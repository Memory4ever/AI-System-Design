<p id="A2.SS2.p5.3" class="ltx_p"><span id="A2.SS2.p5.3.1" class="ltx_text">Finally,</span></p>
<table id="A2.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E155.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}\!\left(X_{1}^{\top}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})X_{1}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}\!\left(X_{1}^{\top}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})X_{1}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(155)</span></td></tr></tbody>
<tbody id="A2.E156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E156.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\frac{2}{c}\,\mathbb{E}\!\left[\|M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\|_{\mathrm{F}}^{2}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\frac{2}{c}\|M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\|_{\mathrm{op}}^{2}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>c</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq\frac{2}{c}\,\mathbb{E}\!\left[\|M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\|_{\mathrm{F}}^{2}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\frac{2}{c}\|M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\|_{\mathrm{op}}^{2}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(156)</span></td></tr></tbody>
<tbody id="A2.E157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E157.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad+\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\big)\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad+\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\big)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(157)</span></td></tr></tbody>
<tbody id="A2.E158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E158.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\frac{2}{c}\!\left(\|M_{1}\|_{\infty}^{2}\|M_{2}\|_{\infty}^{2}+\frac{2}{c}\|M_{1}\|_{\infty}^{2}\|M_{2}\|_{\infty}^{2}\right)+\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\big)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq\frac{2}{c}\!\left(\|M_{1}\|_{\infty}^{2}\|M_{2}\|_{\infty}^{2}+\frac{2}{c}\|M_{1}\|_{\infty}^{2}\|M_{2}\|_{\infty}^{2}\right)+\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\big)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(158)</span></td></tr></tbody>
<tbody id="A2.E159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E159.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\|M_{1}\|_{\infty}^{2}\|M_{2}\|_{\infty}^{2}+\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\big)\right)\!." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mpadded style="width:0.219em;" width="0.219em"><mo>)</mo></mpadded></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\|M_{1}\|_{\infty}^{2}\|M_{2}\|_{\infty}^{2}+\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\big)\right)\!.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(159)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p6" class="ltx_para ltx_noindent">
<p id="A2.SS2.p6.1" class="ltx_p"><span id="A2.SS2.p6.1.1" class="ltx_text">It remains to bound the trace-variance terms. By Cauchy–Schwarz, for all <math id="A2.SS2.p6.m1" class="ltx_Math" alttext="\mathbf{X},\mathbf{Y}\in\mathsf{A}_{\eta}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐗</mi><mo>,</mo><mi>𝐘</mi></mrow><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{X},\mathbf{Y}\in\mathsf{A}_{\eta}</annotation></semantics></math>,</span></p>
<table id="A2.E160" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E160.m1" class="ltx_Math" alttext="\big|\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{X}^{-})\big)-\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{Y}^{-})\big)\big|\leq\sqrt{d}\,\|\Sigma_{X}\|_{\mathrm{op}}\,\mathtt{L}_{1}\,\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐘</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo>≤</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\big|\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{X}^{-})\big)-\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{Y}^{-})\big)\big|\leq\sqrt{d}\,\|\Sigma_{X}\|_{\mathrm{op}}\,\mathtt{L}_{1}\,\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(160)</span></td></tr></tbody>
</table>
<table id="A2.E161" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E161.m1" class="ltx_Math" alttext="\big|\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{X}^{-})\mathbf{B}\big)-\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{Y}^{-})\mathbf{B}\big)\big|\leq\|\Sigma_{X}\|_{\mathrm{op}}\,\mathtt{L}_{1}\,\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐘</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\big|\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{X}^{-})\mathbf{B}\big)-\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{Y}^{-})\mathbf{B}\big)\big|\leq\|\Sigma_{X}\|_{\mathrm{op}}\,\mathtt{L}_{1}\,\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(161)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p6.2" class="ltx_p"><span id="A2.SS2.p6.2.1" class="ltx_text">and</span></p>
<table id="A2.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E162.m1" class="ltx_Math" alttext="\displaystyle\left|\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{X}^{-})\mathbf{B}\,M_{2}(\mathbf{X}^{-})\big)-\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{Y}^{-})\mathbf{B}\,M_{2}(\mathbf{Y}^{-})\big)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐘</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐘</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{X}^{-})\mathbf{B}\,M_{2}(\mathbf{X}^{-})\big)-\operatorname{tr}\!\big(\Sigma_{X}M_{1}(\mathbf{Y}^{-})\mathbf{B}\,M_{2}(\mathbf{Y}^{-})\big)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(162)</span></td></tr></tbody>
<tbody id="A2.E163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E163.m1" class="ltx_Math" alttext="\displaystyle\qquad\leq\|\Sigma_{X}\|_{\mathrm{op}}\big(\|M_{1}\|_{\infty}\mathtt{L}_{2}+\|M_{2}\|_{\infty}\mathtt{L}_{1}\big)\,\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="2.278em">≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mn>1</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq\|\Sigma_{X}\|_{\mathrm{op}}\big(\|M_{1}\|_{\infty}\mathtt{L}_{2}+\|M_{2}\|_{\infty}\mathtt{L}_{1}\big)\,\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(163)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p6.3" class="ltx_p"><span id="A2.SS2.p6.3.1" class="ltx_text">Therefore, by <a href="#Thmproposition6" title="Proposition 6. ‣ B.1 Some sub Gaussian concentration bounds ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">6</span></a> and standard sub-Gaussian variance bounds,</span></p>
<table id="A2.E164" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E164.m1" class="ltx_Math" alttext="\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\big)\right)\lesssim d\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\mathtt{L}_{1}^{2}+d\,\|M_{1}\|_{\infty}^{2}+d^{2}\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\|M_{1}\|_{\infty}^{2}\,\sigma_{\mathsf{A}_{\eta}}^{2}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>≲</mo><mrow><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝙻</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><msub><mi>𝖠</mi><mi>η</mi></msub><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\big)\right)\lesssim d\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\mathtt{L}_{1}^{2}+d\,\|M_{1}\|_{\infty}^{2}+d^{2}\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\|M_{1}\|_{\infty}^{2}\,\sigma_{\mathsf{A}_{\eta}}^{2}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(164)</span></td></tr></tbody>
</table>
<table id="A2.E165" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E165.m1" class="ltx_Math" alttext="\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\big)\right)\lesssim\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\mathtt{L}_{1}^{2}+\|M_{1}\|_{\infty}^{2}+d\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\|M_{1}\|_{\infty}^{2}\,\sigma_{\mathsf{A}_{\eta}}^{2}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>≲</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝙻</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo>+</mo><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><msub><mi>𝖠</mi><mi>η</mi></msub><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\big)\right)\lesssim\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\mathtt{L}_{1}^{2}+\|M_{1}\|_{\infty}^{2}+d\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\|M_{1}\|_{\infty}^{2}\,\sigma_{\mathsf{A}_{\eta}}^{2}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(165)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p6.4" class="ltx_p"><span id="A2.SS2.p6.4.1" class="ltx_text">and</span></p>
<table id="A2.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E166.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\big)\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\mathbf{B}\,M_{2}(X^{-})\big)\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E166.m2" class="ltx_Math" alttext="\displaystyle\lesssim\|\Sigma_{X}\|_{\mathrm{op}}^{2}\big(\|M_{1}\|_{\infty}\mathtt{L}_{2}+\|M_{2}\|_{\infty}\mathtt{L}_{1}\big)^{2}+\|M_{1}\|_{\infty}^{2}\|M_{2}\|_{\infty}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mn>1</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\|\Sigma_{X}\|_{\mathrm{op}}^{2}\big(\|M_{1}\|_{\infty}\mathtt{L}_{2}+\|M_{2}\|_{\infty}\mathtt{L}_{1}\big)^{2}+\|M_{1}\|_{\infty}^{2}\|M_{2}\|_{\infty}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(166)</span></td></tr></tbody>
<tbody id="A2.E167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E167.m1" class="ltx_Math" alttext="\displaystyle\quad+d\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\|M_{1}\|_{\infty}^{2}\,\sigma_{\mathsf{A}_{\eta}}^{2}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><msub><mi>𝖠</mi><mi>η</mi></msub><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+d\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}\,\|M_{1}\|_{\infty}^{2}\,\sigma_{\mathsf{A}_{\eta}}^{2}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(167)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p7" class="ltx_para ltx_noindent">
<p id="A2.SS2.p7.1" class="ltx_p"><span id="A2.SS2.p7.1.1" class="ltx_text">Finally, by <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a>,</span></p>
<table id="A2.E168" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E168.m1" class="ltx_Math" alttext="\sigma_{\mathsf{A}_{\eta}}^{2}=\frac{1-2\mathbb{P}(X\in\mathsf{A}_{\eta})}{2\log\!\left(\frac{1-\mathbb{P}(X\in\mathsf{A}_{\eta})}{\mathbb{P}(X\in\mathsf{A}_{\eta})}\right)}\lesssim\frac{1}{n\,c_{X}}\,," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>σ</mi><msub><mi>𝖠</mi><mi>η</mi></msub><mn>2</mn></msubsup><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:1.146em;" width="1.146em"><mi>log</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mfrac><mo>≲</mo><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>c</mi><mi>X</mi></msub></mrow></mfrac></mrow><mo lspace="0.170em">,</mo></mrow><annotation encoding="application/x-tex">\sigma_{\mathsf{A}_{\eta}}^{2}=\frac{1-2\mathbb{P}(X\in\mathsf{A}_{\eta})}{2\log\!\left(\frac{1-\mathbb{P}(X\in\mathsf{A}_{\eta})}{\mathbb{P}(X\in\mathsf{A}_{\eta})}\right)}\lesssim\frac{1}{n\,c_{X}}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(168)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p7.2" class="ltx_p"><span id="A2.SS2.p7.2.1" class="ltx_text">since <math id="A2.SS2.p7.m1" class="ltx_Math" alttext="1-\mathbb{P}(\mathsf{A}_{\eta})\lesssim\exp(-c_{X}n)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝖠</mi><mi>η</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≲</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\mathbb{P}(\mathsf{A}_{\eta})\lesssim\exp(-c_{X}n)</annotation></semantics></math>. We also note that <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a> forces <math id="A2.SS2.p7.m2" class="ltx_Math" alttext="d&lt;n" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&lt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d&lt;n</annotation></semantics></math> (otherwise <math id="A2.SS2.p7.m3" class="ltx_Math" alttext="C_{X}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>X</mi></msub><annotation encoding="application/x-tex">C_{X}</annotation></semantics></math> would be rank-deficient a.s., yielding <math id="A2.SS2.p7.m4" class="ltx_Math" alttext="\mathbb{P}(X\in\mathsf{A}_{\eta})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{P}(X\in\mathsf{A}_{\eta})=0</annotation></semantics></math> for all <math id="A2.SS2.p7.m5" class="ltx_Math" alttext="\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta&gt;0</annotation></semantics></math>). Plugging the bound on <math id="A2.SS2.p7.m6" class="ltx_Math" alttext="\sigma_{\mathsf{A}_{\eta}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><msub><mi>𝖠</mi><mi>η</mi></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{\mathsf{A}_{\eta}}^{2}</annotation></semantics></math> above into the previous displays gives the stated upper bounds.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>A deterministic equivalent for <math id="A2.SS3.m1" class="ltx_Math" alttext="\operatorname{R}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{R}_{X}(\lambda)</annotation></semantics></math>, with arbitrarly small regularization parameter</h3>

<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p">We first show that the resolvent map is locally Lipschitz, and in particular Lipschitz on <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="\mathsf{A}_{\eta}" display="inline" intent=":literal"><semantics><msub><mi>𝖠</mi><mi>η</mi></msub><annotation encoding="application/x-tex">\mathsf{A}_{\eta}</annotation></semantics></math>.</p>
</div>
<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma6.p1.1" class="ltx_p"><span id="Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="\mathbf{X}_{1},\mathbf{X}_{2}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐗</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝐗</mi><mn>2</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{X}_{1},\mathbf{X}_{2}\in\mathbb{R}^{d\times n}</annotation></semantics></math> and let <math id="Thmlemma6.p1.m2" class="ltx_Math" alttext="\mathbf{D}\succeq 0" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbf{D}\succeq 0</annotation></semantics></math>. Assume that for <math id="Thmlemma6.p1.m3" class="ltx_Math" alttext="i\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,2\}</annotation></semantics></math>,
<math id="Thmlemma6.p1.m4" class="ltx_Math" alttext="\uplambda_{d}(C_{\mathbf{X}_{i}}+\mathbf{D})\geq\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\uplambda_{d}(C_{\mathbf{X}_{i}}+\mathbf{D})\geq\epsilon&gt;0</annotation></semantics></math>. Then</span></p>
<table id="A2.E169" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E169.m1" class="ltx_Math" alttext="\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}-(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}\;\leq\;\frac{2}{\sqrt{n\,\epsilon^{3}}}\,\|\mathbf{X}_{1}-\mathbf{X}_{2}\|_{\mathrm{F}}\;." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>1</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>2</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><mfrac><mn>2</mn><msqrt><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>3</mn></msup></mrow></msqrt></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐗</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}-(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}\;\leq\;\frac{2}{\sqrt{n\,\epsilon^{3}}}\,\|\mathbf{X}_{1}-\mathbf{X}_{2}\|_{\mathrm{F}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(169)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.p2.1" class="ltx_p"><span id="A2.SS3.p2.1.1" class="ltx_text">Using <math id="A2.SS3.p2.m1" class="ltx_Math" alttext="A^{-1}-B^{-1}=A^{-1}(B-A)B^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mi>B</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>=</mo><mrow><msup><mi>A</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo>−</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">A^{-1}-B^{-1}=A^{-1}(B-A)B^{-1}</annotation></semantics></math> and <math id="A2.SS3.p2.m2" class="ltx_Math" alttext="\|AB\|_{\mathrm{F}}\leq\|A\|_{\mathrm{op}}\|B\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>A</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>B</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|AB\|_{\mathrm{F}}\leq\|A\|_{\mathrm{op}}\|B\|_{\mathrm{F}}</annotation></semantics></math>,</span></p>
<table id="A2.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E170"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E170.m1" class="ltx_Math" alttext="\displaystyle\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}-(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>1</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>2</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}-(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E170.m2" class="ltx_Math" alttext="\displaystyle=\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}\big(C_{\mathbf{X}_{2}}-C_{\mathbf{X}_{1}}\big)(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>1</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>2</mn></msub></msub><mo>−</mo><msub><mi>C</mi><msub><mi>𝐗</mi><mn>1</mn></msub></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>2</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}\big(C_{\mathbf{X}_{2}}-C_{\mathbf{X}_{1}}\big)(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(170)</span></td></tr></tbody>
<tbody id="A2.E171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E171.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}\!\left(\mathbf{X}_{1}(\mathbf{X}_{1}-\mathbf{X}_{2})^{\top}+(\mathbf{X}_{1}-\mathbf{X}_{2})\mathbf{X}_{2}^{\top}\right)\!(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>1</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝐗</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐗</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐗</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐗</mi><mn>2</mn><mo>⊤</mo></msubsup></mrow></mrow><mpadded style="width:0.219em;" width="0.219em"><mo>)</mo></mpadded></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>2</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}\!\left(\mathbf{X}_{1}(\mathbf{X}_{1}-\mathbf{X}_{2})^{\top}+(\mathbf{X}_{1}-\mathbf{X}_{2})\mathbf{X}_{2}^{\top}\right)\!(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(171)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p2.2" class="ltx_p"><span id="A2.SS3.p2.2.1" class="ltx_text">Using <math id="A2.SS3.p2.m3" class="ltx_Math" alttext="\|UV^{\top}\|_{\mathrm{F}}\leq\|U\|_{\mathrm{op}}\|V\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>U</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>V</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|UV^{\top}\|_{\mathrm{F}}\leq\|U\|_{\mathrm{op}}\|V\|_{\mathrm{F}}</annotation></semantics></math> and the triangle inequality,</span></p>
<table id="A2.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E172.m1" class="ltx_Math" alttext="\displaystyle\cdots\;\leq\;\frac{1}{n}\Big(\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}\mathbf{X}_{1}\|_{\mathrm{op}}\,\|(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\|_{\mathrm{op}}+\|(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\mathbf{X}_{2}\|_{\mathrm{op}}\,\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}\|_{\mathrm{op}}\Big)\,\|\mathbf{X}_{1}-\mathbf{X}_{2}\|_{\mathrm{F}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>⋯</mo><mo rspace="0.558em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>1</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐗</mi><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>2</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mo>+</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>2</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐗</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mn>1</mn></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐗</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdots\;\leq\;\frac{1}{n}\Big(\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}\mathbf{X}_{1}\|_{\mathrm{op}}\,\|(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\|_{\mathrm{op}}+\|(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\mathbf{X}_{2}\|_{\mathrm{op}}\,\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}\|_{\mathrm{op}}\Big)\,\|\mathbf{X}_{1}-\mathbf{X}_{2}\|_{\mathrm{F}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(172)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p2.3" class="ltx_p"><span id="A2.SS3.p2.3.1" class="ltx_text">Since <math id="A2.SS3.p2.m4" class="ltx_Math" alttext="\uplambda_{d}(C_{\mathbf{X}_{i}}+\mathbf{D})\geq\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\uplambda_{d}(C_{\mathbf{X}_{i}}+\mathbf{D})\geq\epsilon</annotation></semantics></math>, we have <math id="A2.SS3.p2.m5" class="ltx_Math" alttext="\|(C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\|_{\mathrm{op}}\leq\epsilon^{-1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo>≤</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\|(C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\|_{\mathrm{op}}\leq\epsilon^{-1}</annotation></semantics></math>.
Moreover,</span></p>
<table id="A2.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E173"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E173.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{\sqrt{n}}\,\|(C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\mathbf{X}_{i}\|_{\mathrm{op}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐗</mi><mi>i</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\sqrt{n}}\,\|(C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\mathbf{X}_{i}\|_{\mathrm{op}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E173.m2" class="ltx_Math" alttext="\displaystyle=\sqrt{\uplambda_{d}\!\left((C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\frac{\mathbf{X}_{i}\mathbf{X}_{i}^{\top}}{n}(C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msqrt><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝐗</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐗</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{\uplambda_{d}\!\left((C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\frac{\mathbf{X}_{i}\mathbf{X}_{i}^{\top}}{n}(C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(173)</span></td></tr></tbody>
<tbody id="A2.E174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E174.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sqrt{\uplambda_{d}\!\left((C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}C_{\mathbf{X}_{i}}(C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\right)}\;\leq\;\sqrt{\uplambda_{d}\!\left((C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\right)}\;\leq\;\epsilon^{-1/2}\;," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msqrt><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></msqrt><mo lspace="0.558em" rspace="0.558em">≤</mo><msqrt><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>)</mo></mrow></mrow></msqrt><mo lspace="0.558em" rspace="0.558em">≤</mo><mi>ϵ</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{\uplambda_{d}\!\left((C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}C_{\mathbf{X}_{i}}(C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\right)}\;\leq\;\sqrt{\uplambda_{d}\!\left((C_{\mathbf{X}_{i}}+\mathbf{D})^{-1}\right)}\;\leq\;\epsilon^{-1/2}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(174)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p2.4" class="ltx_p"><span id="A2.SS3.p2.4.1" class="ltx_text">where we used <math id="A2.SS3.p2.m6" class="ltx_Math" alttext="C_{\mathbf{X}_{i}}\preceq C_{\mathbf{X}_{i}}+\mathbf{D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>⪯</mo><mrow><msub><mi>C</mi><msub><mi>𝐗</mi><mi>i</mi></msub></msub><mo>+</mo><mi>𝐃</mi></mrow></mrow><annotation encoding="application/x-tex">C_{\mathbf{X}_{i}}\preceq C_{\mathbf{X}_{i}}+\mathbf{D}</annotation></semantics></math>.
Plugging these bounds into the previous display yields</span></p>
<table id="A2.E175" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E175.m1" class="ltx_math_unparsed" alttext="\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}-(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}\;\leq\;\frac{2}{\sqrt{n}}\,\epsilon^{-1/2}\,\epsilon^{-1}\,\|\mathbf{X}_{1}-\mathbf{X}_{2}\|_{\mathrm{F}}=\frac{2}{\sqrt{n\,\epsilon^{3}}}\,\|\mathbf{X}_{1}-\mathbf{X}_{2}\|_{\mathrm{F}}\!," display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><msub><mi>𝐗</mi><mn>1</mn></msub></msub><mo>+</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><msub><mi>𝐗</mi><mn>2</mn></msub></msub><mo>+</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mfrac><mn>2</mn><msqrt><mi>n</mi></msqrt></mfrac><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐗</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>2</mn></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mi>F</mi></msub><mo lspace="0.0835em">=</mo><mfrac><mn>2</mn><msqrt><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>3</mn></msup></mrow></msqrt></mfrac><mo lspace="0.170em" rspace="0.167em">∥</mo><msub><mi>𝐗</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝐗</mi><mn>2</mn></msub><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>F</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\|(C_{\mathbf{X}_{1}}+\mathbf{D})^{-1}-(C_{\mathbf{X}_{2}}+\mathbf{D})^{-1}\right\|_{\mathrm{F}}\;\leq\;\frac{2}{\sqrt{n}}\,\epsilon^{-1/2}\,\epsilon^{-1}\,\|\mathbf{X}_{1}-\mathbf{X}_{2}\|_{\mathrm{F}}=\frac{2}{\sqrt{n\,\epsilon^{3}}}\,\|\mathbf{X}_{1}-\mathbf{X}_{2}\|_{\mathrm{F}}\!,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(175)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p2.5" class="ltx_p"><span id="A2.SS3.p2.5.1" class="ltx_text">as claimed.
∎</span></p>
</div>
</div>
<div id="A2.SS3.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.p3.1" class="ltx_p"><span id="A2.SS3.p3.1.1" class="ltx_text ltx_font_bold">In particular.</span> On <math id="A2.SS3.p3.m1" class="ltx_Math" alttext="\mathsf{A}_{\eta}=\{\mathbf{X}:\,\uplambda_{d}(C_{\mathbf{X}})\geq\eta\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖠</mi><mi>η</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>𝐗</mi><mo lspace="0.278em" rspace="0.448em">:</mo><mrow><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>𝐗</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>η</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{A}_{\eta}=\{\mathbf{X}:\,\uplambda_{d}(C_{\mathbf{X}})\geq\eta\}</annotation></semantics></math> (take <math id="A2.SS3.p3.m2" class="ltx_Math" alttext="\mathbf{D}=0" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbf{D}=0</annotation></semantics></math>), the map <math id="A2.SS3.p3.m3" class="ltx_Math" alttext="\mathbf{X}\mapsto(C_{\mathbf{X}}+\lambda\operatorname{I}_{d})^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo stretchy="false">↦</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mi>𝐗</mi></msub><mo>+</mo><mrow><mi>λ</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{X}\mapsto(C_{\mathbf{X}}+\lambda\operatorname{I}_{d})^{-1}</annotation></semantics></math> is Lipschitz with constant <math id="A2.SS3.p3.m4" class="ltx_Math" alttext="2/\sqrt{n(\eta+\lambda)^{3}}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>/</mo><msqrt><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></msqrt></mrow><annotation encoding="application/x-tex">2/\sqrt{n(\eta+\lambda)^{3}}</annotation></semantics></math>, for all <math id="A2.SS3.p3.m5" class="ltx_Math" alttext="\lambda\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\geq 0</annotation></semantics></math>.</p>
</div>
<div id="A2.SS3.p4" class="ltx_para ltx_noindent">
<p id="A2.SS3.p4.1" class="ltx_p">Define, for any <math id="A2.SS3.p4.m1" class="ltx_Math" alttext="\mathfrak{b}\in[1,\infty)" display="inline" intent=":literal"><semantics><mrow><mi>𝔟</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{b}\in[1,\infty)</annotation></semantics></math> and any matrix <math id="A2.SS3.p4.m2" class="ltx_Math" alttext="\mathbf{D}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{D}\in\mathbb{R}^{d\times d}</annotation></semantics></math>,</p>
<table id="A2.E176" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E176.m1" class="ltx_Math" alttext="\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\;:=\;\Big(\tfrac{\Sigma_{X}}{\mathfrak{b}}+\mathbf{D}\Big)^{-1}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mi>𝔟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">:=</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="false"><mfrac><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mi>𝔟</mi></mfrac></mstyle><mo>+</mo><mi>𝐃</mi></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\;:=\;\Big(\tfrac{\Sigma_{X}}{\mathfrak{b}}+\mathbf{D}\Big)^{-1}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(176)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p4.2" class="ltx_p">We provide two choices of the parameter <math id="A2.SS3.p4.m3" class="ltx_Math" alttext="\mathfrak{b}" display="inline" intent=":literal"><semantics><mi>𝔟</mi><annotation encoding="application/x-tex">\mathfrak{b}</annotation></semantics></math> for which <math id="A2.SS3.p4.m4" class="ltx_Math" alttext="\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mi>𝔟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})</annotation></semantics></math> is a deterministic equivalent of <math id="A2.SS3.p4.m5" class="ltx_Math" alttext="\operatorname{R}_{X}(\mathbf{D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{R}_{X}(\mathbf{D})</annotation></semantics></math>. Precisely:</p>
</div>
<div id="Thmproposition8" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition8.2" class="ltx_text ltx_font_bold">Proposition 8</span></span><span id="Thmproposition8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition8.p1" class="ltx_para ltx_noindent">
<p id="Thmproposition8.p1.1" class="ltx_p"><span id="Thmproposition8.p1.1.1" class="ltx_text ltx_font_italic">Assume <math id="Thmproposition8.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> satisfies <a href="#Thmassumption6" title="H 6 (Lipschitz concentration of the data). ‣ A.2 Discussions on , , ‣ Appendix A In-depth justification of the hypothesis ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">6</span></a> and <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a> for some <math id="Thmproposition8.p1.m2" class="ltx_Math" alttext="\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta&gt;0</annotation></semantics></math>.
Let <math id="Thmproposition8.p1.m3" class="ltx_Math" alttext="\mathbf{B}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐁</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{B}\in\mathbb{R}^{d\times d}</annotation></semantics></math> and let <math id="Thmproposition8.p1.m4" class="ltx_Math" alttext="\mathbf{D}\succeq 0" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbf{D}\succeq 0</annotation></semantics></math> be positive semidefinite. Define</span></p>
<table id="A2.E177" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E177.m1" class="ltx_Math" alttext="\mathfrak{a}^{*}\;=\;1+\frac{1}{n}\,\operatorname{tr}\!\left(\Sigma_{X}\,\mathbb{E}\!\left[\operatorname{R}_{X}(\mathbf{D})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo lspace="0.558em">=</mo><mrow><mn> 1</mn><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.337em" rspace="0em">​</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathfrak{a}^{*}\;=\;1+\frac{1}{n}\,\operatorname{tr}\!\left(\Sigma_{X}\,\mathbb{E}\!\left[\operatorname{R}_{X}(\mathbf{D})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(177)</span></td></tr></tbody>
</table>
<p id="Thmproposition8.p1.2" class="ltx_p"><span id="Thmproposition8.p1.2.1" class="ltx_text ltx_font_italic">and <math id="Thmproposition8.p1.m5" class="ltx_Math" alttext="\mathfrak{b}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔟</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{b}^{*}</annotation></semantics></math> be the unique fixed point of</span></p>
<table id="A2.E178" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E178.m1" class="ltx_Math" alttext="f_{\mathbf{D}}:\ \mathfrak{b}\mapsto 1+\frac{1}{n}\operatorname{tr}\!\left(\Sigma_{X}\,\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0.278em" rspace="0.778em">:</mo><mrow><mi>𝔟</mi><mo stretchy="false">↦</mo><mrow><mn>1</mn><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mi>𝔟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{\mathbf{D}}:\ \mathfrak{b}\mapsto 1+\frac{1}{n}\operatorname{tr}\!\left(\Sigma_{X}\,\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(178)</span></td></tr></tbody>
</table>
<p id="Thmproposition8.p1.3" class="ltx_p"><span id="Thmproposition8.p1.3.1" class="ltx_text ltx_font_italic">Then, for an absolute constant <math id="Thmproposition8.p1.m6" class="ltx_Math" alttext="k&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k&gt;0</annotation></semantics></math> and all <math id="Thmproposition8.p1.m7" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math>,</span></p>
<table id="A2.E179" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E179.m1" class="ltx_Math" alttext="\mathbb{P}\!\left(\left|\frac{1}{d}\operatorname{tr}\!\left(\mathbf{B}\!\left\{\operatorname{R}_{X}(\mathbf{D})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\!\left[\operatorname{R}_{X}(\mathbf{D})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\}\right)\right|\geq t\right)\;\lesssim\;\exp\!\left(-\;k\,\frac{c_{X}\,(\eta+\uplambda_{d}(\mathbf{D}))^{3}\,n\,t^{2}}{\|\mathbf{B}\|_{\mathrm{op}}^{2}\,\big(\eta+\uplambda_{d}(\mathbf{D})+c_{X}/d\big)}\right)\!." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.441em;" width="0.441em"><mi>ℙ</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:0.580em;" width="0.580em"><mi>𝐁</mi></mpadded><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.558em">≲</mo><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo>/</mo><mi>d</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mfrac></mrow></mrow><mpadded style="width:0.219em;" width="0.219em"><mo>)</mo></mpadded></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\!\left(\left|\frac{1}{d}\operatorname{tr}\!\left(\mathbf{B}\!\left\{\operatorname{R}_{X}(\mathbf{D})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\!\left[\operatorname{R}_{X}(\mathbf{D})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\}\right)\right|\geq t\right)\;\lesssim\;\exp\!\left(-\;k\,\frac{c_{X}\,(\eta+\uplambda_{d}(\mathbf{D}))^{3}\,n\,t^{2}}{\|\mathbf{B}\|_{\mathrm{op}}^{2}\,\big(\eta+\uplambda_{d}(\mathbf{D})+c_{X}/d\big)}\right)\!.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(179)</span></td></tr></tbody>
</table>
<p id="Thmproposition8.p1.4" class="ltx_p"><span id="Thmproposition8.p1.4.1" class="ltx_text ltx_font_italic">Furthermore, define the polynomial <math id="Thmproposition8.p1.m8" class="ltx_Math" alttext="Q:\mathbb{R}^{5}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mn>5</mn></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">Q:\mathbb{R}^{5}\to\mathbb{R}</annotation></semantics></math> by</span></p>
<table id="A2.E180" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E180.m1" class="ltx_Math" alttext="Q(X,Y,Z,U,V)\;=\;(1+UX+VX)\,(X^{3}Z+X^{2}+YX^{2}Z+YX)\;+\;YX^{2}Z\;+\;YX^{4}Y^{2}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo>,</mo><mi>U</mi><mo>,</mo><mi>V</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo>+</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>X</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>+</mo><msup><mi>X</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>+</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow></mrow><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.502em">+</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>Y</mi><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Q(X,Y,Z,U,V)\;=\;(1+UX+VX)\,(X^{3}Z+X^{2}+YX^{2}Z+YX)\;+\;YX^{2}Z\;+\;YX^{4}Y^{2}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(180)</span></td></tr></tbody>
</table>
<p id="Thmproposition8.p1.5" class="ltx_p"><span id="Thmproposition8.p1.5.1" class="ltx_text ltx_font_italic">and set <math id="Thmproposition8.p1.m9" class="ltx_Math" alttext="q=Q\big(\eta+\uplambda_{d}(\mathbf{D}),\,\uplambda_{d}(\Sigma_{X}),\,\|\Sigma_{X}\|_{\mathrm{op}}^{-1},\,c_{X}^{-1},\,n^{-1}\big)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q=Q\big(\eta+\uplambda_{d}(\mathbf{D}),\,\uplambda_{d}(\Sigma_{X}),\,\|\Sigma_{X}\|_{\mathrm{op}}^{-1},\,c_{X}^{-1},\,n^{-1}\big)</annotation></semantics></math>. Then</span></p>
<table id="A2.E181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E181.m1" class="ltx_Math" alttext="\left\|\mathbb{E}\!\left[\big\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\big\}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;\lesssim\;\frac{q\,\sqrt{d}\,\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\,\uplambda_{d}(\Sigma_{X})\,(\eta+\uplambda_{d}(\mathbf{D}))^{6}}\;," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0.558em" rspace="0.558em">≲</mo><mfrac><mrow><mi>q</mi><mo lspace="0.170em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\left\|\mathbb{E}\!\left[\big\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\big\}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;\lesssim\;\frac{q\,\sqrt{d}\,\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\,\uplambda_{d}(\Sigma_{X})\,(\eta+\uplambda_{d}(\mathbf{D}))^{6}}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(181)</span></td></tr></tbody>
</table>
<p id="Thmproposition8.p1.6" class="ltx_p"><span id="Thmproposition8.p1.6.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="A2.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E182"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E182.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\!\left[\big\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\big\}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;\lesssim\;" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0.558em" rspace="0.558em">≲</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\!\left[\big\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\big\}\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;\lesssim\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E182.m2" class="ltx_Math" alttext="\displaystyle\left(1+\frac{d\,\|\Sigma_{X}\|_{\mathrm{op}}}{n\,\uplambda_{d}(\Sigma_{X})}\right)\Bigg(\frac{q\,\sqrt{d}\,\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\,\uplambda_{d}(\Sigma_{X})\,(\eta+\uplambda_{d}(\mathbf{D}))^{6}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo lspace="0.170em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(1+\frac{d\,\|\Sigma_{X}\|_{\mathrm{op}}}{n\,\uplambda_{d}(\Sigma_{X})}\right)\Bigg(\frac{q\,\sqrt{d}\,\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\,\uplambda_{d}(\Sigma_{X})\,(\eta+\uplambda_{d}(\mathbf{D}))^{6}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(182)</span></td></tr></tbody>
<tbody id="A2.E183"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E183.m1" class="ltx_Math" alttext="\displaystyle\hskip 62.00006pt+\left(\frac{d\,\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\frac{d^{2}\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))\,n^{2}}\right)\,\mathrm{e}^{-c_{X}n}\Bigg)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 62.00006pt+\left(\frac{d\,\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\frac{d^{2}\,\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))\,n^{2}}\right)\,\mathrm{e}^{-c_{X}n}\Bigg)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(183)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS3.p5" class="ltx_para ltx_noindent">
<p id="A2.SS3.p5.1" class="ltx_p"><em id="A2.SS3.p5.1.1" class="ltx_emph ltx_font_italic">Remark.</em> This result generalizes those of <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib12" title="" class="ltx_ref">Chouard (2022)</a></cite>. Firstly, under <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a> one may take an arbitrarily small regularization <math id="A2.SS3.p5.m1" class="ltx_Math" alttext="\mathbf{D}\succeq 0" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbf{D}\succeq 0</annotation></semantics></math> and still retain favorable concentration properties for the resolvent (even <math id="A2.SS3.p5.m2" class="ltx_Math" alttext="\mathbf{D}=0" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbf{D}=0</annotation></semantics></math>), secondly we provide fully explicit bounds which allow to understand deeper the dependancies to all the parameters.
Our proof follows <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib12" title="" class="ltx_ref">Chouard (2022)</a></cite> closely.</p>
</div>
<div id="A2.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.p6" class="ltx_para ltx_noindent">
<p id="A2.SS3.p6.1" class="ltx_p"><span id="A2.SS3.p6.1.1" class="ltx_text">The proof procees in two parts, first we derive the claimed concentration bound for terms of the form <math id="A2.SS3.p6.m1" class="ltx_Math" alttext="d^{-1}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{X}(\mathbf{D})\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d^{-1}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{X}(\mathbf{D})\right)</annotation></semantics></math>, which follows from concentration of Lipschitz transformations of <math id="A2.SS3.p6.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> (<a href="#Thmassumption6" title="H 6 (Lipschitz concentration of the data). ‣ A.2 Discussions on , , ‣ Appendix A In-depth justification of the hypothesis ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">6</span></a>), as well as <a href="#Thmproposition6" title="Proposition 6. ‣ B.1 Some sub Gaussian concentration bounds ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">6</span></a>. Then we will derive the claimed bias bound, using the Shermann-Morison formula.</span></p>
</div>
<div id="A2.SS3.p7" class="ltx_para ltx_noindent">
<p id="A2.SS3.p7.1" class="ltx_p"><span id="A2.SS3.p7.1.1" class="ltx_text ltx_font_bold">Concentration of <math id="A2.SS3.p7.m1" class="ltx_Math" alttext="d^{-1}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{X}(\mathbf{D})\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi mathvariant="normal">R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d^{-1}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{X}(\mathbf{D})\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math><span id="A2.SS3.p7.1.1.1" class="ltx_text ltx_font_medium">
We mainly rely on <a href="#Thmproposition6" title="Proposition 6. ‣ B.1 Some sub Gaussian concentration bounds ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">6</span></a>, first note that the map</span></span></p>
<table id="A2.E184" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E184.m1" class="ltx_Math" alttext="h_{\mathbf{B},\mathbf{D}}:\begin{cases}\mathsf{A}_{\eta}&amp;\to\mathbb{R}\\
\mathbf{X}&amp;\mapsto\dfrac{1}{d}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{\mathbf{X}}(\mathbf{D})\right)\end{cases}\;," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>𝐃</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><msub><mi>𝖠</mi><mi>η</mi></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>𝐗</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo stretchy="false">↦</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝐗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">h_{\mathbf{B},\mathbf{D}}:\begin{cases}\mathsf{A}_{\eta}&amp;\to\mathbb{R}\\
\mathbf{X}&amp;\mapsto\dfrac{1}{d}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{\mathbf{X}}(\mathbf{D})\right)\end{cases}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(184)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.2" class="ltx_p"><span id="A2.SS3.p7.2.1" class="ltx_text">is <math id="A2.SS3.p7.m2" class="ltx_math_unparsed" alttext="2\|\mathbf{B}\|_{\mathrm{op}}(\eta+\lambda_{1}(\mathbf{D}))^{-3/2}n^{-1/2}d^{-1/2}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐁</mi><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>op</mi></msub><msup><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>+</mo><msub><mi>λ</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2\|\mathbf{B}\|_{\mathrm{op}}(\eta+\lambda_{1}(\mathbf{D}))^{-3/2}n^{-1/2}d^{-1/2}</annotation></semantics></math>-Lipschitz from <a href="#Thmlemma6" title="Lemma 6. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6</span></a>. Moreover <math id="A2.SS3.p7.m3" class="ltx_Math" alttext="\|h_{\mathbf{B},\mathbf{D}}\|_{\infty}\leq\|\mathbf{B}\|_{\mathrm{op}}^{2}(\eta+\lambda_{1}(\mathbf{D}))^{-1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>𝐃</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\|h_{\mathbf{B},\mathbf{D}}\|_{\infty}\leq\|\mathbf{B}\|_{\mathrm{op}}^{2}(\eta+\lambda_{1}(\mathbf{D}))^{-1}</annotation></semantics></math>, we have from <a href="#Thmproposition6" title="Proposition 6. ‣ B.1 Some sub Gaussian concentration bounds ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">6</span></a> that <math id="A2.SS3.p7.m4" class="ltx_Math" alttext="h_{\mathbf{B},\mathbf{D}}(X)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>𝐃</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{\mathbf{B},\mathbf{D}}(X)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math> is sub Gaussian, with parameter,</span></p>
<table id="A2.E185" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E185.m1" class="ltx_Math" alttext="\sigma_{h_{\mathbf{B},\mathbf{D}}(X)}^{2}\lesssim\mathbb{P}(X\in\mathsf{A}_{\eta})^{2}\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}nd}+\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}\sigma(\mathbb{P}(X\in\mathsf{A}_{\eta}))^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\;," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>σ</mi><mrow><msub><mi>h</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>𝐃</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo>≲</mo><mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mrow><mo>+</mo><mfrac><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\sigma_{h_{\mathbf{B},\mathbf{D}}(X)}^{2}\lesssim\mathbb{P}(X\in\mathsf{A}_{\eta})^{2}\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}nd}+\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}\sigma(\mathbb{P}(X\in\mathsf{A}_{\eta}))^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(185)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.3" class="ltx_p"><span id="A2.SS3.p7.3.1" class="ltx_text">and, remarking that by definition of <math id="A2.SS3.p7.m5" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> given in <a href="#Thmproposition6" title="Proposition 6. ‣ B.1 Some sub Gaussian concentration bounds ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">6</span></a>, since <math id="A2.SS3.p7.m6" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> satisfies <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have,</span></p>
<table id="A2.E186" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E186.m1" class="ltx_Math" alttext="\sigma(\mathbb{P}(X\in\mathsf{E}))^{2}\lesssim\dfrac{1}{nc_{X}}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><mi>𝖤</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≲</mo><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>X</mi></msub></mrow></mfrac></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\sigma(\mathbb{P}(X\in\mathsf{E}))^{2}\lesssim\dfrac{1}{nc_{X}}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(186)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.4" class="ltx_p"><span id="A2.SS3.p7.4.1" class="ltx_text">which implies that</span></p>
<table id="A2.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E187"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E187.m1" class="ltx_Math" alttext="\displaystyle\sigma_{h_{\mathbf{B},\mathbf{D}}}^{2}\lesssim\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}}{nd(\eta+\uplambda_{d}(\mathbf{D}))^{3}}+\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}}{c_{X}n(\eta+\uplambda_{d}(\mathbf{D}))^{2}}=\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}}{c_{X}n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left(\dfrac{c_{X}}{d}+(\eta+\uplambda_{d}(\mathbf{D}))\right)\;," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>σ</mi><msub><mi>h</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>𝐃</mi></mrow></msub><mn>2</mn></msubsup><mo>≲</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>c</mi><mi>X</mi></msub><mi>d</mi></mfrac></mstyle><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sigma_{h_{\mathbf{B},\mathbf{D}}}^{2}\lesssim\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}}{nd(\eta+\uplambda_{d}(\mathbf{D}))^{3}}+\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}}{c_{X}n(\eta+\uplambda_{d}(\mathbf{D}))^{2}}=\dfrac{\|\mathbf{B}\|_{\mathrm{op}}^{2}}{c_{X}n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left(\dfrac{c_{X}}{d}+(\eta+\uplambda_{d}(\mathbf{D}))\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(187)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.5" class="ltx_p"><span id="A2.SS3.p7.5.1" class="ltx_text">hence, using the variance bound for sub Gaussian random variable, we have for a universal constant <math id="A2.SS3.p7.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>,</span></p>
<table id="A2.E188" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E188.m1" class="ltx_Math" alttext="\mathbb{P}\left(\left|\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{X}(\mathbf{D})\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{X}(\mathbf{D})\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|\geq t\right)\lesssim\exp\left(-k\dfrac{t^{2}c_{X}(\eta+\uplambda_{d}(\mathbf{D}))^{3}nt^{2}}{\|\mathbf{B}\|_{\mathrm{op}}^{2}(\eta+\uplambda_{d}(\mathbf{D}+c_{X}/d))}\right)\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><mo>≲</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐃</mi><mo>+</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo>/</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\left(\left|\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{X}(\mathbf{D})\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{X}(\mathbf{D})\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|\geq t\right)\lesssim\exp\left(-k\dfrac{t^{2}c_{X}(\eta+\uplambda_{d}(\mathbf{D}))^{3}nt^{2}}{\|\mathbf{B}\|_{\mathrm{op}}^{2}(\eta+\uplambda_{d}(\mathbf{D}+c_{X}/d))}\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(188)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.6" class="ltx_p"><span id="A2.SS3.p7.6.1" class="ltx_text ltx_font_bold">First equivalent for <math id="A2.SS3.p7.m8" class="ltx_Math" alttext="\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi mathvariant="normal">R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math><span id="A2.SS3.p7.6.1.1" class="ltx_text ltx_font_medium">
Recall the notation <math id="A2.SS3.p7.m9" class="ltx_Math" alttext="\operatorname{R}_{X}^{-}(\mathbf{D})=R_{X^{-}}(\mathbf{D})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>R</mi><msup><mi>X</mi><mo>−</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{R}_{X}^{-}(\mathbf{D})=R_{X^{-}}(\mathbf{D})</annotation></semantics></math> where <math id="A2.SS3.p7.m10" class="ltx_Math" alttext="X^{-}=[0,X_{1},\cdots,X_{n}]" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>−</mo></msup><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>X</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">X^{-}=[0,X_{1},\cdots,X_{n}]</annotation></semantics></math>, we have from the Shermann-Morison formula <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib52" title="" class="ltx_ref">Sherman &amp; Morrison (1950)</a></cite>,</span></span></p>
<table id="A2.E189" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E189.m1" class="ltx_Math" alttext="\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\left\{\operatorname{R}_{X}^{-}(\mathbf{D})-\dfrac{1}{n}\dfrac{\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})}{1+n^{-1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}}\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>{</mo><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow></mrow></mfrac></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\left\{\operatorname{R}_{X}^{-}(\mathbf{D})-\dfrac{1}{n}\dfrac{\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})}{1+n^{-1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}}\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(189)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.7" class="ltx_p"><span id="A2.SS3.p7.7.1" class="ltx_text">hence, multiplying both sides by <math id="A2.SS3.p7.m11" class="ltx_Math" alttext="X_{1}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mn>1</mn></msub><annotation encoding="application/x-tex">X_{1}</annotation></semantics></math>, we obtain,</span></p>
<table id="A2.E190" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E190.m1" class="ltx_Math" alttext="\operatorname{R}_{X}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\dfrac{\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}}{1+n^{-1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\operatorname{R}_{X}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\dfrac{\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}}{1+n^{-1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(190)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.8" class="ltx_p"><span id="A2.SS3.p7.8.1" class="ltx_text">Denoting <math id="A2.SS3.p7.m12" class="ltx_Math" alttext="\mathfrak{a}_{X}=1+n^{-1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔞</mi><mi>X</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{a}_{X}=1+n^{-1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math>, we simplify the above expression to,</span></p>
<table id="A2.E191" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E191.m1" class="ltx_Math" alttext="\operatorname{R}_{X}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\dfrac{\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}}{\mathfrak{a}_{X}}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\operatorname{R}_{X}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\dfrac{\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}}{\mathfrak{a}_{X}}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(191)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.9" class="ltx_p"><span id="A2.SS3.p7.9.1" class="ltx_text">We now focus on bounding the bias of <math id="A2.SS3.p7.m13" class="ltx_Math" alttext="\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math>. First, using the identity <math id="A2.SS3.p7.m14" class="ltx_Math" alttext="\mathbf{A}^{-1}-\mathbf{B}^{-1}=\mathbf{A}^{-1}(\mathbf{B}-\mathbf{A})\mathbf{B}^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mi>𝐁</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>=</mo><mrow><msup><mi>𝐀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐁</mi><mo>−</mo><mi>𝐀</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}^{-1}-\mathbf{B}^{-1}=\mathbf{A}^{-1}(\mathbf{B}-\mathbf{A})\mathbf{B}^{-1}</annotation></semantics></math>, we have,</span></p>
<table id="A2.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E192"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E192.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E192.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\left\{\dfrac{\Sigma_{X}}{\mathfrak{a}^{*}}-C_{X}\right\}\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>}</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\left\{\dfrac{\Sigma_{X}}{\mathfrak{a}^{*}}-C_{X}\right\}\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(192)</span></td></tr></tbody>
<tbody id="A2.E193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E193.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\left\{\dfrac{\Sigma_{X}}{\mathfrak{a}^{*}}-X_{1}X_{1}^{\top}\right\}\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow></mrow><mo>}</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\left\{\dfrac{\Sigma_{X}}{\mathfrak{a}^{*}}-X_{1}X_{1}^{\top}\right\}\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(193)</span></td></tr></tbody>
<tbody id="A2.E194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E194.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\left\{\dfrac{1}{\mathfrak{a}^{*}}\operatorname{R}_{X}(\mathbf{D})\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})-\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\left\{\dfrac{1}{\mathfrak{a}^{*}}\operatorname{R}_{X}(\mathbf{D})\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})-\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(194)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.10" class="ltx_p"><span id="A2.SS3.p7.10.1" class="ltx_text">where, in the last equality, we have used (<a href="#A2.E191" title="Equation 191 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">191</span></a>). Further rearranging the terms, we get,</span></p>
<table id="A2.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E195.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(195)</span></td></tr></tbody>
<tbody id="A2.E196"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E196.m1" class="ltx_Math" alttext="\displaystyle\quad=\mathbb{E}\left[\dfrac{1}{\mathfrak{a}^{*}}\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.280em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad=\mathbb{E}\left[\dfrac{1}{\mathfrak{a}^{*}}\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(196)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.11" class="ltx_p"><span id="A2.SS3.p7.11.1" class="ltx_text">Hence, by applying the triangle inequality to bound the bias, we obtain,</span></p>
<table id="A2.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E197.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(197)</span></td></tr></tbody>
<tbody id="A2.E198"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E198.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\dfrac{\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})}{\mathfrak{a}^{*}}\right\|_{\mathrm{F}}+\left\|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\dfrac{\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})}{\mathfrak{a}^{*}}\right\|_{\mathrm{F}}+\left\|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(198)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.12" class="ltx_p"><span id="A2.SS3.p7.12.1" class="ltx_text">Controlling each term individualy, we first use <math id="A2.SS3.p7.m15" class="ltx_Math" alttext="\|\mathbf{A}\mathbf{B}\|_{\mathrm{F}}\leq\|\mathbf{A}\|_{\mathrm{op}}\|\mathbf{B}\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{A}\mathbf{B}\|_{\mathrm{F}}\leq\|\mathbf{A}\|_{\mathrm{op}}\|\mathbf{B}\|_{\mathrm{F}}</annotation></semantics></math> to get,</span></p>
<table id="A2.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E199"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E199.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\dfrac{\Sigma_{X}\bar{\operatorname{R}}_{X}(\mathbf{D})}{\mathfrak{a}^{*}}\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\dfrac{\Sigma_{X}\bar{\operatorname{R}}_{X}(\mathbf{D})}{\mathfrak{a}^{*}}\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E199.m2" class="ltx_Math" alttext="\displaystyle\leq\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\left\|\dfrac{\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}}(\mathbf{D})}{\mathfrak{a}^{*}}\right\|_{\mathrm{op}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mi>𝔞</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>‖</mo></mrow><mi>op</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\left\|\dfrac{\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}}(\mathbf{D})}{\mathfrak{a}^{*}}\right\|_{\mathrm{op}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(199)</span></td></tr></tbody>
<tbody id="A2.E200"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E200.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(200)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.13" class="ltx_p"><span id="A2.SS3.p7.13.1" class="ltx_text">From (<a href="#A2.E191" title="Equation 191 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">191</span></a>),</span></p>
<table id="A2.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E201"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E201.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}=\dfrac{1}{n}\left\|\mathbb{E}\left[\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}=\dfrac{1}{n}\left\|\mathbb{E}\left[\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(201)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.14" class="ltx_p"><span id="A2.SS3.p7.14.1" class="ltx_text">In order to easily bound the riht-hand side of the previous inequality, we introduce the Lowner order on symetrix matrices. We say that <math id="A2.SS3.p7.m16" class="ltx_Math" alttext="\mathbf{A}\preceq\mathbf{B}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>⪯</mo><mi>𝐁</mi></mrow><annotation encoding="application/x-tex">\mathbf{A}\preceq\mathbf{B}</annotation></semantics></math> if and only if <math id="A2.SS3.p7.m17" class="ltx_Math" alttext="\mathbf{B}-\mathbf{A}" display="inline" intent=":literal"><semantics><mrow><mi>𝐁</mi><mo>−</mo><mi>𝐀</mi></mrow><annotation encoding="application/x-tex">\mathbf{B}-\mathbf{A}</annotation></semantics></math> is a PSD matrix, then we have <math id="A2.SS3.p7.m18" class="ltx_Math" alttext="\mathfrak{a}_{X}^{-1}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\preceq\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝔞</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⪯</mo><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{a}_{X}^{-1}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\preceq\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math> almost surely. It is clear that this ordering is preserved when averaging the matrices, we get</span></p>
<table id="A2.E202" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E202.m1" class="ltx_Math" alttext="\mathbb{E}\left[\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\preceq\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>⪯</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\preceq\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(202)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.15" class="ltx_p"><span id="A2.SS3.p7.15.1" class="ltx_text">and, using the fact that the Frobenius norm is non-decreasing w.r.t. the Lowner order on PSD matrices, we deduce,</span></p>
<table id="A2.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E203"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E203.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\{\operatorname{R}_{X}(\mathbf{D})-\operatorname{R}_{X}^{-}(\mathbf{D})\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E203.m2" class="ltx_Math" alttext="\displaystyle=\dfrac{1}{n}\left\|\mathbb{E}\left[\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{1}{n}\left\|\mathbb{E}\left[\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(203)</span></td></tr></tbody>
<tbody id="A2.E204"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E204.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{1}{n}\left\|\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{1}{n}\left\|\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(204)</span></td></tr></tbody>
<tbody id="A2.E205"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E205.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{1}{n}\left\|\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})\Sigma_{X}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{1}{n}\left\|\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})\Sigma_{X}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(205)</span></td></tr></tbody>
<tbody id="A2.E206"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E206.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(206)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.16" class="ltx_p"><span id="A2.SS3.p7.16.1" class="ltx_text">Plugging the previous computations in (<a href="#A2.E198" title="Equation 198 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">198</span></a>), we get</span></p>
<table id="A2.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E207"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E207.m2" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(207)</span></td></tr></tbody>
<tbody id="A2.E208"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E208.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\left\|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq\left\|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(208)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.17" class="ltx_p"><span id="A2.SS3.p7.17.1" class="ltx_text">It remains only to bound the second term in the right hand side of (<a href="#A2.E198" title="Equation 198 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">198</span></a>), recalling the dual representation of the Frobenius norm,</span></p>
<table id="A2.E209" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E209.m1" class="ltx_Math" alttext="\|\mathbf{A}\|_{\mathrm{F}}=\sup_{\|\mathbf{B}\|_{\mathrm{F}}\leq 1}\operatorname{tr}(\mathbf{B}^{\top}\mathbf{A})\;," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mn>1</mn></mrow></munder><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi></mrow><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|\mathbf{A}\|_{\mathrm{F}}=\sup_{\|\mathbf{B}\|_{\mathrm{F}}\leq 1}\operatorname{tr}(\mathbf{B}^{\top}\mathbf{A})\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(209)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.18" class="ltx_p"><span id="A2.SS3.p7.18.1" class="ltx_text">we define for any <math id="A2.SS3.p7.m19" class="ltx_Math" alttext="\mathbf{B}" display="inline" intent=":literal"><semantics><mi>𝐁</mi><annotation encoding="application/x-tex">\mathbf{B}</annotation></semantics></math> of unit Frobenius norm, the random variable <math id="A2.SS3.p7.m20" class="ltx_Math" alttext="\zeta_{\mathbf{B},X}=X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbf{B}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{\mathbf{B},X}=X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbf{B}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math>, we have</span></p>
<table id="A2.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E210"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E210.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(210)</span></td></tr></tbody>
<tbody id="A2.E211"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E211.m1" class="ltx_Math" alttext="\displaystyle\quad=\sup_{\|\mathbf{B}\|_{\mathrm{F}}=1}\mathbb{E}\left[\operatorname{tr}\left(\mathbf{B}^{\top}\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em" rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>=</mo><mn>1</mn></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad=\sup_{\|\mathbf{B}\|_{\mathrm{F}}=1}\mathbb{E}\left[\operatorname{tr}\left(\mathbf{B}^{\top}\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(211)</span></td></tr></tbody>
<tbody id="A2.E212"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E212.m1" class="ltx_Math" alttext="\displaystyle\quad=\sup_{\|\mathbf{B}\|_{\mathrm{F}}=1}\left|\mathbb{E}\left[\operatorname{tr}\left(\mathbf{B}\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em" rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>=</mo><mn>1</mn></mrow></munder><mrow><mo>|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>𝐁</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad=\sup_{\|\mathbf{B}\|_{\mathrm{F}}=1}\left|\mathbb{E}\left[\operatorname{tr}\left(\mathbf{B}\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(212)</span></td></tr></tbody>
<tbody id="A2.E213"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E213.m1" class="ltx_Math" alttext="\displaystyle\quad=\sup_{\|\mathbf{B}\|_{\mathrm{F}}=1}\left|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em" rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>=</mo><mn>1</mn></mrow></munder><mrow><mo>|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow><mo>]</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad=\sup_{\|\mathbf{B}\|_{\mathrm{F}}=1}\left|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(213)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.19" class="ltx_p"><span id="A2.SS3.p7.19.1" class="ltx_text">To conclude the proof, we use <a href="#Thmproposition7" title="Proposition 7. ‣ B.2 Concentration bounds for random quadratic forms ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">7</span></a> to bound the variances of <math id="A2.SS3.p7.m21" class="ltx_Math" alttext="\mathfrak{a}_{X}" display="inline" intent=":literal"><semantics><msub><mi>𝔞</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\mathfrak{a}_{X}</annotation></semantics></math> as well as <math id="A2.SS3.p7.m22" class="ltx_Math" alttext="\zeta_{\mathbf{B},X}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><annotation encoding="application/x-tex">\zeta_{\mathbf{B},X}</annotation></semantics></math>, to bound the above term uniformly over all the possible choices of <math id="A2.SS3.p7.m23" class="ltx_Math" alttext="\mathbf{B}" display="inline" intent=":literal"><semantics><mi>𝐁</mi><annotation encoding="application/x-tex">\mathbf{B}</annotation></semantics></math>.
Using the triangle inequality, we have,</span></p>
<table id="A2.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E215"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E215.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow><mo>]</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E215.m2" class="ltx_Math" alttext="\displaystyle\leq\left|\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}\right)\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]\right|+\left|\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow><mo>]</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}\right)\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]\right|+\left|\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(215)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.20" class="ltx_p"><span id="A2.SS3.p7.20.1" class="ltx_text">We further rewrite the first term by remarking that <math id="A2.SS3.p7.m24" class="ltx_Math" alttext="\mathfrak{a}_{X}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔞</mi><mi>X</mi></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathfrak{a}_{X}\geq 1</annotation></semantics></math> almost surely, and similarly <math id="A2.SS3.p7.m25" class="ltx_Math" alttext="\mathfrak{a}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔞</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{a}^{*}</annotation></semantics></math>, we get:</span></p>
<table id="A2.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E216"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E216.m1" class="ltx_Math" alttext="\displaystyle\left|\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}\right)\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}\right)\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E216.m2" class="ltx_Math" alttext="\displaystyle\leq|\mathfrak{a}^{*}-\mathbb{E}\left[\mathfrak{a}_{X}\right]|\dfrac{\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]}{\mathfrak{a}^{*}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq|\mathfrak{a}^{*}-\mathbb{E}\left[\mathfrak{a}_{X}\right]|\dfrac{\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]}{\mathfrak{a}^{*}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(216)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.21" class="ltx_p"><span id="A2.SS3.p7.21.1" class="ltx_text">Now, observe that <math id="A2.SS3.p7.m26" class="ltx_Math" alttext="|\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]|</annotation></semantics></math> may be explicitly controlled by,</span></p>
<table id="A2.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E217"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E217.m1" class="ltx_Math" alttext="\displaystyle|\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]/\mathfrak{a}^{*}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow><mo>/</mo><msup><mi>𝔞</mi><mo>∗</mo></msup></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]/\mathfrak{a}^{*}|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E217.m2" class="ltx_Math" alttext="\displaystyle=\left|\mathbb{E}\left[\operatorname{tr}\left(\dfrac{\Sigma_{X}}{\mathfrak{a}^{*}}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbf{B}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\mathbb{E}\left[\operatorname{tr}\left(\dfrac{\Sigma_{X}}{\mathfrak{a}^{*}}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbf{B}\operatorname{R}_{X}^{-}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(217)</span></td></tr></tbody>
<tbody id="A2.E218"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E218.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{\sqrt{d}}{\eta+\uplambda_{d}(\mathbf{D})}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{\sqrt{d}}{\eta+\uplambda_{d}(\mathbf{D})}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(218)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.22" class="ltx_p"><span id="A2.SS3.p7.22.1" class="ltx_text">Where we have used the fact that <math id="A2.SS3.p7.m27" class="ltx_Math" alttext="\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\lambda)/\mathfrak{a}^{*}\preceq\operatorname{I}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msup><mi>𝔞</mi><mo>∗</mo></msup></mrow><mo>⪯</mo><msub><mi>I</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\lambda)/\mathfrak{a}^{*}\preceq\operatorname{I}_{d}</annotation></semantics></math>. Secondly, the bias of <math id="A2.SS3.p7.m28" class="ltx_Math" alttext="\mathfrak{a}_{X}" display="inline" intent=":literal"><semantics><msub><mi>𝔞</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\mathfrak{a}_{X}</annotation></semantics></math> can be bounded using (<a href="#A2.E189" title="Equation 189 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">189</span></a>) as,</span></p>
<table id="A2.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E219"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E219.m1" class="ltx_Math" alttext="\displaystyle|\mathfrak{a}^{*}-\mathbb{E}\left[\mathfrak{a}_{X}\right]|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\mathfrak{a}^{*}-\mathbb{E}\left[\mathfrak{a}_{X}\right]|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E219.m2" class="ltx_Math" alttext="\displaystyle=\left|\dfrac{1}{n}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})-\operatorname{R}_{X}(\mathbf{D})\right]\right)\right|=\dfrac{1}{n^{2}}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\right]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\dfrac{1}{n}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})-\operatorname{R}_{X}(\mathbf{D})\right]\right)\right|=\dfrac{1}{n^{2}}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\dfrac{1}{\mathfrak{a}_{X}}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(219)</span></td></tr></tbody>
<tbody id="A2.E220"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E220.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{1}{n^{2}}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\right]\right)\leq\dfrac{1}{n^{2}}\mathbb{E}\left[\operatorname{tr}\left((\Sigma_{X}\operatorname{R}_{X}^{-}(\mathbf{D}))^{2}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{1}{n^{2}}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})\right]\right)\leq\dfrac{1}{n^{2}}\mathbb{E}\left[\operatorname{tr}\left((\Sigma_{X}\operatorname{R}_{X}^{-}(\mathbf{D}))^{2}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(220)</span></td></tr></tbody>
<tbody id="A2.E221"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E221.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{2}n^{2}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{2}n^{2}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(221)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p7.23" class="ltx_p"><span id="A2.SS3.p7.23.1" class="ltx_text">Which implies the following bound on the first term in (<a href="#A2.E215" title="Equation 215 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">215</span></a>),</span></p>
<table id="A2.E222" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E222.m1" class="ltx_Math" alttext="\left|\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}\right)\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]\right|\lesssim\dfrac{d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}n^{2}}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac><mo>−</mo><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow><mo>|</mo></mrow><mo>≲</mo><mfrac><mrow><msup><mi>d</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\left|\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}\right)\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]\right|\lesssim\dfrac{d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}n^{2}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(222)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.p8" class="ltx_para ltx_noindent">
<p id="A2.SS3.p8.1" class="ltx_p"><span id="A2.SS3.p8.1.1" class="ltx_text">Now dealing with the second term in (<a href="#A2.E215" title="Equation 215 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">215</span></a>), using the Cauchy-Schwarz inequality, as well as <math id="A2.SS3.p8.m1" class="ltx_Math" alttext="\mathbb{E}[\mathfrak{a}_{X}]\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\mathfrak{a}_{X}]\geq 1</annotation></semantics></math>, we have,</span></p>
<table id="A2.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E223"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E223.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow><mo>]</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E223.m2" class="ltx_Math" alttext="\displaystyle=\left|\mathbb{E}\left[(\mathfrak{a}_{X}-\mathbb{E}\left[\mathfrak{a}_{X}\right])\dfrac{\zeta_{\mathbf{B},X}}{\mathfrak{a}_{X}\mathbb{E}\left[\mathfrak{a}_{X}\right]}\right]\right|\leq\sqrt{\operatorname{Var}\left(\mathfrak{a}_{X}\right)\operatorname{Var}\left(\zeta_{\mathbf{B},X}/\mathfrak{a}_{X}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔞</mi><mi>X</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mrow><msub><mi>𝔞</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>/</mo><msub><mi>𝔞</mi><mi>X</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\mathbb{E}\left[(\mathfrak{a}_{X}-\mathbb{E}\left[\mathfrak{a}_{X}\right])\dfrac{\zeta_{\mathbf{B},X}}{\mathfrak{a}_{X}\mathbb{E}\left[\mathfrak{a}_{X}\right]}\right]\right|\leq\sqrt{\operatorname{Var}\left(\mathfrak{a}_{X}\right)\operatorname{Var}\left(\zeta_{\mathbf{B},X}/\mathfrak{a}_{X}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(223)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p8.2" class="ltx_p"><span id="A2.SS3.p8.2.1" class="ltx_text">We write <math id="A2.SS3.p8.m2" class="ltx_Math" alttext="\zeta_{\mathbf{B},X}/\mathfrak{a}_{X}=(\zeta_{\mathbf{B},X}-\mathbb{E}\left[\zeta_{\mathbf{B},X}\right])/\mathfrak{a}_{X}+\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]/\mathfrak{a}_{X}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>/</mo><msub><mi>𝔞</mi><mi>X</mi></msub></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>𝔞</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow><mo>/</mo><msub><mi>𝔞</mi><mi>X</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{\mathbf{B},X}/\mathfrak{a}_{X}=(\zeta_{\mathbf{B},X}-\mathbb{E}\left[\zeta_{\mathbf{B},X}\right])/\mathfrak{a}_{X}+\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]/\mathfrak{a}_{X}</annotation></semantics></math>, and using <math id="A2.SS3.p8.m3" class="ltx_Math" alttext="\operatorname{Var}(a+b)\leq 2\operatorname{Var}(a)+2\operatorname{Var}(b)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Var}(a+b)\leq 2\operatorname{Var}(a)+2\operatorname{Var}(b)</annotation></semantics></math>, we have,</span></p>
<table id="A2.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E224"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E224.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}\left(\zeta_{\mathbf{B},X}/\mathfrak{a}_{X}\right)" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>/</mo><msub><mi>𝔞</mi><mi>X</mi></msub></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}\left(\zeta_{\mathbf{B},X}/\mathfrak{a}_{X}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E224.m2" class="ltx_Math" alttext="\displaystyle\leq 2\operatorname{Var}\left((\zeta_{\mathbf{B},X}-\mathbb{E}\left[\zeta_{\mathbf{B},X}\right])/\mathfrak{a}_{X}\right)+2\operatorname{Var}\left(\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]/\mathfrak{a}_{X}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>𝔞</mi><mi>X</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow><mo>/</mo><msub><mi>𝔞</mi><mi>X</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\operatorname{Var}\left((\zeta_{\mathbf{B},X}-\mathbb{E}\left[\zeta_{\mathbf{B},X}\right])/\mathfrak{a}_{X}\right)+2\operatorname{Var}\left(\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]/\mathfrak{a}_{X}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(224)</span></td></tr></tbody>
<tbody id="A2.E225"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E225.m1" class="ltx_Math" alttext="\displaystyle\leq 2\mathbb{E}\left[\left((\zeta_{\mathbf{B},X}-\mathbb{E}\left[\zeta_{\mathbf{B},X}\right])/\mathfrak{a}_{X}\right)^{2}\right]+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}\left(\mathfrak{a}_{X}^{-1}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>𝔞</mi><mi>X</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>𝔞</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\mathbb{E}\left[\left((\zeta_{\mathbf{B},X}-\mathbb{E}\left[\zeta_{\mathbf{B},X}\right])/\mathfrak{a}_{X}\right)^{2}\right]+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}\left(\mathfrak{a}_{X}^{-1}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(225)</span></td></tr></tbody>
<tbody id="A2.E226"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E226.m1" class="ltx_Math" alttext="\displaystyle\leq 2\mathbb{E}\left[\left(\zeta_{\mathbf{B},X}-\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]\right)^{2}\right]+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}\left(\mathfrak{a}_{X}^{-1}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>𝔞</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\mathbb{E}\left[\left(\zeta_{\mathbf{B},X}-\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]\right)^{2}\right]+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}\left(\mathfrak{a}_{X}^{-1}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(226)</span></td></tr></tbody>
<tbody id="A2.E227"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E227.m1" class="ltx_Math" alttext="\displaystyle\leq 2\operatorname{Var}(\zeta_{\mathbf{B},X})+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}(\mathfrak{a}_{X}^{-1})\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔞</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\operatorname{Var}(\zeta_{\mathbf{B},X})+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}(\mathfrak{a}_{X}^{-1})\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(227)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p8.3" class="ltx_p"><span id="A2.SS3.p8.3.1" class="ltx_text">Furthermore, <math id="A2.SS3.p8.m4" class="ltx_Math" alttext="\operatorname{Var}(\mathfrak{a}_{X}^{-1})=\operatorname{inf}_{m}\mathbb{E}\left[(\mathfrak{a}_{X}^{-1}-m)^{2}\right]\leq\mathbb{E}\left[(\mathfrak{a}_{X}^{-1}-\mathbb{E}\left[\mathfrak{a}_{X}\right]^{-1})^{2}\right]\leq\operatorname{Var}(\mathfrak{a}_{X})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔞</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>inf</mi><mi>m</mi></msub><mo lspace="0.167em">⁡</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝔞</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝔞</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Var}(\mathfrak{a}_{X}^{-1})=\operatorname{inf}_{m}\mathbb{E}\left[(\mathfrak{a}_{X}^{-1}-m)^{2}\right]\leq\mathbb{E}\left[(\mathfrak{a}_{X}^{-1}-\mathbb{E}\left[\mathfrak{a}_{X}\right]^{-1})^{2}\right]\leq\operatorname{Var}(\mathfrak{a}_{X})</annotation></semantics></math>, which follows from <math id="A2.SS3.p8.m5" class="ltx_Math" alttext="\mathfrak{a}_{X}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔞</mi><mi>X</mi></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathfrak{a}_{X}\geq 1</annotation></semantics></math> again, we get,</span></p>
<table id="A2.E228" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E228.m1" class="ltx_Math" alttext="\operatorname{Var}\left(\zeta_{\mathbf{B},X}/\mathfrak{a}_{X}\right)\leq 2\operatorname{Var}\left(\zeta_{\mathbf{B},X}\right)+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}(\mathfrak{a}_{X})\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>/</mo><msub><mi>𝔞</mi><mi>X</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}\left(\zeta_{\mathbf{B},X}/\mathfrak{a}_{X}\right)\leq 2\operatorname{Var}\left(\zeta_{\mathbf{B},X}\right)+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}(\mathfrak{a}_{X})\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(228)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p8.4" class="ltx_p"><span id="A2.SS3.p8.4.1" class="ltx_text">which results in,</span></p>
<table id="A2.E229" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E229.m1" class="ltx_Math" alttext="\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]^{2}\leq 2\operatorname{Var}\left(\mathfrak{a}_{X}\right)\operatorname{Var}\left(\zeta_{\mathbf{B},X}\right)+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}\left(\mathfrak{a}_{X}\right)^{2}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><msup><mrow><mo>(</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]^{2}\leq 2\operatorname{Var}\left(\mathfrak{a}_{X}\right)\operatorname{Var}\left(\zeta_{\mathbf{B},X}\right)+2\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]^{2}\operatorname{Var}\left(\mathfrak{a}_{X}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(229)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.p9" class="ltx_para ltx_noindent">
<p id="A2.SS3.p9.1" class="ltx_p"><span id="A2.SS3.p9.1.1" class="ltx_text">We conclude by bounding <math id="A2.SS3.p9.m1" class="ltx_Math" alttext="\operatorname{Var}(\mathfrak{a}_{X})" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Var}(\mathfrak{a}_{X})</annotation></semantics></math> and <math id="A2.SS3.p9.m2" class="ltx_Math" alttext="\operatorname{Var}(\zeta_{\mathbf{B},X})" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Var}(\zeta_{\mathbf{B},X})</annotation></semantics></math>, using <a href="#Thmproposition7" title="Proposition 7. ‣ B.2 Concentration bounds for random quadratic forms ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">7</span></a> and the Lipschitz property of <math id="A2.SS3.p9.m3" class="ltx_Math" alttext="\mathbf{X}\mapsto\operatorname{R}_{\mathbf{X}}^{-}(\mathbf{D})" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo stretchy="false">↦</mo><mrow><msubsup><mi>R</mi><mi>𝐗</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{X}\mapsto\operatorname{R}_{\mathbf{X}}^{-}(\mathbf{D})</annotation></semantics></math> on <math id="A2.SS3.p9.m4" class="ltx_Math" alttext="\mathsf{A}_{\eta}" display="inline" intent=":literal"><semantics><msub><mi>𝖠</mi><mi>η</mi></msub><annotation encoding="application/x-tex">\mathsf{A}_{\eta}</annotation></semantics></math> (which results from <a href="#Thmlemma6" title="Lemma 6. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6</span></a>), we have,</span></p>
<table id="A2.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E230"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E230.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}\left(\mathfrak{a}_{X}\right)" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}\left(\mathfrak{a}_{X}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E230.m2" class="ltx_Math" alttext="\displaystyle=\dfrac{1}{n^{2}}\operatorname{Var}\left(X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)\lesssim\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n^{2}}\left\{\dfrac{1}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}n}+\dfrac{1+c_{X}^{-1}}{(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><msubsup><mi>c</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{1}{n^{2}}\operatorname{Var}\left(X_{1}^{\top}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)\lesssim\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n^{2}}\left\{\dfrac{1}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}n}+\dfrac{1+c_{X}^{-1}}{(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(230)</span></td></tr></tbody>
<tbody id="A2.E231"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E231.m1" class="ltx_Math" alttext="\displaystyle=\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n^{2}(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.280em">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n^{2}(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(231)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.2" class="ltx_p"><span id="A2.SS3.p9.2.1" class="ltx_text">similarly,</span></p>
<table id="A2.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E232"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E232.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}\left(\zeta_{\mathbf{D},X}\right)" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>ζ</mi><mrow><mi>𝐃</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}\left(\zeta_{\mathbf{D},X}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E232.m2" class="ltx_Math" alttext="\displaystyle\lesssim X_{1}^{\top}\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\mathbf{B}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim X_{1}^{\top}\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\mathbf{B}\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(232)</span></td></tr></tbody>
<tbody id="A2.E233"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E233.m1" class="ltx_Math" alttext="\displaystyle\lesssim\dfrac{\|\Sigma_{X}\|_{\mathrm{op}}^{2}\|\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.280em">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\dfrac{\|\Sigma_{X}\|_{\mathrm{op}}^{2}\|\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(233)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.3" class="ltx_p"><span id="A2.SS3.p9.3.1" class="ltx_text">it results from the two previous upper bounds, as well as (<a href="#A2.E218" title="Equation 218 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">218</span></a>) and (<a href="#A2.E229" title="Equation 229 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">229</span></a>), that</span></p>
<table id="A2.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E234"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E234.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E234.m2" class="ltx_Math" alttext="\displaystyle\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{2}\|\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{2}\|\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(234)</span></td></tr></tbody>
<tbody id="A2.E235"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E235.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}^{2}\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]}{n^{2}(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}(\eta+\uplambda_{d}(\mathbf{D}))\right)\right\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub><mo>]</mo></mrow></mrow><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}^{2}\mathbb{E}\left[\zeta_{\mathbf{B},X}\right]}{n^{2}(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}(\eta+\uplambda_{d}(\mathbf{D}))\right)\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(235)</span></td></tr></tbody>
<tbody id="A2.E236"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E236.m1" class="ltx_Math" alttext="\displaystyle\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{2}\|\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{2}\|\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(236)</span></td></tr></tbody>
<tbody id="A2.E237"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E237.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{\mathfrak{a}^{*}d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n^{2}(\eta+\uplambda_{d}(\mathbf{D}))^{4}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}(\eta+\uplambda_{d}(\mathbf{D}))\right)\right\}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{\mathfrak{a}^{*}d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n^{2}(\eta+\uplambda_{d}(\mathbf{D}))^{4}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}(\eta+\uplambda_{d}(\mathbf{D}))\right)\right\}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(237)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.4" class="ltx_p"><span id="A2.SS3.p9.4.1" class="ltx_text">Finally, we bound <math id="A2.SS3.p9.m5" class="ltx_Math" alttext="\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{op}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><annotation encoding="application/x-tex">\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{op}}</annotation></semantics></math> and <math id="A2.SS3.p9.m6" class="ltx_Math" alttext="\mathfrak{a}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔞</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{a}^{*}</annotation></semantics></math> by writing</span></p>
<table id="A2.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E238"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E238.m1" class="ltx_Math" alttext="\displaystyle\mathfrak{a}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔞</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\displaystyle\mathfrak{a}^{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E238.m2" class="ltx_Math" alttext="\displaystyle=1+\dfrac{1}{n}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\leq 1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1+\dfrac{1}{n}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\leq 1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n(\eta+\uplambda_{d}(\mathbf{D}))}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(238)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.5" class="ltx_p"><span id="A2.SS3.p9.5.1" class="ltx_text">and</span></p>
<table id="A2.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E239"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E239.m1" class="ltx_Math" alttext="\displaystyle\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{op}}\leq\left(\dfrac{\lambda_{1}(\Sigma_{X})}{\mathfrak{a}^{*}}+\lambda_{1}(\mathbf{D})\right)^{-1}\leq\dfrac{\mathfrak{a}}{\lambda_{1}(\Sigma_{X})}\leq\dfrac{1+\dfrac{d}{n}\|\Sigma_{X}\|_{\mathrm{op}}(\eta+\uplambda_{d}(\mathbf{D}))^{-1}}{\lambda_{1}(\Sigma_{X})}\;." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo>≤</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>+</mo><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>≤</mo><mstyle displaystyle="true"><mfrac><mi>𝔞</mi><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{op}}\leq\left(\dfrac{\lambda_{1}(\Sigma_{X})}{\mathfrak{a}^{*}}+\lambda_{1}(\mathbf{D})\right)^{-1}\leq\dfrac{\mathfrak{a}}{\lambda_{1}(\Sigma_{X})}\leq\dfrac{1+\dfrac{d}{n}\|\Sigma_{X}\|_{\mathrm{op}}(\eta+\uplambda_{d}(\mathbf{D}))^{-1}}{\lambda_{1}(\Sigma_{X})}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(239)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.6" class="ltx_p"><span id="A2.SS3.p9.6.1" class="ltx_text">We conclude from (<a href="#A2.E234" title="Equation 234 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">234</span></a>),</span></p>
<table id="A2.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E240"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E240.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E240.m2" class="ltx_Math" alttext="\displaystyle\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(240)</span></td></tr></tbody>
<tbody id="A2.E241"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E241.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n^{2}\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{4}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n^{2}\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{4}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(241)</span></td></tr></tbody>
<tbody id="A2.E242"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E242.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n^{2}(\eta+\uplambda_{d}(\mathbf{D}))^{4}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}(\eta+\uplambda_{d}(\mathbf{D}))\right)\right\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{n^{2}(\eta+\uplambda_{d}(\mathbf{D}))^{4}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}(\eta+\uplambda_{d}(\mathbf{D}))\right)\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(242)</span></td></tr></tbody>
<tbody id="A2.E243"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E243.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{d^{5/2}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n^{6}(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}(\eta+\uplambda_{d}(\mathbf{D}))\right)\right\}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mrow><mn>5</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><msup><mi>n</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{d^{5/2}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n^{6}(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{1}{n}+\left(1+\dfrac{1}{c_{X}}(\eta+\uplambda_{d}(\mathbf{D}))\right)\right\}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(243)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.7" class="ltx_p"><span id="A2.SS3.p9.7.1" class="ltx_text">We slighly simplify the previous upper bound by remarking that <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a> implies that <math id="A2.SS3.p9.m7" class="ltx_Math" alttext="d&lt;n" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&lt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d&lt;n</annotation></semantics></math>, hence:</span></p>
<table id="A2.E244" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E244.m1" class="ltx_Math" alttext="\dfrac{d^{5/2}}{n^{3}}\leq\dfrac{d^{3/2}}{n^{2}}\leq\dfrac{\sqrt{d}}{n}\;," display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msup><mi>d</mi><mrow><mn>5</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>n</mi><mn>3</mn></msup></mfrac><mo>≤</mo><mfrac><msup><mi>d</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo>≤</mo><mfrac><msqrt><mi>d</mi></msqrt><mi>n</mi></mfrac></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\dfrac{d^{5/2}}{n^{3}}\leq\dfrac{d^{3/2}}{n^{2}}\leq\dfrac{\sqrt{d}}{n}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(244)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.8" class="ltx_p"><span id="A2.SS3.p9.8.1" class="ltx_text">Using this in (<a href="#A2.E240" title="Equation 240 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">240</span></a>), we obtain,</span></p>
<table id="A2.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E245"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E245.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E245.m2" class="ltx_Math" alttext="\displaystyle\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{(\eta+\uplambda_{d}(\mathbf{D}))^{2}}{n\|\Sigma_{X}\|_{\mathrm{op}}}+\left(1+\dfrac{1}{c_{X}}\right)\dfrac{(\eta+\uplambda_{d}(\mathbf{D}))^{3}}{\|\Sigma_{X}\|_{\mathrm{op}}}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mfrac></mstyle></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{(\eta+\uplambda_{d}(\mathbf{D}))^{2}}{n\|\Sigma_{X}\|_{\mathrm{op}}}+\left(1+\dfrac{1}{c_{X}}\right)\dfrac{(\eta+\uplambda_{d}(\mathbf{D}))^{3}}{\|\Sigma_{X}\|_{\mathrm{op}}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(245)</span></td></tr></tbody>
<tbody id="A2.E246"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E246.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{\eta+\uplambda_{d}(\mathbf{D})}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))^{2}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{\eta+\uplambda_{d}(\mathbf{D})}{n}+\left(1+\dfrac{1}{c_{X}}\right)(\eta+\uplambda_{d}(\mathbf{D}))^{2}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(246)</span></td></tr></tbody>
<tbody id="A2.E247"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E247.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))}{n\|\Sigma_{X}\|_{\mathrm{op}}}+\left(1+\dfrac{1}{c_{X}}\right)\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{2}}{\|\Sigma_{X}\|_{\mathrm{op}}}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mfrac></mstyle></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))}{n\|\Sigma_{X}\|_{\mathrm{op}}}+\left(1+\dfrac{1}{c_{X}}\right)\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{2}}{\|\Sigma_{X}\|_{\mathrm{op}}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(247)</span></td></tr></tbody>
<tbody id="A2.E248"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E248.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{\uplambda_{d}(\mathbf{D})}{n}+\left(1+\dfrac{1}{c_{X}}\right)\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))\right\}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{\dfrac{\uplambda_{d}(\mathbf{D})}{n}+\left(1+\dfrac{1}{c_{X}}\right)\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))\right\}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(248)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.9" class="ltx_p"><span id="A2.SS3.p9.9.1" class="ltx_text">Defining the polynomial <math id="A2.SS3.p9.m8" class="ltx_Math" alttext="P_{1}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mn>1</mn></msub><annotation encoding="application/x-tex">P_{1}</annotation></semantics></math> as:</span></p>
<table id="A2.E249" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E249.m1" class="ltx_Math" alttext="P_{1}(X,Y,Z)=X^{3}Z+X^{2}+YX^{2}Z+YX\;,\quad p_{1}=P_{1}(\eta+\uplambda_{d}(\mathbf{D}),\uplambda_{d}(\Sigma_{X}),\|\Sigma_{X}\|_{\mathrm{op}}^{-1})\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>P</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>X</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>+</mo><msup><mi>X</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>+</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow></mrow></mrow><mo lspace="0.280em" rspace="1.167em">,</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>P</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P_{1}(X,Y,Z)=X^{3}Z+X^{2}+YX^{2}Z+YX\;,\quad p_{1}=P_{1}(\eta+\uplambda_{d}(\mathbf{D}),\uplambda_{d}(\Sigma_{X}),\|\Sigma_{X}\|_{\mathrm{op}}^{-1})\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(249)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.10" class="ltx_p"><span id="A2.SS3.p9.10.1" class="ltx_text">we can rewrite the previous upper bound as,</span></p>
<table id="A2.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E250"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E250.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mi>𝔞</mi><mi>X</mi></msub><mo>]</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mrow><mi>𝐁</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow><mo>]</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left(\dfrac{1}{\mathbb{E}\left[\mathfrak{a}_{X}\right]}-\dfrac{1}{\mathfrak{a}_{X}}\right)\zeta_{\mathbf{B},X}\right]^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(250)</span></td></tr></tbody>
<tbody id="A2.E251"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E251.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}p_{1}\left(\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))}+1+\dfrac{1}{c_{X}}\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}p_{1}\left(\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))}+1+\dfrac{1}{c_{X}}\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(251)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.11" class="ltx_p"><span id="A2.SS3.p9.11.1" class="ltx_text">Plugging (<a href="#A2.E222" title="Equation 222 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">222</span></a>) and (<a href="#A2.E250" title="Equation 250 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">250</span></a>) in (<a href="#A2.E215" title="Equation 215 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">215</span></a>), we get,</span></p>
<table id="A2.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E252"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E252.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>𝔞</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mi>R</mi><mi>X</mi><mo>−</mo></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left(\dfrac{1}{\mathfrak{a}^{*}}-\dfrac{1}{\mathfrak{a}_{X}}\right)\operatorname{R}_{X}^{-}(\mathbf{D})X_{1}X_{1}^{\top}\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(252)</span></td></tr></tbody>
<tbody id="A2.E253"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E253.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\dfrac{d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}n^{2}}+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}p_{1}\left(\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))}+1+\dfrac{1}{c_{X}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\dfrac{d^{3/2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3}n^{2}}+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}p_{1}\left(\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))}+1+\dfrac{1}{c_{X}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(253)</span></td></tr></tbody>
<tbody id="A2.E254"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E254.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{p_{1}\left(\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))}+1+\dfrac{1}{c_{X}}\right)+\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{2}}{\|\Sigma_{X}\|_{\mathrm{op}}}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mfrac></mstyle></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{p_{1}\left(\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))}+1+\dfrac{1}{c_{X}}\right)+\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{2}}{\|\Sigma_{X}\|_{\mathrm{op}}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(254)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p9.12" class="ltx_p"><span id="A2.SS3.p9.12.1" class="ltx_text">Where, once again, we have used the fact that <math id="A2.SS3.p9.m9" class="ltx_Math" alttext="d&lt;n" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&lt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d&lt;n</annotation></semantics></math> from <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a>.</span></p>
</div>
<div id="A2.SS3.p10" class="ltx_para ltx_noindent">
<p id="A2.SS3.p10.1" class="ltx_p"><span id="A2.SS3.p10.1.1" class="ltx_text">Finally, from (<a href="#A2.E207" title="Equation 207 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">207</span></a>), we have,</span></p>
<table id="A2.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E255"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E255.m2" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(255)</span></td></tr></tbody>
<tbody id="A2.E256"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E256.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{(\eta+\uplambda_{d}(\mathbf{D}))^{2}n}+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{p_{1}\left(\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))}+1+\dfrac{1}{c_{X}}\right)+\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{2}}{\|\Sigma_{X}\|_{\mathrm{op}}}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>5</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mfrac></mstyle></mrow><mo>}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{(\eta+\uplambda_{d}(\mathbf{D}))^{2}n}+\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{5}}\left\{p_{1}\left(\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))}+1+\dfrac{1}{c_{X}}\right)+\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{2}}{\|\Sigma_{X}\|_{\mathrm{op}}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(256)</span></td></tr></tbody>
<tbody id="A2.E257"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E257.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}\Biggl\{\dfrac{(\eta+\uplambda_{d}(\mathbf{D}))p_{1}}{n}+(\eta+\uplambda_{d}(\mathbf{D}))p_{1}\left(1+\dfrac{1}{c_{X}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle><mrow><mo stretchy="false">{</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>+</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mn>1</mn></msub><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mi>X</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}\Biggl\{\dfrac{(\eta+\uplambda_{d}(\mathbf{D}))p_{1}}{n}+(\eta+\uplambda_{d}(\mathbf{D}))p_{1}\left(1+\dfrac{1}{c_{X}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(257)</span></td></tr></tbody>
<tbody id="A2.E258"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E258.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 128.0374pt+\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{3}}{\|\Sigma_{X}\|_{\mathrm{op}}}+\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D})^{4})}{\|\Sigma_{X}\|_{\mathrm{op}}^{2}}\Biggr\}\;." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mfrac></mstyle><mo stretchy="false">}</mo><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 128.0374pt+\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{3}}{\|\Sigma_{X}\|_{\mathrm{op}}}+\dfrac{\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D})^{4})}{\|\Sigma_{X}\|_{\mathrm{op}}^{2}}\Biggr\}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(258)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.p11" class="ltx_para ltx_noindent">
<p id="A2.SS3.p11.1" class="ltx_p"><span id="A2.SS3.p11.1.1" class="ltx_text">Defining <math id="A2.SS3.p11.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> as,</span></p>
<table id="A2.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E259"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E259.m1" class="ltx_Math" alttext="\displaystyle Q(X,Y,Z,U,V)=XVP(X,Y,Z)+\left(1+U\right)XP(X,Y,Z)+YX^{3}Z+YX^{4}Y^{2}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo>,</mo><mi>U</mi><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>U</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>+</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>Y</mi><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle Q(X,Y,Z,U,V)=XVP(X,Y,Z)+\left(1+U\right)XP(X,Y,Z)+YX^{3}Z+YX^{4}Y^{2}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(259)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p11.2" class="ltx_p"><span id="A2.SS3.p11.2.1" class="ltx_text">We have shown that:</span></p>
<table id="A2.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E260"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E260.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\leq\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}Q(\eta+\uplambda_{d}(\mathbf{D}),\uplambda_{d}(\Sigma_{X}),\|\Sigma_{X}\|_{\mathrm{op}}^{-1},c_{X}^{-1},n^{-1})\;," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\leq\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}Q(\eta+\uplambda_{d}(\mathbf{D}),\uplambda_{d}(\Sigma_{X}),\|\Sigma_{X}\|_{\mathrm{op}}^{-1},c_{X}^{-1},n^{-1})\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(260)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p11.3" class="ltx_p"><span id="A2.SS3.p11.3.1" class="ltx_text">This concludes the proof for the first deterministic equivalent.</span></p>
</div>
<div id="A2.SS3.p12" class="ltx_para ltx_noindent">
<p id="A2.SS3.p12.1" class="ltx_p"><span id="A2.SS3.p12.1.1" class="ltx_text ltx_font_bold">Second equivalent for <math id="A2.SS3.p12.m1" class="ltx_Math" alttext="\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{E}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi mathvariant="normal">R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><mi>𝖤</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{E}}(X)\right]</annotation></semantics></math><span id="A2.SS3.p12.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A2.SS3.p13" class="ltx_para ltx_noindent">
<p id="A2.SS3.p13.1" class="ltx_p"><span id="A2.SS3.p13.1.1" class="ltx_text">Now, we show that:</span></p>
<table id="A2.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E261"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E261.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(261)</span></td></tr></tbody>
<tbody id="A2.E262"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E262.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{d}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{d}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(262)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p13.2" class="ltx_p"><span id="A2.SS3.p13.2.1" class="ltx_text">where <math id="A2.SS3.p13.m1" class="ltx_Math" alttext="\mathfrak{b}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔟</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{b}^{*}</annotation></semantics></math> is defined as the only positive solution to equation <math id="A2.SS3.p13.m2" class="ltx_Math" alttext="\mathfrak{b}=1+n^{-1}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\right)" display="inline" intent=":literal"><semantics><mrow><mi>𝔟</mi><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mi>𝔟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{b}=1+n^{-1}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\right)</annotation></semantics></math>. Recall the definition of <math id="A2.SS3.p13.m3" class="ltx_Math" alttext="f_{\mathbf{D}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>𝐃</mi></msub><annotation encoding="application/x-tex">f_{\mathbf{D}}</annotation></semantics></math>, for any <math id="A2.SS3.p13.m4" class="ltx_Math" alttext="\mathfrak{b}\in[1,\infty)" display="inline" intent=":literal"><semantics><mrow><mi>𝔟</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{b}\in[1,\infty)</annotation></semantics></math>,</span></p>
<table id="A2.E263" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E263.m1" class="ltx_Math" alttext="f_{\mathbf{D}}(\mathfrak{b})=1+n^{-1}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\right)\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mi>𝔟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">f_{\mathbf{D}}(\mathfrak{b})=1+n^{-1}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(263)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p13.3" class="ltx_p"><span id="A2.SS3.p13.3.1" class="ltx_text">For notation simplicity, we introduce <math id="A2.SS3.p13.m5" class="ltx_Math" alttext="q\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">q\in\mathbb{R}</annotation></semantics></math> defined as:</span></p>
<table id="A2.E264" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E264.m1" class="ltx_Math" alttext="q=Q(\eta+\uplambda_{d}(\mathbf{D}),\uplambda_{d}(\Sigma_{X}),\|\Sigma_{X}\|_{\mathrm{op}}^{-1},c_{X}^{-1},n^{-1})\;," display="block" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>=</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q=Q(\eta+\uplambda_{d}(\mathbf{D}),\uplambda_{d}(\Sigma_{X}),\|\Sigma_{X}\|_{\mathrm{op}}^{-1},c_{X}^{-1},n^{-1})\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(264)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p13.4" class="ltx_p"><span id="A2.SS3.p13.4.1" class="ltx_text">where <math id="A2.SS3.p13.m6" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is defined in (<a href="#A2.E259" title="Equation 259 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">259</span></a>).</span></p>
</div>
<div id="A2.SS3.p14" class="ltx_para ltx_noindent">
<p id="A2.SS3.p14.1" class="ltx_p"><span id="A2.SS3.p14.1.1" class="ltx_text">First, using (<a href="#A2.E260" title="Equation 260 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">260</span></a>), we have,</span></p>
<table id="A2.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E265"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E265.m2" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{{\mathsf{A}_{\eta}}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{{\mathsf{A}_{\eta}}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(265)</span></td></tr></tbody>
<tbody id="A2.E266"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E266.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{{\mathsf{A}_{\eta}}}(X)\right]\right\|_{\mathrm{F}}+\left\|\mathbb{E}\left[\left\{\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{{\mathsf{A}_{\eta}}}(X)\right]\right\|_{\mathrm{F}}+\left\|\mathbb{E}\left[\left\{\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(266)</span></td></tr></tbody>
<tbody id="A2.E267"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E267.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left\|\mathbb{E}\left[\left\{\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left\|\mathbb{E}\left[\left\{\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(267)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.2" class="ltx_p"><span id="A2.SS3.p14.2.1" class="ltx_text">Then, using the identity <math id="A2.SS3.p14.m1" class="ltx_Math" alttext="\mathbf{A}^{-1}-\mathbf{B}^{-1}=\mathbf{A}^{-1}(\mathbf{B}-\mathbf{A})\mathbf{B}^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mi>𝐁</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>=</mo><mrow><msup><mi>𝐀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐁</mi><mo>−</mo><mi>𝐀</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}^{-1}-\mathbf{B}^{-1}=\mathbf{A}^{-1}(\mathbf{B}-\mathbf{A})\mathbf{B}^{-1}</annotation></semantics></math> we deduce</span></p>
<table id="A2.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E268"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E268.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E268.m2" class="ltx_Math" alttext="\displaystyle=\left|\dfrac{1}{\mathfrak{a^{*}}}-\dfrac{1}{\mathfrak{b^{*}}}\right|\mathbb{P}(X\in\mathsf{A}_{\eta})\left\|\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\Sigma_{X}\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔞</mi><mo>∗</mo></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔟</mi><mo>∗</mo></msup></mfrac></mstyle></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\dfrac{1}{\mathfrak{a^{*}}}-\dfrac{1}{\mathfrak{b^{*}}}\right|\mathbb{P}(X\in\mathsf{A}_{\eta})\left\|\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})\Sigma_{X}\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(268)</span></td></tr></tbody>
<tbody id="A2.E269"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E269.m1" class="ltx_Math" alttext="\displaystyle\lesssim\left|\mathfrak{a}^{*}-\mathfrak{b}^{*}\right|\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{F}}/\mathfrak{a}^{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>/</mo><msup><mi>𝔞</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\left|\mathfrak{a}^{*}-\mathfrak{b}^{*}\right|\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{F}}/\mathfrak{a}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(269)</span></td></tr></tbody>
<tbody id="A2.E270"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E270.m1" class="ltx_Math" alttext="\displaystyle\lesssim\left|\mathfrak{a}^{*}-\mathfrak{b}^{*}\right|\dfrac{\sqrt{d}}{\uplambda_{d}(\Sigma_{X})}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\left|\mathfrak{a}^{*}-\mathfrak{b}^{*}\right|\dfrac{\sqrt{d}}{\uplambda_{d}(\Sigma_{X})}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(270)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.3" class="ltx_p"><span id="A2.SS3.p14.3.1" class="ltx_text">Furthermore, we remark that <math id="A2.SS3.p14.m2" class="ltx_Math" alttext="\mathfrak{a}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔞</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{a}^{*}</annotation></semantics></math> is almost a fixed point of <math id="A2.SS3.p14.m3" class="ltx_Math" alttext="f_{\mathbf{D}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>𝐃</mi></msub><annotation encoding="application/x-tex">f_{\mathbf{D}}</annotation></semantics></math> from the first deterministic equivalent, indeed,</span></p>
<table id="A2.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E271"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E271.m1" class="ltx_Math" alttext="\displaystyle|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔞</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E271.m2" class="ltx_Math" alttext="\displaystyle=n^{-1}\left|\operatorname{tr}\left(\Sigma_{X}\left\{\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]-\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\right\}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=n^{-1}\left|\operatorname{tr}\left(\Sigma_{X}\left\{\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]-\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\right\}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(271)</span></td></tr></tbody>
<tbody id="A2.E272"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E272.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{n}\left\|\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]-\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{n}\left\|\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]-\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(272)</span></td></tr></tbody>
<tbody id="A2.E273"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E273.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{n}\left\|\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{op}}}{n}(1-\mathbb{P}(X\in\mathsf{A}_{\eta}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{n}\left\|\mathbb{E}\left[\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{op}}}{n}(1-\mathbb{P}(X\in\mathsf{A}_{\eta}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(273)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.4" class="ltx_p"><span id="A2.SS3.p14.4.1" class="ltx_text">Recalling (<a href="#A2.E239" title="Equation 239 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">239</span></a>), and using <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have,</span></p>
<table id="A2.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E275"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E275.m1" class="ltx_Math" alttext="\displaystyle\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{op}}}{n}(1-\mathbb{P}(X\in\mathsf{A}_{\eta}))\leq\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}\|\bar{\operatorname{R}}_{X}^{\mathfrak{a}^{*}}(\mathbf{D})\|_{\mathrm{op}}}{n}(1-\mathbb{P}(X\in\mathsf{A}_{\eta}))\leq\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(275)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.5" class="ltx_p"><span id="A2.SS3.p14.5.1" class="ltx_text">Now, using equation (<a href="#A2.E260" title="Equation 260 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">260</span></a>), we have,</span></p>
<table id="A2.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E276"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E276.m1" class="ltx_Math" alttext="\displaystyle\left|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔞</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E276.m2" class="ltx_Math" alttext="\displaystyle\lesssim\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(276)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.6" class="ltx_p"><span id="A2.SS3.p14.6.1" class="ltx_text">Furthermore, we show that <math id="A2.SS3.p14.m4" class="ltx_Math" alttext="f_{\mathbf{D}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>𝐃</mi></msub><annotation encoding="application/x-tex">f_{\mathbf{D}}</annotation></semantics></math> is a contraction mapping around <math id="A2.SS3.p14.m5" class="ltx_Math" alttext="\mathfrak{b}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔟</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{b}^{*}</annotation></semantics></math>, indeed we have for any <math id="A2.SS3.p14.m6" class="ltx_Math" alttext="\mathfrak{b}\in[1,\infty)" display="inline" intent=":literal"><semantics><mrow><mi>𝔟</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{b}\in[1,\infty)</annotation></semantics></math>,</span></p>
<table id="A2.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E277"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E277.m1" class="ltx_Math" alttext="\displaystyle\left|f_{\mathbf{D}}(\mathfrak{b})-f_{\mathbf{D}}(\mathfrak{b}^{*})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔟</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{\mathbf{D}}(\mathfrak{b})-f_{\mathbf{D}}(\mathfrak{b}^{*})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E277.m2" class="ltx_Math" alttext="\displaystyle=\dfrac{1}{n}\left|\operatorname{tr}\left(\Sigma_{X}\left\{\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})-\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right\}\right)\right|=\dfrac{1}{n}\left|\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right)\right|\left|\dfrac{1}{\mathfrak{b}}-\dfrac{1}{\mathfrak{b}^{*}}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mi>𝔟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mi>𝔟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>𝔟</mi></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>𝔟</mi><mo>∗</mo></msup></mfrac></mstyle></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{1}{n}\left|\operatorname{tr}\left(\Sigma_{X}\left\{\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})-\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right\}\right)\right|=\dfrac{1}{n}\left|\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}}(\mathbf{D})\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right)\right|\left|\dfrac{1}{\mathfrak{b}}-\dfrac{1}{\mathfrak{b}^{*}}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(277)</span></td></tr></tbody>
<tbody id="A2.E278"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E278.m1" class="ltx_Math" alttext="\displaystyle=\dfrac{1}{n}\operatorname{tr}\left(\left\{\operatorname{I}_{d}-\mathbf{D}\bar{\operatorname{R}}_{X}^{\mathbf{b}}(\mathbf{D})\right\}\dfrac{\Sigma_{X}}{\mathfrak{b}^{*}}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right)\left|\mathfrak{b}-\mathfrak{b}^{*}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>{</mo><mrow><msub><mi>I</mi><mi>d</mi></msub><mo lspace="0em">−</mo><mrow><mi>𝐃</mi><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mi>𝐛</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><msup><mi>𝔟</mi><mo>∗</mo></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>𝔟</mi><mo>−</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{1}{n}\operatorname{tr}\left(\left\{\operatorname{I}_{d}-\mathbf{D}\bar{\operatorname{R}}_{X}^{\mathbf{b}}(\mathbf{D})\right\}\dfrac{\Sigma_{X}}{\mathfrak{b}^{*}}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right)\left|\mathfrak{b}-\mathfrak{b}^{*}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(278)</span></td></tr></tbody>
<tbody id="A2.E279"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E279.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{1}{n\mathfrak{b}^{*}}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right)\left|\mathfrak{b}-\mathfrak{b}^{*}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>𝔟</mi><mo>−</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{1}{n\mathfrak{b}^{*}}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right)\left|\mathfrak{b}-\mathfrak{b}^{*}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(279)</span></td></tr></tbody>
<tbody id="A2.E280"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E280.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{f_{\mathbf{D}}(\mathfrak{b}^{*})-1}{f_{\mathbf{D}}(\mathfrak{b}^{*})}|\mathfrak{b}-\mathfrak{b}^{*}|=\dfrac{\mathfrak{b}^{*}-1}{\mathfrak{b}^{*}}|\mathfrak{b}-\mathfrak{b}^{*}|\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔟</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔟</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>𝔟</mi><mo>−</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo>−</mo><mn>1</mn></mrow><msup><mi>𝔟</mi><mo>∗</mo></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>𝔟</mi><mo>−</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow><mo rspace="0.280em" stretchy="false">|</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{f_{\mathbf{D}}(\mathfrak{b}^{*})-1}{f_{\mathbf{D}}(\mathfrak{b}^{*})}|\mathfrak{b}-\mathfrak{b}^{*}|=\dfrac{\mathfrak{b}^{*}-1}{\mathfrak{b}^{*}}|\mathfrak{b}-\mathfrak{b}^{*}|\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(280)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.7" class="ltx_p"><span id="A2.SS3.p14.7.1" class="ltx_text">where in the last line, we have used the fact that <math id="A2.SS3.p14.m7" class="ltx_Math" alttext="\mathfrak{b}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔟</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{b}^{*}</annotation></semantics></math> is the only fixed point of <math id="A2.SS3.p14.m8" class="ltx_Math" alttext="f_{\mathbf{D}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>𝐃</mi></msub><annotation encoding="application/x-tex">f_{\mathbf{D}}</annotation></semantics></math>. We conclude that <math id="A2.SS3.p14.m9" class="ltx_Math" alttext="f_{\mathbf{D}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>𝐃</mi></msub><annotation encoding="application/x-tex">f_{\mathbf{D}}</annotation></semantics></math> is contractive around <math id="A2.SS3.p14.m10" class="ltx_Math" alttext="\mathfrak{b}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔟</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{b}^{*}</annotation></semantics></math>. We conclude on the distance between <math id="A2.SS3.p14.m11" class="ltx_Math" alttext="\mathfrak{a}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔞</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{a}^{*}</annotation></semantics></math> and <math id="A2.SS3.p14.m12" class="ltx_Math" alttext="\mathfrak{b}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔟</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{b}^{*}</annotation></semantics></math> by writing,</span></p>
<table id="A2.E281" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E281.m1" class="ltx_Math" alttext="|\mathfrak{a}^{*}-\mathfrak{b}^{*}|\leq|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})|+|f_{\mathbf{D}}(\mathfrak{a}^{*})-f_{\mathbf{D}}(\mathfrak{b}^{*})|\leq|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})|+\dfrac{\mathfrak{b}^{*}-1}{\mathfrak{b}^{*}}|\mathfrak{a}^{*}-\mathfrak{b}^{*}|\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔞</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔞</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔟</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><mo fence="false">|</mo><mrow><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔞</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mo>+</mo><mrow><mfrac><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo>−</mo><mn>1</mn></mrow><msup><mi>𝔟</mi><mo>∗</mo></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow><mo rspace="0.280em" stretchy="false">|</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|\mathfrak{a}^{*}-\mathfrak{b}^{*}|\leq|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})|+|f_{\mathbf{D}}(\mathfrak{a}^{*})-f_{\mathbf{D}}(\mathfrak{b}^{*})|\leq|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})|+\dfrac{\mathfrak{b}^{*}-1}{\mathfrak{b}^{*}}|\mathfrak{a}^{*}-\mathfrak{b}^{*}|\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(281)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.8" class="ltx_p"><span id="A2.SS3.p14.8.1" class="ltx_text">which implies,</span></p>
<table id="A2.E282" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E282.m1" class="ltx_Math" alttext="|\mathfrak{a}^{*}-\mathfrak{b}^{*}|\leq\mathfrak{b}^{*}|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})|\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><msup><mi>𝔟</mi><mo>∗</mo></msup></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msup><mi>𝔞</mi><mo>∗</mo></msup><mo>−</mo><mrow><msub><mi>f</mi><mi>𝐃</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔞</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">|\mathfrak{a}^{*}-\mathfrak{b}^{*}|\leq\mathfrak{b}^{*}|\mathfrak{a}^{*}-f_{\mathbf{D}}(\mathfrak{a}^{*})|\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(282)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.9" class="ltx_p"><span id="A2.SS3.p14.9.1" class="ltx_text">To conclude the proof, we need to bound <math id="A2.SS3.p14.m13" class="ltx_Math" alttext="\mathfrak{b}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔟</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathfrak{b}^{*}</annotation></semantics></math>. To this end, write</span></p>
<table id="A2.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E283"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E283.m1" class="ltx_Math" alttext="\displaystyle\mathfrak{b}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝔟</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\displaystyle\mathfrak{b}^{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E283.m2" class="ltx_Math" alttext="\displaystyle=1+\dfrac{1}{n}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right)\leq 1+\dfrac{1}{n}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{1}(\mathbf{D})\right)\leq 1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{d}(\Sigma_{X})}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1+\dfrac{1}{n}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\right)\leq 1+\dfrac{1}{n}\operatorname{tr}\left(\Sigma_{X}\bar{\operatorname{R}}_{X}^{1}(\mathbf{D})\right)\leq 1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{d}(\Sigma_{X})}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(283)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.10" class="ltx_p"><span id="A2.SS3.p14.10.1" class="ltx_text">which followed from <math id="A2.SS3.p14.m14" class="ltx_Math" alttext="\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\preceq\bar{\operatorname{R}}_{X}^{1}(\mathbf{D})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⪯</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}}(\mathbf{D})\preceq\bar{\operatorname{R}}_{X}^{1}(\mathbf{D})</annotation></semantics></math>, we obtain from (<a href="#A2.E268" title="Equation 268 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">268</span></a>),</span></p>
<table id="A2.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E284"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E284.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{E}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔞</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><mi>𝖤</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\bar{\operatorname{R}}^{\mathfrak{a}^{*}}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{E}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(284)</span></td></tr></tbody>
<tbody id="A2.E285"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E285.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{d}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{d}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(285)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.11" class="ltx_p"><span id="A2.SS3.p14.11.1" class="ltx_text">Finally, from (<a href="#A2.E265" title="Equation 265 ‣ Proof. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">265</span></a>), we have,</span></p>
<table id="A2.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E286"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E286.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{E}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msup><mi>𝔟</mi><mo>∗</mo></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><mi>𝖤</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{X}(\mathbf{D})-\bar{\operatorname{R}}^{\mathfrak{b}^{*}}_{X}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{E}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(286)</span></td></tr></tbody>
<tbody id="A2.E287"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E287.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{d}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{d}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D}))^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{(\eta+\uplambda_{d}(\mathbf{D}))n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(287)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p14.12" class="ltx_p"><span id="A2.SS3.p14.12.1" class="ltx_text">This concludes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Conclusion on the proof of <a href="#Thmtheorem1" title="Theorem 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A2.SS4.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.p1.1" class="ltx_p">We leverage <a href="#Thmproposition1" title="Proposition 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a>, to prove that <math id="A2.SS4.p1.m1" class="ltx_Math" alttext="\hat{\mathcal{E}}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{E}}_{X}(\lambda)</annotation></semantics></math> approximates <math id="A2.SS4.p1.m2" class="ltx_Math" alttext="\mathcal{E}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{X}(\lambda)</annotation></semantics></math>. In all this proof, we set <math id="A2.SS4.p1.m3" class="ltx_Math" alttext="X\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">X\in\mathbb{R}^{d\times n}</annotation></semantics></math> and <math id="A2.SS4.p1.m4" class="ltx_Math" alttext="\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta&gt;0</annotation></semantics></math>, such that <a href="#Thmassumption6" title="H 6 (Lipschitz concentration of the data). ‣ A.2 Discussions on , , ‣ Appendix A In-depth justification of the hypothesis ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">6</span></a> and <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a> are satisfied. We first recall,</p>
<table id="A2.E288" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E288.m1" class="ltx_Math" alttext="\mathcal{E}_{X}(\lambda)=\|\operatorname{R}_{X}(\lambda)-\Sigma_{X}\|_{\mathrm{F}}^{2}\;,\quad\text{for }\lambda&gt;0\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\mathcal{E}_{X}(\lambda)=\|\operatorname{R}_{X}(\lambda)-\Sigma_{X}\|_{\mathrm{F}}^{2}\;,\quad\text{for }\lambda&gt;0\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(288)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p1.2" class="ltx_p">and</p>
<table id="A2.E289" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E289.m1" class="ltx_Math" alttext="\hat{\mathcal{E}}_{X}(\lambda):=\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)^{2}\right)-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)+\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-2}\right)\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo rspace="0.280em">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{\mathcal{E}}_{X}(\lambda):=\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)^{2}\right)-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)+\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-2}\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(289)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p1.3" class="ltx_p">where</p>
<table id="A2.E290" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E290.m1" class="ltx_Math" alttext="\mathfrak{b}(\lambda):=\dfrac{1}{1-d/n+\lambda/n\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mfrac><mn>1</mn><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi>λ</mi><mo>/</mo><mi>n</mi></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mfrac></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\mathfrak{b}(\lambda):=\dfrac{1}{1-d/n+\lambda/n\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(290)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p2" class="ltx_para ltx_noindent">
<p id="A2.SS4.p2.1" class="ltx_p">We will write <math id="A2.SS4.p2.m1" class="ltx_Math" alttext="\Delta\mathcal{E}_{X}(\lambda)=\hat{\mathcal{E}}_{X}(\lambda)-\mathcal{E}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\mathcal{E}_{X}(\lambda)=\hat{\mathcal{E}}_{X}(\lambda)-\mathcal{E}_{X}(\lambda)</annotation></semantics></math>, and we remark that,</p>
<table id="A2.E291" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E291.m1" class="ltx_Math" alttext="\Delta\mathcal{E}_{X}(\lambda)=-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo>−</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\Delta\mathcal{E}_{X}(\lambda)=-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(291)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p3" class="ltx_para ltx_noindent">
<p id="A2.SS4.p3.1" class="ltx_p">We derive the claimed concentration bound by applying <a href="#Thmproposition1" title="Proposition 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a>, first noting that <math id="A2.SS4.p3.m1" class="ltx_Math" alttext="\Delta\mathcal{E}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\mathcal{E}_{X}(\lambda)</annotation></semantics></math> is close to the following quantity with high probability,</p>
<table id="A2.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E292"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E292.m1" class="ltx_Math" alttext="\displaystyle\overline{\Delta\mathcal{E}_{X}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overline{\Delta\mathcal{E}_{X}}(\lambda)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E292.m2" class="ltx_Math" alttext="\displaystyle=-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)+\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(292)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p3.2" class="ltx_p">indeed, we have for all <math id="A2.SS4.p3.m2" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>,</p>
<table id="A2.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E293"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E293.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)-\overline{\Delta\mathcal{E}_{X}}(\lambda)\right|\geq\epsilon\right)\leq\mathbb{P}\left(X\notin\mathsf{A}_{\eta}\right)\lesssim\mathrm{e}^{-c_{X}n}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>X</mi><mo>∉</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>≲</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)-\overline{\Delta\mathcal{E}_{X}}(\lambda)\right|\geq\epsilon\right)\leq\mathbb{P}\left(X\notin\mathsf{A}_{\eta}\right)\lesssim\mathrm{e}^{-c_{X}n}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(293)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p3.3" class="ltx_p">Furthermore, we show that each term in <math id="A2.SS4.p3.m3" class="ltx_Math" alttext="\overline{\Delta\mathcal{E}_{X}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\Delta\mathcal{E}_{X}}(\lambda)</annotation></semantics></math> concentrates around its expectation. We have,</p>
<table id="A2.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E294"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E294.m1" class="ltx_Math" alttext="\displaystyle\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E294.m2" class="ltx_Math" alttext="\displaystyle\leq\dfrac{2(1-d/n)}{\lambda d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{2(1-d/n)}{\lambda d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(294)</span></td></tr></tbody>
<tbody id="A2.E295"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E295.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{2\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)}{\lambda d}\left|\dfrac{1}{\mathfrak{b}(\lambda)}-\mathbb{E}\left[\dfrac{1}{\mathfrak{b}(\lambda)}\right]\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{2\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)}{\lambda d}\left|\dfrac{1}{\mathfrak{b}(\lambda)}-\mathbb{E}\left[\dfrac{1}{\mathfrak{b}(\lambda)}\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(295)</span></td></tr></tbody>
<tbody id="A2.E296"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E296.m1" class="ltx_Math" alttext="\displaystyle\quad+\mathbb{E}\left[\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\right]\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\mathbb{E}\left[\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\right]\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(296)</span></td></tr></tbody>
<tbody id="A2.E297"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E297.m1" class="ltx_Math" alttext="\displaystyle\quad+\left|\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(297)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p4" class="ltx_para ltx_noindent">
<p id="A2.SS4.p4.1" class="ltx_p">Remarking that <math id="A2.SS4.p4.m1" class="ltx_Math" alttext="\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta&gt;0</annotation></semantics></math> implies that <math id="A2.SS4.p4.m2" class="ltx_Math" alttext="d&lt;n" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&lt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d&lt;n</annotation></semantics></math> hence, <math id="A2.SS4.p4.m3" class="ltx_Math" alttext="0\leq 1-d/n\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0\leq 1-d/n\leq 1</annotation></semantics></math>, as well as <math id="A2.SS4.p4.m4" class="ltx_Math" alttext="\operatorname{R}_{X}(\lambda)\preceq\lambda^{-1}\operatorname{I}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⪯</mo><mrow><msup><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\operatorname{R}_{X}(\lambda)\preceq\lambda^{-1}\operatorname{I}_{d}</annotation></semantics></math> and <math id="A2.SS4.p4.m5" class="ltx_Math" alttext="\mathfrak{b}(\lambda)\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathfrak{b}(\lambda)\geq 1</annotation></semantics></math>, we bound the various multiplicative term in the previous inequation as,</p>
<table id="A2.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E298"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E298.m1" class="ltx_Math" alttext="\displaystyle\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E298.m2" class="ltx_Math" alttext="\displaystyle\leq\dfrac{2}{\lambda d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{2}{\lambda d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(298)</span></td></tr></tbody>
<tbody id="A2.E299"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E299.m1" class="ltx_Math" alttext="\displaystyle\quad+2\lambda\dfrac{1}{n}\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right]\right)\right|+\dfrac{2}{\lambda d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+2\lambda\dfrac{1}{n}\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right]\right)\right|+\dfrac{2}{\lambda d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right]\right|</annotation></semantics></math></td>
