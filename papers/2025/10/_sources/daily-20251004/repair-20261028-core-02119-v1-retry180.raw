<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span>Qube Research and Technologies
</span>
<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span>Brandschenkestrasse 5, 8001 Zürich
</span>
<span class="ltx_contact ltx_role_email"><span class="ltx_contact_name">Email: </span><a href="mailto:"><span id="id2" class="ltx_text ltx_font_typewriter">adrien.hardy@qube-rt.com</span></a>
</span></span></span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
