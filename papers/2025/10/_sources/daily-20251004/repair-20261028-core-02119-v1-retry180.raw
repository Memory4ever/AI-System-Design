<th id="S3.T1.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:1.5pt 4.0pt;"><span id="S3.T1.2.1.2.1" class="ltx_text ltx_font_bold">Augmentation Name</span></th>
