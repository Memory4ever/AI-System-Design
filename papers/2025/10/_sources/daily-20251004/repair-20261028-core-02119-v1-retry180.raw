<tbody id="A2.E302"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E302.m1" class="ltx_Math" alttext="\displaystyle\quad+2\left\{\lambda+\dfrac{1}{\lambda}\right\}\dfrac{1}{d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mi>λ</mi><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+2\left\{\lambda+\dfrac{1}{\lambda}\right\}\dfrac{1}{d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(302)</span></td></tr></tbody>
<tbody id="A2.E303"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E303.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{1}{d}\left|\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{1}{d}\left|\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\Sigma_{X}^{-1}\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(303)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p5" class="ltx_para ltx_noindent">
<p id="A2.SS4.p5.1" class="ltx_p">Hence, from a union bound argument, we have,</p>
</div>
<div id="A2.SS4.p6" class="ltx_para ltx_noindent">
<table id="A2.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E305"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E305.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|\geq t\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|\geq t\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E305.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{P}\left(\dfrac{1}{d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(0)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{R}_{X}(0)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\right|\geq\dfrac{\lambda t}{6}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mn>6</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\left(\dfrac{1}{d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(0)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{R}_{X}(0)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\right|\geq\dfrac{\lambda t}{6}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(305)</span></td></tr></tbody>
<tbody id="A2.E306"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E306.m1" class="ltx_Math" alttext="\displaystyle\quad+\mathbb{P}\left(\dfrac{1}{d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\right|\geq\dfrac{t}{6(\lambda+\lambda^{-1})}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mi>t</mi><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>+</mo><msup><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\mathbb{P}\left(\dfrac{1}{d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\right|\geq\dfrac{t}{6(\lambda+\lambda^{-1})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(306)</span></td></tr></tbody>
<tbody id="A2.E307"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E307.m1" class="ltx_Math" alttext="\displaystyle\quad+\mathbb{P}\left(\dfrac{1}{d}\left|\operatorname{tr}\left(\Sigma_{X}^{-1}\{\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\}\right)\right|\geq\dfrac{t}{3}\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mi>t</mi><mn>3</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\mathbb{P}\left(\dfrac{1}{d}\left|\operatorname{tr}\left(\Sigma_{X}^{-1}\{\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\}\right)\right|\geq\dfrac{t}{3}\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(307)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p6.1" class="ltx_p">We now control each of these term, by using the concentration statement of <a href="#Thmproposition1" title="Proposition 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a> every time. We denote,</p>
<table id="A2.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E308"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E308.m1" class="ltx_Math" alttext="\displaystyle\xi_{X}(t)=\dfrac{c_{X}\eta^{3}nt^{2}}{\max\{\|\Sigma_{X}\|_{\mathrm{op}},1\}^{2}(\eta+c_{X}/d)}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ξ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo>/</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\xi_{X}(t)=\dfrac{c_{X}\eta^{3}nt^{2}}{\max\{\|\Sigma_{X}\|_{\mathrm{op}},1\}^{2}(\eta+c_{X}/d)}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(308)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p6.2" class="ltx_p">Then, <a href="#Thmproposition1" title="Proposition 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a> and (<a href="#A2.E305" title="Equation 305 ‣ B.4 Conclusion on the proof of ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">305</span></a>) implies that,</p>
<table id="A2.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E309"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E309.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|\geq t\right)\lesssim\mathrm{e}^{-k\xi(\lambda t/6)}+\mathrm{e}^{-k\xi(t/(6(\lambda+\lambda^{-1})))}+\mathrm{e}^{-k\xi(t/3)}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><mo>≲</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>/</mo><mn>6</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>+</mo><msup><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|\geq t\right)\lesssim\mathrm{e}^{-k\xi(\lambda t/6)}+\mathrm{e}^{-k\xi(t/(6(\lambda+\lambda^{-1})))}+\mathrm{e}^{-k\xi(t/3)}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(309)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p6.3" class="ltx_p">for a universal constant <math id="A2.SS4.p6.m1" class="ltx_Math" alttext="k&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k&gt;0</annotation></semantics></math>. Now remarking that <math id="A2.SS4.p6.m2" class="ltx_Math" alttext="\xi(\lambda t/6)\geq\xi(t/(6(\lambda+\lambda^{-1})))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>/</mo><mn>6</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>+</mo><msup><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi(\lambda t/6)\geq\xi(t/(6(\lambda+\lambda^{-1})))</annotation></semantics></math>, we have,</p>
<table id="A2.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E310"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E310.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|\geq t\right)\lesssim\mathrm{e}^{k^{\prime}\xi(t\min\{1/(\lambda+\lambda^{-1}),1\})}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><mo>≲</mo><msup><mi>e</mi><mrow><msup><mi>k</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>+</mo><msup><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left|\overline{\Delta\mathcal{E}_{X}}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|\geq t\right)\lesssim\mathrm{e}^{k^{\prime}\xi(t\min\{1/(\lambda+\lambda^{-1}),1\})}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(310)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p6.4" class="ltx_p">for a universal constant <math id="A2.SS4.p6.m3" class="ltx_Math" alttext="k^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mo>′</mo></msup><annotation encoding="application/x-tex">k^{\prime}</annotation></semantics></math>. And, we conclude,</p>
<table id="A2.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E311"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E311.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|&gt;t\right)\lesssim\exp\left(-k^{\prime}\dfrac{c_{X}\eta^{3}n\min\{1,\lambda+\frac{1}{\lambda}\}^{2}t^{2}}{\max\{\|\Sigma_{X}\|_{\mathrm{op}},1\}(\eta+c_{X}/d)\}}\right)+\exp\left(-c_{X}n\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><mo>≲</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mrow><mi>λ</mi><mo>+</mo><mfrac><mn>1</mn><mi>λ</mi></mfrac></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><mi>max</mi><mo stretchy="false">{</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><mi>X</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mi>op</mi></msub><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo><mo stretchy="false">(</mo><mi>η</mi><mo>+</mo><mi>c</mi><msub><mrow></mrow><mi>X</mi></msub><mo>/</mo><mi>d</mi><mo stretchy="false">)</mo><mo stretchy="false">}</mo></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|&gt;t\right)\lesssim\exp\left(-k^{\prime}\dfrac{c_{X}\eta^{3}n\min\{1,\lambda+\frac{1}{\lambda}\}^{2}t^{2}}{\max\{\|\Sigma_{X}\|_{\mathrm{op}},1\}(\eta+c_{X}/d)\}}\right)+\exp\left(-c_{X}n\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(311)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p7" class="ltx_para ltx_noindent">
<p id="A2.SS4.p7.1" class="ltx_p">We now bound <math id="A2.SS4.p7.m1" class="ltx_Math" alttext="\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]</annotation></semantics></math>, to this end, write,</p>
<table id="A2.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E312"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E312.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E312.m2" class="ltx_Math" alttext="\displaystyle=-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\mathbb{E}\left[\operatorname{R}_{X}(0)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)+\mathbb{E}\left[\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\mathbb{E}\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\mathbb{E}\left[\operatorname{R}_{X}(0)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)+\mathbb{E}\left[\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\mathbb{E}\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(312)</span></td></tr></tbody>
<tbody id="A2.E313"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E313.m1" class="ltx_Math" alttext="\displaystyle=-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\mathbb{E}\left[\operatorname{R}_{X}(0)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)+\mathbb{E}\left[\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\right]\operatorname{tr}\left(\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\mathbb{E}\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\mathbb{E}\left[\operatorname{R}_{X}(0)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)+\mathbb{E}\left[\dfrac{2}{\lambda\mathfrak{b}(\lambda)d}\right]\operatorname{tr}\left(\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\mathbb{E}\left[\operatorname{R}_{X}(\lambda)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(313)</span></td></tr></tbody>
<tbody id="A2.E314"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E314.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{2}{\lambda}\operatorname{Cov}\left(\dfrac{1}{\mathfrak{b}(\lambda)},\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>λ</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{2}{\lambda}\operatorname{Cov}\left(\dfrac{1}{\mathfrak{b}(\lambda)},\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(314)</span></td></tr></tbody>
<tbody id="A2.E315"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E315.m1" class="ltx_Math" alttext="\displaystyle\lesssim\left\{-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(0)}(0)\right)+\dfrac{2}{\lambda\mathfrak{b}^{*}(\lambda)d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)\right\}\mathbb{P}\left(X\in\mathsf{A}_{\eta}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mo>{</mo><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\left\{-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(0)}(0)\right)+\dfrac{2}{\lambda\mathfrak{b}^{*}(\lambda)d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)\right\}\mathbb{P}\left(X\in\mathsf{A}_{\eta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(315)</span></td></tr></tbody>
<tbody id="A2.E316"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E316.m1" class="ltx_Math" alttext="\displaystyle\quad+\dfrac{2}{\lambda}\operatorname{Cov}\left(\dfrac{1}{\mathfrak{b}(\lambda)},\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>λ</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\dfrac{2}{\lambda}\operatorname{Cov}\left(\dfrac{1}{\mathfrak{b}(\lambda)},\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(316)</span></td></tr></tbody>
<tbody id="A2.E317"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E317.m1" class="ltx_Math" alttext="\displaystyle\quad+\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{1}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{1}(\Sigma_{X})\eta^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\eta n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{1}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{1}(\Sigma_{X})\eta^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\eta n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(317)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p7.2" class="ltx_p">where the last line followed from applying the second deterministic equivalent presented in <a href="#Thmproposition1" title="Proposition 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="A2.SS4.p8" class="ltx_para ltx_noindent">
<p id="A2.SS4.p8.1" class="ltx_p">Recalling the definition of <math id="A2.SS4.p8.m1" class="ltx_Math" alttext="\mathfrak{b}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>𝔟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{b}(\lambda)</annotation></semantics></math>, we have,</p>
<table id="A2.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E318"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E318.m1" class="ltx_Math" alttext="\displaystyle\dfrac{2}{\lambda}\operatorname{Cov}\left(\dfrac{1}{\mathfrak{b}(\lambda)},\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>λ</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{2}{\lambda}\operatorname{Cov}\left(\dfrac{1}{\mathfrak{b}(\lambda)},\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E318.m2" class="ltx_Math" alttext="\displaystyle=\dfrac{2\lambda d/n}{\lambda}\operatorname{Cov}\left(\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right),\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>/</mo><mi>n</mi></mrow><mi>λ</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{2\lambda d/n}{\lambda}\operatorname{Cov}\left(\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right),\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(318)</span></td></tr></tbody>
<tbody id="A2.E319"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E319.m1" class="ltx_Math" alttext="\displaystyle\leq 2\operatorname{Var}\left(\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\operatorname{Var}\left(\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(319)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p8.2" class="ltx_p">which is controlled using <a href="#Thmassumption1" title="H 1 (Concentration of 𝑋). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">1</span></a>, from the fact that <math id="A2.SS4.p8.m2" class="ltx_Math" alttext="\mathbf{X}\mapsto d^{-1}\operatorname{tr}\left(\operatorname{R}_{\mathbf{X}}(\lambda)\right)" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo stretchy="false">↦</mo><mrow><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>𝐗</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{X}\mapsto d^{-1}\operatorname{tr}\left(\operatorname{R}_{\mathbf{X}}(\lambda)\right)</annotation></semantics></math> is <math id="A2.SS4.p8.m3" class="ltx_math_unparsed" alttext="2\lambda^{-3/2}n^{-1/2}d^{1/2}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mi>λ</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>n</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>d</mi><msup><mrow></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2\lambda^{-3/2}n^{-1/2}d^{1/2}</annotation></semantics></math>-lipschitz (from <a href="#Thmlemma6" title="Lemma 6. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">6</span></a>), hence <a href="#Thmassumption1" title="H 1 (Concentration of 𝑋). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">1</span></a> ensures that <math id="A2.SS4.p8.m4" class="ltx_Math" alttext="d^{-1}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d^{-1}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)</annotation></semantics></math> is sub Gaussian, and has variance bounded as,</p>
<table id="A2.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E320"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E320.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}\left(\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right)\lesssim\dfrac{1}{\lambda^{3}nd}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>λ</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}\left(\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{X}(\lambda)\right)\right)\lesssim\dfrac{1}{\lambda^{3}nd}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(320)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p8.3" class="ltx_p">which implies,</p>
<table id="A2.EGx99" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E321"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E321.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E321.m2" class="ltx_Math" alttext="\displaystyle\lesssim\left\{-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(0)}(0)\right)+\dfrac{2}{\lambda\mathfrak{b}^{*}(\lambda)d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)\right\}\mathbb{P}\left(X\in\mathsf{A}_{\eta}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mo>{</mo><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\left\{-\dfrac{2(1-d/n)}{\lambda d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(0)}(0)\right)+\dfrac{2}{\lambda\mathfrak{b}^{*}(\lambda)d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)\right\}\mathbb{P}\left(X\in\mathsf{A}_{\eta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(321)</span></td></tr></tbody>
<tbody id="A2.E322"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E322.m1" class="ltx_Math" alttext="\displaystyle\quad+\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{1}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{1}(\Sigma_{X})\eta^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\eta n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)+\dfrac{1}{\lambda^{3}nd}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>λ</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{1}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{1}(\Sigma_{X})\eta^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\eta n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)+\dfrac{1}{\lambda^{3}nd}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(322)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p9" class="ltx_para ltx_noindent">
<p id="A2.SS4.p9.1" class="ltx_p">Now, we remark that by definition <math id="A2.SS4.p9.m1" class="ltx_Math" alttext="\mathfrak{b}^{*}(0)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{b}^{*}(0)</annotation></semantics></math> is the unique fixed point of <math id="A2.SS4.p9.m2" class="ltx_Math" alttext="f_{0}(\mathfrak{b})=1+\mathfrak{b}d/n" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi>𝔟</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>/</mo><mi>n</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{0}(\mathfrak{b})=1+\mathfrak{b}d/n</annotation></semantics></math>, which gives, <math id="A2.SS4.p9.m3" class="ltx_Math" alttext="\mathfrak{b}^{*}(0)=(1-d/n)^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathfrak{b}^{*}(0)=(1-d/n)^{-1}</annotation></semantics></math>, hence,</p>
<table id="A2.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E323"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E323.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E323.m2" class="ltx_Math" alttext="\displaystyle\leq\left\{-\dfrac{2}{\lambda d}\operatorname{tr}\left(\Sigma_{X}^{-1}\right)+\dfrac{2}{\lambda\mathfrak{b}^{*}(\lambda)d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)\right\}\mathbb{P}\left(X\in\mathsf{A}_{\eta}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>{</mo><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\{-\dfrac{2}{\lambda d}\operatorname{tr}\left(\Sigma_{X}^{-1}\right)+\dfrac{2}{\lambda\mathfrak{b}^{*}(\lambda)d}\operatorname{tr}\left(\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)-\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-1}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\right)\right\}\mathbb{P}\left(X\in\mathsf{A}_{\eta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(323)</span></td></tr></tbody>
<tbody id="A2.E324"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E324.m1" class="ltx_Math" alttext="\displaystyle\quad+\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{1}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{1}(\Sigma_{X})\eta^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\eta n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)+\dfrac{1}{\lambda^{3}nd}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>λ</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{1}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{1}(\Sigma_{X})\eta^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\eta n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)+\dfrac{1}{\lambda^{3}nd}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(324)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p9.2" class="ltx_p">Finally, using the identity <math id="A2.SS4.p9.m4" class="ltx_Math" alttext="\mathbf{A}^{-1}-\mathbf{B}^{-1}=\mathbf{A}^{-1}\{\mathbf{B}-\mathbf{A}\}\mathbf{B}^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mi>𝐁</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>=</mo><mrow><msup><mi>𝐀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mi>𝐁</mi><mo>−</mo><mi>𝐀</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}^{-1}-\mathbf{B}^{-1}=\mathbf{A}^{-1}\{\mathbf{B}-\mathbf{A}\}\mathbf{B}^{-1}</annotation></semantics></math>, we get,</p>
<table id="A2.E325" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E325.m1" class="ltx_Math" alttext="\dfrac{1}{\mathfrak{b}^{*}(\lambda)}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)-\Sigma_{X}^{-1}=\lambda\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\Sigma_{X}^{-1}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><mrow><msup><mi>𝔟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\dfrac{1}{\mathfrak{b}^{*}(\lambda)}\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)-\Sigma_{X}^{-1}=\lambda\bar{\operatorname{R}}_{X}^{\mathfrak{b}^{*}(\lambda)}(\lambda)\Sigma_{X}^{-1}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(325)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p9.3" class="ltx_p">we thus conclude on the bias of <math id="A2.SS4.p9.m5" class="ltx_Math" alttext="\hat{\mathcal{E}}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{E}}_{X}(\lambda)</annotation></semantics></math> as,</p>
<table id="A2.E326" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E326.m1" class="ltx_Math" alttext="\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\lesssim\underbrace{\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{1}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{1}(\Sigma_{X})\eta^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\eta n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)+\dfrac{1}{\lambda^{3}nd}}_{B(n)}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≲</mo><munder><munder accentunder="true"><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>6</mn></msup></mrow></mfrac><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mi>n</mi></mfrac><mo>+</mo><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mn>1</mn><mrow><msup><mi>λ</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></munder></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\lesssim\underbrace{\left(1+\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n\uplambda_{1}(\Sigma_{X})}\right)\left(\dfrac{q\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{1}(\Sigma_{X})\eta^{6}}+\left(\dfrac{d\|\Sigma_{X}\|_{\mathrm{op}}}{n}+\dfrac{d^{2}\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\eta n^{2}}\right)\mathrm{e}^{-c_{X}n}\right)+\dfrac{1}{\lambda^{3}nd}}_{B(n)}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(326)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p9.4" class="ltx_p">and, merging the previous equation with (<a href="#A2.E311" title="Equation 311 ‣ B.4 Conclusion on the proof of ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">311</span></a>), we get a universal constant <math id="A2.SS4.p9.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, and the function <math id="A2.SS4.p9.m7" class="ltx_Math" alttext="B(n)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(n)</annotation></semantics></math> defined above,</p>
<table id="A2.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E327"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E327.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)\right|&gt;t+B(n)\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>&gt;</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)\right|&gt;t+B(n)\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E327.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)\right|&gt;t+\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]|\right)\leq\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|\geq t\right)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>ℙ</mi><mrow><mo>(</mo><mo fence="false" rspace="0.167em">|</mo><mi mathvariant="normal">Δ</mi><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">&gt;</mo><mi>t</mi><mo>+</mo><mi>𝔼</mi><mrow><mo>[</mo><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>)</mo></mrow><mo>≤</mo><mi>ℙ</mi><mrow><mo>(</mo><mo fence="false" rspace="0.167em">|</mo><mi mathvariant="normal">Δ</mi><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝔼</mi><mrow><mo>[</mo><mover accent="true"><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub></mrow><mo stretchy="true">¯</mo></mover><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≥</mo><mi>t</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)\right|&gt;t+\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]|\right)\leq\mathbb{P}\left(\left|\Delta\mathcal{E}_{X}(\lambda)-\mathbb{E}\left[\overline{\Delta\mathcal{E}_{X}}(\lambda)\right]\right|\geq t\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(327)</span></td></tr></tbody>
<tbody id="A2.E328"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E328.m1" class="ltx_Math" alttext="\displaystyle\lesssim\exp\left(-k\dfrac{c_{X}\eta^{3}n\min\{1,\lambda+\frac{1}{\lambda}\}^{2}t^{2}}{\max\{\|\Sigma_{X}\|_{\mathrm{op}},1\}(\eta+c_{X}/d)\}}\right)+\exp\left(-c_{X}n\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mrow><mi>λ</mi><mo>+</mo><mfrac><mn>1</mn><mi>λ</mi></mfrac></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><mi>max</mi><mo stretchy="false">{</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><mi>X</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mi>op</mi></msub><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo><mo stretchy="false">(</mo><mi>η</mi><mo>+</mo><mi>c</mi><msub><mrow></mrow><mi>X</mi></msub><mo>/</mo><mi>d</mi><mo stretchy="false">)</mo><mo stretchy="false">}</mo></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\exp\left(-k\dfrac{c_{X}\eta^{3}n\min\{1,\lambda+\frac{1}{\lambda}\}^{2}t^{2}}{\max\{\|\Sigma_{X}\|_{\mathrm{op}},1\}(\eta+c_{X}/d)\}}\right)+\exp\left(-c_{X}n\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(328)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p10" class="ltx_para ltx_noindent">
<p id="A2.SS4.p10.1" class="ltx_p">which terminates the proof of <a href="#Thmtheorem1" title="Theorem 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>A deterministic equivalent for resolvent matrices of augmented sample covariances</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">In this section we generalize <a href="#Thmproposition1" title="Proposition 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a> to the setting where a
non-negligible proportion of the dataset is produced by a data-augmentation scheme. We consider the
augmented dataset <math id="A3.p1.m1" class="ltx_Math" alttext="[X_{1},\ldots,X_{n},G_{1},\ldots,G_{m}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><mi>m</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[X_{1},\ldots,X_{n},G_{1},\ldots,G_{m}]</annotation></semantics></math>, where the two blocks
<math id="A3.p1.m2" class="ltx_Math" alttext="[X_{1},\ldots,X_{n}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[X_{1},\ldots,X_{n}]</annotation></semantics></math> and <math id="A3.p1.m3" class="ltx_Math" alttext="[G_{1},\ldots,G_{m}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><mi>m</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[G_{1},\ldots,G_{m}]</annotation></semantics></math> satisfy <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a>–<a href="#Thmassumption6" title="H 6 (Lipschitz concentration of the data). ‣ A.2 Discussions on , , ‣ Appendix A In-depth justification of the hypothesis ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">6</span></a>.
The proof follows the non-augmented case presented in <a href="#A2" title="Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">B</span></a>.</p>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent">
<p id="A3.p2.1" class="ltx_p">We begin with the following technical lemma, which will be used to derive concentration for the
augmented resolvent matrix <math id="A3.p2.m1" class="ltx_Math" alttext="\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})</annotation></semantics></math>.</p>
</div>
<div id="Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmlemma7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma7.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma7.p1.1" class="ltx_p"><span id="Thmlemma7.p1.1.1" class="ltx_text ltx_font_italic">Assume <math id="Thmlemma7.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="Thmlemma7.p1.m2" class="ltx_Math" alttext="\nu_{X}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\nu_{X}</annotation></semantics></math> satisfy <a href="#Thmassumption6" title="H 6 (Lipschitz concentration of the data). ‣ A.2 Discussions on , , ‣ Appendix A In-depth justification of the hypothesis ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">6</span></a> and <a href="#Thmassumption4" title="H 4 (Smoothness of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">4</span></a>, let <math id="Thmlemma7.p1.m3" class="ltx_Math" alttext="f:\mathbb{R}^{d\times n}\times\mathbb{R}^{d\times m}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}^{d\times n}\times\mathbb{R}^{d\times m}\to\mathbb{R}</annotation></semantics></math> be a <math id="Thmlemma7.p1.m4" class="ltx_Math" alttext="\mathtt{L}_{f}" display="inline" intent=":literal"><semantics><msub><mi>𝙻</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\mathtt{L}_{f}</annotation></semantics></math>-Lispchitz function on <math id="Thmlemma7.p1.m5" class="ltx_Math" alttext="\mathsf{A}_{\eta}\times\mathbb{R}^{d\times m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖠</mi><mi>η</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathsf{A}_{\eta}\times\mathbb{R}^{d\times m}</annotation></semantics></math>. Then for any <math id="Thmlemma7.p1.m6" class="ltx_Math" alttext="\mathbf{X},\mathbf{Y}\in\mathsf{A}_{\eta}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐗</mi><mo>,</mo><mi>𝐘</mi></mrow><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{X},\mathbf{Y}\in\mathsf{A}_{\eta}</annotation></semantics></math>,</span></p>
<table id="A3.E329" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E329.m1" class="ltx_Math" alttext="\left|\int f(\mathbf{X},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)-\int f(\mathbf{Y},g)\nu_{\mathbf{Y}}^{\otimes m}(\mathrm{d}g)\right|\leq\mathtt{L}_{f}\left(1+\sqrt{m}\mathtt{L}_{G}\right)\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mo lspace="0em">∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐘</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msub><mi>𝙻</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mi>G</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\int f(\mathbf{X},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)-\int f(\mathbf{Y},g)\nu_{\mathbf{Y}}^{\otimes m}(\mathrm{d}g)\right|\leq\mathtt{L}_{f}\left(1+\sqrt{m}\mathtt{L}_{G}\right)\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(329)</span></td></tr></tbody>
</table>
<p id="Thmlemma7.p1.2" class="ltx_p"><span id="Thmlemma7.p1.2.1" class="ltx_text ltx_font_italic">i.e, <math id="Thmlemma7.p1.m7" class="ltx_Math" alttext="\mathbf{X}\mapsto\int f(\mathbf{X},g)d\nu_{\mathbf{X}}^{\otimes m}(dg)" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo rspace="0.111em" stretchy="false">↦</mo><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{X}\mapsto\int f(\mathbf{X},g)d\nu_{\mathbf{X}}^{\otimes m}(dg)</annotation></semantics></math> is <math id="Thmlemma7.p1.m8" class="ltx_Math" alttext="\mathtt{L}_{f}(1+\mathtt{L}_{G})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝙻</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>𝙻</mi><mi>G</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathtt{L}_{f}(1+\mathtt{L}_{G})</annotation></semantics></math> Lispchitz on <math id="Thmlemma7.p1.m9" class="ltx_Math" alttext="\mathsf{A}_{\eta}" display="inline" intent=":literal"><semantics><msub><mi>𝖠</mi><mi>η</mi></msub><annotation encoding="application/x-tex">\mathsf{A}_{\eta}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p3" class="ltx_para">
<p id="A3.p3.1" class="ltx_p"><span id="A3.p3.1.1" class="ltx_text">Using <a href="#Thmassumption1" title="H 1 (Concentration of 𝑋). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">1</span></a> and <a href="#Thmassumption4" title="H 4 (Smoothness of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">4</span></a>, we have</span></p>
<table id="A3.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E330"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E330.m1" class="ltx_Math" alttext="\displaystyle\left|\int f(\mathbf{X},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)-\int f(\mathbf{Y},g)\nu_{\mathbf{Y}}^{\otimes m}(\mathrm{d}g)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><mo>−</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐘</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\int f(\mathbf{X},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)-\int f(\mathbf{Y},g)\nu_{\mathbf{Y}}^{\otimes m}(\mathrm{d}g)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(330)</span></td></tr></tbody>
<tbody id="A3.E331"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E331.m1" class="ltx_Math" alttext="\displaystyle\leq\left|\int f(\mathbf{X},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)-\int f(\mathbf{Y},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)\right|+\left|\int f(\mathbf{Y},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)-\int f(\mathbf{Y},g)\nu_{\mathbf{Y}}^{\otimes m}(\mathrm{d}g)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><mo>−</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><mo>−</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐘</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\int f(\mathbf{X},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)-\int f(\mathbf{Y},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)\right|+\left|\int f(\mathbf{Y},g)\nu_{\mathbf{X}}^{\otimes m}(\mathrm{d}g)-\int f(\mathbf{Y},g)\nu_{\mathbf{Y}}^{\otimes m}(\mathrm{d}g)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(331)</span></td></tr></tbody>
<tbody id="A3.E332"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E332.m1" class="ltx_Math" alttext="\displaystyle\leq\mathtt{L}_{f}\left\|\mathbf{X}-\mathbf{Y}\right\|_{\mathrm{F}}+\mathtt{L}_{f}W_{1}(\nu_{\mathbf{X}}^{\otimes m},\nu_{\mathbf{Y}}^{\otimes m})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>𝙻</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><msub><mi>𝙻</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo>,</mo><msubsup><mi>ν</mi><mi>𝐘</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathtt{L}_{f}\left\|\mathbf{X}-\mathbf{Y}\right\|_{\mathrm{F}}+\mathtt{L}_{f}W_{1}(\nu_{\mathbf{X}}^{\otimes m},\nu_{\mathbf{Y}}^{\otimes m})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(332)</span></td></tr></tbody>
<tbody id="A3.E333"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E333.m1" class="ltx_Math" alttext="\displaystyle\leq\mathtt{L}_{f}\left\|\mathbf{X}-\mathbf{Y}\right\|_{\mathrm{F}}+\mathtt{L}_{f}\sqrt{m}\mathtt{L}_{G}\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>𝙻</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><msub><mi>𝙻</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathtt{L}_{f}\left\|\mathbf{X}-\mathbf{Y}\right\|_{\mathrm{F}}+\mathtt{L}_{f}\sqrt{m}\mathtt{L}_{G}\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(333)</span></td></tr></tbody>
<tbody id="A3.E334"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E334.m1" class="ltx_Math" alttext="\displaystyle=\mathtt{L}_{f}\left(1+\sqrt{m}\mathtt{L}_{G}\right)\left\|\mathbf{X}-\mathbf{Y}\right\|_{\mathrm{F}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝙻</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mi>G</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathtt{L}_{f}\left(1+\sqrt{m}\mathtt{L}_{G}\right)\left\|\mathbf{X}-\mathbf{Y}\right\|_{\mathrm{F}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(334)</span></td></tr></tbody>
</table>
<p id="A3.p3.2" class="ltx_p"><span id="A3.p3.2.1" class="ltx_text">Where the last upper bound followed from <a href="#Thmassumption4" title="H 4 (Smoothness of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">4</span></a>.
∎</span></p>
</div>
</div>
<div id="A3.p4" class="ltx_para ltx_noindent">
<p id="A3.p4.1" class="ltx_p">We further recall the following notation for any positive semi-definite matrix <math id="A3.p4.m1" class="ltx_Math" alttext="\mathbf{D}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{D}\in\mathbb{R}^{d\times d}</annotation></semantics></math>, and two dilation factors <math id="A3.p4.m2" class="ltx_Math" alttext="\mathfrak{a}_{x}" display="inline" intent=":literal"><semantics><msub><mi>𝔞</mi><mi>x</mi></msub><annotation encoding="application/x-tex">\mathfrak{a}_{x}</annotation></semantics></math> and <math id="A3.p4.m3" class="ltx_Math" alttext="\mathfrak{a}_{g}" display="inline" intent=":literal"><semantics><msub><mi>𝔞</mi><mi>g</mi></msub><annotation encoding="application/x-tex">\mathfrak{a}_{g}</annotation></semantics></math>.</p>
<table id="A3.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E335"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E335.m1" class="ltx_Math" alttext="\displaystyle\operatorname{R}_{\mathrm{Aug}}(\mathbf{D}):=\left(C_{\mathrm{Aug}}+\mathbf{D}\right)^{-1}=\left((1-\alpha)C_{X}+\alpha C_{G}+\mathbf{D}\right)^{-1}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msup><mrow><mo>(</mo><mrow><msub><mi>C</mi><mi>Aug</mi></msub><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>G</mi></msub></mrow><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{R}_{\mathrm{Aug}}(\mathbf{D}):=\left(C_{\mathrm{Aug}}+\mathbf{D}\right)^{-1}=\left((1-\alpha)C_{X}+\alpha C_{G}+\mathbf{D}\right)^{-1}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(335)</span></td></tr></tbody>
</table>
<p id="A3.p4.2" class="ltx_p">and,</p>
<table id="A3.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E336"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E336.m1" class="ltx_Math" alttext="\displaystyle\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x},\mathfrak{a}_{g})}(\mathbf{D}):=\left(\dfrac{1-(1-\beta/\mathfrak{a}_{g})\alpha}{\mathfrak{a}_{x}}\Sigma_{X}+\dfrac{\alpha}{\mathfrak{a}_{g}}\bar{\Lambda}_{G}+\mathbf{D}\right)^{-1}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>Aug</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔞</mi><mi>x</mi></msub><mo>,</mo><msub><mi>𝔞</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msup><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>/</mo><msub><mi>𝔞</mi><mi>g</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><msub><mi>𝔞</mi><mi>x</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><msub><mi>𝔞</mi><mi>g</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x},\mathfrak{a}_{g})}(\mathbf{D}):=\left(\dfrac{1-(1-\beta/\mathfrak{a}_{g})\alpha}{\mathfrak{a}_{x}}\Sigma_{X}+\dfrac{\alpha}{\mathfrak{a}_{g}}\bar{\Lambda}_{G}+\mathbf{D}\right)^{-1}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(336)</span></td></tr></tbody>
</table>
<p id="A3.p4.3" class="ltx_p">where <math id="A3.p4.m4" class="ltx_Math" alttext="\bar{\Lambda}_{G}=\mathbb{E}\left[\Lambda_{G}(X)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{\Lambda}_{G}=\mathbb{E}\left[\Lambda_{G}(X)\right]</annotation></semantics></math>.</p>
</div>
<div id="A3.p5" class="ltx_para ltx_noindent">
<p id="A3.p5.1" class="ltx_p">We prove the following result,</p>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem4.p1.1" class="ltx_p"><span id="Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Assume that <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a> to <a href="#Thmassumption6" title="H 6 (Lipschitz concentration of the data). ‣ A.2 Discussions on , , ‣ Appendix A In-depth justification of the hypothesis ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">6</span></a> hold. Let <math id="Thmtheorem4.p1.m1" class="ltx_Math" alttext="\mathbf{B}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐁</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{B}\in\mathbb{R}^{d\times d}</annotation></semantics></math>, and let <math id="Thmtheorem4.p1.m2" class="ltx_Math" alttext="\mathbf{D}" display="inline" intent=":literal"><semantics><mi>𝐃</mi><annotation encoding="application/x-tex">\mathbf{D}</annotation></semantics></math> be a positive semi-definite matrix. We define <math id="Thmtheorem4.p1.m3" class="ltx_Math" alttext="(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})</annotation></semantics></math> as,</span></p>
<table id="A3.E337" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E337.m1" class="ltx_Math" alttext="\mathfrak{a}_{x}^{*}=1+\dfrac{1-(1-\beta/\mathfrak{a}_{g}^{*})\alpha}{n}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\;,\quad\mathfrak{a}_{g}^{*}=1+\dfrac{\alpha}{m}\operatorname{tr}\left(\mathbb{E}\left[\left\{\beta C_{X}+\Lambda_{G}(X)\right\}\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>/</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mfrac><mi>α</mi><mi>m</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathfrak{a}_{x}^{*}=1+\dfrac{1-(1-\beta/\mathfrak{a}_{g}^{*})\alpha}{n}\operatorname{tr}\left(\Sigma_{X}\mathbb{E}\left[\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\;,\quad\mathfrak{a}_{g}^{*}=1+\dfrac{\alpha}{m}\operatorname{tr}\left(\mathbb{E}\left[\left\{\beta C_{X}+\Lambda_{G}(X)\right\}\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(337)</span></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.2" class="ltx_p"><span id="Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">Then, we have for a universal constant <math id="Thmtheorem4.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>,</span></p>
<table id="A3.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E338"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E338.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\left|\dfrac{1}{d}\operatorname{tr}\left(\mathbf{B}\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\}\right)\right|\geq t\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐁</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\left|\dfrac{1}{d}\operatorname{tr}\left(\mathbf{B}\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\}\right)\right|\geq t\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(338)</span></td></tr></tbody>
<tbody id="A3.E339"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E339.m1" class="ltx_Math" alttext="\displaystyle\quad\leq 2\exp\left(-k\dfrac{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}t^{2}}{\alpha(1+\sqrt{m}\mathtt{L}_{G})^{2}/d+(1-\alpha)\sigma_{G}^{2}/d+(\eta+\uplambda_{d}(\mathbf{D}))\sigma_{G}^{2}}\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mi>G</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>G</mi><mn>2</mn></msubsup></mrow><mo>/</mo><mi>d</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>G</mi><mn>2</mn></msubsup></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq 2\exp\left(-k\dfrac{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}t^{2}}{\alpha(1+\sqrt{m}\mathtt{L}_{G})^{2}/d+(1-\alpha)\sigma_{G}^{2}/d+(\eta+\uplambda_{d}(\mathbf{D}))\sigma_{G}^{2}}\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(339)</span></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.3" class="ltx_p"><span id="Thmtheorem4.p1.3.1" class="ltx_text ltx_font_italic">And,</span></p>
<table id="A3.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E340"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E340.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})-\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>Aug</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})-\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(340)</span></td></tr></tbody>
<tbody id="A3.E341"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E341.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\dfrac{\alpha^{5}(\kappa q_{1}+q_{2})\sqrt{d}\left\{\sigma_{G}^{2}(\beta^{3}\|\Sigma_{X}\|_{\mathrm{op}}^{3}+\kappa^{3})+\sigma_{X}^{12}\|\Sigma_{X}\|_{\mathrm{op}}\uplambda_{d}(\Sigma_{X})^{-1}n^{-1/2}d^{-1}\right\}}{n((1-\alpha)\eta+\uplambda_{d}(\mathbf{D}))^{6}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><msup><mrow></mrow><mn>5</mn></msup><mo stretchy="false">(</mo><mi>κ</mi><mi>q</mi><msub><mrow></mrow><mn>1</mn></msub><mo>+</mo><mi>q</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo><msqrt><mi>d</mi></msqrt><mo>{</mo><mi>σ</mi><msub><mrow></mrow><mi>G</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">(</mo><mi>β</mi><msup><mrow></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><mi>X</mi></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mi>op</mi></msub><msup><mrow></mrow><mn>3</mn></msup><mo lspace="0em">+</mo><mi>κ</mi><msup><mrow></mrow><mn>3</mn></msup><mo stretchy="false">)</mo><mo>+</mo><mi>σ</mi><msub><mrow></mrow><mi>X</mi></msub><msup><mrow></mrow><mn>12</mn></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><mi>X</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mi>op</mi></msub><mi mathvariant="normal">λ</mi><msub><mrow></mrow><mi>d</mi></msub><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><mi>X</mi></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>n</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>d</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>}</mo></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\dfrac{\alpha^{5}(\kappa q_{1}+q_{2})\sqrt{d}\left\{\sigma_{G}^{2}(\beta^{3}\|\Sigma_{X}\|_{\mathrm{op}}^{3}+\kappa^{3})+\sigma_{X}^{12}\|\Sigma_{X}\|_{\mathrm{op}}\uplambda_{d}(\Sigma_{X})^{-1}n^{-1/2}d^{-1}\right\}}{n((1-\alpha)\eta+\uplambda_{d}(\mathbf{D}))^{6}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(341)</span></td></tr></tbody>
<tbody id="A3.E342"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E342.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+\dfrac{\alpha\beta(1-\alpha^{\prime})^{-1}+1}{(1-\alpha)\eta+\uplambda_{d}(\mathbf{D})}\dfrac{\alpha\beta\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3/2}m}\left\{\dfrac{\sqrt{d}}{\sqrt{n+m}}(1+u(n))+\dfrac{1}{\sqrt{n+m}}+\sqrt{\alpha}\mathtt{L}_{G}+(1+c_{X}^{-1/2})\sqrt{\eta+\uplambda_{d}(\mathbf{D})}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mstyle><mrow><mo>{</mo><mstyle displaystyle="true"><mfrac><msqrt><mi>d</mi></msqrt><msqrt><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow></msqrt></mfrac></mstyle><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow></msqrt></mfrac></mstyle><mo>+</mo><msqrt><mi>α</mi></msqrt><msub><mi>𝙻</mi><mi>G</mi></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msubsup><mi>c</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><msqrt><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\dfrac{\alpha\beta(1-\alpha^{\prime})^{-1}+1}{(1-\alpha)\eta+\uplambda_{d}(\mathbf{D})}\dfrac{\alpha\beta\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3/2}m}\left\{\dfrac{\sqrt{d}}{\sqrt{n+m}}(1+u(n))+\dfrac{1}{\sqrt{n+m}}+\sqrt{\alpha}\mathtt{L}_{G}+(1+c_{X}^{-1/2})\sqrt{\eta+\uplambda_{d}(\mathbf{D})}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(342)</span></td></tr></tbody>
<tbody id="A3.E343"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E343.m1" class="ltx_Math" alttext="\displaystyle\qquad+\dfrac{\alpha\beta(1-\alpha^{\prime})^{-1}+1}{(1-\alpha)\eta+\uplambda_{d}(\mathbf{D})}\dfrac{\alpha\sqrt{d}\|\bar{\Lambda}_{G}\|_{\mathrm{op}}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3/2}m}\left(\dfrac{\mathbb{E}\left[\|\Lambda_{G}(X)-\bar{\Lambda}_{G}\|_{\mathrm{F}}\right]\sqrt{\eta+\uplambda_{d}(\mathbf{D})}}{\|\bar{\Lambda}_{G}\|_{\mathrm{op}}}+\sqrt{\alpha}\mathtt{L}_{G}+\dfrac{1+\sqrt{\eta+\uplambda_{d}(\mathbf{D})}}{\sqrt{n}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mfrac></mstyle><mo>+</mo><mrow><msqrt><mi>α</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mi>G</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><msqrt><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow><msqrt><mi>n</mi></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\dfrac{\alpha\beta(1-\alpha^{\prime})^{-1}+1}{(1-\alpha)\eta+\uplambda_{d}(\mathbf{D})}\dfrac{\alpha\sqrt{d}\|\bar{\Lambda}_{G}\|_{\mathrm{op}}}{(\eta+\uplambda_{d}(\mathbf{D}))^{3/2}m}\left(\dfrac{\mathbb{E}\left[\|\Lambda_{G}(X)-\bar{\Lambda}_{G}\|_{\mathrm{F}}\right]\sqrt{\eta+\uplambda_{d}(\mathbf{D})}}{\|\bar{\Lambda}_{G}\|_{\mathrm{op}}}+\sqrt{\alpha}\mathtt{L}_{G}+\dfrac{1+\sqrt{\eta+\uplambda_{d}(\mathbf{D})}}{\sqrt{n}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(343)</span></td></tr></tbody>
<tbody id="A3.E344"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E344.m1" class="ltx_Math" alttext="\displaystyle\qquad+\dfrac{\mathbb{E}\left[\|\Lambda_{G}(X)-\bar{\Lambda}_{G}\|_{\mathrm{F}}\right]}{((1-\alpha)\eta+\uplambda_{d}(\mathbf{D}))^{2}}+\dfrac{1}{1-\alpha^{\prime}}\dfrac{q_{3}\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D})/(1-\alpha^{\prime}))^{6}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>]</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\dfrac{\mathbb{E}\left[\|\Lambda_{G}(X)-\bar{\Lambda}_{G}\|_{\mathrm{F}}\right]}{((1-\alpha)\eta+\uplambda_{d}(\mathbf{D}))^{2}}+\dfrac{1}{1-\alpha^{\prime}}\dfrac{q_{3}\sqrt{d}\|\Sigma_{X}\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\Sigma_{X})(\eta+\uplambda_{d}(\mathbf{D})/(1-\alpha^{\prime}))^{6}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(344)</span></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.4" class="ltx_p"><span id="Thmtheorem4.p1.4.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem4.p1.m5" class="ltx_Math" alttext="\alpha^{\prime}=\alpha-\alpha\beta/\mathfrak{a}_{g}^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>α</mi><mo>−</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>/</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha^{\prime}=\alpha-\alpha\beta/\mathfrak{a}_{g}^{*}</annotation></semantics></math>, <math id="Thmtheorem4.p1.m6" class="ltx_Math" alttext="q_{1},q_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><msub><mi>q</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">q_{1},q_{2}</annotation></semantics></math> and <math id="Thmtheorem4.p1.m7" class="ltx_Math" alttext="q_{3}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mn>3</mn></msub><annotation encoding="application/x-tex">q_{3}</annotation></semantics></math> are polynomials in <math id="Thmtheorem4.p1.m8" class="ltx_Math" alttext="\eta+\uplambda_{d}(\mathbf{D}),\uplambda_{d}(\Sigma_{X}),\|\Sigma_{X}\|_{\mathrm{op}}^{-1},c_{X}^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">\eta+\uplambda_{d}(\mathbf{D}),\uplambda_{d}(\Sigma_{X}),\|\Sigma_{X}\|_{\mathrm{op}}^{-1},c_{X}^{-1}</annotation></semantics></math>, and <math id="Thmtheorem4.p1.m9" class="ltx_Math" alttext="n^{-1}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">n^{-1}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p6" class="ltx_para ltx_noindent">
<p id="A3.p6.1" class="ltx_p"><span id="A3.p6.1.1" class="ltx_text">Following the proof of <a href="#Thmproposition1" title="Proposition 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a>, we consider only the simpler case of <math id="A3.p6.m1" class="ltx_Math" alttext="\sigma_{X}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>X</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sigma_{X}=1</annotation></semantics></math> (the general case readily follows by considering <math id="A3.p6.m2" class="ltx_Math" alttext="X/\sigma_{X}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>/</mo><msub><mi>σ</mi><mi>X</mi></msub></mrow><annotation encoding="application/x-tex">X/\sigma_{X}</annotation></semantics></math> and <math id="A3.p6.m3" class="ltx_Math" alttext="G/\sigma_{X}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>/</mo><msub><mi>σ</mi><mi>X</mi></msub></mrow><annotation encoding="application/x-tex">G/\sigma_{X}</annotation></semantics></math>.) we prove the two statements of the theorem independantly. First focusing on the concentration of <math id="A3.p6.m4" class="ltx_Math" alttext="d^{-1}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d^{-1}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\right)</annotation></semantics></math>.</span></p>
</div>
<div id="A3.p7" class="ltx_para ltx_noindent">
<p id="A3.p7.1" class="ltx_p"><span id="A3.p7.1.1" class="ltx_text ltx_font_bold">Proof of the concentration inequality.<span id="A3.p7.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A3.p8" class="ltx_para ltx_noindent">
<p id="A3.p8.1" class="ltx_p"><span id="A3.p8.1.1" class="ltx_text">Let <math id="A3.p8.m1" class="ltx_Math" alttext="\mathbf{B}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐁</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{B}\in\mathbb{R}^{d\times d}</annotation></semantics></math> be any squared matrix, for notation simplicity we will denote <math id="A3.p8.m2" class="ltx_Math" alttext="h_{\mathbf{B}}:\mathbf{X},\mathbf{G}\mapsto d^{-1}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{\mathbf{X}\sqcup\mathbf{G}}(\mathbf{D})\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(\mathbf{X})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝐗</mi></mrow><mo>,</mo><mrow><mi>𝐆</mi><mo stretchy="false">↦</mo><mrow><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐁</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mrow><mi>𝐗</mi><mo>⊔</mo><mi>𝐆</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{\mathbf{B}}:\mathbf{X},\mathbf{G}\mapsto d^{-1}\operatorname{tr}\left(\mathbf{B}\operatorname{R}_{\mathbf{X}\sqcup\mathbf{G}}(\mathbf{D})\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(\mathbf{X})</annotation></semantics></math> as well as <math id="A3.p8.m3" class="ltx_Math" alttext="\tilde{X}=X\sqcup G" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>X</mi><mo>⊔</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{X}=X\sqcup G</annotation></semantics></math> (for <math id="A3.p8.m4" class="ltx_Math" alttext="\sqcup" display="inline" intent=":literal"><semantics><mo>⊔</mo><annotation encoding="application/x-tex">\sqcup</annotation></semantics></math> being the column-wise concatenation operator), so that we simply need to bound the cumulative probality function of <math id="A3.p8.m5" class="ltx_Math" alttext="h_{\mathbf{B}}(\tilde{X})-\mathbb{E}[h_{\mathbf{B}}(\tilde{X})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{\mathbf{B}}(\tilde{X})-\mathbb{E}[h_{\mathbf{B}}(\tilde{X})]</annotation></semantics></math>.
To do so, we first bound its moment generating function, for any scalar <math id="A3.p8.m6" class="ltx_Math" alttext="s\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">s\in\mathbb{R}</annotation></semantics></math>,</span></p>
<table id="A3.EGx107" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E345"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E345.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\right]\right\}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\right]\right\}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(345)</span></td></tr></tbody>
<tbody id="A3.E346"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E346.m1" class="ltx_Math" alttext="\displaystyle\quad=\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]\right\}\right)\cdot\exp\left(s\left\{\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\right]\right\}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad=\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]\right\}\right)\cdot\exp\left(s\left\{\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\right]\right\}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(346)</span></td></tr></tbody>
<tbody id="A3.E347"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E347.m1" class="ltx_Math" alttext="\displaystyle\quad=\mathbb{E}\left[\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]\right\}\right)\,\middle|\,X\right]\cdot\exp\left(s\left\{\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\right]\right\}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mi>X</mi><mo rspace="0.055em">]</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad=\mathbb{E}\left[\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]\right\}\right)\,\middle|\,X\right]\cdot\exp\left(s\left\{\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\right]\right\}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(347)</span></td></tr></tbody>
</table>
<p id="A3.p8.2" class="ltx_p"><span id="A3.p8.2.1" class="ltx_text">Note that the random function <math id="A3.p8.m7" class="ltx_Math" alttext="\mathbf{G}\mapsto h_{\mathbf{B}}(X\sqcup\mathbf{G})" display="inline" intent=":literal"><semantics><mrow><mi>𝐆</mi><mo stretchy="false">↦</mo><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>⊔</mo><mi>𝐆</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{G}\mapsto h_{\mathbf{B}}(X\sqcup\mathbf{G})</annotation></semantics></math> is almost surely <math id="A3.p8.m8" class="ltx_math_unparsed" alttext="2\|\mathbf{B}\|_{\mathrm{op}}(n+m)^{-1/2}d^{-1/2}(\eta+\uplambda_{d}(\mathbf{D}))^{-3/2}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐁</mi><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>op</mi></msub><msup><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>+</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>+</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2\|\mathbf{B}\|_{\mathrm{op}}(n+m)^{-1/2}d^{-1/2}(\eta+\uplambda_{d}(\mathbf{D}))^{-3/2}</annotation></semantics></math>-Lispchitz on <math id="A3.p8.m9" class="ltx_Math" alttext="\mathsf{A}_{\eta}" display="inline" intent=":literal"><semantics><msub><mi>𝖠</mi><mi>η</mi></msub><annotation encoding="application/x-tex">\mathsf{A}_{\eta}</annotation></semantics></math> from <a href="#Thmlemma6" title="Lemma 6. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6</span></a>, hence, relying on the <math id="A3.p8.m10" class="ltx_Math" alttext="\sigma_{G}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>G</mi></msub><annotation encoding="application/x-tex">\sigma_{G}</annotation></semantics></math>-Lipschitz concentration property of <math id="A3.p8.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> conditionally to <math id="A3.p8.m12" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, and applying <a href="#Thmproposition6" title="Proposition 6. ‣ B.1 Some sub Gaussian concentration bounds ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">6</span></a>, we get</span></p>
<table id="A3.EGx108" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E348"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E348.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]\right\}\right)\,\middle|\,X\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mi>X</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]\right\}\right)\,\middle|\,X\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E348.m2" class="ltx_Math" alttext="\displaystyle\leq\exp\left(-cs^{2}\sigma_{G}^{2}\left\{\dfrac{1}{(n+m)d(\eta+\uplambda_{d}(\mathbf{D}))^{3}}+\|h_{\mathbf{B}}\|_{\infty}^{2}\sigma_{\mathsf{A}_{\eta}}^{2}\right\}\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>G</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mi>𝐁</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><msub><mi>𝖠</mi><mi>η</mi></msub><mn>2</mn></msubsup></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\left(-cs^{2}\sigma_{G}^{2}\left\{\dfrac{1}{(n+m)d(\eta+\uplambda_{d}(\mathbf{D}))^{3}}+\|h_{\mathbf{B}}\|_{\infty}^{2}\sigma_{\mathsf{A}_{\eta}}^{2}\right\}\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(348)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p9" class="ltx_para ltx_noindent">
<p id="A3.p9.1" class="ltx_p"><span id="A3.p9.1.1" class="ltx_text">Finally, remarking that under <a href="#Thmassumption2" title="H 2 (Model conditionning). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have <math id="A3.p9.m1" class="ltx_Math" alttext="\sigma_{\mathsf{A}_{\eta}}^{2}\lesssim n^{-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><msub><mi>𝖠</mi><mi>η</mi></msub><mn>2</mn></msubsup><mo>≲</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\sigma_{\mathsf{A}_{\eta}}^{2}\lesssim n^{-1}</annotation></semantics></math>, as well as using <math id="A3.p9.m2" class="ltx_Math" alttext="\|h_{\mathbf{B}}\|_{\infty}\lesssim(\eta+\uplambda_{d}(\mathbf{D}))^{-1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>h</mi><mi>𝐁</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\|h_{\mathbf{B}}\|_{\infty}\lesssim(\eta+\uplambda_{d}(\mathbf{D}))^{-1}</annotation></semantics></math>, we have,</span></p>
<table id="A3.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E349"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E349.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]\right\}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\mid X\right]\right\}\right)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E349.m2" class="ltx_Math" alttext="\displaystyle\leq\exp\left(-cs^{2}\sigma_{G}^{2}\left\{\dfrac{1}{(n+m)d(\eta+\uplambda_{d}(\mathbf{D}))^{3}}+\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\right\}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>G</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>}</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\left(-cs^{2}\sigma_{G}^{2}\left\{\dfrac{1}{(n+m)d(\eta+\uplambda_{d}(\mathbf{D}))^{3}}+\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))^{2}}\right\}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(349)</span></td></tr></tbody>
<tbody id="A3.E350"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E350.m1" class="ltx_Math" alttext="\displaystyle=\exp\left(-cs^{2}\dfrac{\sigma_{G}^{2}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1-\alpha}{d}+\eta+\uplambda_{d}(\mathbf{D})\right\}\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>G</mi><mn>2</mn></msubsup><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>d</mi></mfrac></mstyle><mo>+</mo><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\exp\left(-cs^{2}\dfrac{\sigma_{G}^{2}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{1-\alpha}{d}+\eta+\uplambda_{d}(\mathbf{D})\right\}\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(350)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p10" class="ltx_para ltx_noindent">
<p id="A3.p10.1" class="ltx_p"><span id="A3.p10.1.1" class="ltx_text">Now, we will leverage <a href="#Thmproposition6" title="Proposition 6. ‣ B.1 Some sub Gaussian concentration bounds ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">6</span></a> to bound the remaining term, writting <math id="A3.p10.m1" class="ltx_Math" alttext="\mathbb{E}\left[h_{\mathbf{B}}(X)\mid X\right]=g_{\mathbf{B}}(X)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>g</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[h_{\mathbf{B}}(X)\mid X\right]=g_{\mathbf{B}}(X)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math>, where for any <math id="A3.p10.m2" class="ltx_Math" alttext="\mathbf{X}\in{\mathsf{A}_{\eta}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{X}\in{\mathsf{A}_{\eta}}</annotation></semantics></math>,</span></p>
<table id="A3.E351" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E351.m1" class="ltx_Math" alttext="g_{\mathbf{B}}(\mathbf{X})=\int\dfrac{1}{d}\operatorname{tr}\left(\mathbf{B}R_{\mathbf{X}\sqcup g}(\mathbf{D})\right)d\nu_{\mathbf{X}}^{\otimes m}(g)\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>g</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐁</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mrow><mi>𝐗</mi><mo>⊔</mo><mi>g</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">g_{\mathbf{B}}(\mathbf{X})=\int\dfrac{1}{d}\operatorname{tr}\left(\mathbf{B}R_{\mathbf{X}\sqcup g}(\mathbf{D})\right)d\nu_{\mathbf{X}}^{\otimes m}(g)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(351)</span></td></tr></tbody>
</table>
<p id="A3.p10.2" class="ltx_p"><span id="A3.p10.2.1" class="ltx_text">We know from <a href="#Thmlemma7" title="Lemma 7. ‣ Appendix C A deterministic equivalent for resolvent matrices of augmented sample covariances ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">7</span></a> that <math id="A3.p10.m3" class="ltx_Math" alttext="g_{\mathbf{B}}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>𝐁</mi></msub><annotation encoding="application/x-tex">g_{\mathbf{B}}</annotation></semantics></math> is <math id="A3.p10.m4" class="ltx_Math" alttext="\mathtt{L}_{g_{\mathbf{B}}}" display="inline" intent=":literal"><semantics><msub><mi>𝙻</mi><msub><mi>g</mi><mi>𝐁</mi></msub></msub><annotation encoding="application/x-tex">\mathtt{L}_{g_{\mathbf{B}}}</annotation></semantics></math>-Lispchitz on <math id="A3.p10.m5" class="ltx_Math" alttext="\mathsf{A}_{\eta}" display="inline" intent=":literal"><semantics><msub><mi>𝖠</mi><mi>η</mi></msub><annotation encoding="application/x-tex">\mathsf{A}_{\eta}</annotation></semantics></math>, with <math id="A3.p10.m6" class="ltx_math_unparsed" alttext="\mathtt{L}_{g_{\mathbf{B}}}=2(1+\sqrt{m}\mathtt{L}_{G})(n+m)^{-1/2}d^{-1/2}(\eta+\uplambda_{d}(\mathbf{D}))^{-3/2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝙻</mi><msub><mi>g</mi><mi>𝐁</mi></msub></msub><mo>=</mo><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msqrt><mi>m</mi></msqrt><msub><mi>𝙻</mi><mi>G</mi></msub><mo stretchy="false">)</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>+</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mi>d</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>+</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathtt{L}_{g_{\mathbf{B}}}=2(1+\sqrt{m}\mathtt{L}_{G})(n+m)^{-1/2}d^{-1/2}(\eta+\uplambda_{d}(\mathbf{D}))^{-3/2}</annotation></semantics></math>. Hence, using <a href="#Thmproposition6" title="Proposition 6. ‣ B.1 Some sub Gaussian concentration bounds ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">6</span></a>, we prove the existence of a numerical constant <math id="A3.p10.m7" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>, such the following bound holds,</span></p>
<table id="A3.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E352"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E352.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\exp\left(s\left\{g_{\mathbf{B}}(X)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[g_{\mathbf{B}}(X)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\}\right)\right]\leq\exp\left(-c_{2}s^{2}\dfrac{(1+\sqrt{m}\mathtt{L}_{G})^{2}}{d(n+m)(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\right)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>g</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>g</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mi>G</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\exp\left(s\left\{g_{\mathbf{B}}(X)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[g_{\mathbf{B}}(X)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\}\right)\right]\leq\exp\left(-c_{2}s^{2}\dfrac{(1+\sqrt{m}\mathtt{L}_{G})^{2}}{d(n+m)(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(352)</span></td></tr></tbody>
</table>
<p id="A3.p10.3" class="ltx_p"><span id="A3.p10.3.1" class="ltx_text">Putting the previous bounds all together, we have shown that the moment generating function of <math id="A3.p10.m8" class="ltx_Math" alttext="h_{\mathbf{B}}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{\mathbf{B}}(X)</annotation></semantics></math> is bounded for a universal constant <math id="A3.p10.m9" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> by,</span></p>
<table id="A3.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E353"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E353.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\right]\right\}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>h</mi><mi>𝐁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\exp\left(s\left\{h_{\mathbf{B}}(\tilde{X})-\mathbb{E}\left[h_{\mathbf{B}}(\tilde{X})\right]\right\}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(353)</span></td></tr></tbody>
<tbody id="A3.E354"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E354.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\exp\left(-cs^{2}\left\{\dfrac{(1+\sqrt{m}\mathtt{L}_{G})^{2}}{d(n+m)(\eta+\uplambda_{d}(\mathbf{D}))^{3}}+\dfrac{\sigma_{G}^{2}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left(\frac{1-\alpha}{d}+\eta+\uplambda_{d}(\mathbf{D})\right)\right\}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mi>G</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>G</mi><mn>2</mn></msubsup><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>d</mi></mfrac></mstyle><mo>+</mo><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq\exp\left(-cs^{2}\left\{\dfrac{(1+\sqrt{m}\mathtt{L}_{G})^{2}}{d(n+m)(\eta+\uplambda_{d}(\mathbf{D}))^{3}}+\dfrac{\sigma_{G}^{2}}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left(\frac{1-\alpha}{d}+\eta+\uplambda_{d}(\mathbf{D})\right)\right\}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(354)</span></td></tr></tbody>
<tbody id="A3.E355"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E355.m1" class="ltx_Math" alttext="\displaystyle\quad=\exp\left(-cs^{2}\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{\alpha}{d}\left(1+\sqrt{m}\mathtt{L}_{G}\right)^{2}+\dfrac{(1-\alpha)\sigma_{X}^{2}}{d}+\sigma_{G}(\eta+\uplambda_{d}(\mathbf{D}))\right\}\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mi>G</mi></msub></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>X</mi><mn>2</mn></msubsup></mrow><mi>d</mi></mfrac></mstyle><mo>+</mo><mrow><msub><mi>σ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad=\exp\left(-cs^{2}\dfrac{1}{n(\eta+\uplambda_{d}(\mathbf{D}))^{3}}\left\{\dfrac{\alpha}{d}\left(1+\sqrt{m}\mathtt{L}_{G}\right)^{2}+\dfrac{(1-\alpha)\sigma_{X}^{2}}{d}+\sigma_{G}(\eta+\uplambda_{d}(\mathbf{D}))\right\}\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(355)</span></td></tr></tbody>
</table>
<p id="A3.p10.4" class="ltx_p"><span id="A3.p10.4.1" class="ltx_text">Relying on the Chernoff’s bound, and usual computations, the claimed concentration bound follows.</span></p>
</div>
<div id="A3.p11" class="ltx_para ltx_noindent">
<p id="A3.p11.1" class="ltx_p"><span id="A3.p11.1.1" class="ltx_text ltx_font_bold">A first equivalent for <math id="A3.p11.m1" class="ltx_Math" alttext="\mathbb{E}\left[\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi mathvariant="normal">R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math>.<span id="A3.p11.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A3.p12" class="ltx_para ltx_noindent">
<p id="A3.p12.1" class="ltx_p"><span id="A3.p12.1.1" class="ltx_text">We now focus on the bias of <math id="A3.p12.m1" class="ltx_Math" alttext="\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math>. We will show that <math id="A3.p12.m2" class="ltx_Math" alttext="\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>Aug</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})</annotation></semantics></math> is close to <math id="A3.p12.m3" class="ltx_Math" alttext="\mathbb{E}\left[\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math>.</span></p>
</div>
<div id="A3.p13" class="ltx_para ltx_noindent">
<p id="A3.p13.1" class="ltx_p"><span id="A3.p13.1.1" class="ltx_text">As a first step, let us notice that conditionally to <math id="A3.p13.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, <math id="A3.p13.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> satisfies all the assumptions of <a href="#Thmproposition8" title="Proposition 8. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">8</span></a>, hence for any <math id="A3.p13.m3" class="ltx_Math" alttext="\sigma(X)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(X)</annotation></semantics></math>-measurable matrix <math id="A3.p13.m4" class="ltx_Math" alttext="D_{X}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>X</mi></msub><annotation encoding="application/x-tex">D_{X}</annotation></semantics></math>, <math id="A3.p13.m5" class="ltx_Math" alttext="\operatorname{R}_{G}(D_{X})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{R}_{G}(D_{X})</annotation></semantics></math> admist a deterministic equivalent conditionally to <math id="A3.p13.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.
We will through a slight abuse of notation denote <math id="A3.p13.m7" class="ltx_Math" alttext="\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}(D_{X})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}(D_{X})</annotation></semantics></math> the equivalent of <math id="A3.p13.m8" class="ltx_Math" alttext="\operatorname{R}_{G}(D_{X})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{R}_{G}(D_{X})</annotation></semantics></math> conditionally to <math id="A3.p13.m9" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. It is given by <a href="#Thmproposition8" title="Proposition 8. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">8</span></a>, i.e,</span></p>
<table id="A3.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E357"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E357.m1" class="ltx_Math" alttext="\displaystyle\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}(D_{X})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}(D_{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E357.m2" class="ltx_Math" alttext="\displaystyle=\left(\dfrac{\mathbb{E}\left[C_{G}\mid X\right]}{\mathfrak{a}_{g}(X)}+D_{X}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\left(\dfrac{\beta C_{X}}{\mathfrak{a}_{g}(X)}+\dfrac{\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+D_{X}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><msub><mi>D</mi><mi>X</mi></msub></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><msub><mi>D</mi><mi>X</mi></msub></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\dfrac{\mathbb{E}\left[C_{G}\mid X\right]}{\mathfrak{a}_{g}(X)}+D_{X}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\left(\dfrac{\beta C_{X}}{\mathfrak{a}_{g}(X)}+\dfrac{\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+D_{X}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(357)</span></td></tr></tbody>
<tbody id="A3.E358"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E358.m1" class="ltx_Math" alttext="\displaystyle\mathfrak{a}_{g}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathfrak{a}_{g}(X)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E358.m2" class="ltx_Math" alttext="\displaystyle=1+\dfrac{1}{m}\operatorname{tr}\left(\mathbb{E}\left[C_{G}\mid X\right]\mathbb{E}\left[R_{G}(D_{X})\mid X\right]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1+\dfrac{1}{m}\operatorname{tr}\left(\mathbb{E}\left[C_{G}\mid X\right]\mathbb{E}\left[R_{G}(D_{X})\mid X\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(358)</span></td></tr></tbody>
<tbody id="A3.E359"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E359.m1" class="ltx_Math" alttext="\displaystyle=1+\dfrac{1}{m}\operatorname{tr}\left(\left\{\beta C_{X}+\Lambda_{G}(X)\right\}\mathbb{E}\left[R_{G}(D_{X})\mid X\right]\right)\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>{</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1+\dfrac{1}{m}\operatorname{tr}\left(\left\{\beta C_{X}+\Lambda_{G}(X)\right\}\mathbb{E}\left[R_{G}(D_{X})\mid X\right]\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(359)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p14" class="ltx_para ltx_noindent">
<p id="A3.p14.1" class="ltx_p"><span id="A3.p14.1.1" class="ltx_text">Writting for simplicity, <math id="A3.p14.m1" class="ltx_Math" alttext="\alpha^{\prime}=(1-\beta/\mathfrak{a}_{g}^{*})\alpha" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>′</mo></msup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo>/</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha^{\prime}=(1-\beta/\mathfrak{a}_{g}^{*})\alpha</annotation></semantics></math>, and <math id="A3.p14.m2" class="ltx_Math" alttext="\alpha^{\prime}(X)=(1-\beta/\mathfrak{a}_{g}(X))\alpha" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>α</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>β</mi><mo>/</mo><msub><mi>𝔞</mi><mi>g</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha^{\prime}(X)=(1-\beta/\mathfrak{a}_{g}(X))\alpha</annotation></semantics></math>, we will rely on the following upper bound which follows from the triangle inequality,</span></p>
<table id="A3.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E360"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E360.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})-\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>Aug</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})-\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(360)</span></td></tr></tbody>
<tbody id="A3.E361"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E361.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\mathbb{E}\left[\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})-\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\mathbb{E}\left[\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})-\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(361)</span></td></tr></tbody>
<tbody id="A3.E362"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E362.m1" class="ltx_Math" alttext="\displaystyle\qquad+\left\|\mathbb{E}\left[\left\{\dfrac{1}{\alpha}\bar{\operatorname{R}}^{\mathfrak{a}_{g}(X)}_{G\mid X}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)-\dfrac{1}{1-\alpha^{\prime}}\operatorname{R}_{X}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\left\|\mathbb{E}\left[\left\{\dfrac{1}{\alpha}\bar{\operatorname{R}}^{\mathfrak{a}_{g}(X)}_{G\mid X}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)-\dfrac{1}{1-\alpha^{\prime}}\operatorname{R}_{X}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(362)</span></td></tr></tbody>
<tbody id="A3.E363"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E363.m1" class="ltx_Math" alttext="\displaystyle\qquad+\left\|\mathbb{E}\left[\left\{\dfrac{1}{1-\alpha^{\prime}}\operatorname{R}_{X}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)-\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>Aug</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\left\|\mathbb{E}\left[\left\{\dfrac{1}{1-\alpha^{\prime}}\operatorname{R}_{X}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)-\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(363)</span></td></tr></tbody>
</table>
<p id="A3.p14.2" class="ltx_p"><span id="A3.p14.2.1" class="ltx_text">and, remark that we can rewrite,</span></p>
<table id="A3.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E364"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E364.m1" class="ltx_Math" alttext="\displaystyle\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})=\left((1-\alpha)C_{X}+\alpha C_{G}+\mathbf{D}\right)^{-1}=\dfrac{1}{\alpha}\operatorname{R}_{G}\left(\dfrac{(1-\alpha)}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>G</mi></msub></mrow><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})=\left((1-\alpha)C_{X}+\alpha C_{G}+\mathbf{D}\right)^{-1}=\dfrac{1}{\alpha}\operatorname{R}_{G}\left(\dfrac{(1-\alpha)}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(364)</span></td></tr></tbody>
</table>
<table id="A3.EGx115" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E365"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E365.m1" class="ltx_Math" alttext="\displaystyle\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E365.m2" class="ltx_Math" alttext="\displaystyle=\dfrac{1}{\alpha}\left(\dfrac{\mathbb{E}\left[C_{G}\mid X\right]}{\mathfrak{a}_{g}(X)}+\dfrac{1-\alpha}{\alpha}C_{X}+\mathbf{D}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{1}{\alpha}\left(\dfrac{\mathbb{E}\left[C_{G}\mid X\right]}{\mathfrak{a}_{g}(X)}+\dfrac{1-\alpha}{\alpha}C_{X}+\mathbf{D}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(365)</span></td></tr></tbody>
<tbody id="A3.E366"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E366.m1" class="ltx_Math" alttext="\displaystyle=\left(\left(1-\left(1-\dfrac{\beta}{\mathfrak{a}_{g}(X)}\right)\alpha\right)C_{X}+\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\mathbf{D}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\left(1-\left(1-\dfrac{\beta}{\mathfrak{a}_{g}(X)}\right)\alpha\right)C_{X}+\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\mathbf{D}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(366)</span></td></tr></tbody>
<tbody id="A3.E367"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E367.m1" class="ltx_Math" alttext="\displaystyle=\left((1-\alpha^{\prime}(X))C_{X}+\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\mathbf{D}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>α</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left((1-\alpha^{\prime}(X))C_{X}+\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\mathbf{D}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(367)</span></td></tr></tbody>
</table>
<table id="A3.EGx116" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E368"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E368.m1" class="ltx_Math" alttext="\displaystyle\dfrac{1}{1-\alpha^{\prime}}\operatorname{R}_{X}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\left((1-\alpha^{\prime})C_{X}+\dfrac{\alpha\bar{\Lambda}_{G}}{\mathfrak{a}_{g}^{*}}+\mathbf{D}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mfrac></mstyle><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{1}{1-\alpha^{\prime}}\operatorname{R}_{X}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\left((1-\alpha^{\prime})C_{X}+\dfrac{\alpha\bar{\Lambda}_{G}}{\mathfrak{a}_{g}^{*}}+\mathbf{D}\right)^{-1}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(368)</span></td></tr></tbody>
</table>
<p id="A3.p14.3" class="ltx_p"><span id="A3.p14.3.1" class="ltx_text">and,</span></p>
<table id="A3.E369" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E369.m1" class="ltx_Math" alttext="\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\dfrac{1}{1-\alpha^{\prime}}\bar{\operatorname{R}}_{X}^{\mathfrak{a}_{x}^{*}}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>Aug</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mrow></mfrac><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\mathbbm{1}_{\mathsf{A}_{\eta}}(X)=\dfrac{1}{1-\alpha^{\prime}}\bar{\operatorname{R}}_{X}^{\mathfrak{a}_{x}^{*}}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(369)</span></td></tr></tbody>
</table>
<p id="A3.p14.4" class="ltx_p"><span id="A3.p14.4.1" class="ltx_text">Using these equalities, we rewrite the previous bound as,</span></p>
<table id="A3.EGx117" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E370"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E370.m2" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})-\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>Aug</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\operatorname{R}_{\mathrm{Aug}}(\mathbf{D})-\bar{\operatorname{R}}_{\mathrm{Aug}}^{(\mathfrak{a}_{x}^{*},\mathfrak{a}_{g}^{*})}(\mathbf{D})\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(370)</span></td></tr></tbody>
<tbody id="A3.E371"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E371.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\mathbb{E}\left[\left\{\dfrac{1}{\alpha}\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mi>α</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\mathbb{E}\left[\left\{\dfrac{1}{\alpha}\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(371)</span></td></tr></tbody>
<tbody id="A3.E372"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E372.m1" class="ltx_Math" alttext="\displaystyle\qquad+\left\|\mathbb{E}\left[\left\{\left((1-\alpha^{\prime}(X))C_{X}+\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\mathbf{D}\right)^{-1}-\left((1-\alpha^{\prime})C_{X}+\dfrac{\alpha\bar{\Lambda}_{G}}{\mathfrak{a}_{g}}+\mathbf{D}\right)^{-1}\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>α</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><msub><mi>𝔞</mi><mi>g</mi></msub></mfrac></mstyle><mo>+</mo><mi>𝐃</mi></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\left\|\mathbb{E}\left[\left\{\left((1-\alpha^{\prime}(X))C_{X}+\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\mathbf{D}\right)^{-1}-\left((1-\alpha^{\prime})C_{X}+\dfrac{\alpha\bar{\Lambda}_{G}}{\mathfrak{a}_{g}}+\mathbf{D}\right)^{-1}\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(372)</span></td></tr></tbody>
<tbody id="A3.E373"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E373.m1" class="ltx_Math" alttext="\displaystyle\qquad+\left\|\mathbb{E}\left[\left\{\dfrac{1}{1-\alpha^{\prime}}\operatorname{R}_{X}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)-\dfrac{1}{1-\alpha^{\prime}}\bar{\operatorname{R}}_{X}^{\mathfrak{a}_{x}^{*}}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>X</mi><msubsup><mi>𝔞</mi><mi>x</mi><mo>∗</mo></msubsup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝔞</mi><mi>g</mi><mo>∗</mo></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\left\|\mathbb{E}\left[\left\{\dfrac{1}{1-\alpha^{\prime}}\operatorname{R}_{X}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)-\dfrac{1}{1-\alpha^{\prime}}\bar{\operatorname{R}}_{X}^{\mathfrak{a}_{x}^{*}}\left(\dfrac{\alpha\bar{\Lambda}_{G}}{(1-\alpha^{\prime})\mathfrak{a}_{g}^{*}}+\dfrac{1}{1-\alpha^{\prime}}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(373)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p15" class="ltx_para ltx_noindent">
<p id="A3.p15.1" class="ltx_p"><span id="A3.p15.1.1" class="ltx_text">The first and third terms in (<a href="#A3.E370" title="Equation 370 ‣ Proof. ‣ Appendix C A deterministic equivalent for resolvent matrices of augmented sample covariances ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">370</span></a>) are bounded by <a href="#Thmproposition8" title="Proposition 8. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">8</span></a>, whereas the second term is controlled from the fact that <math id="A3.p15.m1" class="ltx_Math" alttext="\mathfrak{a}_{g}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{a}_{g}(X)</annotation></semantics></math> and <math id="A3.p15.m2" class="ltx_Math" alttext="\Lambda_{G}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{G}(X)</annotation></semantics></math> have small deviations. We deal with each of the terms in the right hand side of the previous upper bound one by one, first using the Jensen’s inequality,</span></p>
<table id="A3.EGx118" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E374"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E374.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\dfrac{1}{\alpha}\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mi>α</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\dfrac{1}{\alpha}\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(374)</span></td></tr></tbody>
<tbody id="A3.E375"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E375.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\dfrac{1}{\alpha}\mathbb{E}\left[\left\|\mathbb{E}\left[\left\{\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\bar{\operatorname{R}}_{G}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\middle|X\right]\right\|_{\mathrm{F}}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mi>α</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>G</mi><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mi>X</mi><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq\dfrac{1}{\alpha}\mathbb{E}\left[\left\|\mathbb{E}\left[\left\{\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\bar{\operatorname{R}}_{G}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\middle|X\right]\right\|_{\mathrm{F}}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(375)</span></td></tr></tbody>
</table>
<p id="A3.p15.2" class="ltx_p"><span id="A3.p15.2.1" class="ltx_text">Remarking that for all <math id="A3.p15.m3" class="ltx_Math" alttext="\mathbf{X}\in\mathsf{A}_{\eta}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>∈</mo><msub><mi>𝖠</mi><mi>η</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{X}\in\mathsf{A}_{\eta}</annotation></semantics></math>, we have <math id="A3.p15.m4" class="ltx_Math" alttext="\uplambda_{d}((1-\alpha)/\alpha C_{\mathbf{X}}+\mathbf{D}/\alpha)\geq\alpha^{-1}((1-\alpha)\eta+\uplambda_{d}(\mathbf{D}))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>α</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>𝐗</mi></msub></mrow><mo>+</mo><mrow><mi>𝐃</mi><mo>/</mo><mi>α</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msup><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\uplambda_{d}((1-\alpha)/\alpha C_{\mathbf{X}}+\mathbf{D}/\alpha)\geq\alpha^{-1}((1-\alpha)\eta+\uplambda_{d}(\mathbf{D}))</annotation></semantics></math>. We set <math id="A3.p15.m5" class="ltx_Math" alttext="\epsilon=(1-\alpha)\eta/\alpha+\uplambda_{d}(\mathbf{D})/\alpha" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>/</mo><mi>α</mi></mrow><mo>+</mo><mrow><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>α</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon=(1-\alpha)\eta/\alpha+\uplambda_{d}(\mathbf{D})/\alpha</annotation></semantics></math>, we have from the previous remark and using <a href="#Thmproposition8" title="Proposition 8. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">proposition</span> <span class="ltx_text ltx_ref_tag">8</span></a>,</span></p>
<table id="A3.EGx119" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E376"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E376.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}\left[\left\{\dfrac{1}{\alpha}\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>R</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mi>α</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}\left[\left\{\dfrac{1}{\alpha}\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\dfrac{1}{\alpha}\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right\|_{\mathrm{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(376)</span></td></tr></tbody>
<tbody id="A3.E377"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E377.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\dfrac{1}{\alpha}\mathbb{E}\left[\left\|\mathbb{E}\left[\left\{\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\middle|X\right]\right\|_{\mathrm{F}}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>R</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mi>α</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐃</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mi>X</mi><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq\dfrac{1}{\alpha}\mathbb{E}\left[\left\|\mathbb{E}\left[\left\{\operatorname{R}_{G}\left(\dfrac{(1-\alpha)C_{X}}{\alpha}+\dfrac{1}{\alpha}\mathbf{D}\right)-\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}\left(\dfrac{1-\alpha}{\alpha}C_{X}+\dfrac{1}{\alpha}\mathbf{D}\right)\right\}\middle|X\right]\right\|_{\mathrm{F}}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(377)</span></td></tr></tbody>
<tbody id="A3.E378"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E378.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\dfrac{\sigma_{G}^{2}}{\alpha}\mathbb{E}\left[\left\{Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}^{-1},0,n^{-1})\dfrac{\sqrt{d}\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right])\epsilon^{6}}\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>G</mi><mn>2</mn></msubsup><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><mn>0</mn><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>6</mn></msup></mrow></mfrac></mstyle></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.280em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\dfrac{\sigma_{G}^{2}}{\alpha}\mathbb{E}\left[\left\{Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}^{-1},0,n^{-1})\dfrac{\sqrt{d}\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right])\epsilon^{6}}\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(378)</span></td></tr></tbody>
</table>
<p id="A3.p15.3" class="ltx_p"><span id="A3.p15.3.1" class="ltx_text">where <math id="A3.p15.m6" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is the polynomial function defined in <a href="#Thmproposition8" title="Proposition 8. ‣ B.3 A deterministic equivalent for R_𝑋(𝜆), with arbitrarly small regularization parameter ‣ Appendix B Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">8</span></a>. In order to integrate the above error over the distribution of <math id="A3.p15.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, one needs to ensure that this random quantity doesn’t blow up. We deal with this, first by using the fact that <math id="A3.p15.m8" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is non-decreasing with respect to it’s third entry, and we recall the notation <math id="A3.p15.m9" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>, such that,</span></p>
<table id="A3.E379" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E379.m1" class="ltx_Math" alttext="\mathop{Sp}(\Lambda_{G}(X))\subset[\kappa^{-1},\kappa]\quad\text{a.s}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>κ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mi>κ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>a.s</mtext></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\mathop{Sp}(\Lambda_{G}(X))\subset[\kappa^{-1},\kappa]\quad\text{a.s}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(379)</span></td></tr></tbody>
</table>
<p id="A3.p15.4" class="ltx_p"><span id="A3.p15.4.1" class="ltx_text">and using <math id="A3.p15.m10" class="ltx_Math" alttext="\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}\geq\operatorname{inf}_{\mathbf{X}}\|\Lambda_{G}(\mathbf{X})\|_{\mathrm{op}}\geq\kappa" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo>≥</mo><mrow><msub><mi>inf</mi><mi>𝐗</mi></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mo>≥</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}\geq\operatorname{inf}_{\mathbf{X}}\|\Lambda_{G}(\mathbf{X})\|_{\mathrm{op}}\geq\kappa</annotation></semantics></math>, we write,</span></p>
<table id="A3.EGx120" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E380"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E380.m1" class="ltx_Math" alttext="\displaystyle Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}^{-1},0,n^{-1})" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><mn>0</mn><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}^{-1},0,n^{-1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E380.m2" class="ltx_Math" alttext="\displaystyle\leq Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),(\operatorname{inf}_{\mathbf{X}}\|\Lambda_{G}(\mathbf{X})\|_{\mathrm{op}})^{-1},0,n^{-1})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>inf</mi><mi>𝐗</mi></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mn>0</mn><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),(\operatorname{inf}_{\mathbf{X}}\|\Lambda_{G}(\mathbf{X})\|_{\mathrm{op}})^{-1},0,n^{-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(380)</span></td></tr></tbody>
<tbody id="A3.E381"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E381.m1" class="ltx_Math" alttext="\displaystyle\leq Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),\kappa,0,n^{-1})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>κ</mi><mo>,</mo><mn>0</mn><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),\kappa,0,n^{-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(381)</span></td></tr></tbody>
</table>
<p id="A3.p15.5" class="ltx_p"><span id="A3.p15.5.1" class="ltx_text">and, remarking that there exists two polwnomials <math id="A3.p15.m11" class="ltx_Math" alttext="q_{1}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mn>1</mn></msub><annotation encoding="application/x-tex">q_{1}</annotation></semantics></math> and <math id="A3.p15.m12" class="ltx_Math" alttext="q_{2}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mn>2</mn></msub><annotation encoding="application/x-tex">q_{2}</annotation></semantics></math> (polynomials in <math id="A3.p15.m13" class="ltx_Math" alttext="\epsilon,\kappa,n^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>,</mo><mi>κ</mi><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\epsilon,\kappa,n^{-1}</annotation></semantics></math>) such that,</span></p>
<table id="A3.E382" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E382.m1" class="ltx_Math" alttext="Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),\kappa,0,n^{-1})=q_{1}+\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right])q_{2}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>κ</mi><mo>,</mo><mn>0</mn><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>q</mi><mn>1</mn></msub><mo>+</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>2</mn></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),\kappa,0,n^{-1})=q_{1}+\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right])q_{2}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(382)</span></td></tr></tbody>
</table>
<p id="A3.p15.6" class="ltx_p"><span id="A3.p15.6.1" class="ltx_text">which is trivial from the definition of <math id="A3.p15.m14" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> in <a href="#Thmproposition1" title="Proposition 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a>. We write,</span></p>
<table id="A3.EGx121" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E383"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E383.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\{Q(\epsilon,\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right]),\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}^{-1},0,n^{-1})\dfrac{\sqrt{d}\|\mathbb{E}\left[C_{G}\mid X\right]\|_{\mathrm{op}}^{3}}{n\uplambda_{d}(\mathbb{E}\left[C_{G}\mid X\right])\epsilon^{6}}\right\}\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>{</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><mn>0</mn><mo>,</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>3</mn></msubsup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>C</mi><mi>G</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mro