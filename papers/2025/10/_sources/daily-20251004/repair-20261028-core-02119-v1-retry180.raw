<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E151.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\frac{2}{c}\!\left(d\|M_{1}\|_{\infty}^{2}+\frac{2}{c}\|M_{1}\|_{\infty}^{2}\right)+\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\big)\right)\lesssim d\,\|M_{1}\|_{\infty}^{2}+\operatorname{Var}\!\left(\operatorname{tr}\!\big(\Sigma_{X}M_{1}(X^{-})\,\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\big)\right)\!." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>M</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="f