<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch4.F7.sf6.3" class="ltx_text" style="font-size:90%;">(f)</span> </span><span id="Ch4.F7.sf6.4" class="ltx_text" style="font-size:90%;">Full ring after training</span></figcaption>
