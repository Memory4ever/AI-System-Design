<th id="Ch4.T6.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="Ch4.T6.3.1.2.1" class="ltx_text ltx_font_bold">Beethoven Test NLL <math id="Ch4.T6.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th>
<th id="Ch4.T6.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="Ch4.T6.3.1.3.1" class="ltx_text ltx_font_bold">YouTubeMix Test NLL <math id="Ch4.T6.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="Ch4.T6.3.2" class="ltx_tr">
<th id="Ch4.T6.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Poolformer (ours)</th>
<td id="Ch4.T6.3.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Ch4.T6.3.2.2.1" class="ltx_text ltx_font_bold">0.915</span></td>
<td id="Ch4.T6.3.2.3" class="ltx_td ltx_align_center ltx_border_t">1.391</td></tr>
