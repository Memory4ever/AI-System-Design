<td id="Ch4.T1.3.5.2" class="ltx_td ltx_align_center">7,272,704</td>
<td id="Ch4.T1.3.5.3" class="ltx_td ltx_align_center">1.886 (1.874)</td>
<td id="Ch4.T1.3.5.4" class="ltx_td ltx_align_center">Overfits</td></tr>
<tr id="Ch4.T1.3.6" class="ltx_tr">
<th id="Ch4.T1.3.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w/o gating</th>
<td id="Ch4.T1.3.6.2" class="ltx_td ltx_align_center">5,489,408</td>
<td id="Ch4.T1.3.6.3" class="ltx_td ltx_align_center">2.264 (1.859)</td>
<td id="Ch4.T1.3.6.4" class="ltx_td ltx_align_center">Very unstable</td></tr>
<tr id="Ch4.T1.3.7" class="ltx_tr">
<th id="Ch4.T1.3.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w/ long-skip connections</th>
<td id="Ch4.T1.3.7.2" class="ltx_td ltx_align_center">7,272,704</td>
<td id="Ch4.T1.3.7.3" class="ltx_td ltx_align_center">1.895 (1.895)</td>
<td id="Ch4.T1.3.7.4" class="ltx_td"></td></tr>
<tr id="Ch4.T1.3.8" class="ltx_tr">
<th id="Ch4.T1.3.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   all ResBlocks after pooling</th>
<td id="Ch4.T1.3.8.2" class="ltx_td ltx_align_center">7,272,704</td>
<td id="Ch4.T1.3.8.3" class="ltx_td ltx_align_center"><span id="Ch4.T1.3.8.3.1" class="ltx_text ltx_font_bold">1.851 (1.848)</span></td>
<td id="Ch4.T1.3.8.4" class="ltx_td"></td></tr>
<tr id="Ch4.T1.3.9" class="ltx_tr">
<th id="Ch4.T1.3.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w/ attention in the deepest layer</th>
<td id="Ch4.T1.3.9.2" class="ltx_td ltx_align_center">7,229,184</td>
<td id="Ch4.T1.3.9.3" class="ltx_td ltx_align_center">1.852 (1.851)</td>
<td id="Ch4.T1.3.9.4" class="ltx_td"></td></tr>
<tr id="Ch4.T1.3.10" class="ltx_tr">
<th id="Ch4.T1.3.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w/o complex numbers</th>
<td id="Ch4.T1.3.10.2" class="ltx_td ltx_align_center">7,355,648</td>
<td id="Ch4.T1.3.10.3" class="ltx_td ltx_align_center">1.859 (1.859)</td>
<td id="Ch4.T1.3.10.4" class="ltx_td"></td></tr>
<tr id="Ch4.T1.3.11" class="ltx_tr">
<th id="Ch4.T1.3.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w/ half ring initialization</th>
<td id="Ch4.T1.3.11.2" class="ltx_td ltx_align_center">7,272,704</td>
<td id="Ch4.T1.3.11.3" class="ltx_td ltx_align_center">1.854 (1.854)</td>
<td id="Ch4.T1.3.11.4" class="ltx_td"></td></tr>
<tr id="Ch4.T1.3.12" class="ltx_tr">
<th id="Ch4.T1.3.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w/ full ring initialization</th>
<td id="Ch4.T1.3.12.2" class="ltx_td ltx_align_center">7,272,704</td>
<td id="Ch4.T1.3.12.3" class="ltx_td ltx_align_center">1.876 (1.861)</td>
<td id="Ch4.T1.3.12.4" class="ltx_td ltx_align_center">Very unstable</td></tr>
<tr id="Ch4.T1.3.13" class="ltx_tr">
<th id="Ch4.T1.3.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w/ full circle initialization</th>
<td id="Ch4.T1.3.13.2" class="ltx_td ltx_align_center">7,272,704</td>
<td id="Ch4.T1.3.13.3" class="ltx_td ltx_align_center">1.998 (1.924)</td>
<td id="Ch4.T1.3.13.4" class="ltx_td ltx_align_center">Very unstable</td></tr>
<tr id="Ch4.T1.3.14" class="ltx_tr">
<th id="Ch4.T1.3.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">SaShiMi</th>
<td id="Ch4.T1.3.14.2" class="ltx_td ltx_align_center ltx_border_t">4,751,096</td>
<td id="Ch4.T1.3.14.3" class="ltx_td ltx_align_center ltx_border_t">1.891</td>
<td id="Ch4.T1.3.14.4" class="ltx_td ltx_border_t"></td></tr>
<tr id="Ch4.T1.3.15" class="ltx_tr">
<th id="Ch4.T1.3.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Mamba</th>
<td id="Ch4.T1.3.15.2" class="ltx_td ltx_align_center">6,100,000</td>
<td id="Ch4.T1.3.15.3" class="ltx_td ltx_align_center">1.852</td>
<td id="Ch4.T1.3.15.4" class="ltx_td"></td></tr>
<tr id="Ch4.T1.3.16" class="ltx_tr">
<th id="Ch4.T1.3.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b">Mamba</th>
<td id="Ch4.T1.3.16.2" class="ltx_td ltx_align_center ltx_border_b">24,300,000</td>
<td id="Ch4.T1.3.16.3" class="ltx_td ltx_align_center ltx_border_b">1.860</td>
