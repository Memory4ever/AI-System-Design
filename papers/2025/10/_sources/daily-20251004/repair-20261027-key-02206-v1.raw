yle="fill:none" d="M 131.89 -157.48 h 31.5 v 31.5 h -31.5 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 140.72 -146.19)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch2.F5.pic2.14" class="ltx_text">16</span></span></span></foreignObject></g><path style="fill:none" d="M 167.15 -110.51 L 162.2 -118.43"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.53015 -0.84792 0.84792 -0.53015 162.2 -118.43)"><path d="M 6.37 0 C 5.58 0.19 2.15 1.28 0 2.46 L 0 -2.46 C 2.15 -1.28 5.58 -0.19 6.37 0 Z"></path></g><path style="fill:none" d="M 190.94 -157.48 h 31.5 v 31.5 h -31.5 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 199.77 -146.19)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="Ch2.F5.pic2.15" class="ltx_text">22</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 187.18 -110.51 L 192.13 -118.43"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.53015 -0.84792 0.84792 0.53015 192.13 -118.43)"><path d="M 6.37 0 C 5.58 0.19 2.15 1.28 0 2.46 L 0 -2.46 C 2.15 -1.28 5.58 -0.19 6.37 0 Z"></path></g></g></g></svg></span></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<table id="Ch2.Ex3" class="ltx_equationgroup ltx_centering ltx_figure_panel ltx_eqn_table">

<tbody id="Ch2.Ex3X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch2.Ex3X.m2" class="ltx_Math" alttext="\displaystyle\text{prescan}[L[v]]" display="inline" intent=":literal"><semantics><mrow><mtext>prescan</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{prescan}[L[v]]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch2.Ex3X.m3" class="ltx_Math" alttext="\displaystyle=\text{prescan}[v]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mtext>prescan</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\text{prescan}[v]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Ch2.Ex3Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch2.Ex3Xa.m2" class="ltx_Math" alttext="\displaystyle\text{prescan}[R[v]]" display="inline" intent=":literal"><semantics><mrow><mtext>prescan</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{prescan}[R[v]]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch2.Ex3Xa.m3" class="ltx_Math" alttext="\displaystyle=\text{sum}[L[v]]+\text{prescan}[v]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mtext>sum</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mtext>prescan</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\text{sum}[L[v]]+\text{prescan}[v]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch2.F5.6" class="ltx_text" style="font-size:90%;">Figure 2.5</span>: </span><span id="Ch2.F5.7" class="ltx_text ltx_font_bold" style="font-size:90%;">Associative scan algorithm<span id="Ch2.F5.7.1" class="ltx_text ltx_font_medium"> (taken from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>]</cite>). The associative scan algorithm computes prefix sums (or any associative operation) in <math id="Ch2.F5.m2" class="ltx_Math" alttext="O(\log S)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\log S)</annotation></semantics></math> time using parallel computation. First, the up-sweep is performed, where consecutive nodes are combined. Then, the root is set to the identity (zero in the case of the sum). For the down-sweep, the value at a parent node is passed directly to its left child. The value passed to the right child is the parent’s value combined with the up-sweep result from its left sibling.</span></span></figcaption>
</figure>
<div id="Thmdefinition15" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition15.2" class="ltx_text ltx_font_bold">Definition 15</span></span><span id="Thmdefinition15.3" class="ltx_text ltx_font_bold"> </span>(Affine function shorthand)<span id="Thmdefinition15.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition15.p1" class="ltx_para">
<p id="Thmdefinition15.p1.1" class="ltx_p"><span id="Thmdefinition15.p1.1.1" class="ltx_text ltx_font_italic">We use a shorthand square-bracket notation for affine functions:</span></p>
</div>
<div id="Thmdefinition15.p2" class="ltx_para">
<table id="Ch2.E114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E114.m1" class="ltx_Math" alttext="[M,c](x)\coloneq Mx+c." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mi>c</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[M,c](x)\coloneq Mx+c.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.114)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmdefinition16" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition16.2" class="ltx_text ltx_font_bold">Definition 16</span></span><span id="Thmdefinition16.3" class="ltx_text ltx_font_bold"> </span>(Piping operator)<span id="Thmdefinition16.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition16.p1" class="ltx_para">
<p id="Thmdefinition16.p1.1" class="ltx_p"><span id="Thmdefinition16.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmdefinition16.p1.m1" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math>, and <math id="Thmdefinition16.p1.m2" class="ltx_Math" alttext="f_{2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>2</mn></msub><annotation encoding="application/x-tex">f_{2}</annotation></semantics></math> be two functions.</span></p>
<table id="Ch2.E115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E115.m1" class="ltx_Math" alttext="(f_{1}\rhd f_{2})(x)\coloneq f_{2}(f_{1}(x))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">⊳</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(f_{1}\rhd f_{2})(x)\coloneq f_{2}(f_{1}(x)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.115)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmproposition5" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition5.2" class="ltx_text ltx_font_bold">Proposition 5</span></span><span id="Thmproposition5.3" class="ltx_text ltx_font_bold"> </span>(Composition of affine functions)<span id="Thmproposition5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition5.p1" class="ltx_para">
<table id="Ch2.E116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E116.m1" class="ltx_Math" alttext="[M_{1},c_{1}]\rhd[M_{2},c_{2}]=[M_{2}M_{1},M_{2}c_{1}+c_{2}]" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo>,</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">⊳</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>M</mi><mn>2</mn></msub><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">[M_{1},c_{1}]\rhd[M_{2},c_{2}]=[M_{2}M_{1},M_{2}c_{1}+c_{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.116)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="Ch2.S3.SS3.SSSx4.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="Ch2.S3.SS3.SSSx4.p3" class="ltx_para">
<table id="Ch2.S3.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Ch2.E117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch2.E117.m1" class="ltx_Math" alttext="\displaystyle f_{2}(f_{1}(x))=M_{2}\left(M_{1}x+c_{1}\right)+c_{2}=M_{2}M_{1}x+M_{2}c_{1}+c_{2}=[M_{2}M_{1},M_{2}c_{1}+c_{2}](x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>c</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>c</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{2}(f_{1}(x))=M_{2}\left(M_{1}x+c_{1}\right)+c_{2}=M_{2}M_{1}x+M_{2}c_{1}+c_{2}=[M_{2}M_{1},M_{2}c_{1}+c_{2}](x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.117)</span></td></tr></tbody>
</table>
<p id="Ch2.S3.SS3.SSSx4.p3.1" class="ltx_p"><span id="Ch2.S3.SS3.SSSx4.p3.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Affine recurrence lifting)<span id="Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para">
<p id="Thmtheorem4.p1.1" class="ltx_p"><span id="Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Given a recurrence</span></p>
<table id="Ch2.E118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E118.m1" class="ltx_Math" alttext="h_{k}=\overline{A}h_{k-1}+\overline{B}x_{k}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><mrow><mrow><mover accent="true"><mi>A</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mover accent="true"><mi>B</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">h_{k}=\overline{A}h_{k-1}+\overline{B}x_{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.118)</span></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.2" class="ltx_p"><span id="Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">with <math id="Thmtheorem4.p1.m1" class="ltx_Math" alttext="h_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h_{0}=0</annotation></semantics></math>, we can define the sequence of elements (affine functions) given by</span></p>
<table id="Ch2.E119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E119.m1" class="ltx_Math" alttext="e_{k}=\left[\overline{A},\overline{B}x_{k}\right]." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mi>k</mi></msub><mo>=</mo><mrow><mo>[</mo><mrow><mover accent="true"><mi>A</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><mrow><mover accent="true"><mi>B</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">e_{k}=\left[\overline{A},\overline{B}x_{k}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.119)</span></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.3" class="ltx_p"><span id="Thmtheorem4.p1.3.1" class="ltx_text ltx_font_italic">As binary operation, we will take function composition. Note that we want <math id="Thmtheorem4.p1.m2" class="ltx_Math" alttext="e_{1}\rhd e_{2}\rhd\dots\rhd e_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">⊳</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">⊳</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">⊳</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">e_{1}\rhd e_{2}\rhd\dots\rhd e_{n}</annotation></semantics></math>. Thus, the binary operation can be expressed as</span></p>
<table id="Ch2.E120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E120.m1" class="ltx_Math" alttext="[M_{1},c_{1}]\bullet[M_{2},c_{2}]=[M_{2}M_{1},M_{2}c_{1}+c_{2}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo>,</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">∙</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>M</mi><mn>2</mn></msub><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[M_{1},c_{1}]\bullet[M_{2},c_{2}]=[M_{2}M_{1},M_{2}c_{1}+c_{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.120)</span></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.4" class="ltx_p"><span id="Thmtheorem4.p1.4.1" class="ltx_text ltx_font_italic">The associative scan will produce a sequence of affine functions whose intercepts are <math id="Thmtheorem4.p1.m3" class="ltx_Math" alttext="\{h_{k}\}_{k}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mi>k</mi></msub><annotation encoding="application/x-tex">\{h_{k}\}_{k}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Ch2.S3.SS3.SSSx4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="Ch2.S3.SS3.SSSx4.p4" class="ltx_para">
<p id="Ch2.S3.SS3.SSSx4.p4.1" class="ltx_p"><span id="Ch2.S3.SS3.SSSx4.p4.1.1" class="ltx_text">The only thing we have to prove is that <math id="Ch2.S3.SS3.SSSx4.p4.m1" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math> associative, that is, that</span></p>
<table id="Ch2.E121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E121.m1" class="ltx_Math" alttext="(e_{1}\bullet e_{2})\bullet e_{3}=e_{1}\bullet(e_{2}\bullet e_{3})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∙</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∙</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>=</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∙</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∙</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(e_{1}\bullet e_{2})\bullet e_{3}=e_{1}\bullet(e_{2}\bullet e_{3}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.121)</span></td></tr></tbody>
</table>
<p id="Ch2.S3.SS3.SSSx4.p4.2" class="ltx_p"><span id="Ch2.S3.SS3.SSSx4.p4.2.1" class="ltx_text">However, this is equivalent to</span></p>
<table id="Ch2.E122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E122.m1" class="ltx_Math" alttext="(e_{1}\rhd e_{2})\rhd e_{3}=e_{1}\rhd(e_{2}\rhd e_{3})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">⊳</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">⊳</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo>=</mo><mrow><msub><mi>e</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">⊳</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">⊳</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(e_{1}\rhd e_{2})\rhd e_{3}=e_{1}\rhd(e_{2}\rhd e_{3}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.122)</span></td></tr></tbody>
</table>
<p id="Ch2.S3.SS3.SSSx4.p4.3" class="ltx_p"><span id="Ch2.S3.SS3.SSSx4.p4.3.1" class="ltx_text">which is true because function composition is associative.
∎</span></p>
</div>
</div>
<div id="Ch2.S3.SS3.SSSx4.p5" class="ltx_para">
<p id="Ch2.S3.SS3.SSSx4.p5.1" class="ltx_p">This lets us compute affine recurrences in <math id="Ch2.S3.SS3.SSSx4.p5.m1" class="ltx_Math" alttext="O(\log S)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\log S)</annotation></semantics></math> using multiple compute units. However, each step of the parallel scan involves computing the product of two matrices, which is <math id="Ch2.S3.SS3.SSSx4.p5.m2" class="ltx_Math" alttext="O(D^{3})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D^{3})</annotation></semantics></math>. Once again, we can just assume <math id="Ch2.S3.SS3.SSSx4.p5.m3" class="ltx_Math" alttext="\overline{A}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>A</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{A}</annotation></semantics></math> to be diagonal.</p>
</div>
<div id="Ch2.S3.SS3.SSSx4.p6" class="ltx_para">
<p id="Ch2.S3.SS3.SSSx4.p6.1" class="ltx_p">Finally, we should remark that in practice, ordinary scans can be faster than associative scans, as the main bottleneck is often memory overhead <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>.</p>
</div>
</section>
</section>
<section id="Ch2.S3.SS4" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.3.4 </span>Related work</h4>

<section id="Ch2.S3.SS4.SSSx1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection">S4</h5>

<div id="Ch2.S3.SS4.SSSx1.p1" class="ltx_para">
<p id="Ch2.S3.SS4.SSSx1.p1.1" class="ltx_p">S4 layers <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">15</a>]</cite> are SSM models that use the convolutional mode for training, and the recurrent view for inference. The matrix <math id="Ch2.S3.SS4.SSSx1.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is constrained to be of the form
<math id="Ch2.S3.SS4.SSSx1.p1.m2" class="ltx_Math" alttext="V\Lambda V^{*}-PQ^{T}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mo>∗</mo></msup></mrow><mo>−</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>Q</mi><mi>T</mi></msup></mrow></mrow><annotation encoding="application/x-tex">V\Lambda V^{*}-PQ^{T}</annotation></semantics></math> (normal plus low-rank). They give an algorithm to compute the convolutional kernel <math id="Ch2.S3.SS4.SSSx1.p1.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> in <math id="Ch2.S3.SS4.SSSx1.p1.m4" class="ltx_Math" alttext="O((L+D)(\log(L+D))^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O((L+D)(\log(L+D))^{2})</annotation></semantics></math>. Note that although an associative scan could be used, the matrix <math id="Ch2.S3.SS4.SSSx1.p1.m5" class="ltx_Math" alttext="\overline{A}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>A</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{A}</annotation></semantics></math> not being diagonal would make the algorithm impractically slow.</p>
</div>
</section>
<section id="Ch2.S3.SS4.SSSx2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection">SaShiMi</h5>

<div id="Ch2.S3.SS4.SSSx2.p1" class="ltx_para">
<p id="Ch2.S3.SS4.SSSx2.p1.1" class="ltx_p">SaShiMi <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite> uses S4 layers, but restricts <math id="Ch2.S3.SS4.SSSx2.p1.m1" class="ltx_Math" alttext="A=\Lambda-PP^{*}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mi mathvariant="normal">Λ</mi><mo>−</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mo>∗</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">A=\Lambda-PP^{*}</annotation></semantics></math>. They also introduce a multi-scale architecture, in which they use pooling to reduce the sequence length.</p>
</div>
</section>
<section id="Ch2.S3.SS4.SSSx3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection">S5</h5>

<div id="Ch2.S3.SS4.SSSx3.p1" class="ltx_para">
<p id="Ch2.S3.SS4.SSSx3.p1.1" class="ltx_p">For training, S5 layers <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite> use an associative scan. In order to avoid the cubic complexity of matrix multiplication, they make <math id="Ch2.S3.SS4.SSSx3.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> be diagonal.</p>
</div>
</section>
<section id="Ch2.S3.SS4.SSSx4" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection">Mamba</h5>

<div id="Ch2.S3.SS4.SSSx4.p1" class="ltx_para">
<p id="Ch2.S3.SS4.SSSx4.p1.1" class="ltx_p">For training, Mamba <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite> layers use an associative scan. In addition, <math id="Ch2.S3.SS4.SSSx4.p1.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, <math id="Ch2.S3.SS4.SSSx4.p1.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> and <math id="Ch2.S3.SS4.SSSx4.p1.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> are not directly learnable parameters, but depend on the input <math id="Ch2.S3.SS4.SSSx4.p1.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. The recurrence is given by</p>
<table id="Ch2.E123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E123.m1" class="ltx_Math" alttext="h_{k}=\overline{A_{k}}h_{k-1}+\overline{B_{k}}x_{k}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><mrow><mrow><mover accent="true"><msub><mi>A</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mover accent="true"><msub><mi>B</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">h_{k}=\overline{A_{k}}h_{k-1}+\overline{B_{k}}x_{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.123)</span></td></tr></tbody>
</table>
<p id="Ch2.S3.SS4.SSSx4.p1.2" class="ltx_p">where <math id="Ch2.S3.SS4.SSSx4.p1.m5" class="ltx_Math" alttext="\overline{A_{k}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>A</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{A_{k}}</annotation></semantics></math> and <math id="Ch2.S3.SS4.SSSx4.p1.m6" class="ltx_Math" alttext="\overline{B_{k}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>B</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{B_{k}}</annotation></semantics></math> are functions of <math id="Ch2.S3.SS4.SSSx4.p1.m7" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="Ch2.S3.SS4.SSSx4.p1.m8" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math>. Note that this can be lifted to an associative scan by defining <math id="Ch2.S3.SS4.SSSx4.p1.m9" class="ltx_Math" alttext="e_{k}=\left[\overline{A_{k}},\overline{B_{k}}x_{k}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>k</mi></msub><mo>=</mo><mrow><mo>[</mo><mrow><mover accent="true"><msub><mi>A</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></mover><mo>,</mo><mrow><mover accent="true"><msub><mi>B</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">e_{k}=\left[\overline{A_{k}},\overline{B_{k}}x_{k}\right]</annotation></semantics></math>. Allowing <math id="Ch2.S3.SS4.SSSx4.p1.m10" class="ltx_Math" alttext="\overline{A_{k}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>A</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{A_{k}}</annotation></semantics></math> and <math id="Ch2.S3.SS4.SSSx4.p1.m11" class="ltx_Math" alttext="\overline{B_{k}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>B</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{B_{k}}</annotation></semantics></math> to depend on <math id="Ch2.S3.SS4.SSSx4.p1.m12" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> increases performance, but the time dependency means the convolutional method is no longer valid.</p>
</div>
</section>
<section id="Ch2.S3.SS4.SSSx5" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection">Griffin</h5>

<div id="Ch2.S3.SS4.SSSx5.p1" class="ltx_para">
<p id="Ch2.S3.SS4.SSSx5.p1.1" class="ltx_p">For training, RG-LRU layers <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> can use an associative scan. The recurrence is given by</p>
<table id="Ch2.E124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch2.E124.m1" class="ltx_Math" alttext="h_{k}=a_{k}\odot h_{k-1}+\sqrt{1-a_{k}^{2}}\odot i_{k}\odot x_{k}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><mrow><mrow><msub><mi>a</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>h</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mi>a</mi><mi>k</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>i</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>x</mi><mi>k</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">h_{k}=a_{k}\odot h_{k-1}+\sqrt{1-a_{k}^{2}}\odot i_{k}\odot x_{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.124)</span></td></tr></tbody>
</table>
<p id="Ch2.S3.SS4.SSSx5.p1.2" class="ltx_p">where <math id="Ch2.S3.SS4.SSSx5.p1.m1" class="ltx_Math" alttext="a_{k}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>k</mi></msub><annotation encoding="application/x-tex">a_{k}</annotation></semantics></math>, and <math id="Ch2.S3.SS4.SSSx5.p1.m2" class="ltx_Math" alttext="i_{k}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>k</mi></msub><annotation encoding="application/x-tex">i_{k}</annotation></semantics></math> are derived from <math id="Ch2.S3.SS4.SSSx5.p1.m3" class="ltx_Math" alttext="x_{k}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>k</mi></msub><annotation encoding="application/x-tex">x_{k}</annotation></semantics></math>. Again, note that this can be lifted to an associative scan by defining <math id="Ch2.S3.SS4.SSSx5.p1.m4" class="ltx_Math" alttext="e_{k}=\left(\text{diag}\left(a_{k}\right),\text{diag}\left(\sqrt{1-a_{k}^{2}}\odot i_{k}\right)\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>k</mi></msub><mo>=</mo><mrow><mo>(</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>a</mi><mi>k</mi></msub><mo>)</mo></mrow></mrow><mo>,</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mi>a</mi><mi>k</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>i</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">e_{k}=\left(\text{diag}\left(a_{k}\right),\text{diag}\left(\sqrt{1-a_{k}^{2}}\odot i_{k}\right)\right)</annotation></semantics></math>. Like in Mamba, the convolutional view cannot be applied as <math id="Ch2.S3.SS4.SSSx5.p1.m5" class="ltx_Math" alttext="a_{k}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>k</mi></msub><annotation encoding="application/x-tex">a_{k}</annotation></semantics></math> depends on <math id="Ch2.S3.SS4.SSSx5.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div>
</section>
</section>
</section>
</section>
<section id="Ch3" class="ltx_chapter">
<h2 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 3 </span>Poolformer</h2>

<div id="Ch3.p1" class="ltx_para">
<p id="Ch3.p1.1" class="ltx_p">Modern sequence-to-sequence models are typically based on the transformer architecture, which is organized as a stack of blocks. Each block combines temporal mixing across the sequence dimension (through self-attention layers) and channel mixing (through dense layers). While this design has proven highly effective, the quadratic cost of self-attention with respect to sequence length makes scaling to very long sequences computationally prohibitive.</p>
</div>
<div id="Ch3.p2" class="ltx_para">
<p id="Ch3.p2.1" class="ltx_p">We aim to design a sequence-to-sequence model suitable for very long sequences. An obvious starting point is replacing self-attention layers with recurrent layers. However, if the sequences are extremely long, this might not be efficient enough. In addition, even though recurrent neural networks have a potentially infinite context window, in practice, they do not. In this thesis, we will study how pooling can help alleviate these issues.</p>
</div>
<section id="Ch3.S1" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3.1 </span>SkipBlocks</h3>

<figure id="Ch3.F1" class="ltx_figure"><object type="image/svg+xml" data="2510.02206v1/norm.svg" id="Ch3.F1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:238/139;" width="238" height="139"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F1.3" class="ltx_text" style="font-size:90%;">Figure 3.1</span>: </span><span id="Ch3.F1.4" class="ltx_text" style="font-size:90%;">Comparison of post-layer normalization (left) and pre-layer normalization (right).</span></figcaption>
</figure>
<div id="Ch3.S1.p1" class="ltx_para">
<p id="Ch3.S1.p1.1" class="ltx_p">The original transformer places the normalization layer between residual blocks (post-layer normalization) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite>. Pre-layer normalization, on the other hand, moves the normalization layer to the beginning of the residual block. This makes the model more interpretable: the black vertical bar in Figure <a href="#Ch3.F1" title="Figure 3.1 ‣ 3.1 SkipBlocks ‣ Chapter 3 Poolformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> (often called the residual stream) is the original input plus the output of the different blocks. At present, pre-layer normalization is more common, as it has been shown to improve training stability (refer to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite> for more details).</p>
</div>
<div id="Ch3.S1.p2" class="ltx_para">
<p id="Ch3.S1.p2.1" class="ltx_p">Normal transformer-like models consist of a stack of residual blocks, each adding its contribution to the residual stream (see Figure <a href="#Ch3.F1" title="Figure 3.1 ‣ 3.1 SkipBlocks ‣ Chapter 3 Poolformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>). However, if we apply down-pooling, the dimension of the data changes, and residual connections are no longer feasible. Thus, instead of defining our model as a sequence of blocks, we define it recursively in terms of SkipBlocks.</p>
</div>
<div id="Ch3.S1.p3" class="ltx_para">
<p id="Ch3.S1.p3.1" class="ltx_p">A SkipBlock consists of a down-pooling layer, an inner SkipBlock, and an up-pooling layer. It also contains MLP and temporal mixing ResBlocks, as a normal transformer would. We consider two ways of introducing skip-connections: from the beginning to the end (long skip-connections) and around the pooling layers (short skip-connections). In Chapter <a href="#Ch4.S4" title="4.4 Model Ablations ‣ Chapter 4 Experiments" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>, we ablate the importance of having ResBlocks around the pooling layers (instead of just after). See Figure <a href="#Ch3.F2" title="Figure 3.2 ‣ 3.1 SkipBlocks ‣ Chapter 3 Poolformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> for a visual explanation.</p>
</div>
<figure id="Ch3.F2" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="Ch3.F2.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02206v1/shortskip.svg" id="Ch3.F2.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/318;" width="476" height="318"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F2.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="Ch3.F2.sf1.4" class="ltx_text" style="font-size:90%;">(short skip-connections)</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="Ch3.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02206v1/longskip.svg" id="Ch3.F2.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/318;" width="476" height="318"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F2.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="Ch3.F2.sf2.4" class="ltx_text" style="font-size:90%;">(long skip-connections)</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F2.4" class="ltx_text" style="font-size:90%;">Figure 3.2</span>: </span><span id="Ch3.F2.5" class="ltx_text ltx_font_bold" style="font-size:90%;">SkipBlock.<span id="Ch3.F2.5.1" class="ltx_text ltx_font_medium"> A SkipBlock consists of a down-pooling layer, an inner SkipBlock, and an up-pooling layer. It also contains MLP and temporal mixing ResBlocks. The skip-connections (pink) connect distant parts of the residual stream with the same shape to improve gradient flow. </span></span></figcaption>
</figure>
</section>
<section id="Ch3.S2" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3.2 </span>Pooling</h3>

<figure id="Ch3.F3" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="Ch3.F3.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.02206v1/downpooling.png" id="Ch3.F3.sf1.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/396;" width="476" height="396" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F3.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="Ch3.F3.sf1.4" class="ltx_text" style="font-size:90%;">Down-pooling</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="Ch3.F3.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.02206v1/uppooling.png" id="Ch3.F3.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/396;" width="476" height="396" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F3.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="Ch3.F3.sf2.4" class="ltx_text" style="font-size:90%;">Up-pooling</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F3.4" class="ltx_text" style="font-size:90%;">Figure 3.3</span>: </span><span id="Ch3.F3.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Pooling.<span id="Ch3.F3.5.1" class="ltx_text ltx_font_medium"> Pooling is implemented with strided convolutions (down-pooling) and strided transposed convolutions (up-pooling). In this example, the pooling factor is <math id="Ch3.F3.m2" class="ltx_Math" alttext="F=3" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">F=3</annotation></semantics></math> and the sequence length is 6.</span></span></figcaption>
</figure>
<div id="Ch3.S2.p1" class="ltx_para">
<p id="Ch3.S2.p1.1" class="ltx_p">In order to reduce the sequence length by a factor of <math id="Ch3.S2.p1.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, we use a 1-dimensional convolution with kernel size <math id="Ch3.S2.p1.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, stride <math id="Ch3.S2.p1.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, and feature group count <math id="Ch3.S2.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. This requires <math id="Ch3.S2.p1.m5" class="ltx_Math" alttext="FD^{2}/G" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">FD^{2}/G</annotation></semantics></math> parameters. The procedure, depicted in Figure <a href="#Ch3.F3" title="Figure 3.3 ‣ 3.2 Pooling ‣ Chapter 3 Poolformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, can be summarized as follows:</p>
</div>
<div id="Ch3.S2.p2" class="ltx_para">
<ol id="Ch3.S2.I1" class="ltx_enumerate">
<li id="Ch3.S2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="Ch3.S2.I1.i1.p1" class="ltx_para">
<p id="Ch3.S2.I1.i1.p1.1" class="ltx_p">Divide the sequence, of shape <math id="Ch3.S2.I1.i1.p1.m1" class="ltx_Math" alttext="\mathbb{R}^{L\times D}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{L\times D}</annotation></semantics></math>, into <math id="Ch3.S2.I1.i1.p1.m2" class="ltx_Math" alttext="\frac{L}{F}" display="inline" intent=":literal"><semantics><mfrac><mi>L</mi><mi>F</mi></mfrac><annotation encoding="application/x-tex">\frac{L}{F}</annotation></semantics></math> disjoint segments of shape <math id="Ch3.S2.I1.i1.p1.m3" class="ltx_Math" alttext="\mathbb{R}^{F\times D}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mi>F</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{F\times D}</annotation></semantics></math></p>
</div></li>
<li id="Ch3.S2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="Ch3.S2.I1.i2.p1" class="ltx_para">
<p id="Ch3.S2.I1.i2.p1.1" class="ltx_p">Every segment needs to be mapped to a single vector in <math id="Ch3.S2.I1.i2.p1.m1" class="ltx_Math" alttext="\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>D</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{D}</annotation></semantics></math>. In order to do that,</p>
<ol id="Ch3.S2.I1.i2.I1" class="ltx_enumerate">
<li id="Ch3.S2.I1.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="Ch3.S2.I1.i2.I1.i1.p1" class="ltx_para">
<p id="Ch3.S2.I1.i2.I1.i1.p1.1" class="ltx_p">We map the <math id="Ch3.S2.I1.i2.I1.i1.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th vector in a segment to a vector in <math id="Ch3.S2.I1.i2.I1.i1.p1.m2" class="ltx_Math" alttext="\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>D</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{D}</annotation></semantics></math> using <math id="Ch3.S2.I1.i2.I1.i1.p1.m3" class="ltx_Math" alttext="W_{i}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>i</mi></msub><annotation encoding="application/x-tex">W_{i}</annotation></semantics></math>, where <math id="Ch3.S2.I1.i2.I1.i1.p1.m4" class="ltx_Math" alttext="W_{i}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>i</mi></msub><annotation encoding="application/x-tex">W_{i}</annotation></semantics></math> is a block-diagonal matrix with block size equal to <math id="Ch3.S2.I1.i2.I1.i1.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Special cases are <math id="Ch3.S2.I1.i2.I1.i1.p1.m6" class="ltx_Math" alttext="G=1" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">G=1</annotation></semantics></math> (ordinary matrix) and <math id="Ch3.S2.I1.i2.I1.i1.p1.m7" class="ltx_Math" alttext="G=D" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">G=D</annotation></semantics></math> (diagonal matrix).</p>
</div></li>
<li id="Ch3.S2.I1.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="Ch3.S2.I1.i2.I1.i2.p1" class="ltx_para">
<p id="Ch3.S2.I1.i2.I1.i2.p1.1" class="ltx_p">We sum all the mapped vectors, from <math id="Ch3.S2.I1.i2.I1.i2.p1.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> to <math id="Ch3.S2.I1.i2.I1.i2.p1.m2" class="ltx_Math" alttext="i=F" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">i=F</annotation></semantics></math>.</p>
</div></li>
</ol>
</div></li>
</ol>
</div>
<div id="Ch3.S2.p3" class="ltx_para">
<p id="Ch3.S2.p3.1" class="ltx_p">In order to increase the sequence length by a factor of <math id="Ch3.S2.p3.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, we use a transposed convolution with stride <math id="Ch3.S2.p3.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. The procedure is:</p>
<ol id="Ch3.S2.I2" class="ltx_enumerate">
<li id="Ch3.S2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="Ch3.S2.I2.i1.p1" class="ltx_para">
<p id="Ch3.S2.I2.i1.p1.1" class="ltx_p">For each token <math id="Ch3.S2.I2.i1.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in the down-sampled sequence. Map it with <math id="Ch3.S2.I2.i1.p1.m2" class="ltx_Math" alttext="V_{j}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>j</mi></msub><annotation encoding="application/x-tex">V_{j}</annotation></semantics></math>, from <math id="Ch3.S2.I2.i1.p1.m3" class="ltx_Math" alttext="j=1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j=1</annotation></semantics></math> to <math id="Ch3.S2.I2.i1.p1.m4" class="ltx_Math" alttext="j=F" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">j=F</annotation></semantics></math>, where <math id="Ch3.S2.I2.i1.p1.m5" class="ltx_Math" alttext="V_{j}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>j</mi></msub><annotation encoding="application/x-tex">V_{j}</annotation></semantics></math> is a block-diagonal matrix with block size equal to <math id="Ch3.S2.I2.i1.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.</p>
</div></li>
<li id="Ch3.S2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="Ch3.S2.I2.i2.p1" class="ltx_para">
<p id="Ch3.S2.I2.i2.p1.1" class="ltx_p">These will be output tokens <math id="Ch3.S2.I2.i2.p1.m1" class="ltx_Math" alttext="Fi" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">Fi</annotation></semantics></math>, <math id="Ch3.S2.I2.i2.p1.m2" class="ltx_Math" alttext="Fi+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">Fi+1</annotation></semantics></math>, … <math id="Ch3.S2.I2.i2.p1.m3" class="ltx_Math" alttext="Fi+(F-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Fi+(F-1)</annotation></semantics></math></p>
</div></li>
</ol>
<p id="Ch3.S2.p3.2" class="ltx_p">The output of the up-pooling layer will be merged onto the residual stream. In order to keep training stable, we initialize the up-pooling layer’s weights by sampling from</p>
<table id="Ch3.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch3.E1.m1" class="ltx_Math" alttext="\mathcal{N}\left(0,\frac{\mathtt{scale}}{n_{\mathrm{in}}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mfrac><mi>𝚜𝚌𝚊𝚕𝚎</mi><msub><mi>n</mi><mi>in</mi></msub></mfrac><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{N}\left(0,\frac{\mathtt{scale}}{n_{\mathrm{in}}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.1)</span></td></tr></tbody>
</table>
<p id="Ch3.S2.p3.3" class="ltx_p">where <math id="Ch3.S2.p3.m3" class="ltx_Math" alttext="n_{\mathrm{in}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>in</mi></msub><annotation encoding="application/x-tex">n_{\mathrm{in}}</annotation></semantics></math> is the number of inputs. If <math id="Ch3.S2.p3.m4" class="ltx_Math" alttext="\mathtt{scale}=1" display="inline" intent=":literal"><semantics><mrow><mi>𝚜𝚌𝚊𝚕𝚎</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathtt{scale}=1</annotation></semantics></math>, we recover Lecun normal initialization. If <math id="Ch3.S2.p3.m5" class="ltx_Math" alttext="\mathtt{scale}=0" display="inline" intent=":literal"><semantics><mrow><mi>𝚜𝚌𝚊𝚕𝚎</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathtt{scale}=0</annotation></semantics></math>, the behavior of the network at initialization will be identity-like.</p>
</div>
</section>
<section id="Ch3.S3" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3.3 </span>ResBlocks</h3>

<div id="Ch3.S3.p1" class="ltx_para">
<p id="Ch3.S3.p1.1" class="ltx_p">Both MLPs and temporal mixing layers are wrapped in residual blocks (see Figure <a href="#Ch3.F4" title="Figure 3.4 ‣ 3.3 ResBlocks ‣ Chapter 3 Poolformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>). A residual block (ResBlock) computes its output as <math id="Ch3.S3.p1.m1" class="ltx_Math" alttext="x+F(x)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>+</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x+F(x)</annotation></semantics></math>, where <math id="Ch3.S3.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is the input and <math id="Ch3.S3.p1.m3" class="ltx_Math" alttext="F(x)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(x)</annotation></semantics></math> is a sequence of operations <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">16</a>]</cite>. This structure helps stabilize training and enables deeper architectures by allowing gradients to flow more easily through the network.</p>
</div>
<figure id="Ch3.F4" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="Ch3.F4.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02206v1/resblock.svg" id="Ch3.F4.sf1.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:476/616;" width="476" height="616"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F4.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="Ch3.F4.sf1.4" class="ltx_text" style="font-size:90%;">ResBlock without gating</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="Ch3.F4.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02206v1/gated-resblock.svg" id="Ch3.F4.sf2.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:476/616;" width="476" height="616"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F4.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="Ch3.F4.sf2.4" class="ltx_text" style="font-size:90%;">ResBlock with gating</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch3.F4.3" class="ltx_text" style="font-size:90%;">Figure 3.4</span>: </span><span id="Ch3.F4.4" class="ltx_text" style="font-size:90%;">Comparison of standard ResBlock (left) and gated ResBlock (right).</span></figcaption>
</figure>
<section id="Ch3.S3.SSx1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection">Normalization</h4>

<div id="Ch3.S3.SSx1.p1" class="ltx_para">
<p id="Ch3.S3.SSx1.p1.1" class="ltx_p">In our residual block, the first operation is a normalization layer. We tried three different normalization strategies:</p>
<ul id="Ch3.S3.I1" class="ltx_itemize">
<li id="Ch3.S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch3.S3.I1.i1.p1" class="ltx_para">
<p id="Ch3.S3.I1.i1.p1.1" class="ltx_p"><span id="Ch3.S3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">LayerNorm</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">1</a>]</cite>, in which the tensor is first standardized across the feature dimension, and then scaled and shifted by some learned parameters. That is, given <math id="Ch3.S3.I1.i1.p1.m1" class="ltx_Math" alttext="x\in\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}^{D}</annotation></semantics></math>, we compute <math id="Ch3.S3.I1.i1.p1.m2" class="ltx_Math" alttext="\text{LayerNorm}(x)" display="inline" intent=":literal"><semantics><mrow><mtext>LayerNorm</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{LayerNorm}(x)</annotation></semantics></math> independently for each sample and time-step:</p>
<table id="Ch3.S3.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Ch3.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch3.E2.m1" class="ltx_Math" alttext="\displaystyle\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\displaystyle\mu</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch3.E2.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{D}\sum_{i=1}^{D}x_{i}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{D}\sum_{i=1}^{D}x_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.2)</span></td></tr></tbody>
<tbody id="Ch3.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch3.E3.m1" class="ltx_Math" alttext="\displaystyle\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\displaystyle\sigma</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch3.E3.m2" class="ltx_Math" alttext="\displaystyle=\sqrt{\frac{1}{D}\sum_{i=1}^{D}(x_{i}-\mu)^{2}+\epsilon}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{\frac{1}{D}\sum_{i=1}^{D}(x_{i}-\mu)^{2}+\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.3)</span></td></tr></tbody>
<tbody id="Ch3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch3.E4.m1" class="ltx_Math" alttext="\displaystyle\text{LayerNorm}(x)" display="inline" intent=":literal"><semantics><mrow><mtext>LayerNorm</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{LayerNorm}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch3.E4.m2" class="ltx_Math" alttext="\displaystyle=\gamma\odot\left(\frac{x-\mu}{\sigma}\right)+\beta" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>γ</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><mi>μ</mi></mrow><mi>σ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mi>β</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\odot\left(\frac{x-\mu}{\sigma}\right)+\beta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.4)</span></td></tr></tbody>
</table>
<p id="Ch3.S3.I1.i1.p1.2" class="ltx_p">where <math id="Ch3.S3.I1.i1.p1.m3" class="ltx_Math" alttext="\gamma,\beta\in\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>,</mo><mi>β</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">\gamma,\beta\in\mathbb{R}^{D}</annotation></semantics></math> are learnable.</p>
</div></li>
<li id="Ch3.S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch3.S3.I1.i2.p1" class="ltx_para">
<p id="Ch3.S3.I1.i2.p1.1" class="ltx_p"><span id="Ch3.S3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">RMSNorm</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite>, in which the tensor is first normalized by the root mean square, and then scaled by some learned parameters. It uses half as many parameters as LayerNorm, and previous research <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">2</a>]</cite> found it more stable while training recurrent models.</p>
<table id="Ch3.S3.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Ch3.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch3.E5.m1" class="ltx_Math" alttext="\displaystyle\text{RMS}(x)" display="inline" intent=":literal"><semantics><mrow><mtext>RMS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{RMS}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch3.E5.m2" class="ltx_Math" alttext="\displaystyle=\sqrt{\frac{1}{D}\sum_{i=1}^{d}x_{i}^{2}+\epsilon}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{\frac{1}{D}\sum_{i=1}^{d}x_{i}^{2}+\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.5)</span></td></tr></tbody>
<tbody id="Ch3.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch3.E6.m1" class="ltx_Math" alttext="\displaystyle\text{RMSNorm}(x)" display="inline" intent=":literal"><semantics><mrow><mtext>RMSNorm</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{RMSNorm}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch3.E6.m2" class="ltx_Math" alttext="\displaystyle=\gamma\odot\left(\frac{x}{\text{RMS}(x)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>γ</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>x</mi><mrow><mtext>RMS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\odot\left(\frac{x}{\text{RMS}(x)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.6)</span></td></tr></tbody>
</table>
</div></li>
<li id="Ch3.S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch3.S3.I1.i3.p1" class="ltx_para">
<p id="Ch3.S3.I1.i3.p1.1" class="ltx_p"><span id="Ch3.S3.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">No normalization</span>, where the normalization layer is replaced by the identity function. This was done to test whether normalization could be avoided with careful initialization.</p>
</div></li>
</ul>
</div>
</section>
<section id="Ch3.S3.SSx2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection">Gating</h4>

<div id="Ch3.S3.SSx2.p1" class="ltx_para">
<p id="Ch3.S3.SSx2.p1.1" class="ltx_p">Inspired by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, we consider two variants of our residual block (see Figure <a href="#Ch3.F4" title="Figure 3.4 ‣ 3.3 ResBlocks ‣ Chapter 3 Poolformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a> for a visual explanation):</p>
<ul id="Ch3.S3.I2" class="ltx_itemize">
<li id="Ch3.S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch3.S3.I2.i1.p1" class="ltx_para">
<p id="Ch3.S3.I2.i1.p1.1" class="ltx_p"><span id="Ch3.S3.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Without gating:</span> the MLP or temporal mixing layer followed by a gelu non-linearity <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite>, and then by a dense layer.</p>
</div></li>
<li id="Ch3.S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch3.S3.I2.i2.p1" class="ltx_para">
<p id="Ch3.S3.I2.i2.p1.1" class="ltx_p"><span id="Ch3.S3.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">With gating:</span> two branches are created, one with the MLP or temporal mixing layer, and another with a dense layer and a gelu. After that, both branches are multiplied component-wise. The result is then passed through a final dense layer.</p>
</div></li>
</ul>
<p id="Ch3.S3.SSx2.p1.2" class="ltx_p">The output of the final dense layer will be passed through a Dropout layer, and then merged onto the residual stream. In order to keep training stable, we initialize the last layer’s weights by sampling from</p>
<table id="Ch3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch3.E7.m1" class="ltx_Math" alttext="\mathcal{N}\left(0,\frac{\mathtt{scale}}{n_{\mathrm{in}}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mfrac><mi>𝚜𝚌𝚊𝚕𝚎</mi><msub><mi>n</mi><mi>in</mi></msub></mfrac><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{N}\left(0,\frac{\mathtt{scale}}{n_{\mathrm{in}}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.7)</span></td></tr></tbody>
</table>
<p id="Ch3.S3.SSx2.p1.3" class="ltx_p">where <math id="Ch3.S3.SSx2.p1.m1" class="ltx_Math" alttext="n_{\mathrm{in}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>in</mi></msub><annotation encoding="application/x-tex">n_{\mathrm{in}}</annotation></semantics></math> is the number of inputs. If <math id="Ch3.S3.SSx2.p1.m2" class="ltx_Math" alttext="\mathtt{scale}=1" display="inline" intent=":literal"><semantics><mrow><mi>𝚜𝚌𝚊𝚕𝚎</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathtt{scale}=1</annotation></semantics></math>, we recover Lecun normal initialization. If <math id="Ch3.S3.SSx2.p1.m3" class="ltx_Math" alttext="\mathtt{scale}=0" display="inline" intent=":literal"><semantics><mrow><mi>𝚜𝚌𝚊𝚕𝚎</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathtt{scale}=0</annotation></semantics></math>, the behavior of the network at initialization will be identity-like.</p>
</div>
</section>
<section id="Ch3.S3.SSx3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection">Dropout</h4>

<div id="Ch3.S3.SSx3.p1" class="ltx_para">
<p id="Ch3.S3.SSx3.p1.1" class="ltx_p">To avoid overfitting, we include a Dropout layer <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">29</a>]</cite> as the last operation. Dropout randomly sets a fraction of the input units to zero during training, which helps prevent the model from relying too heavily on any particular feature and encourages better generalization.</p>
</div>
</section>
</section>
<section id="Ch3.S4" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3.4 </span>Temporal Mixing Layer</h3>

<div id="Ch3.S4.p1" class="ltx_para">
<p id="Ch3.S4.p1.1" class="ltx_p">As temporal mixing layer, we use the RG-LRU, introduced in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>. Additionally, we explore introducing attention in the deepest layers, where the sequence length is short. The recurrence is given by the following equations.</p>
<table id="Ch3.S4.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Ch3.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch3.E8.m1" class="ltx_Math" alttext="\displaystyle r_{k}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle r_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch3.E8.m2" class="ltx_Math" alttext="\displaystyle=\sigma(W_{a}x_{k}+b_{a})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>W</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow><mo>+</mo><msub><mi>b</mi><mi>a</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma(W_{a}x_{k}+b_{a})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.8)</span></td></tr></tbody>
<tbody id="Ch3.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch3.E9.m1" class="ltx_Math" alttext="\displaystyle i_{k}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle i_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch3.E9.m2" class="ltx_Math" alttext="\displaystyle=\sigma(W_{x}x_{k}+b_{x})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>W</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow><mo>+</mo><msub><mi>b</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma(W_{x}x_{k}+b_{x})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.9)</span></td></tr></tbody>
<tbody id="Ch3.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch3.E10.m1" class="ltx_Math" alttext="\displaystyle a_{k}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle a_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch3.E10.m2" class="ltx_Math" alttext="\displaystyle=a^{cr_{k}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mi>a</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>k</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle=a^{cr_{k}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.10)</span></td></tr></tbody>
<tbody id="Ch3.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch3.E11.m1" class="ltx_Math" alttext="\displaystyle h_{k}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle h_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch3.E11.m2" class="ltx_Math" alttext="\displaystyle=a_{k}\odot h_{k-1}+\sqrt{1-a_{k}^{2}}\odot(i_{k}\odot x_{k})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>a</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>h</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mi>a</mi><mi>k</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0.222em" rspace="0.222em">⊙</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>x</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=a_{k}\odot h_{k-1}+\sqrt{1-a_{k}^{2}}\odot(i_{k}\odot x_{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.11)</span></td></tr></tbody>
</table>
<p id="Ch3.S4.p1.2" class="ltx_p">Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, we fix <math id="Ch3.S4.p1.m1" class="ltx_Math" alttext="c=8" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">c=8</annotation></semantics></math>. Regarding <math id="Ch3.S4.p1.m2" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, we explore using both complex and real values. Note that if the magnitude is small, the hidden states will quickly converge to zero. Similarly, if the magnitude is larger than one, the hidden state will diverge to infinity. Because of this, we use a parametrization that ensures that the magnitude will always be less than one.</p>
</div>
<section id="Ch3.S4.SS0.SSSx1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection">Real case</h5>

<div id="Ch3.S4.SS0.SSSx1.p1" class="ltx_para">
<p id="Ch3.S4.SS0.SSSx1.p1.1" class="ltx_p">In the real case we set <math id="Ch3.S4.SS0.SSSx1.p1.m1" class="ltx_Math" alttext="a=\sigma(\Lambda)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a=\sigma(\Lambda)</annotation></semantics></math>, where <math id="Ch3.S4.SS0.SSSx1.p1.m2" class="ltx_Math" alttext="\Lambda\in\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">\Lambda\in\mathbb{R}^{D}</annotation></semantics></math>. We initialize <math id="Ch3.S4.SS0.SSSx1.p1.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> in such a way that <math id="Ch3.S4.SS0.SSSx1.p1.m4" class="ltx_Math" alttext="a\sim\sqrt{\mathcal{U}[0.9^{2},0.99^{2}]}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∼</mo><msqrt><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mn>0.9</mn><mn>2</mn></msup><mo>,</mo><msup><mn>0.99</mn><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">a\sim\sqrt{\mathcal{U}[0.9^{2},0.99^{2}]}</annotation></semantics></math>.</p>
</div>
</section>
<section id="Ch3.S4.SS0.SSSx2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection">Complex case</h5>

<div id="Ch3.S4.SS0.SSSx2.p1" class="ltx_para">
<p id="Ch3.S4.SS0.SSSx2.p1.1" class="ltx_p">In the complex case we set <math id="Ch3.S4.SS0.SSSx2.p1.m1" class="ltx_Math" alttext="a=\sigma(\Lambda)\exp(i\theta)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">a=\sigma(\Lambda)\exp(i\theta)</annotation></semantics></math>, where <math id="Ch3.S4.SS0.SSSx2.p1.m2" class="ltx_Math" alttext="\Lambda\in\mathbb{R}^{\frac{D}{2}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>∈</mo><msup><mi>ℝ</mi><mfrac><mi>D</mi><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\Lambda\in\mathbb{R}^{\frac{D}{2}}</annotation></semantics></math>, and <math id="Ch3.S4.SS0.SSSx2.p1.m3" class="ltx_Math" alttext="\theta\in\mathbb{R}^{\frac{D}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>ℝ</mi><mfrac><mi>D</mi><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\theta\in\mathbb{R}^{\frac{D}{2}}</annotation></semantics></math>. We initialize <math id="Ch3.S4.SS0.SSSx2.p1.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> in such a way that <math id="Ch3.S4.SS0.SSSx2.p1.m5" class="ltx_Math" alttext="\sigma(\Lambda)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(\Lambda)</annotation></semantics></math> follows a <math id="Ch3.S4.SS0.SSSx2.p1.m6" class="ltx_Math" alttext="\sqrt{\mathcal{U}[0.9^{2},0.99^{2}]}" display="inline" intent=":literal"><semantics><msqrt><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mn>0.9</mn><mn>2</mn></msup><mo>,</mo><msup><mn>0.99</mn><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{\mathcal{U}[0.9^{2},0.99^{2}]}</annotation></semantics></math>. On the other hand, <math id="Ch3.S4.SS0.SSSx2.p1.m7" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is initialized by sampling from a <math id="Ch3.S4.SS0.SSSx2.p1.m8" class="ltx_Math" alttext="\mathcal{U}[0,\frac{\pi}{10}]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mfrac><mi>π</mi><mn>10</mn></mfrac></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}[0,\frac{\pi}{10}]</annotation></semantics></math>, following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">24</a>]</cite>. This results in a uniform initialization on the short ring in the complex plane centered at the origin, with radius in the interval <math id="Ch3.S4.SS0.SSSx2.p1.m9" class="ltx_Math" alttext="[0.9,0.99]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0.9</mn><mo>,</mo><mn>0.99</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.9,0.99]</annotation></semantics></math> and angle restricted to the interval <math id="Ch3.S4.SS0.SSSx2.p1.m10" class="ltx_Math" alttext="[0,\frac{\pi}{10}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mfrac><mi>π</mi><mn>10</mn></mfrac><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,\frac{\pi}{10}]</annotation></semantics></math>. Note that if we had sampled <math id="Ch3.S4.SS0.SSSx2.p1.m11" class="ltx_Math" alttext="\sigma(\Lambda)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(\Lambda)</annotation></semantics></math> from <math id="Ch3.S4.SS0.SSSx2.p1.m12" class="ltx_Math" alttext="\mathcal{U}[0.9,0.99]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0.9</mn><mo>,</mo><mn>0.99</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}[0.9,0.99]</annotation></semantics></math>, the distribution wouldn’t be uniform on the ring, as the concentration of points would be larger closer to the origin.</p>
</div>
<div id="Ch3.S4.SS0.SSSx2.p2" class="ltx_para">
<p id="Ch3.S4.SS0.SSSx2.p2.1" class="ltx_p">Even if the recursion occurs in complex space, we need to map the output back to real numbers to use ordinary layers, such as dense layers. In order to do this, we concatenate the real and imaginary parts, obtaining a vector in <math id="Ch3.S4.SS0.SSSx2.p2.m1" class="ltx_Math" alttext="\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>D</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{D}</annotation></semantics></math>.</p>
</div>
</section>
</section>
</section>
<section id="Ch4" class="ltx_chapter">
<h2 class="ltx_title ltx_title_chapter"><span class="ltx_tag ltx_tag_chapter">Chapter 4 </span>Experiments</h2>

<section id="Ch4.S1" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4.1 </span>Datasets</h3>

<div id="Ch4.S1.p1" class="ltx_para">
<p id="Ch4.S1.p1.1" class="ltx_p">We use the same three datasets from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite>, keeping the same train / validation / test split. All of them are audio recordings sampled at 16000 Hz with 16-bit linear PCM encoding.</p>
<ol id="Ch4.S1.I1" class="ltx_enumerate">
<li id="Ch4.S1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="Ch4.S1.I1.i1.p1" class="ltx_para">
<p id="Ch4.S1.I1.i1.p1.1" class="ltx_p"><span id="Ch4.S1.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">SC09</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>, <a href="#bib.bib33" title="" class="ltx_ref">33</a>]</cite>, which consists of 1-second (16,000 tokens) recordings of the spoken digits zero to nine (similar to MNIST <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite>, but with audio instead of images). For this dataset, we also compute the FID and IS scores using SaShiMi’s repo <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite>.</p>
</div></li>
<li id="Ch4.S1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="Ch4.S1.I1.i2.p1" class="ltx_para">
<p id="Ch4.S1.I1.i2.p1.1" class="ltx_p"><span id="Ch4.S1.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Beethoven</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite>, that contains 8-second (128,000 tokens) recordings of Beethoven’s piano sonatas.</p>
</div></li>
<li id="Ch4.S1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="Ch4.S1.I1.i3.p1" class="ltx_para">
<p id="Ch4.S1.I1.i3.p1.1" class="ltx_p"><span id="Ch4.S1.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">YouTubeMix</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>]</cite>, that contains 1-minute (960,512 tokens) recordings of Beethoven’s piano sonatas.</p>
</div></li>
</ol>
<p id="Ch4.S1.p1.2" class="ltx_p">Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite>, we apply <math id="Ch4.S1.p1.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-law encoding to SC09 and YouTubeMix, and linear encoding to Beethoven, which results in unsigned 8-bit representations.</p>
</div>
</section>
<section id="Ch4.S2" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4.2 </span>Experimental setup</h3>

<div id="Ch4.S2.p1" class="ltx_para">
<p id="Ch4.S2.p1.1" class="ltx_p">We use JAX and related libraries (JAX, FLAX, Optax) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>, and train all of our models on TPU v4-8 and v3-128. We use the AdamW optimizer <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib22" title="" class="ltx_ref">22</a>]</cite> with a learning rate of 0.002. All other hyperparameters are set to the default values in Optax: <math id="Ch4.S2.p1.m1" class="ltx_Math" alttext="\beta_{1}=0.9" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><mn>0.9</mn></mrow><annotation encoding="application/x-tex">\beta_{1}=0.9</annotation></semantics></math>, <math id="Ch4.S2.p1.m2" class="ltx_Math" alttext="\beta_{2}=0.999" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>=</mo><mn>0.999</mn></mrow><annotation encoding="application/x-tex">\beta_{2}=0.999</annotation></semantics></math>, and a weight decay of 0.0001. Training is performed with:</p>
<ul id="Ch4.S2.I1" class="ltx_itemize">
<li id="Ch4.S2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S2.I1.i1.p1" class="ltx_para">
<p id="Ch4.S2.I1.i1.p1.1" class="ltx_p">A constant learning rate schedule, using a linear warmup for the first 1000 steps.</p>
</div></li>
<li id="Ch4.S2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S2.I1.i2.p1" class="ltx_para">
<p id="Ch4.S2.I1.i2.p1.1" class="ltx_p">A batch size of 32.</p>
</div></li>
<li id="Ch4.S2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S2.I1.i3.p1" class="ltx_para">
<p id="Ch4.S2.I1.i3.p1.1" class="ltx_p">500 total training epochs.</p>
</div></li>
</ul>
</div>
<div id="Ch4.S2.p2" class="ltx_para">
<p id="Ch4.S2.p2.1" class="ltx_p">Model evaluation is conducted on the validation and test sets at the end of every epoch. We apply an exponential moving average (EMA) to the model weights during evaluation, with an EMA decay rate of 0.999.</p>
</div>
<div id="Thmdefinition17" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition17.2" class="ltx_text ltx_font_bold">Definition 17</span></span><span id="Thmdefinition17.3" class="ltx_text ltx_font_bold"> </span>(Pooling configuration)<span id="Thmdefinition17.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition17.p1" class="ltx_para">
<p id="Thmdefinition17.p1.1" class="ltx_p"><span id="Thmdefinition17.p1.1.1" class="ltx_text ltx_font_italic">The pooling configuration is specified by a list of integers. For example, our baseline model has a pooling configuration of <math id="Thmdefinition17.p1.m1" class="ltx_Math" alttext="[2,4,4,5]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[2,4,4,5]</annotation></semantics></math>, which means that in the deepest level, the sequence has <math id="Thmdefinition17.p1.m2" class="ltx_Math" alttext="2\cdot 4\cdot 4\cdot 5=160" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>4</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>4</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>5</mn></mrow><mo>=</mo><mn>160</mn></mrow><annotation encoding="application/x-tex">2\cdot 4\cdot 4\cdot 5=160</annotation></semantics></math> times fewer tokens than in the shallowest level.</span></p>
</div>
</div>
<div id="Thmdefinition18" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition18.2" class="ltx_text ltx_font_bold">Definition 18</span></span><span id="Thmdefinition18.3" class="ltx_text ltx_font_bold"> </span>(Layer configuration)<span id="Thmdefinition18.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition18.p1" class="ltx_para">
<p id="Thmdefinition18.p1.1" class="ltx_p"><span id="Thmdefinition18.p1.1.1" class="ltx_text ltx_font_italic">The layer configuration defines the number of RG-LRU layers at each level of the model’s hierarchy. It is specified by a list of <math id="Thmdefinition18.p1.m1" class="ltx_Math" alttext="n+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n+1</annotation></semantics></math> integers, <math id="Thmdefinition18.p1.m2" class="ltx_Math" alttext="[l_{1},l_{2},...,l_{n},l_{n+1}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>,</mo><msub><mi>l</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>l</mi><mi>n</mi></msub><mo>,</mo><msub><mi>l</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[l_{1},l_{2},...,l_{n},l_{n+1}]</annotation></semantics></math>, for a model with <math id="Thmdefinition18.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> SkipBlocks.</span></p>
<ul id="Ch4.S2.I2" class="ltx_itemize">
<li id="Ch4.S2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S2.I2.i1.p1" class="ltx_para">
<p id="Ch4.S2.I2.i1.p1.1" class="ltx_p"><span id="Ch4.S2.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">For each of the </span><math id="Ch4.S2.I2.i1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="Ch4.S2.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> SkipBlocks, the corresponding integer </span><math id="Ch4.S2.I2.i1.p1.m2" class="ltx_Math" alttext="l_{i}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mi>i</mi></msub><annotation encoding="application/x-tex">l_{i}</annotation></semantics></math><span id="Ch4.S2.I2.i1.p1.1.3" class="ltx_text ltx_font_italic"> specifies the number of RG-LRU layers applied both before down-pooling and after up-pooling. Thus, the </span><math id="Ch4.S2.I2.i1.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="Ch4.S2.I2.i1.p1.1.4" class="ltx_text ltx_font_italic">-th SkipBlock contains a total of </span><math id="Ch4.S2.I2.i1.p1.m4" class="ltx_Math" alttext="2\cdot l_{i}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>l</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">2\cdot l_{i}</annotation></semantics></math><span id="Ch4.S2.I2.i1.p1.1.5" class="ltx_text ltx_font_italic"> layers.</span></p>
</div></li>
<li id="Ch4.S2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S2.I2.i2.p1" class="ltx_para">
<p id="Ch4.S2.I2.i2.p1.1" class="ltx_p"><span id="Ch4.S2.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">The final integer, </span><math id="Ch4.S2.I2.i2.p1.m1" class="ltx_Math" alttext="l_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">l_{n+1}</annotation></semantics></math><span id="Ch4.S2.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">, specifies the number of layers in the deepest part of the network.</span></p>
</div></li>
</ul>
<p id="Thmdefinition18.p1.2" class="ltx_p"><span id="Thmdefinition18.p1.2.1" class="ltx_text ltx_font_italic">For example, our baseline layer configuration is <math id="Thmdefinition18.p1.m4" class="ltx_Math" alttext="[4,4,4,4,4]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[4,4,4,4,4]</annotation></semantics></math>. In this case, <math id="Thmdefinition18.p1.m5" class="ltx_Math" alttext="n=4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n=4</annotation></semantics></math>:</span></p>
<ul id="Ch4.S2.I3" class="ltx_itemize">
<li id="Ch4.S2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S2.I3.i1.p1" class="ltx_para">
<p id="Ch4.S2.I3.i1.p1.1" class="ltx_p"><span id="Ch4.S2.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">There are </span><math id="Ch4.S2.I3.i1.p1.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math><span id="Ch4.S2.I3.i1.p1.1.2" class="ltx_text ltx_font_italic"> SkipBlocks. Each is defined by the value </span><math id="Ch4.S2.I3.i1.p1.m2" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math><span id="Ch4.S2.I3.i1.p1.1.3" class="ltx_text ltx_font_italic">, meaning each contains </span><math id="Ch4.S2.I3.i1.p1.m3" class="ltx_Math" alttext="2\cdot 4=8" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>4</mn></mrow><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">2\cdot 4=8</annotation></semantics></math><span id="Ch4.S2.I3.i1.p1.1.4" class="ltx_text ltx_font_italic"> RG-LRU layers (</span><math id="Ch4.S2.I3.i1.p1.m4" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math><span id="Ch4.S2.I3.i1.p1.1.5" class="ltx_text ltx_font_italic"> layers before down-pooling and </span><math id="Ch4.S2.I3.i1.p1.m5" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math><span id="Ch4.S2.I3.i1.p1.1.6" class="ltx_text ltx_font_italic"> layers after up-pooling).</span></p>
</div></li>
<li id="Ch4.S2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S2.I3.i2.p1" class="ltx_para">
<p id="Ch4.S2.I3.i2.p1.1" class="ltx_p"><span id="Ch4.S2.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">The deepest level is defined by the final value of </span><math id="Ch4.S2.I3.i2.p1.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math><span id="Ch4.S2.I3.i2.p1.1.2" class="ltx_text ltx_font_italic">, meaning it contains </span><math id="Ch4.S2.I3.i2.p1.m2" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math><span id="Ch4.S2.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> RG-LRU layers.</span></p>
</div></li>
<li id="Ch4.S2.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S2.I3.i3.p1" class="ltx_para">
<p id="Ch4.S2.I3.i3.p1.1" class="ltx_p"><span id="Ch4.S2.I3.i3.p1.1.1" class="ltx_text ltx_font_italic">The total number of RG-LRU layers is therefore </span><math id="Ch4.S2.I3.i3.p1.m1" class="ltx_Math" alttext="4\cdot 8+4=36" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>8</mn></mrow><mo>+</mo><mn>4</mn></mrow><mo>=</mo><mn>36</mn></mrow><annotation encoding="application/x-tex">4\cdot 8+4=36</annotation></semantics></math><span id="Ch4.S2.I3.i3.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ul>
</div>
</div>
<div id="Ch4.S2.p3" class="ltx_para">
<p id="Ch4.S2.p3.1" class="ltx_p">In terms of dimensionality, we distinguish between the RG-LRU dimension, which applies to the variables <math id="Ch4.S2.p3.m1" class="ltx_Math" alttext="r_{k}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>k</mi></msub><annotation encoding="application/x-tex">r_{k}</annotation></semantics></math>, <math id="Ch4.S2.p3.m2" class="ltx_Math" alttext="i_{k}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>k</mi></msub><annotation encoding="application/x-tex">i_{k}</annotation></semantics></math>, <math id="Ch4.S2.p3.m3" class="ltx_Math" alttext="a_{k}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>k</mi></msub><annotation encoding="application/x-tex">a_{k}</annotation></semantics></math>, and <math id="Ch4.S2.p3.m4" class="ltx_Math" alttext="h_{k}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>k</mi></msub><annotation encoding="application/x-tex">h_{k}</annotation></semantics></math> within the temporal mixing layer (see Section <a href="#Ch3.S4" title="3.4 Temporal Mixing Layer ‣ Chapter 3 Poolformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>), and the model dimension, which applies to all other components. Our baseline has a model dimension of 128, a dropout rate of 0.2, and RG-LRU layers with complex numbers and a hidden dimension of 256, which brings the total number of parameters to 7,272,704.</p>
</div>
</section>
<section id="Ch4.S3" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4.3 </span>Signal pre-processing and EMA</h3>

<section id="Ch4.S3.SSx1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection">Signal pre-processing</h4>

<div id="Ch4.S3.SSx1.p1" class="ltx_para">
<p id="Ch4.S3.SSx1.p1.1" class="ltx_p">The original audio files are 16-bit, but we convert them into 8-bit. Because of this, the input to the Poolformer are numbers between 0 and 255, which have to be mapped to <math id="Ch4.S3.SSx1.p1.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>-dimensional vectors. This can be done in different ways:</p>
<ul id="Ch4.S3.I1" class="ltx_itemize">
<li id="Ch4.S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S3.I1.i1.p1" class="ltx_para">
<p id="Ch4.S3.I1.i1.p1.1" class="ltx_p"><span id="Ch4.S3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Sinusoidal embeddings</span>. Similarly to the positional embeddings of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite>, or the Fourier features of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">20</a>]</cite>, we can map the class <math id="Ch4.S3.I1.i1.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> (number from 0 to 255) to the concatenation of <math id="Ch4.S3.I1.i1.p1.m2" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> and <math id="Ch4.S3.I1.i1.p1.m3" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math></p>
<table id="Ch4.S3.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Ch4.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch4.E1.m1" class="ltx_Math" alttext="\displaystyle c_{ij}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle c_{ij}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch4.E1.m2" class="ltx_Math" alttext="\displaystyle=\cos\left(\frac{i}{10000^{\frac{j}{D/2}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>i</mi><msup><mn>10000</mn><mfrac><mi>j</mi><mrow><mi>D</mi><mo>/</mo><mn>2</mn></mrow></mfrac></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\cos\left(\frac{i}{10000^{\frac{j}{D/2}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.1)</span></td></tr></tbody>
<tbody id="Ch4.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Ch4.E2.m1" class="ltx_Math" alttext="\displaystyle s_{ij}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle s_{ij}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Ch4.E2.m2" class="ltx_Math" alttext="\displaystyle=\sin\left(\frac{i}{10000^{\frac{j}{D/2}}}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>i</mi><msup><mn>10000</mn><mfrac><mi>j</mi><mrow><mi>D</mi><mo>/</mo><mn>2</mn></mrow></mfrac></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sin\left(\frac{i}{10000^{\frac{j}{D/2}}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.2)</span></td></tr></tbody>
</table>
<p id="Ch4.S3.I1.i1.p1.2" class="ltx_p">where <math id="Ch4.S3.I1.i1.p1.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> goes from 0 to <math id="Ch4.S3.I1.i1.p1.m5" class="ltx_Math" alttext="D/2-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">D/2-1</annotation></semantics></math>. See Figure <a href="#Ch4.F1" title="Figure 4.1 ‣ Signal pre-processing ‣ 4.3 Signal pre-processing and EMA ‣ Chapter 4 Experiments" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> for a more visual explanation.</p>
</div></li>
<li id="Ch4.S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S3.I1.i2.p1" class="ltx_para">
<p id="Ch4.S3.I1.i2.p1.1" class="ltx_p"><span id="Ch4.S3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Linear scaling followed by a dense layer</span>. We can first make the input lie between 0 and 1, and then apply a dense layer. This preserves the natural ordering, but makes similar numbers almost indistinguishable.</p>
</div></li>
<li id="Ch4.S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ch4.S3.I1.i3.p1" class="ltx_para">
<p id="Ch4.S3.I1.i3.p1.1" class="ltx_p"><span id="Ch4.S3.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Embedding layer</span>, so that each class is mapped to a learned feature vector.</p>
</div></li>
</ul>
</div>
<div id="Ch4.S3.SSx1.p2" class="ltx_para">
<p id="Ch4.S3.SSx1.p2.1" class="ltx_p">As shown in Figure <a href="#Ch4.F2" title="Figure 4.2 ‣ Signal pre-processing ‣ 4.3 Signal pre-processing and EMA ‣ Chapter 4 Experiments" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, sinusoidal embeddings provide the model with a very meaningful representation of the input, and results in the best performance. Because of this, sinusoidal embeddings are used in all of our experiments. Note that when using an embedding layer, the performance starts off being significantly worse, but improves over time as the model learns better and better representations. In the long run, both give comparable results.</p>
</div>
<figure id="Ch4.F1" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="Ch4.F1.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.02206v1/sinusoidal-matrix.png" id="Ch4.F1.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/357;" width="476" height="357" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch4.F1.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="Ch4.F1.sf1.4" class="ltx_text" style="font-size:90%;">Sinusoidal embeddings</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="Ch4.F1.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02206v1/sinusoidal-slices.svg" id="Ch4.F1.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/352;" width="476" height="352"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch4.F1.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="Ch4.F1.sf2.4" class="ltx_text" style="font-size:90%;">Some slices from the embeddings</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch4.F1.4" class="ltx_text" style="font-size:90%;">Figure 4.1</span>: </span><span id="Ch4.F1.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Sinusoidal embeddings.<span id="Ch4.F1.5.1" class="ltx_text ltx_font_medium"> Each embedding column is a cosine (first half) or a sine (second half). As <math id="Ch4.F1.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> increases, the frequency of the wave decreases.</span></span></figcaption>
</figure>
<figure id="Ch4.F2" class="ltx_figure ltx_align_center">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch4.F2.4" class="ltx_text" style="font-size:90%;">Figure 4.2</span>: </span><span id="Ch4.F2.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Pre-processing comparison<span id="Ch4.F2.5.1" class="ltx_text ltx_font_medium"> (SC09). The linear scaling strategy performs very poorly, and the model cannot really distinguish between similar inputs. Using embeddings seems to result in overfitting, which can be solved by increasing the dropout rate. Overall, sinusoidal embeddings yield the best performance. </span></span></figcaption><object type="image/svg+xml" data="2510.02206v1/preprocessing.svg" id="Ch4.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/358;" width="476" height="358"></object>
</figure>
</section>
<section id="Ch4.S3.SSx2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection">Exponential Moving Average</h4>

<div id="Ch4.S3.SSx2.p1" class="ltx_para">
<p id="Ch4.S3.SSx2.p1.1" class="ltx_p">Exponential moving average (EMA) is a technique commonly used to stabilize and improve model evaluation. During training, EMA maintains a running average of the model parameters, where recent updates are weighted more heavily than older ones:</p>
</div>
<div id="Ch4.S3.SSx2.p2" class="ltx_para">
<table id="Ch4.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Ch4.E3.m1" class="ltx_Math" alttext="w_{\text{EMA}}\xleftarrow{}\alpha w_{\text{EMA}}+(1-\alpha)w_{\text{new}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mtext>EMA</mtext></msub><mover accent="true"><mo>←</mo><mphantom></mphantom></mover><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mtext>EMA</mtext></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mtext>new</mtext></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">w_{\text{EMA}}\xleftarrow{}\alpha w_{\text{EMA}}+(1-\alpha)w_{\text{new}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.3)</span></td></tr></tbody>
</table>
</div>
<div id="Ch4.S3.SSx2.p3" class="ltx_para">
<p id="Ch4.S3.SSx2.p3.1" class="ltx_p">At evaluation time, predictions are made using these averaged parameters rather than the most recent ones. This helps to smooth out fluctuations caused by noisy updates and often leads to better generalization and more consistent validation or test performance. Typical values for <math id="Ch4.S3.SSx2.p3.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> are 0.999 (our baseline), and 0 (no EMA). In Figure <a href="#Ch4.F3" title="Figure 4.3 ‣ Exponential Moving Average ‣ 4.3 Signal pre-processing and EMA ‣ Chapter 4 Experiments" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> we can see that keeping an EMA of the weights is beneficial, as it results in a smoother and improved test curve.</p>
</div>
<figure id="Ch4.F3" class="ltx_figure"><object type="image/svg+xml" data="2510.02206v1/ema.svg" id="Ch4.F3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:286/215;" width="286" height="215"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Ch4.F3.4" class="ltx_text" style="font-size:90%;">Figure 4.3</span>: </span><span id="Ch4.F3.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Effect of exponential moving average (EMA)<span id="Ch4.F3.5.1" class="ltx_text ltx_font_medium"> (SC09). Applying EMA to model weights during evaluation leads to smoother and slightly improved test curves.</span></span></figcaption>
</figure>
</section>
</section>
<section id="Ch4.S4" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4.4 </span>Model Ablations</h3>

<div id="Ch4.S4.p1" class="ltx_para">
<p id="Ch4.S4.p1.1" class="ltx_p">In this section, we compare different models to our baseline. We perform these ablations on the SC09 dataset exclusively. All results are summarized in Table <a href="#Ch4.T1" title="Table 4.1 ‣ 4.4 Model Ablations ‣ Chapter 4 Experiments" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>.</p>
</div>
<figure id="Ch4.T1" class="ltx_table">
<table id="Ch4.T1.3" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="Ch4.T1.3.1" class="ltx_tr">
<th id="Ch4.T1.3.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="Ch4.T1.3.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>
<td id="Ch4.T1.3.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Ch4.T1.3.1.2.1" class="ltx_text ltx_font_bold">Num. params.</span></td>
<td id="Ch4.T1.3.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="Ch4.T1.3.1.3.1" class="ltx_text ltx_font_bold">Test NLL <math id="Ch4.T1.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="Ch4.T1.3.1.4" class="ltx_td ltx_align_center ltx_border_t"><span id="Ch4.T1.3.1.4.1" class="ltx_text ltx_font_bold">Notes</span></td></tr>
<tr id="Ch4.T1.3.2" class="ltx_tr">
<th id="Ch4.T1.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Poolformer (baseline)</th>
<td id="Ch4.T1.3.2.2" class="ltx_td ltx_align_center ltx_border_t">7,272,704</td>
<td id="Ch4.T1.3.2.3" class="ltx_td ltx_align_center ltx_border_t">1.854 (1.854)</td>
<td id="Ch4.T1.3.2.4" class="ltx_td ltx_border_t"></td></tr>
<tr id="Ch4.T1.3.3" class="ltx_tr">
<th id="Ch4.T1.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w/ RMSNorm instead of LayerNorm</th>
<td id="Ch4.T1.3.3.2" class="ltx_td ltx_align_center">7,263,488</td>
<td id="Ch4.T1.3.3.3" class="ltx_td ltx_align_center">1.874 (1.859)</td>
<td id="Ch4.T1.3.3.4" class="ltx_td ltx_align_center">Unstable</td></tr>
<tr id="Ch4.T1.3.4" class="ltx_tr">
<th id="Ch4.T1.3.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w/ <math id="Ch4.T1.m2" class="ltx_Math" alttext="\mathtt{scale}=0" display="inline" intent=":literal"><semantics><mrow><mi>𝚜𝚌𝚊𝚕𝚎</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathtt{scale}=0</annotation></semantics></math></th>
<td id="Ch4.T1.3.4.2" class="ltx_td ltx_align_center">7,272,704</td>
<td id="Ch4.T1.3.4.3" class="ltx_td ltx_align_center">1.852 (1.852)</td>
<td id="Ch4.T1.3.4.4" class="ltx_td"></td></tr>
