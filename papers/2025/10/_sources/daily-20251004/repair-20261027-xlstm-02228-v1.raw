<span id="A3.T6.6.1.1.1.5.2" class="ltx_td ltx_align_center"><math id="A3.T6.m3" class="ltx_Math" alttext="d_{\text{model}}\big(d_{\text{qk}}n_{\text{head,q}}+(d_{\text{qk}}+d_{\text{hv}})n_{\text{head,kv}}\big)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mtext>model</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>d</mi><mtext>qk</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mtext>head,q</mtext></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mtext>qk</mtext></msub><mo>+</mo><msub><mi>d</mi><mtext>hv</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mtext>head,kv</mtext></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">d_{\text{model}}\big(d_{\text{qk}}n_{\text{head,q}}+(d_{\text{qk}}+d_{\text{hv}})n_{\text{head,kv}}\big)</annotation></semantics></math></span></span>
