<span id="A3.T8.6.1.1.1.7.2" class="ltx_td ltx_align_center"><math id="A3.T8.m9" class="ltx_Math" alttext="\frac{1}{2}L(L+1)+L(F_{\text{log}}+F_{\text{sig}})" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>F</mi><mtext>log</mtext></msub><mo>+</mo><msub><mi>F</mi><mtext>sig</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{2}L(L+1)+L(F_{\text{log}}+F_{\text{sig}})</annotation></semantics></math></span>
<span id="A3.T8.6.1.1.1.7.3" class="ltx_td ltx_align_center"><math id="A3.T8.m10" class="ltx_Math" alttext="0.5L^{2}+2.5L" display="inline" intent=":literal"><semantics><mrow><mrow><mn>0.5</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2.5</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">0.5L^{2}+2.5L</annotation></semantics></math></span></span>
<span id="A3.T8.6.1.1.1.8" class="ltx_tr">
