<span id="A4.T18.4.1.5.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A4.T18.4.1.5.2.1.2.1.1" class="ltx_text ltx_markedasmath">[FLOPs/byte]</span></span></span>
</span></span><span id="A4.T18.4.1.5.3" class="ltx_text"></span></th>
