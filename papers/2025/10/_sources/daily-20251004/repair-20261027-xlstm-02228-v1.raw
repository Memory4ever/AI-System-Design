<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E8Xa.m2" class="ltx_Math" alttext="\displaystyle+2TF_{\text{causal}}+T\left(4d_{\text{qk}}d_{\text{hv}}+6d_{\text{qk}}+4d_{\text{hv}}+13\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mtext>causal</mtext></msub></mrow></mrow><mo>+</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>qk</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>hv</mtext></msub></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>qk</mtext></msub></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>hv</mtext></msub></mrow><mo>+</mo><mn>13</mn></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+2TF_{\text{causal}}+T\left(4d_{\text{qk}}d_{\text{hv}}+6d_{\text{qk}}+4d_{\text{hv}}+13\right)</annotation></semantics></math></td>
