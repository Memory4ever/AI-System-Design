<td id="A1.T1.2.5.1" class="ltx_td ltx_align_right ltx_border_r"><span id="A1.T1.2.5.1.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">1e+20</span></td>
<td id="A1.T1.2.5.2" class="ltx_td ltx_align_right"><span id="A1.T1.2.5.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">128</span></td>
<td id="A1.T1.2.5.3" class="ltx_td ltx_align_right"><span id="A1.T1.2.5.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">1,048,576</span></td></tr>
