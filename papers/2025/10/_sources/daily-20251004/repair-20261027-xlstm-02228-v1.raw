</figure>
<figure id="A1.F7" class="ltx_figure"><object type="image/svg+xml" data="2510.02228v1/plot_isoflop_batch_size_exp_plot.svg" id="A1.F7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/155;" width="548" height="155"></object>
