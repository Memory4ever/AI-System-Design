<figure id="A5.T21" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">Table 21: </span><span id="A5.T21.4" class="ltx_text ltx_font_bold">List of hyperparameters for xLSTM models</span> trained with the <span id="A5.T21.5" class="ltx_text ltx_font_bold">IsoFLOP</span> configuration.</figcaption>
<p id="A5.T21.6" class="ltx_p"><span id="A5.T21.6.1" class="ltx_text ltx_inline-block" style="width:397.5pt;">
<span id="A5.T21.6.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:224.3pt;height:607.4pt;vertical-align:-301.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-27.7pt,74.9pt) scale(0.8,0.8) ;">
<span id="A5.T21.6.1.1.1" class="ltx_p"><span id="A5.T21.6.1.1.1.1" class="ltx_text">
<span id="A5.T21.6.1.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:279.6pt;height:757.2pt;vertical-align:-376.1pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<span id="A5.T21.6.1.1.1.1.1.1" class="ltx_p"><span id="A5.T21.6.1.1.1.1.1.1.1" class="ltx_text">
<span id="A5.T21.6.1.1.1.1.1.1.1.1" class="ltx_tabular ltx_align_middle">
<span id="A5.T21.6.1.1.1.1.1.1.1.1.1" class="ltx_tr">
