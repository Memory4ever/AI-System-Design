<span id="A3.T17.6.1.1.1.11.3" class="ltx_td ltx_align_center"><math id="A3.T17.m13" class="ltx_Math" alttext="3d_{\text{model}}d_{\text{ff}}\text{bytes}_{W_{\text{ff}}}" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>model</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>ff</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mtext>bytes</mtext><msub><mi>W</mi><mtext>ff</mtext></msub></msub></mrow><annotation encoding="application/x-tex">3d_{\text{model}}d_{\text{ff}}\text{bytes}_{W_{\text{ff}}}</annotation></semantics></math></span></span>
<span id="A3.T17.6.1.1.1.12" class="ltx_tr">
<span id="A3.T17.6.1.1.1.12.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A3.T17.6.1.1.1.12.1.1" class="ltx_text ltx_font_italic">Total Feedforward</span> <math id="A3.T17.m14" class="ltx_Math" alttext="\text{Bytes}_{\text{ff,layer}}" display="inline" intent=":literal"><semantics><msub><mtext>Bytes</mtext><mtext>ff,layer</mtext></msub><annotation encoding="application/x-tex">\text{Bytes}_{\text{ff,layer}}</annotation></semantics></math>:</span>
<span id="A3.T17.6.1.1.1.12.2" class="ltx_td ltx_align_center ltx_border_t">—</span>
