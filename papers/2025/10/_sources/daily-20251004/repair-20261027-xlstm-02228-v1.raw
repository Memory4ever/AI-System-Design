<span id="A3.T8.6.1.1.1.3.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A3.T8.m2" class="ltx_Math" alttext="2L+\frac{1}{2}L(L+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2L+\frac{1}{2}L(L+1)</annotation></semantics></math></span></span>
<span id="A3.T8.6.1.1.1.3.2.2.1.2" class="ltx_tr">
