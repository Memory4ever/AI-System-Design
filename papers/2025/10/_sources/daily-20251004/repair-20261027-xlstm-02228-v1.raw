<span id="A3.T8.6.1.1.1.5.3" class="ltx_td ltx_align_center"><math id="A3.T8.m8" class="ltx_Math" alttext="2d_{\text{qk}}+2Ld_{\text{qk}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>qk</mtext></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>qk</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">2d_{\text{qk}}+2Ld_{\text{qk}}</annotation></semantics></math></span></span>
