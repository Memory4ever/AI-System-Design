<span id="A3.T17.6.1.1.1.13.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A3.T17.6.1.1.1.13.1.1" class="ltx_text ltx_font_bold">Output Norm:</span></span>
<span id="A3.T17.6.1.1.1.13.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T17.m15" class="ltx_Math" alttext="BTd_{\text{model}}\times\text{bytes}_{\text{act,norm}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>model</mtext></msub></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mtext>bytes</mtext><mtext>act,norm</mtext></msub></mrow><annotation encoding="application/x-tex">BTd_{\text{model}}\times\text{bytes}_{\text{act,norm}}</annotation></semantics></math></span>
<span id="A3.T17.6.1.1.1.13.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T17.m16" class="ltx_Math" alttext="d_{\text{model}}\times\text{bytes}_{W_{\text{norm}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mtext>model</mtext></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mtext>bytes</mtext><msub><mi>W</mi><mtext>norm</mtext></msub></msub></mrow><annotation encoding="application/x-tex">d_{\text{model}}\times\text{bytes}_{W_{\text{norm}}}</annotation></semantics></math></span></span>
<span id="A3.T17.6.1.1.1.14" class="ltx_tr">
<span id="A3.T17.6.1.1.1.14.1" class="ltx_td ltx_align_left"><span id="A3.T17.6.1.1.1.14.1.1" class="ltx_text ltx_font_bold">Unembedding:</span></span>
<span id="A3.T17.6.1.1.1.14.2" class="ltx_td ltx_align_center"><math id="A3.T17.m17" class="ltx_Math" alttext="BT(d_{\text{model}}+n_{\text{vocab}})\times\text{bytes}_{\text{act}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mtext>model</mtext></msub><mo>+</mo><msub><mi>n</mi><mtext>vocab</mtext></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msub><mtext>bytes</mtext><mtext>act</mtext></msub></mrow><annotation encoding="application/x-tex">BT(d_{\text{model}}+n_{\text{vocab}})\times\text{bytes}_{\text{act}}</annotation></semantics></math></span>
<span id="A3.T17.6.1.1.1.14.3" class="ltx_td ltx_align_center"><math id="A3.T17.m18" class="ltx_Math" alttext="d_{\text{model}}n_{\text{vocab}}\times\text{bytes}_{W_{\text{emb}}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mtext>model</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mtext>vocab</mtext></msub></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mtext>bytes</mtext><msub><mi>W</mi><mtext>emb</mtext></msub></msub></mrow><annotation encoding="application/x-tex">d_{\text{model}}n_{\text{vocab}}\times\text{bytes}_{W_{\text{emb}}}</annotation></semantics></math></span></span>
