<td id="A1.T2.2.1.2" class="ltx_td ltx_align_right ltx_border_r ltx_border_tt">Huber <math id="A1.T2.m7" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math></td>
