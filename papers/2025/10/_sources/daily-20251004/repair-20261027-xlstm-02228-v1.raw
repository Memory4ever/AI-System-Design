<td id="A1.T1.2.1.2" class="ltx_td ltx_align_right ltx_border_tt"><math id="A1.T1.m9" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> (seqs)</td>
<td id="A1.T1.2.1.3" class="ltx_td ltx_align_right ltx_border_tt"><math id="A1.T1.m10" class="ltx_Math" alttext="B\times T" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">B\times T</annotation></semantics></math> (tokens)</td></tr>
<tr id="A1.T1.2.2" class="ltx_tr">
<td id="A1.T1.2.2.1" class="ltx_td ltx_align_right ltx_border_r ltx_border_t">6e+18</td>
