<span id="A3.T6.6.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T6.m1" class="ltx_Math" alttext="n_{\text{vocab}}d_{\text{model}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mtext>vocab</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>model</mtext></msub></mrow><annotation encoding="application/x-tex">n_{\text{vocab}}d_{\text{model}}</annotation></semantics></math></span></span>
