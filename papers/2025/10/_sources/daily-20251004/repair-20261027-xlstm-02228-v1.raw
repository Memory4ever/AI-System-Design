<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E8Xb.m2" class="ltx_Math" alttext="\displaystyle+\frac{T}{L}\left(2d_{\text{qk}}d_{\text{hv}}+2d_{\text{qk}}+5\right)\bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>T</mi><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>qk</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>hv</mtext></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mtext>qk</mtext></msub></mrow><mo>+</mo><mn>5</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{T}{L}\left(2d_{\text{qk}}d_{\text{hv}}+2d_{\text{qk}}+5\right)\bigg).</annotation></semantics></math></td>
