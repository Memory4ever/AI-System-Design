<span id="A3.T13.6.1.1.1.8.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_bb ltx_border_t"><span id="A3.T13.6.1.1.1.8.2.1" class="ltx_text"></span> <span id="A3.T13.6.1.1.1.8.2.2" class="ltx_text">
<span id="A3.T13.6.1.1.1.8.2.2.1" class="ltx_tabular ltx_align_middle">
<span id="A3.T13.6.1.1.1.8.2.2.1.1" class="ltx_tr">
<span id="A3.T13.6.1.1.1.8.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A3.T13.m6" class="ltx_Math" alttext="4L\times\text{bytes}_{\text{if}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mtext>bytes</mtext><mtext>if</mtext></msub></mrow><annotation encoding="application/x-tex">4L\times\text{bytes}_{\text{if}}</annotation></semantics></math></span></span>
