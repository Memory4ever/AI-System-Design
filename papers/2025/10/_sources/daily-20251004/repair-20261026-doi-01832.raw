{"data":{"id":"10.48550/arxiv.2510.01832","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01832","prefix":"10.48550","suffix":"arxiv.2510.01832","identifiers":[{"identifier":"2510.01832","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.01832"}],"creators":[{"name":"Liu, Shicheng","nameType":"Personal","givenName":"Shicheng","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Kai","nameType":"Personal","givenName":"Kai","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Fu, Lisheng","nameType":"Personal","givenName":"Lisheng","familyName":"Fu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Xilun","nameType":"Personal","givenName":"Xilun","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Xinyuan","nameType":"Personal","givenName":"Xinyuan","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Zhaojiang","nameType":"Personal","givenName":"Zhaojiang","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Shao, Rulin","nameType":"Personal","givenName":"Rulin","familyName":"Shao","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Yue","nameType":"Personal","givenName":"Yue","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Kumar, Anuj","nameType":"Personal","givenName":"Anuj","familyName":"Kumar","affiliation":[],"nameIdentifiers":[]},{"name":"Yih, Wen-tau","nameType":"Personal","givenName":"Wen-tau","familyName":"Yih","affiliation":[],"nameIdentifiers":[]},{"name":"Dong, Xin Luna","nameType":"Personal","givenName":"Xin Luna","familyName":"Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SCRIBES: Web-Scale Script-Based Semi-Structured Data Extraction with Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T09:27:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:35:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-17T22:54:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-19T00:15:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Semi-structured content in HTML tables, lists, and infoboxes accounts for a substantial share of factual data on the web, yet the formatting complicates usage, and reliably extracting structured information from them remains challenging. Existing methods either lack generalization or are resource-intensive due to per-page LLM inference. In this paper, we introduce SCRIBES (SCRIpt-Based Semi-Structured Content Extraction at Web-Scale), a novel reinforcement learning framework that leverages layout similarity across webpages within the same site as a reward signal. Instead of processing each page individually, SCRIBES generates reusable extraction scripts that can be applied to groups of structurally similar webpages. Our approach further improves by iteratively training on synthetic annotations from in-the-wild CommonCrawl data. Experiments show that our approach outperforms strong baselines by over 13% in script quality and boosts downstream question answering accuracy by more than 4% for GPT-4o, enabling scalable and resource-efficient web information extraction.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.01832","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:59:01.000Z","registered":"2025-10-03T01:59:02.000Z","published":"2025","updated":"2026-08-19T02:23:55.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.01832","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}