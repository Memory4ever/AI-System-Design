<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex10.m1" class="ltx_Math" alttext="\displaystyle\text{Var}[R^{0,(3,3)}_{j}]=w_{t}^{2}(2w_{t}^{2}+(\hat{r}^{t,1}_{j})^{2}+(\hat{r}^{t,5}_{j})^{2}+(\hat{r}^{t,4}_{j})^{2}+(\hat{r}^{t,2}_{j})^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>R</mi><mi>j</mi><mrow><mn>0</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>w</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>5</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>4</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{Var}[R^{0,(3,3)}_{j}]=w_{t}^{2}(2w_{t}^{2}+(\hat{r}^{t,1}_{j})^{2}+(\hat{r}^{t,5}_{j})^{2}+(\hat{r}^{t,4}_{j})^{2}+(\hat{r}^{t,2}_{j})^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.p21" class="ltx_para ltx_noindent">
<p id="A1.p21.1" class="ltx_p"><span id="A1.p21.1.1" class="ltx_text">and the covariances are:</span></p>
</div>
<div id="A1.p22" class="ltx_para ltx_noindent">
<table id="A1.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
