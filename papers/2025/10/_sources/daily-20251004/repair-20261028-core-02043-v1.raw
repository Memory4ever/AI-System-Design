<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex11.m2" class="ltx_Math" alttext="\displaystyle=w_{t}^{2}\hat{r}^{t,6}_{j}\qquad" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>w</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>6</mn></mrow></msubsup></mrow></mrow><mspace style="width:2em;" width="2em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle=w_{t}^{2}\hat{r}^{t,6}_{j}\qquad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex11.m3" class="ltx_Math" alttext="\displaystyle\text{Cov}[R^{0,(3,2)}_{j},r^{0,1}_{j}]" display="inline" intent=":literal"><semantics><mrow><mtext>Cov</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>R</mi><mi>j</mi><mrow><mn>0</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi>r</mi><mi>j</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{Cov}[R^{0,(3,2)}_{j},r^{0,1}_{j}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex11.m4" class="ltx_Math" alttext="\displaystyle=-w_{t}^{2}\hat{r}^{t,6}_{j}\qquad" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><msubsup><mi>w</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>6</mn></mrow></msubsup></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle=-w_{t}^{2}\hat{r}^{t,6}_{j}\qquad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex11.m5" class="ltx_Math" alttext="\displaystyle\text{Cov}[R^{0,(3,3)}_{j},r^{0,1}_{j}]" display="inline" intent=":literal"><semantics><mrow><mtext>Cov</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>R</mi><mi>j</mi><mrow><mn>0</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi>r</mi><mi>j</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{Cov}[R^{0,(3,3)}_{j},r^{0,1}_{j}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex11.m6" class="ltx_Math" alttext="\displaystyle=w_{t}^{2}\hat{r}^{t,5}_{j}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>w</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>5</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=w_{t}^{2}\hat{r}^{t,5}_{j}</annotation></semantics></math></td>
