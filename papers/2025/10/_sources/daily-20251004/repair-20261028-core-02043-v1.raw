<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E29.m1" class="ltx_Math" alttext="\displaystyle=0-w_{t}^{2}\hat{r}_{j}^{t,4}\hat{r}_{j}^{t,5}+0-w_{t}^{2}\hat{r}_{j}^{t,1}\hat{r}_{j}^{t,2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mn>0</mn><mo>−</mo><mrow><msubsup><mi>w</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>4</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>5</mn></mrow></msubsup></mrow></mrow><mo>+</mo><mn>0</mn></mrow><mo>−</mo><mrow><msubsup><mi>w</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>j</mi><mrow><mi>t</mi><mo>,</mo><mn>2</mn></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=0-w_{t}^{2}\hat{r}_{j}^{t,4}\hat{r}_{j}^{t,5}+0-w_{t}^{2}\hat{r}_{j}^{t,1}\hat{r}_{j}^{t,2}</annotation></semantics></math></td>
