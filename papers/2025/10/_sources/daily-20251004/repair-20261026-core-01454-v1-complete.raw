<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex24.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(iii)}}{{\leq}}\frac{8\sqrt{N}VX^{3}K}{D^{3/2}}\|F_{i}-y_{i}\|_{F}+\frac{2\sqrt{N}SX^{4}V^{2}K}{D^{3/2}}+\frac{\sqrt{N}V^{2}X^{4}K}{D^{3/2}}\|S_{i}-S_{j}\|_{F}+\frac{2B\sqrt{N}VX^{3}K}{D^{3/2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>≤</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msup><mi>D</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>F</mi><mi>i</mi></msub><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msup><mi>D</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msup><mi>D</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>−</mo><msub><mi>S</mi><mi>j</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msup><mi>D</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(iii)}}{{\leq}}\frac{8\sqrt{N}VX^{3}K}{D^{3/2}}\|F_{i}-y_{i}\|_{F}+\frac{2\sqrt{N}SX^{4}V^{2}K}{D^{3/2}}+\frac{\sqrt{N}V^{2}X^{4}K}{D^{3/2}}\|S_{i}-S_{j}\|_{F}+\frac{2B\sqrt{N}VX^{3}K}{D^{3/2}}</annotation></semantics></math></td>
