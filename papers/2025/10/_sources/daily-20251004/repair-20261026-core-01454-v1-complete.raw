<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex21.m1" class="ltx_Math" alttext="\displaystyle=\frac{2}{ND}\bigg\|(S_{i}X_{i}W_{V}-y_{i})\,(I_{N}\otimes W_{V}^{T}X_{i}^{T})\,\frac{\partial S_{i}}{\partial A_{i}}\,\Big(\frac{X_{i}\otimes(X_{i}-X_{j})W_{K}+(X_{i}-X_{j})\otimes X_{j}W_{K}}{\sqrt{D}}\Big)" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mfrac></mstyle></mrow><mo fence="false">|</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>S</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>V</mi></msub></mrow><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>I</mi><mi>N</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>W</mi><mi>V</mi><mi>T</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mi>i</mi><mi>T</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mrow><mo>∂</mo><msub><mi>A</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><msub><mi>X</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>−</mo><msub><mi>X</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>K</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>−</mo><msub><mi>X</mi><mi>j</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi>X</mi><mi>j</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>K</mi></msub></mrow></mrow><msqrt><mi>D</mi></msqrt></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2}{ND}\bigg\|(S_{i}X_{i}W_{V}-y_{i})\,(I_{N}\otimes W_{V}^{T}X_{i}^{T})\,\frac{\partial S_{i}}{\partial A_{i}}\,\Big(\frac{X_{i}\otimes(X_{i}-X_{j})W_{K}+(X_{i}-X_{j})\otimes X_{j}W_{K}}{\sqrt{D}}\Big)</annotation></semantics></math></td>
