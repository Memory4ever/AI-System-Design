<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex20.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\Bigl((S_{i}X_{i}W_{V}-y_{i})\,(I_{N}\otimes W_{V}^{T}X_{i}^{T})\,\frac{\partial S_{i}}{\partial A_{i}}\;-\;(S_{j}X_{j}W_{V}-y_{j})\,(I_{N}\otimes W_{V}^{T}X_{j}^{T})\,\frac{\partial S_{j}}{\partial A_{j}}\Bigr)\,\,\frac{X_{j}\otimes X_{j}\,W_{K}}{\sqrt{D}}\Big\|_{F}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><msub><mi>X</mi><mi>i</mi></msub><msub><mi>W</mi><mi>V</mi></msub><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>N</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>W</mi><mi>V</mi><mi>T</mi></msubsup><msubsup><mi>X</mi><mi>i</mi><mi>T</mi></msubsup><mo rspace="0.170em" stretchy="false">)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mrow><mo>∂</mo><msub><mi>A</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mo lspace="0.502em" rspace="0.502em">−</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>j</mi></msub><msub><mi>X</mi><mi>j</mi></msub><msub><mi>W</mi><mi>V</mi></msub><mo>−</mo><msub><mi>y</mi><mi>j</mi></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>N</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>W</mi><mi>V</mi><mi>T</mi></msubsup><msubsup><mi>X</mi><mi>j</mi><mi>T</mi></msubsup><mo rspace="0.170em" stretchy="false">)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>S</mi><mi>j</mi></msub></mrow><mrow><mo>∂</mo><msub><mi>A</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em" rspace="0.340em">)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>X</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>X</mi><mi>j</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>K</mi></msub></mrow><msqrt><mi>D</mi></msqrt></mfrac></mstyle><msub><mo lspace="0em" mathsize="1.600em">∥</mo><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\Bigl((S_{i}X_{i}W_{V}-y_{i})\,(I_{N}\otimes W_{V}^{T}X_{i}^{T})\,\frac{\partial S_{i}}{\partial A_{i}}\;-\;(S_{j}X_{j}W_{V}-y_{j})\,(I_{N}\otimes W_{V}^{T}X_{j}^{T})\,\frac{\partial S_{j}}{\partial A_{j}}\Bigr)\,\,\frac{X_{j}\otimes X_{j}\,W_{K}}{\sqrt{D}}\Big\|_{F}</annotation></semantics></math></td>
