<tr id="A4.T4.5.1" class="ltx_tr">
<th id="A4.T4.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A4.T4.5.1.1.1" class="ltx_text ltx_font_bold">Metric</span></th>
<th id="A4.T4.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T4.5.1.2.1" class="ltx_text ltx_font_bold">Round 1</span></th>
<th id="A4.T4.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T4.5.1.3.1" class="ltx_text ltx_font_bold">Round 2</span></th>
