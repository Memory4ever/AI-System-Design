<td id="S3.T3.fig1.1.1.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T3.fig1.1.1.6.2.1" class="ltx_text ltx_font_bold">69.7</span></td></tr>
</table>
</span></div>
<figcaption class="ltx_caption ltx_centering">(a) Soft-label target.</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.T3.fig2" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:190.8pt;">
<div id="S3.T3.fig2.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:289.7pt;height:78.6pt;vertical-align:-36.6pt;"><span class="ltx_transformed_inner" style="transform:translate(9.9pt,-2.7pt) scale(1.07351069695999,1.07351069695999) ;">
<table id="S3.T3.fig2.1.1" class="ltx_tabular ltx_align_middle">
<tr id="S3.T3.fig2.1.1.1" class="ltx_tr">
