</figure>
<figure id="A3.F12" class="ltx_figure"><img src="2510.01711v1/real_world_lang_gen_tasks.png" id="A3.F12.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:521/351;" width="521" height="351" alt="Refer to caption">
