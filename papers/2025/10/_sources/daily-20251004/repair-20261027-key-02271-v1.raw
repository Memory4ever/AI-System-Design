<td id="S4.T1.4.1.1.2" class="ltx_td ltx_align_center ltx_border_tt">
<table id="S4.T1.4.1.1.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S4.T1.4.1.1.2.1.1" class="ltx_tr">
<td id="S4.T1.4.1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T1.4.1.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Sample</span></td></tr>
<tr id="S4.T1.4.1.1.2.1.2" class="ltx_tr">
<td id="S4.T1.4.1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T1.4.1.1.2.1.2.1.1" class="ltx_text ltx_font_bold">Number</span></td></tr>
</table></td>
