<td id="A1.T9.2.4.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="A1.T9.2.4.1.1" class="ltx_text ltx_font_bold">Testcase (Ground_truth)</span></td>
