<div id="lstnumberx53" class="ltx_listingline"><span id="lstnumberx53.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx53.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">If</span><span id="lstnumberx53.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">web</span><span id="lstnumberx53.6" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx53.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">like</span><span id="lstnumberx53.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">single</span><span id="lstnumberx53.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">retrieval</span><span id="lstnumberx53.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">could</span><span id="lstnumberx53.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx53.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">it</span><span id="lstnumberx53.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.19" class="ltx_text ltx_font_typewriter">→</span><span id="lstnumberx53.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">C1</span><span id="lstnumberx53.22" class="ltx_text ltx_font_typewriter">–</span><span id="lstnumberx53.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">C2</span><span id="lstnumberx53.24" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx54" class="ltx_listingline"><span id="lstnumberx54.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx54.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">If</span><span id="lstnumberx54.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">at</span><span id="lstnumberx54.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">least</span><span id="lstnumberx54.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">two</span><span id="lstnumberx54.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">independent</span><span id="lstnumberx54.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">conditions</span><span id="lstnumberx54.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">must</span><span id="lstnumberx54.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">be</span><span id="lstnumberx54.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">satisfied</span><span id="lstnumberx54.20" class="ltx_text ltx_font_typewriter">/</span><span id="lstnumberx54.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">combined</span><span id="lstnumberx54.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.23" class="ltx_text ltx_font_typewriter">→</span><span id="lstnumberx54.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">C3</span><span id="lstnumberx54.26" class="ltx_text ltx_font_typewriter">–</span><span id="lstnumberx54.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">C5</span><span id="lstnumberx54.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.29" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx54.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">pick</span><span id="lstnumberx54.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">based</span><span id="lstnumberx54.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">on</span><span id="lstnumberx54.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx54.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">complexity</span><span id="lstnumberx54.37" class="ltx_text ltx_font_typewriter">).</span>
</div>
</div>
</div>
</section>
<section id="A1.SS10.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.10.2 </span>Benchmark Evaluation Prompt</h4>

<div id="A1.SS10.SSS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS10.SSS2.p1.1" class="ltx_p">Below are the exact evaluation prompts used to extract answers, verify correctness, and assess sub-answers for our benchmark.</p>
</div>
<section id="A1.SS10.SSS2.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">extract_answer_template</h5>

