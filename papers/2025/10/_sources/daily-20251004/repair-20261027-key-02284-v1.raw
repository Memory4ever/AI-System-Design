<th id="A1.F12.2.1.3.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_row" style="padding-left:0.0pt;padding-right:0.0pt;"><span id="A1.F12.2.1.3.4.1" class="ltx_text ltx_framed ltx_framed_rectangle" style="--ltx-border-color:#006400;"><img src="2510.02284v1/iclr2026/figures/Figure_2/Force_Prompting/juice_0.png" id="A1.F12.g10" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:88/59;" width="88" height="59" alt="Refer to caption"></span></th>
