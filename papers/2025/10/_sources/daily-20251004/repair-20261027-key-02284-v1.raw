<div id="S4.T2.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:159.0pt;height:44pt;vertical-align:-20.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-30.9pt,8.6pt) scale(0.720144771639168,0.720144771639168) ;">
