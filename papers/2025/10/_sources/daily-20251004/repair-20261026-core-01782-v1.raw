<span id="A4.T6.2.2.4.4" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A4.T6.m9" class="ltx_Math" alttext="4181.32" display="inline" intent=":literal"><semantics><mn>4181.32</mn><annotation encoding="application/x-tex">4181.32</annotation></semantics></math></span></span>
