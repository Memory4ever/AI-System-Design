"sections\",\"sections\":[{\"_key\":\"9f9f720a8793\",\"links\":[{\"title\":\"Claude Academy\",\"url\":\"https://academy.claude.com\"},{\"title\":\"Tutorials\",\"url\":\"https://claude.com/resources/tutorials\"},{\"title\":\"Use cases\",\"url\":\"https://claude.com/resources/use-cases\"},{\"title\":\"Developer docs\",\"url\":\"https://platform.claude.com/docs\"}],\"title\":\"Learn\"},{\"_key\":\"6bd061c46b10\",\"links\":[{\"title\":\"About\",\"url\":\"/company\"},{\"title\":\"Leadership\",\"url\":\"/company/leadership\"},{\"title\":\"Careers\",\"url\":\"/careers\"},{\"title\":\"Events\",\"url\":\"/events\"}],\"title\":\"Company\"}]},{\"_key\":\"22e8d8d2923d\",\"category\":\"News\",\"displayType\":\"singleLink\",\"sections\":null,\"url\":\"/news\"}],\"claudeCta\":{\"desktopCtas\":null,\"mobileCtas\":[{\"title\":\"Log in to Claude\",\"url\":\"https://claude.ai/login\"},{\"title\":\"Download app\",\"url\":\"https://claude.ai/download\"}],\"sections\":[{\"category\":\"About Claude\",\"links\":[{\"title\":\"Overview\",\"url\":\"https://claude.com/product/overview\"},{\"title\":\"Pricing\",\"url\":\"https://claude.com/pricing\"},{\"title\":\"Contact sales\",\"url\":\"https://claude.com/contact-sales\"}]},{\"category\":\"Models\",\"links\":[{\"title\":\"Mythos\",\"url\":\"/claude/mythos\"},{\"title\":\"Fable\",\"url\":\"/claude/fable\"},{\"title\":\"Opus\",\"url\":\"/claude/opus\"},{\"title\":\"Sonnet\",\"url\":\"/claude/sonnet\"},{\"title\":\"Haiku\",\"url\":\"/claude/haiku\"}]},{\"category\":\"Log in\",\"links\":[{\"title\":\"Claude.ai\",\"url\":\"https://claude.ai\"},{\"title\":\"Claude Console\",\"url\":\"https://platform.claude.com/\"}]}],\"title\":\"Try Claude\",\"url\":\"https://claude.ai/\"}},\"page\":{\"_type\":\"page\",\"_id\":\"not-found\",\"_rev\":\"\",\"_createdAt\":\"\",\"_updatedAt\":\"\",\"title\":\"Not Found\",\"slug\":{\"_type\":\"slug\",\"current\":\"not-found\"},\"meta\":{},\"sections\":[]},\"theme\":\"$undefined\",\"hideOnScroll\":\"$undefined\"}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"\",\"children\":[\"$\",\"$L19\",null,{}]}],null]}]\nc:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#141413\"}]]\n1a:I[605500,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/36vb5exi-eaqh.js\",\"/_next/static/chunks/3x8b_vd-kz-ge.js\",\"/_next/static/chunks/3ivs8n8bmmln4.js\",\"/_next/static/chunks/3syu72y118s_7.js\",\"/_next/static/chunks/1m4wanshvtpne.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3u0m-ev5_8d4d.js\"],\"Image\"]\n1b:I[366829,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/36vb5exi-eaqh.js\",\"/_next/static/chunks/3x8b_vd-kz-ge.js\",\"/_next/static/chunks/3ivs8n8bmmln4.js\",\"/_next/static/chunks/3syu72y118s_7.js\",\"/_next/static/chunks/1m4wanshvtpne.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3u0m-ev5_8d4d.js\"],\"default\"]\n21:I[27201,[\"/_next/static/chunks/1fvd0nqqmo54p.js\"],\"IconMark\"]\n1c:[]\n6:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"children\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Building AI for cyber defenders\\\",\\\"description\\\":\\\"How we've improved Claude's cyber defense skills.\\\",\\\"image\\\":[\\\"https://www-cdn.anthropic.com/images/4zrzovbb/website/c79045e9a23b602361bc2784ce8ad3eb15d5be32-1200x630.jpg\\\"],\\\"datePublished\\\":\\\"2025-10-03T18:31:00.000Z\\\",\\\"dateModified\\\":\\\"2026-07-08T22:00:39.000Z\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"mainEntityOfPage\\\":\\\"https://www.anthropic.com/research/building-ai-cyber-defenders\\\",\\\"url\\\":\\\"https://www.anthropic.com/research/building-ai-cyber-defenders\\\"}\"}],[\"$\",\"$L17\",null,{\"children\":[null,[\"$\",\"$L18\",null,{\"isMinimalNavigation\":\"$undefined\",\"siteSettings\":{\"headerNavigation\":\"$16:props:children:1:props:siteSettings:headerNavigation\",\"claudeCta\":\"$16:props:children:1:props:siteSettings:claudeCta\"},\"page\":\"$undefined\",\"theme\":\"$undefined\",\"hideOnScroll\":\"$undefined\"}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"\",\"children\":[\"$\",\"article\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__hero\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__header\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__subjects body-3 bold\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Policy\"}],[\"$\",\"span\",\"1\",{\"children\":\"Frontier Red Team\"}]]}],[\"$\",\"h1\",null,{\"className\":\"headline-1 PostDetail-module-scss-module__UQuRMa__title\",\"children\":\"Building AI for cyber defenders\"}],[\"$\",\"div\",null,{\"className\":\"body-3 agate\",\"children\":[\"$\",\"time\",null,{\"dateTime\":\"2025-10-03T18:31:00.000Z\",\"children\":\"Oct 3, 2025\"}]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__illustrationHeroWrapper\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/f7142e163f054fd84fbe85cbf193f6748becb2e0-2000x1125.jpg\",\"alt\":\"Building AI for cyber defenders\",\"className\":\"PostDetail-module-scss-module__UQuRMa__heroImage\",\"width\":2000,\"height\":1125,\"priority\":true}]}]]}],[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[\"$\",\"$L1b\",null,{\"body\":[{\"_key\":\"4675725aa088\",\"_type\":\"block\",\"children\":[{\"_key\":\"779740609d640\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"AI models are now useful for cybersecurity tasks in practice, not just theory. As research and experience demonstrated the utility of frontier AI as a tool for cyber attackers, we invested in improving Claude’s ability to help defenders detect, analyze, and remediate vulnerabilities in code and deployed systems. This work allowed Claude Sonnet 4.5 to match or eclipse Opus 4.1, our frontier model released only two months prior, in discovering code vulnerabilities and other cyber skills. Adopting and experimenting with AI will be key for defenders to keep pace.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e90539ebeb40\",\"_type\":\"block\",\"children\":[{\"_key\":\"769e6ff2f0390\",\"_type\":\"span\",\"marks\":[],\"text\":\"We believe we are now at an inflection point for AI’s impact on cybersecurity.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"637105f640a0\",\"_type\":\"block\",\"children\":[{\"_key\":\"1b2dd99b3b4e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"For several years, our team has carefully tracked the cybersecurity-relevant capabilities of AI models. Initially, we found models to be not particularly powerful for advanced and meaningful capabilities. However, over the past year or so, we’ve noticed a shift. For example:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6ab29d2fa4da\",\"_type\":\"block\",\"children\":[{\"_key\":\"da80b23e308c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"We showed that models could \"},{\"_key\":\"da80b23e308c1\",\"_type\":\"span\",\"marks\":[\"f010cea38682\"],\"text\":\"reproduce one of the costliest cyberattacks\"},{\"_key\":\"da80b23e308c2\",\"_type\":\"span\",\"marks\":[],\"text\":\" in history—the 2017 Equifax breach—in simulation.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"f010cea38682\",\"_type\":\"link\",\"href\":\"https://red.anthropic.com/2025/cyber-toolkits/\"}],\"style\":\"normal\"},{\"_key\":\"873aeb922b7b\",\"_type\":\"block\",\"children\":[{\"_key\":\"06068cfe80dc0\",\"_type\":\"span\",\"marks\":[],\"text\":\"We entered Claude into cybersecurity competitions, and it \"},{\"_key\":\"06068cfe80dc1\",\"_type\":\"span\",\"marks\":[\"f11ee55cd444\"],\"text\":\"outperformed human teams\"},{\"_key\":\"06068cfe80dc2\",\"_type\":\"span\",\"marks\":[],\"text\":\" in some cases.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"f11ee55cd444\",\"_type\":\"link\",\"href\":\"https://red.anthropic.com/2025/cyber-competitions/\"}],\"style\":\"normal\"},{\"_key\":\"1788c3034487\",\"_type\":\"block\",\"children\":[{\"_key\":\"6f99e847d4ac0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude has helped us \"},{\"_key\":\"6f99e847d4ac1\",\"_type\":\"span\",\"marks\":[\"5e7279fe5089\"],\"text\":\"discover vulnerabilities in our own code\"},{\"_key\":\"6f99e847d4ac2\",\"_type\":\"span\",\"marks\":[],\"text\":\" and fix them before release.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"5e7279fe5089\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/automate-security-reviews-with-claude-code\"}],\"style\":\"normal\"},{\"_key\":\"2c3dd279992e\",\"_type\":\"block\",\"children\":[{\"_key\":\"ab16854aef1f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"In this summer’s DARPA \"},{\"_key\":\"ab16854aef1f1\",\"_type\":\"span\",\"marks\":[\"325b86437e4f\"],\"text\":\"AI Cyber Challenge\"},{\"_key\":\"ab16854aef1f2\",\"_type\":\"span\",\"marks\":[],\"text\":\", teams used LLMs (including Claude) to build “cyber reasoning systems” that examined millions of lines of code for vulnerabilities to patch. In addition to inserted vulnerabilities, teams found (and sometimes patched) \"},{\"_key\":\"ab16854aef1f3\",\"_type\":\"span\",\"marks\":[\"75e1b88652d8\"],\"text\":\"previously undiscovered, non-synthetic vulnerabilities\"},{\"_key\":\"ab16854aef1f4\",\"_type\":\"span\",\"marks\":[],\"text\":\". Beyond a competition setting, other frontier labs now apply models to \"},{\"_key\":\"ab16854aef1f5\",\"_type\":\"span\",\"marks\":[\"b67ec504f7ee\"],\"text\":\"discover and report novel vulnerabilities\"},{\"_key\":\"ab16854aef1f6\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"325b86437e4f\",\"_type\":\"link\",\"href\":\"https://aicyberchallenge.com/\"},{\"_key\":\"75e1b88652d8\",\"_type\":\"link\",\"href\":\"https://aicyberchallenge.com/Finals-winners-announcement/\"},{\"_key\":\"b67ec504f7ee\",\"_type\":\"link\",\"href\":\"https://blog.google/technology/safety-security/cybersecurity-updates-summer-2025/\"}],\"style\":\"normal\"},{\"_key\":\"18c2986780ef\",\"_type\":\"block\",\"children\":[{\"_key\":\"d390341dfbde0\",\"_type\":\"span\",\"marks\":[],\"text\":\"At the same time, as part of our Safeguards work, we have found and disrupted threat actors on our own platform who leveraged AI to scale their operations. Our \"},{\"_key\":\"d390341dfbde1\",\"_type\":\"span\",\"marks\":[\"0ce6bfc26933\"],\"text\":\"Safeguards\"},{\"_key\":\"d390341dfbde2\",\"_type\":\"span\",\"marks\":[],\"text\":\" team recently discovered (and disrupted) a case of “\"},{\"_key\":\"d390341dfbde3\",\"_type\":\"span\",\"marks\":[\"6aa373a6f2dc\"],\"text\":\"vibe hacking\"},{\"_key\":\"d390341dfbde4\",\"_type\":\"span\",\"marks\":[],\"text\":\",” in which a cybercriminal used Claude to build a large-scale data extortion scheme that previously would have required an entire team of people. Safeguards has also detected and countered Claude's use in increasingly \"},{\"_key\":\"d390341dfbde5\",\"_type\":\"span\",\"marks\":[\"257230e0721f\"],\"text\":\"complex espionage operations\"},{\"_key\":\"d390341dfbde6\",\"_type\":\"span\",\"marks\":[],\"text\":\", including the targeting of critical telecommunications infrastructure, by an actor that demonstrated characteristics consistent with Chinese APT operations.\"}],\"markDefs\":[{\"_key\":\"0ce6bfc26933\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/building-safeguards-for-claude\"},{\"_key\":\"6aa373a6f2dc\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/detecting-countering-misuse-aug-2025\"},{\"_key\":\"257230e0721f\",\"_type\":\"link\",\"href\":\"https://www-cdn.anthropic.com/b2a76c6f6992465c09a6f2fce282f6c0cea8c200.pdf\"}],\"style\":\"normal\"},{\"_key\":\"03014b8a1c10\",\"_type\":\"block\",\"children\":[{\"_key\":\"0a9e480119410\",\"_type\":\"span\",\"marks\":[],\"text\":\"All of these lines of evidence lead us to think we are at an important inflection point in the cyber ecosystem, and progress from here could become quite fast or usage could grow quite quickly.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"365849bfc2bb\",\"_type\":\"block\",\"children\":[{\"_key\":\"204b37e7571d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Therefore, now is an important moment to accelerate defensive use of AI to secure code and infrastructure. \"},{\"_key\":\"204b37e7571d1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"We should not cede the cyber advantage derived from AI to attackers and criminals.\"},{\"_key\":\"204b37e7571d2\",\"_type\":\"span\",\"marks\":[],\"text\":\" While we will continue to invest in detecting and disrupting malicious attackers, we think the most scalable solution is to build AI systems that empower those safeguarding our digital environments—like security teams protecting businesses and governments, cybersecurity researchers, and maintainers of critical open-source software.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d70fc3fd75a5\",\"_type\":\"block\",\"children\":[{\"_key\":\"34e0fc5ca5430\",\"_type\":\"span\",\"marks\":[],\"text\":\"In the run-up to the release of Claude Sonnet 4.5, we started to do just that.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f4ecc6bf4fdb\",\"_type\":\"block\",\"children\":[{\"_key\":\"4378040879150\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Sonnet 4.5: emphasizing cyber skills\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"bd6951c7c61b\",\"_type\":\"block\",\"children\":[{\"_key\":\"4a8659248dd60\",\"_type\":\"span\",\"marks\":[],\"text\":\"As LLMs scale in size, “\"},{\"_key\":\"4a8659248dd61\",\"_type\":\"span\",\"marks\":[\"34ad85a01023\"],\"text\":\"emergent abilities\"},{\"_key\":\"4a8659248dd62\",\"_type\":\"span\",\"marks\":[],\"text\":\"”—skills that were not evident in smaller models and were not necessarily an explicit target of model training—appear. Indeed, Claude’s abilities to execute cybersecurity tasks like finding and exploiting software vulnerabilities in Capture-the-Flag (CTF) challenges have been byproducts of developing generally useful AI assistants.\"}],\"markDefs\":[{\"_key\":\"34ad85a01023\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2206.07682\"}],\"style\":\"normal\"},{\"_key\":\"c6102cf57c19\",\"_type\":\"block\",\"children\":[{\"_key\":\"2881ef98499a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"But we don’t want to rely on general model progress alone to better equip defenders. Because of the urgency of this moment in the evolution of AI and cybersecurity, we dedicated researchers to making Claude better at key skills like code vulnerability discovery and patching.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"32416227e0c1\",\"_type\":\"block\",\"children\":[{\"_key\":\"7fc2382e1d340\",\"_type\":\"span\",\"marks\":[],\"text\":\"The results of this work are reflected in Claude Sonnet 4.5. It is comparable or superior to Claude Opus 4.1 in many aspects of cybersecurity while also being less expensive and faster.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d50b8cb41bc6\",\"_type\":\"block\",\"children\":[{\"_key\":\"6cff1e1632990\",\"_type\":\"span\",\"marks\":[],\"text\":\"Evidence from evaluations\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"56bd26d0d0d6\",\"_type\":\"block\",\"children\":[{\"_key\":\"935f80972c870\",\"_type\":\"span\",\"marks\":[],\"text\":\"In building Sonnet 4.5, we had a small research team focus on enhancing Claude’s ability to find vulnerabilities in codebases, patch them, and test for weaknesses in simulated deployed security infrastructure. We chose these because they reflect important tasks for defensive actors. We deliberately avoided enhancements that clearly favor offensive work—such as advanced exploitation or writing malware. We hope to enable models to find insecure code before deployment and to find and fix vulnerabilities in deployed code. There are, of course, many more critical security tasks we did not focus on; at the end of this post, we elaborate on future directions.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c5b3730f19a4\",\"_type\":\"block\",\"children\":[{\"_key\":\"e3559204cef10\",\"_type\":\"span\",\"marks\":[],\"text\":\"To test the effects of our research, we ran industry-standard evaluations of our models. These enable clear comparisons across models, measure the speed of AI progress, and—especially in the case of novel, externally developed evaluations—provide a good metric to ensure that we are not simply teaching to our own tests.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"543fadeace88\",\"_type\":\"block\",\"children\":[{\"_key\":\"b4a9d4f39ad70\",\"_type\":\"span\",\"marks\":[],\"text\":\"As we ran these evaluations, one thing that stood out was the importance of running them many times. Even if it is computationally expensive for a large set of evaluation tasks, it better captures the behavior of a motivated attacker or defender on any particular real-world problem. Doing so reveals impressive performance not only from Claude Sonnet 4.5, but also from models several generations older.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"37406cc30405\",\"_type\":\"block\",\"children\":[{\"_key\":\"ea1dbc62a10f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cybench\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"a73b676b8ebd\",\"_type\":\"block\",\"children\":[{\"_key\":\"a6dac080e8c60\",\"_type\":\"span\",\"marks\":[],\"text\":\"One of the evaluations we have tracked for over a year is \"},{\"_key\":\"a6dac080e8c61\",\"_type\":\"span\",\"marks\":[\"b4f126d77d3c\"],\"text\":\"Cybench\"},{\"_key\":\"a6dac080e8c62\",\"_type\":\"span\",\"marks\":[],\"text\":\", a benchmark drawn from CTF competition challenges.\"},{\"_key\":\"c1b7ba462480\",\"_type\":\"span\",\"marks\":[\"sup\"],\"text\":\"1\"},{\"_key\":\"aef37a9d850f\",\"_type\":\"span\",\"marks\":[],\"text\":\" On this evaluation, we see striking improvement from Claude Sonnet 4.5, not just over Claude Sonnet 4, but even over Claude Opus 4 and 4.1 models. Perhaps most striking,\"},{\"_key\":\"a6dac080e8c63\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\" Sonnet 4.5 achieves a higher probability of success given one attempt per task than Opus 4.1 when given ten attempts per task\"},{\"_key\":\"a6dac080e8c64\",\"_type\":\"span\",\"marks\":[],\"text\":\". The challenges that are part of this evaluation reflect somewhat complex, long-duration workflows. For example, one challenge involved analyzing network traffic, extracting malware from that traffic, and decompiling and decrypting the malware. We estimate that this would have taken a skilled human at least an hour, and possibly much longer; Claude took 38 minutes to solve it.\"}],\"markDefs\":[{\"_key\":\"b4f126d77d3c\",\"_type\":\"link\",\"href\":\"https://cybench.github.io/\"}],\"style\":\"normal\"},{\"_key\":\"d7f4e2b5c589\",\"_type\":\"block\",\"children\":[{\"_key\":\"d079950c84a60\",\"_type\":\"span\",\"marks\":[],\"text\":\"When we give Claude Sonnet 4.5 10 attempts at the Cybench evaluation, it succeeds on 76.5% of the challenges. This is particularly noteworthy because we have doubled this success rate in just the past six months (Sonnet 3.7, released in February 2025, had only a 35.9% success rate when given 10 trials).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"71d552e0db5a\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-ea02c36272de121f033e474a8afda8a039f0ec2c-3000x1800-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"f4de63276e57\",\"_type\":\"block\",\"children\":[{\"_key\":\"b2edb1826f9b0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 1\"},{\"_key\":\"0ba35598c3a1\",\"_type\":\"span\",\"marks\":[],\"text\":\": Model Performance on Cybench. Claude Sonnet 4.5 significantly outperforms all previous models given k=1, 10, or 30 trials, where probability of success is measured as the expectation over the proportion of problems where at least one of k trials succeeds. Note that these results are on a subset of 37 of the 40 original Cybench problems, where 3 problems were excluded due to implementation difficulties.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"67ff1f95c10f\",\"_type\":\"block\",\"children\":[{\"_key\":\"75168a57f04a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Claude Sonnet 4.5 outperforms other models at Cybench\",\"height\":1800,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/ea02c36272de121f033e474a8afda8a039f0ec2c-3000x1800.png\",\"width\":3000},{\"_key\":\"13312fd3b18d\",\"_type\":\"block\",\"children\":[{\"_key\":\"46e096230f84\",\"_type\":\"span\",\"marks\":[],\"text\":\"CyberGym\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"453673ad7d0f\",\"_type\":\"block\",\"children\":[{\"_key\":\"05bc0923f6a00\",\"_type\":\"span\",\"marks\":[],\"text\":\"In another external evaluation, we evaluated Claude Sonnet 4.5 on \"},{\"_key\":\"05bc0923f6a01\",\"_type\":\"span\",\"marks\":[\"7bac022d1725\"],\"text\":\"CyberGym\"},{\"_key\":\"05bc0923f6a02\",\"_type\":\"span\",\"marks\":[],\"text\":\", a benchmark that evaluates the ability of agents to (1) find (previously-discovered) vulnerabilities in real open-source software projects given a high-level description of the weakness, and (2) discover new (previously-undiscovered) vulnerabilities.\"},{\"_key\":\"1f1387d8685e\",\"_type\":\"span\",\"marks\":[\"sup\"],\"text\":\"2\"},{\"_key\":\"5854ee1aff32\",\"_type\":\"span\",\"marks\":[],\"text\":\" The CyberGym team previously found that Claude Sonnet 4 was the strongest model on their \"},{\"_key\":\"05bc0923f6a03\",\"_type\":\"span\",\"marks\":[\"0ec463c065c8\"],\"text\":\"public leaderboard\"},{\"_key\":\"05bc0923f6a04\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"7bac022d1725\",\"_type\":\"link\",\"href\":\"https://www.cybergym.io/\"},{\"_key\":\"0ec463c065c8\",\"_type\":\"link\",\"href\":\"https://www.cybergym.io/\"}],\"style\":\"normal\"},{\"_key\":\"57c936c6325d\",\"_type\":\"block\",\"children\":[{\"_key\":\"d06181673b890\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Sonnet 4.5 scores significantly better than either Claude Sonnet 4 or Claude Opus 4. When using the same cost constraints as the public CyberGym leaderboard (i.e., a limit of $2 of LLM API queries per vulnerability) we find that Sonnet 4.5 achieves a new state-of-the-art score of 28.9%. But true attackers are rarely limited in this way: they can attempt many attacks, for far more than $2 per trial. When we remove these constraints and give Claude 30 trials per task, we find that Sonnet 4.5 reproduces vulnerabilities in 66.7% of programs. And although the relative price of this approach is higher, the absolute cost—about $45 to try one task 30 times—remains quite low.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c9bfe952d1d9\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-c35c81850f6f90e9b5f8064acf5c9effba71b1fe-3493x1640-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"387d3f6d131b\",\"_type\":\"block\",\"children\":[{\"_key\":\"2fb988a3437d0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2\"},{\"_key\":\"0771319ea691\",\"_type\":\"span\",\"marks\":[],\"text\":\": Model Performance on CyberGym. Sonnet 4.5 outperforms all previous models, including Opus 4.1. Note that Opus 4.1, given its higher price, did not follow the same $2 cost constraint as the other models in the 1 trial scenario.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Model Performance on CyberGym — Sonnet 4.5 is more likely to be successful, both after one trial and after thirty.\",\"height\":1640,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/c35c81850f6f90e9b5f8064acf5c9effba71b1fe-3493x1640.png\",\"width\":3493},{\"_key\":\"e17202a47748\",\"_type\":\"block\",\"children\":[{\"_key\":\"f00ed2c113580\",\"_type\":\"span\",\"marks\":[],\"text\":\"Equally interesting is the rate at which Claude Sonnet 4.5 discovers new vulnerabilities. While the CyberGym leaderboard shows that Claude Sonnet 4 only discovers vulnerabilities in about 2% of targets, Sonnet 4.5 discovers new vulnerabilities in 5% of cases. By repeating the trial 30 times it discovers new vulnerabilities in over 33% of projects.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"03b282bc5ef8\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f00cf63cfc5bd5dd2e5e94d4aabde7ec8fb43f6c-3000x1800-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"a7eb90eb3c8e\",\"_type\":\"block\",\"children\":[{\"_key\":\"9255b635490d0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3\"},{\"_key\":\"261519ec068e\",\"_type\":\"span\",\"marks\":[],\"text\":\": Model Performance on CyberGym. Sonnet 4.5 outperforms Sonnet 4 at new vulnerability discovery with only one trial and dramatically outstrips its performance when given 30 trials.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Model Performance on CyberGym new vulnerability discovery\",\"height\":1800,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/f00cf63cfc5bd5dd2e5e94d4aabde7ec8fb43f6c-3000x1800.png\",\"width\":3000},{\"_key\":\"4f8720979f26\",\"_type\":\"block\",\"children\":[{\"_key\":\"e215196a0f42\",\"_type\":\"span\",\"marks\":[],\"text\":\"Further research into patching\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"b74a90b7f7f2\",\"_type\":\"block\",\"children\":[{\"_key\":\"f58f74bdb2220\",\"_type\":\"span\",\"marks\":[],\"text\":\"We are also conducting preliminary research into Claude's ability to generate and review patches that fix vulnerabilities. Patching vulnerabilities is a harder task than finding them because the model has to make surgical changes that remove the vulnerability without altering the original functionality. Without guidance or specifications, the model has to infer this intended functionality from the code base.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"88acb2cfbbbb\",\"_type\":\"block\",\"children\":[{\"_key\":\"68c8b2b5ede90\",\"_type\":\"span\",\"marks\":[],\"text\":\"In our experiment we tasked Claude Sonnet 4.5 with patching vulnerabilities in the CyberGym evaluation set based on a description of the vulnerability and information about what the program was doing when it crashed. We used Claude to judge its own work, asking it to grade the submitted patches by comparing them to human-authored reference patches. 15% of the Claude-generated patches were judged to be semantically equivalent to the human-generated patches. However, this comparison-based approach has an important limitation: because vulnerabilities can often be fixed in multiple valid ways, patches that differ from the reference may still be correct, leading to false negatives in our evaluation.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8a56e2a43977\",\"_type\":\"block\",\"children\":[{\"_key\":\"9c73d0a054810\",\"_type\":\"span\",\"marks\":[],\"text\":\"We manually analyzed a sample of the highest-scoring patches and found them to be functionally identical to reference patches that have been merged into the open-source software on which the CyberGym evaluation is based. This work reveals a pattern consistent with our broader findings: Claude develops cyber-related skills as it generally improves. Our preliminary results suggest that patch generation—like vulnerability discovery before it—is an emergent capability that could be enhanced with focused research. Our next step is to systematically address the challenges we've identified to make Claude a reliable patch author and reviewer.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fd99ef015bd6\",\"_type\":\"block\",\"children\":[{\"_key\":\"88b5a00fa2d50\",\"_type\":\"span\",\"marks\":[],\"text\":\"Conferring with trusted partners\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"70559b8a4636\",\"_type\":\"block\",\"children\":[{\"_key\":\"98d7a2bb0caa0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Real world defensive security is more complicated in practice than our evaluations can capture. We’ve consistently found that real problems are more complex, challenges are harder, and implementation details matter a lot. Therefore, we feel it is important to work with the organizations actually using AI for defense to get feedback on how our research could accelerate them. In the lead-up to Sonnet 4.5 we worked with a number of organizations who applied the model to their real challenges in areas like vulnerability remediation, testing network security, and threat analysis.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"47ab03442021\",\"_type\":\"block\",\"children\":[{\"_key\":\"7221a08c435e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nidhi Aggarwal, Chief Product Officer of HackerOne, said, “Claude Sonnet 4.5 reduced average vulnerability intake time for our Hai security agents by 44% while improving accuracy by 25%, helping us reduce risk for businesses with confidence.” According to Sven Krasser, Senior Vice President for Data Science and Chief Scientist at CrowdStrike, “Claude shows strong promise for red teaming—generating creative attack scenarios that accelerate how we study attacker tradecraft. These insights strengthen our defenses across endpoints, identity, cloud, data, SaaS, and AI workloads.”\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e4c6c626fc95\",\"_type\":\"block\",\"children\":[{\"_key\":\"5edd70673f9f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"These testimonials made us more confident in the potential for applied, defensive work with Claude.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ee098ce04f6f\",\"_type\":\"block\",\"children\":[{\"_key\":\"40da3e0352ce\",\"_type\":\"span\",\"marks\":[],\"text\":\"What's next?\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"9ef5c9f19d4a\",\"_type\":\"block\",\"children\":[{\"_key\":\"9773d5ae1f670\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Sonnet 4.5 represents a meaningful improvement, but we know that many of its capabilities are nascent and do not yet match those of security professionals and established processes. We will keep working to improve the defense-relevant capabilities of our models and enhance the threat intelligence and mitigations that safeguard our platforms. In fact, we have already been using results of our investigations and evaluations to continually refine our ability to catch misuse of our models for harmful cyber behavior. This includes using techniques like organization-level \"},{\"_key\":\"9773d5ae1f671\",\"_type\":\"span\",\"marks\":[\"66dc973b78ef\"],\"text\":\"summarization\"},{\"_key\":\"9773d5ae1f672\",\"_type\":\"span\",\"marks\":[],\"text\":\" to understand the bigger picture beyond just a singular prompt and completion; this helps disaggregate dual-use behavior from nefarious behavior, particularly for the most damaging use-cases involving large scale automated activity.\"}],\"markDefs\":[{\"_key\":\"66dc973b78ef\",\"_type\":\"link\",\"href\":\"https://alignment.anthropic.com/2025/summarization-for-monitoring/\"}],\"style\":\"normal\"},{\"_key\":\"99f64bc47e40\",\"_type\":\"block\",\"children\":[{\"_key\":\"2cbea2ddf3740\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"But we believe that now is the time for as many organizations as possible to start experimenting with how AI can improve their security posture and build the evaluations to assess those gains. \"},{\"_key\":\"2cbea2ddf3741\",\"_type\":\"span\",\"marks\":[\"f362ff1fe2ae\"],\"text\":\"Automated security reviews\"},{\"_key\":\"2cbea2ddf3742\",\"_type\":\"span\",\"marks\":[],\"text\":\" in Claude Code show how AI can be integrated into the CI/CD pipeline. We would specifically like to enable researchers and teams to experiment with applying models in areas like Security Operations Center (SOC) automation, Security Information and Event Management (SIEM) analysis, secure network engineering, or active defense. We would like to see and use more evaluations for defensive capabilities as part of the growing \"},{\"_key\":\"2cbea2ddf3743\",\"_type\":\"span\",\"marks\":[\"89c04400e6d2\"],\"text\":\"third-party ecosystem\"},{\"_key\":\"2cbea2ddf3744\",\"_type\":\"span\",\"marks\":[],\"text\":\" for model evaluations.\"}],\"markDefs\":[{\"_key\":\"f362ff1fe2ae\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/automate-security-reviews-with-claude-code\"},{\"_key\":\"89c04400e6d2\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/a-new-initiative-for-developing-third-party-model-evaluations\"}],\"style\":\"normal\"},{\"_key\":\"74b5ab13cf38\",\"_type\":\"block\",\"children\":[{\"_key\":\"11f176a7f3a90\",\"_type\":\"span\",\"marks\":[],\"text\":\"But even building and adopting to advantage defenders is only part of the solution. We also need conversations about making digital infrastructure more resilient and new software secure by design—including with help from frontier AI models. We look forward to these discussions with industry, government, and civil society as we navigate the moment when AI’s impact on cybersecurity transitions from being a future concern to a present-day imperative.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"footnotes\":{\"body\":\"$6:1:props:children:2:props:children:props:children:1:props:children:props:body\",\"count\":0,\"numberByListItemKey\":{},\"referenced\":\"$W1c\"},\"sidebar\":{\"isVisible\":false}}]}],\"$L1d\",\"$L1e\",\"$L1f\"]}]}],\"$L20\"]}]]\n9:null\ne:[[\"$\",\"title\",\"0\",{\"children\":\"Building AI for cyber defenders \\\\ Anthropic\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"How we've improved Claude's cyber defense skills.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"msapplication-TileColor\",\"content\":\"141413\"}],[\"$\",\"meta\",\"3\",{\"name\":\"msapplication-config\",\"content\":\"/browserconfig.xml\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.anthropic.com/research/building-ai-cyber-defenders\"}],[\"$\",\"meta\",\"5\",{\"name\":\"google-site-verification\",\"content\":\"BqiAW_sWOg-KrPk-Accxm6ge9dtnFEyV6DB6vzVZSGs\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Building AI for cyber defenders\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"How we've improved Claude's cyber defense skills.\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/c79045e9a23b602361bc2784ce8ad3eb15d5be32-1200x630.jpg\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image:alt\",\"content\":\"A clear practice lock being studied beside abstract data patterns, representing AI-assisted vulnerability research\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"11\",{\"property\":\"article:published_time\",\"content\":\"2025-10-03T18:31:00.000Z\"}],[\"$\",\"meta\",\"12\",{\"property\":\"article:modified_time\",\"content\":\"2026-07-08T22:00:39.000Z\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:site\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:creator\",\"content\":\"@AnthropicAI\"}],[\"$\"