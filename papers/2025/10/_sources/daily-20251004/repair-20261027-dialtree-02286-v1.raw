<span id="A4.T4.2.1.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T4.2.1.1.1.1.3.1" class="ltx_text ltx_font_bold">HarmBench</span></span>
<span id="A4.T4.2.1.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt ltx_colspan ltx_colspan_4"><span id="A4.T4.2.1.1.1.1.4.1" class="ltx_text ltx_font_bold">ToxicChat</span></span></span>
<span id="A4.T4.2.1.1.1.2" class="ltx_tr">
