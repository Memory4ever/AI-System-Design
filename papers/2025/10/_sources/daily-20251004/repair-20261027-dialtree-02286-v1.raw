<span id="A4.T6.p1.1.1.1.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt ltx_rowspan ltx_rowspan_2"><span id="A4.T6.p1.1.1.1.1.5.1.1" class="ltx_text ltx_font_bold">Method</span></span>
<span id="A4.T6.p1.1.1.1.1.5.2" class="ltx_td ltx_align_center ltx_border_tt ltx_colspan ltx_colspan_6"><span id="A4.T6.p1.1.1.1.1.5.2.1" class="ltx_text ltx_font_bold">Open-Source Models</span></span></span>
<span id="A4.T6.p1.1.1.1.1.6" class="ltx_tr">
<span id="A4.T6.p1.1.1.1.1.6.1" class="ltx_td ltx_align_center ltx_border_t">Llama-3.1-8B</span>
