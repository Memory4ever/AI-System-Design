<span id="A4.T4.2.1.1.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Recall <math id="A4.T4.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>
