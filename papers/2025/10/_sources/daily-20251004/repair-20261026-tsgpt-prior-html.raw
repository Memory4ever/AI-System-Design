<td id="S5.T1.5.2.8" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-3pt;padding-bottom:-3pt;"><math id="S5.T1.m17" class="ltx_Math" alttext="0.5165" display="inline" intent=":literal"><semantics><mn>0.5165</mn><annotation encoding="application/x-tex">0.5165</annotation></semantics></math> <math id="S5.T1.m18" class="ltx_Math" alttext="(3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(3)</annotation></semantics></math></td></tr>
