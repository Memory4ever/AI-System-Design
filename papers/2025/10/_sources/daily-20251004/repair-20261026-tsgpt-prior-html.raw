<td id="S5.T1.5.2.6" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-3pt;padding-bottom:-3pt;"><math id="S5.T1.m13" class="ltx_Math" alttext="\mathbf{0.0887}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">0.0887</mn><annotation encoding="application/x-tex">\mathbf{0.0887}</annotation></semantics></math> <math id="S5.T1.m14" class="ltx_Math" alttext="\mathbf{(1)}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>𝟏</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\mathbf{(1)}</annotation></semantics></math></td>
