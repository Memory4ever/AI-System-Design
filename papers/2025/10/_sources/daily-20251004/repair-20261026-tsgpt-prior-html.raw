<td id="S5.T1.5.3.1" class="ltx_td ltx_align_left" style="padding-top:-3pt;padding-bottom:-3pt;"><span id="S5.T1.5.3.1.1" class="ltx_text" style="font-size:70%;">DeepAR</span></td>
<td id="S5.T1.5.3.2" class="ltx_td ltx_align_left" style="padding-top:-3pt;padding-bottom:-3pt;"><math id="S5.T1.m19" class="ltx_Math" alttext="0.1064" display="inline" intent=":literal"><semantics><mn>0.1064</mn><annotation encoding="application/x-tex">0.1064</annotation></semantics></math> <math id="S5.T1.m20" class="ltx_Math" alttext="(2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2)</annotation></semantics></math></td>
