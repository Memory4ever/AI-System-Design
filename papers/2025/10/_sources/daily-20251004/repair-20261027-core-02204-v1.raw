</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 17.24)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:18.31em;--ltx-fo-depth:0.25em;font-size:10pt;" height="256.82" overflow="visible" transform="matrix(1 0 0 -1 0 253.36)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.SS0.SSS0.Px2.p2.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:36.62em;">
<span id="A2.SS0.SSS0.Px2.p2.pic1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS0.SSS0.Px2.p2.pic1.p1.pic1" class="ltx_picture" color="#000000" height="23.96" overflow="visible" version="1.1" viewBox="0 0 506.69 23.96" width="506.69"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,23.96) matrix(1 0 0 -1 0 0) translate(-19.69,0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 23.96 L 546.06 23.96 L 546.06 0 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 1.97 L 0 21.99 L 546.06 21.99 L 546.06 1.97 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 19.68 8.6)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS0.SSS0.Px2.p2.pic1.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.62em;">
