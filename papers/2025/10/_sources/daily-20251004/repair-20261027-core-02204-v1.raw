<span id="A2.SS0.SSS0.Px2.p2.pic1.p7" class="ltx_para">
<span id="A2.SS0.SSS0.Px2.p2.pic1.p7.1" class="ltx_p"><span id="A2.SS0.SSS0.Px2.p2.pic1.p7.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">You are a helpful assistant.</span></span>
</span>
<span id="A2.SS0.SSS0.Px2.p2.pic1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS0.SSS0.Px2.p2.pic1.p2.pic1" class="ltx_picture" color="#000000" height="21.27" overflow="visible" version="1.1" viewBox="0 0 506.69 21.27" width="506.69"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,21.27) matrix(1 0 0 -1 0 0) translate(-19.69,0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 21.27 L 546.06 21.27 L 546.06 0 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 1.97 L 0 19.3 L 546.06 19.3 L 546.06 1.97 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 19.68 5.91)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
