<tr id="S4.T1.1.2" class="ltx_tr">
<th id="S4.T1.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">MRR</th>
<th id="S4.T1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Hits@10</th>
<th id="S4.T1.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">MRR</th>
