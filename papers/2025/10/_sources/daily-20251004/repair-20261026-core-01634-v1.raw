</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.1.3" class="ltx_tr">
<th id="S4.T1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Fixed-Euclidean</th>
<td id="S4.T1.1.3.2" class="ltx_td ltx_align_center ltx_border_t">0.2706 <math id="S4.T1.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0010</td>
<td id="S4.T1.1.3.3" class="ltx_td ltx_align_center ltx_border_t">0.4486 <math id="S4.T1.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0011</td>
<td id="S4.T1.1.3.4" class="ltx_td ltx_align_center ltx_border_t">0.2161 <math id="S4.T1.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0037</td>
<td id="S4.T1.1.3.5" class="ltx_td ltx_align_center ltx_border_t">0.4553 <math id="S4.T1.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0050</td></tr>
<tr id="S4.T1.1.4" class="ltx_tr">
<th id="S4.T1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Fixed-Hyperbolic</th>
<td id="S4.T1.1.4.2" class="ltx_td ltx_align_center">0.2655 <math id="S4.T1.m7" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0014</td>
<td id="S4.T1.1.4.3" class="ltx_td ltx_align_center">0.4276 <math id="S4.T1.m8" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0024</td>
<td id="S4.T1.1.4.4" class="ltx_td ltx_align_center">0.0918 <math id="S4.T1.m9" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0051</td>
