<section id="A8.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">H.4 </span>Template for R1-like Reasoning</h3>

<div id="A8.SS4.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A8.SS4.p1.pic1" class="ltx_picture" height="129.26" overflow="visible" version="1.1" viewBox="0 0 653.15 129.26" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,129.26) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#CCE5FF;" fill="#CCE5FF" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 123.36 C 0 126.62 2.64 129.26 5.91 129.26 L 647.24 129.26 C 650.51 129.26 653.15 126.62 653.15 123.36 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#E6F2FF;" fill="#E6F2FF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 105.15 L 651.18 105.15 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 113.75)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A8.SS4.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:44.07em;">
<span id="A8.SS4.p1.pic1.1.1" class="ltx_p"><span id="A8.SS4.p1.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The Template for R1-like Reasoning</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 17.24)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:5.5em;--ltx-fo-depth:0.25em;font-size:10pt;" height="79.56" overflow="visible" transform="matrix(1 0 0 -1 0 76.1)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A8.SS4.p1.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:44.07em;">
<span id="A8.SS4.p1.pic1.2.1" class="ltx_p"><span id="A8.SS4.p1.pic1.2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">You are a helpful AI Assistant that provides well-reasoned and detailed responses. You first think about the reasoning process as an internal monologue and then provide the user with the answer. The final answer must be put in <code id="A8.SS4.p1.pic1.2.1.1.1" class="ltx_verbatim ltx_font_typewriter">\boxed{}</code>. Respond in the following format: <code id="A8.SS4.p1.pic1.2.1.1.2" class="ltx_verbatim ltx_font_typewriter">&lt;think&gt;\n...\n&lt;/think&gt;\n&lt;answer&gt;\n...\n&lt;/answer&gt;</code></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
