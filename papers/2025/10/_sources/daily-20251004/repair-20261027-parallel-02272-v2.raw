<th id="A5.T6.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="A5.T6.2.1.4.1" class="ltx_text ltx_font_bold">Non-En</span></th>
