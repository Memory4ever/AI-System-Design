<td id="A5.T8.2.1.2" class="ltx_td ltx_align_right ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;"><math id="A5.T8.m1" class="ltx_Math" alttext="\mathbf{R^{2}}" display="inline" intent=":literal"><semantics><msup><mi>𝐑</mi><mn>𝟐</mn></msup><annotation encoding="application/x-tex">\mathbf{R^{2}}</annotation></semantics></math></td>
<td id="A5.T8.2.1.3" class="ltx_td ltx_align_right ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="A5.T8.2.1.3.1" class="ltx_text ltx_font_bold">MSE</span></td>
