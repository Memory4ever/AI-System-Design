<td id="A5.T8.2.1.5" class="ltx_td ltx_align_right ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="A5.T8.2.1.5.1" class="ltx_text ltx_font_bold">BIC</span></td></tr>
<tr id="A5.T8.2.2" class="ltx_tr">
