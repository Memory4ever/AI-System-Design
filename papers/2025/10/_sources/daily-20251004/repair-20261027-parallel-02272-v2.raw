<th id="A6.T21.2.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">bn</th>
<th id="A6.T21.2.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">th</th>
<th id="A6.T21.2.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">sw</th>
<th id="A6.T21.2.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">zh</th>
<th id="A6.T21.2.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">ja</th>
<th id="A6.T21.2.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">te</th>
<th id="A6.T21.2.2.12" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="--ltx-bg-color:#E6E6E6;padding-left:2.8pt;padding-right:2.8pt;"><span id="A6.T21.2.2.12.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#E6E6E6;">Training</span></th>
