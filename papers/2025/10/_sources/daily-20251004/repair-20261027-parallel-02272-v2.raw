<th id="A6.T16.2.2.12" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="--ltx-bg-color:#E6E6E6;padding-left:3.4pt;padding-right:3.4pt;"><span id="A6.T16.2.2.12.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Acc</span></th>
