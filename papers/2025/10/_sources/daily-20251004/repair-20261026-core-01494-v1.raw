<figure id="A5.F16.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.01494v1/figures/img/09-appendix/cosine_similarity_layer_5-llama-2-13b-qwen3-14b-nemo.png" id="A5.F16.sf3.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:247/218;" width="247" height="218" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(c) </span></figcaption>
