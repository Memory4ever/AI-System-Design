<figure id="A5.F16.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.01494v1/figures/img/09-appendix/cka_similarity_layer_5-mistral-7b-qwen-8b-llama3.1-8b.png" id="A5.F16.sf5.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:247/219;" width="247" height="219" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(e) </span></figcaption>
