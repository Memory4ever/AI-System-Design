<tr id="S4.T3.2.1.12" class="ltx_tr">
<td id="S4.T3.2.1.12.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;" colspan="7"><em id="S4.T3.2.1.12.1.1" class="ltx_emph ltx_font_bold ltx_font_italic">Results for LlaMA-3 70B</em></td></tr>
<tr id="S4.T3.2.1.13" class="ltx_tr">
<td id="S4.T3.2.1.13.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">TOT</td>
