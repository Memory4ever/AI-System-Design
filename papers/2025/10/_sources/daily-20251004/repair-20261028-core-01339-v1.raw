<td id="S4.F6.2.1.4.3" class="ltx_td" style="padding:-0.25pt 0.0pt;" colspan="7"></td>
<td id="S4.F6.2.1.4.4" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.25pt 0.0pt;">
<span id="S4.F6.2.1.4.4.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:39.8pt;"><span class="ltx_inline-block"><svg id="S4.F6.pic29" class="ltx_picture" height="38.71" overflow="visible" version="1.1" viewBox="0 0 55.61 38.71" width="55.61"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#000000;" color="#000000" fill="#000000" fill-opacity="1" stroke="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="miter" stroke-opacity="1" stroke-width="0.4pt" transform="translate(0,38.71) matrix(1 0 0 -1 0 0) translate(27.5,0) translate(0,16.5)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -27.5 -16.5)"><foreignObject style="--ltx-fo-width:3.98em;--ltx-fo-height:2.39em;--ltx-fo-depth:0em;font-size:10pt;" height="33" overflow="visible" transform="matrix(1 0 0 -1 0 33)" width="55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><img src="2510.01339v1/x51.png" id="S4.F6.pic29.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:55/35;" width="55" height="35" alt="Refer to caption"></span></span></foreignObject></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000" stroke-width="0.2pt"><path style="fill:none" d="M 5.41 -11.81 C 5.41 -9.91 3.87 -8.37 1.97 -8.37 C 0.07 -8.37 -1.48 -9.91 -1.48 -11.81 C -1.48 -13.71 0.07 -15.26 1.97 -15.26 C 3.87 -15.26 5.41 -13.71 5.41 -11.81 Z M 1.97 -11.81"></path></g><g style="--ltx-fg-color:#FF0000;" color="#FF0000" stroke-width="0.8pt"><clipPath id="pgfcp77"><path d="M 27.56 7.87 C 27.56 15.48 21.39 21.65 13.78 21.65 C 6.17 21.65 -0 15.48 -0 7.87 C -0 0.26 6.17 -5.91 13.78 -5.91 C 21.39 -5.91 27.56 0.26 27.56 7.87 Z M 13.78 7.87"></path></clipPath><g clip-path="url(#pgfcp77)"><g style="--ltx-fg-color:#000000;" color="#000000" fill-opacity