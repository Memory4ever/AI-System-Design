<th id="A1.T2.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.5pt;"><math id="A1.T2.m1" class="ltx_Math" alttext="(\lambda_{h},\,\lambda_{v},\,\lambda_{\tau})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>h</mi></msub><mo>,</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><msub><mi>λ</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda_{h},\,\lambda_{v},\,\lambda_{\tau})</annotation></semantics></math></th>
<th id="A1.T2.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.5pt;"><math id="A1.T2.m2" class="ltx_Math" alttext="\eta\delta" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\eta\delta</annotation></semantics></math></th>
<th id="A1.T2.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.5pt;"><math id="A1.T2.m3" class="ltx_Math" alttext="(1-\eta)\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">(1-\eta)\delta</annotation></semantics></math></th></tr>
