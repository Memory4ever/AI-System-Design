                <span class="ltx_tag ltx_tag_listingline">11:</span>
                
                
              <span id="alg3.l11.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l11.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l12" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">12:</span>
                
                
              <math id="alg3.l12.m1" class="ltx_Math" alttext="{\bm{z}}_{0}\leftarrow\dfrac{{\bm{z}}_{1}-\sqrt{1-\bar{\alpha}_{1}}\,E^{(1)}_{\theta}({\bm{z}}_{1})}{\sqrt{\bar{\alpha}_{1}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒛</mi><mn>0</mn></msub><mo stretchy="false">←</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝒛</mi><mn>1</mn></msub><mo>−</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mn>1</mn></msub></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>E</mi><mi>θ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mn>1</mn></msub></msqrt></mfrac></mstyle></mrow><annotation encoding="application/x-tex">{\bm{z}}_{0}\leftarrow\dfrac{{\bm{z}}_{1}-\sqrt{1-\bar{\alpha}_{1}}\,E^{(1)}_{\theta}({\bm{z}}_{1})}{\sqrt{\bar{\alpha}_{1}}}</annotation></semantics></math>

</div>
