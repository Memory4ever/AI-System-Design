                <math id="alg4.l5.m1" class="ltx_Math" alttext="{\bm{z}}^{(k)}_{t_{k}}\leftarrow\sqrt{\alpha_{t_{k}}}\;\mathcal{E}_{V}\!\big({\bm{x}}_{k}\big)\;+\;\sqrt{1-\alpha_{t_{k}}}\;\bm{\epsilon}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒛</mi><msub><mi>t</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">←</mo><mrow><mrow><msqrt><msub><mi>α</mi><msub><mi>t</mi><mi>k</mi></msub></msub></msqrt><mo lspace="0.280em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝒙</mi><mi>k</mi></msub><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.502em">+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></msqrt><mo lspace="0.280em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{z}}^{(k)}_{t_{k}}\leftarrow\sqrt{\alpha_{t_{k}}}\;\mathcal{E}_{V}\!\big({\bm{x}}_{k}\big)\;+\;\sqrt{1-\alpha_{t_{k}}}\;\bm{\epsilon}</annotation></semantics></math> <span id="alg4.l5.2" class="ltx_text" style="float:right;"><math id="alg4.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> encode &amp; diffuse to <math id="alg4.l5.m3" class="ltx_Math" alttext="t_{k}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>k</mi></msub><annotation encoding="application/x-tex">t_{k}</annotation></semantics></math>
</span>
</div>
<div id="alg4.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">6:</span>
                
                
                <math id="alg4.l6.m1" class="ltx_Math" alttext="\tilde{{\bm{x}}}_{k+\nicefrac{{1}}{{2}}}\leftarrow\mathcal{D}_{V}\!\big(f^{V}_{\vartheta}({\bm{z}}^{(k)}_{t_{k}},t_{k})\big)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mrow><mi>k</mi><mo>+</mo><mrow><mpadded voffset="0.3em"><mn mathsize="0.710em">1</mn></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mn mathsize="0.710em">2</mn></mrow></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>f</mi><mi>ϑ</mi><mi>V</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒛</mi><msub><mi>t</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>t</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{{\bm{x}}}_{k+\nicefrac{{1}}{{2}}}\leftarrow\mathcal{D}_{V}\!\big(f^{V}_{\vartheta}({\bm{z}}^{(k)}_{t_{k}},t_{k})\big)</annotation></semantics></math> <span id="alg4.l6.2" class="ltx_text" style="float:right;"><math id="alg4.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> VCM prior contraction
</span>
</div>
<div id="alg4.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">7:</span>
                
                
                <math id="alg4.l7.m1" class="ltx_Math" alttext="{\bm{x}}_{k+1}\leftarrow\argmin_{{\bm{u}}\in\mathbb{R}^{(T+1)\times H\times W\times 3}}g_{y}({\bm{u}})+\phi_{\lambda}({\bm{u}})+\tfrac{1}{2\delta_{k}}\|\tilde{{\bm{x}}}_{k+\nicefrac{{1}}{{2}}}-{\bm{u}}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mrow><mi>𝐮</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>H</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow></msup></mrow></msub><mo>⁡</mo><msub><mi>g</mi><mi>y</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐮</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ϕ</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐮</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>k</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mrow><mi>k</mi><mo>+</mo><mrow><mpadded voffset="0.3em"><mn mathsize="0.710em">1</mn></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mn mathsize="0.710em">2</mn></mrow></mrow></msub><mo>−</mo><mi>𝐮</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{k+1}\leftarrow\argmin_{{\bm{u}}\in\mathbb{R}^{(T+1)\times H\times W\times 3}}g_{y}({\bm{u}})+\phi_{\lambda}({\bm{u}})+\tfrac{1}{2\delta_{k}}\|\tilde{{\bm{x}}}_{k+\nicefrac{{1}}{{2}}}-{\bm{u}}\|_{2}^{2}</annotation></semantics></math>
<span id="alg4.l7.2" class="ltx_text" style="float:right;"><math id="alg4.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> data-consistency
</span>
</div>
<div id="alg4.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">8:</span>
                
                
                Solved with a few CG iters;  TV-in-time can be used here.

</div>
<div id="alg4.l9" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">9:</span>
                
                
              <span id="alg4.l9.2" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l9.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg4.l10" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">10:</span>
                
                
              <span id="alg4.l10.2" class="ltx_text ltx_font_bold">return</span> <math id="alg4.l10.m1" class="ltx_Math" alttext="{\bm{x}}_{N}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mi>N</mi></msub><annotation encoding="application/x-tex">{\bm{x}}_{N}</annotation></semantics></math>

</div>
</div>
</figure>
</section>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Additional examples</h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.1" class="ltx_p">We provide in Table <a href="#A2.T4" title="Table 4 ‣ Appendix B Additional examples ‣ L A TINO: LAtent Video consisTency INverse sOlver for High Definition Video Restoration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> qualitative video comparisons for <span id="A2.p1.1.1" class="ltx_text ltx_font_bold">Problem A</span>, <span id="A2.p1.1.2" class="ltx_text ltx_font_bold">Problem B</span>, and <span id="A2.p1.1.3" class="ltx_text ltx_font_bold">Problem C</span>. Each triplet corresponds to the Ground Truth (GT), the observed degraded input (<math id="A2.p1.m1" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi>𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math>), and the restored sequence. For <span id="A2.p1.1.4" class="ltx_text ltx_markedasmath ltx_font_bold">Problem C</span>, we provide longer sequences (<math id="A2.p1.m3" class="ltx_Math" alttext="81" display="inline" intent=":literal"><semantics><mn>81</mn><annotation encoding="application/x-tex">81</annotation></semantics></math> frames) to better appreciate the results.</p>
</div>
