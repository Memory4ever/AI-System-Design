<span id="lstnumberx33" class="ltx_listingline"><span id="lstnumberx33.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">‘‘‘</span><span id="lstnumberx33.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">python</span>
</span>
<span id="lstnumberx34" class="ltx_listingline"><span id="lstnumberx34.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">{</span><span id="lstnumberx34.2" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">recipients</span><span id="lstnumberx34.4" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">:</span><span id="lstnumberx34.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx34.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">[</span><span id="lstnumberx34.8" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">alex@example</span><span id="lstnumberx34.10" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx34.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">com</span><span id="lstnumberx34.12" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.13" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx34.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx34.15" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">dona@example</span><span id="lstnumberx34.17" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx34.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">com</span><span id="lstnumberx34.19" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.20" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">],</span><span id="lstnumberx34.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx34.22" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">subject</span><span id="lstnumberx34.24" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.25" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">:</span><span id="lstnumberx34.26" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx34.27" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">Update</span><span id="lstnumberx34.29" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx34.30" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">}</span>
</span>
