<td id="S3.T1.2.1.6.5" class="ltx_td ltx_align_center" style="padding:0.25pt 3.6pt;">–</td>
<td id="S3.T1.2.1.6.6" class="ltx_td ltx_align_center" style="padding:0.25pt 3.6pt;">–</td>
<td id="S3.T1.2.1.6.7" class="ltx_td ltx_align_center" style="padding:0.25pt 3.6pt;">–</td></tr>
