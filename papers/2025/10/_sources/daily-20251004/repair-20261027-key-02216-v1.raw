<tr id="S6.SS1.fig2.2.1.1" class="ltx_tr">
<td id="S6.SS1.fig2.2.1.1.1" class="ltx_td ltx_border_tt"></td>
<td id="S6.SS1.fig2.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.SS1.fig2.2.1.1.2.1" class="ltx_text ltx_font_bold">P1</span></td>
<td id="S6.SS1.fig2.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.SS1.fig2.2.1.1.3.1" class="ltx_text ltx_font_bold">P2</span></td>
<td id="S6.SS1.fig2.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.SS1.fig2.2.1.1.4.1" class="ltx_text ltx_font_bold">P3</span></td>
<td id="S6.SS1.fig2.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.SS1.fig2.2.1.1.5.1" class="ltx_text ltx_font_bold">P4</span></td></tr>
<tr id="S6.SS1.fig2.2.1.2" class="ltx_tr">
<td id="S6.SS1.fig2.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">S1</td>
<td id="S6.SS1.fig2.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">34.58 (±1.22)</td>
<td id="S6.SS1.fig2.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">58.46 (±1.89)</td>
<td id="S6.SS1.fig2.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">72.42 (±1.66)</td>
<td id="S6.SS1.fig2.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">80.25 (±1.64)</td></tr>
