</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<div id="S6.SS1.fig2.2" class="ltx_inline-block ltx_figure_panel ltx_align_center ltx_transformed_outer" style="width:186.3pt;height:50pt;vertical-align:-23.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-88.0pt,23.6pt) scale(0.514239940521183,0.514239940521183) ;">
