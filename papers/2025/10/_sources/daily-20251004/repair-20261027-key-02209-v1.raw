<tr id="S1.T1.4.1.9" class="ltx_tr">
<td id="S1.T1.4.1.9.1" class="ltx_td ltx_align_left ltx_border_r">Finance Agent Benchmark <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib5" title="" class="ltx_ref">Bigeard et al., 2025</a>)</cite></td>
<td id="S1.T1.4.1.9.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.T1.4.1.9.2.1" class="ltx_text" style="--ltx-fg-color:#008080;">✓</span></td>
<td id="S1.T1.4.1.9.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.T1.4.1.9.3.1" class="ltx_text" style="--ltx-fg-color:#BF8040;">✗</span></td>
<td id="S1.T1.4.1.9.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.T1.4.1.9.4.1" class="ltx_text" style="--ltx-fg-color:#008080;">✓</span></td>
<td id="S1.T1.4.1.9.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.T1.4.1.9.5.1" class="ltx_text" style="--ltx-fg-color:#BF8040;">✗</span></td>
<td id="S1.T1.4.1.9.6" class="ltx_td ltx_align_center"><span id="S1.T1.4.1.9.6.1" class="ltx_text" style="--ltx-fg-color:#BF8040;">✗</span></td></tr>
<tr id="S1.T1.4.1.10" class="ltx_tr">
<td id="S1.T1.4.1.10.1" class="ltx_td ltx_align_left ltx_border_r">INVESTORBENCH <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib22" title="" class="ltx_ref">Li et al., 2024</a>)</cite></td>
<td id="S1.T1.4.1.10.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.T1.4.1.10.2.1" class="ltx_text" style="--ltx-fg-color:#008080;">✓</span></td>
<td id="S1.T1.4.1.10.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.T1.4.1.10.3.1" class="ltx_text" style="--ltx-fg-color:#008080;">✓</span></td>
<td id="S1.T1.4.1.10.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.T1.4.1.10.4.1" class="ltx_text" style="--ltx-fg-color:#008080;">✓</span></td>
<td id="S1.T1.4.1.10.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S1.T1.4.1.10.5.1" class="ltx_text" style="--ltx-fg-color:#BF8040;">✗</span></td>
<td id="S1.T1.4.1.10.6" class="ltx_td ltx_align_center"><span id="S1.T1.4.1.10.6.1" class="ltx_text" style="--ltx-fg-color:#008080;">✓</span></td></tr>
