<tr id="A3.T7.2.29" class="ltx_tr">
<td id="A3.T7.2.29.1" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.0pt;">steps</td>
<td id="A3.T7.2.29.2" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;" colspan="4">250</td></tr>
<tr id="A3.T7.2.30" class="ltx_tr">
<td id="A3.T7.2.30.1" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.0pt;"><math id="A3.T7.m10" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math></td>
<td id="A3.T7.2.30.2" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">0.003</td>
<td id="A3.T7.2.30.3" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">0.003</td>
<td id="A3.T7.2.30.4" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">0.003</td>
<td id="A3.T7.2.30.5" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">0.0017</td></tr>
<tr id="A3.T7.2.31" class="ltx_tr">
<td id="A3.T7.2.31.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:-0.25pt 4.0pt;"><math id="A3.T7.m11" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math></td>
<td id="A3.T7.2.31.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 4.0pt;">0.35</td>
<td id="A3.T7.2.31.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 4.0pt;">0.35</td>
<td id="A3.T7.2.31.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 4.0pt;">0.35</td>
<td id="A3.T7.2.31.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 4.0pt;">0.3</td></tr>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 7: </span><span id="A3.T7.4" class="ltx_text ltx_font_bold">Equilibrium Matching Configurations.</span></figcaption>
</figure>
<div id="A3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Derivation of Statement <a href="#S4.Thmstatement1" title="Statement 1 (Learned Gradient at Ground-Truth Samples). ‣ 4 Analysis ‣ Equilibrium Matching: Generative Modeling with Implicit Energy-Based Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</h6>
<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p"><span id="A3.SS1.p1.1.1" class="ltx_text">Under perfect training, the squared-error objective</span></p>
<table id="A3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex5.m1" class="ltx_Math" alttext="\mathcal{L}=\mathbb{E}_{x,\epsilon,\gamma}\bigl\|f(x_{\gamma})-(\epsilon-x)\,c(\gamma)\bigr\|^{2}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>,</mo><mi>ϵ</mi><mo>,</mo><mi>γ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>γ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}=\mathbb{E}_{x,\epsilon,\gamma}\bigl\|f(x_{\gamma})-(\epsilon-x)\,c(\gamma)\bigr\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.2" class="ltx_p"><span id="A3.SS1.p1.2.1" class="ltx_text">is minimized when</span></p>
<table id="A3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex6.m1" class="ltx_Math" alttext="f(x_{\gamma})\;=\;\mathbb{E}\bigl[(\epsilon-x)\,c(\gamma)\;\big|\;x_{\gamma}\bigr]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>γ</mi></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><msub><mi>x</mi><mi>γ</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(x_{\gamma})\;=\;\mathbb{E}\bigl[(\epsilon-x)\,c(\gamma)\;\big|\;x_{\gamma}\bigr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.p2.1" class="ltx_p"><span id="A3.SS1.p2.1.1" class="ltx_text">We use the forward noising model</span></p>
<table id="A3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex8.m1" class="ltx_Math" alttext="x_{\gamma}\;=\;\gamma\,x\;+\;(1-\gamma)\,\epsilon," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mi>γ</mi></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mrow><mi>γ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>x</mi></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">x_{\gamma}\;=\;\gamma\,x\;+\;(1-\gamma)\,\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.2" class="ltx_p"><span id="A3.SS1.p2.2.1" class="ltx_text">where <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="x\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}</annotation></semantics></math> is one of finitely many training points and <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="\epsilon\sim\mathcal{N}(0,I_{d})" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon\sim\mathcal{N}(0,I_{d})</annotation></semantics></math>.
For any fixed <math id="A3.SS1.p2.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> and <math id="A3.SS1.p2.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, the conditional density of <math id="A3.SS1.p2.m5" class="ltx_Math" alttext="x_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">x_{\gamma}</annotation></semantics></math> given <math id="A3.SS1.p2.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>,</span></p>
<table id="A3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex9.m1" class="ltx_Math" alttext="p(x_{\gamma}\mid\gamma)\;=\;\mathcal{N}\bigl(\gamma\,x,\,(1-\gamma)^{2}I_{d}\bigr)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>γ</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>γ</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>γ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>x</mi></mrow><mo>,</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">p(x_{\gamma}\mid\gamma)\;=\;\mathcal{N}\bigl(\gamma\,x,\,(1-\gamma)^{2}I_{d}\bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.3" class="ltx_p"><span id="A3.SS1.p2.3.1" class="ltx_text">is a continuous Gaussian on <math id="A3.SS1.p2.m7" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS1.p3" class="ltx_para ltx_noindent">
<p id="A3.SS1.p3.1" class="ltx_p"><span id="A3.SS1.p3.1.1" class="ltx_text">At <math id="A3.SS1.p3.m1" class="ltx_Math" alttext="\gamma=1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma=1</annotation></semantics></math>, <math id="A3.SS1.p3.m2" class="ltx_Math" alttext="x_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">x_{\gamma}</annotation></semantics></math> equals exactly <math id="A3.SS1.p3.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> with probability one (a Dirac mass on each <math id="A3.SS1.p3.m4" class="ltx_Math" alttext="x\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}</annotation></semantics></math>).</span></p>
</div>
<div id="A3.SS1.p4" class="ltx_para ltx_noindent">
<p id="A3.SS1.p4.1" class="ltx_p"><span id="A3.SS1.p4.1.1" class="ltx_text">Since <math id="A3.SS1.p4.m1" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math> is a finite discrete set, in the limit <math id="A3.SS1.p4.m2" class="ltx_Math" alttext="d\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">d\to\infty</annotation></semantics></math> the Gaussian density at any exact training point <math id="A3.SS1.p4.m3" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math> for <math id="A3.SS1.p4.m4" class="ltx_Math" alttext="\gamma&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma&lt;1</annotation></semantics></math> vanishes exponentially in <math id="A3.SS1.p4.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, whereas the mass at <math id="A3.SS1.p4.m6" class="ltx_Math" alttext="\gamma=1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma=1</annotation></semantics></math> remains. Hence</span></p>
<table id="A3.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex10.m1" class="ltx_Math" alttext="P\bigl(\gamma=1\mid x_{\gamma}=x^{(i)}\bigr)\;\longrightarrow\;1\quad(d\to\infty)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>γ</mi><mo>=</mo><mn>1</mn></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>x</mi><mi>γ</mi></msub><mo>=</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mn> 1</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P\bigl(\gamma=1\mid x_{\gamma}=x^{(i)}\bigr)\;\longrightarrow\;1\quad(d\to\infty).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p5" class="ltx_para ltx_noindent">
<p id="A3.SS1.p5.1" class="ltx_p"><span id="A3.SS1.p5.1.1" class="ltx_text">Plugging equation <a href="#A3.Ex10" title="Derivation of Statement . ‣ C.1 Learned Gradient at Ground-Truth Samples ‣ Appendix C Derivations ‣ Equilibrium Matching: Generative Modeling with Implicit Energy-Based Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a> into equation <a href="#A3.Ex6" title="Derivation of Statement . ‣ C.1 Learned Gradient at Ground-Truth Samples ‣ Appendix C Derivations ‣ Equilibrium Matching: Generative Modeling with Implicit Energy-Based Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>, we get</span></p>
<table id="A3.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex12.m1" class="ltx_Math" alttext="f\bigl(x^{(i)}\bigr)\;=\;\mathbb{E}\bigl[(\epsilon-x)\,c(\gamma)\;\big|\;x_{\gamma}=x^{(i)}\bigr]\;\approx\;(\epsilon-x^{(i)})\,c(1)\;=\;0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mrow><msub><mi>x</mi><mi>γ</mi></msub><mo>=</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">≈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>−</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn> 0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f\bigl(x^{(i)}\bigr)\;=\;\mathbb{E}\bigl[(\epsilon-x)\,c(\gamma)\;\big|\;x_{\gamma}=x^{(i)}\bigr]\;\approx\;(\epsilon-x^{(i)})\,c(1)\;=\;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p5.2" class="ltx_p"><span id="A3.SS1.p5.2.1" class="ltx_text">since <math id="A3.SS1.p5.m1" class="ltx_Math" alttext="c(1)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(1)=0</annotation></semantics></math>. Therefore <math id="A3.SS1.p5.m2" class="ltx_Math" alttext="\|f(x^{(i)})\|_{2}\approx 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≈</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\|f(x^{(i)})\|_{2}\approx 0</annotation></semantics></math>, as claimed.
∎</span></p>
</div>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Property of Local Minima</h3>

<div id="A3.Thmstatement2" class="ltx_theorem ltx_theorem_statement">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmstatement2.2" class="ltx_text ltx_font_bold">Statement 2</span></span><span id="A3.Thmstatement2.3" class="ltx_text ltx_font_bold"> </span>(Property of Local Minima)<span id="A3.Thmstatement2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmstatement2.p1" class="ltx_para ltx_noindent">
<p id="A3.Thmstatement2.p1.1" class="ltx_p"><span id="A3.Thmstatement2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmstatement2.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> be an Equilibrium Matching model with <math id="A3.Thmstatement2.p1.m2" class="ltx_Math" alttext="c(1)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(1)=0</annotation></semantics></math>, and let <math id="A3.Thmstatement2.p1.m3" class="ltx_Math" alttext="\hat{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{x}</annotation></semantics></math> be an arbitrary local minimum where <math id="A3.Thmstatement2.p1.m4" class="ltx_Math" alttext="f(\hat{x})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f(\hat{x})=0</annotation></semantics></math>. Assume perfect training, i.e., <math id="A3.Thmstatement2.p1.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> exactly minimizes the training objective. Then, in high-dimensional settings, we have:</span></p>
<table id="A3.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex13.m1" class="ltx_Math" alttext="P(\hat{x}\in\mathcal{X})\approx 1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(\hat{x}\in\mathcal{X})\approx 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmstatement2.p1.2" class="ltx_p"><span id="A3.Thmstatement2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A3.Thmstatement2.p1.m6" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math> is the ground-truth dataset. In other words, all local minima are approximately samples from the ground-truth dataset.</span></p>
</div>
</div>
<div id="A3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Derivation of Statement <a href="#S4.Thmstatement2" title="Statement 2 (Property of Local Minima). ‣ 4 Analysis ‣ Equilibrium Matching: Generative Modeling with Implicit Energy-Based Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</h6>
<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p"><span id="A3.SS2.p1.1.1" class="ltx_text">By the same argument as before, perfect training implies</span></p>
<table id="A3.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex14.m1" class="ltx_Math" alttext="0=f(\hat{x})=\mathbb{E}\bigl[(\epsilon-x)\,c(\gamma)\;\big|\;x_{\gamma}=\hat{x}\bigr]." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mrow><msub><mi>x</mi><mi>γ</mi></msub><mo>=</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0=f(\hat{x})=\mathbb{E}\bigl[(\epsilon-x)\,c(\gamma)\;\big|\;x_{\gamma}=\hat{x}\bigr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.2" class="ltx_p"><span id="A3.SS2.p1.2.1" class="ltx_text">Since <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="c(\gamma)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\gamma)\geq 0</annotation></semantics></math> for all <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> and <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="c(1)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(1)=0</annotation></semantics></math> while <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="c(\gamma)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\gamma)&gt;0</annotation></semantics></math> for <math id="A3.SS2.p1.m5" class="ltx_Math" alttext="\gamma&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma&lt;1</annotation></semantics></math>, the only way the vector-valued expectation in equation <a href="#A3.Ex14" title="Derivation of Statement . ‣ C.2 Property of Local Minima ‣ Appendix C Derivations ‣ Equilibrium Matching: Generative Modeling with Implicit Energy-Based Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a> can vanish in high dimension is if the posterior mass concentrates at <math id="A3.SS2.p1.m6" class="ltx_Math" alttext="\gamma=1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma=1</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.p2.1" class="ltx_p"><span id="A3.SS2.p2.1.1" class="ltx_text">We can argue exactly as in equation <a href="#A3.Ex10" title="Derivation of Statement . ‣ C.1 Learned Gradient at Ground-Truth Samples ‣ Appendix C Derivations ‣ Equilibrium Matching: Generative Modeling with Implicit Energy-Based Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>: for any <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="\hat{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{x}</annotation></semantics></math> that equals some <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="x^{(i)}\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x^{(i)}\in\mathcal{X}</annotation></semantics></math>, we have</span></p>
<table id="A3.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex16.m1" class="ltx_Math" alttext="P(\gamma=1\mid x_{\gamma}=\hat{x})\;\longrightarrow\;1," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>=</mo><mn>1</mn></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>x</mi><mi>γ</mi></msub><mo>=</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover></mrow><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mn> 1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P(\gamma=1\mid x_{\gamma}=\hat{x})\;\longrightarrow\;1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.2" class="ltx_p"><span id="A3.SS2.p2.2.1" class="ltx_text">and for <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="\gamma&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma&lt;1</annotation></semantics></math> the density is exponentially small in <math id="A3.SS2.p2.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.
Since at <math id="A3.SS2.p2.m5" class="ltx_Math" alttext="\gamma=1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma=1</annotation></semantics></math>, all <math id="A3.SS2.p2.m6" class="ltx_Math" alttext="x_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">x_{\gamma}</annotation></semantics></math> are in <math id="A3.SS2.p2.m7" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math>,</span></p>
<table id="A3.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex17.m1" class="ltx_Math" alttext="P(\hat{x}\in\mathcal{X})\approx 1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(\hat{x}\in\mathcal{X})\approx 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.3" class="ltx_p"><span id="A3.SS2.p2.3.1" class="ltx_text">establishing the claim.
∎</span></p>
</div>
</div>
<figure id="A3.SS2.fig3" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
