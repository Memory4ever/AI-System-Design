<td id="A3.T9.1.6.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:-0.25pt 4.0pt;"><span id="A3.T9.1.6.1.1" class="ltx_text ltx_font_bold">EqM-XL/2</span></td>
<td id="A3.T9.1.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 4.0pt;"><span id="A3.T9.1.6.2.1" class="ltx_text ltx_font_bold">EqM</span></td>
<td id="A3.T9.1.6.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 4.0pt;"><span id="A3.T9.1.6.3.1" class="ltx_text ltx_font_bold">1.90</span></td>
<td id="A3.T9.1.6.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 4.0pt;">4.54</td>
