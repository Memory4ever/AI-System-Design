<td id="S5.T3.1.4.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-0.25pt 4.0pt;"><span id="S5.T3.1.4.5.1" class="ltx_text ltx_font_bold">38.34</span></td>
