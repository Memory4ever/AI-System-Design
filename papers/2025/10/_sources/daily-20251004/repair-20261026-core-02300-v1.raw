</table>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Table 1: </span><span id="S5.T1.4" class="ltx_text ltx_font_bold">Class-Conditional ImageNet 256<math id="S5.T1.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>256 Generation.</span> EqM-XL/2 achieves a 1.90 FID, surpassing other tested methods.</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S5.T2" class="ltx_figure ltx_figure_panel ltx_align_center ltx_align_bottom" style="width:214.6pt;">
<table id="S5.T2.1" class="ltx_tabular ltx_centering ltx_figure_panel ltx_align_middle">
<tr id="S5.T2.1.1" class="ltx_tr">
<td id="S5.T2.1.1.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding:-0.25pt 4.0pt;">model</td>
<td id="S5.T2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.25pt 4.0pt;">sampler</td>
<td id="S5.T2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.25pt 4.0pt;"><math id="S5.m1" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math></td>
<td id="S5.T2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.25pt 4.0pt;"><math id="S5.m2" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math></td>
<td id="S5.T2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.25pt 4.0pt;">FID</td></tr>
<tr id="S5.T2.1.2" class="ltx_tr">
<td id="S5.T2.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.25pt 4.0pt;">SiT-XL/2</td>
<td id="S5.T2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;">Euler (ODE)</td>
<td id="S5.T2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;">0.0040</td>
<td id="S5.T2.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;">-</td>
<td id="S5.T2.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;">2.10</td></tr>
<tr id="S5.T2.1.3" class="ltx_tr">
<td id="S5.T2.1.3.1" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.0pt;">SiT-XL/2</td>
<td id="S5.T2.1.3.2" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">Heun (SDE)</td>
<td id="S5.T2.1.3.3" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">0.0040</td>
<td id="S5.T2.1.3.4" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">-</td>
<td id="S5.T2.1.3.5" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">2.06</td></tr>
<tr id="S5.T2.1.4" class="ltx_tr">
<td id="S5.T2.1.4.1" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.0pt;">EqM-XL/2</td>
