<td id="S5.T1.1.6.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:-0.25pt 4.0pt;"><span id="S5.T1.1.6.1.1" class="ltx_text ltx_font_bold">EqM-XL/2</span></td>
