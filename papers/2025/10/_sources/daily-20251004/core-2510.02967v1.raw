<td id="S2.T4.3.1.6.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.6.2.1" class="ltx_text" style="font-size:90%;">Anthropic</span></td>
<td id="S2.T4.3.1.6.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.6.3.1" class="ltx_text" style="font-size:90%;">2025</span></td>
