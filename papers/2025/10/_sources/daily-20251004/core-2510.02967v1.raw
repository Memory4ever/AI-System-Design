</span></td></tr>
<tr id="A6.T27.6.3" class="ltx_tr">
<td id="A6.T27.6.3.1" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top" style="padding-top:2.5pt;padding-bottom:2.5pt;">
