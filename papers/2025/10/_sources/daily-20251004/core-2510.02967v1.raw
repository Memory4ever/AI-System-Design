<span id="S3.T10.3.1.1.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="S3.T10.3.1.1.1.1" class="ltx_p"><span id="S3.T10.3.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Model</span></span>
</span></td>
<td id="S3.T10.3.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S3.T10.3.1.2.1" class="ltx_text"></span><span id="S3.T10.3.1.2.2" class="ltx_text" style="font-size:90%;"> <span id="S3.T10.3.1.2.2.1" class="ltx_text">
