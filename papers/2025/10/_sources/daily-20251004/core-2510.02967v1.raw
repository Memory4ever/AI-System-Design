<td id="S2.T4.3.1.7.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.7.3.1" class="ltx_text" style="font-size:90%;">2024</span></td>
