<td id="S2.T4.3.1.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.4.3.1" class="ltx_text" style="font-size:90%;">2025</span></td>
<td id="S2.T4.3.1.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.4.4.1" class="ltx_text" style="font-size:90%;">1 000 000</span></td>
<td id="S2.T4.3.1.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.4.5.1" class="ltx_text" style="font-size:90%;">No</span></td></tr>
<tr id="S2.T4.3.1.5" class="ltx_tr">
<td id="S2.T4.3.1.5.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.5.1.1" class="ltx_text" style="font-size:90%;">O4-Mini</span></td>
<td id="S2.T4.3.1.5.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.5.2.1" class="ltx_text" style="font-size:90%;">OpenAI</span></td>
<td id="S2.T4.3.1.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.5.3.1" class="ltx_text" style="font-size:90%;">2025</span></td>
<td id="S2.T4.3.1.5.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.5.4.1" class="ltx_text" style="font-size:90%;">200 000</span></td>
<td id="S2.T4.3.1.5.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S2.T4.3.1.5.5.1" class="ltx_text" style="font-size:90%;">Yes</span></td></tr>
