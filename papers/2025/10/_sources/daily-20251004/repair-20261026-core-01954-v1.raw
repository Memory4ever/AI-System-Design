<div id="S4.F5.p1" class="ltx_para">
<div id="S4.F5.p1.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:146.3pt;height:62.3pt;vertical-align:-29.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-26.8pt,11.4pt) scale(0.731586942362001,0.731586942362001) ;">
<table id="S4.F5.p1.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.F5.p1.1.1.1" class="ltx_tr">
<th id="S4.F5.p1.1.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.F5.p1.1.1.1.1.1" class="ltx_text ltx_font_bold">point</span></th>
