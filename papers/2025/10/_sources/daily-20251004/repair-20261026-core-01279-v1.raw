</div>
<div id="alg2.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
            <span id="alg2.l13.3" class="ltx_text ltx_font_bold">else</span> <span id="alg2.l13.4" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l13.m1" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math> issues a search query and <math id="alg2.l13.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> allows <span id="alg2.l13.5" class="ltx_text ltx_font_typewriter">Search</span> <span id="alg2.l13.6" class="ltx_text ltx_font_bold">then</span>

</div>
