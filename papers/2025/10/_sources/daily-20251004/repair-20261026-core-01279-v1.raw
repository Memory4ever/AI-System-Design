            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
               <math id="alg2.l9.m1" class="ltx_math_unparsed" alttext="h\leftarrow h\parallel\text{``Runtime error:'' }r" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo stretchy="false">←</mo><mi>h</mi><mo lspace="0em" rspace="0.167em">∥</mo><mtext>“Runtime error:” </mtext><mi>r</mi></mrow><annotation encoding="application/x-tex">h\leftarrow h\parallel\text{``Runtime error:'' }r</annotation></semantics></math>; <math id="alg2.l9.m2" class="ltx_Math" alttext="b\leftarrow b+1" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo stretchy="false">←</mo><mrow><mi>b</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">b\leftarrow b+1</annotation></semantics></math>; <span id="alg2.l9.3" class="ltx_text ltx_font_bold">continue</span>

</div>
