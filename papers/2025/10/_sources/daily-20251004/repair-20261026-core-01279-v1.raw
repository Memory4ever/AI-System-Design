             <math id="alg2.l7.m1" class="ltx_Math" alttext="r\leftarrow\textsc{ExecuteCode}(o,\tau)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">ExecuteCode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r\leftarrow\textsc{ExecuteCode}(o,\tau)</annotation></semantics></math> <span id="alg2.l7.3" class="ltx_text" style="float:right;"><math id="alg2.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> hard limit <math id="alg2.l7.m3" class="ltx_Math" alttext="\tau=60" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>60</mn></mrow><annotation encoding="application/x-tex">\tau=60</annotation></semantics></math>s; capture stdout/plots/files
</span>
</div>
