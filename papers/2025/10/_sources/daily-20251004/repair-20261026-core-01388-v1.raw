<td id="S6.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.T3.2.1.2.1" class="ltx_text ltx_font_bold">Mean <math id="S6.T3.m1" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> Error <math id="S6.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S6.T3.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.T3.2.1.3.1" class="ltx_text ltx_font_bold">Hausdorff Distance <math id="S6.T3.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
