<div id="S4.T2.4" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:433.6pt;height:160.1pt;vertical-align:-78.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-80.1pt,29.6pt) scale(0.730270369991282,0.730270369991282) ;">
<table id="S4.T2.4.1" class="ltx_tabular ltx_align_middle">
<tr id="S4.T2.4.1.1" class="ltx_tr">
<td id="S4.T2.4.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S4.T2.4.1.1.1.1" class="ltx_text ltx_font_bold">Model</span></td>
