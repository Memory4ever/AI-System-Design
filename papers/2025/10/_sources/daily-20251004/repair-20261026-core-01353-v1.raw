<td id="S5.T3.6.5.4" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.5.4.1" class="ltx_text" style="font-size:90%;">0.237</span></td>
<td id="S5.T3.6.5.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.5.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">13.72<span id="S5.T3.6.5.5.1.1" class="ltx_text ltx_font_medium">/48.4</span></span></td>
<td id="S5.T3.6.5.6" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.5.6.1" class="ltx_text" style="font-size:90%;">0.840</span></td></tr>
<tr id="S5.T3.6.6" class="ltx_tr">
<th id="S5.T3.6.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.6.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">gemini-2.5-pro+Mem0</span></th>
<td id="S5.T3.6.6.2" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.6.2.1" class="ltx_text" style="font-size:90%;">0.118</span></td>
