<td id="S5.T3.6.4.6" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.4.6.1" class="ltx_text" style="font-size:90%;">0.949</span></td></tr>
<tr id="S5.T3.6.5" class="ltx_tr">
<th id="S5.T3.6.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.5.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">gemini-2.5-pro+NoMem</span></th>
<td id="S5.T3.6.5.2" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.5.2.1" class="ltx_text" style="font-size:90%;">0.144</span></td>
