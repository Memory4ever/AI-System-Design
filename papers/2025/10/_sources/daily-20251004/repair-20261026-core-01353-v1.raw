<td id="S5.T3.6.6.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.6.5.1" class="ltx_text" style="font-size:90%;">12.53/46.8</span></td>
