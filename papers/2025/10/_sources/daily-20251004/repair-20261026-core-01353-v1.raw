<td id="S5.T3.6.7.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T3.6.7.4.1" class="ltx_text" style="font-size:90%;">0.238</span></td>
