<th id="S4.F4.3.4.1" class="ltx_td ltx_align_right ltx_th ltx_th_row" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.4.1.1" class="ltx_text" style="font-size:80%;">2</span></th>
<td id="S4.F4.3.4.2" class="ltx_td ltx_nopad_r ltx_align_right" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.4.2.1" class="ltx_text" style="font-size:80%;">5.0</span></td></tr>
<tr id="S4.F4.3.5" class="ltx_tr">
<th id="S4.F4.3.5.1" class="ltx_td ltx_align_right ltx_th ltx_th_row" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.5.1.1" class="ltx_text" style="font-size:80%;">4</span></th>
<td id="S4.F4.3.5.2" class="ltx_td ltx_nopad_r ltx_align_right" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.5.2.1" class="ltx_text" style="font-size:80%;">4.5</span></td></tr>
