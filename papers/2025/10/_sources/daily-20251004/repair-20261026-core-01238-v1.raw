<th id="S4.F4.3.6.1" class="ltx_td ltx_align_right ltx_th ltx_th_row" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.6.1.1" class="ltx_text" style="font-size:80%;">8</span></th>
<td id="S4.F4.3.6.2" class="ltx_td ltx_nopad_r ltx_align_right" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.6.2.1" class="ltx_text" style="font-size:80%;">3.5</span></td></tr>
