<th id="S4.F4.3.1.2" class="ltx_td ltx_nopad_r ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">ASR</span></th></tr>
</thead>
