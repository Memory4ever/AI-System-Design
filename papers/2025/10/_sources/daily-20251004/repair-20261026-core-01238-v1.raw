<th id="S4.F4.3.8.1" class="ltx_td ltx_align_right ltx_th ltx_th_row" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.8.1.1" class="ltx_text" style="font-size:80%;">32</span></th>
<td id="S4.F4.3.8.2" class="ltx_td ltx_nopad_r ltx_align_right" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.8.2.1" class="ltx_text" style="font-size:80%;">12.0</span></td></tr>
<tr id="S4.F4.3.9" class="ltx_tr">
<th id="S4.F4.3.9.1" class="ltx_td ltx_align_right ltx_th ltx_th_row" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.9.1.1" class="ltx_text" style="font-size:80%;">64</span></th>
<td id="S4.F4.3.9.2" class="ltx_td ltx_nopad_r ltx_align_right" style="padding:-0.45pt 3.0pt;"><span id="S4.F4.3.9.2.1" class="ltx_text" style="font-size:80%;">22.5</span></td></tr>
