<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex310.m2" class="ltx_Math" alttext="\displaystyle~\left\|\exp(QK^{\top}/d)-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></msup></mrow></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\left\|\exp(QK^{\top}/d)-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\|_{\infty}</annotation></semantics></math></td>
