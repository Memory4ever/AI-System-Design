<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex286.m2" class="ltx_Math" alttext="\displaystyle~\left|\left(S\left(U_{1}\right)_{i,*}^{\otimes\left(p/2\right)}\right)^{\top}\left(S\left(U_{2}\right)_{j,*}^{\otimes\left(p/2\right)}\right)-\left(\left(U_{1}\right)_{i,*}^{\otimes p/2}\right)^{\top}\left(U_{2}\right)_{j,*}^{\otimes p/2}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msubsup></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mrow><mo>(</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></mrow></msubsup></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\left|\left(S\left(U_{1}\right)_{i,*}^{\otimes\left(p/2\right)}\right)^{\top}\left(S\left(U_{2}\right)_{j,*}^{\otimes\left(p/2\right)}\right)-\left(\left(U_{1}\right)_{i,*}^{\otimes p/2}\right)^{\top}\left(U_{2}\right)_{j,*}^{\otimes p/2}\right|</annotation></semantics></math></td>
