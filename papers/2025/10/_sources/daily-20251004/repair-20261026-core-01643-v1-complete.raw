<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex233.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex233.m2" class="ltx_Math" alttext="\displaystyle~\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\sum_{i=1}^{n}\sum_{j=1}^{n}\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)_{i,j}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}-\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)_{i,j}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>exp</mi><mo>⁡</mo><msubsup><mrow><mo>(</mo><mrow><mrow><msup><mi>Q</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msup><mi>K</mi><mrow><mo>(</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></msubsup></mrow></mrow></mrow><mo>−</mo><msubsup><mrow><mo>(</mo><mrow><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\sum_{i=1}^{n}\sum_{j=1}^{n}\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)_{i,j}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}-\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)_{i,j}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex234"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex234.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex234.m2" class="ltx_Math" alttext="\displaystyle~\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\left|\mathrm{supp}\left(\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right)\right|C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\beta^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}-1}\epsilon_{0}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>exp</mi><mo>⁡</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mi>Q</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msup><mi>K</mi><mrow><mo>(</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\left|\mathrm{supp}\left(\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right)\right|C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\beta^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}-1}\epsilon_{0}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex235"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex235.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex235.m2" class="ltx_Math" alttext="\displaystyle~\epsilon_{0}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|\frac{b^{2}\left(1+\epsilon\right)^{\ell+\ell^{\prime}}}{\log n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{\ell+\ell^{\prime}}}{\log n}\right)}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\epsilon_{0}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|\frac{b^{2}\left(1+\epsilon\right)^{\ell+\ell^{\prime}}}{\log n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{\ell+\ell^{\prime}}}{\log n}\right)}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS5.p3.2" class="ltx_p"><span id="A7.SS5.p3.2.1" class="ltx_text">where the first step follows from definition of <math id="A7.SS5.p3.m2" class="ltx_Math" alttext="\ell_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\ell_{1}</annotation></semantics></math> norm, the third step follows from exchanging the order of the summation, the fourth step follows from the mean value theorem (see Fact <a href="#A7.Thmtheorem4" title="Fact G.4. ‣ G.2 Basic Facts ‣ Appendix G THRESHOLD VALUES SPECIFICATION AND INTERVAL-BASED FACTORIZATION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.4</span></a>) and the fact that there are</span></p>
<table id="A7.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex236"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex236.m1" class="ltx_Math" alttext="\displaystyle\left|\mathrm{supp}\left(\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>exp</mi><mo>⁡</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mi>Q</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msup><mi>K</mi><mrow><mo>(</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathrm{supp}\left(\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.SS5.p3.3" class="ltx_p"><span id="A7.SS5.p3.3.1" class="ltx_text">amount of non-zero entries to approximate, and the last step follows from the definition of <math id="A7.SS5.p3.m3" class="ltx_Math" alttext="A^{\left(\ell,\ell^{\prime}\right)}" display="inline" intent=":literal"><semantics><msup><mi>A</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><annotation encoding="application/x-tex">A^{\left(\ell,\ell^{\prime}\right)}</annotation></semantics></math>, <math id="A7.SS5.p3.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, and <math id="A7.SS5.p3.m5" class="ltx_Math" alttext="C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><annotation encoding="application/x-tex">C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}</annotation></semantics></math> (see from the lemma statement).</span></p>
</div>
<div id="A7.SS5.p4" class="ltx_para">
<p id="A7.SS5.p4.1" class="ltx_p"><span id="A7.SS5.p4.1.1" class="ltx_text">Furthermore, by using the Cauchy–Schwarz inequality (see Fact <a href="#A10.Thmtheorem3" title="Fact J.3. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a>), we can get:</span></p>
<table id="A7.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex237"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex237.m2" class="ltx_Math" alttext="\displaystyle~\left\|\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\|_{1}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>exp</mi><mo>⁡</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mi>Q</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msup><mi>K</mi><mrow><mo>(</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></msup></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></msup></mrow></mrow></mrow><mo>‖</mo></mrow><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle~\left\|\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex238"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex238.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex238.m2" class="ltx_Math" alttext="\displaystyle~\epsilon_{0}\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|^{2}\right)^{1/2}\cdot\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\frac{b^{4}\left(1+\epsilon\right)^{2\ell+2\ell^{\prime}}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{\ell+\ell^{\prime}}}{\log n}\right)}\right)^{1/2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></msup></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle~\epsilon_{0}\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|^{2}\right)^{1/2}\cdot\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\frac{b^{4}\left(1+\epsilon\right)^{2\ell+2\ell^{\prime}}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{\ell+\ell^{\prime}}}{\log n}\right)}\right)^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex239"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex239.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex239.m2" class="ltx_Math" alttext="\displaystyle~\epsilon_{0}\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|\right)\cdot\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\frac{b^{4}\left(1+\epsilon\right)^{2\ell+2\ell^{\prime}}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{\ell+\ell^{\prime}}}{\log n}\right)}\right)^{1/2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></msup></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle~\epsilon_{0}\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|\right)\cdot\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\frac{b^{4}\left(1+\epsilon\right)^{2\ell+2\ell^{\prime}}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{\ell+\ell^{\prime}}}{\log n}\right)}\right)^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.E17.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.E17.m2" class="ltx_Math" alttext="\displaystyle~\epsilon_{0}\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|\right)\cdot\left(\int_{1}^{m+1}\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{x+y}}{\log n}\right)}\,\mathrm{d}x\,\mathrm{d}y\right)^{1/2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\epsilon_{0}\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|\right)\cdot\left(\int_{1}^{m+1}\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{x+y}}{\log n}\right)}\,\mathrm{d}x\,\mathrm{d}y\right)^{1/2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A7.SS5.p4.2" class="ltx_p"><span id="A7.SS5.p4.2.1" class="ltx_text">where the second step follows from Fact <a href="#A10.Thmtheorem3" title="Fact J.3. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a> and the third step follows from the definition of Riemann integral.</span></p>
</div>
<div id="A7.SS5.p5" class="ltx_para">
<p id="A7.SS5.p5.1" class="ltx_p"><span id="A7.SS5.p5.1.1" class="ltx_text">Since <math id="A7.SS5.p5.m1" class="ltx_Math" alttext="\{A^{(\ell,\ell^{\prime})}\}_{\ell,\ell^{\prime}\in[m]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{A^{(\ell,\ell^{\prime})}\}_{\ell,\ell^{\prime}\in[m]}</annotation></semantics></math> forms a support basis of <math id="A7.SS5.p5.m2" class="ltx_Math" alttext="QK^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">QK^{\top}</annotation></semantics></math> (see Lemma <a href="#A6.Thmtheorem4" title="Lemma F.4. ‣ F.2 Multi-Threshold Support Basis Decomposition of 𝑄⁢𝐾^⊤ ‣ Appendix F MULTIPLE THRESHOLDS SUPPORT BASIS DECOMPOSITION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.4</span></a>), by applying Fact <a href="#A10.Thmtheorem2" title="Fact J.2. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.2</span></a>, we have</span></p>
<table id="A7.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.E18.m1" class="ltx_Math" alttext="\displaystyle\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|\leq n^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>≤</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{\left(\ell,\ell^{\prime}\right)}\right)\right|\leq n^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
<div id="A7.SS5.p6" class="ltx_para">
<p id="A7.SS5.p6.1" class="ltx_p"><span id="A7.SS5.p6.1.1" class="ltx_text">Additionally, for all <math id="A7.SS5.p6.m1" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>, we have</span></p>
<table id="A7.EGx115" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex240"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex240.m2" class="ltx_Math" alttext="\displaystyle~\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{x+y}}{\log n}\right)}\,\mathrm{d}x" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{x+y}}{\log n}\right)}\,\mathrm{d}x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex241"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex241.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex241.m2" class="ltx_Math" alttext="\displaystyle~\frac{cb^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-cb^{2}\left(1+\epsilon\right)^{y+1}e^{b^{2}c(\epsilon+1)^{y+1}}-e^{b^{2}c(\epsilon+1)^{y+m+1}}+e^{b^{2}c(\epsilon+1)^{y+1}}}{c^{2}\log^{2}n\log(\epsilon+1)}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>−</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>+</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle~\frac{cb^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-cb^{2}\left(1+\epsilon\right)^{y+1}e^{b^{2}c(\epsilon+1)^{y+1}}-e^{b^{2}c(\epsilon+1)^{y+m+1}}+e^{b^{2}c(\epsilon+1)^{y+1}}}{c^{2}\log^{2}n\log(\epsilon+1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.E19.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.E19.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{b^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}}{c\log^{2}\left(n\right)\log\left({\epsilon}+1\right)}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mrow><mi>c</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo>(</mo><mi>n</mi><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{b^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}}{c\log^{2}\left(n\right)\log\left({\epsilon}+1\right)}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A7.SS5.p6.2" class="ltx_p"><span id="A7.SS5.p6.2.1" class="ltx_text">where the first step follows from <span id="A7.SS5.p6.2.1.1" class="ltx_text ltx_font_bold">Part 1</span> of Fact <a href="#A10.Thmtheorem4" title="Fact J.4 (Integral analysis). ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.4</span></a> and the second step follows from the fact that <math id="A7.SS5.p6.m2" class="ltx_Math" alttext="cb^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><annotation encoding="application/x-tex">cb^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}</annotation></semantics></math> is the dominating term in the numerator.</span></p>
</div>
<div id="A7.SS5.p7" class="ltx_para">
<p id="A7.SS5.p7.1" class="ltx_p"><span id="A7.SS5.p7.1.1" class="ltx_text">We can further get</span></p>
<table id="A7.EGx116" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex242"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex242.m1" class="ltx_Math" alttext="\displaystyle\int_{1}^{m+1}\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{x+y}}{\log n}\right)}\,\mathrm{d}x\,\mathrm{d}y\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\int_{1}^{m+1}\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{o\left(\frac{b^{2}\left(1+\epsilon\right)^{x+y}}{\log n}\right)}\,\mathrm{d}x\,\mathrm{d}y\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex242.m2" class="ltx_Math" alttext="\displaystyle~\int_{1}^{m+1}O\left(\frac{b^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}}{c\log^{2}\left(n\right)\log\left({\epsilon}+1\right)}\right)\,\mathrm{d}y" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mrow><mi>c</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo>(</mo><mi>n</mi><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\int_{1}^{m+1}O\left(\frac{b^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}}{c\log^{2}\left(n\right)\log\left({\epsilon}+1\right)}\right)\,\mathrm{d}y</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
