<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
</div>
<div id="A9.SS5.p5" class="ltx_para">
<p id="A9.SS5.p5.1" class="ltx_p"><span id="A9.SS5.p5.1.1" class="ltx_text">Considering the first term <math id="A9.SS5.p5.m1" class="ltx_Math" alttext="\left\|D^{-1}AV-D^{-1}\widetilde{A}V\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\left\|D^{-1}AV-D^{-1}\widetilde{A}V\right\|_{\infty}</annotation></semantics></math>, we have</span></p>
<table id="A9.EGx181" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex356"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex356.m1" class="ltx_Math" alttext="\displaystyle\left\|D^{-1}AV-D^{-1}\widetilde{A}V\right\|_{\infty}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|D^{-1}AV-D^{-1}\widetilde{A}V\right\|_{\infty}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex356.m2" class="ltx_Math" alttext="\displaystyle~\left\|D^{-1}\left(A-\widetilde{A}\right)V\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo>−</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\left\|D^{-1}\left(A-\widetilde{A}\right)V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex357"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex357.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex357.m2" class="ltx_Math" alttext="\displaystyle~n\left\|D^{-1}\left(A-\widetilde{A}\right)\right\|_{\infty}\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo>−</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~n\left\|D^{-1}\left(A-\widetilde{A}\right)\right\|_{\infty}\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex358"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex358.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex358.m2" class="ltx_Math" alttext="\displaystyle~n\left\|D^{-1}\right\|_{\infty}\left\|A-\widetilde{A}\right\|_{\infty}\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>A</mi><mo>−</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~n\left\|D^{-1}\right\|_{\infty}\left\|A-\widetilde{A}\right\|_{\infty}\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E43.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E43.m2" class="ltx_Math" alttext="\displaystyle~n\left\|D^{-1}\right\|_{\infty}\epsilon_{2}\left\|V\right\|_{\infty}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~n\left\|D^{-1}\right\|_{\infty}\epsilon_{2}\left\|V\right\|_{\infty},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
<p id="A9.SS5.p5.2" class="ltx_p"><span id="A9.SS5.p5.2.1" class="ltx_text">where the second step follows from the definition of inner product, the third step follows from the fact that <math id="A9.SS5.p5.m2" class="ltx_Math" alttext="D^{-1}" display="inline" intent=":literal"><semantics><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">D^{-1}</annotation></semantics></math> is a diagonal matrix, and the last step follows from Lemma <a href="#A9.Thmtheorem2" title="Lemma I.2 ((𝑄,𝐾)-Softmax-Attention Matrix Approximation). ‣ I.2 (𝑄,𝐾)-Softmax-Attention Matrix Approximation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.2</span></a>.</span></p>
</div>
<div id="A9.SS5.p6" class="ltx_para">
<p id="A9.SS5.p6.1" class="ltx_p"><span id="A9.SS5.p6.1.1" class="ltx_text">Now, we consider <math id="A9.SS5.p6.m1" class="ltx_Math" alttext="\left\|D^{-1}\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\left\|D^{-1}\right\|_{\infty}</annotation></semantics></math>: we have</span></p>
<table id="A9.EGx182" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex359"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex359.m1" class="ltx_Math" alttext="\displaystyle\left\|D^{-1}\right\|_{\infty}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|D^{-1}\right\|_{\infty}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex359.m2" class="ltx_Math" alttext="\displaystyle~\max_{i}\frac{1}{D_{i,i}}" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mi>i</mi></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>D</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle~\max_{i}\frac{1}{D_{i,i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex360"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex360.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex360.m2" class="ltx_Math" alttext="\displaystyle~\frac{1}{\min_{i}D_{i,i}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>D</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle~\frac{1}{\min_{i}D_{i,i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex361"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex361.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex361.m2" class="ltx_Math" alttext="\displaystyle~\frac{1}{\min_{i}\left(\exp(QK^{\top}/d)\cdot\mathbf{1}_{n}\right)_{i}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>min</mi><mi>i</mi></msub><mo>⁡</mo><msub><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow><mo>)</mo></mrow><mi>i</mi></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle~\frac{1}{\min_{i}\left(\exp(QK^{\top}/d)\cdot\mathbf{1}_{n}\right)_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex362"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex362.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex362.m2" class="ltx_Math" alttext="\displaystyle~\frac{1}{\min_{i}\sum_{j=1}^{n}\exp\left(\frac{\langle q_{i},k_{j}\rangle}{d}\right)}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>min</mi><mo>⁡</mo><mrow><mmultiscripts><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi><mprescripts></mprescripts><mi>i</mi><mrow></mrow></mmultiscripts><mo>⁡</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>,</mo><msub><mi>k</mi><mi>j</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle~\frac{1}{\min_{i}\sum_{j=1}^{n}\exp\left(\frac{\langle q_{i},k_{j}\rangle}{d}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex363"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex363.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex363.m2" class="ltx_Math" alttext="\displaystyle~\frac{1}{n\cdot\min_{i,j}\exp\left(\frac{\langle q_{i},k_{j}\rangle}{d}\right)}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><msub><mi>min</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0.167em">⁡</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>,</mo><msub><mi>k</mi><mi>j</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle~\frac{1}{n\cdot\min_{i,j}\exp\left(\frac{\langle q_{i},k_{j}\rangle}{d}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E44.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E44.m2" class="ltx_Math" alttext="\displaystyle~\frac{1}{n\cdot\exp(b^{2})}," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{1}{n\cdot\exp(b^{2})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
</table>
<p id="A9.SS5.p6.2" class="ltx_p"><span id="A9.SS5.p6.2.1" class="ltx_text">where the first step follows from the fact that <math id="A9.SS5.p6.m2" class="ltx_Math" alttext="D^{-1}" display="inline" intent=":literal"><semantics><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">D^{-1}</annotation></semantics></math> is a diagonal matrix, the third and fourth steps follow from Definition <a href="#S1.Thmtheorem2" title="Definition 1.2 (The exact attention computation). ‣ 1.1 Problem Formulation ‣ 1 INTRODUCTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a>, and the last step follows from Definition <a href="#A9.Thmtheorem1" title="Definition I.1. ‣ I.1 A Basic Definition ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.1</span></a>.</span></p>
</div>
<div id="A9.SS5.p7" class="ltx_para">
<p id="A9.SS5.p7.1" class="ltx_p"><span id="A9.SS5.p7.1.1" class="ltx_text">Combining Eq. (<a href="#A9.Ex356" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>) and Eq. (<a href="#A9.Ex359" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>), we can get</span></p>
<table id="A9.EGx183" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E45.m1" class="ltx_Math" alttext="\displaystyle\left\|D^{-1}AV-D^{-1}\widetilde{A}V\right\|_{\infty}\leq\frac{\epsilon_{2}\left\|V\right\|_{\infty}}{\exp\left(b^{2}\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ϵ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>b</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|D^{-1}AV-D^{-1}\widetilde{A}V\right\|_{\infty}\leq\frac{\epsilon_{2}\left\|V\right\|_{\infty}}{\exp\left(b^{2}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
</div>
<div id="A9.SS5.p8" class="ltx_para">
<p id="A9.SS5.p8.1" class="ltx_p"><span id="A9.SS5.p8.1.1" class="ltx_text">Considering the second term <math id="A9.SS5.p8.m1" class="ltx_Math" alttext="\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}</annotation></semantics></math>: we have</span></p>
<table id="A9.EGx184" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex364"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex364.m1" class="ltx_Math" alttext="\displaystyle\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex364.m2" class="ltx_Math" alttext="\displaystyle~\left\|\left(D^{-1}-\widetilde{D}^{-1}\right)\widetilde{A}V\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\left\|\left(D^{-1}-\widetilde{D}^{-1}\right)\widetilde{A}V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex365"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex365.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex365.m2" class="ltx_Math" alttext="\displaystyle~n\cdot\left\|D^{-1}-\widetilde{D}^{-1}\right\|_{\infty}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="0.055em">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo rspace="0.055em">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~n\cdot\left\|D^{-1}-\widetilde{D}^{-1}\right\|_{\infty}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex366"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex366.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex366.m2" class="ltx_Math" alttext="\displaystyle~n\cdot\max_{i}\left|\frac{1}{D_{i,i}}-\frac{1}{\widetilde{D}_{i,i}}\right|\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><munder><mi>max</mi><mi>i</mi></munder><mo>⁡</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>D</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub></mfrac></mstyle></mrow><mo rspace="0.055em">|</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo rspace="0.055em">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~n\cdot\max_{i}\left|\frac{1}{D_{i,i}}-\frac{1}{\widetilde{D}_{i,i}}\right|\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex367"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex367.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex367.m2" class="ltx_Math" alttext="\displaystyle~n\cdot\max_{i}\left|\frac{D_{i,i}-\widetilde{D}_{i,i}}{D_{i,i}\cdot\widetilde{D}_{i,i}}\right|\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><munder><mi>max</mi><mi>i</mi></munder><mo>⁡</mo><mrow><mo>|</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>D</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><msub><mi>D</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle><mo rspace="0.055em">|</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo rspace="0.055em">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~n\cdot\max_{i}\left|\frac{D_{i,i}-\widetilde{D}_{i,i}}{D_{i,i}\cdot\widetilde{D}_{i,i}}\right|\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex368"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex368.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex368.m2" class="ltx_Math" alttext="\displaystyle~\frac{n\cdot\|D-\widetilde{D}\|_{\infty}}{\min_{i}D_{i,i}\cdot\min_{i}\widetilde{D}_{i,i}}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>D</mi><mo>−</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mrow><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>D</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><msub><mi>min</mi><mi>i</mi></msub><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo rspace="0.055em">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{n\cdot\|D-\widetilde{D}\|_{\infty}}{\min_{i}D_{i,i}\cdot\min_{i}\widetilde{D}_{i,i}}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E46.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E46.m2" class="ltx_Math" alttext="\displaystyle~\frac{n\cdot\|D-\widetilde{D}\|_{\infty}}{(n\cdot\exp(b^{2}))^{2}}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>D</mi><mo>−</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo rspace="0.055em">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{n\cdot\|D-\widetilde{D}\|_{\infty}}{(n\cdot\exp(b^{2}))^{2}}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
<p id="A9.SS5.p8.2" class="ltx_p"><span id="A9.SS5.p8.2.1" class="ltx_text">where the second step follows from the definition of inner product and <math id="A9.SS5.p8.m2" class="ltx_Math" alttext="D^{-1}" display="inline" intent=":literal"><semantics><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">D^{-1}</annotation></semantics></math> is a diagonal matrix, the third step follows from the definition of <math id="A9.SS5.p8.m3" class="ltx_Math" alttext="\ell_{\infty}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\ell_{\infty}</annotation></semantics></math> norm, and the sixth step follows from Eq. (<a href="#A9.Ex359" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>).</span></p>
</div>
<div id="A9.SS5.p9" class="ltx_para">
<p id="A9.SS5.p9.1" class="ltx_p"><span id="A9.SS5.p9.1.1" class="ltx_text">Note that</span></p>
<table id="A9.EGx185" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex369"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex369.m1" class="ltx_Math" alttext="\displaystyle\left\|D-\widetilde{D}\right\|_{\infty}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>D</mi><mo>−</mo><mover accent="true"><mi>D</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|D-\widetilde{D}\right\|_{\infty}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex369.m2" class="ltx_Math" alttext="\displaystyle~\left\|\diag(A{\bf 1}_{n})-\diag(\widetilde{A}{\bf 1}_{n})\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\left\|\diag(A{\bf 1}_{n})-\diag(\widetilde{A}{\bf 1}_{n})\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex370"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex370.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex370.m2" class="ltx_Math" alttext="\displaystyle~\left\|\left(A-\widetilde{A}\right){\bf 1}_{n}\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><mi>A</mi><mo>−</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\left\|\left(A-\widetilde{A}\right){\bf 1}_{n}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex371"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex371.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex371.m2" class="ltx_Math" alttext="\displaystyle~n\left\|A-\widetilde{A}\right\|_{\infty}\left\|{\bf 1}_{n}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>A</mi><mo>−</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mn>𝟏</mn><mi>n</mi></msub><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~n\left\|A-\widetilde{A}\right\|_{\infty}\left\|{\bf 1}_{n}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E47.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E47.m2" class="ltx_Math" alttext="\displaystyle~n\left\|A-\widetilde{A}\right\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>A</mi><mo>−</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~n\left\|A-\widetilde{A}\right\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
</table>
</div>
<div id="A9.SS5.p10" class="ltx_para">
<p id="A9.SS5.p10.1" class="ltx_p"><span id="A9.SS5.p10.1.1" class="ltx_text">Combining Eq. (<a href="#A9.Ex369" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">47</span></a>) and Eq. (<a href="#A9.Ex364" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a>), we have</span></p>
<table id="A9.EGx186" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex372"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex372.m1" class="ltx_Math" alttext="\displaystyle\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex372.m2" class="ltx_Math" alttext="\displaystyle~\frac{n^{2}\cdot\|A-\widetilde{A}\|_{\infty}}{(n\cdot\exp(b^{2}))^{2}}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>A</mi><mo>−</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo rspace="0.055em">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{n^{2}\cdot\|A-\widetilde{A}\|_{\infty}}{(n\cdot\exp(b^{2}))^{2}}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E48.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E48.m2" class="ltx_Math" alttext="\displaystyle~\frac{\|A-\widetilde{A}\|_{\infty}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}}{\exp(2b^{2})}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>A</mi><mo>−</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo rspace="0.055em">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{\|A-\widetilde{A}\|_{\infty}\cdot\left\|\widetilde{A}\right\|_{\infty}\cdot\left\|V\right\|_{\infty}}{\exp(2b^{2})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
</div>
<div id="A9.SS5.p11" class="ltx_para">
<p id="A9.SS5.p11.1" class="ltx_p"><span id="A9.SS5.p11.1.1" class="ltx_text">Additionally, combining the reverse triangle inequality (see Fact <a href="#A10.Thmtheorem3" title="Fact J.3. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a>) and Lemma <a href="#A9.Thmtheorem2" title="Lemma I.2 ((𝑄,𝐾)-Softmax-Attention Matrix Approximation). ‣ I.2 (𝑄,𝐾)-Softmax-Attention Matrix Approximation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.2</span></a>, we have</span></p>
<table id="A9.EGx187" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E49.m1" class="ltx_Math" alttext="\displaystyle\|\widetilde{A}\|_{\infty}\leq\|A\|_{\infty}+\epsilon_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>A</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><msub><mi>ϵ</mi><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\widetilde{A}\|_{\infty}\leq\|A\|_{\infty}+\epsilon_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
</div>
<div id="A9.SS5.p12" class="ltx_para">
<p id="A9.SS5.p12.1" class="ltx_p"><span id="A9.SS5.p12.1.1" class="ltx_text">In particular, considering <math id="A9.SS5.p12.m1" class="ltx_Math" alttext="\|A\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mi>A</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\|A\|_{\infty}</annotation></semantics></math>, we note that</span></p>
<table id="A9.EGx188" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex373"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex373.m1" class="ltx_Math" alttext="\displaystyle\|A\|_{\infty}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>A</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\|A\|_{\infty}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex373.m2" class="ltx_Math" alttext="\displaystyle~\|\exp(QK^{\top}/d)\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\|\exp(QK^{\top}/d)\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex374"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex374.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex374.m2" class="ltx_Math" alttext="\displaystyle~\exp(\|QK^{\top}\|_{\infty}/d)" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\exp(\|QK^{\top}\|_{\infty}/d)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E50.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E50.m2" class="ltx_Math" alttext="\displaystyle~\exp(B^{2})," display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>B</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\exp(B^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A9.SS5.p12.2" class="ltx_p"><span id="A9.SS5.p12.2.1" class="ltx_text">where the first step follows from Definition <a href="#S1.Thmtheorem2" title="Definition 1.2 (The exact attention computation). ‣ 1.1 Problem Formulation ‣ 1 INTRODUCTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a> and the second step follows from the definition of inner product.</span></p>
</div>
<div id="A9.SS5.p13" class="ltx_para">
<p id="A9.SS5.p13.1" class="ltx_p"><span id="A9.SS5.p13.1.1" class="ltx_text">Combining Eq. (<a href="#A9.Ex372" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a>), Eq. (<a href="#A9.E49" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">49</span></a>), Eq. (<a href="#A9.Ex373" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">50</span></a>), and Lemma <a href="#A9.Thmtheorem2" title="Lemma I.2 ((𝑄,𝐾)-Softmax-Attention Matrix Approximation). ‣ I.2 (𝑄,𝐾)-Softmax-Attention Matrix Approximation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.2</span></a>, we have</span></p>
<table id="A9.EGx189" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E51.m1" class="ltx_Math" alttext="\displaystyle\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}\lesssim\epsilon_{2}\exp(B^{2}-2b^{2})\cdot\left\|V\right\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><mrow><mrow><msub><mi>ϵ</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}\lesssim\epsilon_{2}\exp(B^{2}-2b^{2})\cdot\left\|V\right\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
</div>
<div id="A9.SS5.p14" class="ltx_para">
<p id="A9.SS5.p14.1" class="ltx_p"><span id="A9.SS5.p14.1.1" class="ltx_text">Combining Eq. (<a href="#A9.Ex355" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>), Eq. (<a href="#A9.E45" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>), and Eq. (<a href="#A9.E51" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">51</span></a>), we have</span></p>
<table id="A9.EGx190" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex375"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex375.m1" class="ltx_Math" alttext="\displaystyle\left\|D^{-1}AV-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}\lesssim\epsilon_{2}\exp(B^{2}-2b^{2})\cdot\left\|V\right\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><mrow><mrow><msub><mi>ϵ</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|D^{-1}AV-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}\lesssim\epsilon_{2}\exp(B^{2}-2b^{2})\cdot\left\|V\right\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.SS5.p15" class="ltx_para">
<p id="A9.SS5.p15.1" class="ltx_p"><span id="A9.SS5.p15.1.1" class="ltx_text ltx_font_bold">Proof of Running time.<span id="A9.SS5.p15.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A9.SS5.p16" class="ltx_para">
<p id="A9.SS5.p16.1" class="ltx_p"><span id="A9.SS5.p16.1.1" class="ltx_text">Our goal is to compute <math id="A9.SS5.p16.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> (see Eq. (<a href="#A9.E40" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>) and Eq. (<a href="#A9.E41" title="In Proof. ‣ I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>)).</span></p>
</div>
<div id="A9.SS5.p17" class="ltx_para">
<p id="A9.SS5.p17.1" class="ltx_p"><span id="A9.SS5.p17.1.1" class="ltx_text">By Lemma <a href="#A9.Thmtheorem3" title="Lemma I.3. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.3</span></a>, we have shown that it takes</span></p>
<table id="A9.EGx191" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex376"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex376.m1" class="ltx_Math" alttext="\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS5.p17.2" class="ltx_p"><span id="A9.SS5.p17.2.1" class="ltx_text">time to construct <math id="A9.SS5.p17.m1" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math> and <math id="A9.SS5.p17.m2" class="ltx_Math" alttext="\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math>, for all <math id="A9.SS5.p17.m3" class="ltx_Math" alttext="(\ell,\ell^{\prime})\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\ell,\ell^{\prime})\in[m]\times[m]</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS5.p18" class="ltx_para">
<p id="A9.SS5.p18.1" class="ltx_p"><span id="A9.SS5.p18.1.1" class="ltx_text">By Lemma <a href="#A9.Thmtheorem4" title="Lemma I.4. ‣ I.4 (Batch) Gaussian Kernel Density Estimation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.4</span></a>, we have shown that it takes</span></p>
<table id="A9.EGx192" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex377"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex377.m1" class="ltx_Math" alttext="\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS5.p18.2" class="ltx_p"><span id="A9.SS5.p18.2.1" class="ltx_text">time to compute</span></p>
<table id="A9.EGx193" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex378"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex378.m1" class="ltx_Math" alttext="\displaystyle\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}V}_{z^{2}\times d}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></munder><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></munder><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}V}_{z^{2}\times d}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS5.p18.3" class="ltx_p"><span id="A9.SS5.p18.3.1" class="ltx_text">and</span></p>
<table id="A9.EGx194" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex379"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex379.m1" class="ltx_Math" alttext="\displaystyle\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{V}_{n\times d}," display="inline" intent=":literal"><semantics><mrow><mrow><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mi>V</mi><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></munder></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{V}_{n\times d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS5.p18.4" class="ltx_p"><span id="A9.SS5.p18.4.1" class="ltx_text">for all <math id="A9.SS5.p18.m1" class="ltx_Math" alttext="\left(\ell,\ell^{\prime}\right)\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\ell,\ell^{\prime}\right)\in[m]\times[m]</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS5.p19" class="ltx_para">
<p id="A9.SS5.p19.1" class="ltx_p"><span id="A9.SS5.p19.1.1" class="ltx_text">Similarly, it also takes <math id="A9.SS5.p19.m1" class="ltx_Math" alttext="O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math> time to compute</span></p>
<table id="A9.EGx195" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex380"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex380.m1" class="ltx_Math" alttext="\displaystyle\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}{\bf 1}_{n}}_{z^{2}\times 1}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></munder><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></munder><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}{\bf 1}_{n}}_{z^{2}\times 1}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS5.p19.2" class="ltx_p"><span id="A9.SS5.p19.2.1" class="ltx_text">and</span></p>
<table id="A9.EGx196" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex381"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex381.m1" class="ltx_Math" alttext="\displaystyle\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{{\bf 1}_{n}}_{n\times 1}," display="inline" intent=":literal"><semantics><mrow><mrow><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><msub><mn>𝟏</mn><mi>n</mi></msub><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></munder></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{{\bf 1}_{n}}_{n\times 1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS5.p19.3" class="ltx_p"><span id="A9.SS5.p19.3.1" class="ltx_text">for all <math id="A9.SS5.p19.m2" class="ltx_Math" alttext="\left(\ell,\ell^{\prime}\right)\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\ell,\ell^{\prime}\right)\in[m]\times[m]</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS5.p20" class="ltx_para">
<p id="A9.SS5.p20.1" class="ltx_p"><span id="A9.SS5.p20.1.1" class="ltx_text">This implies that we can compute</span></p>
<table id="A9.EGx197" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex382"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex382.m1" class="ltx_Math" alttext="\displaystyle\widetilde{D}^{-1}=" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{D}^{-1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex382.m2" class="ltx_Math" alttext="\displaystyle~\diag\left(\widetilde{A}{\bf 1}_{n}\right)^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>diag</mi><mo>⁡</mo><msup><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle~\diag\left(\widetilde{A}{\bf 1}_{n}\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex383"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex383.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex383.m2" class="ltx_Math" alttext="\displaystyle~\diag\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}{\bf 1}_{n}\right)^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>diag</mi><mo>⁡</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle~\diag\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}{\bf 1}_{n}\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS5.p20.2" class="ltx_p"><span id="A9.SS5.p20.2.1" class="ltx_text">in <math id="A9.SS5.p20.m1" class="ltx_Math" alttext="O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math> time.</span></p>
</div>
<div id="A9.SS5.p21" class="ltx_para">
<p id="A9.SS5.p21.1" class="ltx_p"><span id="A9.SS5.p21.1.1" class="ltx_text">Finally, as <math id="A9.SS5.p21.m1" class="ltx_Math" alttext="\widetilde{D}^{-1}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\widetilde{D}^{-1}</annotation></semantics></math> is a diagonal matrix, computing</span></p>
<table id="A9.EGx198" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex384"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex384.m1" class="ltx_Math" alttext="\displaystyle P=\widetilde{D}^{-1}\widetilde{A}V=\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\underbrace{\widetilde{D}^{-1}}_{n\times n}\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\right)\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{V}_{n\times d}\right)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><mrow><munder><munder accentunder="true"><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></munder></mrow><mo rspace="0.055em">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mi>V</mi><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></munder></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P=\widetilde{D}^{-1}\widetilde{A}V=\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\underbrace{\widetilde{D}^{-1}}_{n\times n}\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\right)\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{V}_{n\times d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS5.p21.2" class="ltx_p"><span id="A9.SS5.p21.2.1" class="ltx_text">takes <math id="A9.SS5.p21.m2" class="ltx_Math" alttext="O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math> time.</span></p>
</div>
<div id="A9.SS5.p22" class="ltx_para">
<p id="A9.SS5.p22.1" class="ltx_p"><span id="A9.SS5.p22.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A10" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix J </span>MORE FACTS</h2>

<div id="A10.p1" class="ltx_para">
<p id="A10.p1.1" class="ltx_p">In this section, we present basic mathematical properties that support our theoretical proofs.</p>
</div>
<div id="A10.Thmtheorem1" class="ltx_theorem ltx_theorem_fact">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem1.2" class="ltx_text ltx_font_bold">Fact J.1</span></span><span id="A10.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem1.p1" class="ltx_para">
<p id="A10.Thmtheorem1.p1.1" class="ltx_p"><span id="A10.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A10.Thmtheorem1.p1.m1" class="ltx_Math" alttext="A,B\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>,</mo><mi>B</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A,B\in\mathbb{R}^{n\times n}</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem1.p2" class="ltx_para">
<p id="A10.Thmtheorem1.p2.1" class="ltx_p"><span id="A10.Thmtheorem1.p2.1.1" class="ltx_text ltx_font_italic">Then, we have</span></p>
<table id="A10.EGx199" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex385"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex385.m1" class="ltx_Math" alttext="\displaystyle|\mathrm{supp}\left(A+B\right)|\leq|\mathrm{supp}\left(A\right)|+|\mathrm{supp}\left(B\right)|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\mathrm{supp}\left(A+B\right)|\leq|\mathrm{supp}\left(A\right)|+|\mathrm{supp}\left(B\right)|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A10.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.p2" class="ltx_para">
<p id="A10.p2.1" class="ltx_p"><span id="A10.p2.1.1" class="ltx_text">It suffices to show that</span></p>
<table id="A10.EGx200" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E52.m1" class="ltx_Math" alttext="\displaystyle\mathrm{supp}\left(A+B\right)\subseteq\mathrm{supp}\left(A\right)\cup\mathrm{supp}\left(B\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><mo>⊆</mo><mrow><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>∪</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{supp}\left(A+B\right)\subseteq\mathrm{supp}\left(A\right)\cup\mathrm{supp}\left(B\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
</div>
<div id="A10.p3" class="ltx_para">
<p id="A10.p3.1" class="ltx_p"><span id="A10.p3.1.1" class="ltx_text">Suppose <math id="A10.p3.m1" class="ltx_Math" alttext="\left(i,j\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(i,j\right)</annotation></semantics></math> is an arbitrary element in <math id="A10.p3.m2" class="ltx_Math" alttext="\mathrm{supp}\left(A+B\right)" display="inline" intent=":literal"><semantics><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{supp}\left(A+B\right)</annotation></semantics></math>.</span></p>
</div>
<div id="A10.p4" class="ltx_para">
<p id="A10.p4.1" class="ltx_p"><span id="A10.p4.1.1" class="ltx_text">Then, we have <math id="A10.p4.m1" class="ltx_Math" alttext="\left(A+B\right)_{i,j}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>(</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left(A+B\right)_{i,j}\neq 0</annotation></semantics></math>.</span></p>
</div>
<div id="A10.p5" class="ltx_para">
<p id="A10.p5.1" class="ltx_p"><span id="A10.p5.1.1" class="ltx_text">Note that by the basic definition of matrix addition, we have</span></p>
<table id="A10.EGx201" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex386"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex386.m1" class="ltx_Math" alttext="\displaystyle\left(A+B\right)_{i,j}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>(</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left(A+B\right)_{i,j}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex386.m2" class="ltx_Math" alttext="\displaystyle~A_{i,j}+B_{i,j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>+</mo><msub><mi>B</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle~A_{i,j}+B_{i,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A10.Ex387"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex387.m1" class="ltx_Math" alttext="\displaystyle\neq" display="inline" intent=":literal"><semantics><mo>≠</mo><annotation encoding="application/x-tex">\displaystyle\neq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex387.m2" class="ltx_Math" alttext="\displaystyle~0," display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.p5.2" class="ltx_p"><span id="A10.p5.2.1" class="ltx_text">which implies that either <math id="A10.p5.m1" class="ltx_Math" alttext="A_{i,j}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A_{i,j}\neq 0</annotation></semantics></math> or <math id="A10.p5.m2" class="ltx_Math" alttext="B_{i,j}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{i,j}\neq 0</annotation></semantics></math>.</span></p>
</div>
<div id="A10.p6" class="ltx_para">
<p id="A10.p6.1" class="ltx_p"><span id="A10.p6.1.1" class="ltx_text">Therefore, <math id="A10.p6.m1" class="ltx_Math" alttext="\left(i,j\right)\in\mathrm{supp}\left(A\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow><mo>∈</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(i,j\right)\in\mathrm{supp}\left(A\right)</annotation></semantics></math> or <math id="A10.p6.m2" class="ltx_Math" alttext="\left(i,j\right)\in\mathrm{supp}\left(B\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow><mo>∈</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(i,j\right)\in\mathrm{supp}\left(B\right)</annotation></semantics></math>, which completes the proof of Eq. (<a href="#A10.E52" title="In Proof. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">52</span></a>).
∎</span></p>
</div>
</div>
<div id="A10.Thmtheorem2" class="ltx_theorem ltx_theorem_fact">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem2.2" class="ltx_text ltx_font_bold">Fact J.2</span></span><span id="A10.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem2.p1" class="ltx_para">
<p id="A10.Thmtheorem2.p1.1" class="ltx_p"><span id="A10.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A10.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\{A^{(\ell,\ell^{\prime})}\}_{\ell,\ell^{\prime}\in[m]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{A^{(\ell,\ell^{\prime})}\}_{\ell,\ell^{\prime}\in[m]}</annotation></semantics></math> be a collection of <math id="A10.Thmtheorem2.p1.m2" class="ltx_Math" alttext="n\times n" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n\times n</annotation></semantics></math> matrices forming a support basis of <math id="A10.Thmtheorem2.p1.m3" class="ltx_Math" alttext="A\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A\in\mathbb{R}^{n\times n}</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem2.p2" class="ltx_para">
<p id="A10.Thmtheorem2.p2.1" class="ltx_p"><span id="A10.Thmtheorem2.p2.1.1" class="ltx_text ltx_font_italic">Then, we have</span></p>
<table id="A10.Ex388" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex388.m1" class="ltx_Math" alttext="\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{(\ell,\ell^{\prime})}\right)\right|=\left|\supp(A)\right|\leq n^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><munderover><mo lspace="0.167em" movablelimits="false" rspace="0em">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left|\supp\left(A^{(\ell,\ell^{\prime})}\right)\right|=\left|\supp(A)\right|\leq n^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A10.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.p7" class="ltx_para">
<p id="A10.p7.1" class="ltx_p"><span id="A10.p7.1.1" class="ltx_text">By the definition of support basis (see Definition <a href="#A2.Thmtheorem5" title="Definition B.5 (Support basis). ‣ B.2 Support Basis ‣ Appendix B (BATCH) GAUSSIAN KERNEL DENSITY ESTIMATION VIA SINGLE THRESHOLD SUPPORT BASIS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>), we know that <math id="A10.p7.m1" class="ltx_Math" alttext="A^{(\ell,\ell^{\prime})}" display="inline" intent=":literal"><semantics><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">A^{(\ell,\ell^{\prime})}</annotation></semantics></math>’s are disjoint matrices (Definition <a href="#A2.Thmtheorem1" title="Definition B.1 (Disjoint matrices). ‣ B.1 Disjoint Matrices and Their Properties ‣ Appendix B (BATCH) GAUSSIAN KERNEL DENSITY ESTIMATION VIA SINGLE THRESHOLD SUPPORT BASIS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>).</span></p>
</div>
<div id="A10.p8" class="ltx_para">
<p id="A10.p8.1" class="ltx_p"><span id="A10.p8.1.1" class="ltx_text">Therefore, we have</span></p>
<table id="A10.EGx202" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex389"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex389.m1" class="ltx_Math" alttext="\displaystyle\supp\left(A\right)=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\supp\left(A\right)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex389.m2" class="ltx_Math" alttext="\displaystyle~\supp\left(\sum_{\ell,\ell^{\prime}}A^{(\ell,\ell^{\prime})}\right)" display="inline" intent=":literal"><semantics><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></munder></mstyle><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\supp\left(\sum_{\ell,\ell^{\prime}}A^{(\ell,\ell^{\prime})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A10.Ex390"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex390.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex390.m2" class="ltx_Math" alttext="\displaystyle~\bigcup_{\ell,\ell^{\prime}}\supp\left(A^{(\ell,\ell^{\prime})}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">⋃</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></munder></mstyle><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\bigcup_{\ell,\ell^{\prime}}\supp\left(A^{(\ell,\ell^{\prime})}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.p9" class="ltx_para">
<p id="A10.p9.1" class="ltx_p"><span id="A10.p9.1.1" class="ltx_text">Thus, we can further get</span></p>
<table id="A10.EGx203" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex391"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex391.m1" class="ltx_Math" alttext="\displaystyle\left|\supp\left(A\right)\right|=" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left|\supp\left(A\right)\right|=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex391.m2" class="ltx_Math" alttext="\displaystyle~\left|\bigcup_{\ell,\ell^{\prime}}\supp\left(A^{(\ell,\ell^{\prime})}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">⋃</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></munder></mstyle><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\left|\bigcup_{\ell,\ell^{\prime}}\supp\left(A^{(\ell,\ell^{\prime})}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A10.Ex392"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex392.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex392.m2" class="ltx_Math" alttext="\displaystyle~\sum_{\ell,\ell^{\prime}}\left|\supp\left(A^{(\ell,\ell^{\prime})}\right)\right|." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></munder></mstyle><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\sum_{\ell,\ell^{\prime}}\left|\supp\left(A^{(\ell,\ell^{\prime})}\right)\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.p10" class="ltx_para">
<p id="A10.p10.1" class="ltx_p"><span id="A10.p10.1.1" class="ltx_text">Finally, since <math id="A10.p10.m1" class="ltx_Math" alttext="A\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A\in\mathbb{R}^{n\times n}</annotation></semantics></math>, we can get that <math id="A10.p10.m2" class="ltx_Math" alttext="\left|\supp(A)\right|\leq n^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\left|\supp(A)\right|\leq n^{2}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A10.Thmtheorem3" class="ltx_theorem ltx_theorem_fact">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem3.2" class="ltx_text ltx_font_bold">Fact J.3</span></span><span id="A10.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem3.p1" class="ltx_para">
<p id="A10.Thmtheorem3.p1.1" class="ltx_p"><span id="A10.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A10.Thmtheorem3.p1.m1" class="ltx_Math" alttext="u,v\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">u,v\in\mathbb{R}^{n}</annotation></semantics></math>.</span></p>
</div>
<div id="A10.Thmtheorem3.p2" class="ltx_para">
<p id="A10.Thmtheorem3.p2.1" class="ltx_p"><span id="A10.Thmtheorem3.p2.1.1" class="ltx_text ltx_font_italic">Then, we have</span></p>
<ul id="A10.I1" class="ltx_itemize">
<li id="A10.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A10.I1.i1.p1" class="ltx_para">
<p id="A10.I1.i1.p1.1" class="ltx_p"><math id="A10.I1.i1.p1.m1" class="ltx_Math" alttext="\left|\langle u,v\rangle\right|\leq\|u\|_{2}\cdot\|v\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo rspace="0.055em" stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\left|\langle u,v\rangle\right|\leq\|u\|_{2}\cdot\|v\|_{2}</annotation></semantics></math><span id="A10.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> (Cauchy–Schwarz inequality).</span></p>
</div></li>
<li id="A10.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A10.I1.i2.p1" class="ltx_para">
<p id="A10.I1.i2.p1.1" class="ltx_p"><math id="A10.I1.i2.p1.m1" class="ltx_Math" alttext="\|u\|_{2}\leq\|u\|_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\|u\|_{2}\leq\|u\|_{1}</annotation></semantics></math><span id="A10.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A10.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A10.I1.i3.p1" class="ltx_para">
<p id="A10.I1.i3.p1.1" class="ltx_p"><math id="A10.I1.i3.p1.m1" class="ltx_Math" alttext="\langle u,v\rangle=u^{\top}v" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">\langle u,v\rangle=u^{\top}v</annotation></semantics></math><span id="A10.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A10.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A10.I1.i4.p1" class="ltx_para">
<p id="A10.I1.i4.p1.1" class="ltx_p"><math id="A10.I1.i4.p1.m1" class="ltx_Math" alttext="\langle u,u\rangle=u^{\top}u=\|u\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>u</mi><mo>,</mo><mi>u</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\langle u,u\rangle=u^{\top}u=\|u\|_{2}^{2}</annotation></semantics></math><span id="A10.I1.i4.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A10.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A10.I1.i5.p1" class="ltx_para">
<p id="A10.I1.i5.p1.1" class="ltx_p"><math id="A10.I1.i5.p1.m1" class="ltx_Math" alttext="\|u+v\|_{2}\leq\|u\|_{2}+\|v\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|u+v\|_{2}\leq\|u\|_{2}+\|v\|_{2}</annotation></semantics></math><span id="A10.I1.i5.p1.1.1" class="ltx_text ltx_font_italic"> (triangle inequality).</span></p>
</div></li>
<li id="A10.I1.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A10.I1.i6.p1" class="ltx_para">
<p id="A10.I1.i6.p1.1" class="ltx_p"><math id="A10.I1.i6.p1.m1" class="ltx_Math" alttext="\left|\|u\|_{2}-\|v\|_{2}\right|\leq\|u-v\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo stretchy="false">‖</mo><mi>v</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\left|\|u\|_{2}-\|v\|_{2}\right|\leq\|u-v\|_{2}</annotation></semantics></math><span id="A10.I1.i6.p1.1.1" class="ltx_text ltx_font_italic"> (reverse triangle inequality).</span></p>
</div></li>
</ul>
<p id="A10.Thmtheorem3.p2.2" class="ltx_p"><span id="A10.Thmtheorem3.p2.2.1" class="ltx_text ltx_font_italic">The (reverse) triangle inequality holds in all metric spaces. In particular, it applies to <math id="A10.Thmtheorem3.p2.m1" class="ltx_math_unparsed" alttext="(\mathbb{R},|\cdot|)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ℝ</mi><mo>,</mo><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{R},|\cdot|)</annotation></semantics></math>, <math id="A10.Thmtheorem3.p2.m2" class="ltx_math_unparsed" alttext="(\mathbb{R}^{n\times d},\|\cdot\|_{p})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{R}^{n\times d},\|\cdot\|_{p})</annotation></semantics></math>, and <math id="A10.Thmtheorem3.p2.m3" class="ltx_math_unparsed" alttext="(\mathbb{R}^{n},\|\cdot\|_{p})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>ℝ</mi><mi>n</mi></msup><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{R}^{n},\|\cdot\|_{p})</annotation></semantics></math>, for all positive integers <math id="A10.Thmtheorem3.p2.m4" class="ltx_Math" alttext="n,d" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">n,d</annotation></semantics></math>, and <math id="A10.Thmtheorem3.p2.m5" class="ltx_Math" alttext="p\in\{1,2,\dots,\infty\}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">p\in\{1,2,\dots,\infty\}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A10.Thmtheorem4" class="ltx_theorem ltx_theorem_fact">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A10.Thmtheorem4.2" class="ltx_text ltx_font_bold">Fact J.4</span></span><span id="A10.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Integral analysis)<span id="A10.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A10.Thmtheorem4.p1" class="ltx_para">
<p id="A10.Thmtheorem4.p1.1" class="ltx_p"><span id="A10.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">We have</span></p>
<ul id="A10.I2" class="ltx_itemize">
<li id="A10.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A10.I2.i1.p1" class="ltx_para">
<p id="A10.I2.i1.p1.1" class="ltx_p"><span id="A10.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Part 1.</span><span id="A10.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> if </span><math id="A10.I2.i1.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math><span id="A10.I2.i1.p1.1.3" class="ltx_text ltx_font_italic"> is the variable, then</span></p>
<table id="A10.EGx204" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex393"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex393.m1" class="ltx_Math" alttext="\displaystyle~\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{\frac{cb^{2}\left(1+\epsilon\right)^{x+y}}{\log n}}\,\mathrm{d}x" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{\frac{cb^{2}\left(1+\epsilon\right)^{x+y}}{\log n}}\,\mathrm{d}x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A10.Ex394"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex394.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex394.m2" class="ltx_Math" alttext="\displaystyle~\frac{cb^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-cb^{2}\left(1+\epsilon\right)^{y+1}e^{b^{2}c(\epsilon+1)^{y+1}}-e^{b^{2}c(\epsilon+1)^{y+m+1}}+e^{b^{2}c(\epsilon+1)^{y+1}}}{c^{2}\log^{2}n\log(\epsilon+1)}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>−</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>+</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle~\frac{cb^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-cb^{2}\left(1+\epsilon\right)^{y+1}e^{b^{2}c(\epsilon+1)^{y+1}}-e^{b^{2}c(\epsilon+1)^{y+m+1}}+e^{b^{2}c(\epsilon+1)^{y+1}}}{c^{2}\log^{2}n\log(\epsilon+1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A10.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A10.I2.i2.p1" class="ltx_para">
<p id="A10.I2.i2.p1.1" class="ltx_p"><span id="A10.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Part 2.</span><span id="A10.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> if </span><math id="A10.I2.i2.p1.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math><span id="A10.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> is the variable, then</span></p>
<table id="A10.EGx205" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex395"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex395.m1" class="ltx_Math" alttext="\displaystyle\int_{1}^{m+1}\frac{b^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}}{c\log^{2}\left(n\right)\log\left({\epsilon}+1\right)}\,\mathrm{d}y=\frac{e^{b^{2}c(\epsilon+1)^{2m+2}}-e^{b^{2}c(\epsilon+1)^{m+2}}}{c^{2}\log^{2}(n)\log^{2}(\epsilon+1)}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mrow><mi>c</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo>(</mo><mi>n</mi><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow></msup></mrow></msup></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int_{1}^{m+1}\frac{b^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}}{c\log^{2}\left(n\right)\log\left({\epsilon}+1\right)}\,\mathrm{d}y=\frac{e^{b^{2}c(\epsilon+1)^{2m+2}}-e^{b^{2}c(\epsilon+1)^{m+2}}}{c^{2}\log^{2}(n)\log^{2}(\epsilon+1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
</div>
<div id="A10.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A10.p11" class="ltx_para">
<p id="A10.p11.1" class="ltx_p"><span id="A10.p11.1.1" class="ltx_text ltx_font_bold">Proof of Part 1.<span id="A10.p11.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A10.p12" class="ltx_para">
<p id="A10.p12.1" class="ltx_p"><span id="A10.p12.1.1" class="ltx_text">By the linearity of the integral, we have</span></p>
<table id="A10.EGx206" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E53.m1" class="ltx_Math" alttext="\displaystyle\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{\frac{cb^{2}\left(1+\epsilon\right)^{x+y}}{\log n}}\,\mathrm{d}x=\frac{b^{4}\left(1+\epsilon\right)^{2y}}{\log^{2}n}\int_{1}^{m+1}\left(1+\epsilon\right)^{2x}n^{\frac{cb^{2}\left(1+\epsilon\right)^{x+y}}{\log n}}\,\mathrm{d}x." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{\frac{cb^{2}\left(1+\epsilon\right)^{x+y}}{\log n}}\,\mathrm{d}x=\frac{b^{4}\left(1+\epsilon\right)^{2y}}{\log^{2}n}\int_{1}^{m+1}\left(1+\epsilon\right)^{2x}n^{\frac{cb^{2}\left(1+\epsilon\right)^{x+y}}{\log n}}\,\mathrm{d}x.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
</div>
<div id="A10.p13" class="ltx_para">
<p id="A10.p13.1" class="ltx_p"><span id="A10.p13.1.1" class="ltx_text">We can further get</span></p>
<table id="A10.EGx207" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex396"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex396.m1" class="ltx_Math" alttext="\displaystyle\int_{1}^{m+1}(\epsilon+1)^{2x}n^{\frac{b^{2}c(\epsilon+1)^{x+y}}{\log(n)}}\,\mathrm{d}x=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\int_{1}^{m+1}(\epsilon+1)^{2x}n^{\frac{b^{2}c(\epsilon+1)^{x+y}}{\log(n)}}\,\mathrm{d}x=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex396.m2" class="ltx_Math" alttext="\displaystyle~\int_{1}^{m+1}(\epsilon+1)^{x}\log(\epsilon+1)\cdot\frac{(\epsilon+1)^{x}e^{b^{2}c(\epsilon+1)^{x+y}}}{\log(\epsilon+1)}\,\mathrm{d}x" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>x</mi></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>x</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow></msup></mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\int_{1}^{m+1}(\epsilon+1)^{x}\log(\epsilon+1)\cdot\frac{(\epsilon+1)^{x}e^{b^{2}c(\epsilon+1)^{x+y}}}{\log(\epsilon+1)}\,\mathrm{d}x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.p14" class="ltx_para">
<p id="A10.p14.1" class="ltx_p"><span id="A10.p14.1.1" class="ltx_text">Now, we use <math id="A10.p14.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>-substitution by letting <math id="A10.p14.m2" class="ltx_Math" alttext="u=(\epsilon+1)^{x}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>x</mi></msup></mrow><annotation encoding="application/x-tex">u=(\epsilon+1)^{x}</annotation></semantics></math>, which implies that</span></p>
<table id="A10.EGx208" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex397"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex397.m1" class="ltx_Math" alttext="\displaystyle x=\frac{\log(u)}{\log(\epsilon+1)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle x=\frac{\log(u)}{\log(\epsilon+1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.p14.2" class="ltx_p"><span id="A10.p14.2.1" class="ltx_text">and</span></p>
<table id="A10.EGx209" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex398"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex398.m1" class="ltx_Math" alttext="\displaystyle\mathrm{d}x=\frac{1}{(\epsilon+1)^{x}\log(\epsilon+1)}\mathrm{d}u" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>x</mi></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{d}x=\frac{1}{(\epsilon+1)^{x}\log(\epsilon+1)}\mathrm{d}u</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.p15" class="ltx_para">
<p id="A10.p15.1" class="ltx_p"><span id="A10.p15.1.1" class="ltx_text">Therefore, we have</span></p>
<table id="A10.EGx210" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E54.m1" class="ltx_Math" alttext="\displaystyle\int_{1}^{m+1}(\epsilon+1)^{2x}n^{\frac{b^{2}c(\epsilon+1)^{x+y}}{\log(n)}}\,\mathrm{d}x=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\int_{1}^{m+1}(\epsilon+1)^{2x}n^{\frac{b^{2}c(\epsilon+1)^{x+y}}{\log(n)}}\,\mathrm{d}x=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E54.m2" class="ltx_Math" alttext="\displaystyle~\frac{1}{\log(\epsilon+1)}\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}ue^{b^{2}c(\epsilon+1)^{y}u}\,\mathrm{d}u" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></msubsup></mstyle><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{1}{\log(\epsilon+1)}\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}ue^{b^{2}c(\epsilon+1)^{y}u}\,\mathrm{d}u</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
</div>
<div id="A10.p16" class="ltx_para">
<p id="A10.p16.1" class="ltx_p"><span id="A10.p16.1.1" class="ltx_text">Now, we consider</span></p>
<table id="A10.Ex399" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex399.m1" class="ltx_Math" alttext="\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}ue^{b^{2}c(\epsilon+1)^{y}u}\,\mathrm{d}u" display="block" intent=":literal"><semantics><mrow><msubsup><mo>∫</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></msubsup><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}ue^{b^{2}c(\epsilon+1)^{y}u}\,\mathrm{d}u</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.p16.2" class="ltx_p"><span id="A10.p16.2.1" class="ltx_text">We use integration by parts, namely <math id="A10.p16.m1" class="ltx_Math" alttext="\int fg^{\prime}=fg-\int f^{\prime}g" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∫</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mo>′</mo></msup></mrow></mrow><mo>=</mo><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo rspace="0.055em">−</mo><mrow><mo>∫</mo><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\int fg^{\prime}=fg-\int f^{\prime}g</annotation></semantics></math>.</span></p>
</div>
<div id="A10.p17" class="ltx_para">
<p id="A10.p17.1" class="ltx_p"><span id="A10.p17.1.1" class="ltx_text">With</span></p>
<table id="A10.Ex400" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex400.m1" class="ltx_Math" alttext="f=u,\quad g^{\prime}=e^{b^{2}c(\epsilon+1)^{y}u}" display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>=</mo><mi>u</mi></mrow><mo rspace="1.167em">,</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>=</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f=u,\quad g^{\prime}=e^{b^{2}c(\epsilon+1)^{y}u}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A10.Ex401" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A10.Ex401.m1" class="ltx_Math" alttext="f^{\prime}=1,\quad g=\frac{e^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>f</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mi>g</mi><mo>=</mo><mfrac><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msup><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f^{\prime}=1,\quad g=\frac{e^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A10.p17.2" class="ltx_p"><span id="A10.p17.2.1" class="ltx_text">we have</span></p>
<table id="A10.EGx211" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex402"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex402.m2" class="ltx_Math" alttext="\displaystyle~\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}ue^{b^{2}c(\epsilon+1)^{y}u}\,\mathrm{d}u" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></msubsup></mstyle><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}ue^{b^{2}c(\epsilon+1)^{y}u}\,\mathrm{d}u</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A10.Ex403"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex403.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex403.m2" class="ltx_Math" alttext="\displaystyle~\left.\frac{ue^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}}\right|_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}-\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}\frac{e^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}}\,\mathrm{d}u" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msup></mrow><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup></mrow></mfrac></mstyle><mo>|</mo></mrow><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></msubsup><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msup><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\left.\frac{ue^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}}\right|_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}-\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}\frac{e^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}}\,\mathrm{d}u</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A10.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E55.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E55.m2" class="ltx_Math" alttext="\displaystyle~\left(\frac{\left(1+\epsilon\right)^{m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-\left(1+\epsilon\right)e^{b^{2}c(\epsilon+1)^{y+1}}}{b^{2}c(\epsilon+1)^{y}}\right)-\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}\frac{e^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}}\,\mathrm{d}u." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow></mrow><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msup><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\left(\frac{\left(1+\epsilon\right)^{m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-\left(1+\epsilon\right)e^{b^{2}c(\epsilon+1)^{y+1}}}{b^{2}c(\epsilon+1)^{y}}\right)-\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}\frac{e^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}}\,\mathrm{d}u.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
</table>
</div>
<div id="A10.p18" class="ltx_para">
<p id="A10.p18.1" class="ltx_p"><span id="A10.p18.1.1" class="ltx_text">We again use <math id="A10.p18.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>-substitution by letting <math id="A10.p18.m2" class="ltx_Math" alttext="v=b^{2}c(\epsilon+1)^{y}u" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>=</mo><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><annotation encoding="application/x-tex">v=b^{2}c(\epsilon+1)^{y}u</annotation></semantics></math> so that</span></p>
<table id="A10.EGx212" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex404"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex404.m1" class="ltx_Math" alttext="\displaystyle\mathrm{d}u=\frac{1}{b^{2}c(\epsilon+1)^{y}}\mathrm{d}v" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{d}u=\frac{1}{b^{2}c(\epsilon+1)^{y}}\mathrm{d}v</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A10.p19" class="ltx_para">
<p id="A10.p19.1" class="ltx_p"><span id="A10.p19.1.1" class="ltx_text">Therefore, we get</span></p>
<table id="A10.EGx213" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex405"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex405.m1" class="ltx_Math" alttext="\displaystyle\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}\frac{e^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}}\,\mathrm{d}u=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msup><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\int_{1+\epsilon}^{\left(1+\epsilon\right)^{m+1}}\frac{e^{b^{2}c(\epsilon+1)^{y}u}}{b^{2}c(\epsilon+1)^{y}}\,\mathrm{d}u=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex405.m2" class="ltx_Math" alttext="\displaystyle~\frac{1}{b^{4}c^{2}(\epsilon+1)^{2y}}\int_{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)}^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)^{m+1}}e^{v}\,\mathrm{d}v" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msubsup></mstyle><mrow><msup><mi>e</mi><mi>v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>v</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{1}{b^{4}c^{2}(\epsilon+1)^{2y}}\int_{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)}^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)^{m+1}}e^{v}\,\mathrm{d}v</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A10.E56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.E56.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.E56.m2" class="ltx_Math" alttext="\displaystyle~\frac{e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)^{m+1}}-e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)}}{b^{4}c^{2}(\epsilon+1)^{2y}}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow></msup></mrow><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)^{m+1}}-e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)}}{b^{4}c^{2}(\epsilon+1)^{2y}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
</div>
<div id="A10.p20" class="ltx_para">
<p id="A10.p20.1" class="ltx_p"><span id="A10.p20.1.1" class="ltx_text">Combining Eq. (<a href="#A10.E53" title="In Proof. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>), (<a href="#A10.E54" title="In Proof. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">54</span></a>), (<a href="#A10.Ex402" title="In Proof. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">55</span></a>), and (<a href="#A10.Ex405" title="In Proof. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">56</span></a>), we have</span></p>
<table id="A10.EGx214" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A10.Ex406"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex406.m1" class="ltx_Math" alttext="\displaystyle~\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{\frac{cb^{2}\left(1+\epsilon\right)^{x+y}}{\log n}}\,\mathrm{d}x" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\int_{1}^{m+1}\frac{b^{4}\left(1+\epsilon\right)^{2x+2y}}{\log^{2}n}n^{\frac{cb^{2}\left(1+\epsilon\right)^{x+y}}{\log n}}\,\mathrm{d}x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A10.Ex407"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex407.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex407.m2" class="ltx_Math" alttext="\displaystyle~\left(\frac{b^{4}\left(1+\epsilon\right)^{2y}}{\log^{2}n}\right)\cdot\left(\frac{\frac{\left(1+\epsilon\right)^{m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-\left(1+\epsilon\right)e^{b^{2}c(\epsilon+1)^{y+1}}}{b^{2}c(\epsilon+1)^{y}}-\frac{e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)^{m+1}}-e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)}}{b^{4}c^{2}(\epsilon+1)^{2y}}}{\log(\epsilon+1)}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mfrac><mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow></mrow><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup></mrow></mfrac><mo>−</mo><mfrac><mrow><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow></msup></mrow><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup></mrow></mfrac></mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\left(\frac{b^{4}\left(1+\epsilon\right)^{2y}}{\log^{2}n}\right)\cdot\left(\frac{\frac{\left(1+\epsilon\right)^{m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-\left(1+\epsilon\right)e^{b^{2}c(\epsilon+1)^{y+1}}}{b^{2}c(\epsilon+1)^{y}}-\frac{e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)^{m+1}}-e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)}}{b^{4}c^{2}(\epsilon+1)^{2y}}}{\log(\epsilon+1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A10.Ex408"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A10.Ex408.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex408.m2" class="ltx_Math" alttext="\displaystyle~\frac{\frac{b^{2}\left(1+\epsilon\right)^{y}\left(1+\epsilon\right)^{m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-b^{2}\left(1+\epsilon\right)^{y}\left(1+\epsilon\right)e^{b^{2}c(\epsilon+1)^{y+1}}}{c}-\frac{e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)^{m+1}}-e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)}}{c^{2}}}{\log^{2}n\log(\epsilon+1)}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mfrac><mrow><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>−</mo><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow></mrow><mi>c</mi></mfrac><mo>−</mo><mfrac><mrow><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>y</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow></msup></mrow><msup><mi>c</mi><mn>2</mn></msup></mfrac></mrow><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle~\frac{\frac{b^{2}\left(1+\epsilon\right)^{y}\left(1+\epsilon\right)^{m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-b^{2}\left(1+\epsilon\right)^{y}\left(1+\epsilon\right)e^{b^{2}c(\epsilon+1)^{y+1}}}{c}-\frac{e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)^{m+1}}-e^{b^{2}c(\epsilon+1)^{y}\left(1+\epsilon\right)}}{c^{2}}}{\log^{2}n\log(\epsilon+1)}</annotation></semantics></math></td>
