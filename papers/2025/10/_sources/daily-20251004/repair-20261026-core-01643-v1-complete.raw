<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex244.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex244.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{e^{b^{2}c(\epsilon+1)^{2m+2}}-e^{b^{2}c(\epsilon+1)^{m+2}}}{c^{2}\log^{2}(n)\log^{2}(\epsilon+1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow></msup></mrow></msup></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{e^{b^{2}c(\epsilon+1)^{2m+2}}-e^{b^{2}c(\epsilon+1)^{m+2}}}{c^{2}\log^{2}(n)\log^{2}(\epsilon+1)}\right)</annotation></semantics></math></td>
