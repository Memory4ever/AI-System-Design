limits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~+\left\|\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex312"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex312.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex312.m2" class="ltx_Math" alttext="\displaystyle~\left\|\exp(QK^{\top}/d)-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></msup></mrow></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\left\|\exp(QK^{\top}/d)-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex313"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex313.m1" class="ltx_math_unparsed" alttext="\displaystyle~+\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left\|\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}-\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msub><mrow><mo>‖</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></msup><mo>−</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><msup><mi>ϕ</mi><mo>′</mo></msup><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~+\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left\|\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)^{\circ C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}-\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex314"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex314.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex314.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{B^{2}}{\log n}e^{o\left(B^{2}\right)}\epsilon_{0}+\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\max_{i,j\in[n]}\left\{\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>B</mi><mn>2</mn></msup><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>B</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><munder><mi>max</mi><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></msubsup></mrow><mo>}</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{B^{2}}{\log n}e^{o\left(B^{2}\right)}\epsilon_{0}+\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\max_{i,j\in[n]}\left\{\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS2.p2.2" class="ltx_p"><span id="A9.SS2.p2.2.1" class="ltx_text">where the second and the third step follows from the triangle inequality (see Fact <a href="#A10.Thmtheorem3" title="Fact J.3. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a>), and the last step follows from combining Lemma <a href="#A7.Thmtheorem8" title="Lemma G.8. ‣ G.3 Reducing the Softmax Attention Matrix to the Polynomial Attention Matrix ‣ Appendix G THRESHOLD VALUES SPECIFICATION AND INTERVAL-BASED FACTORIZATION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.8</span></a> and Lemma <a href="#A8.Thmtheorem3" title="Lemma H.3 (ℓ_∞ Guarantee for Polynomial Sketching). ‣ H.3 Union Bound to All Entries ‣ Appendix H SKETCHING REDUCES THE TIME COMPLEXITY OF POLYNOMIAL ATTENTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.3</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="A9.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">I.3 </span>Running Time Analysis of Constructing <math id="A9.SS3.m1" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math> and <math id="A9.SS3.m2" class="ltx_Math" alttext="\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math></h3>

<div id="A9.SS3.p1" class="ltx_para">
<p id="A9.SS3.p1.1" class="ltx_p">We analyze the runtime complexity of constructing the sketched feature representations used in approximating the softmax-attention matrix. The following lemma shows that the total time required to compute all randomized feature mappings <math id="A9.SS3.p1.m1" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math> and <math id="A9.SS3.p1.m2" class="ltx_Math" alttext="\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math>, across all bucketed matrix pairs <math id="A9.SS3.p1.m3" class="ltx_Math" alttext="(\ell,\ell^{\prime})\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\ell,\ell^{\prime})\in[m]\times[m]</annotation></semantics></math>, is nearly linear in <math id="A9.SS3.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>:</p>
</div>
<div id="A9.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A9.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma I.3</span></span><span id="A9.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A9.Thmtheorem3.p1" class="ltx_para">
<p id="A9.Thmtheorem3.p1.1" class="ltx_p"><span id="A9.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let everything be defined as in Definition <a href="#A9.Thmtheorem1" title="Definition I.1. ‣ I.1 A Basic Definition ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.1</span></a>.</span></p>
</div>
<div id="A9.Thmtheorem3.p2" class="ltx_para">
<p id="A9.Thmtheorem3.p2.1" class="ltx_p"><span id="A9.Thmtheorem3.p2.1.1" class="ltx_text ltx_font_italic">Then, it takes</span></p>
<table id="A9.EGx151" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex315"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex315.m1" class="ltx_Math" alttext="\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.Thmtheorem3.p2.2" class="ltx_p"><span id="A9.Thmtheorem3.p2.2.1" class="ltx_text ltx_font_italic">time to construct <math id="A9.Thmtheorem3.p2.m1" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math> and <math id="A9.Thmtheorem3.p2.m2" class="ltx_Math" alttext="\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math>, for all <math id="A9.Thmtheorem3.p2.m3" class="ltx_Math" alttext="(\ell,\ell^{\prime})\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\ell,\ell^{\prime})\in[m]\times[m]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A9.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A9.SS3.p2" class="ltx_para">
<p id="A9.SS3.p2.1" class="ltx_p"><span id="A9.SS3.p2.1.1" class="ltx_text">By Lemma <a href="#A1.Thmtheorem2" title="Lemma A.2 (Lemma 3.2 in []). ‣ A.1.1 Background: Low Rank Approximation ‣ A.1 Background: Technique Overview of the Polynomial Method ‣ Appendix A PRELIMINARIES ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>, for each <math id="A9.SS3.p2.m1" class="ltx_Math" alttext="\left(\ell,\ell^{\prime}\right)\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\ell,\ell^{\prime}\right)\in[m]\times[m]</annotation></semantics></math>, it takes <math id="A9.SS3.p2.m2" class="ltx_Math" alttext="O\left(n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O\left(n^{1+o(1)}\right)</annotation></semantics></math> time to construct <math id="A9.SS3.p2.m3" class="ltx_Math" alttext="U_{1}^{\left(\ell,\ell^{\prime}\right)}\in\mathbb{R}^{n\times r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">U_{1}^{\left(\ell,\ell^{\prime}\right)}\in\mathbb{R}^{n\times r}</annotation></semantics></math> and <math id="A9.SS3.p2.m4" class="ltx_Math" alttext="U_{2}^{\left(\ell,\ell^{\prime}\right)}\in\mathbb{R}^{n\times r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">U_{2}^{\left(\ell,\ell^{\prime}\right)}\in\mathbb{R}^{n\times r}</annotation></semantics></math>, with <math id="A9.SS3.p2.m5" class="ltx_Math" alttext="r&lt;n^{o(1)}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><msup><mi>n</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">r&lt;n^{o(1)}</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS3.p3" class="ltx_para">
<p id="A9.SS3.p3.1" class="ltx_p"><span id="A9.SS3.p3.1.1" class="ltx_text">By Theorem <a href="#A1.Thmtheorem9" title="Theorem A.9 (Theorem 1.1 in []). ‣ A.2 Background: Sketching and Polynomial Attention ‣ Appendix A PRELIMINARIES ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.9</span></a>, with</span></p>
<table id="A9.EGx152" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E27.m1" class="ltx_Math" alttext="\displaystyle z=\Theta\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\epsilon^{-2}\log(n/\delta)\right)" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle z=\Theta\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\epsilon^{-2}\log(n/\delta)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A9.SS3.p3.2" class="ltx_p"><span id="A9.SS3.p3.2.1" class="ltx_text">being the sketch size (see Lemma <a href="#A8.Thmtheorem3" title="Lemma H.3 (ℓ_∞ Guarantee for Polynomial Sketching). ‣ H.3 Union Bound to All Entries ‣ Appendix H SKETCHING REDUCES THE TIME COMPLEXITY OF POLYNOMIAL ATTENTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.3</span></a>), where <math id="A9.SS3.p3.m1" class="ltx_Math" alttext="\epsilon\in(0,0.5)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0.5</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in(0,0.5)</annotation></semantics></math> and <math id="A9.SS3.p3.m2" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math> respectively are the accuracy parameter and failure probability for sketching, since <math id="A9.SS3.p3.m3" class="ltx_Math" alttext="\phi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\phi^{\prime}</annotation></semantics></math> is applied row-wisely to a matrix, computing <math id="A9.SS3.p3.m4" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math> and <math id="A9.SS3.p3.m5" class="ltx_Math" alttext="\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math> respectively requires <math id="A9.SS3.p3.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> times of:</span></p>
<ol id="A9.I1" class="ltx_enumerate">
<li id="A9.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A9.I1.i1.p1" class="ltx_para">
<p id="A9.I1.i1.p1.1" class="ltx_p"><math id="A9.I1.i1.p1.m1" class="ltx_Math" alttext="\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}" display="inline" intent=":literal"><semantics><mfrac><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}</annotation></semantics></math> matrix-vector multiplications with matrices of size <math id="A9.I1.i1.p1.m2" class="ltx_Math" alttext="r\times z" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">r\times z</annotation></semantics></math>,</p>
</div></li>
<li id="A9.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A9.I1.i2.p1" class="ltx_para">
<p id="A9.I1.i2.p1.1" class="ltx_p"><math id="A9.I1.i2.p1.m1" class="ltx_Math" alttext="\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}-2" display="inline" intent=":literal"><semantics><mrow><mfrac><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mn>2</mn></mfrac><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}-2</annotation></semantics></math> matrix-vector multiplications with matrices of size <math id="A9.I1.i2.p1.m2" class="ltx_Math" alttext="z\times z" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">z\times z</annotation></semantics></math>,</p>
</div></li>
<li id="A9.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A9.I1.i3.p1" class="ltx_para">
<p id="A9.I1.i3.p1.1" class="ltx_p"><math id="A9.I1.i3.p1.m1" class="ltx_Math" alttext="\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}-1" display="inline" intent=":literal"><semantics><mrow><mfrac><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mn>2</mn></mfrac><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}-1</annotation></semantics></math> Hadamard products of <math id="A9.I1.i3.p1.m2" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>-dimensional vectors,</p>
</div></li>
<li id="A9.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="A9.I1.i4.p1" class="ltx_para">
<p id="A9.I1.i4.p1.1" class="ltx_p">and <math id="A9.I1.i4.p1.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> self-Kronecker product of an <math id="A9.I1.i4.p1.m2" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>-dimensional vector.</p>
</div></li>
</ol>
</div>
<div id="A9.SS3.p4" class="ltx_para">
<p id="A9.SS3.p4.1" class="ltx_p"><span id="A9.SS3.p4.1.1" class="ltx_text">Step 1 takes</span></p>
<table id="A9.EGx153" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex316"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex316.m1" class="ltx_Math" alttext="\displaystyle\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}\cdot rz=O\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}rz\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mn>2</mn></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>r</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}\cdot rz=O\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}rz\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.SS3.p5" class="ltx_para">
<p id="A9.SS3.p5.1" class="ltx_p"><span id="A9.SS3.p5.1.1" class="ltx_text">Step 2 takes</span></p>
<table id="A9.EGx154" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex317"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex317.m1" class="ltx_Math" alttext="\displaystyle\left(\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}-2\right)\cdot z^{2}=O\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z^{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mn>2</mn></mfrac></mstyle><mo>−</mo><mn>2</mn></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}-2\right)\cdot z^{2}=O\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.SS3.p6" class="ltx_para">
<p id="A9.SS3.p6.1" class="ltx_p"><span id="A9.SS3.p6.1.1" class="ltx_text">Step 3 takes</span></p>
<table id="A9.EGx155" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex318"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex318.m1" class="ltx_Math" alttext="\displaystyle\left(\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}-1\right)\cdot z=O\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mn>2</mn></mfrac></mstyle><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>z</mi></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\frac{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}{2}-1\right)\cdot z=O\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.SS3.p7" class="ltx_para">
<p id="A9.SS3.p7.1" class="ltx_p"><span id="A9.SS3.p7.1.1" class="ltx_text">Step 4 takes</span></p>
<table id="A9.EGx156" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex319"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex319.m1" class="ltx_Math" alttext="\displaystyle O\left(z^{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>z</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle O\left(z^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.SS3.p8" class="ltx_para">
<p id="A9.SS3.p8.1" class="ltx_p"><span id="A9.SS3.p8.1.1" class="ltx_text">Therefore, for each <math id="A9.SS3.p8.m1" class="ltx_Math" alttext="\left(\ell,\ell^{\prime}\right)\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\ell,\ell^{\prime}\right)\in[m]\times[m]</annotation></semantics></math>, it takes</span></p>
<table id="A9.EGx157" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex320"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex320.m1" class="ltx_Math" alttext="\displaystyle~O\left(n^{1+o(1)}+n\cdot\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}rz+C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z^{2}+C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z+z^{2}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>+</mo><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(n^{1+o(1)}+n\cdot\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}rz+C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z^{2}+C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z+z^{2}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex321"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex321.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex321.m2" class="ltx_Math" alttext="\displaystyle~O\left(n^{1+o(1)}+nC^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot\left(rz+z^{2}\right)\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>+</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(n^{1+o(1)}+nC^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot\left(rz+z^{2}\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.SS3.p9" class="ltx_para">
<p id="A9.SS3.p9.1" class="ltx_p"><span id="A9.SS3.p9.1.1" class="ltx_text">In total, it takes</span></p>
<table id="A9.EGx158" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex322"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex322.m2" class="ltx_Math" alttext="\displaystyle~\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}O\left(n^{1+o(1)}+nC^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot\left(rz+z^{2}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>+</mo><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}O\left(n^{1+o(1)}+nC^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot\left(rz+z^{2}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex323"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex323.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex323.m2" class="ltx_Math" alttext="\displaystyle~O\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}n^{1+o(1)}+\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}nC^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot\left(rz+z^{2}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}n^{1+o(1)}+\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}nC^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot\left(rz+z^{2}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E28.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E28.m2" class="ltx_Math" alttext="\displaystyle~O\left(m^{2}n^{1+o(1)}+nr\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z+n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>m</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(m^{2}n^{1+o(1)}+nr\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z+n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A9.SS3.p9.2" class="ltx_p"><span id="A9.SS3.p9.2.1" class="ltx_text">time to compute <math id="A9.SS3.p9.m1" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right),\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)\in\mathbb{R}^{n\times z^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right),\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)\in\mathbb{R}^{n\times z^{2}}</annotation></semantics></math> for all <math id="A9.SS3.p9.m2" class="ltx_Math" alttext="\left(\ell,\ell^{\prime}\right)\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\ell,\ell^{\prime}\right)\in[m]\times[m]</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS3.p10" class="ltx_para">
<p id="A9.SS3.p10.1" class="ltx_p"><span id="A9.SS3.p10.1.1" class="ltx_text">Now, we analyze the first term of Eq. (<a href="#A9.Ex322" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>): <math id="A9.SS3.p10.m1" class="ltx_Math" alttext="m^{2}n^{1+o(1)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>m</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">m^{2}n^{1+o(1)}</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS3.p11" class="ltx_para">
<p id="A9.SS3.p11.1" class="ltx_p"><span id="A9.SS3.p11.1.1" class="ltx_text">By Fact <a href="#A7.Thmtheorem2" title="Fact G.2. ‣ G.1 Thresholds for Support Basis ‣ Appendix G THRESHOLD VALUES SPECIFICATION AND INTERVAL-BASED FACTORIZATION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.2</span></a>, we have</span></p>
<table id="A9.EGx159" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E29.m1" class="ltx_Math" alttext="\displaystyle m=\left\lfloor\log_{1+\epsilon_{B}}\left(B/b\right)\right\rfloor+1." display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>=</mo><mrow><mrow><mo>⌊</mo><mrow><msub><mi>log</mi><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>B</mi><mo>/</mo><mi>b</mi></mrow><mo>)</mo></mrow></mrow><mo>⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle m=\left\lfloor\log_{1+\epsilon_{B}}\left(B/b\right)\right\rfloor+1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div>
<div id="A9.SS3.p12" class="ltx_para">
<p id="A9.SS3.p12.1" class="ltx_p"><span id="A9.SS3.p12.1.1" class="ltx_text">Therefore, by Eq. (<a href="#A9.E29" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>), we have</span></p>
<table id="A9.EGx160" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex324"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex324.m1" class="ltx_Math" alttext="\displaystyle m^{2}n^{1+o(1)}=" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>m</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle m^{2}n^{1+o(1)}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex324.m2" class="ltx_Math" alttext="\displaystyle~\left(\left\lfloor\log_{1+\epsilon_{B}}\left(B/b\right)\right\rfloor+1\right)^{2}n^{1+o(1)}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><mrow><mo>⌊</mo><mrow><msub><mi>log</mi><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>B</mi><mo>/</mo><mi>b</mi></mrow><mo>)</mo></mrow></mrow><mo>⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle~\left(\left\lfloor\log_{1+\epsilon_{B}}\left(B/b\right)\right\rfloor+1\right)^{2}n^{1+o(1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E30.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E30.m2" class="ltx_Math" alttext="\displaystyle~O\left(\log_{1+\epsilon_{B}}^{2}\left(B/b\right)n^{1+o(1)}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>log</mi><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mn>2</mn></msubsup><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>B</mi><mo>/</mo><mi>b</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\log_{1+\epsilon_{B}}^{2}\left(B/b\right)n^{1+o(1)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
<div id="A9.SS3.p13" class="ltx_para">
<p id="A9.SS3.p13.1" class="ltx_p"><span id="A9.SS3.p13.1.1" class="ltx_text">Now, we analyze the second term of Eq. (<a href="#A9.Ex322" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>): <math id="A9.SS3.p13.m1" class="ltx_Math" alttext="nr\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msubsup><mo>∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">nr\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS3.p14" class="ltx_para">
<p id="A9.SS3.p14.1" class="ltx_p"><span id="A9.SS3.p14.1.1" class="ltx_text">We have</span></p>
<table id="A9.EGx161" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex325"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex325.m1" class="ltx_Math" alttext="\displaystyle nr\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>z</mi></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle nr\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex325.m2" class="ltx_Math" alttext="\displaystyle~n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">\displaystyle~n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex326"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex326.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex326.m2" class="ltx_Math" alttext="\displaystyle~n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\epsilon^{-2}\log(n/\delta)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\epsilon^{-2}\log(n/\delta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex327"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex327.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex327.m2" class="ltx_Math" alttext="\displaystyle~n^{1+o(1)}\epsilon^{-2}\log(n/\delta)\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~n^{1+o(1)}\epsilon^{-2}\log(n/\delta)\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex328"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex328.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex328.m2" class="ltx_Math" alttext="\displaystyle~n^{1+o(1)}\epsilon^{-2}\log(n/\delta)\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\frac{b^{2}\left(1+\epsilon_{B}\right)^{\ell+\ell^{\prime}}}{\log n}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~n^{1+o(1)}\epsilon^{-2}\log(n/\delta)\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\frac{b^{2}\left(1+\epsilon_{B}\right)^{\ell+\ell^{\prime}}}{\log n}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex329"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex329.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex329.m2" class="ltx_Math" alttext="\displaystyle~\frac{b^{4}n^{1+o(1)}\epsilon^{-2}\log(n/\delta)}{\log^{2}n}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell+2\ell^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{b^{4}n^{1+o(1)}\epsilon^{-2}\log(n/\delta)}{\log^{2}n}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell+2\ell^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E31.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E31.m2" class="ltx_Math" alttext="\displaystyle~\frac{b^{4}n^{1+o(1)}\epsilon^{-2}\log(n/\delta)}{\log^{2}n}\left(\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell}\right)^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{b^{4}n^{1+o(1)}\epsilon^{-2}\log(n/\delta)}{\log^{2}n}\left(\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell}\right)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A9.SS3.p14.2" class="ltx_p"><span id="A9.SS3.p14.2.1" class="ltx_text">where the first step follows from <math id="A9.SS3.p14.m1" class="ltx_Math" alttext="r=n^{o(1)}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><msup><mi>n</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">r=n^{o(1)}</annotation></semantics></math> (see Lemma <a href="#A1.Thmtheorem4" title="Lemma A.4 (An improved version of Lemma 3.4 in []). ‣ A.1.2 Background: Approximating the Attention Computation Assuming 𝑑=𝑂(log𝑛) and Bounded Entries ‣ A.1 Background: Technique Overview of the Polynomial Method ‣ Appendix A PRELIMINARIES ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>), the second step follows from Eq. (<a href="#A9.E27" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>), the fourth step follows from Lemma <a href="#A7.Thmtheorem3" title="Lemma G.3 (Normalized block decomposition). ‣ G.1 Thresholds for Support Basis ‣ Appendix G THRESHOLD VALUES SPECIFICATION AND INTERVAL-BASED FACTORIZATION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.3</span></a> and <math id="A9.SS3.p14.m2" class="ltx_Math" alttext="\epsilon_{B}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mi>B</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon_{B}&gt;0</annotation></semantics></math> denote the bucketing parameter, and the last step follows from <math id="A9.SS3.p14.m3" class="ltx_Math" alttext="\left(1+\epsilon_{B}\right)^{2\ell+2\ell^{\prime}}=\left(1+\epsilon_{B}\right)^{2\ell}\cdot\left(1+\epsilon_{B}\right)^{2\ell^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></mrow></msup><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo rspace="0.055em">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\left(1+\epsilon_{B}\right)^{2\ell+2\ell^{\prime}}=\left(1+\epsilon_{B}\right)^{2\ell}\cdot\left(1+\epsilon_{B}\right)^{2\ell^{\prime}}</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS3.p15" class="ltx_para">
<p id="A9.SS3.p15.1" class="ltx_p"><span id="A9.SS3.p15.1.1" class="ltx_text">Furthermore, we can see that</span></p>
<table id="A9.EGx162" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex330"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex330.m1" class="ltx_Math" alttext="\displaystyle\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell}=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex330.m2" class="ltx_Math" alttext="\displaystyle~\frac{\left(1+\epsilon_{B}\right)^{2}\left(1-\left(1+\epsilon_{B}\right)^{2m}\right)}{1-\left(1+\epsilon_{B}\right)^{2}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle~\frac{\left(1+\epsilon_{B}\right)^{2}\left(1-\left(1+\epsilon_{B}\right)^{2m}\right)}{1-\left(1+\epsilon_{B}\right)^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E32.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E32.m2" class="ltx_Math" alttext="\displaystyle~O\left(\left(1+\epsilon_{B}\right)^{2m}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\left(1+\epsilon_{B}\right)^{2m}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="A9.SS3.p15.2" class="ltx_p"><span id="A9.SS3.p15.2.1" class="ltx_text">where the first step follows from the geometric series formula.</span></p>
</div>
<div id="A9.SS3.p16" class="ltx_para">
<p id="A9.SS3.p16.1" class="ltx_p"><span id="A9.SS3.p16.1.1" class="ltx_text">Combining Eq. (<a href="#A9.Ex325" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>) and (<a href="#A9.Ex330" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>), we have</span></p>
<table id="A9.EGx163" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex331"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex331.m1" class="ltx_Math" alttext="\displaystyle nr\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>z</mi></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle nr\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex331.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{b^{4}\log(n/\delta)e^{4m\epsilon_{B}}}{\epsilon^{2}\log^{2}n}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow></msup></mrow><mrow><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{b^{4}\log(n/\delta)e^{4m\epsilon_{B}}}{\epsilon^{2}\log^{2}n}n^{1+o(1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E33.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E33.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{B^{4}\log(n/\delta)}{\epsilon^{2}\log^{2}n}n^{1+o(1)}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{B^{4}\log(n/\delta)}{\epsilon^{2}\log^{2}n}n^{1+o(1)}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A9.SS3.p16.2" class="ltx_p"><span id="A9.SS3.p16.2.1" class="ltx_text">where the second step follows from Eq. (<a href="#A9.E29" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>).</span></p>
</div>
<div id="A9.SS3.p17" class="ltx_para">
<p id="A9.SS3.p17.1" class="ltx_p"><span id="A9.SS3.p17.1.1" class="ltx_text">Now, we analyze the third term of Eq. (<a href="#A9.Ex322" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>): <math id="A9.SS3.p17.m1" class="ltx_Math" alttext="n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z^{2}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msubsup><mo>∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}z^{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS3.p18" class="ltx_para">
<p id="A9.SS3.p18.1" class="ltx_p"><span id="A9.SS3.p18.1.1" class="ltx_text">We have</span></p>
<table id="A9.EGx164" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex332"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex332.m1" class="ltx_Math" alttext="\displaystyle n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z^{2}=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z^{2}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex332.m2" class="ltx_Math" alttext="\displaystyle~n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\epsilon^{-2}\log(n/\delta)\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle~n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\epsilon^{-2}\log(n/\delta)\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex333"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex333.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex333.m2" class="ltx_Math" alttext="\displaystyle~n\epsilon^{-4}\log^{2}(n/\delta)\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\right)^{3}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo>)</mo></mrow><mn>3</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~n\epsilon^{-4}\log^{2}(n/\delta)\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\right)^{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex334"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex334.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex334.m2" class="ltx_Math" alttext="\displaystyle~n\epsilon^{-4}\log^{2}(n/\delta)\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\frac{b^{2}\left(1+\epsilon_{B}\right)^{\ell+\ell^{\prime}}}{\log n}\right)^{3}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>3</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~n\epsilon^{-4}\log^{2}(n/\delta)\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\frac{b^{2}\left(1+\epsilon_{B}\right)^{\ell+\ell^{\prime}}}{\log n}\right)^{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex335"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex335.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex335.m2" class="ltx_Math" alttext="\displaystyle~\frac{b^{6}n\epsilon^{-4}\log^{2}(n/\delta)}{\log^{3}n}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(1+\epsilon_{B}\right)^{3\ell+3\ell^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>log</mi><mn>3</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{b^{6}n\epsilon^{-4}\log^{2}(n/\delta)}{\log^{3}n}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(1+\epsilon_{B}\right)^{3\ell+3\ell^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E34.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E34.m2" class="ltx_Math" alttext="\displaystyle~\frac{b^{6}n\epsilon^{-4}\log^{2}(n/\delta)}{\log^{3}n}\left(\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{3\ell}\right)^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>log</mi><mn>3</mn></msup><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{b^{6}n\epsilon^{-4}\log^{2}(n/\delta)}{\log^{3}n}\left(\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{3\ell}\right)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
<p id="A9.SS3.p18.2" class="ltx_p"><span id="A9.SS3.p18.2.1" class="ltx_text">where the first step follows from Eq. (<a href="#A9.E27" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>), the third step follows from Lemma <a href="#A7.Thmtheorem3" title="Lemma G.3 (Normalized block decomposition). ‣ G.1 Thresholds for Support Basis ‣ Appendix G THRESHOLD VALUES SPECIFICATION AND INTERVAL-BASED FACTORIZATION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.3</span></a> and <math id="A9.SS3.p18.m1" class="ltx_Math" alttext="\epsilon_{B}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mi>B</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon_{B}&gt;0</annotation></semantics></math> denote the bucketing parameter, and the last step follows from <math id="A9.SS3.p18.m2" class="ltx_Math" alttext="\left(1+\epsilon_{B}\right)^{3\ell+3\ell^{\prime}}=\left(1+\epsilon_{B}\right)^{3\ell}\cdot\left(1+\epsilon_{B}\right)^{3\ell^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></mrow></msup><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo rspace="0.055em">)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\left(1+\epsilon_{B}\right)^{3\ell+3\ell^{\prime}}=\left(1+\epsilon_{B}\right)^{3\ell}\cdot\left(1+\epsilon_{B}\right)^{3\ell^{\prime}}</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS3.p19" class="ltx_para">
<p id="A9.SS3.p19.1" class="ltx_p"><span id="A9.SS3.p19.1.1" class="ltx_text">Furthermore, we can see that</span></p>
<table id="A9.EGx165" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex336"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex336.m1" class="ltx_Math" alttext="\displaystyle\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{3\ell}=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{3\ell}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex336.m2" class="ltx_Math" alttext="\displaystyle~\frac{\left(1+\epsilon_{B}\right)^{3}\left(1-\left(1+\epsilon_{B}\right)^{3m}\right)}{1-\left(1+\epsilon_{B}\right)^{3}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup></mrow><mo>)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle~\frac{\left(1+\epsilon_{B}\right)^{3}\left(1-\left(1+\epsilon_{B}\right)^{3m}\right)}{1-\left(1+\epsilon_{B}\right)^{3}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E35.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E35.m2" class="ltx_Math" alttext="\displaystyle~O\left(\left(1+\epsilon_{B}\right)^{3m}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\left(1+\epsilon_{B}\right)^{3m}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A9.SS3.p19.2" class="ltx_p"><span id="A9.SS3.p19.2.1" class="ltx_text">where the first step follows from the geometric series formula.</span></p>
</div>
<div id="A9.SS3.p20" class="ltx_para">
<p id="A9.SS3.p20.1" class="ltx_p"><span id="A9.SS3.p20.1.1" class="ltx_text">Combining Eq. (<a href="#A9.Ex332" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>) and (<a href="#A9.Ex336" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>), we have</span></p>
<table id="A9.EGx166" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex337"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex337.m1" class="ltx_Math" alttext="\displaystyle n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z^{2}=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle n\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot z^{2}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex337.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{b^{6}\log^{2}(n/\delta)e^{6m\epsilon_{B}}}{\epsilon^{4}\log^{3}n}n\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow></msup></mrow><mrow><msup><mi>ϵ</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>3</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{b^{6}\log^{2}(n/\delta)e^{6m\epsilon_{B}}}{\epsilon^{4}\log^{3}n}n\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E36.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E36.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}\log^{3}n}n\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>ϵ</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>3</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}\log^{3}n}n\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
<p id="A9.SS3.p20.2" class="ltx_p"><span id="A9.SS3.p20.2.1" class="ltx_text">where the second step follows from Eq. (<a href="#A9.E29" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>).</span></p>
</div>
<div id="A9.SS3.p21" class="ltx_para">
<p id="A9.SS3.p21.1" class="ltx_p"><span id="A9.SS3.p21.1.1" class="ltx_text">Finally, combining Eq. (<a href="#A9.Ex322" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>), (<a href="#A9.Ex324" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>), (<a href="#A9.Ex331" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>), and (<a href="#A9.Ex337" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>), we can get that it takes</span></p>
<table id="A9.EGx167" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex338"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex338.m1" class="ltx_Math" alttext="\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS3.p21.2" class="ltx_p"><span id="A9.SS3.p21.2.1" class="ltx_text">time to compute <math id="A9.SS3.p21.m1" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right),\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)\in\mathbb{R}^{n\times z^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right),\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)\in\mathbb{R}^{n\times z^{2}}</annotation></semantics></math> for all <math id="A9.SS3.p21.m2" class="ltx_Math" alttext="\left(\ell,\ell^{\prime}\right)\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\ell,\ell^{\prime}\right)\in[m]\times[m]</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A9.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">I.4 </span>(Batch) Gaussian Kernel Density Estimation</h3>

<div id="A9.SS4.p1" class="ltx_para">
<p id="A9.SS4.p1.1" class="ltx_p">The following lemma shows that, by using the polynomial sketching and bucketing approach described earlier, we can approximate the batch Gaussian kernel density computation with provably small <math id="A9.SS4.p1.m1" class="ltx_Math" alttext="\ell_{\infty}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\ell_{\infty}</annotation></semantics></math> error. Moreover, the algorithm runs in nearly linear time with respect to <math id="A9.SS4.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>:</p>
</div>
<div id="A9.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A9.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma I.4</span></span><span id="A9.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A9.Thmtheorem4.p1" class="ltx_para">
<p id="A9.Thmtheorem4.p1.1" class="ltx_p"><span id="A9.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let everything be defined as in Definition <a href="#A9.Thmtheorem1" title="Definition I.1. ‣ I.1 A Basic Definition ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.1</span></a>.
Then, with probability <math id="A9.Thmtheorem4.p1.m1" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, we can solve the (Batch) Gaussian kernel density estimation (Definition <a href="#A2.Thmtheorem10" title="Definition B.10 ((Batch) Gaussian kernel density estimation). ‣ B.5 (Batch) Gaussian Kernel Density Estimation ‣ Appendix B (BATCH) GAUSSIAN KERNEL DENSITY ESTIMATION VIA SINGLE THRESHOLD SUPPORT BASIS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.10</span></a>) by outputting <math id="A9.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\mathsf{S}\in\mathbb{R}^{n\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝖲</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathsf{S}\in\mathbb{R}^{n\times d}</annotation></semantics></math> satisfying</span></p>
<table id="A9.EGx168" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex339"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex339.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathsf{S}-AV\right\|_{\infty}&lt;n\epsilon_{2}\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝖲</mi><mo>−</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>&lt;</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\mathsf{S}-AV\right\|_{\infty}&lt;n\epsilon_{2}\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.Thmtheorem4.p1.2" class="ltx_p"><span id="A9.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">in <math id="A9.Thmtheorem4.p1.m3" class="ltx_Math" alttext="O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math> time.</span></p>
</div>
</div>
<div id="A9.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A9.SS4.p2" class="ltx_para">
<p id="A9.SS4.p2.1" class="ltx_p"><span id="A9.SS4.p2.1.1" class="ltx_text ltx_font_bold">Proof of correctness.<span id="A9.SS4.p2.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A9.SS4.p3" class="ltx_para">
<p id="A9.SS4.p3.1" class="ltx_p"><span id="A9.SS4.p3.1.1" class="ltx_text">We can get</span></p>
<table id="A9.EGx169" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex340"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex340.m1" class="ltx_Math" alttext="\displaystyle AV=\exp\left(QK^{\top}/d\right)V." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>=</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle AV=\exp\left(QK^{\top}/d\right)V.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A9.SS4.p4" class="ltx_para">
<p id="A9.SS4.p4.1" class="ltx_p"><span id="A9.SS4.p4.1.1" class="ltx_text">We define <math id="A9.SS4.p4.m1" class="ltx_Math" alttext="\mathsf{S}:=\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)V" display="inline" intent=":literal"><semantics><mrow><mi>𝖲</mi><mo>:=</mo><mrow><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msubsup><mo>∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">\mathsf{S}:=\left(\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)V</annotation></semantics></math>.</span></p>
</div>
<div id="A9.SS4.p5" class="ltx_para">
<p id="A9.SS4.p5.1" class="ltx_p"><span id="A9.SS4.p5.1.1" class="ltx_text">Therefore, we can get</span></p>
<table id="A9.EGx170" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex341"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex341.m1" class="ltx_Math" alttext="\displaystyle\left\|AV-\mathsf{S}\right\|_{\infty}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mi>𝖲</mi></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|AV-\mathsf{S}\right\|_{\infty}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex341.m2" class="ltx_Math" alttext="\displaystyle~\left\|\exp(QK^{\top}/d)V-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}V\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\left\|\exp(QK^{\top}/d)V-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex342"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex342.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex342.m2" class="ltx_Math" alttext="\displaystyle~\left\|\left(\exp(QK^{\top}/d)-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)V\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\left\|\left(\exp(QK^{\top}/d)-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex343"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex343.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex343.m2" class="ltx_Math" alttext="\displaystyle~n\left\|\exp(QK^{\top}/d)-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right\|_{\infty}\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle~n\left\|\exp(QK^{\top}/d)-\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right\|_{\infty}\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex344"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex344.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex344.m2" class="ltx_Math" alttext="\displaystyle~n\epsilon_{2}\left\|V\right\|_{\infty}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~n\epsilon_{2}\left\|V\right\|_{\infty},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS4.p5.2" class="ltx_p"><span id="A9.SS4.p5.2.1" class="ltx_text">where the second step follows from the distributive law, the third step follows from the definition of the <math id="A9.SS4.p5.m1" class="ltx_Math" alttext="\ell_{\infty}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\ell_{\infty}</annotation></semantics></math> norm, and the fourth step follows from Lemma <a href="#A9.Thmtheorem2" title="Lemma I.2 ((𝑄,𝐾)-Softmax-Attention Matrix Approximation). ‣ I.2 (𝑄,𝐾)-Softmax-Attention Matrix Approximation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.2</span></a>.</span></p>
</div>
<div id="A9.SS4.p6" class="ltx_para">
<p id="A9.SS4.p6.1" class="ltx_p"><span id="A9.SS4.p6.1.1" class="ltx_text ltx_font_bold">Proof of the running time.<span id="A9.SS4.p6.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A9.SS4.p7" class="ltx_para">
<p id="A9.SS4.p7.1" class="ltx_p"><span id="A9.SS4.p7.1.1" class="ltx_text">By Lemma <a href="#A9.Thmtheorem3" title="Lemma I.3. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.3</span></a>, we note that to obtain <math id="A9.SS4.p7.m1" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right),\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)\in\mathbb{R}^{n\times z^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right),\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)\in\mathbb{R}^{n\times z^{2}}</annotation></semantics></math>, it takes</span></p>
<table id="A9.EGx171" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E37.m1" class="ltx_Math" alttext="\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="A9.SS4.p7.2" class="ltx_p"><span id="A9.SS4.p7.2.1" class="ltx_text">time.</span></p>
</div>
<div id="A9.SS4.p8" class="ltx_para">
<p id="A9.SS4.p8.1" class="ltx_p"><span id="A9.SS4.p8.1.1" class="ltx_text">Then, we compute</span></p>
<table id="A9.EGx172" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex345"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex345.m1" class="ltx_Math" alttext="\displaystyle\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{V}_{n\times d}," display="inline" intent=":literal"><semantics><mrow><mrow><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mi>V</mi><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></munder></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{V}_{n\times d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS4.p8.2" class="ltx_p"><span id="A9.SS4.p8.2.1" class="ltx_text">for all <math id="A9.SS4.p8.m1" class="ltx_Math" alttext="\left(\ell,\ell^{\prime}\right)\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\ell,\ell^{\prime}\right)\in[m]\times[m]</annotation></semantics></math>, which takes</span></p>
<table id="A9.EGx173" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex346"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex346.m1" class="ltx_Math" alttext="\displaystyle\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}O\left(z^{2}nd\right)=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}O\left(z^{2}nd\right)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex346.m2" class="ltx_Math" alttext="\displaystyle~\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}O\left(\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\right)^{2}\epsilon^{-4}\log^{2}(n/\delta)nd\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}O\left(\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\right)^{2}\epsilon^{-4}\log^{2}(n/\delta)nd\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex347"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex347.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex347.m2" class="ltx_Math" alttext="\displaystyle~O\left(\epsilon^{-4}\log^{2}(n/\delta)n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\right)^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\epsilon^{-4}\log^{2}(n/\delta)n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\right)^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex348"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex348.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex348.m2" class="ltx_Math" alttext="\displaystyle~O\left(\epsilon^{-4}\log^{2}(n/\delta)n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\frac{b^{2}\left(1+\epsilon_{B}\right)^{\ell+\ell^{\prime}}}{\log n}\right)^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\epsilon^{-4}\log^{2}(n/\delta)n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\frac{b^{2}\left(1+\epsilon_{B}\right)^{\ell+\ell^{\prime}}}{\log n}\right)^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex349"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex349.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex349.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{b^{4}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell+2\ell^{\prime}}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></mrow></msup></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{b^{4}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell+2\ell^{\prime}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex350"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex350.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex350.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{b^{4}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\left(\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell}\right)^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{b^{4}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\left(\sum_{\ell=1}^{m}\left(1+\epsilon_{B}\right)^{2\ell}\right)^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.Ex351"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex351.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex351.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{b^{4}\log^{2}(n/\delta)e^{4m\epsilon_{B}}}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow></msup></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{b^{4}\log^{2}(n/\delta)e^{4m\epsilon_{B}}}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A9.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E38.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E38.m2" class="ltx_Math" alttext="\displaystyle~O\left(\frac{B^{4}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\frac{B^{4}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="A9.SS4.p8.3" class="ltx_p"><span id="A9.SS4.p8.3.1" class="ltx_text">where the first step follows from Eq. (<a href="#A9.E27" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>), the second step follows from <math id="A9.SS4.p8.m2" class="ltx_Math" alttext="d=O(\log n)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d=O(\log n)</annotation></semantics></math>, the third step follows from Lemma <a href="#A7.Thmtheorem3" title="Lemma G.3 (Normalized block decomposition). ‣ G.1 Thresholds for Support Basis ‣ Appendix G THRESHOLD VALUES SPECIFICATION AND INTERVAL-BASED FACTORIZATION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.3</span></a>, the fifth step follows from <math id="A9.SS4.p8.m3" class="ltx_Math" alttext="\left(1+\epsilon_{B}\right)^{2\ell+2\ell^{\prime}}=\left(1+\epsilon_{B}\right)^{2\ell}\cdot\left(1+\epsilon_{B}\right)^{2\ell^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></mrow></msup><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo rspace="0.055em">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\left(1+\epsilon_{B}\right)^{2\ell+2\ell^{\prime}}=\left(1+\epsilon_{B}\right)^{2\ell}\cdot\left(1+\epsilon_{B}\right)^{2\ell^{\prime}}</annotation></semantics></math>, the sixth step follows from Eq. (<a href="#A9.Ex330" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>), and the last step follows from Eq. (<a href="#A9.E29" title="In Proof. ‣ I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>).</span></p>
</div>
<div id="A9.SS4.p9" class="ltx_para">
<p id="A9.SS4.p9.1" class="ltx_p"><span id="A9.SS4.p9.1.1" class="ltx_text">Finally, for all <math id="A9.SS4.p9.m1" class="ltx_Math" alttext="\left(\ell,\ell^{\prime}\right)\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\ell,\ell^{\prime}\right)\in[m]\times[m]</annotation></semantics></math>, we compute</span></p>
<table id="A9.EGx174" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex352"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex352.m1" class="ltx_Math" alttext="\displaystyle\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}V}_{z^{2}\times d}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></munder><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></munder><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}V}_{z^{2}\times d}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS4.p9.2" class="ltx_p"><span id="A9.SS4.p9.2.1" class="ltx_text">which, similar as in Eq. (<a href="#A9.Ex346" title="In Proof. ‣ I.4 (Batch) Gaussian Kernel Density Estimation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>) also takes</span></p>
<table id="A9.EGx175" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E39.m1" class="ltx_Math" alttext="\displaystyle\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}O\left(z^{2}nd\right)=O\left(\frac{B^{4}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}O\left(z^{2}nd\right)=O\left(\frac{B^{4}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="A9.SS4.p9.3" class="ltx_p"><span id="A9.SS4.p9.3.1" class="ltx_text">time.</span></p>
</div>
<div id="A9.SS4.p10" class="ltx_para">
<p id="A9.SS4.p10.1" class="ltx_p"><span id="A9.SS4.p10.1.1" class="ltx_text">In conclusion, to construct all of <math id="A9.SS4.p10.m1" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right),\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)\in\mathbb{R}^{n\times z^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right),\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)\in\mathbb{R}^{n\times z^{2}}</annotation></semantics></math>, for all <math id="A9.SS4.p10.m2" class="ltx_Math" alttext="\left(\ell,\ell^{\prime}\right)\in[m]\times[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\ell,\ell^{\prime}\right)\in[m]\times[m]</annotation></semantics></math>, we need Eq. (<a href="#A9.E37" title="In Proof. ‣ I.4 (Batch) Gaussian Kernel Density Estimation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>) time; computing all of <math id="A9.SS4.p10.m3" class="ltx_Math" alttext="\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{V}_{n\times d}" display="inline" intent=":literal"><semantics><mrow><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mi>V</mi><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></munder></mrow><annotation encoding="application/x-tex">\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}}_{z^{2}\times n}\underbrace{V}_{n\times d}</annotation></semantics></math>, we need Eq. (<a href="#A9.Ex346" title="In Proof. ‣ I.4 (Batch) Gaussian Kernel Density Estimation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>) time; computing all of <math id="A9.SS4.p10.m4" class="ltx_Math" alttext="\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}V}_{z^{2}\times d}\right)" display="inline" intent=":literal"><semantics><mrow><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></munder><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><munder><munder accentunder="true"><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></munder><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\underbrace{\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)}_{n\times z^{2}}\cdot\left(\underbrace{\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}V}_{z^{2}\times d}\right)</annotation></semantics></math>, we need Eq. (<a href="#A9.E39" title="In Proof. ‣ I.4 (Batch) Gaussian Kernel Density Estimation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>) time. Adding them all together, we need</span></p>
<table id="A9.EGx176" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex353"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex353.m1" class="ltx_Math" alttext="\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.SS4.p10.2" class="ltx_p"><span id="A9.SS4.p10.2.1" class="ltx_text">time.
∎</span></p>
</div>
</div>
</section>
<section id="A9.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">I.5 </span>Main Result</h3>

<div id="A9.SS5.p1" class="ltx_para">
<p id="A9.SS5.p1.1" class="ltx_p">We now state the main result of our attention approximation framework. By combining polynomial sketching, bucketing, and sparse additive decompositions, our algorithm approximates the attention computation to within a small <math id="A9.SS5.p1.m1" class="ltx_Math" alttext="\ell_{\infty}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\ell_{\infty}</annotation></semantics></math> error, with high probability. Importantly, it does so without requiring bounded entries or restrictive assumptions on the input matrices. The theorem below guarantees both the correctness and the runtime efficiency of our method, showing that the overall computation can be carried out in nearly linear time:</p>
</div>
<div id="A9.Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A9.Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem I.5</span></span><span id="A9.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A9.Thmtheorem5.p1" class="ltx_para">
<p id="A9.Thmtheorem5.p1.1" class="ltx_p"><span id="A9.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Let everything be defined as in Definition <a href="#A9.Thmtheorem1" title="Definition I.1. ‣ I.1 A Basic Definition ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.1</span></a>.</span></p>
</div>
<div id="A9.Thmtheorem5.p2" class="ltx_para">
<p id="A9.Thmtheorem5.p2.1" class="ltx_p"><span id="A9.Thmtheorem5.p2.1.1" class="ltx_text ltx_font_italic">Then, with probability <math id="A9.Thmtheorem5.p2.m1" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, we can solve the approximate attention computation (Definition <a href="#S1.Thmtheorem3" title="Definition 1.3 (The approximate attention computation). ‣ 1.2 Background ‣ 1 INTRODUCTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.3</span></a>) by outputting <math id="A9.Thmtheorem5.p2.m2" class="ltx_Math" alttext="P\in\mathbb{R}^{n\times d}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">P\in\mathbb{R}^{n\times d}</annotation></semantics></math> satisfying</span></p>
<table id="A9.EGx177" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex354"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex354.m1" class="ltx_Math" alttext="\displaystyle\left\|P-D^{-1}AV\right\|_{\infty}\leq\left(\epsilon_{2}\exp(B^{2}-2b^{2})+\epsilon_{2}^{2}\exp\left(-2b^{2}\right)\right)\cdot\left\|V\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mi>P</mi><mo>−</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mrow><msub><mi>ϵ</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>ϵ</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mi>V</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|P-D^{-1}AV\right\|_{\infty}\leq\left(\epsilon_{2}\exp(B^{2}-2b^{2})+\epsilon_{2}^{2}\exp\left(-2b^{2}\right)\right)\cdot\left\|V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A9.Thmtheorem5.p2.2" class="ltx_p"><span id="A9.Thmtheorem5.p2.2.1" class="ltx_text ltx_font_italic">in <math id="A9.Thmtheorem5.p2.m3" class="ltx_Math" alttext="O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msup><mi>B</mi><mn>6</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O\left(\frac{B^{6}\log^{2}(n/\delta)}{\epsilon^{4}}n^{1+o(1)}\right)</annotation></semantics></math> time.</span></p>
</div>
</div>
<div id="A9.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A9.SS5.p2" class="ltx_para">
<p id="A9.SS5.p2.1" class="ltx_p"><span id="A9.SS5.p2.1.1" class="ltx_text ltx_font_bold">Proof of correctness.<span id="A9.SS5.p2.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A9.SS5.p3" class="ltx_para">
<p id="A9.SS5.p3.1" class="ltx_p"><span id="A9.SS5.p3.1.1" class="ltx_text">We define</span></p>
<table id="A9.EGx178" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E40.m1" class="ltx_Math" alttext="\displaystyle P:=\widetilde{D}^{-1}\widetilde{A}V=\diag\left(\widetilde{A}{\bf 1}_{n}\right)^{-1}\widetilde{A}V," display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>:=</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>=</mo><mrow><mrow><mi>diag</mi><mo>⁡</mo><msup><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle P:=\widetilde{D}^{-1}\widetilde{A}V=\diag\left(\widetilde{A}{\bf 1}_{n}\right)^{-1}\widetilde{A}V,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="A9.SS5.p3.2" class="ltx_p"><span id="A9.SS5.p3.2.1" class="ltx_text">where</span></p>
<table id="A9.EGx179" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E41.m1" class="ltx_Math" alttext="\displaystyle\widetilde{A}:=\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>:=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{A}:=\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
</div>
<div id="A9.SS5.p4" class="ltx_para">
<p id="A9.SS5.p4.1" class="ltx_p"><span id="A9.SS5.p4.1.1" class="ltx_text">By the triangle inequality (see Fact <a href="#A10.Thmtheorem3" title="Fact J.3. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a>), we have</span></p>
<table id="A9.EGx180" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex355"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex355.m1" class="ltx_Math" alttext="\displaystyle\left\|D^{-1}AV-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|D^{-1}AV-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex355.m2" class="ltx_Math" alttext="\displaystyle~\left\|D^{-1}AV-D^{-1}\widetilde{A}V+D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>+</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle~\left\|D^{-1}AV-D^{-1}\widetilde{A}V+D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
