<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex292.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex292.m2" class="ltx_Math" alttext="\displaystyle~\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p/2}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p/2}+2\left|\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p/2}\right|" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><msup><mrow><mo>⟨</mo><mrow><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>⟩</mo></mrow><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msup><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p/2}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p/2}+2\left|\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p/2}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex293"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex293.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex293.m2" class="ltx_Math" alttext="\displaystyle~\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p/2}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p/2}+2\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p/2}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p/2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p/2}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p/2}+2\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p/2}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p/2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS2.p4.2" class="ltx_p"><span id="A8.SS2.p4.2.1" class="ltx_text">where the second step follows from the triangle inequality (see Fact <a href="#A10.Thmtheorem3" title="Fact J.3. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a>), the third step follows from Lemma <a href="#A8.Thmtheorem1" title="Lemma H.1 (Inner Product Preservation). ‣ H.1 Probabilistic Statement of Two Vector JL Moment Property ‣ Appendix H SKETCHING REDUCES THE TIME COMPLEXITY OF POLYNOMIAL ATTENTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.1</span></a>, and the last step follows from the Cauchy-Schwarz inequality (see Fact <a href="#A10.Thmtheorem3" title="Fact J.3. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a>).</span></p>
</div>
<div id="A8.SS2.p5" class="ltx_para">
<p id="A8.SS2.p5.1" class="ltx_p"><span id="A8.SS2.p5.1.1" class="ltx_text">Thus, combining everything together, we have that</span></p>
<table id="A8.EGx140" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex294"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex294.m1" class="ltx_Math" alttext="\displaystyle\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|\leq\epsilon\|\left(U_{1}\right)_{i,*}\|_{2}^{p}\|\left(U_{2}\right)_{j,*}\|_{2}^{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo>−</mo><msup><mrow><mo>⟨</mo><mrow><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>⟩</mo></mrow><mi>p</mi></msup></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|\leq\epsilon\|\left(U_{1}\right)_{i,*}\|_{2}^{p}\|\left(U_{2}\right)_{j,*}\|_{2}^{p}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS2.p5.2" class="ltx_p"><span id="A8.SS2.p5.2.1" class="ltx_text">holds with probability at least <math id="A8.SS2.p5.m1" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>.</span></p>
</div>
<div id="A8.SS2.p6" class="ltx_para">
<p id="A8.SS2.p6.1" class="ltx_p"><span id="A8.SS2.p6.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A8.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">H.3 </span>Union Bound to All Entries</h3>

<div id="A8.SS3.p1" class="ltx_para">
<p id="A8.SS3.p1.1" class="ltx_p">We generalize the previous pointwise sketching result (Lemma <a href="#A8.Thmtheorem2" title="Lemma H.2 (Pointwise Approximation of Polynomial Kernel via Sketching). ‣ H.2 Pointwise Approximation of Polynomial Kernel via Sketching ‣ Appendix H SKETCHING REDUCES THE TIME COMPLEXITY OF POLYNOMIAL ATTENTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.2</span></a>) by providing an <math id="A8.SS3.p1.m1" class="ltx_Math" alttext="\ell_{\infty}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\ell_{\infty}</annotation></semantics></math> bound over the entire polynomial kernel matrix. It shows that, with high probability, the randomized sketching method can approximate the full matrix <math id="A8.SS3.p1.m2" class="ltx_Math" alttext="\left(U_{1}U_{2}^{\top}\right)^{\circ p}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mn>2</mn><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>p</mi></mrow></msup><annotation encoding="application/x-tex">\left(U_{1}U_{2}^{\top}\right)^{\circ p}</annotation></semantics></math> entry-wise up to a controllable additive error, uniformly across all pairs of rows:</p>
</div>
<div id="A8.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A8.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma H.3</span></span><span id="A8.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(<math id="A8.Thmtheorem3.m1" class="ltx_Math" alttext="\ell_{\infty}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\ell_{\infty}</annotation></semantics></math> Guarantee for Polynomial Sketching)<span id="A8.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A8.Thmtheorem3.p1" class="ltx_para">
<p id="A8.Thmtheorem3.p1.1" class="ltx_p"><span id="A8.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A8.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\{\left(U_{1}\right)_{i,*}\}_{i=1}^{n},\{\left(U_{2}\right)_{j,*}\}_{j=1}^{n}\subset\mathbb{R}^{r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>,</mo><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>⊂</mo><msup><mi>ℝ</mi><mi>r</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\{\left(U_{1}\right)_{i,*}\}_{i=1}^{n},\{\left(U_{2}\right)_{j,*}\}_{j=1}^{n}\subset\mathbb{R}^{r}</annotation></semantics></math>.
Fix an even integer <math id="A8.Thmtheorem3.p1.m2" class="ltx_Math" alttext="p\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">p\geq 2</annotation></semantics></math>. Let <math id="A8.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\epsilon\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in(0,1)</annotation></semantics></math> be the accuracy parameter and <math id="A8.Thmtheorem3.p1.m4" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math> be the failure probability.
Let <math id="A8.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\phi^{\prime}:\mathbb{R}^{r}\to\mathbb{R}^{z^{2}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>r</mi></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msup><mi>z</mi><mn>2</mn></msup></msup></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}:\mathbb{R}^{r}\to\mathbb{R}^{z^{2}}</annotation></semantics></math> be a randomized feature mapping constructed using the sketching technique in Theorem <a href="#A1.Thmtheorem9" title="Theorem A.9 (Theorem 1.1 in []). ‣ A.2 Background: Sketching and Polynomial Attention ‣ Appendix A PRELIMINARIES ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.9</span></a>, with sketch size <math id="A8.Thmtheorem3.p1.m6" class="ltx_Math" alttext="z=\Theta(p\epsilon^{-2}\log(n/\delta))" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z=\Theta(p\epsilon^{-2}\log(n/\delta))</annotation></semantics></math> and <math id="A8.Thmtheorem3.p1.m7" class="ltx_Math" alttext="\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right):=\left(S\left(\left(U_{1}\right)_{i,*}\right)^{\otimes\left(p/2\right)}\right)^{\otimes 2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow></mrow><mo>:=</mo><msup><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msup></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right):=\left(S\left(\left(U_{1}\right)_{i,*}\right)^{\otimes\left(p/2\right)}\right)^{\otimes 2}</annotation></semantics></math>. For any matrix <math id="A8.Thmtheorem3.p1.m8" class="ltx_Math" alttext="A\in\mathbb{R}^{n\times r}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A\in\mathbb{R}^{n\times r}</annotation></semantics></math>, we write <math id="A8.Thmtheorem3.p1.m9" class="ltx_Math" alttext="\phi^{\prime}(A)\in\mathbb{R}^{n\times z^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></msup></mrow><annotation encoding="application/x-tex">\phi^{\prime}(A)\in\mathbb{R}^{n\times z^{2}}</annotation></semantics></math> to denote <math id="A8.Thmtheorem3.p1.m10" class="ltx_Math" alttext="\phi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\phi^{\prime}</annotation></semantics></math> being applied to <math id="A8.Thmtheorem3.p1.m11" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> row-wisely.</span></p>
</div>
<div id="A8.Thmtheorem3.p2" class="ltx_para">
<p id="A8.Thmtheorem3.p2.1" class="ltx_p"><span id="A8.Thmtheorem3.p2.1.1" class="ltx_text ltx_font_italic">Then, with probability at least <math id="A8.Thmtheorem3.p2.m1" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, we have</span></p>
<table id="A8.EGx141" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex295"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex295.m1" class="ltx_Math" alttext="\displaystyle\left\|\left(U_{1}U_{2}^{\top}\right)^{\circ p}-\phi^{\prime}(U_{1})\phi^{\prime}(U_{2})^{\top}\right\|_{\infty}\leq\max_{i,j\in[n]}\left\{\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p}\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mn>2</mn><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>p</mi></mrow></msup><mo>−</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><munder><mi>max</mi><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\left(U_{1}U_{2}^{\top}\right)^{\circ p}-\phi^{\prime}(U_{1})\phi^{\prime}(U_{2})^{\top}\right\|_{\infty}\leq\max_{i,j\in[n]}\left\{\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A8.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A8.SS3.p2" class="ltx_para">
<p id="A8.SS3.p2.1" class="ltx_p"><span id="A8.SS3.p2.1.1" class="ltx_text">By Lemma <a href="#A8.Thmtheorem2" title="Lemma H.2 (Pointwise Approximation of Polynomial Kernel via Sketching). ‣ H.2 Pointwise Approximation of Polynomial Kernel via Sketching ‣ Appendix H SKETCHING REDUCES THE TIME COMPLEXITY OF POLYNOMIAL ATTENTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.2</span></a>, we know that for each <math id="A8.SS3.p2.m1" class="ltx_Math" alttext="i,j\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[n]</annotation></semantics></math>, the randomized mapping <math id="A8.SS3.p2.m2" class="ltx_Math" alttext="\phi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\phi^{\prime}</annotation></semantics></math> satisfies</span></p>
<table id="A8.EGx142" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex296"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex296.m1" class="ltx_math_unparsed" alttext="\displaystyle\Pr\left[\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|&gt;\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p}\cdot\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p}\right]\leq\delta^{\prime}," display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mrow><mo>[</mo><mo fence="false" rspace="0.167em">|</mo><mrow><mo>⟨</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow><mo>,</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow><mo>⟩</mo></mrow><mo>−</mo><msup><mrow><mo>⟨</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>⟩</mo></mrow><mi>p</mi></msup><mo fence="false">|</mo><mo lspace="0.167em">&gt;</mo><mi>ϵ</mi><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo rspace="0.055em">‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup><mo rspace="0.222em">⋅</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup><mo>]</mo></mrow><mo>≤</mo><msup><mi>δ</mi><mo>′</mo></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Pr\left[\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|&gt;\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p}\cdot\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p}\right]\leq\delta^{\prime},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS3.p2.2" class="ltx_p"><span id="A8.SS3.p2.2.1" class="ltx_text">for some small <math id="A8.SS3.p2.m3" class="ltx_Math" alttext="\delta^{\prime}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta^{\prime}\in(0,1)</annotation></semantics></math>.</span></p>
</div>
<div id="A8.SS3.p3" class="ltx_para">
<p id="A8.SS3.p3.1" class="ltx_p"><span id="A8.SS3.p3.1.1" class="ltx_text">Since <math id="A8.SS3.p3.m1" class="ltx_Math" alttext="i,j\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[n]</annotation></semantics></math>, we have <math id="A8.SS3.p3.m2" class="ltx_Math" alttext="n^{2}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mn>2</mn></msup><annotation encoding="application/x-tex">n^{2}</annotation></semantics></math> total pairs <math id="A8.SS3.p3.m3" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math>. Applying the union bound (see Fact <a href="#A10.Thmtheorem8" title="Fact J.8 (Union Bound). ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.8</span></a>) over all <math id="A8.SS3.p3.m4" class="ltx_Math" alttext="i,j\in[n]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[n]</annotation></semantics></math>, we have</span></p>
<table id="A8.EGx143" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex297"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex297.m1" class="ltx_Math" alttext="\displaystyle~\Pr\left[\exists i,j\in[n],\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|&gt;\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p}\cdot\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p}\right]" display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo rspace="0.167em">∃</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo>|</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo>−</mo><msup><mrow><mo>⟨</mo><mrow><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>⟩</mo></mrow><mi>p</mi></msup></mrow><mo>|</mo></mrow><mo>&gt;</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo rspace="0.055em">‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup></mrow><mo rspace="0.222em">⋅</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\Pr\left[\exists i,j\in[n],\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|&gt;\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p}\cdot\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex298"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex298.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex298.m2" class="ltx_Math" alttext="\displaystyle~n^{2}\cdot\delta^{\prime}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>δ</mi><mo>′</mo></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~n^{2}\cdot\delta^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A8.SS3.p4" class="ltx_para">
<p id="A8.SS3.p4.1" class="ltx_p"><span id="A8.SS3.p4.1.1" class="ltx_text">Setting <math id="A8.SS3.p4.m1" class="ltx_Math" alttext="\delta^{\prime}=\delta/n^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>δ</mi><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\delta^{\prime}=\delta/n^{2}</annotation></semantics></math>, we can get that, with probability at least <math id="A8.SS3.p4.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</span></p>
<table id="A8.EGx144" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.E24.m1" class="ltx_Math" alttext="\displaystyle\max_{i,j\in[n]}\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|\leq\max_{i,j\in[n]}\left\{\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p}\cdot\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p}\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>max</mi><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo>|</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo>−</mo><msup><mrow><mo>⟨</mo><mrow><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>⟩</mo></mrow><mi>p</mi></msup></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><munder><mi>max</mi><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo rspace="0.055em">‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup></mrow><mo rspace="0.222em">⋅</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><mi>p</mi></msubsup></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\max_{i,j\in[n]}\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|\leq\max_{i,j\in[n]}\left\{\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{p}\cdot\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{p}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
</div>
<div id="A8.SS3.p5" class="ltx_para">
<p id="A8.SS3.p5.1" class="ltx_p"><span id="A8.SS3.p5.1.1" class="ltx_text">On the other hand, we have</span></p>
<table id="A8.EGx145" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex299"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex299.m2" class="ltx_Math" alttext="\displaystyle~\max_{i,j\in[n]}\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo>|</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo>−</mo><msup><mrow><mo>⟨</mo><mrow><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>⟩</mo></mrow><mi>p</mi></msup></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\max_{i,j\in[n]}\left|\left\langle\phi^{\prime}\left(\left(U_{1}\right)_{i,*}\right),\phi^{\prime}\left(\left(U_{2}\right)_{j,*}\right)\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex300"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex300.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex300.m2" class="ltx_Math" alttext="\displaystyle~\max_{i,j\in[n]}\left|\left\langle\phi^{\prime}\left(U_{1}\right)_{i,*},\phi^{\prime}\left(U_{2}\right)_{j,*}\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo>|</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>,</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow></mrow><mo>⟩</mo></mrow><mo>−</mo><msup><mrow><mo>⟨</mo><mrow><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>⟩</mo></mrow><mi>p</mi></msup></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\max_{i,j\in[n]}\left|\left\langle\phi^{\prime}\left(U_{1}\right)_{i,*},\phi^{\prime}\left(U_{2}\right)_{j,*}\right\rangle-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex301"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex301.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex301.m2" class="ltx_Math" alttext="\displaystyle~\max_{i,j\in[n]}\left|\left(\phi^{\prime}\left(U_{1}\right)\phi^{\prime}\left(U_{2}\right)^{\top}\right)_{i,j}-\left(\left(U_{1}\right)\left(U_{2}^{\top}\right)\right)_{i,j}^{p}\right|" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo>|</mo><mrow><msub><mrow><mo>(</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msubsup><mrow><mo>(</mo><mrow><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mo>⊤</mo></msubsup><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>p</mi></msubsup></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\max_{i,j\in[n]}\left|\left(\phi^{\prime}\left(U_{1}\right)\phi^{\prime}\left(U_{2}\right)^{\top}\right)_{i,j}-\left(\left(U_{1}\right)\left(U_{2}^{\top}\right)\right)_{i,j}^{p}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex302"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex302.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex302.m2" class="ltx_Math" alttext="\displaystyle~\max_{i,j\in[n]}\left|\phi^{\prime}\left(U_{1}\right)\phi^{\prime}\left(U_{2}\right)^{\top}-\left(\left(U_{1}\right)\left(U_{2}^{\top}\right)\right)^{\circ p}\right|_{i,j}" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><msub><mrow><mo>|</mo><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>−</mo><msup><mrow><mo>(</mo><mrow><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mo>⊤</mo></msubsup><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>p</mi></mrow></msup></mrow><mo>|</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle~\max_{i,j\in[n]}\left|\phi^{\prime}\left(U_{1}\right)\phi^{\prime}\left(U_{2}\right)^{\top}-\left(\left(U_{1}\right)\left(U_{2}^{\top}\right)\right)^{\circ p}\right|_{i,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.E25.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.E25.m2" class="ltx_Math" alttext="\displaystyle~\left\|\left(U_{1}U_{2}^{\top}\right)^{\circ p}-\phi^{\prime}(U_{1})\phi^{\prime}(U_{2})^{\top}\right\|_{\infty}," display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>U</mi><mn>2</mn><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>p</mi></mrow></msup><mo>−</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\left\|\left(U_{1}U_{2}^{\top}\right)^{\circ p}-\phi^{\prime}(U_{1})\phi^{\prime}(U_{2})^{\top}\right\|_{\infty},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A8.SS3.p5.2" class="ltx_p"><span id="A8.SS3.p5.2.1" class="ltx_text">where the first step follows from the fact that <math id="A8.SS3.p5.m1" class="ltx_Math" alttext="\phi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\phi^{\prime}</annotation></semantics></math> is applied row-wisely, the second step follows from the definition of matrix multiplication, and the last step follows from the definition of <math id="A8.SS3.p5.m2" class="ltx_Math" alttext="\ell_{\infty}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\ell_{\infty}</annotation></semantics></math> norm.</span></p>
</div>
<div id="A8.SS3.p6" class="ltx_para">
<p id="A8.SS3.p6.1" class="ltx_p"><span id="A8.SS3.p6.1.1" class="ltx_text">Finally, we consider the sketch size. By Lemma <a href="#A8.Thmtheorem2" title="Lemma H.2 (Pointwise Approximation of Polynomial Kernel via Sketching). ‣ H.2 Pointwise Approximation of Polynomial Kernel via Sketching ‣ Appendix H SKETCHING REDUCES THE TIME COMPLEXITY OF POLYNOMIAL ATTENTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.2</span></a>, to get pointwise approximation to the polynomial kernel, we need</span></p>
<table id="A8.EGx146" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex303"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex303.m1" class="ltx_Math" alttext="\displaystyle\Theta\left(p\epsilon^{-2}\log(1/\delta^{\prime})\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>δ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Theta\left(p\epsilon^{-2}\log(1/\delta^{\prime})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A8.SS3.p7" class="ltx_para">
<p id="A8.SS3.p7.1" class="ltx_p"><span id="A8.SS3.p7.1.1" class="ltx_text">Now, since we use union bound and setting <math id="A8.SS3.p7.m1" class="ltx_Math" alttext="\delta^{\prime}=\delta/n^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>δ</mi><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\delta^{\prime}=\delta/n^{2}</annotation></semantics></math>, we can get the sketch size</span></p>
<table id="A8.EGx147" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex304"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex304.m1" class="ltx_Math" alttext="\displaystyle z=" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle z=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex304.m2" class="ltx_Math" alttext="\displaystyle~\Theta\left(p\epsilon^{-2}\log(1/\left(\delta/n^{2}\right))\right)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo>(</mo><mrow><mi>δ</mi><mo>/</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\Theta\left(p\epsilon^{-2}\log(1/\left(\delta/n^{2}\right))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.E26.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.E26.m2" class="ltx_Math" alttext="\displaystyle~\Theta\left(p\epsilon^{-2}\log(n/\delta)\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\Theta\left(p\epsilon^{-2}\log(n/\delta)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
</div>
<div id="A8.SS3.p8" class="ltx_para">
<p id="A8.SS3.p8.1" class="ltx_p"><span id="A8.SS3.p8.1.1" class="ltx_text">Combining Eq. (<a href="#A8.E24" title="In Proof. ‣ H.3 Union Bound to All Entries ‣ Appendix H SKETCHING REDUCES THE TIME COMPLEXITY OF POLYNOMIAL ATTENTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>), (<a href="#A8.Ex299" title="In Proof. ‣ H.3 Union Bound to All Entries ‣ Appendix H SKETCHING REDUCES THE TIME COMPLEXITY OF POLYNOMIAL ATTENTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>), and (<a href="#A8.Ex304" title="In Proof. ‣ H.3 Union Bound to All Entries ‣ Appendix H SKETCHING REDUCES THE TIME COMPLEXITY OF POLYNOMIAL ATTENTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>), we finish the proof.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A9" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix I </span>ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING</h2>

<div id="A9.p1" class="ltx_para">
<p id="A9.p1.1" class="ltx_p">Now, we combine everything together and present our main result using multi-threshold support basis.</p>
</div>
<div id="A9.p2" class="ltx_para">
<p id="A9.p2.1" class="ltx_p">In Appendix <a href="#A9.SS1" title="I.1 A Basic Definition ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.1</span></a>, we give a basic definition. In Appendix <a href="#A9.SS2" title="I.2 (𝑄,𝐾)-Softmax-Attention Matrix Approximation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.2</span></a>, we approximate the <math id="A9.p2.m1" class="ltx_Math" alttext="\left(Q,K\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mi>Q</mi><mo>,</mo><mi>K</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(Q,K\right)</annotation></semantics></math>-softmax-attention matrix using multi-threshold support basis decomposition and sketching. In Appendix <a href="#A9.SS3" title="I.3 Running Time Analysis of Constructing ϕ^′⁢(𝑈_1^(ℓ,ℓ^′)) and ϕ^′⁢(𝑈_2^(ℓ,ℓ^′)) ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.3</span></a>, we analyze the running time for constructing <math id="A9.p2.m2" class="ltx_Math" alttext="\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math> and <math id="A9.p2.m3" class="ltx_Math" alttext="\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)</annotation></semantics></math>. In Appendix <a href="#A9.SS4" title="I.4 (Batch) Gaussian Kernel Density Estimation ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.4</span></a>, we solve the batch Gaussian kernel density estimation problem (see Definition <a href="#A2.Thmtheorem10" title="Definition B.10 ((Batch) Gaussian kernel density estimation). ‣ B.5 (Batch) Gaussian Kernel Density Estimation ‣ Appendix B (BATCH) GAUSSIAN KERNEL DENSITY ESTIMATION VIA SINGLE THRESHOLD SUPPORT BASIS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.10</span></a>) using multi-threshold support basis decomposition. Finally, in Appendix <a href="#A9.SS5" title="I.5 Main Result ‣ Appendix I ATTENTION OPTIMIZATION VIA MULTI-THRESHOLD SUPPORT BASIS AND SKETCHING ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I.5</span></a>, we present our main theorem, which states the running time and correctness of approximating the attention computation problem (see Definition <a href="#S1.Thmtheorem3" title="Definition 1.3 (The approximate attention computation). ‣ 1.2 Background ‣ 1 INTRODUCTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.3</span></a>) using multi-threshold support basis decomposition and sketching.</p>
</div>
<section id="A9.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">I.1 </span>A Basic Definition</h3>

<div id="A9.SS1.p1" class="ltx_para">
<p id="A9.SS1.p1.1" class="ltx_p">In this section, we provide basic definitions and clarify the meaning of all notation. We note that in previous sections, some notational abuse may have occurred—for example, the symbol <math id="A9.SS1.p1.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> may have been used both as the accuracy parameter for sketching and as the bucketing parameter. Our goal here is to unify all theoretical results to derive the main result. Therefore, we redefine the relevant notations to improve clarity.</p>
</div>
<div id="A9.Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A9.Thmtheorem1.2" class="ltx_text ltx_font_bold">Definition I.1</span></span><span id="A9.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A9.Thmtheorem1.p1" class="ltx_para">
<p id="A9.Thmtheorem1.p1.1" class="ltx_p"><span id="A9.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Given the query and the key matrices <math id="A9.Thmtheorem1.p1.m1" class="ltx_Math" alttext="Q,K\in\mathbb{R}^{n\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>,</mo><mi>K</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Q,K\in\mathbb{R}^{n\times d}</annotation></semantics></math>, we define the <math id="A9.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\left(Q,K\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mi>Q</mi><mo>,</mo><mi>K</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(Q,K\right)</annotation></semantics></math>-softmax-attention matrix <math id="A9.Thmtheorem1.p1.m3" class="ltx_Math" alttext="A=\exp(QK^{\top}/d)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A=\exp(QK^{\top}/d)</annotation></semantics></math> as in Definition <a href="#S1.Thmtheorem1" title="Definition 1.1 ((𝑄,𝐾)-softmax-attention matrix). ‣ 1.1 Problem Formulation ‣ 1 INTRODUCTION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>. Let <math id="A9.Thmtheorem1.p1.m4" class="ltx_Math" alttext="Q=\sum_{\ell=1}^{m}Q^{\left(T_{\ell}\right)}\in\mathbb{R}^{n\times d}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mi>Q</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>)</mo></mrow></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Q=\sum_{\ell=1}^{m}Q^{\left(T_{\ell}\right)}\in\mathbb{R}^{n\times d}</annotation></semantics></math> and <math id="A9.Thmtheorem1.p1.m5" class="ltx_Math" alttext="K=\sum_{\ell^{\prime}=1}^{m}K^{\left(T_{\ell^{\prime}}\right)}\in\mathbb{R}^{n\times d}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mi>K</mi><mrow><mo>(</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">K=\sum_{\ell^{\prime}=1}^{m}K^{\left(T_{\ell^{\prime}}\right)}\in\mathbb{R}^{n\times d}</annotation></semantics></math> be defined as in Definition <a href="#A7.Thmtheorem1" title="Definition G.1. ‣ G.1 Thresholds for Support Basis ‣ Appendix G THRESHOLD VALUES SPECIFICATION AND INTERVAL-BASED FACTORIZATION ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.1</span></a>, with <math id="A9.Thmtheorem1.p1.m6" class="ltx_Math" alttext="b=\min_{i\in[n],j\in[d]}\left\{|Q_{i,j}|,|K_{i,j}|\right\}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><msub><mi>min</mi><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mo>⁡</mo><mrow><mo>{</mo><mrow><mo stretchy="false">|</mo><msub><mi>Q</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>,</mo><mrow><mo stretchy="false">|</mo><msub><mi>K</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b=\min_{i\in[n],j\in[d]}\left\{|Q_{i,j}|,|K_{i,j}|\right\}</annotation></semantics></math>, <math id="A9.Thmtheorem1.p1.m7" class="ltx_Math" alttext="B=\max_{i\in[n],j\in[d]}\left\{|Q_{i,j}|,|K_{i,j}|\right\}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><msub><mi>max</mi><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mo>⁡</mo><mrow><mo>{</mo><mrow><mo stretchy="false">|</mo><msub><mi>Q</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>,</mo><mrow><mo stretchy="false">|</mo><msub><mi>K</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B=\max_{i\in[n],j\in[d]}\left\{|Q_{i,j}|,|K_{i,j}|\right\}</annotation></semantics></math>, and for all <math id="A9.Thmtheorem1.p1.m8" class="ltx_Math" alttext="\ell\in[m]\cup\left\{0\right\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∪</mo><mrow><mo>{</mo><mn>0</mn><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell\in[m]\cup\left\{0\right\}</annotation></semantics></math>, we let <math id="A9.Thmtheorem1.p1.m9" class="ltx_Math" alttext="T_{\ell}=b\left(1+\epsilon_{B}\right)^{\ell}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>=</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>ϵ</mi><mi>B</mi></msub></mrow><mo>)</mo></mrow><mi mathvariant="normal">ℓ</mi></msup></mrow></mrow><annotation encoding="application/x-tex">T_{\ell}=b\left(1+\epsilon_{B}\right)^{\ell}</annotation></semantics></math>, where <math id="A9.Thmtheorem1.p1.m10" class="ltx_Math" alttext="\epsilon_{B}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>B</mi></msub><annotation encoding="application/x-tex">\epsilon_{B}</annotation></semantics></math> is the bucketing parameter. Let <math id="A9.Thmtheorem1.p1.m11" class="ltx_Math" alttext="A^{\left(T_{\ell},T_{\ell^{\prime}}\right)}=Q^{\left(T_{\ell}\right)}\left(K^{\left(T_{\ell^{\prime}}\right)}\right)^{\top}=C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>Q</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msup><mi>K</mi><mrow><mo>(</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>Q</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>)</mo></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msup><mi>K</mi><mrow><mo>(</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A^{\left(T_{\ell},T_{\ell^{\prime}}\right)}=Q^{\left(T_{\ell}\right)}\left(K^{\left(T_{\ell^{\prime}}\right)}\right)^{\top}=C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}\cdot Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}\in\mathbb{R}^{n\times n}</annotation></semantics></math>. Suppose by Lemma <a href="#A1.Thmtheorem4" title="Lemma A.4 (An improved version of Lemma 3.4 in []). ‣ A.1.2 Background: Approximating the Attention Computation Assuming 𝑑=𝑂(log𝑛) and Bounded Entries ‣ A.1 Background: Technique Overview of the Polynomial Method ‣ Appendix A PRELIMINARIES ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>, there exists <math id="A9.Thmtheorem1.p1.m12" class="ltx_Math" alttext="U_{1}^{\left(\ell,\ell^{\prime}\right)},U_{2}^{\left(\ell,\ell^{\prime}\right)}\in\mathbb{R}^{n\times r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>,</mo><mrow><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">U_{1}^{\left(\ell,\ell^{\prime}\right)},U_{2}^{\left(\ell,\ell^{\prime}\right)}\in\mathbb{R}^{n\times r}</annotation></semantics></math> such that <math id="A9.Thmtheorem1.p1.m13" class="ltx_Math" alttext="U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}</annotation></semantics></math> is the <math id="A9.Thmtheorem1.p1.m14" class="ltx_Math" alttext="\left(\epsilon_{0},r\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo>,</mo><mi>r</mi><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\epsilon_{0},r\right)</annotation></semantics></math>-approximation of <math id="A9.Thmtheorem1.p1.m15" class="ltx_Math" alttext="\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>Q</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msup><mi>K</mi><mrow><mo>(</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}\right)</annotation></semantics></math>. Let <math id="A9.Thmtheorem1.p1.m16" class="ltx_Math" alttext="\phi^{\prime}:\mathbb{R}^{d}\to\mathbb{R}^{r^{2}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msup><mi>r</mi><mn>2</mn></msup></msup></mrow></mrow><annotation encoding="application/x-tex">\phi^{\prime}:\mathbb{R}^{d}\to\mathbb{R}^{r^{2}}</annotation></semantics></math> be defined as <math id="A9.Thmtheorem1.p1.m17" class="ltx_Math" alttext="\phi^{\prime}\left(q_{i}\right):=\left(Sq_{i}^{\otimes\left(p/2\right)}\right)^{\otimes 2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>q</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mo>:=</mo><msup><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>i</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msubsup></mrow><mo>)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\phi^{\prime}\left(q_{i}\right):=\left(Sq_{i}^{\otimes\left(p/2\right)}\right)^{\otimes 2}</annotation></semantics></math>, where <math id="A9.Thmtheorem1.p1.m18" class="ltx_Math" alttext="S\in\mathbb{R}^{r\times d^{p/2}}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>d</mi><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></msup></mrow><annotation encoding="application/x-tex">S\in\mathbb{R}^{r\times d^{p/2}}</annotation></semantics></math> with <math id="A9.Thmtheorem1.p1.m19" class="ltx_Math" alttext="r=\Theta\left(p\epsilon^{-2}\log(1/\delta)\right)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r=\Theta\left(p\epsilon^{-2}\log(1/\delta)\right)</annotation></semantics></math> is a sketching matrix. With <math id="A9.Thmtheorem1.p1.m20" class="ltx_Math" alttext="\epsilon,\epsilon_{0}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>,</mo><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon,\epsilon_{0}\in(0,1)</annotation></semantics></math>, we let</span></p>
<table id="A9.EGx148" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A9.Ex305"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.Ex305.m1" class="ltx_Math" alttext="\displaystyle\epsilon_{2}:=O\left(\frac{B^{2}}{\log n}e^{o\left(B^{2}\right)}\epsilon_{0}+\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\max_{i,j\in[n]}\left\{\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϵ</mi><mn>2</mn></msub><mo>:=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>B</mi><mn>2</mn></msup><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>B</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><munder><mi>max</mi><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>‖</mo></mrow><mn>2</mn><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></msubsup></mrow><mo>}</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon_{2}:=O\left(\frac{B^{2}}{\log n}e^{o\left(B^{2}\right)}\epsilon_{0}+\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\max_{i,j\in[n]}\left\{\epsilon\left\|\left(U_{1}\right)_{i,*}\right\|_{2}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\left\|\left(U_{2}\right)_{j,*}\right\|_{2}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right\}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
