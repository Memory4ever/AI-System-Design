<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A9.E42.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.E42.m2" class="ltx_Math" alttext="\displaystyle~\left\|D^{-1}AV-D^{-1}\widetilde{A}V\right\|_{\infty}+\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>D</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\left\|D^{-1}AV-D^{-1}\widetilde{A}V\right\|_{\infty}+\left\|D^{-1}\widetilde{A}V-\widetilde{D}^{-1}\widetilde{A}V\right\|_{\infty}.</annotation></semantics></math></td>
