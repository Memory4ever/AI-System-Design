<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex232.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex232.m2" class="ltx_Math" alttext="\displaystyle~\sum_{i=1}^{n}\sum_{j=1}^{n}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)_{i,j}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}-\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)_{i,j}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><msubsup><mrow><mo>(</mo><mrow><mrow><msup><mi>Q</mi><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msup><mi>K</mi><mrow><mo>(</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>/</mo><mi>d</mi></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></msubsup></mrow><mo>−</mo><msubsup><mrow><mo>(</mo><mrow><msubsup><mi>U</mi><mn>1</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi>U</mi><mn>2</mn><mrow><mo>(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><msup><mi>C</mi><mrow><mo>(</mo><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>T</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo>)</mo></mrow></msup></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\sum_{i=1}^{n}\sum_{j=1}^{n}\sum_{\ell=1}^{m}\sum_{\ell^{\prime}=1}^{m}\left(\exp\left(Q^{\left(\ell\right)}\left(K^{\left(\ell^{\prime}\right)}\right)^{\top}/d\right)_{i,j}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}-\left(U_{1}^{\left(\ell,\ell^{\prime}\right)}\left(U_{2}^{\left(\ell,\ell^{\prime}\right)}\right)^{\top}\right)_{i,j}^{C^{\left(T_{\ell},T_{\ell^{\prime}}\right)}}\right)</annotation></semantics></math></td>
