<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A10.Ex409.m2" class="ltx_Math" alttext="\displaystyle~\frac{cb^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-cb^{2}\left(1+\epsilon\right)^{y+1}e^{b^{2}c(\epsilon+1)^{y+1}}-e^{b^{2}c(\epsilon+1)^{y+m+1}}+e^{b^{2}c(\epsilon+1)^{y+1}}}{c^{2}\log^{2}n\log(\epsilon+1)}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>−</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mo>+</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\frac{cb^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}-cb^{2}\left(1+\epsilon\right)^{y+1}e^{b^{2}c(\epsilon+1)^{y+1}}-e^{b^{2}c(\epsilon+1)^{y+m+1}}+e^{b^{2}c(\epsilon+1)^{y+1}}}{c^{2}\log^{2}n\log(\epsilon+1)}.</annotation></semantics></math></td>
