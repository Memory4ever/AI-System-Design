<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex282.m2" class="ltx_Math" alttext="\displaystyle~\left|\left(S\left(U_{1}\right)_{i,*}^{\otimes\left(p/2\right)}\right)^{\top}\left(S\left(U_{2}\right)_{j,*}^{\otimes\left(p/2\right)}\right)-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p/2}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msubsup></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>−</mo><msup><mrow><mo>⟨</mo><mrow><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>⟩</mo></mrow><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\left|\left(S\left(U_{1}\right)_{i,*}^{\otimes\left(p/2\right)}\right)^{\top}\left(S\left(U_{2}\right)_{j,*}^{\otimes\left(p/2\right)}\right)-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p/2}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex283"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex283.m1" class="ltx_Math" alttext="\displaystyle\cdot" display="inline" intent=":literal"><semantics><mo>⋅</mo><annotation encoding="application/x-tex">\displaystyle\cdot</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex283.m2" class="ltx_Math" alttext="\displaystyle~\left|\left(S\left(U_{1}\right)_{i,*}^{\otimes\left(p/2\right)}\right)^{\top}\left(S\left(U_{2}\right)_{j,*}^{\otimes\left(p/2\right)}\right)+\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p/2}\right|," display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msubsup></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><msup><mrow><mo>⟨</mo><mrow><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>⟩</mo></mrow><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>|</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\left|\left(S\left(U_{1}\right)_{i,*}^{\otimes\left(p/2\right)}\right)^{\top}\left(S\left(U_{2}\right)_{j,*}^{\otimes\left(p/2\right)}\right)+\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p/2}\right|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS2.p2.2" class="ltx_p"><span id="A8.SS2.p2.2.1" class="ltx_text">where the first step follows from the definition of <math id="A8.SS2.p2.m1" class="ltx_Math" alttext="\phi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\phi^{\prime}</annotation></semantics></math> (see from the lemma statement), the second step follows from <span id="A8.SS2.p2.2.1.1" class="ltx_text ltx_font_bold">Part 1</span> of Fact <a href="#A10.Thmtheorem6" title="Fact J.6. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.6</span></a>, the third step follows from <math id="A8.SS2.p2.m2" class="ltx_Math" alttext="\left\langle a,b\right\rangle=a^{\top}b" display="inline" intent=":literal"><semantics><mrow><mrow><mo>⟨</mo><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>⟩</mo></mrow><mo>=</mo><mrow><msup><mi>a</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">\left\langle a,b\right\rangle=a^{\top}b</annotation></semantics></math> (see Fact <a href="#A10.Thmtheorem3" title="Fact J.3. ‣ Appendix J MORE FACTS ‣ Support Basis: Fast Attention Beyond Bounded Entries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J.3</span></a>), and the last step follows from <math id="A8.SS2.p2.m3" class="ltx_Math" alttext="a^{2}-b^{2}=(a+b)(a-b)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>−</mo><msup><mi>b</mi><mn>2</mn></msup></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a^{2}-b^{2}=(a+b)(a-b)</annotation></semantics></math>.</span></p>
</div>
<div id="A8.SS2.p3" class="ltx_para">
<p id="A8.SS2.p3.1" class="ltx_p"><span id="A8.SS2.p3.1.1" class="ltx_text">Considering <math id="A8.SS2.p3.m1" class="ltx_Math" alttext="\left|\left(S\left(U_{1}\right)_{i,*}^{\otimes\left(p/2\right)}\right)^{\top}\left(S\left(U_{2}\right)_{j,*}^{\otimes\left(p/2\right)}\right)-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p/2}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msubsup></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo>(</mo><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>−</mo><msup><mrow><mo>⟨</mo><mrow><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>1</mn></msub><mo>)</mo></mrow><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub><mo>,</mo><msub><mrow><mo>(</mo><msub><mi>U</mi><mn>2</mn></msub><mo>)</mo></mrow><mrow><mi>j</mi><mo rspace="0em">,</mo><mo lspace="0em">∗</mo></mrow></msub></mrow><mo>⟩</mo></mrow><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\left|\left(S\left(U_{1}\right)_{i,*}^{\otimes\left(p/2\right)}\right)^{\top}\left(S\left(U_{2}\right)_{j,*}^{\otimes\left(p/2\right)}\right)-\left\langle\left(U_{1}\right)_{i,*},\left(U_{2}\right)_{j,*}\right\rangle^{p/2}\right|</annotation></semantics></math>, with probability <math id="A8.SS2.p3.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, we have</span></p>
<table id="A8.EGx138" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

