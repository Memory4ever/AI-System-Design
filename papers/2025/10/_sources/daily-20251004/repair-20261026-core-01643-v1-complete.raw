<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex243.m2" class="ltx_Math" alttext="\displaystyle~O\left(\int_{1}^{m+1}\frac{b^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}}{c\log^{2}\left(n\right)\log\left({\epsilon}+1\right)}\,\mathrm{d}y\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>1</mn><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>y</mi><mo>+</mo><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></msup></mrow><mrow><mi>c</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo>(</mo><mi>n</mi><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>ϵ</mi><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>y</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~O\left(\int_{1}^{m+1}\frac{b^{2}\left(1+\epsilon\right)^{y+m+1}e^{b^{2}c(\epsilon+1)^{y+m+1}}}{c\log^{2}\left(n\right)\log\left({\epsilon}+1\right)}\,\mathrm{d}y\right)</annotation></semantics></math></td>
