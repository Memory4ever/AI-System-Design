</span></span><span id="S5.T1.3.1.4.3" class="ltx_text"></span></td></tr>
<tr id="S5.T1.3.2" class="ltx_tr">
<td id="S5.T1.3.2.1" class="ltx_td ltx_align_center ltx_border_t">0</td>
<td id="S5.T1.3.2.2" class="ltx_td ltx_align_center ltx_border_t">0.0</td>
<td id="S5.T1.3.2.3" class="ltx_td ltx_align_center ltx_border_t">0.00</td>
<td id="S5.T1.3.2.4" class="ltx_td ltx_align_center ltx_border_t">0.00</td></tr>
<tr id="S5.T1.3.3" class="ltx_tr">
<td id="S5.T1.3.3.1" class="ltx_td ltx_align_center">1</td>
