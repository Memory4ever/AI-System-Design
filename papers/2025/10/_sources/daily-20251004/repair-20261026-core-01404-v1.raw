</span></span><span id="S5.T1.3.1.3.3" class="ltx_text"></span></td>
<td id="S5.T1.3.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.3.1.4.1" class="ltx_text"></span> <span id="S5.T1.3.1.4.2" class="ltx_text">
<span id="S5.T1.3.1.4.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.3.1.4.2.1.1" class="ltx_tr">
