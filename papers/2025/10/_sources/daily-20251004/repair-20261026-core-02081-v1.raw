<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex38.m1" class="ltx_math_unparsed" alttext="\displaystyle-2\sum_{j=1}^{M}\xi^{\top}W_{j}^{\top}\left(\Omega_{j}-\theta L^{j}\right)f_{j}(W_{j}\xi)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msup><mi>ξ</mi><mo>⊤</mo></msup><msubsup><mi>W</mi><mi>j</mi><mo>⊤</mo></msubsup><mrow><mo>(</mo><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub><mo>−</mo><mi>θ</mi><msup><mi>L</mi><mi>j</mi></msup><mo>)</mo></mrow><msub><mi>f</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>j</mi></msub><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-2\sum_{j=1}^{M}\xi^{\top}W_{j}^{\top}\left(\Omega_{j}-\theta L^{j}\right)f_{j}(W_{j}\xi)</annotation></semantics></math></td>
