<td id="A4.T2.2.1.3.1" class="ltx_td ltx_align_left">Franka Kitchen</td>
<td id="A4.T2.2.1.3.2" class="ltx_td ltx_align_right">1</td>
<td id="A4.T2.2.1.3.3" class="ltx_td ltx_align_right">7</td>
