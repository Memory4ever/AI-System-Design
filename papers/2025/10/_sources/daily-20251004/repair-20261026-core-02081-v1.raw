<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex31.m1" class="ltx_math_unparsed" alttext="\displaystyle+\gamma\sum_{j=1}^{M}p_{j}(x,\xi)^{\top}p_{j}(x,\xi)+\theta\sum_{j=1}^{M}f_{j}^{\top}(W_{j}\xi)f_{j}(W_{j}\xi)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>γ</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msub><mi>p</mi><mi>j</mi></msub><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msub><mi>p</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>θ</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msubsup><mi>f</mi><mi>j</mi><mo>⊤</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>j</mi></msub><mi>ξ</mi><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>j</mi></msub><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\gamma\sum_{j=1}^{M}p_{j}(x,\xi)^{\top}p_{j}(x,\xi)+\theta\sum_{j=1}^{M}f_{j}^{\top}(W_{j}\xi)f_{j}(W_{j}\xi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\displaystyle-\xi^{\top}\tilde{\Xi}^{0}\xi-2\sum_{j=1}^{M}\xi^{\top}W_{j}^{\top}\Gamma_{j}p_{j}(x,\xi)-2\sum_{j=1}^{M}\xi^{\top}W_{j}^{\top}\Omega_{j}f_{j}(W_{j}\xi)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><msup><mi>ξ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathvariant="normal">Ξ</mi><mo>~</mo></mover><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><msup><mi>ξ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Γ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><msup><mi>ξ</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\xi^{\top}\tilde{\Xi}^{0}\xi-2\sum_{j=1}^{M}\xi^{\top}W_{j}^{\top}\Gamma_{j}p_{j}(x,\xi)-2\sum_{j=1}^{M}\xi^{\top}W_{j}^{\top}\Omega_{j}f_{j}(W_{j}\xi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_math_unparsed" alttext="\displaystyle-2\sum_{j=1}^{M}\sum_{r=1}^{M}p_{j}(x,\xi)^{\top}W_{j}^{\top}W_{j}\tilde{\Upsilon}_{j,r}W_{r}^{\top}W_{r}f_{r}(W_{r}\xi)." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msub><mi>p</mi><mi>j</mi></msub><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msubsup><mi>W</mi><mi>j</mi><mo>⊤</mo></msubsup><msub><mi>W</mi><mi>j</mi></msub><msub><mover accent="true"><mi mathvariant="normal">Υ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>r</mi></mrow></msub><msubsup><mi>W</mi><mi>r</mi><mo>⊤</mo></msubsup><msub><mi>W</mi><mi>r</mi></msub><msub><mi>f</mi><mi>r</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>r</mi></msub><mi>ξ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-2\sum_{j=1}^{M}\sum_{r=1}^{M}p_{j}(x,\xi)^{\top}W_{j}^{\top}W_{j}\tilde{\Upsilon}_{j,r}W_{r}^{\top}W_{r}f_{r}(W_{r}\xi).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmrefproofx2.p1.3" class="ltx_p">Then, under Lemma <a href="#Thmlem2" title="Lemma 2. ‣ B.4 Proof of Theorem ‣ Appendix B Theorem Proofs ‣ Fine-Tuning Flow Matching via Maximum Likelihood Estimation of Reconstructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, it can be deduced that</p>
