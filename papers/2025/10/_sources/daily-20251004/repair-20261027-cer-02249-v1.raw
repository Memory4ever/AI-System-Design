</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F3.fig3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02249v1/qwen3_4b_length_min.svg" id="S4.F3.g3" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/348;" width="548" height="348"></object>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F3.fig4" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02249v1/qwen3_8b_clip_ratio.svg" id="S4.F3.g4" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/348;" width="548" height="348"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F3.fig5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02249v1/qwen3_8b_length_avg.svg" id="S4.F3.g5" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/348;" width="548" height="348"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F3.fig6" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02249v1/qwen3_8b_length_min.svg" id="S4.F3.g6" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/348;" width="548" height="348"></object>
</figure></div></div>
