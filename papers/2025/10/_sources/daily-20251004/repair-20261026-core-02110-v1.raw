<tr id="S4.T1.14.1.5" class="ltx_tr">
<th id="S4.T1.14.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">VAE-Reconstruction</th>
<td id="S4.T1.14.1.5.2" class="ltx_td ltx_align_center">2/48kHz</td>
<td id="S4.T1.14.1.5.3" class="ltx_td ltx_align_center">33.0</td>
