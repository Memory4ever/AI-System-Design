<td id="A3.T7.2.1.6.3" class="ltx_td ltx_align_center"><span id="A3.T7.2.1.6.3.1" class="ltx_text ltx_underline">35.5</span></td>
<td id="A3.T7.2.1.6.4" class="ltx_td ltx_align_center"><span id="A3.T7.2.1.6.4.1" class="ltx_text ltx_underline">0.628</span></td>
<td id="A3.T7.2.1.6.5" class="ltx_td ltx_align_center"><span id="A3.T7.2.1.6.5.1" class="ltx_text ltx_font_bold">1.25</span></td>
<td id="A3.T7.2.1.6.6" class="ltx_td ltx_align_center"><span id="A3.T7.2.1.6.6.1" class="ltx_text ltx_font_bold">1.56</span></td>
