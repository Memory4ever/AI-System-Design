<td id="A3.T7.2.1.7.2" class="ltx_td ltx_align_center ltx_border_bb">69.3</td>
<td id="A3.T7.2.1.7.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T7.2.1.7.3.1" class="ltx_text ltx_font_bold">35.1</span></td>
<td id="A3.T7.2.1.7.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T7.2.1.7.4.1" class="ltx_text ltx_font_bold">0.597</span></td>
<td id="A3.T7.2.1.7.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T7.2.1.7.5.1" class="ltx_text ltx_underline">1.29</span></td>
<td id="A3.T7.2.1.7.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T7.2.1.7.6.1" class="ltx_text ltx_font_bold">1.56</span></td>
