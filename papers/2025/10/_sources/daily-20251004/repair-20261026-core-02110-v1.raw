<th id="A3.T9.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">99 (<math id="A3.T9.m7" class="ltx_Math" alttext="80\%" display="inline" intent=":literal"><semantics><mrow><mn>80</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">80\%</annotation></semantics></math> CEV)</th>
