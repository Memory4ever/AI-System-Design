<td id="A3.T10.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="A3.T10.2.1.1.2.1" class="ltx_text">Params</span></td>
<td id="A3.T10.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt">Channels/</td>
<td id="A3.T10.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">Text</td>
<td id="A3.T10.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="A3.T10.2.1.1.5.1" class="ltx_text">FAD<math id="A3.T10.m1" class="ltx_math_unparsed" alttext="{}_{\text{PaSST}}\,\downarrow" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mtext>PaSST</mtext></msub><mo lspace="0.448em" stretchy="false">↓</mo></mrow><annotation encoding="application/x-tex">{}_{\text{PaSST}}\,\downarrow</annotation></semantics></math></span></td>
<td id="A3.T10.2.1.1.6" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="A3.T10.2.1.1.6.1" class="ltx_text">KL<math id="A3.T10.m2" class="ltx_math_unparsed" alttext="{}_{\text{PaSST}}\,\downarrow" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mtext>PaSST</mtext></msub><mo lspace="0.448em" stretchy="false">↓</mo></mrow><annotation encoding="application/x-tex">{}_{\text{PaSST}}\,\downarrow</annotation></semantics></math></span></td>
<td id="A3.T10.2.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="A3.T10.2.1.1.7.1" class="ltx_text">IB-Score <math id="A3.T10.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="A3.T10.2.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="A3.T10.2.1.1.8.1" class="ltx_text">DeSync <math id="A3.T10.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
<tr id="A3.T10.2.1.2" class="ltx_tr">
<td id="A3.T10.2.1.2.1" class="ltx_td ltx_align_center">Sample rate</td>
<td id="A3.T10.2.1.2.2" class="ltx_td ltx_align_center">condition</td></tr>
<tr id="A3.T10.2.1.3" class="ltx_tr">
<td id="A3.T10.2.1.3.1" class="ltx_td ltx_align_left ltx_border_t">Our VAE-Reconstruction</td>
<td id="A3.T10.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">–</td>
<td id="A3.T10.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">2/48kHz</td>
<td id="A3.T10.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">–</td>
<td id="A3.T10.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">57.0</td>
<td id="A3.T10.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">0.361</td>
<td id="A3.T10.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t">27.0</td>
