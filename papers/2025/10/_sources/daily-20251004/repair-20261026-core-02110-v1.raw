<td id="A3.T7.2.1.5.7" class="ltx_td ltx_align_center"><span id="A3.T7.2.1.5.7.1" class="ltx_text ltx_font_bold">0.280</span></td>
<td id="A3.T7.2.1.5.8" class="ltx_td ltx_align_center"><span id="A3.T7.2.1.5.8.1" class="ltx_text ltx_font_bold">1.03</span></td></tr>
