<span id="S5.T1.2.1.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:33.7pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:33.7pt;transform:translate(-13.4pt,-13.4pt) rotate(-90deg) ;">
<span id="S5.T1.2.1.2.1.1.1.1" class="ltx_p"><span id="S5.T1.2.1.2.1.1.1.1.1" class="ltx_text ltx_font_bold">SD 3.5</span></span>
</span></span></span></th>
<th id="S5.T1.2.1.2.2" class="ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.25pt 4.3pt;">Base</th>
<td id="S5.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 4.3pt;">0.3474<math id="S5.T1.m12" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.03</td>
<td id="S5.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 4.3pt;">0.2309<math id="S5.T1.m13" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.05</td>
