<td id="S5.T3.2.1.5.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5E5D6;"><span id="S5.T3.2.1.5.3.1" class="ltx_text" style="--ltx-bg-color:#F5E5D6;">1520</span></td>
