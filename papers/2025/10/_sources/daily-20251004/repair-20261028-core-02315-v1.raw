<td id="S5.T2.2.1.5.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5E5D6;"><span id="S5.T2.2.1.5.5.1" class="ltx_text" style="--ltx-bg-color:#F5E5D6;">1498</span></td></tr>
