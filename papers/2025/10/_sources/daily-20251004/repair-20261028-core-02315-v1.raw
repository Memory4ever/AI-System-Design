<td id="S5.T3.2.1.4.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2F2F2;"><span id="S5.T3.2.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">1584</span></td>
<td id="S5.T3.2.1.4.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5E5D6;"><span id="S5.T3.2.1.4.4.1" class="ltx_text" style="--ltx-bg-color:#F5E5D6;">50%</span></td>
<td id="S5.T3.2.1.4.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5E5D6;"><span id="S5.T3.2.1.4.5.1" class="ltx_text" style="--ltx-bg-color:#F5E5D6;">1476</span></td></tr>
