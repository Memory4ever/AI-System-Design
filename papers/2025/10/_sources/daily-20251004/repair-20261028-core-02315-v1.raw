<th id="S5.T2.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" rowspan="2"><span id="S5.T2.2.1.1.1.1" class="ltx_text ltx_font_bold">Heuristic</span></th>
<th id="S5.T2.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S5.T2.2.1.1.2.1" class="ltx_text ltx_font_bold">SD3.5</span></th>
<th id="S5.T2.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S5.T2.2.1.1.3.1" class="ltx_text ltx_font_bold">FLUX.1</span></th></tr>
<tr id="S5.T2.2.1.2" class="ltx_tr">
<th id="S5.T2.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Win[%]</th>
<th id="S5.T2.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Elo<math id="S5.T2.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S5.T2.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Win[%]</th>
<th id="S5.T2.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Elo<math id="S5.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.2.1.3" class="ltx_tr">
