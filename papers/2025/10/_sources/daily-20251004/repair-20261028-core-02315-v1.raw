<tr id="A4.T5.4.1.8" class="ltx_tr">
<th id="A4.T5.4.1.8.1" class="ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_row" style="padding-top:0.25pt;padding-bottom:0.25pt;">Divide&amp;Bind</th>
<td id="A4.T5.4.1.8.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">{<span id="A4.T5.4.1.8.2.1" class="ltx_text ltx_font_bold">0.1</span>, 1, 10}</td>
<td id="A4.T5.4.1.8.3" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><math id="A4.T5.m10" class="ltx_Math" alttext="5\mathrm{e}{-5}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>−</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">5\mathrm{e}{-5}</annotation></semantics></math></td>
<td id="A4.T5.4.1.8.4" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">{<span id="A4.T5.4.1.8.4.1" class="ltx_text ltx_font_bold">200</span>, 250 }</td>
<td id="A4.T5.4.1.8.5" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A4.T5.4.1.8.5.1" class="ltx_text ltx_font_smallcaps">Horse&amp;Bear</span></td></tr>
<tr id="A4.T5.4.1.9" class="ltx_tr">
<th id="A4.T5.4.1.9.1" class="ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-top:0.25pt;padding-bottom:0.25pt;">FOCUS</th>
<td id="A4.T5.4.1.9.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.25pt;padding-bottom:0.25pt;">{0.01, 0.1, 1, 10, <span id="A4.T5.4.1.9.2.1" class="ltx_text ltx_font_bold">100</span>}</td>
<td id="A4.T5.4.1.9.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.25pt;padding-bottom:0.25pt;">{<math id="A4.T5.m11" class="ltx_Math" alttext="1\mathrm{e}{-4}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>−</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">1\mathrm{e}{-4}</annotation></semantics></math>, <math id="A4.T5.m12" class="ltx_Math" alttext="5\mathrm{e}{-5}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>−</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">5\mathrm{e}{-5}</annotation></semantics></math>, <math id="A4.T5.m13" class="ltx_Math" alttext="1\mathrm{e}{-5}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>−</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">1\mathrm{e}{-5}</annotation></semantics></math>}</td>
<td id="A4.T5.4.1.9.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.25pt;padding-bottom:0.25pt;">{200, <span id="A4.T5.4.1.9.4.1" class="ltx_text ltx_font_bold">250</span>, 300}</td>
<td id="A4.T5.4.1.9.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.25pt;padding-bottom:0.25pt;">{<span id="A4.T5.4.1.9.5.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">Horse&amp;Bear</span>, <span id="A4.T5.4.1.9.5.2" class="ltx_text ltx_font_smallcaps">TwoObject</span>}</td></tr>
</tbody>
</table>
</span></div>
</figure>
