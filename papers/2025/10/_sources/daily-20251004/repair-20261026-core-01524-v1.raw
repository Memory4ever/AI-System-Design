</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.2.1.2" class="ltx_tr">
<th id="S4.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">GPT-4+CoT <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib40" title="" class="ltx_ref">Zhou et al., 2024</a>)</cite></th>
