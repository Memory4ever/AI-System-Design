</figure>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> WALT: Two-Agent Tool Construction (Appendix)</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            Candidate <math id="alg1.l1.m1" class="ltx_Math" alttext="\tilde{u}=(s_{i},E_{i},G_{i})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>E</mi><mi>i</mi></msub><mo>,</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}=(s_{i},E_{i},G_{i})</annotation></semantics></math>, attempt budget <math id="alg1.l1.m2" class="ltx_Math" alttext="N_{\text{max}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mtext>max</mtext></msub><annotation encoding="application/x-tex">N_{\text{max}}</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            Validated tool <math id="alg1.l2.m1" class="ltx_Math" alttext="u^{*}\in\mathcal{A}_{\text{tools}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mtext>tools</mtext></msub></mrow><annotation encoding="application/x-tex">u^{*}\in\mathcal{A}_{\text{tools}}</annotation></semantics></math> or <span id="alg1.l2.2" class="ltx_text ltx_markedasmath">FAIL</span>

</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
            <math id="alg1.l3.m1" class="ltx_Math" alttext="\text{attempts}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mtext>attempts</mtext><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\text{attempts}\leftarrow 0</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
            <span id="alg1.l4.2" class="ltx_text ltx_font_bold">while</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="\text{attempts}&lt;N_{\text{max}}" display="inline" intent=":literal"><semantics><mrow><mtext>attempts</mtext><mo>&lt;</mo><msub><mi>N</mi><mtext>max</mtext></msub></mrow><annotation encoding="application/x-tex">\text{attempts}&lt;N_{\text{max}}</annotation></semantics></math> <span id="alg1.l4.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              <math id="alg1.l5.m1" class="ltx_Math" alttext="\text{attempts}\leftarrow\text{attempts}+1" display="inline" intent=":literal"><semantics><mrow><mtext>attempts</mtext><mo stretchy="false">←</mo><mrow><mtext>attempts</mtext><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\text{attempts}\leftarrow\text{attempts}+1</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
              <span id="alg1.l6.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#008080;">Phase I: Exploration &amp; Stabilization (by <math id="alg1.l6.m1" class="ltx_Math" alttext="\mathcal{B}_{\text{browser}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#008080;" class="ltx_font_mathcaligraphic" mathcolor="#008080">ℬ</mi><mtext style="--ltx-fg-color:#008080;" class="ltx_mathvariant_bold" mathcolor="#008080">browser</mtext></msub><annotation encoding="application/x-tex">\mathcal{B}_{\text{browser}}</annotation></semantics></math>)</span>

</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
              <math id="alg1.l7.m1" class="ltx_Math" alttext="\mathcal{X}\leftarrow\mathcal{B}_{\text{browser}}.\text{Execute}(s_{i},E_{i},G_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">←</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>browser</mtext></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext>Execute</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>E</mi><mi>i</mi></msub><mo>,</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{X}\leftarrow\mathcal{B}_{\text{browser}}.\text{Execute}(s_{i},E_{i},G_{i})</annotation></semantics></math>

</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
              <span id="alg1.l8.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="\mathcal{X}=\text{FAIL}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>=</mo><mtext>FAIL</mtext></mrow><annotation encoding="application/x-tex">\mathcal{X}=\text{FAIL}</annotation></semantics></math> <span id="alg1.l8.3" class="ltx_text ltx_font_bold">then</span> 
</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
               <span id="alg1.l9.2" class="ltx_text ltx_font_bold">continue</span> <span id="alg1.l9.3" class="ltx_text" style="float:right;"><math id="alg1.l9.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> retry with alternate exploration strategy </span>
</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
              <span id="alg1.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
              <math id="alg1.l11.m1" class="ltx_Math" alttext="\mathcal{X}\leftarrow\textsc{StabilizeSelectors}(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">StabilizeSelectors</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{X}\leftarrow\textsc{StabilizeSelectors}(\mathcal{X})</annotation></semantics></math> <span id="alg1.l11.2" class="ltx_text" style="float:right;"><math id="alg1.l11.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> resolve to stable DOM hashes/locators; drop unstable segments
</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
              <span id="alg1.l12.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="\mathcal{X}=\text{UNSTABLE}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>=</mo><mtext>UNSTABLE</mtext></mrow><annotation encoding="application/x-tex">\mathcal{X}=\text{UNSTABLE}</annotation></semantics></math> <span id="alg1.l12.3" class="ltx_text ltx_font_bold">then</span> 
</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
               <span id="alg1.l13.2" class="ltx_text ltx_font_bold">continue</span> 
</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
              
              <span id="alg1.l14.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l14.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
              <span id="alg1.l15.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#008080;">Phase II: Synthesis &amp; Optimization (by <math id="alg1.l15.m1" class="ltx_Math" alttext="\mathcal{B}_{\text{tool}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#008080;" class="ltx_font_mathcaligraphic" mathcolor="#008080">ℬ</mi><mtext style="--ltx-fg-color:#008080;" class="ltx_mathvariant_bold" mathcolor="#008080">tool</mtext></msub><annotation encoding="application/x-tex">\mathcal{B}_{\text{tool}}</annotation></semantics></math>)</span>

</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
              <math id="alg1.l16.m1" class="ltx_Math" alttext="\text{plan}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mtext>plan</mtext><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\text{plan}\leftarrow\emptyset</annotation></semantics></math>

</div>
<div id="alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">17:</span>
              
              
              <span id="alg1.l17.2" class="ltx_text ltx_font_bold">for</span> each segment <math id="alg1.l17.m1" class="ltx_Math" alttext="\xi\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">\xi\in\mathcal{X}</annotation></semantics></math> <span id="alg1.l17.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">18:</span>
              
              
               <math id="alg1.l18.m1" class="ltx_Math" alttext="\text{step}\leftarrow\mathcal{B}_{\text{tool}}.\text{ClassifyAndCreate}(\xi)" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>step</mtext><mo stretchy="false">←</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>tool</mtext></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext>ClassifyAndCreate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{step}\leftarrow\mathcal{B}_{\text{tool}}.\text{ClassifyAndCreate}(\xi)</annotation></semantics></math> <span id="alg1.l18.2" class="ltx_text" style="float:right;"><math id="alg1.l18.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> navigation / interaction / agentic
</span>
</div>
<div id="alg1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">19:</span>
              
              
               <math id="alg1.l19.m1" class="ltx_Math" alttext="\text{plan}\leftarrow\text{plan}\cup\{\text{step}\}" display="inline" intent=":literal"><semantics><mrow><mtext>plan</mtext><mo stretchy="false">←</mo><mrow><mtext>plan</mtext><mo>∪</mo><mrow><mo stretchy="false">{</mo><mtext>step</mtext><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{plan}\leftarrow\text{plan}\cup\{\text{step}\}</annotation></semantics></math>

</div>
<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">20:</span>
              
              
              <span id="alg1.l20.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l20.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">21:</span>
              
              
              <math id="alg1.l21.m1" class="ltx_Math" alttext="\text{plan}\leftarrow\textsc{AddAgenticFallbacks}(\text{plan})" display="inline" intent=":literal"><semantics><mrow><mtext>plan</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">AddAgenticFallbacks</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>plan</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{plan}\leftarrow\textsc{AddAgenticFallbacks}(\text{plan})</annotation></semantics></math> <span id="alg1.l21.2" class="ltx_text" style="float:right;"><math id="alg1.l21.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> re-query DOM, retry alt selector, etc.
</span>
</div>
<div id="alg1.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">22:</span>
              
              
              <math id="alg1.l22.m1" class="ltx_Math" alttext="\text{plan}\leftarrow\textsc{ReplaceWithURLOps}(\text{plan})" display="inline" intent=":literal"><semantics><mrow><mtext>plan</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">ReplaceWithURLOps</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>plan</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{plan}\leftarrow\textsc{ReplaceWithURLOps}(\text{plan})</annotation></semantics></math> <span id="alg1.l22.2" class="ltx_text" style="float:right;"><math id="alg1.l22.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> promote eligible UI subsequences to URL ops
</span>
</div>
<div id="alg1.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">23:</span>
              
              
              <math id="alg1.l23.m1" class="ltx_Math" alttext="\mathcal{S}_{\text{inp}}\leftarrow\textsc{InferSchema}(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mtext>inp</mtext></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">InferSchema</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}_{\text{inp}}\leftarrow\textsc{InferSchema}(\mathcal{X})</annotation></semantics></math> <span id="alg1.l23.2" class="ltx_text" style="float:right;"><math id="alg1.l23.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> enums, optionals, descriptions, examples
</span>
</div>
<div id="alg1.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">24:</span>
              
              
              <math id="alg1.l24.m1" class="ltx_Math" alttext="\mathcal{I}_{\text{test}}\leftarrow\mathcal{B}_{\text{tool}}.\text{ExtractTestInputs}(\mathcal{X},\mathcal{S}_{\text{inp}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>test</mtext></msub><mo stretchy="false">←</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>tool</mtext></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext>ExtractTestInputs</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mtext>inp</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}_{\text{test}}\leftarrow\mathcal{B}_{\text{tool}}.\text{ExtractTestInputs}(\mathcal{X},\mathcal{S}_{\text{inp}})</annotation></semantics></math>

</div>
<div id="alg1.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">25:</span>
              
              
              <math id="alg1.l25.m1" class="ltx_Math" alttext="u\leftarrow(\text{plan},\mathcal{S}_{\text{inp}})" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mtext>plan</mtext><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mtext>inp</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u\leftarrow(\text{plan},\mathcal{S}_{\text{inp}})</annotation></semantics></math>

</div>
<div id="alg1.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">26:</span>
              
              
              <span id="alg1.l26.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#008080;">Phase III: Registration &amp; Validation (by <math id="alg1.l26.m1" class="ltx_Math" alttext="\mathcal{B}_{\text{browser}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#008080;" class="ltx_font_mathcaligraphic" mathcolor="#008080">ℬ</mi><mtext style="--ltx-fg-color:#008080;" class="ltx_mathvariant_bold" mathcolor="#008080">browser</mtext></msub><annotation encoding="application/x-tex">\mathcal{B}_{\text{browser}}</annotation></semantics></math>)</span>

</div>
<div id="alg1.l27" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">27:</span>
              
              
              <math id="alg1.l27.m1" class="ltx_Math" alttext="\text{RegisterTool}(u,\mathcal{S}_{\text{inp}},\mathcal{I}_{\text{test}})" display="inline" intent=":literal"><semantics><mrow><mtext>RegisterTool</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mtext>inp</mtext></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>test</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{RegisterTool}(u,\mathcal{S}_{\text{inp}},\mathcal{I}_{\text{test}})</annotation></semantics></math>

</div>
<div id="alg1.l28" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">28:</span>
              
              
              <math id="alg1.l28.m1" class="ltx_Math" alttext="\text{result}\leftarrow\mathcal{B}_{\text{browser}}.\text{TestTool}(u,\mathcal{I}_{\text{test}})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>result</mtext><mo stretchy="false">←</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>browser</mtext></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext>TestTool</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>test</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{result}\leftarrow\mathcal{B}_{\text{browser}}.\text{TestTool}(u,\mathcal{I}_{\text{test}})</annotation></semantics></math>

</div>
<div id="alg1.l29" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">29:</span>
              
              
              <span id="alg1.l29.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l29.m1" class="ltx_Math" alttext="\text{result}=\text{SUCCESS}" display="inline" intent=":literal"><semantics><mrow><mtext>result</mtext><mo>=</mo><mtext>SUCCESS</mtext></mrow><annotation encoding="application/x-tex">\text{result}=\text{SUCCESS}</annotation></semantics></math> <span id="alg1.l29.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l30" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">30:</span>
              
              
               <span id="alg1.l30.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l30.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> <span id="alg1.l30.3" class="ltx_text" style="float:right;"><math id="alg1.l30.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> validated; added to <math id="alg1.l30.m3" class="ltx_Math" alttext="\mathcal{A}_{\text{tools}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mtext>tools</mtext></msub><annotation encoding="application/x-tex">\mathcal{A}_{\text{tools}}</annotation></semantics></math> as <math id="alg1.l30.m4" class="ltx_Math" alttext="u^{*}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">u^{*}</annotation></semantics></math>
</span>
</div>
<div id="alg1.l31" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">31:</span>
              
              
              <span id="alg1.l31.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.l32" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">32:</span>
              
              
               <math id="alg1.l32.m1" class="ltx_Math" alttext="\mathcal{F}\leftarrow\text{GetValidationErrors}(\text{result})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">←</mo><mrow><mtext>GetValidationErrors</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>result</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}\leftarrow\text{GetValidationErrors}(\text{result})</annotation></semantics></math> <span id="alg1.l32.2" class="ltx_text" style="float:right;"><math id="alg1.l32.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> selector drift, missing enum, timeout, semantic mismatch
</span>
</div>
<div id="alg1.l33" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">33:</span>
              
              
               <math id="alg1.l33.m1" class="ltx_Math" alttext="(s_{i},E_{i},G_{i})\leftarrow\textsc{RefineCandidate}\big((s_{i},E_{i},G_{i}),\mathcal{F}\big)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>E</mi><mi>i</mi></msub><mo>,</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">RefineCandidate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>E</mi><mi>i</mi></msub><mo>,</mo><msub><mi>G</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(s_{i},E_{i},G_{i})\leftarrow\textsc{RefineCandidate}\big((s_{i},E_{i},G_{i}),\mathcal{F}\big)</annotation></semantics></math> <span id="alg1.l33.2" class="ltx_text" style="float:right;"><math id="alg1.l33.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> update selectors, schema, or plan hints
</span>
</div>
<div id="alg1.l34" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">34:</span>
              
              
               <span id="alg1.l34.2" class="ltx_text ltx_font_bold">continue</span>

</div>
<div id="alg1.l35" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">35:</span>
              
              
              <span id="alg1.l35.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l35.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l36" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">36:</span>
              
              
            <span id="alg1.l36.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l36.3" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg1.l37" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">37:</span>
              
              
            <span id="alg1.l37.2" class="ltx_text ltx_font_bold">return</span> <span id="alg1.l37.3" class="ltx_text">FAIL</span>

</div>
</div>
</figure>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Implementation Details</h3>

<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.p1.1" class="ltx_p"><span id="A1.SS2.p1.1.1" class="ltx_text ltx_font_bold">Tool Creation Agent Algorithm and System Prompt.</span> We include the system prompt for the tool discovery agent in Listing <a href="#A1.SS3" title="A.3 Use of Large Language Models ‣ Appendix A Appendix ‣ WALT: Web Agents that Learn Tools" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a> and algorithm and system prompt of the tool creation agent <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="\mathcal{B}_{\text{tool}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>tool</mtext></msub><annotation encoding="application/x-tex">\mathcal{B}_{\text{tool}}</annotation></semantics></math> in Algorithm <a href="#alg1" title="Algorithm 1 ‣ A.1 Analysis ‣ Appendix A Appendix ‣ WALT: Web Agents that Learn Tools" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and Listing <a href="#A1.SS3" title="A.3 Use of Large Language Models ‣ Appendix A Appendix ‣ WALT: Web Agents that Learn Tools" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>.</p>
</div>
<div id="A1.SS2.p2" class="ltx_para ltx_noindent">
<p id="A1.SS2.p2.1" class="ltx_p"><span id="A1.SS2.p2.1.1" class="ltx_text ltx_font_bold">Baseline Implementation Details.</span> We use the Claude Computer-Use Agent with a dedicated desktop environment setup similar to OS-World <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib28" title="" class="ltx_ref">Xie et al., 2024</a>]</cite>. Each task initializes with a Chrome browser and task-specific web pages. The agent receives desktop screenshots as observations, predicts OS-level actions, and executes them via pyautogui commands. Task completion is determined by either reaching the maximum step limit or agent prediction, with evaluation based on the final active webpage and parsed response.</p>
</div>
<div id="A1.SS2.p3" class="ltx_para ltx_noindent">
<p id="A1.SS2.p3.1" class="ltx_p">We use <span id="A1.SS2.p3.1.1" class="ltx_text ltx_font_typewriter">claude-4-sonnet-20250514</span> with thinking mode enabled (temperature=1). Due to Bedrock API limits, all screenshots and task images are resized to 1280<math id="A1.SS2.p3.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>720, with a maximum of 30 steps per task. Note that active webpage detection relies on heuristic algorithms using Playwright and Chrome DevTools Protocol, which may incorrectly identify the current page in edge cases. Reported accuracies should be viewed as lower bounds rather than exact measurements.</p>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Use of Large Language Models</h3>

<div id="A1.SS3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.p1.1" class="ltx_p">Large language models (LLMs) were used to polish (proofreading, revising, and compressing) the writing, specifically Claude-4-Sonnet and GPT-5.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
<div id="A1.SS3.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SS3.p2.pic1" class="ltx_picture" height="79.45" overflow="visible" version="1.1" viewBox="0 0 550 79.45" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,79.45) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 73.55 C 0 76.81 2.64 79.45 5.91 79.45 L 544.09 79.45 C 547.36 79.45 550 76.81 550 73.55 L 550 5.91 C 550 2.64 547.36 0 544.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 55.34 L 548.03 55.34 L 548.03 5.91 C 548.03 3.73 546.27 1.97 544.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 63.94)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
