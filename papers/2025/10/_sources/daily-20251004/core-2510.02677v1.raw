<div id="A4.SS3.p7" class="ltx_para ltx_noindent">
<p id="A4.SS3.p7.1" class="ltx_p">For JailbreakBench evaluation, we follow the default configuration and set the user message as follows.</p>
<div id="A4.SS3.p7.2" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx177" class="ltx_listingline"><span id="lstnumberx177.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Please</span><span id="lstnumberx177.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx177.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">carefully</span><span id="lstnumberx177.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx177.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">read</span><span id="lstnumberx177.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx177.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx177.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx177.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">following</span><span id="lstnumberx177.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx177.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">user</span><span id="lstnumberx177.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx177.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">request</span><span id="lstnumberx177.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx177.15" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx177.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">denoted</span><span id="lstnumberx177.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx177.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">as</span><span id="lstnumberx177.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx177.20" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx177.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">REQUEST</span><span id="lstnumberx177.22" class="ltx_text ltx_font_typewriter"