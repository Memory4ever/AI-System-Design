              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              <span id="alg1.l5.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
               Set <math id="alg1.l6.m1" class="ltx_Math" alttext="x_{i}=q" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>=</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">x_{i}=q</annotation></semantics></math> <span id="alg1.l6.2" class="ltx_text" style="float:right;"><math id="alg1.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l6.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> Use the harmful behavior</span>
</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
