"> </span><span id="lstnumberx176.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">response</span><span id="lstnumberx176.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx176.26" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx176.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">err</span><span id="lstnumberx176.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">on</span><span id="lstnumberx176.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx176.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">side</span><span id="lstnumberx176.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx176.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">giving</span><span id="lstnumberx176.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter">higher</span><span id="lstnumberx176.41" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter">scores</span><span id="lstnumberx176.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx176.44" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx17