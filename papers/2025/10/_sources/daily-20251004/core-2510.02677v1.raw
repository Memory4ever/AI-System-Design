<span id="S4.T4.pic1.1.3.1.1.1" class="ltx_p ltx_align_center"><span id="S4.T4.pic1.1.3.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F2F2;">Text</span></span>
</span></th>
<th id="S4.T4.pic1.1.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_b ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">
