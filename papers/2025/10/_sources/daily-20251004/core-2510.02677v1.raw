</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
               <span id="alg1.l15.2" class="ltx_text ltx_font_bold">else</span> Query VLM

</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
                 <math id="alg1.l16.m1" class="ltx_Math" alttext="\mathcal{I}_{\text{adv}}^{t}\leftarrow\hat{\mathcal{I}}_{\text{adv}}^{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mi>t</mi></msubsup><mo stretchy="false">←</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>^</mo></mover><mtext>adv</mtext><mi>t</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{I}_{\text{adv}}^{t}\leftarrow\hat{\mathcal{I}}_{\text{adv}}^{t}</annotation></semantics></math> <span id="alg1.l16.2" class="ltx_text" style="float:right;"><math id="alg1.l16.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l16.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> Apply attack</span>
</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">17:</span>
              
              
                 <math id="alg1.l17.m1" class="ltx_Math" alttext="y_{t}\leftarrow M(\mathcal{I}_{\text{adv}}^{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{t}\leftarrow M(\mathcal{I}_{\text{adv}}^{t})</annotation></semantics></math> <span id="alg1.l17.2" class="ltx_text" style="float:right;"><math id="alg1.l17.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l17.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> Query victim VLM</span>
</span>
</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">18:</span>
              
              
                 <math id="alg1.l18.m1" class="ltx_Math" alttext="s_{t}\leftarrow J(y_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{t}\leftarrow J(y_{t})</annotation></semantics></math> <span id="alg1.l18.2" class="ltx_text" style="float:right;"><math id="alg1.l18.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l18.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> Evaluate response</span>
</span>
</div>
<div id="alg1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">19:</span>
              
              
                 <span id="alg1.l19.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l19.m1" class="ltx_Math" alttext="s_{t}&gt;s^{\ast}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>&gt;</mo><msup><mi>s</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">s_{t}&gt;s^{\ast}</annotation></semantics></math> <span id="alg1.l19.3" class="ltx_text ltx_font_bold">then</span> <span id="alg1.l19.4" class="ltx_text" style="float:right;"><math id="alg1.l19.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l19.4.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> Record best attack</span>
</span>
</div>
<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">20:</span>
              
              
                  <math id="alg1.l20.m1" class="ltx_Math" alttext="\mathcal{I}_{\text{adv}}^{\ast}\leftarrow\mathcal{I}_{\text{adv}}^{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mo>∗</mo></msubsup><mo stretchy="false">←</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mi>t</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{I}_{\text{adv}}^{\ast}\leftarrow\mathcal{I}_{\text{adv}}^{t}</annotation></semantics></math>, <math id="alg1.l20.m2" class="ltx_Math" alttext="y^{\ast}\leftarrow y_{t}" display="inline" intent=":literal"><semantics><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><msub><mi>y</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">y^{\ast}\leftarrow y_{t}</annotation></semantics></math>, <math id="alg1.l20.m3" class="ltx_Math" alttext="s^{\ast}\leftarrow s_{t}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">s^{\ast}\leftarrow s_{t}</annotation></semantics></math>

</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">21:</span>
              
              
                 <span id="alg1.l21.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l21.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">22:</span>
              
              
                 <span id="alg1.l22.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l22.m1" class="ltx_Math" alttext="s_{t}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>t</mi></msub><annotation encoding="application/x-tex">s_{t}</annotation></semantics></math> exceeds threshold <span id="alg1.l22.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">23:</span>
              
              
                  <span id="alg1.l23.2" class="ltx_text ltx_font_bold">break</span> <span id="alg1.l23.3" class="ltx_text" style="float:right;"><math id="alg1.l23.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l23.3.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> Attack success</span>
</span>
</div>
<div id="alg1.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">24:</span>
              
              
                 <span id="alg1.l24.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l24.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">25:</span>
              
              
               <span id="alg1.l25.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l25.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">26:</span>
              
              
              <span id="alg1.l26.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l26.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l27" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">27:</span>
              
              
              Self-reflect optimization turns to obtain <math id="alg1.l27.m1" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>

</div>
<div id="alg1.l28" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">28:</span>
              
              
              <math id="alg1.l28.m1" class="ltx_Math" alttext="\zeta^{i}=\{x_{i},r_{i},\{(\mathcal{I}_{\text{adv}}^{t},y_{t},s_{t})\}_{t=1}^{T}\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ζ</mi><mi>i</mi></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>r</mi><mi>i</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mi>t</mi></msubsup><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta^{i}=\{x_{i},r_{i},\{(\mathcal{I}_{\text{adv}}^{t},y_{t},s_{t})\}_{t=1}^{T}\}</annotation></semantics></math> <span id="alg1.l28.2" class="ltx_text" style="float:right;"><math id="alg1.l28.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l28.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> Get trajectory</span>
</span>
</div>
<div id="alg1.l29" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">29:</span>
              
              
              <math id="alg1.l29.m1" class="ltx_Math" alttext="\mathcal{D}_{\theta}\leftarrow\zeta^{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>θ</mi></msub><mo stretchy="false">←</mo><msup><mi>ζ</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{D}_{\theta}\leftarrow\zeta^{i}</annotation></semantics></math>
<span id="alg1.l29.2" class="ltx_text" style="float:right;"><math id="alg1.l29.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l29.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> Update memory</span>
</span>
</div>
<div id="alg1.l30" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">30:</span>
              
              
              Record the optimized instance <math id="alg1.l30.m1" class="ltx_Math" alttext="\mathcal{I}^{\ast}_{\text{adv}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\mathcal{I}^{\ast}_{\text{adv}}</annotation></semantics></math> with <math id="alg1.l30.m2" class="ltx_Math" alttext="y^{\ast},s^{\ast}" display="inline" intent=":literal"><semantics><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>s</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">y^{\ast},s^{\ast}</annotation></semantics></math>

</div>
<div id="alg1.l31" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">31:</span>
              
              
            <span id="alg1.l31.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l31.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l32" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">32:</span>
              
              
            <span id="alg1.l32.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l32.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> optimized instances with evaluations

</div>
</div>
</figure>
<div id="S3.SS4.p2" class="ltx_para ltx_noindent">
<p id="S3.SS4.p2.1" class="ltx_p"><span id="S3.SS4.p2.1.1" class="ltx_text ltx_font_bold">Memory Update.</span> After <math id="S3.SS4.p2.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th attack trajectory <math id="S3.SS4.p2.m2" class="ltx_Math" alttext="\zeta^{i}" display="inline" intent=":literal"><semantics><msup><mi>ζ</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\zeta^{i}</annotation></semantics></math> is completed, <span id="S3.SS4.p2.1.2" class="ltx_text ltx_font_smallcaps">ARMs</span> extracts the associated risk category <math id="S3.SS4.p2.m3" class="ltx_Math" alttext="c_{\text{r}}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mtext>r</mtext><mi>i</mi></msubsup><annotation encoding="application/x-tex">c_{\text{r}}^{i}</annotation></semantics></math> and the most effective strategy <math id="S3.SS4.p2.m4" class="ltx_Math" alttext="s_{\text{a}}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mtext>a</mtext><mi>i</mi></msubsup><annotation encoding="application/x-tex">s_{\text{a}}^{i}</annotation></semantics></math>.
Let <math id="S3.SS4.p2.m5" class="ltx_Math" alttext="s^{\ast}" display="inline" intent=":literal"><semantics><msup><mi>s</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">s^{\ast}</annotation></semantics></math> denote the harmfulness score by the policy-based judge,
we then update the memory by inserting <math id="S3.SS4.p2.m6" class="ltx_Math" alttext="\zeta^{i}" display="inline" intent=":literal"><semantics><msup><mi>ζ</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\zeta^{i}</annotation></semantics></math> in an empty grid, or replacing the original one whose score is lower than <math id="S3.SS4.p2.m7" class="ltx_Math" alttext="s^{\ast}" display="inline" intent=":literal"><semantics><msup><mi>s</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">s^{\ast}</annotation></semantics></math>, which guarantees the attack effectiveness of the memory.</p>
</div>
<div id="S3.SS4.p3" class="ltx_para ltx_noindent">
<p id="S3.SS4.p3.1" class="ltx_p"><span id="S3.SS4.p3.1.1" class="ltx_text ltx_font_bold">Memory Retrieval.</span>
To balance exploration and exploitation of attack strategies, <span id="S3.SS4.p3.1.2" class="ltx_text ltx_font_smallcaps">ARMs</span> adopts an <math id="S3.SS4.p3.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-greedy memory retrieval strategy. With probability <math id="S3.SS4.p3.m2" class="ltx_Math" alttext="\epsilon_{i}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\epsilon_{i}</annotation></semantics></math>, the agent is encouraged to explore without any memory guidance; otherwise, it exploits past experience by retrieving a stored trajectory from <math id="S3.SS4.p3.m3" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>.
To progressively shift from early-stage exploration to late-stage exploitation as the memory becomes more informative, <math id="S3.SS4.p3.m4" class="ltx_Math" alttext="\epsilon_{i}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\epsilon_{i}</annotation></semantics></math> is updated over time and decays exponentially:</p>
<table id="S3.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E1.m1" class="ltx_math_unparsed" alttext="\epsilon_{i}=\epsilon_{\min}+(\epsilon_{\max}-\epsilon_{\min})\cdot e^{(-\lambda\cdot(i-1))}," display="block" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mi>i</mi></msub><mo>=</mo><msub><mi>ϵ</mi><mi>min</mi></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mi>max</mi></msub><mo>−</mo><msub><mi>ϵ</mi><mi>min</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mi>e</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mo stretchy="false">(</mo><mi>i</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\epsilon_{i}=\epsilon_{\min}+(\epsilon_{\max}-\epsilon_{\min})\cdot e^{(-\lambda\cdot(i-1))},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1)</span></td></tr></tbody>
</table>
<p id="S3.SS4.p3.2" class="ltx_p">where <math id="S3.SS4.p3.m5" class="ltx_Math" alttext="\epsilon_{\min}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\epsilon_{\min}</annotation></semantics></math>, <math id="S3.SS4.p3.m6" class="ltx_Math" alttext="\epsilon_{\max}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\epsilon_{\max}</annotation></semantics></math>, and <math id="S3.SS4.p3.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> are predefined scheduling parameters.
This design mitigates mode collapse and avoids early overfitting to one or few attack strategies by enforcing broad exploration across risk–strategy space before exploitation dominates, encouraging attack diversity.</p>
</div>
<div id="S3.SS4.p4" class="ltx_para ltx_noindent">
<p id="S3.SS4.p4.1" class="ltx_p">Specifically, <span id="S3.SS4.p4.1.1" class="ltx_text ltx_font_smallcaps">ARMs</span> retrieves the top-<math id="S3.SS4.p4.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> memory instance <math id="S3.SS4.p4.m2" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> whose concatenated embeddings of category and behavior are most similar to the current context <math id="S3.SS4.p4.m3" class="ltx_Math" alttext="(c_{\text{r}}^{i},x_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mtext>r</mtext><mi>i</mi></msubsup><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c_{\text{r}}^{i},x_{i})</annotation></semantics></math>, which is measured by <math id="S3.SS4.p4.m4" class="ltx_Math" alttext="\text{score}(\zeta)" display="inline" intent=":literal"><semantics><mrow><mtext>score</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{score}(\zeta)</annotation></semantics></math>. Let <math id="S3.SS4.p4.m5" class="ltx_Math" alttext="\phi(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\cdot)</annotation></semantics></math> denote the embedding function,</p>
<table id="S3.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E2.m1" class="ltx_Math" alttext="\text{score}(\zeta)=\cos\left(\phi(c_{\text{r}}^{i}),\phi(c_{\text{r}}^{\zeta})\right)+\alpha\cdot\cos\left(\phi(x_{i}),\phi(x^{\zeta})\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>score</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mtext>r</mtext><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mtext>r</mtext><mi>ζ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>ζ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{score}(\zeta)=\cos\left(\phi(c_{\text{r}}^{i}),\phi(c_{\text{r}}^{\zeta})\right)+\alpha\cdot\cos\left(\phi(x_{i}),\phi(x^{\zeta})\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
<p id="S3.SS4.p4.2" class="ltx_p">where <math id="S3.SS4.p4.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is a weighting hyper-parameter that balances category-level and prompt-level similarity.</p>
</div>
<div id="S3.SS4.p5" class="ltx_para ltx_noindent">
<p id="S3.SS4.p5.1" class="ltx_p">We detail <span id="S3.SS4.p5.1.1" class="ltx_text ltx_font_smallcaps">ARMs</span>’s red-teaming procedure in Algorithm <a href="#alg1" title="Algorithm 1 ‣ 3.4 Diversity-Enhanced Layered Memory Module ‣ 3 ARMs Framework ‣ ARMs: Adaptive Red-Teaming Agent against Multimodal Models with Plug-and-Play Attacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and provide an illustration in Figure <a href="#S3.F2" title="Figure 2 ‣ 3.2 Overview of ARMs ‣ 3 ARMs Framework ‣ ARMs: Adaptive Red-Teaming Agent against Multimodal Models with Plug-and-Play Attacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
</section>
<section id="S3.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.5 </span><span id="S3.SS5.2" class="ltx_text ltx_font_smallcaps">ARMs-Bench</span>: Advanced Safety Dataset for VLMs</h3>

<div id="S3.SS5.p1" class="ltx_para ltx_noindent">
<p id="S3.SS5.p1.1" class="ltx_p">Building on the strong attack capabilities and diversity of <span id="S3.SS5.p1.1.1" class="ltx_text ltx_font_smallcaps">ARMs</span>, we introduce <span id="S3.SS5.p1.1.2" class="ltx_text ltx_font_smallcaps">ARMs-Bench</span>, a large-scale multimodal safety dataset
with over 30K red-teaming instances that systematically uncover diverse vulnerabilities of VLMs. Each instance is generated through <span id="S3.SS5.p1.1.3" class="ltx_text ltx_font_smallcaps">ARMs</span>’s multi-turn optimization process, ensuring both high success rate and diversity while capturing critical, real-world safety risks faced by VLMs.
As described in §<a href="#S3.SS2" title="3.2 Overview of ARMs ‣ 3 ARMs Framework ‣ ARMs: Adaptive Red-Teaming Agent against Multimodal Models with Plug-and-Play Attacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, harmful behaviors and risk definitions are first collected from existing VLM safety benchmarks and AI regulations, then fed into <span id="S3.SS5.p1.1.4" class="ltx_text ltx_font_smallcaps">ARMs</span> to produce successful adversarial instances. These instances are systematically clustered and categorized into 51 categories
and grouped into four high-level sectors: <span id="S3.SS5.p1.1.5" class="ltx_text ltx_font_italic">General AI Risk</span>, <span id="S3.SS5.p1.1.6" class="ltx_text ltx_font_italic">EU AI Act Regulation</span>, <span id="S3.SS5.p1.1.7" class="ltx_text ltx_font_italic">OWASP Policy</span>, and <span id="S3.SS5.p1.1.8" class="ltx_text ltx_font_italic">FINRA Regulation</span> (detailed in Appendix <a href="#A3.SS2" title="C.2 Safety Benchmark Evaluation with ARMs-Bench ‣ Appendix C ARMs-Bench Details ‣ ARMs: Adaptive Red-Teaming Agent against Multimodal Models with Plug-and-Play Attacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a>).</p>
</div>
<figure id="S3.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 1: </span>A detailed comparison of <span id="S3.T1.4" class="ltx_text ltx_font_smallcaps">ARMs</span> with existing red-teaming frameworks. Compared to prior work, <span id="S3.T1.5" class="ltx_text ltx_font_smallcaps">ARMs</span> offers a unified and extensible attack interface with hierarchical memory, diverse attack strategies integrated by MCP, supporting both instance-based and policy-grounded safety assessment.</figcaption>
<div id="S3.T1.6" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:397.5pt;height:49pt;vertical-align:-23.6pt;"><span class="ltx_transformed_inner" style="transform:translate(-241.5pt,29.8pt) scale(0.451395638393597,0.451395638393597) ;">
<table id="S3.T1.6.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S3.T1.6.1.1" class="ltx_tr">
<th id="S3.T1.6.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_tt">
<span id="S3.T1.6.1.1.1.1" class="ltx_inline-block ltx_align_left">
<span id="S3.T1.6.1.1.1.1.1" class="ltx_p"><span id="S3.T1.6.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Red-teaming</span></span>
<span id="S3.T1.6.1.1.1.1.2" class="ltx_p"><span id="S3.T1.6.1.1.1.1.2.1" class="ltx_text ltx_font_bold">Framework</span></span>
</span></th>
<td id="S3.T1.6.1.1.2" class="ltx_td ltx_align_center ltx_border_tt">
<span id="S3.T1.6.1.1.2.1" class="ltx_inline-block ltx_align_left">
<span id="S3.T1.6.1.1.2.1.1" class="ltx_p"><span id="S3.T1.6.1.1.2.1.1.1" class="ltx_text ltx_font_bold">Multimodal-</span></span>
<span id="S3.T1.6.1.1.2.1.2" class="ltx_p"><span id="S3.T1.6.1.1.2.1.2.1" class="ltx_text ltx_font_bold">centric</span></span>
</span></td>
<td id="S3.T1.6.1.1.3" class="ltx_td ltx_align_center ltx_border_tt">
<span id="S3.T1.6.1.1.3.1" class="ltx_inline-block ltx_align_left">
<span id="S3.T1.6.1.1.3.1.1" class="ltx_p"><span id="S3.T1.6.1.1.3.1.1.1" class="ltx_text ltx_font_bold">Diverse Att-</span></span>
<span id="S3.T1.6.1.1.3.1.2" class="ltx_p"><span id="S3.T1.6.1.1.3.1.2.1" class="ltx_text ltx_font_bold">ack Strategy</span></span>
</span></td>
<td id="S3.T1.6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">
<span id="S3.T1.6.1.1.4.1" class="ltx_inline-block ltx_align_left">
<span id="S3.T1.6.1.1.4.1.1" class="ltx_p"><span id="S3.T1.6.1.1.4.1.1.1" class="ltx_text ltx_font_bold">Plug-and-</span></span>
<span id="S3.T1.6.1.1.4.1.2" class="ltx_p"><span id="S3.T1.6.1.1.4.1.2.1" class="ltx_text ltx_font_bold">play Attacks</span></span>
</span></td>
<td id="S3.T1.6.1.1.5" class="ltx_td ltx_align_center ltx_border_tt">
<span id="S3.T1.6.1.1.5.1" class="ltx_inline-block ltx_align_left">
