<th id="A2.T8.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A2.T8.2.1.2.1" class="ltx_text ltx_font_bold">Judge</span></th>
<th id="A2.T8.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A2.T8.2.1.3.1" class="ltx_text ltx_font_bold">Dataset</span></th>
<th id="A2.T8.2.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A2.T8.2.1.4.1" class="ltx_text ltx_font_bold">ASR</span></th>
