</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
              Initialize <math id="alg1.l8.m1" class="ltx_Math" alttext="\mathcal{I}_{\text{adv}}^{0},y^{\ast},\text{res}\leftarrow\emptyset,s^{\ast}_{i}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mn>0</mn></msubsup><mo>,</mo><msup><mi>y</mi><mo>∗</mo></msup><mo>,</mo><mrow><mtext>res</mtext><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><mo>,</mo><mrow><msubsup><mi>s</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">←</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}_{\text{adv}}^{0},y^{\ast},\text{res}\leftarrow\emptyset,s^{\ast}_{i}\leftarrow 0</annotation></semantics></math>, <math id="alg1.l8.m2" class="ltx_Math" alttext="\mathcal{I}_{\text{adv}}^{\ast}\leftarrow\mathcal{I}_{\text{adv}}^{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mo>∗</mo></msubsup><mo stretchy="false">←</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mn>0</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{I}_{\text{adv}}^{\ast}\leftarrow\mathcal{I}_{\text{adv}}^{0}</annotation></semantics></math>

</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
              Compute exploration likelihood <math id="alg1.l9.m1" class="ltx_Math" alttext="\epsilon_{i}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\epsilon_{i}</annotation></semantics></math> <span id="alg1.l9.2" class="ltx_text" style="float:right;"><math id="alg1.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l9.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> <span id="alg1.l9.2.1.1" class="ltx_text">Eq.</span> (<a href="#S3.E1" title="Equation 1 ‣ 3.4 Diversity-Enhanced Layered Memory Module ‣ 3 ARMs Framework ‣ ARMs: Adaptive Red-Teaming Agent against Multimodal Models with Plug-and-Play Attacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>)</span>
</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
              Retrieve <math id="alg1.l10.m1" class="ltx_Math" alttext="\zeta_{\text{mem}}\sim\mathcal{D}_{\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mtext>mem</mtext></msub><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\zeta_{\text{mem}}\sim\mathcal{D}_{\theta}</annotation></semantics></math> with prob <math id="alg1.l10.m2" class="ltx_Math" alttext="1-\epsilon_{i}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><msub><mi>ϵ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">1-\epsilon_{i}</annotation></semantics></math> <span id="alg1.l10.2" class="ltx_text" style="float:right;"><math id="alg1.l10.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l10.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> <span id="alg1.l10.2.1.1" class="ltx_text">Eq.</span> (<a href="#S3.E2" title="Equation 2 ‣ 3.4 Diversity-Enhanced Layered Memory Module ‣ 3 ARMs Framework ‣ ARMs: Adaptive Red-Teaming Agent against Multimodal Models with Plug-and-Play Attacks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>)</span>
</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
              <span id="alg1.l11.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l11.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math> to <math id="alg1.l11.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> <span id="alg1.l11.3" class="ltx_text ltx_font_bold">do</span> <span id="alg1.l11.4" class="ltx_text" style="float:right;"><math id="alg1.l11.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l11.4.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> Attack optimization turns</span>
</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
               <math id="alg1.l12.m1" class="ltx_Math" alttext="(a_{t},\hat{\mathcal{I}}_{\text{adv}}^{t})\leftarrow\pi_{\text{{ARMs} }}(x_{i},\mathcal{I}_{\text{adv}}^{t-1},\zeta_{\text{mem}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>^</mo></mover><mtext>adv</mtext><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><msub><mi>π</mi><mrow><mtext class="ltx_font_smallcaps">ARMs</mtext><mtext> </mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mtext>adv</mtext><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msub><mi>ζ</mi><mtext>mem</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(a_{t},\hat{\mathcal{I}}_{\text{adv}}^{t})\leftarrow\pi_{\text{{ARMs} }}(x_{i},\mathcal{I}_{\text{adv}}^{t-1},\zeta_{\text{mem}})</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
