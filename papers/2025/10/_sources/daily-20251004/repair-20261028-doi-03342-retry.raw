familyName":"Xia","affiliation":[],"nameIdentifiers":[]},{"name":"Xiao, Ted","nameType":"Personal","givenName":"Ted","familyName":"Xiao","affiliation":[],"nameIdentifiers":[]},{"name":"Xie, Annie","nameType":"Personal","givenName":"Annie","familyName":"Xie","affiliation":[],"nameIdentifiers":[]},{"name":"Xie, Jinyu","nameType":"Personal","givenName":"Jinyu","familyName":"Xie","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Peng","nameType":"Personal","givenName":"Peng","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Sichun","nameType":"Personal","givenName":"Sichun","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Ying","nameType":"Personal","givenName":"Ying","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Zhuo","nameType":"Personal","givenName":"Zhuo","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Yan, Jimmy","nameType":"Personal","givenName":"Jimmy","familyName":"Yan","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Sherry","nameType":"Personal","givenName":"Sherry","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Skye","nameType":"Personal","givenName":"Skye","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Yuxiang","nameType":"Personal","givenName":"Yuxiang","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Hiu Hong","nameType":"Personal","givenName":"Hiu Hong","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Wenhao","nameType":"Personal","givenName":"Wenhao","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Yuan, Wentao","nameType":"Personal","givenName":"Wentao","familyName":"Yuan","affiliation":[],"nameIdentifiers":[]},{"name":"Yuan, Yuan","nameType":"Personal","givenName":"Yuan","familyName":"Yuan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Jingwei","nameType":"Personal","givenName":"Jingwei","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Tingnan","nameType":"Personal","givenName":"Tingnan","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Zhiyuan","nameType":"Personal","givenName":"Zhiyuan","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Allan","nameType":"Personal","givenName":"Allan","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Guangyao","nameType":"Personal","givenName":"Guangyao","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Yuxiang","nameType":"Personal","givenName":"Yuxiang","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gemini Robotics 1.5: Pushing the Frontier of Generalist Robots with Advanced Embodied Reasoning, Thinking, and Motion Transfer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T14:32:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:03:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T10:50:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:48:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-28T18:57:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-02T01:03:48Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"General-purpose robots need a deep understanding of the physical world, advanced reasoning, and general and dexterous control. This report introduces the latest generation of the Gemini Robotics model family: Gemini Robotics 1.5, a multi-embodiment Vision-Language-Action (VLA) model, and Gemini Robotics-ER 1.5, a state-of-the-art Embodied Reasoning (ER) model. We are bringing together three major innovations. First, Gemini Robotics 1.5 features a novel architecture and a Motion Transfer (MT) mechanism, which enables it to learn from heterogeneous, multi-embodiment robot data and makes the VLA more general. Second, Gemini Robotics 1.5 interleaves actions with a multi-level internal reasoning process in natural language. This enables the robot to \"think before acting\" and notably improves its ability to decompose and execute complex, multi-step tasks, and also makes the robot's behavior more interpretable to the user. Third, Gemini Robotics-ER 1.5 establishes a new state-of-the-art for embodied reasoning, i.e., for reasoning capabilities that are critical for robots, such as visual and spatial understanding, task planning, and progress estimation. Together, this family of models takes us a step towards an era of physical agents-enabling robots to perceive, think and then act so they can solve complex multi-step tasks.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.03342","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":2,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:47:35.000Z","registered":"2025-10-07T02:47:36.000Z","published":"2025","updated":"2025-12-02T04:47:39.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.03342","type":"media"}},"references":{"data":[{"id":"10.5281/zenodo.23683347","type":"dois"},{"id":"10.5281/zenodo.23683348","type":"dois"}]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}