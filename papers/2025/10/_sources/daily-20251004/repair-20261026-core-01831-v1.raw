<td id="S5.T1.2.1.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="S5.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Model</span></td>
<td id="S5.T1.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">Correct Mean</span></td>
<td id="S5.T1.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.2.1.1.4.1" class="ltx_text ltx_font_bold">Incorrect Mean</span></td>
<td id="S5.T1.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><math id="S5.T1.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math><span id="S5.T1.2.1.1.5.1" class="ltx_text ltx_font_bold"> DLT</span></td></tr>
