<td id="S5.T1.2.1.7.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="5"><span id="S5.T1.2.1.7.1.1" class="ltx_text">SVAMP</span></td>
<td id="S5.T1.2.1.7.2" class="ltx_td ltx_align_left ltx_border_t">Gemma</td>
<td id="S5.T1.2.1.7.3" class="ltx_td ltx_align_center ltx_border_t">17.34</td>
<td id="S5.T1.2.1.7.4" class="ltx_td ltx_align_center ltx_border_t">18.70</td>
<td id="S5.T1.2.1.7.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.2.1.7.5.1" class="ltx_text ltx_font_bold">+1.36<sup id="S5.T1.2.1.7.5.1.1" class="ltx_sup"><span id="S5.T1.2.1.7.5.1.1.1" class="ltx_text ltx_font_italic">∗</span></sup></span></td></tr>
<tr id="S5.T1.2.1.8" class="ltx_tr">
<td id="S5.T1.2.1.8.1" class="ltx_td ltx_align_left">Granite</td>
<td id="S5.T1.2.1.8.2" class="ltx_td ltx_align_center">16.95</td>
<td id="S5.T1.2.1.8.3" class="ltx_td ltx_align_center">18.58</td>
<td id="S5.T1.2.1.8.4" class="ltx_td ltx_align_center"><span id="S5.T1.2.1.8.4.1" class="ltx_text ltx_font_bold">+1.62<sup id="S5.T1.2.1.8.4.1.1" class="ltx_sup"><span id="S5.T1.2.1.8.4.1.1.1" class="ltx_text ltx_font_italic">∗</span></sup></span></td></tr>
<tr id="S5.T1.2.1.9" class="ltx_tr">
<td id="S5.T1.2.1.9.1" class="ltx_td ltx_align_left">LLaMA</td>
