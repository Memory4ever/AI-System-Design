<td id="A1.T3.2.1.2.7" class="ltx_td ltx_align_center"><span id="A1.T3.2.1.2.7.1" class="ltx_text ltx_font_bold">t-stat.</span></td>
<td id="A1.T3.2.1.2.8" class="ltx_td ltx_align_center"><span id="A1.T3.2.1.2.8.1" class="ltx_text ltx_font_bold">p-val.</span></td></tr>
