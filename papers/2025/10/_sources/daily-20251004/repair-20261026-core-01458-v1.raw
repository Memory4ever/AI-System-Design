<tr id="A1.T2.2.5" class="ltx_tr">
<td id="A1.T2.2.5.1" class="ltx_td ltx_align_left"><math id="A1.T2.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></td>
<td id="A1.T2.2.5.2" class="ltx_td ltx_align_left">0.1</td></tr>
