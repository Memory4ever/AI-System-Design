{"data":[{"id":"10.48550/arxiv.2510.01565","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01565","identifiers":[{"identifier":"2510.01565","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Runyu","familyName":"Lu","name":"Lu, Runyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiqi","familyName":"He","name":"He, Shiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxuan","familyName":"Tan","name":"Tan, Wenxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenggui","familyName":"Li","name":"Li, Shenggui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruofan","familyName":"Wu","name":"Wu, Ruofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeff J.","familyName":"Ma","name":"Ma, Jeff J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ang","familyName":"Chen","name":"Chen, Ang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mosharaf","familyName":"Chowdhury","name":"Chowdhury, Mosharaf","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TetriServe: Efficiently Serving Mixed DiT Workloads"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T01:23:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:17:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T00:16:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:19:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-15T20:28:33Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-19T01:04:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-18T01:08:24Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-19T00:16:06Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion Transformer (DiT) models excel at generating high-quality images through iterative denoising steps, but serving them under strict Service Level Objectives (SLOs) is challenging due to their high computational cost, particularly at larger resolutions. Existing serving systems use fixed-degree sequence parallelism, which is inefficient for heterogeneous workloads with mixed resolutions and deadlines, leading to poor GPU utilization and low SLO attainment.\n In this paper, we propose step-level sequence parallelism to dynamically adjust the degree of parallelism of individual requests according to their deadlines. We present TetriServe, a DiT serving system that implements this strategy for highly efficient image generation. Specifically, TetriServe introduces a novel round-based scheduling mechanism that improves SLO attainment by (1) discretizing time into fixed rounds to make deadline-aware scheduling tractable, (2) adapting parallelism at the step level and minimizing GPU hour consumption, and (3) jointly packing requests to minimize late completions. Extensive evaluation on state-of-the-art DiT models shows that TetriServe achieves up to 32% higher SLO attainment compared to existing solutions without degrading image quality."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01565","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:19Z","registered":"2025-10-03T01:52:20Z","published":null,"updated":"2026-06-19T02:17:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01260","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01260","identifiers":[{"identifier":"2510.01260","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ningyuan","familyName":"Yang","name":"Yang, Ningyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanliang","familyName":"Lyu","name":"Lyu, Guanliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingchen","familyName":"Ma","name":"Ma, Mingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyi","familyName":"Lu","name":"Lu, Yiyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Li","name":"Li, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihui","familyName":"Gao","name":"Gao, Zhihui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hancheng","familyName":"Ye","name":"Ye, Hancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianyi","familyName":"Zhang","name":"Zhang, Jianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tingjun","familyName":"Chen","name":"Chen, Tingjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiran","familyName":"Chen","name":"Chen, Yiran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IoT-MCP: Bridging LLMs and IoT Systems Through Model Context Protocol"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-25T08:35:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The integration of Large Language Models (LLMs) with Internet-of-Things (IoT) systems faces significant challenges in hardware heterogeneity and control complexity. The Model Context Protocol (MCP) emerges as a critical enabler, providing standardized communication between LLMs and physical devices. We propose IoT-MCP, a novel framework that implements MCP through edge-deployed servers to bridge LLMs and IoT ecosystems. To support rigorous evaluation, we introduce IoT-MCP Bench, the first benchmark containing 114 Basic Tasks (e.g., ``What is the current temperature?'') and 1,140 Complex Tasks (e.g., ``I feel so hot, do you have any ideas?'') for IoT-enabled LLMs. Experimental validation across 22 sensor types and 6 microcontroller units demonstrates IoT-MCP's 100% task success rate to generate tool calls that fully meet expectations and obtain completely accurate results, 205ms average response time, and 74KB peak memory footprint. This work delivers both an open-source integration framework (https://github.com/Duke-CEI-Center/IoT-MCP-Servers) and a standardized evaluation methodology for LLM-IoT systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01260","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:44Z","registered":"2025-10-03T01:44:44Z","published":null,"updated":"2025-10-03T01:44:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01256","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01256","identifiers":[{"identifier":"2510.01256","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lingling","familyName":"Zeng","name":"Zeng, Lingling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gen","familyName":"Zhang","name":"Zhang, Gen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialin","familyName":"Peng","name":"Peng, Jialin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Xu","name":"Xu, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Xu","name":"Xu, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lijun","familyName":"Ma","name":"Ma, Lijun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kant: An Efficient Unified Scheduling System for Large-Scale AI Clusters"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.7; C.2.4; C.1.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-25T02:25:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As AI cluster sizes continue to expand and the demand for large-language-model (LLM) training and inference workloads grows rapidly, traditional scheduling systems face significant challenges in balancing resource utilization, scheduling efficiency, and service quality. This paper presents and evaluates Kant: an efficient unified scheduling platform designed for large-scale AI container clusters, supporting the co-scheduling of both training and inference jobs. Based on the practical implementation of the Kant system, we systematically define a set of key evaluation metrics for AI clusters, including GPU Allocation Ratio (GAR), Scheduling Occupancy Rate (SOR), GPU Node Fragmentation Ratio (GFR), Job Waiting Time Distribution (JWTD), and Job Training Time Estimation Distribution (JTTED), providing a foundation for quantitative performance analysis. Experimental results demonstrate that Kant achieves exceptional performance in clusters ranging from hundreds to tens of thousands of GPUs. By leveraging scheduling strategies such as Backfill and Enhanced Binpack (E-Binpack), the system significantly improves resource utilization and scheduling efficiency, while effectively reducing resource fragmentation and communication overhead in distributed training. The system has been deployed in multiple AI data center clusters, where it stably supports large-scale intelligent computing workloads. This work provides a practical engineering approach for building high-performance, highly available, AI-native scheduling infrastructure."},{"descriptionType":"Other","description":"25 pages,15 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01256","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:38Z","registered":"2025-10-03T01:44:38Z","published":null,"updated":"2025-10-03T01:44:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":3,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=registered%3A%5B2025-10-02T16%3A00%3A00Z+TO+2025-10-03T15%3A59%3A59Z%5D+AND+%28subjects.subject%3A%22cs.AR%22+OR+subjects.subject%3A%22cs.DC%22+OR+subjects.subject%3A%22cs.PL%22+OR+subjects.subject%3A%22cs.PF%22%29+AND+%28titles.title%3A%22language+model%22+OR+titles.title%3A%22language+models%22+OR+titles.title%3A%22LLM%22+OR+titles.title%3A%22LLMs%22+OR+titles.title%3A%22transformer%22+OR+titles.title%3A%22transformers%22+OR+titles.title%3A%22foundation+model%22+OR+titles.title%3A%22foundation+models%22+OR+descriptions.description%3A%22language+model%22+OR+descriptions.description%3A%22language+models%22+OR+descriptions.description%3A%22LLM%22+OR+descriptions.description%3A%22LLMs%22+OR+descriptions.description%3A%22transformer%22+OR+descriptions.description%3A%22transformers%22+OR+descriptions.description%3A%22foundation+model%22+OR+descriptions.description%3A%22foundation+models%22%29+AND+%28titles.title%3A%22accelerator%22+OR+titles.title%3A%22accelerators%22+OR+titles.title%3A%22compiler%22+OR+titles.title%3A%22compilers%22+OR+titles.title%3A%22kernel%22+OR+titles.title%3A%22kernels%22+OR+titles.title%3A%22hardware%22+OR+titles.title%3A%22GPU%22+OR+titles.title%3A%22GPUs%22+OR+descriptions.description%3A%22accelerator%22+OR+descriptions.description%3A%22accelerators%22+OR+descriptions.description%3A%22compiler%22+OR+descriptions.description%3A%22compilers%22+OR+descriptions.description%3A%22kernel%22+OR+descriptions.description%3A%22kernels%22+OR+descriptions.description%3A%22hardware%22+OR+descriptions.description%3A%22GPU%22+OR+descriptions.description%3A%22GPUs%22%29\u0026page%5Bsize%5D=1000\u0026page%5Bnumber%5D=1"}}