<td id="S4.T3.2.5.3" class="ltx_td ltx_align_center">0.6308</td>
<td id="S4.T3.2.5.4" class="ltx_td ltx_align_center">0.6630</td>
<td id="S4.T3.2.5.5" class="ltx_td ltx_align_center">0.7531</td>
<td id="S4.T3.2.5.6" class="ltx_td ltx_align_center">1.2530</td>
<td id="S4.T3.2.5.7" class="ltx_td ltx_align_center">1.2558</td>
<td id="S4.T3.2.5.8" class="ltx_td ltx_align_center">1.2648</td></tr>
