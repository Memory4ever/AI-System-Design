<td id="S4.T3.4.1.4.4" class="ltx_td ltx_align_center">38.6</td>
<td id="S4.T3.4.1.4.5" class="ltx_td ltx_align_center">46.6</td></tr>
<tr id="S4.T3.4.1.5" class="ltx_tr">
<td id="S4.T3.4.1.5.1" class="ltx_td ltx_align_left ltx_border_r">GGSD <cite class="ltx_cite ltx_citemacro_citep">(<a href="#biba.bib4" title="" class="ltx_ref">Wang et al., 2024</a>)</cite></td>
<td id="S4.T3.4.1.5.2" class="ltx_td ltx_align_center">40.1</td>
