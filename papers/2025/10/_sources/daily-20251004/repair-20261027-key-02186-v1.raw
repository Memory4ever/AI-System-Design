<td id="A1.T5.4.1.8.2" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="A1.T5.4.1.8.2.1" class="ltx_text ltx_font_typewriter">ME.MinkowskiConvolution</span></td>
<td id="A1.T5.4.1.8.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="A1.T5.m16" class="ltx_Math" alttext="1^{3}" display="inline" intent=":literal"><semantics><msup><mn>1</mn><mn>3</mn></msup><annotation encoding="application/x-tex">1^{3}</annotation></semantics></math></td>
<td id="A1.T5.4.1.8.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">1</td>
<td id="A1.T5.4.1.8.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">512 <math id="A1.T5.m17" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> 128</td></tr>
