<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex76.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 18.49988pt+\sum_{k=0}^{K-1}\Big(\frac{(\alpha-1)((2\eta+\lambda\theta q)\sqrt{\min\{m,n\}})^{\alpha/(\alpha-1)}}{\alpha^{\alpha/(\alpha-1)}(\theta p)^{1/(\alpha-1)}}+3pL_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}\theta^{1-\alpha}\eta^{\alpha}+2p(N\sigma\theta)^{\alpha}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow><mrow><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi mathsize="0.900em">min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathsize="0.900em">m</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></msqrt></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow><mrow><msup><mi mathsize="0.900em">α</mi><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">3</mn><mi mathsize="0.900em">p</mi><msubsup><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><msup><mi mathsize="0.900em">θ</mi><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup><msup><mi mathsize="0.900em">η</mi><mi mathsize="0.900em">α</mi></msup><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">2</mn><mi mathsize="0.900em">p</mi><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">N</mi><mi mathsize="0.900em">σ</mi><mi mathsize="0.900em">θ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 18.49988pt+\sum_{k=0}^{K-1}\Big(\frac{(\alpha-1)((2\eta+\lambda\theta q)\sqrt{\min\{m,n\}})^{\alpha/(\alpha-1)}}{\alpha^{\alpha/(\alpha-1)}(\theta p)^{1/(\alpha-1)}}+3pL_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}\theta^{1-\alpha}\eta^{\alpha}+2p(N\sigma\theta)^{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex77.m1" class="ltx_Math" alttext="\displaystyle\hskip 18.49988pt+\lambda\theta qL_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta+\frac{N\sigma\lambda q\theta^{2}}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">θ</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 18.49988pt+\lambda\theta qL_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta+\frac{N\sigma\lambda q\theta^{2}}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p19.7" class="ltx_p"><span id="S4.p19.7.1" class="ltx_text">Rearranging the terms in this inequality, and using the definition of <math id="S4.p19.m17" class="ltx_Math" alttext="(\eta,\theta,p,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>,</mo><mi>θ</mi><mo>,</mo><mi>p</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\eta,\theta,p,q)</annotation></semantics></math>, we obtain that for all <math id="S4.p19.m18" class="ltx_Math" alttext="K\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">K\geq 4</annotation></semantics></math>,</span></p>
<table id="S4.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex78.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{K}\sum_{k=0}^{K-1}\mathbb{E}[\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow><mrow><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mi mathsize="0.900em">𝔼</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{K}\sum_{k=0}^{K-1}\mathbb{E}[\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex78.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{f(\overline{X}^{0})-f_{\mathrm{low}}+3(N\sigma)^{\alpha}+2(N+1)\lambda\sigma/(1-\lambda)}{K\eta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mn mathsize="0.900em">0</mn></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">low</mi></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mrow><mi mathsize="0.900em">K</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{f(\overline{X}^{0})-f_{\mathrm{low}}+3(N\sigma)^{\alpha}+2(N+1)\lambda\sigma/(1-\lambda)}{K\eta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
