</table>
<p id="S4.p14.2" class="ltx_p"><span id="S4.p14.2.1" class="ltx_text">Notice from (<a href="#S4.E13" title="In IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) that <math id="S4.p14.m2" class="ltx_Math" alttext="\|\overline{X}^{k+1}-\overline{X}^{k}\|=\eta\|\overline{V}^{k}_{O}\|\leq\eta" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msup></mrow><mo stretchy="false">‖</mo></mrow><mo>=</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msubsup><mover accent="true"><mi>V</mi><mo stretchy="true">¯</mo></mover><mi>O</mi><mi>k</mi></msubsup><mo stretchy="false">‖</mo></mrow></mrow><mo>≤</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">\|\overline{X}^{k+1}-\overline{X}^{k}\|=\eta\|\overline{V}^{k}_{O}\|\leq\eta</annotation></semantics></math>. In addition, by Lemma <a href="#Thmlemma1" title="Lemma 1 (consensus error). ‣ II A Decentralized Muon ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and the definition of <math id="S4.p14.m3" class="ltx_Math" alttext="L_{F}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>F</mi></msub><annotation encoding="application/x-tex">L_{F}</annotation></semantics></math> in Section <a href="#S1.SS2" title="I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I-B</span></a>, one has that</span></p>
<table id="S4.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex40.m1" class="ltx_Math" alttext="\displaystyle\|\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1})\|_{*}\leq L_{F}\|X_{[N]}^{k}-X_{[N]}^{k+1}\|" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo mathsize="0.900em">≤</mo><mrow><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1})\|_{*}\leq L_{F}\|X_{[N]}^{k}-X_{[N]}^{k+1}\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E24.m1" class="ltx_Math" alttext="\displaystyle\leq L_{F}(\|X_{[N]}^{k}-\mathbf{1}_{N}\otimes\overline{X}^{k}\|+\|X_{[N]}^{k+1}-\mathbf{1}_{N}\otimes\overline{X}^{k+1}\|+\|\overline{X}^{k}-\overline{X}^{k+1}\|){\leq}L_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">+</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">+</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">≤</mo><mrow><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq L_{F}(\|X_{[N]}^{k}-\mathbf{1}_{N}\otimes\overline{X}^{k}\|+\|X_{[N]}^{k+1}-\mathbf{1}_{N}\otimes\overline{X}^{k+1}\|+\|\overline{X}^{k}-\overline{X}^{k+1}\|){\leq}L_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="S4.p14.3" class="ltx_p"><span id="S4.p14.3.1" class="ltx_text">Using this, Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>(c), (<a href="#S4.E23" title="In Proof. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>), and (<a href="#S4.E24" title="In Proof. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>), we obtain that</span></p>
<table id="S4.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex41.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\nabla F({X}^{k+1}_{[N]})-M_{[N]}^{k+1}\|_{*}]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\nabla F({X}^{k+1}_{[N]})-M_{[N]}^{k+1}\|_{*}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex42.m1" class="ltx_Math" alttext="\displaystyle\leq(1-\theta)(\|M^{k}_{[N]}-\nabla F(X_{[N]}^{k})\|_{*}+\|\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1})\|_{*})+\theta\mathbb{E}_{\xi^{k+1}_{[N]}}[\|G(X_{[N]}^{k+1};\xi^{k+1}_{[N]})-\nabla F(X_{[N]}^{k+1})\|_{*}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo mathsize="0.900em">+</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mi mathsize="0.900em">G</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1-\theta)(\|M^{k}_{[N]}-\nabla F(X_{[N]}^{k})\|_{*}+\|\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1})\|_{*})+\theta\mathbb{E}_{\xi^{k+1}_{[N]}}[\|G(X_{[N]}^{k+1};\xi^{k+1}_{[N]})-\nabla F(X_{[N]}^{k+1})\|_{*}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex43.m1" class="ltx_Math" alttext="\displaystyle\leq(1-\theta)\Big(\|\nabla F({X}^{k}_{[N]})-M_{[N]}^{k}\|_{*}+L_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta\Big)+N\sigma\theta," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1-\theta)\Big(\|\nabla F({X}^{k}_{[N]})-M_{[N]}^{k}\|_{*}+L_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta\Big)+N\sigma\theta,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p14.4" class="ltx_p"><span id="S4.p14.4.1" class="ltx_text">which implies that (<a href="#S4.E21" title="In Lemma 6. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) holds.</span></p>
</div>
<div id="S4.p15" class="ltx_para">
<p id="S4.p15.1" class="ltx_p"><span id="S4.p15.1.1" class="ltx_text">We next prove (<a href="#S4.E22" title="In Lemma 6. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>). By Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, (<a href="#S4.E23" title="In Proof. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>), and (<a href="#S4.E24" title="In Proof. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>), one has that for any <math id="S4.p15.m1" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>,</span></p>
<table id="S4.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex44.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\nabla F({X}^{k+1}_{[N]})-M_{[N]}^{k+1}\|_{F}^{\alpha}]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\nabla F({X}^{k+1}_{[N]})-M_{[N]}^{k+1}\|_{F}^{\alpha}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex45.m1" class="ltx_Math" alttext="\displaystyle\leq\|(1-\theta)(M^{k}_{[N]}-\nabla F(X_{[N]}^{k})+\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1}))\|_{F}^{\alpha}+2\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\theta(G(X_{[N]}^{k+1};\xi^{k+1}_{[N]})-\nabla F(X_{[N]}^{k+1}))\|_{F}^{\alpha}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mrow><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mi mathsize="0.900em">θ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mi mathsize="0.900em">G</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\|(1-\theta)(M^{k}_{[N]}-\nabla F(X_{[N]}^{k})+\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1}))\|_{F}^{\alpha}+2\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\theta(G(X_{[N]}^{k+1};\xi^{k+1}_{[N]})-\nabla F(X_{[N]}^{k+1}))\|_{F}^{\alpha}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex46.m1" class="ltx_Math" alttext="\displaystyle\leq(2+(\alpha-1)^{\alpha-1}c^{1-\alpha})(1-\theta)^{\alpha}\|\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1})\|_{F}^{\alpha}+(1+c)(1-\theta)^{\alpha}\|M^{k}_{[N]}-\nabla F(X_{[N]}^{k})\|_{F}^{\alpha}+2(N\sigma\theta)^{\alpha}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">c</mi><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">c</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(2+(\alpha-1)^{\alpha-1}c^{1-\alpha})(1-\theta)^{\alpha}\|\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1})\|_{F}^{\alpha}+(1+c)(1-\theta)^{\alpha}\|M^{k}_{[N]}-\nabla F(X_{[N]}^{k})\|_{F}^{\alpha}+2(N\sigma\theta)^{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex47.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{ineq:useful-vr}}{\leq}(2+(\alpha-1)^{\alpha-1}c^{1-\alpha})(1-\theta)^{\alpha}L_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}\eta^{\alpha}+(1+c)(1-\theta)^{\alpha}\|M^{k}_{[N]}-\nabla F(X_{[N]}^{k})\|_{F}^{\alpha}+2(N\sigma\theta)^{\alpha}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo mathsize="0.900em">≤</mo><mrow><mtext mathsize="0.630em">(</mtext><mtext mathsize="0.630em"><a href="#S4.E24" title="In Proof. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref" style="font-size:63%;"><span class="ltx_text ltx_ref_tag">24</span></a></mtext><mtext mathsize="0.630em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><mrow><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">c</mi><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mi mathsize="0.900em">α</mi></msup></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">c</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{ineq:useful-vr}}{\leq}(2+(\alpha-1)^{\alpha-1}c^{1-\alpha})(1-\theta)^{\alpha}L_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}\eta^{\alpha}+(1+c)(1-\theta)^{\alpha}\|M^{k}_{[N]}-\nabla F(X_{[N]}^{k})\|_{F}^{\alpha}+2(N\sigma\theta)^{\alpha},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p15.2" class="ltx_p"><span id="S4.p15.2.1" class="ltx_text">where the first and second inequalities are due to Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Letting <math id="S4.p15.m2" class="ltx_Math" alttext="c=(1-\theta)^{1-\alpha}-1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">c=(1-\theta)^{1-\alpha}-1</annotation></semantics></math>, and using the fact that <math id="S4.p15.m3" class="ltx_Math" alttext="\alpha\in(1,2]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(1,2]</annotation></semantics></math>, we have</span></p>
<table id="S4.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex48.m1" class="ltx_Math" alttext="\displaystyle c^{1-\alpha}=((1-\theta)^{1-\alpha}-1)^{1-\alpha}\leq\Big(\frac{1}{1-(\alpha-1)\theta}-1\Big)^{1-\alpha}\leq((\alpha-1)\theta)^{1-\alpha}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathsize="0.900em">c</mi><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup><mo mathsize="0.900em">=</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup><mo mathsize="0.900em">≤</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup><mo mathsize="0.900em">≤</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle c^{1-\alpha}=((1-\theta)^{1-\alpha}-1)^{1-\alpha}\leq\Big(\frac{1}{1-(\alpha-1)\theta}-1\Big)^{1-\alpha}\leq((\alpha-1)\theta)^{1-\alpha},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p15.3" class="ltx_p"><span id="S4.p15.3.1" class="ltx_text">where the first inequality follows from <math id="S4.p15.m4" class="ltx_Math" alttext="(1-\tau)^{\beta}\leq 1-\beta\tau" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>β</mi></msup><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(1-\tau)^{\beta}\leq 1-\beta\tau</annotation></semantics></math> for all <math id="S4.p15.m5" class="ltx_Math" alttext="\tau\in(-\infty,1)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in(-\infty,1)</annotation></semantics></math> and <math id="S4.p15.m6" class="ltx_Math" alttext="\beta\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in[0,1]</annotation></semantics></math>. Combining the above two inequalities, we obtain that</span></p>
<table id="S4.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex49.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\nabla F({X}^{k+1}_{[N]})-M_{[N]}^{k+1}\|^{\alpha}]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\nabla F({X}^{k+1}_{[N]})-M_{[N]}^{k+1}\|^{\alpha}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex50.m1" class="ltx_Math" alttext="\displaystyle\leq L_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}(2+\theta^{1-\alpha})(1-\theta)^{\alpha}\eta^{\alpha}+(1-\theta)\|\nabla F({X}^{k}_{[N]})-M_{[N]}^{k}\|_{F}^{\alpha}+2(N\sigma\theta)^{\alpha}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><msubsup><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">2</mn><mo mathsize="0.900em">+</mo><msup><mi mathsize="0.900em">θ</mi><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mi mathsize="0.900em">α</mi></msup></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq L_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}(2+\theta^{1-\alpha})(1-\theta)^{\alpha}\eta^{\alpha}+(1-\theta)\|\nabla F({X}^{k}_{[N]})-M_{[N]}^{k}\|_{F}^{\alpha}+2(N\sigma\theta)^{\alpha},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p15.4" class="ltx_p"><span id="S4.p15.4.1" class="ltx_text">which along with <math id="S4.p15.m7" class="ltx_Math" alttext="\theta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta\in(0,1)</annotation></semantics></math> and <math id="S4.p15.m8" class="ltx_Math" alttext="\alpha\in(1,2]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(1,2]</annotation></semantics></math> implies that (<a href="#S4.E22" title="In Lemma 6. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) holds.
∎</span></p>
</div>
</div>
<div id="S4.p16" class="ltx_para">
<p id="S4.p16.1" class="ltx_p">The following lemma establishes a descent property for the potential sequence <math id="S4.p16.m1" class="ltx_Math" alttext="\{\mathcal{P}_{k}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathcal{P}_{k}\}</annotation></semantics></math> defined below.</p>
</div>
<div id="Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma7.1" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmlemma7.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma7.p1" class="ltx_para">
<p id="Thmlemma7.p1.1" class="ltx_p"><span id="Thmlemma7.p1.1.1" class="ltx_text ltx_font_italic">Suppose that Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Let <math id="Thmlemma7.p1.m1" class="ltx_Math" alttext="\{(X_{i}^{k},M_{i}^{k},V_{i}^{k})\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>i</mi><mi>k</mi></msubsup><mo>,</mo><msubsup><mi>M</mi><mi>i</mi><mi>k</mi></msubsup><mo>,</mo><msubsup><mi>V</mi><mi>i</mi><mi>k</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(X_{i}^{k},M_{i}^{k},V_{i}^{k})\}</annotation></semantics></math> be the sequence generated by Algorithm <a href="#alg1" title="Algorithm 1 ‣ II A Decentralized Muon ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> with input parameters <math id="Thmlemma7.p1.m2" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> and <math id="Thmlemma7.p1.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, and <math id="Thmlemma7.p1.m4" class="ltx_Math" alttext="L_{*}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">L_{*}</annotation></semantics></math>, <math id="Thmlemma7.p1.m5" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>, and <math id="Thmlemma7.p1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> be defined in Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, and let <math id="Thmlemma7.p1.m7" class="ltx_Math" alttext="\{\mathcal{P}_{k}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathcal{P}_{k}\}</annotation></semantics></math> be defined in (<a href="#S4.E9" title="In IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) for <math id="Thmlemma7.p1.m8" class="ltx_Math" alttext="\{(X_{i}^{k},M_{i}^{k},V_{i}^{k})\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>i</mi><mi>k</mi></msubsup><mo>,</mo><msubsup><mi>M</mi><mi>i</mi><mi>k</mi></msubsup><mo>,</mo><msubsup><mi>V</mi><mi>i</mi><mi>k</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(X_{i}^{k},M_{i}^{k},V_{i}^{k})\}</annotation></semantics></math> and <math id="Thmlemma7.p1.m9" class="ltx_Math" alttext="q=2\eta/(1-\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q=2\eta/(1-\lambda)</annotation></semantics></math> and any positive scalar <math id="Thmlemma7.p1.m10" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>. Then, it holds that for all <math id="Thmlemma7.p1.m11" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math>,</span></p>
<table id="S4.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex51.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\mathcal{P}_{k+1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\mathcal{P}_{k+1}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex51.m2" class="ltx_Math" alttext="\displaystyle\leq\mathcal{P}_{k}-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+\frac{(\alpha-1)((2\eta+\lambda\theta q)\sqrt{n})^{\alpha/(\alpha-1)}}{\alpha^{\alpha/(\alpha-1)}(\theta p)^{1/(\alpha-1)}}+3pL_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\theta^{1-\alpha}\eta^{\alpha}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mi mathsize="0.900em">k</mi></msub><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">n</mi></msqrt></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow><mrow><msup><mi mathsize="0.900em">α</mi><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">θ</mi><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mi mathsize="0.900em">α</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{P}_{k}-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+\frac{(\alpha-1)((2\eta+\lambda\theta q)\sqrt{n})^{\alpha/(\alpha-1)}}{\alpha^{\alpha/(\alpha-1)}(\theta p)^{1/(\alpha-1)}}+3pL_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\theta^{1-\alpha}\eta^{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E25.m1" class="ltx_Math" alttext="\displaystyle\hskip 18.49988pt+2p(N\sigma\theta)^{\alpha}+\lambda\theta qL_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta+\frac{N\sigma\lambda q\theta^{2}}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">θ</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 18.49988pt+2p(N\sigma\theta)^{\alpha}+\lambda\theta qL_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta+\frac{N\sigma\lambda q\theta^{2}}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p17" class="ltx_para">
<p id="S4.p17.1" class="ltx_p"><span id="S4.p17.1.1" class="ltx_text">Fix any <math id="S4.p17.m1" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math>. By (<a href="#S4.E9" title="In IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), (<a href="#S4.E16" title="In Lemma 4. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), (<a href="#S4.E19" title="In Lemma 5. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>), (<a href="#S4.E21" title="In Lemma 6. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>), (<a href="#S4.E22" title="In Lemma 6. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), and the fact that <math id="S4.p17.m2" class="ltx_Math" alttext="q=2\eta/(1-\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q=2\eta/(1-\lambda)</annotation></semantics></math>, one has</span></p>
<table id="S4.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex52.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\mathcal{P}_{k+1}]\overset{\eqref{def:pot}}{=}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo mathsize="0.900em">=</mo><mrow><mtext mathsize="0.630em">(</mtext><mtext mathsize="0.630em"><a href="#S4.E9" title="In IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref" style="font-size:63%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext><mtext mathsize="0.630em">)</mtext></mrow></mover></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\mathcal{P}_{k+1}]\overset{\eqref{def:pot}}{=}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex52.m2" class="ltx_Math" alttext="\displaystyle\ \mathbb{E}_{\xi^{k+1}_{[N]}}\big[f(\overline{X}^{k+1})+p\|\nabla F(X^{k+1}_{[N]})-M^{k+1}_{[N]}\|_{F}^{\alpha}+q\|V^{k+1}_{[N]}-\mathbf{1}_{N}\otimes\overline{V}^{k+1}\|_{*}\big]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">V</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \mathbb{E}_{\xi^{k+1}_{[N]}}\big[f(\overline{X}^{k+1})+p\|\nabla F(X^{k+1}_{[N]})-M^{k+1}_{[N]}\|_{F}^{\alpha}+q\|V^{k+1}_{[N]}-\mathbf{1}_{N}\otimes\overline{V}^{k+1}\|_{*}\big]</annotation></semantics></math></td>
