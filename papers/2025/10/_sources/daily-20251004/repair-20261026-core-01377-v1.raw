<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex68.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\lambda\theta}{1-\theta}\mathbb{E}[\|\nabla F(X^{0}_{[N]})-G(X^{0}_{[N]};\xi^{0}_{[N]})\|_{*}]+\frac{\lambda\sigma\theta}{1-\theta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mn mathsize="0.900em">0</mn></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">G</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mn mathsize="0.900em">0</mn></msubsup><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mn mathsize="0.900em">0</mn></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\lambda\theta}{1-\theta}\mathbb{E}[\|\nabla F(X^{0}_{[N]})-G(X^{0}_{[N]};\xi^{0}_{[N]})\|_{*}]+\frac{\lambda\sigma\theta}{1-\theta}</annotation></semantics></math></td>
