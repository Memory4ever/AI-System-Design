<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex56.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{ineq:vr1}\eqref{ineq:vr2}}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo mathsize="0.900em">≤</mo><mrow><mtext mathsize="0.630em">(</mtext><mtext mathsize="0.630em"><a href="#S4.E21" title="In Lemma 6. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref" style="font-size:63%;"><span class="ltx_text ltx_ref_tag">21</span></a></mtext><mtext mathsize="0.630em">)(</mtext><mtext mathsize="0.630em"><a href="#S4.E22" title="In Lemma 6. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref" style="font-size:63%;"><span class="ltx_text ltx_ref_tag">22</span></a></mtext><mtext mathsize="0.630em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{ineq:vr1}\eqref{ineq:vr2}}{\leq}</annotation></semantics></math></td>
