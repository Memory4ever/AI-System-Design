<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex53.m2" class="ltx_Math" alttext="\displaystyle\ f(\overline{X}^{k})-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+p\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\nabla F(X^{k+1}_{[N]})-M^{k+1}_{[N]}\|_{F}^{\alpha}]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ f(\overline{X}^{k})-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+p\mathbb{E}_{\xi^{k+1}_{[N]}}[\|\nabla F(X^{k+1}_{[N]})-M^{k+1}_{[N]}\|_{F}^{\alpha}]</annotation></semantics></math></td>
