<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E23.m1" class="ltx_Math" alttext="\displaystyle=(1-\theta)((M^{k}_{[N]}-\nabla F(X_{[N]}^{k}))+(\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1})))+\theta(G(X_{[N]}^{k+1};\xi^{k+1}_{[N]})-\nabla F(X_{[N]}^{k+1}))." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">+</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">θ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mi mathsize="0.900em">G</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(1-\theta)((M^{k}_{[N]}-\nabla F(X_{[N]}^{k}))+(\nabla F(X_{[N]}^{k})-\nabla F(X_{[N]}^{k+1})))+\theta(G(X_{[N]}^{k+1};\xi^{k+1}_{[N]})-\nabla F(X_{[N]}^{k+1})).</annotation></semantics></math></td>
