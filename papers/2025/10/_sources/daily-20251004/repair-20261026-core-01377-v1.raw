<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex80.m1" class="ltx_Math" alttext="\displaystyle\hskip 18.49988pt+\frac{2\lambda L_{F}(2\sqrt{N}\lambda/(1-\lambda)+1)/(1-\lambda)}{K\eta\cdot K^{2\alpha/(3\alpha-2)}}+\frac{4N\sigma\lambda/(1-\lambda)}{K\eta\cdot K^{(\alpha+1)/(3\alpha-2)}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><mrow><mi mathsize="0.900em">K</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><msup><mi mathsize="0.900em">K</mi><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">α</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">α</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">2</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mn mathsize="0.900em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><mrow><mi mathsize="0.900em">K</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><msup><mi mathsize="0.900em">K</mi><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">α</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">2</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 18.49988pt+\frac{2\lambda L_{F}(2\sqrt{N}\lambda/(1-\lambda)+1)/(1-\lambda)}{K\eta\cdot K^{2\alpha/(3\alpha-2)}}+\frac{4N\sigma\lambda/(1-\lambda)}{K\eta\cdot K^{(\alpha+1)/(3\alpha-2)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex81.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 18.49988pt+\frac{(\sqrt{N}\lambda/(1-\lambda)+1/2)L_{*}}{K\eta\cdot K^{\alpha/(3\alpha-2)}}\leq U_{\mathrm{dm}}K^{-(\alpha-1)/(3\alpha-2)}," display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">2</mn></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub></mrow><mrow><mrow><mi mathsize="0.900em">K</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><msup><mi mathsize="0.900em">K</mi><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">α</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">2</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle><mo mathsize="0.900em">≤</mo><mi mathsize="0.900em">U</mi><msub><mrow></mrow><mi mathsize="0.900em">dm</mi></msub><mi mathsize="0.900em">K</mi><msup><mrow></mrow><mrow><mo mathsize="0.900em">−</mo><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em">)</mo><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">3</mn><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">2</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 18.49988pt+\frac{(\sqrt{N}\lambda/(1-\lambda)+1/2)L_{*}}{K\eta\cdot K^{\alpha/(3\alpha-2)}}\leq U_{\mathrm{dm}}K^{-(\alpha-1)/(3\alpha-2)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p19.8" class="ltx_p"><span id="S4.p19.8.1" class="ltx_text">where the last inequality is due to (<a href="#S2.E8" title="In Theorem 1 (iteration complexity). ‣ II A Decentralized Muon ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) and <math id="S4.p19.m19" class="ltx_Math" alttext="K\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">K\geq 4</annotation></semantics></math>. Thus, we obtain that for all <math id="S4.p19.m20" class="ltx_Math" alttext="K\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">K\geq 4</annotation></semantics></math>,</span></p>
<table id="S4.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex82.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|\overline{\nabla}F({X}_{[N]}^{\iota_{K}})\|_{*}]=\frac{1}{K}\sum_{k=0}^{K-1}\mathbb{E}[\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}]\leq\frac{U_{\mathrm{dm}}}{K^{(\alpha-1)/(3\alpha-2)}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathsize="0.900em">𝔼</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><msub><mi mathsize="0.900em">ι</mi><mi mathsize="0.900em">K</mi></msub></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow><mrow><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mi mathsize="0.900em">𝔼</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow></mrow><mo mathsize="0.900em">≤</mo><mstyle displaystyle="true"><mfrac><msub><mi mathsize="0.900em">U</mi><mi mathsize="0.900em">dm</mi></msub><msup><mi mathsize="0.900em">K</mi><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">α</mi></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">2</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mfrac></mstyle></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|\overline{\nabla}F({X}_{[N]}^{\iota_{K}})\|_{*}]=\frac{1}{K}\sum_{k=0}^{K-1}\mathbb{E}[\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}]\leq\frac{U_{\mathrm{dm}}}{K^{(\alpha-1)/(3\alpha-2)}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p19.9" class="ltx_p"><span id="S4.p19.9.1" class="ltx_text">Hence, the conclusion of this theorem holds as desired.
∎</span></p>
</div>
</div>
</section>
