<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex28.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{N}\sum_{i=1}^{N}\|\overline{V}^{k}-V_{i}^{k}\|_{*}-\frac{1}{N}\sum_{i=1}^{N}\|V_{i}^{k}\|_{*}\leq\frac{2}{N}\sum_{i=1}^{N}\|\overline{V}^{k}-V_{i}^{k}\|_{*}-\|\overline{V}^{k}\|_{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></munderover></mstyle><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></munderover></mstyle><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow></mrow><mo mathsize="0.900em">≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">2</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></munderover></mstyle><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo mathsize="0.900em">−</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{N}\sum_{i=1}^{N}\|\overline{V}^{k}-V_{i}^{k}\|_{*}-\frac{1}{N}\sum_{i=1}^{N}\|V_{i}^{k}\|_{*}\leq\frac{2}{N}\sum_{i=1}^{N}\|\overline{V}^{k}-V_{i}^{k}\|_{*}-\|\overline{V}^{k}\|_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
