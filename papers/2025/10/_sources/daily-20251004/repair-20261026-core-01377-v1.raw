<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex29.m1" class="ltx_Math" alttext="\displaystyle\leq-\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+\|\overline{\nabla}F({X}_{[N]}^{k})-\overline{V}^{k}\|_{*}+\frac{2}{N}\sum_{i=1}^{N}\|\overline{V}^{k}-V_{i}^{k}\|_{*}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mo mathsize="0.900em">−</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><mo mathsize="0.900em">+</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo mathsize="0.900em">+</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">2</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></munderover></mstyle><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+\|\overline{\nabla}F({X}_{[N]}^{k})-\overline{V}^{k}\|_{*}+\frac{2}{N}\sum_{i=1}^{N}\|\overline{V}^{k}-V_{i}^{k}\|_{*},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p10.4" class="ltx_p"><span id="S4.p10.4.1" class="ltx_text">where the first inequality follows from the trace Hölder inequality and <math id="S4.p10.m8" class="ltx_Math" alttext="\|\mathrm{msgn}(V_{i}^{k})\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>msgn</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mi>i</mi><mi>k</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\mathrm{msgn}(V_{i}^{k})\|\leq 1</annotation></semantics></math> for each <math id="S4.p10.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and the last two inequalities follow from the triangular inequality. Using this inequality, Lemma <a href="#Thmlemma1" title="Lemma 1 (consensus error). ‣ II A Decentralized Muon ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, (<a href="#S4.E18" title="In Proof. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>), Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>(i), and <math id="S4.p10.m10" class="ltx_Math" alttext="\overline{M}^{k}=\overline{V}^{k}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msup><mo>=</mo><msup><mover accent="true"><mi>V</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\overline{M}^{k}=\overline{V}^{k}</annotation></semantics></math>, we obtain that</span></p>
<table id="S4.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex30.m1" class="ltx_Math" alttext="\displaystyle f(\overline{X}^{k+1})\leq f(\overline{X}^{k})-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+2\eta\|\overline{\nabla}F({X}_{[N]}^{k})-\overline{M}^{k}\|_{*}+\frac{2\eta}{N}\sum_{i=1}^{N}\|\overline{V}^{k}-V_{i}^{k}\|_{*}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">≤</mo><mrow><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">M</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></munderover></mstyle><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle f(\overline{X}^{k+1})\leq f(\overline{X}^{k})-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+2\eta\|\overline{\nabla}F({X}_{[N]}^{k})-\overline{M}^{k}\|_{*}+\frac{2\eta}{N}\sum_{i=1}^{N}\|\overline{V}^{k}-V_{i}^{k}\|_{*}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2},</annotation></semantics></math></td>
