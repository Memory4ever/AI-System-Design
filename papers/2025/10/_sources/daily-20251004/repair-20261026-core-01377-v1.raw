<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex63.m1" class="ltx_Math" alttext="\displaystyle\hskip 18.49988pt-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+\frac{(\alpha-1)((2\eta+\lambda\theta q)\sqrt{\min\{m,n\}})^{\alpha/(\alpha-1)}}{\alpha^{\alpha/(\alpha-1)}(\theta p)^{1/(\alpha-1)}}+3pL_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}\theta^{1-\alpha}\eta^{\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi mathsize="0.900em">min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathsize="0.900em">m</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></msqrt></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow><mrow><msup><mi mathsize="0.900em">α</mi><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">θ</mi><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mi mathsize="0.900em">α</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 18.49988pt-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+\frac{(\alpha-1)((2\eta+\lambda\theta q)\sqrt{\min\{m,n\}})^{\alpha/(\alpha-1)}}{\alpha^{\alpha/(\alpha-1)}(\theta p)^{1/(\alpha-1)}}+3pL_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}\theta^{1-\alpha}\eta^{\alpha}</annotation></semantics></math></td>
