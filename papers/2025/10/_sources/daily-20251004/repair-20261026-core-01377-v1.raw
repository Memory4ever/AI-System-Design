<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex75.m1" class="ltx_Math" alttext="\displaystyle\leq f(\overline{X}^{0})+(N\sigma)^{\alpha}+\frac{2(N+1)\lambda\sigma\theta}{(1-\theta)(1-\lambda)}-\eta\sum_{k=0}^{K-1}\mathbb{E}[\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mn mathsize="0.900em">0</mn></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow><mrow><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mi mathsize="0.900em">𝔼</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq f(\overline{X}^{0})+(N\sigma)^{\alpha}+\frac{2(N+1)\lambda\sigma\theta}{(1-\theta)(1-\lambda)}-\eta\sum_{k=0}^{K-1}\mathbb{E}[\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}]</annotation></semantics></math></td>
