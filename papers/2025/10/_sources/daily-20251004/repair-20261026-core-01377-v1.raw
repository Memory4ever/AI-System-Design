<div id="S3.F2.sf1.1" class="ltx_block ltx_minipage ltx_align_top" style="width:110.4pt;"><object type="image/svg+xml" data="2510.01377v1/val.svg" id="S3.F2.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:153/121;" width="153" height="121"></object>
</div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span>Complete Graph</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S3.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center">
<div id="S3.F2.sf2.1" class="ltx_block ltx_minipage ltx_align_top" style="width:110.4pt;"><object type="image/svg+xml" data="2510.01377v1/x3.svg" id="S3.F2.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:153/121;" width="153" height="121"></object>
</div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>Directed Exponential Graph</figcaption>
