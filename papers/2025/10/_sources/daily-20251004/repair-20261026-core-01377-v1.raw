<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex58.m1" class="ltx_Math" alttext="\displaystyle+3pL_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}\theta^{1-\alpha}\eta^{\alpha}+2p(N\sigma\theta)^{\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">θ</mi><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mi mathsize="0.900em">α</mi></msup></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+3pL_{F}^{\alpha}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)^{\alpha}\theta^{1-\alpha}\eta^{\alpha}+2p(N\sigma\theta)^{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E26.m1" class="ltx_Math" alttext="\displaystyle+\lambda\theta qL_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta+\frac{N\sigma\lambda q\theta^{2}}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">θ</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\lambda\theta qL_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta+\frac{N\sigma\lambda q\theta^{2}}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="S4.p17.2" class="ltx_p"><span id="S4.p17.2.1" class="ltx_text">In addition, letting <math id="S4.p17.m3" class="ltx_Math" alttext="\alpha^{\prime}=\alpha/(\alpha-1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>α</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha^{\prime}=\alpha/(\alpha-1)</annotation></semantics></math> and using the Young’s inequality, we have</span></p>
<table id="S4.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex59.m1" class="ltx_Math" alttext="\displaystyle(2\eta+\lambda\theta q)\|\nabla F({X}_{[N]}^{k})-M_{[N]}^{k}\|_{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle(2\eta+\lambda\theta q)\|\nabla F({X}_{[N]}^{k})-M_{[N]}^{k}\|_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex59.m2" class="ltx_Math" alttext="\displaystyle\leq(2\eta+\lambda\theta q)\sqrt{\min\{m,n\}}\|\nabla F({X}_{[N]}^{k})-M_{[N]}^{k}\|_{F}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi mathsize="0.900em">min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathsize="0.900em">m</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(2\eta+\lambda\theta q)\sqrt{\min\{m,n\}}\|\nabla F({X}_{[N]}^{k})-M_{[N]}^{k}\|_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex60.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{((\alpha\theta p)^{1/\alpha}\|\nabla F({X}_{[N]}^{k})-M_{[N]}^{k}\|_{F})^{\alpha}}{\alpha}+\frac{\Big(\frac{(2\eta+\lambda\theta q)\sqrt{\min\{m,n\}}}{(\alpha\theta p)^{1/\alpha}}\Big)^{\alpha^{\prime}}}{\alpha^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mi mathsize="0.900em">α</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup><mi mathsize="0.900em">α</mi></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi mathsize="0.900em">min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathsize="0.900em">m</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></msqrt></mrow><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mi mathsize="0.900em">α</mi></mrow></msup></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><msup><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">′</mo></msup></msup><msup><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">′</mo></msup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{((\alpha\theta p)^{1/\alpha}\|\nabla F({X}_{[N]}^{k})-M_{[N]}^{k}\|_{F})^{\alpha}}{\alpha}+\frac{\Big(\frac{(2\eta+\lambda\theta q)\sqrt{\min\{m,n\}}}{(\alpha\theta p)^{1/\alpha}}\Big)^{\alpha^{\prime}}}{\alpha^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
