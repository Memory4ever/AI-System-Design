<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex55.m1" class="ltx_Math" alttext="\displaystyle+(2\eta+\lambda q)\|V^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{V}^{k}\|_{*}+\frac{\lambda\sigma\theta q}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">V</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+(2\eta+\lambda q)\|V^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{V}^{k}\|_{*}+\frac{\lambda\sigma\theta q}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}</annotation></semantics></math></td>
