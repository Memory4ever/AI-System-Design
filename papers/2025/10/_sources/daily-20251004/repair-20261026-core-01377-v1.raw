<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex74.m1" class="ltx_Math" alttext="\displaystyle\hskip 18.49988pt+2p(N\sigma\theta)^{\alpha}+\lambda\theta qL_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta+\frac{N\sigma\lambda q\theta^{2}}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}\Big)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">θ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">θ</mi><mn mathsize="0.900em">2</mn></msup></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">θ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 18.49988pt+2p(N\sigma\theta)^{\alpha}+\lambda\theta qL_{F}\Big(\frac{2\sqrt{N}\lambda}{1-\lambda}+1\Big)\eta+\frac{N\sigma\lambda q\theta^{2}}{1-\theta}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}\Big)</annotation></semantics></math></td>
