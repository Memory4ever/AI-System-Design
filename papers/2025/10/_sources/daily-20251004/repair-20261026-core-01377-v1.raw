em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(1-\theta)M^{k}_{[N]}+\theta G(X_{[N]}^{k+1};\xi^{k+1}_{[N]})-\nabla F(X_{[N]}^{k+1})</annotation></semantics></math></td>
