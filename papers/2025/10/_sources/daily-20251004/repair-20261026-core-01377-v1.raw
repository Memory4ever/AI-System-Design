<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex62.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\mathcal{P}_{k+1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝔼</mi><msubsup><mi mathsize="0.900em">ξ</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi^{k+1}_{[N]}}[\mathcal{P}_{k+1}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex62.m2" class="ltx_Math" alttext="\displaystyle\leq f(\overline{X}^{k})+p\|\nabla F(X^{k}_{[N]})-M^{k}_{[N]}\|_{F}^{\alpha}+q\|V^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{V}^{k}\|_{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">V</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq f(\overline{X}^{k})+p\|\nabla F(X^{k}_{[N]})-M^{k}_{[N]}\|_{F}^{\alpha}+q\|V^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{V}^{k}\|_{*}</annotation></semantics></math></td>
