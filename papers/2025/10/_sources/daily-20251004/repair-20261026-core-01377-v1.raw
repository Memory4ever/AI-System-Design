<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex17.m1" class="ltx_Math" alttext="\displaystyle=\Big(\Big(W-\frac{1}{N}\mathbf{1}_{N}\mathbf{1}_{N}^{T}\Big)\otimes I_{m}\Big)\Big(\Big(\Big(I_{N}-\frac{1}{N}\mathbf{1}_{N}\mathbf{1}_{N}^{T}\Big)\otimes I_{m}\Big)X^{k-1}_{[N]}+\eta V^{k-1}_{O,[N]}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi mathsize="0.900em">W</mi><mo mathsize="0.900em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi><mi mathsize="0.900em">T</mi></msubsup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo mathsize="0.900em" rspace="0.222em">⊗</mo><msub><mi mathsize="0.900em">I</mi><mi mathsize="0.900em">m</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi mathsize="0.900em">I</mi><mi mathsize="0.900em">N</mi></msub><mo mathsize="0.900em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi><mi mathsize="0.900em">T</mi></msubsup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo mathsize="0.900em" rspace="0.222em">⊗</mo><msub><mi mathsize="0.900em">I</mi><mi mathsize="0.900em">m</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">O</mi><mo mathsize="0.900em">,</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Big(\Big(W-\frac{1}{N}\mathbf{1}_{N}\mathbf{1}_{N}^{T}\Big)\otimes I_{m}\Big)\Big(\Big(\Big(I_{N}-\frac{1}{N}\mathbf{1}_{N}\mathbf{1}_{N}^{T}\Big)\otimes I_{m}\Big)X^{k-1}_{[N]}+\eta V^{k-1}_{O,[N]}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex18.m1" class="ltx_Math" alttext="\displaystyle=\Big(\Big(W-\frac{1}{N}\mathbf{1}_{N}\mathbf{1}_{N}^{T}\Big)\otimes I_{m}\Big)\big(X_{[N]}^{k-1}-\mathbf{1}_{N}\otimes\overline{X}^{k-1}-\eta V^{k-1}_{O,[N]}\big)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi mathsize="0.900em">W</mi><mo mathsize="0.900em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi><mi mathsize="0.900em">T</mi></msubsup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo mathsize="0.900em" rspace="0.222em">⊗</mo><msub><mi mathsize="0.900em">I</mi><mi mathsize="0.900em">m</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">O</mi><mo mathsize="0.900em">,</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\Big(\Big(W-\frac{1}{N}\mathbf{1}_{N}\mathbf{1}_{N}^{T}\Big)\otimes I_{m}\Big)\big(X_{[N]}^{k-1}-\mathbf{1}_{N}\otimes\overline{X}^{k-1}-\eta V^{k-1}_{O,[N]}\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p8.2" class="ltx_p"><span id="S4.p8.2.1" class="ltx_text">where the first equality is due to Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>(ii), the third equality follows from (<a href="#S1.E2" title="In I-A Notation ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) and double stochasticity of <math id="S4.p8.m6" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>, the fourth equality is due to (<a href="#S1.E2" title="In I-A Notation ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) and Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>(iii), and the last equality follows from Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>(ii). We recall from Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>(i) that <math id="S4.p8.m7" class="ltx_Math" alttext="\|V^{k}_{O,[N]}\|\leq(\sum_{i=1}^{N}\|\mathrm{msgn}(V^{k}_{i})\|^{2})^{1/2}=\sqrt{N}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msubsup><mi>V</mi><mrow><mi>O</mi><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><mi>k</mi></msubsup><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>msgn</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mi>i</mi><mi>k</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>=</mo><msqrt><mi>N</mi></msqrt></mrow><annotation encoding="application/x-tex">\|V^{k}_{O,[N]}\|\leq(\sum_{i=1}^{N}\|\mathrm{msgn}(V^{k}_{i})\|^{2})^{1/2}=\sqrt{N}</annotation></semantics></math>. Using this, (<a href="#S1.E4" title="In Remark 1. ‣ I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), and the above inequality, we have</span></p>
<table id="S4.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex19.m1" class="ltx_Math" alttext="\displaystyle\|X^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k}\|" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|X^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k}\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex20.m1" class="ltx_Math" alttext="\displaystyle\leq\Big\|\Big(W-\frac{1}{N}\mathbf{1}_{N}\mathbf{1}_{N}^{T}\Big)\otimes I_{m}\Big\|\big(\|X^{k-1}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k-1}\|+\sqrt{N}\eta\big)" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em" rspace="0em">≤</mo><mo fence="false" lspace="0em">|</mo><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi mathsize="0.900em">W</mi><mo mathsize="0.900em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi><mi mathsize="0.900em">T</mi></msubsup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo mathsize="0.900em" rspace="0.222em">⊗</mo><msub><mi mathsize="0.900em">I</mi><mi mathsize="0.900em">m</mi></msub></mrow><mo fence="false">|</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">+</mo><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Big\|\Big(W-\frac{1}{N}\mathbf{1}_{N}\mathbf{1}_{N}^{T}\Big)\otimes I_{m}\Big\|\big(\|X^{k-1}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k-1}\|+\sqrt{N}\eta\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex21.m1" class="ltx_Math" alttext="\displaystyle\leq\lambda\big(\|X^{k-1}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k-1}\|+\sqrt{N}\eta\big)\leq\cdots\leq\lambda^{k}\|X^{0}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{0}\|+\sqrt{N}\eta\sum_{t=1}^{k}\lambda^{t}\leq\frac{\sqrt{N}\lambda\eta}{1-\lambda}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mi mathsize="0.900em">λ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">+</mo><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo mathsize="0.900em" rspace="0.1389em">≤</mo><mo lspace="0.1389em" mathsize="0.900em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em" mathsize="0.900em">≤</mo><mrow><mrow><msup><mi mathsize="0.900em">λ</mi><mi mathsize="0.900em">k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mn mathsize="0.900em">0</mn></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mn mathsize="0.900em">0</mn></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">k</mi></munderover></mstyle><msup><mi mathsize="0.900em">λ</mi><mi mathsize="0.900em">t</mi></msup></mrow></mrow></mrow><mo mathsize="0.900em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\lambda\big(\|X^{k-1}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k-1}\|+\sqrt{N}\eta\big)\leq\cdots\leq\lambda^{k}\|X^{0}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{0}\|+\sqrt{N}\eta\sum_{t=1}^{k}\lambda^{t}\leq\frac{\sqrt{N}\lambda\eta}{1-\lambda},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p8.3" class="ltx_p"><span id="S4.p8.3.1" class="ltx_text">where the last inequality follows from <math id="S4.p8.m8" class="ltx_Math" alttext="X_{i}^{0}=\overline{X}^{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>i</mi><mn>0</mn></msubsup><mo>=</mo><msup><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mn>0</mn></msup></mrow><annotation encoding="application/x-tex">X_{i}^{0}=\overline{X}^{0}</annotation></semantics></math> for each <math id="S4.p8.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. Hence, the conclusion of this lemma holds as desired.
∎</span></p>
</div>
</div>
<div id="S4.p9" class="ltx_para">
<p id="S4.p9.1" class="ltx_p">The following lemma provides a descent inequality on the network average <math id="S4.p9.m1" class="ltx_Math" alttext="\{\overline{X}^{k}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msup><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\overline{X}^{k}\}</annotation></semantics></math>.</p>
</div>
<div id="Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma4.1" class="ltx_text ltx_font_bold">Lemma 4</span></span><span id="Thmlemma4.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma4.p1" class="ltx_para">
<p id="Thmlemma4.p1.1" class="ltx_p"><span id="Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">Suppose that Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Let <math id="Thmlemma4.p1.m1" class="ltx_Math" alttext="\{(X^{k}_{i},M^{k}_{i},V^{k}_{i})\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>i</mi><mi>k</mi></msubsup><mo>,</mo><msubsup><mi>M</mi><mi>i</mi><mi>k</mi></msubsup><mo>,</mo><msubsup><mi>V</mi><mi>i</mi><mi>k</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(X^{k}_{i},M^{k}_{i},V^{k}_{i})\}</annotation></semantics></math> be generated by Algorithm <a href="#alg1" title="Algorithm 1 ‣ II A Decentralized Muon ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> with input parameters <math id="Thmlemma4.p1.m2" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> and <math id="Thmlemma4.p1.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>. Then, it holds that for all <math id="Thmlemma4.p1.m4" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math>,</span></p>
<table id="S4.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex22.m1" class="ltx_Math" alttext="\displaystyle f(\overline{X}^{k+1})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f(\overline{X}^{k+1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E16.m1" class="ltx_Math" alttext="\displaystyle\leq f(\overline{X}^{k})-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+2\eta\|\nabla F({X}_{[N]}^{k})-M_{[N]}^{k}\|_{*}+2\eta\|V_{[N]}^{k}-\mathbf{1}_{N}\otimes\overline{V}^{k}\|_{*}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">M</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">V</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq f(\overline{X}^{k})-\eta\|\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+2\eta\|\nabla F({X}_{[N]}^{k})-M_{[N]}^{k}\|_{*}+2\eta\|V_{[N]}^{k}-\mathbf{1}_{N}\otimes\overline{V}^{k}\|_{*}+\Big(\frac{\sqrt{N}\lambda}{1-\lambda}+\frac{1}{2}\Big)L_{*}\eta^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="Thmlemma4.p1.2" class="ltx_p"><span id="Thmlemma4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma4.p1.m5" class="ltx_Math" alttext="L_{*}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">L_{*}</annotation></semantics></math> is given in Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>(b), and <math id="Thmlemma4.p1.m6" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is defined in (<a href="#S1.E4" title="In Remark 1. ‣ I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>).</span></p>
</div>
</div>
<div id="S4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p10" class="ltx_para">
<p id="S4.p10.1" class="ltx_p"><span id="S4.p10.1.1" class="ltx_text">Fix any <math id="S4.p10.m1" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math>. Using (<a href="#S4.E11" title="In IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) and the doubly stochasticity of <math id="S4.p10.m2" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>, one can show by induction that <math id="S4.p10.m3" class="ltx_Math" alttext="\overline{M}^{k}=\overline{V}^{k}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msup><mo>=</mo><msup><mover accent="true"><mi>V</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\overline{M}^{k}=\overline{V}^{k}</annotation></semantics></math>. In addition, by Assumption <a href="#Thmassumption1" title="Assumption 1. ‣ I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>(b), and Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>(i), one has</span></p>
<table id="S4.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E17.m1" class="ltx_Math" alttext="\displaystyle\|\nabla f(\overline{X}^{k})-\overline{\nabla}F({X}_{[N]}^{k})\|_{*}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub><annotation encoding="application/x-tex">\displaystyle\|\nabla f(\overline{X}^{k})-\overline{\nabla}F({X}_{[N]}^{k})\|_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E17.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{L_{*}}{N}\sum_{i=1}^{N}\|\overline{X}^{k}-X_{i}^{k}\|\leq L_{*}\|X^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k}\|," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mi mathsize="0.900em">N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></munderover></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">X</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow></mrow></mrow><mo mathsize="0.900em">≤</mo><mrow><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{L_{*}}{N}\sum_{i=1}^{N}\|\overline{X}^{k}-X_{i}^{k}\|\leq L_{*}\|X^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k}\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="S4.p10.2" class="ltx_p"><span id="S4.p10.2.1" class="ltx_text">Note that <math id="S4.p10.m4" class="ltx_Math" alttext="\|\overline{V}^{k}_{O}\|\leq\sum_{i=1}^{N}\|\mathrm{msgn}(V_{i}^{k})\|/N\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msubsup><mover accent="true"><mi>V</mi><mo stretchy="true">¯</mo></mover><mi>O</mi><mi>k</mi></msubsup><mo stretchy="false">‖</mo></mrow><mo rspace="0.111em">≤</mo><mrow><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>msgn</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mi>i</mi><mi>k</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><mo>/</mo><mi>N</mi></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\overline{V}^{k}_{O}\|\leq\sum_{i=1}^{N}\|\mathrm{msgn}(V_{i}^{k})\|/N\leq 1</annotation></semantics></math>. Using these, the (<a href="#S1.E3" title="In Remark 1. ‣ I-B Assumptions ‣ I Introduction ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) with <math id="S4.p10.m5" class="ltx_Math" alttext="(X,Y)=(\overline{X}^{k},\overline{X}^{k+1})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msup><mo>,</mo><msup><mover accent="true"><mi>X</mi><mo stretchy="true">¯</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(X,Y)=(\overline{X}^{k},\overline{X}^{k+1})</annotation></semantics></math>, and (<a href="#S4.E13" title="In IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>), we have</span></p>
<table id="S4.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex23.m1" class="ltx_Math" alttext="\displaystyle f(\overline{X}^{k+1}){\leq}f(\overline{X}^{k})+\langle\nabla f(\overline{X}^{k}),\overline{X}^{k+1}-\overline{X}^{k}\rangle+\frac{L_{*}}{2}\|\overline{X}^{k+1}-\overline{X}^{k}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">≤</mo><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo mathsize="0.900em">+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mn mathsize="0.900em">2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f(\overline{X}^{k+1}){\leq}f(\overline{X}^{k})+\langle\nabla f(\overline{X}^{k}),\overline{X}^{k+1}-\overline{X}^{k}\rangle+\frac{L_{*}}{2}\|\overline{X}^{k+1}-\overline{X}^{k}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex24.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{update-ave-x}}{=}f(\overline{X}^{k})-\eta\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle+\eta\langle\overline{V}^{k}-\nabla f(\overline{X}^{k}),\overline{V}^{k}_{O}\rangle+\frac{L_{*}\eta^{2}}{2}\|\overline{V}^{k}_{O}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo mathsize="0.900em">=</mo><mrow><mtext mathsize="0.630em">(</mtext><mtext mathsize="0.630em"><a href="#S4.E13" title="In IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref" style="font-size:63%;"><span class="ltx_text ltx_ref_tag">13</span></a></mtext><mtext mathsize="0.630em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">,</mo><msubsup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">O</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">,</mo><msubsup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">O</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow><mn mathsize="0.900em">2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><msubsup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">O</mi><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{update-ave-x}}{=}f(\overline{X}^{k})-\eta\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle+\eta\langle\overline{V}^{k}-\nabla f(\overline{X}^{k}),\overline{V}^{k}_{O}\rangle+\frac{L_{*}\eta^{2}}{2}\|\overline{V}^{k}_{O}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex25.m1" class="ltx_Math" alttext="\displaystyle\leq f(\overline{X}^{k})-\eta\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle+\eta\|\nabla f(\overline{X}^{k})-\overline{V}^{k}\|_{*}+\frac{L_{*}\eta^{2}}{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">,</mo><msubsup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">O</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq f(\overline{X}^{k})-\eta\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle+\eta\|\nabla f(\overline{X}^{k})-\overline{V}^{k}\|_{*}+\frac{L_{*}\eta^{2}}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex26.m1" class="ltx_Math" alttext="\displaystyle\leq f(\overline{X}^{k})-\eta\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle+\eta\|\nabla f(\overline{X}^{k})-\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+\eta\|\overline{\nabla}F({X}_{[N]}^{k})-\overline{V}^{k}\|_{*}+\frac{L_{*}\eta^{2}}{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≤</mo><mrow><mrow><mrow><mi mathsize="0.900em">f</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">,</mo><msubsup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">O</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq f(\overline{X}^{k})-\eta\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle+\eta\|\nabla f(\overline{X}^{k})-\overline{\nabla}F({X}_{[N]}^{k})\|_{*}+\eta\|\overline{\nabla}F({X}_{[N]}^{k})-\overline{V}^{k}\|_{*}+\frac{L_{*}\eta^{2}}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E18.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{ineq:ave-grad-1}}{\leq}f(\overline{X}^{k})-\eta\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle+L_{*}\eta\|X^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k}\|+\eta\|\overline{\nabla}F({X}_{[N]}^{k})-\overline{M}^{k}\|_{*}+\frac{L_{*}\eta^{2}}{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mover accent="true"><mo mathsize="0.900em">≤</mo><mrow><mtext mathsize="0.630em">(</mtext><mtext mathsize="0.630em"><a href="#S4.E17" title="In Proof. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref" style="font-size:63%;"><span class="ltx_text ltx_ref_tag">17</span></a></mtext><mtext mathsize="0.630em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">η</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">,</mo><msubsup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">O</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">−</mo><mrow><msub><mn mathsize="0.900em">𝟏</mn><mi mathsize="0.900em">N</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⊗</mo><msup><mover accent="true"><mi mathsize="0.900em">X</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mover accent="true"><mo mathsize="0.900em">∇</mo><mo stretchy="true">¯</mo></mover><mo lspace="0.167em" rspace="0em">​</mo><mi mathsize="0.900em">F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">N</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">M</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mo mathsize="0.900em">∗</mo></msub></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathsize="0.900em">L</mi><mo mathsize="0.900em">∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{ineq:ave-grad-1}}{\leq}f(\overline{X}^{k})-\eta\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle+L_{*}\eta\|X^{k}_{[N]}-\mathbf{1}_{N}\otimes\overline{X}^{k}\|+\eta\|\overline{\nabla}F({X}_{[N]}^{k})-\overline{M}^{k}\|_{*}+\frac{L_{*}\eta^{2}}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="S4.p10.3" class="ltx_p"><span id="S4.p10.3.1" class="ltx_text">where the second inequality follows from <math id="S4.p10.m6" class="ltx_Math" alttext="\|\overline{V}^{k}_{O}\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msubsup><mover accent="true"><mi>V</mi><mo stretchy="true">¯</mo></mover><mi>O</mi><mi>k</mi></msubsup><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\overline{V}^{k}_{O}\|\leq 1</annotation></semantics></math> and the trace Hölder inequality, the third inequality is due to the triangular inequality, and the last inequality follows from (<a href="#S4.E17" title="In Proof. ‣ IV Proof of the Main Results ‣ DeMuon: A Decentralized Muon for Matrix Optimization over Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) and <math id="S4.p10.m7" class="ltx_Math" alttext="\overline{M}^{k}=\overline{V}^{k}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msup><mo>=</mo><msup><mover accent="true"><mi>V</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\overline{M}^{k}=\overline{V}^{k}</annotation></semantics></math>. Also, notice that</span></p>
<table id="S4.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex27.m1" class="ltx_Math" alttext="\displaystyle-\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">−</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">,</mo><msubsup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">O</mi><mi mathsize="0.900em">k</mi></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\langle\overline{V}^{k},\overline{V}^{k}_{O}\rangle</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex27.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\frac{1}{N}\sum_{i=1}^{N}\langle\overline{V}^{k}-V_{i}^{k},\mathrm{msgn}(V_{i}^{k})\rangle-\frac{1}{N}\sum_{i=1}^{N}\|V_{i}^{k}\|_{*}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em" rspace="0em">=</mo><mo lspace="0em" mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></munderover></mstyle><mrow><mo stretchy="false">⟨</mo><msup><mover accent="true"><mi mathsize="0.900em">V</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">k</mi></msup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">k</mi></msubsup><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">msgn</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">k</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">N</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></munderover></mstyle><mo lspace="0em" mathsize="0.900em" rspace="0.167em">∥</mo><msubsup><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">k</mi></msubsup><msub><mo lspace="0em" mathsize="0.900em">∥</mo><mo mathsize="0.900em">∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{1}{N}\sum_{i=1}^{N}\langle\overline{V}^{k}-V_{i}^{k},\mathrm{msgn}(V_{i}^{k})\rangle-\frac{1}{N}\sum_{i=1}^{N}\|V_{i}^{k}\|_{*}</annotation></semantics></math></td>
