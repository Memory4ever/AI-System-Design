<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex79.m1" class="ltx_Math" alttext="\displaystyle\hskip 18.49988pt+\frac{(\alpha-1)(2\sqrt{\min\{m,n\}}/(\alpha(1-\lambda)))^{\alpha/(\alpha-1)}+3L_{F}^{\alpha}(2\sqrt{N}\lambda/(1-\lambda)+1)^{\alpha}}{K\eta}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi mathsize="0.900em">min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathsize="0.900em">m</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></msqrt></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mi mathsize="0.900em">α</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></msup></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">N</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">λ</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">α</mi></msup></mrow></mrow><mrow><mi mathsize="0.900em">K</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 18.49988pt+\frac{(\alpha-1)(2\sqrt{\min\{m,n\}}/(\alpha(1-\lambda)))^{\alpha/(\alpha-1)}+3L_{F}^{\alpha}(2\sqrt{N}\lambda/(1-\lambda)+1)^{\alpha}}{K\eta}</annotation></semantics></math></td>
