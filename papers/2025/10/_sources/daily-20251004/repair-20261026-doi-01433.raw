{"data":{"id":"10.48550/arxiv.2510.01433","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01433","prefix":"10.48550","suffix":"arxiv.2510.01433","identifiers":[{"identifier":"2510.01433","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.01433"}],"creators":[{"name":"Singh, Anukriti","nameType":"Personal","givenName":"Anukriti","familyName":"Singh","affiliation":[],"nameIdentifiers":[]},{"name":"Torshizi, Kasra","nameType":"Personal","givenName":"Kasra","familyName":"Torshizi","affiliation":[],"nameIdentifiers":[]},{"name":"Habib, Khuzema","nameType":"Personal","givenName":"Khuzema","familyName":"Habib","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Kelin","nameType":"Personal","givenName":"Kelin","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Ruohan","nameType":"Personal","givenName":"Ruohan","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Tokekar, Pratap","nameType":"Personal","givenName":"Pratap","familyName":"Tokekar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AFFORD2ACT: How Far Can Sparse Keypoints Go for Robot Manipulation?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T20:13:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:09:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-15T19:41:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-17T00:07:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-20T22:36:23Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-22T00:18:10Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Vision-based manipulation policies are commonly learned from rich visual observations, typically using dense visual features extracted from full resolution images. It remains unclear how much of this visual information is really needed for effective policy learning. In this paper, we investigate the opposite end of the spectrum: how effective can manipulation policies be if they use as input only a compact visual representation. Sparse 2D keypoints provide a deliberately compact representation, giving the policy spatial information while removing direct access to appearance, texture, and background. We design AFFORD2ACT (Affordance-Guided Keypoints to Act) to study how much manipulation capability can be retained under this representation constraint. An off-the-shelf language-conditioned affordance model identifies the task-relevant region, from which up to 15 object keypoints are selected, together with 4 end-effector keypoints. The policy input is therefore reduced to only 19 2D keypoints (38 coordinates). A lightweight gating further decides which keypoints to pay attention to during execution. Across six real-robot manipulation tasks, this compact state outperforms the evaluated RGB, RGB-D, and dense-affordance behavior cloning baselines, degrades less as the number of demonstrations is reduced, and achieves 82% average success in held-out settings. Replacing learned gating with uniform weights reduces success from 92% to 52%. At the same time, the representation depends on reliable affordance localization and keypoint tracking, and remains vulnerable to incorrect masks, occlusion, tracking drift, and distractors.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.01433","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:48:59.000Z","registered":"2025-10-03T01:48:59.000Z","published":"2025","updated":"2026-10-22T03:00:20.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.01433","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}