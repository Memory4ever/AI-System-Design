<figure id="A5.F10.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.02272v1/parallel_with_different_langs_accuracy_and_relative_gain_on_aime25.png" id="A5.F10.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:521/131;" width="521" height="131" alt="Refer to caption">
