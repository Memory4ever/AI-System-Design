<figure id="A2.F8.sf1" class="ltx_figure ltx_figure_panel ltx_align_center">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1"><span class="ltx_inline-block"><svg id="A2.F8.sf1.pic1" class="ltx_picture ltx_figure_panel" height="430.41" overflow="visible" version="1.1" viewBox="0 0 477.38 430.41" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,430.41) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.32 L 0 425.09 C 0 428.03 2.38 430.41 5.32 430.41 L 472.06 430.41 C 474.99 430.41 477.38 428.03 477.38 425.09 L 477.38 5.32 C 477.38 2.38 474.99 0 472.06 0 L 5.32 0 C 2.38 0 0 2.38 0 5.32 Z"></path></g><g style="--ltx-fill-color:#F5F5F5;" fill="#F5F5F5" fill-opacity="1.0"><path style="stroke:none" d="M 1.38 5.32 L 1.38 425.09 C 1.38 427.26 3.15 429.03 5.32 429.03 L 472.06 429.03 C 474.23 429.03 475.99 427.26 475.99 425.09 L 475.99 5.32 C 475.99 3.15 474.23 1.38 472.06 1.38 L 5.32 1.38 C 3.15 1.38 1.38 3.15 1.38 5.32 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 6.7 6.7)"><foreignObject style="--ltx-fo-width:33.53em;--ltx-fo-height:30.14em;--ltx-fo-depth:0em;font-size:10pt;" class="ltx_minipage" height="417" overflow="visible" transform="matrix(1 0 0 -1 0 417)" width="33.53em"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><img src="2510.01700v1/images/prompt_images/object/object_ex1.jpg" id="A2.F8.sf1.pic1.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:324/417;" width="324" height="417" alt="Refer to caption"></span></span></foreignObject></g></g></svg></span></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1"><span class="ltx_inline-block"><svg id="A2.F8.sf1.pic2" class="ltx_picture ltx_figure_panel" height="42.31" overflow="visible" version="1.1" viewBox="0 0 477.38 42.31" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,42.31) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.32 L 0 36.99 C 0 39.93 2.38 42.31 5.32 42.31 L 472.06 42.31 C 474.99 42.31 477.38 39.93 477.38 36.99 L 477.38 5.32 C 477.38 2.38 474.99 0 472.06 0 L 5.32 0 C 2.38 0 0 2.38 0 5.32 Z"></path></g><g style="--ltx-fill-color:#F5F5F5;" fill="#F5F5F5" fill-opacity="1.0"><path style="stroke:none" d="M 1.38 5.32 L 1.38 36.99 C 1.38 39.17 3.15 40.93 5.32 40.93 L 472.06 40.93 C 474.23 40.93 475.99 39.17 475.99 36.99 L 475.99 5.32 C 475.99 3.15 474.23 1.38 472.06 1.38 L 5.32 1.38 C 3.15 1.38 1.38 3.15 1.38 5.32 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 6.7 9.39)"><foreignObject style="--ltx-fo-width:33.53em;--ltx-fo-height:1.89em;--ltx-fo-depth:0.19em;font-size:10pt;" height="28.9" overflow="visible" transform="matrix(1 0 0 -1 0 26.21)" width="463.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
