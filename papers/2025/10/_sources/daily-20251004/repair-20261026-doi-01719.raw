{"data":{"id":"10.48550/arxiv.2510.01719","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01719","prefix":"10.48550","suffix":"arxiv.2510.01719","identifiers":[{"identifier":"2510.01719","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.01719"}],"creators":[{"name":"Chung, Jiwan","nameType":"Personal","givenName":"Jiwan","familyName":"Chung","affiliation":[],"nameIdentifiers":[]},{"name":"Joshi, Neel","nameType":"Personal","givenName":"Neel","familyName":"Joshi","affiliation":[],"nameIdentifiers":[]},{"name":"Sharma, Pratyusha","nameType":"Personal","givenName":"Pratyusha","familyName":"Sharma","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Youngjae","nameType":"Personal","givenName":"Youngjae","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Vineet, Vibhav","nameType":"Personal","givenName":"Vibhav","familyName":"Vineet","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What MLLMs Learn about When they Learn about Multimodal Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T06:58:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:29:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-07T15:17:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T00:54:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-03T08:57:11Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-04T01:44:26Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-07T09:13:59Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-08T00:42:20Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-10-23T02:22:08Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-10-26T00:24:33Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Evaluation of multimodal reasoning models is typically reduced to a single accuracy score, implicitly treating reasoning as a unitary capability. We introduce MathLens, a benchmark of textbook-style geometry problems that exposes this assumption by operationally decomposing performance into perception, reasoning, and multimodal-specific components. Each problem is derived from a symbolic specification and accompanied by visual diagrams, text-only variants, multimodal questions, and targeted perceptual probes, enabling controlled measurement of each component. Using this decomposition, we show that common training strategies are associated with systematically different capability profiles that are invisible under aggregate accuracy. Across the models we study, reinforcement learning primarily improves perceptual grounding and robustness to diagram variation, while our analysis suggests that textual SFT yields gains through reflective reasoning. In contrast, as perception and reasoning improve, a growing fraction of remaining errors fall outside these components and are categorized as multimodal-specific. These results suggest that apparent progress in multimodal reasoning reflects shifting balances among subskills rather than uniform advancement, motivating evaluation beyond scalar accuracy.","descriptionType":"Abstract"},{"description":"NeurIPS 2026. Project page: https://jiwanchung.github.io/mathlens/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.01719","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:56:14.000Z","registered":"2025-10-03T01:56:14.000Z","published":"2025","updated":"2026-10-26T02:32:44.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.01719","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}