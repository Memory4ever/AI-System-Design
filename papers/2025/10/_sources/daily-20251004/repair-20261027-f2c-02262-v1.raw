<div id="S3.T1.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:159.0pt;height:50.4pt;vertical-align:-23.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-36.4pt,11.6pt) scale(0.68563449053051,0.68563449053051) ;">
