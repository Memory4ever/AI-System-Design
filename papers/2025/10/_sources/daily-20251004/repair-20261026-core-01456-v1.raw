<td id="A6.T2.2.8.2" class="ltx_td ltx_align_center">seedA <math id="A6.T2.m7" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> seedB</td>
<td id="A6.T2.2.8.3" class="ltx_td ltx_align_center">1.000</td></tr>
<tr id="A6.T2.2.9" class="ltx_tr">
<th id="A6.T2.2.9.1" class="ltx_td ltx_th ltx_th_row"></th>
<td id="A6.T2.2.9.2" class="ltx_td ltx_align_center">seedB <math id="A6.T2.m8" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> seedA</td>
<td id="A6.T2.2.9.3" class="ltx_td ltx_align_center">1.000</td></tr>
<tr id="A6.T2.2.10" class="ltx_tr">
<th id="A6.T2.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Finger hard policy realizations</th>
<td id="A6.T2.2.10.2" class="ltx_td ltx_align_center">seedA <math id="A6.T2.m9" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> seedB</td>
<td id="A6.T2.2.10.3" class="ltx_td ltx_align_center">1.000</td></tr>
<tr id="A6.T2.2.11" class="ltx_tr">
<th id="A6.T2.2.11.1" class="ltx_td ltx_th ltx_th_row ltx_border_bb"></th>
<td id="A6.T2.2.11.2" class="ltx_td ltx_align_center ltx_border_bb">seedB <math id="A6.T2.m10" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> seedA</td>
