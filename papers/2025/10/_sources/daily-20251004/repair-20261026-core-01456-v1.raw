<td id="A6.T2.2.5.2" class="ltx_td ltx_align_center">hard <math id="A6.T2.m4" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> easy</td>
<td id="A6.T2.2.5.3" class="ltx_td ltx_align_center">1.000</td></tr>
