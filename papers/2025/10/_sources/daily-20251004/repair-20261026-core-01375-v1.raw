<td id="S5.T5.2.5.4" class="ltx_td ltx_align_center"><span id="S5.T5.2.5.4.1" class="ltx_text ltx_font_bold">16.68</span></td>
<td id="S5.T5.2.5.5" class="ltx_td ltx_align_center"><span id="S5.T5.2.5.5.1" class="ltx_text ltx_font_bold">91.04%</span></td></tr>
