<tr id="S5.T4.2.1" class="ltx_tr">
<th id="S5.T4.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row"><span id="S5.T4.2.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>
<th id="S5.T4.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row"><span id="S5.T4.2.1.2.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="S5.T4.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T4.2.1.3.1" class="ltx_text ltx_font_bold">ALFWorld Success</span></th>
<th id="S5.T4.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T4.2.1.4.1" class="ltx_text ltx_font_bold">WebShop Success</span></th>
<th id="S5.T4.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T4.2.1.5.1" class="ltx_text ltx_font_bold">WebShop Score</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T4.2.2" class="ltx_tr">
<th id="S5.T4.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt">14B</th>
<th id="S5.T4.2.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt">Base</th>
