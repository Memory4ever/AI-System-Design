<td id="S5.T4.2.3.3" class="ltx_td ltx_align_center">82.09%</td>
<td id="S5.T4.2.3.4" class="ltx_td ltx_align_center"><span id="S5.T4.2.3.4.1" class="ltx_text ltx_font_bold">43.5%</span></td>
<td id="S5.T4.2.3.5" class="ltx_td ltx_align_center">67.08</td></tr>
