<td id="S4.T1.2.15.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.8pt;padding-right:4.8pt;"><span id="S4.T1.2.15.8.1" class="ltx_text" style="--ltx-bg-color:#CCE1EF;">90.7</span></td>
