<tr id="S4.T4.2.4" class="ltx_tr">
<th id="S4.T4.2.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">3</th>
<td id="S4.T4.2.4.2" class="ltx_td ltx_align_center">17.3/11.5</td>
<td id="S4.T4.2.4.3" class="ltx_td ltx_align_center">50.0</td>
<td id="S4.T4.2.4.4" class="ltx_td ltx_align_center">81.0</td>
<td id="S4.T4.2.4.5" class="ltx_td ltx_align_center">38.2</td>
<td id="S4.T4.2.4.6" class="ltx_td ltx_align_center">44.3</td>
<td id="S4.T4.2.4.7" class="ltx_td ltx_align_center"><span id="S4.T4.2.4.7.1" class="ltx_text ltx_underline">40.4</span></td></tr>
<tr id="S4.T4.2.5" class="ltx_tr">
<th id="S4.T4.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">4</th>
