<td id="A1.T8.4.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="2"><span id="A1.T8.4.1.5.1" class="ltx_text ltx_font_bold">BBEH</span></td>
<td id="A1.T8.4.1.6" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="A1.T8.4.1.6.1" class="ltx_text ltx_font_bold">Average</span></td></tr>
<tr id="A1.T8.4.2" class="ltx_tr">
<th id="A1.T8.4.2.1" class="ltx_td ltx_th ltx_th_row ltx_border_r ltx_border_t"></th>
