<td id="A1.T8.4.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Len.<math id="A1.T8.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="A1.T8.4.2.4" class="ltx_td ltx_align_center ltx_border_t">Acc.<math id="A1.T8.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
