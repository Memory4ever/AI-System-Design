              <math id="algorithm1.m18" class="ltx_Math" alttext="w_{i}(o)\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w_{i}(o)\leftarrow 0</annotation></semantics></math> if <math id="algorithm1.m19" class="ltx_Math" alttext="o=\textsf{none}" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>=</mo><mtext class="ltx_mathvariant_sans-serif">none</mtext></mrow><annotation encoding="application/x-tex">o=\textsf{none}</annotation></semantics></math> else <math id="algorithm1.m20" class="ltx_Math" alttext="A_{i}^{o}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>i</mi><mi>o</mi></msubsup><annotation encoding="application/x-tex">A_{i}^{o}</annotation></semantics></math> 
</div>
