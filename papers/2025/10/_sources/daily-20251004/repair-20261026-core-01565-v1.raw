                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.19.1" class="ltx_text ltx_font_bold">17</span></span>
              <span id="algorithm1.4.19.2" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.19.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m27" class="ltx_Math" alttext="o\in\mathcal{O}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">o\in\mathcal{O}_{i}</annotation></semantics></math></em> <span id="algorithm1.4.19.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.20" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.20.1" class="ltx_text ltx_font_bold">18</span></span>
              <span id="algorithm1.4.20.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.20.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m28" class="ltx_Math" alttext="w_{i}(o)\leq c" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">w_{i}(o)\leq c</annotation></semantics></math></em> <span id="algorithm1.4.20.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.21" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.21.1" class="ltx_text ltx_font_bold">19</span></span>
              <math id="algorithm1.m29" class="ltx_Math" alttext="\text{next}[c]\leftarrow\max\{\text{next}[c],\ \text{dp}[c-w_{i}(o)]+\mathrm{sv}_{i}(o)\}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>next</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mtext>next</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mtext>dp</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>−</mo><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>sv</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{next}[c]\leftarrow\max\{\text{next}[c],\ \text{dp}[c-w_{i}(o)]+\mathrm{sv}_{i}(o)\}</annotation></semantics></math>
</div>
<div id="algorithm1.4.22" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.22.1" class="ltx_text ltx_font_bold">20</span></span>
              <math id="algorithm1.m30" class="ltx_Math" alttext="\text{dp}\leftarrow\text{next}" display="inline" intent=":literal"><semantics><mrow><mtext>dp</mtext><mo stretchy="false">←</mo><mtext>next</mtext></mrow><annotation encoding="application/x-tex">\text{dp}\leftarrow\text{next}</annotation></semantics></math>
</div>
<div id="algorithm1.4.23" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.23.1" class="ltx_text ltx_font_bold">21</span></span>
              <math id="algorithm1.m31" class="ltx_Math" alttext="c^{\star}\leftarrow\arg\max_{c}\text{dp}[c]" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>⋆</mo></msup><mo stretchy="false">←</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mi>c</mi></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><mtext>dp</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c^{\star}\leftarrow\arg\max_{c}\text{dp}[c]</annotation></semantics></math>
</div>
<div id="algorithm1.4.24" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.24.1" class="ltx_text ltx_font_bold">22</span></span>
              <span id="algorithm1.4.24.2" class="ltx_text ltx_font_bold">return</span> plan reconstructed from back-pointers at <math id="algorithm1.m32" class="ltx_Math" alttext="c^{\star}" display="inline" intent=":literal"><semantics><msup><mi>c</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">c^{\star}</annotation></semantics></math>
</div>
