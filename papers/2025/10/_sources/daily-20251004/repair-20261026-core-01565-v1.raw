              <span id="algorithm1.4.18.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.18.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m25" class="ltx_Math" alttext="c=0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c=0</annotation></semantics></math> <span id="algorithm1.4.18.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m26" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></em> <span id="algorithm1.4.18.4" class="ltx_text ltx_font_bold">do</span>
</div>
