              Initialize <math id="algorithm1.m21" class="ltx_math_unparsed" alttext="\text{dp}[0..N]\leftarrow-\infty" display="inline" intent=":literal"><semantics><mrow><mtext>dp</mtext><mrow><mo stretchy="false">[</mo><mn>0</mn><mo lspace="0em" rspace="0.0835em">.</mo><mo lspace="0.0835em" rspace="0.167em">.</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo rspace="0em" stretchy="false">←</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\text{dp}[0..N]\leftarrow-\infty</annotation></semantics></math>, <math id="algorithm1.m22" class="ltx_Math" alttext="\text{dp}[0]\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>dp</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\text{dp}[0]\leftarrow 0</annotation></semantics></math>
</div>
<div id="algorithm1.4.16" class="ltx_listingline">
