<td id="S4.T2.2.1.8.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.1.8.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#EDFFFF;">94.37 <math id="S4.T2.m21" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#EDFFFF;" mathbackground="#EDFFFF">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.02</span></td>
<td id="S4.T2.2.1.8.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.1.8.3.1" class="ltx_text" style="--ltx-bg-color:#EDFFFF;">4.35</span></td>
