<td id="S2.T3.2.8.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S2.T3.2.8.2.1" class="ltx_text" style="font-size:80%;">98</span></td>
