<tr id="S2.T3.2.4" class="ltx_tr">
<td id="S2.T3.2.4.1" class="ltx_td ltx_align_left" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S2.T3.2.4.1.1" class="ltx_text" style="font-size:80%;">Defendant’s arguments</span></td>
<td id="S2.T3.2.4.2" class="ltx_td ltx_align_center" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S2.T3.2.4.2.1" class="ltx_text" style="font-size:80%;">99</span></td>
<td id="S2.T3.2.4.3" class="ltx_td ltx_align_center" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S2.T3.2.4.3.1" class="ltx_text" style="font-size:80%;">316</span></td>
<td id="S2.T3.2.4.4" class="ltx_td ltx_align_center" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S2.T3.2.4.4.1" class="ltx_text" style="font-size:80%;">79</span></td>
<td id="S2.T3.2.4.5" class="ltx_td ltx_align_center" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S2.T3.2.4.5.1" class="ltx_text" style="font-size:80%;">13</span></td>
