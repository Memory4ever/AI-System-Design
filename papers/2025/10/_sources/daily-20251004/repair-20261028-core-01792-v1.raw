<td id="S2.T3.2.5.5" class="ltx_td ltx_align_center" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S2.T3.2.5.5.1" class="ltx_text" style="font-size:80%;">13</span></td>
