<tr id="S2.T3.2.5" class="ltx_tr">
<td id="S2.T3.2.5.1" class="ltx_td ltx_align_left" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S2.T3.2.5.1.1" class="ltx_text" style="font-size:80%;">Court evaluation of evidence</span></td>
