<span id="A10.T10.2.1.2.1.1" class="ltx_p"><span id="A10.T10.2.1.2.1.1.1" class="ltx_text ltx_font_bold">Response (excerpt)</span></span>
</span></th>
<th id="A10.T10.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="A10.T10.2.1.3.1" class="ltx_text ltx_font_bold">Human label</span></th>
