s="ltx_text ltx_lst_space"> </span>games<span id="lstnumberx107.25" class="ltx_text ltx_lst_space"> </span>with<span id="lstnumberx107.26" class="ltx_text ltx_lst_space"> </span>positive<span id="lstnumberx107.27" class="ltx_text ltx_lst_space"> </span>ratings<span id="lstnumberx107.28" class="ltx_text ltx_lst_space"> </span>and<span id="lstnumberx107.29" class="ltx_text ltx_lst_space"> </span>positive<span id="lstnumberx107.30" class="ltx_text ltx_lst_space"> </span>playtime.<span id="lstnumberx107.31" class="ltx_text ltx_lst_space"> </span>Plot<span id="lstnumberx107.32" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx107.33" class="ltx_text ltx_lst_space"> </span>results<span id="lstnumberx107.34" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx107.35" class="ltx_text ltx_lst_space"> </span>a<span id="lstnumberx107.36" class="ltx_text ltx_lst_space"> </span>scatter<span id="lstnumberx107.37" class="ltx_text ltx_lst_space"> </span>plot<span id="lstnumberx107.38" class="ltx_text ltx_lst_space"> </span>following<span id="lstnumberx107.39" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx107.40" class="ltx_text" style="--ltx-fg-color:#BA2121;">‘plot.yaml‘<span id="lstnumberx107.40.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span></span>requirements<span id="lstnumberx107.41" class="ltx_text ltx_lst_space"> </span>and<span id="lstnumberx107.42" class="ltx_text ltx_lst_space"> </span>save<span id="lstnumberx107.43" class="ltx_text ltx_lst_space"> </span>it<span id="lstnumberx107.44" class="ltx_text ltx_lst_space"> </span>as<span id="lstnumberx107.45" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx107.46" class="ltx_text" style="--ltx-fg-color:#BA2121;">‘result.png‘</span>.
</div>
<div id="lstnumberx108" class="ltx_listingline">
</div>
<div id="lstnumberx109" class="ltx_listingline">—
</div>
<div id="lstnumberx110" class="ltx_listingline"><span id="lstnumberx110.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#800080;">##<span id="lstnumberx110.1.1" class="ltx_text ltx_lst_space"> </span>Environment</span>
</div>
<div id="lstnumberx111" class="ltx_listingline">|—<span id="lstnumberx111.1" class="ltx_text ltx_lst_space"> </span>steam.csv<span id="lstnumberx111.2" class="ltx_text ltx_lst_space"> </span>#<span id="lstnumberx111.3" class="ltx_text ltx_lst_space"> </span>Core<span id="lstnumberx111.4" class="ltx_text ltx_lst_space"> </span>dataset<span id="lstnumberx111.5" class="ltx_text ltx_lst_space"> </span>with<span id="lstnumberx111.6" class="ltx_text ltx_lst_space"> </span>game-level<span id="lstnumberx111.7" class="ltx_text ltx_lst_space"> </span>metadata<span id="lstnumberx111.8" class="ltx_text ltx_lst_space"> </span>(title,<span id="lstnumberx111.9" class="ltx_text ltx_lst_space"> </span>app<span id="lstnumberx111.10" class="ltx_text ltx_lst_space"> </span>ID,<span id="lstnumberx111.11" class="ltx_text ltx_lst_space"> </span>release<span id="lstnumberx111.12" class="ltx_text ltx_lst_space"> </span>info,<span id="lstnumberx111.13" class="ltx_text ltx_lst_space"> </span>etc.)
