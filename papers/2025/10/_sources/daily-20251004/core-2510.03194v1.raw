<span id="S4.T5.6.1.1.1.1.1.4.2" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">2,350</span>
<span id="S4.T5.6.1.1.1.1.1.4.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">3,788</span>
<span id="S4.T5.6.1.1.1.1.1.4.4" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">1.0</span></span>
<span id="S4.T5.6.1.1.1.1.1.5" class="ltx_tr">
<span id="S4.T5.6.1.1.1.1.1.5.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T5.6.1.1.1.1.1.5.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#4C6EDB;">Co<span id="S4.T5.6.1.1.1.1.1.5.1.1.1" class="ltx_text" style="--ltx-fg-color:#F58A7A;">D<span id="S4.T5.6.1.1.1.1.1.5.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#4FB5A5;">A</span></span></span> (Ours)</span>
