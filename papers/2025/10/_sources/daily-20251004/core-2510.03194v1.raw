            <span id="alg1.l13.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l13.m1" class="ltx_Math" alttext="\text{report.overall\_score}\geq\tau" display="inline" intent=":literal"><semantics><mrow><mtext>report.overall_score</mtext><mo>≥</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\text{report.overall\_score}\geq\tau</annotation></semantics></math> <span id="alg1.l13.4" class="ltx_text ltx_font_bold"> and </span> <math id="alg1.l13.m2" class="ltx_Math" alttext="\text{report.satisfies}(\text{design.success\_ind})" display="inline" intent=":literal"><semantics><mrow><mtext>report.satisfies</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>design.success_ind</mtext><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{report.satisfies}(\text{design.success\_ind})</annotation></semantics></math> <span id="alg1.l13.5" class="ltx_text ltx_font_bold">then</span>

</div>
