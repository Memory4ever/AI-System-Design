<span id="S4.T5.6.1.1.1.1.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">MatplotAgent</span>
<span id="S4.T5.6.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">34,177</span>
<span id="S4.T5.6.1.1.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">26,792</span>
<span id="S4.T5.6.1.1.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">15.4</span></span>
<span id="S4.T5.6.1.1.1.1.1.3" class="ltx_tr">
<span id="S4.T5.6.1.1.1.1.1.3.1" class="ltx_td ltx_align_left" style="padding-left:8.0pt;padding-right:8.0pt;">VisPath</span>
<span id="S4.T5.6.1.1.1.1.1.3.2" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">16,224</span>
<span id="S4.T5.6.1.1.1.1.1.3.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">13,056</span>
<span id="S4.T5.6.1.1.1.1.1.3.4" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">7.0</span></span>
