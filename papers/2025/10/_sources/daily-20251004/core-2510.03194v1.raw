"lstnumberx264.28" class="ltx_text ltx_lst_space"> </span>should<span id="lstnumberx264.29" class="ltx_text ltx_lst_space"> </span>be<span id="lstnumberx264.30" class="ltx_text ltx_lst_space"> </span>proportionate<span id="lstnumberx264.31" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx264.32" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx264.33" class="ltx_text ltx_lst_space"> </span>resemblance<span id="lstnumberx264.34" class="ltx_text ltx_lst_space"> </span>between<span id="lstnumberx264.35" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx264.36" class="ltx_text ltx_lst_space"> </span>two<span id="lstnumberx264.37" class="ltx_text ltx_lst_space"> </span>plots.
</div>
<div id="lstnumberx265" class="ltx_listingline">In<span id="lstnumberx265.1" class="ltx_text ltx_lst_space"> </span>some<span id="lstnumberx265.2" class="ltx_text ltx_lst_space"> </span>rare<span id="lstnumberx265.3" class="ltx_text ltx_lst_space"> </span>occurrence,<span id="lstnumberx265.4" class="ltx_text ltx_lst_space"> </span>see<span id="lstnumberx265.5" class="ltx_text ltx_lst_space"> </span>if<span id="lstnumberx265.6" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx265.7" class="ltx_text ltx_lst_space"> </span>data<span id="lstnumberx265.8" class="ltx_text ltx_lst_space"> </span>points<span id="lstnumberx265.9" class="ltx_text ltx_lst_space"> </span>are<span id="lstnumberx265.10" class="ltx_text ltx_lst_space"> </span>generated<span id="lstnumberx265.11" class="ltx_text ltx_lst_space"> </span>randomly<span id="lstnumberx265.12" class="ltx_text ltx_lst_space"> </span>according<span id="lstnumberx265.13" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx265.14" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx265.15" class="ltx_text ltx_lst_space"> </span>query,<span id="lstnumberx265.16" class="ltx_text ltx_lst_space"> </span>if<span id="lstnumberx265.17" class="ltx_text ltx_lst_space"> </span>so,<span id="lstnumberx265.18" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx265.19" class="ltx_text ltx_lst_space"> </span>generated<span id="lstnumberx265.20" class="ltx_text ltx_lst_space"> </span>plot<span id="lstnumberx265.21" class="ltx_text ltx_lst_space"> </span>may<span id="lstnumberx265.22" class="ltx_text ltx_lst_space"> </span>not<span id="lstnumberx265.23" class="ltx_text ltx_lst_space"> </span>perfectly<span id="lstnumberx265.24" class="ltx_text ltx_lst_space"> </span>match<span id="lstnumberx265.25" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx265.26" class="ltx_text ltx_lst_space"> </span>ground<span id="lstnumberx265.27" class="ltx_text ltx_lst_space"> </span>truth,<span id="lstnumberx265.28" class="ltx_text ltx_lst_space"> </span>but<span id="lstnumberx265.29" class="ltx_text ltx_lst_space"> </span>it<span id="lstnumberx265.30" class="ltx_text ltx_lst_space"> </span>is<span id="lstnumberx265.31" class="ltx_text ltx_lst_space"> </span>correct<span id="lstnumberx265.32" class="ltx_text ltx_lst_space"> </span>nonetheless.
