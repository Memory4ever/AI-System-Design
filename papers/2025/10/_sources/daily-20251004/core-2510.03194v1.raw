</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
             <math id="alg1.l17.m1" class="ltx_Math" alttext="\text{code}\leftarrow A_{\text{code}}.\text{revise}(\text{design},\text{dp},\text{examples},\text{report})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>code</mtext><mo stretchy="false">←</mo><msub><mi>A</mi><mtext>code</mtext></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext>revise</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>design</mtext><mo>,</mo><mtext>dp</mtext><mo>,</mo><mtext>examples</mtext><mo>,</mo><mtext>report</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{code}\leftarrow A_{\text{code}}.\text{revise}(\text{design},\text{dp},\text{examples},\text{report})</annotation></semantics></math>

