<figcaption class="ltx_caption ltx_centering ltx_font_bold"><span class="ltx_tag ltx_tag_figure"><span id="A2.F5.sf1.6" class="ltx_text ltx_font_medium" style="font-size:90%;">(a)</span> </span><span id="A2.F5.sf1.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#4C6EDB;">Co<span id="A2.F5.sf1.7.1" class="ltx_text" style="--ltx-fg-color:#F58A7A;">D<span id="A2.F5.sf1.7.1.1" class="ltx_text" style="--ltx-fg-color:#4FB5A5;">A</span></span></span><span id="A2.F5.sf1.8" class="ltx_text" style="font-size:90%;"> Output</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A2.F5.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.03194v1/appendix/examples/gt-005.png" id="A2.F5.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/286;" width="476" height="286" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering ltx_font_bold"><span class="ltx_tag ltx_tag_figure"><span id="A2.F5.sf2.5" class="ltx_text ltx_font_medium" style="font-size:90%;">(b)</span> </span><span id="A2.F5.sf2.6" class="ltx_text" style="font-size:90%;">Ground Truth</span></figcaption>
