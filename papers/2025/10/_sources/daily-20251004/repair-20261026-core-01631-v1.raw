<td id="A1.T1.5.5.4" class="ltx_td ltx_align_center">20</td></tr>
<tr id="A1.T1.5.6" class="ltx_tr">
<th id="A1.T1.5.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">1B</th>
<td id="A1.T1.5.6.2" class="ltx_td ltx_align_center">1792</td>
<td id="A1.T1.5.6.3" class="ltx_td ltx_align_center">22</td>
<td id="A1.T1.5.6.4" class="ltx_td ltx_align_center">28</td></tr>
<tr id="A1.T1.5.7" class="ltx_tr">
