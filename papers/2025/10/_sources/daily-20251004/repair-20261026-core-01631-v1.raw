<td id="A1.T1.5.3.2" class="ltx_td ltx_align_center ltx_border_t">576</td>
<td id="A1.T1.5.3.3" class="ltx_td ltx_align_center ltx_border_t">7</td>
<td id="A1.T1.5.3.4" class="ltx_td ltx_align_center ltx_border_t">9</td></tr>
