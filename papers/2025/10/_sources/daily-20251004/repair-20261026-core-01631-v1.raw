<td id="A1.T1.5.4.2" class="ltx_td ltx_align_center">832</td>
<td id="A1.T1.5.4.3" class="ltx_td ltx_align_center">10</td>
<td id="A1.T1.5.4.4" class="ltx_td ltx_align_center">13</td></tr>
<tr id="A1.T1.5.5" class="ltx_tr">
