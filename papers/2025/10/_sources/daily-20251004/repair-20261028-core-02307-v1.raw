</div>
<div id="alg1.l16" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
                
                
               <span id="alg1.l16.3" class="ltx_text ltx_font_bold">return</span>  Optimized <math id="alg1.l16.m1" class="ltx_Math" alttext="\hat{\sigma}_{t}^{*}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>t</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\hat{\sigma}_{t}^{*}</annotation></semantics></math>

</div>
