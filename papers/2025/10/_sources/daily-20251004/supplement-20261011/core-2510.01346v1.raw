/span><span id="lstnumberx78.67" class="ltx_text ltx_font_typewriter ltx_font_italic" style="font-size:90%;">transformation</span><span id="lstnumberx78.68" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_italic" style="font-size:90%;"> </span><span id="lstnumberx78.69" class="ltx_text ltx_font_typewriter ltx_font_italic" style="font-size:90%;">property:</span><span id="lstnumberx78.70" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_italic" style="font-size:90%;"> </span><span id="lstnumberx78.71" class="ltx_text ltx_font_typewriter ltx_font_italic" style="font-size:90%;">$\\text{Delta}(-1/\\tau)</span><span id="lstnumberx78.72" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_italic" style="font-size:90%;"> </span><span id="lstnumberx78.73" class="ltx_text ltx_font_typewriter ltx_font_italic" style="font-size:90%;">=</span><span id="lstnumberx78.74" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_italic" style="font-size:90%;"> </span><span id="lstnumberx78.75" class="ltx_text ltx_font_typewriter ltx_font_italic" style="font-size:90%;">(\\tau/i)^{12}</span><span id="lstnumberx78.76" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_italic" style="font-size:90%;"> </span><span id="lstnumberx78.77" class="ltx_text ltx_font_typewriter ltx_font_italic" style="font-size:90%;">\\text{Delta}(\\tau)$.</span>
