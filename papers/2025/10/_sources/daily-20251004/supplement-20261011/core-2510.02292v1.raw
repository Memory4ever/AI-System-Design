<tr id="S4.T1.2.1.6" class="ltx_tr">
<td id="S4.T1.2.1.6.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding-bottom: 4.0pt;padding:-1pt 3.8pt;"><span id="S4.T1.2.1.6.1.1" class="ltx_text ltx_font_typewriter">shape</span></td>
<td id="S4.T1.2.1.6.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt" style="padding-bottom: 4.0pt;padding:-1pt 3.8pt;">
