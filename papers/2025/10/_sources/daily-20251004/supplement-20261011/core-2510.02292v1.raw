<td id="S4.T1.2.1.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt" style="padding:-1pt 3.8pt;">
<span id="S4.T1.2.1.1.2.1" class="ltx_inline-block ltx_align_top" style="width:224.3pt;">
