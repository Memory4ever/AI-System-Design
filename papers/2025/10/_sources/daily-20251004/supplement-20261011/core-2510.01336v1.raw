<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span> HiSpec Algorithm</h2>

<div id="A1.p1" class="ltx_para ltx_noindent">
<p id="A1.p1.1" class="ltx_p">Algorithm <a href="#A1" title="Appendix A HiSpec Algorithm ‣ HiSpec: Hierarchical SpeculativeDecoding for LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a> describes an elaborate version of the HiSpec design.</p>
</div>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Speculative Decoding with HiSpec</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          <span id="alg2.l1.2" class="ltx_text ltx_font_bold">Input:</span> Draft layer <math id="alg2.l1.m1" class="ltx_Math" alttext="L_{d}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>d</mi></msub><annotation encoding="application/x-tex">L_{d}</annotation></semantics></math>,
</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
             Full layer <math id="alg2.l2.m1" class="ltx_Math" alttext="L_{f}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>f</mi></msub><annotation encoding="application/x-tex">L_{f}</annotation></semantics></math>,
</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
             Intermediate layer <math id="alg2.l3.m1" class="ltx_Math" alttext="L_{i}\mid L_{d}&lt;L_{i}&lt;L_{f}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo fence="false">|</mo><mrow><msub><mi>L</mi><mi>d</mi></msub><mo>&lt;</mo><msub><mi>L</mi><mi>i</mi></msub><mo>&lt;</mo><msub><mi>L</mi><mi>f</mi></msub></mrow></mrow><annotation encoding="application/x-tex">L_{i}\mid L_{d}&lt;L_{i}&lt;L_{f}</annotation></semantics></math> 
</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
             Prompt <math id="alg2.l4.m1" class="ltx_Math" alttext="=[T_{0},T_{1},\dots,T_{k}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>T</mi><mn>0</mn></msub><mo>,</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">=[T_{0},T_{1},\dots,T_{k}]</annotation></semantics></math>,
</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
             Draft proposal length <math id="alg2.l5.m1" class="ltx_Math" alttext="N_{d}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>d</mi></msub><annotation encoding="application/x-tex">N_{d}</annotation></semantics></math>, <span id="alg2.l5.2" class="ltx_text" style="--ltx-fg-color:#0000FF;float:right;">// Tokens proposed by <math id="alg2.l5.m2" class="ltx_Math" alttext="L_{d}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">d</mi></msub><annotation encoding="application/x-tex">L_{d}</annotation></semantics></math> per step</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
             Tentative acceptance window <math id="alg2.l6.m1" class="ltx_Math" alttext="N_{i}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>i</mi></msub><annotation encoding="application/x-tex">N_{i}</annotation></semantics></math>, <span id="alg2.l6.2" class="ltx_text" style="--ltx-fg-color:#0000FF;float:right;">// Tokens verified by <math id="alg2.l6.m2" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math>, before verification by <math id="alg2.l6.m3" class="ltx_Math" alttext="L_{f}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">f</mi></msub><annotation encoding="application/x-tex">L_{f}</annotation></semantics></math></span>
</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
          
</div>
<div id="alg2.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
          <span id="alg2.l8.2" class="ltx_text ltx_font_bold">Algorithm:</span> 
</div>
<div id="alg2.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
          <math id="alg2.l9.m1" class="ltx_Math" alttext="\mathbf{current\_context}\leftarrow\mathbf{prompt}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐜𝐮𝐫𝐫𝐞𝐧𝐭</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐜𝐨𝐧𝐭𝐞𝐱𝐭</mi></mrow><mo stretchy="false">←</mo><mi>𝐩𝐫𝐨𝐦𝐩𝐭</mi></mrow><annotation encoding="application/x-tex">\mathbf{current\_context}\leftarrow\mathbf{prompt}</annotation></semantics></math> <span id="alg2.l9.2" class="ltx_text" style="float:right;"><span id="alg2.l9.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">// Initializing the context with input tokens</span>
</span>
</div>
<div id="alg2.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
          <math id="alg2.l10.m1" class="ltx_Math" alttext="\mathbf{B}_{i}\leftarrow[\;]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐁</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mo rspace="0.280em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{B}_{i}\leftarrow[\;]</annotation></semantics></math> <span id="alg2.l10.2" class="ltx_text" style="float:right;"><span id="alg2.l10.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">// Buffer for tokens accepted by <math id="alg2.l10.m2" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> but not committed</span>
</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
          <span id="alg2.l11.2" class="ltx_text ltx_font_bold">while</span> not end-of-sequence <span id="alg2.l11.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
            
            <math id="alg2.l12.m1" class="ltx_Math" alttext="\mathbf{ctx^{\star}}\leftarrow[\mathbf{current\_context},\mathbf{B}_{i}]" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐜𝐭𝐱</mi><mo>⋆</mo></msup><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>𝐜𝐮𝐫𝐫𝐞𝐧𝐭</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐜𝐨𝐧𝐭𝐞𝐱𝐭</mi></mrow><mo>,</mo><msub><mi>𝐁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{ctx^{\star}}\leftarrow[\mathbf{current\_context},\mathbf{B}_{i}]</annotation></semantics></math><span id="alg2.l12.2" class="ltx_text" style="float:right;"><span id="alg2.l12.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">// Concatenating context for draft generation cycle</span>
</span>
</div>
