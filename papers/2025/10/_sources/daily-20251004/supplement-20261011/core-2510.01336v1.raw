               <math id="alg2.l40.m1" class="ltx_Math" alttext="\mathbf{current\_context}\leftarrow[\mathbf{current\_context}\,,T^{f}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐜𝐮𝐫𝐫𝐞𝐧𝐭</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐜𝐨𝐧𝐭𝐞𝐱𝐭</mi></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>𝐜𝐮𝐫𝐫𝐞𝐧𝐭</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐜𝐨𝐧𝐭𝐞𝐱𝐭</mi></mrow><mo lspace="0.170em">,</mo><msup><mi>T</mi><mi>f</mi></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{current\_context}\leftarrow[\mathbf{current\_context}\,,T^{f}]</annotation></semantics></math>

</div>
