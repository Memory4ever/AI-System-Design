</div>
<div id="algx1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">19:</span>
              
              
            
</div>
<div id="algx1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">20:</span>
              
              
            <span id="algx1.l20.2" class="ltx_text ltx_font_bold">function</span> <span id="algx1.l20.3" class="ltx_text ltx_font_smallcaps">LeadingSubstringVerify</span>(<math id="algx1.l20.m1" class="ltx_Math" alttext="\text{Draft Tokens S},\;\text{Verifier Layer }L,\;\text{Context}" display="inline" intent=":literal"><semantics><mrow><mtext>Draft Tokens S</mtext><mo rspace="0.447em">,</mo><mrow><mtext>Verifier Layer </mtext><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo rspace="0.447em">,</mo><mtext>Context</mtext></mrow><annotation encoding="application/x-tex">\text{Draft Tokens S},\;\text{Verifier Layer }L,\;\text{Context}</annotation></semantics></math>)

</div>
<div id="algx1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">21:</span>
              
              
              <math id="algx1.l21.m1" class="ltx_Math" alttext="\widehat{\mathbf{S}}\leftarrow" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐒</mi><mo>^</mo></mover><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{S}}\leftarrow</annotation></semantics></math> longest prefix of <math id="algx1.l21.m2" class="ltx_Math" alttext="\mathbf{S}" display="inline" intent=":literal"><semantics><mi>𝐒</mi><annotation encoding="application/x-tex">\mathbf{S}</annotation></semantics></math> such that every token <math id="algx1.l21.m3" class="ltx_Math" alttext="\in\textsc{TopPredictions}(L)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∈</mo><mrow><mtext class="ltx_font_smallcaps">TopPredictions</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\in\textsc{TopPredictions}(L)</annotation></semantics></math>

</div>
