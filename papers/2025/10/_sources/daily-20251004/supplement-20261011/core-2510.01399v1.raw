<td id="A5.T1.6.7.6" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFEBEB;padding:2.5pt 5.0pt;"><span id="A5.T1.6.7.6.1" class="ltx_text" style="--ltx-bg-color:#FFEBEB;">32.3</span></td>
