<tr id="A5.T4.2.2" class="ltx_tr">
<td id="A5.T4.2.2.1" class="ltx_td ltx_align_center" style="padding-top:2.5pt;padding-bottom:2.5pt;">Score</td>
<td id="A5.T4.2.2.2" class="ltx_td ltx_align_center" style="padding-top:2.5pt;padding-bottom:2.5pt;">(seconds)</td></tr>
<tr id="A5.T4.2.3" class="ltx_tr">
<th id="A5.T4.2.3.1" class="ltx_td ltx_th ltx_th_row ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"></th>
<th id="A5.T4.2.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="--ltx-bg-color:#F0E6FF;padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A5.T4.2.3.2.1" class="ltx_text" style="--ltx-bg-color:#F0E6FF;">Gemini-Nanobanana</span></th>
<td id="A5.T4.2.3.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#F0E6FF;padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A5.T4.2.3.3.1" class="ltx_text" style="--ltx-bg-color:#F0E6FF;">60.0</span></td>
<td id="A5.T4.2.3.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#F0E6FF;padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A5.T4.2.3.4.1" class="ltx_text" style="--ltx-bg-color:#F0E6FF;">7</span></td></tr>
<tr id="A5.T4.2.4" class="ltx_tr">
<th id="A5.T4.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="--ltx-bg-color:#F0E6FF;padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A5.T4.2.4.1.1" class="ltx_text" style="--ltx-bg-color:#F0E6FF;">Proprietary</span></th>
