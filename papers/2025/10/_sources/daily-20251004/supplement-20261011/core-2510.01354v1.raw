<span id="A3.p3.pic1.2.2" class="ltx_logical-block ltx_minipage ltx_align_middle" style="width:224.0pt;">
                    
<span id="A3.p3.pic1.p2" class="ltx_para"><img src="2510.01354v1/images/examples/malicious/VWA-adv-screenshot.png" id="A3.p3.pic1.g2" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:309/224;" width="309" height="224" alt="[Uncaptioned image]">
</span>
                    
