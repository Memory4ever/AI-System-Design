<td id="S4.T3.5.1.4.4" class="ltx_td ltx_align_center ltx_border_t">216</td>
<td id="S4.T3.5.1.4.5" class="ltx_td ltx_align_center ltx_border_t">84</td>
<td id="S4.T3.5.1.4.6" class="ltx_td ltx_align_center ltx_border_t">500</td>
<td id="S4.T3.5.1.4.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">145</td>
