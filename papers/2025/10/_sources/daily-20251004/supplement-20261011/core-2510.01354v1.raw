<td id="S4.T2.5.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T2.5.1.2.5.1" class="ltx_text ltx_font_bold">VPI</span></td>
<td id="S4.T2.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.5.1.2.6.1" class="ltx_text ltx_font_bold">#Samples</span></td>
<td id="S4.T2.5.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.5.1.2.7.1" class="ltx_text ltx_font_bold">Source(s)</span></td></tr>
<tr id="S4.T2.5.1.3" class="ltx_tr">
<td id="S4.T2.5.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S4.T2.5.1.3.1.1" class="ltx_text ltx_font_bold">Comment &amp; Issue</span></td>
<td id="S4.T2.5.1.3.2" class="ltx_td ltx_align_center ltx_border_t">–</td>
<td id="S4.T2.5.1.3.3" class="ltx_td ltx_align_center ltx_border_t">–</td>
<td id="S4.T2.5.1.3.4" class="ltx_td ltx_align_center ltx_border_t">–</td>
<td id="S4.T2.5.1.3.5" class="ltx_td ltx_align_center ltx_border_t">84/84</td>
<td id="S4.T2.5.1.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">–</td>
<td id="S4.T2.5.1.3.7" class="ltx_td ltx_align_center ltx_border_t">806</td>
<td id="S4.T2.5.1.3.8" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">Reddit (VWA), Gitlab (WA)</td></tr>
<tr id="S4.T2.5.1.4" class="ltx_tr">
<td id="S4.T2.5.1.4.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S4.T2.5.1.4.1.1" class="ltx_text ltx_font_bold">Image caption</span></td>
<td id="S4.T2.5.1.4.2" class="ltx_td ltx_align_center ltx_border_t">298/94</td>
<td id="S4.T2.5.1.4.3" class="ltx_td ltx_align_center ltx_border_t">–</td>
<td id="S4.T2.5.1.4.4" class="ltx_td ltx_align_center ltx_border_t">–</td>
<td id="S4.T2.5.1.4.5" class="ltx_td ltx_align_center ltx_border_t">–</td>
