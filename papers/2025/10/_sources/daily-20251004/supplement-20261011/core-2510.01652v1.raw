pic1.8" class="ltx_text" style="--ltx-fg-color:#808080;">Word representation in Llama</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#81BFDA;--ltx-fill-color:#81BFDA;--ltx-fg-color:#81BFDA;" color="#81BFDA" fill="#81BFDA" stroke="#81BFDA" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.7pt"><path style="fill:none" d="M -124.01 12.4 L 141.73 12.4"></path></g><g style="--ltx-stroke-color:#FCCCCB;--ltx-fill-color:#FCF1F0;" fill="#FCF1F0" stroke="#FCCCCB"><path d="M -85.44 -5.91 L -127.15 -5.91 C -128.68 -5.91 -129.92 -7.14 -129.92 -8.67 L -129.92 -26.76 C -129.92 -28.29 -128.68 -29.53 -127.15 -29.53 L -85.44 -29.53 C -83.92 -29.53 -82.68 -28.29 -82.68 -26.76 L -82.68 -8.67 C -82.68 -7.14 -83.92 -5.91 -85.44 -5.91 Z M -129.92 -29.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -118.21 -22.52)"><foreignObject style="--ltx-fo-width:1.72em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="23.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.9" class="ltx_text">The</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#F9D580;--ltx-fill-color:#F3DEB7;" fill="#F3DEB7" stroke="#F9D580"><path d="M -17.85 -5.91 L -70.73 -5.91 C -72.26 -5.91 -73.5 -7.14 -73.5 -8.67 L -73.5 -26.76 C -73.5 -28.29 -72.26 -29.53 -70.73 -29.53 L -17.85 -29.53 C -16.32 -29.53 -15.08 -28.29 -15.08 -26.76 L -15.08 -8.67 C -15.08 -7.14 -16.32 -5.91 -17.85 -5.91 Z M -73.5 -29.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -68.89 -21.18)"><foreignObject style="--ltx-fo-width:3.56em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" wi