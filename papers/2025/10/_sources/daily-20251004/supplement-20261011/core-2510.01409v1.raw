xt ltx_lst_space"> </span>without<span id="lstnumberx34.27" class="ltx_text ltx_lst_space"> </span>any<span id="lstnumberx34.28" class="ltx_text ltx_lst_space"> </span>escape<span id="lstnumberx34.29" class="ltx_text ltx_lst_space"> </span>characters<span id="lstnumberx34.30" class="ltx_text ltx_lst_space"> </span>or<span id="lstnumberx34.31" class="ltx_text ltx_lst_space"> </span>newlines.<span id="lstnumberx34.32" class="ltx_text ltx_lst_space"> </span>The<span id="lstnumberx34.33" class="ltx_text ltx_lst_space"> </span>JSON<span id="lstnumberx34.34" class="ltx_text ltx_lst_space"> </span>must<span id="lstnumberx34.35" class="ltx_text ltx_lst_space"> </span>be<span id="lstnumberx34.36" class="ltx_text ltx_lst_space"> </span>formatted<span id="lstnumberx34.37" class="ltx_text ltx_lst_space"> </span>correctly,<span id="lstnumberx34.38" class="ltx_text ltx_lst_space"> </span>with<span id="lstnumberx34.39" class="ltx_text ltx_lst_space"> </span>all<span id="lstnumberx34.40" class="ltx_text ltx_lst_space"> </span>necessary<span id="lstnumberx34.41" class="ltx_text ltx_lst_space"> </span>commas<span id="lstnumberx34.42" class="ltx_text ltx_lst_space"> </span>and<span id="lstnumberx34.43" class="ltx_text ltx_lst_space"> </span>brackets<span id="lstnumberx34.44" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx34.45" class="ltx_text ltx_lst_space"> </span>place.
