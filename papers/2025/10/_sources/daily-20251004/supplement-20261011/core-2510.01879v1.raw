<td id="A3.T8.5.12.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A3.T8.m47" class="ltx_Math" alttext="0.79\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.79</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.02</mn></mrow><annotation encoding="application/x-tex">0.79\pm 0.02</annotation></semantics></math></td>
<td id="A3.T8.5.12.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A3.T8.m48" class="ltx_Math" alttext="0.77\pm 0.01" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.77</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.01</mn></mrow><annotation encoding="application/x-tex">0.77\pm 0.01</annotation></semantics></math></td>
