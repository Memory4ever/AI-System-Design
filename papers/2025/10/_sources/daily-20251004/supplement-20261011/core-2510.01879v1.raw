<td id="A3.T8.5.12.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A3.T8.m50" class="ltx_Math" alttext="0.61\pm 0.03" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.61</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.03</mn></mrow><annotation encoding="application/x-tex">0.61\pm 0.03</annotation></semantics></math></td>
