<td id="A3.T8.5.11.2" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A3.T8.m41" class="ltx_Math" alttext="0.74\pm 0.03" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.74</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.03</mn></mrow><annotation encoding="application/x-tex">0.74\pm 0.03</annotation></semantics></math></td>
<td id="A3.T8.5.11.3" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A3.T8.m42" class="ltx_Math" alttext="0.74\pm 0.04" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.74</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.04</mn></mrow><annotation encoding="application/x-tex">0.74\pm 0.04</annotation></semantics></math></td>
<td id="A3.T8.5.11.4" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A3.T8.m43" class="ltx_Math" alttext="0.82\pm 0.05" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.82</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.05</mn></mrow><annotation encoding="application/x-tex">0.82\pm 0.05</annotation></semantics></math></td>
<td id="A3.T8.5.11.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A3.T8.m44" class="ltx_Math" alttext="0.59\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.59</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.02</mn></mrow><annotation encoding="application/x-tex">0.59\pm 0.02</annotation></semantics></math></td>
<td id="A3.T8.5.11.6" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A3.T8.m45" class="ltx_Math" alttext="0.57\pm 0.01" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.57</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.01</mn></mrow><annotation encoding="application/x-tex">0.57\pm 0.01</annotation></semantics></math></td>
<td id="A3.T8.5.11.7" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="A3.T8.m46" class="ltx_Math" alttext="0.61\pm 0.03" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.61</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.03</mn></mrow><annotation encoding="application/x-tex">0.61\pm 0.03</annotation></semantics></math></td></tr>
<tr id="A3.T8.5.12" class="ltx_tr">
