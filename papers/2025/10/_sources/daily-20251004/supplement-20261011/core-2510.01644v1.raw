<td id="S2.T2.2.5.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S2.T2.2.5.3.1" class="ltx_text" style="--ltx-bg-color:#E0FFEB;">Contrastive</span></td>
<td id="S2.T2.2.5.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S2.T2.2.5.4.1" class="ltx_inline-block ltx_align_top" style="width:144.5pt;--ltx-bg-color:#E0FFEB;">
