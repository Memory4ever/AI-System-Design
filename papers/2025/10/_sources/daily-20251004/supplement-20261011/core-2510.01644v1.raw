<tr id="S2.T2.2.6" class="ltx_tr">
<td id="S2.T2.2.6.1" class="ltx_td ltx_border_r"></td>
<td id="S2.T2.2.6.2" class="ltx_td ltx_align_right ltx_border_r ltx_border_t"><span id="S2.T2.2.6.2.1" class="ltx_text" style="--ltx-bg-color:#E0FFEB;">8</span></td>
<td id="S2.T2.2.6.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S2.T2.2.6.3.1" class="ltx_text" style="--ltx-bg-color:#E0FFEB;">Gameplay</span></td>
<td id="S2.T2.2.6.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S2.T2.2.6.4.1" class="ltx_inline-block ltx_align_top" style="width:144.5pt;--ltx-bg-color:#E0FFEB;">
<span id="S2.T2.2.6.4.1.1" class="ltx_p">Prompt invokes a game setting to justify modified behavior.</span>
</span></td></tr>
<tr id="S2.T2.2.7" class="ltx_tr">
<td id="S2.T2.2.7.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Attention Shifting</td>
<td id="S2.T2.2.7.2" class="ltx_td ltx_align_right ltx_border_r ltx_border_t">4</td>
<td id="S2.T2.2.7.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Text Continuation</td>
<td id="S2.T2.2.7.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S2.T2.2.7.4.1" class="ltx_inline-block ltx_align_top" style="width:144.5pt;">
<span id="S2.T2.2.7.4.1.1" class="ltx_p">Misdirection by shifting to continuation of text.</span>
</span></td></tr>
<tr id="S2.T2.2.8" class="ltx_tr">
<td id="S2.T2.2.8.1" class="ltx_td ltx_border_r"></td>
