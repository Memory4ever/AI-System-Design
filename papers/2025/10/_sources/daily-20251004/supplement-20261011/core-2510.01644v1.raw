<td id="S2.T2.2.16.2" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t"><span id="S2.T2.2.16.2.1" class="ltx_text" style="--ltx-bg-color:#E0FFEB;">10</span></td>
<td id="S2.T2.2.16.3" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r ltx_border_t"><span id="S2.T2.2.16.3.1" class="ltx_text" style="--ltx-bg-color:#E0FFEB;">Ethical Appeal</span></td>
