<td id="A1.T6.3.8.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="A1.T6.3.8.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">94.8</span></td>
