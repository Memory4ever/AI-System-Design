<th id="S4.T1.3.1.23.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r ltx_border_t"><span id="S4.T1.3.1.23.2.1" class="ltx_text" style="font-size:80%;">SD v2-1</span></th>
<td id="S4.T1.3.1.23.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.3.1.23.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">97.8</span></td>
<td id="S4.T1.3.1.23.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><span id="S4.T1.3.1.23.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">98.4</span></td>
<td id="S4.T1.3.1.23.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.3.1.23.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">62.0</span></td>
<td id="S4.T1.3.1.23.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.3.1.23.6.1" class="ltx_text ltx_underline" style="font-size:80%;">91.0</span></td></tr>
