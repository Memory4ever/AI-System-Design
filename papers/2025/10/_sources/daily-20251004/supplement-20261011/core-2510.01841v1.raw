<tr id="A2.T7.3.3" class="ltx_tr">
<td id="A2.T7.3.3.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-top:0.4pt;padding-bottom:0.4pt;"><span id="A2.T7.3.3.1.1" class="ltx_text ltx_font_typewriter" style="font-size:70%;">"face"<span id="A2.T7.3.3.1.1.1" class="ltx_text ltx_font_serif">, </span>"torso"<span id="A2.T7.3.3.1.1.2" class="ltx_text ltx_font_serif">, </span>"legs"<span id="A2.T7.3.3.1.1.3" class="ltx_text ltx_font_serif">, </span>"foot"</span></td>
