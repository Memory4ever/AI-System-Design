<th id="S4.T1.3.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S4.T1.3.1.8.1.1" class="ltx_text" style="font-size:80%;">NAE <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite></span></th>
<th id="S4.T1.3.1.8.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S4.T1.3.1.8.2.1" class="ltx_text" style="font-size:80%;">ResNet50</span></th>
