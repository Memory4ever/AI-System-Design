<td id="A2.T7.3.3.3" class="ltx_td ltx_align_center" style="padding-top:0.4pt;padding-bottom:0.4pt;"><span id="A2.T7.3.3.3.1" class="ltx_text ltx_underline" style="font-size:70%;">90.8</span></td></tr>
