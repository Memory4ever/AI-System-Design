<td id="A2.T7.3.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.4pt;padding-bottom:0.4pt;"><span id="A2.T7.3.4.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">91.0</span></td></tr>
</tbody>
