<td id="A3.T8.3.4.3" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A3.T8.3.4.3.1" class="ltx_text ltx_underline" style="font-size:80%;">90.8</span></td></tr>
<tr id="A3.T8.3.5" class="ltx_tr">
<th id="A3.T8.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A3.T8.3.5.1.1" class="ltx_text" style="font-size:80%;">Ours (MSFRN)</span></th>
