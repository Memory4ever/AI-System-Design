      <name>Krithika Ramakrishnan</name>
    </author>
    <author>
      <name>Yanqi Luo</name>
    </author>
    <author>
      <name>Silvio Savarese</name>
    </author>
    <author>
      <name>Caiming Xiong</name>
    </author>
    <author>
      <name>Junnan Li</name>
    </author>
