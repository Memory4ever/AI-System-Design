<span id="A1.SS4.SSS0.Px1.p1.p1.1.1.2" class="ltx_td ltx_align_center ltx_border_tt">Text</span>
<span id="A1.SS4.SSS0.Px1.p1.p1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt">Graphs</span>
<span id="A1.SS4.SSS0.Px1.p1.p1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">TAG</span></span>
<span id="A1.SS4.SSS0.Px1.p1.p1.1.2" class="ltx_tr">
<span id="A1.SS4.SSS0.Px1.p1.p1.1.2.1" class="ltx_td ltx_align_left ltx_border_t">Zero</span>
<span id="A1.SS4.SSS0.Px1.p1.p1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">54.1</span>
<span id="A1.SS4.SSS0.Px1.p1.p1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">58.0</span>
<span id="A1.SS4.SSS0.Px1.p1.p1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">52.6</span></span>
<span id="A1.SS4.SSS0.Px1.p1.p1.1.3" class="ltx_tr">
<span id="A1.SS4.SSS0.Px1.p1.p1.1.3.1" class="ltx_td ltx_align_left">Few</span>
