<tr id="S4.T2.6.1.4" class="ltx_tr">
<th id="S4.T2.6.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen3-Reranker-0.6B</th>
<th id="S4.T2.6.1.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">0.6</th>
<td id="S4.T2.6.1.4.3" class="ltx_td ltx_align_left">0.983</td>
<td id="S4.T2.6.1.4.4" class="ltx_td ltx_align_left">0.962</td>
<td id="S4.T2.6.1.4.5" class="ltx_td ltx_align_left">0.972</td>
