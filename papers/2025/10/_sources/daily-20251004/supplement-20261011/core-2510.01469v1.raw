<td id="S4.T2.6.1.1.6" class="ltx_td ltx_align_left ltx_border_tt"><span id="S4.T2.6.1.1.6.1" class="ltx_text ltx_font_bold">F1</span></td>
<td id="S4.T2.6.1.1.7" class="ltx_td ltx_align_left ltx_border_tt"><span id="S4.T2.6.1.1.7.1" class="ltx_text ltx_font_bold">Acc*</span></td></tr>
