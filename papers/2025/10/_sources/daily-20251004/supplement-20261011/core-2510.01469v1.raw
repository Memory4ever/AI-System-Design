<tr id="S3.T1.5.4" class="ltx_tr">
<td id="S3.T1.5.4.1" class="ltx_td ltx_align_left">MMLU-PRO</td></tr>
<tr id="S3.T1.5.5" class="ltx_tr">
<td id="S3.T1.5.5.1" class="ltx_td ltx_align_left" rowspan="2"><span id="S3.T1.5.5.1.1" class="ltx_text">Exact-Match</span></td>
<td id="S3.T1.5.5.2" class="ltx_td ltx_align_left ltx_border_t">bAbi</td>
