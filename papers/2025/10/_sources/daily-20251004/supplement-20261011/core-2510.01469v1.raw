<td id="S3.T1.5.5.4" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" rowspan="3"><span id="S3.T1.5.5.4.1" class="ltx_text">
<span id="S3.T1.5.5.4.1.1" class="ltx_inline-block">
<span id="S3.T1.5.5.4.1.1.1" class="ltx_p">3</span>
</span></span></td></tr>
