<th id="S4.T2.6.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen3-Reranker-4B</th>
<th id="S4.T2.6.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">4</th>
<td id="S4.T2.6.1.3.3" class="ltx_td ltx_align_left"><span id="S4.T2.6.1.3.3.1" class="ltx_text ltx_font_bold">0.985</span></td>
<td id="S4.T2.6.1.3.4" class="ltx_td ltx_align_left">0.983</td>
