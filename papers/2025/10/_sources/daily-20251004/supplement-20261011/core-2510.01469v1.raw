<td id="S4.T2.6.1.2.6" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T2.6.1.2.6.1" class="ltx_text ltx_font_bold">0.986</span></td>
<td id="S4.T2.6.1.2.7" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T2.6.1.2.7.1" class="ltx_text ltx_font_bold">0.956</span></td></tr>
