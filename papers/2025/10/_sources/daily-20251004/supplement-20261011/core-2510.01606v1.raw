<th id="S5.T4.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Missing rate</th>
<th id="S5.T4.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Hit@10</th></tr>
</thead>
