<th id="A1.SS2.SSS0.Px10.p6.1.1.9" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="A1.SS2.SSS0.Px10.p6.1.1.9.1" class="ltx_text ltx_font_typewriter">a</span></th>
<th id="A1.SS2.SSS0.Px10.p6.1.1.10" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="A1.SS2.SSS0.Px10.p6.1.1.10.1" class="ltx_text ltx_font_typewriter">b</span></th>
<th id="A1.SS2.SSS0.Px10.p6.1.1.11" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="A1.SS2.SSS0.Px10.p6.1.1.11.1" class="ltx_text ltx_font_typewriter">b</span></th>
<th id="A1.SS2.SSS0.Px10.p6.1.1.12" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="A1.SS2.SSS0.Px10.p6.1.1.12.1" class="ltx_text ltx_font_typewriter">b</span></th>
<th id="A1.SS2.SSS0.Px10.p6.1.1.13" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="A1.SS2.SSS0.Px10.p6.1.1.13.1" class="ltx_text ltx_font_typewriter">e</span></th>
<th id="A1.SS2.SSS0.Px10.p6.1.1.14" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="A1.SS2.SSS0.Px10.p6.1.1.14.1" class="ltx_text ltx_font_typewriter">r</span></th>
<th id="A1.SS2.SSS0.Px10.p6.1.1.15" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column"><span id="A1.SS2.SSS0.Px10.p6.1.1.15.1" class="ltx_text ltx_font_typewriter">y</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.SS2.SSS0.Px10.p6.1.2" class="ltx_tr">
<td id="A1.SS2.SSS0.Px10.p6.1.2.1" class="ltx_td"></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.2" class="ltx_td"></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.3" class="ltx_td ltx_align_center"><math id="A1.SS2.SSS0.Px10.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.4" class="ltx_td"></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.5" class="ltx_td ltx_align_center"><math id="A1.SS2.SSS0.Px10.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.6" class="ltx_td ltx_align_center"><math id="A1.SS2.SSS0.Px10.m8" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.7" class="ltx_td"></td>
