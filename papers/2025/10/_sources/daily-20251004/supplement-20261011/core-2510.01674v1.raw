<td id="A1.SS2.SSS0.Px10.p6.1.2.9" class="ltx_td"></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.10" class="ltx_td"></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.11" class="ltx_td"></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.12" class="ltx_td"></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.13" class="ltx_td"></td>
<td id="A1.SS2.SSS0.Px10.p6.1.2.14" class="ltx_td ltx_align_center"><math id="A1.SS2.SSS0.Px10.m10" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
