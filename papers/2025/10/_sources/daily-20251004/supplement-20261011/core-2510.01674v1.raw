<td id="S5.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t">74 / 1319</td>
<td id="S5.T1.2.2.3" class="ltx_td ltx_align_right ltx_border_t">5.6</td></tr>
<tr id="S5.T1.2.3" class="ltx_tr">
<td id="S5.T1.2.3.1" class="ltx_td ltx_align_left">FOR-Prompting (1 round)</td>
<td id="S5.T1.2.3.2" class="ltx_td ltx_align_center">321 / 1319</td>
<td id="S5.T1.2.3.3" class="ltx_td ltx_align_right">24.3 <math id="S5.T1.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="S5.T1.2.4" class="ltx_tr">
