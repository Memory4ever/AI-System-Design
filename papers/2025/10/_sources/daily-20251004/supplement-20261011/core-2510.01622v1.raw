<span id="S3.F2.pic1.4.3" class="ltx_p"><math id="S3.F2.pic1.m4" class="ltx_Math" alttext="f_{text}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">f</mi><mrow><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo lspace="0em" mathsize="0.900em" rspace="0em">⋅</mo><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{text}(\cdot)</annotation></semantics></math></span>
