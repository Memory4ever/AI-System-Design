</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#33FF33;--ltx-fill-color:#D9FFD9;" fill="#D9FFD9" stroke="#33FF33"><path d="M -139.3 212.6 L -238.65 212.6 C -240.94 212.6 -242.8 210.74 -242.8 208.45 L -242.8 169.5 C -242.8 167.21 -240.94 165.35 -238.65 165.35 L -139.3 165.35 C -137.01 165.35 -135.15 167.21 -135.15 169.5 L -135.15 208.45 C -135.15 210.74 -137.01 212.6 -139.3 212.6 Z M -242.8 165.35"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -238.19 192.61)"><foreignObject style="--ltx-fo-width:7.69em;--ltx-fo-height:0.68em;--ltx-fo-depth:1.2em;font-size:10pt;" height="25.94" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="106.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
