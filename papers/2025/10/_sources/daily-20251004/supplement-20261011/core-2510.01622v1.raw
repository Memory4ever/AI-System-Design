</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#33FF33;--ltx-fill-color:#D9FFD9;" fill="#D9FFD9" stroke="#33FF33"><path d="M 49.67 212.6 L -49.67 212.6 C -51.97 212.6 -53.82 210.74 -53.82 208.45 L -53.82 169.5 C -53.82 167.21 -51.97 165.35 -49.67 165.35 L 49.67 165.35 C 51.97 165.35 53.82 167.21 53.82 169.5 L 53.82 208.45 C 53.82 210.74 51.97 212.6 49.67 212.6 Z M -53.82 165.35"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -49.21 185.86)"><foreignObject style="--ltx-fo-width:7.69em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.23em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="106.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
