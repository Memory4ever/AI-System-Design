 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;" fill="#A6A6A6" stroke="#A6A6A6" stroke-width="0.8pt"><path style="fill:none" d="M 0 37 L 0 -61.09"></path><g style="--ltx-fg-color:#A6A6A6;" color="#A6A6A6" transform="matrix(0.0 -1.0 1.0 0.0 0 -61.09)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;" fill="#A6A6A6" stroke="#A6A6A6" stroke-width="0.8pt"><path style="fill:none" d="M 128.05 67.49 C 99.93 10 77.87 -20.28 34.38 -62.19"></path><g style="--ltx-fg-color:#A6A6A6;" color="#A6A6A6" transform="matrix(-0.72015 -0.69382 0.69382 -0.72015 34.38 -62.19)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M -213.97 165.08 C -315.39 89.24 -189.12 -160.87 -71.32 -125.33"></path><g transform="matrix(0.95738 0.28883 -0.28883 0.95738 -71.32 -125.33)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 2.09 165.08 C 10.1 75.84 10.22 24.59 2.91 -61.1"></path><g transform="matrix(-0.08492 -0.99638 0.99638 -0.08492 2.91 -61.1)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 213.97 165.08 C 315.39 89.24 189.12 -160.87 71.32 -125.33"></path><g transform="matrix(-0.95738 0.28883 -0.28883 -0.95738 71.32 -125.33)"><path style="stroke:none" d="M 3.6 0 L -2.16 2.88 L 0 0 L -2.16 -2.88"></path></g></g><g style="--ltx-stroke-color:#CC3366;--ltx-fill-color:#CC3366;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#CC3366" stroke="#CC3366" stroke-width="1.2pt"><path style="fill:none" d="M 0 -124.29 L 0 -159.66"></path><g style="--ltx-fg-color:#CC3366;" color="#CC3366" transform="matrix(0.0 -1.0 1.0 0.0 0 -159.66)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g><g style="--ltx-stroke-color:#FF9933;--ltx-fill-color:#FF9933;--ltx-fg-color:#FF9933;" color="#FF9933" fill="#FF9933" stroke="#FF9933" transform="matrix(1.0 0.0 0.0 1.0 234.25 80.72)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:7.69em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="106.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F2.pic1.15" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:7.69em;">
<span id="S3.F2.pic1.15.1" class="ltx_p"></span>
<span id="S3.F2.pic1.15.2" class="ltx_p"><span id="S3.F2.pic1.15.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#FF9933;">Cross-Modal</span></span>
<span id="S3.F2.pic1.15.3" class="ltx_p"><span id="S3.F2.pic1.15.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#FF9933;">Attention</span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#999999;--ltx-fill-color:#999999;--ltx-fg-color:#999999;" color="#999999" fill="#999999" stroke="#999999" transform="matrix(1.0 0.0 0.0 1.0 234.25 19.3)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:7.69em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="106.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F2.pic1.16" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:7.69em;">
<span id="S3.F2.pic1.16.1" class="ltx_p"></span>
<span id="S3.F2.pic1.16.2" class="ltx_p"><span id="S3.F2.pic1.16.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#999999;">Residual</span></span>
<span id="S3.F2.pic1.16.3" class="ltx_p"><span id="S3.F2.pic1.16.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#999999;">Connections</span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#CC3366;--ltx-fill-color:#CC3366;--ltx-fg-color:#CC3366;" color="#CC3366" fill="#CC3366" stroke="#CC3366" transform="matrix(1.0 0.0 0.0 1.0 -332.68 -97.6)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:7.69em;--ltx-fo-height:0.63em;--ltx-fo-depth:0.18em;font-size:10pt;" color="#000000" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="106.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F2.pic1.17" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:7.69em;">
<span id="S3.F2.pic1.17.1" class="ltx_p"></span>
<span id="S3.F2.pic1.17.2" class="ltx_p"><span id="S3.F2.pic1.17.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#CC3366;">Adaptive</span></span>
<span id="S3.F2.pic1.17.3" class="ltx_p"><span id="S3.F2.pic1.17.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#CC3366;">Fusion</span></span>
</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 2: </span>Detailed multimodal fusion architecture with cross-modal attention mechanisms. The system processes textual content (reviews, descriptions), categorical features (genres, categories), and numerical signals (ratings, timestamps) through specialized encoders, applies pairwise cross-modal attention, and generates a unified representation through adaptive weighted fusion with residual connections.</figcaption>
</figure>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S3.SS3.4" class="ltx_text">III-C</span> </span><span id="S3.SS3.5" class="ltx_text ltx_font_italic">Retrieval-Augmented Generation Mechanism</span></h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">Our retrieval-augmented generation mechanism enhances recommendation quality by incorporating relevant contextual information from within the dataset during the generation process. Rather than relying on external knowledge bases, we leverage rich metadata available in recommendation datasets including item descriptions, user reviews, genre/category information, and similar item relationships. The mechanism operates through three stages: contextual retrieval, relevance assessment, and generation augmentation.</p>
</div>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p"><span id="S3.SS3.p2.1.1" class="ltx_text ltx_font_bold">Contextual Retrieval:</span> Given a user query representation <math id="S3.SS3.p2.m1" class="ltx_Math" alttext="\mathbf{q}_{u}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mi>u</mi></msub><annotation encoding="application/x-tex">\mathbf{q}_{u}</annotation></semantics></math>, we retrieve relevant contextual information from the dataset’s metadata repository <math id="S3.SS3.p2.m2" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> using dense vector similarity:</p>
</div>
<div id="S3.SS3.p3" class="ltx_para">
<table id="S3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E7.m1" class="ltx_Math" alttext="\text{sim}(\mathbf{q}_{u},\mathbf{k}_{j})=\frac{\mathbf{q}_{u}^{T}\mathbf{k}_{j}}{||\mathbf{q}_{u}||_{2}\cdot||\mathbf{k}_{j}||_{2}}" display="block" intent=":literal"><semantics><mrow><mrow><mtext>sim</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐪</mi><mi>u</mi></msub><mo>,</mo><msub><mi>𝐤</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msubsup><mi>𝐪</mi><mi>u</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mi>j</mi></msub></mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐪</mi><mi>u</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐤</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\text{sim}(\mathbf{q}_{u},\mathbf{k}_{j})=\frac{\mathbf{q}_{u}^{T}\mathbf{k}_{j}}{||\mathbf{q}_{u}||_{2}\cdot||\mathbf{k}_{j}||_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p4" class="ltx_para">
<p id="S3.SS3.p4.1" class="ltx_p">The top-<math id="S3.SS3.p4.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> most relevant contextual entries are selected:</p>
</div>
<div id="S3.SS3.p5" class="ltx_para">
<table id="S3.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E8.m1" class="ltx_Math" alttext="\mathcal{M}_{retrieved}=\text{TopK}(\{\mathbf{m}_{j}|j\in\mathcal{M}\},\text{sim}(\mathbf{q}_{u},\cdot))" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo>=</mo><mrow><mtext>TopK</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>𝐦</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mtext>sim</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐪</mi><mi>u</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{retrieved}=\text{TopK}(\{\mathbf{m}_{j}|j\in\mathcal{M}\},\text{sim}(\mathbf{q}_{u},\cdot))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p6" class="ltx_para">
<p id="S3.SS3.p6.1" class="ltx_p"><span id="S3.SS3.p6.1.1" class="ltx_text ltx_font_bold">Relevance Assessment:</span> We compute a comprehensive relevance score considering multiple factors:</p>
</div>
<div id="S3.SS3.p7" class="ltx_para">
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex1.m1" class="ltx_Math" alttext="\displaystyle\text{score}(\mathbf{k}_{j})" display="inline" intent=":literal"><semantics><mrow><mtext>score</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐤</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{score}(\mathbf{k}_{j})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex1.m2" class="ltx_Math" alttext="\displaystyle=\lambda_{1}\cdot\text{sim}(\mathbf{q}_{u},\mathbf{k}_{j})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>sim</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐪</mi><mi>u</mi></msub><mo>,</mo><msub><mi>𝐤</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lambda_{1}\cdot\text{sim}(\mathbf{q}_{u},\mathbf{k}_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex2.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\lambda_{2}\cdot\text{temporal}(\mathbf{k}_{j})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>λ</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>temporal</mtext><mrow><mo stretchy="false">(</mo><msub><mi>𝐤</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\lambda_{2}\cdot\text{temporal}(\mathbf{k}_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E9.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\lambda_{3}\cdot\text{credibility}(\mathbf{k}_{j})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>λ</mi><mn>3</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>credibility</mtext><mrow><mo stretchy="false">(</mo><msub><mi>𝐤</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\lambda_{3}\cdot\text{credibility}(\mathbf{k}_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p8" class="ltx_para">
<p id="S3.SS3.p8.1" class="ltx_p">where temporal relevance is modeled as:</p>
</div>
<div id="S3.SS3.p9" class="ltx_para">
<table id="S3.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E10.m1" class="ltx_Math" alttext="\text{temporal}(\mathbf{k}_{j})=\exp\left(-\frac{(t_{current}-t_{j})^{2}}{2\sigma^{2}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mtext>temporal</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐤</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>t</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{temporal}(\mathbf{k}_{j})=\exp\left(-\frac{(t_{current}-t_{j})^{2}}{2\sigma^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p10" class="ltx_para">
<p id="S3.SS3.p10.1" class="ltx_p"><span id="S3.SS3.p10.1.1" class="ltx_text ltx_font_bold">Generation Augmentation:</span> The retrieved knowledge is integrated into the generation process through contextual conditioning:</p>
</div>
<div id="S3.SS3.p11" class="ltx_para">
<table id="S3.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E11.m1" class="ltx_Math" alttext="P(y_{t}|y_{&lt;t},\mathbf{h}_{user},\mathcal{K}_{retrieved})=\text{softmax}(\mathbf{W}_{o}\cdot\mathbf{h}_{t}+\mathbf{b}_{o})" display="block" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>y</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐡</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>softmax</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝐖</mi><mi>o</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝐡</mi><mi>t</mi></msub></mrow><mo>+</mo><msub><mi>𝐛</mi><mi>o</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P(y_{t}|y_{&lt;t},\mathbf{h}_{user},\mathcal{K}_{retrieved})=\text{softmax}(\mathbf{W}_{o}\cdot\mathbf{h}_{t}+\mathbf{b}_{o})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p12" class="ltx_para">
<p id="S3.SS3.p12.1" class="ltx_p">where the hidden state <math id="S3.SS3.p12.m1" class="ltx_Math" alttext="\mathbf{h}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐡</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{h}_{t}</annotation></semantics></math> is computed considering both user context and retrieved knowledge:</p>
</div>
<div id="S3.SS3.p13" class="ltx_para">
<table id="S3.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E12.m1" class="ltx_Math" alttext="\mathbf{h}_{t}=\text{LLM}([\mathbf{h}_{user};\text{Embed}(\mathcal{K}_{retrieved});y_{&lt;t}])" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐡</mi><mi>t</mi></msub><mo>=</mo><mrow><mtext>LLM</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐡</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>;</mo><mrow><mtext>Embed</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>;</mo><msub><mi>y</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}_{t}=\text{LLM}([\mathbf{h}_{user};\text{Embed}(\mathcal{K}_{retrieved});y_{&lt;t}])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S3.SS4.4" class="ltx_text">III-D</span> </span><span id="S3.SS4.5" class="ltx_text ltx_font_italic">Causal Inference-Based Debiasing</span></h3>

<div id="S3.SS4.p1" class="ltx_para">
<p id="S3.SS4.p1.1" class="ltx_p">Our debiasing framework employs causal inference techniques to identify and mitigate various forms of systematic bias in recommendation outcomes. The framework addresses three primary types of bias: selection bias, popularity bias, and demographic bias.</p>
</div>
<div id="S3.SS4.p2" class="ltx_para">
<p id="S3.SS4.p2.1" class="ltx_p"><span id="S3.SS4.p2.1.1" class="ltx_text ltx_font_bold">Selection Bias Mitigation:</span> We use inverse propensity scoring to adjust for non-random user-item interactions. The propensity score is estimated as:</p>
</div>
<div id="S3.SS4.p3" class="ltx_para">
<table id="S3.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E13.m1" class="ltx_Math" alttext="e(u,i)=P(O_{ui}=1|\mathbf{x}_{u},\mathbf{x}_{i})" display="block" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>O</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mi>u</mi></msub><mo>,</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">e(u,i)=P(O_{ui}=1|\mathbf{x}_{u},\mathbf{x}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS4.p4" class="ltx_para">
<p id="S3.SS4.p4.1" class="ltx_p">where <math id="S3.SS4.p4.m1" class="ltx_Math" alttext="O_{ui}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">O_{ui}</annotation></semantics></math> indicates whether user <math id="S3.SS4.p4.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> interacted with item <math id="S3.SS4.p4.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. The debiased loss function becomes:</p>
</div>
<div id="S3.SS4.p5" class="ltx_para">
<table id="S3.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E14.m1" class="ltx_Math" alttext="\mathcal{L}_{debiased}=\frac{1}{|\mathcal{D}|}\sum_{(u,i)\in\mathcal{D}}\frac{1}{e(u,i)}\cdot\ell(r_{ui},\hat{r}_{ui})" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder><mfrac><mn>1</mn><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{debiased}=\frac{1}{|\mathcal{D}|}\sum_{(u,i)\in\mathcal{D}}\frac{1}{e(u,i)}\cdot\ell(r_{ui},\hat{r}_{ui})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS4.p6" class="ltx_para">
<p id="S3.SS4.p6.1" class="ltx_p"><span id="S3.SS4.p6.1.1" class="ltx_text ltx_font_bold">Popularity Bias Correction:</span> We model the causal relationship using structural causal models. The causal effect of item features on user preference, independent of popularity, is estimated using do-calculus:</p>
</div>
<div id="S3.SS4.p7" class="ltx_para">
<table id="S3.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\displaystyle P(Y_{ui}|\text{do}(\mathbf{X}_{i}=\mathbf{x}))" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mtext>do</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐗</mi><mi>i</mi></msub><mo>=</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P(Y_{ui}|\text{do}(\mathbf{X}_{i}=\mathbf{x}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex3.m2" class="ltx_Math" alttext="\displaystyle=\sum_{p}P(Y_{ui}|\mathbf{X}_{i}=\mathbf{x},P_{i}=p)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>p</mi></munder></mstyle><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>𝐗</mi><mi>i</mi></msub><mo>=</mo><mi>𝐱</mi></mrow><mo>,</mo><mrow><msub><mi>P</mi><mi>i</mi></msub><mo>=</mo><mi>p</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{p}P(Y_{ui}|\mathbf{X}_{i}=\mathbf{x},P_{i}=p)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E15.m1" class="ltx_Math" alttext="\displaystyle\quad\cdot P(P_{i}=p)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.222em" rspace="0.222em">⋅</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>i</mi></msub><mo>=</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\cdot P(P_{i}=p)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS4.p8" class="ltx_para">
<p id="S3.SS4.p8.1" class="ltx_p">where <math id="S3.SS4.p8.m1" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math> represents item popularity and <math id="S3.SS4.p8.m2" class="ltx_Math" alttext="\mathbf{X}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐗</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{X}_{i}</annotation></semantics></math> represents item features.</p>
</div>
<div id="S3.SS4.p9" class="ltx_para">
<p id="S3.SS4.p9.1" class="ltx_p"><span id="S3.SS4.p9.1.1" class="ltx_text ltx_font_bold">Demographic Fairness:</span> We implement adversarial debiasing with fairness constraints. The objective function incorporates both recommendation accuracy and fairness:</p>
</div>
<div id="S3.SS4.p10" class="ltx_para">
<table id="S3.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E16.m1" class="ltx_Math" alttext="\mathcal{L}_{total}=\mathcal{L}_{rec}+\lambda_{fair}\cdot\mathcal{L}_{adv}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>+</mo><mrow><msub><mi>λ</mi><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{total}=\mathcal{L}_{rec}+\lambda_{fair}\cdot\mathcal{L}_{adv}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS4.p11" class="ltx_para">
<p id="S3.SS4.p11.1" class="ltx_p">where the adversarial loss ensures demographic parity:</p>
</div>
<div id="S3.SS4.p12" class="ltx_para">
<table id="S3.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E17.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{adv}=-\sum_{s\in\mathcal{S}}P(S=s)\log P(S=s|\hat{r}_{ui})" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.055em">−</mo><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder><mi>P</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>=</mo><mi>s</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><mi>P</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>=</mo><mi>s</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{adv}=-\sum_{s\in\mathcal{S}}P(S=s)\log P(S=s|\hat{r}_{ui})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS4.p13" class="ltx_para">
<p id="S3.SS4.p13.1" class="ltx_p">The fairness constraint ensures:</p>
</div>
<div id="S3.SS4.p14" class="ltx_para">
<table id="S3.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E18.m1" class="ltx_Math" alttext="|P(\hat{r}_{ui}&gt;\tau|S=s_{1})-P(\hat{r}_{ui}&gt;\tau|S=s_{2})|\leq\epsilon" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>&gt;</mo><mi>τ</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mi>S</mi><mo>=</mo><msub><mi>s</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>&gt;</mo><mi>τ</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mi>S</mi><mo>=</mo><msub><mi>s</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">|P(\hat{r}_{ui}&gt;\tau|S=s_{1})-P(\hat{r}_{ui}&gt;\tau|S=s_{2})|\leq\epsilon</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS4.p15" class="ltx_para">
<p id="S3.SS4.p15.1" class="ltx_p">for any demographic groups <math id="S3.SS4.p15.m1" class="ltx_Math" alttext="s_{1},s_{2}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><msub><mi>s</mi><mn>2</mn></msub></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s_{1},s_{2}\in\mathcal{S}</annotation></semantics></math> and threshold <math id="S3.SS4.p15.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S3.SS5.4" class="ltx_text">III-E</span> </span><span id="S3.SS5.5" class="ltx_text ltx_font_italic">Explainable Recommendation Generation</span></h3>

<div id="S3.SS5.p1" class="ltx_para">
<p id="S3.SS5.p1.1" class="ltx_p">Our explainable recommendation generation module produces natural language explanations that justify recommendation decisions through multiple explanation types: preference-based, similarity-based, and contextual explanations.</p>
</div>
<div id="S3.SS5.p2" class="ltx_para">
<p id="S3.SS5.p2.1" class="ltx_p"><span id="S3.SS5.p2.1.1" class="ltx_text ltx_font_bold">Preference-Based Explanations:</span> We model user preference patterns through latent factor analysis and generate explanations based on dominant preference dimensions:</p>
</div>
<div id="S3.SS5.p3" class="ltx_para">
<table id="S3.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E19.m1" class="ltx_Math" alttext="\mathbf{p}_{u}=\text{softmax}(\mathbf{W}_{p}\mathbf{h}_{u}+\mathbf{b}_{p})" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐩</mi><mi>u</mi></msub><mo>=</mo><mrow><mtext>softmax</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝐖</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐡</mi><mi>u</mi></msub></mrow><mo>+</mo><msub><mi>𝐛</mi><mi>p</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{p}_{u}=\text{softmax}(\mathbf{W}_{p}\mathbf{h}_{u}+\mathbf{b}_{p})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS5.p4" class="ltx_para">
<p id="S3.SS5.p4.1" class="ltx_p">where <math id="S3.SS5.p4.m1" class="ltx_Math" alttext="\mathbf{p}_{u}" display="inline" intent=":literal"><semantics><msub><mi>𝐩</mi><mi>u</mi></msub><annotation encoding="application/x-tex">\mathbf{p}_{u}</annotation></semantics></math> represents the user’s preference distribution over different aspects. The explanation generation probability is:</p>
</div>
<div id="S3.SS5.p5" class="ltx_para">
<table id="S3.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E20.m1" class="ltx_Math" alttext="P(\text{explanation}|u,i)=\prod_{k=1}^{K}P(\text{aspect}_{k}|\mathbf{p}_{u})\cdot P(\text{item}_{i}|\text{aspect}_{k})" display="block" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>explanation</mtext><mo lspace="0em" rspace="0em">|</mo><mrow><mi>u</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mtext>aspect</mtext><mi>k</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐩</mi><mi>u</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mtext>item</mtext><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mtext>aspect</mtext><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P(\text{explanation}|u,i)=\prod_{k=1}^{K}P(\text{aspect}_{k}|\mathbf{p}_{u})\cdot P(\text{item}_{i}|\text{aspect}_{k})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS5.p6" class="ltx_para">
<p id="S3.SS5.p6.1" class="ltx_p"><span id="S3.SS5.p6.1.1" class="ltx_text ltx_font_bold">Similarity-Based Explanations:</span> We compute item-to-item similarity in the learned embedding space and generate explanations based on nearest neighbors:</p>
</div>
<div id="S3.SS5.p7" class="ltx_para">
<table id="S3.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E21.m1" class="ltx_Math" alttext="\text{sim}(i,j)=\frac{\mathbf{e}_{i}^{T}\mathbf{e}_{j}}{||\mathbf{e}_{i}||_{2}\cdot||\mathbf{e}_{j}||_{2}}" display="block" intent=":literal"><semantics><mrow><mrow><mtext>sim</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msubsup><mi>𝐞</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>j</mi></msub></mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐞</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐞</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\text{sim}(i,j)=\frac{\mathbf{e}_{i}^{T}\mathbf{e}_{j}}{||\mathbf{e}_{i}||_{2}\cdot||\mathbf{e}_{j}||_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS5.p8" class="ltx_para">
<p id="S3.SS5.p8.1" class="ltx_p">The explanation focuses on the most similar items from user history:</p>
</div>
<div id="S3.SS5.p9" class="ltx_para">
<table id="S3.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E22.m1" class="ltx_Math" alttext="\mathcal{I}_{similar}=\text{TopK}(\{j|(u,j)\in\mathcal{H}_{u}\},\text{sim}(i,\cdot))" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>=</mo><mrow><mtext>TopK</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>u</mi></msub></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mtext>sim</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}_{similar}=\text{TopK}(\{j|(u,j)\in\mathcal{H}_{u}\},\text{sim}(i,\cdot))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS5.p10" class="ltx_para">
<p id="S3.SS5.p10.1" class="ltx_p"><span id="S3.SS5.p10.1.1" class="ltx_text ltx_font_bold">Contextual Explanations:</span> We incorporate contextual factors through a context-aware attention mechanism:</p>
</div>
<div id="S3.SS5.p11" class="ltx_para">
<table id="S3.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E23.m1" class="ltx_Math" alttext="\mathbf{c}_{t}=\text{Attention}(\mathbf{h}_{context},[\mathbf{h}_{time};\mathbf{h}_{location};\mathbf{h}_{trend}])" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐜</mi><mi>t</mi></msub><mo>=</mo><mrow><mtext>Attention</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐡</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐡</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><mo>;</mo><msub><mi>𝐡</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>;</mo><msub><mi>𝐡</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{c}_{t}=\text{Attention}(\mathbf{h}_{context},[\mathbf{h}_{time};\mathbf{h}_{location};\mathbf{h}_{trend}])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS5.p12" class="ltx_para">
<p id="S3.SS5.p12.1" class="ltx_p">The final explanation generation combines all three types:</p>
</div>
<div id="S3.SS5.p13" class="ltx_para">
<table id="S3.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E24.m1" class="ltx_Math" alttext="P(\mathbf{y}_{exp}|u,i,\mathbf{c}_{t})=\text{LLM}([\mathbf{h}_{u};\mathbf{h}_{i};\mathbf{c}_{t};\text{template}])" display="block" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>u</mi><mo>,</mo><mi>i</mi><mo>,</mo><msub><mi>𝐜</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>LLM</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐡</mi><mi>u</mi></msub><mo>;</mo><msub><mi>𝐡</mi><mi>i</mi></msub><mo>;</mo><msub><mi>𝐜</mi><mi>t</mi></msub><mo>;</mo><mtext>template</mtext></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P(\mathbf{y}_{exp}|u,i,\mathbf{c}_{t})=\text{LLM}([\mathbf{h}_{u};\mathbf{h}_{i};\mathbf{c}_{t};\text{template}])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS5.p14" class="ltx_para">
<p id="S3.SS5.p14.1" class="ltx_p">where the explanation template is selected based on the dominant explanation type:</p>
</div>
<div id="S3.SS5.p15" class="ltx_para">
<table id="S3.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E25.m1" class="ltx_Math" alttext="\text{template}=\arg\max_{t\in\mathcal{T}}\{\alpha_{pref},\alpha_{sim},\alpha_{context}\}" display="block" intent=":literal"><semantics><mrow><mtext>template</mtext><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>α</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo>,</mo><msub><mi>α</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo>,</mo><msub><mi>α</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{template}=\arg\max_{t\in\mathcal{T}}\{\alpha_{pref},\alpha_{sim},\alpha_{context}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S3.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S3.SS6.4" class="ltx_text">III-F</span> </span><span id="S3.SS6.5" class="ltx_text ltx_font_italic">Real-Time Adaptive Learning</span></h3>

<div id="S3.SS6.p1" class="ltx_para">
<p id="S3.SS6.p1.1" class="ltx_p">Our adaptive learning framework enables continuous model improvement through incremental updates that incorporate new user feedback and behavioral data without requiring full model retraining.</p>
</div>
<div id="S3.SS6.p2" class="ltx_para">
<p id="S3.SS6.p2.1" class="ltx_p"><span id="S3.SS6.p2.1.1" class="ltx_text ltx_font_bold">Online Parameter Updates:</span> We employ stochastic gradient descent with momentum for continuous learning:</p>
</div>
<div id="S3.SS6.p3" class="ltx_para">
<table id="S3.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E26.m1" class="ltx_Math" alttext="\mathbf{v}_{t}=\gamma\mathbf{v}_{t-1}+\eta\nabla_{\theta}\mathcal{L}(\mathbf{x}_{t},y_{t};\theta_{t-1})" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo>,</mo><msub><mi>θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}_{t}=\gamma\mathbf{v}_{t-1}+\eta\nabla_{\theta}\mathcal{L}(\mathbf{x}_{t},y_{t};\theta_{t-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS6.p4" class="ltx_para">
<table id="S3.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E27.m1" class="ltx_Math" alttext="\theta_{t}=\theta_{t-1}-\mathbf{v}_{t}" display="block" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝐯</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\theta_{t}=\theta_{t-1}-\mathbf{v}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS6.p5" class="ltx_para">
<p id="S3.SS6.p5.1" class="ltx_p">where <math id="S3.SS6.p5.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is the momentum coefficient and <math id="S3.SS6.p5.m2" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is the learning rate, adaptively adjusted based on feedback quality:</p>
</div>
<div id="S3.SS6.p6" class="ltx_para">
<table id="S3.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E28.m1" class="ltx_math_unparsed" alttext="\eta_{t}=\eta_{0}\cdot\exp(-\lambda\cdot\text{uncertainty}(\mathbf{x}_{t}))" display="block" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo>=</mo><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>λ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>uncertainty</mtext><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta_{t}=\eta_{0}\cdot\exp(-\lambda\cdot\text{uncertainty}(\mathbf{x}_{t}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS6.p7" class="ltx_para">
<p id="S3.SS6.p7.1" class="ltx_p"><span id="S3.SS6.p7.1.1" class="ltx_text ltx_font_bold">Memory-Efficient Updates:</span> We implement selective parameter updates using importance sampling:</p>
</div>
<div id="S3.SS6.p8" class="ltx_para">
<table id="S3.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E29.m1" class="ltx_Math" alttext="P(\text{update}|\theta_{j})=\frac{\exp(|\nabla_{\theta_{j}}\mathcal{L}|)}{\sum_{k}\exp(|\nabla_{\theta_{k}}\mathcal{L}|)}" display="block" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>update</mtext><mo lspace="0em" rspace="0em">|</mo><msub><mi>θ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mi>j</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo stretchy="false">|</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mo>∑</mo><mi>k</mi></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mi>k</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo stretchy="false">|</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">P(\text{update}|\theta_{j})=\frac{\exp(|\nabla_{\theta_{j}}\mathcal{L}|)}{\sum_{k}\exp(|\nabla_{\theta_{k}}\mathcal{L}|)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS6.p9" class="ltx_para">
<p id="S3.SS6.p9.1" class="ltx_p">Only parameters with high importance scores are updated, reducing computational overhead:</p>
</div>
<div id="S3.SS6.p10" class="ltx_para">
<table id="S3.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E30.m1" class="ltx_Math" alttext="\theta_{j}^{(t)}=\begin{cases}\theta_{j}^{(t-1)}-\eta_{t}\nabla_{\theta_{j}}\mathcal{L}&amp;\text{if }P(\text{update}|\theta_{j})&gt;\tau\\
\theta_{j}^{(t-1)}&amp;\text{otherwise}\end{cases}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>θ</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>θ</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mi>j</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>update</mtext><mo lspace="0em" rspace="0em">|</mo><msub><mi>θ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>τ</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><msubsup><mi>θ</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\theta_{j}^{(t)}=\begin{cases}\theta_{j}^{(t-1)}-\eta_{t}\nabla_{\theta_{j}}\mathcal{L}&amp;\text{if }P(\text{update}|\theta_{j})&gt;\tau\\
\theta_{j}^{(t-1)}&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS6.p11" class="ltx_para">
<p id="S3.SS6.p11.1" class="ltx_p"><span id="S3.SS6.p11.1.1" class="ltx_text ltx_font_bold">Multi-Type Feedback Integration:</span> We combine explicit and implicit feedback through weighted aggregation:</p>
</div>
<div id="S3.SS6.p12" class="ltx_para">
<table id="S3.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E31.m1" class="ltx_Math" alttext="\mathcal{L}_{total}=\alpha\mathcal{L}_{explicit}+\beta\mathcal{L}_{implicit}+\gamma\mathcal{L}_{regularization}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{total}=\alpha\mathcal{L}_{explicit}+\beta\mathcal{L}_{implicit}+\gamma\mathcal{L}_{regularization}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS6.p13" class="ltx_para">
<p id="S3.SS6.p13.1" class="ltx_p">where the weights are dynamically adjusted based on feedback reliability:</p>
</div>
<div id="S3.SS6.p14" class="ltx_para">
<table id="S3.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E32.m1" class="ltx_Math" alttext="\alpha_{t}=\frac{\text{reliability}_{explicit}(t)}{\text{reliability}_{explicit}(t)+\text{reliability}_{implicit}(t)}" display="block" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>=</mo><mfrac><mrow><msub><mtext>reliability</mtext><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msub><mtext>reliability</mtext><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mtext>reliability</mtext><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha_{t}=\frac{\text{reliability}_{explicit}(t)}{\text{reliability}_{explicit}(t)+\text{reliability}_{implicit}(t)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS6.p15" class="ltx_para">
<p id="S3.SS6.p15.1" class="ltx_p"><span id="S3.SS6.p15.1.1" class="ltx_text ltx_font_bold">Catastrophic Forgetting Prevention:</span> We employ elastic weight consolidation to preserve important knowledge:</p>
</div>
<div id="S3.SS6.p16" class="ltx_para">
<table id="S3.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E33.m1" class="ltx_Math" alttext="\mathcal{L}_{EWC}=\mathcal{L}_{new}+\frac{\lambda}{2}\sum_{j}F_{j}(\theta_{j}-\theta_{j}^{*})^{2}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>+</mo><mrow><mfrac><mi>λ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder><mrow><msub><mi>F</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>θ</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>θ</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{EWC}=\mathcal{L}_{new}+\frac{\lambda}{2}\sum_{j}F_{j}(\theta_{j}-\theta_{j}^{*})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS6.p17" class="ltx_para">
<p id="S3.SS6.p17.1" class="ltx_p">where <math id="S3.SS6.p17.m1" class="ltx_Math" alttext="F_{j}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>j</mi></msub><annotation encoding="application/x-tex">F_{j}</annotation></semantics></math> represents the Fisher information matrix diagonal and <math id="S3.SS6.p17.m2" class="ltx_Math" alttext="\theta_{j}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mi>j</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\theta_{j}^{*}</annotation></semantics></math> are the optimal parameters from previous tasks.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">IV </span><span id="S4.1" class="ltx_text ltx_font_smallcaps">Experimental Evaluation</span></h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS1.4" class="ltx_text">IV-A</span> </span><span id="S4.SS1.5" class="ltx_text ltx_font_italic">Experimental Setup</span></h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">We conducted comprehensive experiments on three benchmark datasets: MovieLens-25M, Amazon-Electronics, and Yelp-2023. These datasets were selected for their complementary characteristics: MovieLens-25M provides rich textual metadata (movie descriptions, genres, tags) and temporal interaction patterns; Amazon-Electronics contains product descriptions, categorical information, and review text suitable for multimodal analysis; Yelp-2023 offers extensive textual reviews, business attributes, and user check-in data enabling comprehensive evaluation of our text-enhanced generative framework.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">For multimodal fusion experiments, we utilize available textual features (reviews, descriptions, tags) as the primary modality, with categorical and numerical features as auxiliary modalities. The retrieval augmentation component leverages genre/category information and similar item descriptions from the dataset itself. Causal debiasing is evaluated using temporal splits and category-based fairness metrics available in the datasets.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p">The experimental setup includes comparison with five baseline methods: traditional GenRec, P5, RecBole, LightGCN, and BERT4Rec. We evaluate performance using standard recommendation metrics including Hit Ratio (HR), Normalized Discounted Cumulative Gain (NDCG), Mean Reciprocal Rank (MRR), and diversity measures.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS2.4" class="ltx_text">IV-B</span> </span><span id="S4.SS2.5" class="ltx_text ltx_font_italic">Performance Results</span></h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">Table <a href="#S4.T1" title="TABLE I ‣ IV-B Performance Results ‣ IV Experimental Evaluation ‣ LLM4Rec: Large Language Models for Multimodal Generative Recommendation with Causal Debiasing" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I</span></a> presents the comprehensive performance comparison across three benchmark datasets. Our enhanced framework demonstrates significant improvements across all evaluation metrics compared to baseline methods.</p>
</div>
