                          <XMRef idref="S1.F1.pic1.m14.3" xml:id="S1.F1.pic1.m14.2.5.1.2"/>
                          <XMRef idref="S1.F1.pic1.m14.4" xml:id="S1.F1.pic1.m14.2.5.1.3"/>
                        </XMApp>
                        <XMWrap xml:id="S1.F1.pic1.m14.2.5.2">
                          <XMTok fontsize="70%" role="OPEN" stretchy="false">(</XMTok>
