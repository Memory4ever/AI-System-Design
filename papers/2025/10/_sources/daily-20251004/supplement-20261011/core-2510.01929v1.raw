<td id="S3.T2.3.1.2.3" class="ltx_td ltx_align_center"><cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib4" title="" class="ltx_ref">Croce &amp; Hein (2020)</a></cite></td>
<td id="S3.T2.3.1.2.4" class="ltx_td ltx_align_center" colspan="2"><cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib11" title="" class="ltx_ref">Goodfellow et al. (2015)</a></cite></td></tr>
<tr id="S3.T2.3.1.3" class="ltx_tr">
<th id="S3.T2.3.1.3.1" class="ltx_td ltx_th ltx_th_row"></th>
<td id="S3.T2.3.1.3.2" class="ltx_td ltx_align_center" colspan="2"><math id="S3.T2.m2" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math></td>
<td id="S3.T2.3.1.3.3" class="ltx_td"></td>
<td id="S3.T2.3.1.3.4" class="ltx_td ltx_align_center" colspan="2"><math id="S3.T2.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></td></tr>
