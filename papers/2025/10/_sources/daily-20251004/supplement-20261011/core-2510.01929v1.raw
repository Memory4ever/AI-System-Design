            <XMath xml:id="S1.F1.pic1.m13.4a">
              <XMApp xml:id="S1.F1.pic1.m13.4a.1">
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">p</XMTok>
                <XMDual xml:id="S1.F1.pic1.m13.4a.1.2">
                  <XMApp xml:id="S1.F1.pic1.m13.4a.1.2.1">
                    <XMTok meaning="conditional"/>
                    <XMRef idref="S1.F1.pic1.m13.1" xml:id="S1.F1.pic1.m13.4a.1.2.1.2"/>
                    <XMRef idref="S1.F1.pic1.m13.2" xml:id="S1.F1.pic1.m13.4a.1.2.1.3"/>
                  </XMApp>
                  <XMWrap xml:id="S1.F1.pic1.m13.4a.1.2.2">
                    <XMTok fontsize="70%" role="OPEN" stretchy="false">(</XMTok>
                    <XMApp xml:id="S1.F1.pic1.m13.1">
                      <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                      <XMTok font="bold" fontsize="70%" role="UNKNOWN">x</XMTok>
                      <XMTok font="italic" fontsize="49%" role="UNKNOWN">i</XMTok>
                    </XMApp>
                    <XMTok fontsize="70%" role="MIDDLE" stretchy="false">|</XMTok>
                    <XMDual xml:id="S1.F1.pic1.m13.2">
                      <XMApp xml:id="S1.F1.pic1.m13.2.3">
                        <XMTok meaning="vector"/>
                        <XMRef idref="S1.F1.pic1.m13.3" xml:id="S1.F1.pic1.m13.2.3.2"/>
                        <XMRef idref="S1.F1.pic1.m13.4" xml:id="S1.F1.pic1.m13.2.3.3"/>
                        <XMRef idref="S1.F1.pic1.m13.5" xml:id="S1.F1.pic1.m13.2.3.4"/>
                      </XMApp>
                      <XMWrap xml:id="S1.F1.pic1.m13.2.4">
                        <XMApp xml:id="S1.F1.pic1.m13.3">
                          <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                          <XMTok font="bold" fontsize="70%" role="UNKNOWN">x</XMTok>
                          <XMTok fontsize="49%" meaning="1" role="NUMBER">1</XMTok>
                        </XMApp>
                        <XMTok fontsize="70%" role="PUNCT">,</XMTok>
                        <XMTok fontsize="70%" name="ldots" role="ID" xml:id="S1.F1.pic1.m13.4">…</XMTok>
                        <XMTok fontsize="70%" role="PUNCT">,</XMTok>
                        <XMApp xml:id="S1.F1.pic1.m13.5">
                          <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                          <XMTok font="bold" fontsize="70%" role="UNKNOWN">x</XMTok>
                          <XMApp xml:id="S1.F1.pic1.m13.5.3">
                            <XMTok fontsize="49%" meaning="minus" role="ADDOP">-</XMTok>
                            <XMTok font="italic" fontsize="49%" role="UNKNOWN">i</XMTok>
                            <XMTok fontsize="49%" meaning="1" role="NUMBER">1</XMTok>
                          </XMApp>
                        </XMApp>
                      </XMWrap>
                    </XMDual>
                    <XMTok fontsize="70%" role="CLOSE" stretchy="false">)</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
            </XMath>
          </Math></foreignObject></g></g><g transform="translate(238.69,233.91)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="124.60" height="11.96" overflow="visible"><Math mode="inline" tex="p\big(\mathbf{x}_{i-1}|\nabla_{\mathbf{x}_{i-1}}p(\mathbf{x}_{i}|\mathbf{x}_{1},\ldots,\mathbf{x}_{i-1})\big)" text="p@(conditional@(x _ (i - 1), (nabla _ x _ (i - 1))@(p) * conditional@(x _ i, vector@(x _ 1, ldots, x _ (i - 1)))))" xml:id="S1.F1.pic1.m14">
            <XMath xml:id="S1.F1.pic1.m14.4a">
              <XMApp xml:id="S1.F1.pic1.m14.4a.1">
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">p</XMTok>
                <XMDual xml:id="S1.F1.pic1.m14.4a.1.2">
                  <XMApp xml:id="S1.F1.pic1.m14.4a.1.2.1">
                    <XMTok meaning="conditional"/>
                    <XMRef idref="S1.F1.pic1.m14.1" xml:id="S1.F1.pic1.m14.4a.1.2.1.2"/>
