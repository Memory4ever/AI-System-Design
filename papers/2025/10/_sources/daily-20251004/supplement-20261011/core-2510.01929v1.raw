<td id="S3.T2.3.1.7.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.3.1.7.2.1" class="ltx_text ltx_font_bold">48.1%</span></td>
<td id="S3.T2.3.1.7.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.3.1.7.3.1" class="ltx_text ltx_font_bold">45.0%</span></td>
