<th id="S3.T2.3.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S3.T2.m4" class="ltx_Math" alttext="g(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\mathbf{x})</annotation></semantics></math> <math id="S3.T2.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<td id="S3.T2.3.1.4.2" class="ltx_td ltx_align_center"><math id="S3.T2.m6" class="ltx_Math" alttext="1\text{e-}3" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mtext>e-</mtext><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">1\text{e-}3</annotation></semantics></math></td>
<td id="S3.T2.3.1.4.3" class="ltx_td ltx_align_center"><math id="S3.T2.m7" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math></td>
<td id="S3.T2.3.1.4.4" class="ltx_td"></td>
<td id="S3.T2.3.1.4.5" class="ltx_td ltx_align_center"><math id="S3.T2.m8" class="ltx_Math" alttext="5\text{e-}3" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mtext>e-</mtext><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">5\text{e-}3</annotation></semantics></math></td>
<td id="S3.T2.3.1.4.6" class="ltx_td ltx_align_center"><math id="S3.T2.m9" class="ltx_Math" alttext="1\text{e-}2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mtext>e-</mtext><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1\text{e-}2</annotation></semantics></math></td></tr>
