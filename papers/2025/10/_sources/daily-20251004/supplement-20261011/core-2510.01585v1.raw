<td id="S4.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.8pt;padding-right:3.8pt;"><span id="S4.T3.5.2.4.1" class="ltx_text" style="font-size:90%;">-</span></td></tr>
