<td id="S4.T3.5.5.1" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.8pt;padding-right:3.8pt;"><span id="S4.T3.5.5.1.1" class="ltx_text" style="font-size:90%;">w/o SOES</span></td>
