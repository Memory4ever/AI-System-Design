<td id="S4.T3.5.4.3" class="ltx_td ltx_align_center" style="padding-left:3.8pt;padding-right:3.8pt;"><span id="S4.T3.5.4.3.1" class="ltx_text" style="font-size:90%;">66.1</span></td>
