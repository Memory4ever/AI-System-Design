<span id="A1.T9.4.10.1.1.1" class="ltx_p"><span id="A1.T9.4.10.1.1.1.1" class="ltx_text ltx_font_bold">Notes:</span> Numeric mapping should preserve order</span>
</span></td></tr>
<tr id="A1.T9.4.11" class="ltx_tr">
<th id="A1.T9.4.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" rowspan="3"><span id="A1.T9.4.11.1.1" class="ltx_text ltx_font_typewriter">binary</span></th>
<td id="A1.T9.4.11.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top">
