<td id="S3.T3.4.1.24.2" class="ltx_td ltx_align_center ltx_border_bb">0.778</td>
<td id="S3.T3.4.1.24.3" class="ltx_td ltx_align_center ltx_border_bb">0.803</td>
<td id="S3.T3.4.1.24.4" class="ltx_td ltx_align_center ltx_border_bb">0.761</td>
<td id="S3.T3.4.1.24.5" class="ltx_td ltx_align_center ltx_border_bb">0.796</td>
