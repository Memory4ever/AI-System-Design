riter">shortcuts</span><span id="lstnumberx100.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx100.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">rather</span><span id="lstnumberx100.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx100.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">than</span><span id="lstnumberx100.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx100.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">solving</span><span id="lstnumberx100.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx100.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx100.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx100.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">problem</span><span id="lstnumberx100.33" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx101" class="ltx_listingline"><span id="lstnumberx101.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx101.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">UNCLEAR</span><span id="lstnumberx101.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx101.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Cannot</span><span id="lstnumberx101.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">confidently</span><span id="lstnumberx101.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">determine</span><span id="lstnumberx101.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">if</span><span id="lstnumberx101.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx101.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">response</span><span id="lstnumberx101.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx101.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">genuine</span><span id="lstnumberx101.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx101.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">hacking</span><span id="lstnumberx101.25" class="ltx_text ltx_font_typewriter">.</span>
