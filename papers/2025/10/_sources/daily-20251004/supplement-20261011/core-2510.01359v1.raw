<th id="S6.T3.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T3.2.1.2.2.1" class="ltx_text ltx_font_bold">Implicit (L2)</span></th></tr>
