<span id="A1.F15.pic2.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.F15.pic2.p1.pic1" class="ltx_picture" color="#000000" height="60.3" overflow="visible" version="1.1" viewBox="0 0 531.06 60.3" width="531.06"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,60.3) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#7DA8CB;" fill="#7DA8CB" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 55.67 C 0 58.23 2.07 60.3 4.63 60.3 L 526.43 60.3 C 528.98 60.3 531.06 58.23 531.06 55.67 L 531.06 4.63 C 531.06 2.07 528.98 0 526.43 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 55.67 C 0.69 57.85 2.45 59.61 4.63 59.61 L 526.43 59.61 C 528.6 59.61 530.36 57.85 530.36 55.67 L 530.36 4.63 C 530.36 2.45 528.6 0.69 526.43 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 7.4 10.09)"><foreignObject style="--ltx-fo-width:37.31em;--ltx-fo-height:3.09em;--ltx-fo-depth:0.19em;font-size:10pt;" height="45.51" overflow="visible" transform="matrix(1 0 0 -1 0 42.82)" width="516.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
