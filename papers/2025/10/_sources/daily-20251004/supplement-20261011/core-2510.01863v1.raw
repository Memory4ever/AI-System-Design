<tr id="S6.T3.1.4" class="ltx_tr">
<td id="S6.T3.1.4.1" class="ltx_td ltx_align_center">B</td>
<td id="S6.T3.1.4.2" class="ltx_td ltx_align_center">0.0036</td>
<td id="S6.T3.1.4.3" class="ltx_td ltx_align_center">0.09%</td></tr>
<tr id="S6.T3.1.5" class="ltx_tr">
<td id="S6.T3.1.5.1" class="ltx_td ltx_align_center">C</td>
<td id="S6.T3.1.5.2" class="ltx_td ltx_align_center">0.0187</td>
<td id="S6.T3.1.5.3" class="ltx_td ltx_align_center">0.48%</td></tr>
<tr id="S6.T3.1.6" class="ltx_tr">
<td id="S6.T3.1.6.1" class="ltx_td ltx_align_center">D</td>
<td id="S6.T3.1.6.2" class="ltx_td ltx_align_center">0.9948</td>
<td id="S6.T3.1.6.3" class="ltx_td ltx_align_center">25.66%</td></tr>
