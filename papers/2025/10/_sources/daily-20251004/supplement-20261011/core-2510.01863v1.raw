<th id="S6.T3.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Difference</th>
<th id="S6.T3.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">R. Difference</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T3.1.2" class="ltx_tr">
