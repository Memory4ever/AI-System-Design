pic1.2" class="ltx_text">Loss</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M 117.72 -15.01 h 179.68 v 21.66 h -179.68 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 121.87 -4.18)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 16.12)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.06)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-dasharray="3.0pt,2.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 C 0 0 8.53 0 11.81 0 C 15.09 0 23.62 0 23.62 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.73 0) translate(28.15,0) matrix(1.0 0.0 0.0 1.0 -25.39 -3.22)"><foreignObject style="--ltx-fo-width:3.67em;--ltx-fo-height:0.62em;--ltx-fo-depth:0em;font-size:10pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="50.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F5.pic1.3" class="ltx_text">truncate</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 81.04 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 C 0 0 8.53 0 11.81 0 C 15.09 0 23.62 0 23.62 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 105.77 0) translate(32.81,0) matrix(1.0 0.0 0.0 1.0 -30.04 -3.22)"><foreignObject style="--ltx-fo-width:4.34em;--ltx-fo-height:0.62em;--ltx-fo-depth:0em;font-size:10pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="60.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F5.pic1.4" class="ltx_text">to-nearest</span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 5: </span>Comparison of the loss function with two different rounding policies</figcaption>
</figure>
<div id="S5.SS2.p4" class="ltx_para">
<p id="S5.SS2.p4.1" class="ltx_p">We ran the learning program over one hundred iterations and compared the average error between using full-precision, C++23’s <span id="S5.SS2.p4.1.1" class="ltx_text ltx_font_typewriter">std::bfloat16_t</span> and Anyfloat’s bfloat16 with truncation and rounding-to-nearest. Figure <a href="#S5.F5" title="Fig. 5 ‣ V-B Rounding ‣ V Floating-point arithmetic ‣ Microscaling Floating Point Formatsfor Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> shows the loss function between the two rounding policies, while Table <a href="#S5.T1" title="TABLE I ‣ V-B Rounding ‣ V Floating-point arithmetic ‣ Microscaling Floating Point Formatsfor Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I</span></a> shows the relative differences of the two against the full-precision baseline.</p>
</div>
<figure id="S5.T1" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">TABLE I: </span>Difference in loss over 100 steps of training</figcaption>
<table id="S5.T1.1" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S5.T1.1.1" class="ltx_tr">
<th id="S5.T1.1.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_t"></th>
<th id="S5.T1.1.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S5.T1.1.1.2.1" class="ltx_text ltx_font_bold">baseline</span></th>
<th id="S5.T1.1.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S5.T1.1.1.3.1" class="ltx_text ltx_font_bold">std::bfloat16</span></th>
<th id="S5.T1.1.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S5.T1.1.1.4.1" class="ltx_text ltx_font_bold">truncation</span></th>
<th id="S5.T1.1.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S5.T1.1.1.5.1" class="ltx_text ltx_font_bold">to-nearest</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.1.2" class="ltx_tr">
<th id="S5.T1.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S5.T1.1.2.1.1" class="ltx_text ltx_font_bold">Average loss</span></th>
<td id="S5.T1.1.2.2" class="ltx_td ltx_align_right ltx_border_t">3.877</td>
<td id="S5.T1.1.2.3" class="ltx_td ltx_align_right ltx_border_t">3.9889</td>
<td id="S5.T1.1.2.4" class="ltx_td ltx_align_right ltx_border_t">4.3023</td>
<td id="S5.T1.1.2.5" class="ltx_td ltx_align_right ltx_border_t">3.9874</td></tr>
<tr id="S5.T1.1.3" class="ltx_tr">
<th id="S5.T1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T1.1.3.1.1" class="ltx_text ltx_font_bold">Difference</span></th>
<td id="S5.T1.1.3.2" class="ltx_td"></td>
<td id="S5.T1.1.3.3" class="ltx_td ltx_align_right">0.1120</td>
<td id="S5.T1.1.3.4" class="ltx_td ltx_align_right">0.4254</td>
<td id="S5.T1.1.3.5" class="ltx_td ltx_align_right">0.1105</td></tr>
<tr id="S5.T1.1.4" class="ltx_tr">
