{"data":{"id":"10.48550/arxiv.2510.01661","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01661","prefix":"10.48550","suffix":"arxiv.2510.01661","identifiers":[{"identifier":"2510.01661","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.01661"}],"creators":[{"name":"Shao, Yifei Simon","nameType":"Personal","givenName":"Yifei Simon","familyName":"Shao","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Yuchen","nameType":"Personal","givenName":"Yuchen","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Sunan","nameType":"Personal","givenName":"Sunan","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Chaudhari, Pratik","nameType":"Personal","givenName":"Pratik","familyName":"Chaudhari","affiliation":[],"nameIdentifiers":[]},{"name":"Kumar, Vijay","nameType":"Personal","givenName":"Vijay","familyName":"Kumar","affiliation":[],"nameIdentifiers":[]},{"name":"Figueroa, Nadia","nameType":"Personal","givenName":"Nadia","familyName":"Figueroa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Symskill: Symbol and Skill Co-Invention for Data-Efficient and Reactive Long-Horizon Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T04:41:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:24:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-11T03:01:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-12T00:22:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-08T10:32:48Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-09T01:38:18Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Multi-step manipulation in dynamic environments remains challenging. Imitation learning (IL) is reactive but lacks compositional generalization, since monolithic policies do not decide which skill to reuse when scenes change. Classical task-and-motion planning (TAMP) offers compositionality, but its high planning latency prevents real-time failure recovery. We introduce SymSkill, a unified framework that jointly learns predicates, operators, and skills from unlabeled, unsegmented demonstrations, combining compositional generalization with real-time recovery. Offline, SymSkill learns symbolic abstractions and goal-oriented skills directly from demonstrations. Online, given a conjunction of learned predicates, it uses a symbolic planner to compose and reorder skills to achieve symbolic goals while recovering from failures at both the motion and symbolic levels in real time. Coupled with a compliant controller, SymSkill supports safe execution under human and environmental disturbances. In RoboCasa simulation, SymSkill executes 12 single-step tasks with 85% success and composes them into multi-step plans without additional data. On a real Franka robot, it learns from 5 minutes of play data and performs 12-step tasks from goal specifications. Code and additional analysis are available at https://symskill.github.io/ .","descriptionType":"Abstract"},{"description":"ICRA 2026 Best Conference Paper Award; ICRA 2026 Best Paper Award on Planning and Control; CoRL 2025 Best Paper Award on Learning Effective Abstractions for Planning (LEAP) Workshop (https://symskill.github.io/)","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.01661","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:44.000Z","registered":"2025-10-03T01:54:45.000Z","published":"2025","updated":"2026-06-09T04:12:57.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.01661","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}