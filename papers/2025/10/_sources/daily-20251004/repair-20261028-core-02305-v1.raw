<td id="S2.F2.3.1.1.1.2.1" class="ltx_td ltx_align_left ltx_align_middle">
<span id="S2.F2.3.1.1.1.2.1.1" class="ltx_inline-block ltx_align_middle" style="width:29.3pt;">
<span id="S2.F2.3.1.1.1.2.1.1.1" class="ltx_p"><span id="S2.F2.3.1.1.1.2.1.1.1.1" class="ltx_text" style="font-size:80%;">Score smoothing</span></span>
</span></td>
<td id="S2.F2.3.1.1.1.2.2" class="ltx_td ltx_align_center"><span id="S2.F2.3.1.1.1.2.2.1" class="ltx_text" style="position:relative; bottom:-12.3pt;">
<span id="S2.F2.3.1.1.1.2.2.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:130.8pt;height:33.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
