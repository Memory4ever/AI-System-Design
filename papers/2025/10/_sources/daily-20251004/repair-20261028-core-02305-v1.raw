<figure id="S5.F10.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.02305v1/mnist_L2_4s.svg" id="S5.F10.sf1.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:229/224;" width="229" height="224"></object>
