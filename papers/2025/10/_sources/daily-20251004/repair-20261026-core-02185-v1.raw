</div>
<div id="lstnumberx17" class="ltx_listingline"><span id="lstnumberx17.1" class="ltx_text ltx_lst_identifier">std</span>::<span id="lstnumberx17.2" class="ltx_text ltx_lst_identifier">vector</span>&lt;<span id="lstnumberx17.3" class="ltx_text ltx_lst_identifier">uint8_t</span>&gt;<span id="lstnumberx17.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.5" class="ltx_text ltx_lst_identifier">crx_image_buf</span><span id="lstnumberx17.6" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx17.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.8" class="ltx_text ltx_lst_identifier">provider</span>.<span id="lstnumberx17.9" class="ltx_text ltx_lst_identifier">ConsumeBytes</span>&lt;<span id="lstnumberx17.10" class="ltx_text ltx_lst_identifier">uint8_t</span>&gt;(<span id="lstnumberx17.11" class="ltx_text ltx_lst_identifier">crx_image_size</span>);
