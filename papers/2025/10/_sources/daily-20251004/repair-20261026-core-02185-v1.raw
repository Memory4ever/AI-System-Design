<th id="S5.T8.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Tools</th>
<th id="S5.T8.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Output</th>
<th id="S5.T8.4.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Total</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T8.4.2" class="ltx_tr">
<th id="S5.T8.4.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Function Analyzer</th>
<td id="S5.T8.4.2.2" class="ltx_td ltx_align_center ltx_border_t">$0.004</td>
<td id="S5.T8.4.2.3" class="ltx_td ltx_align_center ltx_border_t">$0.016</td>
<td id="S5.T8.4.2.4" class="ltx_td ltx_align_center ltx_border_t">$0.004</td>
<td id="S5.T8.4.2.5" class="ltx_td ltx_align_center ltx_border_t">$0.024</td></tr>
<tr id="S5.T8.4.3" class="ltx_tr">
<th id="S5.T8.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Context Analyzer</th>
<td id="S5.T8.4.3.2" class="ltx_td ltx_align_center">$0.022</td>
<td id="S5.T8.4.3.3" class="ltx_td ltx_align_center">$0.023</td>
<td id="S5.T8.4.3.4" class="ltx_td ltx_align_center">$0.012</td>
<td id="S5.T8.4.3.5" class="ltx_td ltx_align_center">$0.056</td></tr>
<tr id="S5.T8.4.4" class="ltx_tr">
<th id="S5.T8.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Existing agents</th>
<td id="S5.T8.4.4.2" class="ltx_td ltx_align_center">$0.055</td>
<td id="S5.T8.4.4.3" class="ltx_td ltx_align_center">$0.685</td>
<td id="S5.T8.4.4.4" class="ltx_td ltx_align_center">$0.119</td>
<td id="S5.T8.4.4.5" class="ltx_td ltx_align_center">$0.859</td></tr>
<tr id="S5.T8.4.5" class="ltx_tr">
<th id="S5.T8.4.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Cost (per driver)</th>
<td id="S5.T8.4.5.2" class="ltx_td ltx_align_center ltx_border_t">$0.081</td>
<td id="S5.T8.4.5.3" class="ltx_td ltx_align_center ltx_border_t">$0.723</td>
<td id="S5.T8.4.5.4" class="ltx_td ltx_align_center ltx_border_t">$0.135</td>
<td id="S5.T8.4.5.5" class="ltx_td ltx_align_center ltx_border_t">$0.939</td></tr>
