<th id="S5.T8.4.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t">Cost (per project)</th>
<td id="S5.T8.4.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">$3.75</td>
<td id="S5.T8.4.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">$33.49</td>
