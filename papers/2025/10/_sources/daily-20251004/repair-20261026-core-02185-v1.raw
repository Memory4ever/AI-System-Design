</div>
<div id="lstnumberx19" class="ltx_listingline"><span id="lstnumberx19.1" class="ltx_text ltx_lst_identifier">RawProcessor</span>.<span id="lstnumberx19.2" class="ltx_text ltx_lst_identifier">crxDecodePlane</span>(<span id="lstnumberx19.3" class="ltx_text ltx_lst_identifier">crx_image_buf</span>.<span id="lstnumberx19.4" class="ltx_text ltx_lst_identifier">data</span>(),<span id="lstnumberx19.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx19.6" class="ltx_text ltx_lst_identifier">planeNumber</span>);
