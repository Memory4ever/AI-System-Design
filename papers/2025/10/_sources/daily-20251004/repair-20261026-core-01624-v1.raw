<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Longest Examples</h3>

<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.1" class="ltx_p">A sample Longest Examples from AceReasoner1.1-SFT Dataset <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib23" title="" class="ltx_ref">Liu et al., 2025b</a>)</cite> <span id="A4.SS2.p1.1.1" class="ltx_text ltx_font_bold">(<math id="A4.SS2.p1.m1" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>8k tokens)</span>:</p>
</div>
<div id="A4.SS2.p2" class="ltx_para">
<p id="A4.SS2.p2.1" class="ltx_p"><math id="A4.SS2.p2.m1" class="ltx_Math" alttext="[" display="inline" intent=":literal"><semantics><mo stretchy="false">[</mo><annotation encoding="application/x-tex">[</annotation></semantics></math><span id="A4.SS2.p2.1.1" class="ltx_text ltx_font_bold">Input<math id="A4.SS2.p2.m2" class="ltx_Math" alttext="]" display="inline" intent=":literal"><semantics><mo stretchy="false">]</mo><annotation encoding="application/x-tex">]</annotation></semantics></math></span>:</p>
<div id="A4.SS2.p2.2" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx6" class="ltx_listingline"><span id="lstnumberx6.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx6.2" class="ltx_text ltx_lst_identifier">For</span><span id="lstnumberx6.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.4" class="ltx_text ltx_lst_identifier">sets</span><span id="lstnumberx6.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.6" class="ltx_text ltx_lst_identifier">$A$</span>,<span id="lstnumberx6.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.8" class="ltx_text ltx_lst_identifier">$B$</span>,<span id="lstnumberx6.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.10" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx6.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.12" class="ltx_text ltx_lst_identifier">$C$</span>,<span id="lstnumberx6.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.14" class="ltx_text ltx_lst_identifier">where</span><span id="lstnumberx6.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.16" class="ltx_text ltx_lst_identifier">$n</span>(<span id="lstnumberx6.17" class="ltx_text ltx_lst_identifier">A</span>)<span id="lstnumberx6.18" class="ltx_text ltx_lst_identifier">$</span>,<span id="lstnumberx6.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.20" class="ltx_text ltx_lst_identifier">$n</span>(<span id="lstnumberx6.21" class="ltx_text ltx_lst_identifier">B</span>)<span id="lstnumberx6.22" class="ltx_text ltx_lst_identifier">$</span>,<span id="lstnumberx6.23" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.24" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx6.25" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.26" class="ltx_text ltx_lst_identifier">$n</span>(<span id="lstnumberx6.27" class="ltx_text ltx_lst_identifier">C</span>)<span id="lstnumberx6.28" class="ltx_text ltx_lst_identifier">$</span><span id="lstnumberx6.29" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.30" class="ltx_text ltx_lst_identifier">denote</span><span id="lstnumberx6.31" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.32" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx6.33" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.34" class="ltx_text ltx_lst_identifier">number</span><span id="lstnumberx6.35" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.36" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx6.37" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.38" class="ltx_text ltx_lst_identifier">subsets</span><span id="lstnumberx6.39" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.40" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx6.41" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.42" class="ltx_text ltx_lst_identifier">$A$</span>,<span id="lstnumberx6.43" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.44" class="ltx_text ltx_lst_identifier">$B$</span>,<span id="lstnumberx6.45" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.46" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx6.47" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.48" class="ltx_text ltx_lst_identifier">$C$</span><span id="lstnumberx6.49" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.50" class="ltx_text ltx_lst_identifier">respectively</span>,<span id="lstnumberx6.51" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.52" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx6.53" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.54" class="ltx_text ltx_lst_identifier">$</span>\<span id="lstnumberx6.55" class="ltx_text ltx_lst_identifier">left</span><span id="lstnumberx6.56" class="ltx_text ltx_lst_space"> </span>|<span id="lstnumberx6.57" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.58" class="ltx_text ltx_lst_identifier">A</span><span id="lstnumberx6.59" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx6.60" class="ltx_text ltx_lst_identifier">right</span><span id="lstnumberx6.61" class="ltx_text ltx_lst_space"> </span>|<span id="lstnumberx6.62" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx6.63" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx6.64" class="ltx_text ltx_lst_identifier">left</span><span id="lstnumberx6.65" class="ltx_text ltx_lst_space"> </span>|<span id="lstnumberx6.66" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.67" class="ltx_text ltx_lst_identifier">B</span><span id="lstnumberx6.68" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx6.69" class="ltx_text ltx_lst_identifier">right</span><span id="lstnumberx6.70" class="ltx_text ltx_lst_space"> </span>|<span id="lstnumberx6.71" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx6.72" class="ltx_text ltx_lst_space"> </span>100<span id="lstnumberx6.73" class="ltx_text ltx_lst_identifier">$</span>,<span id="lstnumberx6.74" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.75" class="ltx_text ltx_lst_identifier">if</span><span id="lstnumberx6.76" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.77" class="ltx_text ltx_lst_identifier">$n</span>(<span id="lstnumberx6.78" class="ltx_text ltx_lst_identifier">A</span>)<span id="lstnumberx6.79" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx6.80" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.81" class="ltx_text ltx_lst_identifier">n</span>(<span id="lstnumberx6.82" class="ltx_text ltx_lst_identifier">B</span>)<span id="lstnumberx6.83" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx6.84" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx6.85" class="ltx_text ltx_lst_identifier">n</span>(<span id="lstnumberx6.86" class="ltx_text ltx_lst_identifier">C</span>)<span id="lstnumberx6.87" class="lt