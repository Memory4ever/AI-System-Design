umberx5.944" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx5.945" class="ltx_text ltx_lst_space"> </span>36<span id="lstnumberx5.946" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx5.947" class="ltx_text ltx_lst_identifier">m</span><span id="lstnumberx5.948" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx5.949" class="ltx_text ltx_lst_identifier">bridge</span>,<span id="lstnumberx5.950" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx5.951" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx5.952" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx5.953" class="ltx_text ltx_lst_identifier">total</span><span id="lstnumberx5.954" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx5.955" class="ltx_text ltx_lst_identifier">distance</span><span id="lstnumberx5.956" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx5.957" class="ltx_text ltx_lst_identifier">needed</span><span id="lstnumberx5.958" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx5.959" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx5.960" class="ltx_text ltx_lst_space"> </span>\(<span id="lstnumberx5.961" class="ltx_text ltx_lst_space"> </span>36<span id="lstnumberx5.962" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx5.963" class="ltx_text ltx_lst_identifier">text</span>{<span id="lstnumberx5.964" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx5.965" class="ltx_text ltx_lst_identifier">m</span>}<span id="lstnumberx5.966" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx5.967" class="ltx_text ltx_lst_space"> </span>18<span id="lstnumberx5.968" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx5.969" class="ltx_text ltx_lst_identifier">text</span>{<span id="lstnumberx5.970" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx5.971" class="ltx_text ltx_lst_identifier">m</span>}<span id="lstnumberx5.972" class="ltx_text ltx_lst_space"> <