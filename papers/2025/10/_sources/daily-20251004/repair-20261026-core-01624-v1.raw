space"> </span><span id="lstnumberx3.486" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx3.487" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.488" class="ltx_text ltx_lst_identifier">southern</span><span id="lstnumberx3.489" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.490" class="ltx_text ltx_lst_identifier">hemisphere</span>?<span id="lstnumberx3.491" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.492" class="ltx_text ltx_lst_identifier">But</span><span id="lstnumberx3.493" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.494" class="ltx_text ltx_lst_identifier">that</span>’<span id="lstnumberx3.495" class="ltx_text ltx_lst_identifier">s</span><span id="lstnumberx3.496" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.497" class="ltx_text ltx_lst_identifier">overcomplicating</span>.<span id="lstnumberx3.498" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.499" class="ltx_text ltx_lst_identifier">The</span><span id="lstnumberx3.500" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.501" class="ltx_text ltx_lst_identifier">problem</span><span id="lstnumberx3.502" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.503" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx3.504" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.505" class="ltx_text ltx_lst_identifier">likely</span><span id="lstnumberx3.506" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.507" class="ltx_text ltx_lst_identifier">testing</span><span id="lstnumberx3.508" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.509" class="ltx_text ltx_lst_identifier">understanding</span><span id="lstnumberx3.510" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.511" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx3.512" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.513" class="ltx_text ltx_lst_identifier">independent</span><span id="lstnumberx3.514" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.515" class="ltx_text ltx_lst_identifier">events</span>.<span id="lstnumberx3.516" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.517" class="ltx_text ltx_lst_identifier">So</span><span id="lstnumberx3.518" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.519" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx3.520" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.521" class="ltx_text ltx_lst_identifier">answer</span><span id="lstnumberx3.522" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.523" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx3.524" class="ltx_text ltx_lst_space"> </span>1/20.<span id="lstnumberx3.525" class="ltx_text ltx_lst_space"> </span>&lt;/<span id="lstnumberx3.526" class="ltx_text ltx_lst_identifier">think</span>&gt;<span id="lstnumberx3.527" class="ltx_text ltx_lst_space">  </span>\<span id="lstnumberx3.528" class="ltx_text ltx_lst_identifier">boxed</span>{\<span id="lstnumberx3.529" class="ltx_text ltx_lst_identifier">dfrac</span>{1}{20}}
