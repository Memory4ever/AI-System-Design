" mathsize="0.800em">γ</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em" stretchy="true">‖</mo><mrow><mrow><msup><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">G</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">(</mo><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">𝐲</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">−</mo><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">𝐒𝐱</mi></mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">2</mn><mn style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathbf{x}}^{(i)}_{0}\leftarrow\arg\min_{\mathbf{x}}\;\|\mathbf{y}-\mathbf{H}\mathbf{x}\|_{2}^{2}+\rho_{i}\|\mathbf{x}-\tilde{\mathbf{x}}^{(i)}_{0}\|_{2}^{2}\;{\color[rgb]{0.4,0.4,1}+\;\gamma\,\|\mathrm{G}^{*}(\mathbf{y})-\mathbf{S}\mathbf{x}\|_{2}^{2}}</annotation></semantics></math><span id="alg9.l7.4" class="ltx_text" style="font-size:80%;">
