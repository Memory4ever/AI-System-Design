<td id="A1.T9.2.1.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T9.m13" class="ltx_Math" alttext="2.62\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>2.62</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2.62\times 10^{-4}</annotation></semantics></math></td>
<td id="A1.T9.2.1.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T9.m14" class="ltx_Math" alttext="1.67\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1.67</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.67\times 10^{-4}</annotation></semantics></math></td>
<td id="A1.T9.2.1.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T9.m15" class="ltx_Math" alttext="8.95\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>8.95</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">8.95\times 10^{-5}</annotation></semantics></math></td>
<td id="A1.T9.2.1.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T9.m16" class="ltx_Math" alttext="\mathbf{4.01\times 10^{-5}}" display="inline" intent=":literal"><semantics><mrow><mn class="ltx_mathvariant_bold" mathvariant="bold">4.01</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>𝟏𝟎</mn><mrow><mo>−</mo><mn>𝟓</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{4.01\times 10^{-5}}</annotation></semantics></math></td>
<td id="A1.T9.2.1.4.6" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T9.m17" class="ltx_Math" alttext="\underline{4.52\times 10^{-5}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mn>4.52</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{4.52\times 10^{-5}}</annotation></semantics></math></td></tr>
