            <span id="alg2.l7.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg2.l7.m1" class="ltx_Math" alttext="t=\frac{1+\sqrt{1+4(t^{\prime})^{2}}}{2}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">=</mo><mfrac><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">+</mo><msqrt><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">+</mo><mrow><mn mathsize="0.800em">4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msup><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">′</mo></msup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mn mathsize="0.800em">2</mn></msup></mrow></mrow></msqrt></mrow><mn mathsize="0.800em">2</mn></mfrac></mrow><annotation encoding="application/x-tex">t=\frac{1+\sqrt{1+4(t^{\prime})^{2}}}{2}</annotation></semantics></math><span id="alg2.l7.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
