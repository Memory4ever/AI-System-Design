            <span id="alg3.l3.3" class="ltx_text ltx_font_bold" style="font-size:80%;">for</span><span id="alg3.l3.4" class="ltx_text" style="font-size:80%;"> </span><math id="alg3.l3.m1" class="ltx_Math" alttext="\ell=1,\dots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">1</mn></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em" mathvariant="normal">…</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">L</mi></mrow><annotation encoding="application/x-tex">\ell=1,\dots,L</annotation></semantics></math><span id="alg3.l3.5" class="ltx_text" style="font-size:80%;"> </span><span id="alg3.l3.6" class="ltx_text ltx_font_bold" style="font-size:80%;">do</span><span id="alg3.l3.7" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg3.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg3.l4.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg3.l4.m1" class="ltx_Math" alttext="\mathbf{x}^{\ell}\leftarrow\mathbf{z}^{\ell}-\alpha\left(\mathbf{H}^{\top}(\mathbf{Hz}^{\ell}-\mathbf{y})+{\color[rgb]{0.4,0.4,1}\gamma\mathbf{S}^{\top}(\mathbf{Sz}^{\ell}-\mathrm{G}^{*}(\mathbf{y}))}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em" stretchy="false">←</mo><mrow><msup><mi mathsize="0.800em">𝐳</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">−</mo><mrow><mi mathsize="0.800em">α</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mi mathsize="0.800em">𝐇</mi><mo mathsize="0.800em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><msup><mi mathsize="0.800em">𝐇𝐳</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">−</mo><mi mathsize="0.800em">𝐲</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo mathsize="0.800em">+</mo><mrow><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">𝐒</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">(</mo><mrow><msup><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">𝐒𝐳</mi><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">−</mo><mrow><msup><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">G</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">(</mo><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">𝐲</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}^{\ell}\leftarrow\mathbf{z}^{\ell}-\alpha\left(\mathbf{H}^{\top}(\mathbf{Hz}^{\ell}-\mathbf{y})+{\color[rgb]{0.4,0.4,1}\gamma\mathbf{S}^{\top}(\mathbf{Sz}^{\ell}-\mathrm{G}^{*}(\mathbf{y}))}\right)</annotation></semantics></math><span id="alg3.l4.4" class="ltx_text" style="font-size:80%;">
</span>
