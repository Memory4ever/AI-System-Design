            <math id="alg2.l2.m1" class="ltx_Math" alttext="\mathbf{x}^{0}=\mathbf{z}^{1}=\mathbf{0},\;t=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathsize="0.800em">𝐱</mi><mn mathsize="0.800em">0</mn></msup><mo mathsize="0.800em">=</mo><msup><mi mathsize="0.800em">𝐳</mi><mn mathsize="0.800em">1</mn></msup><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">𝟎</mn></mrow><mo mathsize="0.800em" rspace="0.447em">,</mo><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">1</mn></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}^{0}=\mathbf{z}^{1}=\mathbf{0},\;t=1</annotation></semantics></math><span id="alg2.l2.3" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg2.l3.3" class="ltx_text ltx_font_bold" style="font-size:80%;">for</span><span id="alg2.l3.4" class="ltx_text" style="font-size:80%;"> </span><math id="alg2.l3.m1" class="ltx_Math" alttext="\ell=1,\dots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">1</mn></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em" mathvariant="normal">…</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">L</mi></mrow><annotation encoding="application/x-tex">\ell=1,\dots,L</annotation></semantics></math><span id="alg2.l3.5" class="ltx_text" style="font-size:80%;"> </span><span id="alg2.l3.6" class="ltx_text ltx_font_bold" style="font-size:80%;">do</span><span id="alg2.l3.7" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg2.l4.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg2.l4.m1" class="ltx_Math" alttext="\mathbf{x}^{\ell}\leftarrow\mathbf{z}^{\ell}-\alpha\mathbf{H}^{\top}(\mathbf{Hz}^{\ell}-\mathbf{y})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em" stretchy="false">←</mo><mrow><msup><mi mathsize="0.800em">𝐳</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">−</mo><mrow><mi mathsize="0.800em">α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">𝐇</mi><mo mathsize="0.800em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><msup><mi mathsize="0.800em">𝐇𝐳</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">−</mo><mi mathsize="0.800em">𝐲</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}^{\ell}\leftarrow\mathbf{z}^{\ell}-\alpha\mathbf{H}^{\top}(\mathbf{Hz}^{\ell}-\mathbf{y})</annotation></semantics></math><span id="alg2.l4.4" class="ltx_text" style="font-size:80%;">
