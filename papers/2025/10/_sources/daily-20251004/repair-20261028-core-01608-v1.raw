            <span id="alg2.l6.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg2.l6.m1" class="ltx_Math" alttext="t^{\prime}=t" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">=</mo><mi mathsize="0.800em">t</mi></mrow><annotation encoding="application/x-tex">t^{\prime}=t</annotation></semantics></math><span id="alg2.l6.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
