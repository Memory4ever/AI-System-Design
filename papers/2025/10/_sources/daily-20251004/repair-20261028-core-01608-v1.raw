frac><mo lspace="0.280em" rspace="0em">​</mo><msub><mover accent="true"><mi mathsize="0.800em">𝐱</mi><mo>^</mo></mover><mn mathsize="0.800em">0</mn></msub></mrow><mo mathsize="0.800em">+</mo><mrow><msub><mover accent="true"><mi mathsize="0.800em">σ</mi><mo>~</mo></mover><mi mathsize="0.800em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">𝐳</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}^{\prime}_{i-1}\leftarrow\frac{\sqrt{\alpha_{i}(1-\bar{\alpha}_{i-1})}}{1-\bar{\alpha}_{i}}\;\mathbf{x}_{i}+\frac{\sqrt{\bar{\alpha}_{i-1}}\beta_{i}}{1-\bar{\alpha}_{i}}\;\hat{\mathbf{x}}_{0}+\tilde{\sigma}_{i}\,\mathbf{z}</annotation></semantics></math><span id="alg7.l7.4" class="ltx_text" style="font-size:80%;">
