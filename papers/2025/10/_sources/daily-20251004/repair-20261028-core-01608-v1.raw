            <span id="alg2.l8.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg2.l8.m1" class="ltx_Math" alttext="\mathbf{z}^{\ell+1}\leftarrow\mathbf{x}^{\ell}+\frac{t^{\prime}-1}{t}(\mathbf{x}^{\ell}-\mathbf{x}^{\ell-1})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.800em">𝐳</mi><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">1</mn></mrow></msup><mo mathsize="0.800em" stretchy="false">←</mo><mrow><msup><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">+</mo><mrow><mfrac><mrow><msup><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow><mi mathsize="0.800em">t</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><msup><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">−</mo><msup><mi mathsize="0.800em">𝐱</mi><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow></msup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}^{\ell+1}\leftarrow\mathbf{x}^{\ell}+\frac{t^{\prime}-1}{t}(\mathbf{x}^{\ell}-\mathbf{x}^{\ell-1})</annotation></semantics></math><span id="alg2.l8.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
