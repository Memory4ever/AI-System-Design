</div>
<div id="alg5.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg5.l4.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg5.l4.m1" class="ltx_Math" alttext="\mathbf{x}^{\ell}\leftarrow\mathbf{z}^{\ell}-\alpha\left(\mathbf{H}^{\top}(\mathbf{Hz}^{\ell}-\mathbf{y})+{\color[rgb]{0.4,0.4,1}\gamma\mathbf{S}^{\top}(\mathbf{Sz}^{\ell}-\mathrm{G}^{*}(\mathbf{y}))}\right)-\lambda(\mathbf{z}^{\ell}-\mathrm{D}_{\sigma}(\mathbf{z}^{\ell}))" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em" stretchy="false">←</mo><mrow><msup><mi mathsize="0.800em">𝐳</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">−</mo><mrow><mi mathsize="0.800em">α</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mi mathsize="0.800em">𝐇</mi><mo mathsize="0.800em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><msup><mi mathsize="0.800em">𝐇𝐳</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">−</mo><mi mathsize="0.800em">𝐲</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo mathsize="0.800em">+</mo><mrow><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">𝐒</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">(</mo><mrow><msup><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">𝐒𝐳</mi><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">−</mo><mrow><msup><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">G</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">(</mo><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" mathsize="0.800em">𝐲</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo mathsize="0.800em">−</mo><mrow><mi mathsize="0.800em">λ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><msup><mi mathsize="0.800em">𝐳</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">−</mo><mrow><msub><mi mathsize="0.800em">D</mi><mi mathsize="0.800em">σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msup><mi mathsize="0.800em">𝐳</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}^{\ell}\leftarrow\mathbf{z}^{\ell}-\alpha\left(\mathbf{H}^{\top}(\mathbf{Hz}^{\ell}-\mathbf{y})+{\color[rgb]{0.4,0.4,1}\gamma\mathbf{S}^{\top}(\mathbf{Sz}^{\ell}-\mathrm{G}^{*}(\mathbf{y}))}\right)-\lambda(\mathbf{z}^{\ell}-\mathrm{D}_{\sigma}(\mathbf{z}^{\ell}))</annotation></semantics></math><span id="alg5.l4.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg5.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            <span id="alg5.l5.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg5.l5.m1" class="ltx_Math" alttext="t^{\prime}=t" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">=</mo><mi mathsize="0.800em">t</mi></mrow><annotation encoding="application/x-tex">t^{\prime}=t</annotation></semantics></math><span id="alg5.l5.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg5.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <span id="alg5.l6.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg5.l6.m1" class="ltx_Math" alttext="t=\frac{1+\sqrt{1+4(t^{\prime})^{2}}}{2}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">=</mo><mfrac><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">+</mo><msqrt><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">+</mo><mrow><mn mathsize="0.800em">4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msup><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">′</mo></msup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mn mathsize="0.800em">2</mn></msup></mrow></mrow></msqrt></mrow><mn mathsize="0.800em">2</mn></mfrac></mrow><annotation encoding="application/x-tex">t=\frac{1+\sqrt{1+4(t^{\prime})^{2}}}{2}</annotation></semantics></math><span id="alg5.l6.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg5.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <span id="alg5.l7.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg5.l7.m1" class="ltx_Math" alttext="\mathbf{z}^{\ell+1}\leftarrow\mathbf{x}^{\ell}+\frac{t^{\prime}-1}{t}(\mathbf{x}^{\ell}-\mathbf{x}^{\ell-1})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.800em">𝐳</mi><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">1</mn></mrow></msup><mo mathsize="0.800em" stretchy="false">←</mo><mrow><msup><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">+</mo><mrow><mfrac><mrow><msup><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow><mi mathsize="0.800em">t</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><msup><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><mo mathsize="0.800em">−</mo><msup><mi mathsize="0.800em">𝐱</mi><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow></msup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}^{\ell+1}\leftarrow\mathbf{x}^{\ell}+\frac{t^{\prime}-1}{t}(\mathbf{x}^{\ell}-\mathbf{x}^{\ell-1})</annotation></semantics></math><span id="alg5.l7.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg5.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <span id="alg5.l8.3" class="ltx_text ltx_font_bold" style="font-size:80%;">end</span><span id="alg5.l8.4" class="ltx_text" style="font-size:80%;"> </span><span id="alg5.l8.5" class="ltx_text ltx_font_bold" style="font-size:80%;">for</span>
</div>
<div id="alg5.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            <span id="alg5.l9.3" class="ltx_text ltx_font_bold" style="font-size:80%;">return</span><span id="alg5.l9.4" class="ltx_text" style="font-size:80%;"> </span><math id="alg5.l9.m1" class="ltx_Math" alttext="\mathbf{x}^{\ell}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em" mathvariant="normal">ℓ</mi></msup><annotation encoding="application/x-tex">\mathbf{x}^{\ell}</annotation></semantics></math><span id="alg5.l9.5" class="ltx_text" style="font-size:80%;">
</span>
</div>
</div>
</figure>
</section>
<section id="A1.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.7 </span>Deep Image Prior</h3>

<div id="A1.SS7.p1" class="ltx_para">
<p id="A1.SS7.p1.1" class="ltx_p">Deep Image Prior (DIP) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib54" title="" class="ltx_ref">54</a>]</cite> is an unsupervised reconstruction framework that leverages untrained neural networks to reconstruct the underlying signal. This approach, since it only compares with the measurements <math id="A1.SS7.p1.m1" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math>, its solution may overfit to the noise of the measurements. Therefore, the use of the NPN provides a suitable approach to improve image consistency reconstructions. The optimization problem with the proposed NPN regularization is</p>
</div>
<div id="A1.SS7.p2" class="ltx_para">
<table id="A1.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E15.m1" class="ltx_Math" alttext="\mathrm{K}^{*}=\argmin_{\mathrm{K}}\|\mathbf{y}-\mathbf{H}\mathrm{K}(\mathbf{z})\|_{2}^{2}+{\color[rgb]{0.4,0.4,1}\gamma\|\mathrm{G}^{*}(\mathbf{y})-\mathbf{S}\mathrm{K}(\mathbf{z})\|_{2}^{2}},\quad\hat{\mathbf{x}}=\mathrm{K}^{*}(\mathbf{z}),\quad\mathbf{z}\sim\mathcal{N}(0,1)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>K</mi><mo>∗</mo></msup><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>K</mi></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐲</mi><mo>−</mo><mrow><mi>𝐇</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" stretchy="false">‖</mo><mrow><mrow><msup><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">G</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">𝐲</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">−</mo><mrow><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">𝐒</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">𝐳</mi><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">2</mn><mn style="--ltx-fg-color:#6666FF;" mathcolor="#6666FF">2</mn></msubsup></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mo>=</mo><mrow><msup><mi>K</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝐳</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{K}^{*}=\argmin_{\mathrm{K}}\|\mathbf{y}-\mathbf{H}\mathrm{K}(\mathbf{z})\|_{2}^{2}+{\color[rgb]{0.4,0.4,1}\gamma\|\mathrm{G}^{*}(\mathbf{y})-\mathbf{S}\mathrm{K}(\mathbf{z})\|_{2}^{2}},\quad\hat{\mathbf{x}}=\mathrm{K}^{*}(\mathbf{z}),\quad\mathbf{z}\sim\mathcal{N}(0,1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A1.SS7.p2.1" class="ltx_p">where <math id="A1.SS7.p2.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is a regularization parameter.</p>
</div>
</section>
<section id="A1.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.8 </span>Diffusion-based Solvers</h3>

<div id="A1.SS8.p1" class="ltx_para">
<p id="A1.SS8.p1.1" class="ltx_p">Diffusion models (DMs) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">47</a>, <a href="#bib.bib22" title="" class="ltx_ref">22</a>, <a href="#bib.bib49" title="" class="ltx_ref">49</a>, <a href="#bib.bib50" title="" class="ltx_ref">50</a>]</cite> have recently gained attention due to their exceptional capability in modeling complex image distributions via an iterative noising-denoising process. Conditioning DMs entails guiding their generative reverse diffusion process using measured data to ensure reconstructions align with the measurements. We have integrated our proposed regularization term into two widely adopted diffusion-model frameworks, Diffusion Posterior Sampling (DPS) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">12</a>]</cite> and DiffPIR <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib65" title="" class="ltx_ref">65</a>]</cite>. These frameworks serve as canonical diffusion pipelines upon which newer methods build. Our regularization could likewise be incorporated into other approaches, such as latent-space diffusion models <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">15</a>, <a href="#bib.bib48" title="" class="ltx_ref">48</a>]</cite>.</p>
</div>
<div id="A1.SS8.p2" class="ltx_para">
<p id="A1.SS8.p2.1" class="ltx_p"><span id="A1.SS8.p2.1.1" class="ltx_text ltx_font_bold">DPS <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">12</a>]</cite>:</span> we denote <math id="A1.SS8.p2.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is the number of reverse diffusion steps, and <math id="A1.SS8.p2.m2" class="ltx_Math" alttext="i\in{0,\dots,N-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i\in{0,\dots,N-1}</annotation></semantics></math> is the reverse-time index; <math id="A1.SS8.p2.m3" class="ltx_Math" alttext="\mathbf{x}_{i}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>i</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{i}\in\mathbb{R}^{n}</annotation></semantics></math> is the current latent state and <math id="A1.SS8.p2.m4" class="ltx_Math" alttext="\mathbf{x}_{N}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>N</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{N}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math> is the Gaussian start; <math id="A1.SS8.p2.m5" class="ltx_Math" alttext="\hat{\mathbf{s}}=\mathbf{s}_{\theta}(\mathbf{x}_{i},i)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐬</mi><mo>^</mo></mover><mo>=</mo><mrow><msub><mi>𝐬</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathbf{s}}=\mathbf{s}_{\theta}(\mathbf{x}_{i},i)</annotation></semantics></math> is the score/noise estimate produced by the network with parameters <math id="A1.SS8.p2.m6" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>; <math id="A1.SS8.p2.m7" class="ltx_Math" alttext="\hat{\mathbf{x}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\hat{\mathbf{x}}_{0}</annotation></semantics></math> is the network’s prediction of the clean sample at step <math id="A1.SS8.p2.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>; <math id="A1.SS8.p2.m9" class="ltx_Math" alttext="\alpha_{i}\in(0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>i</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{i}\in(0,1]</annotation></semantics></math> is the per-step retention factor, <math id="A1.SS8.p2.m10" class="ltx_Math" alttext="\beta_{i}=1-\alpha_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>i</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\beta_{i}=1-\alpha_{i}</annotation></semantics></math> is the noise increment, and <math id="A1.SS8.p2.m11" class="ltx_Math" alttext="\bar{\alpha}_{i}=\prod_{j=1}^{i}\alpha_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><msub><mi>α</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\bar{\alpha}_{i}=\prod_{j=1}^{i}\alpha_{j}</annotation></semantics></math> is the cumulative product (with <math id="A1.SS8.p2.m12" class="ltx_Math" alttext="\bar{\alpha}_{0}=1" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mn>0</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\bar{\alpha}_{0}=1</annotation></semantics></math>); <math id="A1.SS8.p2.m13" class="ltx_Math" alttext="\zeta_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\zeta_{i}&gt;0</annotation></semantics></math> is the data-consistency step size and <math id="A1.SS8.p2.m14" class="ltx_Math" alttext="\tilde{\sigma}_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{\sigma}_{i}\geq 0</annotation></semantics></math> is the sampling noise scale at step <math id="A1.SS8.p2.m15" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>; <math id="A1.SS8.p2.m16" class="ltx_Math" alttext="\mathbf{z}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math> is i.i.d. Gaussian noise; <math id="A1.SS8.p2.m17" class="ltx_Math" alttext="\mathbf{x}^{\prime i-1}" display="inline" intent=":literal"><semantics><msup><mi>𝐱</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><annotation encoding="application/x-tex">\mathbf{x}^{\prime i-1}</annotation></semantics></math> denotes the pre–data-consistency iterate before applying the gradient correction; <math id="A1.SS8.p2.m18" class="ltx_math_unparsed" alttext="\nabla{\mathbf{x}_{i}}\lVert\mathbf{y}-\mathbf{H}\hat{\mathbf{x}}_{0}\rVert_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><msub><mi>𝐱</mi><mi>i</mi></msub><msubsup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝐲</mi><mo>−</mo><mi>𝐇</mi><msub><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mn>0</mn></msub><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\nabla{\mathbf{x}_{i}}\lVert\mathbf{y}-\mathbf{H}\hat{\mathbf{x}}_{0}\rVert_{2}^{2}</annotation></semantics></math> is the gradient of the quadratic data-fidelity term with respect to <math id="A1.SS8.p2.m19" class="ltx_Math" alttext="\mathbf{x}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{x}_{i}</annotation></semantics></math> (through the dependence <math id="A1.SS8.p2.m20" class="ltx_Math" alttext="\hat{\mathbf{x}}_{0}(\mathbf{x}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathbf{x}}_{0}(\mathbf{x}_{i})</annotation></semantics></math>);</p>
</div>
<figure id="alg6" class="ltx_float ltx_float_algorithm ltx_minipage ltx_align_middle ltx_framed ltx_framed_top" style="width:155.3pt;">
<figcaption class="ltx_caption" style="font-size:80%;"><span class="ltx_tag ltx_tag_float"><span id="alg6.5" class="ltx_text ltx_font_bold">Algorithm 6</span> </span> DPS Sampling</figcaption>
<div id="alg6.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg6.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <math id="alg6.l1.m1" class="ltx_Math" alttext="N,\;\mathbf{H},\;\mathbf{y},\;\{\,\zeta_{i}\,\}_{i=1}^{N},\;\{\,\tilde{\sigma}_{i}\,\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">N</mi><mo mathsize="0.800em" rspace="0.447em">,</mo><mi mathsize="0.800em">𝐇</mi><mo mathsize="0.800em" rspace="0.447em">,</mo><mi mathsize="0.800em">𝐲</mi><mo mathsize="0.800em" rspace="0.447em">,</mo><msubsup><mrow><mo rspace="0.170em" stretchy="false">{</mo><msub><mi mathsize="0.800em">ζ</mi><mi mathsize="0.800em">i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">1</mn></mrow><mi mathsize="0.800em">N</mi></msubsup><mo mathsize="0.800em" rspace="0.447em">,</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi mathsize="0.800em">σ</mi><mo>~</mo></mover><mi mathsize="0.800em">i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">1</mn></mrow><mi mathsize="0.800em">N</mi></msubsup></mrow><annotation encoding="application/x-tex">N,\;\mathbf{H},\;\mathbf{y},\;\{\,\zeta_{i}\,\}_{i=1}^{N},\;\{\,\tilde{\sigma}_{i}\,\}_{i=1}^{N}</annotation></semantics></math><span id="alg6.l1.3" class="ltx_text" style="font-size:80%;"> </span><span id="alg6.l1.4" class="ltx_text" style="font-size:80%;float:right;"><math id="alg6.l1.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> step sizes and noise scales
</span>
</div>
<div id="alg6.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <math id="alg6.l2.m1" class="ltx_Math" alttext="\mathbf{x}_{N}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em">N</mi></msub><mo mathsize="0.800em">∼</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒩</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mn mathsize="0.800em">𝟎</mn><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">𝐈</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{N}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math><span id="alg6.l2.3" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg6.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg6.l3.3" class="ltx_text ltx_font_bold" style="font-size:80%;">for</span><span id="alg6.l3.4" class="ltx_text" style="font-size:80%;"> </span><math id="alg6.l3.m1" class="ltx_Math" alttext="i=N\!-\!1,\dots,0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">N</mi><mo lspace="0.092em" mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em" mathvariant="normal">…</mi><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">0</mn></mrow><annotation encoding="application/x-tex">i=N\!-\!1,\dots,0</annotation></semantics></math><span id="alg6.l3.5" class="ltx_text" style="font-size:80%;"> </span><span id="alg6.l3.6" class="ltx_text ltx_font_bold" style="font-size:80%;">do</span><span id="alg6.l3.7" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg6.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg6.l4.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg6.l4.m1" class="ltx_Math" alttext="\hat{\mathbf{s}}\leftarrow\mathbf{s}_{\theta}(\mathbf{x}_{i},\,i)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathsize="0.800em">𝐬</mi><mo>^</mo></mover><mo mathsize="0.800em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.800em">𝐬</mi><mi mathsize="0.800em">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">i</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathbf{s}}\leftarrow\mathbf{s}_{\theta}(\mathbf{x}_{i},\,i)</annotation></semantics></math><span id="alg6.l4.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg6.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            <span id="alg6.l5.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg6.l5.m1" class="ltx_Math" alttext="\hat{\mathbf{x}}_{0}\leftarrow\frac{1}{\sqrt{\bar{\alpha}_{i}}}\!\left(\mathbf{x}_{i}+(1-\bar{\alpha}_{i})\hat{\mathbf{s}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathsize="0.800em">𝐱</mi><mo>^</mo></mover><mn mathsize="0.800em">0</mn></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mfrac><mn mathsize="0.800em">1</mn><msqrt><msub><mover accent="true"><mi mathsize="0.800em">α</mi><mo>¯</mo></mover><mi mathsize="0.800em">i</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">+</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">−</mo><msub><mover accent="true"><mi mathsize="0.800em">α</mi><mo>¯</mo></mover><mi mathsize="0.800em">i</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathsize="0.800em">𝐬</mi><mo>^</mo></mover></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathbf{x}}_{0}\leftarrow\frac{1}{\sqrt{\bar{\alpha}_{i}}}\!\left(\mathbf{x}_{i}+(1-\bar{\alpha}_{i})\hat{\mathbf{s}}\right)</annotation></semantics></math><span id="alg6.l5.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg6.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <span id="alg6.l6.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg6.l6.m1" class="ltx_Math" alttext="\mathbf{z}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">𝐳</mi><mo mathsize="0.800em">∼</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒩</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mn mathsize="0.800em">𝟎</mn><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">𝐈</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math><span id="alg6.l6.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg6.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <span id="alg6.l7.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg6.l7.m1" class="ltx_Math" alttext="\mathbf{x}^{\prime}_{i-1}\leftarrow\sqrt{\frac{\alpha_{i}(1-\bar{\alpha}_{i-1})}{1-\bar{\alpha}_{i}}}\;\mathbf{x}_{i}+\sqrt{\frac{\bar{\alpha}_{i-1}\beta_{i}}{1-\bar{\alpha}_{i}}}\;\hat{\mathbf{x}}_{0}+\tilde{\sigma}_{i}\,\mathbf{z}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">𝐱</mi><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow><mo mathsize="0.800em">′</mo></msubsup><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mrow><msqrt><mfrac><mrow><msub><mi mathsize="0.800em">α</mi><mi mathsize="0.800em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">−</mo><msub><mover accent="true"><mi mathsize="0.800em">α</mi><mo>¯</mo></mover><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">−</mo><msub><mover accent="true"><mi mathsize="0.800em">α</mi><mo>¯</mo></mover><mi mathsize="0.800em">i</mi></msub></mrow></mfrac></msqrt><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.800em">𝐱</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo mathsize="0.800em">+</mo><mrow><msqrt><mfrac><mrow><msub><mover accent="true"><mi mathsize="0.800em">α</mi><mo>¯</mo></mover><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">β</mi><mi mathsize="0.800em">i</mi></msub></mrow><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">−</mo><msub><mover accent="true"><mi mathsize="0.800em">α</mi><mo>¯</mo></mover><mi mathsize="0.800em">i</mi></msub></mrow></mfrac></msqrt><mo lspace="0.280em" rspace="0em">​</mo><msub><mover accent="true"><mi mathsize="0.800em">𝐱</mi><mo>^</mo></mover><mn mathsize="0.800em">0</mn></msub></mrow><mo mathsize="0.800em">+</mo><mrow><msub><mover accent="true"><mi mathsize="0.800em">σ</mi><mo>~</mo></mover><mi mathsize="0.800em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">𝐳</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}^{\prime}_{i-1}\leftarrow\sqrt{\frac{\alpha_{i}(1-\bar{\alpha}_{i-1})}{1-\bar{\alpha}_{i}}}\;\mathbf{x}_{i}+\sqrt{\frac{\bar{\alpha}_{i-1}\beta_{i}}{1-\bar{\alpha}_{i}}}\;\hat{\mathbf{x}}_{0}+\tilde{\sigma}_{i}\,\mathbf{z}</annotation></semantics></math><span id="alg6.l7.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg6.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
