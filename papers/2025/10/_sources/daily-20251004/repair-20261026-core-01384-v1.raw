<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS3" title="In Appendix D Experiment details and ablation studies ‣ Fine-Tuning Masked Diffusion for ProvableSelf-Correction" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.3 </span>Ablation on Fine-tuning Hyperparameters-<math class="ltx_Math" alttext="(k,n_{y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><msub><mi>n</mi><mi>y</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k,n_{y})</annotation></semantics></math></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS4" title="In Appendix D Experiment details and ablation studies ‣ Fine-Tuning Masked Diffusion for ProvableSelf-Correction" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.4 </span>Ablation on Fine-tuning Hyperparameters-Nucleus sampling</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS5" title="In Appendix D Experiment details and ablation studies ‣ Fine-Tuning Masked Diffusion for ProvableSelf-Correction" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.5 </span>Experiment Configurations</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS6" title="In Appendix D Experiment details and ablation studies ‣ Fine-Tuning Masked Diffusion for ProvableSelf-Correction" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.6 </span>Additional experimental details on LLaDA</span></a></li>
</ol></li>
