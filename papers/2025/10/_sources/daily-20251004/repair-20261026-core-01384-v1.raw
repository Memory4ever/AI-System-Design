<td id="A4.T3.2.1.13.4" class="ltx_td ltx_align_center">144</td></tr>
<tr id="A4.T3.2.1.14" class="ltx_tr">
<th id="A4.T3.2.1.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   <math id="A4.T3.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math></th>
<td id="A4.T3.2.1.14.2" class="ltx_td ltx_align_center">4</td>
<td id="A4.T3.2.1.14.3" class="ltx_td ltx_align_center">8</td>
<td id="A4.T3.2.1.14.4" class="ltx_td ltx_align_center">8</td></tr>
<tr id="A4.T3.2.1.15" class="ltx_tr">
<th id="A4.T3.2.1.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   <math id="A4.T3.m5" class="ltx_Math" alttext="n_{y}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>y</mi></msub><annotation encoding="application/x-tex">n_{y}</annotation></semantics></math></th>
<td id="A4.T3.2.1.15.2" class="ltx_td ltx_align_center">1</td>
<td id="A4.T3.2.1.15.3" class="ltx_td ltx_align_center">4</td>
<td id="A4.T3.2.1.15.4" class="ltx_td ltx_align_center">1</td></tr>
<tr id="A4.T3.2.1.16" class="ltx_tr">
<th id="A4.T3.2.1.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   Nucleus <math id="A4.T3.m6" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math></th>
<td id="A4.T3.2.1.16.2" class="ltx_td ltx_align_center">1.0</td>
<td id="A4.T3.2.1.16.3" class="ltx_td ltx_align_center">1.0</td>
<td id="A4.T3.2.1.16.4" class="ltx_td ltx_align_center">0.0</td></tr>
<tr id="A4.T3.2.1.17" class="ltx_tr">
