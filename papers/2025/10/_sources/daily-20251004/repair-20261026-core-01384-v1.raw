<td id="A4.T3.2.1.11.3" class="ltx_td ltx_align_center"><math id="A4.T3.m2" class="ltx_Math" alttext="1.5\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1.5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.5\times 10^{-4}</annotation></semantics></math></td>
<td id="A4.T3.2.1.11.4" class="ltx_td ltx_align_center"><math id="A4.T3.m3" class="ltx_Math" alttext="1.0\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1.0</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.0\times 10^{-4}</annotation></semantics></math></td></tr>
