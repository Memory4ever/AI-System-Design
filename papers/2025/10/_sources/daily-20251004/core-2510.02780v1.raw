<td id="A1.T5.2.6.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T5.2.6.1.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
<span id="A1.T5.2.6.1.1.1" class="ltx_p">Phonetic Transformation (PT)</span>
</span></td>
