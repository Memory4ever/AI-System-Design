<span id="A1.T5.2.6.2.1" class="ltx_inline-block ltx_align_top" style="width:241.9pt;">
<span id="A1.T5.2.6.2.1.1" class="ltx_p">Sound-based wordplay or homophones</span>
</span></td></tr>
<tr id="A1.T5.2.7" class="ltx_tr">
<td id="A1.T5.2.7.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
