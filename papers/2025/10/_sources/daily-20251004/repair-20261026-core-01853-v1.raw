<td id="A3.T4.2.3.1" class="ltx_td"></td>
<td id="A3.T4.2.3.2" class="ltx_td ltx_align_left">CUDA</td>
<td id="A3.T4.2.3.3" class="ltx_td ltx_align_left">CUDA 12.3</td></tr>
<tr id="A3.T4.2.4" class="ltx_tr">
<td id="A3.T4.2.4.1" class="ltx_td"></td>
<td id="A3.T4.2.4.2" class="ltx_td ltx_align_left">GPUs</td>
<td id="A3.T4.2.4.3" class="ltx_td ltx_align_left">8<math id="A3.T4.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> A100-SXM4-80GB</td></tr>
<tr id="A3.T4.2.5" class="ltx_tr">
<td id="A3.T4.2.5.1" class="ltx_td"></td>
<td id="A3.T4.2.5.2" class="ltx_td ltx_align_left">Random seed</td>
<td id="A3.T4.2.5.3" class="ltx_td ltx_align_left">580946</td></tr>
<tr id="A3.T4.2.6" class="ltx_tr">
<td id="A3.T4.2.6.1" class="ltx_td ltx_align_left ltx_border_t">Training duration</td>
<td id="A3.T4.2.6.2" class="ltx_td ltx_align_left ltx_border_t">Max epochs</td>
<td id="A3.T4.2.6.3" class="ltx_td ltx_align_left ltx_border_t">100 (<math id="A3.T4.m2" class="ltx_Math" alttext="\approx 165,000" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mn>165,000</mn></mrow><annotation encoding="application/x-tex">\approx 165,000</annotation></semantics></math> steps, <math id="A3.T4.m3" class="ltx_Math" alttext="\approx 15" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">\approx 15</annotation></semantics></math> h)</td></tr>
<tr id="A3.T4.2.7" class="ltx_tr">
<td id="A3.T4.2.7.1" class="ltx_td"></td>
<td id="A3.T4.2.7.2" class="ltx_td ltx_align_left">Best checkpoint</td>
<td id="A3.T4.2.7.3" class="ltx_td ltx_align_left">Epoch 80 (<math id="A3.T4.m4" class="ltx_Math" alttext="\approx 130000" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mn>130000</mn></mrow><annotation encoding="application/x-tex">\approx 130000</annotation></semantics></math> steps, <math id="A3.T4.m5" class="ltx_Math" alttext="\approx 12" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">\approx 12</annotation></semantics></math> h)</td></tr>
<tr id="A3.T4.2.8" class="ltx_tr">
<td id="A3.T4.2.8.1" class="ltx_td ltx_align_left ltx_border_t">Batching</td>
<td id="A3.T4.2.8.2" class="ltx_td ltx_align_left ltx_border_t">Per-GPU batch size</td>
<td id="A3.T4.2.8.3" class="ltx_td ltx_align_left ltx_border_t">128</td></tr>
<tr id="A3.T4.2.9" class="ltx_tr">
<td id="A3.T4.2.9.1" class="ltx_td"></td>
