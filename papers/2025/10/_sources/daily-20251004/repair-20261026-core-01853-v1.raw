<td id="A3.T4.2.9.3" class="ltx_td ltx_align_left">2 steps</td></tr>
<tr id="A3.T4.2.10" class="ltx_tr">
<td id="A3.T4.2.10.1" class="ltx_td ltx_align_left ltx_border_t">Optimizer &amp; LR</td>
<td id="A3.T4.2.10.2" class="ltx_td ltx_align_left ltx_border_t">Optimizer</td>
<td id="A3.T4.2.10.3" class="ltx_td ltx_align_left ltx_border_t">AdamW</td></tr>
<tr id="A3.T4.2.11" class="ltx_tr">
<td id="A3.T4.2.11.1" class="ltx_td"></td>
<td id="A3.T4.2.11.2" class="ltx_td ltx_align_left"><math id="A3.T4.m6" class="ltx_Math" alttext="\beta_{1},\beta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\beta_{1},\beta_{2}</annotation></semantics></math></td>
<td id="A3.T4.2.11.3" class="ltx_td ltx_align_left">0.9, 0.999</td></tr>
<tr id="A3.T4.2.12" class="ltx_tr">
<td id="A3.T4.2.12.1" class="ltx_td"></td>
<td id="A3.T4.2.12.2" class="ltx_td ltx_align_left">Weight decay</td>
<td id="A3.T4.2.12.3" class="ltx_td ltx_align_left">0.01</td></tr>
<tr id="A3.T4.2.13" class="ltx_tr">
<td id="A3.T4.2.13.1" class="ltx_td"></td>
<td id="A3.T4.2.13.2" class="ltx_td ltx_align_left">Initial LR</td>
<td id="A3.T4.2.13.3" class="ltx_td ltx_align_left"><math id="A3.T4.m7" class="ltx_Math" alttext="2\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2\times 10^{-4}</annotation></semantics></math></td></tr>
<tr id="A3.T4.2.14" class="ltx_tr">
<td id="A3.T4.2.14.1" class="ltx_td ltx_align_left ltx_border_t">Scheduler</td>
<td id="A3.T4.2.14.2" class="ltx_td ltx_align_left ltx_border_t">Warmup steps</td>
<td id="A3.T4.2.14.3" class="ltx_td ltx_align_left ltx_border_t">12000</td></tr>
<tr id="A3.T4.2.15" class="ltx_tr">
<td id="A3.T4.2.15.1" class="ltx_td"></td>
<td id="A3.T4.2.15.2" class="ltx_td ltx_align_left">Decay policy</td>
<td id="A3.T4.2.15.3" class="ltx_td ltx_align_left">Linear to 0 over <math id="A3.T4.m8" class="ltx_Math" alttext="165,000" display="inline" intent=":literal"><semantics><mn>165,000</mn><annotation encoding="application/x-tex">165,000</annotation></semantics></math> steps</td></tr>
