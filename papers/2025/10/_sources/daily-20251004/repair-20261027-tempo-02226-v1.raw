<span id="S4.T1.1.1.1.1.1.9.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Aesthetic</span></span>
<span id="S4.T1.1.1.1.1.1.9.2.1.2" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.9.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Quality</span></span>
</span></span><span id="S4.T1.1.1.1.1.1.9.3" class="ltx_text"></span></span>
<span id="S4.T1.1.1.1.1.1.10" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.1.1.1.1.1.10.1" class="ltx_text"></span> <span id="S4.T1.1.1.1.1.1.10.2" class="ltx_text">
<span id="S4.T1.1.1.1.1.1.10.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.1.1.1.1.1.10.2.1.1" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.10.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Imaging</span></span>
<span id="S4.T1.1.1.1.1.1.10.2.1.2" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.10.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Quality</span></span>
</span></span><span id="S4.T1.1.1.1.1.1.10.3" class="ltx_text"></span></span></span>
<span id="S4.T1.1.1.1.1.2" class="ltx_tr">
<span id="S4.T1.1.1.1.1.2.1" class="ltx_td ltx_align_center ltx_border_t ltx_colspan ltx_colspan_10"><span id="S4.T1.1.1.1.1.2.1.1" class="ltx_text ltx_font_bold">One Object</span></span></span>
