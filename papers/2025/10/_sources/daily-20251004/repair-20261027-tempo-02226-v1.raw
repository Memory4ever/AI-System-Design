</span></span><span id="S4.T1.1.1.1.1.1.3.3" class="ltx_text"></span></span>
<span id="S4.T1.1.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.1.1.1.1.1.4.1" class="ltx_text"></span> <span id="S4.T1.1.1.1.1.1.4.2" class="ltx_text">
<span id="S4.T1.1.1.1.1.1.4.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.1.1.1.1.1.4.2.1.1" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">T. Presence</span></span>
<span id="S4.T1.1.1.1.1.1.4.2.1.2" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Accuracy</span></span>
</span></span><span id="S4.T1.1.1.1.1.1.4.3" class="ltx_text"></span></span>
<span id="S4.T1.1.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.1.1.1.1.1.5.1" class="ltx_text"></span> <span id="S4.T1.1.1.1.1.1.5.2" class="ltx_text">
<span id="S4.T1.1.1.1.1.1.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.1.1.1.1.1.5.2.1.1" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Subject</span></span>
