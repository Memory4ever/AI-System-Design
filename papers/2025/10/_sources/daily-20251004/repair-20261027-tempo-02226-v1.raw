<span id="S4.T1.1.1.1.1.1.5.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Consistency</span></span>
</span></span><span id="S4.T1.1.1.1.1.1.5.3" class="ltx_text"></span></span>
<span id="S4.T1.1.1.1.1.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.1.1.1.1.1.6.1" class="ltx_text"></span> <span id="S4.T1.1.1.1.1.1.6.2" class="ltx_text">
<span id="S4.T1.1.1.1.1.1.6.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.1.1.1.1.1.6.2.1.1" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.6.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Background</span></span>
<span id="S4.T1.1.1.1.1.1.6.2.1.2" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.6.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Consistency</span></span>
</span></span><span id="S4.T1.1.1.1.1.1.6.3" class="ltx_text"></span></span>
<span id="S4.T1.1.1.1.1.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.1.1.1.1.1.7.1" class="ltx_text"></span> <span id="S4.T1.1.1.1.1.1.7.2" class="ltx_text">
<span id="S4.T1.1.1.1.1.1.7.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.1.1.1.1.1.7.2.1.1" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.7.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Motion</span></span>
<span id="S4.T1.1.1.1.1.1.7.2.1.2" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.7.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Smoothness</span></span>
</span></span><span id="S4.T1.1.1.1.1.1.7.3" class="ltx_text"></span></span>
<span id="S4.T1.1.1.1.1.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.1.1.1.1.1.8.1" class="ltx_text"></span> <span id="S4.T1.1.1.1.1.1.8.2" class="ltx_text">
<span id="S4.T1.1.1.1.1.1.8.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.1.1.1.1.1.8.2.1.1" class="ltx_tr">
<span id="S4.T1.1.1.1.1.1.8.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Dynamic</span></span>
