<span id="S4.T1.1.1.1.1.1.8.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Degree</span></span>
</span></span><span id="S4.T1.1.1.1.1.1.8.3" class="ltx_text"></span></span>
<span id="S4.T1.1.1.1.1.1.9" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.1.1.1.1.1.9.1" class="ltx_text"></span> <span id="S4.T1.1.1.1.1.1.9.2" class="ltx_text">
<span id="S4.T1.1.1.1.1.1.9.2.1" class="ltx_tabular ltx_align_middle">
