<tr id="S5.T1.10.1.4" class="ltx_tr">
<th id="S5.T1.10.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">Video Generative Model</th>
<td id="S5.T1.10.1.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">1.00</td>
<td id="S5.T1.10.1.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">0.98</td>
<td id="S5.T1.10.1.4.4" class="ltx_td ltx_align_center ltx_border_rr ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">0.84</td>
<td id="S5.T1.10.1.4.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">0.92</td>
