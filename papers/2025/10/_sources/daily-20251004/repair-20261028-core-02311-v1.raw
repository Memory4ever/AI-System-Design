<th id="S5.T1.10.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S5.T1.10.1.3.2.1" class="ltx_text ltx_font_bold">Oracle</span></th>
