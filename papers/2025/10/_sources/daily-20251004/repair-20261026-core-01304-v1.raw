<td id="S4.T1.8.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="9"><math id="S4.T1.m2" class="ltx_Math" alttext="3\times 3" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">3\times 3</annotation></semantics></math></td></tr>
