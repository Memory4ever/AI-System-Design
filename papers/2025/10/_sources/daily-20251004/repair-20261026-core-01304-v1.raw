<tr id="S4.T1.8.1.4" class="ltx_tr">
<td id="S4.T1.8.1.4.1" class="ltx_td ltx_align_left ltx_border_r">GPT-4o</td>
<td id="S4.T1.8.1.4.2" class="ltx_td ltx_align_center">38.7</td>
