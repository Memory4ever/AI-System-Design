tex">\displaystyle\tilde{\eta}{\bm{\varepsilon}}^{\top}\left(\frac{1}{\eta}\left(\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}^{\top}+\eta{\bm{k}}\right)\tilde{{\bm{v}}}^{\top}+\frac{1}{\eta}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}-\frac{\xi}{\eta\gamma_{1}}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
