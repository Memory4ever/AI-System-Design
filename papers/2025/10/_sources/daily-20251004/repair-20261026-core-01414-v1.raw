<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex58.m2" class="ltx_Math" alttext="\displaystyle-\frac{\tilde{\eta}\xi}{\eta\gamma_{1}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\tilde{\eta}\xi}{\eta\gamma_{1}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}.</annotation></semantics></math></td>
