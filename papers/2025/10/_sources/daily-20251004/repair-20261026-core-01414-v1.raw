><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>η</mi><mo>~</mo></mover><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\alpha}_{Z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\alpha_{Z}\left(1-\frac{\xi}{\gamma_{2}}\right){\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\alpha_{A}\left[\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}+\frac{\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\tilde{{\bm{Z}}}\right]+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{2}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}</annotation></semantics></math></td>
