<td id="S1.T1.6.8.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" colspan="4"><span id="S1.T1.6.8.1.1" class="ltx_text ltx_font_bold">Misspecified with Covariate Shift:</span> <math id="S1.T1.m39" class="ltx_Math" alttext="\alpha_{A}\neq\tilde{\alpha}_{A}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>A</mi></msub><mo>≠</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{A}\neq\tilde{\alpha}_{A}</annotation></semantics></math> or <math id="S1.T1.m40" class="ltx_Math" alttext="\alpha_{Z}\neq\tilde{\alpha}_{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>≠</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{Z}\neq\tilde{\alpha}_{Z}</annotation></semantics></math></td></tr>
<tr id="S1.T1.6.9" class="ltx_tr">
<td id="S1.T1.6.9.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 30.0pt;">
<span id="S1.T1.6.9.1.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S1.T1.6.9.1.1.1" class="ltx_p"><math id="S1.T1.m41" class="ltx_Math" alttext="\theta^{2}=\gamma\tau^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\theta^{2}=\gamma\tau^{2}</annotation></semantics></math></span>
</span></td>
<td id="S1.T1.6.9.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 30.0pt;">
<span id="S1.T1.6.9.2.1" class="ltx_inline-block ltx_align_top" style="width:96.7pt;">
<span id="S1.T1.6.9.2.1.1" class="ltx_p ltx_align_center">Never</span>
</span></td>
<td id="S1.T1.6.9.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 30.0pt;">
<span id="S1.T1.6.9.3.1" class="ltx_inline-block ltx_align_top" style="width:68.3pt;">
<span id="S1.T1.6.9.3.1.1" class="ltx_p ltx_align_center">All other cases</span>
</span></td>
<td id="S1.T1.6.9.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 30.0pt;">
<table id="S1.T1.6.9.4.1" class="ltx_tabular ltx_centering ltx_align_middle" style="width:139.4pt;">
<tr id="S1.T1.6.9.4.1.1" class="ltx_tr">
<td id="S1.T1.6.9.4.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S1.T1.m42" class="ltx_Math" alttext="\alpha_{Z}\neq\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>≠</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><mo>,</mo><mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>⟂̸</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha_{Z}\neq\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp{\bm{u}}</annotation></semantics></math>, <math id="S1.T1.m43" class="ltx_Math" alttext="\gamma=\omega_{c}(1)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><msub><mi>ω</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma=\omega_{c}(1)</annotation></semantics></math></td></tr>
<tr id="S1.T1.6.9.4.1.2" class="ltx_tr">
<td id="S1.T1.6.9.4.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">or</td></tr>
<tr id="S1.T1.6.9.4.1.3" class="ltx_tr">
<td id="S1.T1.6.9.4.1.3.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S1.T1.m44" class="ltx_Math" alttext="\alpha_{Z}=\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><mo>,</mo><mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>⟂̸</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha_{Z}=\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp{\bm{u}}</annotation></semantics></math>,</td></tr>
<tr id="S1.T1.6.9.4.1.4" class="ltx_tr">
<td id="S1.T1.6.9.4.1.4.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S1.T1.m45" class="ltx_Math" alttext="\omega_{c}(1)\leq\gamma\leq o_{c}(c^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ω</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>γ</mi><mo>≤</mo><mrow><msub><mi>o</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\omega_{c}(1)\leq\gamma\leq o_{c}(c^{2})</annotation></semantics></math></td></tr>
</table></td></tr>
<tr id="S1.T1.6.10" class="ltx_tr">
