<span id="S1.T1.6.10.3.1.1" class="ltx_p ltx_align_center">All other cases</span>
</span></td>
<td id="S1.T1.6.10.4" class="ltx_td ltx_align_left ltx_align_top" style="padding-bottom: 5.0pt;">
<span id="S1.T1.6.10.4.1" class="ltx_inline-block ltx_align_top" style="width:139.4pt;">
<span id="S1.T1.6.10.4.1.1" class="ltx_p ltx_align_center"><math id="S1.T1.m49" class="ltx_Math" alttext="\alpha_{Z}\neq\tilde{\alpha}_{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>≠</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{Z}\neq\tilde{\alpha}_{Z}</annotation></semantics></math> and <math id="S1.T1.m50" class="ltx_Math" alttext="{\bm{\beta}}_{*}\not\perp{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>⟂̸</mo><mi>𝒖</mi></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}\not\perp{\bm{u}}</annotation></semantics></math></span>
</span></td></tr>
<tr id="S1.T1.6.11" class="ltx_tr">
<td id="S1.T1.6.11.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" colspan="4"><span id="S1.T1.6.11.1.1" class="ltx_text ltx_font_bold">Spike Recovery:</span> <math id="S1.T1.m51" class="ltx_Math" alttext="\alpha_{A}=\tilde{\alpha}_{A}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>A</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha_{A}=\tilde{\alpha}_{A}=0</annotation></semantics></math>, <math id="S1.T1.m52" class="ltx_Math" alttext="\alpha_{Z}=\tilde{\alpha}_{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{Z}=\tilde{\alpha}_{Z}</annotation></semantics></math>    (Appendix <a href="#A3" title="Appendix C Spike Recovery Case ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>)</td></tr>
<tr id="S1.T1.6.12" class="ltx_tr">
<td id="S1.T1.6.12.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 5.0pt;">
