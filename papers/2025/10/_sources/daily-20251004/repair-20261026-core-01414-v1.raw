<span id="S1.T1.6.10.1.1.1" class="ltx_p"><math id="S1.T1.m46" class="ltx_Math" alttext="\theta^{2}=d\tau^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\theta^{2}=d\tau^{2}</annotation></semantics></math></span>
</span></td>
