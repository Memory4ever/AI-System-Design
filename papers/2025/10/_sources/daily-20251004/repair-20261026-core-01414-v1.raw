<div id="A4.SS3.SSS5.p2" class="ltx_para">
<p id="A4.SS3.SSS5.p2.1" class="ltx_p"><span id="A4.SS3.SSS5.p2.1.1" class="ltx_text">For <math id="A4.SS3.SSS5.p2.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, we note that the calculation is exactly the same. An example of such a calculation can be seen in the proof of <a href="#Thmlemma4" title="Lemma 4. ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4</span></a>.
∎</span></p>
</div>
</div>
<div id="Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma 2</span></span><span id="Thmlemma2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma2.p1" class="ltx_para">
<p id="Thmlemma2.p1.1" class="ltx_p"><span id="Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">In the setting of Section <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, we have:</span></p>
<table id="A4.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex59.m1" class="ltx_Math" alttext="{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}=\begin{cases}{\bm{I}}-\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{h}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger},&amp;c&lt;1\\
{\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta\xi}{\gamma_{2}}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}-\frac{\eta\xi}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}},&amp;c&gt;1\end{cases}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>𝑰</mi><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}=\begin{cases}{\bm{I}}-\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{h}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger},&amp;c&lt;1\\
{\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta\xi}{\gamma_{2}}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}-\frac{\eta\xi}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}},&amp;c&gt;1\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS3.SSS5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS3.SSS5.p3" class="ltx_para">
<p id="A4.SS3.SSS5.p3.1" class="ltx_p"><span id="A4.SS3.SSS5.p3.1.1" class="ltx_text">For <math id="A4.SS3.SSS5.p3.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, <math id="A4.SS3.SSS5.p3.m2" class="ltx_Math" alttext="{\bm{Z}},{\bm{A}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒁</mi><mo>,</mo><mi>𝑨</mi></mrow><annotation encoding="application/x-tex">{\bm{Z}},{\bm{A}}</annotation></semantics></math> are <math id="A4.SS3.SSS5.p3.m3" class="ltx_Math" alttext="d\times n" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d\times n</annotation></semantics></math> with <math id="A4.SS3.SSS5.p3.m4" class="ltx_Math" alttext="d&lt;n" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&lt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d&lt;n</annotation></semantics></math>. Since <math id="A4.SS3.SSS5.p3.m5" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> is assumed to have full rank, <math id="A4.SS3.SSS5.p3.m6" class="ltx_Math" alttext="{\bm{Z}}+{\bm{A}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><annotation encoding="application/x-tex">{\bm{Z}}+{\bm{A}}</annotation></semantics></math> has full rank with probability 1, and hence</span></p>
<table id="A4.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex60.m1" class="ltx_Math" alttext="({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}={\bm{I}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mo>=</mo><mi>𝑰</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}={\bm{I}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p3.2" class="ltx_p"><span id="A4.SS3.SSS5.p3.2.1" class="ltx_text">Thus, from <a href="#Thmprop1" title="Proposition 1 (Proposition 2 from []). ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a>,</span></p>
<table id="A4.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex61.m1" class="ltx_Math" alttext="\displaystyle{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}=({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}-{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}={\bm{I}}-\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{h}}-\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mo>−</mo><mrow><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow></mrow><mo>=</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}=({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}-{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}={\bm{I}}-\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{h}}-\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS3.SSS5.p4" class="ltx_para">
<p id="A4.SS3.SSS5.p4.1" class="ltx_p"><span id="A4.SS3.SSS5.p4.1.1" class="ltx_text">For <math id="A4.SS3.SSS5.p4.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, since <math id="A4.SS3.SSS5.p4.m2" class="ltx_Math" alttext="({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><annotation encoding="application/x-tex">({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}</annotation></semantics></math> is no longer the identity matrix, we directly expand using <a href="#Thmtheorem6" title="Theorem 6 (Theorems 3, 5 of []). ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6</span></a>:</span></p>
<table id="A4.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex62.m1" class="ltx_Math" alttext="\displaystyle{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex62.m2" class="ltx_Math" alttext="\displaystyle={\bm{A}}\left({\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta{\bm{k}}\right)\left(\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}+{\bm{h}}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝑨</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mi>𝒉</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{A}}\left({\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta{\bm{k}}\right)\left(\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}+{\bm{h}}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex63.m1" class="ltx_Math" alttext="\displaystyle={\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{A}}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}\right)\left(\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}+{\bm{h}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mi>𝒉</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{A}}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}\right)\left(\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}+{\bm{h}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p4.2" class="ltx_p"><span id="A4.SS3.SSS5.p4.2.1" class="ltx_text">Noting that <math id="A4.SS3.SSS5.p4.m3" class="ltx_Math" alttext="{\bm{A}}{\bm{A}}^{\dagger}{\bm{h}}^{\top}={\bm{A}}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{v}}={\bm{A}}^{\dagger\top}{\bm{v}}={\bm{h}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>=</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{A}}{\bm{A}}^{\dagger}{\bm{h}}^{\top}={\bm{A}}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{v}}={\bm{A}}^{\dagger\top}{\bm{v}}={\bm{h}}^{\top}</annotation></semantics></math>, we have</span></p>
<table id="A4.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex64.m1" class="ltx_Math" alttext="\displaystyle{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex64.m2" class="ltx_Math" alttext="\displaystyle={\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{h}}^{\top}+\eta{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}\right)\left(\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}+{\bm{h}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mi>𝒉</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{h}}^{\top}+\eta{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}\right)\left(\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}+{\bm{h}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex65.m1" class="ltx_Math" alttext="\displaystyle={\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\xi\gamma_{2}}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}-\frac{\eta\xi}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\xi\gamma_{2}}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}-\frac{\eta\xi}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p4.3" class="ltx_p"><span id="A4.SS3.SSS5.p4.3.1" class="ltx_text">We can combine the coefficients in front of <math id="A4.SS3.SSS5.p4.m4" class="ltx_Math" alttext="{\bm{h}}^{\top}{\bm{s}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{h}}^{\top}{\bm{s}}^{\top}</annotation></semantics></math> to get</span></p>
<table id="A4.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex66.m1" class="ltx_Math" alttext="\frac{\eta}{\xi}-\frac{\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\xi\gamma_{2}}=\frac{\eta(\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2})-\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\xi\gamma_{2}}=\frac{\eta\xi}{\gamma_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>η</mi><mi>ξ</mi></mfrac><mo>−</mo><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mfrac></mrow><mo>=</mo><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mrow><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\eta}{\xi}-\frac{\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\xi\gamma_{2}}=\frac{\eta(\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2})-\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\xi\gamma_{2}}=\frac{\eta\xi}{\gamma_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p4.4" class="ltx_p"><span id="A4.SS3.SSS5.p4.4.1" class="ltx_text">The statement follows from here.
∎</span></p>
</div>
</div>
<div id="Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma 3</span></span><span id="Thmlemma3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma3.p1" class="ltx_para">
<p id="Thmlemma3.p1.1" class="ltx_p"><span id="Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">If <math id="Thmlemma3.p1.m1" class="ltx_Math" alttext="\xi\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\xi\neq 0</annotation></semantics></math> and <math id="Thmlemma3.p1.m2" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> has full rank, we have:</span></p>
<table id="A4.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex67.m1" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}=\begin{cases}\left(1-\frac{\xi}{\gamma_{1}}\right){\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}&amp;c&lt;1\\
\left(1-\frac{\xi}{\gamma_{2}}\right){\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}&amp;c&gt;1\end{cases}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="false"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="false"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}=\begin{cases}\left(1-\frac{\xi}{\gamma_{1}}\right){\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}&amp;c&lt;1\\
\left(1-\frac{\xi}{\gamma_{2}}\right){\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}&amp;c&gt;1\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS3.SSS5.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS3.SSS5.p5" class="ltx_para">
<p id="A4.SS3.SSS5.p5.1" class="ltx_p"><span id="A4.SS3.SSS5.p5.1.1" class="ltx_text">Using <a href="#Thmprop1" title="Proposition 1 (Proposition 2 from []). ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a> for <math id="A4.SS3.SSS5.p5.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math> and <math id="A4.SS3.SSS5.p5.m2" class="ltx_Math" alttext="\tilde{{\bm{Z}}}=\tilde{\eta}{\bm{u}}\tilde{{\bm{v}}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\tilde{{\bm{Z}}}=\tilde{\eta}{\bm{u}}\tilde{{\bm{v}}}^{\top}</annotation></semantics></math>, we have that</span></p>
<table id="A4.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex68.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex68.m2" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{h}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}\right)\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{h}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}\right)\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex69.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{h}}{\bm{u}}\tilde{{\bm{v}}}^{\top}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{h}}{\bm{u}}\tilde{{\bm{v}}}^{\top}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex70.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}\tilde{{\bm{v}}}^{\top}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{1}}{\bm{u}}{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}\tilde{{\bm{v}}}^{\top}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p5.2" class="ltx_p"><span id="A4.SS3.SSS5.p5.2.1" class="ltx_text">Note <math id="A4.SS3.SSS5.p5.m3" class="ltx_Math" alttext="\xi-1=\eta{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">\xi-1=\eta{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}</annotation></semantics></math>, <math id="A4.SS3.SSS5.p5.m4" class="ltx_Math" alttext="{\bm{k}}{\bm{A}}^{\dagger}{\bm{u}}={\bm{k}}^{\top}{\bm{k}}=\|{\bm{k}}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>=</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>=</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">{\bm{k}}{\bm{A}}^{\dagger}{\bm{u}}={\bm{k}}^{\top}{\bm{k}}=\|{\bm{k}}\|^{2}</annotation></semantics></math>. The above equation becomes</span></p>
<table id="A4.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex71.m1" class="ltx_Math" alttext="\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\xi(\xi-1)}{\gamma_{1}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}}\right){\bm{u}}\tilde{{\bm{v}}}^{\top}={\bm{\beta}}_{*}^{\top}\left(\frac{\xi(\xi-1)}{\gamma_{1}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}}\right)\tilde{{\bm{Z}}}^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ξ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo>+</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ξ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo>+</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\xi(\xi-1)}{\gamma_{1}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}}\right){\bm{u}}\tilde{{\bm{v}}}^{\top}={\bm{\beta}}_{*}^{\top}\left(\frac{\xi(\xi-1)}{\gamma_{1}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}}\right)\tilde{{\bm{Z}}}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p5.3" class="ltx_p"><span id="A4.SS3.SSS5.p5.3.1" class="ltx_text">Using <math id="A4.SS3.SSS5.p5.m5" class="ltx_Math" alttext="\gamma_{1}=\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}+\xi^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\gamma_{1}=\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}+\xi^{2}</annotation></semantics></math> to combine the coefficients, we have that</span></p>
<table id="A4.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex72.m1" class="ltx_Math" alttext="\frac{\xi(\xi-1)}{\gamma_{1}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}}=\frac{-\xi+\xi^{2}+\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}}=\frac{-\xi+\gamma_{1}}{\gamma_{1}}=1-\frac{\xi}{\gamma_{1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ξ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo>+</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mrow><mo>=</mo><mfrac><mrow><mrow><mo>−</mo><mi>ξ</mi></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo>=</mo><mfrac><mrow><mrow><mo>−</mo><mi>ξ</mi></mrow><mo>+</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\xi(\xi-1)}{\gamma_{1}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}}=\frac{-\xi+\xi^{2}+\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}}=\frac{-\xi+\gamma_{1}}{\gamma_{1}}=1-\frac{\xi}{\gamma_{1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS3.SSS5.p6" class="ltx_para ltx_noindent">
<p id="A4.SS3.SSS5.p6.1" class="ltx_p">This completes the proof for <math id="A4.SS3.SSS5.p6.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>. Similarly, for <math id="A4.SS3.SSS5.p6.m2" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, we obtain</p>
<table id="A4.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex73.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex73.m2" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}\right)\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}\right)\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex74.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}{\bm{u}}\tilde{{\bm{v}}}^{\top}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}{\bm{u}}\tilde{{\bm{v}}}^{\top}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex75.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}\tilde{{\bm{v}}}^{\top}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}\tilde{{\bm{v}}}^{\top}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p6.2" class="ltx_p">Note <math id="A4.SS3.SSS5.p6.m3" class="ltx_Math" alttext="\xi-1=\eta{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">\xi-1=\eta{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}</annotation></semantics></math>, <math id="A4.SS3.SSS5.p6.m4" class="ltx_Math" alttext="{\bm{s}}^{\top}{\bm{u}}=\|{\bm{s}}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>=</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">{\bm{s}}^{\top}{\bm{u}}=\|{\bm{s}}\|^{2}</annotation></semantics></math>. The above equation becomes</p>
<table id="A4.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex76.m1" class="ltx_Math" alttext="\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\xi(\xi-1)}{\gamma_{2}}+\frac{\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}\right){\bm{u}}\tilde{{\bm{v}}}^{\top}={\bm{\beta}}_{*}^{\top}\left(\frac{\xi(\xi-1)}{\gamma_{2}}+\frac{\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}\right)\tilde{{\bm{Z}}}^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ξ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo>+</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ξ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo>+</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\eta}{\bm{\beta}}_{*}^{\top}\left(\frac{\xi(\xi-1)}{\gamma_{2}}+\frac{\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}\right){\bm{u}}\tilde{{\bm{v}}}^{\top}={\bm{\beta}}_{*}^{\top}\left(\frac{\xi(\xi-1)}{\gamma_{2}}+\frac{\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}\right)\tilde{{\bm{Z}}}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p6.3" class="ltx_p">Using <math id="A4.SS3.SSS5.p6.m5" class="ltx_Math" alttext="\gamma_{2}=\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\gamma_{2}=\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2}</annotation></semantics></math> to combine the coefficients, we have that</p>
<table id="A4.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex77.m1" class="ltx_Math" alttext="\frac{\xi(\xi-1)}{\gamma_{2}}+\frac{\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}=\frac{-\xi+\xi^{2}+\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{2}}=\frac{-\xi+\gamma_{2}}{\gamma_{2}}=1-\frac{\xi}{\gamma_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ξ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo>+</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mrow><mo>=</mo><mfrac><mrow><mrow><mo>−</mo><mi>ξ</mi></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo>=</mo><mfrac><mrow><mrow><mo>−</mo><mi>ξ</mi></mrow><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\xi(\xi-1)}{\gamma_{2}}+\frac{\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}=\frac{-\xi+\xi^{2}+\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{2}}=\frac{-\xi+\gamma_{2}}{\gamma_{2}}=1-\frac{\xi}{\gamma_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p6.4" class="ltx_p">The target expression follows.
∎</p>
</div>
</div>
<div id="Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma 4</span></span><span id="Thmlemma4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma4.p1" class="ltx_para">
<p id="Thmlemma4.p1.1" class="ltx_p"><span id="Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">If <math id="Thmlemma4.p1.m1" class="ltx_Math" alttext="\xi\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\xi\neq 0</annotation></semantics></math> and <math id="Thmlemma4.p1.m2" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> has full rank, we have:</span></p>
<table id="A4.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex78.m1" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}=\begin{cases}\frac{\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}&amp;c&lt;1\\
\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}+\frac{\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\tilde{{\bm{Z}}}&amp;c&gt;1\end{cases}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="false"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}=\begin{cases}\frac{\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}&amp;c&lt;1\\
\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}+\frac{\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\tilde{{\bm{Z}}}&amp;c&gt;1\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS3.SSS5.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS3.SSS5.p7" class="ltx_para">
<p id="A4.SS3.SSS5.p7.1" class="ltx_p"><span id="A4.SS3.SSS5.p7.1.1" class="ltx_text">We begin with <math id="A4.SS3.SSS5.p7.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>. Since <math id="A4.SS3.SSS5.p7.m2" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> is assumed to have full rank, <math id="A4.SS3.SSS5.p7.m3" class="ltx_Math" alttext="{\bm{Z}}+{\bm{A}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><annotation encoding="application/x-tex">{\bm{Z}}+{\bm{A}}</annotation></semantics></math> has full column rank with probability 1, and hence</span></p>
<table id="A4.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex79.m1" class="ltx_Math" alttext="({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}={\bm{I}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mo>=</mo><mi>𝑰</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}={\bm{I}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p7.2" class="ltx_p"><span id="A4.SS3.SSS5.p7.2.1" class="ltx_text">It follows from <a href="#Thmlemma3" title="Lemma 3. ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3</span></a> that</span></p>
<table id="A4.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex80.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex80.m2" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}-{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}-{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex81.m1" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\left(1-\frac{\xi}{\gamma_{1}}\right){\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}=\frac{\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\left(1-\frac{\xi}{\gamma_{1}}\right){\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}=\frac{\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS3.SSS5.p8" class="ltx_para ltx_noindent">
<p id="A4.SS3.SSS5.p8.1" class="ltx_p">For <math id="A4.SS3.SSS5.p8.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, <math id="A4.SS3.SSS5.p8.m2" class="ltx_Math" alttext="{\bm{Z}}+{\bm{A}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><annotation encoding="application/x-tex">{\bm{Z}}+{\bm{A}}</annotation></semantics></math> now has full row rank instead of full column rank. Hence, we do not have <math id="A4.SS3.SSS5.p8.m3" class="ltx_Math" alttext="({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}={\bm{I}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mo>=</mo><mi>𝑰</mi></mrow><annotation encoding="application/x-tex">({\bm{Z}}+{\bm{A}})({\bm{Z}}+{\bm{A}})^{\dagger}={\bm{I}}</annotation></semantics></math> and need to directly expand it using <a href="#Thmtheorem6" title="Theorem 6 (Theorems 3, 5 of []). ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6</span></a> and its helper variables:</p>
</div>
<div id="A4.SS3.SSS5.p9" class="ltx_para">
<table id="A4.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex82.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex82.m2" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}{\bm{A}}\left({\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}{\bm{q}}_{2}^{\top}\right)\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒒</mi><mn>2</mn><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}{\bm{A}}\left({\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}{\bm{q}}_{2}^{\top}\right)\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex83.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left({\bm{k}}\tilde{{\bm{v}}}^{\top}+\frac{\eta\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\tilde{{\bm{v}}}^{\top}-\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}{\bm{q}}_{2}^{\top}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒒</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left({\bm{k}}\tilde{{\bm{v}}}^{\top}+\frac{\eta\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\tilde{{\bm{v}}}^{\top}-\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}{\bm{q}}_{2}^{\top}{\bm{u}}\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex84.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}-\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}\left(-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}-{\bm{h}}\right){\bm{u}}\tilde{{\bm{v}}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mi>𝒉</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}-\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}\left(-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}-{\bm{h}}\right){\bm{u}}\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex85.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}+\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}\left(\frac{\eta\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\xi}+\frac{\xi-1}{\eta}\right)\tilde{{\bm{v}}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ξ</mi><mo>−</mo><mn>1</mn></mrow><mi>η</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}+\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}\left(\frac{\eta\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\xi}+\frac{\xi-1}{\eta}\right)\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex86.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}+\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2}-\xi}{\xi\eta}\right)\tilde{{\bm{v}}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mo>−</mo><mi>ξ</mi></mrow><mrow><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}+\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2}-\xi}{\xi\eta}\right)\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex87.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}+\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}\left(\frac{\gamma_{2}-\xi}{\xi\eta}\right)\tilde{{\bm{v}}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>−</mo><mi>ξ</mi></mrow><mrow><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}+\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}\left(\frac{\gamma_{2}-\xi}{\xi\eta}\right)\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex88.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}+\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}-\frac{\xi}{\eta\gamma_{2}}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}\left(-\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}+\frac{1}{\eta}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}-\frac{\xi}{\eta\gamma_{2}}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex89.m1" class="ltx_Math" alttext="\displaystyle=-\frac{\tilde{\eta}\xi}{\eta\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{\tilde{\eta}\xi}{\eta\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex90.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\tilde{\eta}\xi}{\eta\gamma_{2}}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{h}}^{\top}+\eta{\bm{A}}{\bm{k}}\right)\tilde{{\bm{v}}}^{\top}\quad\text{by plugging in the expression of ${\bm{p}}_{2}$}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mfrac></mstyle><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo>+</mo><mi>η</mi><mi>𝑨</mi><mi>𝒌</mi><mo>)</mo></mrow><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup><mrow><mtext>by plugging in the expression of </mtext><msub><mi>𝒑</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\tilde{\eta}\xi}{\eta\gamma_{2}}{\bm{\beta}}_{*}^{\top}\left(\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{h}}^{\top}+\eta{\bm{A}}{\bm{k}}\right)\tilde{{\bm{v}}}^{\top}\quad\text{by plugging in the expression of ${\bm{p}}_{2}$}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex91.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\tilde{\eta}\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}\tilde{{\bm{v}}}^{\top}+\frac{\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\tilde{{\bm{Z}}}\quad\text{by $\tilde{\eta}{\bm{k}}\tilde{{\bm{v}}}^{\top}={\bm{A}}^{\dagger}\tilde{\eta}{\bm{u}}\tilde{{\bm{v}}}^{\top}={\bm{A}}^{\dagger}\tilde{{\bm{Z}}}$}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mi>𝜷</mi><msub><mrow></mrow><mo>∗</mo></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒉</mi><msup><mrow></mrow><mo>⊤</mo></msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><msup><mrow></mrow><mo>⊤</mo></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mi>𝜷</mi><msub><mrow></mrow><mo>∗</mo></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝑨</mi><mi>𝑨</mi><msup><mrow></mrow><mo>†</mo></msup><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover><mrow><mtext>by </mtext><mrow><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\tilde{\eta}\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}\tilde{{\bm{v}}}^{\top}+\frac{\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\tilde{{\bm{Z}}}\quad\text{by $\tilde{\eta}{\bm{k}}\tilde{{\bm{v}}}^{\top}={\bm{A}}^{\dagger}\tilde{\eta}{\bm{u}}\tilde{{\bm{v}}}^{\top}={\bm{A}}^{\dagger}\tilde{{\bm{Z}}}$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p9.1" class="ltx_p"><span id="A4.SS3.SSS5.p9.1.1" class="ltx_text">Noting that <math id="A4.SS3.SSS5.p9.m1" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}</annotation></semantics></math> is a scalar, we then introduce <math id="A4.SS3.SSS5.p9.m2" class="ltx_Math" alttext="1={\bm{u}}^{\top}{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">1={\bm{u}}^{\top}{\bm{u}}</annotation></semantics></math> and get that</span></p>
<table id="A4.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex92.m1" class="ltx_Math" alttext="\frac{\tilde{\eta}\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{u}}\tilde{{\bm{v}}}^{\top}=\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}\quad\text{since $\tilde{\eta}{\bm{u}}\tilde{{\bm{v}}}^{\top}=\tilde{{\bm{Z}}}$}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>since </mtext><mrow><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><mo>=</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\tilde{\eta}\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{u}}\tilde{{\bm{v}}}^{\top}=\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}\quad\text{since $\tilde{\eta}{\bm{u}}\tilde{{\bm{v}}}^{\top}=\tilde{{\bm{Z}}}$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p9.2" class="ltx_p"><span id="A4.SS3.SSS5.p9.2.1" class="ltx_text">Thus, the final expression is</span></p>
<table id="A4.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex93.m1" class="ltx_Math" alttext="\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}+\frac{\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\tilde{{\bm{Z}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}+\frac{\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\tilde{{\bm{Z}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p9.3" class="ltx_p"><span id="A4.SS3.SSS5.p9.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.3" class="ltx_text ltx_font_bold"> </span>(Bias Term)<span id="Thmlemma5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para">
<p id="Thmlemma5.p1.1" class="ltx_p"><span id="Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">In the setting of <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have that if <math id="Thmlemma5.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>,</span></p>
<table id="A4.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex94.m1" class="ltx_Math" alttext="\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-{\bm{\beta}}_{int}^{\top}\tilde{{\bm{Z}}}=\left[\tilde{\alpha}_{Z}-\alpha_{Z}+\frac{\xi}{\gamma_{1}}(\alpha_{Z}-\alpha_{A})\right]{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{1}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msubsup><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo>[</mo><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo>+</mo><mrow><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mfrac><mover accent="true"><mi>η</mi><mo>~</mo></mover><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-{\bm{\beta}}_{int}^{\top}\tilde{{\bm{Z}}}=\left[\tilde{\alpha}_{Z}-\alpha_{Z}+\frac{\xi}{\gamma_{1}}(\alpha_{Z}-\alpha_{A})\right]{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{1}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma5.p1.2" class="ltx_p"><span id="Thmlemma5.p1.2.1" class="ltx_text ltx_font_italic">and if <math id="Thmlemma5.p1.m2" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>,</span></p>
<table id="A4.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex95.m1" class="ltx_Math" alttext="\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-{\bm{\beta}}_{int}^{\top}\tilde{{\bm{Z}}}={\bm{\beta}}_{*}^{\top}\left[(\tilde{\alpha}_{Z}-\alpha_{Z}){\bm{I}}+\frac{\xi}{\gamma_{2}}(\alpha_{Z}{\bm{I}}-\alpha_{A}{\bm{A}}{\bm{A}}^{\dagger})\right]\tilde{{\bm{Z}}}-\alpha_{A}\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{2}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msubsup><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>+</mo><mrow><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>−</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mo>+</mo><mrow><mfrac><mover accent="true"><mi>η</mi><mo>~</mo></mover><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-{\bm{\beta}}_{int}^{\top}\tilde{{\bm{Z}}}={\bm{\beta}}_{*}^{\top}\left[(\tilde{\alpha}_{Z}-\alpha_{Z}){\bm{I}}+\frac{\xi}{\gamma_{2}}(\alpha_{Z}{\bm{I}}-\alpha_{A}{\bm{A}}{\bm{A}}^{\dagger})\right]\tilde{{\bm{Z}}}-\alpha_{A}\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{2}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS3.SSS5.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS3.SSS5.p10" class="ltx_para">
<p id="A4.SS3.SSS5.p10.1" class="ltx_p"><span id="A4.SS3.SSS5.p10.1.1" class="ltx_text">To simplify the bias term, we first need the following expansion:</span></p>
<table id="A4.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex96.m1" class="ltx_Math" alttext="\displaystyle\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-{\bm{\beta}}_{int}^{\top}\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msubsup><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-{\bm{\beta}}_{int}^{\top}\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex96.m2" class="ltx_Math" alttext="\displaystyle=\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-({\bm{\beta}}_{*}^{\top}(\alpha_{z}{\bm{Z}}+\alpha_{A}{\bm{A}})+{\bm{\varepsilon}}^{\top})({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi></mrow><mo>+</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-({\bm{\beta}}_{*}^{\top}(\alpha_{z}{\bm{Z}}+\alpha_{A}{\bm{A}})+{\bm{\varepsilon}}^{\top})({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex97.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\alpha_{z}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}-\alpha_{A}{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}-{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msub><mi>α</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mo>−</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\alpha}_{z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\alpha_{z}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}-\alpha_{A}{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}-{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p10.2" class="ltx_p"><span id="A4.SS3.SSS5.p10.2.1" class="ltx_text">From Lemmas <a href="#Thmlemma1" title="Lemma 1. ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, <a href="#Thmlemma3" title="Lemma 3. ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, <a href="#Thmlemma4" title="Lemma 4. ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we get simplified expressions for <math id="A4.SS3.SSS5.p10.m1" class="ltx_Math" alttext="{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}</annotation></semantics></math>, <math id="A4.SS3.SSS5.p10.m2" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}\tilde{{\bm{Z}}}</annotation></semantics></math>, <math id="A4.SS3.SSS5.p10.m3" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}</annotation></semantics></math> and plug them in. For <math id="A4.SS3.SSS5.p10.m4" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, we get</span></p>
<table id="A4.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex98.m1" class="ltx_Math" alttext="\displaystyle\tilde{\alpha}_{Z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\alpha_{Z}\left(1-\frac{\xi}{\gamma_{1}}\right){\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\alpha_{A}\frac{\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{1}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>η</mi><mo>~</mo></mover><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\alpha}_{Z}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\alpha_{Z}\left(1-\frac{\xi}{\gamma_{1}}\right){\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}-\alpha_{A}\frac{\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{1}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
