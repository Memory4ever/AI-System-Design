<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.3" class="ltx_text ltx_font_bold"> </span>(Squared Norms of <math id="Thmlemma6.m1" class="ltx_Math" alttext="{\bm{p}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\bm{p}}_{1}</annotation></semantics></math> and <math id="Thmlemma6.m2" class="ltx_Math" alttext="{\bm{p}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\bm{p}}_{2}</annotation></semantics></math>)<span id="Thmlemma6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para">
<p id="Thmlemma6.p1.1" class="ltx_p"><span id="Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">Recall <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="{\bm{p}}_{1}=-\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}^{\top}-\eta{\bm{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐩</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐤</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐭</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐤</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{p}}_{1}=-\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}^{\top}-\eta{\bm{k}}</annotation></semantics></math> and <math id="Thmlemma6.p1.m2" class="ltx_Math" alttext="{\bm{p}}_{2}=-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}-\eta{\bm{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐩</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐬</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐡</mi></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐤</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{p}}_{2}=-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}-\eta{\bm{k}}</annotation></semantics></math>.</span></p>
<ol id="A4.I2" class="ltx_enumerate">
<li id="A4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A4.I2.i1.p1" class="ltx_para">
<p id="A4.I2.i1.p1.1" class="ltx_p"><math id="A4.I2.i1.p1.m1" class="ltx_Math" alttext="\displaystyle\|{\bm{p}}_{1}\|^{2}=\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi^{2}}\gamma_{1}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|{\bm{p}}_{1}\|^{2}=\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi^{2}}\gamma_{1}.</annotation></semantics></math></p>
</div></li>
<li id="A4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A4.I2.i2.p1" class="ltx_para">
<p id="A4.I2.i2.p1.1" class="ltx_p"><math id="A4.I2.i2.p1.m1" class="ltx_Math" alttext="\|{\bm{p}}_{2}\|^{2}=\frac{\eta^{4}\|{\bm{s}}\|^{4}}{\xi^{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{2\eta^{3}\|{\bm{s}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta^{2}\|{\bm{k}}\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mrow><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\|{\bm{p}}_{2}\|^{2}=\frac{\eta^{4}\|{\bm{s}}\|^{4}}{\xi^{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{2\eta^{3}\|{\bm{s}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta^{2}\|{\bm{k}}\|^{2}</annotation></semantics></math><span id="A4.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="A4.SS3.SSS5.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS3.SSS5.p13" class="ltx_para">
<p id="A4.SS3.SSS5.p13.1" class="ltx_p"><span id="A4.SS3.SSS5.p13.1.1" class="ltx_text">For <math id="A4.SS3.SSS5.p13.m1" class="ltx_Math" alttext="{\bm{p}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\bm{p}}_{1}</annotation></semantics></math>, we have</span></p>
<table id="A4.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex102.m1" class="ltx_Math" alttext="\displaystyle\|{\bm{p}}_{1}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\|{\bm{p}}_{1}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex102.m2" class="ltx_Math" alttext="\displaystyle=\left(-\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}-\eta{\bm{k}}\right)\left(-\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}^{\top}-\eta{\bm{k}}^{\top}\right)=\left(\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}\right)^{2}\|{\bm{t}}\|^{2}+2\frac{\eta^{3}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}{\bm{k}}+\eta^{2}\|{\bm{k}}\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒕</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(-\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}-\eta{\bm{k}}\right)\left(-\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}^{\top}-\eta{\bm{k}}^{\top}\right)=\left(\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}\right)^{2}\|{\bm{t}}\|^{2}+2\frac{\eta^{3}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}{\bm{k}}+\eta^{2}\|{\bm{k}}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p13.2" class="ltx_p"><span id="A4.SS3.SSS5.p13.2.1" class="ltx_text">Using <math id="A4.SS3.SSS5.p13.m2" class="ltx_Math" alttext="{\bm{t}}{\bm{k}}=\bm{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{t}}{\bm{k}}=\bm{0}</annotation></semantics></math> yields the first result, which we can further simplify as</span></p>
<table id="A4.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex103.m1" class="ltx_Math" alttext="\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi^{2}}\left(\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{t}}\|^{2}+\xi^{2}\right)=\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi^{2}}\gamma_{1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi^{2}}\left(\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{t}}\|^{2}+\xi^{2}\right)=\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi^{2}}\gamma_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS3.SSS5.p14" class="ltx_para ltx_noindent">
<p id="A4.SS3.SSS5.p14.1" class="ltx_p">For <math id="A4.SS3.SSS5.p14.m1" class="ltx_Math" alttext="{\bm{p}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝒑</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\bm{p}}_{2}</annotation></semantics></math>, similarly, we have</p>
<table id="A4.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex104.m1" class="ltx_Math" alttext="\displaystyle\|{\bm{p}}_{2}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\|{\bm{p}}_{2}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex104.m2" class="ltx_Math" alttext="\displaystyle=\left(-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{h}}{\bm{A}}^{\dagger\top}-\eta{\bm{k}}^{\top}\right)\left(-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}-\eta{\bm{k}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{h}}{\bm{A}}^{\dagger\top}-\eta{\bm{k}}^{\top}\right)\left(-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}-\eta{\bm{k}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex105.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta^{4}\|{\bm{s}}\|^{4}}{\xi^{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{2\eta^{3}\|{\bm{s}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta^{2}\|{\bm{k}}\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta^{4}\|{\bm{s}}\|^{4}}{\xi^{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{2\eta^{3}\|{\bm{s}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta^{2}\|{\bm{k}}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.SSS5.p14.2" class="ltx_p">∎</p>
</div>
</div>
<div id="Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmlemma7.3" class="ltx_text ltx_font_bold"> </span>(Squared Norms of <math id="Thmlemma7.m1" class="ltx_Math" alttext="{\bm{q}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝒒</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\bm{q}}_{1}</annotation></semantics></math> and <math id="Thmlemma7.m2" class="ltx_Math" alttext="{\bm{q}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝒒</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\bm{q}}_{2}</annotation></semantics></math>)<span id="Thmlemma7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma7.p1" class="ltx_para">
<p id="Thmlemma7.p1.1" class="ltx_p"><span id="Thmlemma7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma7.p1.m1" class="ltx_Math" alttext="{\bm{q}}_{1}^{\top}=-\frac{\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}-{\bm{h}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐪</mi><mn>1</mn><mo>⊤</mo></msubsup><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐭</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐤</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>†</mo></msup></mrow></mrow><mo>−</mo><mi>𝐡</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{q}}_{1}^{\top}=-\frac{\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}-{\bm{h}}</annotation></semantics></math> and <math id="Thmlemma7.p1.m2" class="ltx_Math" alttext="{\bm{q}}_{2}^{\top}=-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}-{\bm{h}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐪</mi><mn>2</mn><mo>⊤</mo></msubsup><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐡</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐬</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mi>𝐡</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{q}}_{2}^{\top}=-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}-{\bm{h}}</annotation></semantics></math>.</span></p>
<ol id="A4.I3" class="ltx_enumerate">
<li id="A4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A4.I3.i1.p1" class="ltx_para">
<p id="A4.I3.i1.p1.1" class="ltx_p"><math id="A4.I3.i1.p1.m1" class="ltx_Math" alttext="\displaystyle\|{\bm{q}}_{1}\|^{2}=\frac{\eta^{2}\|{\bm{t}}\|^{4}}{\xi^{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}+\frac{2\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\|{\bm{h}}\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒒</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|{\bm{q}}_{1}\|^{2}=\frac{\eta^{2}\|{\bm{t}}\|^{4}}{\xi^{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}+\frac{2\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\|{\bm{h}}\|^{2}.</annotation></semantics></math></p>
</div></li>
<li id="A4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A4.I3.i2.p1" class="ltx_para">
<p id="A4.I3.i2.p1.1" class="ltx_p"><math id="A4.I3.i2.p1.m1" class="ltx_Math" alttext="\|{\bm{q}}_{2}\|^{2}=\frac{\|{\bm{h}}\|^{2}}{\xi^{2}}\gamma_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒒</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msup><mi>ξ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|{\bm{q}}_{2}\|^{2}=\frac{\|{\bm{h}}\|^{2}}{\xi^{2}}\gamma_{2}.</annotation></semantics></math></p>
</div></li>
</ol>
</div>
</div>
<div id="A4.SS3.SSS5.8" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS3.SSS5.p15" class="ltx_para">
<p id="A4.SS3.SSS5.p15.1" class="ltx_p"><span id="A4.SS3.SSS5.p15.1.1" class="ltx_text">Similar to Lemma <a href="#Thmlemma6" title="Lemma 6 (Squared Norms of 𝒑_1 and 𝒑_2). ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we directly expand the two terms:</span></p>
<table id="A4.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex106.m1" class="ltx_Math" alttext="\displaystyle\|{\bm{q}}_{1}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒒</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\|{\bm{q}}_{1}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex106.m2" class="ltx_Math" alttext="\displaystyle=\left(-\frac{\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}-{\bm{h}}\right)\left(-\frac{\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{A}}^{\dagger\top}{\bm{k}}-{\bm{h}}^{\top}\right)=\frac{\eta^{2}\|{\bm{t}}\|^{4}}{\xi^{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}+\frac{2\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\|{\bm{h}}\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>−</mo><mi>𝒉</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow></mrow><mo>−</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(-\frac{\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}-{\bm{h}}\right)\left(-\frac{\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{A}}^{\dagger\top}{\bm{k}}-{\bm{h}}^{\top}\right)=\frac{\eta^{2}\|{\bm{t}}\|^{4}}{\xi^{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}+\frac{2\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\|{\bm{h}}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex107.m1" class="ltx_Math" alttext="\displaystyle\|{\bm{q}}_{2}\|^{2}=\left(-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}-{\bm{h}}\right)\left(-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}-{\bm{h}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒒</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mi>𝒉</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi></mrow></mrow><mo>−</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|{\bm{q}}_{2}\|^{2}=\left(-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}-{\bm{h}}\right)\left(-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}-{\bm{h}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex107.m2" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\eta^{2}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\xi^{2}}+\|{\bm{h}}\|^{2}\quad\text{since ${\bm{h}}{\bm{s}}=\bm{0}$}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝒉</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mrow><mtext>since </mtext><mrow><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi></mrow><mo>=</mo><mn>𝟎</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta^{2}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\xi^{2}}+\|{\bm{h}}\|^{2}\quad\text{since ${\bm{h}}{\bm{s}}=\bm{0}$}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex108.m1" class="ltx_Math" alttext="\displaystyle=\frac{\|{\bm{h}}\|^{2}(\eta^{2}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{2}+\xi^{2})}{\xi^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\|{\bm{h}}\|^{2}(\eta^{2}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{2}+\xi^{2})}{\xi^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex109.m1" class="ltx_Math" alttext="\displaystyle=\frac{\|{\bm{h}}\|^{2}}{\xi^{2}}\gamma_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\|{\bm{h}}\|^{2}}{\xi^{2}}\gamma_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
