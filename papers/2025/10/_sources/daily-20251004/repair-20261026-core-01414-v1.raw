<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex101.m2" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}\left[(\tilde{\alpha}_{Z}-\alpha_{Z}){\bm{I}}+\frac{\xi}{\gamma_{2}}(\alpha_{Z}{\bm{I}}-\alpha_{A}{\bm{A}}{\bm{A}}^{\dagger})\right]\tilde{{\bm{Z}}}-\alpha_{A}\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{2}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><mo>−</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>η</mi><mo>~</mo></mover><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}\left[(\tilde{\alpha}_{Z}-\alpha_{Z}){\bm{I}}+\frac{\xi}{\gamma_{2}}(\alpha_{Z}{\bm{I}}-\alpha_{A}{\bm{A}}{\bm{A}}^{\dagger})\right]\tilde{{\bm{Z}}}-\alpha_{A}\frac{\eta\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{2}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{2}\tilde{{\bm{v}}}^{\top}.</annotation></semantics></math></td>
