<span id="S1.T1.6.12.1.1.1" class="ltx_p"><math id="S1.T1.m53" class="ltx_Math" alttext="\theta^{2}=\gamma\tau^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\theta^{2}=\gamma\tau^{2}</annotation></semantics></math></span>
</span></td>
<td id="S1.T1.6.12.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 5.0pt;">
<span id="S1.T1.6.12.2.1" class="ltx_inline-block ltx_align_top" style="width:96.7pt;">
<span id="S1.T1.6.12.2.1.1" class="ltx_p ltx_align_center"><math id="S1.T1.m54" class="ltx_Math" alttext="\gamma\tau^{2}=o_{c}(1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo>=</mo><mrow><msub><mi>o</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma\tau^{2}=o_{c}(1)</annotation></semantics></math></span>
</span></td>
<td id="S1.T1.6.12.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 5.0pt;">
<span id="S1.T1.6.12.3.1" class="ltx_inline-block ltx_align_top" style="width:68.3pt;">
<span id="S1.T1.6.12.3.1.1" class="ltx_p ltx_align_center"><math id="S1.T1.m55" class="ltx_Math" alttext="\gamma\tau^{2}=\Theta_{c}(1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo>=</mo><mrow><msub><mi mathvariant="normal">Θ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma\tau^{2}=\Theta_{c}(1)</annotation></semantics></math></span>
</span></td>
<td id="S1.T1.6.12.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 5.0pt;">
<span id="S1.T1.6.12.4.1" class="ltx_inline-block ltx_align_top" style="width:139.4pt;">
<span id="S1.T1.6.12.4.1.1" class="ltx_p ltx_align_center"><math id="S1.T1.m56" class="ltx_Math" alttext="\gamma\tau^{2}=\omega_{c}(1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo>=</mo><mrow><msub><mi>ω</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma\tau^{2}=\omega_{c}(1)</annotation></semantics></math></span>
</span></td></tr>
<tr id="S1.T1.6.13" class="ltx_tr">
<td id="S1.T1.6.13.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S1.T1.6.13.1.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S1.T1.6.13.1.1.1" class="ltx_p"><math id="S1.T1.m57" class="ltx_Math" alttext="\theta^{2}=d\tau^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\theta^{2}=d\tau^{2}</annotation></semantics></math></span>
</span></td>
<td id="S1.T1.6.13.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S1.T1.6.13.2.1" class="ltx_inline-block ltx_align_top" style="width:96.7pt;">
<span id="S1.T1.6.13.2.1.1" class="ltx_p ltx_align_center"><math id="S1.T1.m58" class="ltx_Math" alttext="\tau^{2}=o_{c}(1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo>=</mo><mrow><msub><mi>o</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau^{2}=o_{c}(1)</annotation></semantics></math></span>
</span></td>
<td id="S1.T1.6.13.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S1.T1.6.13.3.1" class="ltx_inline-block ltx_align_top" style="width:68.3pt;">
<span id="S1.T1.6.13.3.1.1" class="ltx_p ltx_align_center"><math id="S1.T1.m59" class="ltx_Math" alttext="\tau^{2}=\Theta_{c}(1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo>=</mo><mrow><msub><mi mathvariant="normal">Θ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau^{2}=\Theta_{c}(1)</annotation></semantics></math></span>
</span></td>
<td id="S1.T1.6.13.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S1.T1.6.13.4.1" class="ltx_inline-block ltx_align_top" style="width:139.4pt;">
<span id="S1.T1.6.13.4.1.1" class="ltx_p ltx_align_center">Never</span>
</span></td></tr>
