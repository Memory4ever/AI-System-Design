<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex99.m1" class="ltx_Math" alttext="\displaystyle=\ " display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex99.m2" class="ltx_Math" alttext="\displaystyle\left[\tilde{\alpha}_{Z}-\alpha_{Z}+\frac{\xi}{\gamma_{1}}(\alpha_{Z}-\alpha_{A})\right]{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{1}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>[</mo><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒁</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>η</mi><mo>~</mo></mover><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left[\tilde{\alpha}_{Z}-\alpha_{Z}+\frac{\xi}{\gamma_{1}}(\alpha_{Z}-\alpha_{A})\right]{\bm{\beta}}_{*}^{\top}\tilde{{\bm{Z}}}+\frac{\tilde{\eta}}{\eta}\frac{\xi}{\gamma_{1}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}.</annotation></semantics></math></td>
