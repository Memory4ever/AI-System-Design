<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex57.m2" class="ltx_Math" alttext="\displaystyle{\bm{\varepsilon}}^{\top}\left(-\frac{\tilde{\eta}}{\eta}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}+\frac{\tilde{\eta}}{\eta}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}-\frac{\tilde{\eta}\xi}{\eta\gamma_{1}}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>η</mi><mo>~</mo></mover><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>η</mi><mo>~</mo></mover><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>η</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒗</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\varepsilon}}^{\top}\left(-\frac{\tilde{\eta}}{\eta}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}+\frac{\tilde{\eta}}{\eta}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}-\frac{\tilde{\eta}\xi}{\eta\gamma_{1}}{\bm{p}}_{1}\tilde{{\bm{v}}}^{\top}\right)</annotation></semantics></math></td>
