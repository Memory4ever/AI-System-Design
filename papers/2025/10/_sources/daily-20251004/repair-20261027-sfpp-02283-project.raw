  <style>
    /* Collapsed container */
    #toc {
      position: fixed;
      top: 80px;
      left: 20px;
      width: 56px; /* collapsed width */
      padding: 8px;
      background: rgba(252, 232, 236, 0.18);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-radius: 16px;
      box-shadow: 0 10px 24px rgba(0,0,0,0.16);
      font-family: system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
      z-index: 999;
      overflow: hidden;
      transition: width .25s ease, padding .25s ease, box-shadow .25s ease;
    }
  
    /* Expand on hover/focus/touch-open */
    #toc:hover,
    #toc:focus-within,
    #toc.open {
      width: 260px;
      padding: 12px;
      box-shadow: 0 14px 32px rgba(0,0,0,0.18);
    }
  
    .toc-header {
      font-weight: 700;
      font-size: 0.95rem;
      color: #1f2937;
      line-height: 1.2;
      white-space: nowrap;
      text-align: center;
      user-select: none;
      cursor: pointer;
    }
  
    /* --- CSS Arrow --- */
    .toc-arrow {
      display: inline-block;
      width: 16px;
      height: 16px;
      margin-top: 4px;
      position: relative;
    }
    .toc-arrow::before {
      content: '';
      position: absolute;
      width: 100%;
      height: 100%;
      border-width: 0 2px 2px 0;
      border-style: solid;
      border-color: #1f2937;
      box-sizing: border-box;
      transform: rotate(45deg); /* down */
      transition: transform .25s ease;
    }
    #toc:hover .toc-arrow::before,
    #toc:focus-within .toc-arrow::before,
    #toc.open .toc-arrow::before {
      transform: rotate(-135deg); /* up */
    }
  
    #tocContent {
      list-style: none;
      padding: 6px 0 0 0;
      margin: 0;
      opacity: 0;
      max-height: 0;
      transition: opacity .18s ease .08s, max-height .18s ease .08s;
    }
    #toc:hover #tocContent,
    #toc:focus-within #tocContent,
    #toc.open #tocContent {
      opacity: 1;
      max-height: 80vh;
    }
  
    #tocContent li { margin: 4px 0; }
  
    #tocContent a {
      display: block;
      padding: 8px 12px;
      text-decoration: none;
      color: #111827;
      border-radius: 10px;
      background: transparent;
      transition: transform .15s ease, background .15s ease, color .15s ease;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #tocContent a:hover,
    #tocContent a:focus-visible {
      background: rgba(0,123,255,0.12);
      color: #0a58ca;
      transform: translateX(4px);
      outline: none;
    }

    /* Default pink style for Compare with LongLive link */
#tocContent a[href="#compare_with_longlive"] {
  background: rgba(255, 192, 203, 0.3); /* light pink background */
  color: #ff7eb3; /* a stronger pink text color */
  font-weight: 600;
}
#tocContent a[href="#compare_with_longlive"]:hover,
#tocContent a[href="#compare_with_longlive"]:focus-visible {
  background: rgba(255, 192, 203, 0.6);
  color: #ff7eb3;
}
  
    @media (prefers-reduced-motion: reduce) {
      #toc, #tocContent a, .toc-arrow::before { transition: none !important; }
    }
    @supports not (backdrop-filter: blur(10px)) {
      #toc { background: rgba(255,255,255,0.9); }
    }
  
    /* --- Force-fold when scrolling: the `.folded` class wins regardless of hover/focus --- */
    /* Place AFTER the hover/open rules so it overrides them */
    #toc.folded {
      width: 56px !important;
      padding: 8px !important;
      box-shadow: 0 10px 24px rgba(0,0,0,0.16) !important;
    }
    #toc.folded #tocContent {
      opacity: 0 !important;
      max-height: 0 !important;
    }
    #toc.folded .toc-arrow::before {
      transform: rotate(45deg) !important; /* point down */
    }
  </style>
  
  <script>
    (function () {
      const toc = document.getElementById('toc');
      if (!toc) return;
  
      const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
  
      // Touch: tap to open, tap outside to close
      if (isTouch) {
        toc.addEventListener('touchstart', () => toc.classList.add('open'), { passive: true });
        document.addEventListener('touchstart', (e) => {
          if (!toc.contains(e.target)) toc.classList.remove('open');
        }, { passive: true });
      }
  
      // Also collapse if mouse leaves while .open is set (extra safety)
      toc.addEventListener('mouseleave', () => toc.classList.remove('open'));
  
      // Smooth scroll + center + auto-collapse after link click
      document.querySelectorAll("#tocContent a").forEach(link => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
  
          const targetId = link.getAttribute("href").substring(1);
          const target = document.getElementById(targetId);
          if (!target) return;
  
          target.scrollIntoView({ behavior: "smooth", block: "center" });
  
          setTimeout(() => {
            const hadTabIndex = target.hasAttribute('tabindex');
            if (!hadTabIndex) target.setAttribute('tabindex', '-1');
            target.focus({ preventScroll: true });
            setTimeout(() => { if (!hadTabIndex) target.removeAttribute('tabindex'); }, 800);
  
            toc.classList.remove('open');
            toc.classList.add('folded'); // ensure folded after click-initiated scroll
            link.blur();
            toc.blur();
            if (document.activeElement && toc.contains(document.activeElement)) {
              document.activeElement.blur();
            }
          }, 50);
        });
      });
  
      // --- NEW: Auto-fold on scroll (mouse wheel, trackpad, or touch) ---
      let scrollFoldTimer = null;
      const FOLD_RELEASE_MS = 250; // how long after scrolling stops to release the fold
  
      function forceFoldOnScroll() {
        // Remove any programmatic "open" and force the folded state
        toc.classList.remove('open');
        toc.classList.add('folded');
  
        // Clear & set a timer to release the forced fold shortly after scrolling stops
        if (scrollFoldTimer) clearTimeout(scrollFoldTimer);
        scrollFoldTimer = setTimeout(() => {
          toc.classList.remove('folded');
        }, FOLD_RELEASE_MS);
      }
  
      // Wheel / scroll
      window.addEventListener('scroll', forceFoldOnScroll, { passive: true });
      window.addEventListener('wheel', forceFoldOnScroll, { passive: true });
  
      // Touch move (for iOS/Android momentum scrolling)
      window.addEventListener('touchmove', forceFoldOnScroll, { passive: true });
  
      // Optional: clicking the header toggles open state on desktop
      const header = toc.querySelector('.toc-header');
      if (header) {
        header.addEventListener('click', () => {
          if (toc.classList.contains('folded')) {
            // If currently forced-folded, allow opening and clear the fold
            toc.classList.remove('folded');
            toc.classList.add('open');
          } else {
            toc.classList.toggle('open');
          }
        });
      }
    })();
  </script>
  
  
  

