<td id="A4.T2.8.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">0.848</td>
<td id="A4.T2.8.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">0.933</td>
<td id="A4.T2.8.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">0.889</td></tr>
<tr id="A4.T2.8.1.3" class="ltx_tr">
<th id="A4.T2.8.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">Completion</th>
<td id="A4.T2.8.1.3.2" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">77.08%</td>
