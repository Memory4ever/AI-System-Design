<tbody class="ltx_tbody">
<tr id="A4.T2.8.1.2" class="ltx_tr">
<th id="A4.T2.8.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:-0.75pt;padding-bottom:-0.75pt;" rowspan="6"><span id="A4.T2.8.1.2.1.1" class="ltx_text">GPT-4.1</span></th>
<th id="A4.T2.8.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:-0.75pt;padding-bottom:-0.75pt;" rowspan="2"><span id="A4.T2.8.1.2.2.1" class="ltx_text">all_step</span></th>
<th id="A4.T2.8.1.2.3" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">BGD</th>
