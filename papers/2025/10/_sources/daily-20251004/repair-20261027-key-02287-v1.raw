<td id="S3.T3.st2.3.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T3.st2.3.7.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">16.0</span></td>
