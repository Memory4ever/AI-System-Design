{"data":{"id":"10.48550/arxiv.2510.01607","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01607","prefix":"10.48550","suffix":"arxiv.2510.01607","identifiers":[{"identifier":"2510.01607","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.01607"}],"creators":[{"name":"Zeng, Qiyuan","nameType":"Personal","givenName":"Qiyuan","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Chengmeng","nameType":"Personal","givenName":"Chengmeng","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"John, Jude St.","nameType":"Personal","givenName":"Jude St.","familyName":"John","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Zhongyi","nameType":"Personal","givenName":"Zhongyi","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Wen, Junjie","nameType":"Personal","givenName":"Junjie","familyName":"Wen","affiliation":[],"nameIdentifiers":[]},{"name":"Feng, Guorui","nameType":"Personal","givenName":"Guorui","familyName":"Feng","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Yichen","nameType":"Personal","givenName":"Yichen","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Yi","nameType":"Personal","givenName":"Yi","familyName":"Xu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ActiveUMI: Robotic Manipulation with Active Perception from Robot-Free Human Demonstrations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:44:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:21:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We present ActiveUMI, a framework for a data collection system that transfers in-the-wild human demonstrations to robots capable of complex bimanual manipulation. ActiveUMI couples a portable VR teleoperation kit with sensorized controllers that mirror the robot's end-effectors, bridging human-robot kinematics via precise pose alignment. To ensure mobility and data quality, we introduce several key techniques, including immersive 3D model rendering, a self-contained wearable computer, and efficient calibration methods. ActiveUMI's defining feature is its capture of active, egocentric perception. By recording an operator's deliberate head movements via a head-mounted display, our system learns the crucial link between visual attention and manipulation. We evaluate ActiveUMI on six challenging bimanual tasks. Policies trained exclusively on ActiveUMI data achieve an average success rate of 70\\% on in-distribution tasks and demonstrate strong generalization, retaining a 56\\% success rate when tested on novel objects and in new environments. Our results demonstrate that portable data collection systems, when coupled with learned active perception, provide an effective and scalable pathway toward creating generalizable and highly capable real-world robot policies.","descriptionType":"Abstract"},{"description":"technique report. The website is available at https://activeumi.github.io","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.01607","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:53:21.000Z","registered":"2025-10-03T01:53:22.000Z","published":"2025","updated":"2025-10-03T01:53:22.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.01607","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}