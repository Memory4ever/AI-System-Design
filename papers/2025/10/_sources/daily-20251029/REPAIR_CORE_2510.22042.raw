<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">(a) </span>Synthetic emotion dataset.</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A5.T6.st2" class="ltx_table ltx_figure_panel ltx_align_center">
<div id="A5.T6.st2.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:397.5pt;height:270.7pt;vertical-align:-131.9pt;"><span class="ltx_transformed_inner" style="transform:translate(55.7pt,-38.0pt) scale(1.38966988481396,1.38966988481396) ;">
<table id="A5.T6.st2.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A5.T6.st2.2.1.1" class="ltx_tr">
<th id="A5.T6.st2.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t">Model</th>
<th id="A5.T6.st2.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">PC</th>
<th id="A5.T6.st2.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Avg. Spearman</th>
<th id="A5.T6.st2.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Avg. Kendall</th></tr>
</thead>
