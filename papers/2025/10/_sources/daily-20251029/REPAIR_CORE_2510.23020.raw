<td id="S5.T2.6.13.2" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;"><span id="S5.T2.6.13.2.1" class="ltx_text ltx_font_bold">53.1</span></td>
<td id="S5.T2.6.13.3" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;"><span id="S5.T2.6.13.3.1" class="ltx_text ltx_font_bold">65.4</span></td>
<td id="S5.T2.6.13.4" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;"><span id="S5.T2.6.13.4.1" class="ltx_text ltx_font_bold">1.37</span></td>
