<td id="S5.T2.6.5.5" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">37.5</td></tr>
<tr id="S5.T2.6.6" class="ltx_tr">
<td id="S5.T2.6.6.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.7pt;padding-right:5.7pt;">Base</td>
<td id="S5.T2.6.6.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:5.7pt;padding-right:5.7pt;" rowspan="2"><span id="S5.T2.6.6.2.1" class="ltx_text">Pixart-<math id="S5.T2.m12" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math></span></td>
<td id="S5.T2.6.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.7pt;padding-right:5.7pt;">42.0</td>
