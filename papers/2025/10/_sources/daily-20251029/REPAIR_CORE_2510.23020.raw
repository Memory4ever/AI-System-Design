<span id="S2.T1.8.1.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="S2.T1.8.1.5.2.1.1" class="ltx_tr">
<span id="S2.T1.8.1.5.2.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.1pt;padding-right:1.1pt;">Maximum</span></span>
