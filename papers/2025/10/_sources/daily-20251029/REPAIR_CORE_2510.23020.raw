<td id="S5.T2.6.3.2" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">26.8</td>
<td id="S5.T2.6.3.3" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">28.0</td>
<td id="S5.T2.6.3.4" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">2.90</td>
<td id="S5.T2.6.3.5" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">36.6</td></tr>
<tr id="S5.T2.6.4" class="ltx_tr">
<td id="S5.T2.6.4.1" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">Composable</td>
<td id="S5.T2.6.4.2" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">26.5</td>
