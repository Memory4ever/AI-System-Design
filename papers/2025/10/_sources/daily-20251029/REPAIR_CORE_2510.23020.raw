<td id="S5.T2.6.7.4" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;"><span id="S5.T2.6.7.4.1" class="ltx_text ltx_font_bold">2.09</span></td>
<td id="S5.T2.6.7.5" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;"><span id="S5.T2.6.7.5.1" class="ltx_text ltx_font_bold">52.9</span></td></tr>
<tr id="S5.T2.6.8" class="ltx_tr">
<td id="S5.T2.6.8.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.7pt;padding-right:5.7pt;">Base</td>
<td id="S5.T2.6.8.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:5.7pt;padding-right:5.7pt;" rowspan="4"><span id="S5.T2.6.8.2.1" class="ltx_text">SD3</span></td>
<td id="S5.T2.6.8.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.7pt;padding-right:5.7pt;">53.3</td>
<td id="S5.T2.6.8.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.7pt;padding-right:5.7pt;">66.9</td>
<td id="S5.T2.6.8.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.7pt;padding-right:5.7pt;">1.52</td>
<td id="S5.T2.6.8.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.7pt;padding-right:5.7pt;">58.0</td></tr>
<tr id="S5.T2.6.9" class="ltx_tr">
<td id="S5.T2.6.9.1" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">Negative Prompt</td>
<td id="S5.T2.6.9.2" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">50.5</td>
<td id="S5.T2.6.9.3" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">63.4</td>
<td id="S5.T2.6.9.4" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">1.66</td>
