</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 13.78)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:51.41em;--ltx-fo-depth:0em;font-size:10pt;" height="711.4" overflow="visible" transform="matrix(1 0 0 -1 0 711.4)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A4.SS3.p1.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:36.62em;">
<span id="A4.SS3.p1.pic1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.SS3.p1.pic1.p1.pic1" class="ltx_picture" color="#000000" height="111.51" overflow="visible" version="1.1" viewBox="0 0 506.69 111.51" width="506.69"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,111.51) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 105.6 C 0 108.86 2.64 111.51 5.91 111.51 L 500.79 111.51 C 504.05 111.51 506.69 108.86 506.69 105.6 L 506.69 5.91 C 506.69 2.64 504.05 0 500.79 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFE6;" fill="#FFFFE6" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 87.55 L 504.72 87.55 L 504.72 5.91 C 504.72 3.73 502.96 1.97 500.79 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 96.15)"><foreignObject style="--ltx-fo-width:33.49em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="463.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
