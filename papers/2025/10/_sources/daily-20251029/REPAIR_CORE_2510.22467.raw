<th id="S4.T3.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T3.1.2.1.1" class="ltx_text ltx_font_bold">GradLite (Full)</span></th>
<td id="S4.T3.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.1.2.2.1" class="ltx_text ltx_font_bold">66.8</span></td></tr>
<tr id="S4.T3.1.3" class="ltx_tr">
