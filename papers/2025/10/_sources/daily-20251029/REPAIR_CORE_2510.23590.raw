<td id="A4.T5.5.1.27.2" class="ltx_td ltx_align_center ltx_border_bb">cosine w/min_lr=1e-6</td>
<td id="A4.T5.5.1.27.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb">cosine w/min_lr=1e-7</td></tr>
