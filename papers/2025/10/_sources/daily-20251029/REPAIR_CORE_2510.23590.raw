<tr id="A4.T4.5.4" class="ltx_tr">
<td id="A4.T4.5.4.1" class="ltx_td ltx_align_left">Gravidity (number of pregnancies)</td>
<td id="A4.T4.5.4.2" class="ltx_td ltx_nopad_r ltx_align_left">Int</td></tr>
<tr id="A4.T4.5.5" class="ltx_tr">
