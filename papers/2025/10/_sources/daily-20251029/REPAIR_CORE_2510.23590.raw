<thead class="ltx_thead">
<tr id="S5.T3.8.1.1" class="ltx_tr">
<th id="S5.T3.8.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding-top:0.25pt;padding-bottom:0.25pt;" colspan="2"><span id="S5.T3.8.1.1.1.1" class="ltx_text ltx_font_bold">Task 1:</span> Prefer both young and elderly beneficiaries</th></tr>
</thead>
