<tr id="A4.T4.5.18" class="ltx_tr">
<td id="A4.T4.5.18.1" class="ltx_td ltx_align_left">Education level 2/7 – 1–5th Grade Completed</td>
<td id="A4.T4.5.18.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A4.T4.5.19" class="ltx_tr">
<td id="A4.T4.5.19.1" class="ltx_td ltx_align_left">Education level 3/7 – 6–9th Grade Completed</td>
<td id="A4.T4.5.19.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A4.T4.5.20" class="ltx_tr">
<td id="A4.T4.5.20.1" class="ltx_td ltx_align_left">Education level 4/7 – 10th Grade Passed</td>
<td id="A4.T4.5.20.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A4.T4.5.21" class="ltx_tr">
<td id="A4.T4.5.21.1" class="ltx_td ltx_align_left">Education level 5/7 – 12th Grade Passed</td>
<td id="A4.T4.5.21.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A4.T4.5.22" class="ltx_tr">
<td id="A4.T4.5.22.1" class="ltx_td ltx_align_left">Education level 6/7 – Graduate</td>
<td id="A4.T4.5.22.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A4.T4.5.23" class="ltx_tr">
<td id="A4.T4.5.23.1" class="ltx_td ltx_align_left">Education level 7/7 – Post graduate</td>
<td id="A4.T4.5.23.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
