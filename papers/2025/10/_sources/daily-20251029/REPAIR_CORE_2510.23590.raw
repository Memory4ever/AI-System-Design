<th id="S5.T2.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.5.1.3.1" class="ltx_text" style="font-size:70%;">DrDPO</span></th>
<th id="S5.T2.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.5.1.4.1" class="ltx_text" style="font-size:70%;">DPO-PRO</span></th></tr>
