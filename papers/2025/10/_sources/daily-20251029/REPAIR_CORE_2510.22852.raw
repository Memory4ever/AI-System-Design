FF;--ltx-fg-color:#FFFFFF;" color="#FFFFFF" fill="#FFFFFF" stroke="#FFFFFF"><path style="stroke:none" d="M 45.67 114.17 M 45.67 114.17 L 45.67 125.59 L 57.09 125.59 L 57.09 114.17 Z M 57.09 125.59"></path></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;--ltx-fg-color:#FFFFFF;" color="#FFFFFF" fill="#FFFFFF" stroke="#FFFFFF"><path style="stroke:none" d="M 57.09 114.17 M 57.09 114.17 L 57.09 125.59 L 68.5 125.59 L 68.5 114.17 Z M 68.5 125.59"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill="#87CEFA" stroke="#87CEFA"><path style="stroke:none" d="M 0 102.75 M 0 102.75 L 0 114.17 L 11.42 114.17 L 11.42 102.75 Z M 11.42 114.17"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill="#87CEFA" stroke="#87CEFA"><path style="stroke:none" d="M 11.42 102.75 M 11.42 102.75 L 11.42 114.17 L 22.83 114.17 L 22.83 102.75 Z M 22.83 114.17"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill="#87CEFA" stroke="#87CEFA"><path style="stroke:none" d="M 22.83 102.75 M 22.83 102.75 L 22.83 114.17 L 34.25 114.17 L 34.25 102.75 Z M 34.25 114.17"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill="#87CEFA" stroke="#87CEFA"><path style="stroke:none" d="M 34.25 102.75 M 34.25 102.75 L 34.25 114.17 L 45.67 114.17 L 45.67 102.75 Z M 45.67 114.17"></path></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;--ltx-fg-color:#FFFFFF;" color="#FFFFFF" fill="#FFFFFF" stroke="#FFFFFF"><path style="stroke:none" d="M 45.67 102.75 M 45.67 102.75 L 45.67 114.17 L 57.09 114.17 L 57.09 102.75 Z M 57.09 114.17"></path></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;--ltx-fg-color:#FFFFFF;" color="#FFFFFF" fill="#FFFFFF" stroke="#FFFFFF"><path style="stroke:none" d="M 57.09 102.75 M 57.09 102.75 L 57.09 114.17 L 68.5 114.17 L 68.5 102.75 Z M 68.5 114.17"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill="#87CEFA" stroke="#87CEFA"><path style="stroke:none" d="M 0 91.34 M 0 91.34 L 0 102.75 L 11.42 102.75 L 11.42 91.34 Z M 11.42 102.75"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill="#87CEFA" stroke="#87CEFA"><path style="stroke:none" d="M 11.42 91.34 M 11.42 91.34 L 11.42 102.75 L 22.83 102.75 L 22.83 91.34 Z M 22.83 102.75"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill="#87CEFA" stroke="#87CEFA"><path style="stroke:none" d="M 22.83 91.34 M 22.83 91.34 L 22.83 102.75 L 34.25 102.75 L 34.25 91.34 Z M 34.25 102.75"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill="#87CEFA" stroke="#87CEFA"><path style="stroke:none" d="M 34.25 91.34 M 34.25 91.34 L 34.25 102.75 L 45.67 102.75 L 45.67 91.34 Z M 45.67 102.75"></path></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;--ltx-fg-color:#FFFFFF;" color="#FFFFFF" fill="#FFFFFF" stroke="#FFFFFF"><path style="stroke:none" d="M 45.67 91.34 M 45.67 91.34 L 45.67 102.75 L 57.09 102.75 L 57.09 91.34 Z M 57.09 102.75"></path></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;--ltx-fg-color:#FFFFFF;" color="#FFFFFF" fill="#FFFFFF" stroke="#FFFFFF"><path style="stroke:none" d="M 57.09 91.34 M 57.09 91.34 L 57.09 102.75 L 68.5 102.75 L 68.5 91.34 Z M 68.5 102.75"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill="#87CEFA" stroke="#87CEFA"><path style="stroke:none" d="M 0 79.92 M 0 79.92 L 0 91.34 L 11.42 91.34 L 11.42 79.92 Z M 11.42 91.34"></path></g><g style="--ltx-stroke-color:#87CEFA;--ltx-fill-color:#87CEFA;--ltx-fg-color:#87CEFA;" color="#87CEFA" fill=