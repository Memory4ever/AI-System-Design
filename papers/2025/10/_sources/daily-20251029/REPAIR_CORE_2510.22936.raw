<th id="A1.T9.2.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">0.280</th>
<td id="A1.T9.2.1.3.3" class="ltx_td ltx_align_center">0.167</td>
<td id="A1.T9.2.1.3.4" class="ltx_td ltx_align_center">0.104</td>
<td id="A1.T9.2.1.3.5" class="ltx_td ltx_align_center">0.068</td>
<td id="A1.T9.2.1.3.6" class="ltx_td ltx_align_center">0.137</td>
