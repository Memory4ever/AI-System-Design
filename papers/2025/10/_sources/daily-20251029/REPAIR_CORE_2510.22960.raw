<td id="S4.T1.1.3.3" class="ltx_td ltx_align_center ltx_border_t">9</td>
<td id="S4.T1.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.45</td>
<td id="S4.T1.1.3.5" class="ltx_td ltx_align_center ltx_border_t">70.2</td>
<td id="S4.T1.1.3.6" class="ltx_td ltx_align_center ltx_border_t">40.2</td>
<td id="S4.T1.1.3.7" class="ltx_td ltx_align_center ltx_border_t">86.7</td>
