<tr id="S4.T1.1.4" class="ltx_tr">
<td id="S4.T1.1.4.1" class="ltx_td ltx_align_center ltx_border_rr">Doctor</td>
<td id="S4.T1.1.4.2" class="ltx_td ltx_align_center">6</td>
<td id="S4.T1.1.4.3" class="ltx_td ltx_align_center ltx_border_r">0.30</td>
<td id="S4.T1.1.4.4" class="ltx_td ltx_align_center">83.7</td>
<td id="S4.T1.1.4.5" class="ltx_td ltx_align_center">44.8</td>
