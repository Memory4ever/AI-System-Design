<span id="S4.T1.1.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:30.7pt;height:6.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:30.7pt;transform:translate(0.0pt,0.0pt) rotate(-0deg) ;">
