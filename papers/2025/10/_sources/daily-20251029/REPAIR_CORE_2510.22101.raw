<td id="S6.T9.2.4.2" class="ltx_td ltx_align_center"><math id="S6.T9.m7" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></td>
<td id="S6.T9.2.4.3" class="ltx_td ltx_align_center"><math id="S6.T9.m8" class="ltx_Math" alttext="+0.59\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>0.59</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.59\%</annotation></semantics></math></td></tr>
