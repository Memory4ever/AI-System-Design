<th id="S4.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T2.2.3.1.1" class="ltx_text ltx_font_smallcaps">First Layer</span></th>
<td id="S4.T2.2.3.2" class="ltx_td ltx_align_center"><math id="S4.T2.m1" class="ltx_Math" alttext="-0.3356" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.3356</mn></mrow><annotation encoding="application/x-tex">-0.3356</annotation></semantics></math></td></tr>
<tr id="S4.T2.2.4" class="ltx_tr">
<th id="S4.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T2.2.4.1.1" class="ltx_text ltx_font_smallcaps">Second Layer</span></th>
<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center"><math id="S4.T2.m2" class="ltx_Math" alttext="-0.0296" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.0296</mn></mrow><annotation encoding="application/x-tex">-0.0296</annotation></semantics></math></td></tr>
