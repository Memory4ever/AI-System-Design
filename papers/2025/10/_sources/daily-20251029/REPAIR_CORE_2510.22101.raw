<td id="S4.T4.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T4.m2" class="ltx_Math" alttext="-100\%" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>100</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">-100\%</annotation></semantics></math></td></tr>
