<td id="S4.T3.2.3.2" class="ltx_td ltx_align_center"><math id="S4.T3.m1" class="ltx_Math" alttext="-0.0079" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.0079</mn></mrow><annotation encoding="application/x-tex">-0.0079</annotation></semantics></math></td></tr>
