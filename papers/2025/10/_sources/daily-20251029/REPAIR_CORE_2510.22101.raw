<td id="S6.T9.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T9.m4" class="ltx_Math" alttext="-26.69\%" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>26.69</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">-26.69\%</annotation></semantics></math></td></tr>
<tr id="S6.T9.2.3" class="ltx_tr">
<th id="S6.T9.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S6.T9.2.3.1.1" class="ltx_text ltx_font_smallcaps">NDCG @ 10</span></th>
<td id="S6.T9.2.3.2" class="ltx_td ltx_align_center"><math id="S6.T9.m5" class="ltx_Math" alttext="+5.54\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>5.54</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+5.54\%</annotation></semantics></math></td>
<td id="S6.T9.2.3.3" class="ltx_td ltx_align_center"><math id="S6.T9.m6" class="ltx_Math" alttext="+8.45\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>8.45</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+8.45\%</annotation></semantics></math></td></tr>
