<td id="S4.T2.2.5.2" class="ltx_td ltx_align_center"><math id="S4.T2.m3" class="ltx_Math" alttext="-0.0133" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.0133</mn></mrow><annotation encoding="application/x-tex">-0.0133</annotation></semantics></math></td></tr>
