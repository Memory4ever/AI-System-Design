<td id="S4.T3.2.5.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T3.m3" class="ltx_Math" alttext="-0.0080" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.0080</mn></mrow><annotation encoding="application/x-tex">-0.0080</annotation></semantics></math></td></tr>
