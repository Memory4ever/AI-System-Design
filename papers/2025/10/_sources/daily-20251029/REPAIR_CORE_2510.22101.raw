<td id="S6.T9.2.5.2" class="ltx_td ltx_align_center"><math id="S6.T9.m9" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></td>
