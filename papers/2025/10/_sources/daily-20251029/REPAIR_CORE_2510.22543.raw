<tr id="A2.T1.2.10" class="ltx_tr">
<td id="A2.T1.2.10.1" class="ltx_td ltx_align_left">Max Prompt Length</td>
<td id="A2.T1.2.10.2" class="ltx_td ltx_align_center">5120</td>
<td id="A2.T1.2.10.3" class="ltx_td ltx_align_center">2048</td>
<td id="A2.T1.2.10.4" class="ltx_td ltx_align_center">2048</td></tr>
<tr id="A2.T1.2.11" class="ltx_tr">
<td id="A2.T1.2.11.1" class="ltx_td ltx_align_left">Max Response Length</td>
<td id="A2.T1.2.11.2" class="ltx_td ltx_align_center">8192</td>
<td id="A2.T1.2.11.3" class="ltx_td ltx_align_center">8192</td>
<td id="A2.T1.2.11.4" class="ltx_td ltx_align_center">20480</td></tr>
<tr id="A2.T1.2.12" class="ltx_tr">
<td id="A2.T1.2.12.1" class="ltx_td ltx_align_left">Overlong Buffer Length</td>
<td id="A2.T1.2.12.2" class="ltx_td ltx_align_center">4096</td>
<td id="A2.T1.2.12.3" class="ltx_td ltx_align_center">4096</td>
<td id="A2.T1.2.12.4" class="ltx_td ltx_align_center">4096</td></tr>
