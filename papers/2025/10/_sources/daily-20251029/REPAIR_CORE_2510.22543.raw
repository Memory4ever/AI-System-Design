<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E15Xc.m3" class="ltx_Math" alttext="\displaystyle 2\alpha\gamma\lambda(1-\mu_{\text{GRPO}})+2\gamma(1-\mu_{\text{GRPO}})(\gamma\lambda-\lambda)-2\beta(1+\mu_{\text{GRPO}})\gamma\lambda" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>μ</mi><mtext>GRPO</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>μ</mi><mtext>GRPO</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>μ</mi><mtext>GRPO</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\alpha\gamma\lambda(1-\mu_{\text{GRPO}})+2\gamma(1-\mu_{\text{GRPO}})(\gamma\lambda-\lambda)-2\beta(1+\mu_{\text{GRPO}})\gamma\lambda</annotation></semantics></math></td>
