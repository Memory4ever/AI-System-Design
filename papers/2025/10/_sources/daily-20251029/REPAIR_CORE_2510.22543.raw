<td id="A2.T1.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T1.2.1.3.1" class="ltx_text ltx_font_bold">Baseline &amp; FAPO-7B</span></td>
<td id="A2.T1.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T1.2.1.4.1" class="ltx_text ltx_font_bold">Baseline &amp; FAPO-32B</span></td></tr>
<tr id="A2.T1.2.2" class="ltx_tr">
