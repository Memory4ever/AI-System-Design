<tr id="A1.E15Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E15Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E15Xa.m3" class="ltx_Math" alttext="\displaystyle(1-\beta)(1-\mu_{\text{GRPO}})^{2}+\beta(1+\mu_{\text{GRPO}})^{2}{\color[rgb]{0.5,0.5,0.5}\quad\rightarrow\;\because\gamma=1-\alpha-\beta}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">GRPO</mtext></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">GRPO</mtext></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" rspace="0em" stretchy="false">→</mo><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">∵</mo><mrow><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">γ</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">=</mo><mrow><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">−</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">α</mi><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">−</mo><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">β</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-\beta)(1-\mu_{\text{GRPO}})^{2}+\beta(1+\mu_{\text{GRPO}})^{2}{\color[rgb]{0.5,0.5,0.5}\quad\rightarrow\;\because\gamma=1-\alpha-\beta}</annotation></semantics></math></td>
