<article class="ltx_document ltx_authors_1line">
<h1 class="ltx_title ltx_title_document">FAPO: Flawed-Aware Policy Optimization for Efficient and Reliable Reasoning</h1>
<div class="ltx_authors">
<span class="ltx_creator ltx_role_author">
<span class="ltx_personname">
<br class="ltx_break">
<span id="id1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:127.2pt;">
<span id="id1.1" class="ltx_p ltx_align_center"><span id="id1.1.1" class="ltx_text ltx_font_bold">Yuyang Ding</span></span>
<span id="id1.2" class="ltx_p ltx_align_center">Soochow University</span>
<span id="id1.3" class="ltx_p ltx_align_center">yyding23@stu.suda.edu.cn</span>
</span>
 
