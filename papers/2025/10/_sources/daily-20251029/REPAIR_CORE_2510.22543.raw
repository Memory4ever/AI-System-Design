<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E15X.m2" class="ltx_Math" alttext="\displaystyle{\color[rgb]{0,0.4,0}A}=" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#006600;" mathcolor="#006600">A</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,0.4,0}A}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E15X.m3" class="ltx_Math" alttext="\displaystyle\alpha(1-\mu_{\text{GRPO}})^{2}+\gamma(1-\mu_{\text{GRPO}})^{2}+\beta(1+\mu_{\text{GRPO}})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>μ</mi><mtext>GRPO</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>μ</mi><mtext>GRPO</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>μ</mi><mtext>GRPO</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(1-\mu_{\text{GRPO}})^{2}+\gamma(1-\mu_{\text{GRPO}})^{2}+\beta(1+\mu_{\text{GRPO}})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
