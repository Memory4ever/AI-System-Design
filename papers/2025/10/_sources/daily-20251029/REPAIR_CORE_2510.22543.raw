<span id="A7.p1.pic1.2.27" class="ltx_p"><span id="A7.p1.pic1.2.27.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">- For <math id="A7.p1.pic1.m42" class="ltx_Math" alttext="n=9" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><annotation encoding="application/x-tex">n=9</annotation></semantics></math>:
