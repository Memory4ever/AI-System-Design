<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E14Xe.m3" class="ltx_Math" alttext="\displaystyle\color[rgb]{0,0.4,0}{\displaystyle A}+{\color[rgb]{0.75,0,0.25}B}+{\color[rgb]{0,0,1}C}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#006600;" mathcolor="#006600">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">B</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">C</mi></mrow><annotation encoding="application/x-tex">\displaystyle\color[rgb]{0,0.4,0}{\displaystyle A}+{\color[rgb]{0.75,0,0.25}B}+{\color[rgb]{0,0,1}C}</annotation></semantics></math></td>
