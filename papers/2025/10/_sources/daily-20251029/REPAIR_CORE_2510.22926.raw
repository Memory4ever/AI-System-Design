<td id="S5.T1.3.5.2" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.5.2.1" class="ltx_text" style="font-size:90%;">116.84</span></td>
<td id="S5.T1.3.5.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.5.3.1" class="ltx_text" style="font-size:90%;">4.10</span></td>
