<tr id="A1.T2.5.7" class="ltx_tr">
<td id="A1.T2.5.7.1" class="ltx_td ltx_align_left">Decay Rate <math id="A1.T2.m6" class="ltx_Math" alttext="\beta_{2}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\beta_{2}</annotation></semantics></math></td>
<td id="A1.T2.5.7.2" class="ltx_td ltx_align_left">0.999</td>
<td id="A1.T2.5.7.3" class="ltx_td ltx_align_left">0.999</td>
<td id="A1.T2.5.7.4" class="ltx_td ltx_align_left">0.999</td>
<td id="A1.T2.5.7.5" class="ltx_td ltx_align_left">0.999</td></tr>
<tr id="A1.T2.5.8" class="ltx_tr">
