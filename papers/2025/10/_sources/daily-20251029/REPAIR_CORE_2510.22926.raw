<tr id="A1.T2.5.6" class="ltx_tr">
<td id="A1.T2.5.6.1" class="ltx_td ltx_align_left">Decay Rate <math id="A1.T2.m5" class="ltx_Math" alttext="\beta_{1}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\beta_{1}</annotation></semantics></math></td>
<td id="A1.T2.5.6.2" class="ltx_td ltx_align_left">0.9</td>
<td id="A1.T2.5.6.3" class="ltx_td ltx_align_left">0.9</td>
