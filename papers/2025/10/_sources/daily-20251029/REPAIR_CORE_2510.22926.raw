<td id="S5.T1.3.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.3.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">5.55</span></td></tr>
