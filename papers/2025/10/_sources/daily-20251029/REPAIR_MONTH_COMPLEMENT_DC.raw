Type":"Personal","givenName":"Yue","familyName":"Yang","name":"Yang, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Yu","name":"Yu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufeng","familyName":"Deng","name":"Deng, Yufeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Zhang","name":"Zhang, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunfei","familyName":"Yu","name":"Yu, Yunfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Zhang","name":"Zhang, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxiao","familyName":"He","name":"He, Yuxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zengke","familyName":"Gui","name":"Gui, Zengke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoxin","familyName":"Huan","name":"Huan, Zhaoxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoyang","familyName":"Wang","name":"Wang, Zhaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibo","familyName":"Zhu","name":"Zhu, Zhibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihao","familyName":"Wang","name":"Wang, Zhihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqiang","familyName":"Zhang","name":"Zhang, Zhiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhoufei","familyName":"Wang","name":"Wang, Zhoufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihang","familyName":"Zeng","name":"Zeng, Zihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Liu","name":"Liu, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zitao","familyName":"Xuan","name":"Xuan, Zitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zuoli","familyName":"Tang","name":"Tang, Zuoli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Every Activation Boosted: Scaling General Reasoner to 1 Trillion Open Language Foundation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T01:51:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:21:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-07T02:15:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-10T00:01:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Ling 2.0, a series reasoning-oriented language foundation built upon the principle that every activation boosts reasoning capability. Designed to scale from tens of billions to one trillion parameters under a unified Mixture-of-Experts (MoE) paradigm, Ling 2.0 emphasizes high sparsity, cross-scale consistency, and efficiency guided by empirical scaling laws. The series includes three non-thinking (instruct) models - Ling-mini-2.0, Ling-flash-2.0, and Ling-1T - ranging from 16B to 1T total parameters and achieving up to 7-fold active-compute efficiency compared with dense counterparts. Ling 2.0 integrates coordinated innovations across model architecture, pre-training, post-training, and infrastructure: a high-sparsity MoE with MTP for efficient reasoning, reasoning-oriented data and mid-training CoT activation, reinforcement-based fine-tuning (DFT, Evo-CoT), and full-scale FP8 training with fine-grained heterogeneous pipelines. At the trillion scale, Ling-1T establishes a new Pareto frontier of reasoning accuracy versus computational efficiency, demonstrating that sparse activation, when properly aligned with reasoning objectives, enables scalable and efficient intelligence. Collectively, Ling 2.0 provides a coherent, open, and efficient foundation for advancing future reasoning and thinking models, including the Ring series built upon the same base."},{"descriptionType":"Other","description":"Ling 2.0 Technical Report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22115","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:07:38Z","registered":"2025-10-28T03:07:39Z","published":null,"updated":"2026-09-10T02:28:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23508","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23508","identifiers":[{"identifier":"2510.23508","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahui","familyName":"Geng","name":"Geng, Jiahui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Tonglet","name":"Tonglet, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iryna","familyName":"Gurevych","name":"Gurevych, Iryna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"M4FC: a Multimodal, Multilingual, Multicultural, Multitask Real-World Fact-Checking Dataset"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T16:44:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:54:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-12T09:14:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-13T02:11:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-10T08:47:23Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-11T00:39:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-09-01T16:46:25Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-09-02T01:16:54Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing real-world datasets for multimodal fact-checking have multiple limitations: they contain few instances, cover only one or two languages, focus on a single task, or rely on external news article sets to source true claims. To address these shortcomings, we introduce M4FC, a new real-world dataset comprising 4,982 images paired with 6,980 claims. The images, verified by professional fact-checkers from 22 organizations, represent a diverse range of cultural and geographic contexts. Each claim is available in one or two out of ten languages. M4FC spans six multimodal fact-checking tasks: visual claim extraction, claimant intent prediction, fake image detection, image contextualization, location verification, and verdict prediction. We provide baseline results for all tasks and analyze how combining intermediate tasks affects verdict prediction performance. We make our dataset and code publicly available."},{"descriptionType":"Other","description":"Camera-ready version accepted at EMNLP Findings 2026. Code and data available at: https://github.com/UKPLab/M4FC"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23508","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:40:46Z","registered":"2025-10-28T03:40:46Z","published":null,"updated":"2026-09-02T03:00:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22876","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22876","identifiers":[{"identifier":"2510.22876","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ranran Haoran","familyName":"Zhang","name":"Zhang, Ranran Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soumik","familyName":"Dey","name":"Dey, Soumik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashirbad","familyName":"Mishra","name":"Mishra, Ashirbad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hansi","familyName":"Wu","name":"Wu, Hansi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binbin","familyName":"Li","name":"Li, Binbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Zhang","name":"Zhang, Rui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Correctness Forensics for Batch Speculative Decoding: Diagnosing the Ragged Tensor Problem"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T23:59:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:13:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T20:38:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-02T01:06:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-15T22:53:25Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-17T02:08:10Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08-31T04:52:47Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-09-01T01:34:14Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Inference optimizations are routinely evaluated by throughput alone, without verifying output correctness. We conduct a forensic analysis of batch speculative decoding and find that several widely-used implementations silently produce corrupted outputs (repetitive tokens, symbols) while reporting competitive speed; failures invisible to metrics like ROUGE. We trace the root cause to the ragged tensor problem: variable token acceptance desynchronizes position IDs, attention masks, and KV-cache across a batch. We formalize the synchronization invariants (rectangular alignment and position-ID contiguity) that valid batched inference must preserve and show that maintaining them incurs superlinear alignment overhead under contiguous layouts. EQSPEC enforces the invariants without custom kernels; EXSPEC schedules same-length sequences to bypass realignment. On SpecBench across three model families, EXSPEC reaches 3 x throughput at batch size 8 with 95% exact match to standard decoding; residual divergence traces to floating-point non-determinism, not synchronization error. Code:https://github.com/eBay/spec_dec"},{"descriptionType":"Other","description":"Accepted to Findings of the Association for Computational Linguistics: EMNLP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22876","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:25:40Z","registered":"2025-10-28T03:25:41Z","published":null,"updated":"2026-09-01T05:02:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22588","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22588","identifiers":[{"identifier":"2510.22588","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenming","familyName":"Tu","name":"Tu, Wenming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanrou","familyName":"Yang","name":"Yang, Guanrou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiqi","familyName":"Yan","name":"Yan, Ruiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxi","familyName":"Chen","name":"Chen, Wenxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyang","familyName":"Ma","name":"Ma, Ziyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yipeng","familyName":"Kang","name":"Kang, Yipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Yu","name":"Yu, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xie","familyName":"Chen","name":"Chen, Xie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zilong","familyName":"Zheng","name":"Zheng, Zilong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UltraVoice: Scaling Fine-Grained Style-Controlled Speech Conversations for Spoken Dialogue Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T09:06:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:56:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-29T14:19:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-01T00:38:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Spoken dialogue models currently lack the ability for fine-grained speech style control, a critical capability for human-like interaction that is often overlooked in favor of purely functional capabilities like reasoning and question answering. To address this limitation, we introduce UltraVoice, the first large-scale speech dialogue dataset engineered for multiple fine-grained speech style control. Encompassing over 830 hours of speech dialogues, UltraVoice provides instructions across six key speech stylistic dimensions: emotion, speed, volume, accent, language, and composite styles. Fine-tuning leading models such as SLAM-Omni and VocalNet on UltraVoice significantly enhances their fine-grained speech stylistic controllability without degrading core conversational abilities. Specifically, our fine-tuned models achieve improvements of 29.12-42.33% in Mean Opinion Score (MOS) and 14.61-40.09 percentage points in Instruction Following Rate (IFR) on multi-dimensional control tasks designed in the UltraVoice. Moreover, on the URO-Bench benchmark, our fine-tuned models demonstrate substantial gains in core understanding, reasoning, and conversational abilities, with average improvements of +10.84% on the Basic setting and +7.87% on the Pro setting. Furthermore, the dataset's utility extends to training controllable Text-to-Speech (TTS) models, underscoring its high quality and broad applicability for expressive speech synthesis. The complete dataset and model checkpoints are available at: https://github.com/bigai-nlco/UltraVoice."},{"descriptionType":"Other","description":"EMNLP 2026 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22588","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:18:53Z","registered":"2025-10-28T03:18:54Z","published":null,"updated":"2026-09-01T05:01:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22733","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22733","identifiers":[{"identifier":"2510.22733","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qi","familyName":"Liu","name":"Liu, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanzhao","familyName":"Zhang","name":"Zhang, Yanzhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingxin","familyName":"Li","name":"Li, Mingxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingkun","familyName":"Long","name":"Long, Dingkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjun","familyName":"Xie","name":"Xie, Pengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxin","familyName":"Mao","name":"Mao, Jiaxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"E2Rank: Unifying Text Embedding and Listwise Reranking for Effective and Efficient Search"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T16:04:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:05:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-31T03:47:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-03T01:23:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-26T06:13:32Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-27T00:26:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Text embedding models deliver competitive retrieval performance with high efficiency, but their ranking fidelity remains limited compared to LLM-based listwise rerankers, which capture fine-grained query-document and document-document interactions at high computational cost. We propose E2Rank (Efficient Embedding-based Ranking), a unified framework that extends a single text embedding model to perform both retrieval and listwise reranking via continued training under a listwise ranking objective. The key insight is to treat the listwise prompt---constructed from the query and its top-K candidates---as a pseudo-relevance feedback (PRF) query, enabling reranking via cosine similarity against precomputed document embeddings without autoregressive decoding. Empirically, E2Rank achieves state-of-the-art results on BEIR, competitive performance on the reasoning-intensive BRIGHT benchmark, significantly lower latency than existing LLM-based rerankers, and improved embedding performance on MTEB---all within a single model."},{"descriptionType":"Other","description":"Accepted by EMNLP 2026 main conference. Code and models are avaliable at https://alibaba-nlp.github.io/E2Rank"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22733","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:22:18Z","registered":"2025-10-28T03:22:19Z","published":null,"updated":"2026-08-27T02:23:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22028","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22028","identifiers":[{"identifier":"2510.22028","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yilin","familyName":"Zhang","name":"Zhang, Yilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenda","familyName":"Xu","name":"Xu, Wenda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongtao","familyName":"Liu","name":"Liu, Zhongtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tetsuji","familyName":"Nakagawa","name":"Nakagawa, Tetsuji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus","familyName":"Freitag","name":"Freitag, Markus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Penalizing Length: Uncovering Systematic Bias in Quality Estimation Metrics"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T21:22:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:13:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T08:22:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T01:35:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-02T17:12:49Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-03T01:03:43Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08-09T05:04:30Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-08-11T00:54:23Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quality Estimation (QE) metrics are vital in machine translation for reference-free evaluation and increasingly serve as selection criteria in data filtering and candidate reranking. However, the prevalence and impact of length bias in QE metrics have been underexplored. Through a systematic study of top-performing learned and LLM-as-a-Judge QE metrics across 10 diverse language pairs, we reveal two critical length effects: First, QE metrics consistently over-predict errors with increasing translation length, even for high-quality, error-free texts. Second, when candidates of comparable quality are available for the same source text, learned QE metrics tend to favor shorter translations, whereas LLM-as-a-Judge metrics range from being approximately length-neutral to favoring longer translations. These metric-dependent length effects can favor or penalize translations based on length rather than quality and can propagate into downstream pipelines that rely on QE signals for data selection or system optimization. We trace the root cause of MetricX-24 QE's cumulative-length penalty to skewed supervision distributions, in which longer error-free examples are underrepresented in training data. As a diagnostic intervention, we apply length normalization during training and show that this simple modification effectively decouples error prediction from sequence length, yielding more reliable QE signals across translations of varying length."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22028","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:05:35Z","registered":"2025-10-28T03:05:36Z","published":null,"updated":"2026-08-11T04:13:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23340","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23340","identifiers":[{"identifier":"2510.23340","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anwesha","familyName":"Das","name":"Das, Anwesha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Duff","name":"Duff, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jörg","familyName":"Hoffmann","name":"Hoffmann, Jörg","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vera","familyName":"Demberg","name":"Demberg, Vera","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Planning Ahead with RSA: Efficient Signalling in Dynamic Environments by Projecting User Awareness across Future Timesteps"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T13:54:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-24T00:47:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.65109/brgk2754","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Adaptive agent design offers a way to improve human-AI collaboration on time-sensitive tasks in rapidly changing environments. In such cases, to ensure the human maintains an accurate understanding of critical task elements, an assistive agent must not only identify the highest priority information but also estimate how and when this information can be communicated most effectively, given that human attention represents a zero-sum cognitive resource where focus on one message diminishes awareness of other or upcoming information. We introduce a theoretical framework for adaptive signalling which meets these challenges by using principles of rational communication, formalised as Bayesian reference resolution using the Rational Speech Act (RSA) modelling framework, to plan a sequence of messages which optimise timely alignment between user belief and a dynamic environment. The agent adapts message specificity and timing to the particulars of a user and scenario based on projections of how prior-guided interpretation of messages will influence attention to the interface and subsequent belief update, across several timesteps out to a fixed horizon. In a comparison to baseline methods, we show that this effectiveness depends crucially on combining multi-step planning with a realistic model of user awareness. As the first application of RSA for communication in a dynamic environment, and for human-AI interaction in general, we establish theoretical foundations for pragmatic communication in human-agent teams, highlighting how insights from cognitive science can be capitalised to inform the design of assistive agents."},{"descriptionType":"Other","description":"11 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23340","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-28T03:36:45Z","registered":"2025-10-28T03:36:46Z","published":null,"updated":"2026-07-24T02:11:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22437","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22437","identifiers":[{"identifier":"2510.22437","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"G M","familyName":"Shahariar","name":"Shahariar, G M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erfan","familyName":"Shayegani","name":"Shayegani, Erfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Nazari","name":"Nazari, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nael","familyName":"Abu-Ghazaleh","name":"Abu-Ghazaleh, Nael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modeling Hierarchical Thinking in Large Reasoning Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T21:25:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:44:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-28T09:51:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-29T00:51:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Reasoning Models (LRMs) solve complex tasks by generating long Chain-of-Thought (CoT) sequences; however, the emergent dynamics governing reasoning trajectories are not well understood and can lead to inconsistencies and reasoning pathologies. In this work, we propose to approximate LRM's emerging hierarchical reasoning dynamics as a trajectory within a Finite State Machine (FSM) transitioning among six abstract cognitive states. We demonstrate that these states and transitions can be captured in the latent state of the model. We believe that this representation can have different applications in the interpretability and optimization of LRM models. For example, by analyzing the topology of these transitions, we identify statistical shifts in reasoning strategies that help identify effective reasoning chains from those that fail. To illustrate these potential advantages, we propose Q-Value guided steering, a training-free inference-time control method that treats reasoning as a planning problem. We estimate the long-horizon utility of state transitions and apply sparse, orthogonal activation steering at sentence boundaries to align the CoT generation with optimal reasoning policies. Experiments across four benchmarks (AIME25, MATH-500, GSM8k, and GPQA Diamond) using three state-of-the-art open reasoning models demonstrate that Q-Value steering policy achieves significant performance gains with \"surgical\" efficiency, often requiring 25 times fewer interventions than greedy and weighted baselines, which suggests that reasoning can be effectively controlled by guiding high-level cognitive dynamics rather than micro-managing token generation. Code is available at: https://github.com/shahariar-shibli/CoT-FSM."},{"descriptionType":"Other","description":"Accepted in ICML 2026 as Oral"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22437","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:15:21Z","registered":"2025-10-28T03:15:22Z","published":null,"updated":"2026-05-29T02:57:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23538","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23538","identifiers":[{"identifier":"2510.23538","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiushi","familyName":"Sun","name":"Sun, Qiushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyang","familyName":"Gong","name":"Gong, Jingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Liu","name":"Liu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiaosheng","familyName":"Chen","name":"Chen, Qiaosheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Li","name":"Li, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Chen","name":"Chen, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qipeng","familyName":"Guo","name":"Guo, Qipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ben","familyName":"Kao","name":"Kao, Ben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Yuan","name":"Yuan, Fei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"JanusCoder: Towards a Foundational Visual-Programmatic Interface for Code Intelligence"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T17:13:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:56:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-14T09:11:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-15T00:39:41Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-20T01:19:34Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-21T00:21:51Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The scope of neural code intelligence is rapidly expanding beyond text-based source code to encompass the rich visual outputs that programs generate. This visual dimension is critical for advanced applications like flexible content generation and precise, program-driven editing of visualizations. However, progress has been impeded by the scarcity of high-quality multimodal code data, a bottleneck stemming from challenges in synthesis and quality assessment. To address these challenges, we make contributions from both a data and modeling perspective. We first introduce a complete synthesis toolkit that leverages reciprocal synergies between data modalities to efficiently produce a large-scale, high-quality corpus spanning from standard charts to complex interactive web UIs and code-driven animations. Leveraging this toolkit, we construct JanusCode-800K, the largest multimodal code corpus to date. This powers the training of our models, JanusCoder and JanusCoderV, which establish a visual-programmatic interface for generating code from textual instructions, visual inputs, or a combination of both. Our unified model is a departure from existing approaches that build specialized models for isolated tasks. Extensive experiments on both text-centric and vision-centric coding tasks demonstrate the superior performance of the JanusCoder series, with our 7B to 14B scale models approaching or even exceeding the performance of commercial models. Furthermore, extensive analysis provides key insights into harmonizing programmatic logic with its visual expression. Our code and checkpoints are available at https://github.com/InternLM/JanusCoder."},{"descriptionType":"Other","description":"ICLR 2026 Camera Ready Version, with code and data available"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23538","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:41:29Z","registered":"2025-10-28T03:41:30Z","published":null,"updated":"2026-05-21T02:35:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22767","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22767","identifiers":[{"identifier":"2510.22767","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Omar","familyName":"Naim","name":"Naim, Omar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krish","familyName":"Sharma","name":"Sharma, Krish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niyar R","familyName":"Barman","name":"Barman, Niyar R","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Asher","name":"Asher, Nicholas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TELL-TALE: Task Efficient LLMs with Task Aware Layer Elimination"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T17:34:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:07:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-24T08:04:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T01:21:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-10T13:04:53Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-12T01:16:12Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) typically come with a fixed architecture, despite growing evidence that not all layers contribute equally to every downstream task. We introduce TALE (Task-Aware Layer Elimination), an inference-time method that improves task performance by selectively removing layers that are irrelevant or detrimental for a given task. TALE optimizes task-specific performance, yielding a task-optimized architecture without retraining. Across 9 tasks and 5 model families, under both zero-shot and few-shot settings, TALE consistently matches or surpasses baseline performance while simultaneously reducing computational costs. TALE also synergizes with fine-tuning, leading to further performance improvements. Computing TALE for a new task requires modest resources, making it a practical and deployable solution for task-specialized LLM inference."},{"descriptionType":"Other","description":"ACL 2026 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22767","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:23:07Z","registered":"2025-10-28T03:23:08Z","published":null,"updated":"2026-05-12T05:05:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.21954","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21954","identifiers":[{"identifier":"2510.21954","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mykola","familyName":"Haltiuk","name":"Haltiuk, Mykola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aleksander","familyName":"Smywinski-Pohl","name":"Smywinski-Pohl, Aleksander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Model-Aware Tokenizer Transfer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T18:27:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:07:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-10T14:18:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T01:18:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are trained to support an increasing number of languages, yet their predefined tokenizers remain a bottleneck for adapting models to lower-resource or distinct-script languages. Existing tokenizer transfer methods typically rely on semantic heuristics to initialize new embeddings, ignoring higher-layer model dynamics and limiting transfer quality. We propose Model-Aware Tokenizer Transfer (MATT), a method that incorporates model internals into the tokenizer transfer process. MATT introduces an Attention Influence Modeling (AIM) objective that distills inter-token communication patterns from a source model into a target model with a new tokenizer, providing an efficient warm-up before standard language modeling. Unlike approaches that focus solely on embedding similarity, MATT leverages attention behavior to guide embedding initialization and adaptation. Experiments across diverse linguistic settings show that MATT recovers a large fraction of the original model's performance within a few GPU hours, outperforming heuristic baselines. These results demonstrate that incorporating model-level signals offers a practical and effective path toward robust tokenizer transfer in multilingual LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.21954","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:03:51Z","registered":"2025-10-28T03:03:52Z","published":null,"updated":"2026-05-12T05:05:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22907","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22907","identifiers":[{"identifier":"2510.22907","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifan","familyName":"Zhang","name":"Zhang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lanser","familyName":"Contributors","name":"Contributors, Lanser","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reinforcement Learning from Compiler and Language Server Feedback"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T01:25:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:15:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-01T23:47:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-05T00:14:59Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Coding agents fail when text-level guesses outrun program facts: they hallucinate APIs, drift to the wrong symbol, and apply edits without evidence that the workspace remains valid. Compilers, type checkers, and language servers already compute the missing supervision signal, in the form of diagnostics, symbol resolution, type information, references, and refactoring preconditions, but expose it through interfaces designed for human-driven IDEs rather than learning loops. We introduce Reinforcement Learning from Compiler and Language Server Feedback (RLCSF) together with Lanser-CLI, a CLI-first orchestration layer that exposes this signal to agents and CI. RLCSF treats each tool interaction as a transition and computes a shaped process reward from deterministic changes in diagnostics, selector confidence, and edit safety. Lanser-CLI, in turn, converts ephemeral LSP sessions into replayable Analysis Bundles with pinned environment metadata and stable content hashes. Its core mechanisms are robust selectors that go beyond file:line:col, deterministic bundle normalization, preview-first guarded mutations, and a reward functional whose potential-based component is replayable under frozen snapshots. We formalize determinism for canonical bundles and prove that componentwise-improving transitions receive non-negative reward in the undiscounted setting. Together, these pieces yield a practical substrate for process supervision of coding agents."},{"descriptionType":"Other","description":"Project Page: https://github.com/yifanzhang-pro/lanser-cli"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22907","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:26:24Z","registered":"2025-10-28T03:26:25Z","published":null,"updated":"2026-05-05T04:01:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22102","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22102","identifiers":[{"identifier":"2510.22102","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xingjian","familyName":"Tao","name":"Tao, Xingjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwei","familyName":"Wang","name":"Wang, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujun","familyName":"Cai","name":"Cai, Yujun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihong","familyName":"Luo","name":"Luo, Yihong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Han","name":"Han, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Tang","name":"Tang, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mitigating Coordinate Prediction Bias from Positional Encoding Failures"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T00:58:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:20:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-28T03:11:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-29T00:21:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While Multimodal Large Language Models (MLLMs) excel at general vision-language tasks, precise coordinate prediction remains a significant challenge, particularly as high-resolution inputs cause visual positional encodings (VPEs) to degrade. We demonstrate that these encoding failures do not result in random noise but instead trigger predictable, directional biases, suggesting that models default to internal spatial priors when grounding signals are weak. To counteract this, we introduce Vision-PE Shuffle Guidance (VPSG), a training-free, inference-time correction method. VPSG isolates position-unconditioned tendencies by shuffling VPEs and utilizes this negative evidence to steer digit decoding through a lightweight finite-state machine. Evaluation on the ScreenSpot-Pro benchmark confirms that VPSG effectively rectifies coordinate drift, yielding consistent improvements in localization accuracy across various model scales without any retraining. Our code is available at https://github.com/taoxj2001/VPSG."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22102","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:07:19Z","registered":"2025-10-28T03:07:20Z","published":null,"updated":"2026-04-29T02:33:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23642","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23642","identifiers":[{"identifier":"2510.23642","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuansheng","familyName":"Ni","name":"Ni, Yuansheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songcheng","familyName":"Cai","name":"Cai, Songcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangchao","familyName":"Chen","name":"Chen, Xiangchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiarong","familyName":"Liang","name":"Liang, Jiarong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiheng","familyName":"Lyu","name":"Lyu, Zhiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Deng","name":"Deng, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Zou","name":"Zou, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Nie","name":"Nie, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Yuan","name":"Yuan, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Yue","name":"Yue, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhu","familyName":"Chen","name":"Chen, Wenhu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VisCoder2: Building Multi-Language Visualization Coding Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T18:03:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-29T00:00:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-07T20:59:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-09T00:10:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have recently enabled coding agents capable of generating, executing, and revising visualization code. However, existing models often fail in practical workflows due to limited language coverage, unreliable execution, and lack of iterative correction mechanisms. Progress has been constrained by narrow datasets and benchmarks that emphasize single-round generation and single-language tasks. To address these challenges, we introduce three complementary resources for advancing visualization coding agents. VisCode-Multi-679K is a large-scale, supervised dataset containing 679K validated and executable visualization samples with multi-turn correction dialogues across 12 programming languages. VisPlotBench is a benchmark for systematic evaluation, featuring executable tasks, rendered outputs, and protocols for both initial generation and multi-round self-debug. Finally, we present VisCoder2, a family of multi-language visualization models trained on VisCode-Multi-679K. Experiments show that VisCoder2 significantly outperforms strong open-source baselines and approaches the performance of proprietary models like GPT-4.1, with further gains from iterative self-debug, reaching 82.4% overall execution pass rate at the 32B scale, particularly in symbolic or compiler-dependent languages."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23642","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-29T01:45:53Z","registered":"2025-10-29T01:45:53Z","published":null,"updated":"2026-04-09T02:19:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22739","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22739","identifiers":[{"identifier":"2510.22739","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiwen","familyName":"Tang","name":"Tang, Yiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiuyu","familyName":"Zhao","name":"Zhao, Qiuyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zenghui","familyName":"Sun","name":"Sun, Zenghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinsong","familyName":"Lan","name":"Lan, Jinsong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyong","familyName":"Zhu","name":"Zhu, Xiaoyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Zheng","name":"Zheng, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"REVISION:Reflective Intent Mining and Online Reasoning Auxiliary for E-commerce Visual Search System Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T16:15:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:05:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T04:54:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-05T01:29:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In Taobao e-commerce visual search, user behavior analysis reveals a large proportion of no-click requests, suggesting diverse and implicit user intents. These intents are expressed in various forms and are difficult to mine and discover, thereby leading to the limited adaptability and lag in platform strategies. This greatly restricts users' ability to express diverse intents and hinders the scalability of the visual search system. This mismatch between user implicit intent expression and system response defines the User-SearchSys Intent Discrepancy. To alleviate the issue, we propose a novel framework REVISION. This framework integrates offline reasoning mining with online decision-making and execution, enabling adaptive strategies to solve implicit user demands. In the offline stage, we construct a periodic pipeline to mine discrepancies from historical no-click requests. Leveraging large models, we analyze implicit intent factors and infer optimal suggestions by jointly reasoning over query and product metadata. These inferred suggestions serve as actionable insights for refining platform strategies. In the online stage, REVISION-R1-3B, trained on the curated offline data, performs holistic analysis over query images and associated historical products to generate optimization plans and adaptively schedule strategies across the search pipeline. Our framework offers a streamlined paradigm for integrating large models with traditional search systems, enabling end-to-end intelligent optimization across information aggregation and user interaction. Experimental results demonstrate that our approach improves the efficiency of implicit intent mining from large-scale search logs and significantly reduces the no-click rate."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22739","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:22:27Z","registered":"2025-10-28T03:22:28Z","published":null,"updated":"2026-03-05T03:45:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22373","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22373","identifiers":[{"identifier":"2510.22373","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yupeng","familyName":"Xie","name":"Xie, Yupeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyang","familyName":"Zhang","name":"Zhang, Zhiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Wu","name":"Wu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sirong","familyName":"Lu","name":"Lu, Sirong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Zhang","name":"Zhang, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoyang","familyName":"Yu","name":"Yu, Zhaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinlin","familyName":"Wang","name":"Wang, Jinlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sirui","familyName":"Hong","name":"Hong, Sirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bang","familyName":"Liu","name":"Liu, Bang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenglin","familyName":"Wu","name":"Wu, Chenglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyu","familyName":"Luo","name":"Luo, Yuyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VisJudge-Bench: Aesthetics and Quality Assessment of Visualizations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T17:31:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:40:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-31T13:30:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T01:41:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-02T13:53:32Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-03T03:09:30Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Visualization, a domain-specific yet widely used form of imagery, is an effective way to turn complex datasets into intuitive insights, and its value depends on whether data are faithfully represented, clearly communicated, and aesthetically designed. However, evaluating visualization quality is challenging: unlike natural images, it requires simultaneous judgment across data encoding accuracy, information expressiveness, and visual aesthetics. Although multimodal large language models (MLLMs) have shown promising performance in aesthetic assessment of natural images, no systematic benchmark exists for measuring their capabilities in evaluating visualizations. To address this, we propose VisJudge-Bench, the first comprehensive benchmark for evaluating MLLMs' performance in assessing visualization aesthetics and quality. It contains 3,090 expert-annotated samples from real-world scenarios, covering single visualizations, multiple visualizations, and dashboards across 32 chart types. Systematic testing on this benchmark reveals that even the most advanced MLLMs (such as GPT-5) still exhibit significant gaps compared to human experts in judgment, with a Mean Absolute Error (MAE) of 0.553 and a correlation with human ratings of only 0.428. To address this issue, we propose VisJudge, a model specifically designed for visualization aesthetics and quality assessment. Experimental results demonstrate that VisJudge significantly narrows the gap with human judgment, reducing the MAE to 0.421 (a 23.9% reduction) and increasing the consistency with human experts to 0.687 (a 60.5% improvement) compared to GPT-5. The benchmark is available at https://github.com/HKUSTDial/VisJudgeBench."},{"descriptionType":"Other","description":"62 pages, 27 figures, 8 tables. Accepted at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22373","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:13:50Z","registered":"2025-10-28T03:13:51Z","published":null,"updated":"2026-03-03T05:47:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22037","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22037","identifiers":[{"identifier":"2510.22037","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shayne","familyName":"Longpre","name":"Longpre, Shayne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sneha","familyName":"Kudugunta","name":"Kudugunta, Sneha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niklas","familyName":"Muennighoff","name":"Muennighoff, Niklas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I-Hung","familyName":"Hsu","name":"Hsu, I-Hung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isaac","familyName":"Caswell","name":"Caswell, Isaac","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Pentland","name":"Pentland, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sercan","familyName":"Arik","name":"Arik, Sercan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen-Yu","familyName":"Lee","name":"Lee, Chen-Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sayna","familyName":"Ebrahimi","name":"Ebrahimi, Sayna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ATLAS: Adaptive Transfer Scaling Laws for Multilingual Pretraining, Finetuning, and Decoding the Curse of Multilinguality"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T21:45:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:14:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-25T01:59:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-26T01:17:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Scaling laws research has focused overwhelmingly on English -- yet the most prominent AI models explicitly serve billions of international users. In this work, we undertake the largest multilingual scaling laws study to date, totaling 774 multilingual training experiments, spanning 10M-8B model parameters, 400+ training languages and 48 evaluation languages. We introduce the Adaptive Transfer Scaling Law (ATLAS) for both monolingual and multilingual pretraining, which outperforms existing scaling laws' out-of-sample generalization often by more than 0.3 R^2. Our analyses of the experiments shed light on multilingual learning dynamics, transfer properties between languages, and the curse of multilinguality. First, we derive a cross-lingual transfer matrix, empirically measuring mutual benefit scores between 38 x 38=1444 language pairs. Second, we derive a language-agnostic scaling law that reveals how to optimally scale model size and data when adding languages without sacrificing performance. Third, we identify the computational crossover points for when to pretrain from scratch versus finetune from multilingual checkpoints. We hope these findings provide the scientific foundation for democratizing scaling laws across languages, and enable practitioners to efficiently scale models -- beyond English-first AI."},{"descriptionType":"Other","description":"Published as a conference paper at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22037","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:05:48Z","registered":"2025-10-28T03:05:49Z","published":null,"updated":"2026-02-26T03:26:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22500","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22500","identifiers":[{"identifier":"2510.22500","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ren","familyName":"Yin","name":"Yin, Ren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takashi","familyName":"Ishida","name":"Ishida, Takashi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masashi","familyName":"Sugiyama","name":"Sugiyama, Masashi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Scalable Oversight via Partitioned Human Supervision"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T02:42:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:48:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T13:37:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:48:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As artificial intelligence (AI) systems approach and surpass expert human performance across a broad range of tasks, obtaining high-quality human supervision for evaluation and training becomes increasingly challenging. Our focus is on tasks that require deep knowledge and skills of multiple domains, where this bottleneck is severe. Unfortunately, even the best human experts are knowledgeable only in a single narrow area, and will not be able to evaluate the correctness of advanced AI systems on such superhuman tasks. However, based on their narrow expertise, humans may provide a weak signal, i.e., a complementary label indicating an option that is incorrect. For example, a cardiologist could state that ''this is not related to any cardiovascular disease,'' even if they cannot identify the true disease. Based on this weak signal, we propose a scalable oversight framework that enables us to evaluate frontier AI systems without the need to prepare the ground truth. We derive an unbiased estimator of top-1 accuracy from complementary labels and quantify how many complementary labels are needed to match the variance of ordinary labels. We further introduce two estimators to combine scarce ordinary labels with abundant complementary labels. We provide finite-sample deviation guarantees for both complementary-only and the mixed estimators. Empirically, we show that we can evaluate the output of large language models without the ground truth, if we have complementary labels. We further show that we can train an AI system with such weak signals: we show how we can design an agentic AI system automatically that can improve itself with this partitioned human supervision. Our code is available at https://github.com/R-Yin-217/Towards-Scalable-Oversight-via-Partitioned-Human-Supervision."},{"descriptionType":"Other","description":"ICLR 2026 camera ready version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22500","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:16:49Z","registered":"2025-10-28T03:16:50Z","published":null,"updated":"2026-02-25T03:10:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23276","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23276","identifiers":[{"identifier":"2510.23276","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thai-Binh","familyName":"Nguyen","name":"Nguyen, Thai-Binh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katerina","familyName":"Zmolikova","name":"Zmolikova, Katerina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pingchuan","familyName":"Ma","name":"Ma, Pingchuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ngoc Quan","familyName":"Pham","name":"Pham, Ngoc Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Fuegen","name":"Fuegen, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Waibel","name":"Waibel, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Cocktail-Party Benchmark: Multi-Modal dataset and Comparative Evaluation Results"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T12:36:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:40:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-12T01:34:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-13T01:17:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce the task of Multi-Modal Context-Aware Recognition (MCoRec) in the ninth CHiME Challenge, which addresses the cocktail-party problem of overlapping conversations in a single-room setting using audio, visual, and contextual cues. MCoRec captures natural multi-party conversations where the recordings focus on unscripted, casual group chats, leading to extreme speech overlap of up to 100% and highly fragmented conversational turns. The task requires systems to answer the question \"Who speaks when, what, and with whom?\" by jointly transcribing each speaker's speech and clustering them into their respective conversations from audio-visual recordings. Audio-only baselines exceed 100% word error rate, whereas incorporating visual cues yields substantial 50% improvements, highlighting the importance of multi-modality. In this manuscript, we present the motivation behind the task, outline the data collection process, and report the baseline systems developed for the MCoRec."},{"descriptionType":"Other","description":"Accepted at ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23276","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:35:15Z","registered":"2025-10-28T03:35:15Z","published":null,"updated":"2026-02-13T03:21:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22007","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22007","identifiers":[{"identifier":"2510.22007","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"T. Tony","familyName":"Cai","name":"Cai, T. Tony","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Li","name":"Li, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Long","name":"Long, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weijie J.","familyName":"Su","name":"Su, Weijie J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Garrett G.","familyName":"Wen","name":"Wen, Garrett G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal Detection for Language Watermarks with Pseudorandom Collision"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T20:21:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-01-21T19:42:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Text watermarking plays a crucial role in ensuring the traceability and accountability of large language model (LLM) outputs and mitigating misuse. While promising, most existing methods assume perfect pseudorandomness. In practice, repetition in generated text induces collisions that create structured dependence, compromising Type I error control and invalidating standard analyses.\n We introduce a statistical framework that captures this structure through a hierarchical two-layer partition. At its core is the concept of minimal units -- the smallest groups treatable as independent across units while permitting dependence within. Using minimal units, we define a non-asymptotic efficiency measure and cast watermark detection as a minimax hypothesis testing problem.\n Applied to Gumbel-max and inverse-transform watermarks, our framework produces closed-form optimal rules. It explains why discarding repeated statistics often improves performance and shows that within-unit dependence must be addressed unless degenerate. Both theory and experiments confirm improved detection power with rigorous Type I error control. These results provide the first principled foundation for watermark detection under imperfect pseudorandomness, offering both theoretical insight and practical guidance for reliable tracing of model outputs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22007","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:05:06Z","registered":"2025-10-28T03:05:07Z","published":null,"updated":"2026-01-22T03:18:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23564","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23564","identifiers":[{"identifier":"2510.23564","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaoyang","familyName":"Yu","name":"Yu, Zhaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Zhang","name":"Zhang, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huixue","familyName":"Su","name":"Su, Huixue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufan","familyName":"Zhao","name":"Zhao, Yufan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Wu","name":"Wu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyi","familyName":"Deng","name":"Deng, Mingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyu","familyName":"Xiang","name":"Xiang, Jinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizhang","familyName":"Lin","name":"Lin, Yizhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingxiao","familyName":"Tang","name":"Tang, Lingxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyu","familyName":"Luo","name":"Luo, Yuyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bang","familyName":"Liu","name":"Liu, Bang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenglin","familyName":"Wu","name":"Wu, Chenglin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReCode: Unify Plan and Action for Universal Granularity Control"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T17:35:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:58:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-28T03:22:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-29T00:27:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-12T13:55:48Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-15T01:44:09Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-06T09:30:39Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-07T01:32:57Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-world tasks require decisions at varying granularities, and humans excel at this by leveraging a unified cognitive representation where planning is fundamentally understood as a high-level form of action. However, current Large Language Model (LLM)-based agents lack this crucial capability to operate fluidly across decision granularities. This limitation stems from existing paradigms that enforce a rigid separation between high-level planning and low-level action, which impairs dynamic adaptability and limits generalization. We propose ReCode (Recursive Code Generation), a novel paradigm that addresses this limitation by unifying planning and action within a single code representation. In this representation, ReCode treats high-level plans as abstract placeholder functions, which the agent then recursively decomposes into finer-grained sub-functions until reaching primitive actions. This recursive approach dissolves the rigid boundary between plan and action, enabling the agent to dynamically control its decision granularity. Furthermore, the recursive structure inherently generates rich, multi-granularity training data, enabling models to learn hierarchical decision-making processes. Extensive experiments show ReCode significantly surpasses advanced baselines in inference performance and demonstrates exceptional data efficiency in training, validating our core insight that unifying planning and action through recursive code generation is a powerful and effective approach to achieving universal granularity control. The code is available at https://github.com/FoundationAgents/ReCode."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23564","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:42:07Z","registered":"2025-10-28T03:42:08Z","published":null,"updated":"2026-01-07T03:00:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23637","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23637","identifiers":[{"identifier":"2510.23637","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Job","familyName":"Petrovčič","name":"Petrovčič, Job","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David Eliecer Narvaez","familyName":"Denis","name":"Denis, David Eliecer Narvaez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ljupčo","familyName":"Todorovski","name":"Todorovski, Ljupčo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Combining Textual and Structural Information for Premise Selection in Lean"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T14:24:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-29T00:00:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-28T19:08:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-02T01:04:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Premise selection is a key bottleneck for scaling theorem proving in large formal libraries. Yet existing language-based methods often treat premises in isolation, ignoring the web of dependencies that connects them. We present a graph-augmented approach that combines dense text embeddings of Lean formalizations with graph neural networks over a heterogeneous dependency graph capturing both state-premise and premise-premise relations. On the LeanDojo Benchmark, our method outperforms the ReProver language-based baseline by over 25\\% across standard retrieval metrics. These results suggest that relational information is beneficial for premise selection."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23637","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-29T01:45:46Z","registered":"2025-10-29T01:45:46Z","published":null,"updated":"2025-12-02T04:49:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22780","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22780","identifiers":[{"identifier":"2510.22780","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zora Zhiruo","familyName":"Wang","name":"Wang, Zora Zhiruo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijia","familyName":"Shao","name":"Shao, Yijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omar","familyName":"Shaikh","name":"Shaikh, Omar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Fried","name":"Fried, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Graham","familyName":"Neubig","name":"Neubig, Graham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diyi","familyName":"Yang","name":"Yang, Diyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Do AI Agents Do Human Work? Comparing AI and Human Workflows Across Diverse Occupations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T18:10:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:07:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-06T21:03:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-10T01:05:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI agents are continually optimized for tasks related to human work, such as software engineering and professional writing, signaling a pressing trend with significant impacts on the human workforce. However, these agent developments have often not been grounded in a clear understanding of how humans execute work, to reveal what expertise agents possess and the roles they can play in diverse workflows. In this work, we study how agents do human work by presenting the first direct comparison of human and agent workers across multiple essential work-related skills: data analysis, engineering, computation, writing, and design. To better understand and compare heterogeneous computer-use activities of workers, we introduce a scalable toolkit to induce interpretable, structured workflows from either human or agent computer-use activities. Using such induced workflows, we compare how humans and agents perform the same tasks and find that: (1) While agents exhibit promise in their alignment to human workflows, they take an overwhelmingly programmatic approach across all work domains, even for open-ended, visually dependent tasks like design, creating a contrast with the UI-centric methods typically used by humans. (2) Agents produce work of inferior quality, yet often mask their deficiencies via data fabrication and misuse of advanced tools. (3) Nonetheless, agents deliver results 88.3% faster and cost 90.4-96.2% less than humans, highlighting the potential for enabling efficient collaboration by delegating easily programmable tasks to agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22780","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:23:26Z","registered":"2025-10-28T03:23:26Z","published":null,"updated":"2025-11-10T02:50:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23169","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23169","identifiers":[{"identifier":"2510.23169","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marah","familyName":"Ghoummaid","name":"Ghoummaid, Marah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladimir","familyName":"Tchuiev","name":"Tchuiev, Vladimir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ofek","familyName":"Glick","name":"Glick, Ofek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michal","familyName":"Moshkovitz","name":"Moshkovitz, Michal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dotan","familyName":"Di Castro","name":"Di Castro, Dotan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MATCH: Task-Driven Code Evaluation through Contrastive Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T09:51:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:33:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-28T07:44:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-29T00:36:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI-based code generation is increasingly prevalent, with GitHub Copilot estimated to generate 46% of the code on GitHub. Accurately evaluating how well generated code aligns with developer intent remains a critical challenge. Traditional evaluation methods, such as unit tests, are often unscalable and costly. Syntactic similarity metrics (e.g., BLEU, ROUGE) fail to capture code functionality, and metrics like CodeBERTScore require reference code, which is not always available. To address the gap in reference-free evaluation, with few alternatives such as ICE-Score, this paper introduces MATCH, a novel reference-free metric. MATCH uses Contrastive Learning to generate meaningful embeddings for code and natural language task descriptions, enabling similarity scoring that reflects how well generated code implements the task. We show that MATCH achieves stronger correlations with functional correctness and human preference than existing metrics across multiple programming languages."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23169","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:32:41Z","registered":"2025-10-28T03:32:42Z","published":null,"updated":"2025-10-29T02:26:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22672","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22672","identifiers":[{"identifier":"2510.22672","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anna","familyName":"Deichler","name":"Deichler, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Beskow","name":"Beskow, Jonas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Look and Tell: A Dataset for Multimodal Grounding Across Egocentric and Exocentric Views"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.10; I.2.9; I.2.7; H.5.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-26T13:27:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:01:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-28T08:39:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-29T00:38:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Look and Tell, a multimodal dataset for studying referential communication across egocentric and exocentric perspectives. Using Meta Project Aria smart glasses and stationary cameras, we recorded synchronized gaze, speech, and video as 25 participants instructed a partner to identify ingredients in a kitchen. Combined with 3D scene reconstructions, this setup provides a benchmark for evaluating how different spatial representations (2D vs. 3D; ego vs. exo) affect multimodal grounding. The dataset contains 3.67 hours of recordings, including 2,707 richly annotated referential expressions, and is designed to advance the development of embodied agents that can understand and engage in situated dialogue."},{"descriptionType":"Other","description":"10 pages, 6 figures, 2 tables. Accepted to the NeurIPS 2025 Workshop on SPACE in Vision, Language, and Embodied AI (SpaVLE). Dataset: https://huggingface.co/datasets/annadeichler/KTH-ARIA-referential"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22672","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:20:53Z","registered":"2025-10-28T03:20:54Z","published":null,"updated":"2025-10-29T02:25:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23544","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23544","identifiers":[{"identifier":"2510.23544","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tingyu","familyName":"Song","name":"Song, Tingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilun","familyName":"Zhao","name":"Zhao, Yilun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyue","familyName":"Zhang","name":"Zhang, Siyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Zhao","name":"Zhao, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arman","familyName":"Cohan","name":"Cohan, Arman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LimRank: Less is More for Reasoning-Intensive Information Reranking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T17:19:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:57:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing approaches typically rely on large-scale fine-tuning to adapt LLMs for information reranking tasks, which is computationally expensive. In this work, we demonstrate that modern LLMs can be effectively adapted using only minimal, high-quality supervision. To enable this, we design LIMRANK-SYNTHESIZER, a reusable and open-source pipeline for generating diverse, challenging, and realistic reranking examples. Using this synthetic data, we fine-tune our reranker model, LIMRANK. We evaluate LIMRANK on two challenging benchmarks, i.e., BRIGHT for reasoning-intensive retrieval and FollowIR for instruction-following retrieval. Our experiments demonstrate that LIMRANK achieves competitive performance, while being trained on less than 5% of the data typically used in prior work. Further ablation studies demonstrate the effectiveness of LIMRANK-SYNTHESIZER and the strong generalization capabilities of LIMRANK across downstream tasks, including scientific literature search and retrieval-augmented generation for knowledge-intensive problem solving."},{"descriptionType":"Other","description":"EMNLP 2025 Main (Short)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23544","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:41:38Z","registered":"2025-10-28T03:41:38Z","published":null,"updated":"2025-10-28T03:41:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23451","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23451","identifiers":[{"identifier":"2510.23451","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuoran","familyName":"Jin","name":"Jin, Zhuoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongbang","familyName":"Yuan","name":"Yuan, Hongbang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kejian","familyName":"Zhu","name":"Zhu, Kejian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiachun","familyName":"Li","name":"Li, Jiachun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengfei","familyName":"Cao","name":"Cao, Pengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yubo","familyName":"Chen","name":"Chen, Yubo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Liu","name":"Liu, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Zhao","name":"Zhao, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Omni-Reward: Towards Generalist Omni-Modal Reward Modeling with Free-Form Preferences"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T15:53:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:51:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reward models (RMs) play a critical role in aligning AI behaviors with human preferences, yet they face two fundamental challenges: (1) Modality Imbalance, where most RMs are mainly focused on text and image modalities, offering limited support for video, audio, and other modalities; and (2) Preference Rigidity, where training on fixed binary preference pairs fails to capture the complexity and diversity of personalized preferences. To address the above challenges, we propose Omni-Reward, a step toward generalist omni-modal reward modeling with support for free-form preferences, consisting of: (1) Evaluation: We introduce Omni-RewardBench, the first omni-modal RM benchmark with free-form preferences, covering nine tasks across five modalities including text, image, video, audio, and 3D; (2) Data: We construct Omni-RewardData, a multimodal preference dataset comprising 248K general preference pairs and 69K instruction-tuning pairs for training generalist omni-modal RMs; (3) Model: We propose Omni-RewardModel, which includes both discriminative and generative RMs, and achieves strong performance on Omni-RewardBench as well as other widely used reward modeling benchmarks."},{"descriptionType":"Other","description":"48 pages, 17 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23451","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:39:24Z","registered":"2025-10-28T03:39:24Z","published":null,"updated":"2025-10-28T03:39:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23284","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23284","identifiers":[{"identifier":"2510.23284","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuanzhen","familyName":"Xie","name":"Xie, Yuanzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liu","familyName":"Ye","name":"Ye, Liu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiqun","familyName":"Chu","name":"Chu, Jiqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mochi","familyName":"Gao","name":"Gao, Mochi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hehuan","familyName":"Liu","name":"Liu, Hehuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunzhi","familyName":"Tan","name":"Tan, Yunzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Hu","name":"Hu, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zang","familyName":"Li","name":"Li, Zang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DCMM-SQL: Automated Data-Centric Pipeline and Multi-Model Collaboration Training for Text-to-SQL Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T12:53:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:41:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Text-to-SQL tasks have gained attractive improvements since the release of ChatGPT. Among them, agent-based frameworks have been widely used in this field. However, the impact of data-centric strategies on text-to-SQL tasks has rarely been explored. In this paper, we systemically design a fully automated data-centric pipeline for text-to-SQL tasks, including \\emph{adaptive data repair}, which can automatically find and fix errors in the training dataset; and \\emph{error data augmentation}, where we specifically diffuse and enhance erroneous data predicted by the initially trained models. Meanwhile, we propose a Multi-Model collaboration training schema, aiming to train multiple models with different augmented data, enabling them to possess distinct capabilities and work together to complement each other, because it has been found that the capability of a single fine-tuned model is very limited. Furthermore, we utilize an ensemble strategy to integrate the capabilities of multiple models to solve a multiple-choice question, aiming to further improve the accuracy of text-to-SQL tasks. The experiment results and ablation study have demonstrated the effectiveness of data-centric pipeline and Multi-Model(MM) interactive iterative strategies, achieving first place in lightweight text-to-SQL models (within 70B)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23284","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:35:26Z","registered":"2025-10-28T03:35:27Z","published":null,"updated":"2025-10-28T03:35:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23198","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23198","identifiers":[{"identifier":"2510.23198","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Etienne","familyName":"Goffinet","name":"Goffinet, Etienne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shane","familyName":"Bergsma","name":"Bergsma, Shane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avraham","familyName":"Sheinin","name":"Sheinin, Avraham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natalia","familyName":"Vassilieva","name":"Vassilieva, Natalia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaheer","familyName":"Muhammad","name":"Muhammad, Shaheer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Preslav","familyName":"Nakov","name":"Nakov, Preslav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gurpreet","familyName":"Gosal","name":"Gosal, Gurpreet","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PTPP-Aware Adaptation Scaling Laws: Predicting Domain-Adaptation Performance at Unseen Pre-Training Budgets"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T10:36:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:35:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Continual pre-training (CPT) for domain adaptation must balance target-domain gains with stability on the base domain. Existing CPT scaling laws typically assume a fixed pre-training budget, which limits their ability to forecast adaptation outcomes for models trained at different tokens-per-parameter (PTPP). We present \\emph{PTPP-aware} adaptation scaling laws that make the pre-training budget an explicit variable, enabling accurate \\emph{prediction} of adaptation loss at unseen \\ptpp. On a multilingual setup (English/Arabic $\\rightarrow$ French), PTPP-aware formulations trained on early stages (\\ptpp{}=\\{15,31\\}) predict target loss at \\ptpp{}=279 and outperform a PTPP-agnostic \\dcpt{} transfer baseline on metrics (Huber-on-log, MAE$_\\mathrm{rel}$, calibration slope); full diagnostics (RMSE, MAPE) are in the appendix. Beyond forecasting, we show a practical use case: planning replay ratios and adaptation token budgets that satisfy target and forgetting constraints under compute limits."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23198","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:33:23Z","registered":"2025-10-28T03:33:23Z","published":null,"updated":"2025-10-28T03:33:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23142","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23142","identifiers":[{"identifier":"2510.23142","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chi","familyName":"Liu","name":"Liu, Chi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rethinking GSPO: The Perplexity-Entropy Equivalence"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T09:19:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:32:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide a new perspective on GSPO's length-normalized importance ratios by establishing their connection to information-theoretic quantities. We show that GSPO's sequence-level weight $s(θ) = (π_θ/π_{θ_{\\text{old}}})^{1/|y|}$ can be equivalently expressed as the inverse perplexity ratio $\\text{PPL}_{θ_{\\text{old}}}/\\text{PPL}_θ$ and as the exponential cross-entropy change $\\exp(ΔH)$. While the perplexity-entropy relationship follows from standard definitions, this observation provides a useful lens for understanding GSPO: the algorithm weights policy gradient updates by perplexity ratios, offering an information-theoretic interpretation of the importance weights. This perspective helps explain GSPO's empirical properties, including log-domain variance reduction through geometric averaging and stability in training mixture-of-experts models. We validate the mathematical equivalences and variance predictions through controlled experiments on mathematical reasoning tasks."},{"descriptionType":"Other","description":"10 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23142","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:32:03Z","registered":"2025-10-28T03:32:03Z","published":null,"updated":"2025-10-28T03:32:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23123","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23123","identifiers":[{"identifier":"2510.23123","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shiwei","familyName":"Li","name":"Li, Shiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiandi","familyName":"Luo","name":"Luo, Xiandi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haozhao","familyName":"Wang","name":"Wang, Haozhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Tang","name":"Tang, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqiang","familyName":"Cui","name":"Cui, Ziqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dugang","familyName":"Liu","name":"Liu, Dugang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhua","familyName":"Li","name":"Li, Yuhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiuqiang","familyName":"He","name":"He, Xiuqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruixuan","familyName":"Li","name":"Li, Ruixuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Higher Rank: Token-wise Input-Output Projections for Efficient Low-Rank Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T08:57:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:30:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Low-rank adaptation (LoRA) is a parameter-efficient fine-tuning (PEFT) method widely used in large language models (LLMs). LoRA essentially describes the projection of an input space into a low-dimensional output space, with the dimensionality determined by the LoRA rank. In standard LoRA, all input tokens share the same weights and undergo an identical input-output projection. This limits LoRA's ability to capture token-specific information due to the inherent semantic differences among tokens. To address this limitation, we propose Token-wise Projected Low-Rank Adaptation (TopLoRA), which dynamically adjusts LoRA weights according to the input token, thereby learning token-wise input-output projections in an end-to-end manner. Formally, the weights of TopLoRA can be expressed as $BΣ_X A$, where $A$ and $B$ are low-rank matrices (as in standard LoRA), and $Σ_X$ is a diagonal matrix generated from each input token $X$. Notably, TopLoRA does not increase the rank of LoRA weights but achieves more granular adaptation by learning token-wise LoRA weights (i.e., token-wise input-output projections). Extensive experiments across multiple models and datasets demonstrate that TopLoRA consistently outperforms LoRA and its variants. The code is available at https://github.com/Leopold1423/toplora-neurips25."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23123","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:31:35Z","registered":"2025-10-28T03:31:36Z","published":null,"updated":"2025-10-28T03:31:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23023","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23023","identifiers":[{"identifier":"2510.23023","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huixuan","familyName":"Zhang","name":"Zhang, Huixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojun","familyName":"Wan","name":"Wan, Xiaojun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UniAIDet: A Unified and Universal Benchmark for AI-Generated Image Content Detection and Localization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T05:37:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:23:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid proliferation of image generative models, the authenticity of digital images has become a significant concern. While existing studies have proposed various methods for detecting AI-generated content, current benchmarks are limited in their coverage of diverse generative models and image categories, often overlooking end-to-end image editing and artistic images. To address these limitations, we introduce UniAIDet, a unified and comprehensive benchmark that includes both photographic and artistic images. UniAIDet covers a wide range of generative models, including text-to-image, image-to-image, image inpainting, image editing, and deepfake models. Using UniAIDet, we conduct a comprehensive evaluation of various detection methods and answer three key research questions regarding generalization capability and the relation between detection and localization. Our benchmark and analysis provide a robust foundation for future research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23023","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:29:10Z","registered":"2025-10-28T03:29:11Z","published":null,"updated":"2025-10-28T03:29:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23020","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23020","identifiers":[{"identifier":"2510.23020","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huixuan","familyName":"Zhang","name":"Zhang, Huixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojun","familyName":"Wan","name":"Wan, Xiaojun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"M$^{3}$T2IBench: A Large-Scale Multi-Category, Multi-Instance, Multi-Relation Text-to-Image Benchmark"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T05:32:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:23:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Text-to-image models are known to struggle with generating images that perfectly align with textual prompts. Several previous studies have focused on evaluating image-text alignment in text-to-image generation. However, these evaluations either address overly simple scenarios, especially overlooking the difficulty of prompts with multiple different instances belonging to the same category, or they introduce metrics that do not correlate well with human evaluation. In this study, we introduce M$^3$T2IBench, a large-scale, multi-category, multi-instance, multi-relation along with an object-detection-based evaluation metric, $AlignScore$, which aligns closely with human evaluation. Our findings reveal that current open-source text-to-image models perform poorly on this challenging benchmark. Additionally, we propose the Revise-Then-Enforce approach to enhance image-text alignment. This training-free post-editing method demonstrates improvements in image-text alignment across a broad range of diffusion models. \\footnote{Our code and data has been released in supplementary material and will be made publicly available after the paper is accepted.}"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23020","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:29:06Z","registered":"2025-10-28T03:29:06Z","published":null,"updated":"2025-10-28T03:29:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22866","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22866","identifiers":[{"identifier":"2510.22866","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tiasa Singha","familyName":"Roy","name":"Roy, Tiasa Singha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayush Rajesh","familyName":"Jhaveri","name":"Jhaveri, Ayush Rajesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ilias","familyName":"Triantafyllopoulos","name":"Triantafyllopoulos, Ilias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interpreting and Mitigating Unwanted Uncertainty in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T23:16:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:12:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite their impressive capabilities, Large Language Models (LLMs) exhibit unwanted uncertainty, a phenomenon where a model changes a previously correct answer into an incorrect one when re-prompted. This behavior undermines trust and poses serious risks in high-stakes domains. In this work, we investigate the mechanisms that drive this phenomenon. We adapt the Needle-in-a-Haystack retrieval framework and integrate a Flip-style re-evaluation prompt to simulate realistic answer-flipping scenarios. We find that retrieval heads are not primarily responsible for avoiding uncertainty. Instead, we identify a small set of non-retrieval attention heads that disproportionately attend to misleading tokens in uncertain contexts. Masking these heads yields significant improvements, reducing flip behavior by up to 15% without introducing incoherence or overcorrection. However, when tested for downstream tasks, we observe trade-offs with flip behavior. Our findings contribute to the growing field of mechanistic interpretability and present a simple yet effective technique for mitigating uncertainty-driven failure modes in LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22866","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:25:26Z","registered":"2025-10-28T03:25:27Z","published":null,"updated":"2025-10-28T03:25:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22684","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22684","identifiers":[{"identifier":"2510.22684","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiuniu","familyName":"Wang","name":"Wang, Jiuniu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gongjie","familyName":"Zhang","name":"Zhang, Gongjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quanhao","familyName":"Qian","name":"Qian, Quanhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junlong","familyName":"Gao","name":"Gao, Junlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deli","familyName":"Zhao","name":"Zhao, Deli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ran","familyName":"Xu","name":"Xu, Ran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RoboSVG: A Unified Framework for Interactive SVG Generation with Multi-modal Guidance"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T13:57:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:01:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Scalable Vector Graphics (SVGs) are fundamental to digital design and robot control, encoding not only visual structure but also motion paths in interactive drawings. In this work, we introduce RoboSVG, a unified multimodal framework for generating interactive SVGs guided by textual, visual, and numerical signals. Given an input query, the RoboSVG model first produces multimodal guidance, then synthesizes candidate SVGs through dedicated generation modules, and finally refines them under numerical guidance to yield high-quality outputs. To support this framework, we construct RoboDraw, a large-scale dataset of one million examples, each pairing an SVG generation condition (e.g., text, image, and partial SVG) with its corresponding ground-truth SVG code. RoboDraw dataset enables systematic study of four tasks, including basic generation (Text-to-SVG, Image-to-SVG) and interactive generation (PartialSVG-to-SVG, PartialImage-to-SVG). Extensive experiments demonstrate that RoboSVG achieves superior query compliance and visual fidelity across tasks, establishing a new state of the art in versatile SVG generation. The dataset and source code of this project will be publicly available soon."},{"descriptionType":"Other","description":"15 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22684","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:21:10Z","registered":"2025-10-28T03:21:11Z","published":null,"updated":"2025-10-28T03:21:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22679","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22679","identifiers":[{"identifier":"2510.22679","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuval","familyName":"Kainan","name":"Kainan, Yuval","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaked","familyName":"Zychlinski","name":"Zychlinski, Shaked","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do Stop Me Now: Detecting Boilerplate Responses with a Single Iteration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T13:43:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:01:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) often expend significant computational resources generating boilerplate responses, such as refusals, simple acknowledgements and casual greetings, which adds unnecessary cost and latency. To address this inefficiency, we propose a simple yet highly effective method for detecting such responses after only a single generation step. We demonstrate that the log-probability distribution of the first generated token serves as a powerful signal for classifying the nature of the entire subsequent response. Our experiments, conducted across a diverse range of small, large, and reasoning-specialized models, show that the first-token log-probability vectors form distinctly separable clusters for different response types. Using a lightweight k-NN classifier, we achieve high accuracy in predicting whether a response will be a substantive answer or a form of boilerplate response, including user-specified refusals. The primary implication is a practical, computationally trivial technique, optimizing LLM inference by enabling early termination or redirection to a smaller model, thereby yielding significant savings in computational cost. This work presents a direct path toward more efficient and sustainable LLM deployment."},{"descriptionType":"Other","description":"13 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22679","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:21:03Z","registered":"2025-10-28T03:21:04Z","published":null,"updated":"2025-10-28T03:21:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22548","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22548","identifiers":[{"identifier":"2510.22548","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyuan","familyName":"He","name":"He, Ziyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Wang","name":"Wang, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Li","name":"Li, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kexin","familyName":"Liang","name":"Liang, Kexin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhan","familyName":"Zhang","name":"Zhang, Muhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LooGLE v2: Are LLMs Ready for Real World Long Dependency Challenges?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T06:14:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:52:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are equipped with increasingly extended context windows recently, yet their long context understanding capabilities over long dependency tasks remain fundamentally limited and underexplored. This gap is especially significant in many real-world long-context applications that were rarely benchmarked. In this paper, we introduce LooGLE v2, a novel benchmark designed to evaluate LLMs' long context ability in real-world applications and scenarios. Our benchmark consists of automatically collected real-world long texts, ranging from 16k to 2M tokens, encompassing domains in law, finance, game and code. Accordingly, we delicately design 10 types of domain-specific long-dependency tasks and generate 1,934 QA instances with various diversity and complexity in a scalable data curation pipeline for further practical needs. We conduct a comprehensive assessment of 6 locally deployed and 4 API-based LLMs. The evaluation results show that even the best-performing model achieves only a 59.2% overall score on our benchmark. Despite the extensive context windows, popular LLMs are only capable of understanding a much shorter length of context than they claim to be, revealing significant limitations in their ability to handle real-world tasks with long dependencies and highlighting substantial room for model improvement in practical long-context understanding."},{"descriptionType":"Other","description":"NeurIPS 2025 Datasets and Benchmarks Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22548","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:17:56Z","registered":"2025-10-28T03:17:57Z","published":null,"updated":"2025-10-28T03:17:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22492","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22492","identifiers":[{"identifier":"2510.22492","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyu","familyName":"Liang","name":"Liang, Siyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicolas","familyName":"Ballier","name":"Ballier, Nicolas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gina-Anne","familyName":"Levow","name":"Levow, Gina-Anne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Wright","name":"Wright, Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Limits of Data Scaling: Sub-token Utilization and Acoustic Saturation in Multilingual ASR"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T02:13:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:48:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"How much audio is needed to fully observe a multilingual ASR model's learned sub-token inventory across languages, and does data disparity in multilingual pre-training affect how these tokens are utilized during inference? We address this question by analyzing Whisper's decoding behavior during inference across 49 languages. By logging decoding candidate sub-tokens and tracking their cumulative discovery over time, we study the utilization pattern of the model's sub-token space. Results show that the total number of discovered tokens remains largely independent of a language's pre-training hours, indicating that data disparity does not strongly influence lexical diversity in the model's hypothesis space. Sub-token discovery rates follow a consistent exponential saturation pattern across languages, suggesting a stable time window after which additional audio yields minimal new sub-token activation. We refer to this convergence threshold as acoustic saturation time (AST). Further analyses of rank-frequency distributions reveal Zipf-like patterns better modeled by a Zipf-Mandelbrot law, and mean sub-token length shows a positive correlation with resource level. Additionally, those metrics show more favorable patterns for languages in the Latin script than those in scripts such as Cyrillic, CJK, and Semitic. Together, our study suggests that sub-token utilization during multilingual ASR inference is constrained more by the statistical, typological, and orthographic structure of the speech than by training data scale, providing an empirical basis for more equitable corpus construction and cross-lingual evaluation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22492","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:16:38Z","registered":"2025-10-28T03:16:39Z","published":null,"updated":"2025-10-28T03:16:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22376","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22376","identifiers":[{"identifier":"2510.22376","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zirui","familyName":"Pang","name":"Pang, Zirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zheng","name":"Zheng, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijie","familyName":"Deng","name":"Deng, Zhijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Li","name":"Li, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixin","familyName":"Zhong","name":"Zhong, Zixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaheng","familyName":"Wei","name":"Wei, Jiaheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Label Smoothing Improves Gradient Ascent in LLM Unlearning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T17:43:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:41:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLM unlearning has emerged as a promising approach, aiming to enable models to forget hazardous/undesired knowledge at low cost while preserving as much model utility as possible. Among existing techniques, the most straightforward method is performing Gradient Ascent (GA) w.r.t. the forget data, thereby forcing the model to unlearn the forget dataset. However, GA suffers from severe instability, as it drives updates in a divergent direction, often resulting in drastically degraded model utility. To address this issue, we propose Smoothed Gradient Ascent (SGA). SGA combines the forget data with multiple constructed normal data through a tunable smoothing rate. Intuitively, this extends GA from learning solely on the forget data to jointly learning across both forget and normal data, enabling more stable unlearning while better preserving model utility. Theoretically, we provide the theoretical guidance on the selection of the optimal smoothing rate. Empirically, we evaluate SGA on three benchmarks: TOFU, Harry Potter, and MUSE-NEWS. Experimental results demonstrate that SGA consistently outperforms the original Gradient Ascent (GA) method across all metrics and achieves top-2 performance among all baseline methods on several key metrics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22376","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:13:55Z","registered":"2025-10-28T03:13:55Z","published":null,"updated":"2025-10-28T03:13:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22256","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22256","identifiers":[{"identifier":"2510.22256","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaoyan","familyName":"Zhao","name":"Zhao, Xiaoyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Yan","name":"Yan, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilun","familyName":"Qiu","name":"Qiu, Yilun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoting","familyName":"Ni","name":"Ni, Haoting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuli","familyName":"Feng","name":"Feng, Fuli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Cheng","name":"Cheng, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tat-Seng","familyName":"Chua","name":"Chua, Tat-Seng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SteerX: Disentangled Steering for LLM Personalization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T11:26:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:34:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have shown remarkable success in recent years, enabling a wide range of applications, including intelligent assistants that support users' daily life and work. A critical factor in building such assistants is personalizing LLMs, as user preferences and needs vary widely. Activation steering, which directly leverages directions representing user preference in the LLM activation space to adjust its behavior, offers a cost-effective way to align the model's outputs with individual users. However, existing methods rely on all historical data to compute the steering vector, ignoring that not all content reflects true user preferences, which undermines the personalization signal. To address this, we propose SteerX, a disentangled steering method that isolates preference-driven components from preference-agnostic components. Grounded in causal inference theory, SteerX estimates token-level causal effects to identify preference-driven tokens, transforms these discrete signals into a coherent description, and then leverages them to steer personalized LLM generation. By focusing on the truly preference-driven information, SteerX produces more accurate activation steering vectors and enhances personalization. Experiments on two representative steering backbone methods across real-world datasets demonstrate that SteerX consistently enhances steering vector quality, offering a practical solution for more effective LLM personalization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22256","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:11:02Z","registered":"2025-10-28T03:11:03Z","published":null,"updated":"2025-10-28T03:11:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22255","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22255","identifiers":[{"identifier":"2510.22255","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eunseop","familyName":"Yoon","name":"Yoon, Eunseop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hee Suk","familyName":"Yoon","name":"Yoon, Hee Suk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaehyun","familyName":"Jang","name":"Jang, Jaehyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"SooHwan","familyName":"Eom","name":"Eom, SooHwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Dai","name":"Dai, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chong","familyName":"Luo","name":"Luo, Chong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark A.","familyName":"Hasegawa-Johnson","name":"Hasegawa-Johnson, Mark A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang D.","familyName":"Yoo","name":"Yoo, Chang D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PACR: Progressively Ascending Confidence Reward for LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T11:25:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:34:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning with Verifiable Rewards (RLVR) has significantly improved LLM reasoning, but its sparse, outcome-based reward provides no guidance for intermediate steps, slowing exploration. We propose Progressively Ascending Confidence Reward (PACR), a dense, model-intrinsic reward computed directly from the model's evolving belief in the correct answer. PACR encodes the inductive bias that, along a well-formed reasoning trajectory, the probability of the ground-truth answer should have a generally ascending trend. We provide empirical and theoretical analysis validating that such an inductive bias constrains the exploration search space to regions richer in logically sound reasoning. We demonstrate that PACR accelerates exploration, reaches reward saturation with fewer trajectories, and yields improvements on multiple benchmarks. Our results suggest that dense, model-intrinsic shaping signals can make RLVR training more effective and reliable."},{"descriptionType":"Other","description":"16 pages, 14 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22255","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:11:01Z","registered":"2025-10-28T03:11:01Z","published":null,"updated":"2025-10-28T03:11:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22207","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22207","identifiers":[{"identifier":"2510.22207","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nnamdi","familyName":"Aghanya","name":"Aghanya, Nnamdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Li","name":"Li, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kewei","familyName":"Wang","name":"Wang, Kewei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Lossy Horizon: Error-Bounded Predictive Coding for Lossy Text Compression (Episode I)"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"E.4; I.2.7; I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"94A08, 68P30, 68T50","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-10-25T08:18:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:29:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) can achieve near-optimal lossless compression by acting as powerful probability models. We investigate their use in the lossy domain, where reconstruction fidelity is traded for higher compression ratios. This paper introduces Error-Bounded Predictive Coding (EPC), a lossy text codec that leverages a Masked Language Model (MLM) as a decompressor. Instead of storing a subset of original tokens, EPC allows the model to predict masked content and stores minimal, rank-based corrections only when the model's top prediction is incorrect. This creates a residual channel that offers continuous rate-distortion control. We compare EPC to a simpler Predictive Masking (PM) baseline and a transform-based Vector Quantisation with a Residual Patch (VQ+RE) approach. Through an evaluation that includes precise bit accounting and rate-distortion analysis, we demonstrate that EPC consistently dominates PM, offering superior fidelity at a significantly lower bit rate by more efficiently utilising the model's intrinsic knowledge."},{"descriptionType":"Other","description":"12 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22207","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:09:51Z","registered":"2025-10-28T03:09:52Z","published":null,"updated":"2025-10-28T03:09:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22141","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22141","identifiers":[{"identifier":"2510.22141","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuhang","familyName":"Gao","name":"Gao, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Xiang","name":"Xiang, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Zhong","name":"Zhong, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoyou","familyName":"Wang","name":"Wang, Guoyou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LOC: A General Language-Guided Framework for Open-Set 3D Occupancy Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T03:27:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:24:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs) have shown significant progress in open-set challenges. However, the limited availability of 3D datasets hinders their effective application in 3D scene understanding. We propose LOC, a general language-guided framework adaptable to various occupancy networks, supporting both supervised and self-supervised learning paradigms. For self-supervised tasks, we employ a strategy that fuses multi-frame LiDAR points for dynamic/static scenes, using Poisson reconstruction to fill voids, and assigning semantics to voxels via K-Nearest Neighbor (KNN) to obtain comprehensive voxel representations. To mitigate feature over-homogenization caused by direct high-dimensional feature distillation, we introduce Densely Contrastive Learning (DCL). DCL leverages dense voxel semantic information and predefined textual prompts. This efficiently enhances open-set recognition without dense pixel-level supervision, and our framework can also leverage existing ground truth to further improve performance. Our model predicts dense voxel features embedded in the CLIP feature space, integrating textual and image pixel information, and classifies based on text and semantic similarity. Experiments on the nuScenes dataset demonstrate the method's superior performance, achieving high-precision predictions for known classes and distinguishing unknown classes without additional training data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22141","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:08:15Z","registered":"2025-10-28T03:08:16Z","published":null,"updated":"2025-10-28T03:08:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22139","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22139","identifiers":[{"identifier":"2510.22139","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinzhe","familyName":"Liu","name":"Liu, Jinzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junshu","familyName":"Sun","name":"Sun, Junshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shufan","familyName":"Shen","name":"Shen, Shufan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxue","familyName":"Yang","name":"Yang, Chenxue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhui","familyName":"Wang","name":"Wang, Shuhui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Edit Less, Achieve More: Dynamic Sparse Neuron Masking for Lifelong Knowledge Editing in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T03:22:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:24:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Lifelong knowledge editing enables continuous, precise updates to outdated knowledge in large language models (LLMs) without computationally expensive full retraining. However, existing methods often accumulate errors throughout the editing process, causing a gradual decline in both editing accuracy and generalization. To tackle this problem, we propose Neuron-Specific Masked Knowledge Editing (NMKE), a novel fine-grained editing framework that combines neuron-level attribution with dynamic sparse masking. Leveraging neuron functional attribution, we identify two key types of knowledge neurons, with knowledge-general neurons activating consistently across prompts and knowledge-specific neurons activating to specific prompts. NMKE further introduces an entropy-guided dynamic sparse mask, locating relevant neurons to the target knowledge. This strategy enables precise neuron-level knowledge editing with fewer parameter modifications. Experimental results from thousands of sequential edits demonstrate that NMKE outperforms existing methods in maintaining high editing success rates and preserving model general capabilities in lifelong editing."},{"descriptionType":"Other","description":"19 pages, 11 figures, Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22139","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:08:12Z","registered":"2025-10-28T03:08:13Z","published":null,"updated":"2025-10-28T03:08:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22099","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22099","identifiers":[{"identifier":"2510.22099","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuanming","familyName":"Zhang","name":"Zhang, Xuanming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalization or Memorization: Dynamic Decoding for Mode Steering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T00:50:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:20:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) exhibit a troubling duality, capable of both remarkable generalization and brittle, verbatim memorization of their training data. This unpredictability undermines their reliability in high-stakes applications. In this work, we propose a unified framework to understand, identify, and control these distinct reasoning modes. First, we introduce a theoretical model based on the Information Bottleneck (IB) principle, formalizing generalization as the learning of a compressed, task-relevant representation and memorization as a failure to compress. Building on this theory, we develop Dynamic Mode Steering (DMS), a novel inference-time algorithm which comprises two components: (1) a lightweight, causally-grounded linear probe that identifies the model's instantaneous reliance on memorization, and (2) a dynamic activation steering mechanism that nudges the model's computation towards pre-identified generalization circuits. We frame DMS as a form of adaptive, self-contrastive decoding. Experiments on reasoning and faithfulness tasks demonstrate that DMS significantly improves logical consistency and factual accuracy, thereby offering a principled approach to enhancing LLM reliability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22099","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:07:15Z","registered":"2025-10-28T03:07:16Z","published":null,"updated":"2025-10-28T03:07:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.21983","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21983","identifiers":[{"identifier":"2510.21983","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Havva Alizadeh","familyName":"Noughabi","name":"Noughabi, Havva Alizadeh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julien","familyName":"Serbanescu","name":"Serbanescu, Julien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fattane","familyName":"Zarrinkalam","name":"Zarrinkalam, Fattane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Dehghantanha","name":"Dehghantanha, Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncovering the Persuasive Fingerprint of LLMs in Jailbreaking Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T19:20:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:10:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite recent advances, Large Language Models remain vulnerable to jailbreak attacks that bypass alignment safeguards and elicit harmful outputs. While prior research has proposed various attack strategies differing in human readability and transferability, little attention has been paid to the linguistic and psychological mechanisms that may influence a model's susceptibility to such attacks. In this paper, we examine an interdisciplinary line of research that leverages foundational theories of persuasion from the social sciences to craft adversarial prompts capable of circumventing alignment constraints in LLMs. Drawing on well-established persuasive strategies, we hypothesize that LLMs, having been trained on large-scale human-generated text, may respond more compliantly to prompts with persuasive structures. Furthermore, we investigate whether LLMs themselves exhibit distinct persuasive fingerprints that emerge in their jailbreak responses. Empirical evaluations across multiple aligned LLMs reveal that persuasion-aware prompts significantly bypass safeguards, demonstrating their potential to induce jailbreak behaviors. This work underscores the importance of cross-disciplinary insight in addressing the evolving challenges of LLM safety. The code and data are available."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.21983","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:04:32Z","registered":"2025-10-28T03:04:33Z","published":null,"updated":"2025-10-28T03:04:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.21961","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21961","identifiers":[{"identifier":"2510.21961","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Iskander","familyName":"Azangulov","name":"Azangulov, Iskander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teodora","familyName":"Pandeva","name":"Pandeva, Teodora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niranjani","familyName":"Prasad","name":"Prasad, Niranjani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javier","familyName":"Zazo","name":"Zazo, Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sushrut","familyName":"Karmalkar","name":"Karmalkar, Sushrut","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Parallel Sampling from Masked Diffusion Models via Conditional Independence Testing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T18:41:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:08:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Masked diffusion models (MDMs) offer a compelling alternative to autoregressive models (ARMs) for discrete text generation because they enable parallel token sampling, rather than sequential, left-to-right generation. This means potentially much faster inference. However, effective parallel sampling faces two competing requirements: (i) simultaneously updated tokens must be conditionally independent, and (ii) updates should prioritise high-confidence predictions. These goals conflict because high-confidence predictions often cluster and depend on each other, opportunities for parallel updates.\n We present PUNT, a model-agnostic sampler that reconciles this trade-off. Our method identifies token dependencies and removes lower-confidence tokens from conflicting groups. This produces sets of indices for unmasking that satisfy both independence and confidence criteria. Our approach ensures improved parallel unmasking through approximate conditional independence testing.\n Our experiments show that PUNT delivers a superior trade-off between accuracy and compute when compared to other strong training-free baselines, especially for generation of longer sequences. On the IFEval benchmark, it achieves up to 16\\% higher accuracy over baseline methods, including sequential generation (one-by-one). These gains hold across different values of hyperparameters, mitigating the need for brittle hyperparameter tuning. Moreover, we observe that PUNT induces an emergent hierarchical generation strategy, where the model first establishes high-level paragraph structure before local refinement, suggesting a planning-like generation process that contributes to strong alignment performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.21961","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:04:01Z","registered":"2025-10-28T03:04:01Z","published":null,"updated":"2025-10-28T03:04:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.21909","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21909","identifiers":[{"identifier":"2510.21909","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Catherine","familyName":"Arnett","name":"Arnett, Catherine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tyler A.","familyName":"Chang","name":"Chang, Tyler A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stella","familyName":"Biderman","name":"Biderman, Stella","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin K.","familyName":"Bergen","name":"Bergen, Benjamin K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Explaining and Mitigating Crosslingual Tokenizer Inequities"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T17:36:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:05:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The number of tokens it takes to encode parallel text in different languages is known to vary. These disparities are called token premiums. Having high token premiums leads to less throughput during training and increases costs at inference. In this paper, we show that even after controlling for dataset size, vocabulary size, and data content, monolingual tokenizers exhibit a wide range of token premiums across languages. To understand the cross-linguistic differences that cause these token premiums, we train a suite of approximately 7,000 comparable monolingual tokenizers for 97 languages, manipulating tokenization algorithm, vocabulary size, and dataset size. We measure token premiums and test for a relationship between factors such as data similarity (between tokenizer training and evaluation), vocabulary size, and pre-tokenization. We also investigate the role of language-specific features such as writing system and word length. We find that similarity between training and test data does not impact token premiums, but vocabulary size and pre-tokenization do. While simply increasing vocabulary size does not lead to reduced token premium effects, we can determine an ``optimal'' vocabulary size for each language to achieve significantly reduced token premium effects. We also train superword tokenizers which allow merges over whitespaces, and we find that they both reduce token premium effects and improve compression overall. Thus, intervening on the vocabulary size or the pre-tokenizer significantly reduces crosslingual token premium effects."},{"descriptionType":"Other","description":"Accepted to NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.21909","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:02:48Z","registered":"2025-10-28T03:02:49Z","published":null,"updated":"2025-10-28T03:02:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.21900","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21900","identifiers":[{"identifier":"2510.21900","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongbo","familyName":"Zhang","name":"Zhang, Hongbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Cui","name":"Cui, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yidong","familyName":"Wang","name":"Wang, Yidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijian","familyName":"Tian","name":"Tian, Yijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Guo","name":"Guo, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cunxiang","familyName":"Wang","name":"Wang, Cunxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Wu","name":"Wu, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chiyu","familyName":"Song","name":"Song, Chiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Zhang","name":"Zhang, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deep Literature Survey Automation with an Iterative Workflow"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T14:41:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:05:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Automatic literature survey generation has attracted increasing attention, yet most existing systems follow a one-shot paradigm, where a large set of papers is retrieved at once and a static outline is generated before drafting. This design often leads to noisy retrieval, fragmented structures, and context overload, ultimately limiting survey quality. Inspired by the iterative reading process of human researchers, we propose \\ours, a framework based on recurrent outline generation, in which a planning agent incrementally retrieves, reads, and updates the outline to ensure both exploration and coherence. To provide faithful paper-level grounding, we design paper cards that distill each paper into its contributions, methods, and findings, and introduce a review-and-refine loop with visualization enhancement to improve textual flow and integrate multimodal elements such as figures and tables. Experiments on both established and emerging topics show that \\ours\\ substantially outperforms state-of-the-art baselines in content coverage, structural coherence, and citation quality, while producing more accessible and better-organized surveys. To provide a more reliable assessment of such improvements, we further introduce Survey-Arena, a pairwise benchmark that complements absolute scoring and more clearly positions machine-generated surveys relative to human-written ones. The code is available at https://github.com/HancCui/IterSurvey\\_Autosurveyv2."},{"descriptionType":"Other","description":"Preprint version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.21900","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:02:35Z","registered":"2025-10-28T03:02:36Z","published":null,"updated":"2025-10-28T03:02:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":51,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=doi%3A%2810.48550%2Farxiv.2510.21900+OR+10.48550%2Farxiv.2510.21909+OR+10.48550%2Farxiv.2510.21954+OR+10.48550%2Farxiv.2510.21961+OR+10.48550%2Farxiv.2510.21983+OR+10.48550%2Farxiv.2510.22007+OR+10.48550%2Farxiv.2510.22028+OR+10.48550%2Farxiv.2510.22037+OR+10.48550%2Farxiv.2510.22099+OR+10.48550%2Farxiv.2510.22102+OR+10.48550%2Farxiv.2510.22115+OR+10.48550%2Farxiv.2510.22139+OR+10.48550%2Farxiv.2510.22141+OR+10.48550%2Farxiv.2510.22172+OR+10.48550%2Farxiv.2510.22207+OR+10.48550%2Farxiv.2510.22255+OR+10.48550%2Farxiv.2510.22256+OR+10.48550%2Farxiv.2510.22373+OR+10.48550%2Farxiv.2510.22376+OR+10.48550%2Farxiv.2510.22437+OR+10.48550%2Farxiv.2510.22492+OR+10.48550%2Farxiv.2510.22500+OR+10.48550%2Farxiv.2510.22548+OR+10.48550%2Farxiv.2510.22588+OR+10.48550%2Farxiv.2510.22672+OR+10.48550%2Farxiv.2510.22679+OR+10.48550%2Farxiv.2510.22684+OR+10.48550%2Farxiv.2510.22733+OR+10.48550%2Farxiv.2510.22739+OR+10.48550%2Farxiv.2510.22767+OR+10.48550%2Farxiv.2510.22780+OR+10.48550%2Farxiv.2510.22866+OR+10.48550%2Farxiv.2510.22876+OR+10.48550%2Farxiv.2510.22907+OR+10.48550%2Farxiv.2510.23020+OR+10.48550%2Farxiv.2510.23023+OR+10.48550%2Farxiv.2510.23123+OR+