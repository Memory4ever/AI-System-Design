{"data":[{"id":"10.48550/arxiv.2510.23160","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23160","identifiers":[{"identifier":"2510.23160","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zile","familyName":"Yang","name":"Yang, Zile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Li","name":"Li, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Na","familyName":"Di","name":"Di, Na","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinlong","familyName":"Pang","name":"Pang, Jinlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Zhou","name":"Zhou, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Cheng","name":"Cheng, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Han","name":"Han, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaheng","familyName":"Wei","name":"Wei, Jiaheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reclaiming Low-Quality Instruction Data with Rule-Guided LLM Reconstruction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T09:39:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:33:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-14T14:53:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-15T01:23:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Data selection for supervised fine-tuning (SFT) often discards low-scoring instruction examples that may retain useful supervision. We propose a rule-guided LLM reconstruction framework to reclaim this information. The framework identifies low-scoring samples through LLM-based rating and score correction, selects semantically representative sources, and reconstructs instruction-response pairs through strategy-guided generation, criteria-based validation, and failure-guided repair. From 123,786 low-scoring samples, it constructs 54,888 training examples. Across three 7B/8B base LLMs, the reconstructed data achieves higher average downstream performance than the low-scoring source set and all evaluated data-selection baselines. Despite using substantially fewer examples than the full source dataset (approximately 300K), it achieves higher reported average scores than full-data training across all three base models. Stepwise ablations identify rule-guided reconstruction as the largest source of observed improvements over direct fusion, while a manual audit reveals remaining limitations in source integration and answer faithfulness. These findings support reconstruction as a complementary approach to selection-based SFT data curation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23160","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:32:28Z","registered":"2025-10-28T03:32:29Z","published":null,"updated":"2026-10-15T03:09:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22172","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22172","identifiers":[{"identifier":"2510.22172","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruixiang","familyName":"Mao","name":"Mao, Ruixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangnan","familyName":"Ma","name":"Ma, Xiangnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Yang","name":"Yang, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziming","familyName":"Zhu","name":"Zhu, Ziming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yucheng","familyName":"Qiao","name":"Qiao, Yucheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Ge","name":"Ge, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tong","familyName":"Xiao","name":"Xiao, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengxiang","familyName":"Gao","name":"Gao, Shengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengtao","familyName":"Yu","name":"Yu, Zhengtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingbo","familyName":"Zhu","name":"Zhu, Jingbo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"M-CIF: Multi-Scale Alignment For CIF-Based Non-Autoregressive ASR"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T05:51:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:27:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-21T15:40:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-22T02:11:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The Continuous Integrate-and-Fire (CIF) mechanism provides effective alignment for non-autoregressive (NAR) speech recognition. This mechanism creates a smooth and monotonic mapping from acoustic features to target tokens, achieving performance on Mandarin competitive with other NAR approaches. However, without finer-grained guidance, its stability degrades in some languages such as English and French. In this paper, we propose Multi-scale CIF (M-CIF), which performs multi-level alignment by integrating character and phoneme level supervision progressively distilled into subword representations, thereby enhancing robust acoustic-text alignment. Experiments show that M-CIF reduces WER compared to the Paraformer baseline, especially on CommonVoice by 4.21% in German and 3.05% in French. To further investigate these gains, we define phonetic confusion errors (PE) and space-related segmentation errors (SE) as evaluation metrics. Analysis of these metrics across different M-CIF settings reveals that the phoneme and character layers are essential for enhancing progressive CIF alignment."},{"descriptionType":"Other","description":"Accepted by CCL 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22172","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:09:00Z","registered":"2025-10-28T03:09:03Z","published":null,"updated":"2026-09-22T04:43:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22115","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22115","identifiers":[{"identifier":"2510.22115","identifierType":"arXiv"}],"creators":[{"nameType":"Organizational","name":"Ling Team","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ang","familyName":"Li","name":"Li, Ang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ben","familyName":"Liu","name":"Liu, Ben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binbin","familyName":"Hu","name":"Hu, Binbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Li","name":"Li, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingwei","familyName":"Zeng","name":"Zeng, Bingwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Borui","familyName":"Ye","name":"Ye, Borui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caizhi","familyName":"Tang","name":"Tang, Caizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changxin","familyName":"Tian","name":"Tian, Changxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Huang","name":"Huang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Zhang"