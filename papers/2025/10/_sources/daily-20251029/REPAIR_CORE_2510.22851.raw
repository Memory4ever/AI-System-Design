<th id="S4.T3.6.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt">CLIP<sub id="S4.T3.6.1.3.1" class="ltx_sub"><span id="S4.T3.6.1.3.1.1" class="ltx_text ltx_font_italic">s</span></sub><math id="S4.T3.m10" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
