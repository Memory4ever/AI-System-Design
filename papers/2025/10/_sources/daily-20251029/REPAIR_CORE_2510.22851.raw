<th id="S4.T3.6.1.6" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt">CLIP-30K<math id="S4.T3.m14" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th></tr>
