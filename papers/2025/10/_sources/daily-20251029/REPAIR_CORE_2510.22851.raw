<td id="A1.T5.2.1.3.1" class="ltx_td ltx_align_left">I2P Explicit Content Removal</td>
<td id="A1.T5.2.1.3.2" class="ltx_td ltx_align_center">-0.06</td>
<td id="A1.T5.2.1.3.3" class="ltx_td ltx_align_center">0.02 (Global)</td>
<td id="A1.T5.2.1.3.4" class="ltx_td ltx_align_center">0.5 (Global)</td>
<td id="A1.T5.2.1.3.5" class="ltx_td ltx_align_center">Yes (NudeNet <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite>)</td>
<td id="A1.T5.2.1.3.6" class="ltx_td ltx_align_center">1.0</td></tr>
<tr id="A1.T5.2.1.4" class="ltx_tr">
<td id="A1.T5.2.1.4.1" class="ltx_td ltx_align_left">Artistic Style Erasure</td>
<td id="A1.T5.2.1.4.2" class="ltx_td ltx_align_center">-0.30</td>
