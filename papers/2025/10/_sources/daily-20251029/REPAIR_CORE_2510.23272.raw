</span>
<span id="lstnumberx10" class="ltx_listingline"><span id="lstnumberx10.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">    </span><span id="lstnumberx10.2" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx10.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">aesthetics_score</span><span id="lstnumberx10.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">":</span><span id="lstnumberx10.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx10.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">score_B_2</span><span id="lstnumberx10.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span>
</span>
<span id="lstnumberx11" class="ltx_listingline"><span id="lstnumberx11.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">    </span><span id="lstnumberx11.2" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx11.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">structure_score</span><span id="lstnumberx11.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">":</span><span id="lstnumberx11.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx11.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">score_B_3</span><span id="lstnumberx11.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span>
</span>
