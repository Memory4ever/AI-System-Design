<td id="S7.T1.7.1.7.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center">0.09</td>
<td id="S7.T1.7.1.7.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center">69</td>
<td id="S7.T1.7.1.7.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right">0.61 <span class="ltx_rule" style="width:0.6pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
<td id="S7.T1.7.1.7.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center">23.53</td>
