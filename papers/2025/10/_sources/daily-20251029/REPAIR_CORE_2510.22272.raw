<th id="S6.T2.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T2.2.1.2.1" class="ltx_text" style="font-size:90%;">Baseline</span></th>
<th id="S6.T2.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T2.2.1.3.1" class="ltx_text" style="font-size:90%;">RAG Slide Text</span></th></tr>
</thead>
