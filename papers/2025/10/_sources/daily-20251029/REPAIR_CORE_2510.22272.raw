<td id="S6.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T2.2.2.2.1" class="ltx_text" style="font-size:90%;">45.27</span></td>
<td id="S6.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T2.2.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">47.36</span></td></tr>
<tr id="S6.T2.2.3" class="ltx_tr">
