<div id="A5.T3.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:56.4pt;vertical-align:-26.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-131.8pt,21.6pt) scale(0.566811890687596,0.566811890687596) ;">
