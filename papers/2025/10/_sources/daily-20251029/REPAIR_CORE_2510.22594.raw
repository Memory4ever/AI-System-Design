<td id="S5.T1.3.1.2.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">57.1</td>
<td id="S5.T1.3.1.2.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">60.2</td>
<td id="S5.T1.3.1.2.6" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">59.0</td>
<td id="S5.T1.3.1.2.7" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">63.1</td>
<td id="S5.T1.3.1.2.8" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">59.9</td>
<td id="S5.T1.3.1.2.9" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">60.7</td></tr>
<tr id="S5.T1.3.1.3" class="ltx_tr">
<td id="S5.T1.3.1.3.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_l ltx_border_r ltx_border_t">Accuracy</td>
<td id="S5.T1.3.1.3.2" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t">0.59</td>
<td id="S5.T1.3.1.3.3" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t">0.62</td>
<td id="S5.T1.3.1.3.4" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t">0.62</td>
<td id="S5.T1.3.1.3.5" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t">0.63</td>
<td id="S5.T1.3.1.3.6" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t">0.60</td>
<td id="S5.T1.3.1.3.7" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t">0.64</td>
