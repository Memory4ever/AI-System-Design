{"data":[{"id":"10.48550/arxiv.2510.22087","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22087","identifiers":[{"identifier":"2510.22087","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shvetank","familyName":"Prakash","name":"Prakash, Shvetank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Cheng","name":"Cheng, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Mazumder","name":"Mazumder, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arya","familyName":"Tschand","name":"Tschand, Arya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Varun","familyName":"Gohil","name":"Gohil, Varun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeffrey","familyName":"Ma","name":"Ma, Jeffrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Yik","name":"Yik, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zishen","familyName":"Wan","name":"Wan, Zishen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jessica","familyName":"Quaye","name":"Quaye, Jessica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elisavet Lydia","familyName":"Alvanaki","name":"Alvanaki, Elisavet Lydia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avinash","familyName":"Kumar","name":"Kumar, Avinash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chandrashis","familyName":"Mazumdar","name":"Mazumdar, Chandrashis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tuhin","familyName":"Khare","name":"Khare, Tuhin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Ingare","name":"Ingare, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ikechukwu","familyName":"Uchendu","name":"Uchendu, Ikechukwu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Radhika","familyName":"Ghosal","name":"Ghosal, Radhika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Tyagi","name":"Tyagi, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyu","familyName":"Wang","name":"Wang, Chenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea Mattia","familyName":"Garavagno","name":"Garavagno, Andrea Mattia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarah","familyName":"Gu","name":"Gu, Sarah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alice","familyName":"Guo","name":"Guo, Alice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Grace","familyName":"Hur","name":"Hur, Grace","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca P.","familyName":"Carloni","name":"Carloni, Luca P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tushar","familyName":"Krishna","name":"Krishna, Tushar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ankita","familyName":"Nayak","name":"Nayak, Ankita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Yazdanbakhsh","name":"Yazdanbakhsh, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vijay Janapa","familyName":"Reddi","name":"Reddi, Vijay Janapa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"QuArch: A Benchmark for Evaluating LLM Reasoning in Computer Architecture"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T23:54:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:18:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-21T03:14:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-22T00:21:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-08T05:22:36Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-11T00:21:24Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The field of computer architecture, which bridges high-level software abstractions and low-level hardware implementations, remains absent from current large language model (LLM) evaluations. To this end, we present QuArch (pronounced 'quark'), the first benchmark designed to facilitate the development and evaluation of LLM knowledge and reasoning capabilities specifically in computer architecture. QuArch v1.0 provides a comprehensive collection of 2,671 expert-validated question-answer (QA) pairs covering various aspects of computer architecture, including processor design, memory systems, and interconnection networks. Our evaluation reveals that while frontier models possess domain-specific knowledge, they struggle with skills that require higher-order thinking in computer architecture. Frontier model accuracies vary widely (from 34% to 73%) on these advanced questions, highlighting persistent gaps in architectural reasoning across analysis, design, and implementation QAs. Furthermore, via fine-tuning we find that QuArch can translate to improved performance on a realistic memory hierarchy design task, resulting in up to 1.99x more area-efficient solutions and up to 40% more viable solutions overall. By holistically assessing fundamental skills, QuArch provides a foundation for building and measuring LLM capabilities that can accelerate innovation in computing systems. The QuArch benchmark and leaderboard are publicly available at: https://quarch.ai/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22087","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:06:58Z","registered":"2025-10-28T03:06:59Z","published":null,"updated":"2026-08-11T04:13:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22170","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22170","identifiers":[{"identifier":"2510.22170","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexandra","familyName":"Yost","name":"Yost, Alexandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shreyans","familyName":"Jain","name":"Jain, Shreyans","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shivam","familyName":"Raval","name":"Raval, Shivam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Grant","familyName":"Corser","name":"Corser, Grant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Allen","familyName":"Roush","name":"Roush, Allen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nina","familyName":"Xu","name":"Xu, Nina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacqueline","familyName":"Hammack","name":"Hammack, Jacqueline","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ravid","familyName":"Shwartz-Ziv","name":"Shwartz-Ziv, Ravid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amirali","familyName":"Abdullah","name":"Abdullah, Amirali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Measure what Matters: Psychometric Evaluation of AI with Situational Judgment Tests"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.6; H.1.2; J.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-25T05:45:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:27:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-09T11:03:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T00:42:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-29T03:51:46Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-30T00:21:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Persona conditioning is widely used to steer large language model (LLM) behavior, but it is unclear whether it induces stable behavioral structure or superficial variation. We propose a framework to measure consistent behavioral tendencies using situational judgment tests (SJTs), multidimensional item response theory (MIRT), and structured synthetic personas, treating responses as observations of latent behavioral variables.\n Across large-scale SJT and persona datasets, we find that persona-conditioned behaviors are stable across runs, latent trait scores predict external benchmarks (e.g., TruthfulQA, EmoBench), and MIRT reveals consistent latent structure. We validate these results through human annotation, benchmark evaluation, and internal consistency analyses.\n We interpret these traits not as human personality, but as stable behavioral tendencies expressed across contexts. Our results show that scenario-based psychometric evaluation provides a more reliable alternative to classical self-report approaches for assessing LLM behavior, and we release datasets to support further study."},{"descriptionType":"Other","description":"100 pages. Code, and link to datasets here: https://github.com/amir-abdullah-thoughtworks/psychometrics_for_LLMs"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22170","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:08:57Z","registered":"2025-10-28T03:08:58Z","published":null,"updated":"2026-07-30T02:20:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22067","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22067","identifiers":[{"identifier":"2510.22067","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zheng","familyName":"Qi","name":"Qi, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Shang","name":"Shang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evangelia","familyName":"Spiliopoulou","name":"Spiliopoulou, Evangelia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikolaos","familyName":"Pappas","name":"Pappas, Nikolaos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Capturing Gaze Shifts for Guidance: Cross-Modal Fusion Enhancement for VLM Hallucination Mitigation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T23:04:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:17:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-10T17:37:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-11T02:50:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-29T17:43:25Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-01T01:17:43Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision language models (VLMs) often generate hallucination, i.e., content that cannot be substantiated by either textual or visual inputs. Prior work primarily attributes this to over-reliance on linguistic prior knowledge rather than visual inputs. Some methods attempt to mitigate hallucination by amplifying visual token attention proportionally to their attention scores. However, these methods overlook the visual attention sink problem, where attention is frequently misallocated to task-irrelevant visual regions, and neglect cross-modal fusion balance by enhancing only visual attention without adjusting attention to the user query. This can result in amplifying incorrect areas while failing to properly interpret the user query. To address these challenges, we propose a simple yet effective method called Gaze Shift-Guided Cross-modal Fusion Enhancement (GIFT). GIFT pre-computes a holistic visual saliency map by tracking positive changes in visual attention, or \"gaze shifts\", during user query comprehension, and leverages this map to amplify attention to both salient visual information and the user query at each decoding step. This reduces the impact of visual attention sink, as irrelevant tokens exhibit minimal shifts, while ensuring balanced cross-modal fusion for well-integrated representation. Extensive experiments show that GIFT effectively mitigates hallucination in VLMs across both generative and classification tasks, achieving up to 20.7% improvement over greedy decoding, while maintaining general vision-language performance with low computational overhead."},{"descriptionType":"Other","description":"ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22067","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:06:30Z","registered":"2025-10-28T03:06:30Z","published":null,"updated":"2026-06-01T02:34:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23008","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23008","identifiers":[{"identifier":"2510.23008","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiuli","familyName":"Wang","name":"Wang, Qiuli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinhuang","familyName":"Sun","name":"Sun, Xinhuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yonglin","familyName":"Chen","name":"Chen, Yonglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Cheng","name":"Cheng, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongxu","familyName":"Liu","name":"Liu, Yongxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingpeng","familyName":"Zhang","name":"Zhang, Xingpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoming","familyName":"Li","name":"Li, Xiaoming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Chen","name":"Chen, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Prompt Optimization to Multi-Dimensional Credibility Evaluation: Enhancing Trustworthiness of Chinese LLM-Generated Liver MRI Reports -- with Preliminary Extension to Lung Cancer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T04:57:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:22:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-28T02:12:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-29T00:24:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-25T08:27:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-26T01:35:00Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated promising performance in generating diagnostic conclusions from imaging findings, thereby supporting radiology reporting, trainee education, and quality control. However, systematic guidance on how to optimize prompt design across different clinical contexts remains underexplored. Moreover, a comprehensive and standardized framework for assessing the trustworthiness of LLM-generated radiology reports is yet to be established. This study aims to enhance the trustworthiness of LLM-generated liver MRI reports by introducing a Multi-Dimensional Credibility Assessment (MDCA) framework and providing guidance on institution-specific prompt optimization. The proposed framework is applied to evaluate and compare the performance of several advanced LLMs, including Kimi-K2-Instruct-0905, Qwen3-235B-A22B-Instruct-2507, DeepSeek-V3, and ByteDance-Seed-OSS-36B-Instruct, using the SiliconFlow platform."},{"descriptionType":"Other","description":"10 pages, 6 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23008","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:28:49Z","registered":"2025-10-28T03:28:49Z","published":null,"updated":"2026-05-26T04:05:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22827","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22827","identifiers":[{"identifier":"2510.22827","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zahraa Al","familyName":"Sahili","name":"Sahili, Zahraa Al","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maimuna","familyName":"Nowaz","name":"Nowaz, Maimuna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maryam","familyName":"Fetanat","name":"Fetanat, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ioannis","familyName":"Patras","name":"Patras, Ioannis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Purver","name":"Purver, Matthew","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FairJudge: Abstention-Aware Multimodal Judges for Fairness and Alignment Evaluation in Text-to-Image Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T20:43:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:10:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-18T21:19:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-20T01:07:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-25T14:31:30Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-26T01:54:04Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Evaluating text-to-image (T2I) systems requires judging not only whether an image matches a prompt, but also whether socially salient attributes are represented faithfully and without unsupported inference. Existing automated evaluators typically rely on face-centric recognizers or contrastive image--text similarity, which provide limited diagnostic feedback and often force predictions even when visual evidence is ambiguous or absent. For fairness-sensitive attributes such as religion and disability, where cues may be contextual, indirect, or intentionally unspecified, these evaluators can therefore miss failure modes that careful human reviewers would notice.\n We introduce \\textsc{FairJudge}, an abstention-aware evaluation protocol that uses instruction-following multimodal LLMs as structured judges for social-attribute prediction, profession grounding, and prompt--image alignment. The protocol constrains outputs to closed label sets, requires visible-evidence rationales, supports an explicit \\textsc{unspecified} decision when cues are insufficient, and maps rubric-based alignment judgments to $[-1,1]$. These constraints turn MLLM judging from open-ended assessment into a parseable, auditable evaluation procedure.\n Across four attribute-prediction benchmarks and three profession/alignment benchmarks, \\textsc{FairJudge} outperforms or complements CLIP, DeepFace, VIEScore, and VQAScore. Ablations show that closed labels, abstention, and evidence reporting are central to reliability. We further introduce \\textsc{DIVERSIFY} and \\textsc{DIVERSIFY-Professions}, two context-rich resources for evaluating social representation and profession grounding beyond face-visible or iconic cues. We release code, prompts, datasets, parser logs, and per-image judge outputs to support reproducible auditing."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22827","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:24:31Z","registered":"2025-10-28T03:24:32Z","published":null,"updated":"2026-05-26T04:05:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23477","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23477","identifiers":[{"identifier":"2510.23477","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tengchao","familyName":"Yang","name":"Yang, Tengchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sichen","familyName":"Guo","name":"Guo, Sichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengzhao","familyName":"Jia","name":"Jia, Mengzhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaming","familyName":"Su","name":"Su, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanyang","familyName":"Liu","name":"Liu, Yuanyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihan","familyName":"Zhang","name":"Zhang, Zhihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Jiang","name":"Jiang, Meng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MMTutorBench: The First Multimodal Benchmark for AI Math Tutoring"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T16:11:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:52:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-13T19:10:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-15T00:07:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Effective math tutoring requires not only solving problems but also diagnosing students' difficulties and guiding them step by step. While multimodal large language models (MLLMs) show promise, existing benchmarks largely overlook these tutoring skills. We introduce MMTutorBench, the first benchmark for AI math tutoring, consisting of 685 problems built around pedagogically significant key-steps. Each problem is paired with problem-specific rubrics that enable fine-grained evaluation across six dimensions, and structured into three tasks-Insight Discovery, Operation Formulation, and Operation Execution. We evaluate 12 leading MLLMs and find clear performance gaps between proprietary and open-source systems, substantial room compared to human tutors, and consistent trends across input variants: OCR pipelines degrade tutoring quality, few-shot prompting yields limited gains, and our rubric-based LLM-as-a-Judge proves highly reliable. These results highlight both the difficulty and diagnostic value of MMTutorBench for advancing AI tutoring."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23477","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:40:01Z","registered":"2025-10-28T03:40:02Z","published":null,"updated":"2026-05-15T02:36:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22944","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22944","identifiers":[{"identifier":"2510.22944","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bin","familyName":"Wang","name":"Wang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"YiLu","familyName":"Zhong","name":"Zhong, YiLu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"MiDi","familyName":"Wan","name":"Wan, MiDi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"WenJie","familyName":"Yu","name":"Yu, WenJie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"YuanBing","familyName":"Ouyang","name":"Ouyang, YuanBing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yenan","familyName":"Huang","name":"Huang, Yenan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Li","name":"Li, Hui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Is Your Prompt Poisoning Code? Defect Induction Rates and Security Mitigation Strategies"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T02:59:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:18:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-08T13:14:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-11T00:59:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have become indispensable for automated code generation, yet the quality and security of their outputs remain a critical concern. Existing studies predominantly concentrate on adversarial attacks or inherent flaws within the models. However, a more prevalent yet underexplored issue concerns how the quality of a benign but poorly formulated prompt affects the security of the generated code. To investigate this, we first propose an evaluation framework for prompt quality encompassing three key dimensions: goal clarity, information completeness, and logical consistency. Based on this framework, we construct and publicly release CWE-BENCH-PYTHON, a large-scale benchmark dataset containing tasks with prompts categorized into four distinct levels of normativity (L0-L3). Extensive experiments on multiple state-of-the-art LLMs reveal a clear correlation: as prompt normativity decreases, the likelihood of generating insecure code consistently and markedly increases. Furthermore, we demonstrate that advanced prompting techniques, such as Chain-of-Thought and Self-Correction, effectively mitigate the security risks introduced by low-quality prompts, substantially improving code safety. Our findings highlight that enhancing the quality of user prompts constitutes a critical and effective strategy for strengthening the security of AI-generated code."},{"descriptionType":"Other","description":"Accepted for publication in Empirical Software Engineering (EMSE) Journal"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22944","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:27:17Z","registered":"2025-10-28T03:27:18Z","published":null,"updated":"2026-05-11T02:43:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22609","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22609","identifiers":[{"identifier":"2510.22609","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md. Mehedi","familyName":"Hasan","name":"Hasan, Md. Mehedi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Abir","familyName":"Hossain","name":"Hossain, Md. Abir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farman Hossain","familyName":"Sayem","name":"Sayem, Farman Hossain","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bikash Kumar","familyName":"Paul","name":"Paul, Bikash Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziaur","familyName":"Rahman","name":"Rahman, Ziaur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Shorif","familyName":"Uddin","name":"Uddin, Mohammad Shorif","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafid","familyName":"Mostafiz","name":"Mostafiz, Rafid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CLIN-LLM: A Safety-Constrained Hybrid Framework for Clinical Diagnosis and Treatment Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T10:11:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:56:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-25T23:16:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-28T00:42:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate symptom-to-disease classification and clinically grounded treatment recommendations remain challenging, particularly in heterogeneous patient settings with high diagnostic risk. Existing large language model (LLM)-based systems often lack medical grounding and fail to quantify uncertainty, resulting in unsafe outputs. We propose CLIN-LLM, a safety-constrained hybrid pipeline that integrates multimodal patient encoding, uncertainty-calibrated disease classification, and retrieval-augmented treatment generation. The framework fine-tunes BioBERT on 1,200 clinical cases from the Symptom2Disease dataset and incorporates Focal Loss with Monte Carlo Dropout to enable confidence-aware predictions from free-text symptoms and structured vitals. Low-certainty cases (18%) are automatically flagged for expert review, ensuring human oversight. For treatment generation, CLIN-LLM employs Biomedical Sentence-BERT to retrieve top-k relevant dialogues from the 260,000-sample MedDialog corpus. The retrieved evidence and patient context are fed into a fine-tuned FLAN-T5 model for personalized treatment generation, followed by post-processing with RxNorm for antibiotic stewardship and drug-drug interaction (DDI) screening. CLIN-LLM achieves 98% accuracy and F1 score, outperforming ClinicalBERT by 7.1% (p \u0026lt; 0.001), with 78% top-5 retrieval precision and a clinician-rated validity of 4.2 out of 5. Unsafe antibiotic suggestions are reduced by 67% compared to GPT-5. These results demonstrate CLIN-LLM's robustness, interpretability, and clinical safety alignment. The proposed system provides a deployable, human-in-the-loop decision support framework for resource-limited healthcare environments. Future work includes integrating imaging and lab data, multilingual extensions, and clinical trial validation."},{"descriptionType":"Other","description":"13 pages, 9 figures. Preprint version under review in the area of Artificial Intelligence (cs.CR)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22609","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:19:23Z","registered":"2025-10-28T03:19:23Z","published":null,"updated":"2026-04-28T04:06:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23536","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23536","identifiers":[{"identifier":"2510.23536","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jieyong","familyName":"Kim","name":"Kim, Jieyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maryam","familyName":"Amirizaniani","name":"Amirizaniani, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soojin","familyName":"Yoon","name":"Yoon, Soojin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongha","familyName":"Lee","name":"Lee, Dongha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IPQA: A Benchmark for Core Intent Identification in Personalized Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T17:12:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:56:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-17T14:36:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-20T00:53:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Intent identification serves as the foundation for generating appropriate responses in personalized question answering (PQA). However, existing benchmarks evaluate only response quality or retrieval performance without directly measuring intent identification capabilities. This gap is critical because without understanding which intents users prioritize, systems cannot generate responses satisfying individual information needs. To address this, we introduce the concept of core intents: intents users prioritize when selecting answers to satisfy their information needs. To evaluate these core intents, we propose IPQA, a benchmark for core Intent identification in Personalized Question Answering. Since users do not explicitly state their prioritized intents, we derive core intents from observable behavior patterns in answer selection, grounded in satisficing theory where users choose answers meeting their acceptance thresholds. We construct a dataset with various domains through systematic filtering, LLM-based annotation, and rigorous quality control combining automated verification with human validation. Experimental evaluations across state-of-the-art language models reveal that current systems struggle with core intent identification in personalized contexts. Models fail to identify core intents from user histories, with performance degrading as question complexity increases. The code and dataset will be made publicly available to facilitate future research in this direction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23536","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:41:26Z","registered":"2025-10-28T03:41:27Z","published":null,"updated":"2026-04-20T02:09:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22977","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22977","identifiers":[{"identifier":"2510.22977","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenlong","familyName":"Yin","name":"Yin, Chenlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyang","familyName":"Sha","name":"Sha, Zeyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiwen","familyName":"Cui","name":"Cui, Shiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changhua","familyName":"Meng","name":"Meng, Changhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zechao","familyName":"Li","name":"Li, Zechao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Reasoning Trap: How Enhancing LLM Reasoning Amplifies Tool Hallucination"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-27T03:58:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:20:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-17T17:15:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-20T01:01:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Enhancing the reasoning capabilities of Large Language Models (LLMs) is a key strategy for building Agents that \"think then act.\" However, recent observations, like OpenAI's o3, suggest a paradox: stronger reasoning often coincides with increased hallucination, yet no prior work has systematically examined whether reasoning enhancement itself causes tool hallucination. To address this gap, we pose the central question: Does strengthening reasoning increase tool hallucination? To answer this, we introduce SimpleToolHalluBench, a diagnostic benchmark measuring tool hallucination in two failure modes: (i) no tool available, and (ii) only distractor tools available. Through controlled experiments, we establish three key findings. First, we demonstrate a causal relationship: progressively enhancing reasoning through RL increases tool hallucination proportionally with task performance gains. Second, this effect transcends overfitting - training on non-tool tasks (e.g., mathematics) still amplifies subsequent tool hallucination. Third, the effect is method-agnostic, appearing when reasoning is instilled via supervised fine-tuning and when it is merely elicited at inference by switching from direct answers to step-by-step thinking. We also evaluate mitigation strategies including Prompt Engineering and Direct Preference Optimization (DPO), revealing a fundamental reliability-capability trade-off: reducing hallucination consistently degrades utility. Mechanistically, Reasoning RL disproportionately collapses tool-reliability-related representations, and hallucinations surface as amplified divergences concentrated in late-layer residual streams. These findings reveal that current reasoning enhancement methods inherently amplify tool hallucination, highlighting the need for new training objectives that jointly optimize for capability and reliability."},{"descriptionType":"Other","description":"Accepted to ACL 2026 Main"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22977","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:28:04Z","registered":"2025-10-28T03:28:05Z","published":null,"updated":"2026-04-20T02:09:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22514","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22514","identifiers":[{"identifier":"2510.22514","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Armel","familyName":"Koulong","name":"Koulong, Armel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Pakniyat","name":"Pakniyat, Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Multi-Agent Safety via Tube-Based Tightened Exponential Barrier Functions"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T03:38:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:49:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-21T15:45:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-24T01:30:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-01T14:23:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-02T00:57:16Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents a constructive framework for synthesizing provably safe controllers for nonlinear multi-agent systems subject to bounded disturbances. The methodology applies to systems representable in Brunovsky canonical form, accommodating arbitrary-order dynamics in multi-dimensional spaces. The central contribution is a method of constraint tightening that formally couples robust error feedback with nominal trajectory planning. The key insight is that the design of an ancillary feedback law, which confines state errors to a robust positively invariant (RPI) tube, simultaneously provides the exact information needed to ensure the safety of the nominal plan. Specifically, the geometry of the resulting RPI tube is leveraged via its support function to derive state-dependent safety margins. These margins are then used to systematically tighten the high relative-degree exponential control barrier function (eCBF) constraints imposed on the nominal planner. This integrated synthesis guarantees that any nominal trajectory satisfying the tightened constraints corresponds to a provably safe trajectory for the true, disturbed system. We demonstrate the practical utility of this formal synthesis method by implementing the planner within a distributed Model Predictive Control (MPC) scheme, which optimizes performance while inheriting the robust safety guarantees."},{"descriptionType":"Other","description":"Joint submission to IFAC World Congress 2026 and NAHS journal (Reference: NAHS_101717). Accepted for NAHS journal; under review by World Congress"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22514","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:17:08Z","registered":"2025-10-28T03:17:09Z","published":null,"updated":"2026-04-02T02:28:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23324","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23324","identifiers":[{"identifier":"2510.23324","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sebastian","familyName":"Maier","name":"Maier, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manuel","familyName":"Schneider","name":"Schneider, Manuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Feuerriegel","name":"Feuerriegel, Stefan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Partnering with Generative AI: Experimental Evaluation of Human-Led and Model-Led Interaction in Human-AI Co-Creation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T13:41:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:43:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-09T15:38:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-10T03:00:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-09T09:52:10Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T01:56:44Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) show strong potential to support creative tasks, but the role of the interface design is poorly understood. In particular, the effect of different modes of collaboration between humans and LLMs on co-creation outcomes is unclear. To test this, we conducted a randomized controlled experiment ($N = 486$) comparing: (a) two variants of reflective, human-led modes in which the LLM elicits elaboration through suggestions or questions, against (b) a proactive, model-led mode in which the LLM independently rewrites ideas. By assessing the effects on idea quality, diversity, and perceived ownership, we found that the model-led mode substantially improved idea quality but reduced idea diversity and users' perceived idea ownership. The reflective, human-led mode also improved idea quality, yet while preserving diversity and ownership. We independently validated the findings in a different context ($N = 640$). Our findings highlight the importance of designing interactions with generative AI systems as reflective thought partners that complement human strengths and augment creative processes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23324","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:36:23Z","registered":"2025-10-28T03:36:24Z","published":null,"updated":"2026-03-10T04:52:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22758","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22758","identifiers":[{"identifier":"2510.22758","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Li","familyName":"Zhou","name":"Zhou, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lutong","familyName":"Yu","name":"Yu, Lutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"You","familyName":"Lyu","name":"Lyu, You","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihang","familyName":"Lin","name":"Lin, Yihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zefeng","familyName":"Zhao","name":"Zhao, Zefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyi","familyName":"Ao","name":"Ao, Junyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhao","familyName":"Zhang","name":"Zhang, Yuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benyou","familyName":"Wang","name":"Wang, Benyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haizhou","familyName":"Li","name":"Li, Haizhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EchoMind: An Interrelated Multi-level Benchmark for Evaluating Empathetic Speech Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T17:15:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:06:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-05T07:37:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-06T01:37:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Speech Language Models (SLMs) have made significant progress in spoken language understanding. Yet it remains unclear whether they can fully perceive non lexical vocal cues alongside spoken words, and respond with empathy that aligns with both emotional and contextual factors. Existing benchmarks typically evaluate linguistic, acoustic, reasoning, or dialogue abilities in isolation, overlooking the integration of these skills that is crucial for human-like, emotionally intelligent conversation. We present EchoMind, the first interrelated, multi-level benchmark that simulates the cognitive process of empathetic dialogue through sequential, context-linked tasks: spoken-content understanding, vocal-cue perception, integrated reasoning, and response generation. All tasks share identical and semantically neutral scripts that are free of explicit emotional or contextual cues, and controlled variations in vocal style are used to test the effect of delivery independent of the transcript. EchoMind is grounded in an empathy-oriented framework spanning 3 coarse and 12 fine-grained dimensions, encompassing 39 vocal attributes, and evaluated using both objective and subjective metrics. Testing 12 advanced SLMs reveals that even state-of-the-art models struggle with high-expressive vocal cues, limiting empathetic response quality. Analyses of prompt strength, speech source, and ideal vocal cue recognition reveal persistent weaknesses in instruction-following, resilience to natural speech variability, and effective use of vocal cues for empathy. These results underscore the need for SLMs that integrate linguistic content with diverse vocal cues to achieve truly empathetic conversational ability."},{"descriptionType":"Other","description":"Speech Language Models, Spoken Language Understanding, Vocal Cue Perception, Empathetic Dialogue, Benchmark Evaluation; Accepted by ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22758","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:22:54Z","registered":"2025-10-28T03:22:55Z","published":null,"updated":"2026-03-06T03:26:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.21910","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21910","identifiers":[{"identifier":"2510.21910","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mahavir","familyName":"Dabas","name":"Dabas, Mahavir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tran","familyName":"Huynh","name":"Huynh, Tran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikhil Reddy","familyName":"Billa","name":"Billa, Nikhil Reddy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiachen T.","familyName":"Wang","name":"Wang, Jiachen T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Gao","name":"Gao, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charith","familyName":"Peris","name":"Peris, Charith","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Ma","name":"Ma, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahul","familyName":"Gupta","name":"Gupta, Rahul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Jin","name":"Jin, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prateek","familyName":"Mittal","name":"Mittal, Prateek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruoxi","familyName":"Jia","name":"Jia, Ruoxi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adversarial Déjà Vu: Jailbreak Dictionary Learning for Stronger Generalization to Unseen Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-24T17:37:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:05:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-01T23:39:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-04T01:44:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-02T16:59:21Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-03T03:23:31Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models remain vulnerable to jailbreak attacks that bypass safety guardrails to elicit harmful outputs. Defending against novel jailbreaks represents a critical challenge in AI safety. Adversarial training -- designed to make models robust against worst-case perturbations -- has been the dominant paradigm for adversarial robustness. However, due to optimization challenges and difficulties in defining realistic threat models, adversarial training methods often fail on newly developed jailbreaks in practice. This paper proposes a new paradigm for improving robustness against unseen jailbreaks, centered on the Adversarial Déjà Vu hypothesis: novel jailbreaks are not fundamentally new, but largely recombinations of adversarial skills from previous attacks. We study this hypothesis through a large-scale analysis of 32 attack papers published over two years. Using an automated pipeline, we extract and compress adversarial skills into a sparse dictionary of primitives, with LLMs generating human-readable descriptions. Our analysis reveals that unseen attacks can be effectively explained as sparse compositions of earlier skills, with explanatory power increasing monotonically as skill coverage grows. Guided by this insight, we introduce Adversarial Skill Compositional Training (ASCoT), which trains on diverse compositions of skill primitives rather than isolated attack instances. ASCoT substantially improves robustness to unseen attacks, including multi-turn jailbreaks, while maintaining low over-refusal rates. We also demonstrate that expanding adversarial skill coverage, not just data scale, is key to defending against novel attacks. \\textcolor{red}{\\textbf{Warning: This paper contains content that may be harmful or offensive in nature."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.21910","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:02:49Z","registered":"2025-10-28T03:02:50Z","published":null,"updated":"2026-03-03T05:46:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22620","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22620","identifiers":[{"identifier":"2510.22620","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Julia","familyName":"Bazinska","name":"Bazinska, Julia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Mathys","name":"Mathys, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Casucci","name":"Casucci, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mateo","familyName":"Rojas-Carulla","name":"Rojas-Carulla, Mateo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xander","familyName":"Davies","name":"Davies, Xander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandra","familyName":"Souly","name":"Souly, Alexandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niklas","familyName":"Pfister","name":"Pfister, Niklas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Breaking Agent Backbones: Evaluating the Security of Backbone LLMs in AI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T10:36:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:57:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T09:00:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:34:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"AI agents powered by large language models (LLMs) are being deployed at scale, yet we lack a systematic understanding of how the choice of backbone LLM affects agent security. The non-deterministic sequential nature of AI agents complicates security modeling, while the integration of traditional software with AI components entangles novel LLM vulnerabilities with conventional security risks. Existing frameworks only partially address these challenges as they either capture specific vulnerabilities only or require modeling of complete agents. To address these limitations, we introduce threat snapshots: a framework that isolates specific states in an agent's execution flow where LLM vulnerabilities manifest, enabling the systematic identification and categorization of security risks that propagate from the LLM to the agent level. We apply this framework to construct the $b^3$ benchmark, a security benchmark based on 194,331 unique crowdsourced adversarial attacks. We then evaluate 34 popular LLMs with it, revealing, among other insights, that enhanced reasoning capabilities improve security, while model size does not correlate with security. We release our benchmark, dataset, and evaluation code to facilitate widespread adoption by LLM providers and practitioners, offering guidance for agent developers and incentivizing model developers to prioritize backbone security improvements."},{"descriptionType":"Other","description":"Julia Bazinska and Max Mathys contributed equally"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22620","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:19:38Z","registered":"2025-10-28T03:19:39Z","published":null,"updated":"2026-02-25T03:10:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.21798","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21798","identifiers":[{"identifier":"2510.21798","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Juan","familyName":"Gutiérrez","name":"Gutiérrez, Juan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor","familyName":"Gutiérrez","name":"Gutiérrez, Victor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ángel","familyName":"Mora","name":"Mora, Ángel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silvia","familyName":"Rodriguez","name":"Rodriguez, Silvia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José Luis","familyName":"Blanco","name":"Blanco, José Luis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Evaluation of Hybrid Annotation Workflows on High-Ambiguity Spatiotemporal Video Footage"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-20T16:10:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:02:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-06T16:18:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-09T01:51:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Manual annotation remains the gold standard for high-quality, dense temporal video datasets, yet it is inherently time-consuming. Vision-language models can aid human annotators and expedite this process. We report on the impact of automatic Pre-Annotations from a tuned encoder on a Human-in-the-Loop labeling workflow for video footage. Quantitative analysis in a study of a single-iteration test involving 18 volunteers demonstrates that our workflow reduced annotation time by 35% for the majority (72%) of the participants. Beyond efficiency, we provide a rigorous framework for benchmarking AI-assisted workflows that quantifies trade-offs between algorithmic speed and the integrity of human verification."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.21798","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:00:11Z","registered":"2025-10-28T03:00:12Z","published":null,"updated":"2026-02-09T03:02:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23594","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23594","identifiers":[{"identifier":"2510.23594","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yusu","familyName":"Qian","name":"Qian, Yusu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Wan","name":"Wan, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Jia","name":"Jia, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinfei","familyName":"Yang","name":"Yang, Yinfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyu","familyName":"Zhao","name":"Zhao, Qingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Gan","name":"Gan, Zhe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PRISM-Bench: A Benchmark of Puzzle-Based Visual Tasks with CoT Error Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T17:57:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:59:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-28T02:07:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-29T00:23:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-22T03:59:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-25T01:19:51Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-12-01T02:32:50Z","dateType":"Withdrawn","dateInformation":"v4; This paper's first error detection task's ground truth data contains hallucination introduced by gpt and needs to be withdrawn"},{"date":"2025-12-02T02:05:22Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal large language models (MLLMs) have achieved remarkable progress on vision-language tasks, yet their reasoning processes remain sometimes unreliable. We introduce PRISM-Bench, a benchmark of puzzle-based visual challenges designed to evaluate not only whether models can solve problems, but how their reasoning unfolds. Unlike prior evaluations that measure only final-answer accuracy, PRISM-Bench introduces a diagnostic task: given a visual puzzle and a step-by-step chain-of-thought (CoT) containing exactly one error, models must identify the first incorrect step. This setting enables fine-grained assessment of logical consistency, error detection, and visual reasoning. The puzzles in PRISM-Bench require multi-step symbolic, geometric, and analogical reasoning, resisting shortcuts based on superficial pattern matching. Evaluations across state-of-the-art MLLMs reveal a persistent gap between fluent generation and faithful reasoning: models that produce plausible CoTs often fail to locate simple logical faults. By disentangling answer generation from reasoning verification, PRISM-Bench offers a sharper lens on multimodal reasoning competence and underscores the need for diagnostic evaluation protocols in the development of trustworthy MLLMs."},{"descriptionType":"Other","description":"This paper's first error detection task's ground truth data contains hallucination introduced by gpt and needs to be withdrawn"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23594","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:42:50Z","registered":"2025-10-28T03:42:51Z","published":null,"updated":"2025-12-02T04:49:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22340","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22340","identifiers":[{"identifier":"2510.22340","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Changti","familyName":"Wu","name":"Wu, Changti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijie","familyName":"Lian","name":"Lian, Shijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihao","familyName":"Liu","name":"Liu, Zihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Zhang","name":"Zhang, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laurence Tianruo","familyName":"Yang","name":"Yang, Laurence Tianruo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Chen","name":"Chen, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DynaSolidGeo: A Dynamic Benchmark for Genuine Spatial Mathematical Reasoning of VLMs in Solid Geometry"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T15:49:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:39:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-11T15:16:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-12T01:54:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Solid geometry problem solving demands spatial mathematical reasoning that integrates spatial intelligence and symbolic reasoning. However, most existing multimodal mathematical reasoning benchmarks focus primarily on 2D plane geometry, rely on static datasets prone to data contamination and memorization, and evaluate models solely by final answers, overlooking the reasoning process. To address these limitations, we introduce DynaSolidGeo, the first dynamic benchmark for evaluating genuine spatial reasoning in Vision-Language Models (VLMs). Constructed through a semi-automatic annotation pipeline, DynaSolidGeo contains 503 expert-curated seed questions that can, in principle, dynamically generate an unbounded number of diverse multimodal text-visual instances. Beyond answer accuracy, we incorporate process evaluation based on expert-annotated reasoning chains to measure logical validity and causal coherence. Experiments across representative open-source and closed-source VLMs reveal large performance gaps, severe degradation in dynamic settings, and poor performance on tasks requiring high-level spatial intelligence, such as mental rotation and visualization. The code and dataset are available at \\href{https://zgca-ai4edu.github.io/DynaSolidGeo/}{DynaSolidGeo}."},{"descriptionType":"Other","description":"The code and dataset are available at \\href{https://zgca-ai4edu.github.io/DynaSolidGeo/}{DynaSolidGeo}"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22340","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:13:03Z","registered":"2025-10-28T03:13:04Z","published":null,"updated":"2025-11-12T03:31:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22967","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22967","identifiers":[{"identifier":"2510.22967","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yucheng","familyName":"Ning","name":"Ning, Yucheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xixun","familyName":"Lin","name":"Lin, Xixun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fang","familyName":"Fang","name":"Fang, Fang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanan","familyName":"Cao","name":"Cao, Yanan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MAD-Fact: A Multi-Agent Debate Framework for Long-Form Factuality Evaluation in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T03:41:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:19:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-29T07:50:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-30T00:34:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The widespread adoption of Large Language Models (LLMs) raises critical concerns about the factual accuracy of their outputs, especially in high-risk domains such as biomedicine, law, and education. Existing evaluation methods for short texts often fail on long-form content due to complex reasoning chains, intertwined perspectives, and cumulative information. To address this, we propose a systematic approach integrating large-scale long-form datasets, multi-agent verification mechanisms, and weighted evaluation metrics. We construct LongHalluQA, a Chinese long-form factuality dataset; and develop MAD-Fact, a debate-based multi-agent verification system. We introduce a fact importance hierarchy to capture the varying significance of claims in long-form texts. Experiments on two benchmarks show that larger LLMs generally maintain higher factual consistency, while domestic models excel on Chinese content. Our work provides a structured framework for evaluating and enhancing factual reliability in long-form LLM outputs, guiding their safe deployment in sensitive domains."},{"descriptionType":"Other","description":"The article has been accepted by Frontiers of Computer Science (FCS), with the DOI: {10.1007/s11704-025-51369-x}"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22967","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:27:50Z","registered":"2025-10-28T03:27:50Z","published":null,"updated":"2025-10-30T02:19:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22581","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22581","identifiers":[{"identifier":"2510.22581","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kaushal Kumar","familyName":"Maurya","name":"Maurya, Kaushal Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ekaterina","familyName":"Kochmar","name":"Kochmar, Ekaterina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pedagogy-driven Evaluation of Generative AI-powered Intelligent Tutoring Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T08:44:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T16:00:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The interdisciplinary research domain of Artificial Intelligence in Education (AIED) has a long history of developing Intelligent Tutoring Systems (ITSs) by integrating insights from technological advancements, educational theories, and cognitive psychology. The remarkable success of generative AI (GenAI) models has accelerated the development of large language model (LLM)-powered ITSs, which have potential to imitate human-like, pedagogically rich, and cognitively demanding tutoring. However, the progress and impact of these systems remain largely untraceable due to the absence of reliable, universally accepted, and pedagogy-driven evaluation frameworks and benchmarks. Most existing educational dialogue-based ITS evaluations rely on subjective protocols and non-standardized benchmarks, leading to inconsistencies and limited generalizability. In this work, we take a step back from mainstream ITS development and provide comprehensive state-of-the-art evaluation practices, highlighting associated challenges through real-world case studies from careful and caring AIED research. Finally, building on insights from previous interdisciplinary AIED research, we propose three practical, feasible, and theoretically grounded research directions, rooted in learning science principles and aimed at establishing fair, unified, and scalable evaluation methodologies for ITSs."},{"descriptionType":"Other","description":"AIED 2025 (BlueSky). International Conference on Artificial Intelligence in Education. Cham: Springer Nature Switzerland, 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22581","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:18:43Z","registered":"2025-10-28T03:18:44Z","published":null,"updated":"2025-10-29T02:25:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23482","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23482","identifiers":[{"identifier":"2510.23482","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zujing","familyName":"Liu","name":"Liu, Zujing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junwen","familyName":"Pan","name":"Pan, Junwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"She","name":"She, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Gao","name":"Gao, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guisong","familyName":"Xia","name":"Xia, Guisong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Faithfulness of Visual Thinking: Measurement and Enhancement"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T16:15:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:52:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent large vision-language models (LVLMs) can generate vision-text multimodal chain-of-thought (MCoT) traces after reinforcement fine-tuning (RFT). However, we observe that the visual information incorporated in MCoT is often inaccurate, though still yield correct answers, indicating a lack of faithfulness in the MCoT reasoning process. We attribute this unfaithfulness to the RL reward in RFT, which solely incentivizes the format of interleaved vision-text cues, ie, it encourages the model to incorporate visual information into its text reasoning steps without considering the correctness of the visual information. In this paper, we first probe the faithfulness of MCoT by measuring how much the prediction changes when its visual and textual thoughts are intervened. Surprisingly, the model's predictions remain nearly unchanged under visual intervention but change significantly under textual intervention, indicating that the visual evidence is largely ignored. To further analyze visual information, we introduce an automated LVLM-based evaluation metric that quantifies the faithfulness of visual cues from two perspectives: reliability and sufficiency. Our evaluation reveals that the visual information in current MCoT traces is simultaneously unreliable and insufficient. To address this issue, we propose a novel MCoT learning strategy termed Sufficient-Component Cause Model (SCCM) learning. This approach encourages the MCoT to generate sufficient yet minimal visual components that are independently capable of leading to correct answers. We note that the proposed SCCM is annotation-free and compatible with various RFT for MCoT in a plug-and-play manner. Empirical results demonstrate that SCCM consistently improves the visual faithfulness across a suite of fine-grained perception and reasoning benchmarks. Code is available at https://github.com/EugeneLiu01/Faithful_Thinking_with_Image."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23482","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:40:08Z","registered":"2025-10-28T03:40:09Z","published":null,"updated":"2025-10-28T03:40:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23337","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23337","identifiers":[{"identifier":"2510.23337","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyuan","familyName":"Zheng","name":"Zheng, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pai","familyName":"Liu","name":"Liu, Pai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Chen","name":"Chen, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jizheng","familyName":"Dong","name":"Dong, Jizheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sihan","familyName":"Jia","name":"Jia, Sihan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BaZi-Based Character Simulation Benchmark: Evaluating AI on Temporal and Persona Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T13:51:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:44:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Human-like virtual characters are crucial for games, storytelling, and virtual reality, yet current methods rely heavily on annotated data or handcrafted persona prompts, making it difficult to scale up and generate realistic, contextually coherent personas. We create the first QA dataset for BaZi-based persona reasoning, where real human experiences categorized into wealth, health, kinship, career, and relationships are represented as life-event questions and answers. Furthermore, we propose the first BaZi-LLM system that integrates symbolic reasoning with large language models to generate temporally dynamic and fine-grained virtual personas. Compared with mainstream LLMs such as DeepSeek-v3 and GPT-5-mini, our method achieves a 30.3%-62.6% accuracy improvement. In addition, when incorrect BaZi information is used, our model's accuracy drops by 20%-45%, showing the potential of culturally grounded symbolic-LLM integration for realistic character simulation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23337","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:36:41Z","registered":"2025-10-28T03:36:42Z","published":null,"updated":"2025-10-28T03:36:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.23190","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.23190","identifiers":[{"identifier":"2510.23190","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pascal","familyName":"Benschop","name":"Benschop, Pascal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristian","familyName":"Meo","name":"Meo, Cristian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Justin","familyName":"Dauwels","name":"Dauwels, Justin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jelte P.","familyName":"Mense","name":"Mense, Jelte P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluation of Vision-LLMs in Surveillance Video"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-27T10:27:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T01:34:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The widespread use of cameras in our society has created an overwhelming amount of video data, far exceeding the capacity for human monitoring. This presents a critical challenge for public safety and security, as the timely detection of anomalous or criminal events is crucial for effective response and prevention. The ability for an embodied agent to recognize unexpected events is fundamentally tied to its capacity for spatial reasoning. This paper investigates the spatial reasoning of vision-language models (VLMs) by framing anomalous action recognition as a zero-shot, language-grounded task, addressing the embodied perception challenge of interpreting dynamic 3D scenes from sparse 2D video. Specifically, we investigate whether small, pre-trained vision--LLMs can act as spatially-grounded, zero-shot anomaly detectors by converting video into text descriptions and scoring labels via textual entailment. We evaluate four open models on UCF-Crime and RWF-2000 under prompting and privacy-preserving conditions. Few-shot exemplars can improve accuracy for some models, but may increase false positives, and privacy filters -- especially full-body GAN transforms -- introduce inconsistencies that degrade accuracy. These results chart where current vision--LLMs succeed (simple, spatially salient events) and where they falter (noisy spatial cues, identity obfuscation). Looking forward, we outline concrete paths to strengthen spatial grounding without task-specific training: structure-aware prompts, lightweight spatial memory across clips, scene-graph or 3D-pose priors during description, and privacy methods that preserve action-relevant geometry. This positions zero-shot, language-grounded pipelines as adaptable building blocks for embodied, real-world video understanding. Our implementation for evaluating VLMs is publicly available at: https://github.com/pascalbenschopTU/VLLM_AnomalyRecognition"},{"descriptionType":"Other","description":"Accepted as poster in the NeurIPS 2025 Workshop on Space in Vision, Language, and Embodied AI"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.23190","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:33:11Z","registered":"2025-10-28T03:33:12Z","published":null,"updated":"2025-10-28T03:33:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22593","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22593","identifiers":[{"identifier":"2510.22593","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dario","familyName":"Loi","name":"Loi, Dario","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elena Maria","familyName":"Muià","name":"Muià, Elena Maria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federico","familyName":"Siciliano","name":"Siciliano, Federico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giovanni","familyName":"Trappolini","name":"Trappolini, Giovanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vincenzo","familyName":"Crisà","name":"Crisà, Vincenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Kruger","name":"Kruger, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabrizio","familyName":"Silvestri","name":"Silvestri, Fabrizio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AutoBench: Automating LLM Evaluation through Reciprocal Peer Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.11; H.3.4; D.2.8","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-26T09:20:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:56:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present AutoBench, a fully automated and self-sustaining framework for evaluating Large Language Models (LLMs) through reciprocal peer assessment. This paper provides a rigorous scientific validation of the AutoBench methodology, originally developed as an open-source project by eZecute S.R.L.. Unlike static benchmarks that suffer from test-set contamination and limited adaptability, AutoBench dynamically generates novel evaluation tasks while models alternately serve as question generators, contestants, and judges across diverse domains. An iterative weighting mechanism amplifies the influence of consistently reliable evaluators, aggregating peer judgments into consensus-based rankings that reflect collective model agreement. Our experiments demonstrate strong correlations with established benchmarks including MMLU-Pro and GPQA (respectively 78\\% and 63\\%), validating this peer-driven evaluation paradigm. The multi-judge design significantly outperforms single-judge baselines, confirming that distributed evaluation produces more robust and human-consistent assessments. AutoBench offers a scalable, contamination-resistant alternative to static benchmarks for the continuous evaluation of evolving language models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22593","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:19:00Z","registered":"2025-10-28T03:19:01Z","published":null,"updated":"2025-10-28T03:19:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22571","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22571","identifiers":[{"identifier":"2510.22571","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mahiro","familyName":"Ukai","name":"Ukai, Mahiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhei","familyName":"Kurita","name":"Kurita, Shuhei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nakamasa","familyName":"Inoue","name":"Inoue, Nakamasa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"STATUS Bench: A Rigorous Benchmark for Evaluating Object State Understanding in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-26T08:04:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:54:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Object state recognition aims to identify the specific condition of objects, such as their positional states (e.g., open or closed) and functional states (e.g., on or off). While recent Vision-Language Models (VLMs) are capable of performing a variety of multimodal tasks, it remains unclear how precisely they can identify object states. To alleviate this issue, we introduce the STAte and Transition UnderStanding Benchmark (STATUS Bench), the first benchmark for rigorously evaluating the ability of VLMs to understand subtle variations in object states in diverse situations. Specifically, STATUS Bench introduces a novel evaluation scheme that requires VLMs to perform three tasks simultaneously: object state identification (OSI), image retrieval (IR), and state change identification (SCI). These tasks are defined over our fully hand-crafted dataset involving image pairs, their corresponding object state descriptions and state change descriptions. Furthermore, we introduce a large-scale training dataset, namely STATUS Train, which consists of 13 million semi-automatically created descriptions. This dataset serves as the largest resource to facilitate further research in this area. In our experiments, we demonstrate that STATUS Bench enables rigorous consistency evaluation and reveal that current state-of-the-art VLMs still significantly struggle to capture subtle object state distinctions. Surprisingly, under the proposed rigorous evaluation scheme, most open-weight VLMs exhibited chance-level zero-shot performance. After fine-tuning on STATUS Train, Qwen2.5-VL achieved performance comparable to Gemini 2.0 Flash. These findings underscore the necessity of STATUS Bench and Train for advancing object state recognition in VLM research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22571","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:18:29Z","registered":"2025-10-28T03:18:30Z","published":null,"updated":"2025-10-28T03:18:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22395","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22395","identifiers":[{"identifier":"2510.22395","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Federica","familyName":"Gamba","name":"Gamba, Federica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aman","familyName":"Sinha","name":"Sinha, Aman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timothee","familyName":"Mickus","name":"Mickus, Timothee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raul","familyName":"Vazquez","name":"Vazquez, Raul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patanjali","familyName":"Bhamidipati","name":"Bhamidipati, Patanjali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudio","familyName":"Savelli","name":"Savelli, Claudio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahana","familyName":"Chattopadhyay","name":"Chattopadhyay, Ahana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laura A.","familyName":"Zanella","name":"Zanella, Laura A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yash","familyName":"Kankanampati","name":"Kankanampati, Yash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binesh Arakkal","familyName":"Remesh","name":"Remesh, Binesh Arakkal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aryan Ashok","familyName":"Chandramania","name":"Chandramania, Aryan Ashok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rohit","familyName":"Agarwal","name":"Agarwal, Rohit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuyuan","familyName":"Li","name":"Li, Chuyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ioana","familyName":"Buhnila","name":"Buhnila, Ioana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Radhika","familyName":"Mamidi","name":"Mamidi, Radhika","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Confabulations from ACL Publications (CAP): A Dataset for Scientific Hallucination Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T18:42:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:42:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce the CAP (Confabulations from ACL Publications) dataset, a multilingual resource for studying hallucinations in large language models (LLMs) within scientific text generation. CAP focuses on the scientific domain, where hallucinations can distort factual knowledge, as they frequently do. In this domain, however, the presence of specialized terminology, statistical reasoning, and context-dependent interpretations further exacerbates these distortions, particularly given LLMs' lack of true comprehension, limited contextual understanding, and bias toward surface-level generalization. CAP operates in a cross-lingual setting covering five high-resource languages (English, French, Hindi, Italian, and Spanish) and four low-resource languages (Bengali, Gujarati, Malayalam, and Telugu). The dataset comprises 900 curated scientific questions and over 7000 LLM-generated answers from 16 publicly available models, provided as question-answer pairs along with token sequences and corresponding logits. Each instance is annotated with a binary label indicating the presence of a scientific hallucination, denoted as a factuality error, and a fluency label, capturing issues in the linguistic quality or naturalness of the text. CAP is publicly released to facilitate advanced research on hallucination detection, multilingual evaluation of LLMs, and the development of more reliable scientific NLP systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22395","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:14:22Z","registered":"2025-10-28T03:14:23Z","published":null,"updated":"2025-10-28T03:14:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22242","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22242","identifiers":[{"identifier":"2510.22242","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yutao","familyName":"Wu","name":"Wu, Yutao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Liu","name":"Liu, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunhao","familyName":"Feng","name":"Feng, Yunhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiale","familyName":"Ding","name":"Ding, Jiale","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingjun","familyName":"Ma","name":"Ma, Xingjun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PaperAsk: A Benchmark for Reliability Evaluation of LLMs in Paper Search and Reading"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T10:11:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:33:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) increasingly serve as research assistants, yet their reliability in scholarly tasks remains under-evaluated. In this work, we introduce PaperAsk, a benchmark that systematically evaluates LLMs across four key research tasks: citation retrieval, content extraction, paper discovery, and claim verification. We evaluate GPT-4o, GPT-5, and Gemini-2.5-Flash under realistic usage conditions-via web interfaces where search operations are opaque to the user. Through controlled experiments, we find consistent reliability failures: citation retrieval fails in 48-98% of multi-reference queries, section-specific content extraction fails in 72-91% of cases, and topical paper discovery yields F1 scores below 0.32, missing over 60% of relevant literature. Further human analysis attributes these failures to the uncontrolled expansion of retrieved context and the tendency of LLMs to prioritize semantically relevant text over task instructions. Across basic tasks, the LLMs display distinct failure behaviors: ChatGPT often withholds responses rather than risk errors, whereas Gemini produces fluent but fabricated answers. To address these issues, we develop lightweight reliability classifiers trained on PaperAsk data to identify unreliable outputs. PaperAsk provides a reproducible and diagnostic framework for advancing the reliability evaluation of LLM-based scholarly assistance systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22242","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:10:42Z","registered":"2025-10-28T03:10:43Z","published":null,"updated":"2025-10-28T03:10:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.22085","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22085","identifiers":[{"identifier":"2510.22085","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pavlos","familyName":"Ntais","name":"Ntais, Pavlos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Jailbreak Mimicry: Automated Discovery of Narrative-Based Jailbreaks for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.0; K.6.5","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-24T23:53:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:18:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) remain vulnerable to sophisticated prompt engineering attacks that exploit contextual framing to bypass safety mechanisms, posing significant risks in cybersecurity applications. We introduce Jailbreak Mimicry, a systematic methodology for training compact attacker models to automatically generate narrative-based jailbreak prompts in a one-shot manner. Our approach transforms adversarial prompt discovery from manual craftsmanship into a reproducible scientific process, enabling proactive vulnerability assessment in AI-driven security systems. Developed for the OpenAI GPT-OSS-20B Red-Teaming Challenge, we use parameter-efficient fine-tuning (LoRA) on Mistral-7B with a curated dataset derived from AdvBench, achieving an 81.0% Attack Success Rate (ASR) against GPT-OSS-20B on a held-out test set of 200 items. Cross-model evaluation reveals significant variation in vulnerability patterns: our attacks achieve 66.5% ASR against GPT-4, 79.5% on Llama-3 and 33.0% against Gemini 2.5 Flash, demonstrating both broad applicability and model-specific defensive strengths in cybersecurity contexts. This represents a 54x improvement over direct prompting (1.5% ASR) and demonstrates systematic vulnerabilities in current safety alignment approaches. Our analysis reveals that technical domains (Cybersecurity: 93% ASR) and deception-based attacks (Fraud: 87.8% ASR) are particularly vulnerable, highlighting threats to AI-integrated threat detection, malware analysis, and secure systems, while physical harm categories show greater resistance (55.6% ASR). We employ automated harmfulness evaluation using Claude Sonnet 4, cross-validated with human expert assessment, ensuring reliable and scalable evaluation for cybersecurity red-teaming. Finally, we analyze failure mechanisms and discuss defensive strategies to mitigate these vulnerabilities in AI for cybersecurity."},{"descriptionType":"Other","description":"18 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.22085","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:06:55Z","registered":"2025-10-28T03:06:56Z","published":null,"updated":"2025-10-28T03:06:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":28,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=registered%3A%5B2025-10-27T16%3A00%3A00Z+TO+2025-10-28T15%3A59%3A59Z%5D+AND+%28titles.title%3A%28evaluation+OR+benchmark+OR+hallucination+OR+faithfulness+OR+safety+OR+security+OR+jailbreak+OR+%22prompt+injection%22%29+AND+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+agent%29%29\u0026client-id=arxiv.content\u0026page%5Bsize%5D=100\u0026page%5Bnumber%5D=1"}}