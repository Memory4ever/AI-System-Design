<span id="S4.T6.6.1.1.1.1.4.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Qwen3-8B</span></span>
</span></span><span id="S4.T6.6.1.1.1.1.4.2.2" class="ltx_text"></span></span></span>
<span id="S4.T6.6.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T6.6.1.1.1.1.5.1" class="ltx_text"></span><span id="S4.T6.6.1.1.1.1.5.2" class="ltx_text ltx_font_bold"> <span id="S4.T6.6.1.1.1.1.5.2.1" class="ltx_text">
<span id="S4.T6.6.1.1.1.1.5.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T6.6.1.1.1.1.5.2.1.1.1" class="ltx_tr">
<span id="S4.T6.6.1.1.1.1.5.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Ernie-4.5-21B</span></span>
</span></span><span id="S4.T6.6.1.1.1.1.5.2.2" class="ltx_text"></span></span></span>
<span id="S4.T6.6.1.1.1.1.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T6.6.1.1.1.1.6.1" class="ltx_text"></span><span id="S4.T6.6.1.1.1.1.6.2" class="ltx_text ltx_font_bold"> <span id="S4.T6.6.1.1.1.1.6.2.1" class="ltx_text">
<span id="S4.T6.6.1.1.1.1.6.2.1.1" class="ltx_tabular ltx_align_middle">
