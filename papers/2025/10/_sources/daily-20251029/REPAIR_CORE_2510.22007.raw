_font_mathcaligraphic">ℐ</mi><mrow><mn>2</mn><mo>,</mo><mn>2</mn></mrow><mi>Y</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{2,2}^{Y}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 318.9 -19.69 M 318.9 -19.69 C 319.94 -21.76 322.36 -23.14 325.82 -23.14 L 327.73 -23.14 C 331.19 -23.14 333.61 -24.53 334.65 -26.6 C 335.68 -24.53 338.1 -23.14 341.56 -23.14 L 343.47 -23.14 C 346.93 -23.14 349.36 -21.76 350.39 -19.69"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 324.72 -41.75)"><foreignObject style="--ltx-fo-width:1.43em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="19.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m36" class="ltx_Math" alttext="{\mathcal{I}}_{3,1}^{Y}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mn>3</mn><mo>,</mo><mn>1</mn></mrow><mi>Y</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{3,1}^{Y}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 358.27 -19.69 M 358.27 -19.69 C 359.31 -21.76 361.73 -23.14 365.19 -23.14 L 367.1 -23.14 C 370.56 -23.14 372.98 -24.53 374.02 -26.6 C 375.05 -24.53 377.48 -23.14 380.93 -23.14 L 382.85 -23.14 C 386.3 -23.14 388.73 -21.76 389.76 -19.69"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 364.09 -41.75)"><foreignObject style="--ltx-fo-width:1.43em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="19.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m37" class="ltx_Math" alttext="{\mathcal{I}}_{4,1}^{Y}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mn>4</mn><mo>,</mo><mn>1</mn></mrow><mi>Y</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{4,1}^{Y}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 398.59 75.28)"><foreignObject style="--ltx-fo-width:10.68em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="147.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">blocks in <math id="S3.F2.pic1.m38" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math>-level partition</span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 398.59 14.88)"><foreignObject style="--ltx-fo-width:4.7em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="65.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">the full set</span></span></foreignObject></g><path style="fill:none" d="M 98.43 -51.18 M 98.43 -51.18 C 99.46 -53.26 101.88 -54.64 105.34 -54.64 L 229.3 -54.64 C 232.76 -54.64 235.18 -56.02 236.22 -58.1 C 237.26 -56.02 239.68 -54.64 243.14 -54.64 L 367.1 -54.64 C 370.56 -54.64 372.98 -53.26 374.02 -51.18"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 226.24 -71.06)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="19.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m39" class="ltx_Math" alttext="\Pi_{Y}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><annotation encoding="application/x-tex">\Pi_{Y}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 398.59 -42.83)"><foreignObject style="--ltx-fo-width:12.51em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="173.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">sub-blocks in <math id="S3.F2.pic1.m40" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>-level partition</span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>Illustration of the two-level partition structure in a <math id="S3.F2.m6" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math>-length sequence: the <math id="S3.F2.m7" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math>-level partition <math id="S3.F2.m8" class="ltx_Math" alttext="\Pi_{\zeta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><annotation encoding="application/x-tex">\Pi_{\zeta}</annotation></semantics></math> groups indices with the same pseudorandom variable, while the <math id="S3.F2.m9" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>-level partition <math id="S3.F2.m10" class="ltx_Math" alttext="\Pi_{Y}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><annotation encoding="application/x-tex">\Pi_{Y}</annotation></semantics></math> further groups them by shared pivotal statistic.</figcaption>
</figure>
<div id="S3.SS1.SSS0.Px1.p3" class="ltx_para">
<p id="S3.SS1.SSS0.Px1.p3.1" class="ltx_p">An example of the two-layer partition is shown in Figure <a href="#S3.F2" title="Figure 2 ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. While this structure captures the dependencies caused by repeated context windows, it also implies where conditional independence can still hold. In particular, pseudorandom variables associated with different blocks can be safely treated as independent (see Assumption <a href="#S3.Thmasmp1" title="Assumption 3.1 (Independence across blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> for the formal statement). This independence follows from the input sensitivity of cryptographic hash functions: when the input contexts differ, the resulting pseudorandom outputs—<math id="S3.SS1.SSS0.Px1.p3.m1" class="ltx_math_unparsed" alttext="{\mathcal{A}}({w}_{(t-m):(t-1)},{\mathtt{Key}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>m</mi></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝙺𝚎𝚢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}({w}_{(t-m):(t-1)},{\mathtt{Key}})</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px1.p3.m2" class="ltx_math_unparsed" alttext="{\mathcal{A}}({w}_{(t^{\prime}-m):(t^{\prime}-1)},{\mathtt{Key}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>t</mi><mo>′</mo></msup><mo>−</mo><mi>m</mi></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>t</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝙺𝚎𝚢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}({w}_{(t^{\prime}-m):(t^{\prime}-1)},{\mathtt{Key}})</annotation></semantics></math>—are statistically independent <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib50" title="" class="ltx_ref">50</a>]</cite>.</p>
</div>
<div id="S3.Thmasmp1" class="ltx_theorem ltx_theorem_asmp">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmasmp1.2" class="ltx_text ltx_font_bold">Assumption 3.1</span></span><span id="S3.Thmasmp1.3" class="ltx_text ltx_font_bold"> </span>(Independence across blocks)<span id="S3.Thmasmp1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmasmp1.p1" class="ltx_para">
<p id="S3.Thmasmp1.p1.1" class="ltx_p"><span id="S3.Thmasmp1.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S3.Thmasmp1.p1.m1" class="ltx_Math" alttext="k\neq k^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">k\neq k^{\prime}</annotation></semantics></math> and any <math id="S3.Thmasmp1.p1.m2" class="ltx_Math" alttext="i\in{\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup></mrow><annotation encoding="application/x-tex">i\in{\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math> and <math id="S3.Thmasmp1.p1.m3" class="ltx_Math" alttext="j\in{\mathcal{I}}_{k^{\prime}}^{\zeta}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><msup><mi>k</mi><mo>′</mo></msup><mi>ζ</mi></msubsup></mrow><annotation encoding="application/x-tex">j\in{\mathcal{I}}_{k^{\prime}}^{\zeta}</annotation></semantics></math>, <math id="S3.Thmasmp1.p1.m4" class="ltx_Math" alttext="\zeta_{i}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\zeta_{i}</annotation></semantics></math> is statistically independent of <math id="S3.Thmasmp1.p1.m5" class="ltx_Math" alttext="\zeta_{j}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\zeta_{j}</annotation></semantics></math>, denoted as <math id="S3.Thmasmp1.p1.m6" class="ltx_Math" alttext="\zeta_{i}\perp\zeta_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>i</mi></msub><mo>⟂</mo><msub><mi>ζ</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\zeta_{i}\perp\zeta_{j}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.Thmcor1" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmcor1.2" class="ltx_text ltx_font_bold">Corollary 3.1</span></span><span id="S3.Thmcor1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmcor1.p1" class="ltx_para">
<p id="S3.Thmcor1.p1.1" class="ltx_p"><span id="S3.Thmcor1.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#S3.Thmasmp1" title="Assumption 3.1 (Independence across blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, for <math id="S3.Thmcor1.p1.m1" class="ltx_Math" alttext="k\neq k^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">k\neq k^{\prime}</annotation></semantics></math> and any indices <math id="S3.Thmcor1.p1.m2" class="ltx_Math" alttext="i\in{\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup></mrow><annotation encoding="application/x-tex">i\in{\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math> and <math id="S3.Thmcor1.p1.m3" class="ltx_Math" alttext="j\in{\mathcal{I}}_{k^{\prime}}^{\zeta}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><msup><mi>k</mi><mo>′</mo></msup><mi>ζ</mi></msubsup></mrow><annotation encoding="application/x-tex">j\in{\mathcal{I}}_{k^{\prime}}^{\zeta}</annotation></semantics></math>, <math id="S3.Thmcor1.p1.m4" class="ltx_Math" alttext="Y_{i}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>i</mi></msub><annotation encoding="application/x-tex">Y_{i}</annotation></semantics></math> is statistically independent of <math id="S3.Thmcor1.p1.m5" class="ltx_Math" alttext="Y_{j}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>j</mi></msub><annotation encoding="application/x-tex">Y_{j}</annotation></semantics></math>, denoted as <math id="S3.Thmcor1.p1.m6" class="ltx_Math" alttext="Y_{i}\perp Y_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>i</mi></msub><mo>⟂</mo><msub><mi>Y</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">Y_{i}\perp Y_{j}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS1.SSS0.Px1.p4" class="ltx_para">
<p id="S3.SS1.SSS0.Px1.p4.1" class="ltx_p">In some cases, a finer level of independence holds between sub-blocks (see Assumption <a href="#S3.Thmasmp2" title="Assumption 3.2 (Independence across sub-blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>). Recall that each <math id="S3.SS1.SSS0.Px1.p4.m1" class="ltx_Math" alttext="Y_{t}=Y(\zeta_{t},w_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>Y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo>,</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y_{t}=Y(\zeta_{t},w_{t})</annotation></semantics></math> is a deterministic function of both <math id="S3.SS1.SSS0.Px1.p4.m2" class="ltx_Math" alttext="\zeta_{t}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\zeta_{t}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px1.p4.m3" class="ltx_Math" alttext="w_{t}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>t</mi></msub><annotation encoding="application/x-tex">w_{t}</annotation></semantics></math>. Since <math id="S3.SS1.SSS0.Px1.p4.m4" class="ltx_Math" alttext="\zeta_{t}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\zeta_{t}</annotation></semantics></math> is constant within each sub-block, this finer independence requires that the function <math id="S3.SS1.SSS0.Px1.p4.m5" class="ltx_Math" alttext="w\mapsto Y(\zeta_{t},w)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo stretchy="false">↦</mo><mrow><mi>Y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w\mapsto Y(\zeta_{t},w)</annotation></semantics></math> induces variability across tokens. Whether this holds depends on the specific structure of the decoder <math id="S3.SS1.SSS0.Px1.p4.m6" class="ltx_Math" alttext="{\mathcal{S}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">{\mathcal{S}}</annotation></semantics></math> and the statistic <math id="S3.SS1.SSS0.Px1.p4.m7" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>, and does not hold universally. A notable case where it does is the Gumbel-max watermark, where <math id="S3.SS1.SSS0.Px1.p4.m8" class="ltx_Math" alttext="\zeta_{t}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\zeta_{t}</annotation></semantics></math> is a random vector with i.i.d. <math id="S3.SS1.SSS0.Px1.p4.m9" class="ltx_Math" alttext="{U}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{U}(0,1)</annotation></semantics></math> entries and <math id="S3.SS1.SSS0.Px1.p4.m10" class="ltx_Math" alttext="Y_{t}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">Y_{t}</annotation></semantics></math> selects the entry indexed by <math id="S3.SS1.SSS0.Px1.p4.m11" class="ltx_Math" alttext="w_{t}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>t</mi></msub><annotation encoding="application/x-tex">w_{t}</annotation></semantics></math>, preserving independence across tokens even when <math id="S3.SS1.SSS0.Px1.p4.m12" class="ltx_Math" alttext="\zeta_{t}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\zeta_{t}</annotation></semantics></math> is shared.</p>
</div>
<div id="S3.Thmasmp2" class="ltx_theorem ltx_theorem_asmp">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmasmp2.2" class="ltx_text ltx_font_bold">Assumption 3.2</span></span><span id="S3.Thmasmp2.3" class="ltx_text ltx_font_bold"> </span>(Independence across sub-blocks)<span id="S3.Thmasmp2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmasmp2.p1" class="ltx_para">
<p id="S3.Thmasmp2.p1.1" class="ltx_p"><span id="S3.Thmasmp2.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="S3.Thmasmp2.p1.m1" class="ltx_Math" alttext="i\in{\mathcal{I}}_{k,l}^{Y}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mi>Y</mi></msubsup></mrow><annotation encoding="application/x-tex">i\in{\mathcal{I}}_{k,l}^{Y}</annotation></semantics></math> and <math id="S3.Thmasmp2.p1.m2" class="ltx_Math" alttext="j\in{\mathcal{I}}_{k^{\prime},l^{\prime}}^{Y}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>,</mo><msup><mi>l</mi><mo>′</mo></msup></mrow><mi>Y</mi></msubsup></mrow><annotation encoding="application/x-tex">j\in{\mathcal{I}}_{k^{\prime},l^{\prime}}^{Y}</annotation></semantics></math>, <math id="S3.Thmasmp2.p1.m3" class="ltx_Math" alttext="Y_{i}\perp Y_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>i</mi></msub><mo>⟂</mo><msub><mi>Y</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">Y_{i}\perp Y_{j}</annotation></semantics></math>, whenever either <math id="S3.Thmasmp2.p1.m4" class="ltx_Math" alttext="k\neq k^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">k\neq k^{\prime}</annotation></semantics></math> or <math id="S3.Thmasmp2.p1.m5" class="ltx_Math" alttext="k=k^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">k=k^{\prime}</annotation></semantics></math> but <math id="S3.Thmasmp2.p1.m6" class="ltx_Math" alttext="l\neq l^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≠</mo><msup><mi>l</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">l\neq l^{\prime}</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
<section id="S3.SS1.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Factorization from structural independence.</h5>

<div id="S3.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="S3.SS1.SSS0.Px2.p1.1" class="ltx_p">The pivotal statistics <math id="S3.SS1.SSS0.Px2.p1.m1" class="ltx_math_unparsed" alttext="Y_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Y_{1:n}</annotation></semantics></math> are the basis for detection. A direct consequence of the above independence conditions is that the joint distribution of <math id="S3.SS1.SSS0.Px2.p1.m2" class="ltx_math_unparsed" alttext="Y_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Y_{1:n}</annotation></semantics></math> factorizes across blocks—and in some cases, across sub-blocks—which simplifies both analysis and inference.</p>
</div>
<div id="S3.Thmprop1" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmprop1.2" class="ltx_text ltx_font_bold">Proposition 3.1</span></span><span id="S3.Thmprop1.3" class="ltx_text ltx_font_bold"> </span>(Distribution factorization)<span id="S3.Thmprop1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmprop1.p1" class="ltx_para">
<p id="S3.Thmprop1.p1.1" class="ltx_p"><span id="S3.Thmprop1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmprop1.p1.m1" class="ltx_Math" alttext="\Pi_{\zeta}=\{{\mathcal{I}}_{k}^{\zeta}\}_{k=1}^{K}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup></mrow><annotation encoding="application/x-tex">\Pi_{\zeta}=\{{\mathcal{I}}_{k}^{\zeta}\}_{k=1}^{K}</annotation></semantics></math> denote a <math id="S3.Thmprop1.p1.m2" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math>-level partition.
Under Assumption <a href="#S3.Thmasmp1" title="Assumption 3.1 (Independence across blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, the joint distribution of <math id="S3.Thmprop1.p1.m3" class="ltx_Math" alttext="(Y_{t})_{t=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">(Y_{t})_{t=1}^{n}</annotation></semantics></math> factorizes as</span></p>
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E2.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}((Y_{t})_{t=1}^{n}\mid\Pi_{\zeta})=\prod_{{\mathcal{V}}\in\Pi_{\zeta}}{\mathbb{P}}((Y_{t})_{t\in{\mathcal{V}}}|\Pi_{\zeta})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub></mrow></munder></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}((Y_{t})_{t=1}^{n}\mid\Pi_{\zeta})=\prod_{{\mathcal{V}}\in\Pi_{\zeta}}{\mathbb{P}}((Y_{t})_{t\in{\mathcal{V}}}|\Pi_{\zeta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
<p id="S3.Thmprop1.p1.2" class="ltx_p"><span id="S3.Thmprop1.p1.2.1" class="ltx_text ltx_font_italic">If Assumption <a href="#S3.Thmasmp2" title="Assumption 3.2 (Independence across sub-blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> holds, let <math id="S3.Thmprop1.p1.m4" class="ltx_Math" alttext="\Pi_{Y}^{(k)}=\{{\mathcal{I}}_{k,l}^{Y}\}_{l=1}^{m_{k}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Π</mi><mi>Y</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mi>Y</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>m</mi><mi>k</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\Pi_{Y}^{(k)}=\{{\mathcal{I}}_{k,l}^{Y}\}_{l=1}^{m_{k}}</annotation></semantics></math> be the <math id="S3.Thmprop1.p1.m5" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>-level refinement of <math id="S3.Thmprop1.p1.m6" class="ltx_Math" alttext="{\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math>, and define the full <math id="S3.Thmprop1.p1.m7" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>-level partition as <math id="S3.Thmprop1.p1.m8" class="ltx_Math" alttext="\Pi_{Y}:=\{{\mathcal{I}}_{k,l}^{Y}\}_{k,l}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo>:=</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mi>Y</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\Pi_{Y}:=\{{\mathcal{I}}_{k,l}^{Y}\}_{k,l}</annotation></semantics></math>. Then the joint distribution further factorizes as</span></p>
<table id="S3.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E3.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}((Y_{t})_{t=1}^{n}\mid\Pi_{Y})=\prod_{{\mathcal{V}}\in\Pi_{Y}}{\mathbb{P}}((Y_{t})_{t\in{\mathcal{V}}}|\Pi_{Y})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub></mrow></munder></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}((Y_{t})_{t=1}^{n}\mid\Pi_{Y})=\prod_{{\mathcal{V}}\in\Pi_{Y}}{\mathbb{P}}((Y_{t})_{t\in{\mathcal{V}}}|\Pi_{Y}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
</div>
</div>
</section>
<section id="S3.SS1.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Minimal units.</h5>

<div id="S3.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="S3.SS1.SSS0.Px3.p1.1" class="ltx_p">Proposition <a href="#S3.Thmprop1" title="Proposition 3.1 (Distribution factorization). ‣ Factorization from structural independence. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> establishes that, conditioned on the observed repetition pattern (represented by the tuple <math id="S3.SS1.SSS0.Px3.p1.m1" class="ltx_Math" alttext="(\Pi_{\zeta},\Pi_{Y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Pi_{\zeta},\Pi_{Y})</annotation></semantics></math>), the joint distribution of <math id="S3.SS1.SSS0.Px3.p1.m2" class="ltx_Math" alttext="(Y_{t})_{t=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">(Y_{t})_{t=1}^{n}</annotation></semantics></math> factorizes into independent components.
We denote such a component by <math id="S3.SS1.SSS0.Px3.p1.m3" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>, which corresponds either to a block like <math id="S3.SS1.SSS0.Px3.p1.m4" class="ltx_Math" alttext="{\mathcal{I}}_{1}^{\zeta},\ldots,{\mathcal{I}}_{K}^{\zeta}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mn>1</mn><mi>ζ</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>K</mi><mi>ζ</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{I}}_{1}^{\zeta},\ldots,{\mathcal{I}}_{K}^{\zeta}</annotation></semantics></math>, where pseudorandom variables are shared (as in (<a href="#S3.E2" title="In Proposition 3.1 (Distribution factorization). ‣ Factorization from structural independence. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>)), or to a sub-block like <math id="S3.SS1.SSS0.Px3.p1.m5" class="ltx_Math" alttext="{\mathcal{I}}_{1,1}^{Y},\ldots,{\mathcal{I}}_{K,m_{K}}^{Y}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mi>Y</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>K</mi><mo>,</mo><msub><mi>m</mi><mi>K</mi></msub></mrow><mi>Y</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{I}}_{1,1}^{Y},\ldots,{\mathcal{I}}_{K,m_{K}}^{Y}</annotation></semantics></math>, where pivotal statistics coincide (as in (<a href="#S3.E3" title="In Proposition 3.1 (Distribution factorization). ‣ Factorization from structural independence. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>)).
We refer to this element <math id="S3.SS1.SSS0.Px3.p1.m6" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math> as a <em id="S3.SS1.SSS0.Px3.p1.1.1" class="ltx_emph ltx_font_italic">minimal unit</em>—the finest partition level at which this independence factorization holds.
We denote the set of all minimal units as <math id="S3.SS1.SSS0.Px3.p1.m7" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>, which can be either <math id="S3.SS1.SSS0.Px3.p1.m8" class="ltx_Math" alttext="\Pi_{\zeta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><annotation encoding="application/x-tex">\Pi_{\zeta}</annotation></semantics></math> or <math id="S3.SS1.SSS0.Px3.p1.m9" class="ltx_Math" alttext="\Pi_{Y}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><annotation encoding="application/x-tex">\Pi_{Y}</annotation></semantics></math> depending on the structure. In the case of the Gumbel-max watermark, for instance, the minimal units are the sub-blocks. A key implication is that pivotal statistics from different minimal units are mutually independent, while those within the same unit might exhibit strong dependence due to pseudorandomness collisions.</p>
</div>
</section>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Problem Formulation</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">With the two-layer partition structure in place, we now formalize the hypothesis testing problem. Given data <math id="S3.SS2.p1.m1" class="ltx_math_unparsed" alttext="Y_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Y_{1:n}</annotation></semantics></math>, where each <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="Y_{t}=Y({w}_{t},\zeta_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>Y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y_{t}=Y({w}_{t},\zeta_{t})</annotation></semantics></math> depends on the token <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="{w}_{t}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{w}_{t}</annotation></semantics></math> and its associated pseudorandom variable <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="\zeta_{t}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\zeta_{t}</annotation></semantics></math>, we begin by identifying the repetition pattern and representing it through the two-layer partitions <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="\Pi_{\zeta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><annotation encoding="application/x-tex">\Pi_{\zeta}</annotation></semantics></math> and <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="\Pi_{Y}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><annotation encoding="application/x-tex">\Pi_{Y}</annotation></semantics></math>. The goal is to test:</p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_math_unparsed" alttext="H_{0}:Y_{t}~|~(\Pi_{\zeta},\Pi_{Y})\sim\mu_{0},\quad t=1,\dots,n\quad\text{vs.}\quad H_{1}:Y_{t}~|~(\Pi_{\zeta},\Pi_{Y})\sim\mu_{1,\bm{P}_{t}},\quad t=1,\dots,n." display="block" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>Y</mi><mi>t</mi></msub><mo fence="false" rspace="0.497em" stretchy="false">|</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>μ</mi><mn>0</mn></msub><mo rspace="1.167em">,</mo><mi>t</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mtext>vs.</mtext><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>Y</mi><mi>t</mi></msub><mo fence="false" rspace="0.497em" stretchy="false">|</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi>μ</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝑷</mi><mi>t</mi></msub></mrow></msub><mo rspace="1.167em">,</mo><mi>t</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{0}:Y_{t}~|~(\Pi_{\zeta},\Pi_{Y})\sim\mu_{0},\quad t=1,\dots,n\quad\text{vs.}\quad H_{1}:Y_{t}~|~(\Pi_{\zeta},\Pi_{Y})\sim\mu_{1,\bm{P}_{t}},\quad t=1,\dots,n.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">The notation <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="Y_{t}~|~(\Pi_{\zeta},\Pi_{Y})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo fence="false" lspace="0.608em">|</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{t}~|~(\Pi_{\zeta},\Pi_{Y})</annotation></semantics></math> indicates that the joint distribution of <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="(Y_{t})_{t=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">(Y_{t})_{t=1}^{n}</annotation></semantics></math> follows the observed repetition structure: indices within the same block of <math id="S3.SS2.p1.m9" class="ltx_Math" alttext="\Pi_{\zeta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><annotation encoding="application/x-tex">\Pi_{\zeta}</annotation></semantics></math> share the same pseudorandom variable, and those within the same sub-block of <math id="S3.SS2.p1.m10" class="ltx_Math" alttext="\Pi_{Y}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><annotation encoding="application/x-tex">\Pi_{Y}</annotation></semantics></math> take on the same pivotal statistic.</p>
</div>
<div id="S3.Thmrem1" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmrem1.2" class="ltx_text ltx_font_italic">Remark 3.1</span></span><span id="S3.Thmrem1.3" class="ltx_text ltx_font_italic"> </span>(Comparison with previous work)<span id="S3.Thmrem1.4" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmrem1.p1" class="ltx_para">
<p id="S3.Thmrem1.p1.1" class="ltx_p">The main difference from prior work <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite> is that <math id="S3.Thmrem1.p1.m1" class="ltx_Math" alttext="(Y_{t})_{t=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">(Y_{t})_{t=1}^{n}</annotation></semantics></math> are no longer independent under either <math id="S3.Thmrem1.p1.m2" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> or <math id="S3.Thmrem1.p1.m3" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>.<span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup>
                <span class="ltx_tag ltx_tag_note">3</span>
                
                
                
              For theoretical analysis, we assume that <math id="footnote3.m1" class="ltx_math_unparsed" alttext="\bm{P}_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑷</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{P}_{1:n}</annotation></semantics></math> is fixed but unknown. This simplification preserves the difficulty of the problem, as <math id="footnote3.m2" class="ltx_math_unparsed" alttext="\bm{P}_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑷</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{P}_{1:n}</annotation></semantics></math> are still not observed. Under this assumption, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite> shows that <math id="footnote3.m3" class="ltx_Math" alttext="(Y_{t})_{t=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">(Y_{t})_{t=1}^{n}</annotation></semantics></math> are independent under both <math id="footnote3.m4" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> and <math id="footnote3.m5" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>. See Section 3.1 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite> for a related discussion.</span></span></span> The dependence arises from the two-level partition <math id="S3.Thmrem1.p1.m4" class="ltx_Math" alttext="(\Pi_{\zeta},\Pi_{Y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Pi_{\zeta},\Pi_{Y})</annotation></semantics></math>, which forces certain pseudorandom variables and pivotal statistics to be identical within groups. As a result, although each <math id="S3.Thmrem1.p1.m5" class="ltx_Math" alttext="Y_{t}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">Y_{t}</annotation></semantics></math> still marginally follows <math id="S3.Thmrem1.p1.m6" class="ltx_Math" alttext="\mu_{0}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mu_{0}</annotation></semantics></math> under <math id="S3.Thmrem1.p1.m7" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> or <math id="S3.Thmrem1.p1.m8" class="ltx_Math" alttext="\mu_{1,\bm{P}_{t}}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝑷</mi><mi>t</mi></msub></mrow></msub><annotation encoding="application/x-tex">\mu_{1,\bm{P}_{t}}</annotation></semantics></math> under <math id="S3.Thmrem1.p1.m9" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> when conditioning on <math id="S3.Thmrem1.p1.m10" class="ltx_Math" alttext="(\Pi_{\zeta},\Pi_{Y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Pi_{\zeta},\Pi_{Y})</annotation></semantics></math>, their joint distribution no longer factorizes across <math id="S3.Thmrem1.p1.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and instead follows the one described in Proposition <a href="#S3.Thmprop1" title="Proposition 3.1 (Distribution factorization). ‣ Factorization from structural independence. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>. In short, pseudorandom collisions induce dependence among pivotal statistics, motivating our new formulation in (<a href="#S3.E4" title="In 3.2 Problem Formulation ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) and the minimal-unit technique to properly address it.</p>
</div>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">At a high level, watermark detection under pseudorandomness collisions reduces to identifying distributional differences in <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="(Y_{t})_{t=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">(Y_{t})_{t=1}^{n}</annotation></semantics></math>, given the dependence structure specified by the two-layer partitions <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="(\Pi_{\zeta},\Pi_{Y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Pi_{\zeta},\Pi_{Y})</annotation></semantics></math>. By the factorization established in Proposition <a href="#S3.Thmprop1" title="Proposition 3.1 (Distribution factorization). ‣ Factorization from structural independence. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, it is both natural and sufficient to consider detection rules that assign score functions to each minimal unit and aggregate the resulting scores into a global test statistic.<span id="footnote4" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">4</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">4</sup>
              <span class="ltx_tag ltx_tag_note">4</span>
              
              
              
            The log-likelihood ratio test also falls into this class, though it is typically impractical as it depends on the inaccessible NTP distributions.</span></span></span>
Specifically, we propose and assign a score function <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="h_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">h_{{\mathcal{V}}}</annotation></semantics></math> to every minimal unit <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="{\mathcal{V}}\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">{\mathcal{V}}\in\Pi</annotation></semantics></math>, and write <math id="S3.SS2.p2.m5" class="ltx_Math" alttext="Y_{{\mathcal{V}}}:=(Y_{t})_{t\in{\mathcal{V}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>:=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Y_{{\mathcal{V}}}:=(Y_{t})_{t\in{\mathcal{V}}}</annotation></semantics></math> for the vector of pivotal statistics in <math id="S3.SS2.p2.m6" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>.
The detection rule then takes the form:</p>
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="T_{n}=\begin{cases}1,&amp;\text{if }S_{n}\geq\gamma_{n,\alpha},\\
0,&amp;\text{otherwise},\end{cases}" display="block" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>n</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>n</mi></msub></mrow><mo>≥</mo><msub><mi>γ</mi><mrow><mi>n</mi><mo>,</mo><mi>α</mi></mrow></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>otherwise</mtext><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">T_{n}=\begin{cases}1,&amp;\text{if }S_{n}\geq\gamma_{n,\alpha},\\
0,&amp;\text{otherwise},\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p2.2" class="ltx_p">where the test statistic is defined as</p>
<table id="S3.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E6.m1" class="ltx_Math" alttext="S_{n}=\sum_{{\mathcal{V}}\in\Pi}h_{{{\mathcal{V}}}}(Y_{{\mathcal{V}}})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></munder><mrow><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{n}=\sum_{{\mathcal{V}}\in\Pi}h_{{{\mathcal{V}}}}(Y_{{\mathcal{V}}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p2.3" class="ltx_p">and <math id="S3.SS2.p2.m7" class="ltx_Math" alttext="\gamma_{n,\alpha}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>n</mi><mo>,</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">\gamma_{n,\alpha}</annotation></semantics></math> is the <math id="S3.SS2.p2.m8" class="ltx_Math" alttext="(1-\alpha)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\alpha)</annotation></semantics></math> quantile of <math id="S3.SS2.p2.m9" class="ltx_Math" alttext="S_{n}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>n</mi></msub><annotation encoding="application/x-tex">S_{n}</annotation></semantics></math> under <math id="S3.SS2.p2.m10" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>, ensuring Type I error control: <math id="S3.SS2.p2.m11" class="ltx_Math" alttext="{\mathbb{P}}_{0}(S_{n}\geq\gamma_{n,\alpha})=\alpha" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>n</mi></msub><mo>≥</mo><msub><mi>γ</mi><mrow><mi>n</mi><mo>,</mo><mi>α</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">{\mathbb{P}}_{0}(S_{n}\geq\gamma_{n,\alpha})=\alpha</annotation></semantics></math>.
In practice, <math id="S3.SS2.p2.m12" class="ltx_Math" alttext="\gamma_{n,\alpha}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>n</mi><mo>,</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">\gamma_{n,\alpha}</annotation></semantics></math> can be estimated via simulation, since the dependence structure of <math id="S3.SS2.p2.m13" class="ltx_math_unparsed" alttext="Y_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Y_{1:n}</annotation></semantics></math> is fully characterized by the partitions <math id="S3.SS2.p2.m14" class="ltx_Math" alttext="(\Pi_{\zeta},\Pi_{Y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Π</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Pi_{\zeta},\Pi_{Y})</annotation></semantics></math>, and each <math id="S3.SS2.p2.m15" class="ltx_Math" alttext="Y_{t}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">Y_{t}</annotation></semantics></math> marginally follows <math id="S3.SS2.p2.m16" class="ltx_Math" alttext="\mu_{0}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mu_{0}</annotation></semantics></math> under the null.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Detection Efficiency and Optimal Scores</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">The central goal of this paper is to solve the hypothesis testing problem (<a href="#S3.E4" title="In 3.2 Problem Formulation ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) optimally using detection rules of the form (<a href="#S3.E5" title="In 3.2 Problem Formulation ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>). To this end, we require a criterion or efficiency notion to quantify the performance of a given score function.</p>
</div>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p">We follow the spirit of the asymptotic efficiency notion introduced by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite>, which quantifies detection efficiency via the decay rate of the least favorable Type II error under a fixed Type I error level. Here, “least favorable” refers to the worst-case Type II error over a belief class <math id="S3.SS3.p2.m1" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math>—a collection of plausible NTP distributions that the verifier assumes the true <math id="S3.SS3.p2.m2" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math> belongs to. This formulation reflects a practical constraint: the verifier does not have access to the true <math id="S3.SS3.p2.m3" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math> and must rely on prior knowledge or assumptions to evaluate efficiency.
However, this notion cannot be directly applied in our setting, as it relies on perfect pseudorandomness and thus assumes full independence among these <math id="S3.SS3.p2.m4" class="ltx_Math" alttext="Y_{t}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">Y_{t}</annotation></semantics></math>’s. To address this, we introduce a new non-asymptotic notion of efficiency that explicitly incorporates the dependencies induced by the partition <math id="S3.SS3.p2.m5" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmdefn3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmdefn3.2" class="ltx_text ltx_font_bold">Definition 3.3</span></span><span id="S3.Thmdefn3.3" class="ltx_text ltx_font_bold"> </span>(Non-asymptotic <math id="S3.Thmdefn3.m1" class="ltx_Math" alttext="\mathscr{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒫</mi><annotation encoding="application/x-tex">\mathscr{P}</annotation></semantics></math>-efficiency)<span id="S3.Thmdefn3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmdefn3.p1" class="ltx_para">
<p id="S3.Thmdefn3.p1.1" class="ltx_p"><span id="S3.Thmdefn3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmdefn3.p1.m1" class="ltx_Math" alttext="S_{n}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>n</mi></msub><annotation encoding="application/x-tex">S_{n}</annotation></semantics></math> be a test statistic computed from <math id="S3.Thmdefn3.p1.m2" class="ltx_math_unparsed" alttext="Y_{1:n}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Y_{1:n}</annotation></semantics></math> using a partition <math id="S3.Thmdefn3.p1.m3" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math> with <math id="S3.Thmdefn3.p1.m4" class="ltx_Math" alttext="N_{n}=|\Pi|" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>n</mi></msub><mo>=</mo><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">N_{n}=|\Pi|</annotation></semantics></math> minimal units. Let <math id="S3.Thmdefn3.p1.m5" class="ltx_Math" alttext="\gamma_{n,\alpha}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>n</mi><mo>,</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">\gamma_{n,\alpha}</annotation></semantics></math> denote the critical value corresponding to a Type I error level <math id="S3.Thmdefn3.p1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>. For a given family of belief classes <math id="S3.Thmdefn3.p1.m7" class="ltx_Math" alttext="\mathscr{P}:=\{{\mathcal{P}}_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒫</mi><mo>:=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathscr{P}:=\{{\mathcal{P}}_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math>, the non-asymptotic <math id="S3.Thmdefn3.p1.m8" class="ltx_Math" alttext="\mathscr{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒫</mi><annotation encoding="application/x-tex">\mathscr{P}</annotation></semantics></math>-efficiency of the test based on the score functions <math id="S3.Thmdefn3.p1.m9" class="ltx_Math" alttext="{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><mrow><mi>𝐡</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math> is defined as</span></p>
<table id="S3.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E7.m1" class="ltx_math_unparsed" alttext="\displaystyle R_{n,\mathscr{P}}({\bm{h}}):=-\frac{1}{N_{n}}\sup_{\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{{\mathcal{V}}},\forall{\mathcal{V}}}\log{\mathbb{P}}_{1,\bm{P}_{{\mathcal{V}}}}(S_{n}\leq\gamma_{n,\alpha})," display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">:=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>N</mi><mi>n</mi></msub></mfrac></mstyle><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow><mo>,</mo><mrow><mo rspace="0.167em">∀</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></mrow></munder><mi>log</mi><msub><mi>ℙ</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo>≤</mo><msub><mi>γ</mi><mrow><mi>n</mi><mo>,</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle R_{n,\mathscr{P}}({\bm{h}}):=-\frac{1}{N_{n}}\sup_{\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{{\mathcal{V}}},\forall{\mathcal{V}}}\log{\mathbb{P}}_{1,\bm{P}_{{\mathcal{V}}}}(S_{n}\leq\gamma_{n,\alpha}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div>
<div id="S3.Thmdefn3.p2" class="ltx_para">
<p id="S3.Thmdefn3.p2.1" class="ltx_p"><span id="S3.Thmdefn3.p2.1.1" class="ltx_text ltx_font_italic">where <math id="S3.Thmdefn3.p2.m1" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}:=(\bm{P}_{t})_{t\in{\mathcal{V}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>:=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐏</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}:=(\bm{P}_{t})_{t\in{\mathcal{V}}}</annotation></semantics></math> collect the NTP distributions in the minimal unit <math id="S3.Thmdefn3.p2.m2" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>, <math id="S3.Thmdefn3.p2.m3" class="ltx_Math" alttext="{\mathcal{P}}_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{{\mathcal{V}}}</annotation></semantics></math> is the belief class associated with <math id="S3.Thmdefn3.p2.m4" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>, and the supremum is taken over all collections where each <math id="S3.Thmdefn3.p2.m5" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{{\mathcal{V}}}</annotation></semantics></math> for all <math id="S3.Thmdefn3.p2.m6" class="ltx_Math" alttext="{\mathcal{V}}\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">{\mathcal{V}}\in\Pi</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.Thmrem2" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmrem2.2" class="ltx_text ltx_font_italic">Remark 3.2</span></span><span id="S3.Thmrem2.3" class="ltx_text ltx_font_italic"> </span>(Necessity of non-asymptotic efficiency)<span id="S3.Thmrem2.4" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmrem2.p1" class="ltx_para">
<p id="S3.Thmrem2.p1.1" class="ltx_p">Given the hash rule <math id="S3.Thmrem2.p1.m1" class="ltx_math_unparsed" alttext="\zeta_{t}={\mathcal{A}}({w}_{(t-m):(t-1)},{\mathtt{Key}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>t</mi></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>m</mi></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝙺𝚎𝚢</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta_{t}={\mathcal{A}}({w}_{(t-m):(t-1)},{\mathtt{Key}})</annotation></semantics></math>, the number of distinct text windows <math id="S3.Thmrem2.p1.m2" class="ltx_math_unparsed" alttext="{w}_{(t-m):(t-1)}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>m</mi></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">{w}_{(t-m):(t-1)}</annotation></semantics></math> is bounded by <math id="S3.Thmrem2.p1.m3" class="ltx_Math" alttext="|{{\mathcal{W}}}|^{m}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mi>m</mi></msup><annotation encoding="application/x-tex">|{{\mathcal{W}}}|^{m}</annotation></semantics></math>. Consequently, the total number of possible pseudorandom variables <math id="S3.Thmrem2.p1.m4" class="ltx_Math" alttext="\zeta_{t}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\zeta_{t}</annotation></semantics></math> is also bounded by <math id="S3.Thmrem2.p1.m5" class="ltx_Math" alttext="|{{\mathcal{W}}}|^{m}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mi>m</mi></msup><annotation encoding="application/x-tex">|{{\mathcal{W}}}|^{m}</annotation></semantics></math>. Since different minimal units must correspond to different pseudorandom variables, the number of minimal units satisfies <math id="S3.Thmrem2.p1.m6" class="ltx_Math" alttext="|\Pi|\leq|{{\mathcal{W}}}|^{m}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mi>m</mi></msup></mrow><annotation encoding="application/x-tex">|\Pi|\leq|{{\mathcal{W}}}|^{m}</annotation></semantics></math>, which does not grow with the text length <math id="S3.Thmrem2.p1.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. This boundedness necessitates a non-asymptotic efficiency notion, as <math id="S3.Thmrem2.p1.m8" class="ltx_Math" alttext="|\Pi|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\Pi|</annotation></semantics></math> cannot diverge with <math id="S3.Thmrem2.p1.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> when <math id="S3.Thmrem2.p1.m10" class="ltx_Math" alttext="|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|</annotation></semantics></math> and <math id="S3.Thmrem2.p1.m11" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> are fixed.</p>
</div>
</div>
<div id="S3.SS3.p3" class="ltx_para">
<p id="S3.SS3.p3.1" class="ltx_p">There are two key differences between our efficiency notion and that of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>, Theorem 2.1]</cite>.
First, <math id="S3.SS3.p3.m1" class="ltx_Math" alttext="R_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math> is defined for finite <math id="S3.SS3.p3.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and uses minimal units as the basic building blocks.
In contrast, the earlier notion is defined at the token level and only in the asymptotic regime as <math id="S3.SS3.p3.m3" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.
That special case corresponds to our framework when the partition is <math id="S3.SS3.p3.m4" class="ltx_Math" alttext="\Pi=\{\{1\},\{2\},\dots,\{n\}\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Π</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">{</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><mn>2</mn><mo stretchy="false">}</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">{</mo><mi>n</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Pi=\{\{1\},\{2\},\dots,\{n\}\}</annotation></semantics></math>, that is, one token per unit.
Second, our formulation allows different belief classes to be assigned to different minimal units, and each minimal unit can have its own score function.
This flexibility enables us to evaluate a broader range of detection rules and better reflect practical scenarios.
By contrast, the efficiency notion of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite> requires a single belief class and a single score function across all tokens, which is less expressive.</p>
</div>
<div id="S3.Thmasmp3" class="ltx_theorem ltx_theorem_asmp">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmasmp3.2" class="ltx_text ltx_font_bold">Assumption 3.3</span></span><span id="S3.Thmasmp3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmasmp3.p1" class="ltx_para">
<p id="S3.Thmasmp3.p1.1" class="ltx_p"><span id="S3.Thmasmp3.p1.1.1" class="ltx_text ltx_font_italic">We assume that</span></p>
<ol id="S3.I3" class="ltx_enumerate">
<li id="S3.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S3.I3.i1.p1" class="ltx_para">
<p id="S3.I3.i1.p1.1" class="ltx_p"><span id="S3.I3.i1.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">(Independence structure)</span><span id="S3.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">
 Either Assumption </span><a href="#S3.Thmasmp1" title="Assumption 3.1 (Independence across blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">3.1</span></a><span id="S3.I3.i1.p1.1.3" class="ltx_text ltx_font_italic"> or </span><a href="#S3.Thmasmp2" title="Assumption 3.2 (Independence across sub-blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">3.2</span></a><span id="S3.I3.i1.p1.1.4" class="ltx_text ltx_font_italic"> holds.</span></p>
</div></li>
<li id="S3.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S3.I3.i2.p1" class="ltx_para">
<p id="S3.I3.i2.p1.1" class="ltx_p"><span id="S3.I3.i2.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">(Bounded variance)</span><span id="S3.I3.i2.p1.1.2" class="ltx_text ltx_font_italic">
 Let </span><math id="S3.I3.i2.p1.m1" class="ltx_Math" alttext="{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math><span id="S3.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> be the score functions, with each assigned to a minimal unit. We assume that the variances of </span><math id="S3.I3.i2.p1.m2" class="ltx_Math" alttext="\{h_{{\mathcal{V}}}(Y_{{\mathcal{V}}})\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub><annotation encoding="application/x-tex">\{h_{{\mathcal{V}}}(Y_{{\mathcal{V}}})\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math><span id="S3.I3.i2.p1.1.4" class="ltx_text ltx_font_italic"> are uniformly bounded under </span><math id="S3.I3.i2.p1.m3" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math><span id="S3.I3.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S3.I3.i3.p1" class="ltx_para">
<p id="S3.I3.i3.p1.1" class="ltx_p"><span id="S3.I3.i3.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">(Well posedness)</span><span id="S3.I3.i3.p1.1.2" class="ltx_text ltx_font_italic"> 
Let </span><math id="S3.I3.i3.p1.m1" class="ltx_Math" alttext="B_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math><span id="S3.I3.i3.p1.1.3" class="ltx_text ltx_font_italic"> denote the non-asymptotic quantity defined in (</span><a href="#S3.E9" title="In Theorem 3.1 (Explicit lower bound for detection efficiency). ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">9</span></a><span id="S3.I3.i3.p1.1.4" class="ltx_text ltx_font_italic">).
There exists a minimizer of the infimum over </span><math id="S3.I3.i3.p1.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math><span id="S3.I3.i3.p1.1.5" class="ltx_text ltx_font_italic"> that is bounded by a positive constant independent of both the partition </span><math id="S3.I3.i3.p1.m3" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math><span id="S3.I3.i3.p1.1.6" class="ltx_text ltx_font_italic"> and </span><math id="S3.I3.i3.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="S3.I3.i3.p1.1.7" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS3.p4" class="ltx_para">
<p id="S3.SS3.p4.1" class="ltx_p">We pose a mild Assumption <a href="#S3.Thmasmp3" title="Assumption 3.3. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> to simplify the efficiency notion <math id="S3.SS3.p4.m1" class="ltx_Math" alttext="R_{n,\mathscr{P}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><annotation encoding="application/x-tex">R_{n,\mathscr{P}}</annotation></semantics></math>. The first condition of independence structure reflects the repetition-induced partition and has been discussed in Section <a href="#S3.SS1" title="3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>: although dependence may persist within a block, some independence still holds across different blocks or sub-blocks. The second condition of bounded variance rules out pathological score functions with unbounded variability, and is satisfied in practice since the score functions we study even admit finite MGFs. The last condition of well-posedness ensures that the minimization problem in <math id="S3.SS3.p4.m2" class="ltx_Math" alttext="B_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math> has stable solutions: the minimizer over <math id="S3.SS3.p4.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is uniformly bounded. Together, these assumptions require only mild regularity and do not limit the practical applicability of our framework.</p>
</div>
<div id="S3.Thmthm1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm1.2" class="ltx_text ltx_font_bold">Theorem 3.1</span></span><span id="S3.Thmthm1.3" class="ltx_text ltx_font_bold"> </span>(Explicit lower bound for detection efficiency)<span id="S3.Thmthm1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm1.p1" class="ltx_para">
<p id="S3.Thmthm1.p1.1" class="ltx_p"><span id="S3.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm1.p1.m1" class="ltx_Math" alttext="\mathscr{P}=\{{\mathcal{P}}_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒫</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathscr{P}=\{{\mathcal{P}}_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math> denote the family of belief classes, with one belief class assigned to each minimal unit.
Let <math id="S3.Thmthm1.p1.m2" class="ltx_Math" alttext="\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>,</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(\theta)</annotation></semantics></math> denote the moment generating function (MGF) under the alternative <math id="S3.Thmthm1.p1.m3" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> in (<a href="#S3.E4" title="In 3.2 Problem Formulation ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), defined for any <math id="S3.Thmthm1.p1.m4" class="ltx_Math" alttext="\theta\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\theta\geq 0</annotation></semantics></math> as</span></p>
<table id="S3.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E8.m1" class="ltx_Math" alttext="\displaystyle\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(\theta):=\EB_{1,\bm{P}_{{\mathcal{V}}}}[\exp(-\theta\,h_{{\mathcal{V}}}(Y_{{\mathcal{V}}}))]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ϕ</mi><mrow><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>,</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msub><mi>𝔼</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>θ</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(\theta):=\EB_{1,\bm{P}_{{\mathcal{V}}}}[\exp(-\theta\,h_{{\mathcal{V}}}(Y_{{\mathcal{V}}}))].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="S3.Thmthm1.p1.2" class="ltx_p"><span id="S3.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#S3.Thmasmp3" title="Assumption 3.3. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, the non-asymptotic <math id="S3.Thmthm1.p1.m5" class="ltx_Math" alttext="\mathscr{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒫</mi><annotation encoding="application/x-tex">\mathscr{P}</annotation></semantics></math>-efficiency of the score functions <math id="S3.Thmthm1.p1.m6" class="ltx_Math" alttext="{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><mrow><mi>𝐡</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math> is lower bounded by</span></p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="R_{n,\mathscr{P}}({\bm{h}})\geq B_{n,\mathscr{P}}({\bm{h}})-\omega_{N_{n}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>R</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">R_{n,\mathscr{P}}({\bm{h}})\geq B_{n,\mathscr{P}}({\bm{h}})-\omega_{N_{n}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm1.p1.3" class="ltx_p"><span id="S3.Thmthm1.p1.3.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="S3.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E9.m1" class="ltx_math_unparsed" alttext="\displaystyle B_{n,\mathscr{P}}({\bm{h}}):=-\inf_{\theta\geq 0}\frac{1}{N_{n}}\sum_{{\mathcal{V}}\in\Pi}\left(\theta\,\EB_{0}[h_{{{\mathcal{V}}}}(Y_{{\mathcal{V}}})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{\mathcal{V}}}\log\phi_{\bm{P}_{{\mathcal{V}}},h_{{{\mathcal{V}}}}}(\theta)\right)," display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">:=</mo><mo lspace="0em">−</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>θ</mi><mo>≥</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>N</mi><mi>n</mi></msub></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></munder></mstyle><mrow><mo>(</mo><mi>θ</mi><msub><mi>𝔼</mi><mn>0</mn></msub><mrow><mo stretchy="false">[</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></munder><mi>log</mi><msub><mi>ϕ</mi><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>,</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle B_{n,\mathscr{P}}({\bm{h}}):=-\inf_{\theta\geq 0}\frac{1}{N_{n}}\sum_{{\mathcal{V}}\in\Pi}\left(\theta\,\EB_{0}[h_{{{\mathcal{V}}}}(Y_{{\mathcal{V}}})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{\mathcal{V}}}\log\phi_{\bm{P}_{{\mathcal{V}}},h_{{{\mathcal{V}}}}}(\theta)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="S3.Thmthm1.p1.4" class="ltx_p"><span id="S3.Thmthm1.p1.4.1" class="ltx_text ltx_font_italic">and <math id="S3.Thmthm1.p1.m7" class="ltx_Math" alttext="\omega_{N_{n}}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub><annotation encoding="application/x-tex">\omega_{N_{n}}</annotation></semantics></math> is a deterministic function of <math id="S3.Thmthm1.p1.m8" class="ltx_Math" alttext="N_{n}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>n</mi></msub><annotation encoding="application/x-tex">N_{n}</annotation></semantics></math> satisfying <math id="S3.Thmthm1.p1.m9" class="ltx_Math" alttext="\omega_{N_{n}}\to 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\omega_{N_{n}}\to 0</annotation></semantics></math> as <math id="S3.Thmthm1.p1.m10" class="ltx_Math" alttext="N_{n}\to\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>n</mi></msub><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">N_{n}\to\infty</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.Thmrem3" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmrem3.2" class="ltx_text ltx_font_italic">Remark 3.3</span></span><span id="S3.Thmrem3.3" class="ltx_text ltx_font_italic"> </span>(Asymptotic tightness)<span id="S3.Thmrem3.4" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmrem3.p1" class="ltx_para">
<p id="S3.Thmrem3.p1.1" class="ltx_p">Under further regularity conditions, the lower bound <math id="S3.Thmrem3.p1.m1" class="ltx_Math" alttext="B_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math> is asymptotically tight in the sense that <math id="S3.Thmrem3.p1.m2" class="ltx_Math" alttext="\left|R_{n,\mathscr{P}}({\bm{h}})-B_{n,\mathscr{P}}({\bm{h}})\right|\leq\omega_{N_{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi>R</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub></mrow><annotation encoding="application/x-tex">\left|R_{n,\mathscr{P}}({\bm{h}})-B_{n,\mathscr{P}}({\bm{h}})\right|\leq\omega_{N_{n}}</annotation></semantics></math> for the same sequence <math id="S3.Thmrem3.p1.m3" class="ltx_Math" alttext="\omega_{N_{n}}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub><annotation encoding="application/x-tex">\omega_{N_{n}}</annotation></semantics></math> introduced in Theorem <a href="#S3.Thmthm1" title="Theorem 3.1 (Explicit lower bound for detection efficiency). ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>.
To prove this tightness, we develop a novel non-i.i.d. large-deviation bound.
See Theorem <a href="#A1.SS2" title="A.2 Asymptotic Tightness ‣ Appendix A Proof for the General Framework ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> in the Supplementary Material for more details.</p>
</div>
</div>
<div id="S3.SS3.p5" class="ltx_para">
<p id="S3.SS3.p5.1" class="ltx_p">In Theorem <a href="#S3.Thmthm1" title="Theorem 3.1 (Explicit lower bound for detection efficiency). ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, we lower bound <math id="S3.SS3.p5.m1" class="ltx_Math" alttext="R_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math> by a more explicit quantity <math id="S3.SS3.p5.m2" class="ltx_Math" alttext="B_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math>, using the classical Chernoff bound. Setting <math id="S3.SS3.p5.m3" class="ltx_Math" alttext="\theta=0" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\theta=0</annotation></semantics></math> further shows that <math id="S3.SS3.p5.m4" class="ltx_Math" alttext="B_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math> is always non-negative.</p>
</div>
<section id="S3.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Optimality via minimax optimization.</h5>

<div id="S3.SS3.SSS0.Px1.p1" class="ltx_para">
<p id="S3.SS3.SSS0.Px1.p1.1" class="ltx_p">The lower bound <math id="S3.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="B_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math> provides a tractable approximation to the efficiency notion <math id="S3.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="R_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math> and admits an explicit form suitable for analysis. In particular, identifying the optimal score functions reduces to solving the minimax optimization problem that <math id="S3.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\max_{\bm{h}}B_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>max</mi><mi>𝒉</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\max_{\bm{h}}B_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math>.
Since the expression of <math id="S3.SS3.SSS0.Px1.p1.m4" class="ltx_Math" alttext="B_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math> decomposes over minimal units, the overall optimization problem naturally separates into independent subproblems. Viewing each scaled score function <math id="S3.SS3.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\theta h_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow><annotation encoding="application/x-tex">\theta h_{{\mathcal{V}}}</annotation></semantics></math> as a reparameterization, finding the optimal collection <math id="S3.SS3.SSS0.Px1.p1.m6" class="ltx_Math" alttext="{\bm{h}}=\{h_{{{\mathcal{V}}}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{h}}=\{h_{{{\mathcal{V}}}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math> reduces to solving the following minimax problem for each minimal unit <math id="S3.SS3.SSS0.Px1.p1.m7" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>:</p>
<table id="S3.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E10.m1" class="ltx_math_unparsed" alttext="h_{{{\mathcal{V}}}}=\arg\min_{h}\max_{\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{{\mathcal{V}}}}L(h,\bm{P}_{{\mathcal{V}}}),\quad\text{where}\quad L(h,\bm{P}_{{\mathcal{V}}})=\EB_{0}[h(Y_{{\mathcal{V}}})]+\log\EB_{1,\bm{P}_{{\mathcal{V}}}}[\exp(-h(Y_{{\mathcal{V}}}))]." display="block" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>=</mo><mi>arg</mi><munder><mi>min</mi><mi>h</mi></munder><munder><mi>max</mi><mrow><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></munder><mi>L</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><mtext>where</mtext><mi>L</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mn>0</mn></msub><mrow><mo stretchy="false">[</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>log</mi><msub><mi>𝔼</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub><mrow><mo stretchy="false">[</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h_{{{\mathcal{V}}}}=\arg\min_{h}\max_{\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{{\mathcal{V}}}}L(h,\bm{P}_{{\mathcal{V}}}),\quad\text{where}\quad L(h,\bm{P}_{{\mathcal{V}}})=\EB_{0}[h(Y_{{\mathcal{V}}})]+\log\EB_{1,\bm{P}_{{\mathcal{V}}}}[\exp(-h(Y_{{\mathcal{V}}}))].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="S3.SS3.SSS0.Px1.p1.2" class="ltx_p">The key difference from the previous formulation in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>, Equation 14]</cite> is that we now optimize over all NTP distributions <math id="S3.SS3.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}</annotation></semantics></math> within each minimal unit <math id="S3.SS3.SSS0.Px1.p1.m9" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>, which is necessary to capture the dependence induced by repetition in the two-level partition. In contrast, the previous setting corresponds to the non-repetition case where <math id="S3.SS3.SSS0.Px1.p1.m10" class="ltx_Math" alttext="|{\mathcal{V}}|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|=1</annotation></semantics></math>, which results in a significantly simpler minimax problem.
Following prior work, we adopt the <math id="S3.SS3.SSS0.Px1.p1.m11" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>-regular class as our belief set for simplicity:</p>
<table id="S3.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E11.m1" class="ltx_Math" alttext="\displaystyle{\mathcal{P}}_{\Delta}=\left\{\bm{P}:\max_{w}P_{w}\leq 1-\Delta\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi mathvariant="normal">Δ</mi></msub><mo>=</mo><mrow><mo>{</mo><mi>𝑷</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><munder><mi>max</mi><mi>w</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>w</mi></msub></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{P}}_{\Delta}=\left\{\bm{P}:\max_{w}P_{w}\leq 1-\Delta\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Application to the Gumbel-max Watermark</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">In this section, we apply our framework to the Gumbel-max watermarking scheme <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">1</a>]</cite>. Recall that the Gumbel-max decoder can be equivalently written as</p>
<table id="S4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E12.m1" class="ltx_Math" alttext="{w}_{t}={\mathcal{S}}^{\mathrm{gum}}(\bm{P}_{t},\zeta_{t}):=\arg\max_{{w}\in{{\mathcal{W}}}}\frac{\log U_{t,{w}}}{P_{t,{w}}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>gum</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑷</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><munder><mi>max</mi><mrow><mi>w</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>w</mi></mrow></msub></mrow><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><mi>w</mi></mrow></msub></mfrac></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{w}_{t}={\mathcal{S}}^{\mathrm{gum}}(\bm{P}_{t},\zeta_{t}):=\arg\max_{{w}\in{{\mathcal{W}}}}\frac{\log U_{t,{w}}}{P_{t,{w}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="S4.p1.2" class="ltx_p">where <math id="S4.p1.m1" class="ltx_Math" alttext="\{\zeta_{t}\}_{t=1}^{n}=\{(U_{t,{w}})_{{w}\in{{\mathcal{W}}}}\}_{t=1}^{n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>w</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>w</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><annotation encoding="application/x-tex">\{\zeta_{t}\}_{t=1}^{n}=\{(U_{t,{w}})_{{w}\in{{\mathcal{W}}}}\}_{t=1}^{n}</annotation></semantics></math> denotes <math id="S4.p1.m2" class="ltx_Math" alttext="n\times|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">n\times|{{\mathcal{W}}}|</annotation></semantics></math> i.i.d. replicates of standard uniform random variables <math id="S4.p1.m3" class="ltx_Math" alttext="U(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(0,1)</annotation></semantics></math>. As shown in (<a href="#S4.E12" title="In 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>), the Gumbel-max trick ensures that the decoder samples exactly from the intended NTP distribution <math id="S4.p1.m4" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math>.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">The pivotal statistic in this setting is given by <math id="S4.p2.m1" class="ltx_Math" alttext="Y_{t}=Y^{\mathrm{gum}}(w_{t},\zeta_{t})=U_{t,w_{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo>=</mo><mrow><msup><mi>Y</mi><mi>gum</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><msub><mi>w</mi><mi>t</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">Y_{t}=Y^{\mathrm{gum}}(w_{t},\zeta_{t})=U_{t,w_{t}}</annotation></semantics></math>, namely the coordinate of <math id="S4.p2.m2" class="ltx_Math" alttext="\zeta_{t}=(U_{t,{w}})_{{w}\in{{\mathcal{W}}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>t</mi></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mrow><mi>t</mi><mo>,</mo><mi>w</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>w</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\zeta_{t}=(U_{t,{w}})_{{w}\in{{\mathcal{W}}}}</annotation></semantics></math> corresponding to the chosen token <math id="S4.p2.m3" class="ltx_Math" alttext="{w}_{t}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{w}_{t}</annotation></semantics></math>.
This choice satisfies the refined Assumption <a href="#S3.Thmasmp2" title="Assumption 3.2 (Independence across sub-blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, implying that each minimal unit coincides with a sub-block.
Consequently, for a minimal unit <math id="S4.p2.m4" class="ltx_Math" alttext="{\mathcal{V}}=\{t_{1},\dots,t_{k}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{V}}=\{t_{1},\dots,t_{k}\}</annotation></semantics></math>, all pivotal statistics <math id="S4.p2.m5" class="ltx_Math" alttext="Y_{t_{1}},\dots,Y_{t_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Y</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">Y_{t_{1}},\dots,Y_{t_{k}}</annotation></semantics></math> collapse to the same value, so it is sufficient to consider only the unique representative, say <math id="S4.p2.m6" class="ltx_Math" alttext="Y_{t_{1}}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">Y_{t_{1}}</annotation></semantics></math>.
Under the null <math id="S4.p2.m7" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>, this statistic still follows <math id="S4.p2.m8" class="ltx_Math" alttext="\mathrm{Unif}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Unif}(0,1)</annotation></semantics></math>, since repetition does not alter its marginal distribution.
We next derive its alternative distribution in the following lemma.</p>
</div>
<div id="S4.Thmlem1" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmlem1.2" class="ltx_text ltx_font_bold">Lemma 4.1</span></span><span id="S4.Thmlem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmlem1.p1" class="ltx_para">
<p id="S4.Thmlem1.p1.1" class="ltx_p"><span id="S4.Thmlem1.p1.1.1" class="ltx_text ltx_font_italic">For the minimal unit <math id="S4.Thmlem1.p1.m1" class="ltx_Math" alttext="{\mathcal{V}}=\{t_{1},\dots,t_{k}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{V}}=\{t_{1},\dots,t_{k}\}</annotation></semantics></math>, all pivotal statistics within the unit share the same value, that is, <math id="S4.Thmlem1.p1.m2" class="ltx_Math" alttext="Y_{t_{1}}=\cdots=Y_{t_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><msub><mi>Y</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">Y_{t_{1}}=\cdots=Y_{t_{k}}</annotation></semantics></math>.
Let <math id="S4.Thmlem1.p1.m3" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}=(\bm{P}_{t})_{t\in{\mathcal{V}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐏</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}=(\bm{P}_{t})_{t\in{\mathcal{V}}}</annotation></semantics></math> denote their corresponding NTP distributions. Then, the alternative distribution of the shared pivotal statistic is given by</span></p>
<table id="S4.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E13.m1" class="ltx_Math" alttext="{\mathbb{P}}_{1,\bm{P}_{{\mathcal{V}}}}(Y_{t_{1}}\leq y\,|\,Y_{t_{1}}=\cdots=Y_{t_{k}})=\frac{\sum_{w\in{{\mathcal{W}}}}S_{w}y^{1/S_{w}}}{\sum_{w\in{{\mathcal{W}}}}S_{w}}~\text{where}~S_{w}=\left(\sum_{w^{\prime}\neq w}\max_{t\in{\mathcal{V}}}\frac{P_{t,w^{\prime}}}{P_{t,w}}+1\right)^{-1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo>≤</mo><mi>y</mi></mrow><mo lspace="0.170em" rspace="0.170em">|</mo><mrow><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><msub><mi>Y</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><msub><mo>∑</mo><mrow><mi>w</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></msub><mrow><msub><mi>S</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mrow><mn>1</mn><mo>/</mo><msub><mi>S</mi><mi>w</mi></msub></mrow></msup></mrow></mrow><mrow><msub><mo>∑</mo><mrow><mi>w</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></msub><msub><mi>S</mi><mi>w</mi></msub></mrow></mfrac><mo lspace="0.330em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">where</mtext><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>S</mi><mi>w</mi></msub></mrow><mo>=</mo><msup><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><msup><mi>w</mi><mo>′</mo></msup><mo>≠</mo><mi>w</mi></mrow></munder><mrow><munder><mi>max</mi><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mfrac><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><msup><mi>w</mi><mo>′</mo></msup></mrow></msub><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><mi>w</mi></mrow></msub></mfrac></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{P}}_{1,\bm{P}_{{\mathcal{V}}}}(Y_{t_{1}}\leq y\,|\,Y_{t_{1}}=\cdots=Y_{t_{k}})=\frac{\sum_{w\in{{\mathcal{W}}}}S_{w}y^{1/S_{w}}}{\sum_{w\in{{\mathcal{W}}}}S_{w}}~\text{where}~S_{w}=\left(\sum_{w^{\prime}\neq w}\max_{t\in{\mathcal{V}}}\frac{P_{t,w^{\prime}}}{P_{t,w}}+1\right)^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">The alternative distribution of <math id="S4.p3.m1" class="ltx_Math" alttext="Y_{t_{1}}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">Y_{t_{1}}</annotation></semantics></math> is considerably more complex, as it depends on the NTP distributions of all tokens <math id="S4.p3.m2" class="ltx_Math" alttext="w_{t_{1}},\ldots,w_{t_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>w</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">w_{t_{1}},\ldots,w_{t_{k}}</annotation></semantics></math> within the minimal unit <math id="S4.p3.m3" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>. This added dependence makes the analysis far more difficult than in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>. In their case, with <math id="S4.p3.m4" class="ltx_Math" alttext="|{\mathcal{V}}|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|=1</annotation></semantics></math>, the alternative CDF <math id="S4.p3.m5" class="ltx_Math" alttext="\bm{P}\mapsto{\mathbb{P}}_{1,\bm{P}}(Y_{t_{1}}\leq y)" display="inline" intent=":literal"><semantics><mrow><mi>𝑷</mi><mo stretchy="false">↦</mo><mrow><msub><mi>ℙ</mi><mrow><mn>1</mn><mo>,</mo><mi>𝑷</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo>≤</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{P}\mapsto{\mathbb{P}}_{1,\bm{P}}(Y_{t_{1}}\leq y)</annotation></semantics></math> is convex for every <math id="S4.p3.m6" class="ltx_Math" alttext="y\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">y\in[0,1]</annotation></semantics></math>, a property central to their analysis. By contrast, in our setting the mapping <math id="S4.p3.m7" class="ltx_Math" alttext="(\bm{P}_{t_{1}},\ldots,\bm{P}_{t_{k}})\mapsto{\mathbb{P}}_{1,\bm{P}_{{\mathcal{V}}}}(Y_{t_{1}}\leq y\mid Y_{t_{1}}=\cdots=Y_{t_{k}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝑷</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝑷</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><msub><mi>ℙ</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo>≤</mo><mi>y</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><msub><mi>Y</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\bm{P}_{t_{1}},\ldots,\bm{P}_{t_{k}})\mapsto{\mathbb{P}}_{1,\bm{P}_{{\mathcal{V}}}}(Y_{t_{1}}\leq y\mid Y_{t_{1}}=\cdots=Y_{t_{k}})</annotation></semantics></math> is highly non-convex, introducing a unique challenge that requires new analytical tools. We will show how we address this difficulty in Section <a href="#S7.SS1" title="7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>.</p>
</div>
<div id="S4.p4" class="ltx_para">
<p id="S4.p4.1" class="ltx_p">To apply our framework, we evaluate the detection performance of score functions <math id="S4.p4.m1" class="ltx_Math" alttext="{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math> using the non-asymptotic <math id="S4.p4.m2" class="ltx_Math" alttext="R_{n,\mathscr{P}}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><annotation encoding="application/x-tex">R_{n,\mathscr{P}}</annotation></semantics></math>-efficiency defined in Definition <a href="#S3.Thmdefn3" title="Definition 3.3 (Non-asymptotic 𝒫-efficiency). ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>. Here, <math id="S4.p4.m3" class="ltx_Math" alttext="\mathscr{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒫</mi><annotation encoding="application/x-tex">\mathscr{P}</annotation></semantics></math> assigns to each minimal unit a (potentially different) <math id="S4.p4.m4" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>-regular class <math id="S4.p4.m5" class="ltx_Math" alttext="{\mathcal{P}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{\Delta}</annotation></semantics></math> for the prior belief, as introduced in (<a href="#S3.E11" title="In Optimality via minimax optimization. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>). To identify the optimal score functions, we focus on saddle point solutions of the minimax problem (<a href="#S3.E10" title="In Optimality via minimax optimization. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>). For a minimal unit <math id="S4.p4.m6" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>, a pair <math id="S4.p4.m7" class="ltx_Math" alttext="(h^{\star},\bm{P}_{{\mathcal{V}}}^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>⋆</mo></msup><mo>,</mo><msubsup><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h^{\star},\bm{P}_{{\mathcal{V}}}^{\star})</annotation></semantics></math> is called a saddle point solution of the minimax problem <math id="S4.p4.m8" class="ltx_Math" alttext="\min_{h}\max_{\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{\Delta}}L(h,\bm{P}_{{\mathcal{V}}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>min</mi><mi>h</mi></msub><mo lspace="0.167em">⁡</mo><mrow><msub><mi>max</mi><mrow><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi mathvariant="normal">Δ</mi></msub></mrow></msub><mo lspace="0.167em">⁡</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\min_{h}\max_{\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{\Delta}}L(h,\bm{P}_{{\mathcal{V}}})</annotation></semantics></math> if and only if <math id="S4.p4.m9" class="ltx_Math" alttext="L(h^{\star},\bm{P}_{{\mathcal{V}}})\leq L(h^{\star},\bm{P}_{{\mathcal{V}}}^{\star})\leq L(h,\bm{P}_{{\mathcal{V}}}^{\star})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>⋆</mo></msup><mo>,</mo><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>⋆</mo></msup><mo>,</mo><msubsup><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msubsup><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L(h^{\star},\bm{P}_{{\mathcal{V}}})\leq L(h^{\star},\bm{P}_{{\mathcal{V}}}^{\star})\leq L(h,\bm{P}_{{\mathcal{V}}}^{\star})</annotation></semantics></math> holds for any score <math id="S4.p4.m10" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> and <math id="S4.p4.m11" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{\Delta}</annotation></semantics></math>, where <math id="S4.p4.m12" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}^{\star}</annotation></semantics></math> is the set of least-favorable NTP distributions and <math id="S4.p4.m13" class="ltx_Math" alttext="h^{\star}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">h^{\star}</annotation></semantics></math> is the corresponding optimal score function. We adopt this notion of optimality in line with the robust hypothesis testing literature <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>, <a href="#bib.bib49" title="" class="ltx_ref">49</a>, <a href="#bib.bib12" title="" class="ltx_ref">12</a>]</cite>, where saddle point solutions often provide both interpretability and explicit analytical forms. The following theorem specifies when such saddle point solutions exist and gives their explicit forms when they do.</p>
</div>
<div id="S4.Thmthm1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm1.2" class="ltx_text ltx_font_bold">Theorem 4.1</span></span><span id="S4.Thmthm1.3" class="ltx_text ltx_font_bold"> </span>(Trichotomy of the saddle point solution)<span id="S4.Thmthm1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm1.p1" class="ltx_para">
<p id="S4.Thmthm1.p1.1" class="ltx_p"><span id="S4.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">Fix a sub-block <math id="S4.Thmthm1.p1.m1" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>. There exist constants <math id="S4.Thmthm1.p1.m2" class="ltx_Math" alttext="0&lt;\Delta_{1}^{\star}\leq\Delta_{2}^{\star}&lt;\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>≤</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo>&lt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">0&lt;\Delta_{1}^{\star}\leq\Delta_{2}^{\star}&lt;\tfrac{1}{2}</annotation></semantics></math>, depending only on <math id="S4.Thmthm1.p1.m3" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>, such that the minimax problem in (<a href="#S3.E10" title="In Optimality via minimax optimization. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) with belief class <math id="S4.Thmthm1.p1.m4" class="ltx_Math" alttext="{\mathcal{P}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{\Delta}</annotation></semantics></math> admits a saddle point solution that falls into one of the following three regimes.</span></p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Low-regularity regime <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="(\Delta\in[0,\Delta_{1}^{\star}])" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Delta\in[0,\Delta_{1}^{\star}])</annotation></semantics></math></span><span id="S4.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">
A unique saddle point solution exists. The optimal score function is the weighted-log rule:</span></p>
<table id="S4.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E14.m1" class="ltx_Math" alttext="h_{{{\mathcal{V}}}}^{\mathrm{gum}}(y)=\frac{(|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|)\,\Delta}{(|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1)(1-\Delta)}\,\log y." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gum</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>y</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h_{{{\mathcal{V}}}}^{\mathrm{gum}}(y)=\frac{(|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|)\,\Delta}{(|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1)(1-\Delta)}\,\log y.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Intermediate regime <math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="(\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star}))</annotation></semantics></math></span><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">
In this range, the minimax problem in (</span><a href="#S3.E10" title="In Optimality via minimax optimization. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">10</span></a><span id="S4.I1.i2.p1.1.3" class="ltx_text ltx_font_italic">) does not admit a saddle point solution.</span></p>
</div></li>
<li id="S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p"><span id="S4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">High-regularity regime <math id="S4.I1.i3.p1.m1" class="ltx_Math" alttext="(\Delta\in[\Delta_{2}^{\star},\tfrac{1}{2}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo>,</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Delta\in[\Delta_{2}^{\star},\tfrac{1}{2}))</annotation></semantics></math></span><span id="S4.I1.i3.p1.1.2" class="ltx_text ltx_font_italic">
A unique saddle point solution exists. The optimal score function takes the least-favorable form:</span></p>
<table id="S4.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E15.m1" class="ltx_Math" alttext="h_{{{\mathcal{V}}}}^{\mathrm{gum}}(y)=\log\left(y^{\frac{\Delta}{1-\Delta}}+y^{\frac{1-\Delta}{\Delta}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gum</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>y</mi><mfrac><mi mathvariant="normal">Δ</mi><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow></mfrac></msup><mo>+</mo><msup><mi>y</mi><mfrac><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mi mathvariant="normal">Δ</mi></mfrac></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h_{{{\mathcal{V}}}}^{\mathrm{gum}}(y)=\log\left(y^{\frac{\Delta}{1-\Delta}}+y^{\frac{1-\Delta}{\Delta}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S4.Thmrem1" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmrem1.2" class="ltx_text ltx_font_italic">Remark 4.1</span></span><span id="S4.Thmrem1.3" class="ltx_text ltx_font_italic"> </span>(Beyond saddle point solutions)<span id="S4.Thmrem1.4" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmrem1.p1" class="ltx_para">
<p id="S4.Thmrem1.p1.1" class="ltx_p">Saddle point solutions are a strong form of optimality, offering both interpretability and explicit analytical forms. If we relax this requirement and do not insist that the optimal score function be part of a saddle point pair, then a solution always exists in the intermediate regime. However, this solution is not associated with any least-favorable NTP distribution and does not admit a closed-form expression. A detailed discussion is provided in Supplementary <a href="#A2.SS8" title="B.8 Optimal Score in the Intermediate Regime ‣ Appendix B Proof for Gumbel-max Watermarks in Section ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.8</span></a>.</p>
</div>
</div>
<section id="S4.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Discussion of the trichotomy.</h5>

<div id="S4.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="S4.SS0.SSS0.Px1.p1.1" class="ltx_p">Theorem <a href="#S4.Thmthm1" title="Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> reveals a trichotomy that reflects a transition in the existence and form of saddle point solutions as the regularity level <math id="S4.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> varies. In the low- and high-regularity regimes (<math id="S4.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\Delta\notin(\Delta_{1}^{\star},\Delta_{2}^{\star})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∉</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\notin(\Delta_{1}^{\star},\Delta_{2}^{\star})</annotation></semantics></math>), a saddle point solution exists and yields closed-form optimal score functions. Specifically, the expression in (<a href="#S4.E15" title="In item 3 ‣ Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) coincides with the least-favorable solution identified in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>, Theorem 3.2]</cite>, which is designed to perform optimally against the least-favorable NTP distribution in <math id="S4.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="{\mathcal{P}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{\Delta}</annotation></semantics></math>. Meanwhile, the form in (<a href="#S4.E14" title="In item 1 ‣ Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) resembles a weighted-log score and arises in the low-regularity regime, where the alternative distribution remains close to the null. In contrast, the intermediate regime <math id="S4.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star})</annotation></semantics></math> admits no saddle point solution, as the minimax problem is not convex–concave and the stability conditions required for a solution break down. A more detailed discussion is provided later.</p>
</div>
<figure id="S4.F3" class="ltx_figure"><object type="image/svg+xml" data="2510.22007v1/Trichotomy_all.svg" id="S4.F3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/179;" width="476" height="179"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span><span id="S4.F3.4" class="ltx_text ltx_font_bold">Left</span>: Transaction thresholds <math id="S4.F3.m10" class="ltx_Math" alttext="\Delta_{1}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\Delta_{1}^{\star}</annotation></semantics></math> (in red) and <math id="S4.F3.m11" class="ltx_Math" alttext="\Delta_{2}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\Delta_{2}^{\star}</annotation></semantics></math> (in blue) as functions of <math id="S4.F3.m12" class="ltx_Math" alttext="|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|</annotation></semantics></math>. The gray region marks the intermediate regime, where no saddle point solution exists. <span id="S4.F3.5" class="ltx_text ltx_font_bold">Right</span>: Illustration of why no saddle point solution exists when <math id="S4.F3.m13" class="ltx_Math" alttext="|{\mathcal{V}}|=3\leq|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>3</mn><mo>≤</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|=3\leq|{{\mathcal{W}}}|</annotation></semantics></math>.
For <math id="S4.F3.m14" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> in the low- and high-regularity regimes, each optimal score (<math id="S4.F3.m15" class="ltx_Math" alttext="h_{{\bm{S}}_{\Delta}^{\star}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><annotation encoding="application/x-tex">h_{{\bm{S}}_{\Delta}^{\star}}</annotation></semantics></math> or <math id="S4.F3.m16" class="ltx_Math" alttext="h_{\bm{P}_{\Delta}^{\star}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><annotation encoding="application/x-tex">h_{\bm{P}_{\Delta}^{\star}}</annotation></semantics></math>) corresponds to a specific distribution vector (<math id="S4.F3.m17" class="ltx_Math" alttext="{\bm{S}}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">{\bm{S}}_{\Delta}^{\star}</annotation></semantics></math> or <math id="S4.F3.m18" class="ltx_Math" alttext="\bm{P}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\bm{P}_{\Delta}^{\star}</annotation></semantics></math>).
In the intermediate regime, no distribution aligns with either score, so no saddle point solution arises.
</figcaption>
</figure>
</section>
<section id="S4.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Effects of <math id="S4.SS0.SSS0.Px2.m1" class="ltx_Math" alttext="|{\mathcal{V}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|</annotation></semantics></math>.</h5>

<div id="S4.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="S4.SS0.SSS0.Px2.p1.1" class="ltx_p">When <math id="S4.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="|{\mathcal{V}}|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|=1</annotation></semantics></math>, no repetition occurs, and our optimal score function reduces to the rule in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite>, which is exactly the least-favorable rule in (<a href="#S4.E15" title="In item 3 ‣ Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>). When <math id="S4.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="|{\mathcal{V}}|\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|\geq 2</annotation></semantics></math>, the role of <math id="S4.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="|{\mathcal{V}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|</annotation></semantics></math> becomes more nuanced. While the least-favorable rule in (<a href="#S4.E15" title="In item 3 ‣ Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) remains unaffected by <math id="S4.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="|{\mathcal{V}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|</annotation></semantics></math>, the weighted-log rule in (<a href="#S4.E14" title="In item 1 ‣ Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) incorporates <math id="S4.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="|{\mathcal{V}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|</annotation></semantics></math> through the factor <math id="S4.SS0.SSS0.Px2.p1.m6" class="ltx_Math" alttext="|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|</annotation></semantics></math>, which weakly determines the effective regularity level assigned to each sub-block. In addition, <math id="S4.SS0.SSS0.Px2.p1.m7" class="ltx_Math" alttext="|{\mathcal{V}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|</annotation></semantics></math> influences the transition thresholds <math id="S4.SS0.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\Delta_{1}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\Delta_{1}^{\star}</annotation></semantics></math> and <math id="S4.SS0.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\Delta_{2}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\Delta_{2}^{\star}</annotation></semantics></math> that govern the trichotomy. As illustrated in the left panel of Figure <a href="#S4.F3" title="Figure 3 ‣ Discussion of the trichotomy. ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, increasing <math id="S4.SS0.SSS0.Px2.p1.m10" class="ltx_Math" alttext="|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|</annotation></semantics></math> increases both <math id="S4.SS0.SSS0.Px2.p1.m11" class="ltx_Math" alttext="\Delta_{1}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\Delta_{1}^{\star}</annotation></semantics></math> and <math id="S4.SS0.SSS0.Px2.p1.m12" class="ltx_Math" alttext="\Delta_{2}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\Delta_{2}^{\star}</annotation></semantics></math>, thereby shrinking the intermediate regime that lacks a saddle point solution. This “gray region” eventually vanishes as the informativeness of each block grows.</p>
</div>
</section>
<section id="S4.SS0.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Justification for discarding repeated pivotal statistics.</h5>

<div id="S4.SS0.SSS0.Px3.p1" class="ltx_para">
<p id="S4.SS0.SSS0.Px3.p1.1" class="ltx_p">Theorem <a href="#S4.Thmthm1" title="Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> shows that for the Gumbel-max watermark, the optimal score function for each minimal unit depends only on its unique pivotal statistic. This makes sense since all pivotal statistics within a minimal unit <math id="S4.SS0.SSS0.Px3.p1.m1" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math> take the same value, with only the size <math id="S4.SS0.SSS0.Px3.p1.m2" class="ltx_Math" alttext="|{\mathcal{V}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|</annotation></semantics></math> contributing limited additional information. A key implication is that practical heuristics <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>, <a href="#bib.bib50" title="" class="ltx_ref">50</a>, <a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite> that discard repeated pivotal statistics incur little information loss, as the optimal rule itself follows this principle. Furthermore, once repetitions are removed, the remaining pivotal statistics can be safely treated as i.i.d., which helps improve the alignment between empirical and theoretical Type I errors <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite>. Our analysis thus offers a theoretical justification for this widely used practice.</p>
</div>
</section>
<section id="S4.SS0.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Practical suggestion.</h5>

<div id="S4.SS0.SSS0.Px4.p1" class="ltx_para">
<p id="S4.SS0.SSS0.Px4.p1.1" class="ltx_p">Since no saddle point solution exists when <math id="S4.SS0.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star})</annotation></semantics></math>, one may choose any preferred score function in practice. When <math id="S4.SS0.SSS0.Px4.p1.m2" class="ltx_Math" alttext="|{\mathcal{V}}|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|=1</annotation></semantics></math>, the thresholds collapse to <math id="S4.SS0.SSS0.Px4.p1.m3" class="ltx_Math" alttext="\Delta_{1}^{\star}=\Delta_{2}^{\star}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>=</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{1}^{\star}=\Delta_{2}^{\star}=0</annotation></semantics></math>, so the least-favorable rule in (<a href="#S4.E15" title="In item 3 ‣ Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) applies directly. Empirical evidence <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>, Figure 1]</cite> suggests that many practical scenarios fall into small-<math id="S4.SS0.SSS0.Px4.p1.m4" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> regimes. Consequently, when <math id="S4.SS0.SSS0.Px4.p1.m5" class="ltx_Math" alttext="|{\mathcal{V}}|\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|\geq 2</annotation></semantics></math>, Theorem <a href="#S4.Thmthm1" title="Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> often recommends the weighted-log rule.
A practical benefit of our framework over previous one <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite> is its separation across minimal units, which allows different regularity levels to be assigned to different units. In our LLM experiments, we find that choosing <math id="S4.SS0.SSS0.Px4.p1.m6" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> carefully—for example, setting <math id="S4.SS0.SSS0.Px4.p1.m7" class="ltx_Math" alttext="\Delta=1-\max_{{w}}P_{w}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>max</mi><mi>w</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>w</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta=1-\max_{{w}}P_{w}</annotation></semantics></math>, where <math id="S4.SS0.SSS0.Px4.p1.m8" class="ltx_Math" alttext="P_{w}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>w</mi></msub><annotation encoding="application/x-tex">P_{w}</annotation></semantics></math> is the underlying NTP distribution—often improves performance. In practice, however, <math id="S4.SS0.SSS0.Px4.p1.m9" class="ltx_Math" alttext="1-\max_{{w}}P_{w}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>max</mi><mi>w</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>w</mi></msub></mrow></mrow><annotation encoding="application/x-tex">1-\max_{{w}}P_{w}</annotation></semantics></math> is typically unknown and must be estimated from related models or tasks. Such estimation can introduce inaccuracies and, in turn, reduce detection efficiency.</p>
</div>
</section>
<section id="S4.SS0.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Why the saddle point solution does not exist.</h5>

<div id="S4.SS0.SSS0.Px5.p1" class="ltx_para">
<p id="S4.SS0.SSS0.Px5.p1.1" class="ltx_p">We now briefly explain why no saddle point solution exists in the intermediate regime. To formalize this, we reparameterize the minimax problem in (<a href="#S3.E10" title="In Optimality via minimax optimization. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) as <math id="S4.SS0.SSS0.Px5.p1.m1" class="ltx_Math" alttext="\min_{h}\sup_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}L(h,{\bm{S}})" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mrow><mmultiscripts><mo>sup</mo><mrow><mi>𝑺</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow><mrow></mrow><mprescripts></mprescripts><mi>h</mi><mrow></mrow></mmultiscripts><mo lspace="0.167em">⁡</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>𝑺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\min_{h}\sup_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}L(h,{\bm{S}})</annotation></semantics></math>, where <math id="S4.SS0.SSS0.Px5.p1.m2" class="ltx_Math" alttext="{\bm{S}}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">{\bm{S}}</annotation></semantics></math> denotes the reparameterized distribution vector and <math id="S4.SS0.SSS0.Px5.p1.m3" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}</annotation></semantics></math> its domain. If a saddle point solution existed, there would be a pair <math id="S4.SS0.SSS0.Px5.p1.m4" class="ltx_Math" alttext="(h^{\star},{\bm{S}}^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi>𝑺</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h^{\star},{\bm{S}}^{\star})</annotation></semantics></math> such that <math id="S4.SS0.SSS0.Px5.p1.m5" class="ltx_Math" alttext="L(h^{\star},{\bm{S}})\leq L(h^{\star},{\bm{S}}^{\star})\leq L(h,{\bm{S}}^{\star})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>⋆</mo></msup><mo>,</mo><mi>𝑺</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi>𝑺</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msup><mi>𝑺</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L(h^{\star},{\bm{S}})\leq L(h^{\star},{\bm{S}}^{\star})\leq L(h,{\bm{S}}^{\star})</annotation></semantics></math> holds for all <math id="S4.SS0.SSS0.Px5.p1.m6" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> and <math id="S4.SS0.SSS0.Px5.p1.m7" class="ltx_Math" alttext="{\bm{S}}\in{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><mi>𝑺</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{S}}\in{\mathcal{D}}_{\Delta}</annotation></semantics></math>, where <math id="S4.SS0.SSS0.Px5.p1.m8" class="ltx_Math" alttext="{\bm{S}}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝑺</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">{\bm{S}}^{\star}</annotation></semantics></math> is the least-favorable distribution vector and <math id="S4.SS0.SSS0.Px5.p1.m9" class="ltx_Math" alttext="h^{\star}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">h^{\star}</annotation></semantics></math> the corresponding optimal score function. Our analysis in Section <a href="#S7.SS1" title="7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> establishes two key facts. First, <math id="S4.SS0.SSS0.Px5.p1.m10" class="ltx_Math" alttext="h^{\star}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">h^{\star}</annotation></semantics></math> must be the log-likelihood ratio score associated with <math id="S4.SS0.SSS0.Px5.p1.m11" class="ltx_Math" alttext="{\bm{S}}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝑺</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">{\bm{S}}^{\star}</annotation></semantics></math>. Second, <math id="S4.SS0.SSS0.Px5.p1.m12" class="ltx_Math" alttext="{\bm{S}}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝑺</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">{\bm{S}}^{\star}</annotation></semantics></math> must be either <math id="S4.SS0.SSS0.Px5.p1.m13" class="ltx_Math" alttext="{\bm{S}}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">{\bm{S}}_{\Delta}^{\star}</annotation></semantics></math> or <math id="S4.SS0.SSS0.Px5.p1.m14" class="ltx_Math" alttext="\bm{P}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\bm{P}_{\Delta}^{\star}</annotation></semantics></math> (see Lemma <a href="#S7.Thmlem5" title="Lemma 7.5 (Convex envelope of 𝒟_Δ∩ℋ_Δ). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a> for their closed forms). However, when <math id="S4.SS0.SSS0.Px5.p1.m15" class="ltx_Math" alttext="\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star})</annotation></semantics></math>, <math id="S4.SS0.SSS0.Px5.p1.m16" class="ltx_Math" alttext="{\bm{S}}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">{\bm{S}}_{\Delta}^{\star}</annotation></semantics></math> fails to maximize the loss for its own log-likelihood ratio score, while <math id="S4.SS0.SSS0.Px5.p1.m17" class="ltx_Math" alttext="\bm{P}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\bm{P}_{\Delta}^{\star}</annotation></semantics></math> fails for the same reason, so neither candidate consistently dominates the other. As a result, no saddle point solution exists in this regime. See the right panel of Figure <a href="#S4.F3" title="Figure 3 ‣ Discussion of the trichotomy. ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> for an illustration and Section <a href="#S7.SS1" title="7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> for a proof sketch.</p>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Application to the Inverse Transform Watermark</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">In this section, we apply the framework to the
inverse transform watermark <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">24</a>]</cite>.
Recall that its decoder is defined as</p>
<table id="S5.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex4.m1" class="ltx_Math" alttext="{w}_{t}={\mathcal{S}}^{\mathrm{inv}}(\bm{P}_{t},\zeta_{t}):=\pi_{t}^{-1}(F^{-1}(U_{t};\pi_{t}))," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>inv</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑷</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msubsup><mi>π</mi><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>t</mi></msub><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{w}_{t}={\mathcal{S}}^{\mathrm{inv}}(\bm{P}_{t},\zeta_{t}):=\pi_{t}^{-1}(F^{-1}(U_{t};\pi_{t})),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p1.2" class="ltx_p">where the pseudorandom number <math id="S5.p1.m1" class="ltx_Math" alttext="\zeta_{t}=(\pi_{t},U_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>U</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta_{t}=(\pi_{t},U_{t})</annotation></semantics></math> with <math id="S5.p1.m2" class="ltx_Math" alttext="U_{t}\sim U(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>t</mi></msub><mo>∼</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U_{t}\sim U(0,1)</annotation></semantics></math> and <math id="S5.p1.m3" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> being sampled uniformly at random from all permutations on <math id="S5.p1.m4" class="ltx_Math" alttext="{{\mathcal{W}}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">{{\mathcal{W}}}</annotation></semantics></math>. Its pivotal statistic is defined as</p>
<table id="S5.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex5.m1" class="ltx_Math" alttext="Y^{\mathrm{inv}}_{t}=|U_{t}-\eta(\pi_{t}({w}_{t}))|,\quad\text{where}\quad\eta(w):=\frac{w-1}{|{{\mathcal{W}}}|-1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Y</mi><mi>t</mi><mi>inv</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>U</mi><mi>t</mi></msub><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo rspace="1.167em">,</mo><mtext>where</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mfrac><mrow><mi>w</mi><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Y^{\mathrm{inv}}_{t}=|U_{t}-\eta(\pi_{t}({w}_{t}))|,\quad\text{where}\quad\eta(w):=\frac{w-1}{|{{\mathcal{W}}}|-1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p1.3" class="ltx_p">maps a discrete token index to the interval <math id="S5.p1.m5" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> to enable direct comparison with <math id="S5.p1.m6" class="ltx_Math" alttext="U_{t}\sim U(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>t</mi></msub><mo>∼</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U_{t}\sim U(0,1)</annotation></semantics></math>.</p>
</div>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p">The problem is inherently intricate, shown in prior work <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>, because the combinatorial structure introduced by the permutation <math id="S5.p2.m1" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> significantly complicates the analysis. In our setting, this challenge is further intensified by the fact that we only have block-level independence rather than the stronger sub-block independence.
Indeed, under the pivotal function rule <math id="S5.p2.m2" class="ltx_Math" alttext="Y^{\mathrm{inv}}(w,\zeta)=|U-\eta(\pi({w}))|" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>Y</mi><mi>inv</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mi>U</mi><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">Y^{\mathrm{inv}}(w,\zeta)=|U-\eta(\pi({w}))|</annotation></semantics></math>, if <math id="S5.p2.m3" class="ltx_Math" alttext="\zeta=(U,\pi)" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta=(U,\pi)</annotation></semantics></math> is shared within a block, then the pivotal statistics computed across different tokens <math id="S5.p2.m4" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> in the block remain dependent. This violates the sub-block independence in Assumption <a href="#S3.Thmasmp2" title="Assumption 3.2 (Independence across sub-blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>.
As a result, the minimal units are entire blocks for the inverse transform watermark, not sub-blocks as in the Gumbel-max watermark. These introduce two layers of complexity: the same combinatorial challenges from <math id="S5.p2.m5" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math>, and the potentially arbitrary dependence within each block. Together, these make the analysis substantially more challenging than in the Gumbel-max case.</p>
</div>
<div id="S5.p3" class="ltx_para">
<p id="S5.p3.1" class="ltx_p">To address these challenges, we slightly modify the efficiency measure by adopting an asymptotic perspective in which the vocabulary size tends to infinity. This adjustment leads to a significantly simpler characterization of both the null and alternative distributions, as shown in Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1 (Asymptotic joint distribution of pivotal statistics). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>. It also enables us to manage within-block dependence more effectively: in the asymptotic regime, the joint distribution of pivotal statistics within a block is governed by a set of independent latent variables. As a result, the within-block dependence structure becomes much more tractable, allowing for a straightforward derivation of the optimal score function. See Theorem <a href="#S5.Thmtheorem2" title="Theorem 5.2. ‣ 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> for details.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1 </span>Asymptotic Distributions</h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">In the following, we focus our analysis on a minimal unit (or a block) <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="{\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math> for some index <math id="S5.SS1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, which consists of <math id="S5.SS1.p1.m3" class="ltx_Math" alttext="m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">m_{k}</annotation></semantics></math> sub-blocks denoted by <math id="S5.SS1.p1.m4" class="ltx_Math" alttext="\{{\mathcal{I}}_{k,\ell}^{Y}\}_{\ell=1}^{m_{k}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>Y</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>m</mi><mi>k</mi></msub></msubsup><annotation encoding="application/x-tex">\{{\mathcal{I}}_{k,\ell}^{Y}\}_{\ell=1}^{m_{k}}</annotation></semantics></math>. By definition, we have <math id="S5.SS1.p1.m5" class="ltx_Math" alttext="{\mathcal{I}}_{k}^{\zeta}=\bigcup_{\ell=1}^{m_{k}}{\mathcal{I}}_{k,\ell}^{Y}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>⋃</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>m</mi><mi>k</mi></msub></msubsup><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>Y</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{I}}_{k}^{\zeta}=\bigcup_{\ell=1}^{m_{k}}{\mathcal{I}}_{k,\ell}^{Y}.</annotation></semantics></math></p>
</div>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.1" class="ltx_p">Our results are asymptotic in nature and follow the convention in prior work <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>, which studies an asymptotic efficiency by letting the vocabulary size <math id="S5.SS1.p2.m1" class="ltx_Math" alttext="|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|</annotation></semantics></math> tend to infinity. To enable this analysis, we introduce a comparable set of regularity conditions on the NTP distributions.</p>
</div>
<div id="S5.Thmasmp1" class="ltx_theorem ltx_theorem_asmp">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmasmp1.2" class="ltx_text ltx_font_bold">Assumption 5.1</span></span><span id="S5.Thmasmp1.3" class="ltx_text ltx_font_bold"> </span>(Asymptotic NTP conditions)<span id="S5.Thmasmp1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmasmp1.p1" class="ltx_para">
<p id="S5.Thmasmp1.p1.1" class="ltx_p"><span id="S5.Thmasmp1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmasmp1.p1.m1" class="ltx_Math" alttext="P_{t,(i)}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">P_{t,(i)}</annotation></semantics></math> denote the <math id="S5.Thmasmp1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th largest probability in the NTP distribution <math id="S5.Thmasmp1.p1.m3" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐏</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math>. We assume that</span></p>
<ul id="S5.I1" class="ltx_itemize">
<li id="S5.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S5.I1.ix1.p1" class="ltx_para">
<p id="S5.I1.ix1.p1.1" class="ltx_p"><span id="S5.I1.ix1.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Regular NTP distributions</span><span id="S5.I1.ix1.p1.1.2" class="ltx_text ltx_font_italic"> There exists a universal constant </span><math id="S5.I1.ix1.p1.m1" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math><span id="S5.I1.ix1.p1.1.3" class="ltx_text ltx_font_italic"> and a sequence </span><math id="S5.I1.ix1.p1.m2" class="ltx_Math" alttext="\{\Delta_{t}\}_{t\geq 1}\subseteq(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>≥</mo><mn>1</mn></mrow></msub><mo>⊆</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\{\Delta_{t}\}_{t\geq 1}\subseteq(0,1)</annotation></semantics></math><span id="S5.I1.ix1.p1.1.4" class="ltx_text ltx_font_italic"> such that for all </span><math id="S5.I1.ix1.p1.m3" class="ltx_Math" alttext="t\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\geq 1</annotation></semantics></math><span id="S5.I1.ix1.p1.1.5" class="ltx_text ltx_font_italic">,</span></p>
<table id="S5.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E16.m1" class="ltx_math_unparsed" alttext="\bm{P}_{t}\in\overline{{\mathcal{P}}}_{\Delta_{t}},\quad\text{where}\quad{\overline{{\mathcal{P}}}_{\Delta}}:=\left\{\bm{P}:\delta\leq P_{(1)}\leq 1-\Delta,\quad P_{(2)}\leq{\varepsilon}_{|{{\mathcal{W}}}|}\right\}," display="block" intent=":literal"><semantics><mrow><msub><mi>𝑷</mi><mi>t</mi></msub><mo>∈</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></msub><mo rspace="1.167em">,</mo><mtext class="ltx_mathvariant_italic">where</mtext><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><mi mathvariant="normal">Δ</mi></msub><mo>:=</mo><mrow><mo>{</mo><mi>𝑷</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>δ</mi><mo>≤</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo>≤</mo><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi><mo rspace="1.167em">,</mo><msub><mi>P</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msub><mo>≤</mo><msub><mi>ε</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></msub><mo>}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{P}_{t}\in\overline{{\mathcal{P}}}_{\Delta_{t}},\quad\text{where}\quad{\overline{{\mathcal{P}}}_{\Delta}}:=\left\{\bm{P}:\delta\leq P_{(1)}\leq 1-\Delta,\quad P_{(2)}\leq{\varepsilon}_{|{{\mathcal{W}}}|}\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="S5.I1.ix1.p1.2" class="ltx_p"><span id="S5.I1.ix1.p1.2.1" class="ltx_text ltx_font_italic">and </span><math id="S5.I1.ix1.p1.m4" class="ltx_Math" alttext="{\varepsilon}_{|{{\mathcal{W}}}|}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></msub><annotation encoding="application/x-tex">{\varepsilon}_{|{{\mathcal{W}}}|}</annotation></semantics></math><span id="S5.I1.ix1.p1.2.2" class="ltx_text ltx_font_italic"> satisfies </span><math id="S5.I1.ix1.p1.m5" class="ltx_Math" alttext="\log|{{\mathcal{W}}}|\cdot{\varepsilon}_{|{{\mathcal{W}}}|}\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>ε</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></msub></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\log|{{\mathcal{W}}}|\cdot{\varepsilon}_{|{{\mathcal{W}}}|}\to 0</annotation></semantics></math><span id="S5.I1.ix1.p1.2.3" class="ltx_text ltx_font_italic"> as </span><math id="S5.I1.ix1.p1.m6" class="ltx_Math" alttext="|{{\mathcal{W}}}|\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|\to\infty</annotation></semantics></math><span id="S5.I1.ix1.p1.2.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S5.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S5.I1.ix2.p1" class="ltx_para">
<p id="S5.I1.ix2.p1.1" class="ltx_p"><span id="S5.I1.ix2.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Heavy repeated tokens</span><span id="S5.I1.ix2.p1.1.2" class="ltx_text ltx_font_italic"> All tokens in non-singleton minimal units are </span><em id="S5.I1.ix2.p1.1.3" class="ltx_emph">heavy</em><span id="S5.I1.ix2.p1.1.4" class="ltx_text ltx_font_italic">, meaning that each token has the largest probability in its corresponding NTP distribution. That is, for any </span><math id="S5.I1.ix2.p1.m1" class="ltx_Math" alttext="t\in{\mathcal{I}}_{\ell}^{Y}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi mathvariant="normal">ℓ</mi><mi>Y</mi></msubsup></mrow><annotation encoding="application/x-tex">t\in{\mathcal{I}}_{\ell}^{Y}</annotation></semantics></math><span id="S5.I1.ix2.p1.1.5" class="ltx_text ltx_font_italic"> (for some </span><math id="S5.I1.ix2.p1.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math><span id="S5.I1.ix2.p1.1.6" class="ltx_text ltx_font_italic">) and </span><math id="S5.I1.ix2.p1.m3" class="ltx_Math" alttext="m_{k}&gt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{k}&gt;1</annotation></semantics></math><span id="S5.I1.ix2.p1.1.7" class="ltx_text ltx_font_italic">, we have </span><math id="S5.I1.ix2.p1.m4" class="ltx_Math" alttext="P_{t,w_{\ell}}=P_{t,(1)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><msub><mi>w</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></msub><mo>=</mo><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">P_{t,w_{\ell}}=P_{t,(1)}</annotation></semantics></math><span id="S5.I1.ix2.p1.1.8" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ul>
</div>
</div>
<div id="S5.SS1.p3" class="ltx_para">
<p id="S5.SS1.p3.1" class="ltx_p">We briefly elaborate on Assumption <a href="#S5.Thmasmp1" title="Assumption 5.1 (Asymptotic NTP conditions). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>.
Condition (i) extends the <math id="S5.SS1.p3.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>-regular class defined in (<a href="#S3.E11" title="In Optimality via minimax optimization. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>), and a similar condition is adopted by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>, Equation (24)]</cite>. As <math id="S5.SS1.p3.m2" class="ltx_Math" alttext="|{{\mathcal{W}}}|\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|\to\infty</annotation></semantics></math>, the second-largest probabilities <math id="S5.SS1.p3.m3" class="ltx_Math" alttext="P_{t,(2)}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">P_{t,(2)}</annotation></semantics></math> vanish uniformly, implying that each <math id="S5.SS1.p3.m4" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math> becomes asymptotically concentrated on a single token. This assumption simplifies the theoretical analysis while remaining realistic; <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>, Figure 1]</cite> finds that practical NTP distributions are typically dominated by a single token.</p>
</div>
<div id="S5.SS1.p4" class="ltx_para">
<p id="S5.SS1.p4.1" class="ltx_p">Condition (ii) follows naturally from (i). Since <math id="S5.SS1.p4.m1" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math> asymptotically assigns non-negligible probability to a single token, that token is almost surely the one generated by the LLM, and thus must be the so-called heavy token. Importantly, this condition also aids the dependence analysis within a block: because the verifier lacks access to the NTP distributions during detection, and the same tokens in the same sub-block may come from distinct NTP distributions, assuming a heavy token allows us to use a single index <math id="S5.SS1.p4.m2" class="ltx_Math" alttext="\Delta_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Delta_{t}</annotation></semantics></math> to represent <math id="S5.SS1.p4.m3" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math> in the asymptotic regime. This strategy—also employed by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>—substantially simplifies the analysis while preserving essential asymptotic behavior.</p>
</div>
<div id="S5.SS1.p5" class="ltx_para">
<p id="S5.SS1.p5.1" class="ltx_p">Since tokens are identical within each sub-block and distinct across different sub-blocks, we let <math id="S5.SS1.p5.m1" class="ltx_Math" alttext="w_{1},\ldots,w_{m_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>w</mi><msub><mi>m</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">w_{1},\ldots,w_{m_{k}}</annotation></semantics></math> denote the unique tokens corresponding to each sub-block.
With Assumption <a href="#S5.Thmasmp1" title="Assumption 5.1 (Asymptotic NTP conditions). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> in place, the following lemma establishes the asymptotic joint distribution of <math id="S5.SS1.p5.m2" class="ltx_Math" alttext="(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))</annotation></semantics></math> under both <math id="S5.SS1.p5.m3" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> and <math id="S5.SS1.p5.m4" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmlem1" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmlem1.2" class="ltx_text ltx_font_bold">Lemma 5.1</span></span><span id="S5.Thmlem1.3" class="ltx_text ltx_font_bold"> </span>(Asymptotic joint distribution of pseudorandomness and tokens)<span id="S5.Thmlem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmlem1.p1" class="ltx_para">
<p id="S5.Thmlem1.p1.1" class="ltx_p"><span id="S5.Thmlem1.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S3.Thmasmp1" title="Assumption 3.1 (Independence across blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> and <a href="#S5.Thmasmp1" title="Assumption 5.1 (Asymptotic NTP conditions). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> hold. Fix a minimal unit <math id="S5.Thmlem1.p1.m1" class="ltx_Math" alttext="{\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math> from the partition <math id="S5.Thmlem1.p1.m2" class="ltx_Math" alttext="\Pi_{\zeta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>ζ</mi></msub><annotation encoding="application/x-tex">\Pi_{\zeta}</annotation></semantics></math> (Definition <a href="#S3.Thmdefn1" title="Definition 3.1 (𝜁-level partition). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>) with <math id="S5.Thmlem1.p1.m3" class="ltx_Math" alttext="m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">m_{k}</annotation></semantics></math> sub-blocks <math id="S5.Thmlem1.p1.m4" class="ltx_Math" alttext="\{{\mathcal{I}}^{Y}_{k,\ell}\}_{\ell=1}^{m_{k}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>Y</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>m</mi><mi>k</mi></msub></msubsup><annotation encoding="application/x-tex">\{{\mathcal{I}}^{Y}_{k,\ell}\}_{\ell=1}^{m_{k}}</annotation></semantics></math>. Define the block-wise regularity vector as</span></p>
<table id="S5.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E17.m1" class="ltx_Math" alttext="\bm{{\bar{\Delta}}}_{k}:=({\bar{\Delta}}_{k,1},\ldots,{\bar{\Delta}}_{k,m_{k}}),\quad\text{where}\quad{\bar{\Delta}}_{k,\ell}:=\max_{t\in{\mathcal{I}}^{Y}_{k,\ell}}\Delta_{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>:=</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mtext class="ltx_mathvariant_italic">where</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo>:=</mo><mrow><munder><mi>max</mi><mrow><mi>t</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>Y</mi></msubsup></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{{\bar{\Delta}}}_{k}:=({\bar{\Delta}}_{k,1},\ldots,{\bar{\Delta}}_{k,m_{k}}),\quad\text{where}\quad{\bar{\Delta}}_{k,\ell}:=\max_{t\in{\mathcal{I}}^{Y}_{k,\ell}}\Delta_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="S5.Thmlem1.p1.2" class="ltx_p"><span id="S5.Thmlem1.p1.2.1" class="ltx_text ltx_font_italic">As <math id="S5.Thmlem1.p1.m5" class="ltx_Math" alttext="|{{\mathcal{W}}}|\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|\to\infty</annotation></semantics></math>, the joint distribution of <math id="S5.Thmlem1.p1.m6" class="ltx_Math" alttext="(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))</annotation></semantics></math> converges weakly as follows.</span></p>
<ul id="S5.I2" class="ltx_itemize">
<li id="S5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i1.p1" class="ltx_para">
<p id="S5.I2.i1.p1.1" class="ltx_p"><span id="S5.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">Under </span><math id="S5.I2.i1.p1.m1" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math><span id="S5.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="S5.I2.i1.p1.m2" class="ltx_Math" alttext="(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))\xrightarrow{d}(U,X_{1},\ldots,X_{m_{k}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑑</mo></mover><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))\xrightarrow{d}(U,X_{1},\ldots,X_{m_{k}})</annotation></semantics></math><span id="S5.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">, where </span><math id="S5.I2.i1.p1.m3" class="ltx_Math" alttext="U,X_{1},\ldots,X_{m_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>,</mo><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><msub><mi>m</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">U,X_{1},\ldots,X_{m_{k}}</annotation></semantics></math><span id="S5.I2.i1.p1.1.4" class="ltx_text ltx_font_italic"> are i.i.d. </span><math id="S5.I2.i1.p1.m4" class="ltx_Math" alttext="\mathrm{Unif}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Unif}(0,1)</annotation></semantics></math><span id="S5.I2.i1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i2.p1" class="ltx_para">
<p id="S5.I2.i2.p1.1" class="ltx_p"><span id="S5.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">Under </span><math id="S5.I2.i2.p1.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math><span id="S5.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">, if </span><math id="S5.I2.i2.p1.m2" class="ltx_Math" alttext="P_{t,(1)}=1-\Delta_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">P_{t,(1)}=1-\Delta_{t}</annotation></semantics></math><span id="S5.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> for all </span><math id="S5.I2.i2.p1.m3" class="ltx_Math" alttext="t\in{\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup></mrow><annotation encoding="application/x-tex">t\in{\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math><span id="S5.I2.i2.p1.1.4" class="ltx_text ltx_font_italic">, </span><math id="S5.I2.i2.p1.m4" class="ltx_Math" alttext="(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))\xrightarrow{d}(U,X_{1},\ldots,X_{m_{k}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑑</mo></mover><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))\xrightarrow{d}(U,X_{1},\ldots,X_{m_{k}})</annotation></semantics></math><span id="S5.I2.i2.p1.1.5" class="ltx_text ltx_font_italic">, where </span><math id="S5.I2.i2.p1.m5" class="ltx_Math" alttext="X_{1},\ldots,X_{m_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><msub><mi>m</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">X_{1},\ldots,X_{m_{k}}</annotation></semantics></math><span id="S5.I2.i2.p1.1.6" class="ltx_text ltx_font_italic"> are i.i.d. </span><math id="S5.I2.i2.p1.m6" class="ltx_Math" alttext="\mathrm{Unif}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Unif}(0,1)</annotation></semantics></math><span id="S5.I2.i2.p1.1.7" class="ltx_text ltx_font_italic">, and </span><math id="S5.I2.i2.p1.m7" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="S5.I2.i2.p1.1.8" class="ltx_text ltx_font_italic"> is independent and uniformly distributed on</span></p>
<table id="S5.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E18.m1" class="ltx_math_unparsed" alttext="\left[\max_{\ell\in[m_{k}]}{\bar{\Delta}}_{k,\ell}X_{\ell},\quad\min_{\ell\in[m_{k}]}(1-{\bar{\Delta}}_{k,\ell}+{\bar{\Delta}}_{k,\ell}X_{\ell})\right]," display="block" intent=":literal"><semantics><mrow><mrow><mo>[</mo><munder><mi>max</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow></munder><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mi>X</mi><mi mathvariant="normal">ℓ</mi></msub><mo rspace="1.167em">,</mo><munder><mi>min</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo>+</mo><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mi>X</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left[\max_{\ell\in[m_{k}]}{\bar{\Delta}}_{k,\ell}X_{\ell},\quad\min_{\ell\in[m_{k}]}(1-{\bar{\Delta}}_{k,\ell}+{\bar{\Delta}}_{k,\ell}X_{\ell})\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="S5.I2.i2.p1.2" class="ltx_p"><span id="S5.I2.i2.p1.2.1" class="ltx_text ltx_font_italic">conditioned on this interval being non-empty.</span></p>
</div></li>
</ul>
</div>
</div>
<div id="S5.SS1.p6" class="ltx_para">
<p id="S5.SS1.p6.1" class="ltx_p">Surprisingly, the asymptotic distributions of <math id="S5.SS1.p6.m1" class="ltx_Math" alttext="(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(U,\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))</annotation></semantics></math> take simple forms under both <math id="S5.SS1.p6.m2" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> and <math id="S5.SS1.p6.m3" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>. Under <math id="S5.SS1.p6.m4" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>, the pseudorandom variable <math id="S5.SS1.p6.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> is independent of the normalized token vector <math id="S5.SS1.p6.m6" class="ltx_Math" alttext="(\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\eta(\pi(w_{1})),\ldots,\eta(\pi(w_{m_{k}})))</annotation></semantics></math>, whose entries are all i.i.d. <math id="S5.SS1.p6.m7" class="ltx_Math" alttext="\mathrm{Unif}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Unif}(0,1)</annotation></semantics></math>. In contrast, under <math id="S5.SS1.p6.m8" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>, the pseudorandom value <math id="S5.SS1.p6.m9" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> becomes dependent on the token vector due to the block structure specified by <math id="S5.SS1.p6.m10" class="ltx_Math" alttext="{\mathcal{I}}_{k}^{\zeta}=\{{\mathcal{I}}_{k,\ell}^{Y}\}_{\ell=1}^{m_{k}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>Y</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>m</mi><mi>k</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{I}}_{k}^{\zeta}=\{{\mathcal{I}}_{k,\ell}^{Y}\}_{\ell=1}^{m_{k}}</annotation></semantics></math>. Specifically, <math id="S5.SS1.p6.m11" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> is independently drawn from the interval in (<a href="#S5.E18" title="In 2nd item ‣ Lemma 5.1 (Asymptotic joint distribution of pseudorandomness and tokens). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>), which itself depends on the token vector, provided the interval is non-empty. This conditional dependence reflects the watermark signal embedded in the generation process.</p>
</div>
<div id="S5.SS1.p7" class="ltx_para">
<p id="S5.SS1.p7.1" class="ltx_p">Recall that for each sub-block <math id="S5.SS1.p7.m1" class="ltx_Math" alttext="{\mathcal{I}}_{k,\ell}^{Y}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>Y</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{k,\ell}^{Y}</annotation></semantics></math>, the corresponding pivotal statistic is defined as <math id="S5.SS1.p7.m2" class="ltx_Math" alttext="Y_{k,\ell}:=|U-\eta(\pi(w_{\ell}))|" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo>:=</mo><mrow><mo stretchy="false">|</mo><mrow><mi>U</mi><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{k,\ell}:=|U-\eta(\pi(w_{\ell}))|</annotation></semantics></math> for <math id="S5.SS1.p7.m3" class="ltx_Math" alttext="\ell=1,\ldots,m_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\ell=1,\ldots,m_{k}</annotation></semantics></math>. By applying a careful change-of-variable argument, we can then characterize the asymptotic joint distribution of the vector <math id="S5.SS1.p7.m4" class="ltx_Math" alttext="\bm{Y}_{k}=(Y_{k,1},\ldots,Y_{k,m_{k}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒀</mi><mi>k</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{Y}_{k}=(Y_{k,1},\ldots,Y_{k,m_{k}})</annotation></semantics></math> under both hypotheses, as stated in the following theorem.</p>
</div>
<div id="S5.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 5.1</span></span><span id="S5.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Asymptotic joint distribution of pivotal statistics)<span id="S5.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem1.p1" class="ltx_para">
<p id="S5.Thmtheorem1.p1.1" class="ltx_p"><span id="S5.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Under the same notions and assumptions of Lemma <a href="#S5.Thmlem1" title="Lemma 5.1 (Asymptotic joint distribution of pseudorandomness and tokens). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, let <math id="S5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\bm{Y}_{k}=(Y_{k,1},\ldots,Y_{k,m_{k}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐘</mi><mi>k</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{Y}_{k}=(Y_{k,1},\ldots,Y_{k,m_{k}})</annotation></semantics></math> denote the vector of unique pivotal statistics within the block <math id="S5.Thmtheorem1.p1.m2" class="ltx_Math" alttext="{\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math>, where <math id="S5.Thmtheorem1.p1.m3" class="ltx_Math" alttext="Y_{k,\ell}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><annotation encoding="application/x-tex">Y_{k,\ell}</annotation></semantics></math> represents the pivotal statistic within the sub-block <math id="S5.Thmtheorem1.p1.m4" class="ltx_Math" alttext="{\mathcal{I}}^{Y}_{k,\ell}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>Y</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}^{Y}_{k,\ell}</annotation></semantics></math>.
Then, as <math id="S5.Thmtheorem1.p1.m5" class="ltx_Math" alttext="|{{\mathcal{W}}}|\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|\to\infty</annotation></semantics></math>, the joint PDF of <math id="S5.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\bm{Y}_{k}" display="inline" intent=":literal"><semantics><msub><mi>𝐘</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{k}</annotation></semantics></math> converges as follows.</span></p>
<ul id="S5.I3" class="ltx_itemize">
<li id="S5.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I3.i1.p1" class="ltx_para">
<p id="S5.I3.i1.p1.1" class="ltx_p"><span id="S5.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">Under </span><math id="S5.I3.i1.p1.m1" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math><span id="S5.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">, the limiting null PDF is</span></p>
<table id="S5.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E19.m1" class="ltx_Math" alttext="\displaystyle f_{0}(\bm{y})=\int_{0}^{1}2^{|I_{1}(u)|}{\bf 1}_{I_{2}(u)=\emptyset}\,{\mathrm{d}}u," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><msup><mn>2</mn><mrow><mo stretchy="false">|</mo><mrow><msub><mi>I</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mrow><msub><mi>I</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle f_{0}(\bm{y})=\int_{0}^{1}2^{|I_{1}(u)|}{\bf 1}_{I_{2}(u)=\emptyset}\,{\mathrm{d}}u,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="S5.I3.i1.p1.2" class="ltx_p"><span id="S5.I3.i1.p1.2.1" class="ltx_text ltx_font_italic">where for a fixed vector </span><math id="S5.I3.i1.p1.m2" class="ltx_Math" alttext="\bm{y}=(y_{1},\ldots,y_{m_{k}})" display="inline" intent=":literal"><semantics><mrow><mi>𝒚</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>y</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{y}=(y_{1},\ldots,y_{m_{k}})</annotation></semantics></math><span id="S5.I3.i1.p1.2.2" class="ltx_text ltx_font_italic"> and </span><math id="S5.I3.i1.p1.m3" class="ltx_Math" alttext="u\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">u\in[0,1]</annotation></semantics></math><span id="S5.I3.i1.p1.2.3" class="ltx_text ltx_font_italic">,</span></p>
<table id="S5.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex6.m1" class="ltx_Math" alttext="\displaystyle I_{1}(u):=\left\{\ell\in[m_{k}]:0&lt;y_{\ell}&lt;\min(u,1-u)\right\},\quad I_{2}(u):=\left\{\ell\in[m_{k}]:y_{\ell}\geq\max(u,1-u)\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>I</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>{</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>m</mi><mi>k</mi></msub><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>y</mi><mi mathvariant="normal">ℓ</mi></msub><mo>&lt;</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>I</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>{</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>m</mi><mi>k</mi></msub><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mi>y</mi><mi mathvariant="normal">ℓ</mi></msub><mo>≥</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle I_{1}(u):=\left\{\ell\in[m_{k}]:0&lt;y_{\ell}&lt;\min(u,1-u)\right\},\quad I_{2}(u):=\left\{\ell\in[m_{k}]:y_{\ell}\geq\max(u,1-u)\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I3.i2.p1" class="ltx_para">
<p id="S5.I3.i2.p1.1" class="ltx_p"><span id="S5.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">Under </span><math id="S5.I3.i2.p1.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math><span id="S5.I3.i2.p1.1.2" class="ltx_text ltx_font_italic">, the limiting alternative PDF is</span></p>
<table id="S5.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E20.m1" class="ltx_Math" alttext="\displaystyle f_{\bm{{\bar{\Delta}}}_{k}}(\bm{y})=\frac{1}{I_{m_{k}}(\bm{{\bar{\Delta}}}_{k})}\sum_{\bm{\sigma}\in\{-1,1\}^{m_{k}}}\left(B_{\bm{\sigma}}^{\bm{{\bar{\Delta}}}_{k}}(\bm{y})-A_{\bm{\sigma}}^{\bm{{\bar{\Delta}}}_{k}}(\bm{y})\right)_{+}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>I</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝝈</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><msub><mi>m</mi><mi>k</mi></msub></msup></mrow></munder></mstyle><msub><mrow><mo>(</mo><mrow><mrow><msubsup><mi>B</mi><mi>𝝈</mi><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>A</mi><mi>𝝈</mi><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>+</mo></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle f_{\bm{{\bar{\Delta}}}_{k}}(\bm{y})=\frac{1}{I_{m_{k}}(\bm{{\bar{\Delta}}}_{k})}\sum_{\bm{\sigma}\in\{-1,1\}^{m_{k}}}\left(B_{\bm{\sigma}}^{\bm{{\bar{\Delta}}}_{k}}(\bm{y})-A_{\bm{\sigma}}^{\bm{{\bar{\Delta}}}_{k}}(\bm{y})\right)_{+},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="S5.I3.i2.p1.2" class="ltx_p"><span id="S5.I3.i2.p1.2.1" class="ltx_text ltx_font_italic">where for each sign vector </span><math id="S5.I3.i2.p1.m2" class="ltx_Math" alttext="\bm{\sigma}=(\sigma_{1},\ldots,\sigma_{m_{k}})\in\{-1,1\}^{m_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>𝝈</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>σ</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><msub><mi>m</mi><mi>k</mi></msub></msup></mrow><annotation encoding="application/x-tex">\bm{\sigma}=(\sigma_{1},\ldots,\sigma_{m_{k}})\in\{-1,1\}^{m_{k}}</annotation></semantics></math><span id="S5.I3.i2.p1.2.2" class="ltx_text ltx_font_italic"> and input </span><math id="S5.I3.i2.p1.m3" class="ltx_Math" alttext="\bm{y}=(y_{1},\ldots,y_{m_{k}})" display="inline" intent=":literal"><semantics><mrow><mi>𝒚</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>y</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{y}=(y_{1},\ldots,y_{m_{k}})</annotation></semantics></math><span id="S5.I3.i2.p1.2.3" class="ltx_text ltx_font_italic">,</span></p>
<table id="S5.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex7.m1" class="ltx_Math" alttext="\displaystyle L_{\bm{\sigma}}(\bm{y})" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>𝝈</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle L_{\bm{\sigma}}(\bm{y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex7.m2" class="ltx_Math" alttext="\displaystyle:=\max_{\ell\in[m_{k}]}(-\sigma_{\ell}y_{\ell})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><munder><mi>max</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\max_{\ell\in[m_{k}]}(-\sigma_{\ell}y_{\ell}),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex7.m3" class="ltx_Math" alttext="\displaystyle U_{\bm{\sigma}}(\bm{y})" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>𝝈</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle U_{\bm{\sigma}}(\bm{y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex7.m4" class="ltx_Math" alttext="\displaystyle:=\min_{\ell\in[m_{k}]}(1-\sigma_{\ell}y_{\ell})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><munder><mi>min</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\min_{\ell\in[m_{k}]}(1-\sigma_{\ell}y_{\ell}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex8.m1" class="ltx_Math" alttext="\displaystyle Y^{+}_{\bm{\sigma}}(\bm{y})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Y</mi><mi>𝝈</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Y^{+}_{\bm{\sigma}}(\bm{y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex8.m2" class="ltx_math_unparsed" alttext="\displaystyle:=\left(\max_{\ell:\sigma_{\ell}=1}\frac{{\bar{\Delta}}_{k,\ell}}{1-{\bar{\Delta}}_{k,\ell}}\cdot y_{\ell}\right)_{+}," display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><msub><mrow><mo>(</mo><munder><mi>max</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>y</mi><mi mathvariant="normal">ℓ</mi></msub><mo>)</mo></mrow><mo>+</mo></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\left(\max_{\ell:\sigma_{\ell}=1}\frac{{\bar{\Delta}}_{k,\ell}}{1-{\bar{\Delta}}_{k,\ell}}\cdot y_{\ell}\right)_{+},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex8.m3" class="ltx_Math" alttext="\displaystyle Y^{-}_{\bm{\sigma}}(\bm{y})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Y</mi><mi>𝝈</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Y^{-}_{\bm{\sigma}}(\bm{y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex8.m4" class="ltx_math_unparsed" alttext="\displaystyle:=\left(\max_{\ell:\sigma_{\ell}=-1}\frac{{\bar{\Delta}}_{k,\ell}}{1-{\bar{\Delta}}_{k,\ell}}\cdot y_{\ell}\right)_{+}," display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><msub><mrow><mo>(</mo><munder><mi>max</mi><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>σ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>y</mi><mi mathvariant="normal">ℓ</mi></msub><mo>)</mo></mrow><mo>+</mo></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\left(\max_{\ell:\sigma_{\ell}=-1}\frac{{\bar{\Delta}}_{k,\ell}}{1-{\bar{\Delta}}_{k,\ell}}\cdot y_{\ell}\right)_{+},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex9.m1" class="ltx_Math" alttext="\displaystyle A_{\bm{\sigma}}^{\bm{{\bar{\Delta}}}_{k}}(\bm{y})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>𝝈</mi><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle A_{\bm{\sigma}}^{\bm{{\bar{\Delta}}}_{k}}(\bm{y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex9.m2" class="ltx_Math" alttext="\displaystyle:=\max\left\{L_{\bm{\sigma}}(\bm{y}),\ Y^{+}_{\bm{\sigma}}(\bm{y})\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msub><mi>L</mi><mi>𝝈</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msubsup><mi>Y</mi><mi>𝝈</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\max\left\{L_{\bm{\sigma}}(\bm{y}),\ Y^{+}_{\bm{\sigma}}(\bm{y})\right\},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex9.m3" class="ltx_Math" alttext="\displaystyle B_{\bm{\sigma}}^{\bm{{\bar{\Delta}}}_{k}}(\bm{y})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mi>𝝈</mi><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle B_{\bm{\sigma}}^{\bm{{\bar{\Delta}}}_{k}}(\bm{y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex9.m4" class="ltx_Math" alttext="\displaystyle:=\min\left\{U_{\bm{\sigma}}(\bm{y}),\ 1-Y^{-}_{\bm{\sigma}}(\bm{y})\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>U</mi><mi>𝝈</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mn> 1</mn><mo>−</mo><mrow><msubsup><mi>Y</mi><mi>𝝈</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\min\left\{U_{\bm{\sigma}}(\bm{y}),\ 1-Y^{-}_{\bm{\sigma}}(\bm{y})\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I3.i2.p1.3" class="ltx_p"><span id="S5.I3.i2.p1.3.1" class="ltx_text ltx_font_italic">with </span><math id="S5.I3.i2.p1.m4" class="ltx_Math" alttext="(x)_{+}:=\max(x,0)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></msub><mo>:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(x)_{+}:=\max(x,0)</annotation></semantics></math><span id="S5.I3.i2.p1.3.2" class="ltx_text ltx_font_italic">, and the normalization constant </span><math id="S5.I3.i2.p1.m5" class="ltx_Math" alttext="I_{m_{k}}(\bm{{\bar{\Delta}}}_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I_{m_{k}}(\bm{{\bar{\Delta}}}_{k})</annotation></semantics></math><span id="S5.I3.i2.p1.3.3" class="ltx_text ltx_font_italic"> is given by</span></p>
<table id="S5.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex10.m1" class="ltx_math_unparsed" alttext="I_{m_{k}}(\bm{{\bar{\Delta}}}_{k}):=\int_{[0,1]^{m_{k}}}\left(\min_{\ell\in[m_{k}]}\{1-{\bar{\Delta}}_{k,\ell}+{\bar{\Delta}}_{k,\ell}x_{\ell}\}-\max_{\ell\in[m_{k}]}\{{\bar{\Delta}}_{k,\ell}x_{\ell}\}\right)_{+}{\mathrm{d}}x_{1}\cdots{\mathrm{d}}x_{m_{k}}." display="block" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">:=</mo><msub><mo rspace="0em">∫</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mi>k</mi></msub></msup></msub><msub><mrow><mo>(</mo><munder><mi>min</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo>+</mo><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mi>x</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">}</mo></mrow><mo>−</mo><munder><mi>max</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>m</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msub><mi>x</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">}</mo></mrow><mo>)</mo></mrow><mo>+</mo></msub><mi>d</mi><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>d</mi><msub><mi>x</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">I_{m_{k}}(\bm{{\bar{\Delta}}}_{k}):=\int_{[0,1]^{m_{k}}}\left(\min_{\ell\in[m_{k}]}\{1-{\bar{\Delta}}_{k,\ell}+{\bar{\Delta}}_{k,\ell}x_{\ell}\}-\max_{\ell\in[m_{k}]}\{{\bar{\Delta}}_{k,\ell}x_{\ell}\}\right)_{+}{\mathrm{d}}x_{1}\cdots{\mathrm{d}}x_{m_{k}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
</div>
<div id="S5.SS1.p8" class="ltx_para">
<p id="S5.SS1.p8.1" class="ltx_p">As a special case, when <math id="S5.SS1.p8.m1" class="ltx_Math" alttext="m_{k}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{k}=1</annotation></semantics></math>, the block <math id="S5.SS1.p8.m2" class="ltx_Math" alttext="{\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math> contains no repeated tokens. In this setting, the PDFs in Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1 (Asymptotic joint distribution of pivotal statistics). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> simplify significantly and recover the previous non-repetitive results in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>, Theorem 4.1]</cite>, as shown in the following corollary.</p>
</div>
<div id="S5.Thmcor1" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmcor1.2" class="ltx_text ltx_font_bold">Corollary 5.1</span></span><span id="S5.Thmcor1.3" class="ltx_text ltx_font_bold"> </span>(Case <math id="S5.Thmcor1.m1" class="ltx_Math" alttext="m_{k}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{k}=1</annotation></semantics></math>)<span id="S5.Thmcor1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmcor1.p1" class="ltx_para">
<p id="S5.Thmcor1.p1.1" class="ltx_p"><span id="S5.Thmcor1.p1.1.1" class="ltx_text ltx_font_italic">Consider a minimal unit <math id="S5.Thmcor1.p1.m1" class="ltx_Math" alttext="{\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math> consisting of a single sub-block. In this case, the parameter vector <math id="S5.Thmcor1.p1.m2" class="ltx_Math" alttext="\bm{{\bar{\Delta}}}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\bm{{\bar{\Delta}}}_{k}</annotation></semantics></math> reduces to a scalar <math id="S5.Thmcor1.p1.m3" class="ltx_Math" alttext="\Delta_{k,1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\Delta_{k,1}</annotation></semantics></math>.
The normalization constant from Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1 (Asymptotic joint distribution of pivotal statistics). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> simplifies to <math id="S5.Thmcor1.p1.m4" class="ltx_Math" alttext="I_{1}(\bm{{\bar{\Delta}}}_{k})=1-\Delta_{k,1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>I</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">I_{1}(\bm{{\bar{\Delta}}}_{k})=1-\Delta_{k,1}</annotation></semantics></math>. The asymptotic PDF for the single pivotal statistic <math id="S5.Thmcor1.p1.m5" class="ltx_Math" alttext="Y_{k,1}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">Y_{k,1}</annotation></semantics></math> reduce to:</span></p>
<ul id="S5.I4" class="ltx_itemize">
<li id="S5.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I4.i1.p1" class="ltx_para">
<p id="S5.I4.i1.p1.1" class="ltx_p"><span id="S5.I4.i1.p1.1.1" class="ltx_text ltx_font_italic">Under </span><math id="S5.I4.i1.p1.m1" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math><span id="S5.I4.i1.p1.1.2" class="ltx_text ltx_font_italic">, the PDF of </span><math id="S5.I4.i1.p1.m2" class="ltx_Math" alttext="Y_{k,1}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">Y_{k,1}</annotation></semantics></math><span id="S5.I4.i1.p1.1.3" class="ltx_text ltx_font_italic"> is a triangular distribution on </span><math id="S5.I4.i1.p1.m3" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math><span id="S5.I4.i1.p1.1.4" class="ltx_text ltx_font_italic">:</span></p>
<table id="S5.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex11.m1" class="ltx_Math" alttext="\displaystyle f_{0}(y_{1})=2(1-y_{1}){\bf 1}_{0\leq y_{1}\leq 1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mrow><mn>0</mn><mo>≤</mo><msub><mi>y</mi><mn>1</mn></msub><mo>≤</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{0}(y_{1})=2(1-y_{1}){\bf 1}_{0\leq y_{1}\leq 1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I4.i2.p1" class="ltx_para">
<p id="S5.I4.i2.p1.1" class="ltx_p"><span id="S5.I4.i2.p1.1.1" class="ltx_text ltx_font_italic">Under </span><math id="S5.I4.i2.p1.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math><span id="S5.I4.i2.p1.1.2" class="ltx_text ltx_font_italic">, the PDF of </span><math id="S5.I4.i2.p1.m2" class="ltx_Math" alttext="Y_{k,1}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">Y_{k,1}</annotation></semantics></math><span id="S5.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> is a triangular distribution supported on </span><math id="S5.I4.i2.p1.m3" class="ltx_Math" alttext="[0,1-\Delta_{k,1}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1-\Delta_{k,1}]</annotation></semantics></math><span id="S5.I4.i2.p1.1.4" class="ltx_text ltx_font_italic">:</span></p>
<table id="S5.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E21.m1" class="ltx_Math" alttext="\displaystyle f_{\Delta_{k,1}}(y_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><msub><mi mathvariant="normal">Δ</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{\Delta_{k,1}}(y_{1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E21.m2" class="ltx_Math" alttext="\displaystyle=\begin{cases}\dfrac{2}{1-\Delta_{k,1}}-\dfrac{2y_{1}}{(1-\Delta_{k,1})^{2}},&amp;\text{if }0&lt;y_{1}&lt;1-\Delta_{k,1},\\[5.0pt]
0,&amp;\text{otherwise}.\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mn>1</mn><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if </mtext><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow><mo>&lt;</mo><msub><mi>y</mi><mn>1</mn></msub><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext class="ltx_mathvariant_italic">otherwise</mtext><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\dfrac{2}{1-\Delta_{k,1}}-\dfrac{2y_{1}}{(1-\Delta_{k,1})^{2}},&amp;\text{if }0&lt;y_{1}&lt;1-\Delta_{k,1},\\[5.0pt]
0,&amp;\text{otherwise}.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2 </span>Optimal Score Function</h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.1" class="ltx_p">As shown in Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1 (Asymptotic joint distribution of pivotal statistics). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, when the vocabulary size <math id="S5.SS2.p1.m1" class="ltx_Math" alttext="|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|</annotation></semantics></math> tends to infinity, the joint distributions of the unique pivotal statistics within each minimal unit simplify significantly under both <math id="S5.SS2.p1.m2" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> and <math id="S5.SS2.p1.m3" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>. To incorporate this effect in our framework, we replace the original class-dependent efficiency from Definition <a href="#S3.Thmdefn3" title="Definition 3.3 (Non-asymptotic 𝒫-efficiency). ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> with its asymptotic counterpart, defined over the new class <math id="S5.SS2.p1.m4" class="ltx_Math" alttext="{\overline{{\mathcal{P}}}_{\Delta}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\overline{{\mathcal{P}}}_{\Delta}}</annotation></semantics></math> introduced in (<a href="#S5.E16" title="In item (i) ‣ Assumption 5.1 (Asymptotic NTP conditions). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>). Specifically, we consider the following asymptotic efficiency, denoted by <math id="S5.SS2.p1.m5" class="ltx_Math" alttext="\bar{R}_{n,\mathscr{P}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><annotation encoding="application/x-tex">\bar{R}_{n,\mathscr{P}}</annotation></semantics></math> and defined by</p>
<table id="S5.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E22.m1" class="ltx_Math" alttext="\bar{R}_{n,\mathscr{P}}({\bm{h}}):=\liminf_{|{{\mathcal{W}}}|\to\infty}R_{n,\mathscr{P}}({\bm{h}})\geq\liminf_{|{{\mathcal{W}}}|\to\infty}B_{n,\mathscr{P}}({\bm{h}})-\omega_{N_{n}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">:=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim inf</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mi>R</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.1389em">≥</mo><mrow><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim inf</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bar{R}_{n,\mathscr{P}}({\bm{h}}):=\liminf_{|{{\mathcal{W}}}|\to\infty}R_{n,\mathscr{P}}({\bm{h}})\geq\liminf_{|{{\mathcal{W}}}|\to\infty}B_{n,\mathscr{P}}({\bm{h}})-\omega_{N_{n}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="S5.SS2.p1.2" class="ltx_p">where <math id="S5.SS2.p1.m6" class="ltx_Math" alttext="\mathscr{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒫</mi><annotation encoding="application/x-tex">\mathscr{P}</annotation></semantics></math> assigns the new class <math id="S5.SS2.p1.m7" class="ltx_Math" alttext="{\overline{{\mathcal{P}}}_{\Delta}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\overline{{\mathcal{P}}}_{\Delta}}</annotation></semantics></math> (with potentially different values of <math id="S5.SS2.p1.m8" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>) to the minimal units, and <math id="S5.SS2.p1.m9" class="ltx_Math" alttext="\omega_{N_{n}}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub><annotation encoding="application/x-tex">\omega_{N_{n}}</annotation></semantics></math> is a vanishing term tending to zero as the number of minimal units <math id="S5.SS2.p1.m10" class="ltx_Math" alttext="N_{n}\to\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>n</mi></msub><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">N_{n}\to\infty</annotation></semantics></math> (by Theorem <a href="#S3.Thmthm1" title="Theorem 3.1 (Explicit lower bound for detection efficiency). ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>).</p>
</div>
<div id="S5.SS2.p2" class="ltx_para">
<p id="S5.SS2.p2.1" class="ltx_p">To identify the optimal score functions, we adopt the same strategy as in the analysis of the Gumbel-max watermark. The quantity <math id="S5.SS2.p2.m1" class="ltx_Math" alttext="\liminf\limits_{|{{\mathcal{W}}}|\to\infty}B_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim inf</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\liminf\limits_{|{{\mathcal{W}}}|\to\infty}B_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math>, introduced in (<a href="#S5.E22" title="In 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) and defined in (<a href="#S3.E9" title="In Theorem 3.1 (Explicit lower bound for detection efficiency). ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), retains its additive structure across minimal units. The main difference is that the null and alternative distributions are now replaced by their asymptotic limits, as established in Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1 (Asymptotic joint distribution of pivotal statistics). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>. Thus, the problem reduces to optimizing the score function for each minimal unit individually. If we assign <math id="S5.SS2.p2.m2" class="ltx_Math" alttext="\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub><annotation encoding="application/x-tex">\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}</annotation></semantics></math> to a minimal unit <math id="S5.SS2.p2.m3" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>, we obtain the following minimax optimization problem, which parallels the structure of (<a href="#S3.E10" title="In Optimality via minimax optimization. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>),</p>
<table id="S5.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E23.m1" class="ltx_math_unparsed" alttext="h_{{{\mathcal{V}}}}=\arg\min_{h}\sup_{\Delta_{{\mathcal{V}}}\leq\bm{{\bar{\Delta}}}\leq 1-\delta}L^{\prime}(h,\bm{{\bar{\Delta}}}),\quad\text{where}\quad L^{\prime}(h,\bm{{\bar{\Delta}}})=\EB_{f_{0}}[h(\bm{Y}_{k})]+\log\EB_{f_{\bm{{\bar{\Delta}}}}}[\exp(-h(\bm{Y}_{k}))]," display="block" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>=</mo><mi>arg</mi><munder><mi>min</mi><mi>h</mi></munder><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>≤</mo><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow></munder><msup><mi>L</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><mtext>where</mtext><msup><mi>L</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><msub><mi>f</mi><mn>0</mn></msub></msub><mrow><mo stretchy="false">[</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>log</mi><msub><mi>𝔼</mi><msub><mi>f</mi><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover></msub></msub><mrow><mo stretchy="false">[</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">h_{{{\mathcal{V}}}}=\arg\min_{h}\sup_{\Delta_{{\mathcal{V}}}\leq\bm{{\bar{\Delta}}}\leq 1-\delta}L^{\prime}(h,\bm{{\bar{\Delta}}}),\quad\text{where}\quad L^{\prime}(h,\bm{{\bar{\Delta}}})=\EB_{f_{0}}[h(\bm{Y}_{k})]+\log\EB_{f_{\bm{{\bar{\Delta}}}}}[\exp(-h(\bm{Y}_{k}))],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="S5.SS2.p2.2" class="ltx_p">where <math id="S5.SS2.p2.m4" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> and <math id="S5.SS2.p2.m5" class="ltx_Math" alttext="f_{\bm{{\bar{\Delta}}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover></msub><annotation encoding="application/x-tex">f_{\bm{{\bar{\Delta}}}}</annotation></semantics></math> denote the asymptotic PDFs of the vector of pivotal statistics <math id="S5.SS2.p2.m6" class="ltx_Math" alttext="\bm{Y}_{k}=(Y_{k,1},\ldots,Y_{k,m_{k}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒀</mi><mi>k</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{Y}_{k}=(Y_{k,1},\ldots,Y_{k,m_{k}})</annotation></semantics></math> under the null and alternative, respectively, as given in Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1 (Asymptotic joint distribution of pivotal statistics). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>. Here, <math id="S5.SS2.p2.m7" class="ltx_Math" alttext="\bm{{\bar{\Delta}}}\geq\Delta_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo>≥</mo><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow><annotation encoding="application/x-tex">\bm{{\bar{\Delta}}}\geq\Delta_{{\mathcal{V}}}</annotation></semantics></math> means that every entry of <math id="S5.SS2.p2.m8" class="ltx_Math" alttext="\bm{{\bar{\Delta}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bm{{\bar{\Delta}}}</annotation></semantics></math> is at least <math id="S5.SS2.p2.m9" class="ltx_Math" alttext="\Delta_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">\Delta_{{\mathcal{V}}}</annotation></semantics></math>, and the notation <math id="S5.SS2.p2.m10" class="ltx_Math" alttext="\bm{{\bar{\Delta}}}\leq 1-\delta" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">\bm{{\bar{\Delta}}}\leq 1-\delta</annotation></semantics></math> is defined analogously.</p>
</div>
<div id="S5.SS2.p3" class="ltx_para">
<p id="S5.SS2.p3.1" class="ltx_p">We then characterize the optimal score functions that maximize <math id="S5.SS2.p3.m1" class="ltx_Math" alttext="\bar{R}_{n,\mathscr{P}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><annotation encoding="application/x-tex">\bar{R}_{n,\mathscr{P}}</annotation></semantics></math>-efficiency (up to the infinitesimal error <math id="S5.SS2.p3.m2" class="ltx_Math" alttext="\omega_{N_{n}}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub><annotation encoding="application/x-tex">\omega_{N_{n}}</annotation></semantics></math>), as stated in the following theorem.</p>
</div>
<div id="S5.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 5.2</span></span><span id="S5.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem2.p1" class="ltx_para">
<p id="S5.Thmtheorem2.p1.1" class="ltx_p"><span id="S5.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#S3.Thmasmp1" title="Assumption 3.1 (Independence across blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, <a href="#S3.Thmasmp3" title="Assumption 3.3. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> <a href="#S3.I3.i2" title="item (ii) ‣ Assumption 3.3. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(ii)</span></a>, and <a href="#S5.Thmasmp1" title="Assumption 5.1 (Asymptotic NTP conditions). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> hold.
Fix a block <math id="S5.Thmtheorem2.p1.m1" class="ltx_Math" alttext="{\mathcal{V}}={\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{V}}={\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math> consisting of <math id="S5.Thmtheorem2.p1.m2" class="ltx_Math" alttext="m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">m_{k}</annotation></semantics></math> minimal units, and assume that <math id="S5.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\mathscr{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒫</mi><annotation encoding="application/x-tex">\mathscr{P}</annotation></semantics></math> assigns the class <math id="S5.Thmtheorem2.p1.m4" class="ltx_Math" alttext="\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub><annotation encoding="application/x-tex">\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}</annotation></semantics></math> with <math id="S5.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\Delta_{{\mathcal{V}}}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta_{{\mathcal{V}}}\in(0,1)</annotation></semantics></math> to <math id="S5.Thmtheorem2.p1.m6" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>.
Define</span></p>
<table id="S5.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E24.m1" class="ltx_Math" alttext="\displaystyle h_{{{\mathcal{V}}}}^{\mathrm{inv}}(\bm{y}):=\log\frac{f_{\bm{{\bar{\Delta}}}_{{\mathcal{V}}}}(\bm{y})}{f_{0}(\bm{y})}\quad\text{with}\quad\bm{y}=(y_{1},\ldots,y_{m_{k}}),\quad\bm{{\bar{\Delta}}}_{{\mathcal{V}}}=(\Delta_{{\mathcal{V}}},\ldots,\Delta_{{\mathcal{V}}})\in{\mathbb{R}}^{m_{k}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>inv</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">with</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi>𝒚</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>y</mi><msub><mi>m</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mi>k</mi></msub></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle h_{{{\mathcal{V}}}}^{\mathrm{inv}}(\bm{y}):=\log\frac{f_{\bm{{\bar{\Delta}}}_{{\mathcal{V}}}}(\bm{y})}{f_{0}(\bm{y})}\quad\text{with}\quad\bm{y}=(y_{1},\ldots,y_{m_{k}}),\quad\bm{{\bar{\Delta}}}_{{\mathcal{V}}}=(\Delta_{{\mathcal{V}}},\ldots,\Delta_{{\mathcal{V}}})\in{\mathbb{R}}^{m_{k}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="S5.Thmtheorem2.p1.2" class="ltx_p"><span id="S5.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S5.Thmtheorem2.p1.m7" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> and <math id="S5.Thmtheorem2.p1.m8" class="ltx_Math" alttext="f_{\bm{{\bar{\Delta}}}_{{\mathcal{V}}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub><annotation encoding="application/x-tex">f_{\bm{{\bar{\Delta}}}_{{\mathcal{V}}}}</annotation></semantics></math> denote the asymptotic null and alternative PDFs, respectively, as given in Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1 (Asymptotic joint distribution of pivotal statistics). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>.
The score functions <math id="S5.Thmtheorem2.p1.m9" class="ltx_Math" alttext="\{h_{{{\mathcal{V}}}}^{\mathrm{inv}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>inv</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub><annotation encoding="application/x-tex">\{h_{{{\mathcal{V}}}}^{\mathrm{inv}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math> maximizes the <math id="S5.Thmtheorem2.p1.m10" class="ltx_Math" alttext="\bar{R}_{n,\mathscr{P}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><annotation encoding="application/x-tex">\bar{R}_{n,\mathscr{P}}</annotation></semantics></math>-efficiency defined in (<a href="#S5.E22" title="In 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), in the sense that</span></p>
<table id="S5.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex12.m1" class="ltx_Math" alttext="\lim_{M\to\infty}\bar{R}_{n,\mathscr{P}}\left(\{[h_{{{\mathcal{V}}}}^{\mathrm{inv}}]_{[-M,M]}\}_{{\mathcal{V}}\in\Pi}\right)=\infty," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">[</mo><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>inv</mi></msubsup><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">]</mo></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lim_{M\to\infty}\bar{R}_{n,\mathscr{P}}\left(\{[h_{{{\mathcal{V}}}}^{\mathrm{inv}}]_{[-M,M]}\}_{{\mathcal{V}}\in\Pi}\right)=\infty,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem2.p1.3" class="ltx_p"><span id="S5.Thmtheorem2.p1.3.1" class="ltx_text ltx_font_italic">where <math id="S5.Thmtheorem2.p1.m11" class="ltx_Math" alttext="[\cdot]_{[-M,M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">[\cdot]_{[-M,M]}</annotation></semantics></math> denotes the clipping operator onto the interval <math id="S5.Thmtheorem2.p1.m12" class="ltx_Math" alttext="[-M,M]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-M,M]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS2.p4" class="ltx_para">
<p id="S5.SS2.p4.1" class="ltx_p">As shown in Theorem <a href="#S5.Thmtheorem2" title="Theorem 5.2. ‣ 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>, the optimal score function takes the form of a log-likelihood ratio between the asymptotic null and alternative PDFs. This result generalizes the previous result of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>, Theorem 4.2]</cite>, which corresponds to the special case <math id="S5.SS2.p4.m1" class="ltx_Math" alttext="m_{k}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>k</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{k}=1</annotation></semantics></math>, where each block consists of only a single sub-block.
Notably, the efficiency at the rule <math id="S5.SS2.p4.m2" class="ltx_Math" alttext="h_{{{\mathcal{V}}}}^{\mathrm{inv}}" display="inline" intent=":literal"><semantics><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>inv</mi></msubsup><annotation encoding="application/x-tex">h_{{{\mathcal{V}}}}^{\mathrm{inv}}</annotation></semantics></math> diverges to infinity. This arises because the null and alternative PDFs <math id="S5.SS2.p4.m3" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> and <math id="S5.SS2.p4.m4" class="ltx_Math" alttext="f_{\bm{{\bar{\Delta}}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover></msub><annotation encoding="application/x-tex">f_{\bm{{\bar{\Delta}}}}</annotation></semantics></math> differ on their supports, causing the KL divergence (which is essentially the optimal efficiency) to diverge.
In practice, although the asymptotic regime <math id="S5.SS2.p4.m5" class="ltx_Math" alttext="|{{\mathcal{W}}}|\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|\to\infty</annotation></semantics></math> only holds approximately, the score function <math id="S5.SS2.p4.m6" class="ltx_Math" alttext="h_{{{\mathcal{V}}}}^{\mathrm{inv}}" display="inline" intent=":literal"><semantics><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>inv</mi></msubsup><annotation encoding="application/x-tex">h_{{{\mathcal{V}}}}^{\mathrm{inv}}</annotation></semantics></math> still performs well—particularly when the regularity level <math id="S5.SS2.p4.m7" class="ltx_Math" alttext="\Delta_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">\Delta_{{\mathcal{V}}}</annotation></semantics></math> is adaptively selected.</p>
</div>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Experiments</h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">This section highlights the effectiveness of our framework through synthetic and real-data experiments and shows the practical utility of our proposed methods under pseudorandom collision. All the experiment codes are at <a href="https://github.com/lx10077/WatermarkCollision" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://github.com/lx10077/WatermarkCollision</a>.</p>
</div>
<section id="S6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.1 </span>Synthetic Studies</h3>

<section id="S6.SS1.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Experimental setup.</h5>

<div id="S6.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="S6.SS1.SSS0.Px1.p1.1" class="ltx_p">We deliberately introduce repetition to evaluate Type I and Type II errors under pseudorandom collisions.
We set the vocabulary size to <math id="S6.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="|{{\mathcal{W}}}|=10^{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><msup><mn>10</mn><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|=10^{3}</annotation></semantics></math>. At each step <math id="S6.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, with probability <math id="S6.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="0.9" display="inline" intent=":literal"><semantics><mn>0.9</mn><annotation encoding="application/x-tex">0.9</annotation></semantics></math>, a new token is generated according to the considered watermarking scheme. Specifically, we first sample <math id="S6.SS1.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\Delta_{t}\sim\mathrm{Unif}(10^{-3},\Delta_{\max})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{t}\sim\mathrm{Unif}(10^{-3},\Delta_{\max})</annotation></semantics></math> for a prespecified <math id="S6.SS1.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\Delta_{\max}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>max</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta_{\max}\in(0,1)</annotation></semantics></math>, and then independently construct an NTP distribution <math id="S6.SS1.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\bm{P}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{P}_{t}</annotation></semantics></math> satisfying <math id="S6.SS1.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\max_{{w}\in{{\mathcal{W}}}}\bm{P}_{t,{w}}=1-\Delta_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>max</mi><mrow><mi>w</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>𝑷</mi><mrow><mi>t</mi><mo>,</mo><mi>w</mi></mrow></msub></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\max_{{w}\in{{\mathcal{W}}}}\bm{P}_{t,{w}}=1-\Delta_{t}</annotation></semantics></math>. The NTP distribution interpolates between a Zipf law <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib54" title="" class="ltx_ref">54</a>]</cite> and the uniform distribution,<span id="footnote5" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">5</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">5</sup>
                <span class="ltx_tag ltx_tag_note">5</span>
                
                
                
              See Algorithm 1 in the appendix of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite> for details.</span></span></span> with <math id="S6.SS1.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\Delta_{\max}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\Delta_{\max}</annotation></semantics></math> controlling its degree of randomness or entropy.</p>
</div>
<div id="S6.SS1.SSS0.Px1.p2" class="ltx_para">
<p id="S6.SS1.SSS0.Px1.p2.1" class="ltx_p">With the remaining probability <math id="S6.SS1.SSS0.Px1.p2.m1" class="ltx_Math" alttext="0.1" display="inline" intent=":literal"><semantics><mn>0.1</mn><annotation encoding="application/x-tex">0.1</annotation></semantics></math>, we introduce repetition through two independent mechanisms. With probability <math id="S6.SS1.SSS0.Px1.p2.m2" class="ltx_Math" alttext="0.05" display="inline" intent=":literal"><semantics><mn>0.05</mn><annotation encoding="application/x-tex">0.05</annotation></semantics></math>, we insert a segment sampled from a growing pool of previously used segments, which is updated whenever a new segment is generated or observed. With another <math id="S6.SS1.SSS0.Px1.p2.m3" class="ltx_Math" alttext="0.05" display="inline" intent=":literal"><semantics><mn>0.05</mn><annotation encoding="application/x-tex">0.05</annotation></semantics></math>, we copy a contiguous block from the generated prefix: draw a length <math id="S6.SS1.SSS0.Px1.p2.m4" class="ltx_Math" alttext="L\in\{1,\ldots,L_{\max}\}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>L</mi><mi>max</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">L\in\{1,\ldots,L_{\max}\}</annotation></semantics></math> with <math id="S6.SS1.SSS0.Px1.p2.m5" class="ltx_Math" alttext="L_{\max}=5" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>max</mi></msub><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">L_{\max}=5</annotation></semantics></math>, select a valid start uniformly, and replicate the block as the next output. Since the repeat decision is independent of the mechanism, this yields a decoupled corruption setup, enabling direct comparisons of Type I and Type II errors across score functions. The simulation results for <math id="S6.SS1.SSS0.Px1.p2.m6" class="ltx_Math" alttext="\Delta_{\max}=0.7" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>max</mi></msub><mo>=</mo><mn>0.7</mn></mrow><annotation encoding="application/x-tex">\Delta_{\max}=0.7</annotation></semantics></math> are shown in Figure <a href="#S6.F4" title="Figure 4 ‣ Experimental setup. ‣ 6.1 Synthetic Studies ‣ 6 Experiments ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, while further implementation details and additional results for other values of <math id="S6.SS1.SSS0.Px1.p2.m7" class="ltx_Math" alttext="\Delta_{\max}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\Delta_{\max}</annotation></semantics></math> are provided in Supplementary <a href="#A4" title="Appendix D Details of Simulation Study ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a>.</p>
</div>
<figure id="S6.F4" class="ltx_figure"><object type="image/svg+xml" data="2510.22007v1/K1000N2000c7key23333T700Delta0.7-alpha0.01-all0.9.svg" id="S6.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/238;" width="476" height="238"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>Type I errors (left) and Type II errors (right, log scale) on synthetic datasets for the Gumbel-max watermark (top) and the inverse-transform watermark (bottom).
Our new detection rules are denoted by <math id="S6.F4.m2" class="ltx_Math" alttext="h_{\mathrm{new},\Delta}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>new</mi><mo>,</mo><mi mathvariant="normal">Δ</mi></mrow></msub><annotation encoding="application/x-tex">h_{\mathrm{new},\Delta}</annotation></semantics></math>. Here, “raw” or “deduped” indicates that the detection rule is applied to raw or unique pivotal statistics.</figcaption>
</figure>
</section>
<section id="S6.SS1.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Type I error.</h5>

<div id="S6.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="S6.SS1.SSS0.Px2.p1.1" class="ltx_p">From the first column of Figure <a href="#S6.F4" title="Figure 4 ‣ Experimental setup. ‣ 6.1 Synthetic Studies ‣ 6 Experiments ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, existing rules, when directly applied to raw data, fail to control Type I error: at <math id="S6.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\alpha=0.01" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">\alpha=0.01</annotation></semantics></math>, their empirical errors (light curves) hover around <math id="S6.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="0.03" display="inline" intent=":literal"><semantics><mn>0.03</mn><annotation encoding="application/x-tex">0.03</annotation></semantics></math>, well above the nominal level. This inflation arises because repeated pivotal statistics are double-counted as independent evidence, inflating the effective sample size and understating variance. In our setup, about 15%–20% of the data is repeated on average. We then evaluate the same detection rules, together with our proposed rule in Theorem <a href="#S4.Thmthm1" title="Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> and the new rule in Theorem <a href="#S5.Thmtheorem2" title="Theorem 5.2. ‣ 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>, after removing repetitions while regenerating until the sequence length is maintained. In contrast, these methods (darker curves) control Type I error well, with only natural random fluctuation. These results show that treating minimal units as the basic unit is effective for controlling Type I errors.</p>
</div>
</section>
<section id="S6.SS1.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Type II error.</h5>

<div id="S6.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="S6.SS1.SSS0.Px3.p1.1" class="ltx_p">From the second column of Figure <a href="#S6.F4" title="Figure 4 ‣ Experimental setup. ‣ 6.1 Synthetic Studies ‣ 6 Experiments ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we find that detection rules, when applied to deduplicated data, achieve Type II errors that are comparable to, and sometimes smaller than, those on raw data. For example, for the Gumbel-max watermark, <math id="S6.SS1.SSS0.Px3.p1.m1" class="ltx_Math" alttext="h_{\mathrm{ars}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>ars</mi></msub><annotation encoding="application/x-tex">h_{\mathrm{ars}}</annotation></semantics></math> performs slightly better once repetitions are removed. Both of our proposed detection rules also perform on par with existing state-of-the-art methods: for Gumbel-max, <math id="S6.SS1.SSS0.Px3.p1.m2" class="ltx_Math" alttext="h_{\mathrm{new},0.005}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>new</mi><mo>,</mo><mn>0.005</mn></mrow></msub><annotation encoding="application/x-tex">h_{\mathrm{new},0.005}</annotation></semantics></math> behaves similarly to <math id="S6.SS1.SSS0.Px3.p1.m3" class="ltx_Math" alttext="h_{\mathrm{ars}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>ars</mi></msub><annotation encoding="application/x-tex">h_{\mathrm{ars}}</annotation></semantics></math>, while for the inverse-transform watermark, <math id="S6.SS1.SSS0.Px3.p1.m4" class="ltx_Math" alttext="h_{\mathrm{new},0.01}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>new</mi><mo>,</mo><mn>0.01</mn></mrow></msub><annotation encoding="application/x-tex">h_{\mathrm{new},0.01}</annotation></semantics></math> matches the performance of <math id="S6.SS1.SSS0.Px3.p1.m5" class="ltx_Math" alttext="h_{\mathrm{dif},0.01}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>dif</mi><mo>,</mo><mn>0.01</mn></mrow></msub><annotation encoding="application/x-tex">h_{\mathrm{dif},0.01}</annotation></semantics></math> from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>. These findings indicate that modest levels of repetition do not substantially degrade Type II errors or the detection power, as the watermark signal embedded in unique data is already strong. Another reason is that we set a uniform <math id="S6.SS1.SSS0.Px3.p1.m6" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> across all minimal units, which may limit potential gains from explicitly modeling repetition.</p>
</div>
<figure id="S6.F5" class="ltx_figure"><object type="image/svg+xml" data="2510.22007v1/real.svg" id="S6.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/278;" width="476" height="278"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>Type I errors (left) and Type II errors (right, log scale) on C4 dataset for the Gumbel-max watermark (top) and the inverse-transform watermark (bottom).
Our new detection rules are denoted by <math id="S6.F5.m3" class="ltx_Math" alttext="h_{\mathrm{new}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>new</mi></msub><annotation encoding="application/x-tex">h_{\mathrm{new}}</annotation></semantics></math>. Here, “sur” and “oracle” indicate that the <math id="S6.F5.m4" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>-values are approximated or computed using the ground truth.</figcaption>
</figure>
</section>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.2 </span>Real-World Examples</h3>

<div id="S6.SS2.p1" class="ltx_para">
<p id="S6.SS2.p1.1" class="ltx_p">Next, we conduct an empirical analysis of the detection performance of different watermark detection methods on text sequences generated by the language model, OPT-1.3B <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib52" title="" class="ltx_ref">52</a>]</cite>. We evaluate Type I errors using 2000 human-written samples from the C4 news-like dataset <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib42" title="" class="ltx_ref">42</a>]</cite>. To assess Type II errors, we randomly sample prompts from the same dataset, feed them to the model, and let it generate continuations. To ensure a fair evaluation based on unique pivotal statistics, we continue generating until each generated sentence contains at least 300 unique pivotal statistics (or minimal units). This approach guarantees a sufficient number of valid statistics, regardless of the total sequence length. The remaining experimental setup follows <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite> and is detailed in Supplementary Material <a href="#A5" title="Appendix E Details for Real-World Examples ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a> for completeness.</p>
</div>
<div id="S6.SS2.p2" class="ltx_para">
<p id="S6.SS2.p2.1" class="ltx_p">The empirical Type I (left) and Type II errors (right) are presented in Figure <a href="#S6.F5" title="Figure 5 ‣ Type II error. ‣ 6.1 Synthetic Studies ‣ 6 Experiments ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.
The score functions <math id="S6.SS2.p2.m1" class="ltx_Math" alttext="h_{\mathrm{gum},0.05}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>gum</mi><mo>,</mo><mn>0.05</mn></mrow></msub><annotation encoding="application/x-tex">h_{\mathrm{gum},0.05}</annotation></semantics></math> and <math id="S6.SS2.p2.m2" class="ltx_Math" alttext="h_{\mathrm{dif},0.1}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>dif</mi><mo>,</mo><mn>0.1</mn></mrow></msub><annotation encoding="application/x-tex">h_{\mathrm{dif},0.1}</annotation></semantics></math> are the two methods proposed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>, while <math id="S6.SS2.p2.m3" class="ltx_Math" alttext="h_{\mathrm{ars}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>ars</mi></msub><annotation encoding="application/x-tex">h_{\mathrm{ars}}</annotation></semantics></math> and <math id="S6.SS2.p2.m4" class="ltx_Math" alttext="h_{\mathrm{neg}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>neg</mi></msub><annotation encoding="application/x-tex">h_{\mathrm{neg}}</annotation></semantics></math> serve as baseline scores introduced in their original works <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">1</a>, <a href="#bib.bib24" title="" class="ltx_ref">24</a>]</cite>.
Across most scenarios, all detection methods maintain Type I errors between 0.006 and 0.014, closely aligning with the nominal 0.01 level.
This result is consistent with expectations, as the deduplicated pivotal statistics can be regarded as i.i.d., allowing conventional detection methods to remain effective — a phenomenon also observed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>, <a href="#bib.bib50" title="" class="ltx_ref">50</a>]</cite>.
To further demonstrate the advantage of our new framework, we consider two approaches for computing the <math id="S6.SS2.p2.m5" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>-values for each minimal unit.
The first, denoted as “oracle,” uses the ground-truth NTP distributions to compute the regularity level <math id="S6.SS2.p2.m6" class="ltx_Math" alttext="\Delta_{{\mathcal{V}}}=1-\max_{t\in{\mathcal{V}}}\max_{{w}}P_{t,{w}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><msub><mi>max</mi><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mi>w</mi></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><mi>w</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{{\mathcal{V}}}=1-\max_{t\in{\mathcal{V}}}\max_{{w}}P_{t,{w}}</annotation></semantics></math> for the minimal unit <math id="S6.SS2.p2.m7" class="ltx_Math" alttext="{\mathcal{V}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">{\mathcal{V}}</annotation></semantics></math>.
Since the ground-truth NTP distributions are inaccessible in practice, we introduce a practical surrogate: for a given text, we feed it directly into the detection model (OPT-1.3B in our setup) and autoregressively estimate the NTP distributions.
Although this surrogate approximation omits the preceding context and initial prompt, it still yields a reasonably accurate estimate of <math id="S6.SS2.p2.m8" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>. See the red solid curve for <math id="S6.SS2.p2.m9" class="ltx_Math" alttext="h_{\mathrm{new}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>new</mi></msub><annotation encoding="application/x-tex">h_{\mathrm{new}}</annotation></semantics></math> “sur”.
Remarkably, even with this rough approximation, our proposed methods consistently outperform previous state-of-the-art approaches.
Furthermore, when oracle <math id="S6.SS2.p2.m10" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>-values are available, our methods demonstrate a clear and substantial advantage, underscoring the effectiveness of our framework in adaptively selecting <math id="S6.SS2.p2.m11" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> for each minimal unit.</p>
</div>
</section>
</section>
<section id="S7" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">7 </span>Proof of Main Results</h2>

<div id="S7.p1" class="ltx_para">
<p id="S7.p1.1" class="ltx_p">In this section, we provide proof sketches for Theorems <a href="#S4.Thmthm1" title="Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> and <a href="#S5.Thmtheorem2" title="Theorem 5.2. ‣ 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>, with the proofs of technical lemmas deferred to the Supplementary Material.</p>
</div>
<section id="S7.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.1 </span>Proof of Theorem <a href="#S4.Thmthm1" title="Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a></h3>

<div id="S7.SS1.p1" class="ltx_para">
<p id="S7.SS1.p1.1" class="ltx_p">Fix a minimal unit <math id="S7.SS1.p1.m1" class="ltx_Math" alttext="{\mathcal{V}}=\{t_{1},\dots,t_{k}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{V}}=\{t_{1},\dots,t_{k}\}</annotation></semantics></math> and, without loss of generality, let <math id="S7.SS1.p1.m2" class="ltx_Math" alttext="Y_{{\mathcal{V}}}:=Y_{t_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>:=</mo><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">Y_{{\mathcal{V}}}:=Y_{t_{1}}</annotation></semantics></math>. To facilitate analysis, we reparameterize the alternative distribution <math id="S7.SS1.p1.m3" class="ltx_Math" alttext="F_{{\bm{S}}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>𝑺</mi></msub><annotation encoding="application/x-tex">F_{{\bm{S}}}</annotation></semantics></math> of <math id="S7.SS1.p1.m4" class="ltx_Math" alttext="Y_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">Y_{{\mathcal{V}}}</annotation></semantics></math> in terms of a vector <math id="S7.SS1.p1.m5" class="ltx_Math" alttext="{\bm{S}}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">{\bm{S}}</annotation></semantics></math> rather than the original NTP distributions <math id="S7.SS1.p1.m6" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}</annotation></semantics></math>. This step is motivated by the fact that, as shown in Lemma <a href="#S4.Thmlem1" title="Lemma 4.1. ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, the mapping <math id="S7.SS1.p1.m7" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}\mapsto F_{{\bm{S}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">↦</mo><msub><mi>F</mi><mi>𝑺</mi></msub></mrow><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}\mapsto F_{{\bm{S}}}</annotation></semantics></math> is non-convex, making direct optimization over <math id="S7.SS1.p1.m8" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}</annotation></semantics></math> intractable. In contrast, the mapping <math id="S7.SS1.p1.m9" class="ltx_Math" alttext="{\bm{S}}\mapsto F_{{\bm{S}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑺</mi><mo stretchy="false">↦</mo><msub><mi>F</mi><mi>𝑺</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{S}}\mapsto F_{{\bm{S}}}</annotation></semantics></math> yields a much simpler structure that is more amenable to analysis.
Specifically, under this parameterization, the alternative distribution takes the form <math id="S7.SS1.p1.m10" class="ltx_Math" alttext="F_{{\bm{S}}}(y)=\sum_{w}\frac{S_{w}y^{1/S_{w}}}{\sum_{w^{\prime}}S_{w^{\prime}}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>w</mi></msub><mfrac><mrow><msub><mi>S</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mrow><mn>1</mn><mo>/</mo><msub><mi>S</mi><mi>w</mi></msub></mrow></msup></mrow><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><msup><mi>w</mi><mo>′</mo></msup></msub></mstyle><msub><mi>S</mi><msup><mi>w</mi><mo>′</mo></msup></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">F_{{\bm{S}}}(y)=\sum_{w}\frac{S_{w}y^{1/S_{w}}}{\sum_{w^{\prime}}S_{w^{\prime}}}</annotation></semantics></math>, where each <math id="S7.SS1.p1.m11" class="ltx_Math" alttext="S_{w}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>w</mi></msub><annotation encoding="application/x-tex">S_{w}</annotation></semantics></math> is a nonlinear transformation of <math id="S7.SS1.p1.m12" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}</annotation></semantics></math> (see (<a href="#S4.E13" title="In Lemma 4.1. ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>)).</p>
</div>
<div id="S7.SS1.p2" class="ltx_para">
<p id="S7.SS1.p2.1" class="ltx_p">With this reparameterization, we revisit the minimax problem in (<a href="#S3.E10" title="In Optimality via minimax optimization. ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>), which now is expressed as</p>
<table id="S7.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E25.m1" class="ltx_math_unparsed" alttext="L(h,{\bm{S}})=\EB_{0}[h(Y_{t_{1}})]+\log\EB_{F_{\bm{S}}}[{\mathrm{e}}^{-h(Y_{t_{1}})}]=\int h(y)F_{0}({\mathrm{d}}y)+\log\int{\mathrm{e}}^{-h(y)}F_{{\bm{S}}}({\mathrm{d}}y)," display="block" intent=":literal"><semantics><mrow><mi>L</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>𝑺</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mn>0</mn></msub><mrow><mo stretchy="false">[</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>log</mi><msub><mi>𝔼</mi><msub><mi>F</mi><mi>𝐒</mi></msub></msub><mrow><mo stretchy="false">[</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo stretchy="false">]</mo></mrow><mo rspace="0.111em">=</mo><mo>∫</mo><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><msub><mi>F</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>dy</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>log</mi><mo>∫</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><msub><mi>F</mi><mi>𝐒</mi></msub><mrow><mo stretchy="false">(</mo><mi>dy</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">L(h,{\bm{S}})=\EB_{0}[h(Y_{t_{1}})]+\log\EB_{F_{\bm{S}}}[{\mathrm{e}}^{-h(Y_{t_{1}})}]=\int h(y)F_{0}({\mathrm{d}}y)+\log\int{\mathrm{e}}^{-h(y)}F_{{\bm{S}}}({\mathrm{d}}y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="S7.SS1.p2.2" class="ltx_p">where <math id="S7.SS1.p2.m1" class="ltx_Math" alttext="F_{0}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>0</mn></msub><annotation encoding="application/x-tex">F_{0}</annotation></semantics></math> and <math id="S7.SS1.p2.m2" class="ltx_Math" alttext="F_{{\bm{S}}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>𝑺</mi></msub><annotation encoding="application/x-tex">F_{{\bm{S}}}</annotation></semantics></math> denote the null and alternative distributions of <math id="S7.SS1.p2.m3" class="ltx_Math" alttext="Y_{t_{1}}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">Y_{t_{1}}</annotation></semantics></math>, respectively.</p>
</div>
<div id="S7.SS1.p3" class="ltx_para">
<p id="S7.SS1.p3.1" class="ltx_p">Let <math id="S7.SS1.p3.m1" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}</annotation></semantics></math> denote the set of all feasible <math id="S7.SS1.p3.m2" class="ltx_Math" alttext="{\bm{S}}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">{\bm{S}}</annotation></semantics></math> vectors induced by <math id="S7.SS1.p3.m3" class="ltx_Math" alttext="\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">\bm{P}_{{\mathcal{V}}}\subseteq{\mathcal{P}}_{\Delta}</annotation></semantics></math>. Our goal is reduced to identify a saddle point pair <math id="S7.SS1.p3.m4" class="ltx_Math" alttext="(h^{\star},{\bm{S}}^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi>𝑺</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h^{\star},{\bm{S}}^{\star})</annotation></semantics></math> that solves the following minimax problem:</p>
<table id="S7.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E26.m1" class="ltx_math_unparsed" alttext="\displaystyle\min_{h}\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}L(h,{\bm{S}})=\int h(y)F_{0}({\mathrm{d}}y)+\log\int{\mathrm{e}}^{-h(y)}F_{{\bm{S}}}({\mathrm{d}}y)." display="inline" intent=":literal"><semantics><mrow><munder><mi>min</mi><mi>h</mi></munder><munder><mi>max</mi><mrow><mi>𝑺</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow></munder><mi>L</mi><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>𝑺</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><msub><mi>F</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><mi>d</mi><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>log</mi><mstyle displaystyle="true"><mo>∫</mo></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><msub><mi>F</mi><mi>𝑺</mi></msub><mrow><mo stretchy="false">(</mo><mi>d</mi><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\min_{h}\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}L(h,{\bm{S}})=\int h(y)F_{0}({\mathrm{d}}y)+\log\int{\mathrm{e}}^{-h(y)}F_{{\bm{S}}}({\mathrm{d}}y).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
</div>
<div id="S7.SS1.p4" class="ltx_para">
<p id="S7.SS1.p4.1" class="ltx_p">The function <math id="S7.SS1.p4.m1" class="ltx_Math" alttext="L(h,{\bm{S}})" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>𝑺</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(h,{\bm{S}})</annotation></semantics></math> is convex in the score function <math id="S7.SS1.p4.m2" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> for a fixed <math id="S7.SS1.p4.m3" class="ltx_Math" alttext="{\bm{S}}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">{\bm{S}}</annotation></semantics></math>, but generally not concave or convex in <math id="S7.SS1.p4.m4" class="ltx_Math" alttext="{\bm{S}}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">{\bm{S}}</annotation></semantics></math> when <math id="S7.SS1.p4.m5" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> is fixed and <math id="S7.SS1.p4.m6" class="ltx_Math" alttext="|{\mathcal{V}}|&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|{\mathcal{V}}|&gt;1</annotation></semantics></math>. As a result, this renders standard minimax tools unusable, and so even the existence of a solution is not guaranteed. We begin by characterizing when a saddle point solution exists in Lemma <a href="#S7.Thmlem1" title="Lemma 7.1 (Necessity of optimal score functions). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>.</p>
</div>
<div id="S7.Thmlem1" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmlem1.2" class="ltx_text ltx_font_bold">Lemma 7.1</span></span><span id="S7.Thmlem1.3" class="ltx_text ltx_font_bold"> </span>(Necessity of optimal score functions)<span id="S7.Thmlem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmlem1.p1" class="ltx_para">
<p id="S7.Thmlem1.p1.1" class="ltx_p"><span id="S7.Thmlem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmlem1.p1.m1" class="ltx_Math" alttext="h_{\bm{S}}=\log({\mathrm{d}}F_{\bm{S}}/{\mathrm{d}}y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>𝐒</mi></msub><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi mathvariant="normal">d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>𝐒</mi></msub></mrow><mo>/</mo><mi mathvariant="normal">d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{\bm{S}}=\log({\mathrm{d}}F_{\bm{S}}/{\mathrm{d}}y)</annotation></semantics></math> denote the loglikelihood ratio with respect to the alternative distribution <math id="S7.Thmlem1.p1.m2" class="ltx_Math" alttext="F_{\bm{S}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>𝐒</mi></msub><annotation encoding="application/x-tex">F_{\bm{S}}</annotation></semantics></math>.
The saddle point pair <math id="S7.Thmlem1.p1.m3" class="ltx_Math" alttext="(h^{\star},{\bm{S}}^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi>𝐒</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h^{\star},{\bm{S}}^{\star})</annotation></semantics></math> solves the minimax problem (<a href="#S7.E26" title="In 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) if and only if there exists a vector <math id="S7.Thmlem1.p1.m4" class="ltx_Math" alttext="{\bm{S}}^{\star}\in{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐒</mi><mo>⋆</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{S}}^{\star}\in{\mathcal{D}}_{\Delta}</annotation></semantics></math> such that <math id="S7.Thmlem1.p1.m5" class="ltx_Math" alttext="h^{\star}=h_{{\bm{S}}^{\star}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mo>⋆</mo></msup><mo>=</mo><msub><mi>h</mi><msup><mi>𝐒</mi><mo>⋆</mo></msup></msub></mrow><annotation encoding="application/x-tex">h^{\star}=h_{{\bm{S}}^{\star}}</annotation></semantics></math> and</span></p>
<table id="S7.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E27.m1" class="ltx_Math" alttext="\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}L(h_{{\bm{S}}^{\star}},{\bm{S}})=L(h_{{\bm{S}}^{\star}},{\bm{S}}^{\star})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>max</mi><mrow><mi>𝑺</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msup><mi>𝑺</mi><mo>⋆</mo></msup></msub><mo>,</mo><mi>𝑺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msup><mi>𝑺</mi><mo>⋆</mo></msup></msub><mo>,</mo><msup><mi>𝑺</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}L(h_{{\bm{S}}^{\star}},{\bm{S}})=L(h_{{\bm{S}}^{\star}},{\bm{S}}^{\star}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="S7.Thmlem1.p1.2" class="ltx_p"><span id="S7.Thmlem1.p1.2.1" class="ltx_text ltx_font_italic">The optimal objective value is <math id="S7.Thmlem1.p1.m6" class="ltx_math_unparsed" alttext="-\mathrm{KL}(F_{0}\|F_{{\bm{S}}^{\star}})" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>F</mi><msup><mi>𝐒</mi><mo>⋆</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">-\mathrm{KL}(F_{0}\|F_{{\bm{S}}^{\star}})</annotation></semantics></math> where <math id="S7.Thmlem1.p1.m7" class="ltx_Math" alttext="F_{0}={U}(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{0}={U}(0,1)</annotation></semantics></math> for the Gumbel-max watermark.</span></p>
</div>
</div>
<div id="S7.SS1.p5" class="ltx_para">
<p id="S7.SS1.p5.1" class="ltx_p">Lemma <a href="#S7.Thmlem1" title="Lemma 7.1 (Necessity of optimal score functions). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a> implies that any optimal score function corresponding to a saddle point pair must be of the log-likelihood ratio form <math id="S7.SS1.p5.m1" class="ltx_Math" alttext="h_{{\bm{S}}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>𝑺</mi></msub><annotation encoding="application/x-tex">h_{{\bm{S}}}</annotation></semantics></math> for some <math id="S7.SS1.p5.m2" class="ltx_Math" alttext="{\bm{S}}\in{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><mi>𝑺</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{S}}\in{\mathcal{D}}_{\Delta}</annotation></semantics></math>, and that such functions are always non-decreasing from Lemma <a href="#S4.Thmlem1" title="Lemma 4.1. ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>. Hence, it suffices to restrict our attention to non-decreasing <math id="S7.SS1.p5.m3" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>. A similar approach is used in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>, but while their feasible domain <math id="S7.SS1.p5.m4" class="ltx_Math" alttext="{\mathcal{P}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{P}}_{\Delta}</annotation></semantics></math> is straightforward, our domain <math id="S7.SS1.p5.m5" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}</annotation></semantics></math> is substantially more complex, as shown in Lemma <a href="#S7.Thmlem2" title="Lemma 7.2 (Properties of the domain 𝒟_Δ). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>.</p>
</div>
<div id="S7.Thmlem2" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmlem2.2" class="ltx_text ltx_font_bold">Lemma 7.2</span></span><span id="S7.Thmlem2.3" class="ltx_text ltx_font_bold"> </span>(Properties of the domain <math id="S7.Thmlem2.m1" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}</annotation></semantics></math>)<span id="S7.Thmlem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmlem2.p1" class="ltx_para">
<p id="S7.Thmlem2.p1.1" class="ltx_p"><math id="S7.Thmlem2.p1.m1" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}</annotation></semantics></math><span id="S7.Thmlem2.p1.1.1" class="ltx_text ltx_font_italic"> is a permutation-invariant set.<span id="footnote6" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">6</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">6</sup>
                  <span class="ltx_tag ltx_tag_note"><span id="footnote6.1" class="ltx_text ltx_font_upright">6</span></span>
                  
                  
                  
                <span id="footnote6.6" class="ltx_text ltx_font_upright">It means that for any permutation </span><math id="footnote6.m1" class="ltx_Math" alttext="\pi\in\mathrm{Perm}({{\mathcal{W}}})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><mrow><mi>Perm</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi\in\mathrm{Perm}({{\mathcal{W}}})</annotation></semantics></math><span id="footnote6.7" class="ltx_text ltx_font_upright">, the permuted vector </span><math id="footnote6.m2" class="ltx_Math" alttext="\pi({\bm{S}}):=(S_{\pi(w)})_{w\in{{\mathcal{W}}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐒</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>w</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\pi({\bm{S}}):=(S_{\pi(w)})_{w\in{{\mathcal{W}}}}</annotation></semantics></math><span id="footnote6.8" class="ltx_text ltx_font_upright"> also belongs to </span><math id="footnote6.m3" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}</annotation></semantics></math><span id="footnote6.9" class="ltx_text ltx_font_upright">.</span></span></span></span>
For any <math id="S7.Thmlem2.p1.m2" class="ltx_Math" alttext="{\bm{S}}=(S_{w})_{w\in{{\mathcal{W}}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐒</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>w</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{S}}=(S_{w})_{w\in{{\mathcal{W}}}}</annotation></semantics></math> in <math id="S7.Thmlem2.p1.m3" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}</annotation></semantics></math>, it follows that </span>(i)<span id="S7.Thmlem2.p1.1.2" class="ltx_text ltx_font_italic"> <math id="S7.Thmlem2.p1.m4" class="ltx_Math" alttext="0\leq S_{w}\leq 1-\Delta" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msub><mi>S</mi><mi>w</mi></msub><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><annotation encoding="application/x-tex">0\leq S_{w}\leq 1-\Delta</annotation></semantics></math> for any <math id="S7.Thmlem2.p1.m5" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>, </span>(ii)<span id="S7.Thmlem2.p1.1.3" class="ltx_text ltx_font_italic"> <math id="S7.Thmlem2.p1.m6" class="ltx_Math" alttext="\sum_{w}S_{w}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>w</mi></msub><msub><mi>S</mi><mi>w</mi></msub></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{w}S_{w}\leq 1</annotation></semantics></math>, </span>(iii)<span id="S7.Thmlem2.p1.1.4" class="ltx_text ltx_font_italic"> <math id="S7.Thmlem2.p1.m7" class="ltx_Math" alttext="\frac{\max_{w}S_{w}}{1-\Delta}\leq 1-\frac{1-\sum_{w}S_{w}}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><msub><mi>max</mi><mi>w</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>S</mi><mi>w</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow></mfrac><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mi>w</mi></msub></mstyle><msub><mi>S</mi><mi>w</mi></msub></mrow></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\frac{\max_{w}S_{w}}{1-\Delta}\leq 1-\frac{1-\sum_{w}S_{w}}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|}</annotation></semantics></math>, and </span>(iv)<span id="S7.Thmlem2.p1.1.5" class="ltx_text ltx_font_italic"> <math id="S7.Thmlem2.p1.m8" class="ltx_Math" alttext="{\bm{S}}_{\Delta}^{\star}:=(\frac{1-\Delta}{1+\frac{\Delta}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1}},0,\cdots,0)\in{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐒</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo>:=</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mrow><mn>1</mn><mo>+</mo><mfrac><mi mathvariant="normal">Δ</mi><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mfrac><mo>,</mo><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{S}}_{\Delta}^{\star}:=(\frac{1-\Delta}{1+\frac{\Delta}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1}},0,\cdots,0)\in{\mathcal{D}}_{\Delta}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS1.p6" class="ltx_para">
<p id="S7.SS1.p6.1" class="ltx_p">Now, solving the minimax problem (<a href="#S7.E26" title="In 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) reduces to identifying a feasible vector <math id="S7.SS1.p6.m1" class="ltx_Math" alttext="{\bm{S}}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝑺</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">{\bm{S}}^{\star}</annotation></semantics></math> that satisfies condition (<a href="#S7.E27" title="In Lemma 7.1 (Necessity of optimal score functions). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>). This requires understanding both (i) the geometry of the feasible domain <math id="S7.SS1.p6.m2" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}</annotation></semantics></math> and (ii) how to achieve the maximum in the mapping <math id="S7.SS1.p6.m3" class="ltx_Math" alttext="{\bm{S}}\mapsto\EB_{F_{{\bm{S}}}}[{\mathrm{e}}^{-h(Y_{t_{1}})}]=\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)" display="inline" intent=":literal"><semantics><mrow><mi>𝑺</mi><mo stretchy="false">↦</mo><mrow><msub><mi>𝔼</mi><msub><mi>F</mi><mi>𝐒</mi></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><msub><mi>t</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>𝐒</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>dy</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{S}}\mapsto\EB_{F_{{\bm{S}}}}[{\mathrm{e}}^{-h(Y_{t_{1}})}]=\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)</annotation></semantics></math> for any fixed <math id="S7.SS1.p6.m4" class="ltx_Math" alttext="y\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">y\in[0,1]</annotation></semantics></math> and a given function <math id="S7.SS1.p6.m5" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>.
The first issue is addressed in detail in Lemma <a href="#S7.Thmlem2" title="Lemma 7.2 (Properties of the domain 𝒟_Δ). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>, while the second issue can be approached by noting that the mapping is <em id="S7.SS1.p6.1.1" class="ltx_emph ltx_font_italic">Schur-convex</em> in <math id="S7.SS1.p6.m6" class="ltx_Math" alttext="{\bm{S}}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">{\bm{S}}</annotation></semantics></math>. In principle, the maximum of a Schur-convex function over a permutation-invariant domain typically occurs at its boundary.
Hence, both Lemmas <a href="#S7.Thmlem2" title="Lemma 7.2 (Properties of the domain 𝒟_Δ). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> and <a href="#S7.Thmlem3" title="Lemma 7.3 (Schur-convexity). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a> assist in solving the inner maximization problem in (<a href="#S7.E26" title="In 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>).</p>
</div>
<div id="S7.Thmdefn1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmdefn1.2" class="ltx_text ltx_font_bold">Definition 7.1</span></span><span id="S7.Thmdefn1.3" class="ltx_text ltx_font_bold"> </span>(Schur-convexity)<span id="S7.Thmdefn1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmdefn1.p1" class="ltx_para">
<p id="S7.Thmdefn1.p1.1" class="ltx_p"><span id="S7.Thmdefn1.p1.1.1" class="ltx_text ltx_font_italic">A function <math id="S7.Thmdefn1.p1.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is Schur-convex if it is isotonic and preserves order. Specifically, if <math id="S7.Thmdefn1.p1.m2" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math> is majorized by <math id="S7.Thmdefn1.p1.m3" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math>, denoted by, <math id="S7.Thmdefn1.p1.m4" class="ltx_math_unparsed" alttext="{\bm{x}}\leq_{m}{\bm{y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>≤</mo><msub><mrow></mrow><mi>m</mi></msub><mi>𝐲</mi></mrow><annotation encoding="application/x-tex">{\bm{x}}\leq_{m}{\bm{y}}</annotation></semantics></math>, then it must satisfy <math id="S7.Thmdefn1.p1.m5" class="ltx_Math" alttext="F({\bm{x}})\leq F({\bm{y}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F({\bm{x}})\leq F({\bm{y}})</annotation></semantics></math>.
For two vectors <math id="S7.Thmdefn1.p1.m6" class="ltx_Math" alttext="{\bm{x}},{\bm{y}}\in{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{x}},{\bm{y}}\in{\mathbb{R}}^{d}</annotation></semantics></math>, <math id="S7.Thmdefn1.p1.m7" class="ltx_math_unparsed" alttext="{\bm{x}}\leq_{m}{\bm{y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>≤</mo><msub><mrow></mrow><mi>m</mi></msub><mi>𝐲</mi></mrow><annotation encoding="application/x-tex">{\bm{x}}\leq_{m}{\bm{y}}</annotation></semantics></math> if and only if </span>(i)<span id="S7.Thmdefn1.p1.1.2" class="ltx_text ltx_font_italic"> <math id="S7.Thmdefn1.p1.m8" class="ltx_Math" alttext="\sum_{i=1}^{k}y_{(i)}\geq\sum_{i=1}^{k}x_{(i)}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><msub><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo rspace="0.111em">≥</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><msub><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{k}y_{(i)}\geq\sum_{i=1}^{k}x_{(i)}</annotation></semantics></math> for all <math id="S7.Thmdefn1.p1.m9" class="ltx_Math" alttext="k=1,2,\ldots,d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">k=1,2,\ldots,d</annotation></semantics></math> with <math id="S7.Thmdefn1.p1.m10" class="ltx_Math" alttext="y_{(1)}\geq\ldots\geq y_{(d)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo>≥</mo><mi mathvariant="normal">…</mi><mo>≥</mo><msub><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">y_{(1)}\geq\ldots\geq y_{(d)}</annotation></semantics></math> and <math id="S7.Thmdefn1.p1.m11" class="ltx_Math" alttext="x_{(1)}\geq\ldots\geq x_{(d)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo>≥</mo><mi mathvariant="normal">…</mi><mo>≥</mo><msub><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">x_{(1)}\geq\ldots\geq x_{(d)}</annotation></semantics></math> the ordered entries and </span>(ii)<span id="S7.Thmdefn1.p1.1.3" class="ltx_text ltx_font_italic"> <math id="S7.Thmdefn1.p1.m12" class="ltx_Math" alttext="\sum_{i=1}^{d}x_{i}=\sum_{i=1}^{d}y_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><msub><mi>x</mi><mi>i</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><msub><mi>y</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{d}x_{i}=\sum_{i=1}^{d}y_{i}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.Thmlem3" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmlem3.2" class="ltx_text ltx_font_bold">Lemma 7.3</span></span><span id="S7.Thmlem3.3" class="ltx_text ltx_font_bold"> </span>(Schur-convexity)<span id="S7.Thmlem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmlem3.p1" class="ltx_para">
<p id="S7.Thmlem3.p1.1" class="ltx_p"><span id="S7.Thmlem3.p1.1.1" class="ltx_text ltx_font_italic">For any non-decresing function <math id="S7.Thmlem3.p1.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>, the map <math id="S7.Thmlem3.p1.m2" class="ltx_Math" alttext="{\bm{S}}\mapsto\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)" display="inline" intent=":literal"><semantics><mrow><mi>𝐒</mi><mo rspace="0.111em" stretchy="false">↦</mo><mrow><mo>∫</mo><mrow><msup><mi mathvariant="normal">e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>𝐒</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{S}}\mapsto\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)</annotation></semantics></math> is Schur-convex in <math id="S7.Thmlem3.p1.m3" class="ltx_Math" alttext="{\bm{S}}" display="inline" intent=":literal"><semantics><mi>𝐒</mi><annotation encoding="application/x-tex">{\bm{S}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.Thmlem4" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmlem4.2" class="ltx_text ltx_font_bold">Lemma 7.4</span></span><span id="S7.Thmlem4.3" class="ltx_text ltx_font_bold"> </span>(Reduced domain)<span id="S7.Thmlem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmlem4.p1" class="ltx_para">
<p id="S7.Thmlem4.p1.1" class="ltx_p"><span id="S7.Thmlem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmlem4.p1.m1" class="ltx_Math" alttext="{\mathcal{H}}_{\Delta}=\{{\bm{S}}:\frac{1-\Delta}{1+\frac{\Delta}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1}}\leq\sum_{w}S_{w}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>𝐒</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mrow><mn>1</mn><mo>+</mo><mfrac><mi mathvariant="normal">Δ</mi><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mfrac><mo rspace="0.111em">≤</mo><mrow><msub><mo>∑</mo><mi>w</mi></msub><msub><mi>S</mi><mi>w</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{H}}_{\Delta}=\{{\bm{S}}:\frac{1-\Delta}{1+\frac{\Delta}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1}}\leq\sum_{w}S_{w}\}</annotation></semantics></math> be a half-space.
For any non-decreasing function <math id="S7.Thmlem4.p1.m2" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>,</span></p>
<table id="S7.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex13.m1" class="ltx_Math" alttext="\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)=\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}}\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mmultiscripts><mo>∫</mo><mprescripts></mprescripts><mrow><mi>𝑺</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow><mrow></mrow></mmultiscripts><mo>⁡</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mmultiscripts><mo>∫</mo><mprescripts></mprescripts><mrow><mi>𝑺</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>⁡</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)=\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}}\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S7.SS1.p7" class="ltx_para">
<p id="S7.SS1.p7.1" class="ltx_p">Moreover, Lemma <a href="#S7.Thmlem4" title="Lemma 7.4 (Reduced domain). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.4</span></a> shows that the maximum of the objective over the domain <math id="S7.SS1.p7.m1" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}</annotation></semantics></math> always lies within the half-space <math id="S7.SS1.p7.m2" class="ltx_Math" alttext="{\mathcal{H}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{\Delta}</annotation></semantics></math>. Consequently, any points in <math id="S7.SS1.p7.m3" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}\setminus{\mathcal{H}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}\setminus{\mathcal{H}}_{\Delta}</annotation></semantics></math> are suboptimal and can be safely excluded from consideration.
This reduction allows us to focus on the reduced domain <math id="S7.SS1.p7.m4" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}</annotation></semantics></math>. To proceed with the proof, we aim to characterize its convex envelope, which provides a tractable outer approximation while preserving all potential maximizers of the objective.</p>
</div>
<div id="S7.Thmlem5" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmlem5.2" class="ltx_text ltx_font_bold">Lemma 7.5</span></span><span id="S7.Thmlem5.3" class="ltx_text ltx_font_bold"> </span>(Convex envelope of <math id="S7.Thmlem5.m1" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}</annotation></semantics></math>)<span id="S7.Thmlem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmlem5.p1" class="ltx_para">
<p id="S7.Thmlem5.p1.1" class="ltx_p"><span id="S7.Thmlem5.p1.1.1" class="ltx_text ltx_font_italic">We define new sets <math id="S7.Thmlem5.p1.m1" class="ltx_Math" alttext="{\mathcal{K}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{K}}_{\Delta}</annotation></semantics></math> and <math id="S7.Thmlem5.p1.m2" class="ltx_Math" alttext="{\mathcal{E}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\Delta}</annotation></semantics></math> by</span></p>
<table id="S7.EGx15" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S7.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex14.m1" class="ltx_math_unparsed" alttext="\displaystyle{\mathcal{K}}_{\Delta}=\left\{{\bm{S}}:\forall w,0\leq S_{w}\leq 1-\Delta,~\frac{1-\Delta}{1+\frac{\Delta}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1}}\leq\sum_{w}S_{w}\leq 1~\text{and}~\frac{\max_{w}S_{w}}{1-\Delta}\leq 1-\frac{1-\sum_{w}S_{w}}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|}\right\}," display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub><mo>=</mo><mrow><mo>{</mo><mi>𝑺</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mo rspace="0.167em">∀</mo><mi>w</mi><mo>,</mo><mn>0</mn><mo>≤</mo><msub><mi>S</mi><mi>w</mi></msub><mo>≤</mo><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi><mo rspace="0.497em">,</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mrow><mn>1</mn><mo>+</mo><mfrac><mi mathvariant="normal">Δ</mi><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mfrac><mo rspace="0.111em">≤</mo><munder><mo movablelimits="false">∑</mo><mi>w</mi></munder><msub><mi>S</mi><mi>w</mi></msub><mo>≤</mo><mn>1</mn><mtext class="ltx_mathvariant_italic">and</mtext><mfrac><mrow><msub><mi>max</mi><mi>w</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi>S</mi><mi>w</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow></mfrac><mo>≤</mo><mn>1</mn><mo>−</mo><mfrac><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mi>w</mi></msub><msub><mi>S</mi><mi>w</mi></msub></mrow></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac><mo>}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{K}}_{\Delta}=\left\{{\bm{S}}:\forall w,0\leq S_{w}\leq 1-\Delta,~\frac{1-\Delta}{1+\frac{\Delta}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1}}\leq\sum_{w}S_{w}\leq 1~\text{and}~\frac{\max_{w}S_{w}}{1-\Delta}\leq 1-\frac{1-\sum_{w}S_{w}}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|}\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex15.m1" class="ltx_math_unparsed" alttext="\displaystyle{\mathcal{E}}_{\Delta}:=\{\pi(\bm{P}_{\Delta}^{\star}),\pi({\bm{S}}_{\Delta}^{\star}),~\forall\pi\in\mathrm{Perm}({{\mathcal{W}}})\}," display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi mathvariant="normal">Δ</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0.497em">,</mo><mo rspace="0.167em">∀</mo><mi>π</mi><mo>∈</mo><mi>Perm</mi><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{E}}_{\Delta}:=\{\pi(\bm{P}_{\Delta}^{\star}),\pi({\bm{S}}_{\Delta}^{\star}),~\forall\pi\in\mathrm{Perm}({{\mathcal{W}}})\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmlem5.p1.2" class="ltx_p"><span id="S7.Thmlem5.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S7.Thmlem5.p1.m3" class="ltx_Math" alttext="\bm{P}_{\Delta}^{\star}:=\left(1-\Delta,\Delta,0,\cdots,0\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo>:=</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mo>,</mo><mi mathvariant="normal">Δ</mi><mo>,</mo><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{P}_{\Delta}^{\star}:=\left(1-\Delta,\Delta,0,\cdots,0\right)</annotation></semantics></math> and <math id="S7.Thmlem5.p1.m4" class="ltx_Math" alttext="{\bm{S}}_{\Delta}^{\star}:=(\frac{1-\Delta}{1+\frac{\Delta}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1}},0,\cdots,0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐒</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo>:=</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mrow><mn>1</mn><mo>+</mo><mfrac><mi mathvariant="normal">Δ</mi><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mfrac><mo>,</mo><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{S}}_{\Delta}^{\star}:=(\frac{1-\Delta}{1+\frac{\Delta}{|{\mathcal{V}}|\wedge|{{\mathcal{W}}}|-1}},0,\cdots,0)</annotation></semantics></math>.
With <math id="S7.Thmlem5.p1.m5" class="ltx_Math" alttext="\Delta\in(0,0.5]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0.5</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\in(0,0.5]</annotation></semantics></math>, then</span></p>
<ol id="S7.I1" class="ltx_enumerate">
<li id="S7.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S7.I1.i1.p1" class="ltx_para">
<p id="S7.I1.i1.p1.1" class="ltx_p"><math id="S7.I1.i1.p1.m1" class="ltx_Math" alttext="{\mathcal{K}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{K}}_{\Delta}</annotation></semantics></math><span id="S7.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> is a convex polyhedron with extreme points given by </span><math id="S7.I1.i1.p1.m2" class="ltx_Math" alttext="{\mathcal{E}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\Delta}</annotation></semantics></math><span id="S7.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">, that is, </span><math id="S7.I1.i1.p1.m3" class="ltx_Math" alttext="{\mathcal{K}}_{\Delta}=\mathrm{conv}({\mathcal{E}}_{\Delta})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub><mo>=</mo><mrow><mi>conv</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi mathvariant="normal">Δ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{K}}_{\Delta}=\mathrm{conv}({\mathcal{E}}_{\Delta})</annotation></semantics></math><span id="S7.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S7.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S7.I1.i2.p1" class="ltx_para">
<p id="S7.I1.i2.p1.1" class="ltx_p"><math id="S7.I1.i2.p1.m1" class="ltx_Math" alttext="{\mathcal{E}}_{\Delta}\subseteq{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi mathvariant="normal">Δ</mi></msub><mo>⊆</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{\Delta}\subseteq{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}</annotation></semantics></math><span id="S7.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S7.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S7.I1.i3.p1" class="ltx_para">
<p id="S7.I1.i3.p1.1" class="ltx_p"><math id="S7.I1.i3.p1.m1" class="ltx_Math" alttext="{\mathcal{K}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{K}}_{\Delta}</annotation></semantics></math><span id="S7.I1.i3.p1.1.1" class="ltx_text ltx_font_italic"> is the convex envelop of </span><math id="S7.I1.i3.p1.m2" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}</annotation></semantics></math><span id="S7.I1.i3.p1.1.2" class="ltx_text ltx_font_italic">, that is, </span><math id="S7.I1.i3.p1.m3" class="ltx_Math" alttext="{\mathcal{K}}_{\Delta}=\mathrm{conv}({\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub><mo>=</mo><mrow><mi>conv</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{K}}_{\Delta}=\mathrm{conv}({\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta})</annotation></semantics></math><span id="S7.I1.i3.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S7.SS1.p8" class="ltx_para">
<p id="S7.SS1.p8.1" class="ltx_p">By Lemma <a href="#S7.Thmlem5" title="Lemma 7.5 (Convex envelope of 𝒟_Δ∩ℋ_Δ). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>, the convex envelope of <math id="S7.SS1.p8.m1" class="ltx_Math" alttext="{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{D}}_{\Delta}\cap{\mathcal{H}}_{\Delta}</annotation></semantics></math> is characterized by <math id="S7.SS1.p8.m2" class="ltx_Math" alttext="{\mathcal{K}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{K}}_{\Delta}</annotation></semantics></math>, which forms a convex polyhedron whose extreme points are explicitly known. This structure enables the inner maximization to be reduced to a binary comparison, leveraging permutation invariance and Schur-convexity. In particular, Lemma <a href="#S7.Thmlem6" title="Lemma 7.6 (Maximum over polyhedron). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.6</span></a> shows that maximizing over this relaxed domain <math id="S7.SS1.p8.m3" class="ltx_Math" alttext="{\mathcal{K}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{K}}_{\Delta}</annotation></semantics></math> is straightforward.</p>
</div>
<div id="S7.Thmlem6" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmlem6.2" class="ltx_text ltx_font_bold">Lemma 7.6</span></span><span id="S7.Thmlem6.3" class="ltx_text ltx_font_bold"> </span>(Maximum over polyhedron)<span id="S7.Thmlem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmlem6.p1" class="ltx_para">
<p id="S7.Thmlem6.p1.1" class="ltx_p"><span id="S7.Thmlem6.p1.1.1" class="ltx_text ltx_font_italic">Let the points <math id="S7.Thmlem6.p1.m1" class="ltx_Math" alttext="\bm{P}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\bm{P}_{\Delta}^{\star}</annotation></semantics></math>, <math id="S7.Thmlem6.p1.m2" class="ltx_Math" alttext="{\bm{S}}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐒</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">{\bm{S}}_{\Delta}^{\star}</annotation></semantics></math>, and the set <math id="S7.Thmlem6.p1.m3" class="ltx_Math" alttext="{\mathcal{K}}_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">{\mathcal{K}}_{\Delta}</annotation></semantics></math> be as defined in Lemma <a href="#S7.Thmlem5" title="Lemma 7.5 (Convex envelope of 𝒟_Δ∩ℋ_Δ). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>. When <math id="S7.Thmlem6.p1.m4" class="ltx_Math" alttext="\Delta\in(0,0.5)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0.5</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\in(0,0.5)</annotation></semantics></math>, it follows that for any non-decreasing function <math id="S7.Thmlem6.p1.m5" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>,</span></p>
<table id="S7.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex16.m1" class="ltx_Math" alttext="\max_{{\bm{S}}\in{\mathcal{K}}_{\Delta}}\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)=\max\left\{\int{\mathrm{e}}^{-h(y)}F_{\bm{P}_{\Delta}^{\star}}({\mathrm{d}}y),\int{\mathrm{e}}^{-h(y)}F_{{\bm{S}}_{\Delta}^{\star}}({\mathrm{d}}y)\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mmultiscripts><mo>∫</mo><mprescripts></mprescripts><mrow><mi>𝑺</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi mathvariant="normal">Δ</mi></msub></mrow><mrow></mrow></mmultiscripts><mo>⁡</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo lspace="0em">∫</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0em">,</mo><mrow><mo>∫</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{{\bm{S}}\in{\mathcal{K}}_{\Delta}}\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)=\max\left\{\int{\mathrm{e}}^{-h(y)}F_{\bm{P}_{\Delta}^{\star}}({\mathrm{d}}y),\int{\mathrm{e}}^{-h(y)}F_{{\bm{S}}_{\Delta}^{\star}}({\mathrm{d}}y)\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S7.SS1.p9" class="ltx_para">
<p id="S7.SS1.p9.1" class="ltx_p">With all supporting lemmas established, we are ready to prove Theorem <a href="#S4.Thmthm1" title="Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>.</p>
</div>
<div id="S7.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S4.Thmthm1" title="Theorem 4.1 (Trichotomy of the saddle point solution). ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>.</h6>
<div id="S7.SS1.p10" class="ltx_para">
<p id="S7.SS1.p10.1" class="ltx_p"><span id="S7.SS1.p10.1.1" class="ltx_text">By Lemma <a href="#S7.Thmlem1" title="Lemma 7.1 (Necessity of optimal score functions). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>, solving the minimax problem (<a href="#S7.E26" title="In 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) by a saddle point reduces to obtaining a feasible solution <math id="S7.SS1.p10.m1" class="ltx_Math" alttext="{\bm{S}}\in{\mathcal{D}}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><mi>𝑺</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{S}}\in{\mathcal{D}}_{\Delta}</annotation></semantics></math> that satisfies the optimality condition (<a href="#S7.E27" title="In Lemma 7.1 (Necessity of optimal score functions). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>).
By Lemmas <a href="#S7.Thmlem4" title="Lemma 7.4 (Reduced domain). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.4</span></a>, <a href="#S7.Thmlem5" title="Lemma 7.5 (Convex envelope of 𝒟_Δ∩ℋ_Δ). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>, and <a href="#S7.Thmlem6" title="Lemma 7.6 (Maximum over polyhedron). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.6</span></a>, for any non-decreasing function <math id="S7.SS1.p10.m2" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>,</span></p>
<table id="S7.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex17.m1" class="ltx_Math" alttext="\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)=\max\left\{\int{\mathrm{e}}^{-h(y)}F_{\bm{P}_{\Delta}^{\star}}({\mathrm{d}}y),\int{\mathrm{e}}^{-h(y)}F_{{\bm{S}}_{\Delta}^{\star}}({\mathrm{d}}y)\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mmultiscripts><mo>∫</mo><mprescripts></mprescripts><mrow><mi>𝑺</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi mathvariant="normal">Δ</mi></msub></mrow><mrow></mrow></mmultiscripts><mo>⁡</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>𝑺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo lspace="0em">∫</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0em">,</mo><mrow><mo>∫</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{{\bm{S}}\in{\mathcal{D}}_{\Delta}}\int{\mathrm{e}}^{-h(y)}F_{\bm{S}}({\mathrm{d}}y)=\max\left\{\int{\mathrm{e}}^{-h(y)}F_{\bm{P}_{\Delta}^{\star}}({\mathrm{d}}y),\int{\mathrm{e}}^{-h(y)}F_{{\bm{S}}_{\Delta}^{\star}}({\mathrm{d}}y)\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.p10.2" class="ltx_p"><span id="S7.SS1.p10.2.1" class="ltx_text">This implies that the maximum is achieved by either <math id="S7.SS1.p10.m3" class="ltx_Math" alttext="{\bm{S}}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">{\bm{S}}_{\Delta}^{\star}</annotation></semantics></math> or <math id="S7.SS1.p10.m4" class="ltx_Math" alttext="\bm{P}_{\Delta}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\bm{P}_{\Delta}^{\star}</annotation></semantics></math>. According to Lemma <a href="#S7.Thmlem1" title="Lemma 7.1 (Necessity of optimal score functions). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>, if an optimal score function exists, it must be either <math id="S7.SS1.p10.m5" class="ltx_Math" alttext="h_{{\bm{S}}_{\Delta}^{\star}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><annotation encoding="application/x-tex">h_{{\bm{S}}_{\Delta}^{\star}}</annotation></semantics></math> or <math id="S7.SS1.p10.m6" class="ltx_Math" alttext="h_{\bm{P}_{\Delta}^{\star}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><annotation encoding="application/x-tex">h_{\bm{P}_{\Delta}^{\star}}</annotation></semantics></math>. Therefore, we verify whether either pair—<math id="S7.SS1.p10.m7" class="ltx_Math" alttext="(h_{{\bm{S}}_{\Delta}^{\star}},{\bm{S}}_{\Delta}^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo>,</mo><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h_{{\bm{S}}_{\Delta}^{\star}},{\bm{S}}_{\Delta}^{\star})</annotation></semantics></math> or <math id="S7.SS1.p10.m8" class="ltx_Math" alttext="(h_{\bm{P}_{\Delta}^{\star}},\bm{P}_{\Delta}^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo>,</mo><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h_{\bm{P}_{\Delta}^{\star}},\bm{P}_{\Delta}^{\star})</annotation></semantics></math>—solves the minimax problem (<a href="#S7.E26" title="In 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>).</span></p>
</div>
<div id="S7.SS1.p11" class="ltx_para">
<ul id="S7.I2" class="ltx_itemize">
<li id="S7.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I2.i1.p1" class="ltx_para">
<p id="S7.I2.i1.p1.1" class="ltx_p">If <math id="S7.I2.i1.p1.m1" class="ltx_Math" alttext="h_{{\bm{S}}_{\Delta}^{\star}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><annotation encoding="application/x-tex">h_{{\bm{S}}_{\Delta}^{\star}}</annotation></semantics></math> is the optimal score function, then it must satisfy <math id="S7.I2.i1.p1.m2" class="ltx_Math" alttext="L(h_{{\bm{S}}_{\Delta}^{\star}},{\bm{S}}_{\Delta}^{\star})\geq L(h_{{\bm{S}}_{\Delta}^{\star}},\bm{P}_{\Delta}^{\star})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo>,</mo><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo>,</mo><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L(h_{{\bm{S}}_{\Delta}^{\star}},{\bm{S}}_{\Delta}^{\star})\geq L(h_{{\bm{S}}_{\Delta}^{\star}},\bm{P}_{\Delta}^{\star})</annotation></semantics></math>.
This condition is equivalent to the inequality</p>
<table id="S7.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E28.m1" class="ltx_Math" alttext="1\geq\int{\mathrm{e}}^{-h_{{\bm{S}}_{\Delta}^{\star}}(y)}F_{\bm{P}_{\Delta}^{\star}}({\mathrm{d}}y)=\int\frac{{\mathrm{d}}F_{\bm{P}_{\Delta}^{\star}}}{{\mathrm{d}}F_{{\bm{S}}_{\Delta}^{\star}}}{\mathrm{d}}F_{0}," display="block" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo rspace="0.111em">≥</mo><mrow><mo>∫</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>h</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">1\geq\int{\mathrm{e}}^{-h_{{\bm{S}}_{\Delta}^{\star}}(y)}F_{\bm{P}_{\Delta}^{\star}}({\mathrm{d}}y)=\int\frac{{\mathrm{d}}F_{\bm{P}_{\Delta}^{\star}}}{{\mathrm{d}}F_{{\bm{S}}_{\Delta}^{\star}}}{\mathrm{d}}F_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="S7.I2.i1.p1.2" class="ltx_p">which leads to an algebraic constraint. By numerically solving this condition, we identify the first valid parameter range: <math id="S7.I2.i1.p1.m3" class="ltx_Math" alttext="\Delta\in[0,\Delta_{1}^{\star})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\in[0,\Delta_{1}^{\star})</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I2.i2.p1" class="ltx_para">
<p id="S7.I2.i2.p1.1" class="ltx_p">If <math id="S7.I2.i2.p1.m1" class="ltx_Math" alttext="h_{\bm{P}_{\Delta}^{\star}}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><annotation encoding="application/x-tex">h_{\bm{P}_{\Delta}^{\star}}</annotation></semantics></math> is the optimal score function, it must satisfy <math id="S7.I2.i2.p1.m2" class="ltx_Math" alttext="L(h_{\bm{P}_{\Delta}^{\star}},\bm{P}_{\Delta}^{\star})\geq L(h_{\bm{P}_{\Delta}^{\star}},{\bm{S}}_{\Delta}^{\star})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo>,</mo><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo>,</mo><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">L(h_{\bm{P}_{\Delta}^{\star}},\bm{P}_{\Delta}^{\star})\geq L(h_{\bm{P}_{\Delta}^{\star}},{\bm{S}}_{\Delta}^{\star}).</annotation></semantics></math>
This is equivalent to the inequality</p>
<table id="S7.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E29.m1" class="ltx_Math" alttext="1\geq\int{\mathrm{e}}^{-h_{\bm{P}_{\Delta}^{\star}}(y)}F_{{\bm{S}}_{\Delta}^{\star}}({\mathrm{d}}y)=\int\frac{{\mathrm{d}}F_{{\bm{S}}_{\Delta}^{\star}}}{{\mathrm{d}}F_{\bm{P}_{\Delta}^{\star}}}{\mathrm{d}}F_{0}." display="block" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo rspace="0.111em">≥</mo><mrow><mo>∫</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>h</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑺</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msubsup><mi>𝑷</mi><mi mathvariant="normal">Δ</mi><mo>⋆</mo></msubsup></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">1\geq\int{\mathrm{e}}^{-h_{\bm{P}_{\Delta}^{\star}}(y)}F_{{\bm{S}}_{\Delta}^{\star}}({\mathrm{d}}y)=\int\frac{{\mathrm{d}}F_{{\bm{S}}_{\Delta}^{\star}}}{{\mathrm{d}}F_{\bm{P}_{\Delta}^{\star}}}{\mathrm{d}}F_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="S7.I2.i2.p1.2" class="ltx_p">Numerically solving this condition yields the second valid range: <math id="S7.I2.i2.p1.m3" class="ltx_Math" alttext="\Delta\in(\Delta_{2}^{\star},0.5]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo>,</mo><mn>0.5</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\in(\Delta_{2}^{\star},0.5]</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I2.i3.p1" class="ltx_para">
<p id="S7.I2.i3.p1.1" class="ltx_p">We always have <math id="S7.I2.i3.p1.m1" class="ltx_Math" alttext="\Delta_{1}^{\star}\leq\Delta_{2}^{\star}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>≤</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">\Delta_{1}^{\star}\leq\Delta_{2}^{\star}</annotation></semantics></math> because the Chebyshev inequality ensures that the sum of the right-hand sides of both (<a href="#S7.E28" title="In 1st item ‣ Proof of Theorem . ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>) and (<a href="#S7.E29" title="In 2nd item ‣ Proof of Theorem . ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) is at least <math id="S7.I2.i3.p1.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>. This implies that the intervals <math id="S7.I2.i3.p1.m3" class="ltx_Math" alttext="[0,\Delta_{1}^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,\Delta_{1}^{\star})</annotation></semantics></math> and <math id="S7.I2.i3.p1.m4" class="ltx_Math" alttext="(\Delta_{2}^{\star},0.5]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo>,</mo><mn>0.5</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">(\Delta_{2}^{\star},0.5]</annotation></semantics></math> are disjoint, and hence <math id="S7.I2.i3.p1.m5" class="ltx_Math" alttext="\Delta_{1}^{\star}\leq\Delta_{2}^{\star}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>≤</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">\Delta_{1}^{\star}\leq\Delta_{2}^{\star}</annotation></semantics></math>. By Lemma <a href="#S7.Thmlem1" title="Lemma 7.1 (Necessity of optimal score functions). ‣ 7.1 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>, no optimal score function exists when <math id="S7.I2.i3.p1.m6" class="ltx_Math" alttext="\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>2</mn><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\in(\Delta_{1}^{\star},\Delta_{2}^{\star})</annotation></semantics></math>. The gray region in Figure <a href="#S4.F3" title="Figure 3 ‣ Discussion of the trichotomy. ‣ 4 Application to the Gumbel-max Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> highlights where this breakdown occurs.</p>
</div></li>
</ul>
<p id="S7.SS1.p11.1" class="ltx_p"><span id="S7.SS1.p11.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="S7.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.2 </span>Proof of Theorem <a href="#S5.Thmtheorem2" title="Theorem 5.2. ‣ 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a></h3>

<div id="S7.SS2.p1" class="ltx_para">
<p id="S7.SS2.p1.1" class="ltx_p">Recall that <math id="S7.SS2.p1.m1" class="ltx_Math" alttext="\mathscr{P}=\{\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒫</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathscr{P}=\{\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math>.
For the score functions <math id="S7.SS2.p1.m2" class="ltx_Math" alttext="{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{h}}=\{h_{{\mathcal{V}}}\}_{{\mathcal{V}}\in\Pi}</annotation></semantics></math>, it follows that</p>
<table id="S7.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex18.m1" class="ltx_Math" alttext="\displaystyle\bar{R}_{n,\mathscr{P}}({\bm{h}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bar{R}_{n,\mathscr{P}}({\bm{h}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex18.m2" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\geq}\liminf_{|{{\mathcal{W}}}|\to\infty}B_{n,\mathscr{P}}({\bm{h}})-\omega_{N_{n}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≥</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0.278em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">lim inf</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mi>B</mi><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒉</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\geq}\liminf_{|{{\mathcal{W}}}|\to\infty}B_{n,\mathscr{P}}({\bm{h}})-\omega_{N_{n}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex19.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\geq}-\inf_{\theta\geq 0}\limsup_{|{{\mathcal{W}}}|\to\infty}\frac{1}{N_{n}}\sum_{{\mathcal{V}}\in\Pi}\left(\theta\,\EB_{0}[h_{{\mathcal{V}}}(Y_{{\mathcal{V}}})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}}\log\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(\theta)\right)-\omega_{N_{n}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≥</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em">−</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.0835em">inf</mo><mrow><mi>θ</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><munder><mo lspace="0.0835em" movablelimits="false" rspace="0.167em">lim sup</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>N</mi><mi>n</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><mi>θ</mi><mo lspace="0.337em" rspace="0em">​</mo><msub><mi>𝔼</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub></mrow></munder><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>ϕ</mi><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>,</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>−</mo><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\geq}-\inf_{\theta\geq 0}\limsup_{|{{\mathcal{W}}}|\to\infty}\frac{1}{N_{n}}\sum_{{\mathcal{V}}\in\Pi}\left(\theta\,\EB_{0}[h_{{\mathcal{V}}}(Y_{{\mathcal{V}}})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}}\log\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(\theta)\right)-\omega_{N_{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex20.m1" class="ltx_Math" alttext="\displaystyle\overset{(c)}{\geq}-\limsup_{|{{\mathcal{W}}}|\to\infty}\frac{1}{N_{n}}\sum_{{\mathcal{V}}\in\Pi}\left(\EB_{0}[h_{{\mathcal{V}}}(Y_{{\mathcal{V}}})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}}\log\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(1)\right)-\omega_{N_{n}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≥</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em">−</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">lim sup</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>N</mi><mi>n</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msub><mi>𝔼</mi><mn>0</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub></mrow></munder><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>ϕ</mi><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>,</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{\geq}-\limsup_{|{{\mathcal{W}}}|\to\infty}\frac{1}{N_{n}}\sum_{{\mathcal{V}}\in\Pi}\left(\EB_{0}[h_{{\mathcal{V}}}(Y_{{\mathcal{V}}})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}}\log\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(1)\right)-\omega_{N_{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E30.m1" class="ltx_Math" alttext="\displaystyle\overset{(d)}{=}-\frac{1}{N_{n}}\sum_{{\mathcal{V}}\in\Pi}\limsup_{|{{\mathcal{W}}}|\to\infty}\left(\EB_{0}[h_{{\mathcal{V}}}(Y_{{\mathcal{V}}})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}}\log\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(1)\right)-\omega_{N_{n}}," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">d</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>N</mi><mi>n</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></munder></mstyle><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">lim sup</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mo>(</mo><mrow><mrow><msub><mi>𝔼</mi><mn>0</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub></mrow></munder><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>ϕ</mi><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>,</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><msub><mi>ω</mi><msub><mi>N</mi><mi>n</mi></msub></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(d)}{=}-\frac{1}{N_{n}}\sum_{{\mathcal{V}}\in\Pi}\limsup_{|{{\mathcal{W}}}|\to\infty}\left(\EB_{0}[h_{{\mathcal{V}}}(Y_{{\mathcal{V}}})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}}\log\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}(1)\right)-\omega_{N_{n}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="S7.SS2.p1.2" class="ltx_p">where (a) applies (<a href="#S5.E22" title="In 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), (b) uses the expression in (<a href="#S3.E9" title="In Theorem 3.1 (Explicit lower bound for detection efficiency). ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) with the MGF <math id="S7.SS2.p1.m3" class="ltx_Math" alttext="\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><msub><mi>𝑷</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>,</mo><msub><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub><annotation encoding="application/x-tex">\phi_{\bm{P}_{{\mathcal{V}}},h_{{\mathcal{V}}}}</annotation></semantics></math> defined in (<a href="#S3.E8" title="In Theorem 3.1 (Explicit lower bound for detection efficiency). ‣ 3.3 Detection Efficiency and Optimal Scores ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), (c) follows by setting <math id="S7.SS2.p1.m4" class="ltx_Math" alttext="\theta=1" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\theta=1</annotation></semantics></math>, and (d) exchanges the order of summation and <math id="S7.SS2.p1.m5" class="ltx_Math" alttext="\limsup" display="inline" intent=":literal"><semantics><mo>lim sup</mo><annotation encoding="application/x-tex">\limsup</annotation></semantics></math> since the number of minimal units <math id="S7.SS2.p1.m6" class="ltx_Math" alttext="|\Pi|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\Pi|</annotation></semantics></math> is finite and independent of the vocabulary size <math id="S7.SS2.p1.m7" class="ltx_Math" alttext="|{{\mathcal{W}}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|</annotation></semantics></math>.</p>
</div>
<div id="S7.SS2.p2" class="ltx_para">
<p id="S7.SS2.p2.1" class="ltx_p">The last lower bound (<a href="#S7.E30" title="In 7.2 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) separates over the scores of each sub-block, so it suffices to consider each subproblem individually.
Lemma <a href="#S7.Thmlem7" title="Lemma 7.7 (Simplified limits). ‣ 7.2 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.7</span></a> shows that, as <math id="S7.SS2.p2.m1" class="ltx_Math" alttext="|{{\mathcal{W}}}|\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">|{{\mathcal{W}}}|\to\infty</annotation></semantics></math>, the objective function for each subproblem simplifies exactly to (<a href="#S5.E23" title="In 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>).
Its proof essentially exchanges the order of <math id="S7.SS2.p2.m2" class="ltx_Math" alttext="\limsup" display="inline" intent=":literal"><semantics><mo>lim sup</mo><annotation encoding="application/x-tex">\limsup</annotation></semantics></math> and <math id="S7.SS2.p2.m3" class="ltx_Math" alttext="\sup" display="inline" intent=":literal"><semantics><mo>sup</mo><annotation encoding="application/x-tex">\sup</annotation></semantics></math>, and then applies the weak convergence result in Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1 (Asymptotic joint distribution of pivotal statistics). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>.</p>
</div>
<div id="S7.Thmlem7" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmlem7.2" class="ltx_text ltx_font_bold">Lemma 7.7</span></span><span id="S7.Thmlem7.3" class="ltx_text ltx_font_bold"> </span>(Simplified limits)<span id="S7.Thmlem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmlem7.p1" class="ltx_para">
<p id="S7.Thmlem7.p1.1" class="ltx_p"><span id="S7.Thmlem7.p1.1.1" class="ltx_text ltx_font_italic">For a minimal unit <math id="S7.Thmlem7.p1.m1" class="ltx_Math" alttext="{\mathcal{V}}={\mathcal{I}}_{k}^{\zeta}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>k</mi><mi>ζ</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{V}}={\mathcal{I}}_{k}^{\zeta}</annotation></semantics></math> containing <math id="S7.Thmlem7.p1.m2" class="ltx_Math" alttext="m_{k}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>k</mi></msub><annotation encoding="application/x-tex">m_{k}</annotation></semantics></math> sub-blocks, we represent its associated pivotal statistics <math id="S7.Thmlem7.p1.m3" class="ltx_Math" alttext="Y_{{\mathcal{V}}}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><annotation encoding="application/x-tex">Y_{{\mathcal{V}}}</annotation></semantics></math> as the vector <math id="S7.Thmlem7.p1.m4" class="ltx_Math" alttext="\bm{Y}_{k}=(Y_{k,1},\ldots,Y_{k,m_{k}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐘</mi><mi>k</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>,</mo><msub><mi>m</mi><mi>k</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{Y}_{k}=(Y_{k,1},\ldots,Y_{k,m_{k}})</annotation></semantics></math>, where each component corresponds to a distinct sub-block. Under Assumptions <a href="#S3.Thmasmp1" title="Assumption 3.1 (Independence across blocks). ‣ Two-level partitions. ‣ 3.1 Structural Dependence and Distribution Factorization ‣ 3 A Statistical Framework under Pseudorandomness Collision ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> and <a href="#S5.Thmasmp1" title="Assumption 5.1 (Asymptotic NTP conditions). ‣ 5.1 Asymptotic Distributions ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, for any Lipschitz continuous function <math id="S7.Thmlem7.p1.m5" class="ltx_Math" alttext="h:{\mathbb{R}}^{m_{k}}\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>m</mi><mi>k</mi></msub></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">h:{\mathbb{R}}^{m_{k}}\to{\mathbb{R}}</annotation></semantics></math>,</span></p>
<table id="S7.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex21.m1" class="ltx_Math" alttext="\limsup_{|{{\mathcal{W}}}|\to\infty}\left(\EB_{0}[h(\bm{Y}_{k})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}}\log\EB_{1,\bm{P}_{{\mathcal{V}}}}[\exp(-h(\bm{Y}_{k}))]\right)=\sup_{\Delta_{{\mathcal{V}}}\leq\bm{{\bar{\Delta}}}^{\prime}\leq 1-\delta}L^{\prime}(h,\bm{{\bar{\Delta}}}^{\prime})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim sup</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mo lspace="0em">(</mo><mrow><mrow><msub><mi>𝔼</mi><mn>0</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>⊆</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="true">¯</mo></mover><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub></mrow></munder><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝐏</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>≤</mo><msup><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo>′</mo></msup><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow></munder><mrow><msup><mi>L</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msup><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\limsup_{|{{\mathcal{W}}}|\to\infty}\left(\EB_{0}[h(\bm{Y}_{k})]+\sup_{\bm{P}_{{\mathcal{V}}}\subseteq\overline{{\mathcal{P}}}_{\Delta_{{\mathcal{V}}}}}\log\EB_{1,\bm{P}_{{\mathcal{V}}}}[\exp(-h(\bm{Y}_{k}))]\right)=\sup_{\Delta_{{\mathcal{V}}}\leq\bm{{\bar{\Delta}}}^{\prime}\leq 1-\delta}L^{\prime}(h,\bm{{\bar{\Delta}}}^{\prime}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmlem7.p1.2" class="ltx_p"><span id="S7.Thmlem7.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S7.Thmlem7.p1.m6" class="ltx_Math" alttext="\bm{{\bar{\Delta}}}^{\prime}=(\Delta_{1}^{\prime},\ldots,\Delta_{m_{k}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><msub><mi>m</mi><mi>k</mi></msub><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{{\bar{\Delta}}}^{\prime}=(\Delta_{1}^{\prime},\ldots,\Delta_{m_{k}}^{\prime})</annotation></semantics></math> is a regularity-level vector and <math id="S7.Thmlem7.p1.m7" class="ltx_Math" alttext="L^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mo>′</mo></msup><annotation encoding="application/x-tex">L^{\prime}</annotation></semantics></math> is given in (<a href="#S5.E23" title="In 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>).</span></p>
</div>
</div>
<div id="S7.Thmlem8" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmlem8.2" class="ltx_text ltx_font_bold">Lemma 7.8</span></span><span id="S7.Thmlem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmlem8.p1" class="ltx_para">
<p id="S7.Thmlem8.p1.1" class="ltx_p"><span id="S7.Thmlem8.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmlem8.p1.m1" class="ltx_Math" alttext="h_{{\mathcal{V}}}^{\mathrm{inv}}(\bm{y})=\log\frac{f_{\bm{{\bar{\Delta}}}_{{\mathcal{V}}}}(\bm{y})}{f_{0}(\bm{y})}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>inv</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">h_{{\mathcal{V}}}^{\mathrm{inv}}(\bm{y})=\log\frac{f_{\bm{{\bar{\Delta}}}_{{\mathcal{V}}}}(\bm{y})}{f_{0}(\bm{y})}</annotation></semantics></math> be defined as in (<a href="#S5.E24" title="In Theorem 5.2. ‣ 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>). For any <math id="S7.Thmlem8.p1.m2" class="ltx_Math" alttext="\Delta_{{\mathcal{V}}}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta_{{\mathcal{V}}}\in(0,1)</annotation></semantics></math>, it follows that</span></p>
<table id="S7.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex22.m1" class="ltx_Math" alttext="\lim_{M\to\infty}\sup_{\Delta_{{\mathcal{V}}}\leq\bm{{\bar{\Delta}}}^{\prime}\leq 1-\delta}L^{\prime}([h_{{\mathcal{V}}}^{\mathrm{inv}}]_{[-M,M]},\bm{{\bar{\Delta}}}^{\prime})=-\infty," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi></msub><mo>≤</mo><msup><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo>′</mo></msup><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow></munder><mrow><msup><mi>L</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">[</mo><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>inv</mi></msubsup><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msup><mover accent="true"><mi>𝚫</mi><mo>¯</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lim_{M\to\infty}\sup_{\Delta_{{\mathcal{V}}}\leq\bm{{\bar{\Delta}}}^{\prime}\leq 1-\delta}L^{\prime}([h_{{\mathcal{V}}}^{\mathrm{inv}}]_{[-M,M]},\bm{{\bar{\Delta}}}^{\prime})=-\infty,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmlem8.p1.2" class="ltx_p"><span id="S7.Thmlem8.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S7.Thmlem8.p1.m3" class="ltx_Math" alttext="[\cdot]_{[-M,M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">[\cdot]_{[-M,M]}</annotation></semantics></math> denotes the clipping operator onto the interval <math id="S7.Thmlem8.p1.m4" class="ltx_Math" alttext="[-M,M]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-M,M]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS2.p3" class="ltx_para">
<p id="S7.SS2.p3.1" class="ltx_p">Finally, Theorem <a href="#S5.Thmtheorem2" title="Theorem 5.2. ‣ 5.2 Optimal Score Function ‣ 5 Application to the Inverse Transform Watermark ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> is obtained by combining the lower bound (<a href="#S7.E30" title="In 7.2 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) with Lemmas <a href="#S7.Thmlem7" title="Lemma 7.7 (Simplified limits). ‣ 7.2 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.7</span></a> and <a href="#S7.Thmlem8" title="Lemma 7.8. ‣ 7.2 Proof of Theorem ‣ 7 Proof of Main Results ‣ Optimal Detection for Language Watermarks with Pseudorandom Collision" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.8</span></a>:</p>
<table id="S7.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex23.m1" class="ltx_Math" alttext="\lim_{M\to\infty}\bar{R}_{n,\mathscr{P}}(\{[h_{{\mathcal{V}}}^{\mathrm{inv}}]_{[-M,M]}\}_{{\mathcal{V}}\in\Pi})=\infty." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>n</mi><mo>,</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">[</mo><msubsup><mi>h</mi><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>inv</mi></msubsup><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>,</mo><mi>M</mi></mrow><mo stretchy="false">]</mo></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{M\to\infty}\bar{R}_{n,\mathscr{P}}(\{[h_{{\mathcal{V}}}^{\mathrm{inv}}]_{[-M,M]}\}_{{\mathcal{V}}\in\Pi})=\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="S8" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">8 </span>Discussion</h2>

<div id="S8.p1" class="ltx_para">
<p id="S8.p1.1" class="ltx_p">In this paper, we study how to optimally perform watermark detection under pseudorandomness collisions, a phenomenon arising from text repetition in both human-written and low-random LLM outputs. Our central idea is to capture the repetition structure through a hierarchical two-layer partition, identifying minimal units within which strong dependence exists but across which independence is preserved. Using these minimal units as basic components, we develop a new non-asymptotic efficiency measure for evaluating detection rules that take the form of sum-based scores over the minimal units. This formulation naturally casts the search for optimal detection rules as a minimax problem. We then apply our framework to two watermarking schemes—the Gumbel-max watermark and the inverse-transform watermark. For both schemes, we derive the corresponding optimal detection rules and show, both theoretically and empirically, that our rules enable valid Type I error control while achieving comparable or even higher detection power. Moreover, our framework provides a theoretical justification for the widely used heuristic of discarding repeated statistics. At a broader level, our contribution of incorporating pseudorandomness collisions into watermark analysis advances the development of statistical foundations for LLMs <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib48" title="" class="ltx_ref">48</a>]</cite>.</p>
</div>
<div id="S8.p2" class="ltx_para">
<p id="S8.p2.1" class="ltx_p">Building on this foundation, our work opens several promising directions for future research.
First, our framework empirically demonstrates the benefit of assigning different regularity levels <math id="S8.p2.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> to different minimal units. Further efforts could focus on more accurately approximating the NTP distribution for a given text <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>]</cite>.
Second, our current analysis adopts a <math id="S8.p2.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>-regular belief class of NTP distributions to represent the least favorable case. Exploring alternative or more refined belief classes may sharpen efficiency guarantees and yield stronger detection rules, particularly when the existing worst-case formulation is overly conservative.
Last, many downstream statistical tasks merit reexamination under pseudorandomness collisions. Examples include detection under human edits <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite> and estimation of the proportion of watermarked tokens in AI-mixed text <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite>. Both problems can be reformulated with minimal units as the basic component, offering a principled alternative to methods that still assume perfect pseudorandomness.</p>
</div>
<div id="S8.p3" class="ltx_para">
<p id="S8.p3.1" class="ltx_p">Beyond methodological development, our study also connects to a classical statistical problem called content authenticity.
Traditional approaches such as stylometry and authorship attribution identify an author’s linguistic fingerprints from stylistic patterns like word-length distributions or function-word usage <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>, <a href="#bib.bib34" title="" class="ltx_ref">34</a>, <a href="#bib.bib20" title="" class="ltx_ref">20</a>, <a href="#bib.bib45" title="" class="ltx_ref">45</a>]</cite>.
Plagiarism detection represents another related line, leveraging information-retrieval techniques to identify surface-level overlaps with existing corpora <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib31" title="" class="ltx_ref">31</a>]</cite>.
Watermark detection, however, is fundamentally distinct, as its objective is not to detect unconscious stylistic features or verbatim copies, but to verify the presence of a deliberately embedded statistical signal with explicitly specified properties <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>.
This distinction makes the reliability of the underlying statistical dependence crucial—precisely the aspect that pseudorandomness collisions undermine. At the same time, our framework may inspire new revisitations of these classical authenticity problems, where one could deliberately embed structured dependence or repeated linguistic patterns via watermarking to enhance detectability and robustness in the era of generative AI.</p>
</div>
</section>
