<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E129.m1" class="ltx_Math" alttext="\displaystyle\leq O(m)\cdot\max_{\begin{subarray}{c}\ell\in[m]\\
t\in{\mathcal{I}}^{Y}_{\ell}\end{subarray}}\left(\frac{1}{|{{\mathcal{W}}}|}+\sqrt{\sum_{j=2}^{|{{\mathcal{W}}}|}P_{t,(j)}^{2}\log|{{\mathcal{W}}}|}+P_{t,(2)}\log|{{\mathcal{W}}}|\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><munder><mi>max</mi><mtable rowspacing="0pt"><mtr><mtd><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>t</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi mathvariant="normal">ℓ</mi><mi>Y</mi></msubsup></mrow></mtd></mtr></mtable></munder><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo>+</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>2</mn></mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></munderover></mstyle><mrow><msubsup><mi>P</mi><mrow><mi>t</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow></msqrt><mo>+</mo><mrow><msub><mi>P</mi><mrow><mi>t</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq O(m)\cdot\max_{\begin{subarray}{c}\ell\in[m]\\
t\in{\mathcal{I}}^{Y}_{\ell}\end{subarray}}\left(\frac{1}{|{{\mathcal{W}}}|}+\sqrt{\sum_{j=2}^{|{{\mathcal{W}}}|}P_{t,(j)}^{2}\log|{{\mathcal{W}}}|}+P_{t,(2)}\log|{{\mathcal{W}}}|\right)</annotation></semantics></math></td>
