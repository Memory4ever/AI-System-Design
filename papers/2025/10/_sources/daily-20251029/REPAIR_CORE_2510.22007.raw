<span id="S1.T1.2.1.5.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">from <span id="S1.T1.2.1.5.1.2.1.2.1.1" class="ltx_text ltx_font_italic">White Fang</span></span></span>
<span id="S1.T1.2.1.5.1.2.1.3" class="ltx_tr">
