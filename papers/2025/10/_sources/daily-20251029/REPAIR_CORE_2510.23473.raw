<td id="A4.T5.6.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">37.40%</td>
<td id="A4.T5.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">29.03%</td>
<td id="A4.T5.6.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">73.40%</td>
<td id="A4.T5.6.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">77.04%</td>
<td id="A4.T5.6.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">63.58%</td>
<td id="A4.T5.6.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">44.48%</td>
<td id="A4.T5.6.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">69.85%</td>
<td id="A4.T5.6.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">38.05%</td>
<td id="A4.T5.6.1.3.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">54.10%</td></tr>
<tr id="A4.T5.6.1.4" class="ltx_tr">
<th id="A4.T5.6.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-top:2.5pt;padding-bottom:2.5pt;">1000</th>
<td id="A4.T5.6.1.4.2" class="ltx_td ltx_align_center" style="padding-top:2.5pt;padding-bottom:2.5pt;">38.32%</td>
<td id="A4.T5.6.1.4.3" class="ltx_td ltx_align_center" style="padding-top:2.5pt;padding-bottom:2.5pt;">30.30%</td>
