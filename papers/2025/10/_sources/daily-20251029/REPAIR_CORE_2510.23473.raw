<th id="A4.T5.6.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A4.T5.6.1.2.3.1" class="ltx_text ltx_font_bold">VRBench</span></th>
<th id="A4.T5.6.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A4.T5.6.1.2.4.1" class="ltx_text ltx_font_bold">ActivityNet</span></th>
<th id="A4.T5.6.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A4.T5.6.1.2.5.1" class="ltx_text ltx_font_bold">Star</span></th>
<th id="A4.T5.6.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A4.T5.6.1.2.6.1" class="ltx_text ltx_font_bold">ScaleLong</span></th>
<th id="A4.T5.6.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A4.T5.6.1.2.7.1" class="ltx_text ltx_font_bold">YouCook2</span></th>
<th id="A4.T5.6.1.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A4.T5.6.1.2.8.1" class="ltx_text ltx_font_bold">LVBench</span></th></tr>
</thead>
<tbody class="ltx_tbody">
