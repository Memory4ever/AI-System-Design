<th id="S4.T2.6.1.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">16</th>
<td id="S4.T2.6.1.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">38.54%</td>
<td id="S4.T2.6.1.6.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">27.81%</td>
<td id="S4.T2.6.1.6.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">69.25%</td>
<td id="S4.T2.6.1.6.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">76.00%</td>
