<th id="A6.T5.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">BoN-max second</th>
<td id="A6.T5.2.1.3.2" class="ltx_td ltx_align_right" style="--ltx-bg-color:#67C296;"><span id="A6.T5.2.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#67C296;">0.261</span></td>
<td id="A6.T5.2.1.3.3" class="ltx_td ltx_align_right" style="--ltx-bg-color:#8DD1B0;"><span id="A6.T5.2.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#8DD1B0;">0.302</span></td>
<td id="A6.T5.2.1.3.4" class="ltx_td ltx_align_right" style="--ltx-bg-color:#A1D9BE;"><span id="A6.T5.2.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#A1D9BE;">0.338</span></td>
