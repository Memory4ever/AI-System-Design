<td id="A6.T5.2.1.2.9" class="ltx_td ltx_align_right ltx_border_tt" style="--ltx-bg-color:#70C59C;"><span id="A6.T5.2.1.2.9.1" class="ltx_text" style="--ltx-bg-color:#70C59C;">0.541</span></td>
