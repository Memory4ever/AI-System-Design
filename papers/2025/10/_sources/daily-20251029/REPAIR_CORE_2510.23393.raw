<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Baselines</h2>

<div id="A1.p1" class="ltx_para ltx_noindent">
<p id="A1.p1.1" class="ltx_p">Here we describe baseline approaches used in our work.
All of them modify how advantage is calculated in GRPO formulation:</p>
<table id="A1.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex13.m1" class="ltx_Math" alttext="\begin{split}\mathcal{J}_{\mathrm{grpo}}=\mathbb{E}_{x\sim D}\;&amp;\mathbb{E}_{{\bm{y}}\sim{\bm{\pi}}_{\mathrm{old}}(\cdot\mid x)}\!\left[\frac{1}{n}\,\sum_{i=1}^{n}\left(\mathcal{A}(y_{i},x,\varepsilon)-\beta\,\mathbb{D}_{\mathrm{KL}}(\pi_{\theta}\,\|\,\pi_{\mathrm{old}})\right)\right],\\
&amp;\mathcal{A}(y_{i},x,\varepsilon)=\min\left(\frac{\pi_{\theta}(y_{i}\mid x)}{\pi_{\mathrm{old}}(y_{i}\mid x)}A_{i},\,\clip\left(\dfrac{\pi_{\theta}(y_{i}\mid x)}{\pi_{\mathrm{old}}(y_{i}\mid x)},\,1-\varepsilon,\,1+\varepsilon\right)\,A_{i}\right).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>grpo</mi></msub><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>D</mi></mrow></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><msub><mrow></mrow><mrow><mi>𝒚</mi><mo>∼</mo><mi>𝝅</mi><msub><mrow></mrow><mi>old</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0.507em" movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mo>(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">(</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>𝔻</mi><msub><mrow></mrow><mi>KL</mi></msub><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo lspace="0.170em" rspace="0.507em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>old</mi></msub><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>old</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>i</mi></msub></mrow><mo rspace="0.507em">,</mo><mrow><mrow><mi>clip</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>old</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>,</mo><mrow><mn> 1</mn><mo>−</mo><mi>ε</mi></mrow><mo>,</mo><mrow><mn> 1</mn><mo>+</mo><mi>ε</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0.340em" rspace="0em">​</mo><msub><mi>A</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathcal{J}_{\mathrm{grpo}}=\mathbb{E}_{x\sim D}\;&amp;\mathbb{E}_{{\bm{y}}\sim{\bm{\pi}}_{\mathrm{old}}(\cdot\mid x)}\!\left[\frac{1}{n}\,\sum_{i=1}^{n}\left(\mathcal{A}(y_{i},x,\varepsilon)-\beta\,\mathbb{D}_{\mathrm{KL}}(\pi_{\theta}\,\|\,\pi_{\mathrm{old}})\right)\right],\\
&amp;\mathcal{A}(y_{i},x,\varepsilon)=\min\left(\frac{\pi_{\theta}(y_{i}\mid x)}{\pi_{\mathrm{old}}(y_{i}\mid x)}A_{i},\,\clip\left(\dfrac{\pi_{\theta}(y_{i}\mid x)}{\pi_{\mathrm{old}}(y_{i}\mid x)},\,1-\varepsilon,\,1+\varepsilon\right)\,A_{i}\right).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.p2" class="ltx_para ltx_noindent">
<ul id="A1.I1" class="ltx_itemize">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i1.p1.1" class="ltx_p">In <span id="A1.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">BoN-max mean</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Chow et al., 2024a</a>)</cite> advantage is assigned only to the completions with the highest scores and average score of all completions is used as variance reduction.
Let’s denote <math id="A1.I1.i1.p1.m1" class="ltx_Math" alttext="r_{m}=\max\left(r(y_{1},x),r(y_{2},x),\dots,r(y_{n},x)\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>m</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>2</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>n</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{m}=\max\left(r(y_{1},x),r(y_{2},x),\dots,r(y_{n},x)\right)</annotation></semantics></math>, then:</p>
<table id="A1.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex14.m1" class="ltx_Math" alttext="A_{i}=\begin{cases}r(y_{i},x)-\mean\left(r(y_{1},x),r(y_{2},x),\dots,r(y_{n},x)\right)&amp;,r(y_{i},x)=r_{m}\\
0&amp;,otherwise\end{cases}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>i</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>mean</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>2</mn></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>n</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>,</mo><mi>r</mi><mo stretchy="false">(</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mi>r</mi><msub><mrow></mrow><mi>m</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>,</mo><mi>o</mi><mi>t</mi><mi>h</mi><mi>e</mi><mi>r</mi><mi>w</mi><mi>i</mi><mi>s</mi><mi>e</mi></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A_{i}=\begin{cases}r(y_{i},x)-\mean\left(r(y_{1},x),r(y_{2},x),\dots,r(y_{n},x)\right)&amp;,r(y_{i},x)=r_{m}\\
0&amp;,otherwise\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i2.p1.1" class="ltx_p">In case of <span id="A1.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">BoN-max second</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Chow et al., 2024a</a>)</cite> the advantage is similar, but second best value is used as variance reduction:</p>
<table id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="A_{i}=\begin{cases}r(y_{i},x)-\max_{i|r(y_{i},x)\neq r_{m}}\left(r(y_{i},x)\right)&amp;,r(y_{i},x)=r_{m}\\
0&amp;,otherwise\end{cases}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>i</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>max</mi><mrow><mi>i</mi><mo fence="false">|</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><msub><mi>r</mi><mi>m</mi></msub></mrow></mrow></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>,</mo><mi>r</mi><mo stretchy="false">(</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mi>r</mi><msub><mrow></mrow><mi>m</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>,</mo><mi>o</mi><mi>t</mi><mi>h</mi><mi>e</mi><mi>r</mi><mi>w</mi><mi>i</mi><mi>s</mi><mi>e</mi></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A_{i}=\begin{cases}r(y_{i},x)-\max_{i|r(y_{i},x)\neq r_{m}}\left(r(y_{i},x)\right)&amp;,r(y_{i},x)=r_{m}\\
0&amp;,otherwise\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i3.p1.1" class="ltx_p"><span id="A1.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">BoN LOO-1<cite class="ltx_cite ltx_citemacro_citep"><span id="A1.I1.i3.p1.1.1.1" class="ltx_text ltx_font_medium">(</span><a href="#bib.bib40" title="" class="ltx_ref">Tang et al., 2025</a><span id="A1.I1.i3.p1.1.1.3" class="ltx_text ltx_font_medium">)</span></cite></span> uses on-policy estimation <a href="#S3.E7" title="In 3.2 On-policy case ‣ 3 Pass@k optimization ‣ The Best of N Worlds:Aligning Reinforcement Learning with Best-of-N Sampling via max@k Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">7</span></a> of BoN objective, but modifies to decrease its variance.
New objective takes the form of:</p>
<table id="A1.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex16.m1" class="ltx_Math" alttext="\frac{1}{\binom{n}{k}}\sum_{i=1}^{n}\left(\nabla_{\theta}\!\log\pi(y_{i}\mid x)\sum_{\begin{subarray}{c}I\subseteq[n],i\in I\\
|I|=k\end{subarray}}\max\!\left(\left(r\!\left(y_{j},x\right)\right)_{j\in I}\right)-\max\!\left(\left(r\!\left(y_{j},x\right)\right)_{j\in I\setminus i}\right)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mi>k</mi></mfrac><mo>)</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mo>(</mo><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>I</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">|</mo><mi>I</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder><mrow><mpadded style="width:1.808em;" width="1.808em"><mi>max</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><mrow><mpadded style="width:0.309em;" width="0.309em"><mi>r</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>x</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>j</mi><mo>∈</mo><mi>I</mi></mrow></msub><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mpadded style="width:1.808em;" width="1.808em"><mi>max</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><mrow><mpadded style="width:0.309em;" width="0.309em"><mi>r</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msub><mi>y</mi><mi>j</mi></msub><mo>,</mo><mi>x</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>j</mi><mo>∈</mo><mrow><mi>I</mi><mo>∖</mo><mi>i</mi></mrow></mrow></msub><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{\binom{n}{k}}\sum_{i=1}^{n}\left(\nabla_{\theta}\!\log\pi(y_{i}\mid x)\sum_{\begin{subarray}{c}I\subseteq[n],i\in I\\
|I|=k\end{subarray}}\max\!\left(\left(r\!\left(y_{j},x\right)\right)_{j\in I}\right)-\max\!\left(\left(r\!\left(y_{j},x\right)\right)_{j\in I\setminus i}\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.I1.i3.p2" class="ltx_para ltx_noindent">
<p id="A1.I1.i3.p2.1" class="ltx_p">The sum of the first terms results in <a href="#S3.E9" title="In 3.2 On-policy case ‣ 3 Pass@k optimization ‣ The Best of N Worlds:Aligning Reinforcement Learning with Best-of-N Sampling via max@k Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">9</span></a>.
The sum of the second terms <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib42" title="" class="ltx_ref">Walder &amp; Karkhanis (2025)</a></cite> propose to calculate in the following way:</p>
<table id="A1.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex17.m1" class="ltx_Math" alttext="term_{2}=\frac{k}{n(k-1)}b_{i}^{(k-1)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mfrac><mi>k</mi><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">term_{2}=\frac{k}{n(k-1)}b_{i}^{(k-1)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i3.p2.2" class="ltx_p">where</p>
</div>
<div id="A1.I1.i3.p3" class="ltx_para ltx_noindent">
<table id="A1.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex18.m1" class="ltx_Math" alttext="b_{i}^{(k)}=\frac{1}{\binom{n-1}{k}}\sum\limits_{\begin{subarray}{c}j=1\\
j\neq i\end{subarray}}^{n}\sum_{\begin{subarray}{c}I\subseteq[n]\setminus i,j\in I\\
|I|=k\end{subarray}}\max\!\left(\left(r\!\left(y_{l},x\right)\right)_{l\in I}\right)," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>b</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mi>k</mi></mfrac><mo>)</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd><mrow><mi>j</mi><mo>≠</mo><mi>i</mi></mrow></mtd></mtr></mtable><mi>n</mi></munderover><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>I</mi><mo>⊆</mo><mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>i</mi></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mi>I</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">|</mo><mi>I</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder><mrow><mpadded style="width:1.808em;" width="1.808em"><mi>max</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msub><mrow><mo>(</mo><mrow><mpadded style="width:0.309em;" width="0.309em"><mi>r</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msub><mi>y</mi><mi>l</mi></msub><mo>,</mo><mi>x</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mi>l</mi><mo>∈</mo><mi>I</mi></mrow></msub><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">b_{i}^{(k)}=\frac{1}{\binom{n-1}{k}}\sum\limits_{\begin{subarray}{c}j=1\\
j\neq i\end{subarray}}^{n}\sum_{\begin{subarray}{c}I\subseteq[n]\setminus i,j\in I\\
|I|=k\end{subarray}}\max\!\left(\left(r\!\left(y_{l},x\right)\right)_{l\in I}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I1.i3.p3.1" class="ltx_p">and calculated recursively:</p>
<table id="A1.EGx2" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex19.m1" class="ltx_Math" alttext="\displaystyle b_{1}^{(k)}=\frac{1}{\binom{n}{k}}\sum_{i=2}^{n}(w_{ii}+(i-2)w_{i,i+1})r(y_{i},x)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mi>k</mi></mfrac><mo>)</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></munderover><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle b_{1}^{(k)}=\frac{1}{\binom{n}{k}}\sum_{i=2}^{n}(w_{ii}+(i-2)w_{i,i+1})r(y_{i},x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex20.m1" class="ltx_Math" alttext="\displaystyle b_{i+1}^{k}=b_{i}^{(k)}+\frac{1}{\binom{n}{k}}(r(y_{i},x)-r(y_{i+1},x))(w_{ii}+(i-2)w_{i,i+1})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>k</mi></msubsup><mo>=</mo><mrow><msubsup><mi>b</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mi>k</mi></mfrac><mo>)</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle b_{i+1}^{k}=b_{i}^{(k)}+\frac{1}{\binom{n}{k}}(r(y_{i},x)-r(y_{i+1},x))(w_{ii}+(i-2)w_{i,i+1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A1.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i4.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i4.p1.1" class="ltx_p">In <span id="A1.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">BoN mean</span> baseline we calculate rewards as described in <a href="#S3.E9" title="In 3.2 On-policy case ‣ 3 Pass@k optimization ‣ The Best of N Worlds:Aligning Reinforcement Learning with Best-of-N Sampling via max@k Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">9</span></a>.
After that, z-score is applied to these rewards as in normal GRPO (<a href="#S3.E5" title="In 3.1 Preliminaries ‣ 3 Pass@k optimization ‣ The Best of N Worlds:Aligning Reinforcement Learning with Best-of-N Sampling via max@k Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">5</span></a>).</p>
</div></li>
</ul>
</div>
</section>
