<td id="S5.T2.2.10.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">1.274 <span id="S5.T2.2.10.2.1" class="ltx_text" style="font-size:70%;">(±0.061)</span></td>
<td id="S5.T2.2.10.3" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">1.265 <span id="S5.T2.2.10.3.1" class="ltx_text" style="font-size:70%;">(±0.134)</span></td></tr>
