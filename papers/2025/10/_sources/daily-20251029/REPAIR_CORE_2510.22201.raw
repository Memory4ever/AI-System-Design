<span id="S4.T1.2.11.5.1.1" class="ltx_p ltx_align_center">48.3% <span id="S4.T1.2.11.5.1.1.1" class="ltx_text" style="font-size:70%;">(±5.77%)</span></span>
</span></td>
<td id="S4.T1.2.11.6" class="ltx_td ltx_align_left ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">
