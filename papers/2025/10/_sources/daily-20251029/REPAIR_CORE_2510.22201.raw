<td id="S5.T2.2.9.3" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">1.317 <span id="S5.T2.2.9.3.1" class="ltx_text" style="font-size:70%;">(±0.083)</span></td></tr>
