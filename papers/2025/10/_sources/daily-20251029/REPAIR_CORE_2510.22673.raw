<td id="A2.T4.6.1.2.6.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A2.T4.6.1.2.6.1.1.1.1" class="ltx_text" style="font-size:90%;">Integer</span></td></tr>
<tr id="A2.T4.6.1.2.6.1.2" class="ltx_tr">
<td id="A2.T4.6.1.2.6.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A2.T4.6.1.2.6.1.2.1.1" class="ltx_text" style="font-size:90%;">shift consist.</span></td></tr>
</table></th>
<th id="A2.T4.6.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">
<table id="A2.T4.6.1.2.7.1" class="ltx_tabular ltx_align_middle">
<tr id="A2.T4.6.1.2.7.1.1" class="ltx_tr">
