<td id="A2.T4.6.1.2.5.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A2.T4.6.1.2.5.1.2.1.1" class="ltx_text" style="font-size:90%;">accuracy</span></td></tr>
