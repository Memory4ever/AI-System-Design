<td id="S5.T2.2.1.9.2" class="ltx_td ltx_align_center"><span id="S5.T2.2.1.9.2.1" class="ltx_text" style="--ltx-bg-color:#EBF5FF;">62.7</span></td>
<td id="S5.T2.2.1.9.3" class="ltx_td ltx_align_center"><span id="S5.T2.2.1.9.3.1" class="ltx_text" style="--ltx-bg-color:#EBF5FF;">57.2</span></td></tr>
