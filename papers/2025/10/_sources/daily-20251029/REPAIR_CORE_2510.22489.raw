<td id="S4.T2.5.1.3" class="ltx_td ltx_align_center ltx_border_rr ltx_border_tt"><span id="S4.T2.5.1.3.1" class="ltx_text ltx_font_bold">WT-2</span> <math id="S4.T2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
