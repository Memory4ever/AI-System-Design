<td id="S4.T2.5.1.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S4.T2.5.1.6.1" class="ltx_text ltx_font_bold">ARC</span> <math id="S4.T2.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
