<td id="S7.T3.8.1.19.1" class="ltx_td ltx_align_left"><span id="S7.T3.8.1.19.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">GPT4o</span></td>
<td id="S7.T3.8.1.19.2" class="ltx_td ltx_align_left"><math id="S7.T3.m109" class="ltx_Math" alttext="05.61" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">05.61</mn><annotation encoding="application/x-tex">05.61</annotation></semantics></math><span id="S7.T3.8.1.19.2.1" class="ltx_text" style="font-size:90%;">%</span></td>
