<td id="S7.T3.8.1.19.8" class="ltx_td ltx_align_left"><math id="S7.T3.m113" class="ltx_Math" alttext="26.52" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">26.52</mn><annotation encoding="application/x-tex">26.52</annotation></semantics></math><span id="S7.T3.8.1.19.8.1" class="ltx_text" style="font-size:90%;">%</span></td>
<td id="S7.T3.8.1.19.9" class="ltx_td ltx_align_left"><math id="S7.T3.m114" class="ltx_Math" alttext="00.83" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">00.83</mn><annotation encoding="application/x-tex">00.83</annotation></semantics></math><span id="S7.T3.8.1.19.9.1" class="ltx_text" style="font-size:90%;">%</span></td>
<td id="S7.T3.8.1.19.10" class="ltx_td ltx_align_left"><span id="S7.T3.8.1.19.10.1" class="ltx_text ltx_font_bold" style="font-size:90%;">32.02%</span></td>
<td id="S7.T3.8.1.19.11" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S7.T3.8.1.19.11.1" class="ltx_text" style="font-size:90%;">–</span></td></tr>
<tr id="S7.T3.8.1.20" class="ltx_tr">
<td id="S7.T3.8.1.20.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S7.T3.8.1.20.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">DS-v3</span></td>
<td id="S7.T3.8.1.20.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="S7.T3.m115" class="ltx_Math" alttext="11.34" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">11.34</mn><annotation encoding="application/x-tex">11.34</annotation></semantics></math><span id="S7.T3.8.1.20.2.1" class="ltx_text" style="font-size:90%;">%</span></td>
