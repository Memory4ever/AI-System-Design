<td id="S7.T5.7.1.20.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="S7.T5.m105" class="ltx_Math" alttext="10.67" display="inline" intent=":literal"><semantics><mn>10.67</mn><annotation encoding="application/x-tex">10.67</annotation></semantics></math>%</td>
<td id="S7.T5.7.1.20.3" class="ltx_td ltx_align_left ltx_border_bb"><math id="S7.T5.m106" class="ltx_Math" alttext="13.55" display="inline" intent=":literal"><semantics><mn>13.55</mn><annotation encoding="application/x-tex">13.55</annotation></semantics></math>%</td>
