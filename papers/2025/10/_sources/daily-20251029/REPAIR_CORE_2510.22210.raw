<td id="S7.T2.5.1.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt"><span id="S7.T2.5.1.1.2.1" class="ltx_text ltx_font_bold">Domain</span></td>
<td id="S7.T2.5.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S7.T2.5.1.1.3.1" class="ltx_text ltx_font_bold">Version</span></td>
<td id="S7.T2.5.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S7.T2.5.1.1.4.1" class="ltx_text ltx_font_bold">Language</span></td></tr>
<tr id="S7.T2.5.1.2" class="ltx_tr">
<td id="S7.T2.5.1.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Black <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib22" title="" class="ltx_ref">Foundation), 2025</a>)</cite></td>
