<td id="S7.T3.8.1.19.4" class="ltx_td ltx_align_left"><math id="S7.T3.m111" class="ltx_Math" alttext="00.23" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">00.23</mn><annotation encoding="application/x-tex">00.23</annotation></semantics></math><span id="S7.T3.8.1.19.4.1" class="ltx_text" style="font-size:90%;">%</span></td>
<td id="S7.T3.8.1.19.5" class="ltx_td ltx_align_left"><span id="S7.T3.8.1.19.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">27.75%</span></td>
<td id="S7.T3.8.1.19.6" class="ltx_td ltx_align_left"><span id="S7.T3.8.1.19.6.1" class="ltx_text" style="font-size:90%;">–</span></td>
