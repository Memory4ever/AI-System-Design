<div id="A3.T8.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:440.8pt;height:627.8pt;vertical-align:-311.9pt;"><span class="ltx_transformed_inner" style="transform:translate(-55.1pt,78.5pt) scale(0.8,0.8) ;">
