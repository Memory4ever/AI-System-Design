<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(d) </span>MMLU</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S5.F2.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.22767v1/img/plots/commonqa.png" id="S5.F2.sf5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/396;" width="548" height="396" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(e) </span>CommonQA</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S5.F2.sf6" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.22767v1/img/plots/winogrande.png" id="S5.F2.sf6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/388;" width="548" height="388" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(f) </span>WinoGrande</figcaption>
