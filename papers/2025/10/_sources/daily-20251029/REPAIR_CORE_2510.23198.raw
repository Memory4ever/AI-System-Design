<td id="S3.T1.2.5.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S3.T1.m15" class="ltx_Math" alttext="4.74\!\times\!10^{-4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">4.74\!\times\!10^{-4}</annotation></semantics></math></td>
