<td id="S3.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m4" class="ltx_Math" alttext="5.22\!\times\!10^{-5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5.22\!\times\!10^{-5}</annotation></semantics></math></td>
