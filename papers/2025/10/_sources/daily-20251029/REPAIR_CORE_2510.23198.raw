<th id="S3.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S3.T1.m1" class="ltx_Math" alttext="\mathrm{Huber}_{\log}\!\downarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">Huber</mi><mi mathsize="0.900em">log</mi></msub><mo lspace="0.128em" mathsize="0.900em" stretchy="false">↓</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathrm{Huber}_{\log}\!\downarrow</annotation></semantics></math></th>
