<td id="A2.tab2.2.2.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_l ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;" rowspan="2"><span id="A2.tab2.2.2.1.1" class="ltx_text">Java</span></td>
<td id="A2.tab2.2.2.2" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;" rowspan="2"><span id="A2.tab2.2.2.2.1" class="ltx_text">
<span id="A2.tab2.2.2.2.1.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:42.7pt;">
<span id="A2.tab2.2.2.2.1.1.1" class="ltx_p">Functional</span>
<span id="A2.tab2.2.2.2.1.1.2" class="ltx_p">Correctness</span>
</span></span></td>
<td id="A2.tab2.2.2.3" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;" rowspan="2">
<span id="A2.tab2.2.2.3.1" class="ltx_inline-block">
<span id="A2.tab2.2.2.3.1.1" class="ltx_p">
<span id="A2.tab2.2.2.3.1.1.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:85.4pt;">
<span id="A2.tab2.2.2.3.1.1.1.1" class="ltx_p">Write a function that counts numbers &gt;10 with odd first and last digits.</span>
</span></span>
</span></td>
<td id="A2.tab2.2.2.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A2.tab2.2.2.4.1" class="ltx_inline-block">
<span id="A2.tab2.2.2.4.1.1" class="ltx_p ltx_align_left ltx_parbox ltx_align_middle" style="width:113.8pt;"><span id="A2.tab2.2.2.4.1.1.1" class="ltx_text ltx_font_typewriter">return (int) nums.stream()
<br class="ltx_break"> .filter(i -&gt; Math.abs(i) % 2 == 1
<br class="ltx_break"> &amp;&amp; i % 10 % 2 == 1
<br class="ltx_break"> &amp;&amp; i / 10 % 2 == 1)
<br class="ltx_break"> .count();
</span></span>
</span></td>
<td id="A2.tab2.2.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0</td>
<td id="A2.tab2.2.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.699</td>
<td id="A2.tab2.2.2.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.218</td></tr>
<tr id="A2.tab2.2.3" class="ltx_tr">
<td id="A2.tab2.2.3.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A2.tab2.2.3.1.1" class="ltx_inline-block">
<span id="A2.tab2.2.3.1.1.1" class="ltx_p ltx_align_left ltx_parbox ltx_align_middle" style="width:113.8pt;"><span id="A2.tab2.2.3.1.1.1.1" class="ltx_text ltx_font_typewriter">return (int) nums.stream()
<br class="ltx_break"> .filter(num -&gt; num &gt; 10)
<br class="ltx_break"> .filter(num -&gt;
<br class="ltx_break"> Integer.toString(num)
<br class="ltx_break">  .charAt(0) % 2 != 0
<br class="ltx_break"> &amp;&amp; Integer.toString(num)
<br class="ltx_break">  .charAt(Integer.toString
<br class="ltx_break">   (num).length() - 1)
<br class="ltx_break">  % 2 != 0
<br class="ltx_break"> ).count();
</span></span>
</span></td>
<td id="A2.tab2.2.3.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">1</td>
<td id="A2.tab2.2.3.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.763</td>
<td id="A2.tab2.2.3.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.714</td></tr>
