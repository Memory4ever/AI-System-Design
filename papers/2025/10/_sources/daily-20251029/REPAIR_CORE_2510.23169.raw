<td id="S7.T4.2.1.6.15" class="ltx_td ltx_align_center ltx_border_b"><span id="S7.T4.2.1.6.15.1" class="ltx_text ltx_font_bold">.726</span></td>
<td id="S7.T4.2.1.6.16" class="ltx_td ltx_align_center ltx_border_b"><span id="S7.T4.2.1.6.16.1" class="ltx_text ltx_font_bold">.744</span></td></tr>
