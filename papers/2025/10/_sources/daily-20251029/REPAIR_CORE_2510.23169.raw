<tbody class="ltx_tbody">
<tr id="S7.T4.2.1.3" class="ltx_tr">
<th id="S7.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S7.T4.2.1.3.1.1" class="ltx_text ltx_font_smallcaps">MATCH</span> (LS(F),Linear)</th>
<td id="S7.T4.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T4.2.1.3.2.1" class="ltx_text ltx_font_bold">.673</span></td>
