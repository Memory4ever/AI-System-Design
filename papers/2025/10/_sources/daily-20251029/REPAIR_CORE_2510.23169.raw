<tbody class="ltx_tbody">
<tr id="A2.tab1.2.2" class="ltx_tr">
<td id="A2.tab1.2.2.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_l ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Python</td>
<td id="A2.tab1.2.2.2" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Functional Correctness</td>
<td id="A2.tab1.2.2.3" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A2.tab1.2.2.3.1" class="ltx_inline-block ltx_align_top">
<span id="A2.tab1.2.2.3.1.1" class="ltx_p">Given a string s and a natural number n, implement a function that returns all words from string s with exactly n consonants in order. Return empty list if s is empty.</span>
</span></td>
<td id="A2.tab1.2.2.4" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A2.tab1.2.2.4.1" class="ltx_inline-block">
<span id="A2.tab1.2.2.4.1.1" class="ltx_p ltx_minipage ltx_align_middle" style="width:345.0pt;"><span id="A2.tab1.2.2.4.1.1.1" class="ltx_text ltx_font_typewriter">arr = []
<br class="ltx_break">for word in s.split():
<br class="ltx_break"> s = word.replace("a", "").replace("e", "")\
<br class="ltx_break">   .replace("i", "").replace("o", "")\
<br class="ltx_break">   .replace("u", "")
<br class="ltx_break"> if len(s) == n:
<br class="ltx_break">   arr.append(word)
<br class="ltx_break">return arr
<br class="ltx_break"></span></span>
</span></td>
<td id="A2.tab1.2.2.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0</td>
<td id="A2.tab1.2.2.6" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0</td>
<td id="A2.tab1.2.2.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.774</td></tr>
</tbody>
