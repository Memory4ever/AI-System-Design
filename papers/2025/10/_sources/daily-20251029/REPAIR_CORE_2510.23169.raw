<span id="A2.tab3.2.3.1.1" class="ltx_inline-block">
<span id="A2.tab3.2.3.1.1.1" class="ltx_p ltx_minipage ltx_align_top" style="width:345.0pt;"><span id="A2.tab3.2.3.1.1.1.1" class="ltx_text ltx_font_typewriter">String s = Integer.toBinaryString(N);
<br class="ltx_break">int sum = 0;
<br class="ltx_break">for (int i = 0; i &lt; s.length(); i++) {
<br class="ltx_break"> sum += Integer.parseInt(
<br class="ltx_break">   String.valueOf(s.charAt(i)));
<br class="ltx_break">}
<br class="ltx_break">return Integer.toString(sum);
</span></span>
