</div>
<div id="lstnumberx7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7</span>
              
              
              
            <span id="lstnumberx7.2" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx7.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.4" class="ltx_text ltx_font_typewriter">-&gt;</span><span id="lstnumberx7.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.6" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter" style="--ltx-fg-color:#FF00FF;">tuple</span><span id="lstnumberx7.7" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx7.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">torch</span><span id="lstnumberx7.9" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx7.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">FloatTensor</span><span id="lstnumberx7.11" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx7.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">torch</span><span id="lstnumberx7.14" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx7.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">FloatTensor</span><span id="lstnumberx7.16" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx7.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">torch</span><span id="lstnumberx7.19" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx7.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">FloatTensor</span><span id="lstnumberx7.21" class="ltx_text ltx_font_typewriter">]:</span>
</div>
<div id="lstnumberx8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8</span>
              
              
              
            <span id="lstnumberx8.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx8.3" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#9400D1;">""</span><span id="lstnumberx8.4" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#9400D1;">"</span>
</div>
