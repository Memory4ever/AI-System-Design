            <span id="lstnumberx37.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx37.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#FF00FF;">return</span><span id="lstnumberx37.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx37.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">losses</span><span id="lstnumberx37.6" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx37.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx37.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">chosen_s</span><span id="lstnumberx37.9" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx37.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">detach</span><span id="lstnumberx37.11" class="ltx_text ltx_font_typewriter">(),</span><span id="lstnumberx37.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx37.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">rejected_s</span><span id="lstnumberx37.14" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx37.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">detach</span><span id="lstnumberx37.16" class="ltx_text ltx_font_typewriter">()</span>
</div>
