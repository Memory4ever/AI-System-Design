<td id="S3.T2.2.1.6.2" class="ltx_td ltx_align_center ltx_border_b"><span id="S3.T2.2.1.6.2.1" class="ltx_text ltx_font_bold">98.77%</span></td>
<td id="S3.T2.2.1.6.3" class="ltx_td ltx_align_center ltx_border_b"><span id="S3.T2.2.1.6.3.1" class="ltx_text ltx_font_bold">96.40%</span></td>
