<tr id="S2.T1.2.1.9" class="ltx_tr">
<th id="S2.T1.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DSA</th>
<td id="S2.T1.2.1.9.2" class="ltx_td ltx_align_center"><span id="S2.T1.2.1.9.2.1" class="ltx_text ltx_font_bold">0.057</span></td>
<td id="S2.T1.2.1.9.3" class="ltx_td ltx_align_center"><span id="S2.T1.2.1.9.3.1" class="ltx_text ltx_font_bold">0.008</span></td>
<td id="S2.T1.2.1.9.4" class="ltx_td ltx_align_center"><span id="S2.T1.2.1.9.4.1" class="ltx_text ltx_font_bold">0.056</span></td>
<td id="S2.T1.2.1.9.5" class="ltx_td ltx_align_center"><span id="S2.T1.2.1.9.5.1" class="ltx_text ltx_font_bold">0.007</span></td>
