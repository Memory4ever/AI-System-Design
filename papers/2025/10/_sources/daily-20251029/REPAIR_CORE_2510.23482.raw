<td id="A1.T2.2.6.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_rr ltx_border_t" style="padding:2.5pt 5.0pt;">2.0000</td>
<td id="A1.T2.2.6.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding:2.5pt 5.0pt;">1.9682</td>
