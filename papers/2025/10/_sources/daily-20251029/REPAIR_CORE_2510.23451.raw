<td id="S4.T3.6.1.42.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#FFF5F5;"><span id="S4.T3.6.1.42.6.1" class="ltx_text" style="--ltx-bg-color:#FFF5F5;">64.61</span></td>
<td id="S4.T3.6.1.42.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#FFFAF3;"><span id="S4.T3.6.1.42.7.1" class="ltx_text" style="--ltx-bg-color:#FFFAF3;">66.62</span></td>
<td id="S4.T3.6.1.42.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#F3F7EC;"><span id="S4.T3.6.1.42.8.1" class="ltx_text" style="--ltx-bg-color:#F3F7EC;">52.57</span></td>
<td id="S4.T3.6.1.42.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#F5FCFE;"><span id="S4.T3.6.1.42.9.1" class="ltx_text" style="--ltx-bg-color:#F5FCFE;">63.54</span></td>
<td id="S4.T3.6.1.42.10" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#F9F8FF;"><span id="S4.T3.6.1.42.10.1" class="ltx_text" style="--ltx-bg-color:#F9F8FF;">58.10</span></td>
