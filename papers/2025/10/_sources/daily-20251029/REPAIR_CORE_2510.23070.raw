<span id="A1.T8.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:327.8pt;">
<span id="A1.T8.2.2.1.1.1" class="ltx_p"><span id="A1.T8.2.2.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">Korean<span id="A1.T8.2.2.1.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></span></span>
