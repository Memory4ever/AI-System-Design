1 0 0 -1 0 8.92)" width="33.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m10" class="ltx_math_unparsed" alttext="0.6\times" display="inline" intent=":literal"><semantics><mrow><mn>0.6</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">0.6\times</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 277.81 34.3)"><foreignObject style="--ltx-fo-width:2.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.08em;font-size:10pt;" height="10.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="33.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m11" class="ltx_math_unparsed" alttext="0.2\times" display="inline" intent=":literal"><semantics><mrow><mn>0.2</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">0.2\times</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 4.53 63.47)"><foreignObject style="--ltx-fo-width:1.62em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="22.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m12" class="ltx_Math" alttext="\geq\beta" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\geq\beta</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 122.64 63.47)"><foreignObject style="--ltx-fo-width:1.62em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="22.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m13" class="ltx_Math" alttext="\geq\beta" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\geq\beta</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 271.72 63.47)"><foreignObject style="--ltx-fo-width:2.84em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="39.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m14" class="ltx_Math" alttext="\geq\beta_{\text{tail}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><msub><mi>β</mi><mtext>tail</mtext></msub></mrow><annotation encoding="application/x-tex">\geq\beta_{\text{tail}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S2.F2.4" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S2.F2.5" class="ltx_text" style="font-size:90%;">In the CIF activation process, the feed-forward network predicts <math id="S2.F2.m4" class="ltx_Math" alttext="\alpha_{\text{pre}}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mtext>pre</mtext></msub><annotation encoding="application/x-tex">\alpha_{\text{pre}}</annotation></semantics></math>; the threshold <math id="S2.F2.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> is set to 1, with <math id="S2.F2.m6" class="ltx_Math" alttext="\beta_{\text{tail}}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mtext>tail</mtext></msub><annotation encoding="application/x-tex">\beta_{\text{tail}}</annotation></semantics></math> set to 0.45.</span></figcaption>
</figure>
<div id="S2.SS1.p3" class="ltx_para">
<p id="S2.SS1.p3.1" class="ltx_p">To quantify these errors, we compute their rates by normalizing error counts with respect to the number of reference units. We first define the normalized Levenshtein<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite> distance as <math id="S2.SS1.p3.m1" class="ltx_Math" alttext="\text{NLD}(x,y)=\text{Lev}(x,y)/\max(|x|,|y|)" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>NLD</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mtext>Lev</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow><mo>,</mo><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{NLD}(x,y)=\text{Lev}(x,y)/\max(|x|,|y|)</annotation></semantics></math>. PE are counted when the normalized phoneme distance falls below <math id="S2.SS1.p3.m2" class="ltx_Math" alttext="\theta_{\text{PE}}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mtext>PE</mtext></msub><annotation encoding="application/x-tex">\theta_{\text{PE}}</annotation></semantics></math>, and SE are counted when the reference and hypothesis show boundary mismatches but their de-spaced strings have a character-level distance below <math id="S2.SS1.p3.m3" class="ltx_Math" alttext="\theta_{\text{SE}}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mtext>SE</mtext></msub><annotation encoding="application/x-tex">\theta_{\text{SE}}</annotation></semantics></math>.</p>
</div>
<div id="S2.SS1.p4" class="ltx_para">
<p id="S2.SS1.p4.1" class="ltx_p">The PE rate and SE rate are computed as follows:</p>
<table id="S2.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E1.m1" class="ltx_Math" alttext="\text{PE Rate}=\frac{\sum\{\text{NLD}(\mathrm{ref}_{\text{phone}},\mathrm{hyp}_{\text{phone}})\leq\theta_{\text{PE}}\}}{\sum{\mathrm{ref}_{\text{phone}}}}" display="block" intent=":literal"><semantics><mrow><mtext>PE Rate</mtext><mo>=</mo><mfrac><mrow><mo rspace="0em">∑</mo><mo stretchy="false">{</mo><mtext>NLD</mtext><mo stretchy="false">(</mo><mi>ref</mi><msub><mrow></mrow><mtext>phone</mtext></msub><mo>,</mo><mi>hyp</mi><msub><mrow></mrow><mtext>phone</mtext></msub><mo stretchy="false">)</mo><mo>≤</mo><mi>θ</mi><msub><mrow></mrow><mtext>PE</mtext></msub><mo stretchy="false">}</mo></mrow><mrow><mo>∑</mo><msub><mi>ref</mi><mtext>phone</mtext></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\text{PE Rate}=\frac{\sum\{\text{NLD}(\mathrm{ref}_{\text{phone}},\mathrm{hyp}_{\text{phone}})\leq\theta_{\text{PE}}\}}{\sum{\mathrm{ref}_{\text{phone}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1)</span></td></tr></tbody>
</table>
<table id="S2.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E2.m1" class="ltx_Math" alttext="\text{SE Rate}=\frac{\sum\{\text{SE $\cap$ NLD}(\mathrm{ref}_{\text{char}},\mathrm{hyp}_{\text{char}})\leq\theta_{\text{SE}}\}}{\sum{\mathrm{ref}_{\text{boundary}}}}" display="block" intent=":literal"><semantics><mrow><mtext>SE Rate</mtext><mo>=</mo><mfrac><mrow><mo rspace="0em">∑</mo><mo stretchy="false">{</mo><mrow><mtext>SE </mtext><mo>∩</mo><mtext> NLD</mtext></mrow><mo stretchy="false">(</mo><mi>ref</mi><msub><mrow></mrow><mtext>char</mtext></msub><mo>,</mo><mi>hyp</mi><msub><mrow></mrow><mtext>char</mtext></msub><mo stretchy="false">)</mo><mo>≤</mo><mi>θ</mi><msub><mrow></mrow><mtext>SE</mtext></msub><mo stretchy="false">}</mo></mrow><mrow><mo>∑</mo><msub><mi>ref</mi><mtext>boundary</mtext></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\text{SE Rate}=\frac{\sum\{\text{SE $\cap$ NLD}(\mathrm{ref}_{\text{char}},\mathrm{hyp}_{\text{char}})\leq\theta_{\text{SE}}\}}{\sum{\mathrm{ref}_{\text{boundary}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.2 </span>Multi-scale CIF Strategy</h3>

<div id="S2.SS2.p1" class="ltx_para">
<p id="S2.SS2.p1.1" class="ltx_p">To address the unstable behavior of CIF in synthetic languages, we propose <span id="S2.SS2.p1.1.1" class="ltx_text ltx_font_italic">M-CIF</span>, a multi-scale framework that alleviates multi-syllabic ambiguity through progressive alignment. As shown in Figure <a href="#S1.F3" title="Figure 3 ‣ 1 Introduction ‣ M-CIF: Multi-Scale Alignment for CIF-Based Non-Autoregressive ASR" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>(a), it aligns encoder-derived acoustic representations at the character, phoneme, and word levels, with scale-specific CTC objectives providing auxiliary supervision for stable training.</p>
</div>
<figure id="S2.T1" class="ltx_table ltx_figure_panel ltx_align_center">
<div id="S2.T1.1" class="ltx_inline-block ltx_figure_panel ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:53.6pt;vertical-align:-25.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-104.0pt,16.2pt) scale(0.623875533493419,0.623875533493419) ;">
<table id="S2.T1.1.1" class="ltx_tabular ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S2.T1.1.1.1" class="ltx_tr">
<td id="S2.T1.1.1.1.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:11.4pt;padding-right:11.4pt;" rowspan="2"><span id="S2.T1.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Method</span></td>
<td id="S2.T1.1.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:11.4pt;padding-right:11.4pt;" rowspan="2"><span id="S2.T1.1.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Param.</span></td>
<td id="S2.T1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:11.4pt;padding-right:11.4pt;" colspan="3"><span id="S2.T1.1.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">EN(LS) <math id="S2.SS2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
