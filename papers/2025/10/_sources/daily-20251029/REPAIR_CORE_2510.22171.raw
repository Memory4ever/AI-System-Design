<td id="S5.T1.5.1.5.6" class="ltx_td ltx_align_center">76.12</td>
<td id="S5.T1.5.1.5.7" class="ltx_td ltx_align_center">62.75</td></tr>
<tr id="S5.T1.5.1.6" class="ltx_tr">
<th id="S5.T1.5.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Entropy</th>
<td id="S5.T1.5.1.6.2" class="ltx_td ltx_align_center ltx_border_t">61.38</td>
<td id="S5.T1.5.1.6.3" class="ltx_td ltx_align_center ltx_border_t">35.65</td>
<td id="S5.T1.5.1.6.4" class="ltx_td ltx_align_center ltx_border_t">67.57</td>
<td id="S5.T1.5.1.6.5" class="ltx_td ltx_align_center ltx_border_t">49.23</td>
<td id="S5.T1.5.1.6.6" class="ltx_td ltx_align_center ltx_border_t">54.15</td>
