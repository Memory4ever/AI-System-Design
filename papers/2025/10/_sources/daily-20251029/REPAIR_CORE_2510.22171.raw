<tr id="S5.T1.5.1.5" class="ltx_tr">
<th id="S5.T1.5.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Self-Eval Confidence</th>
<td id="S5.T1.5.1.5.2" class="ltx_td ltx_align_center">71.53</td>
