<th id="S5.T1.5.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="10"><span id="S5.T1.5.1.3.1.1" class="ltx_text">
<span id="S5.T1.5.1.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:8.8pt;height:45.3pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:45.3pt;transform:translate(-18.3pt,-18.3pt) rotate(-90deg) ;">
<span id="S5.T1.5.1.3.1.1.1.1" class="ltx_p">AOKVQA</span>
</span></span></span></th>
