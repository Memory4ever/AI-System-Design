<td id="A3.T8.6.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T8.6.1.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">15</span></td>
<td id="A3.T8.6.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T8.6.1.6.1" class="ltx_text ltx_font_bold" style="font-size:80%;">20</span></td>
<td id="A3.T8.6.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T8.6.1.7.1" class="ltx_text ltx_font_bold" style="font-size:80%;">25</span></td></tr>
