            Input <math id="alg2.l1.m1" class="ltx_Math" alttext="{\mathbf{x}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{0}</annotation></semantics></math>, Path-drop prob <math id="alg2.l1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>,
encoder <math id="alg2.l1.m3" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math>, middle blocks <math id="alg2.l1.m4" class="ltx_Math" alttext="g_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">g_{\theta}</annotation></semantics></math>, decoder <math id="alg2.l1.m5" class="ltx_Math" alttext="h_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">h_{\theta}</annotation></semantics></math>, condition <math id="alg2.l1.m6" class="ltx_Math" alttext="{\mathbf{c}}" display="inline" intent=":literal"><semantics><mi>𝐜</mi><annotation encoding="application/x-tex">{\mathbf{c}}</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            <span id="alg2.l2.2" class="ltx_text ltx_font_bold">while</span> not converged <span id="alg2.l2.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
              Sample <math id="alg2.l3.m1" class="ltx_Math" alttext="t\sim[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∼</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\sim[0,1]</annotation></semantics></math> and <math id="alg2.l3.m2" class="ltx_Math" alttext="\epsilon\sim\mathcal{N}(0,I)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon\sim\mathcal{N}(0,I)</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
              <math id="alg2.l4.m1" class="ltx_Math" alttext="{\mathbf{x}}_{t}\leftarrow(1-t)\,{\mathbf{x}}_{0}+t\,\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{t}\leftarrow(1-t)\,{\mathbf{x}}_{0}+t\,\epsilon</annotation></semantics></math>
<span id="alg2.l4.2" class="ltx_text" style="float:right;"><math id="alg2.l4.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <math id="alg2.l4.m3" class="ltx_Math" alttext="{\mathbf{x}}_{t}\in\mathbb{R}^{B\times N\times C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{t}\in\mathbb{R}^{B\times N\times C}</annotation></semantics></math>
</span>
</div>
