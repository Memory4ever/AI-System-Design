<td id="S4.T1.4.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="5">w CFG (<math id="S4.T1.m6" class="ltx_Math" alttext="w=1.4" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mn>1.4</mn></mrow><annotation encoding="application/x-tex">w=1.4</annotation></semantics></math>)</td></tr>
