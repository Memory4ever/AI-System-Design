<td id="S4.T1.4.1.4.13" class="ltx_td ltx_align_center"><span id="S4.T1.4.1.4.13.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">0.55</span></td></tr>
<tr id="S4.T1.4.1.5" class="ltx_tr">
<td id="S4.T1.4.1.5.1" class="ltx_td ltx_align_left ltx_border_r">   + Progressive Training</td>
<td id="S4.T1.4.1.5.2" class="ltx_td ltx_align_center ltx_border_r">SD</td>
<td id="S4.T1.4.1.5.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.4.1.5.3.1" class="ltx_text ltx_font_bold">16.8</span></td>
