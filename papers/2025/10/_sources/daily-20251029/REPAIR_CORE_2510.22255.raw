<td id="S7.T1.8.1.19.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T1.8.1.19.5.1" class="ltx_text" style="--ltx-bg-color:#E5EEF0;">   35.3<math id="S7.T1.m33" class="ltx_Math" alttext="{}_{\texttt{+1.5}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext style="--ltx-fg-color:#00B464;--ltx-bg-color:#E5EEF0;" class="ltx_mathvariant_monospace" mathbackground="#E5EEF0" mathcolor="#00B464">+1.5</mtext></msub><annotation encoding="application/x-tex">{}_{\texttt{+1.5}}</annotation></semantics></math></span></td>
