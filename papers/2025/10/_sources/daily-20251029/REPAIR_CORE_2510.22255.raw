<td id="S7.T1.8.1.20.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_r"><span id="S7.T1.8.1.20.1.1" class="ltx_text" style="--ltx-bg-color:#CBDEE2;">Qwen3-4B + Dense-PACR</span></td>
<td id="S7.T1.8.1.20.2" class="ltx_td ltx_align_center ltx_border_b"><span id="S7.T1.8.1.20.2.1" class="ltx_text" style="--ltx-bg-color:#CBDEE2;">   46.7<math id="S7.T1.m36" class="ltx_Math" alttext="{}_{\texttt{+6.7}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext style="--ltx-fg-color:#00B464;--ltx-bg-color:#CBDEE2;" class="ltx_mathvariant_monospace" mathbackground="#CBDEE2" mathcolor="#00B464">+6.7</mtext></msub><annotation encoding="application/x-tex">{}_{\texttt{+6.7}}</annotation></semantics></math></span></td>
<td id="S7.T1.8.1.20.3" class="ltx_td ltx_align_center ltx_border_b"><span id="S7.T1.8.1.20.3.1" class="ltx_text" style="--ltx-bg-color:#CBDEE2;">   63.4<math id="S7.T1.m37" class="ltx_Math" alttext="{}_{\texttt{-0.4}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext style="--ltx-fg-color:#B40064;--ltx-bg-color:#CBDEE2;" class="ltx_mathvariant_monospace" mathbackground="#CBDEE2" mathcolor="#B40064">-0.4</mtext></msub><annotation encoding="application/x-tex">{}_{\texttt{-0.4}}</annotation></semantics></math></span></td>
