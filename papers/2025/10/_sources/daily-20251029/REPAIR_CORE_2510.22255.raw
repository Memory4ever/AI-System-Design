<td id="S7.T1.8.1.6.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T1.8.1.6.3.1" class="ltx_text" style="--ltx-bg-color:#E5EEF0;">    48.4 <math id="S7.T1.m5" class="ltx_Math" alttext="{}_{\texttt{+1.4}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext style="--ltx-fg-color:#00B464;--ltx-bg-color:#E5EEF0;" class="ltx_mathvariant_monospace" mathbackground="#E5EEF0" mathcolor="#00B464">+1.4</mtext></msub><annotation encoding="application/x-tex">{}_{\texttt{+1.4}}</annotation></semantics></math></span></td>
