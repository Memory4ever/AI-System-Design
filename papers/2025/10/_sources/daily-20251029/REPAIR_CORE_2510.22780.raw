<td id="A4.T8.2.1.7.2" class="ltx_td ltx_align_center"><span id="A4.T8.2.1.7.2.1" class="ltx_text" style="font-size:90%;">94.4</span></td>
<td id="A4.T8.2.1.7.3" class="ltx_td ltx_align_center ltx_border_r"><span id="A4.T8.2.1.7.3.1" class="ltx_text" style="font-size:90%;">64.6</span></td>
<td id="A4.T8.2.1.7.4" class="ltx_td ltx_align_center"><span id="A4.T8.2.1.7.4.1" class="ltx_text" style="font-size:90%;">50.0</span></td>
