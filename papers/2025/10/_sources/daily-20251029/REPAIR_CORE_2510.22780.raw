<td id="A4.T8.2.1.6.2" class="ltx_td ltx_align_center"><span id="A4.T8.2.1.6.2.1" class="ltx_text" style="font-size:90%;">71.5</span></td>
<td id="A4.T8.2.1.6.3" class="ltx_td ltx_align_center ltx_border_r"><span id="A4.T8.2.1.6.3.1" class="ltx_text" style="font-size:90%;">49.3</span></td>
<td id="A4.T8.2.1.6.4" class="ltx_td ltx_align_center"><span id="A4.T8.2.1.6.4.1" class="ltx_text" style="font-size:90%;">29.5</span></td>
