<td id="A1.T4.2.1.17.3" class="ltx_td ltx_align_center"><span id="A1.T4.2.1.17.3.1" class="ltx_text" style="font-size:90%;position:relative; bottom:-2.3pt;"><img src="2510.22780v1/logo/oh-logo.png" id="A1.T4.g38" class="ltx_graphics ltx_img_square" style="aspect-ratio:18/18;" width="18" height="18" alt="[Uncaptioned image]"></span><span id="A1.T4.2.1.17.3.2" class="ltx_text" style="font-size:90%;position:relative; bottom:-2.3pt;"><img src="2510.22780v1/logo/oai-logo.png" id="A1.T4.g39" class="ltx_graphics ltx_img_square" style="aspect-ratio:18/18;" width="18" height="18" alt="[Uncaptioned image]"></span><span id="A1.T4.2.1.17.3.3" class="ltx_text" style="font-size:90%;position:relative; bottom:-1.1pt;"><img src="2510.22780v1/logo/manus-logo.png" id="A1.T4.g40" class="ltx_graphics ltx_img_square" style="aspect-ratio:15/15;" width="15" height="15" alt="[Uncaptioned image]"></span></td></tr>
