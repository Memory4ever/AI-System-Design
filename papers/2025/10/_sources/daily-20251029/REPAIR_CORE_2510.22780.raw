<td id="A1.T4.2.1.18.1" class="ltx_td ltx_align_left"><span id="A1.T4.2.1.18.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">task_tracking</span></td>
<td id="A1.T4.2.1.18.2" class="ltx_td ltx_align_left"><span id="A1.T4.2.1.18.2.1" class="ltx_text" style="font-size:90%;">Track the task-solving progress by managing a todo list.</span></td>
<td id="A1.T4.2.1.18.3" class="ltx_td ltx_align_center"><span id="A1.T4.2.1.18.3.1" class="ltx_text" style="font-size:90%;position:relative; bottom:-2.3pt;"><img src="2510.22780v1/logo/oh-logo.png" id="A1.T4.g41" class="ltx_graphics ltx_img_square" style="aspect-ratio:18/18;" width="18" height="18" alt="[Uncaptioned image]"></span></td></tr>
