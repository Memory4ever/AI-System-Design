<tr id="A4.T8.2.1.8" class="ltx_tr">
<td id="A4.T8.2.1.8.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r"><span id="A4.T8.2.1.8.1.1" class="ltx_text" style="font-size:90%;">design</span></td>
<td id="A4.T8.2.1.8.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T8.2.1.8.2.1" class="ltx_text" style="font-size:90%;">91.7</span></td>
<td id="A4.T8.2.1.8.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="A4.T8.2.1.8.3.1" class="ltx_text" style="font-size:90%;">60.6</span></td>
