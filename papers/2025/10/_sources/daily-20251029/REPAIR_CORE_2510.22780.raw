<td id="A4.T8.2.1.6.7" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F4F8E6;"><span id="A4.T8.2.1.6.7.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F4F8E6;">67.4</span></td></tr>
<tr id="A4.T8.2.1.7" class="ltx_tr">
