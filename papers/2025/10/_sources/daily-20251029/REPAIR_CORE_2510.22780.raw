<td id="A1.T4.2.1.20.3" class="ltx_td ltx_align_center"><span id="A1.T4.2.1.20.3.1" class="ltx_text" style="font-size:90%;position:relative; bottom:-1.1pt;"><img src="2510.22780v1/logo/manus-logo.png" id="A1.T4.g44" class="ltx_graphics ltx_img_square" style="aspect-ratio:15/15;" width="15" height="15" alt="[Uncaptioned image]"></span></td></tr>
<tr id="A1.T4.2.1.21" class="ltx_tr">
