<td id="S4.T2.2.1.4.2" class="ltx_td ltx_align_center">67</td>
<td id="S4.T2.2.1.4.3" class="ltx_td ltx_align_center">216.33</td>
<td id="S4.T2.2.1.4.4" class="ltx_td ltx_align_center ltx_border_r">30.9</td>
<td id="S4.T2.2.1.4.5" class="ltx_td ltx_align_center">70</td>
