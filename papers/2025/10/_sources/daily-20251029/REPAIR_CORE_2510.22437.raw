<td id="S4.T2.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">60</td>
<td id="S4.T2.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">10.08</td>
<td id="S4.T2.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t">5.08</td></tr>
