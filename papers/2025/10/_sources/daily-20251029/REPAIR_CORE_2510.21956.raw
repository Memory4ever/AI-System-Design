<td id="S1.T1.3.1.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">FlashAttention-2 <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Dao (2024)</a></cite></td>
<td id="S1.T1.3.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m4" class="ltx_Math" alttext="f(x)=\exp{x}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">f(x)=\exp{x}</annotation></semantics></math></td>
<td id="S1.T1.3.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m5" class="ltx_Math" alttext="O(N^{2}D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(N^{2}D)</annotation></semantics></math></td>
<td id="S1.T1.3.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m6" class="ltx_Math" alttext="O(ND)\,\,/\,\,O(ND)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo rspace="0.340em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.562em">/</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O(ND)\,\,/\,\,O(ND)</annotation></semantics></math></td>
<td id="S1.T1.3.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">100</td>
<td id="S1.T1.3.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">1.5</td></tr>
<tr id="S1.T1.3.1.4" class="ltx_tr">
<td id="S1.T1.3.1.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><span id="S1.T1.3.1.4.1.1" class="ltx_text"></span> <span id="S1.T1.3.1.4.1.2" class="ltx_text">
<span id="S1.T1.3.1.4.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S1.T1.3.1.4.1.2.1.1" class="ltx_tr">
<span id="S1.T1.3.1.4.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:4pt;padding-bottom:4pt;">Speculative</span></span>
<span id="S1.T1.3.1.4.1.2.1.2" class="ltx_tr">
<span id="S1.T1.3.1.4.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:4pt;padding-bottom:4pt;">Decoding LA <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib30" title="" class="ltx_ref">You et al. (2024)</a></cite></span></span>
</span></span><span id="S1.T1.3.1.4.1.3" class="ltx_text"></span></td>
<td id="S1.T1.3.1.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m7" class="ltx_Math" alttext="f(x)=bx" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">f(x)=bx</annotation></semantics></math></td>
<td id="S1.T1.3.1.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m8" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math></td>
<td id="S1.T1.3.1.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m9" class="ltx_Math" alttext="O(ND)\,\,/\,\,O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo rspace="0.340em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.562em">/</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O(ND)\,\,/\,\,O(ND^{2})</annotation></semantics></math></td>
<td id="S1.T1.3.1.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">OOM</td>
<td id="S1.T1.3.1.4.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">OOM</td></tr>
<tr id="S1.T1.3.1.5" class="ltx_tr">
<td id="S1.T1.3.1.5.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">Gated LA <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib28" title="" class="ltx_ref">Yang et al. (2023)</a></cite></td>
<td id="S1.T1.3.1.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m10" class="ltx_Math" alttext="f(x)=bx" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">f(x)=bx</annotation></semantics></math></td>
<td id="S1.T1.3.1.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m11" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math></td>
<td id="S1.T1.3.1.5.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m12" class="ltx_Math" alttext="O(ND)\,\,/\,\,O(ND)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo rspace="0.340em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.562em">/</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O(ND)\,\,/\,\,O(ND)</annotation></semantics></math></td>
<td id="S1.T1.3.1.5.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">100</td>
<td id="S1.T1.3.1.5.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">5</td></tr>
<tr id="S1.T1.3.1.6" class="ltx_tr">
<td id="S1.T1.3.1.6.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">Our LA</td>
<td id="S1.T1.3.1.6.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m13" class="ltx_Math" alttext="f(x)=a+bx" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)=a+bx</annotation></semantics></math></td>
<td id="S1.T1.3.1.6.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m14" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math></td>
<td id="S1.T1.3.1.6.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;"><math id="S1.T1.m15" class="ltx_Math" alttext="O(ND)\,\,/\,\,O(ND)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo rspace="0.340em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.562em">/</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O(ND)\,\,/\,\,O(ND)</annotation></semantics></math></td>
<td id="S1.T1.3.1.6.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">25</td>
<td id="S1.T1.3.1.6.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:4pt;padding-bottom:4pt;">1.5</td></tr>
</table>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S1.T1.4" class="ltx_text" style="font-size:90%;">Table 1</span>: </span><span id="S1.T1.5" class="ltx_text" style="font-size:90%;">Comparing the time and memory complexity of attention mechanisms. We achieve <math id="S1.T1.m22" class="ltx_math_unparsed" alttext="3.3\times" display="inline" intent=":literal"><semantics><mrow><mn>3.3</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">3.3\times</annotation></semantics></math> speedup and <math id="S1.T1.m23" class="ltx_math_unparsed" alttext="3.6\times" display="inline" intent=":literal"><semantics><mrow><mn>3.6</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">3.6\times</annotation></semantics></math> memory reduction compared to the sota linear attention (LA) implementation Gate LA. The forward-pass time and memory is for a single attention layer with a batch size of <math id="S1.T1.m24" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>, <math id="S1.T1.m25" class="ltx_Math" alttext="16" display="inline" intent=":literal"><semantics><mn>16</mn><annotation encoding="application/x-tex">16</annotation></semantics></math> heads, dimension per head of <math id="S1.T1.m26" class="ltx_Math" alttext="128" display="inline" intent=":literal"><semantics><mn>128</mn><annotation encoding="application/x-tex">128</annotation></semantics></math>, token length of <math id="S1.T1.m27" class="ltx_Math" alttext="10^{4}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>4</mn></msup><annotation encoding="application/x-tex">10^{4}</annotation></semantics></math>, and causal mask applied. (OOM = out of memory)</span></figcaption>
</figure>
<div id="S1.p4" class="ltx_para ltx_noindent">
<p id="S1.p4.1" class="ltx_p">Due to the less established nature of LA, its implementation is far less optimized compared to Regular Attention, and leaving considerable room for improvement. Given LA’s apparently comparable expressivity on certain problems and its increasing popularity, evidenced by deployable LA LLMs <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib16" title="" class="ltx_ref">MiniMax et al. (2025)</a></cite>, enhancing LA implementation efficiency is crucial. Our contribution is as follows:</p>
<ul id="S1.I1" class="ltx_itemize">
<li id="S1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S1.I1.i1.p1.1" class="ltx_p">We derive a novel method for calculating the forward and backward-pass of attention layer with LA based on the Transformer architecture in time complexity of <math id="S1.I1.i1.p1.m1" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math> and <math id="S1.I1.i1.p1.m2" class="ltx_Math" alttext="O(ND)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND)</annotation></semantics></math> memory (Section <a href="#S3" title="3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>). This method aims to enable a parallelized implementation with minimal off-chip memory access.</p>
</div></li>
<li id="S1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S1.I1.i2.p1.1" class="ltx_p">We implement the forward and backward-pass on GPU using CUDA, extensively optimizing both data movement and thread scheduling (Section <a href="#S4" title="4 Optimized Implementation ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>).</p>
</div></li>
<li id="S1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I1.i3.p1" class="ltx_para">
<p id="S1.I1.i3.p1.1" class="ltx_p">We evaluate our implementation in an isolated setting as a standalone attention layer, and in an end-to-end setting where we train a 1.4 billion parameter LLM. We achieve <math id="S1.I1.i3.p1.m1" class="ltx_math_unparsed" alttext="3.3\times" display="inline" intent=":literal"><semantics><mrow><mn>3.3</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">3.3\times</annotation></semantics></math> speedup and a <math id="S1.I1.i3.p1.m2" class="ltx_math_unparsed" alttext="3.6\times" display="inline" intent=":literal"><semantics><mrow><mn>3.6</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">3.6\times</annotation></semantics></math> reduction in memory consumption compared to the state-of-the-art LA implementation <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib28" title="" class="ltx_ref">Yang et al. (2023)</a></cite> on A6000 GPU.</p>
</div></li>
</ul>
</div>
<div id="S1.p5" class="ltx_para ltx_noindent">
<p id="S1.p5.1" class="ltx_p">By improving the implementation efficiency of Linear Attention (LA) is critical for its practical adoption, as it directly enables the deployment of large transformer models on resource-constrained platforms like edge devices and mobile hardware. This gain in efficiency democratizes access to advanced AI capabilities by allowing complex models to run effectively on smartphones, embedded systems, and other low-power devices. To elaborate, LA enables faster inference speeds and lower energy consumption, which are essential for real-time applications and battery-powered systems. Moreover, the predictable linear scaling of efficient LA simplifies deployment planning and optimizes batching strategies, making it a viable solution for production environments operating under strict computational budgets.</p>
</div>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2 </span>Background</h2>

<div id="S2.p1" class="ltx_para ltx_noindent">
<p id="S2.p1.1" class="ltx_p">At its core, the Transformer architecture <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib26" title="" class="ltx_ref">Vaswani et al. (2017)</a></cite> processes sequential data through three main components. First, the input sequence is transformed into three sets of matrices Query (<math id="S2.p1.m1" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math>), Key (<math id="S2.p1.m2" class="ltx_Math" alttext="\mathbf{K}" display="inline" intent=":literal"><semantics><mi>𝐊</mi><annotation encoding="application/x-tex">\mathbf{K}</annotation></semantics></math>), and Value (<math id="S2.p1.m3" class="ltx_Math" alttext="\mathbf{V}" display="inline" intent=":literal"><semantics><mi>𝐕</mi><annotation encoding="application/x-tex">\mathbf{V}</annotation></semantics></math>) by passing the input embeddings through linear projection layers. The attention layer then calculates its Output (<math id="S2.p1.m4" class="ltx_Math" alttext="\mathbf{O}" display="inline" intent=":literal"><semantics><mi>𝐎</mi><annotation encoding="application/x-tex">\mathbf{O}</annotation></semantics></math>) as a weighted sum of the Value vectors, where the weights are determined by the similarity between the Query of one position and the Key of all positions. This attention mechanism allows the model to weigh the importance of different parts of the input sequence when processing each position. The Output is then processed by a feed-forward network, which applies non-linear transformations. These layers are typically stacked multiple times, along with residual connections to build deep and powerful models. Our focus is solely on the attention mechanism.</p>
</div>
<div id="S2.p2" class="ltx_para ltx_noindent">
<p id="S2.p2.1" class="ltx_p"><span id="S2.p2.1.1" class="ltx_text ltx_font_bold">Notation:</span> Bold upper case letters, e.g., <math id="S2.p2.m1" class="ltx_Math" alttext="\mathbf{X}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">\mathbf{X}</annotation></semantics></math> indicate matrices, and bold lower case letters <math id="S2.p2.m2" class="ltx_Math" alttext="\mathbf{x}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{x}_{i}</annotation></semantics></math> and <math id="S2.p2.m3" class="ltx_Math" alttext="\mathbf{x}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{x}_{ij}</annotation></semantics></math> the <math id="S2.p2.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th row and the element at the <math id="S2.p2.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th row and <math id="S2.p2.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th column of <math id="S2.p2.m7" class="ltx_Math" alttext="\mathbf{X}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">\mathbf{X}</annotation></semantics></math> respectively. Letters <math id="S2.p2.m8" class="ltx_Math" alttext="X,x,x_{i},x^{(i)}_{jkl}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>x</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">X,x,x_{i},x^{(i)}_{jkl}</annotation></semantics></math> indicate scalars.</p>
</div>
<section id="S2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.1 </span>Regular Attention</h3>

<div id="S2.SS1.p1" class="ltx_para ltx_noindent">
<p id="S2.SS1.p1.1" class="ltx_p">In the Regular Attention mechanism, given a sequence of <math id="S2.SS1.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> tokens, model dimension of <math id="S2.SS1.p1.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, <math id="S2.SS1.p1.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> heads, and dimension per head of <math id="S2.SS1.p1.m4" class="ltx_Math" alttext="D=C/H" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mi>C</mi><mo>/</mo><mi>H</mi></mrow></mrow><annotation encoding="application/x-tex">D=C/H</annotation></semantics></math>, each head takes in three matrices <math id="S2.SS1.p1.m5" class="ltx_Math" alttext="\mathbf{Q},\mathbf{K},\mathbf{V}\in\mathbb{R}^{N\times D}" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>,</mo><mi>𝐊</mi><mo>,</mo><mrow><mi>𝐕</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q},\mathbf{K},\mathbf{V}\in\mathbb{R}^{N\times D}</annotation></semantics></math>, and gives an output matrix <math id="S2.SS1.p1.m6" class="ltx_Math" alttext="\mathbf{O}\in\mathbb{R}^{N\times D}" display="inline" intent=":literal"><semantics><mrow><mi>𝐎</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{O}\in\mathbb{R}^{N\times D}</annotation></semantics></math>. The output is calculated using a matrix vector product (MVP) of the Attention matrix <math id="S2.SS1.p1.m7" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math> with <math id="S2.SS1.p1.m8" class="ltx_Math" alttext="\mathbf{V}" display="inline" intent=":literal"><semantics><mi>𝐕</mi><annotation encoding="application/x-tex">\mathbf{V}</annotation></semantics></math> as follows:</p>
<table id="S2.EGx1" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S2.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E1.m1" class="ltx_Math" alttext="\displaystyle\mathbf{O}=\mathbf{A}\mathbf{V},\,\,\mathbf{A}=\mbox{Softmax}\left(\mathbf{Q}\mathbf{K}^{T}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐎</mi><mo>=</mo><mi>𝐀𝐕</mi></mrow><mo rspace="0.507em">,</mo><mrow><mi>𝐀</mi><mo>=</mo><mrow><mtext>Softmax</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝐐𝐊</mi><mi>T</mi></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{O}=\mathbf{A}\mathbf{V},\,\,\mathbf{A}=\mbox{Softmax}\left(\mathbf{Q}\mathbf{K}^{T}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1)</span></td></tr></tbody>
<tbody id="S2.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E2.m1" class="ltx_Math" alttext="\displaystyle\mathbf{o_{ij}}\!=\!\dfrac{\sum_{n=1}^{N}{\exp(\mathbf{q}_{i}.\mathbf{k_{n}}/\sqrt{D})\mathbf{v_{n,j}}}}{\sum_{n=1}^{N}{\exp(\mathbf{q}_{i}.\mathbf{k}_{n}/\sqrt{D})}}\!=\!\dfrac{\sum_{n=1}^{N}{f(\mathbf{q}_{i}.\mathbf{k_{n}})\mathbf{v_{n,j}}}}{\sum_{n=1}^{N}{f(\mathbf{q}_{i}.\mathbf{k}_{n})}}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐨</mi><mi>𝐢𝐣</mi></msub><mo lspace="0.108em" rspace="0.108em">=</mo><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>exp</mi><mo stretchy="false">(</mo><mi>𝐪</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><mi>𝐤</mi><msub><mrow></mrow><mi>𝐧</mi></msub><mo>/</mo><msqrt><mi>D</mi></msqrt><mo stretchy="false">)</mo><mi>𝐯</mi><msub><mrow></mrow><mrow><mi>𝐧</mi><mo>,</mo><mi>𝐣</mi></mrow></msub></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>exp</mi><mo stretchy="false">(</mo><mi>𝐪</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><mi>𝐤</mi><msub><mrow></mrow><mi>n</mi></msub><mo>/</mo><msqrt><mi>D</mi></msqrt><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0.108em" rspace="0.108em">=</mo><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>f</mi><mo stretchy="false">(</mo><mi>𝐪</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><mi>𝐤</mi><msub><mrow></mrow><mi>𝐧</mi></msub><mo stretchy="false">)</mo><mi>𝐯</mi><msub><mrow></mrow><mrow><mi>𝐧</mi><mo>,</mo><mi>𝐣</mi></mrow></msub></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>f</mi><mo stretchy="false">(</mo><mi>𝐪</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><mi>𝐤</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{o_{ij}}\!=\!\dfrac{\sum_{n=1}^{N}{\exp(\mathbf{q}_{i}.\mathbf{k_{n}}/\sqrt{D})\mathbf{v_{n,j}}}}{\sum_{n=1}^{N}{\exp(\mathbf{q}_{i}.\mathbf{k}_{n}/\sqrt{D})}}\!=\!\dfrac{\sum_{n=1}^{N}{f(\mathbf{q}_{i}.\mathbf{k_{n}})\mathbf{v_{n,j}}}}{\sum_{n=1}^{N}{f(\mathbf{q}_{i}.\mathbf{k}_{n})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
<p id="S2.SS1.p1.2" class="ltx_p">where <math id="S2.SS1.p1.m9" class="ltx_Math" alttext="f(x)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(x)</annotation></semantics></math> is the Attention kernel. Therefore, each head has a computational complexity of <math id="S2.SS1.p1.m10" class="ltx_Math" alttext="O(N^{2}D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(N^{2}D)</annotation></semantics></math>. The final output is given by concatenating outputs from each head. We can apply a causal mask by changing Eq. <a href="#S2.E2" title="In 2.1 Regular Attention ‣ 2 Background ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> to</p>
<table id="S2.EGx2" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S2.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E3.m1" class="ltx_Math" alttext="\displaystyle\mathbf{O}=\mbox{tril}(\mathbf{A})\mathbf{V},\quad\mbox{tril}(\mathbf{A})_{ij}=\begin{cases}\mathbf{a}_{ij},j\leq i\\
0,\,j&gt;i\end{cases},\quad\mathbf{o}_{ij}=\dfrac{\sum_{n=1}^{i}{f(\mathbf{q}_{i}.\mathbf{k}_{n})\mathbf{v}_{n,j}}}{\sum_{n=1}^{i}{f(\mathbf{q}_{i}.\mathbf{k}_{n})}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐎</mi><mo>=</mo><mrow><mtext>tril</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>tril</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝐚</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>,</mo><mi>j</mi></mrow><mo>≤</mo><mi>i</mi></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>0</mn><mo rspace="0.337em">,</mo><mi>j</mi></mrow><mo>&gt;</mo><mi>i</mi></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mi>f</mi><mo stretchy="false">(</mo><mi>𝐪</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><mi>𝐤</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo><mi>𝐯</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mi>f</mi><mo stretchy="false">(</mo><mi>𝐪</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><mi>𝐤</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{O}=\mbox{tril}(\mathbf{A})\mathbf{V},\quad\mbox{tril}(\mathbf{A})_{ij}=\begin{cases}\mathbf{a}_{ij},j\leq i\\
0,\,j&gt;i\end{cases},\quad\mathbf{o}_{ij}=\dfrac{\sum_{n=1}^{i}{f(\mathbf{q}_{i}.\mathbf{k}_{n})\mathbf{v}_{n,j}}}{\sum_{n=1}^{i}{f(\mathbf{q}_{i}.\mathbf{k}_{n})}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
</div>
<div id="S2.SS1.p2" class="ltx_para ltx_noindent">
<p id="S2.SS1.p2.1" class="ltx_p">The traditional softmax attention kernel, defined by <math id="S2.SS1.p2.m1" class="ltx_Math" alttext="f(x)=\mbox{exp}(x/\sqrt{D})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>exp</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>/</mo><msqrt><mi>D</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)=\mbox{exp}(x/\sqrt{D})</annotation></semantics></math>, is not the sole viable option for deriving the attention matrix. In fact, any definite positive convex function can substitute for the attention kernel, with the choice impacting the model’s expressivity.</p>
</div>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.2 </span>Linear Attention</h3>

<div id="S2.SS2.p1" class="ltx_para ltx_noindent">
<p id="S2.SS2.p1.1" class="ltx_p">Using LA, the attention kernel is chosen to be <math id="S2.SS2.p1.m1" class="ltx_Math" alttext="f(x)=a+bx" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)=a+bx</annotation></semantics></math>, with the coefficients either as the Taylor expansion of the exponential or as learnable parameters. The output with (left) and without (right) causal mask will be</p>
<table id="S2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E4.m1" class="ltx_Math" alttext="\displaystyle\mathbf{o_{ij}}=\dfrac{\sum_{n=1}^{N}(a+b\mathbf{q}_{i}.\mathbf{k}_{n})\mathbf{v_{n,j}}}{\sum_{n=1}^{N}a+b\mathbf{q}_{i}.\mathbf{k}_{n}},\quad\mathbf{o_{ij}}=\dfrac{\sum_{n=1}^{i}(a+b\mathbf{q}_{i}.\mathbf{k}_{n})\mathbf{v_{n,j}}}{\sum_{n=1}^{i}a+b\mathbf{q}_{i}.\mathbf{k}_{n}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐨</mi><mi>𝐢𝐣</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mo stretchy="false">(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mi>𝐪</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><mi>𝐤</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo><mi>𝐯</mi><msub><mrow></mrow><mrow><mi>𝐧</mi><mo>,</mo><mi>𝐣</mi></mrow></msub></mrow><mrow><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mi>a</mi></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><msub><mi>𝐤</mi><mi>n</mi></msub></mrow></mfrac></mstyle></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐨</mi><mi>𝐢𝐣</mi></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mo stretchy="false">(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mi>𝐪</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><mi>𝐤</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo><mi>𝐯</mi><msub><mrow></mrow><mrow><mi>𝐧</mi><mo>,</mo><mi>𝐣</mi></mrow></msub></mrow><mrow><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mi>a</mi></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><msub><mi>𝐤</mi><mi>n</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{o_{ij}}=\dfrac{\sum_{n=1}^{N}(a+b\mathbf{q}_{i}.\mathbf{k}_{n})\mathbf{v_{n,j}}}{\sum_{n=1}^{N}a+b\mathbf{q}_{i}.\mathbf{k}_{n}},\quad\mathbf{o_{ij}}=\dfrac{\sum_{n=1}^{i}(a+b\mathbf{q}_{i}.\mathbf{k}_{n})\mathbf{v_{n,j}}}{\sum_{n=1}^{i}a+b\mathbf{q}_{i}.\mathbf{k}_{n}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S2.SS2.p1.2" class="ltx_p">which can be implemented using either an RNN architecture <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib14" title="" class="ltx_ref">Katharopoulos et al. (2020)</a>; <a href="#bib.bib28" title="" class="ltx_ref">Yang et al. (2023)</a></cite> or a Transformer <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib12" title="" class="ltx_ref">Han et al. (2023)</a>; <a href="#bib.bib5" title="" class="ltx_ref">Cai et al. (2022)</a>; <a href="#bib.bib33" title="" class="ltx_ref">Zhang et al. (2024)</a>; <a href="#bib.bib27" title="" class="ltx_ref">Wang et al. ()</a>; <a href="#bib.bib23" title="" class="ltx_ref">Shen et al. (2021)</a>; <a href="#bib.bib30" title="" class="ltx_ref">You et al. (2024)</a></cite> in <math id="S2.SS2.p1.m2" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math> time. Our approach is based on the Transformer architecture. In Section <a href="#S3" title="3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> we demonstrate our novel method for calculating the forward and backward-pass of LA, and in Section <a href="#S4" title="4 Optimized Implementation ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> our optimized implementation.</p>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Method</h2>

<div id="S3.p1" class="ltx_para ltx_noindent">
<p id="S3.p1.1" class="ltx_p">We analyze LA to identify and reuse repeated computation patterns, thereby reducing the computational cost of both the forward and backward-passes. We will demonstrate this process with a causal mask applied; attention without a causal mask follows a similar procedure. Our method and its subsequent implementation are intrinsically linked. The computational pattern we devise is specifically designed to enable a highly parallelized implementation with minimal data movement, as we elaborate in Section <a href="#S4" title="4 Optimized Implementation ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Forward-Pass</h3>

<div id="S3.SS1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS1.p1.1" class="ltx_p">With <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="f(x)=a+bx" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)=a+bx</annotation></semantics></math> as the attention kernel and causal mask applied, the output matrix <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="\mathbf{O}" display="inline" intent=":literal"><semantics><mi>𝐎</mi><annotation encoding="application/x-tex">\mathbf{O}</annotation></semantics></math> can be broken down to</p>
<table id="S3.EGx4" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S3.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="\displaystyle\mathbf{o}_{ij}=\dfrac{\sum_{n=1}^{i}{f(\mathbf{q}_{i}^{T}\mathbf{k_{n}})\mathbf{v}_{nj}}}{\sum_{n=1}^{i}{f(\mathbf{q}_{i}^{T}\mathbf{k_{n}})}}=\dfrac{\mathbf{f}_{ij}}{\mathbf{g}_{i}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐪</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mi>𝐧</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐪</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mi>𝐧</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>=</mo><mfrac><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{o}_{ij}=\dfrac{\sum_{n=1}^{i}{f(\mathbf{q}_{i}^{T}\mathbf{k_{n}})\mathbf{v}_{nj}}}{\sum_{n=1}^{i}{f(\mathbf{q}_{i}^{T}\mathbf{k_{n}})}}=\dfrac{\mathbf{f}_{ij}}{\mathbf{g}_{i}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
<tbody id="S3.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E6.m1" class="ltx_Math" alttext="\displaystyle\mathbf{f}_{ij}\!=\!\sum_{n=1}^{i}\!\left(a+b\!\sum_{m=1}^{D}\!{\mathbf{q}_{im}\mathbf{k}_{n,m}}\right)\mathbf{v}_{nj},\quad\mathbf{g}_{i}\!=\!\sum_{n=1}^{i}\left(a+b\sum_{m=1}^{D}\!{\mathbf{q}_{im}\mathbf{k}_{n,m}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0.108em" rspace="0.0539em">=</mo><mrow><munderover><mo lspace="0.0539em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover><mrow><mrow><mo>(</mo><mrow><mi>a</mi><mo>+</mo><mrow><mpadded style="width:0.426em;" width="0.426em"><mi>b</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover><mrow><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐠</mi><mi>i</mi></msub><mo rspace="0.0539em">=</mo><mrow><munderover><mo lspace="0.0539em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover><mrow><mo>(</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover><mrow><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{f}_{ij}\!=\!\sum_{n=1}^{i}\!\left(a+b\!\sum_{m=1}^{D}\!{\mathbf{q}_{im}\mathbf{k}_{n,m}}\right)\mathbf{v}_{nj},\quad\mathbf{g}_{i}\!=\!\sum_{n=1}^{i}\left(a+b\sum_{m=1}^{D}\!{\mathbf{q}_{im}\mathbf{k}_{n,m}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">Changing the summation orders we get</p>
<table id="S3.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E7.m1" class="ltx_Math" alttext="\displaystyle\mathbf{f}_{ij}=a\sum_{n=1}^{i}{\mathbf{v}_{nj}}+b\sum_{m=1}^{D}{\sum_{n=1}^{i}{\mathbf{q}_{im}\mathbf{k}_{n,m}\mathbf{v}_{nj}}},\quad\quad\mathbf{g}_{i}=a\sum_{n=1}^{i}{1}+b\sum_{m=1}^{D}{\sum_{n=1}^{i}{\mathbf{q}_{im}\mathbf{k}_{n,m}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><msub><mi>𝐯</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><mrow><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>𝐠</mi><mi>i</mi></msub><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><mn>1</mn></mrow></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><mrow><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{f}_{ij}=a\sum_{n=1}^{i}{\mathbf{v}_{nj}}+b\sum_{m=1}^{D}{\sum_{n=1}^{i}{\mathbf{q}_{im}\mathbf{k}_{n,m}\mathbf{v}_{nj}}},\quad\quad\mathbf{g}_{i}=a\sum_{n=1}^{i}{1}+b\sum_{m=1}^{D}{\sum_{n=1}^{i}{\mathbf{q}_{im}\mathbf{k}_{n,m}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p1.3" class="ltx_p">Factorizing the repeated computation we arrive at</p>
<table id="S3.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E8.m1" class="ltx_Math" alttext="\displaystyle\mathbf{f}_{ij}=x^{(1)}_{ij}+\sum_{m=1}^{D}{\mathbf{q}_{im}x^{(2)}_{ijm}},\quad\mathbf{g}_{i}=y^{(1)}_{i}+\sum_{m=1}^{D}{\mathbf{q}_{im}y^{(2)}_{im}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐠</mi><mi>i</mi></msub><mo>=</mo><mrow><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{f}_{ij}=x^{(1)}_{ij}+\sum_{m=1}^{D}{\mathbf{q}_{im}x^{(2)}_{ijm}},\quad\mathbf{g}_{i}=y^{(1)}_{i}+\sum_{m=1}^{D}{\mathbf{q}_{im}y^{(2)}_{im}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p1.4" class="ltx_p">where the <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="x,y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x,y</annotation></semantics></math>, are the identified repeated computation patterns and can be derived in linear time as</p>
<table id="S3.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex1.m1" class="ltx_Math" alttext="\displaystyle x^{(1)}_{1j}=a\,\mathbf{v}_{1j},\quad x^{(1)}_{ij}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle x^{(1)}_{1j}=a\,\mathbf{v}_{1j},\quad x^{(1)}_{ij}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex1.m2" class="ltx_Math" alttext="\displaystyle=x^{(1)}_{i-1j}+a\,\mathbf{v}_{ij}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>x</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=x^{(1)}_{i-1j}+a\,\mathbf{v}_{ij},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex2.m1" class="ltx_Math" alttext="\displaystyle x^{(2)}_{1jm}=b\,\mathbf{k}_{1m}\mathbf{v}_{1j},\quad x^{(2)}_{ijm}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>x</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle x^{(2)}_{1jm}=b\,\mathbf{k}_{1m}\mathbf{v}_{1j},\quad x^{(2)}_{ijm}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex2.m2" class="ltx_Math" alttext="\displaystyle=x^{(2)}_{i-1jm}+b\,\mathbf{k}_{im}\mathbf{v}_{ij}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>x</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=x^{(2)}_{i-1jm}+b\,\mathbf{k}_{im}\mathbf{v}_{ij},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E9.m1" class="ltx_Math" alttext="\displaystyle y^{(1)}_{i}=a\,i,\quad y^{(2)}_{1m}=b\,\mathbf{k}_{1m},\quad" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>y</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle y^{(1)}_{i}=a\,i,\quad y^{(2)}_{1m}=b\,\mathbf{k}_{1m},\quad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E9.m2" class="ltx_Math" alttext="\displaystyle y^{(2)}_{im}=y^{(2)}_{i-1m}+b\,\mathbf{k}_{im}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>y</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle y^{(2)}_{im}=y^{(2)}_{i-1m}+b\,\mathbf{k}_{im}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS1.p2" class="ltx_para ltx_noindent">
<p id="S3.SS1.p2.1" class="ltx_p">Equation <a href="#S3.E5" title="In 3.1 Forward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> requires <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="O(ND)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND)</annotation></semantics></math> operations, while Equations <a href="#S3.E7" title="In 3.1 Forward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> and <a href="#S3.E9" title="In 3.1 Forward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> both require <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math> operations. Therefore, the overall computational complexity of the forward-pass will be <math id="S3.SS1.p2.m3" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math>. When using a differentiable programming library such as JAX or PyTorch, all operations must be tracked in the computational graph. Consequently, all intermediate variables from Eq. <a href="#S3.E9" title="In 3.1 Forward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> need to be stored, resulting in a high memory consumption of <math id="S3.SS1.p2.m4" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math>. To reduce the memory consumption and to also improve runtime efficiency, we derive the analytical gradient of the LA attention head and manually implement the backward-pass, instead of relying on these libraries.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Backward-Pass</h3>

<div id="S3.SS2.p1" class="ltx_para ltx_noindent">
<p id="S3.SS2.p1.1" class="ltx_p">To maintain an overall linear time scaling during training, the backward-pass must also be calculated with a time complexity of <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math>. Let us denote the dot product <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="\mathbf{q}_{i}.\mathbf{k}_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐪</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">.</mo><msub><mi>𝐤</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{q}_{i}.\mathbf{k}_{j}</annotation></semantics></math> as <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="s_{ij}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">s_{ij}</annotation></semantics></math>, and write the attention <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="\mathbf{a}" display="inline" intent=":literal"><semantics><mi>𝐚</mi><annotation encoding="application/x-tex">\mathbf{a}</annotation></semantics></math> and output <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="\mathbf{o}" display="inline" intent=":literal"><semantics><mi>𝐨</mi><annotation encoding="application/x-tex">\mathbf{o}</annotation></semantics></math> with causal mask applied as</p>
<table id="S3.EGx8" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S3.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E10.m1" class="ltx_Math" alttext="\displaystyle\mathbf{o}_{ij}=\sum_{n=1}^{i}{\mathbf{a}_{in}\mathbf{v}_{nj}},\quad\mathbf{a}_{in}=\dfrac{f(s_{ij})}{\sum_{m=1}^{i}f(s_{im})}=\dfrac{f(s_{ij})}{\mathbf{g}_{i}},\quad f(x)=a+bx" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover><mrow><msub><mi>𝐚</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐚</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{o}_{ij}=\sum_{n=1}^{i}{\mathbf{a}_{in}\mathbf{v}_{nj}},\quad\mathbf{a}_{in}=\dfrac{f(s_{ij})}{\sum_{m=1}^{i}f(s_{im})}=\dfrac{f(s_{ij})}{\mathbf{g}_{i}},\quad f(x)=a+bx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">Taking the derivative with respect to <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="s_{il}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">s_{il}</annotation></semantics></math>, we find <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="\dfrac{\partial\mathbf{o}_{ij}}{\partial s_{il}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\dfrac{\partial\mathbf{o}_{ij}}{\partial s_{il}}</annotation></semantics></math> as</p>
</div>
<div id="S3.SS2.p2" class="ltx_para ltx_noindent">
<table id="S3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E11.m1" class="ltx_Math" alttext="\displaystyle\dfrac{\partial\mathbf{a}_{in}}{\partial s_{il}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐚</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\dfrac{\partial\mathbf{a}_{in}}{\partial s_{il}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E11.m2" class="ltx_Math" alttext="\displaystyle=\begin{cases}\dfrac{b\,(1-\mathbf{a}_{ij})}{\sum_{m=1}^{i}f(s_{im})},n=l\vskip 5.0pt\\
\dfrac{b\,(-\mathbf{a}_{ij})}{\sum_{m=1}^{i}f(s_{im})},n\neq l\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>𝐚</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi>n</mi></mrow><mo>=</mo><mi>l</mi></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mi>𝐚</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo><mi>n</mi></mrow><mo>≠</mo><mi>l</mi></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\dfrac{b\,(1-\mathbf{a}_{ij})}{\sum_{m=1}^{i}f(s_{im})},n=l\vskip 5.0pt\\
\dfrac{b\,(-\mathbf{a}_{ij})}{\sum_{m=1}^{i}f(s_{im})},n\neq l\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
<tbody id="S3.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E12.m1" class="ltx_Math" alttext="\displaystyle\dfrac{\partial\mathbf{o}_{ij}}{\partial s_{il}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\dfrac{\partial\mathbf{o}_{ij}}{\partial s_{il}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E12.m2" class="ltx_Math" alttext="\displaystyle=\sum_{n=1}^{i}\dfrac{\partial\mathbf{a}_{in}}{\partial s_{il}}\mathbf{v}_{nj}=\dfrac{b\,(\mathbf{v}_{lj}-\sum_{n=1}^{i}\mathbf{a}_{in}\mathbf{v}_{nj})}{\sum_{m=1}^{i}f(s_{im})}=\dfrac{b}{\mathbf{g}_{i}}(\mathbf{v}_{lj}-\mathbf{o}_{ij})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐚</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><msub><mi>𝐚</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>b</mi><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{n=1}^{i}\dfrac{\partial\mathbf{a}_{in}}{\partial s_{il}}\mathbf{v}_{nj}=\dfrac{b\,(\mathbf{v}_{lj}-\sum_{n=1}^{i}\mathbf{a}_{in}\mathbf{v}_{nj})}{\sum_{m=1}^{i}f(s_{im})}=\dfrac{b}{\mathbf{g}_{i}}(\mathbf{v}_{lj}-\mathbf{o}_{ij}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p2.1" class="ltx_p">We now derive the partial derivative with respect to <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="\mathbf{Q},\mathbf{K},\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>,</mo><mi>𝐊</mi><mo>,</mo><mi>𝐕</mi></mrow><annotation encoding="application/x-tex">\mathbf{Q},\mathbf{K},\mathbf{V}</annotation></semantics></math></p>
<table id="S3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E13.m1" class="ltx_Math" alttext="\displaystyle\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{q}_{ir}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{q}_{ir}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E13.m2" class="ltx_Math" alttext="\displaystyle=\sum_{l=1}^{i}\dfrac{\partial s_{il}}{\partial\mathbf{q}_{ir}}\dfrac{\partial\mathbf{o}_{ij}}{\partial s_{il}}=\dfrac{\sum_{l=1}^{i}b\,\mathbf{k}_{l,r}}{\mathbf{g}_{i}}(\mathbf{v}_{lj}-\mathbf{o}_{ij})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow></mfrac></mstyle></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>l</mi><mo>,</mo><mi>r</mi></mrow></msub></mrow></mrow><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=1}^{i}\dfrac{\partial s_{il}}{\partial\mathbf{q}_{ir}}\dfrac{\partial\mathbf{o}_{ij}}{\partial s_{il}}=\dfrac{\sum_{l=1}^{i}b\,\mathbf{k}_{l,r}}{\mathbf{g}_{i}}(\mathbf{v}_{lj}-\mathbf{o}_{ij})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
<tbody id="S3.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E14.m1" class="ltx_Math" alttext="\displaystyle\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{k}_{p,r}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝐤</mi><mrow><mi>p</mi><mo>,</mo><mi>r</mi></mrow></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{k}_{p,r}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E14.m2" class="ltx_Math" alttext="\displaystyle=\dfrac{\partial s_{ip}}{\partial\mathbf{k}_{p,r}}\dfrac{\partial\mathbf{o}_{ij}}{\partial s_{ip}}=\dfrac{b\,\mathbf{q}_{ir}}{\mathbf{g}_{i}}(\mathbf{v}_{p,j}-\mathbf{o}_{ij})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝐤</mi><mrow><mi>p</mi><mo>,</mo><mi>r</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub></mrow></mfrac></mstyle></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mrow><mi>p</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{\partial s_{ip}}{\partial\mathbf{k}_{p,r}}\dfrac{\partial\mathbf{o}_{ij}}{\partial s_{ip}}=\dfrac{b\,\mathbf{q}_{ir}}{\mathbf{g}_{i}}(\mathbf{v}_{p,j}-\mathbf{o}_{ij})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
<tbody id="S3.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E15.m1" class="ltx_Math" alttext="\displaystyle\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{v}_{p,j}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝐯</mi><mrow><mi>p</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{v}_{p,j}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E15.m2" class="ltx_Math" alttext="\displaystyle=\mathbf{a}_{ip}=\dfrac{f(s_{ip})}{\mathbf{g}_{i}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>𝐚</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbf{a}_{ip}=\dfrac{f(s_{ip})}{\mathbf{g}_{i}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p2.2" class="ltx_p">During the backward-pass, given the gradient of the layer in front <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="\mathbf{\Omega}" display="inline" intent=":literal"><semantics><mi>𝛀</mi><annotation encoding="application/x-tex">\mathbf{\Omega}</annotation></semantics></math>, the gradient of the attention head <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="\nabla\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>𝚿</mi></mrow><annotation encoding="application/x-tex">\nabla\mathbf{\Psi}</annotation></semantics></math> is calculated as follows</p>
<table id="S3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E16.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\mathbf{q}_{ir}}\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mi>𝚿</mi></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\mathbf{q}_{ir}}\mathbf{\Psi}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E16.m2" class="ltx_Math" alttext="\displaystyle=\sum_{j=1}^{D}\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{q}_{ir}}\mathbf{\Omega}_{ij}=\sum_{j=1}^{D}\dfrac{\sum_{l=1}^{i}b\,\mathbf{k}_{l,r}(\mathbf{v}_{lj}-\mathbf{o}_{ij})}{\mathbf{g}_{i}}\,\mathbf{\Omega}_{ij}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝛀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>l</mi><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝛀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=1}^{D}\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{q}_{ir}}\mathbf{\Omega}_{ij}=\sum_{j=1}^{D}\dfrac{\sum_{l=1}^{i}b\,\mathbf{k}_{l,r}(\mathbf{v}_{lj}-\mathbf{o}_{ij})}{\mathbf{g}_{i}}\,\mathbf{\Omega}_{ij}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
<tbody id="S3.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E17.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\mathbf{k}_{p,r}}\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>𝐤</mi><mrow><mi>p</mi><mo>,</mo><mi>r</mi></mrow></msub></msub><mi>𝚿</mi></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\mathbf{k}_{p,r}}\mathbf{\Psi}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E17.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{p}\sum_{j=1}^{D}\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{k}_{p,r}}\mathbf{\Omega}_{ij}=\sum_{i=1}^{p}\sum_{j=1}^{D}\dfrac{b\,\mathbf{q}_{ir}}{\mathbf{g}_{i}}(\mathbf{v}_{p,j}-\mathbf{o}_{ij})\,\mathbf{\Omega}_{ij}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝐤</mi><mrow><mi>p</mi><mo>,</mo><mi>r</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝛀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mrow><mi>p</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝛀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{p}\sum_{j=1}^{D}\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{k}_{p,r}}\mathbf{\Omega}_{ij}=\sum_{i=1}^{p}\sum_{j=1}^{D}\dfrac{b\,\mathbf{q}_{ir}}{\mathbf{g}_{i}}(\mathbf{v}_{p,j}-\mathbf{o}_{ij})\,\mathbf{\Omega}_{ij}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
<tbody id="S3.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E18.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\mathbf{v}_{p,j}}\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>𝐯</mi><mrow><mi>p</mi><mo>,</mo><mi>j</mi></mrow></msub></msub><mi>𝚿</mi></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\mathbf{v}_{p,j}}\mathbf{\Psi}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E18.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{p}\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{v}_{p,j}}\mathbf{\Omega}_{ij}=\sum_{i=1}^{p}\dfrac{f(s_{ip})}{\mathbf{g}_{i}}\,\mathbf{\Omega}_{ij}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝐯</mi><mrow><mi>p</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝛀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝛀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{p}\dfrac{\partial\mathbf{o}_{ij}}{\partial\mathbf{v}_{p,j}}\mathbf{\Omega}_{ij}=\sum_{i=1}^{p}\dfrac{f(s_{ip})}{\mathbf{g}_{i}}\,\mathbf{\Omega}_{ij}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p2.3" class="ltx_p">Changing the summation order and factorizing the repeated computation we get</p>
<table id="S3.EGx12" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S3.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E19.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\mathbf{q}_{ir}}\mathbf{\Psi}=\sum_{j=1}^{D}\alpha_{ijr}^{Q}-\beta_{ir}^{Q}\,\mathbf{o}_{ij}\,\hat{\mathbf{\Omega}}_{ij},\quad\quad\nabla_{\mathbf{k}_{ir}}\mathbf{\Psi}=\sum_{j=1}^{D}\alpha_{irj}^{K}\,\mathbf{v}_{ij}-\beta_{irj}^{K}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mi>𝚿</mi></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover><msubsup><mi>α</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>Q</mi></msubsup></mrow><mo>−</mo><mrow><msubsup><mi>β</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>Q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mi>𝚿</mi></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>K</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>−</mo><msubsup><mi>β</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>K</mi></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\mathbf{q}_{ir}}\mathbf{\Psi}=\sum_{j=1}^{D}\alpha_{ijr}^{Q}-\beta_{ir}^{Q}\,\mathbf{o}_{ij}\,\hat{\mathbf{\Omega}}_{ij},\quad\quad\nabla_{\mathbf{k}_{ir}}\mathbf{\Psi}=\sum_{j=1}^{D}\alpha_{irj}^{K}\,\mathbf{v}_{ij}-\beta_{irj}^{K},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
<tbody id="S3.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E20.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\mathbf{v}_{ij}}\mathbf{\Psi}=\alpha_{ij}^{V}+\sum_{j=1}^{D}\beta_{rj}^{V}\,\mathbf{k}_{ir},\quad\quad\hat{\mathbf{\Omega}}_{ij}=\dfrac{\mathbf{\Omega}_{ij}}{\mathbf{g}_{i}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mi>𝚿</mi></mrow><mo>=</mo><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>V</mi></msubsup><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover><mrow><msubsup><mi>β</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>V</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mfrac><msub><mi>𝛀</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><msub><mi>𝐠</mi><mi>i</mi></msub></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\mathbf{v}_{ij}}\mathbf{\Psi}=\alpha_{ij}^{V}+\sum_{j=1}^{D}\beta_{rj}^{V}\,\mathbf{k}_{ir},\quad\quad\hat{\mathbf{\Omega}}_{ij}=\dfrac{\mathbf{\Omega}_{ij}}{\mathbf{g}_{i}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p2.4" class="ltx_p">where the <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and <math id="S3.SS2.p2.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> are the factorized coefficients and are defined as</p>
<table id="S3.EGx13" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S3.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\displaystyle\alpha_{1jr}^{Q}=b\,\mathbf{k}_{1r}\,\mathbf{v}_{1j},\quad\alpha_{ijr}^{Q}=\alpha_{i-1jr}^{Q}+b\,\mathbf{k}_{ir}\,\mathbf{v}_{ij}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>α</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>Q</mi></msubsup><mo>=</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>Q</mi></msubsup><mo>=</mo><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mi>Q</mi></msubsup><mo>+</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{1jr}^{Q}=b\,\mathbf{k}_{1r}\,\mathbf{v}_{1j},\quad\alpha_{ijr}^{Q}=\alpha_{i-1jr}^{Q}+b\,\mathbf{k}_{ir}\,\mathbf{v}_{ij},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_Math" alttext="\displaystyle\beta_{1r}^{Q}=b\,\mathbf{k}_{1r},\quad\beta_{ir}^{Q}=\beta_{i-1r}^{Q}+b\,\mathbf{k}_{ir}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>β</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>Q</mi></msubsup><mo>=</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>β</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>Q</mi></msubsup><mo>=</mo><mrow><msubsup><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mi>Q</mi></msubsup><mo>+</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta_{1r}^{Q}=b\,\mathbf{k}_{1r},\quad\beta_{ir}^{Q}=\beta_{i-1r}^{Q}+b\,\mathbf{k}_{ir},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex5.m1" class="ltx_Math" alttext="\displaystyle\alpha_{Nrj}^{K}=b\,\mathbf{q}_{Nr}\,\hat{\mathbf{\Omega}}_{Nj},\quad\alpha_{irj}^{K}=\alpha_{i+1rj}^{K}+b\,\mathbf{q}_{ir}\,\hat{\mathbf{\Omega}}_{ij}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>α</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>K</mi></msubsup><mo>=</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>K</mi></msubsup><mo>=</mo><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo>+</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow><mi>K</mi></msubsup><mo>+</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{Nrj}^{K}=b\,\mathbf{q}_{Nr}\,\hat{\mathbf{\Omega}}_{Nj},\quad\alpha_{irj}^{K}=\alpha_{i+1rj}^{K}+b\,\mathbf{q}_{ir}\,\hat{\mathbf{\Omega}}_{ij},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_Math" alttext="\displaystyle\beta_{Nrj}^{K}=b\,\mathbf{q}_{Nr}\,\mathbf{o}_{Nj}\,\hat{\mathbf{\Omega}}_{Nj},\quad\beta_{irj}^{K}=\beta_{i+1rj}^{K}+b\,\mathbf{q}_{ir}\,\mathbf{o}_{ij}\,\hat{\mathbf{\Omega}}_{ij}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>β</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>K</mi></msubsup><mo>=</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐨</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>β</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>K</mi></msubsup><mo>=</mo><mrow><msubsup><mi>β</mi><mrow><mi>i</mi><mo>+</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow><mi>K</mi></msubsup><mo>+</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta_{Nrj}^{K}=b\,\mathbf{q}_{Nr}\,\mathbf{o}_{Nj}\,\hat{\mathbf{\Omega}}_{Nj},\quad\beta_{irj}^{K}=\beta_{i+1rj}^{K}+b\,\mathbf{q}_{ir}\,\mathbf{o}_{ij}\,\hat{\mathbf{\Omega}}_{ij},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="\displaystyle\alpha_{Nj}^{V}=a\,\hat{\mathbf{\Omega}}_{Nj},\quad\alpha_{Nj}^{V}=\alpha_{i+1j}^{V}+a\,\hat{\mathbf{\Omega}}_{ij}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>α</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>V</mi></msubsup><mo>=</mo><mrow><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>α</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>V</mi></msubsup><mo>=</mo><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo>+</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow><mi>V</mi></msubsup><mo>+</mo><mrow><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{Nj}^{V}=a\,\hat{\mathbf{\Omega}}_{Nj},\quad\alpha_{Nj}^{V}=\alpha_{i+1j}^{V}+a\,\hat{\mathbf{\Omega}}_{ij},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E21.m1" class="ltx_Math" alttext="\displaystyle\beta_{Nrj}^{V}=b,\ \mathbf{q}_{Nr}\,\hat{\mathbf{\Omega}}_{Nj},\quad\beta_{irj}^{V}=\beta_{i+1rj}^{V}+b,\ \mathbf{q}_{ir}\,\hat{\mathbf{\Omega}}_{ij}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>β</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>V</mi></msubsup><mo>=</mo><mi>b</mi></mrow><mo rspace="0.667em">,</mo><mrow><msub><mi>𝐪</mi><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>β</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>V</mi></msubsup><mo>=</mo><mrow><msubsup><mi>β</mi><mrow><mi>i</mi><mo>+</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow><mi>V</mi></msubsup><mo>+</mo><mi>b</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta_{Nrj}^{V}=b,\ \mathbf{q}_{Nr}\,\hat{\mathbf{\Omega}}_{Nj},\quad\beta_{irj}^{V}=\beta_{i+1rj}^{V}+b,\ \mathbf{q}_{ir}\,\hat{\mathbf{\Omega}}_{ij}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p3" class="ltx_para ltx_noindent">
<p id="S3.SS2.p3.1" class="ltx_p">Put into words, gradient of the output matrix <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="\mathbf{O}" display="inline" intent=":literal"><semantics><mi>𝐎</mi><annotation encoding="application/x-tex">\mathbf{O}</annotation></semantics></math> can be calculated by storing <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math>, <math id="S3.SS2.p3.m3" class="ltx_Math" alttext="\mathbf{K}" display="inline" intent=":literal"><semantics><mi>𝐊</mi><annotation encoding="application/x-tex">\mathbf{K}</annotation></semantics></math>, <math id="S3.SS2.p3.m4" class="ltx_Math" alttext="\mathbf{V}" display="inline" intent=":literal"><semantics><mi>𝐕</mi><annotation encoding="application/x-tex">\mathbf{V}</annotation></semantics></math>, <math id="S3.SS2.p3.m5" class="ltx_Math" alttext="\mathbf{O}" display="inline" intent=":literal"><semantics><mi>𝐎</mi><annotation encoding="application/x-tex">\mathbf{O}</annotation></semantics></math>, and <math id="S3.SS2.p3.m6" class="ltx_Math" alttext="\mathbf{g}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐠</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{g}_{i}</annotation></semantics></math>; resulting in a reduced memory consumption of <math id="S3.SS2.p3.m7" class="ltx_Math" alttext="O(ND)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND)</annotation></semantics></math> elements. The time complexity is <math id="S3.SS2.p3.m8" class="ltx_Math" alttext="O(ND^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(ND^{2})</annotation></semantics></math> since we perform <math id="S3.SS2.p3.m9" class="ltx_Math" alttext="O(D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D)</annotation></semantics></math> operations for <math id="S3.SS2.p3.m10" class="ltx_Math" alttext="1\leq i\leq N,\,1\leq j\leq D" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>N</mi></mrow><mo>,</mo><mrow><mn> 1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq N,\,1\leq j\leq D</annotation></semantics></math> in Equation <a href="#S3.E21" title="In 3.2 Backward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>, which is the same time complexity as the forward-pass.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Normalization</h3>

<div id="S3.SS3.p1" class="ltx_para ltx_noindent">
<p id="S3.SS3.p1.1" class="ltx_p">It has been suggested <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib18" title="" class="ltx_ref">Qin et al. (2022a)</a></cite> that the lack of expressivity in other subquadratic attention mechanisms rises due to the possibility of their gradients either blowing up or vanishing. To prevent such behavior, we recommend normalizing the query and key vectors before the attention calculation. To be specific, given <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math> and <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="\mathbf{K}" display="inline" intent=":literal"><semantics><mi>𝐊</mi><annotation encoding="application/x-tex">\mathbf{K}</annotation></semantics></math>, we first normalize <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math> and <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="\mathbf{K}" display="inline" intent=":literal"><semantics><mi>𝐊</mi><annotation encoding="application/x-tex">\mathbf{K}</annotation></semantics></math> row-wise as</p>
<table id="S3.EGx14" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S3.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E22.m1" class="ltx_Math" alttext="\displaystyle\mathbf{q}_{i}=\dfrac{\mathbf{q}_{i}}{||\mathbf{q}_{i}||},\quad\mathbf{k}_{i}=\dfrac{\mathbf{k}_{i}}{||\mathbf{k}_{i}||},\quad\forall 1\leq i\leq N." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐪</mi><mi>i</mi></msub><mo>=</mo><mfrac><msub><mi>𝐪</mi><mi>i</mi></msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐪</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐤</mi><mi>i</mi></msub><mo>=</mo><mfrac><msub><mi>𝐤</mi><mi>i</mi></msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐤</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mn>1</mn></mrow><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>N</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{q}_{i}=\dfrac{\mathbf{q}_{i}}{||\mathbf{q}_{i}||},\quad\mathbf{k}_{i}=\dfrac{\mathbf{k}_{i}}{||\mathbf{k}_{i}||},\quad\forall 1\leq i\leq N.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Optimized Implementation</h2>

<div id="S4.p1" class="ltx_para ltx_noindent">
<p id="S4.p1.1" class="ltx_p">Calculating LA in the specific format detailed in Section <a href="#S3" title="3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> offers the potential to increase both the data reuse rate (the number of times each element is used per off-chip memory access) and parallelization. Specifically, the operations are ordered to ensure that each data segment is accessed by a single thread. This ordering prevents scenarios where multiple threads conflict over the same element or where individual threads require data exceeding the shared memory (L1 cache) size, thereby preventing redundant off-chip memory accesses. In this section we will provide the details of our optimized CUDA implementation such as data movement and thread scheduling for the forward and backward-pass. We employ attention kernel of <math id="S4.p1.m1" class="ltx_Math" alttext="f(x)=1+x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">f(x)=1+x</annotation></semantics></math>, and the variables are stored as three dimensional tensors.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Forward-Pass</h3>

<div id="S4.SS1.p1" class="ltx_para ltx_noindent">
<p id="S4.SS1.p1.1" class="ltx_p">To calculate the output <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="\mathbf{O}" display="inline" intent=":literal"><semantics><mi>𝐎</mi><annotation encoding="application/x-tex">\mathbf{O}</annotation></semantics></math>, we require <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="\mathbf{f}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{f}_{ij}</annotation></semantics></math> and <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="\mathbf{g}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐠</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{g}_{i}</annotation></semantics></math>, where <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="\mathbf{f}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{f}_{ij}</annotation></semantics></math> and <math id="S4.SS1.p1.m5" class="ltx_Math" alttext="\mathbf{g}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐠</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{g}_{i}</annotation></semantics></math> are obtained according to Equation <a href="#S3.E8" title="In 3.1 Forward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. We will detail the process for calculating <math id="S4.SS1.p1.m6" class="ltx_Math" alttext="\mathbf{f}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{f}_{ij}</annotation></semantics></math>, and <math id="S4.SS1.p1.m7" class="ltx_Math" alttext="\mathbf{g}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐠</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{g}_{i}</annotation></semantics></math> follows a similar, simpler process.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para ltx_noindent">
<p id="S4.SS1.p2.1" class="ltx_p">To derive <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\mathbf{f}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{f}_{ij}</annotation></semantics></math>, we need to find two sets of coefficients <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="x^{(1)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(1)}</annotation></semantics></math> and <math id="S4.SS1.p2.m3" class="ltx_Math" alttext="x^{(2)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(2)}</annotation></semantics></math>, as described by Equation <a href="#S3.E9" title="In 3.1 Forward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>. The derivation of <math id="S4.SS1.p2.m4" class="ltx_Math" alttext="x^{(1)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(1)}</annotation></semantics></math> and <math id="S4.SS1.p2.m5" class="ltx_Math" alttext="x^{(2)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(2)}</annotation></semantics></math> is sequential, meaning that <math id="S4.SS1.p2.m6" class="ltx_Math" alttext="x^{(1)}_{ij}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(1)}_{ij}</annotation></semantics></math> and <math id="S4.SS1.p2.m7" class="ltx_Math" alttext="x^{(2)}_{ijm}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(2)}_{ijm}</annotation></semantics></math> depend on <math id="S4.SS1.p2.m8" class="ltx_Math" alttext="x^{(1)}_{i-1j}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(1)}_{i-1j}</annotation></semantics></math> and <math id="S4.SS1.p2.m9" class="ltx_Math" alttext="x^{(2)}_{i-1j}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(2)}_{i-1j}</annotation></semantics></math>. As a result, the derivation of each individual <math id="S4.SS1.p2.m10" class="ltx_Math" alttext="x^{(1)}_{ij}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(1)}_{ij}</annotation></semantics></math> and <math id="S4.SS1.p2.m11" class="ltx_Math" alttext="x^{(2)}_{ijm}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(2)}_{ijm}</annotation></semantics></math> cannot be parallelized; at least not without employing ‘<span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_italic">reduction</span>‘ techniques<span id="footnote2" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">2</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">2</sup>
              <span class="ltx_tag ltx_tag_note">2</span>
              
              
              
            <a href="https://developer.download.nvidia.com/assets/cuda/files/reduction.pdf" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://developer.download.nvidia.com/assets/cuda/files/reduction.pdf</a></span></span></span>. For now, let’s assume a non-parallelized approach. Similarly, the derivation of each individual <math id="S4.SS1.p2.m12" class="ltx_Math" alttext="f_{ij}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{ij}</annotation></semantics></math> is also inherently sequential. Therefore, the computation of <math id="S4.SS1.p2.m13" class="ltx_Math" alttext="x^{(1)}_{ij}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(1)}_{ij}</annotation></semantics></math>, <math id="S4.SS1.p2.m14" class="ltx_Math" alttext="x^{(2)}_{ijm}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(2)}_{ijm}</annotation></semantics></math> and <math id="S4.SS1.p2.m15" class="ltx_Math" alttext="f_{ij}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{ij}</annotation></semantics></math> for each <math id="S4.SS1.p2.m16" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> should be performed within the same thread as well.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para ltx_noindent">
<p id="S4.SS1.p3.1" class="ltx_p">As a reminder <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="\mathbf{f}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{f}_{ij}</annotation></semantics></math> is calculated as</p>
<table id="S4.EGx15" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S4.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E23.m1" class="ltx_Math" alttext="\displaystyle\mathbf{f}_{ij}=x^{(1)}_{j}+\sum_{m=1}^{D}{\mathbf{q}_{im}x^{(2)}_{jm}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi>x</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover><mrow><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{f}_{ij}=x^{(1)}_{j}+\sum_{m=1}^{D}{\mathbf{q}_{im}x^{(2)}_{jm}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p3.2" class="ltx_p">which we refer to the left term <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="x^{(1)}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(1)}_{j}</annotation></semantics></math> as the Constant term and the right term <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="\sum_{m=1}^{D}{\mathbf{q}_{i,m}x^{(2)}_{jm}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></msubsup><mrow><msub><mi>𝐪</mi><mrow><mi>i</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\sum_{m=1}^{D}{\mathbf{q}_{i,m}x^{(2)}_{jm}}</annotation></semantics></math> as the Linear term. Let’s first proceed with the Constant term. We call <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> threads for <math id="S4.SS1.p3.m5" class="ltx_Math" alttext="1\leq j\leq D" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">1\leq j\leq D</annotation></semantics></math>, in each thread perform a loop for <math id="S4.SS1.p3.m6" class="ltx_Math" alttext="1\leq i\leq N" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq N</annotation></semantics></math> to calculate <math id="S4.SS1.p3.m7" class="ltx_Math" alttext="x^{(1)}_{ij}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(1)}_{ij}</annotation></semantics></math>, and assign it to <math id="S4.SS1.p3.m8" class="ltx_Math" alttext="f_{ij}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{ij}</annotation></semantics></math> as shown in Algorithm <a href="#alg1" title="Algorithm 1 ‣ Appendix A Implementation Pseudo Codes ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> in the Appendix. Since the <math id="S4.SS1.p3.m9" class="ltx_Math" alttext="x^{(1)}_{ij}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(1)}_{ij}</annotation></semantics></math> values for each <math id="S4.SS1.p3.m10" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is only accessed within a thread, we can use a single register to store and update the <math id="S4.SS1.p3.m11" class="ltx_Math" alttext="x^{(1)}_{ij}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(1)}_{ij}</annotation></semantics></math> values in the for loop, rather than store them for each <math id="S4.SS1.p3.m12" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. This will accelerate the read operations (accessing in-thread registers is considerably faster than accessing shared memory) and reduce the memory consumption. Furthermore, each thread <math id="S4.SS1.p3.m13" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> will access the off-chip memory to read the <math id="S4.SS1.p3.m14" class="ltx_Math" alttext="\mathbf{v}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{v}_{ij}</annotation></semantics></math> values for <math id="S4.SS1.p3.m15" class="ltx_Math" alttext="1\leq i\leq N" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq N</annotation></semantics></math>, and to write <math id="S4.SS1.p3.m16" class="ltx_Math" alttext="\mathbf{f}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{f}_{ij}</annotation></semantics></math>. To leverage the efficient data movement capabilities of NVIDIA GPU Streaming Multiprocessors (SMs), which fetch adjacent data blocks from off-chip memory to the L2 and L1 caches for adjacent blocks and threads, the <math id="S4.SS1.p3.m17" class="ltx_Math" alttext="\mathbf{V}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐕</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{V}_{ij}</annotation></semantics></math> and <math id="S4.SS1.p3.m18" class="ltx_Math" alttext="\mathbf{f}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{f}_{ij}</annotation></semantics></math> values should be stored with <math id="S4.SS1.p3.m19" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> as the first tensor dimension and <math id="S4.SS1.p3.m20" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> as the second.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para ltx_noindent">
<p id="S4.SS1.p4.1" class="ltx_p">To calculate the Linear term, we call <math id="S4.SS1.p4.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> threads for <math id="S4.SS1.p4.m2" class="ltx_Math" alttext="1\leq j\leq D" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">1\leq j\leq D</annotation></semantics></math>, and in each thread perform a loop for <math id="S4.SS1.p4.m3" class="ltx_Math" alttext="1\leq m\leq D" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>m</mi><mo>≤</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">1\leq m\leq D</annotation></semantics></math> within a loop for <math id="S4.SS1.p4.m4" class="ltx_Math" alttext="1\leq i\leq N" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq N</annotation></semantics></math> to calculate <math id="S4.SS1.p4.m5" class="ltx_Math" alttext="x^{(2)}_{ijm}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(2)}_{ijm}</annotation></semantics></math> and add it to <math id="S4.SS1.p4.m6" class="ltx_Math" alttext="f_{ij}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{ij}</annotation></semantics></math>, as shown in Algorithm <a href="#alg2" title="Algorithm 2 ‣ Appendix A Implementation Pseudo Codes ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Since the <math id="S4.SS1.p4.m7" class="ltx_Math" alttext="x^{(2)}_{ijm}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(2)}_{ijm}</annotation></semantics></math> values for each <math id="S4.SS1.p4.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> are only accessed within a thread, we can use an array of registers to store them for each <math id="S4.SS1.p4.m9" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, and sequentially update it as the <math id="S4.SS1.p4.m10" class="ltx_Math" alttext="x^{(2)}_{ijm}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(2)}_{ijm}</annotation></semantics></math> values to accelerate read operations. However, the value of <math id="S4.SS1.p4.m11" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is often too large for the whole <math id="S4.SS1.p4.m12" class="ltx_Math" alttext="x^{(2)}_{ijm}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">x^{(2)}_{ijm}</annotation></semantics></math> <math id="S4.SS1.p4.m13" class="ltx_Math" alttext="1\leq m\leq D" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>m</mi><mo>≤</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">1\leq m\leq D</annotation></semantics></math> to be stored in thread registers. As a workaround we perform reduction, where we break the inner loop into separate <math id="S4.SS1.p4.m14" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> block of threads, that is, we call <math id="S4.SS1.p4.m15" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> blocks, each with <math id="S4.SS1.p4.m16" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> threads, and in each thread performing loop for <math id="S4.SS1.p4.m17" class="ltx_Math" alttext="1\leq m\leq D/L" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>m</mi><mo>≤</mo><mrow><mi>D</mi><mo>/</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">1\leq m\leq D/L</annotation></semantics></math> within a loop for <math id="S4.SS1.p4.m18" class="ltx_Math" alttext="1\leq i\leq N" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq N</annotation></semantics></math>. By applying reduction, multiple threads might edit the same <math id="S4.SS1.p4.m19" class="ltx_Math" alttext="f_{ij}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{ij}</annotation></semantics></math>, and therefore we would have to use ‘Race Aware‘ operations when updating <math id="S4.SS1.p4.m20" class="ltx_Math" alttext="f_{ij}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{ij}</annotation></semantics></math>. We use <math id="S4.SS1.p4.m21" class="ltx_Math" alttext="L=\dfrac{D}{32}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mstyle displaystyle="true"><mfrac><mi>D</mi><mn>32</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">L=\dfrac{D}{32}</annotation></semantics></math> in our implementation.</p>
</div>
<div id="S4.SS1.p5" class="ltx_para ltx_noindent">
<p id="S4.SS1.p5.1" class="ltx_p">Furthermore, since the <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="\mathbf{q}_{im}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{q}_{im}</annotation></semantics></math> and <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="\mathbf{k}_{im}" display="inline" intent=":literal"><semantics><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{k}_{im}</annotation></semantics></math> values for each <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> are accessed within the same block of threads, we can store them in shared memory (note that multiple block of threads will access the same <math id="S4.SS1.p5.m4" class="ltx_Math" alttext="\mathbf{q}_{im}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{q}_{im}</annotation></semantics></math> and <math id="S4.SS1.p5.m5" class="ltx_Math" alttext="\mathbf{k}_{im}" display="inline" intent=":literal"><semantics><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{k}_{im}</annotation></semantics></math>). To be specific, within every iteration of the outer loop (for <math id="S4.SS1.p5.m6" class="ltx_Math" alttext="1\leq i\leq n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq n</annotation></semantics></math>), each thread moves one element of <math id="S4.SS1.p5.m7" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math> and <math id="S4.SS1.p5.m8" class="ltx_Math" alttext="\mathbf{k}" display="inline" intent=":literal"><semantics><mi>𝐤</mi><annotation encoding="application/x-tex">\mathbf{k}</annotation></semantics></math> from the off-chip memory to the shared memory; a total of <math id="S4.SS1.p5.m9" class="ltx_Math" alttext="2\times D" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">2\times D</annotation></semantics></math> elements. Since <math id="S4.SS1.p5.m10" class="ltx_Math" alttext="64\leq D\leq 512" display="inline" intent=":literal"><semantics><mrow><mn>64</mn><mo>≤</mo><mi>D</mi><mo>≤</mo><mn>512</mn></mrow><annotation encoding="application/x-tex">64\leq D\leq 512</annotation></semantics></math>, there is enough shared memory for storage. In order to enable the adjacent threads utilize the shared memory, corresponding <math id="S4.SS1.p5.m11" class="ltx_Math" alttext="\mathbf{q}_{im}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{q}_{im}</annotation></semantics></math> and <math id="S4.SS1.p5.m12" class="ltx_Math" alttext="\mathbf{k}_{im}" display="inline" intent=":literal"><semantics><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{k}_{im}</annotation></semantics></math> values should be stored with <math id="S4.SS1.p5.m13" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> as the first tensor dimension and <math id="S4.SS1.p5.m14" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> as the second. By parallelizing the read operations and utilizing shared memory, we reduce the read time from <math id="S4.SS1.p5.m15" class="ltx_Math" alttext="ND\,t_{oc}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>t</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub></mrow><annotation encoding="application/x-tex">ND\,t_{oc}</annotation></semantics></math> to <math id="S4.SS1.p5.m16" class="ltx_Math" alttext="N,t_{oc}+D\,t_{s}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>,</mo><mrow><msub><mi>t</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>+</mo><mrow><mi>D</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>t</mi><mi>s</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">N,t_{oc}+D\,t_{s}</annotation></semantics></math>, where <math id="S4.SS1.p5.m17" class="ltx_Math" alttext="t_{oc}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">t_{oc}</annotation></semantics></math> and <math id="S4.SS1.p5.m18" class="ltx_Math" alttext="t_{s}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>s</mi></msub><annotation encoding="application/x-tex">t_{s}</annotation></semantics></math> are the read time for off-chip and shared memory ( <math id="S4.SS1.p5.m19" class="ltx_Math" alttext="t_{s}&lt;&lt;t_{oc}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>s</mi></msub><mo>&lt;&lt;</mo><msub><mi>t</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub></mrow><annotation encoding="application/x-tex">t_{s}&lt;&lt;t_{oc}</annotation></semantics></math>). For context, <math id="S4.SS1.p5.m20" class="ltx_Math" alttext="t_{oc}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">t_{oc}</annotation></semantics></math> is on the order of a hundred cycles, where <math id="S4.SS1.p5.m21" class="ltx_Math" alttext="t_{s}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>s</mi></msub><annotation encoding="application/x-tex">t_{s}</annotation></semantics></math> a few cycles.</p>
</div>
<div id="S4.SS1.p6" class="ltx_para ltx_noindent">
<p id="S4.SS1.p6.1" class="ltx_p">Finally, considering the multiple attention heads <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> in each Transformer layer and multiple input batches <math id="S4.SS1.p6.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, the entire process is executed across <math id="S4.SS1.p6.m3" class="ltx_Math" alttext="B\times H" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">B\times H</annotation></semantics></math> parallel blocks. The values are stored such that the third tensor dimension corresponds to the batch and head numbers. Overall, the process involves <math id="S4.SS1.p6.m4" class="ltx_Math" alttext="B\times H" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">B\times H</annotation></semantics></math> outer blocks, <math id="S4.SS1.p6.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> inner blocks, and <math id="S4.SS1.p6.m6" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> threads per block. For instance, Figure <a href="#S4.F1" title="Figure 1 ‣ 4.1 Forward-Pass ‣ 4 Optimized Implementation ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> illustrates the structure of the <math id="S4.SS1.p6.m7" class="ltx_Math" alttext="\mathbf{q}_{rij}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{q}_{rij}</annotation></semantics></math> values and the data movement pattern for calculating the Linear term with a batch size of <math id="S4.SS1.p6.m8" class="ltx_Math" alttext="B=2" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">B=2</annotation></semantics></math>, number of heads <math id="S4.SS1.p6.m9" class="ltx_Math" alttext="H=4" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">H=4</annotation></semantics></math>, dimension per head <math id="S4.SS1.p6.m10" class="ltx_Math" alttext="D=6" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">D=6</annotation></semantics></math>, sequence length <math id="S4.SS1.p6.m11" class="ltx_Math" alttext="N=8" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">N=8</annotation></semantics></math>, and <span id="S4.SS1.p6.1.1" class="ltx_text ltx_font_italic">reduction</span> block size <math id="S4.SS1.p6.m12" class="ltx_Math" alttext="L=2" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">L=2</annotation></semantics></math> (indicated as A and B blocks), where <math id="S4.SS1.p6.m13" class="ltx_Math" alttext="1\leq r\leq B\times H" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>r</mi><mo>≤</mo><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>H</mi></mrow></mrow><annotation encoding="application/x-tex">1\leq r\leq B\times H</annotation></semantics></math>, <math id="S4.SS1.p6.m14" class="ltx_Math" alttext="1\leq i\leq N" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq N</annotation></semantics></math>, and <math id="S4.SS1.p6.m15" class="ltx_Math" alttext="1\leq j\leq D" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">1\leq j\leq D</annotation></semantics></math>. Cells sharing the same color belong to the same outer block, cells with the same letter (A or B) belong to the same inner block, and each cell within an inner block is accessed by D threads. The <math id="S4.SS1.p6.m16" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math> cells are then processed sequentially, with the left number in each cell indicating the outer loop iteration (line 11 in Algorithm <a href="#alg2" title="Algorithm 2 ‣ Appendix A Implementation Pseudo Codes ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) and the right number indicating the inner loop iteration (line 16 in Algorithm <a href="#alg2" title="Algorithm 2 ‣ Appendix A Implementation Pseudo Codes ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). In a 1-dimensional view, the data are arranged so that data processed by adjacent threads are spatially adjacent. For example, cells with the same color and the same letter are positioned next to each other.</p>
</div>
<div id="S4.SS1.p7" class="ltx_para ltx_noindent">
<p id="S4.SS1.p7.1" class="ltx_p">Note that the data movement differs for other tensors such as <math id="S4.SS1.p7.m1" class="ltx_Math" alttext="\mathbf{k}" display="inline" intent=":literal"><semantics><mi>𝐤</mi><annotation encoding="application/x-tex">\mathbf{k}</annotation></semantics></math> and <math id="S4.SS1.p7.m2" class="ltx_Math" alttext="\mathbf{v}" display="inline" intent=":literal"><semantics><mi>𝐯</mi><annotation encoding="application/x-tex">\mathbf{v}</annotation></semantics></math>. We should also mention that we must ensure threads related to the Constant term complete their execution before invoking threads related to the Linear term to prevent race conditions, as both sets of threads might modify the same <math id="S4.SS1.p7.m3" class="ltx_Math" alttext="f_{ij}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">f_{ij}</annotation></semantics></math>.</p>
</div>
<figure id="S4.F1" class="ltx_figure"><object type="image/svg+xml" data="2510.21956v1/memory.svg" id="S4.F1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:519/335;" width="519" height="335"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F1.4" class="ltx_text" style="font-size:90%;">Figure 1</span>: </span><span id="S4.F1.5" class="ltx_text" style="font-size:90%;">Structure of the Query (<math id="S4.F1.m7" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math>) storage and its data movement pattern for calculating the Linear term with a batch size of <math id="S4.F1.m8" class="ltx_Math" alttext="B=2" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">B=2</annotation></semantics></math>, number of heads <math id="S4.F1.m9" class="ltx_Math" alttext="H=4" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">H=4</annotation></semantics></math>, dimension per head <math id="S4.F1.m10" class="ltx_Math" alttext="D=6" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">D=6</annotation></semantics></math>, sequence length <math id="S4.F1.m11" class="ltx_Math" alttext="N=8" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">N=8</annotation></semantics></math>, and <span id="S4.F1.5.1" class="ltx_text ltx_font_italic">reduction</span> block size <math id="S4.F1.m12" class="ltx_Math" alttext="L=2" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">L=2</annotation></semantics></math>. Cells with the same color and letter (A or B) are processed by the same block of threads, and the left and right numbers on each cell denote the sequential order of processing in each thread’s outer and inner loops.</span></figcaption>
</figure>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Backward-Pass</h3>

<div id="S4.SS2.p1" class="ltx_para ltx_noindent">
<p id="S4.SS2.p1.1" class="ltx_p">During the backward-pass, the attention layer takes the incoming gradient of the layer in front, and produces the gradient with respect to <math id="S4.SS2.p1.m1" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math>, <math id="S4.SS2.p1.m2" class="ltx_Math" alttext="\mathbf{K}" display="inline" intent=":literal"><semantics><mi>𝐊</mi><annotation encoding="application/x-tex">\mathbf{K}</annotation></semantics></math> and <math id="S4.SS2.p1.m3" class="ltx_Math" alttext="\mathbf{V}" display="inline" intent=":literal"><semantics><mi>𝐕</mi><annotation encoding="application/x-tex">\mathbf{V}</annotation></semantics></math>, as shown in Equations <a href="#S3.E19" title="In 3.2 Backward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>-<a href="#S3.E20" title="In 3.2 Backward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>. We will detail the process for calculating the gradient with respect to <math id="S4.SS2.p1.m4" class="ltx_Math" alttext="\mathbf{K}" display="inline" intent=":literal"><semantics><mi>𝐊</mi><annotation encoding="application/x-tex">\mathbf{K}</annotation></semantics></math> (<math id="S4.SS2.p1.m5" class="ltx_Math" alttext="\nabla_{\mathbf{K}}\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝐊</mi></msub><mi>𝚿</mi></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{K}}\mathbf{\Psi}</annotation></semantics></math>), and <math id="S4.SS2.p1.m6" class="ltx_Math" alttext="\nabla_{\mathbf{Q}}\mathbf{\Psi},\,\nabla_{\mathbf{V}}\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>𝐐</mi></msub><mi>𝚿</mi></mrow><mo rspace="0.337em">,</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝐕</mi></msub><mi>𝚿</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{Q}}\mathbf{\Psi},\,\nabla_{\mathbf{V}}\mathbf{\Psi}</annotation></semantics></math> follows a similar process. To derive <math id="S4.SS2.p1.m7" class="ltx_Math" alttext="\mathbf{f}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐟</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{f}_{ij}</annotation></semantics></math>, we need to find two sets of coefficients <math id="S4.SS2.p1.m8" class="ltx_Math" alttext="\alpha^{K}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mi>K</mi></msup><annotation encoding="application/x-tex">\alpha^{K}</annotation></semantics></math> and <math id="S4.SS2.p1.m9" class="ltx_Math" alttext="\beta^{K}" display="inline" intent=":literal"><semantics><msup><mi>β</mi><mi>K</mi></msup><annotation encoding="application/x-tex">\beta^{K}</annotation></semantics></math>. Similar to the forward-pass, these coefficients are determined sequentially, as described by Equation <a href="#S3.E21" title="In 3.2 Backward-Pass ‣ 3 Method ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>. As a reminder <math id="S4.SS2.p1.m10" class="ltx_Math" alttext="\nabla_{\mathbf{k}_{ir}}\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mi>𝚿</mi></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{k}_{ir}}\mathbf{\Psi}</annotation></semantics></math> is calculated as</p>
<table id="S4.EGx16" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S4.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E24.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\mathbf{k}_{ij}}\mathbf{\Psi}=\sum_{m=1}^{D}\alpha_{ijm}^{K}\,\mathbf{v}_{im}-\sum_{m=1}^{D}\beta_{ijm}^{K}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mi>𝚿</mi></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>K</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover><msubsup><mi>β</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>K</mi></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\mathbf{k}_{ij}}\mathbf{\Psi}=\sum_{m=1}^{D}\alpha_{ijm}^{K}\,\mathbf{v}_{im}-\sum_{m=1}^{D}\beta_{ijm}^{K},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="S4.SS2.p1.2" class="ltx_p">where we refer to the left term <math id="S4.SS2.p1.m11" class="ltx_Math" alttext="\sum_{m=1}^{D}\alpha_{ijm}^{K}\,\mathbf{v}_{im}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></msubsup><mrow><msubsup><mi>α</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>K</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{m=1}^{D}\alpha_{ijm}^{K}\,\mathbf{v}_{im}</annotation></semantics></math> as the Alpha term, and the right term <math id="S4.SS2.p1.m12" class="ltx_Math" alttext="\sum_{m=1}^{D}\beta_{ijm}^{K}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></msubsup><msubsup><mi>β</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>K</mi></msubsup></mrow><annotation encoding="application/x-tex">\sum_{m=1}^{D}\beta_{ijm}^{K}</annotation></semantics></math> the Beta term. To derive them, we take an approach similar to calculation of Linear term in forward-pass; to call <math id="S4.SS2.p1.m13" class="ltx_Math" alttext="B\times H" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">B\times H</annotation></semantics></math> outer blocks, <math id="S4.SS2.p1.m14" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> inner blocks, and <math id="S4.SS2.p1.m15" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> threads per block.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para ltx_noindent">
<p id="S4.SS2.p2.1" class="ltx_p">To calculate the Alpha term, each thread consists of an outer loop for <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="1\leq i\leq N" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq N</annotation></semantics></math> and an inner loop for <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="1\leq m\leq D/L" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>m</mi><mo>≤</mo><mrow><mi>D</mi><mo>/</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">1\leq m\leq D/L</annotation></semantics></math>. The <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="\alpha_{ijm}^{K}" display="inline" intent=":literal"><semantics><msubsup><mi>α</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>K</mi></msubsup><annotation encoding="application/x-tex">\alpha_{ijm}^{K}</annotation></semantics></math> are then calculated sequentially and assigned to <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="\nabla_{\mathbf{k}_{ij}}\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mi>𝚿</mi></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{k}_{ij}}\mathbf{\Psi}</annotation></semantics></math>, as shown in Algorithm <a href="#alg3" title="Algorithm 3 ‣ Appendix A Implementation Pseudo Codes ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. Given that the <math id="S4.SS2.p2.m5" class="ltx_Math" alttext="\mathbf{q}_{ij}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{q}_{ij}</annotation></semantics></math> values for each <math id="S4.SS2.p2.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> are solely accessed within a thread, we can use a single register to store and update them in the for loop. Furthermore, since the <math id="S4.SS2.p2.m7" class="ltx_Math" alttext="\alpha_{ijm}^{K}" display="inline" intent=":literal"><semantics><msubsup><mi>α</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>K</mi></msubsup><annotation encoding="application/x-tex">\alpha_{ijm}^{K}</annotation></semantics></math> values are accessed only within a thread as well, we use an array of registers to store them, employing the same <span id="S4.SS2.p2.1.1" class="ltx_text ltx_font_italic">reduction</span> techniques to manage the limited register space.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para ltx_noindent">
<p id="S4.SS2.p3.1" class="ltx_p">The <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="\mathbf{v}_{im}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{v}_{im}</annotation></semantics></math> and <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="\mathbf{\hat{\Omega}}_{im}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{\hat{\Omega}}_{im}</annotation></semantics></math> for each <math id="S4.SS2.p3.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> are accessed within the same block of threads. Therefore, we can store them in shared memory. Analogous to the Linear terms in forward pass, the data movement from the off-chip to shared memory is parallelized among each block of threads to reduce the read time from <math id="S4.SS2.p3.m4" class="ltx_Math" alttext="ND\,t_{oc}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>t</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub></mrow><annotation encoding="application/x-tex">ND\,t_{oc}</annotation></semantics></math> to <math id="S4.SS2.p3.m5" class="ltx_Math" alttext="N,t_{oc}+D\,t_{s}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>,</mo><mrow><msub><mi>t</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>+</mo><mrow><mi>D</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>t</mi><mi>s</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">N,t_{oc}+D\,t_{s}</annotation></semantics></math>. To optimize data movement for <math id="S4.SS2.p3.m6" class="ltx_Math" alttext="\mathbf{\hat{\Omega}}_{ij}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{\hat{\Omega}}_{ij}</annotation></semantics></math> and <math id="S4.SS2.p3.m7" class="ltx_Math" alttext="\nabla_{\mathbf{k}_{ij}}\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mi>𝚿</mi></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{k}_{ij}}\mathbf{\Psi}</annotation></semantics></math> by the SMs, we should store them with <math id="S4.SS2.p3.m8" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> and <math id="S4.SS2.p3.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> mapping to the first and second tensor dimensions respectively. This arrangement allows adjacent threads to access adjacent memory, enhancing efficiency.</p>
</div>
<div id="S4.SS2.p4" class="ltx_para ltx_noindent">
<p id="S4.SS2.p4.1" class="ltx_p">Similarly, to calculate the Beta term, each thread consists of an outer loop for <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="1\leq i\leq N" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq N</annotation></semantics></math> and an inner loop for <math id="S4.SS2.p4.m2" class="ltx_Math" alttext="1\leq m\leq D/L" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>m</mi><mo>≤</mo><mrow><mi>D</mi><mo>/</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">1\leq m\leq D/L</annotation></semantics></math>, where the <math id="S4.SS2.p4.m3" class="ltx_Math" alttext="\beta{ijm}^{K}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mi>K</mi></msup></mrow><annotation encoding="application/x-tex">\beta{ijm}^{K}</annotation></semantics></math> are calculated sequentially and deducted from <math id="S4.SS2.p4.m4" class="ltx_Math" alttext="\nabla_{\mathbf{k}_{ij}}\mathbf{\Psi}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>𝐤</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mi>𝚿</mi></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{k}_{ij}}\mathbf{\Psi}</annotation></semantics></math>, as shown in Algorithm <a href="#alg4" title="Algorithm 4 ‣ Appendix A Implementation Pseudo Codes ‣ Transformer Based Linear Attention with Optimized GPU Kernel Implementation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. The main difference compared to Alpha term calculation is that instead of storing <math id="S4.SS2.p4.m5" class="ltx_Math" alttext="\mathbf{v}_{im}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{v}_{im}</annotation></semantics></math> and <math id="S4.SS2.p4.m6" class="ltx_Math" alttext="\mathbf{\hat{\Omega}}_{im}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{\hat{\Omega}}_{im}</annotation></semantics></math> in the shared memory, <math id="S4.SS2.p4.m7" class="ltx_Math" alttext="\mathbf{o}_{im}" display="inline" intent=":literal"><semantics><msub><mi>𝐨</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{o}_{im}</annotation></semantics></math> and <math id="S4.SS2.p4.m8" class="ltx_Math" alttext="\mathbf{\hat{\Omega}}_{im}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{\hat{\Omega}}_{im}</annotation></semantics></math> will be stored.</p>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Evaluation</h2>

<div id="S5.p1" class="ltx_para ltx_noindent">
<p id="S5.p1.1" class="ltx_p">We evaluate our work through two sets of evaluations: first, in an isolated setting as a standalone attention layer with causal mask applied, and second, in an end-to-end setting where we train an LLM. We refer to our implementation as ‘Our LA‘, and compare our results with Gated LA <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib28" title="" class="ltx_ref">Yang et al. (2023)</a></cite> (the state-of-the-art LA implementation), Speculative Decoding (Spec. Dec.) LA <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib30" title="" class="ltx_ref">You et al. (2024)</a></cite>, and baseline LA where we use the default Pytorch operations. We also compare with efficient I/O aware implementation of Regular Attention, FlashAttention-2 <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Dao (2024)</a></cite>.</p>
</div>
<figure id="S5.F2" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<div id="S5.F2.3" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_middle" style="width:234.4pt;">
