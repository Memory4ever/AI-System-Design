<tr id="S5.T3.2.4" class="ltx_tr">
<th id="S5.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">0.1-0.5</th>
<td id="S5.T3.2.4.2" class="ltx_td ltx_align_center">38</td>
<td id="S5.T3.2.4.3" class="ltx_td ltx_align_center">32</td></tr>
<tr id="S5.T3.2.5" class="ltx_tr">
<th id="S5.T3.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b">0.5-1</th>
<td id="S5.T3.2.5.2" class="ltx_td ltx_align_center ltx_border_b">4</td>
