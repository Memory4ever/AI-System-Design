<tr id="A5.T12.2.1.3" class="ltx_tr">
<td id="A5.T12.2.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.65pt;padding-bottom:0.65pt;" colspan="7"><span id="A5.T12.2.1.3.1.1" class="ltx_text ltx_font_italic">Proprietary</span></td></tr>
<tr id="A5.T12.2.1.4" class="ltx_tr">
<td id="A5.T12.2.1.4.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.65pt;padding-bottom:0.65pt;"><span id="A5.T12.2.1.4.1.1" class="ltx_text ltx_font_typewriter">GPT-4o</span></td>
