<td id="A5.T13.2.5.3" class="ltx_td ltx_align_right" style="padding-top:0.65pt;padding-bottom:0.65pt;"><span id="A5.T13.2.5.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#EBF5FF;">39.54</span></td>
<td id="A5.T13.2.5.4" class="ltx_td ltx_align_right" style="padding-top:0.65pt;padding-bottom:0.65pt;"><span id="A5.T13.2.5.4.1" class="ltx_text" style="--ltx-bg-color:#EBF5FF;">24.72</span></td>
<td id="A5.T13.2.5.5" class="ltx_td ltx_align_right" style="padding-top:0.65pt;padding-bottom:0.65pt;"><span id="A5.T13.2.5.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#EBF5FF;">44.47</span></td>
