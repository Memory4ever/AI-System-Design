<span id="alg2.l24.5" class="ltx_text" style="float:right;"><math id="alg2.l24.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Check for valid omission rule

</span>
</div>
<div id="alg2.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
              
              
