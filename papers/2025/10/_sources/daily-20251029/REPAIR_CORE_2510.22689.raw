              <math id="alg2.l16.m1" class="ltx_math_unparsed" alttext="Q^{\prime}\leftarrow\{(\mathbf{s^{\prime}},[\mathbf{s^{\prime}}\notin Z_{ret}],[\mathbf{s^{\prime}}\notin Z_{omi}])\mid\mathbf{s^{\prime}}\in S\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Q</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo>,</mo><mrow><mo stretchy="false">[</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo>∉</mo><msub><mi>Z</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo>∉</mo><msub><mi>Z</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo>∈</mo><mi>S</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">Q^{\prime}\leftarrow\{(\mathbf{s^{\prime}},[\mathbf{s^{\prime}}\notin Z_{ret}],[\mathbf{s^{\prime}}\notin Z_{omi}])\mid\mathbf{s^{\prime}}\in S\}</annotation></semantics></math>
<span id="alg2.l16.3" class="ltx_text" style="float:right;"><math id="alg2.l16.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Pair nodes with their validity

</span>
</div>
<div id="alg2.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
