</div>
<div id="alg2.l27" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l27.1" class="ltx_text" style="font-size:80%;">27:</span></span>
              
              
                 <math id="alg2.l27.m1" class="ltx_Math" alttext="Z_{omi}\leftarrow Z_{omi}\cup\{\mathbf{s^{\prime}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi>Z</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{omi}\leftarrow Z_{omi}\cup\{\mathbf{s^{\prime}}\}</annotation></semantics></math>


</div>
