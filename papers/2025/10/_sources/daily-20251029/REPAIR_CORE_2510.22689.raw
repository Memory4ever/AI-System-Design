</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            The rule-based explanations

</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <math id="alg1.l6.m1" class="ltx_Math" alttext="R\leftarrow\{\}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">R\leftarrow\{\}</annotation></semantics></math> <span id="alg1.l6.3" class="ltx_text" style="float:right;"><math id="alg1.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initialize valid rule set
</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <math id="alg1.l7.m1" class="ltx_Math" alttext="Z\leftarrow\{\}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">Z\leftarrow\{\}</annotation></semantics></math> <span id="alg1.l7.3" class="ltx_text" style="float:right;"><math id="alg1.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initialize invalid node set
</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <span id="alg1.l8.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="l^{\prime}\in[0,|\mathbf{s}|]" display="inline" intent=":literal"><semantics><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><mo stretchy="false">|</mo><mi>𝐬</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">l^{\prime}\in[0,|\mathbf{s}|]</annotation></semantics></math> <span id="alg1.l8.4" class="ltx_text ltx_font_bold">do</span>


</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
              <math id="alg1.l9.m1" class="ltx_Math" alttext="l\leftarrow|\mathbf{s}|-l^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">|</mo><mi>𝐬</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">l\leftarrow|\mathbf{s}|-l^{\prime}</annotation></semantics></math>
<span id="alg1.l9.3" class="ltx_text" style="float:right;"><math id="alg1.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Compute current level size

</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
              <math id="alg1.l10.m1" class="ltx_Math" alttext="S\leftarrow\{\mathbf{s^{\prime}}\subseteq\mathbf{s}\mid|\mathbf{s}^{\prime}|=l\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>𝐬</mi><mo>′</mo></msup><mo>⊆</mo><mi>𝐬</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mo stretchy="false">|</mo><msup><mi>𝐬</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>l</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S\leftarrow\{\mathbf{s^{\prime}}\subseteq\mathbf{s}\mid|\mathbf{s}^{\prime}|=l\}</annotation></semantics></math>
