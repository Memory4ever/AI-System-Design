<tr id="S3.T4.2.5" class="ltx_tr">
<td id="S3.T4.2.5.1" class="ltx_td ltx_align_center ltx_border_b">Interleave</td>
<td id="S3.T4.2.5.2" class="ltx_td ltx_align_center ltx_border_b">66.65</td>
