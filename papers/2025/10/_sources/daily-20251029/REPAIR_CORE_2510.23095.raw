<td id="S3.T4.2.3.4" class="ltx_td ltx_align_center">72.80</td>
<td id="S3.T4.2.3.5" class="ltx_td ltx_align_center">63.07</td></tr>
<tr id="S3.T4.2.4" class="ltx_tr">
<td id="S3.T4.2.4.1" class="ltx_td ltx_align_center">Multi-Head</td>
<td id="S3.T4.2.4.2" class="ltx_td ltx_align_center">66.40</td>
<td id="S3.T4.2.4.3" class="ltx_td ltx_align_center">52.58</td>
<td id="S3.T4.2.4.4" class="ltx_td ltx_align_center">74.92</td>
