<tr id="S5.T1.2.9" class="ltx_tr">
<th id="S5.T1.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Our+CS</th>
<th id="S5.T1.2.9.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">12</th>
<td id="S5.T1.2.9.3" class="ltx_td ltx_align_center">83.2</td>
