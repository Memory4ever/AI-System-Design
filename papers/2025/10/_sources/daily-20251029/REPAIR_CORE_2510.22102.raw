<td id="S4.T3.10.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.10.2.2.2.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">  13.3</span></td>
<td id="S4.T3.10.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.10.2.2.3.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">  –</span></td></tr>
