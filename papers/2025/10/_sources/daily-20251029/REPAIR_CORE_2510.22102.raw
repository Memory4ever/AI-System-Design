<td id="S4.T3.11.2.3.2" class="ltx_td ltx_align_center">  18.6</td>
<td id="S4.T3.11.2.3.3" class="ltx_td ltx_align_center">  <math id="S4.T3.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 0.5</td></tr>
<tr id="S4.T3.11.2.4" class="ltx_tr">
<th id="S4.T3.11.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">w/o Coefficient decay</th>
<td id="S4.T3.11.2.4.2" class="ltx_td ltx_align_center ltx_border_bb">  18.2</td>
<td id="S4.T3.11.2.4.3" class="ltx_td ltx_align_center ltx_border_bb">  <math id="S4.T3.m8" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 0.9</td></tr>
