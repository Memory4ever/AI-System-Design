</tbody>
</table>
</div></div><div class="ltx_flex_cell ltx_flex_size_2">
<div id="S4.T3.11" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:178.9pt;">
<p id="S4.T3.11.1" class="ltx_p ltx_align_center"><span id="S4.T3.11.1.1" class="ltx_text ltx_font_bold">Qwen2.5-VL-7B</span></p>
<table id="S4.T3.11.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T3.11.2.1" class="ltx_tr">
<th id="S4.T3.11.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T3.11.2.1.1.1" class="ltx_text ltx_font_bold">Setting</span></th>
<th id="S4.T3.11.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">  <span id="S4.T3.11.2.1.2.1" class="ltx_text ltx_font_bold">Avg</span></th>
<th id="S4.T3.11.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">  <math id="S4.T3.m6" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T3.11.2.2" class="ltx_tr" style="--ltx-bg-color:#EDEDED;">
<th id="S4.T3.11.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T3.11.2.2.1.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">VPSG</span></th>
<td id="S4.T3.11.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.11.2.2.2.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">  19.1</span></td>
<td id="S4.T3.11.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.11.2.2.3.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">  –</span></td></tr>
