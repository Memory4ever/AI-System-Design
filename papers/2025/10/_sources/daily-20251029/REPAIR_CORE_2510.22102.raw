<td id="A4.T4.4.5.2" class="ltx_td ltx_align_center">0.392</td>
<td id="A4.T4.4.5.3" class="ltx_td ltx_align_center">0.171</td>
<td id="A4.T4.4.5.4" class="ltx_td ltx_align_center">0.436</td>
