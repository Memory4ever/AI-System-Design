<td id="S4.T3.10.2.3.2" class="ltx_td ltx_align_center">  13.0</td>
<td id="S4.T3.10.2.3.3" class="ltx_td ltx_align_center">  <math id="S4.T3.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 0.3</td></tr>
<tr id="S4.T3.10.2.4" class="ltx_tr">
