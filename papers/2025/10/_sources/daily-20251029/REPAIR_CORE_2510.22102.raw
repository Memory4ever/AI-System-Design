<th id="A4.T4.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">2160<math id="A4.T4.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>1440</th>
