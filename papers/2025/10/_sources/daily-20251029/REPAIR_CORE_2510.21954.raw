          <math id="algorithm1.m9" class="ltx_Math" alttext="k\leftarrow-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">←</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k\leftarrow-1</annotation></semantics></math>; <span id="algorithm1.4.6.2" class="ltx_text ltx_font_typewriter"><math id="algorithm1.m10" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> </span><span id="algorithm1.4.6.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">current segment id<span id="algorithm1.4.6.3.1" class="ltx_text" style="--ltx-fg-color:#000000;"> </span></span>
</div>
