<th id="S4.T4.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3">Top prob (Accuracy <math id="S4.T4.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</th>
<th id="S4.T4.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3">Top prob margin (Accuracy <math id="S4.T4.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</th></tr>
<tr id="S4.T4.4.2" class="ltx_tr">
<th id="S4.T4.4.2.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="S4.T4.4.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">NFE=5</th>
