<td id="A1.T3.2.10.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T3.2.10.4.1" class="ltx_text" style="font-size:90%;">0.809</span></td>
<td id="A1.T3.2.10.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T3.2.10.5.1" class="ltx_text" style="font-size:90%;">0.027</span></td>
