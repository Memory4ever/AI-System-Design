</span></span><span id="S4.T1.6.1.1.1.2.8.3" class="ltx_text"></span></span>
<span id="S4.T1.6.1.1.1.2.9" class="ltx_td ltx_align_center ltx_border_t">WeMath</span>
<span id="S4.T1.6.1.1.1.2.10" class="ltx_td ltx_align_center ltx_border_t">LogicVista</span></span>
<span id="S4.T1.6.1.1.1.3" class="ltx_tr">
<span id="S4.T1.6.1.1.1.3.1" class="ltx_td ltx_align_left ltx_border_t">Qwen2.5-VL-3B</span>
<span id="S4.T1.6.1.1.1.3.2" class="ltx_td ltx_align_center ltx_border_t">-</span>
<span id="S4.T1.6.1.1.1.3.3" class="ltx_td ltx_align_center ltx_border_t">27.1</span>
<span id="S4.T1.6.1.1.1.3.4" class="ltx_td ltx_align_center ltx_border_t">55.9</span>
<span id="S4.T1.6.1.1.1.3.5" class="ltx_td ltx_align_center ltx_border_t">21.9</span>
<span id="S4.T1.6.1.1.1.3.6" class="ltx_td ltx_align_center ltx_border_t">61.2</span>
<span id="S4.T1.6.1.1.1.3.7" class="ltx_td ltx_align_center ltx_border_t">31.2</span>
