<th id="S2.T2.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><math id="S2.T2.m1" class="ltx_Math" alttext="s_{j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{j}(t)</annotation></semantics></math></th>
<th id="S2.T2.2.1.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt"><math id="S2.T2.m2" class="ltx_Math" alttext="\dot{r}_{j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>r</mi><mo>˙</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\dot{r}_{j}(t)</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S2.T2.2.2" class="ltx_tr">
<th id="S2.T2.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S2.T2.2.2.1.1" class="ltx_text ltx_font_bold">Post-LN</span></th>
<td id="S2.T2.2.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="S2.T2.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td>
<td id="S2.T2.2.2.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t"><math id="S2.T2.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td></tr>
<tr id="S2.T2.2.3" class="ltx_tr">
<th id="S2.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S2.T2.2.3.1.1" class="ltx_text ltx_font_bold">Pre-LN</span></th>
<td id="S2.T2.2.3.2" class="ltx_td ltx_align_left"><math id="S2.T2.m5" class="ltx_Math" alttext="r_{j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{j}(t)</annotation></semantics></math></td>
<td id="S2.T2.2.3.3" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S2.T2.m6" class="ltx_Math" alttext="\langle\theta_{j}(t),A^{t}_{j}(\Theta(t))\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>θ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>A</mi><mi>j</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\theta_{j}(t),A^{t}_{j}(\Theta(t))\rangle</annotation></semantics></math></td></tr>
