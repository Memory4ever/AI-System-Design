<td id="S4.Thmtheorem1.p1.2.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.Thmtheorem1.p1.m13" class="ltx_Math" alttext="\displaystyle\frac{2}{e^{\beta}+n-1}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mrow><msup><mi>e</mi><mi>β</mi></msup><mo>+</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{2}{e^{\beta}+n-1}</annotation></semantics></math></td>
<td id="S4.Thmtheorem1.p1.2.2.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t"><math id="S4.Thmtheorem1.p1.m14" class="ltx_Math" alttext="\displaystyle Ce^{-2t}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle Ce^{-2t}</annotation></semantics></math></td></tr>
<tr id="S4.Thmtheorem1.p1.2.3" class="ltx_tr">
<th id="S4.Thmtheorem1.p1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.Thmtheorem1.p1.2.3.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Pre-LN</span></th>
<td id="S4.Thmtheorem1.p1.2.3.2" class="ltx_td ltx_align_left"><math id="S4.Thmtheorem1.p1.m15" class="ltx_Math" alttext="\displaystyle\frac{2}{r_{0}(e^{\beta}+n-1)}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><msub><mi>r</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>e</mi><mi>β</mi></msup><mo>+</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{2}{r_{0}(e^{\beta}+n-1)}</annotation></semantics></math></td>
<td id="S4.Thmtheorem1.p1.2.3.3" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S4.Thmtheorem1.p1.m16" class="ltx_Math" alttext="C/t^{3}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>/</mo><msup><mi>t</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">C/t^{3}</annotation></semantics></math></td></tr>
