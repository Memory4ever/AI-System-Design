idth="0.85pt"><path style="fill:none" d="M 0 49.08 L 0 55.52"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 0 52.24)"><path d="M 7.88 0 L 1.9 2.22 L 3.58 0 L 1.9 -2.22 Z"></path></g></g><g stroke-width="0.85pt"><path style="fill:none" d="M 0 73.43 L 0 79.86"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 0 76.58)"><path d="M 7.88 0 L 1.9 2.22 L 3.58 0 L 1.9 -2.22 Z"></path></g></g><g stroke-width="0.85pt"><path style="fill:none" d="M 0 114.81 L 0 140.15"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 0 136.87)"><path d="M 7.88 0 L 1.9 2.22 L 3.58 0 L 1.9 -2.22 Z"></path></g></g><g stroke-width="0.85pt"><path style="fill:none" d="M 0 175.1 L 0 181.54"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 0 178.25)"><path d="M 7.88 0 L 1.9 2.22 L 3.58 0 L 1.9 -2.22 Z"></path></g></g><g stroke-width="0.85pt"><path style="fill:none" d="M 0 199.44 L 0 205.88"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 0 202.6)"><path d="M 7.88 0 L 1.9 2.22 L 3.58 0 L 1.9 -2.22 Z"></path></g></g><g stroke-width="0.85pt"><path style="fill:none" d="M 0 240.83 L 0 247.27"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 0 243.99)"><path d="M 7.88 0 L 1.9 2.22 L 3.58 0 L 1.9 -2.22 Z"></path></g></g><g stroke-width="0.85pt"><path style="fill:none" d="M 8.93 0 L 53.21 0 L 53.21 67.55 L 12.03 67.55"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 -0.00002 0.00002 -1.0 15.32 67.55)"><path d="M 7.88 0 L 1.9 2.22 L 3.58 0 L 1.9 -2.22 Z"></path></g></g><g stroke-width="0.85pt"><path style="fill:none" d="M 0 130.56 L 52.58 130.56 L 52.58 193.57 L 12.03 193.57"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 -0.00002 0.00002 -1.0 15.32 193.57)"><path d="M 7.88 0 L 1.9 2.22 L 3.58 0 L 1.9 -2.22 Z"></path></g></g></g></svg></span>
