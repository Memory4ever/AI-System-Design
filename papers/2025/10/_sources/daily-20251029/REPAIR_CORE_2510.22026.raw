<th id="S2.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S2.T2.2.4.1.1" class="ltx_text ltx_font_bold">Mix-LN</span></th>
<td id="S2.T2.2.4.2" class="ltx_td ltx_align_left"><math id="S2.T2.m7" class="ltx_Math" alttext="{\rm 1}\kern-2.40005pt{\rm I}_{t\leq\tau}+r_{j}(t){\rm 1}\kern-2.40005pt{\rm I}_{t&gt;\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:0.260em;" width="0.260em"><mn>1</mn></mpadded><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mrow><mi>t</mi><mo>≤</mo><mi>τ</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>r</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.260em;" width="0.260em"><mn>1</mn></mpadded><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mrow><mi>t</mi><mo>&gt;</mo><mi>τ</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">{\rm 1}\kern-2.40005pt{\rm I}_{t\leq\tau}+r_{j}(t){\rm 1}\kern-2.40005pt{\rm I}_{t&gt;\tau}</annotation></semantics></math></td>
<td id="S2.T2.2.4.3" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S2.T2.m8" class="ltx_Math" alttext="\langle\theta_{j}(t),A^{t}_{j}(\Theta(t))\rangle{\rm 1}\kern-2.40005pt{\rm I}_{t&gt;\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>θ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>A</mi><mi>j</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.260em;" width="0.260em"><mn>1</mn></mpadded><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mrow><mi>t</mi><mo>&gt;</mo><mi>τ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\langle\theta_{j}(t),A^{t}_{j}(\Theta(t))\rangle{\rm 1}\kern-2.40005pt{\rm I}_{t&gt;\tau}</annotation></semantics></math></td></tr>
<tr id="S2.T2.2.5" class="ltx_tr">
<th id="S2.T2.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S2.T2.2.5.1.1" class="ltx_text ltx_font_bold">Peri-LN</span></th>
<td id="S2.T2.2.5.2" class="ltx_td ltx_align_left"><math id="S2.T2.m9" class="ltx_Math" alttext="r_{j}(t)\|A^{t}_{j}(\Theta(t))\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>A</mi><mi>j</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">r_{j}(t)\|A^{t}_{j}(\Theta(t))\|</annotation></semantics></math></td>
<td id="S2.T2.2.5.3" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S2.T2.m10" class="ltx_Math" alttext="\langle\theta_{j}(t),A^{t}_{j}(\Theta(t))\rangle/\|A^{t}_{j}(\Theta(t))\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>θ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>A</mi><mi>j</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>/</mo><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>A</mi><mi>j</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\langle\theta_{j}(t),A^{t}_{j}(\Theta(t))\rangle/\|A^{t}_{j}(\Theta(t))\|</annotation></semantics></math></td></tr>
