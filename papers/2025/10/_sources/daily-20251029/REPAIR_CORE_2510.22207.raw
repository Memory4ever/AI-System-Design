form="matrix(1 0 0 -1 27.73 0)"><foreignObject style="--ltx-fo-width:3.4em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="43.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.I1.i1.pic1.3" class="ltx_text ltx_font_sansserif" style="font-size:90%;">(MLM </span><math id="S3.I1.i1.pic1.m3" class="ltx_Math" alttext="q_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">q</mi><mi mathsize="0.900em">θ</mi></msub><annotation encoding="application/x-tex">q_{\theta}</annotation></semantics></math><span id="S3.I1.i1.pic1.4" class="ltx_text ltx_font_sansserif" style="font-size:90%;">)</span></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#FAFAFA;" fill="#FAFAFA" stroke="#666666"><path d="M 440.08 22.36 L 335.38 22.36 C 333.85 22.36 332.61 21.12 332.61 19.59 L 332.61 -19.59 C 332.61 -21.12 333.85 -22.36 335.38 -22.36 L 440.08 -22.36 C 441.61 -22.36 442.85 -21.12 442.85 -19.59 L 442.85 19.59 C 442.85 21.12 441.61 22.36 440.08 22.36 Z M 332.61 -22.36"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 363.8 -7.44)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.1)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.65)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:2.82em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="36.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.I1.i1.pic1.5" class="ltx_text ltx_font_sansserif" style="font-size:90%;">Select </span><math id="S3.I1.i1.pic1.m4" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":