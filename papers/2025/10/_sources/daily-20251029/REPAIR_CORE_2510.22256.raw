<td id="S5.T1.6.1.12.9" class="ltx_td ltx_align_center" style="padding-top:-0.25pt;padding-bottom:-0.25pt;"><span id="S5.T1.6.1.12.9.1" class="ltx_text" style="--ltx-bg-color:#FCF1E2;">2.5961</span></td>
