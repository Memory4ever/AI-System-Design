<td id="S5.T1.6.1.13.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;">0.2237</td>
<td id="S5.T1.6.1.13.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;">2.0095</td>
