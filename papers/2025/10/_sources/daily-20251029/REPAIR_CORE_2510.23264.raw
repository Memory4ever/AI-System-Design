<td id="A4.T8.2.11.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;" colspan="4"><span id="A4.T8.2.11.2.1" class="ltx_text ltx_font_bold">22 min</span></td></tr>
