<td id="A3.T7.2.3.3" class="ltx_td ltx_align_center">0.93</td>
<td id="A3.T7.2.3.4" class="ltx_td ltx_align_center">3.64</td></tr>
<tr id="A3.T7.2.4" class="ltx_tr">
