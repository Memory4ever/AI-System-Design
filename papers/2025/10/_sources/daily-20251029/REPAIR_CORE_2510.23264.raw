                <math id="algx1.l42.m1" class="ltx_Math" alttext="Y^{(l)}\leftarrow Output\cdot W_{O,32}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Y</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>W</mi><mrow><mi>O</mi><mo>,</mo><mn>32</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">Y^{(l)}\leftarrow Output\cdot W_{O,32}</annotation></semantics></math>

</div>
<div id="algx1.l43" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">43:</span>
            
            
                <span id="algx1.l43.2" class="ltx_text ltx_font_bold">if</span> <math id="algx1.l43.m1" class="ltx_Math" alttext="l=l_{s}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><msub><mi>l</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">l=l_{s}</annotation></semantics></math> and <math id="algx1.l43.m2" class="ltx_Math" alttext="h=h_{s}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><msub><mi>h</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">h=h_{s}</annotation></semantics></math> <span id="algx1.l43.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="algx1.l44" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">44:</span>
            
            
                  // Replace corrupted activation with clean activation

</div>
<div id="algx1.l45" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">45:</span>
            
            
                  <math id="algx1.l45.m1" class="ltx_Math" alttext="Y^{(l,h_{s})}\leftarrow A_{clean}^{(l_{s},h_{s})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Y</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><msub><mi>h</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><msubsup><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mi>s</mi></msub><mo>,</mo><msub><mi>h</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">Y^{(l,h_{s})}\leftarrow A_{clean}^{(l_{s},h_{s})}</annotation></semantics></math>

</div>
<div id="algx1.l46" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">46:</span>
            
            
                <span id="algx1.l46.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l46.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="algx1.l47" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">47:</span>
            
            
               <span id="algx1.l47.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="algx1.l48" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">48:</span>
            
            
                <math id="algx1.l48.m1" class="ltx_Math" alttext="Y^{(l)}\leftarrow Output\cdot W_{O,8}" display="inline" intent=":literal"><semantics><mrow><msup><mi>Y</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>W</mi><mrow><mi>O</mi><mo>,</mo><mn>8</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">Y^{(l)}\leftarrow Output\cdot W_{O,8}</annotation></semantics></math>

</div>
<div id="algx1.l49" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">49:</span>
            
            
               <span id="algx1.l49.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l49.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="algx1.l50" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">50:</span>
            
            
               <math id="algx1.l50.m1" class="ltx_Math" alttext="\tilde{X}^{(l+1)}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>X</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\tilde{X}^{(l+1)}\leftarrow</annotation></semantics></math> Apply remaining operations (layer norm, MLP, etc.) to <math id="algx1.l50.m2" class="ltx_Math" alttext="Y^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>Y</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">Y^{(l)}</annotation></semantics></math>

</div>
<div id="algx1.l51" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">51:</span>
            
            
               Store replaced activations: <math id="algx1.l51.m1" class="ltx_Math" alttext="A_{replaced}^{(l)}\leftarrow Y^{(l)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">←</mo><msup><mi>Y</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">A_{replaced}^{(l)}\leftarrow Y^{(l)}</annotation></semantics></math>

</div>
<div id="algx1.l52" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">52:</span>
            
            
             <span id="algx1.l52.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l52.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="algx1.l53" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">53:</span>
            
            
             Obtain model output with replaced activations <math id="algx1.l53.m1" class="ltx_Math" alttext="A_{output}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">A_{output}</annotation></semantics></math>

</div>
<div id="algx1.l54" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">54:</span>
            
            
             // Calculate difference before and after replacement

</div>
<div id="algx1.l55" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">55:</span>
            
            
             <math id="algx1.l55.m1" class="ltx_Math" alttext="\Delta A=||A_{corrupt}^{(l_{d},h_{d})}-A_{replaced}^{(l_{d},h_{d})}||" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo>=</mo><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>A</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mi>d</mi></msub><mo>,</mo><msub><mi>h</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>A</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mi>d</mi></msub><mo>,</mo><msub><mi>h</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta A=||A_{corrupt}^{(l_{d},h_{d})}-A_{replaced}^{(l_{d},h_{d})}||</annotation></semantics></math>

</div>
<div id="algx1.l56" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">56:</span>
            
            
             <span id="algx1.l56.2" class="ltx_text ltx_font_bold">if</span> <math id="algx1.l56.m1" class="ltx_Math" alttext="\Delta A&gt;\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo>&gt;</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\Delta A&gt;\delta</annotation></semantics></math> <span id="algx1.l56.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="algx1.l57" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">57:</span>
            
            
               // If difference exceeds threshold, edge <math id="algx1.l57.m1" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> is considered important

</div>
<div id="algx1.l58" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">58:</span>
            
            
               <math id="algx1.l58.m1" class="ltx_Math" alttext="I(e)\leftarrow\Delta A" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">I(e)\leftarrow\Delta A</annotation></semantics></math>

</div>
<div id="algx1.l59" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">59:</span>
            
            
             <span id="algx1.l59.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="algx1.l60" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">60:</span>
            
            
               <math id="algx1.l60.m1" class="ltx_Math" alttext="I(e)\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">I(e)\leftarrow 0</annotation></semantics></math> // Edge is not important

</div>
<div id="algx1.l61" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">61:</span>
            
            
             <span id="algx1.l61.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l61.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="algx1.l62" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">62:</span>
            
            
            <span id="algx1.l62.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l62.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="algx1.l63" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">63:</span>
            
            
            Sort edges based on importance scores

</div>
<div id="algx1.l64" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">64:</span>
            
            
            Remove edges with importance scores below threshold: <math id="algx1.l64.m1" class="ltx_Math" alttext="E\leftarrow\{e\in E|I(e)&gt;\tau\}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mi>e</mi><mo>∈</mo><mi>E</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>τ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">E\leftarrow\{e\in E|I(e)&gt;\tau\}</annotation></semantics></math>

</div>
<div id="algx1.l65" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">65:</span>
            
            
            Update computational graph: <math id="algx1.l65.m1" class="ltx_Math" alttext="G\leftarrow(V,E)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G\leftarrow(V,E)</annotation></semantics></math>

</div>
<div id="algx1.l66" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">66:</span>
            
            
            <math id="algx1.l66.m1" class="ltx_Math" alttext="t\leftarrow t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">←</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t\leftarrow t+1</annotation></semantics></math>

</div>
<div id="algx1.l67" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">67:</span>
            
            
            Dynamically adjust threshold <math id="algx1.l67.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> to control pruning speed

</div>
<div id="algx1.l68" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">68:</span>
            
            
          <span id="algx1.l68.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l68.3" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="algx1.l69" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">69:</span>
            
            
          Perform inference using final pruned computational graph <math id="algx1.l69.m1" class="ltx_Math" alttext="G_{sparse}=(V,E)" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G_{sparse}=(V,E)</annotation></semantics></math>:

</div>
<div id="algx1.l70" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">70:</span>
            
            
          <span id="algx1.l70.2" class="ltx_text ltx_font_bold">for</span> each layer <math id="algx1.l70.m1" class="ltx_Math" alttext="l\in\{1,...,L\}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">l\in\{1,...,L\}</annotation></semantics></math> <span id="algx1.l70.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="algx1.l71" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">71:</span>
            
            
            Determine set of heads <math id="algx1.l71.m1" class="ltx_Math" alttext="H_{high}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">H_{high}^{(l)}</annotation></semantics></math> requiring high-precision computation (based on edges in <math id="algx1.l71.m2" class="ltx_Math" alttext="G_{sparse}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><annotation encoding="application/x-tex">G_{sparse}</annotation></semantics></math>)

</div>
<div id="algx1.l72" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">72:</span>
            
            
            <span id="algx1.l72.2" class="ltx_text ltx_font_bold">for</span> each head <math id="algx1.l72.m1" class="ltx_Math" alttext="h^{*}\in H_{high}^{(l)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo>∈</mo><msubsup><mi>H</mi><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">h^{*}\in H_{high}^{(l)}</annotation></semantics></math> requiring high-precision computation <span id="algx1.l72.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="algx1.l73" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">73:</span>
            
            
             Asynchronously launch <math id="algx1.l73.m1" class="ltx_Math" alttext="S\{U(W^{(l,h^{*})}_{QKV,32}),U(W^{(l)}_{O,32})\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>,</mo><mn>32</mn></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><msup><mi>h</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mi>O</mi><mo>,</mo><mn>32</mn></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S\{U(W^{(l,h^{*})}_{QKV,32}),U(W^{(l)}_{O,32})\}</annotation></semantics></math>

</div>
<div id="algx1.l74" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">74:</span>
            
            
            <span id="algx1.l74.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l74.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="algx1.l75" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">75:</span>
            
            
            <span id="algx1.l75.2" class="ltx_text ltx_font_bold">for</span> <math id="algx1.l75.m1" class="ltx_Math" alttext="comp\in\{Q,K,V\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mi>Q</mi><mo>,</mo><mi>K</mi><mo>,</mo><mi>V</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">comp\in\{Q,K,V\}</annotation></semantics></math> <span id="algx1.l75.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="algx1.l76" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">76:</span>
            
            
             Asynchronously launch <math id="algx1.l76.m1" class="ltx_Math" alttext="S\{C_{low}(X^{(l)},W^{(l)}_{comp,8})\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>C</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>W</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>,</mo><mn>8</mn></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S\{C_{low}(X^{(l)},W^{(l)}_{comp,8})\}</annotation></semantics></math>

</div>
<div id="algx1.l77" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">77:</span>
            
            
             <span id="algx1.l77.2" class="ltx_text ltx_font_bold">for</span> each <math id="algx1.l77.m1" class="ltx_Math" alttext="h^{*}\in H_{high}^{(l)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo>∈</mo><msubsup><mi>H</mi><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">h^{*}\in H_{high}^{(l)}</annotation></semantics></math> <span id="algx1.l77.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="algx1.l78" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">78:</span>
            
            
               Synchronously wait until <math id="algx1.l78.m1" class="ltx_Math" alttext="U(W^{(l,h^{*})}_{comp,32})" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>,</mo><mn>32</mn></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><msup><mi>h</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(W^{(l,h^{*})}_{comp,32})</annotation></semantics></math> completes

</div>
<div id="algx1.l79" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">79:</span>
            
            
               Asynchronously launch <math id="algx1.l79.m1" class="ltx_Math" alttext="S\{C_{high}(X^{(l)},W^{(l,h^{*})}_{comp,32})\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>C</mi><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>W</mi><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>,</mo><mn>32</mn></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><msup><mi>h</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S\{C_{high}(X^{(l)},W^{(l,h^{*})}_{comp,32})\}</annotation></semantics></math>

</div>
<div id="algx1.l80" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">80:</span>
            
            
             <span id="algx1.l80.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l80.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="algx1.l81" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">81:</span>
            
            
            <span id="algx1.l81.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l81.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="algx1.l82" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">82:</span>
            
            
            Perform mixed-precision computation and merge results

</div>
<div id="algx1.l83" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">83:</span>
            
            
            Proceed to next layer computation

</div>
<div id="algx1.l84" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">84:</span>
            
            
          <span id="algx1.l84.2" class="ltx_text ltx_font_bold">end</span> <span id="algx1.l84.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="algx1.l85" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">85:</span>
            
            
          <span id="algx1.l85.2" class="ltx_text ltx_font_bold">return</span> Sparse computational graph <math id="algx1.l85.m1" class="ltx_Math" alttext="G_{sparse}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><annotation encoding="application/x-tex">G_{sparse}</annotation></semantics></math> and final output

</div>
</div>
</div>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Artifacts and Reproducibility</h2>

<section id="A7.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.1 </span>Software Dependencies and Licenses</h3>

<div id="A7.SS1.p1" class="ltx_para">
<p id="A7.SS1.p1.1" class="ltx_p">Our implementation builds upon several open-source software libraries, all of which are licensed for academic and commercial use:</p>
</div>
<div id="A7.SS1.p2" class="ltx_para">
<p id="A7.SS1.p2.1" class="ltx_p"><span id="A7.SS1.p2.1.1" class="ltx_text ltx_font_bold">Deep Learning Frameworks:</span></p>
<ul id="A7.I1" class="ltx_itemize">
<li id="A7.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I1.i1.p1" class="ltx_para">
<p id="A7.I1.i1.p1.1" class="ltx_p"><span id="A7.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">PyTorch</span> (BSD-3-Clause License): We use PyTorch as the primary deep learning framework for model implementation and tensor operations.</p>
</div></li>
<li id="A7.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I1.i2.p1" class="ltx_para">
<p id="A7.I1.i2.p1.1" class="ltx_p"><span id="A7.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Hugging Face Transformers</span> (Apache 2.0 License): Used for loading pre-trained language models and tokenizers. All models are accessed through the Hugging Face Model Hub<span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup>
                    <span class="ltx_tag ltx_tag_note">3</span>
                    
                    
                    
                  <a href="https://huggingface.co/models" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/models</a></span></span></span>.</p>
</div></li>
</ul>
</div>
<div id="A7.SS1.p3" class="ltx_para">
<p id="A7.SS1.p3.1" class="ltx_p"><span id="A7.SS1.p3.1.1" class="ltx_text ltx_font_bold">Mechanistic Interpretability Tools:</span></p>
<ul id="A7.I2" class="ltx_itemize">
<li id="A7.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I2.i1.p1" class="ltx_para">
<p id="A7.I2.i1.p1.1" class="ltx_p"><span id="A7.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">TransformerLens</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib33" title="" class="ltx_ref">Nanda and Bloom, 2022</a>)</cite> (MIT License): A library specifically designed for mechanistic interpretability research, providing utilities for analyzing transformer activations and circuit discovery.</p>
</div></li>
</ul>
</div>
<div id="A7.SS1.p4" class="ltx_para">
<p id="A7.SS1.p4.1" class="ltx_p">All dependencies use permissive open-source licenses that permit modification and redistribution, ensuring full reproducibility of our work.</p>
</div>
</section>
<section id="A7.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.2 </span>Models and Datasets</h3>

<section id="A7.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">G.2.1 </span>Pre-trained Models</h4>

<div id="A7.SS2.SSS1.p1" class="ltx_para">
<p id="A7.SS2.SSS1.p1.1" class="ltx_p">We evaluate PAHQ on three publicly available transformer models:</p>
</div>
<div id="A7.SS2.SSS1.p2" class="ltx_para">
<ul id="A7.I3" class="ltx_itemize">
<li id="A7.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I3.i1.p1" class="ltx_para">
<p id="A7.I3.i1.p1.1" class="ltx_p"><span id="A7.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">GPT-2</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib36" title="" class="ltx_ref">Radford et al., 2019</a>)</cite>: A 124M parameter autoregressive language model trained on WebText. Available under a modified MIT license through Hugging Face (<span id="A7.I3.i1.p1.1.2" class="ltx_text ltx_font_typewriter">gpt2</span>).</p>
</div></li>
<li id="A7.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I3.i2.p1" class="ltx_para">
<p id="A7.I3.i2.p1.1" class="ltx_p"><span id="A7.I3.i2.p1.1.1" class="ltx_text ltx_font_bold">Attn-4l</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib14" title="" class="ltx_ref">Heimersheim and Janiak, 2023</a>)</cite>: A 4-layer attention-only transformer designed for interpretability research. Publicly available under MIT license.</p>
</div></li>
<li id="A7.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I3.i3.p1" class="ltx_para">
<p id="A7.I3.i3.p1.1" class="ltx_p"><span id="A7.I3.i3.p1.1.1" class="ltx_text ltx_font_bold">Redwood-2l</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib10" title="" class="ltx_ref">Gokaslan and Cohen, 2019</a>)</cite>: A 2-layer transformer model trained on OpenWebText. Available under Apache 2.0 license.</p>
</div></li>
</ul>
</div>
<div id="A7.SS2.SSS1.p3" class="ltx_para">
<p id="A7.SS2.SSS1.p3.1" class="ltx_p">All models were downloaded from Hugging Face Model Hub using their official model identifiers. We did not modify model weights or architectures; all experiments use the original pre-trained checkpoints.</p>
</div>
</section>
<section id="A7.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">G.2.2 </span>Evaluation Tasks and Datasets</h4>

<div id="A7.SS2.SSS2.p1" class="ltx_para">
<p id="A7.SS2.SSS2.p1.1" class="ltx_p">We evaluate on three standard mechanistic interpretability benchmarks:</p>
</div>
<div id="A7.SS2.SSS2.p2" class="ltx_para">
<ul id="A7.I4" class="ltx_itemize">
<li id="A7.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I4.i1.p1" class="ltx_para">
<p id="A7.I4.i1.p1.1" class="ltx_p"><span id="A7.I4.i1.p1.1.1" class="ltx_text ltx_font_bold">Indirect Object Identification (IOI)</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib41" title="" class="ltx_ref">Wang et al., 2022</a>)</cite>: Tests the model’s ability to identify indirect objects in sentences. The dataset consists of 1,000 synthetic examples with templates like "When [Name1] and [Name2] went to the store, [Name2] gave a gift to [Name1]." We converted the original token-based format to natural language and re-tokenized using each model’s vocabulary.</p>
</div></li>
<li id="A7.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I4.i2.p1" class="ltx_para">
<p id="A7.I4.i2.p1.1" class="ltx_p"><span id="A7.I4.i2.p1.1.1" class="ltx_text ltx_font_bold">Docstring</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib14" title="" class="ltx_ref">Heimersheim and Janiak, 2023</a>)</cite>: Evaluates Python function documentation generation from code. The dataset contains 10,000 function-docstring pairs from open-source Python repositories. We use the publicly released version from the ACDC repository.</p>
</div></li>
<li id="A7.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I4.i3.p1" class="ltx_para">
<p id="A7.I4.i3.p1.1" class="ltx_p"><span id="A7.I4.i3.p1.1.1" class="ltx_text ltx_font_bold">Greater Than</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib34" title="" class="ltx_ref">Nanda et al., 2023</a>)</cite>: A numerical reasoning task requiring comparison of two numbers. The dataset includes 2,000 number pairs with varying magnitudes and digit lengths.</p>
</div></li>
</ul>
</div>
<div id="A7.SS2.SSS2.p3" class="ltx_para">
<p id="A7.SS2.SSS2.p3.1" class="ltx_p">All datasets are either synthetically generated or derived from publicly available code repositories, containing no personally identifiable information.</p>
</div>
</section>
</section>
<section id="A7.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.3 </span>Data Privacy and Ethical Considerations</h3>

<div id="A7.SS3.p1" class="ltx_para">
<p id="A7.SS3.p1.1" class="ltx_p"><span id="A7.SS3.p1.1.1" class="ltx_text ltx_font_bold">Pre-training Data:</span> The pre-trained models we use (GPT-2, Attn-4l, Redwood-2l) were trained on large-scale internet text corpora. While we did not participate in the original data collection or model training, we acknowledge:</p>
<ul id="A7.I5" class="ltx_itemize">
<li id="A7.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I5.i1.p1" class="ltx_para">
<p id="A7.I5.i1.p1.1" class="ltx_p">These corpora may contain personal information that was publicly available on the internet at the time of collection</p>
</div></li>
<li id="A7.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I5.i2.p1" class="ltx_para">
<p id="A7.I5.i2.p1.1" class="ltx_p">The training data may include content that could be considered offensive or biased</p>
</div></li>
<li id="A7.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I5.i3.p1" class="ltx_para">
<p id="A7.I5.i3.p1.1" class="ltx_p">We use these models solely for analyzing their internal mechanisms and do not generate or analyze content targeting individuals or groups</p>
</div></li>
</ul>
</div>
<div id="A7.SS3.p2" class="ltx_para">
<p id="A7.SS3.p2.1" class="ltx_p"><span id="A7.SS3.p2.1.1" class="ltx_text ltx_font_bold">Evaluation Data:</span> Our evaluation datasets are either:</p>
<ul id="A7.I6" class="ltx_itemize">
<li id="A7.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I6.i1.p1" class="ltx_para">
<p id="A7.I6.i1.p1.1" class="ltx_p">Synthetically generated (IOI, Greater Than) with no real personal information</p>
</div></li>
<li id="A7.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I6.i2.p1" class="ltx_para">
<p id="A7.I6.i2.p1.1" class="ltx_p">Derived from open-source code repositories (Docstring) with public licenses</p>
</div></li>
</ul>
</div>
<div id="A7.SS3.p3" class="ltx_para">
<p id="A7.SS3.p3.1" class="ltx_p">No additional data collection or human subject involvement occurred in this research.</p>
</div>
</section>
<section id="A7.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.4 </span>Intended Use and Compatibility</h3>

<div id="A7.SS4.p1" class="ltx_para">
<p id="A7.SS4.p1.1" class="ltx_p">PAHQ is designed specifically for mechanistic interpretability research and maintains compatibility with the original intended uses of all utilized artifacts:</p>
</div>
<div id="A7.SS4.p2" class="ltx_para">
<ul id="A7.I7" class="ltx_itemize">
<li id="A7.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I7.i1.p1" class="ltx_para">
<p id="A7.I7.i1.p1.1" class="ltx_p"><span id="A7.I7.i1.p1.1.1" class="ltx_text ltx_font_bold">PyTorch and Transformers</span>: Used within their designed scope for deep learning research and inference</p>
</div></li>
<li id="A7.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I7.i2.p1" class="ltx_para">
<p id="A7.I7.i2.p1.1" class="ltx_p"><span id="A7.I7.i2.p1.1.1" class="ltx_text ltx_font_bold">TransformerLens</span>: Applied precisely for its intended purpose of mechanistic interpretability analysis</p>
</div></li>
<li id="A7.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I7.i3.p1" class="ltx_para">
<p id="A7.I7.i3.p1.1" class="ltx_p"><span id="A7.I7.i3.p1.1.1" class="ltx_text ltx_font_bold">Pre-trained models</span>: Used only for analyzing internal mechanisms, not for downstream generation tasks</p>
</div></li>
<li id="A7.I7.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I7.i4.p1" class="ltx_para">
<p id="A7.I7.i4.p1.1" class="ltx_p"><span id="A7.I7.i4.p1.1.1" class="ltx_text ltx_font_bold">Circuit discovery methods</span>: PAHQ accelerates existing methods (ACDC) without modifying their algorithmic logic or intended research applications</p>
</div></li>
</ul>
</div>
<div id="A7.SS4.p3" class="ltx_para">
<p id="A7.SS4.p3.1" class="ltx_p">Our method introduces quantization as an inference optimization technique while preserving the faithfulness and interpretability guarantees of the underlying circuit discovery algorithms. All experiments operate within the research contexts intended by the original artifact creators.</p>
</div>
</section>
<section id="A7.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.5 </span>Code and Implementation Details</h3>

<div id="A7.SS5.p1" class="ltx_para">
<p id="A7.SS5.p1.1" class="ltx_p">Our implementation will be made publicly available upon publication to facilitate reproduction and extension of this work. The codebase includes:</p>
</div>
<div id="A7.SS5.p2" class="ltx_para">
<ul id="A7.I8" class="ltx_itemize">
<li id="A7.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I8.i1.p1" class="ltx_para">
<p id="A7.I8.i1.p1.1" class="ltx_p">Custom CUDA kernels for mixed-precision attention computation</p>
</div></li>
<li id="A7.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I8.i2.p1" class="ltx_para">
<p id="A7.I8.i2.p1.1" class="ltx_p">Three-stream parallel scheduler implementation</p>
</div></li>
<li id="A7.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I8.i3.p1" class="ltx_para">
<p id="A7.I8.i3.p1.1" class="ltx_p">Integration with ACDC and other circuit discovery methods</p>
</div></li>
<li id="A7.I8.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I8.i4.p1" class="ltx_para">
<p id="A7.I8.i4.p1.1" class="ltx_p">Evaluation scripts for all three benchmark tasks</p>
</div></li>
<li id="A7.I8.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I8.i5.p1" class="ltx_para">
<p id="A7.I8.i5.p1.1" class="ltx_p">Detailed documentation and usage examples</p>
</div></li>
</ul>
</div>
<div id="A7.SS5.p3" class="ltx_para">
<p id="A7.SS5.p3.1" class="ltx_p"><span id="A7.SS5.p3.1.1" class="ltx_text ltx_font_bold">Hardware Requirements:</span> All experiments were conducted on NVIDIA H20-NVLink GPUs (96GB) with 16 vCPU AMD EPYC 9K84 processors. The method is compatible with any CUDA-capable GPU supporting FP8 operations (compute capability &gt;=8.9).</p>
</div>
<div id="A7.SS5.p4" class="ltx_para">
<p id="A7.SS5.p4.1" class="ltx_p"><span id="A7.SS5.p4.1.1" class="ltx_text ltx_font_bold">Software Requirements:</span></p>
<ul id="A7.I9" class="ltx_itemize">
<li id="A7.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I9.i1.p1" class="ltx_para">
<p id="A7.I9.i1.p1.1" class="ltx_p">Python &gt;= 3.8</p>
</div></li>
<li id="A7.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I9.i2.p1" class="ltx_para">
<p id="A7.I9.i2.p1.1" class="ltx_p">PyTorch &gt;= 2.0 with CUDA support</p>
</div></li>
<li id="A7.I9.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I9.i3.p1" class="ltx_para">
<p id="A7.I9.i3.p1.1" class="ltx_p">Transformers &gt;= 4.30</p>
</div></li>
<li id="A7.I9.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A7.I9.i4.p1" class="ltx_para">
<p id="A7.I9.i4.p1.1" class="ltx_p">TransformerLens &gt;= 1.0</p>
</div></li>
</ul>
</div>
<div id="A7.SS5.p5" class="ltx_para">
<p id="A7.SS5.p5.1" class="ltx_p">Complete installation instructions and dependency specifications will be provided in the code repository.</p>
</div>
</section>
</section>
