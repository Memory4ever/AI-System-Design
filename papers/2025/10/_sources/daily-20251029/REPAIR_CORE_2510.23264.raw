<span id="A3.T7.2.1.3.2.1.2" class="ltx_tr">
<span id="A3.T7.2.1.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A3.T7.2.1.3.2.1.2.1.1" class="ltx_text ltx_font_bold">(PAHQ)</span></span></span>
</span></span><span id="A3.T7.2.1.3.3" class="ltx_text"></span></td>
<td id="A3.T7.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T7.2.1.4.1" class="ltx_text"></span> <span id="A3.T7.2.1.4.2" class="ltx_text">
<span id="A3.T7.2.1.4.2.1" class="ltx_tabular ltx_align_middle">
