<span id="S4.T5.2.2.1.1.1" class="ltx_p ltx_align_center">4-bit</span>
</span></td>
<td id="S4.T5.2.2.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="S4.T5.2.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:56.9pt;">
