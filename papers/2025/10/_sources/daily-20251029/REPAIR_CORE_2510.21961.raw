<td id="A3.T1.3.4.2" class="ltx_td ltx_align_left"><span id="A3.T1.3.4.2.1" class="ltx_text" style="font-size:90%;">3</span></td>
<td id="A3.T1.3.4.3" class="ltx_td ltx_align_right"><span id="A3.T1.3.4.3.1" class="ltx_text" style="font-size:90%;">512</span></td></tr>
