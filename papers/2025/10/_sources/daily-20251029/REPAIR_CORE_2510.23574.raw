<td id="S5.T6.7.3.4" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T6.7.3.4.1" class="ltx_text" style="font-size:80%;">15.6</span></td>
<td id="S5.T6.7.3.5" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T6.7.3.5.1" class="ltx_text" style="font-size:80%;">78.8</span></td></tr>
<tr id="S5.T6.7.4" class="ltx_tr">
