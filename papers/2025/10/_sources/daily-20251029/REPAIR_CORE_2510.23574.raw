<span id="S5.T1.20.1.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.20.1.2.1.1.1" class="ltx_tr">
<span id="S5.T1.20.1.2.1.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:0.85pt 2.0pt;">Reference</span></span>
</span></span></td>
<td id="S5.T1.20.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:0.85pt 2.0pt;" rowspan="2"><span id="S5.T1.20.1.3.1" class="ltx_text" style="font-size:80%;">
<span id="S5.T1.20.1.3.1.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.20.1.3.1.1.1" class="ltx_tr">
<span id="S5.T1.20.1.3.1.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:0.85pt 2.0pt;">Training Data</span></span>
</span></span></td>
<td id="S5.T1.20.1.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:0.85pt 2.0pt;" rowspan="2"><span id="S5.T1.20.1.4.1" class="ltx_text" style="font-size:80%;">
<span id="S5.T1.20.1.4.1.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.20.1.4.1.1.1" class="ltx_tr">
<span id="S5.T1.20.1.4.1.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:0.85pt 2.0pt;">#Param.</span></span>
