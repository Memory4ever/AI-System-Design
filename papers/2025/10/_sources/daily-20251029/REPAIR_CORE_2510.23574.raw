<td id="S5.T6.7.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T6.7.4.4.1" class="ltx_text" style="font-size:80%;">7.5</span></td>
<td id="S5.T6.7.4.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T6.7.4.5.1" class="ltx_text" style="font-size:80%;">94.2</span></td></tr>
<tr id="S5.T6.7.5" class="ltx_tr">
