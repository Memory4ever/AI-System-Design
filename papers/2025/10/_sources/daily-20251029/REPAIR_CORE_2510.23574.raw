<td id="S5.T6.7.5.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T6.7.5.2.1" class="ltx_text" style="font-size:80%;">✓</span></td>
