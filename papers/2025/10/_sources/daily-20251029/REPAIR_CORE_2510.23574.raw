<td id="S5.T5.7.5.8" class="ltx_td ltx_align_center" style="padding-left:12.8pt;padding-right:12.8pt;"><span id="S5.T5.7.5.8.1" class="ltx_text" style="font-size:80%;">94.2</span></td></tr>
