e" transform="matrix(1 0 0 -1 0 9.69)" width="17.3"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic4.3" class="ltx_text" style="position:relative; bottom:-3.0pt;"></span>  </span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 87.44 -20.25)"><foreignObject style="--ltx-fo-width:1.99em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="27.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">1.5B</span></span></foreignObject><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic4.4" class="ltx_text" style="position:relative; bottom:-3.0pt;"></span> </span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 117.8 -20.25)"><foreignObject style="--ltx-fo-width:1.21em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">3B</span></span></foreignObject><foreignObject style="--ltx-fo-width:3.64em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="50.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic4.5" class="ltx_text" style="position:relative; bottom:-9.8pt;">Qwen</span>  </span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" f