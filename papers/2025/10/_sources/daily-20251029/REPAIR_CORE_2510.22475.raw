<td id="A2.T9.2.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T9.2.1.1.1.1" class="ltx_text ltx_font_bold">Answer Format</span></td>
<td id="A2.T9.2.1.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T9.2.1.1.2.1" class="ltx_text ltx_font_bold">Answer Trigger</span></td></tr>
<tr id="A2.T9.2.1.2" class="ltx_tr">
