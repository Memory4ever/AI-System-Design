<td id="S4.T1.3.31.2" class="ltx_td ltx_align_center" style="padding-left:3.6pt;padding-right:3.6pt;"><math id="S4.T1.m103" class="ltx_Math" alttext="0.807\text{\scriptsize{$\pm$0.256}}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.807</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em">±</mo><mtext mathsize="0.700em">0.256</mtext></mrow></mrow><annotation encoding="application/x-tex">0.807\text{\scriptsize{$\pm$0.256}}</annotation></semantics></math></td>
<td id="S4.T1.3.31.3" class="ltx_td ltx_align_center" style="padding-left:3.6pt;padding-right:3.6pt;"><math id="S4.T1.m104" class="ltx_Math" alttext="0.955\text{\scriptsize{$\pm$0.043}}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.955</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em">±</mo><mtext mathsize="0.700em">0.043</mtext></mrow></mrow><annotation encoding="application/x-tex">0.955\text{\scriptsize{$\pm$0.043}}</annotation></semantics></math></td>
