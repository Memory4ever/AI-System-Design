{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{fill=#E2E2E2} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 13.93 10.88 L -13.93 10.88 C -16.23 10.88 -18.08 9.02 -18.08 6.73 L -18.08 0.69 C -18.08 -1.6 -16.23 -3.46 -13.93 -3.46 L 13.93 -3.46 C 16.23 -3.46 18.08 -1.6 18.08 0.69 L 18.08 6.73 C 18.08 9.02 16.23 10.88 13.93 10.88 Z M -18.08 -3.46}{stroke:none} \lx@inpgf@ignorespaces
