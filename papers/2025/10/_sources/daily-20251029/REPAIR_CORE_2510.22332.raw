<td id="S4.T1.3.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.6pt;padding-right:3.6pt;"><math id="S4.T1.m6" class="ltx_Math" alttext="0.699\text{\scriptsize{$\pm$0.000}}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.699</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em">±</mo><mtext mathsize="0.700em">0.000</mtext></mrow></mrow><annotation encoding="application/x-tex">0.699\text{\scriptsize{$\pm$0.000}}</annotation></semantics></math></td>
