<td id="S4.T1.3.30.2" class="ltx_td ltx_align_center" style="padding-left:3.6pt;padding-right:3.6pt;"><math id="S4.T1.m99" class="ltx_Math" alttext="0.807\text{\scriptsize{$\pm$0.267}}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.807</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em">±</mo><mtext mathsize="0.700em">0.267</mtext></mrow></mrow><annotation encoding="application/x-tex">0.807\text{\scriptsize{$\pm$0.267}}</annotation></semantics></math></td>
