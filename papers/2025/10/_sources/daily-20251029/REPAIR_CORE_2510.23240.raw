<td id="S5.T5.fig3.1.1.22.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S5.T5.fig3.1.1.22.1.1" class="ltx_text ltx_font_bold">Eruku</span></td>
<td id="S5.T5.fig3.1.1.22.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S5.T5.fig3.1.1.22.2.1" class="ltx_text ltx_font_bold">1.21</span></td>
