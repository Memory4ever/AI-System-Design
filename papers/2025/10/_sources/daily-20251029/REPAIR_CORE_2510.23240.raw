<td id="S5.T5.fig3.1.1.21.4" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;"> <span id="S5.T5.fig3.1.1.21.4.1" class="ltx_text ltx_font_bold">9.85</span></td>
<td id="S5.T5.fig3.1.1.21.5" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;"> <span id="S5.T5.fig3.1.1.21.5.1" class="ltx_text ltx_font_bold">4.33</span></td></tr>
