<td id="S5.T3.2.11.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.11.2.1" class="ltx_text" style="font-size:70%;">1m07s</span></td>
<td id="S5.T3.2.11.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.11.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">44.1</span></td>
<td id="S5.T3.2.11.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.11.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">+8.3</span></td></tr>
