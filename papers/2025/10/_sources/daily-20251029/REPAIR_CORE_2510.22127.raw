<th id="A3.T6.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A3.T6.m1" class="ltx_Math" alttext="{\mathcal{V}}^{\text{GT}}_{\text{total}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒱</mi><mtext mathsize="0.900em">total</mtext><mtext mathsize="0.900em">GT</mtext></msubsup><annotation encoding="application/x-tex">{\mathcal{V}}^{\text{GT}}_{\text{total}}</annotation></semantics></math></th>
<th id="A3.T6.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A3.T6.m2" class="ltx_Math" alttext="{\mathcal{V}}^{\text{GT}}_{\text{intra}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒱</mi><mtext mathsize="0.900em">intra</mtext><mtext mathsize="0.900em">GT</mtext></msubsup><annotation encoding="application/x-tex">{\mathcal{V}}^{\text{GT}}_{\text{intra}}</annotation></semantics></math></th>
<th id="A3.T6.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A3.T6.m3" class="ltx_Math" alttext="{\mathcal{V}}^{\text{GT}}_{\text{inter}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒱</mi><mtext mathsize="0.900em">inter</mtext><mtext mathsize="0.900em">GT</mtext></msubsup><annotation encoding="application/x-tex">{\mathcal{V}}^{\text{GT}}_{\text{inter}}</annotation></semantics></math></th></tr>
<tr id="A3.T6.2.2" class="ltx_tr">
