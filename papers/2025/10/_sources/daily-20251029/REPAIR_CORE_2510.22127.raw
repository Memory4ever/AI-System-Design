<td id="A3.T6.2.2.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="A3.T6.2.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.9332</span></td></tr>
</tbody>
</table>
</figure>
