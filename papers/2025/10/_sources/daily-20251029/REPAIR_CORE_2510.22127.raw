<td id="S5.T3.2.7.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.7.2.1" class="ltx_text" style="font-size:70%;">30s</span></td>
<td id="S5.T3.2.7.3" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.7.3.1" class="ltx_text" style="font-size:70%;">38.5</span></td>
<td id="S5.T3.2.7.4" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.7.4.1" class="ltx_text" style="font-size:70%;">+2.7</span></td></tr>
<tr id="S5.T3.2.8" class="ltx_tr">
<th id="S5.T3.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.8.1.1" class="ltx_text" style="font-size:70%;">TPS</span></th>
<td id="S5.T3.2.8.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.8.2.1" class="ltx_text" style="font-size:70%;">9m58s</span></td>
<td id="S5.T3.2.8.3" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.8.3.1" class="ltx_text" style="font-size:70%;">38.6</span></td>
<td id="S5.T3.2.8.4" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.8.4.1" class="ltx_text" style="font-size:70%;">+2.8</span></td></tr>
<tr id="S5.T3.2.9" class="ltx_tr">
<th id="S5.T3.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.9.1.1" class="ltx_text" style="font-size:70%;">CLIPArTT</span></th>
<td id="S5.T3.2.9.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.9.2.1" class="ltx_text" style="font-size:70%;">7m40s</span></td>
<td id="S5.T3.2.9.3" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.9.3.1" class="ltx_text" style="font-size:70%;">40.7</span></td>
<td id="S5.T3.2.9.4" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.9.4.1" class="ltx_text" style="font-size:70%;">+4.9</span></td></tr>
<tr id="S5.T3.2.10" class="ltx_tr">
<th id="S5.T3.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.10.1.1" class="ltx_text" style="font-size:70%;">WATT<span id="S5.T3.2.10.1.1.1" class="ltx_text">-</span>S</span></th>
<td id="S5.T3.2.10.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.10.2.1" class="ltx_text" style="font-size:70%;">50m20s</span></td>
<td id="S5.T3.2.10.3" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T3.2.10.3.1" class="ltx_text" style="font-size:70%;">41.9</span></td>
