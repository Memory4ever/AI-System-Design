<td id="A1.T4.2.3.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">16.7%</td>
<td id="A1.T4.2.3.5" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">34017</td></tr>
