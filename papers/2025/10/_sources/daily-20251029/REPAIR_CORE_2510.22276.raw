<figure id="S3.F4" class="ltx_figure"><img src="2510.22276v1/images/siglip_score.png" id="S3.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:628/393;" width="628" height="393" alt="Refer to caption">
