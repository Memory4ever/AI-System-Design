<th id="S3.T2.7.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="S3.T2.7.3.1.1" class="ltx_text" style="font-size:80%;">Pullback <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite></span></th>
<td id="S3.T2.7.3.2" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="S3.T2.7.3.2.1" class="ltx_text" style="font-size:80%;">0.90</span></td>
<td id="S3.T2.7.3.3" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="S3.T2.7.3.3.1" class="ltx_text" style="font-size:80%;">26.8 dB</span></td>
<td id="S3.T2.7.3.4" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="S3.T2.7.3.4.1" class="ltx_text" style="font-size:80%;">0.78</span></td>
<td id="S3.T2.7.3.5" class="ltx_td ltx_align_center" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="S3.T2.7.3.5.1" class="ltx_text" style="font-size:80%;">0.65</span></td></tr>
<tr id="S3.T2.7.4" class="ltx_tr">
