<td id="S4.T3.5.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#F2F2F2;"><span id="S4.T3.5.1.3.9.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">-0.011</span></td></tr>
