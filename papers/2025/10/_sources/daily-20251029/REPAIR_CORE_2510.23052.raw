<tr id="S4.T3.5.1.3" class="ltx_tr">
<td id="S4.T3.5.1.3.1" class="ltx_td ltx_align_center ltx_border_t">MLA</td>
<td id="S4.T3.5.1.3.2" class="ltx_td ltx_align_center ltx_border_t">128</td>
<td id="S4.T3.5.1.3.3" class="ltx_td ltx_align_center ltx_border_t">4</td>
