</figure></div><div class="ltx_flex_cell ltx_flex_size_many">
<figure id="S4.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.23052v1/loss_1dot6b.svg" id="S4.F2.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/478;" width="476" height="478"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F2.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S4.F2.sf2.4" class="ltx_text" style="font-size:90%;">A1.6b-14.6B</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_many"><span class="ltx_rule ltx_figure_panel ltx_align_center" style="--ltx-bg-color:black;display:inline-block;"> </span></div><div class="ltx_flex_cell ltx_flex_size_many">
<figure id="S4.F2.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.23052v1/loss_08b.svg" id="S4.F2.sf3.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/476;" width="476" height="476"></object>
