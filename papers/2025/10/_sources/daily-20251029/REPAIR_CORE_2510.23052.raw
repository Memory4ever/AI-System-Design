<td id="S4.T3.5.1.1.9" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S4.T3.5.1.1.9.1" class="ltx_text"><math id="S4.T3.m3" class="ltx_Math" alttext="\Delta L" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\Delta L</annotation></semantics></math></span></td></tr>
