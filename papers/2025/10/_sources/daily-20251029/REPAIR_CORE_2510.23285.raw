</div>
<div id="alg2.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
                
                
                <math id="alg2.l6.m1" class="ltx_Math" alttext="\hat{t}_{n}\leftarrow t_{n}+\gamma_{n}t_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>t</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>t</mi><mi>n</mi></msub><mo>+</mo><mrow><msub><mi>γ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mi>n</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{t}_{n}\leftarrow t_{n}+\gamma_{n}t_{n}</annotation></semantics></math>

