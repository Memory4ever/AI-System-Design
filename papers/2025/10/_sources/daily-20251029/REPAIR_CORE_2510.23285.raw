                Sample <math id="alg2.l4.m1" class="ltx_Math" alttext="\bm{\epsilon}_{n}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>n</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\epsilon}_{n}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
                
                
