              Initialize <math id="alg2.l2.m1" class="ltx_Math" alttext="{\mathbf{x}}_{t_{N}}\sim\mathcal{N}(\mathbf{0},t^{2}_{N}\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><msub><mi>t</mi><mi>N</mi></msub></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mrow><msubsup><mi>t</mi><mi>N</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{t_{N}}\sim\mathcal{N}(\mathbf{0},t^{2}_{N}\mathbf{I})</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
