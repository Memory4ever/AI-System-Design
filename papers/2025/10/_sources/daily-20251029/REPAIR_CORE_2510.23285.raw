<td id="S6.F3.sf4.3.13.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.F3.sf4.3.13.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#ECFFFF;">18.03</span></td>
<td id="S6.F3.sf4.3.13.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.F3.sf4.3.13.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#ECFFFF;">6.96</span></td>
<td id="S6.F3.sf4.3.13.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.F3.sf4.3.13.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#ECFFFF;">5.69</span></td>
<td id="S6.F3.sf4.3.13.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.F3.sf4.3.13.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#ECFFFF;">5.16</span></td></tr>
