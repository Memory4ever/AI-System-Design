<tr id="S4.T1.2.1.2" class="ltx_tr">
<td id="S4.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_t"><span id="S4.T1.2.1.2.1.1" class="ltx_text ltx_font_bold">Data Size</span></td>
