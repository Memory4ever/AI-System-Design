<th id="S4.T4.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   w\ KL</th>
<td id="S4.T4.2.1.9.2" class="ltx_td ltx_align_center">0.7328</td>
<td id="S4.T4.2.1.9.3" class="ltx_td ltx_align_center">0.5430</td>
<td id="S4.T4.2.1.9.4" class="ltx_td ltx_align_center">0.6379</td>
<td id="S4.T4.2.1.9.5" class="ltx_td ltx_align_center"><span id="S4.T4.2.1.9.5.1" class="ltx_text ltx_font_bold">0.5700</span></td>
<td id="S4.T4.2.1.9.6" class="ltx_td ltx_align_center"><span id="S4.T4.2.1.9.6.1" class="ltx_text ltx_font_bold">0.4879</span></td>
<td id="S4.T4.2.1.9.7" class="ltx_td ltx_align_center"><span id="S4.T4.2.1.9.7.1" class="ltx_text ltx_font_bold">0.5207</span></td></tr>
<tr id="S4.T4.2.1.10" class="ltx_tr">
<th id="S4.T4.2.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">   w\ KL + Curriculum</th>
<td id="S4.T4.2.1.10.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T4.2.1.10.2.1" class="ltx_text ltx_font_bold">0.7342</span></td>
<td id="S4.T4.2.1.10.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T4.2.1.10.3.1" class="ltx_text ltx_font_bold">0.6787</span></td>
<td id="S4.T4.2.1.10.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T4.2.1.10.4.1" class="ltx_text ltx_font_bold">0.7065</span></td>
<td id="S4.T4.2.1.10.5" class="ltx_td ltx_align_center ltx_border_bb">0.5376</td>
<td id="S4.T4.2.1.10.6" class="ltx_td ltx_align_center ltx_border_bb">0.4855</td>
