                <math id="alg1.l12.m1" class="ltx_Math" alttext="\mathcal{C}\leftarrow\mathcal{C}\cup\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>∪</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}\leftarrow\mathcal{C}\cup\mathcal{H}</annotation></semantics></math>

