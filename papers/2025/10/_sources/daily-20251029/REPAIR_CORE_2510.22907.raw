<td id="A3.tab1.1.8.2" class="ltx_td ltx_align_left"><span id="A3.tab1.1.8.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">E/LS_CRASH</span></td>
<td id="A3.tab1.1.8.3" class="ltx_td ltx_align_left"><span id="A3.tab1.1.8.3.1" class="ltx_text" style="font-size:90%;">Server crashed</span></td>
<td id="A3.tab1.1.8.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="A3.tab1.1.8.4.1" class="ltx_text" style="font-size:90%;">Yes</span></td></tr>
