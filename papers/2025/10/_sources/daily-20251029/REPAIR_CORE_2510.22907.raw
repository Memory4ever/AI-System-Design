<th id="A3.tab1.1.6.1" class="ltx_td ltx_align_right ltx_th ltx_th_row"><span id="A3.tab1.1.6.1.1" class="ltx_text" style="font-size:90%;">10</span></th>
<td id="A3.tab1.1.6.2" class="ltx_td ltx_align_left"><span id="A3.tab1.1.6.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">E/VERSION_SKEW</span></td>
<td id="A3.tab1.1.6.3" class="ltx_td ltx_align_left"><span id="A3.tab1.1.6.3.1" class="ltx_text" style="font-size:90%;">Snapshot mismatch</span></td>
