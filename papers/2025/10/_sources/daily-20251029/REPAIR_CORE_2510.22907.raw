              <math id="alg1.l3.m1" class="ltx_Math" alttext="\mathcal{C}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{C}\leftarrow\emptyset</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                
              <span id="alg1.l4.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> is present and <math id="alg1.l4.m2" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> has exact map<math id="alg1.l4.m3" class="ltx_Math" alttext="(s,v)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,v)</annotation></semantics></math> <span id="alg1.l4.3" class="ltx_text ltx_font_bold">then</span> <span id="alg1.l4.4" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l4.m4" class="ltx_Math" alttext="\{(\text{map}(s,v),1.0)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mrow><mtext class="undefined">\text</mtext><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>1.0</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(\text{map}(s,v),1.0)\}</annotation></semantics></math> 
</div>
