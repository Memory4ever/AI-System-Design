<tr id="A3.tab1.1.15" class="ltx_tr">
<th id="A3.tab1.1.15.1" class="ltx_td ltx_align_right ltx_th ltx_th_row"><span id="A3.tab1.1.15.1.1" class="ltx_text" style="font-size:90%;">76</span></th>
<td id="A3.tab1.1.15.2" class="ltx_td ltx_align_left"><span id="A3.tab1.1.15.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">E/REPLAY_MISMATCH</span></td>
