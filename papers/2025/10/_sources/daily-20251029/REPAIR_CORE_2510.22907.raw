</div>
<div id="alg1.l11" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
                
                <math id="alg1.l11.m1" class="ltx_Math" alttext="\mathcal{H}\leftarrow" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{H}\leftarrow</annotation></semantics></math> fuzzy_within_ctx<math id="alg1.l11.m2" class="ltx_math_unparsed" alttext="(s.snippet,s.ctx;k{=}7,w{=}4)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>s</mi><mi>n</mi><mi>i</mi><mi>p</mi><mi>p</mi><mi>e</mi><mi>t</mi><mo>,</mo><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>c</mi><mi>t</mi><mi>x</mi><mo>;</mo><mi>k</mi><mo>=</mo><mn>7</mn><mo>,</mo><mi>w</mi><mo>=</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s.snippet,s.ctx;k{=}7,w{=}4)</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
