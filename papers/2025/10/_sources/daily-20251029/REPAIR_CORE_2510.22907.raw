<td id="A3.tab1.1.9.3" class="ltx_td ltx_align_left"><span id="A3.tab1.1.9.3.1" class="ltx_text" style="font-size:90%;">Patch could not be applied</span></td>
<td id="A3.tab1.1.9.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="A3.tab1.1.9.4.1" class="ltx_text" style="font-size:90%;">Manual</span></td></tr>
