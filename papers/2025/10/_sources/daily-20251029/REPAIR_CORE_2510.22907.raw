              <span id="alg1.l6.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l6.m1" class="ltx_Math" alttext="s.kind\in\{\text{symbol},\text{ast}\}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mtext class="undefined">\text</mtext><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>,</mo><mrow><mtext class="undefined">\text</mtext><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s.kind\in\{\text{symbol},\text{ast}\}</annotation></semantics></math> <span id="alg1.l6.3" class="ltx_text ltx_font_bold">then</span>

</div>
