<section id="A1.SS2.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">ReCode Agent</h5>

<div id="A1.SS2.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS0.Px3.p1.1" class="ltx_p">ReCode Agent shares a set of prompt templates across all environments, providing different primitive action descriptions and examples based on the environment.</p>
</div>
<div id="A1.SS2.SSS0.Px3.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SS2.SSS0.Px3.p2.pic1" class="ltx_picture" height="65.93" overflow="visible" version="1.1" viewBox="0 0 550 65.93" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,65.93) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 2.77 L 0 63.17 C 0 64.7 1.24 65.93 2.77 65.93 L 547.23 65.93 C 548.76 65.93 550 64.7 550 63.17 L 550 2.77 C 550 1.24 548.76 0 547.23 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 2.77 2.77 L 2.77 40.23 L 547.23 40.23 L 547.23 2.77 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 22.45 49.62)"><foreignObject style="--ltx-fo-width:31.74em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="439.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.SS2.SSS0.Px3.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:31.74em;">
