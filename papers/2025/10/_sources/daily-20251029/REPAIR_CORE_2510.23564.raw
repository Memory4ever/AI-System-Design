<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">10.55</td>
<td id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">9.76</td>
<td id="S4.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">10.29</td>
<td id="S4.T3.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">11.07</td>
<td id="S4.T3.2.1.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">3.15</td>
