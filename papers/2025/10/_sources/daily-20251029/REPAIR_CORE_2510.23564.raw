<span id="lstnumberx126" class="ltx_listingline"><span id="lstnumberx126.1" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">The</span><span id="lstnumberx126.2" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.3" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">variables</span><span id="lstnumberx126.4" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.5" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">you</span><span id="lstnumberx126.6" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.7" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">can</span><span id="lstnumberx126.8" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.9" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">use</span><span id="lstnumberx126.10" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.11" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">is</span><span id="lstnumberx126.12" class="ltx_text" style="--ltx-fg-color:#000000;">:</span>
