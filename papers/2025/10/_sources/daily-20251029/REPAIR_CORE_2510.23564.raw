ltx-fg-color:#000000;">price</span><span id="lstnumberx348.41" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx348.42" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">lower</span><span id="lstnumberx348.43" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx348.44" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">than</span><span id="lstnumberx348.45" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx348.46" class="ltx_text" style="--ltx-fg-color:#000000;">100.00</span><span id="lstnumberx348.47" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx348.48" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">dollars</span>
