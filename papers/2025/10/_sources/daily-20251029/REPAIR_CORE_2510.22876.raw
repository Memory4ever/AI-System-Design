<span id="algx3.l17.2.1" class="ltx_p"><math id="algx3.l17.m1" class="ltx_Math" alttext="\textit{Pool}[i]\leftarrow\textit{Pool}[i]\oplus A[i]\oplus B[i]" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_italic">Pool</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><mtext class="ltx_mathvariant_italic">Pool</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>⊕</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>⊕</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\textit{Pool}[i]\leftarrow\textit{Pool}[i]\oplus A[i]\oplus B[i]</annotation></semantics></math></span>
</span><span class="ltx_inline-block"><svg id="algx3.l17.pic5" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span><span class="ltx_inline-block"><svg id="algx3.l17.pic6" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span>
</div>
<div id="algx3.l18" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">18:</span>
                
                
