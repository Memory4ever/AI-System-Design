<span id="algx1.l9.2" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:190.8pt;">
<span id="algx1.l9.2.1" class="ltx_p"><span id="algx1.l9.2.1.1" class="ltx_text" style="float:right; float:right;"><math id="algx1.l9.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math><span id="algx1.l9.2.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#0000FF;"> Vectorized first mismatch detection</span></span></span>
</span>
</div>
<div id="algx1.l10" class="ltx_listingline">
