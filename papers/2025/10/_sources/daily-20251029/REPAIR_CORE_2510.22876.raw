<td id="S4.T2.2.2.2" class="ltx_td ltx_align_right ltx_border_t">95.6</td>
<td id="S4.T2.2.2.3" class="ltx_td ltx_align_right ltx_border_t">1469</td>
<td id="S4.T2.2.2.4" class="ltx_td ltx_align_right ltx_border_r ltx_border_t">24.88</td>
