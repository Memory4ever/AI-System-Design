<td id="S1.F1.3.1.8.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S1.F1.3.1.8.2.1" class="ltx_inline-block ltx_align_top" style="width:111.0pt;--ltx-bg-color:#DFEDFE;">
<span id="S1.F1.3.1.8.2.1.1" class="ltx_p"><span id="S1.F1.3.1.8.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#00B300;">✓ Matches ground truth</span></span>
</span></td></tr>
