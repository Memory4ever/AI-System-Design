<th id="A1.T1.2.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="A1.T1.2.3.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Raw / Per-word</span></th></tr>
