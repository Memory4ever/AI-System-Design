{"data":{"id":"10.48550/arxiv.2510.21049","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21049","prefix":"10.48550","suffix":"arxiv.2510.21049","identifiers":[{"identifier":"2510.21049","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.21049"}],"creators":[{"name":"Chegini, Atoosa","nameType":"Personal","givenName":"Atoosa","familyName":"Chegini","affiliation":[],"nameIdentifiers":[]},{"name":"Kazemi, Hamid","nameType":"Personal","givenName":"Hamid","familyName":"Kazemi","affiliation":[],"nameIdentifiers":[]},{"name":"Souza, Garrett","nameType":"Personal","givenName":"Garrett","familyName":"Souza","affiliation":[],"nameIdentifiers":[]},{"name":"Safi, Maria","nameType":"Personal","givenName":"Maria","familyName":"Safi","affiliation":[],"nameIdentifiers":[]},{"name":"Song, Yang","nameType":"Personal","givenName":"Yang","familyName":"Song","affiliation":[],"nameIdentifiers":[]},{"name":"Bengio, Samy","nameType":"Personal","givenName":"Samy","familyName":"Bengio","affiliation":[],"nameIdentifiers":[]},{"name":"Williamson, Sinead","nameType":"Personal","givenName":"Sinead","familyName":"Williamson","affiliation":[],"nameIdentifiers":[]},{"name":"Farajtabar, Mehrdad","nameType":"Personal","givenName":"Mehrdad","familyName":"Farajtabar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reasoning's Razor: Reasoning Improves Accuracy but Can Hurt Recall at Critical Operating Points in Safety and Hallucination Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-23T23:23:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-27T00:12:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Reasoning has become a central paradigm for large language models (LLMs), consistently boosting accuracy across diverse benchmarks. Yet its suitability for precision-sensitive tasks remains unclear. We present the first systematic study of reasoning for classification tasks under strict low false positive rate (FPR) regimes. Our analysis covers two tasks--safety detection and hallucination detection--evaluated in both fine-tuned and zero-shot settings, using standard LLMs and Large Reasoning Models (LRMs). Our results reveal a clear trade-off: Think On (reasoning-augmented) generation improves overall accuracy, but underperforms at the low-FPR thresholds essential for practical use. In contrast, Think Off (no reasoning during inference) dominates in these precision-sensitive regimes, with Think On surpassing only when higher FPRs are acceptable. In addition, we find token-based scoring substantially outperforms self-verbalized confidence for precision-sensitive deployments. Finally, a simple ensemble of the two modes recovers the strengths of each. Taken together, our findings position reasoning as a double-edged tool: beneficial for average accuracy, but often ill-suited for applications requiring strict precision.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.21049","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-27T01:45:32.000Z","registered":"2025-10-27T01:45:33.000Z","published":"2025","updated":"2025-10-27T01:45:33.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.21049","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}