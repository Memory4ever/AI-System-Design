<th id="A7.T10.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><math id="A7.T10.m2" class="ltx_Math" alttext="\bm{s}" display="inline" intent=":literal"><semantics><mi>𝒔</mi><annotation encoding="application/x-tex">\bm{s}</annotation></semantics></math> shared?</th>
