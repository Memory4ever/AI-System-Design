<th id="A3.T7.2.21.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r">GPU</th>
<td id="A3.T7.2.21.2" class="ltx_td ltx_align_center ltx_border_b" colspan="5"><math id="A3.T7.m73" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> RTX 4090</td></tr>
</tbody>
</table>
</figure>
