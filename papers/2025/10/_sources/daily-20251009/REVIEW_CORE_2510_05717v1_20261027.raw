<td id="A3.T8.2.7.2" class="ltx_td ltx_align_center" colspan="4"><math id="A3.T8.m11" class="ltx_Math" alttext="{1}\mathrm{e}{-4}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>−</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">{1}\mathrm{e}{-4}</annotation></semantics></math></td></tr>
