                </XMApp>
              </XMath>
            </Math></foreignObject></g></g><g transform="translate(326.85,85.15)"><g transform="translate(0,13.15) scale(1,-1)"><foreignObject width="25.64" height="11.16" overflow="visible"><Math class="ltx_math_unparsed" mode="inline" tex="\bm{d}_{0}^{1:V}" xml:id="S3.F1.pic1.m7">
              <XMath xml:id="S3.F1.pic1.m7.1">
                <XMTok font="bold italic" role="UNKNOWN">d</XMTok>
                <XMApp role="POSTSUBSCRIPT" scriptpos="1" xml:id="S3.F1.pic1.m7.1.2">
                  <XMTok fontsize="70%" meaning="0" role="NUMBER">0</XMTok>
                </XMApp>
                <XMApp role="POSTSUPERSCRIPT" scriptpos="1" xml:id="S3.F1.pic1.m7.1.3">
                  <XMApp xml:id="S3.F1.pic1.m7.1.3.1">
                    <XMTok fontsize="70%" name="colon" role="METARELOP">:</XMTok>
                    <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">V</XMTok>
                  </XMApp>
                </XMApp>
              </XMath>
            </Math></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1: </span><em id="S3.F1.3" class="ltx_emph ltx_font_italic">DiffSDA</em> processes sequences <math id="S3.F1.m4" class="ltx_math_unparsed" alttext="\mathbf{x}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{0}^{1:V}</annotation></semantics></math> via semantic and stochastic encoders (top and bottom). Their outputs <math id="S3.F1.m5" class="ltx_math_unparsed" alttext="(\bm{s}_{0},\bm{d}_{0}^{1:V},\mathbf{x}_{t}^{1:V})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝒔</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>𝒅</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo>,</mo><msubsup><mi>𝐱</mi><mi>t</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{s}_{0},\bm{d}_{0}^{1:V},\mathbf{x}_{t}^{1:V})</annotation></semantics></math> are fed to a stochastic decoder yielding a denoised <math id="S3.F1.m6" class="ltx_math_unparsed" alttext="\tilde{\mathbf{x}}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{x}}_{0}^{1:V}</annotation></semantics></math> (right).</figcaption>
</figure>
<div id="S3.SS1.p3" class="ltx_para ltx_noindent">
<p id="S3.SS1.p3.1" class="ltx_p">Given a sequence <math id="S3.SS1.p3.m1" class="ltx_math_unparsed" alttext="\mathbf{x}_{0}^{1:V}\sim p_{0}(\mathbf{x}_{0}^{1:V})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo>∼</mo><msub><mi>p</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{0}^{1:V}\sim p_{0}(\mathbf{x}_{0}^{1:V})</annotation></semantics></math>, the posterior distribution of the latent variables <math id="S3.SS1.p3.m2" class="ltx_math_unparsed" alttext="\mathbf{x}_{t}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{t}^{1:V}</annotation></semantics></math> and latent factors <math id="S3.SS1.p3.m3" class="ltx_Math" alttext="\bm{s}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒔</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\bm{s}_{0}</annotation></semantics></math> and <math id="S3.SS1.p3.m4" class="ltx_math_unparsed" alttext="\bm{d}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝒅</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{d}_{0}^{1:V}</annotation></semantics></math> is composed of three independent distributions. Further, unlike the non-autoregressive prior in Eq. <a href="#S3.E1" title="Equation 1 ‣ 3.1 Probabilistic Modeling ‣ 3 Method ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, here, we explicitly assume temporal dependence. The posterior distribution reads</p>
<table id="S3.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E2.m1" class="ltx_math_unparsed" alttext="p(\mathbf{x}_{t}^{1:V},\bm{s}_{0},\bm{d}_{0}^{1:V}\mid\mathbf{x}_{0}^{1:V})=p_{0t}(\mathbf{x}_{t}^{1:V}\mid\mathbf{x}_{0}^{1:V})p(\bm{s}_{0}\mid\mathbf{x}_{0}^{1:V})\prod_{\tau=1}^{V}p(\bm{d}_{0}^{\tau}\mid\bm{d}_{0}^{&lt;\tau},\mathbf{x}_{0}^{\leq\tau})" display="block" intent=":literal"><semantics><mrow><mi>p</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>t</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo>,</mo><msub><mi>𝒔</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>𝒅</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐱</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>t</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐱</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒔</mi><mn>0</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝐱</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mi>V</mi></munderover><mi>p</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒅</mi><mn>0</mn><mi>τ</mi></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><msubsup><mi>𝒅</mi><mn>0</mn><mrow><mphantom></mphantom><mo>&lt;</mo><mi>τ</mi></mrow></msubsup><mo>,</mo><msubsup><mi>𝐱</mi><mn>0</mn><mrow><mphantom></mphantom><mo>≤</mo><mi>τ</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(\mathbf{x}_{t}^{1:V},\bm{s}_{0},\bm{d}_{0}^{1:V}\mid\mathbf{x}_{0}^{1:V})=p_{0t}(\mathbf{x}_{t}^{1:V}\mid\mathbf{x}_{0}^{1:V})p(\bm{s}_{0}\mid\mathbf{x}_{0}^{1:V})\prod_{\tau=1}^{V}p(\bm{d}_{0}^{\tau}\mid\bm{d}_{0}^{&lt;\tau},\mathbf{x}_{0}^{\leq\tau})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p3.2" class="ltx_p">where <math id="S3.SS1.p3.m5" class="ltx_math_unparsed" alttext="\mathbf{x}_{t}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{t}^{1:V}</annotation></semantics></math> and <math id="S3.SS1.p3.m6" class="ltx_Math" alttext="\bm{s}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒔</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\bm{s}_{0}</annotation></semantics></math> are conditioned on the entire input <math id="S3.SS1.p3.m7" class="ltx_math_unparsed" alttext="\mathbf{x}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{0}^{1:V}</annotation></semantics></math>, and the dynamic factors only depend on pr evious dynamic factors and current and previous data elements. We employ score matching <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib33" title="" class="ltx_ref">Hyvärinen &amp; Dayan, 2005</a>; <a href="#bib.bib63" title="" class="ltx_ref">Song et al., 2021</a>)</cite>, to optimize for the denoising parametric map <math id="S3.SS1.p3.m8" class="ltx_Math" alttext="\bm{D}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>𝑫</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\bm{D}_{\theta}</annotation></semantics></math>. The map <math id="S3.SS1.p3.m9" class="ltx_Math" alttext="\bm{D}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>𝑫</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\bm{D}_{\theta}</annotation></semantics></math> takes the noisy latent <math id="S3.SS1.p3.m10" class="ltx_Math" alttext="\mathbf{x}_{t}^{\tau}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\mathbf{x}_{t}^{\tau}</annotation></semantics></math>, time <math id="S3.SS1.p3.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, and disentangled factors <math id="S3.SS1.p3.m12" class="ltx_Math" alttext="\mathbf{z}_{0}^{\tau}:=(\bm{s}_{0},\bm{d}_{0}^{\tau})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mn>0</mn><mi>τ</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒔</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>𝒅</mi><mn>0</mn><mi>τ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{0}^{\tau}:=(\bm{s}_{0},\bm{d}_{0}^{\tau})</annotation></semantics></math>, and it returns an estimate of the score function <math id="S3.SS1.p3.m13" class="ltx_Math" alttext="\nabla_{\mathbf{x}}\log p_{0t}(\mathbf{x}_{t}^{\tau}\mid\mathbf{x}_{0}^{\tau})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝐱</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msubsup><mi>𝐱</mi><mn>0</mn><mi>τ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{x}}\log p_{0t}(\mathbf{x}_{t}^{\tau}\mid\mathbf{x}_{0}^{\tau})</annotation></semantics></math>. Overall, the optimization objective reads</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="{\bm{\theta}}^{*}=\argmin_{\bm{\theta}}\mathbb{E}_{t}\Big\{\lambda_{t}\mathbb{E}\big[\left\lVert\bm{D}_{\theta}-\nabla_{\mathbf{x}}\log p_{0t}\right\rVert_{2}^{2}\big]\Big\}\ ," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝜽</mi><mo>∗</mo></msup><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>𝜽</mi></msub><mo>⁡</mo><msub><mi>𝔼</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>𝐃</mi><mi>θ</mi></msub><mo>−</mo><mrow><msub><mo>∇</mo><mi>𝐱</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo rspace="0.500em" stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{\theta}}^{*}=\argmin_{\bm{\theta}}\mathbb{E}_{t}\Big\{\lambda_{t}\mathbb{E}\big[\left\lVert\bm{D}_{\theta}-\nabla_{\mathbf{x}}\log p_{0t}\right\rVert_{2}^{2}\big]\Big\}\ ,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p3.3" class="ltx_p">where <math id="S3.SS1.p3.m14" class="ltx_Math" alttext="\lambda_{t}\in\mathbb{R}^{+}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">\lambda_{t}\in\mathbb{R}^{+}</annotation></semantics></math> is a positive weight, <math id="S3.SS1.p3.m15" class="ltx_Math" alttext="t\sim\mathcal{U}[0,T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\sim\mathcal{U}[0,T]</annotation></semantics></math> is uniformly sampled over <math id="S3.SS1.p3.m16" class="ltx_Math" alttext="[0,T]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,T]</annotation></semantics></math>, the variables <math id="S3.SS1.p3.m17" class="ltx_Math" alttext="\mathbf{x}_{t}^{\tau},\;\mathbf{x}_{0}^{\tau}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup><mo rspace="0.447em">,</mo><msubsup><mi>𝐱</mi><mn>0</mn><mi>τ</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{t}^{\tau},\;\mathbf{x}_{0}^{\tau}</annotation></semantics></math> are sampled from their respective distributions, <math id="S3.SS1.p3.m18" class="ltx_Math" alttext="p_{0t}(\cdot),p_{0}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{0t}(\cdot),p_{0}(\cdot)</annotation></semantics></math>, and <math id="S3.SS1.p3.m19" class="ltx_Math" alttext="\mathbf{z}_{0}^{\tau}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐳</mi><mn>0</mn><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\mathbf{z}_{0}^{\tau}</annotation></semantics></math> via the densities in Eq. <a href="#S3.E2" title="Equation 2 ‣ 3.1 Probabilistic Modeling ‣ 3 Method ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. The inner expectation is taken over <math id="S3.SS1.p3.m20" class="ltx_Math" alttext="\mathbf{x}_{t}^{\tau},\;\mathbf{z}_{0}^{\tau}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup><mo rspace="0.447em">,</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi>τ</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{t}^{\tau},\;\mathbf{z}_{0}^{\tau}</annotation></semantics></math>, and <math id="S3.SS1.p3.m21" class="ltx_Math" alttext="\mathbf{x}_{0}^{\tau}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐱</mi><mn>0</mn><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\mathbf{x}_{0}^{\tau}</annotation></semantics></math>. Importantly, <math id="S3.SS1.p3.m22" class="ltx_Math" alttext="p_{T0}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">p_{T0}</annotation></semantics></math> of <math id="S3.SS1.p3.m23" class="ltx_math_unparsed" alttext="\mathbf{s}_{0},\bm{d}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐬</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>𝒅</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{s}_{0},\bm{d}_{0}^{1:V}</annotation></semantics></math> is not used in Eq. <a href="#S3.E3" title="Equation 3 ‣ 3.1 Probabilistic Modeling ‣ 3 Method ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, and thus its optimization can be separated.</p>
</div>
<div id="S3.SS1.p4" class="ltx_para ltx_noindent">
<p id="S3.SS1.p4.1" class="ltx_p">Notably, we make no assumptions about the given data <math id="S3.SS1.p4.m1" class="ltx_math_unparsed" alttext="\mathbf{x}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{0}^{1:V}</annotation></semantics></math>, ensuring that our framework remains modal-free and independent of specific properties of video, audio, or time series data. This theoretical compatibility with any type of sequence makes it highly adaptable to diverse applications.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Diffusion Sequential Disentanglement Autoencoder</h3>

<div id="S3.SS2.p1" class="ltx_para ltx_noindent">
<p id="S3.SS2.p1.1" class="ltx_p">Our architecture, shown in Fig. <a href="#S3.F1" title="Figure 1 ‣ 3.1 Probabilistic Modeling ‣ 3 Method ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, comprises three main components: (1) a sequential semantic encoder, (2) a stochastic encoder, and (3) a stochastic decoder. At a high level, the sequential semantic encoder factorizes data into separate static and dynamic components, while the stochastic decoder denoises the noisy latent representation produced by the stochastic encoder, conditioned on the disentangled factors. Notably, unlike prior works, our implementation achieves disentanglement with a single, simple loss term.</p>
</div>
<section id="S3.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Encoders.</h4>

<div id="S3.SS2.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS0.Px1.p1.1" class="ltx_p">Inspired by prior work in sequential disentanglement <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib78" title="" class="ltx_ref">Yingzhen &amp; Mandt, 2018</a>)</cite>, we design a novel <em id="S3.SS2.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">sequential semantic encoder</em> to extract <math id="S3.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\bm{s}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒔</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\bm{s}_{0}</annotation></semantics></math> and <math id="S3.SS2.SSS0.Px1.p1.m2" class="ltx_math_unparsed" alttext="\bm{d}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝒅</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{d}_{0}^{1:V}</annotation></semantics></math>. Particularly, it consists of a U-Net <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib57" title="" class="ltx_ref">Ronneberger et al., 2015</a>)</cite> for video data and an MLP for other modalities, coupled with linear layers that independently process each sequence element. Then, an LSTM module summarizes the sequence into a latent representation <math id="S3.SS2.SSS0.Px1.p1.m3" class="ltx_math_unparsed" alttext="\bm{h}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{h}^{1:V}</annotation></semantics></math>. The last hidden, <math id="S3.SS2.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\bm{h}^{V}" display="inline" intent=":literal"><semantics><msup><mi>𝒉</mi><mi>V</mi></msup><annotation encoding="application/x-tex">\bm{h}^{V}</annotation></semantics></math>, is passed to a linear layer to produce <math id="S3.SS2.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\bm{s}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒔</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\bm{s}_{0}</annotation></semantics></math>, whereas <math id="S3.SS2.SSS0.Px1.p1.m6" class="ltx_math_unparsed" alttext="\bm{h}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{h}^{1:V}</annotation></semantics></math> are processed with another LSTM and a linear layer to produce <math id="S3.SS2.SSS0.Px1.p1.m7" class="ltx_math_unparsed" alttext="\bm{d}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝒅</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{d}_{0}^{1:V}</annotation></semantics></math>. Our stochastic encoder follows the EDM framework <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib36" title="" class="ltx_ref">Karras et al., 2022</a>)</cite>, adding noise <math id="S3.SS2.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\epsilon\sim\mathcal{N}(0,\sigma_{t}^{2}I)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon\sim\mathcal{N}(0,\sigma_{t}^{2}I)</annotation></semantics></math> to each element <math id="S3.SS2.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\mathbf{x}_{0}^{\tau}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐱</mi><mn>0</mn><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\mathbf{x}_{0}^{\tau}</annotation></semantics></math>, yielding <math id="S3.SS2.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\mathbf{x}_{t}^{\tau}=\mathbf{x}_{0}^{\tau}+\epsilon" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup><mo>=</mo><mrow><msubsup><mi>𝐱</mi><mn>0</mn><mi>τ</mi></msubsup><mo>+</mo><mi>ϵ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{t}^{\tau}=\mathbf{x}_{0}^{\tau}+\epsilon</annotation></semantics></math>. These encoders realize in practice the posterior in Eq. <a href="#S3.E2" title="Equation 2 ‣ 3.1 Probabilistic Modeling ‣ 3 Method ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<figure id="S3.F2" class="ltx_figure"><span id="S3.F2.pic1" class="ltx_picture ltx_centering" style="width:397.0pt;height:131.01000000000002pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="527.36" height="174.03" overflow="visible"><g transform="translate(0,174.03) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,176.01) scale(1,-1)"><foreignObject width="539.05" height="176.01" overflow="visible"><img src="2510.05717v1/teaser_lr_opt.png" id="S3.F2.pic1.g1" class="ltx_graphics ltx_img_landscape" style="width:100%;height:100%;object-fit:contain" width="548" height="183" alt="Refer to caption"></foreignObject></g></g><g transform="translate(0,104.37)"></g><g transform="translate(2.75,16.48)"></g><g transform="translate(184.03,104.37)"></g><g transform="translate(184.03,2.75)"></g><g transform="translate(366.68,74.16)"></g><g transform="translate(368.05,142.83)"></g><g transform="translate(368.05,10.99)"></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>We present swap (left), zero-shot (middle), and multifactor disentanglement (right) results on multiple real-world and high-resolution visual datasets. See Sec. <a href="#S4" title="4 Results ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> for further details.</figcaption>
</figure>
</section>
<section id="S3.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Decoder.</h4>

<div id="S3.SS2.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS0.Px2.p1.1" class="ltx_p">To efficiently handle real-world sequential information, we follow the decoding in EDM <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib36" title="" class="ltx_ref">Karras et al., 2022</a>)</cite>, featuring only <math id="S3.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="63" display="inline" intent=":literal"><semantics><mn>63</mn><annotation encoding="application/x-tex">63</annotation></semantics></math> neural function evaluations (NFEs) during inference. Our decoder <math id="S3.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\bm{D}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>𝑫</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\bm{D}_{\theta}</annotation></semantics></math> takes as inputs the noisy input <math id="S3.SS2.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\mathbf{x}_{t}^{\tau}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\mathbf{x}_{t}^{\tau}</annotation></semantics></math> and disentangled factors <math id="S3.SS2.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\mathbf{z}_{0}^{\tau}:=(\bm{s}_{0},\bm{d}_{0}^{\tau})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mn>0</mn><mi>τ</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒔</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>𝒅</mi><mn>0</mn><mi>τ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{0}^{\tau}:=(\bm{s}_{0},\bm{d}_{0}^{\tau})</annotation></semantics></math>, and it returns a denoised version of <math id="S3.SS2.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\mathbf{x}_{t}^{\tau}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\mathbf{x}_{t}^{\tau}</annotation></semantics></math>, denoted by <math id="S3.SS2.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\tilde{\mathbf{x}}_{0}^{\tau}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mn>0</mn><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\tilde{\mathbf{x}}_{0}^{\tau}</annotation></semantics></math>. Given any <math id="S3.SS2.SSS0.Px2.p1.m7" class="ltx_Math" alttext="t\in[0,T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,T]</annotation></semantics></math> and <math id="S3.SS2.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\tau\in\{1,\dots,V\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>V</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{1,\dots,V\}</annotation></semantics></math>, the decoder is parameterized independently from other times <math id="S3.SS2.SSS0.Px2.p1.m9" class="ltx_Math" alttext="t^{\prime},\tau^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>t</mi><mo>′</mo></msup><mo>,</mo><msup><mi>τ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">t^{\prime},\tau^{\prime}</annotation></semantics></math> as follows</p>
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E4.m1" class="ltx_Math" alttext="\displaystyle\tilde{\mathbf{x}}_{0}^{\tau}:=\bm{D}_{\theta}(\mathbf{x}_{t}^{\tau},t,\mathbf{z}_{0}^{\tau})=c_{t}^{\text{skip}}\mathbf{x}_{t}^{\tau}+c_{t}^{\text{out}}\bm{F}_{\theta}\left(c_{t}^{\text{in}}\mathbf{x}_{t}^{\tau},\mathbf{z}_{0}^{\tau},c^{\text{noise}}_{t}\right)\ ," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mn>0</mn><mi>τ</mi></msubsup><mo>:=</mo><mrow><msub><mi>𝑫</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup><mo>,</mo><mi>t</mi><mo>,</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi>τ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>c</mi><mi>t</mi><mtext>skip</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>c</mi><mi>t</mi><mtext>out</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑭</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>c</mi><mi>t</mi><mtext>in</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup></mrow><mo>,</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi>τ</mi></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>t</mi><mtext>noise</mtext></msubsup><mo rspace="0.500em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\mathbf{x}}_{0}^{\tau}:=\bm{D}_{\theta}(\mathbf{x}_{t}^{\tau},t,\mathbf{z}_{0}^{\tau})=c_{t}^{\text{skip}}\mathbf{x}_{t}^{\tau}+c_{t}^{\text{out}}\bm{F}_{\theta}\left(c_{t}^{\text{in}}\mathbf{x}_{t}^{\tau},\mathbf{z}_{0}^{\tau},c^{\text{noise}}_{t}\right)\ ,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S3.SS2.SSS0.Px2.p1.2" class="ltx_p">where <math id="S3.SS2.SSS0.Px2.p1.m10" class="ltx_Math" alttext="c_{t}^{\text{skip}}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>t</mi><mtext>skip</mtext></msubsup><annotation encoding="application/x-tex">c_{t}^{\text{skip}}</annotation></semantics></math> modulates the skip connection, <math id="S3.SS2.SSS0.Px2.p1.m11" class="ltx_Math" alttext="c_{t}^{\text{in}},c_{t}^{\text{out}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mi>t</mi><mtext>in</mtext></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>t</mi><mtext>out</mtext></msubsup></mrow><annotation encoding="application/x-tex">c_{t}^{\text{in}},c_{t}^{\text{out}}</annotation></semantics></math> scale the input/output magnitudes, and <math id="S3.SS2.SSS0.Px2.p1.m12" class="ltx_Math" alttext="c_{t}^{\text{noise}}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>t</mi><mtext>noise</mtext></msubsup><annotation encoding="application/x-tex">c_{t}^{\text{noise}}</annotation></semantics></math> maps noise at time <math id="S3.SS2.SSS0.Px2.p1.m13" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> into a conditioning input for the neural network <math id="S3.SS2.SSS0.Px2.p1.m14" class="ltx_Math" alttext="\bm{F}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>𝑭</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\bm{F}_{\theta}</annotation></semantics></math>, conditioned on <math id="S3.SS2.SSS0.Px2.p1.m15" class="ltx_Math" alttext="\mathbf{z}_{0}^{\tau}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐳</mi><mn>0</mn><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\mathbf{z}_{0}^{\tau}</annotation></semantics></math> through AdaGN.</p>
</div>
</section>
<section id="S3.SS2.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Loss.</h4>

<div id="S3.SS2.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS0.Px3.p1.1" class="ltx_p">While prior sequential disentanglement works depend on intricate prior modeling, regularization terms, and mutual information losses, leading to many hyper-parameters and challenging training, we opt for a simpler objective containing a single loss term that is based on Eq. <a href="#S3.E3" title="Equation 3 ‣ 3.1 Probabilistic Modeling ‣ 3 Method ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>,</p>
<table id="S3.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E5.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t,\mathbf{x}_{t}^{\tau},\mathbf{z}_{0}^{\tau},\mathbf{x}_{0}^{\tau}}\left[\lambda_{t}(c_{t}^{\text{out}})^{2}\|\bm{F}_{\theta}-\frac{1}{c_{t}^{\text{out}}}(\mathbf{x}_{0}^{\tau}-c_{t}^{\text{skip}}\cdot\mathbf{x}_{t}^{\tau})\|_{2}^{2}\right]\ ," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>,</mo><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup><mo>,</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi>τ</mi></msubsup><mo>,</mo><msubsup><mi>𝐱</mi><mn>0</mn><mi>τ</mi></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>t</mi><mtext>out</mtext></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑭</mi><mi>θ</mi></msub><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>c</mi><mi>t</mi><mtext>out</mtext></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mn>0</mn><mi>τ</mi></msubsup><mo>−</mo><mrow><msubsup><mi>c</mi><mi>t</mi><mtext>skip</mtext></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo rspace="0.500em">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t,\mathbf{x}_{t}^{\tau},\mathbf{z}_{0}^{\tau},\mathbf{x}_{0}^{\tau}}\left[\lambda_{t}(c_{t}^{\text{out}})^{2}\|\bm{F}_{\theta}-\frac{1}{c_{t}^{\text{out}}}(\mathbf{x}_{0}^{\tau}-c_{t}^{\text{skip}}\cdot\mathbf{x}_{t}^{\tau})\|_{2}^{2}\right]\ ,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S3.SS2.SSS0.Px3.p1.2" class="ltx_p">where <math id="S3.SS2.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\bm{F}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>𝑭</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\bm{F}_{\theta}</annotation></semantics></math> takes as inputs <math id="S3.SS2.SSS0.Px3.p1.m2" class="ltx_Math" alttext="c_{t}^{\text{in}}\mathbf{x}_{t}^{\tau},\mathbf{z}_{0}^{\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>c</mi><mi>t</mi><mtext>in</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>t</mi><mi>τ</mi></msubsup></mrow><mo>,</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi>τ</mi></msubsup></mrow><annotation encoding="application/x-tex">c_{t}^{\text{in}}\mathbf{x}_{t}^{\tau},\mathbf{z}_{0}^{\tau}</annotation></semantics></math>, and <math id="S3.SS2.SSS0.Px3.p1.m3" class="ltx_Math" alttext="c_{t}^{\text{noise}}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>t</mi><mtext>noise</mtext></msubsup><annotation encoding="application/x-tex">c_{t}^{\text{noise}}</annotation></semantics></math>.
While our loss in Eq. <a href="#S3.E5" title="Equation 5 ‣ Loss. ‣ 3.2 Diffusion Sequential Disentanglement Autoencoder ‣ 3 Method ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> does not include auxiliary terms, it promotes disentanglement due to two main reasons: i) the static factor <math id="S3.SS2.SSS0.Px3.p1.m4" class="ltx_Math" alttext="\bm{s}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒔</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\bm{s}_{0}</annotation></semantics></math> is shared across <math id="S3.SS2.SSS0.Px3.p1.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, and thus it will not hold dynamic information, and ii) the dynamic factors <math id="S3.SS2.SSS0.Px3.p1.m6" class="ltx_Math" alttext="\bm{d}_{0}^{\tau}\in\mathbb{R}^{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒅</mi><mn>0</mn><mi>τ</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\bm{d}_{0}^{\tau}\in\mathbb{R}^{k}</annotation></semantics></math> are low-dimensional (i.e., <math id="S3.SS2.SSS0.Px3.p1.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is small), making it difficult for <math id="S3.SS2.SSS0.Px3.p1.m8" class="ltx_Math" alttext="\bm{d}_{0}^{\tau}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒅</mi><mn>0</mn><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\bm{d}_{0}^{\tau}</annotation></semantics></math> to store static features. We empirically validate these assumptions through experiments presented in App. <a href="#A7.SS2" title="G.2 Additional Analysis of DiffSDA Disentanglement Components ‣ Appendix G Additional Experiments ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G.2</span></a>. Finally, we briefly mention that to support high-resolution sequences, we incorporate latent diffusion models (LDM) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib56" title="" class="ltx_ref">Rombach et al., 2022</a>)</cite>, using a pre-trained VQ-VAE autoencoder to reduce the high-dimensionality of input frames <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib49" title="" class="ltx_ref">Naiman et al., 2025</a>)</cite>. Instead of factorizing all the equations above with new symbols for the features VQ-VAE produces, we denote by <math id="S3.SS2.SSS0.Px3.p1.m9" class="ltx_math_unparsed" alttext="\mathrm{x}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathrm{x}_{0}^{1:V}</annotation></semantics></math> the input sequence, and we abuse the notation <math id="S3.SS2.SSS0.Px3.p1.m10" class="ltx_math_unparsed" alttext="\mathbf{x}_{0}^{1:V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{0}^{1:V}</annotation></semantics></math> to denote the latent features, i.e., <math id="S3.SS2.SSS0.Px3.p1.m11" class="ltx_math_unparsed" alttext="\mathbf{x}_{0}^{1:V}=\mathcal{E}(\mathrm{x}_{0}^{1:V})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{0}^{1:V}=\mathcal{E}(\mathrm{x}_{0}^{1:V})</annotation></semantics></math> and <math id="S3.SS2.SSS0.Px3.p1.m12" class="ltx_math_unparsed" alttext="\mathrm{x}_{0}^{1:V}=\mathcal{D}(\mathbf{x}_{0}^{1:V})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mn>0</mn><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{x}_{0}^{1:V}=\mathcal{D}(\mathbf{x}_{0}^{1:V})</annotation></semantics></math>, where <math id="S3.SS2.SSS0.Px3.p1.m13" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> and <math id="S3.SS2.SSS0.Px3.p1.m14" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> are the VQ-VAE encoder and decoder, respectively.</p>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Results</h2>

<div id="S4.p1" class="ltx_para ltx_noindent">
<p id="S4.p1.1" class="ltx_p">Below, we empirically evaluate the modeling capabilities of DiffSDA in comparison to recent <em id="S4.p1.1.1" class="ltx_emph ltx_font_italic">modal-agnostic</em> state-of-the-art methods (see Tab. <a href="#S2.T1" title="Table 1 ‣ Disentangled Representation Learning. ‣ 2 Related Work ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), SPYL <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib46" title="" class="ltx_ref">Naiman et al., 2023</a>)</cite> and DBSE <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib11" title="" class="ltx_ref">Berman et al., 2024b</a>)</cite>. In general, we consider quantitative and qualitative experiments. For video, we include three high-resolution, real-world visual datasets that have not been previously used for sequential disentanglement: VoxCeleb <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib44" title="" class="ltx_ref">Nagrani et al., 2017</a>)</cite>, CelebV-HQ <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib82" title="" class="ltx_ref">Zhu et al., 2022</a>)</cite>, and TaiChi-HD <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib59" title="" class="ltx_ref">Siarohin et al., 2019</a>)</cite>, along with the popular MUG dataset <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib1" title="" class="ltx_ref">Aifanti et al., 2010</a>)</cite>. For audio, we consider TIMIT <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib22" title="" class="ltx_ref">Garofolo (1993)</a></cite> and a new dataset, Libri Speech <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib50" title="" class="ltx_ref">Panayotov et al. (2015)</a></cite>. The time series datasets are PhysioNet, ETTh1, and Air Quality <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib64" title="" class="ltx_ref">Tonekaboni et al. (2022)</a></cite>. Detailed descriptions of the datasets and their pre-processing can be found in App. <a href="#A4" title="Appendix D Datasets ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a>, while extended baseline comparisons are provided in App. <a href="#A8.SS1" title="H.1 Extended Benchmark Results ‣ Appendix H Additional Results ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.1</span></a>. For brevity, we omit below the subscript indicating the diffusion step for clean samples (corresponding to time step 0).</p>
</div>
<figure id="S4.F3" class="ltx_figure"><span id="S4.F3.pic1" class="ltx_picture ltx_centering" style="width:397.0pt;height:131.01000000000002pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="527.36" height="174.03" overflow="visible"><g transform="translate(0,174.03) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,176.01) scale(1,-1)"><foreignObject width="539.05" height="176.01" overflow="visible"><img src="2510.05717v1/celebv_vox_taichi_swap_lr.png" id="S4.F3.pic1.g1" class="ltx_graphics ltx_img_landscape" style="width:100%;height:100%;object-fit:contain" width="548" height="183" alt="Refer to caption"></foreignObject></g></g><g transform="translate(5.49,109.87)"></g><g transform="translate(5.49,54.93)"></g><g transform="translate(5.49,5.49)"></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>We present dynamic swap results of our approach (third row) and SPYL (fourth row) on CelebV-HQ (left), VoxCeleb (middle), and TaiChi-HD (right).</figcaption>
</figure>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Conditional swap in videos</h3>

<div id="S4.SS1.p1" class="ltx_para ltx_noindent">
<p id="S4.SS1.p1.1" class="ltx_p">We begin our tests with the conditional swap task <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib78" title="" class="ltx_ref">Yingzhen &amp; Mandt, 2018</a>)</cite>. Given two sample videos <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>, <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="\hat{\mathbf{x}}\sim p_{0}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mo>∼</mo><msub><mi>p</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\hat{\mathbf{x}}\sim p_{0}</annotation></semantics></math>, the goal in this experiment is to create a new sample <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="\bar{\mathbf{x}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\mathbf{x}}</annotation></semantics></math>, conditioned on the static factor of <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="\bf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\bf{x}</annotation></semantics></math> and dynamic features of <math id="S4.SS1.p1.m5" class="ltx_Math" alttext="\hat{\mathbf{x}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbf{x}}</annotation></semantics></math>. This is done by extracting the latent factors <math id="S4.SS1.p1.m6" class="ltx_math_unparsed" alttext="\mathbf{z}=(\bm{s},\bm{d}^{1:V})" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>𝒔</mi><mo>,</mo><msup><mi>𝒅</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}=(\bm{s},\bm{d}^{1:V})</annotation></semantics></math> and <math id="S4.SS1.p1.m7" class="ltx_math_unparsed" alttext="\hat{\mathbf{z}}=(\hat{\bm{s}},\hat{\bm{d}}^{1:V})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐳</mi><mo>^</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒔</mi><mo>^</mo></mover><mo>,</mo><msup><mover accent="true"><mi>𝒅</mi><mo>^</mo></mover><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathbf{z}}=(\hat{\bm{s}},\hat{\bm{d}}^{1:V})</annotation></semantics></math> for <math id="S4.SS1.p1.m8" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> and <math id="S4.SS1.p1.m9" class="ltx_Math" alttext="\hat{\mathbf{x}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbf{x}}</annotation></semantics></math>, respectively. The new sample <math id="S4.SS1.p1.m10" class="ltx_Math" alttext="\bar{\mathbf{x}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\mathbf{x}}</annotation></semantics></math> is defined to be the reconstruction of <math id="S4.SS1.p1.m11" class="ltx_math_unparsed" alttext="\bar{\mathbf{z}}=(\bm{s},\hat{\bm{d}}^{1:V})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐳</mi><mo>¯</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>𝒔</mi><mo>,</mo><msup><mover accent="true"><mi>𝒅</mi><mo>^</mo></mover><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{\mathbf{z}}=(\bm{s},\hat{\bm{d}}^{1:V})</annotation></semantics></math> through sampling, see Alg. <a href="#A2.SS4" title="B.4 Reverse processes ‣ Appendix B DiffSDA Modeling ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>. In an ideal swap, <math id="S4.SS1.p1.m12" class="ltx_Math" alttext="\bar{\mathbf{x}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\mathbf{x}}</annotation></semantics></math> preserves the static characteristics of <math id="S4.SS1.p1.m13" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> while presenting the dynamics of <math id="S4.SS1.p1.m14" class="ltx_Math" alttext="\hat{\mathbf{x}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbf{x}}</annotation></semantics></math>, thus demonstrating strong disentanglement capabilities of the swapping method. We show in Fig. <a href="#S3.F2" title="Figure 2 ‣ Encoders. ‣ 3.2 Diffusion Sequential Disentanglement Autoencoder ‣ 3 Method ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (left) a swap example of DiffSDA, where the top two rows are real videos, and the third row shows the new sample obtained by preserving the static features of the first row and using the dynamics of the second row. Remarkably, while the people in these sequences are very different, many fine details are transferred, including head angle and orientation, as well as mouth and eyes orientation and openness. In Fig. <a href="#S4.F3" title="Figure 3 ‣ 4 Results ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we present additional swap results on CelebV-HQ (left), VoxCeleb (middle), and TaiChi-HD (right), comparing DiffSDA (third row) to SPYL (fourth row). Our approach produces high-quality samples, while swapping the dynamics of the second row into the first row, whereas SPYL struggles both with the reconstruction and swap. Additional conditional and unconditional swap results appear in App. <a href="#A8.SS3" title="H.3 Additional results: conditional swap ‣ Appendix H Additional Results ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.3</span></a> and App. <a href="#A8.SS4" title="H.4 Additional results: unconditional swap ‣ Appendix H Additional Results ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.4</span></a>, respectively.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para ltx_noindent">
<p id="S4.SS1.p2.1" class="ltx_p">In addition to the above qualitative evaluation, we also want to quantitatively assess DiffSDA’s effectiveness. We report in App. <a href="#A6" title="Appendix F MUG and Judge Metric Analysis ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a> results from the traditional quantitative benchmark, where a pre-trained judge (classifier) is used to determine if swapped content is correct <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib4" title="" class="ltx_ref">Bai et al., 2021</a>)</cite>. However, there are two main issues with the benchmark: i) it depends on labeled data, making it relevant to only a small number of datasets; and ii) results are sensitive to the expressivity and generalizability of the judge. For instance, swapping a smiling expression from person A to person B, may result in person B having a smile, different from the one in the data. In these cases, the judge may wrongly classify a different expression to the smiling person B, see App. <a href="#A6" title="Appendix F MUG and Judge Metric Analysis ‣ DiffSDA: Unsupervised Diffusion Sequential Disentanglement Across Modalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a> for further discussion.</p>
</div>
<figure id="S4.T2" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">Table 2: </span>Preservation of objects (AED) and motions (AKD) is estimated across several datasets and methods. The labels ‘static frozen’ and ‘dynamics frozen’ correspond to samples <math id="S4.T2.m3" class="ltx_Math" alttext="\mathbf{z}^{s}" display="inline" intent=":literal"><semantics><msup><mi>𝐳</mi><mi>s</mi></msup><annotation encoding="application/x-tex">\mathbf{z}^{s}</annotation></semantics></math> and <math id="S4.T2.m4" class="ltx_Math" alttext="\mathbf{z}^{d}" display="inline" intent=":literal"><semantics><msup><mi>𝐳</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbf{z}^{d}</annotation></semantics></math>.</figcaption>
<div id="S4.T2.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:318.0pt;height:65pt;vertical-align:-30.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-20.2pt,4.1pt) scale(0.887205750220793,0.887205750220793) ;">
<table id="S4.T2.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T2.2.1.1" class="ltx_tr">
<th id="S4.T2.2.1.1.1" class="ltx_td ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt"></th>
<th id="S4.T2.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" colspan="3">AED<math id="S4.T2.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> (static frozen)</th>
<th id="S4.T2.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3">AKD<math id="S4.T2.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> (dynamics frozen)</th></tr>
<tr id="S4.T2.2.1.2" class="ltx_tr">
<th id="S4.T2.2.1.2.1" class="ltx_td ltx_th ltx_th_column ltx_th_row ltx_border_r"></th>
<th id="S4.T2.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column">SPYL</th>
<th id="S4.T2.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column">DBSE</th>
<th id="S4.T2.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r">Ours</th>
<th id="S4.T2.2.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column">SPYL</th>
<th id="S4.T2.2.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column">DBSE</th>
<th id="S4.T2.2.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column">Ours</th></tr>
</thead>
