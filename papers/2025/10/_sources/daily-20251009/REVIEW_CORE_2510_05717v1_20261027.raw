              <span id="alg1.l4.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
               <span id="alg1.l5.2" class="ltx_text ltx_font_bold">sample</span> <math id="alg1.l5.m1" class="ltx_math_unparsed" alttext="\mathbf{x}_{N}^{1:V}\sim\mathcal{N}\big(\mathbf{0},~t_{N}^{2}~\mathbf{I}\big)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mi>N</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi></mrow></msubsup><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>𝟎</mn><mo rspace="0.497em">,</mo><msubsup><mi>t</mi><mi>N</mi><mn>2</mn></msubsup><mi>𝐈</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{N}^{1:V}\sim\mathcal{N}\big(\mathbf{0},~t_{N}^{2}~\mathbf{I}\big)</annotation></semantics></math>
  
</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
