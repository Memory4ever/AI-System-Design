<td id="A6.T9.2.11.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t">Ours</td>
<td id="A6.T9.2.11.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="A6.T9.m40" class="ltx_Math" alttext="81.15\%" display="inline" intent=":literal"><semantics><mrow><mn>81.15</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">81.15\%</annotation></semantics></math></td>
