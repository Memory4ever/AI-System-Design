            </Math></foreignObject></g></g><g transform="translate(335.09,164.8)"><g transform="translate(0,7.84) scale(1,-1)"><foreignObject width="13.02" height="5.84" overflow="visible"><Math mode="inline" tex="\bm{s}_{0}" text="s _ 0" xml:id="S3.F1.pic1.m6">
              <XMath xml:id="S3.F1.pic1.m6.1">
                <XMApp xml:id="S3.F1.pic1.m6.1.1">
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="bold italic" role="UNKNOWN">s</XMTok>
