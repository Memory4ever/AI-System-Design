<td id="S4.T2.5.5.4" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.T2.m6" class="ltx_Math" alttext="1.797\times 10^{-8}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">1.797</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">8</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.797\times 10^{-8}</annotation></semantics></math></td></tr>
