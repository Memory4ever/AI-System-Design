<td id="S4.T3.5.5.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="3"><span id="S4.T3.5.5.1.1" class="ltx_text" style="font-size:90%;">Single Specialized</span></td>
<td id="S4.T3.5.5.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T3.5.5.2.1" class="ltx_text" style="font-size:90%;">Spearman</span></td>
<td id="S4.T3.5.5.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T3.5.5.3.1" class="ltx_text" style="font-size:90%;">0.921</span></td></tr>
