<th id="S4.T3.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T3.5.1.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="font-size:90%;">Model</span></th>
