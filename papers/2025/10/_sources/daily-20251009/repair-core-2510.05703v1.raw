<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex185.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 2\sqrt{K}\Bigg(\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\|\phi(x,y)-\phi(x,y^{\prime})\|^{2}_{(\bar{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>2</mn><msqrt><mi>K</mi></msqrt><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>base</mtext></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sqrt{K}\Bigg(\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\|\phi(x,y)-\phi(x,y^{\prime})\|^{2}_{(\bar{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex186"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
