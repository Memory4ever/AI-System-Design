<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex136.m1" class="ltx_Math" alttext="\displaystyle c_{k}(x,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c_{k}(x,y)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex136.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\lambda_{k}}\left(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y|x)}{\pi_{\textup{ref}}(y|x)}-\beta\log\frac{\pi_{k}(y|x)}{\pi_{\textup{ref}}(y|x)}-\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>λ</mi><mi>k</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><msub><mi>π</mi><mtext>ref</mtext></msub></mfrac></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\lambda_{k}}\left(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y|x)}{\pi_{\textup{ref}}(y|x)}-\beta\log\frac{\pi_{k}(y|x)}{\pi_{\textup{ref}}(y|x)}-\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\right)</annotation></semantics></math></td>
