<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex184.m1" class="ltx_Math" alttext="\displaystyle=\sqrt{2K\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\|\phi(x,y)-\phi(x,y^{\prime})+\phi(x,y^{\prime})\|^{2}_{(\bar{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msqrt><mrow><mn>2</mn><mi>K</mi><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>base</mtext></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>ϕ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mi>ϕ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo>+</mo><mi>ϕ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><msub><mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{2K\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\|\phi(x,y)-\phi(x,y^{\prime})+\phi(x,y^{\prime})\|^{2}_{(\bar{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]}</annotation></semantics></math></td>
