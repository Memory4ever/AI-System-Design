<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex88.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[\hat{c}(x,y)-c^{*}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>c</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[\hat{c}(x,y)-c^{*}(x,y)]</annotation></semantics></math></td>
