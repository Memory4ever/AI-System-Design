<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex137.m1" class="ltx_Math" alttext="\displaystyle\quad+b^{c}_{k}(x,y)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+b^{c}_{k}(x,y).</annotation></semantics></math></td>
