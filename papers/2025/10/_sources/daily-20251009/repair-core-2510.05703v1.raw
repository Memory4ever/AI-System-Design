<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex87.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)</annotation></semantics></math></td>
