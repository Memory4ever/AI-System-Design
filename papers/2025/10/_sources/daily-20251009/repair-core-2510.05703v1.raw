<tbody id="A3.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex89.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+K\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[r^{*}(x,y)-\hat{r}(x,y)]-\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[r^{*}(x,y)-\hat{r}(x,y)]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mover accent="true"><mi>r</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mover accent="true"><mi>r</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+K\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[r^{*}(x,y)-\hat{r}(x,y)]-\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[r^{*}(x,y)-\hat{r}(x,y)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p12" class="ltx_para">
<p id="A3.SS3.p12.1" class="ltx_p"><span id="A3.SS3.p12.1.1" class="ltx_text">Let <math id="A3.SS3.p12.m1" class="ltx_Math" alttext="\bar{\lambda}=0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bar{\lambda}=0</annotation></semantics></math>. Recall that <math id="A3.SS3.p12.m2" class="ltx_Math" alttext="\pi^{\textup{out}}_{K}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>K</mi><mtext>out</mtext></msubsup><annotation encoding="application/x-tex">\pi^{\textup{out}}_{K}</annotation></semantics></math> is the uniform policy over <math id="A3.SS3.p12.m3" class="ltx_Math" alttext="\pi_{1},\dots,\pi_{K}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>π</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{1},\dots,\pi_{K}</annotation></semantics></math> and <math id="A3.SS3.p12.m4" class="ltx_Math" alttext="\eta:=\frac{\lambda_{1}}{C_{\max}\sqrt{K}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>:=</mo><mfrac><msub><mi>λ</mi><mn>1</mn></msub><mrow><msub><mi>C</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>K</mi></msqrt></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta:=\frac{\lambda_{1}}{C_{\max}\sqrt{K}}</annotation></semantics></math>. Then, we have</span></p>
<table id="A3.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex90.m1" class="ltx_Math" alttext="\displaystyle\quad f(\pi^{*})-f(\pi^{\textup{out}}_{K})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>K</mi><mtext>out</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad f(\pi^{*})-f(\pi^{\textup{out}}_{K})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex91.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{K}\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi_{k})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{K}\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi_{k})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex92.m1" class="ltx_Math" alttext="\displaystyle=O\Bigg(\frac{\lambda_{1}C_{\max}}{\sqrt{K}}+\rho C_{\max}\sqrt{\frac{\log\left(\frac{1}{\delta}\right)}{N^{\textup{CE}}}}+\rho W\sqrt{\frac{\log\left(\frac{|\mathcal{X}||\mathcal{Y}|N^{\textup{CE}}}{\delta}\right)}{M^{\textup{CE}}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>max</mi></msub></mrow><msqrt><mi>K</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow><msup><mi>N</mi><mtext>CE</mtext></msup></mfrac></mstyle></msqrt></mrow><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mtext>CE</mtext></msup></mrow><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow><msup><mi>M</mi><mtext>CE</mtext></msup></mfrac></mstyle></msqrt></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=O\Bigg(\frac{\lambda_{1}C_{\max}}{\sqrt{K}}+\rho C_{\max}\sqrt{\frac{\log\left(\frac{1}{\delta}\right)}{N^{\textup{CE}}}}+\rho W\sqrt{\frac{\log\left(\frac{|\mathcal{X}||\mathcal{Y}|N^{\textup{CE}}}{\delta}\right)}{M^{\textup{CE}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex93.m1" class="ltx_math_unparsed" alttext="\displaystyle+\!\rho\!\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{c}}+\gamma I)^{-1}}\right]\!+\!\frac{1}{K}\!\!\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{c}}+\gamma I)^{-1}}\right]\right)\!\!\cdot" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.052em">+</mo><mpadded style="width:0.347em;" width="0.347em"><mi>ρ</mi></mpadded><mrow><mo>(</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>c</mi></msup></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>c</mi></msup></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow><mpadded style="width:0.271em;" width="0.271em"><mo>)</mo></mpadded></mrow><mo>⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\!\rho\!\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{c}}+\gamma I)^{-1}}\right]\!+\!\frac{1}{K}\!\!\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{c}}+\gamma I)^{-1}}\right]\right)\!\!\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex94.m1" class="ltx_Math" alttext="\displaystyle\sqrt{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{1}{\delta}\right)\right)+\gamma(C_{\max})^{2}}" display="inline" intent=":literal"><semantics><msqrt><mrow><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>C</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>C</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><annotation encoding="application/x-tex">\displaystyle\sqrt{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{1}{\delta}\right)\right)+\gamma(C_{\max})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex95.m1" class="ltx_math_unparsed" alttext="\displaystyle+\!\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}}+\gamma I)^{-1}}\right]\!+\!\frac{1}{K}\!\!\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}}+\gamma I)^{-1}}\right]\right)\!\!\cdot" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.052em">+</mo><mrow><mo>(</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>r</mi></msup></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>r</mi></msup></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow><mpadded style="width:0.271em;" width="0.271em"><mo>)</mo></mpadded></mrow><mo>⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\!\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}}+\gamma I)^{-1}}\right]\!+\!\frac{1}{K}\!\!\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}}+\gamma I)^{-1}}\right]\right)\!\!\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex96.m1" class="ltx_Math" alttext="\displaystyle\sqrt{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{1}{\delta}\right)\right)+\gamma(R_{\max})^{2}}\Bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><msqrt><mrow><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>R</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{1}{\delta}\right)\right)+\gamma(R_{\max})^{2}}\Bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p13" class="ltx_para">
<p id="A3.SS3.p13.1" class="ltx_p"><span id="A3.SS3.p13.1.1" class="ltx_text">Let <math id="A3.SS3.p13.m1" class="ltx_Math" alttext="\bar{\lambda}=2\rho" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow></mrow><annotation encoding="application/x-tex">\bar{\lambda}=2\rho</annotation></semantics></math>. Then, we have</span></p>
<table id="A3.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex97.m1" class="ltx_math_unparsed" alttext="\displaystyle f(\pi^{*})-f(\pi^{\textup{out}}_{K})+2\rho\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{\textup{out}}_{K}(\cdot|x)}[c^{*}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>K</mi><mtext>out</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>2</mn><mi>ρ</mi><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>out</mtext></msup><msub><mrow></mrow><mi>K</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f(\pi^{*})-f(\pi^{\textup{out}}_{K})+2\rho\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{\textup{out}}_{K}(\cdot|x)}[c^{*}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex98.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{K}\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi_{k})\right)+\frac{2\rho}{K}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{K}\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi_{k})\right)+\frac{2\rho}{K}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p14" class="ltx_para">
<p id="A3.SS3.p14.1" class="ltx_p"><span id="A3.SS3.p14.1.1" class="ltx_text">If <math id="A3.SS3.p14.m1" class="ltx_math_unparsed" alttext="\frac{1}{K}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\leq 0" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\frac{1}{K}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\leq 0</annotation></semantics></math>, the second statement of the theorem naturally holds; Otherwise, we can replace the term <math id="A3.SS3.p14.m2" class="ltx_math_unparsed" alttext="2\rho\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{\textup{out}}_{K}(\cdot|x)}[c^{*}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mi>ρ</mi><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>out</mtext></msup><msub><mrow></mrow><mi>K</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">2\rho\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{\textup{out}}_{K}(\cdot|x)}[c^{*}(x,y)]</annotation></semantics></math> by <math id="A3.SS3.p14.m3" class="ltx_math_unparsed" alttext="2\rho[\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{\textup{out}}_{K}(\cdot|x)}[c^{*}(x,y)]]_{+}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mi>ρ</mi><msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>out</mtext></msup><msub><mrow></mrow><mi>K</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">2\rho[\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{\textup{out}}_{K}(\cdot|x)}[c^{*}(x,y)]]_{+}</annotation></semantics></math> in the above inequality.
Then, using Corollary <a href="#Thmcorollary1" title="Corollary 1 (Corollary 8.43 in []). ‣ Appendix F Technical Tools ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and Lemma <a href="#Thmlemma10" title="Lemma 10 (Theorem 3.60 in []). ‣ Appendix F Technical Tools ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, we obtain</span></p>
<table id="A3.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex99.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{\textup{out}}_{K}(\cdot|x)}[c^{*}(x,y)]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>out</mtext></msup><msub><mrow></mrow><mi>K</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{\textup{out}}_{K}(\cdot|x)}[c^{*}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex100.m1" class="ltx_Math" alttext="\displaystyle=O\Bigg(\frac{C_{\max}}{\rho\sqrt{K}}\left(\frac{\left(\lambda_{1}-2\rho\right)^{2}}{\lambda_{1}}+\lambda_{1}\right)+C_{\max}\sqrt{\frac{\log\left(\frac{1}{\delta}\right)}{N^{\textup{CE}}}}+W\sqrt{\frac{\log\left(\frac{|\mathcal{X}||\mathcal{Y}|N^{\textup{CE}}}{\delta}\right)}{M^{\textup{CE}}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mi>max</mi></msub><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>K</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><msub><mi>λ</mi><mn>1</mn></msub></mfrac></mstyle><mo>+</mo><msub><mi>λ</mi><mn>1</mn></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow><msup><mi>N</mi><mtext>CE</mtext></msup></mfrac></mstyle></msqrt></mrow><mo>+</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mtext>CE</mtext></msup></mrow><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow><msup><mi>M</mi><mtext>CE</mtext></msup></mfrac></mstyle></msqrt></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=O\Bigg(\frac{C_{\max}}{\rho\sqrt{K}}\left(\frac{\left(\lambda_{1}-2\rho\right)^{2}}{\lambda_{1}}+\lambda_{1}\right)+C_{\max}\sqrt{\frac{\log\left(\frac{1}{\delta}\right)}{N^{\textup{CE}}}}+W\sqrt{\frac{\log\left(\frac{|\mathcal{X}||\mathcal{Y}|N^{\textup{CE}}}{\delta}\right)}{M^{\textup{CE}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex101.m1" class="ltx_math_unparsed" alttext="\displaystyle+\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{c}}+\gamma I)^{-1}}\right]\!+\!\frac{1}{K}\!\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{c}}+\gamma I)^{-1}}\right]\right)\!\cdot" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo>(</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>c</mi></msup></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>c</mi></msup></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow><mo>)</mo></mrow><mo lspace="0.052em">⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{c}}+\gamma I)^{-1}}\right]\!+\!\frac{1}{K}\!\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{c}}+\gamma I)^{-1}}\right]\right)\!\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex102.m1" class="ltx_Math" alttext="\displaystyle\sqrt{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{1}{\delta}\right)\right)+\gamma(C_{\max})^{2}}" display="inline" intent=":literal"><semantics><msqrt><mrow><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>C</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>C</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><annotation encoding="application/x-tex">\displaystyle\sqrt{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{1}{\delta}\right)\right)+\gamma(C_{\max})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex103.m1" class="ltx_math_unparsed" alttext="\displaystyle+\!\frac{1}{\rho}\!\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}\!\!\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}}+\gamma I)^{-1}}\right]\!+\!\frac{1}{K}\!\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\!\!\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}}+\gamma I)^{-1}}\right]\right)\!\cdot" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.052em">+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ρ</mi></mfrac></mstyle><mrow><mo>(</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>r</mi></msup></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>r</mi></msup></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow><mo>)</mo></mrow><mo lspace="0.052em">⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\!\frac{1}{\rho}\!\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}\!\!\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}}+\gamma I)^{-1}}\right]\!+\!\frac{1}{K}\!\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\!\!\left[\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}}+\gamma I)^{-1}}\right]\right)\!\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex104.m1" class="ltx_Math" alttext="\displaystyle\sqrt{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{1}{\delta}\right)\right)+\gamma(R_{\max})^{2}}\Bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><msqrt><mrow><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>R</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{1}{\delta}\right)\right)+\gamma(R_{\max})^{2}}\Bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p14.2" class="ltx_p"><span id="A3.SS3.p14.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Pseudo-code and Detailed Description of Algorithm <math id="A4.m1" class="ltx_Math" alttext="\mathtt{O\mbox{-}PD\mbox{-}DPO}" display="inline" intent=":literal"><semantics><mrow><mi>𝙾</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙿𝙳</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙳𝙿𝙾</mi></mrow><annotation encoding="application/x-tex">\mathtt{O\mbox{-}PD\mbox{-}DPO}</annotation></semantics></math></h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">In this section, we present the pseudo-code and a more detailed description of algorithm <math id="A4.p1.m1" class="ltx_Math" alttext="\mathtt{O\mbox{-}PD\mbox{-}DPO}" display="inline" intent=":literal"><semantics><mrow><mi>𝙾</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙿𝙳</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙳𝙿𝙾</mi></mrow><annotation encoding="application/x-tex">\mathtt{O\mbox{-}PD\mbox{-}DPO}</annotation></semantics></math>.</p>
</div>
<div id="A4.p2" class="ltx_para">
<p id="A4.p2.1" class="ltx_p">Algorithm <a href="#algorithm2" title='In Appendix D Pseudo-code and Detailed Description of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> illustrates the algorithm procedure of <math id="A4.p2.m1" class="ltx_Math" alttext="\mathtt{O\mbox{-}PD\mbox{-}DPO}" display="inline" intent=":literal"><semantics><mrow><mi>𝙾</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙿𝙳</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙳𝙿𝙾</mi></mrow><annotation encoding="application/x-tex">\mathtt{O\mbox{-}PD\mbox{-}DPO}</annotation></semantics></math>. Compared to algorithm <math id="A4.p2.m2" class="ltx_Math" alttext="\mathtt{PD\mbox{-}DPO}" display="inline" intent=":literal"><semantics><mrow><mi>𝙿𝙳</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙳𝙿𝙾</mi></mrow><annotation encoding="application/x-tex">\mathtt{PD\mbox{-}DPO}</annotation></semantics></math>, <math id="A4.p2.m3" class="ltx_Math" alttext="\mathtt{O\mbox{-}PD\mbox{-}DPO}" display="inline" intent=":literal"><semantics><mrow><mi>𝙾</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙿𝙳</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙳𝙿𝙾</mi></mrow><annotation encoding="application/x-tex">\mathtt{O\mbox{-}PD\mbox{-}DPO}</annotation></semantics></math> includes exploration bonuses <math id="A4.p2.m4" class="ltx_Math" alttext="b^{c}_{k}(x,y)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">b^{c}_{k}(x,y)</annotation></semantics></math> and <math id="A4.p2.m5" class="ltx_Math" alttext="b^{r}_{k}(x,y)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">b^{r}_{k}(x,y)</annotation></semantics></math> in the standard DPO and standard rearranged Lagrangian DPO training objectives (Lines <a href="#A4.EGx72" title='In 2 ‣ Appendix D Pseudo-code and Detailed Description of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#A4.EGx73" title='In 2 ‣ Appendix D Pseudo-code and Detailed Description of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>). We define the exploration bonuses <math id="A4.p2.m6" class="ltx_Math" alttext="b^{\diamond}_{k}(x,y)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mi>k</mi><mo>⋄</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">b^{\diamond}_{k}(x,y)</annotation></semantics></math> as</p>
<table id="A4.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex105.m1" class="ltx_Math" alttext="\displaystyle b^{\diamond}_{k}(x,y):=4\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{\diamond}_{k}}+\gamma^{\textup{on}}I)^{-1}}\!\!\sqrt{\frac{\left(\exp\left(z\right)+\exp\left(-z\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|\!+\!\log\left(\frac{2}{\delta^{\prime}}\right)\right)\!+\!\gamma^{\textup{on}}z^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>b</mi><mi>k</mi><mo>⋄</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mo>⋄</mo></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mi>z</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mi>z</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mi>δ</mi><mo>′</mo></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle b^{\diamond}_{k}(x,y):=4\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{\diamond}_{k}}+\gamma^{\textup{on}}I)^{-1}}\!\!\sqrt{\frac{\left(\exp\left(z\right)+\exp\left(-z\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|\!+\!\log\left(\frac{2}{\delta^{\prime}}\right)\right)\!+\!\gamma^{\textup{on}}z^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.2" class="ltx_p">where</p>
<table id="A4.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex106.m1" class="ltx_Math" alttext="\displaystyle\tilde{\Sigma}_{\mathcal{D}^{\diamond}_{k}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mo>⋄</mo></msubsup></msub><annotation encoding="application/x-tex">\displaystyle\tilde{\Sigma}_{\mathcal{D}^{\diamond}_{k}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex106.m2" class="ltx_Math" alttext="\displaystyle:=\frac{1}{N^{\textup{on}}}\sum_{(x,y,y^{\prime})\in\mathcal{D}^{\diamond}_{1}}\left(\phi(x,y)-\phi(x,y^{\prime})\right)\left(\phi(x,y)-\phi(x,y^{\prime})\right)^{\top}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mo>⋄</mo></msubsup></mrow></munder></mstyle><mrow><mrow><mo>(</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{1}{N^{\textup{on}}}\sum_{(x,y,y^{\prime})\in\mathcal{D}^{\diamond}_{1}}\left(\phi(x,y)-\phi(x,y^{\prime})\right)\left(\phi(x,y)-\phi(x,y^{\prime})\right)^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex107.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\ +\frac{1}{N^{\textup{on}}}\sum_{k=1}^{K}\sum_{i=1}^{N^{\textup{on}}}\left(\phi(x_{k,i},y_{k,i})-\phi(x_{k,i},y^{\prime}_{k,i})\right)\left(\phi(x_{k,i},y_{k,i})-\phi(x_{k,i},y^{\prime}_{k,i})\right)^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>N</mi><mtext>on</mtext></msup></munderover></mstyle><mrow><mo>(</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msub><mi>y</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>y</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><msup><mrow><mo>(</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msub><mi>y</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>y</mi><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad\ +\frac{1}{N^{\textup{on}}}\sum_{k=1}^{K}\sum_{i=1}^{N^{\textup{on}}}\left(\phi(x_{k,i},y_{k,i})-\phi(x_{k,i},y^{\prime}_{k,i})\right)\left(\phi(x_{k,i},y_{k,i})-\phi(x_{k,i},y^{\prime}_{k,i})\right)^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.3" class="ltx_p">with <math id="A4.p2.m7" class="ltx_Math" alttext="z=R_{\max}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">z=R_{\max}</annotation></semantics></math> when <math id="A4.p2.m8" class="ltx_math_unparsed" alttext="\diamond=r" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">⋄</mo><mo lspace="0em">=</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\diamond=r</annotation></semantics></math>, and <math id="A4.p2.m9" class="ltx_Math" alttext="z=C_{\max}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><msub><mi>C</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">z=C_{\max}</annotation></semantics></math> when <math id="A4.p2.m10" class="ltx_math_unparsed" alttext="\diamond=c" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">⋄</mo><mo lspace="0em">=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">\diamond=c</annotation></semantics></math>.</p>
</div>
<figure id="algorithm2" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span><math id="algorithm2.m2" class="ltx_Math" alttext="\mathtt{O\mbox{-}PD\mbox{-}DPO}" display="inline" intent=":literal"><semantics><mrow><mi>𝙾</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙿𝙳</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙳𝙿𝙾</mi></mrow><annotation encoding="application/x-tex">\mathtt{O\mbox{-}PD\mbox{-}DPO}</annotation></semantics></math></figcaption>
<div id="algorithm2.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm2.4.1" class="ltx_listingline">
<span id="algorithm2.4.1.1" class="ltx_text"><span id="algorithm2.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span><math id="algorithm2.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>, <math id="algorithm2.m4" class="ltx_Math" alttext="\delta^{\prime}:=\frac{\delta}{4}" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mo>′</mo></msup><mo>:=</mo><mfrac><mi>δ</mi><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\delta^{\prime}:=\frac{\delta}{4}</annotation></semantics></math>, <math id="algorithm2.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, <math id="algorithm2.m6" class="ltx_Math" alttext="\pi_{\textup{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>ref</mtext></msub><annotation encoding="application/x-tex">\pi_{\textup{ref}}</annotation></semantics></math>, <math id="algorithm2.m7" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>, <math id="algorithm2.m8" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math>, <math id="algorithm2.m9" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, <math id="algorithm2.m10" class="ltx_Math" alttext="N^{\textup{CE}}" display="inline" intent=":literal"><semantics><msup><mi>N</mi><mtext>CE</mtext></msup><annotation encoding="application/x-tex">N^{\textup{CE}}</annotation></semantics></math>, <math id="algorithm2.m11" class="ltx_Math" alttext="M^{\textup{CE}}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mtext>CE</mtext></msup><annotation encoding="application/x-tex">M^{\textup{CE}}</annotation></semantics></math>, <math id="algorithm2.m12" class="ltx_Math" alttext="\gamma^{\textup{on}}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mtext>on</mtext></msup><annotation encoding="application/x-tex">\gamma^{\textup{on}}</annotation></semantics></math>, <math id="algorithm2.m13" class="ltx_Math" alttext="N^{\textup{on}}:=32K^{2}\ln(\frac{8K|\mathcal{X}||\mathcal{Y}|}{\delta^{\prime}})/(\gamma^{\textup{on}})^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>N</mi><mtext>on</mtext></msup><mo>:=</mo><mrow><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><msup><mi>δ</mi><mo>′</mo></msup></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>/</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>γ</mi><mtext>on</mtext></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">N^{\textup{on}}:=32K^{2}\ln(\frac{8K|\mathcal{X}||\mathcal{Y}|}{\delta^{\prime}})/(\gamma^{\textup{on}})^{2}</annotation></semantics></math>, <math id="algorithm2.m14" class="ltx_Math" alttext="\mathcal{D}^{p}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msup><annotation encoding="application/x-tex">\mathcal{D}^{p}</annotation></semantics></math>, <math id="algorithm2.m15" class="ltx_Math" alttext="\mathcal{D}^{r}=\{(x^{r}_{i},y_{i}^{rw},y_{i}^{r\ell})\}_{i\in[N^{r}]}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>r</mi></msup><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>r</mi></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>N</mi><mi>r</mi></msup><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{D}^{r}=\{(x^{r}_{i},y_{i}^{rw},y_{i}^{r\ell})\}_{i\in[N^{r}]}</annotation></semantics></math>, <math id="algorithm2.m16" class="ltx_Math" alttext="\mathcal{D}^{c}=\{(x^{c}_{i},y_{i}^{cw},y_{i}^{c\ell})\}_{i\in[N^{c}]}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>c</mi></msup><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>c</mi></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>N</mi><mi>c</mi></msup><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{D}^{c}=\{(x^{c}_{i},y_{i}^{cw},y_{i}^{c\ell})\}_{i\in[N^{c}]}</annotation></semantics></math>
</div>
<div id="algorithm2.4.2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.2.1" class="ltx_text ltx_font_bold">1</span></span>
          <math id="algorithm2.m17" class="ltx_Math" alttext="\mathcal{D}^{r}_{1}\leftarrow\mathcal{D}^{r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">←</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{D}^{r}_{1}\leftarrow\mathcal{D}^{r}</annotation></semantics></math>, <math id="algorithm2.m18" class="ltx_Math" alttext="\mathcal{D}^{c}_{1}\leftarrow\mathcal{D}^{c}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>c</mi></msubsup><mo stretchy="false">←</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>c</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{D}^{c}_{1}\leftarrow\mathcal{D}^{c}</annotation></semantics></math>
</div>
<div id="algorithm2.4.3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.3.1" class="ltx_text ltx_font_bold">2</span></span>
          <span id="algorithm2.4.3.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm2.4.3.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m19" class="ltx_Math" alttext="k=1,2,\dots,K" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">k=1,2,\dots,K</annotation></semantics></math></em> <span id="algorithm2.4.3.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.4" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.4.1" class="ltx_text ltx_font_bold">3</span></span>
          Train a model using standard DPO with exploration bonuses:

<table id="A4.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex108.m1" class="ltx_Math" alttext="\displaystyle\pi^{*}_{\hat{r}+b^{r}}\leftarrow\operatornamewithlimits{argmin}_{\pi\in\tilde{\Pi}^{r}_{k}}-\!\!\!\!\!\!\sum_{(x,y^{rw},y^{r\ell})\in\mathcal{D}^{r}}\log\sigma\Bigg(" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mrow><mover accent="true"><mi>r</mi><mo>^</mo></mover><mo>+</mo><msup><mi>b</mi><mi>r</mi></msup></mrow><mo>∗</mo></msubsup><mo rspace="0.1389em" stretchy="false">←</mo><mrow><munder><mo lspace="0.1389em" rspace="0em">argmin</mo><mrow><mi>π</mi><mo>∈</mo><msubsup><mover accent="true"><mi mathvariant="normal">Π</mi><mo>~</mo></mover><mi>k</mi><mi>r</mi></msubsup></mrow></munder><mpadded style="width:0em;" width="0em"><mo lspace="0em">−</mo></mpadded><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo>,</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>r</mi></msup></mrow></munder></mstyle><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi^{*}_{\hat{r}+b^{r}}\leftarrow\operatornamewithlimits{argmin}_{\pi\in\tilde{\Pi}^{r}_{k}}-\!\!\!\!\!\!\sum_{(x,y^{rw},y^{r\ell})\in\mathcal{D}^{r}}\log\sigma\Bigg(</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex108.m2" class="ltx_Math" alttext="\displaystyle\beta\log\frac{\pi(y^{rw}|x)}{\pi_{\textup{ref}}(y^{rw}|x)}-b^{r}(x,y^{rw})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><msup><mi>b</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\beta\log\frac{\pi(y^{rw}|x)}{\pi_{\textup{ref}}(y^{rw}|x)}-b^{r}(x,y^{rw})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E29.m1" class="ltx_Math" alttext="\displaystyle-\left(\beta\log\frac{\pi(y^{r\ell}|x)}{\pi_{\textup{ref}}(y^{r\ell}|x)}-b^{r}(x,y^{r\ell})\right)\Bigg)," display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>−</mo><mrow><mo>(</mo><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><msup><mi>b</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\left(\beta\log\frac{\pi(y^{r\ell}|x)}{\pi_{\textup{ref}}(y^{r\ell}|x)}-b^{r}(x,y^{r\ell})\right)\Bigg),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
where <math id="algorithm2.m20" class="ltx_Math" alttext="\tilde{\Pi}^{r}_{k}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi mathvariant="normal">Π</mi><mo>~</mo></mover><mi>k</mi><mi>r</mi></msubsup><annotation encoding="application/x-tex">\tilde{\Pi}^{r}_{k}</annotation></semantics></math> is defined in Eq. (<a href="#A4.E31" title='In Appendix D Pseudo-code and Detailed Description of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>)
</div>
<div id="algorithm2.4.5" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.5.1" class="ltx_text ltx_font_bold">4</span></span>
          Train a model using a rearranged Lagrangian DPO objective with exploration bonuses:

<table id="A4.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex109.m1" class="ltx_Math" alttext="\displaystyle\pi_{k}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>k</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{k}\leftarrow</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex109.m2" class="ltx_Math" alttext="\displaystyle\operatornamewithlimits{argmin}_{\pi\in\tilde{\Pi}^{c}_{k}}-\sum_{(x,y^{cw},y^{c\ell})\in\mathcal{D}^{c}}\log\sigma\Bigg(\frac{1}{\lambda_{k}}\bigg(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{cw}|x)}{\pi_{\textup{ref}}(y^{cw}|x)}-\beta\log\frac{\pi(y^{cw}|x)}{\pi_{\textup{ref}}(y^{cw}|x)}" display="inline" intent=":literal"><semantics><mrow><munder><mo>argmin</mo><mrow><mi>π</mi><mo>∈</mo><msubsup><mover accent="true"><mi mathvariant="normal">Π</mi><mo>~</mo></mover><mi>k</mi><mi>c</mi></msubsup></mrow></munder><mo lspace="0em">−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo>,</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>c</mi></msup></mrow></munder></mstyle><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>λ</mi><mi>k</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatornamewithlimits{argmin}_{\pi\in\tilde{\Pi}^{c}_{k}}-\sum_{(x,y^{cw},y^{c\ell})\in\mathcal{D}^{c}}\log\sigma\Bigg(\frac{1}{\lambda_{k}}\bigg(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{cw}|x)}{\pi_{\textup{ref}}(y^{cw}|x)}-\beta\log\frac{\pi(y^{cw}|x)}{\pi_{\textup{ref}}(y^{cw}|x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E30.m1" class="ltx_Math" alttext="\displaystyle-b^{c}_{k}(x,y^{cw})-\Big(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{c\ell}|x)}{\pi_{\textup{ref}}(y^{c\ell}|x)}-\beta\log\frac{\pi(y^{c\ell}|x)}{\pi_{\textup{ref}}(y^{c\ell}|x)}-b^{c}_{k}(x,y^{c\ell})\Big)\bigg)\Bigg)," display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo fence="true" lspace="0em" rspace="0em">OPEN</mo><mrow><mrow><mo>−</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-b^{c}_{k}(x,y^{cw})-\Big(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{c\ell}|x)}{\pi_{\textup{ref}}(y^{c\ell}|x)}-\beta\log\frac{\pi(y^{c\ell}|x)}{\pi_{\textup{ref}}(y^{c\ell}|x)}-b^{c}_{k}(x,y^{c\ell})\Big)\bigg)\Bigg),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
where <math id="algorithm2.m21" class="ltx_Math" alttext="\tilde{\Pi}^{c}_{k}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi mathvariant="normal">Π</mi><mo>~</mo></mover><mi>k</mi><mi>c</mi></msubsup><annotation encoding="application/x-tex">\tilde{\Pi}^{c}_{k}</annotation></semantics></math> is defined in Eq. (<a href="#A4.E32" title='In Appendix D Pseudo-code and Detailed Description of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>) 
</div>
<div id="algorithm2.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.6.1" class="ltx_text ltx_font_bold">5</span></span>
          Construct an estimate <math id="algorithm2.m22" class="ltx_Math" alttext="\tilde{c}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\tilde{c}_{k}</annotation></semantics></math> for <math id="algorithm2.m23" class="ltx_math_unparsed" alttext="\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]</annotation></semantics></math>: For <math id="algorithm2.m24" class="ltx_Math" alttext="i=1,\dots,N^{\textup{CE}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>N</mi><mtext>CE</mtext></msup></mrow><annotation encoding="application/x-tex">i=1,\dots,N^{\textup{CE}}</annotation></semantics></math>, first sample <math id="algorithm2.m25" class="ltx_Math" alttext="x_{i}\sim\mathcal{D}^{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">x_{i}\sim\mathcal{D}^{p}</annotation></semantics></math>, <math id="algorithm2.m26" class="ltx_math_unparsed" alttext="y_{i}\sim\pi_{k}(\cdot|x_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>∼</mo><msub><mi>π</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y_{i}\sim\pi_{k}(\cdot|x_{i})</annotation></semantics></math>. Then, for each <math id="algorithm2.m27" class="ltx_Math" alttext="(x_{i},y_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{i},y_{i})</annotation></semantics></math>, sample <math id="algorithm2.m28" class="ltx_Math" alttext="\{Z_{i,j}\}_{j=1}^{M^{\textup{CE}}}\overset{\textup{i.i.d.}}{\sim}\textup{Ber}(\sigma(c^{*}(x_{i},y_{i})))" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>Z</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>M</mi><mtext>CE</mtext></msup></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>∼</mo><mtext mathsize="0.700em">i.i.d.</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mtext>Ber</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>c</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\{Z_{i,j}\}_{j=1}^{M^{\textup{CE}}}\overset{\textup{i.i.d.}}{\sim}\textup{Ber}(\sigma(c^{*}(x_{i},y_{i})))</annotation></semantics></math>. Set <math id="algorithm2.m29" class="ltx_Math" alttext="\tilde{c}_{k}\leftarrow\frac{1}{N^{\textup{CE}}}\sum_{i=1}^{N^{\textup{CE}}}\sigma^{-1}(\frac{1}{M^{\textup{CE}}}\sum_{j=1}^{M^{\textup{CE}}}Z_{i,j})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><msup><mi>N</mi><mtext>CE</mtext></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>N</mi><mtext>CE</mtext></msup></msubsup><mrow><msup><mi>σ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><msup><mi>M</mi><mtext>CE</mtext></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>M</mi><mtext>CE</mtext></msup></msubsup><msub><mi>Z</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{c}_{k}\leftarrow\frac{1}{N^{\textup{CE}}}\sum_{i=1}^{N^{\textup{CE}}}\sigma^{-1}(\frac{1}{M^{\textup{CE}}}\sum_{j=1}^{M^{\textup{CE}}}Z_{i,j})</annotation></semantics></math>, where <math id="algorithm2.m30" class="ltx_Math" alttext="\sigma^{-1}(z):=\log(\frac{1}{1-z}-1)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>σ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>z</mi></mrow></mfrac><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma^{-1}(z):=\log(\frac{1}{1-z}-1)</annotation></semantics></math> is the inverse of the sigmoid function
</div>
<div id="algorithm2.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.7.1" class="ltx_text ltx_font_bold">6</span></span>
          <math id="algorithm2.m31" class="ltx_Math" alttext="\lambda_{k+1}\leftarrow\textup{Proj}_{[0,2\rho]}(\lambda_{k}+\eta\tilde{c}_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mtext>Proj</mtext><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{k+1}\leftarrow\textup{Proj}_{[0,2\rho]}(\lambda_{k}+\eta\tilde{c}_{k})</annotation></semantics></math>, where <math id="algorithm2.m32" class="ltx_Math" alttext="\eta:=\frac{\lambda_{1}}{C_{\max}\sqrt{K}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>:=</mo><mfrac><msub><mi>λ</mi><mn>1</mn></msub><mrow><msub><mi>C</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>K</mi></msqrt></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta:=\frac{\lambda_{1}}{C_{\max}\sqrt{K}}</annotation></semantics></math>
</div>
<div id="algorithm2.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.8.1" class="ltx_text ltx_font_bold">7</span></span>
          For <math id="algorithm2.m33" class="ltx_Math" alttext="i=1,\dots,N^{\textup{on}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>N</mi><mtext>on</mtext></msup></mrow><annotation encoding="application/x-tex">i=1,\dots,N^{\textup{on}}</annotation></semantics></math>, sample <math id="algorithm2.m34" class="ltx_Math" alttext="x_{i}\sim\mathcal{D}^{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">x_{i}\sim\mathcal{D}^{p}</annotation></semantics></math>, <math id="algorithm2.m35" class="ltx_math_unparsed" alttext="y_{i}\sim\pi_{k}(\cdot|x_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>∼</mo><msub><mi>π</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y_{i}\sim\pi_{k}(\cdot|x_{i})</annotation></semantics></math>, <math id="algorithm2.m36" class="ltx_math_unparsed" alttext="y^{\prime}_{i}\sim\pi^{\textup{base}}(\cdot|x_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>y</mi><mi>i</mi><mo>′</mo></msubsup><mo>∼</mo><msup><mi>π</mi><mtext>base</mtext></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y^{\prime}_{i}\sim\pi^{\textup{base}}(\cdot|x_{i})</annotation></semantics></math>. Collect reward and cost preference feedback on <math id="algorithm2.m37" class="ltx_Math" alttext="\{(x_{i},y_{i},y^{\prime}_{i})\}_{i=1}^{N^{\textup{on}}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>N</mi><mtext>on</mtext></msup></msubsup><annotation encoding="application/x-tex">\{(x_{i},y_{i},y^{\prime}_{i})\}_{i=1}^{N^{\textup{on}}}</annotation></semantics></math>, and obtain preference data <math id="algorithm2.m38" class="ltx_Math" alttext="\{(x_{i},y^{rw}_{i},y^{r\ell}_{i})\}_{i=1}^{N^{\textup{on}}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>N</mi><mtext>on</mtext></msup></msubsup><annotation encoding="application/x-tex">\{(x_{i},y^{rw}_{i},y^{r\ell}_{i})\}_{i=1}^{N^{\textup{on}}}</annotation></semantics></math> and <math id="algorithm2.m39" class="ltx_Math" alttext="\{(x_{i},y^{cw}_{i},y^{c\ell}_{i})\}_{i=1}^{N^{\textup{on}}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>N</mi><mtext>on</mtext></msup></msubsup><annotation encoding="application/x-tex">\{(x_{i},y^{cw}_{i},y^{c\ell}_{i})\}_{i=1}^{N^{\textup{on}}}</annotation></semantics></math> 
</div>
<div id="algorithm2.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.9.1" class="ltx_text ltx_font_bold">8</span></span>
          <math id="algorithm2.m40" class="ltx_Math" alttext="\mathcal{D}^{r}_{k+1}\leftarrow\mathcal{D}^{r}_{k}\cup\{(x_{i},y^{rw}_{i},y^{r\ell}_{i})\}_{i=1}^{N^{\textup{on}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mo stretchy="false">←</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup><mo>∪</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>N</mi><mtext>on</mtext></msup></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}^{r}_{k+1}\leftarrow\mathcal{D}^{r}_{k}\cup\{(x_{i},y^{rw}_{i},y^{r\ell}_{i})\}_{i=1}^{N^{\textup{on}}}</annotation></semantics></math>, <math id="algorithm2.m41" class="ltx_Math" alttext="\mathcal{D}^{c}_{k+1}\leftarrow\mathcal{D}^{c}_{k}\cup\{(x_{i},y^{cw}_{i},y^{c\ell}_{i})\}_{i=1}^{N^{\textup{on}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>c</mi></msubsup><mo stretchy="false">←</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>c</mi></msubsup><mo>∪</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>i</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>N</mi><mtext>on</mtext></msup></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}^{c}_{k+1}\leftarrow\mathcal{D}^{c}_{k}\cup\{(x_{i},y^{cw}_{i},y^{c\ell}_{i})\}_{i=1}^{N^{\textup{on}}}</annotation></semantics></math> 

</div>
<div id="algorithm2.4.10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.10.1" class="ltx_text ltx_font_bold">9</span></span>
          <span id="algorithm2.4.10.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm2.m42" class="ltx_Math" alttext="\pi^{\textup{out}}_{K}:=\textup{unif}(\pi_{1},\dots,\pi_{K})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>K</mi><mtext>out</mtext></msubsup><mo>:=</mo><mrow><mtext>unif</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>π</mi><mi>K</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\textup{out}}_{K}:=\textup{unif}(\pi_{1},\dots,\pi_{K})</annotation></semantics></math>

</div>
</div>
</figure>
<div id="A4.p3" class="ltx_para">
<p id="A4.p3.1" class="ltx_p">We take <math id="A4.p3.m1" class="ltx_Math" alttext="b^{r}_{k}(x,y^{rw})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">b^{r}_{k}(x,y^{rw})</annotation></semantics></math> in Eq. (<a href="#A4.E29" title='In 3 ‣ 2 ‣ Appendix D Pseudo-code and Detailed Description of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) as an example to explain the <em id="A4.p3.1.1" class="ltx_emph ltx_font_italic">intuition behind why including exploration bonuses <math id="A4.p3.m2" class="ltx_Math" alttext="b^{\diamond}_{k}" display="inline" intent=":literal"><semantics><msubsup><mi>b</mi><mi>k</mi><mo>⋄</mo></msubsup><annotation encoding="application/x-tex">b^{\diamond}_{k}</annotation></semantics></math> effectively encourages exploration</em>:
When preference data do not cover <math id="A4.p3.m3" class="ltx_Math" alttext="(x,y^{rw})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x,y^{rw})</annotation></semantics></math> well, <math id="A4.p3.m4" class="ltx_Math" alttext="b^{r}(x,y^{rw})" display="inline" intent=":literal"><semantics><mrow><msup><mi>b</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">b^{r}(x,y^{rw})</annotation></semantics></math> will be large. Then, subtracting a large value from <math id="A4.p3.m5" class="ltx_Math" alttext="\beta\log\frac{\pi(y^{rw}|x)}{\pi_{\textup{ref}}(y^{rw}|x)}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\beta\log\frac{\pi(y^{rw}|x)}{\pi_{\textup{ref}}(y^{rw}|x)}</annotation></semantics></math> encourages <math id="A4.p3.m6" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> to put a higher probability on <math id="A4.p3.m7" class="ltx_Math" alttext="y^{rw}" display="inline" intent=":literal"><semantics><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><annotation encoding="application/x-tex">y^{rw}</annotation></semantics></math> to maintain the original value of <math id="A4.p3.m8" class="ltx_Math" alttext="\beta\log\frac{\pi(y^{rw}|x)}{\pi_{\textup{ref}}(y^{rw}|x)}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\beta\log\frac{\pi(y^{rw}|x)}{\pi_{\textup{ref}}(y^{rw}|x)}</annotation></semantics></math> which achieves the optimal value of the MLE training objective.
By incorporating exploration bonuses in the training objective, the trained model <math id="A4.p3.m9" class="ltx_Math" alttext="\pi_{k}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\pi_{k}</annotation></semantics></math> has incentive to explore uncovered prompt-response space.</p>
</div>
<div id="A4.p4" class="ltx_para">
<p id="A4.p4.1" class="ltx_p">In addition, the constrained policy search ranges in Lines <a href="#A4.EGx72" title='In 2 ‣ Appendix D Pseudo-code and Detailed Description of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#A4.EGx73" title='In 2 ‣ Appendix D Pseudo-code and Detailed Description of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> also incorporate exploration bonuses, which are defined as</p>
<table id="A4.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E31.m1" class="ltx_Math" alttext="\displaystyle\tilde{\Pi}^{r}_{k}:=\left\{\pi(y|x)=\frac{\pi_{\textup{ref}}(y|x)\cdot\exp\left(\frac{1}{\beta}\left(r(x,y)+b^{r}_{k}(x,y)\right)\right)}{\sum_{y^{\prime}\in\mathcal{Y}}\pi_{\textup{ref}}(y^{\prime}|x)\cdot\exp\left(\frac{1}{\beta}\left(r(x,y^{\prime})+b^{r}_{k}(x,y^{\prime})\right)\right)}:r\in\mathcal{R}\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Π</mi><mo>~</mo></mover><mi>k</mi><mi>r</mi></msubsup><mo>:=</mo><mrow><mo>{</mo><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mrow><msub><mo>∑</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>r</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><mo>}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\Pi}^{r}_{k}:=\left\{\pi(y|x)=\frac{\pi_{\textup{ref}}(y|x)\cdot\exp\left(\frac{1}{\beta}\left(r(x,y)+b^{r}_{k}(x,y)\right)\right)}{\sum_{y^{\prime}\in\mathcal{Y}}\pi_{\textup{ref}}(y^{\prime}|x)\cdot\exp\left(\frac{1}{\beta}\left(r(x,y^{\prime})+b^{r}_{k}(x,y^{\prime})\right)\right)}:r\in\mathcal{R}\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A4.p4.2" class="ltx_p">and</p>
<table id="A4.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex110.m1" class="ltx_math_unparsed" alttext="\displaystyle\tilde{\Pi}^{c}_{k}\!:=\!\Bigg\{" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Π</mi><mo>~</mo></mover><mi>k</mi><mi>c</mi></msubsup><mo lspace="0.108em" rspace="0.108em">:=</mo><mo stretchy="false">{</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\Pi}^{c}_{k}\!:=\!\Bigg\{</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex110.m2" class="ltx_Math" alttext="\displaystyle\pi(y|x)\!=\!\frac{\pi_{\textup{ref}}(y|x)\cdot\exp\left(\frac{1}{\beta}\left(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y|x)}{\pi_{\textup{ref}}(y|x)}-\lambda_{k}\left(c(x,y)-b^{c}_{k}(x,y)\right)\right)\right)}{\sum_{y^{\prime}\in\mathcal{Y}}\pi_{\textup{ref}}(y^{\prime}|x)\cdot\exp\left(\frac{1}{\beta}\left(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{\prime}|x)}{\pi_{\textup{ref}}(y^{\prime}|x)}-\lambda_{k}\left(c(x,y^{\prime})-b^{c}_{k}(x,y^{\prime})\right)\right)\right)}\!:" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.108em">=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mrow><msub><mo>∑</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0.108em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\pi(y|x)\!=\!\frac{\pi_{\textup{ref}}(y|x)\cdot\exp\left(\frac{1}{\beta}\left(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y|x)}{\pi_{\textup{ref}}(y|x)}-\lambda_{k}\left(c(x,y)-b^{c}_{k}(x,y)\right)\right)\right)}{\sum_{y^{\prime}\in\mathcal{Y}}\pi_{\textup{ref}}(y^{\prime}|x)\cdot\exp\left(\frac{1}{\beta}\left(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{\prime}|x)}{\pi_{\textup{ref}}(y^{\prime}|x)}-\lambda_{k}\left(c(x,y^{\prime})-b^{c}_{k}(x,y^{\prime})\right)\right)\right)}\!:</annotation></semantics></math></td>
