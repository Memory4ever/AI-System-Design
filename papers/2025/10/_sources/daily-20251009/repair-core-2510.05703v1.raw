<p id="A5.SS1.SSS0.Px1.p11.3" class="ltx_p"><span id="A5.SS1.SSS0.Px1.p11.3.1" class="ltx_text">We have that <math id="A5.SS1.SSS0.Px1.p11.m3" class="ltx_Math" alttext="c_{k}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>k</mi></msub><annotation encoding="application/x-tex">c_{k}</annotation></semantics></math> achieves the optimal value in Eq. (<a href="#A5.E39" title='In Step (ii). ‣ E.1 Connection between our DPO-based Procedure and the RLHF-based Procedure with Exploration Bonuses ‣ Appendix E Proofs for Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>),</span></p>
<table id="A5.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex138.m1" class="ltx_math_unparsed" alttext="\displaystyle-\sum_{(x,y^{cw},y^{c\ell})\in\mathcal{D}^{c}}\log\sigma\Bigg(\frac{1}{\lambda_{k}}\bigg(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{cw}|x)}{\pi_{\textup{ref}}(y^{cw}|x)}-\beta\log\frac{\pi_{k}(y^{cw}|x)}{\pi_{\textup{ref}}(y^{cw}|x)}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo>,</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>c</mi></msup></mrow></munder></mstyle><mi>log</mi><mi>σ</mi><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>λ</mi><mi>k</mi></msub></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>β</mi><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mi>β</mi><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\sum_{(x,y^{cw},y^{c\ell})\in\mathcal{D}^{c}}\log\sigma\Bigg(\frac{1}{\lambda_{k}}\bigg(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{cw}|x)}{\pi_{\textup{ref}}(y^{cw}|x)}-\beta\log\frac{\pi_{k}(y^{cw}|x)}{\pi_{\textup{ref}}(y^{cw}|x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex139.m1" class="ltx_Math" alttext="\displaystyle-\!\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\bigg)\!+\!b^{c}_{k}(x,y^{cw})\!-\!\frac{1}{\lambda_{k}}\bigg(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{c\ell}|x)}{\pi_{\textup{ref}}(y^{c\ell}|x)}\!-\!\beta\log\frac{\pi_{k}(y^{c\ell}|x)}{\pi_{\textup{ref}}(y^{c\ell}|x)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>Z</mi><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><msub><mi>π</mi><mtext>ref</mtext></msub></mfrac></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0.052em" rspace="0.052em">+</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0.052em" rspace="0.052em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>λ</mi><mi>k</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0.052em" rspace="0.052em">−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\!\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\bigg)\!+\!b^{c}_{k}(x,y^{cw})\!-\!\frac{1}{\lambda_{k}}\bigg(\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y^{c\ell}|x)}{\pi_{\textup{ref}}(y^{c\ell}|x)}\!-\!\beta\log\frac{\pi_{k}(y^{c\ell}|x)}{\pi_{\textup{ref}}(y^{c\ell}|x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E42.m1" class="ltx_Math" alttext="\displaystyle-\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\bigg)-b^{c}_{k}(x,y^{c\ell})\Bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo fence="true" lspace="0em" rspace="0em">OPEN</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><msub><mi>π</mi><mtext>ref</mtext></msub></mfrac></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo>−</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\bigg)-b^{c}_{k}(x,y^{c\ell})\Bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="A5.SS1.SSS0.Px1.p11.4" class="ltx_p"><span id="A5.SS1.SSS0.Px1.p11.4.1" class="ltx_text">Otherwise, there exists another <math id="A5.SS1.SSS0.Px1.p11.m4" class="ltx_Math" alttext="c^{\prime}\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">c^{\prime}\in\mathcal{C}</annotation></semantics></math> and then there exists a <math id="A5.SS1.SSS0.Px1.p11.m5" class="ltx_Math" alttext="\pi^{\prime}=\pi^{*}_{\hat{r}_{k}+b^{r}_{k}-\lambda_{k}(c^{\prime}-b^{r}_{k})}\in\tilde{\Pi}^{c}_{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>′</mo></msup><mo>=</mo><msubsup><mi>π</mi><mrow><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∗</mo></msubsup><mo>∈</mo><msubsup><mover accent="true"><mi mathvariant="normal">Π</mi><mo>~</mo></mover><mi>k</mi><mi>c</mi></msubsup></mrow><annotation encoding="application/x-tex">\pi^{\prime}=\pi^{*}_{\hat{r}_{k}+b^{r}_{k}-\lambda_{k}(c^{\prime}-b^{r}_{k})}\in\tilde{\Pi}^{c}_{k}</annotation></semantics></math> which gives a smaller objective value than <math id="A5.SS1.SSS0.Px1.p11.m6" class="ltx_Math" alttext="\tilde{\pi}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>π</mi><mo>~</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\tilde{\pi}_{k}</annotation></semantics></math> in Eq. (<a href="#A5.E42" title='In Proof. ‣ Step (ii). ‣ E.1 Connection between our DPO-based Procedure and the RLHF-based Procedure with Exploration Bonuses ‣ Appendix E Proofs for Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>).
Thus, <math id="A5.SS1.SSS0.Px1.p11.m7" class="ltx_Math" alttext="c_{k}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>k</mi></msub><annotation encoding="application/x-tex">c_{k}</annotation></semantics></math> achieves the optimal value in Eq. (<a href="#A5.E39" title='In Step (ii). ‣ E.1 Connection between our DPO-based Procedure and the RLHF-based Procedure with Exploration Bonuses ‣ Appendix E Proofs for Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>). Then, the optimal solution to Eq. (<a href="#A5.E39" title='In Step (ii). ‣ E.1 Connection between our DPO-based Procedure and the RLHF-based Procedure with Exploration Bonuses ‣ Appendix E Proofs for Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>) under cost model <math id="A5.SS1.SSS0.Px1.p11.m8" class="ltx_Math" alttext="c_{k}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>k</mi></msub><annotation encoding="application/x-tex">c_{k}</annotation></semantics></math> is</span></p>
<table id="A5.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex140.m1" class="ltx_Math" alttext="\displaystyle\pi(y|x)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi(y|x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex140.m2" class="ltx_Math" alttext="\displaystyle\propto\pi_{\textup{ref}}(y|x)\cdot\exp\Bigg(\frac{1}{\beta}\bigg(\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y|x)}{\pi_{\textup{ref}}(y|x)}+\beta\log\frac{\pi_{k}(y|x)}{\pi_{\textup{ref}}(y|x)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∝</mo><mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\pi_{\textup{ref}}(y|x)\cdot\exp\Bigg(\frac{1}{\beta}\bigg(\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}(y|x)}{\pi_{\textup{ref}}(y|x)}+\beta\log\frac{\pi_{k}(y|x)}{\pi_{\textup{ref}}(y|x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex141.m1" class="ltx_Math" alttext="\displaystyle\quad+\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\bigg)\Bigg)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo fence="true" lspace="0em" rspace="0em">OPEN</mo><mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><msub><mi>π</mi><mtext>ref</mtext></msub></mfrac></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\bigg)\Bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex142.m1" class="ltx_Math" alttext="\displaystyle\overset{\textup{(a)}}{\propto}\pi_{\textup{ref}}(y|x)\cdot\exp\Bigg(\frac{1}{\beta}\bigg(\beta\log Z_{\hat{r}_{k}+b^{r}_{k}}(x)+\beta\log\frac{\pi_{k}(y|x)}{\pi_{\textup{ref}}(y|x)}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>∝</mo><mtext mathsize="0.700em">(a)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\textup{(a)}}{\propto}\pi_{\textup{ref}}(y|x)\cdot\exp\Bigg(\frac{1}{\beta}\bigg(\beta\log Z_{\hat{r}_{k}+b^{r}_{k}}(x)+\beta\log\frac{\pi_{k}(y|x)}{\pi_{\textup{ref}}(y|x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex143.m1" class="ltx_Math" alttext="\displaystyle\quad+\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\bigg)\Bigg)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo fence="true" lspace="0em" rspace="0em">OPEN</mo><mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><mrow><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msubsup><mi>π</mi><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo>∗</mo></msubsup><msub><mi>π</mi><mtext>ref</mtext></msub></mfrac></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\beta\log Z_{\beta\log\frac{\pi^{*}_{\hat{r}_{k}+b^{r}_{k}}}{\pi_{\textup{ref}}}-\lambda_{k}(c_{k}-b^{c}_{k})}(x)\bigg)\Bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex144.m1" class="ltx_Math" alttext="\displaystyle\propto\pi_{\textup{ref}}(y|x)\cdot\exp\left(\frac{1}{\beta}\left(\beta\log\frac{\pi_{k}(y|x)}{\pi_{\textup{ref}}(y|x)}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∝</mo><mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\pi_{\textup{ref}}(y|x)\cdot\exp\left(\frac{1}{\beta}\left(\beta\log\frac{\pi_{k}(y|x)}{\pi_{\textup{ref}}(y|x)}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex145.m1" class="ltx_Math" alttext="\displaystyle=\pi_{k}(y|x)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>π</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\pi_{k}(y|x),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.SSS0.Px1.p11.5" class="ltx_p"><span id="A5.SS1.SSS0.Px1.p11.5.1" class="ltx_text">where (a) uses a similar derivation as Eq. (<a href="#S3.E5" title="In 3 Preliminaries ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>).</span></p>
</div>
<div id="A5.SS1.SSS0.Px1.p12" class="ltx_para">
<p id="A5.SS1.SSS0.Px1.p12.1" class="ltx_p"><span id="A5.SS1.SSS0.Px1.p12.1.1" class="ltx_text">Therefore, <math id="A5.SS1.SSS0.Px1.p12.m1" class="ltx_Math" alttext="\pi_{k}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\pi_{k}</annotation></semantics></math> is also an optimal solution to Eq. (<a href="#A3.E23" title='In Theorem 4 (Connection between Our Rearranged Lagrangian DPO and Safe RLHF). ‣ Step (ii). ‣ C.1 Connection between Our DPO-based Procedure and the RLHF-based Procedure ‣ Appendix C Proofs for Algorithm 𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>).
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Suboptimality and Constraint Violation</h3>

<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.1" class="ltx_p">In the following, we present the proof of the suboptimality and constraint violation guarantees for algorithm <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="\mathtt{O\mbox{-}PD\mbox{-}DPO}" display="inline" intent=":literal"><semantics><mrow><mi>𝙾</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙿𝙳</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝙳𝙿𝙾</mi></mrow><annotation encoding="application/x-tex">\mathtt{O\mbox{-}PD\mbox{-}DPO}</annotation></semantics></math> (Theorem <a href="#Thmtheorem2" title='Theorem 2 (Result of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾). ‣ 5 Exploratory Primal-Dual DPO with Exploration Bonuses ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>).</p>
</div>
<div id="A5.SS2.p2" class="ltx_para">
<p id="A5.SS2.p2.1" class="ltx_p">Define event</p>
<table id="A5.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex146.m1" class="ltx_Math" alttext="\displaystyle\mathcal{G}^{\textup{on}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mtext>on</mtext></msup><annotation encoding="application/x-tex">\displaystyle\mathcal{G}^{\textup{on}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex146.m2" class="ltx_math_unparsed" alttext="\displaystyle:=\Bigg\{|\hat{r}_{k}(x,y)-r^{*}(x,y)|\leq 4\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\cdot" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><mrow><mo stretchy="false">{</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mn>4</mn><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>⋅</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\Bigg\{|\hat{r}_{k}(x,y)-r^{*}(x,y)|\leq 4\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex147.m1" class="ltx_Math" alttext="\displaystyle\sqrt{\frac{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2K}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(R_{\max})^{2}}:=b^{r}_{k}(x,y)," display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>R</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msup><mi>δ</mi><mo>′</mo></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo>:=</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{\frac{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2K}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(R_{\max})^{2}}:=b^{r}_{k}(x,y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex148.m1" class="ltx_math_unparsed" alttext="\displaystyle|\hat{c}_{k}(x,y)-c^{*}(x,y)|\leq 4\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{c}_{k}}+\gamma^{\textup{on}}I)^{-1}}\cdot" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mn>4</mn><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>c</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\hat{c}_{k}(x,y)-c^{*}(x,y)|\leq 4\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{c}_{k}}+\gamma^{\textup{on}}I)^{-1}}\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex149.m1" class="ltx_Math" alttext="\displaystyle\sqrt{\frac{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2K}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(C_{\max})^{2}}:=b^{c}_{k}(x,y)," display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>C</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>C</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msup><mi>δ</mi><mo>′</mo></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo>:=</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{\frac{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2K}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(C_{\max})^{2}}:=b^{c}_{k}(x,y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex150.m1" class="ltx_math_unparsed" alttext="\displaystyle\forall(x,y)\in\mathcal{X}\times\mathcal{Y}\Bigg\}." display="inline" intent=":literal"><semantics><mrow><mo>∀</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\forall(x,y)\in\mathcal{X}\times\mathcal{Y}\Bigg\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.3" class="ltx_text ltx_font_bold"> </span>(MLE Guarantee with Online Data)<span id="Thmlemma5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para">
<p id="Thmlemma5.p1.1" class="ltx_p"><span id="Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">It holds that</span></p>
<table id="A5.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex151.m1" class="ltx_Math" alttext="\displaystyle\Pr\left[\mathcal{G}^{\textup{on}}\right]\geq 1-2\delta^{\prime}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mtext>on</mtext></msup><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>δ</mi><mo>′</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Pr\left[\mathcal{G}^{\textup{on}}\right]\geq 1-2\delta^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p3" class="ltx_para">
<p id="A5.SS2.p3.1" class="ltx_p"><span id="A5.SS2.p3.1.1" class="ltx_text">According to Lemma 3.1 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx40" title="" class="ltx_ref">Zhu et al.(2023)Zhu, Jordan, and Jiao</a>]</cite>, we have that with probability at least <math id="A5.SS2.p3.m1" class="ltx_Math" alttext="1-\delta^{\prime}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><msup><mi>δ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">1-\delta^{\prime}</annotation></semantics></math>,</span></p>
<table id="A5.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex152.m1" class="ltx_Math" alttext="\displaystyle\quad|\hat{r}_{k}(x,y)-r^{*}(x,y)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad|\hat{r}_{k}(x,y)-r^{*}(x,y)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex153.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 4\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}_{k}}+N^{\textup{on}}\gamma^{\textup{on}}I)^{-1}}\cdot" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>4</mn><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>N</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4\left\|\phi(x,y)\right\|_{(\Sigma_{\mathcal{D}^{r}_{k}}+N^{\textup{on}}\gamma^{\textup{on}}I)^{-1}}\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex154.m1" class="ltx_Math" alttext="\displaystyle\quad\sqrt{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2}{\delta^{\prime}}\right)\right)+N^{\textup{on}}\gamma^{\textup{on}}(R_{\max})^{2}}" display="inline" intent=":literal"><semantics><msqrt><mrow><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>R</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mi>δ</mi><mo>′</mo></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>N</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><annotation encoding="application/x-tex">\displaystyle\quad\sqrt{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2}{\delta^{\prime}}\right)\right)+N^{\textup{on}}\gamma^{\textup{on}}(R_{\max})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex155.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{4}{\sqrt{N^{\textup{on}}}}\left\|\phi(x,y)\right\|_{(\frac{1}{N^{\textup{on}}}\Sigma_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\cdot" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>4</mn><msqrt><msup><mi>N</mi><mtext>on</mtext></msup></msqrt></mfrac></mstyle><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>N</mi><mtext>on</mtext></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{4}{\sqrt{N^{\textup{on}}}}\left\|\phi(x,y)\right\|_{(\frac{1}{N^{\textup{on}}}\Sigma_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex156.m1" class="ltx_Math" alttext="\displaystyle\quad\sqrt{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2}{\delta^{\prime}}\right)\right)+N^{\textup{on}}\gamma^{\textup{on}}(R_{\max})^{2}}" display="inline" intent=":literal"><semantics><msqrt><mrow><mrow><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>R</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mi>δ</mi><mo>′</mo></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>N</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><annotation encoding="application/x-tex">\displaystyle\quad\sqrt{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2}{\delta^{\prime}}\right)\right)+N^{\textup{on}}\gamma^{\textup{on}}(R_{\max})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex157.m1" class="ltx_math_unparsed" alttext="\displaystyle=4\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\cdot" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>4</mn><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle=4\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex158.m1" class="ltx_Math" alttext="\displaystyle\quad\sqrt{\frac{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(R_{\max})^{2}}." display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>R</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mi>δ</mi><mo>′</mo></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\sqrt{\frac{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(R_{\max})^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p3.2" class="ltx_p"><span id="A5.SS2.p3.2.1" class="ltx_text">Taking a union bound over <math id="A5.SS2.p3.m2" class="ltx_Math" alttext="k=1,\dots,K" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">k=1,\dots,K</annotation></semantics></math>, we can obtain the first statement.</span></p>
</div>
<div id="A5.SS2.p4" class="ltx_para">
<p id="A5.SS2.p4.1" class="ltx_p"><span id="A5.SS2.p4.1.1" class="ltx_text">Using a similar argument, we can obtain the second statement.
∎</span></p>
</div>
</div>
<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para">
<p id="Thmlemma6.p1.1" class="ltx_p"><span id="Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx99" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex159.m1" class="ltx_math_unparsed" alttext="\displaystyle f(\pi^{*};\hat{r}_{k}+b^{r}_{k})-f(\pi_{k};\hat{r}_{k}+b^{r}_{k})\leq-\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)]." display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo>;</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mo>;</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f(\pi^{*};\hat{r}_{k}+b^{r}_{k})-f(\pi_{k};\hat{r}_{k}+b^{r}_{k})\leq-\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p5" class="ltx_para">
<p id="A5.SS2.p5.1" class="ltx_p"><span id="A5.SS2.p5.1.1" class="ltx_text">It holds that</span></p>
<table id="A5.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex160.m1" class="ltx_Math" alttext="\displaystyle\quad f(\pi^{*};\hat{r}_{k}+b^{r}_{k})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo>,</mo><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad f(\pi^{*};\hat{r}_{k}+b^{r}_{k})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex161"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex161.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{\textup{(a)}}{\leq}f(\pi^{*};\hat{r}_{k}+b^{r}_{k})-\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[c^{*}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(a)</mtext></mover><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo>;</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\textup{(a)}}{\leq}f(\pi^{*};\hat{r}_{k}+b^{r}_{k})-\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[c^{*}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex162.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{x\sim\mathcal{D}^{p}}\left[\mathbb{E}_{y\sim\pi^{*}(\cdot|x)}\left[\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\lambda_{k}\cdot c^{*}(x,y)\right]-\beta\cdot\textup{KL}(\pi^{*}(\cdot|x)\|\pi_{\textup{ref}}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msup></mrow></msub><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>KL</mtext><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mtext>ref</mtext></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x\sim\mathcal{D}^{p}}\left[\mathbb{E}_{y\sim\pi^{*}(\cdot|x)}\left[\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\lambda_{k}\cdot c^{*}(x,y)\right]-\beta\cdot\textup{KL}(\pi^{*}(\cdot|x)\|\pi_{\textup{ref}}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex163.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{x\sim\mathcal{D}^{p}}\Big[\mathbb{E}_{y\sim\pi^{*}(\cdot|x)}\left[\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\lambda_{k}\left(\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msup></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>λ</mi><mi>k</mi></msub><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x\sim\mathcal{D}^{p}}\Big[\mathbb{E}_{y\sim\pi^{*}(\cdot|x)}\left[\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\lambda_{k}\left(\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex164"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex164.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\beta\cdot\textup{KL}(\pi^{*}(\cdot|x)\|\pi_{\textup{ref}}(\cdot|x))\Big]+\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)-c^{*}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>KL</mtext><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mtext>ref</mtext></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo><mo>+</mo><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">[</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\beta\cdot\textup{KL}(\pi^{*}(\cdot|x)\|\pi_{\textup{ref}}(\cdot|x))\Big]+\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)-c^{*}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex165.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{\textup{(b)}}{\leq}\mathbb{E}_{x\sim\mathcal{D}^{p}}\Big[\mathbb{E}_{y\sim\pi_{k}(\cdot|x)}\left[\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\lambda_{k}\left(\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(b)</mtext></mover><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msup></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>λ</mi><mi>k</mi></msub><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\textup{(b)}}{\leq}\mathbb{E}_{x\sim\mathcal{D}^{p}}\Big[\mathbb{E}_{y\sim\pi_{k}(\cdot|x)}\left[\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\lambda_{k}\left(\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex166.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\beta\cdot\textup{KL}(\pi_{k}(\cdot|x)\|\pi_{\textup{ref}}(\cdot|x))\Big]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>KL</mtext><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mtext>ref</mtext></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\beta\cdot\textup{KL}(\pi_{k}(\cdot|x)\|\pi_{\textup{ref}}(\cdot|x))\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex167.m1" class="ltx_math_unparsed" alttext="\displaystyle=f(\pi_{k};\hat{r}_{k}+b^{r}_{k})-\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)]," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mo>;</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=f(\pi_{k};\hat{r}_{k}+b^{r}_{k})-\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p5.2" class="ltx_p"><span id="A5.SS2.p5.2.1" class="ltx_text">where inequality (a) uses the fact that <math id="A5.SS2.p5.m1" class="ltx_Math" alttext="\lambda_{k}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{k}\geq 0</annotation></semantics></math> and <math id="A5.SS2.p5.m2" class="ltx_Math" alttext="\pi^{*}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\pi^{*}</annotation></semantics></math> is feasible, and inequality (b) comes from Theorem <a href="#Thmtheorem6" title='Theorem 6 (Connection between Our Rearranged Lagrangian DPO and Safe RLHF with Constrained Policy Ranges and Exploration Bonuses). ‣ Step (ii). ‣ E.1 Connection between our DPO-based Procedure and the RLHF-based Procedure with Exploration Bonuses ‣ Appendix E Proofs for Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.
∎</span></p>
</div>
</div>
<div id="A5.SS2.p6" class="ltx_para">
<p id="A5.SS2.p6.1" class="ltx_p">Let</p>
<table id="A5.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex168"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex168.m1" class="ltx_Math" alttext="\displaystyle\bar{\Sigma}_{\mathcal{D}^{r}_{k}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><annotation encoding="application/x-tex">\displaystyle\bar{\Sigma}_{\mathcal{D}^{r}_{k}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex168.m2" class="ltx_math_unparsed" alttext="\displaystyle:=\Sigma_{\mathcal{D}^{r}_{1}}+\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\left(\phi(x,y)-\phi(x,y^{\prime})\right)\left(\phi(x,y)-\phi(x,y^{\prime})\right)^{\top}\right]," display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><msub><mi mathvariant="normal">Σ</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup></msub><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>base</mtext></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mrow><mo>(</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><msup><mrow><mo>(</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\Sigma_{\mathcal{D}^{r}_{1}}+\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\left(\phi(x,y)-\phi(x,y^{\prime})\right)\left(\phi(x,y)-\phi(x,y^{\prime})\right)^{\top}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex169"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex169.m1" class="ltx_Math" alttext="\displaystyle\bar{\Sigma}_{\mathcal{D}^{c}_{k}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>c</mi></msubsup></msub><annotation encoding="application/x-tex">\displaystyle\bar{\Sigma}_{\mathcal{D}^{c}_{k}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex169.m2" class="ltx_math_unparsed" alttext="\displaystyle:=\Sigma_{\mathcal{D}^{c}_{1}}+\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\left(\phi(x,y)-\phi(x,y^{\prime})\right)\left(\phi(x,y)-\phi(x,y^{\prime})\right)^{\top}\right]." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><msub><mi mathvariant="normal">Σ</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>c</mi></msubsup></msub><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>base</mtext></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mrow><mo>(</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><msup><mrow><mo>(</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\Sigma_{\mathcal{D}^{c}_{1}}+\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\left(\phi(x,y)-\phi(x,y^{\prime})\right)\left(\phi(x,y)-\phi(x,y^{\prime})\right)^{\top}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmlemma7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma7.p1" class="ltx_para">
<p id="Thmlemma7.p1.1" class="ltx_p"><span id="Thmlemma7.p1.1.1" class="ltx_text ltx_font_italic">It holds that</span></p>
<table id="A5.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex170"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex170.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{r}_{k}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{r}_{k}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex171.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 4\sqrt{\frac{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2K}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(R_{\max})^{2}}\cdot" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>4</mn><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>R</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msup><mi>δ</mi><mo>′</mo></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo lspace="0.222em">⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4\sqrt{\frac{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2K}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(R_{\max})^{2}}\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex172.m1" class="ltx_Math" alttext="\displaystyle 2\sqrt{2|\mathcal{X}||\mathcal{Y}|K\left(\log\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{r}_{1}|+4K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+C^{\textup{base}}K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msup><mi>C</mi><mtext>base</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\sqrt{2|\mathcal{X}||\mathcal{Y}|K\left(\log\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{r}_{1}|+4K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+C^{\textup{base}}K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma7.p1.2" class="ltx_p"><span id="Thmlemma7.p1.2.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="A5.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex173"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex173.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex174.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 4\sqrt{\frac{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2K}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(C_{\max})^{2}}\cdot" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>4</mn><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>C</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>C</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><msup><mi>δ</mi><mo>′</mo></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo lspace="0.222em">⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4\sqrt{\frac{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{2K}{\delta^{\prime}}\right)\right)+\gamma^{\textup{on}}(C_{\max})^{2}}\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex175"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex175.m1" class="ltx_Math" alttext="\displaystyle 2\sqrt{2|\mathcal{X}||\mathcal{Y}|K\left(\log\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{c}_{1}|+4K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{c}_{1}|+C^{\textup{base}}K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>c</mi></msubsup><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>c</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msup><mi>C</mi><mtext>base</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\sqrt{2|\mathcal{X}||\mathcal{Y}|K\left(\log\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{c}_{1}|+4K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{c}_{1}|+C^{\textup{base}}K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)\right)}.</annotation></semantics></math></td>
