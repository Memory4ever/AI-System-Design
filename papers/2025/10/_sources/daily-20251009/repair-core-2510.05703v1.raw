<div id="A5.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p7" class="ltx_para">
<p id="A5.SS2.p7.1" class="ltx_p"><span id="A5.SS2.p7.1.1" class="ltx_text">First, we have</span></p>
<table id="A5.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex176.m1" class="ltx_Math" alttext="\displaystyle\bar{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bar{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex176.m2" class="ltx_Math" alttext="\displaystyle=\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex177.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\left(\phi(x,y)-\phi(x,y^{\prime})\right)\left(\phi(x,y)-\phi(x,y^{\prime})\right)^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>base</mtext></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mrow><mo>(</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><msup><mrow><mo>(</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x),y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\left[\left(\phi(x,y)-\phi(x,y^{\prime})\right)\left(\phi(x,y)-\phi(x,y^{\prime})\right)^{\top}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex178"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex178.m1" class="ltx_Math" alttext="\displaystyle\succeq\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I+C^{\textup{base}}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y^{\prime}\sim\pi^{\textup{base}}}\left[\phi(x,y^{\prime})\phi(x,y^{\prime})^{\top}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⪰</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>+</mo><mrow><msup><mi>C</mi><mtext>base</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>x</mi><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msup></mrow><mo>,</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∼</mo><msup><mi>π</mi><mtext>base</mtext></msup></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\succeq\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I+C^{\textup{base}}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y^{\prime}\sim\pi^{\textup{base}}}\left[\phi(x,y^{\prime})\phi(x,y^{\prime})^{\top}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p7.2" class="ltx_p"><span id="A5.SS2.p7.2.1" class="ltx_text">and thus</span></p>
<table id="A5.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex179.m1" class="ltx_Math" alttext="\displaystyle\left(\bar{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I\right)^{-1}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>¯</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\left(\bar{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex179.m2" class="ltx_Math" alttext="\displaystyle\preceq\left(\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I+C^{\textup{base}}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y^{\prime}\sim\pi^{\textup{base}}}\left[\phi(x,y^{\prime})\phi(x,y^{\prime})^{\top}\right]\right)^{-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>⪯</mo><msup><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>+</mo><mrow><msup><mi>C</mi><mtext>base</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>x</mi><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msup></mrow><mo>,</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∼</mo><msup><mi>π</mi><mtext>base</mtext></msup></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\preceq\left(\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I+C^{\textup{base}}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y^{\prime}\sim\pi^{\textup{base}}}\left[\phi(x,y^{\prime})\phi(x,y^{\prime})^{\top}\right]\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E43.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{C^{\textup{base}}}\left(\frac{1}{C^{\textup{base}}}\left(\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I\right)+\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y^{\prime}\sim\pi^{\textup{base}}}\left[\phi(x,y^{\prime})\phi(x,y^{\prime})^{\top}\right]\right)^{-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>x</mi><mo>∼</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msup></mrow><mo>,</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∼</mo><msup><mi>π</mi><mtext>base</mtext></msup></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{C^{\textup{base}}}\left(\frac{1}{C^{\textup{base}}}\left(\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I\right)+\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y^{\prime}\sim\pi^{\textup{base}}}\left[\phi(x,y^{\prime})\phi(x,y^{\prime})^{\top}\right]\right)^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p8" class="ltx_para">
<p id="A5.SS2.p8.1" class="ltx_p"><span id="A5.SS2.p8.1.1" class="ltx_text">For ease of notation, let <math id="A5.SS2.p8.m1" class="ltx_Math" alttext="d:=|\mathcal{X}||\mathcal{Y}|" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>:=</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d:=|\mathcal{X}||\mathcal{Y}|</annotation></semantics></math>.
Then, we have</span></p>
<table id="A5.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex180"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex180.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex181"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex181.m1" class="ltx_Math" alttext="\displaystyle\leq\sqrt{K\sum_{k=1}^{K}\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]\right)^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msqrt><mrow><mi>K</mi><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mo>(</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo>‖</mo><mi>ϕ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>‖</mo><msub><mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo><mo>)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{K\sum_{k=1}^{K}\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]\right)^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex182"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex182.m1" class="ltx_Math" alttext="\displaystyle\leq\sqrt{K\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|^{2}_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msqrt><mrow><mi>K</mi><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>K</mi></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo>‖</mo><mi>ϕ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><msub><mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi><mi>r</mi></msubsup></msub><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>]</mo></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{K\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}\left[\left\|\phi(x,y)\right\|^{2}_{(\tilde{\Sigma}_{\mathcal{D}^{r}_{k}}+\gamma^{\textup{on}}I)^{-1}}\right]}</annotation></semantics></math></td>
