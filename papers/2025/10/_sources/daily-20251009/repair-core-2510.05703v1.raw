<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex187.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{\textup{(b)}}{\leq}2\sqrt{K}\Bigg(2\log\left(\frac{\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{r}_{1}|+4K}{d}\right)^{d}}{(\gamma^{\textup{on}})^{d}}\right)+\frac{1}{C^{\textup{base}}}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\Bigg[" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(b)</mtext></mover><mn>2</mn><msqrt><mi>K</mi></msqrt><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mn>2</mn><mi>log</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mi>d</mi></mfrac><mo>)</mo></mrow><mi>d</mi></msup><msup><mrow><mo stretchy="false">(</mo><msup><mi>γ</mi><mtext>on</mtext></msup><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mfrac></mstyle><mo>)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>base</mtext></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">[</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\textup{(b)}}{\leq}2\sqrt{K}\Bigg(2\log\left(\frac{\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{r}_{1}|+4K}{d}\right)^{d}}{(\gamma^{\textup{on}})^{d}}\right)+\frac{1}{C^{\textup{base}}}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y^{\prime}\sim\pi^{\textup{base}}(\cdot|x)}\Bigg[</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex188.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\|\phi(x,y^{\prime})\|^{2}_{\left(\frac{1}{C^{\textup{base}}}\left(\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I\right)+\sum_{k^{\prime}=1}^{k-1}\mathbb{E}_{x\sim\mathcal{D}^{p},\tilde{y}\sim\pi^{\textup{base}}(\cdot|x)}\left[\phi(x,\tilde{y})\phi(x,\tilde{y})^{\top}\right]\right)^{-1}}\Bigg]\Bigg)^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><msup><mrow><mrow><mo rspace="0.167em">∥</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac><mo>(</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup></msub><mo>+</mo><mi>γ</mi><msup><mrow></mrow><mtext>on</mtext></msup><mi>I</mi><mo>)</mo><mo>+</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mover accent="true"><mi>y</mi><mo>~</mo></mover><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mtext>base</mtext></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>ϕ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mover accent="true"><mi>y</mi><mo>~</mo></mover><mo stretchy="false">)</mo><mi>ϕ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mover accent="true"><mi>y</mi><mo>~</mo></mover><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo>]</mo><mo>)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mn>2</mn></msubsup><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><annotation encoding="application/x-tex">\displaystyle\quad\|\phi(x,y^{\prime})\|^{2}_{\left(\frac{1}{C^{\textup{base}}}\left(\Sigma_{\mathcal{D}^{r}_{1}}+\gamma^{\textup{on}}I\right)+\sum_{k^{\prime}=1}^{k-1}\mathbb{E}_{x\sim\mathcal{D}^{p},\tilde{y}\sim\pi^{\textup{base}}(\cdot|x)}\left[\phi(x,\tilde{y})\phi(x,\tilde{y})^{\top}\right]\right)^{-1}}\Bigg]\Bigg)^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex189.m1" class="ltx_Math" alttext="\displaystyle\overset{\textup{(c)}}{\leq}2\sqrt{K}\sqrt{2d\log\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{r}_{1}|+4K}{d\gamma^{\textup{on}}}\right)+\frac{2}{C^{\textup{base}}}\log\left(\frac{\left(\frac{\frac{1}{C^{\textup{base}}}\left(\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|\right)+K}{d}\right)^{d}}{\left(\frac{\gamma^{\textup{on}}}{C^{\textup{base}}}\right)^{d}}\right)}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(c)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>K</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mfrac><mrow><mrow><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mi>K</mi></mrow><mi>d</mi></mfrac><mo>)</mo></mrow><mi>d</mi></msup><msup><mrow><mo>(</mo><mfrac><msup><mi>γ</mi><mtext>on</mtext></msup><msup><mi>C</mi><mtext>base</mtext></msup></mfrac><mo>)</mo></mrow><mi>d</mi></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\textup{(c)}}{\leq}2\sqrt{K}\sqrt{2d\log\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{r}_{1}|+4K}{d\gamma^{\textup{on}}}\right)+\frac{2}{C^{\textup{base}}}\log\left(\frac{\left(\frac{\frac{1}{C^{\textup{base}}}\left(\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|\right)+K}{d}\right)^{d}}{\left(\frac{\gamma^{\textup{on}}}{C^{\textup{base}}}\right)^{d}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex190.m1" class="ltx_Math" alttext="\displaystyle\leq 2\sqrt{2dK\left(\log\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{r}_{1}|+4K}{d\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+C^{\textup{base}}K}{d\gamma^{\textup{on}}}\right)\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msup><mi>C</mi><mtext>base</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sqrt{2dK\left(\log\left(\frac{\gamma^{\textup{on}}+4|\mathcal{D}^{r}_{1}|+4K}{d\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+C^{\textup{base}}K}{d\gamma^{\textup{on}}}\right)\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p8.2" class="ltx_p"><span id="A5.SS2.p8.2.1" class="ltx_text">where inequality (a) comes from Lemma <a href="#Thmlemma13" title="Lemma 13 (Lemma H.4 in []). ‣ Appendix F Technical Tools ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>, inequality (b) uses Lemma <a href="#Thmlemma11" title="Lemma 11. ‣ Appendix F Technical Tools ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a> and Eq. (<a href="#A5.E43" title='In Proof. ‣ E.2 Suboptimality and Constraint Violation ‣ Appendix E Proofs for Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>), and inequality (c) is due to Lemma <a href="#Thmlemma11" title="Lemma 11. ‣ Appendix F Technical Tools ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>.</span></p>
</div>
<div id="A5.SS2.p9" class="ltx_para">
<p id="A5.SS2.p9.1" class="ltx_p"><span id="A5.SS2.p9.1.1" class="ltx_text">Thus, we can obtain the first statement.</span></p>
</div>
<div id="A5.SS2.p10" class="ltx_para">
<p id="A5.SS2.p10.1" class="ltx_p"><span id="A5.SS2.p10.1.1" class="ltx_text">Using a similar analysis as above, we can further obtain the second statement.
∎</span></p>
</div>
</div>
<div id="A5.SS2.p11" class="ltx_para">
<p id="A5.SS2.p11.1" class="ltx_p">In the following, we prove Theorem <a href="#Thmtheorem2" title='Theorem 2 (Result of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾). ‣ 5 Exploratory Primal-Dual DPO with Exploration Bonuses ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<div id="A5.SS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmtheorem2" title='Theorem 2 (Result of Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾). ‣ 5 Exploratory Primal-Dual DPO with Exploration Bonuses ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</h6>
<div id="A5.SS2.p12" class="ltx_para">
<p id="A5.SS2.p12.1" class="ltx_p"><span id="A5.SS2.p12.1.1" class="ltx_text">For this online setting, we also use events <math id="A5.SS2.p12.m1" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> and <math id="A5.SS2.p12.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> defined in Eqs. (<a href="#A3.E26" title='In C.2 Cost Estimation for Lagrangian Multiplier Update ‣ Appendix C Proofs for Algorithm 𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) and (<a href="#A3.E27" title='In C.2 Cost Estimation for Lagrangian Multiplier Update ‣ Appendix C Proofs for Algorithm 𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>).</span></p>
</div>
<div id="A5.SS2.p13" class="ltx_para">
<p id="A5.SS2.p13.1" class="ltx_p"><span id="A5.SS2.p13.1.1" class="ltx_text">Let <math id="A5.SS2.p13.m1" class="ltx_Math" alttext="\delta^{\prime}:=\frac{\delta}{4}" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mo>′</mo></msup><mo>:=</mo><mfrac><mi>δ</mi><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\delta^{\prime}:=\frac{\delta}{4}</annotation></semantics></math>. Then, according to Lemmas <a href="#Thmlemma1" title='Lemma 1. ‣ C.2 Cost Estimation for Lagrangian Multiplier Update ‣ Appendix C Proofs for Algorithm 𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and <a href="#Thmlemma3" title='Lemma 3 (MLE Guarantee, Lemma 3.1 in []). ‣ C.3 Suboptimality and Constraint Violation ‣ Appendix C Proofs for Algorithm 𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we have <math id="A5.SS2.p13.m2" class="ltx_Math" alttext="\Pr[\mathcal{E}\cap\mathcal{F}\cap\mathcal{G}^{\textup{on}}]\geq 1-\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∩</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∩</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mtext>on</mtext></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">\Pr[\mathcal{E}\cap\mathcal{F}\cap\mathcal{G}^{\textup{on}}]\geq 1-\delta</annotation></semantics></math>. Now it suffices to prove this theorem assuming that event <math id="A5.SS2.p13.m3" class="ltx_Math" alttext="\mathcal{E}\cap\mathcal{F}\cap\mathcal{G}^{\textup{on}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∩</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∩</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mtext>on</mtext></msup></mrow><annotation encoding="application/x-tex">\mathcal{E}\cap\mathcal{F}\cap\mathcal{G}^{\textup{on}}</annotation></semantics></math> holds. In the following proof, we assume that event <math id="A5.SS2.p13.m4" class="ltx_Math" alttext="\mathcal{E}\cap\mathcal{F}\cap\mathcal{G}^{\textup{on}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∩</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>∩</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mtext>on</mtext></msup></mrow><annotation encoding="application/x-tex">\mathcal{E}\cap\mathcal{F}\cap\mathcal{G}^{\textup{on}}</annotation></semantics></math> holds.</span></p>
</div>
<div id="A5.SS2.p14" class="ltx_para">
<p id="A5.SS2.p14.1" class="ltx_p"><span id="A5.SS2.p14.1.1" class="ltx_text">For any <math id="A5.SS2.p14.m1" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math> and <math id="A5.SS2.p14.m2" class="ltx_Math" alttext="\bar{\lambda}\in[0,2\rho]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{\lambda}\in[0,2\rho]</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx107" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex191.m1" class="ltx_Math" alttext="\displaystyle\left(\lambda^{k+1}-\bar{\lambda}\right)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><msup><mi>λ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover></mrow><mo>)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\left(\lambda^{k+1}-\bar{\lambda}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex191.m2" class="ltx_Math" alttext="\displaystyle=\left(\textup{Proj}_{[0,2\rho]}\left(\lambda_{k}+\eta_{k}\tilde{c}_{k}\right)-\textup{Proj}_{[0,2\rho]}\left(\bar{\lambda}\right)\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo>(</mo><mrow><mrow><msub><mtext>Proj</mtext><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>+</mo><mrow><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mtext>Proj</mtext><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\textup{Proj}_{[0,2\rho]}\left(\lambda_{k}+\eta_{k}\tilde{c}_{k}\right)-\textup{Proj}_{[0,2\rho]}\left(\bar{\lambda}\right)\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex192"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex192.m1" class="ltx_Math" alttext="\displaystyle\overset{\textup{(a)}}{\leq}\left(\lambda_{k}+\eta_{k}\tilde{c}_{k}-\bar{\lambda}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(a)</mtext></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>+</mo><mrow><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub></mrow></mrow><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\textup{(a)}}{\leq}\left(\lambda_{k}+\eta_{k}\tilde{c}_{k}-\bar{\lambda}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex193.m1" class="ltx_Math" alttext="\displaystyle=\left(\lambda_{k}-\bar{\lambda}\right)^{2}+2\eta_{k}\tilde{c}_{k}\left(\lambda_{k}-\bar{\lambda}\right)+\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><msub><mi>η</mi><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\lambda_{k}-\bar{\lambda}\right)^{2}+2\eta_{k}\tilde{c}_{k}\left(\lambda_{k}-\bar{\lambda}\right)+\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p14.2" class="ltx_p"><span id="A5.SS2.p14.2.1" class="ltx_text">where inequality (a) uses the nonexpansivity of the projection to <math id="A5.SS2.p14.m3" class="ltx_Math" alttext="[0,2\rho]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,2\rho]</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p15" class="ltx_para">
<p id="A5.SS2.p15.1" class="ltx_p"><span id="A5.SS2.p15.1.1" class="ltx_text">Summing the above inequality over <math id="A5.SS2.p15.m1" class="ltx_Math" alttext="k=1,\dots,K" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">k=1,\dots,K</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx108" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex194.m1" class="ltx_math_unparsed" alttext="\displaystyle 0\leq\left(\lambda_{K+1}-\bar{\lambda}\right)^{2}\leq\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\sum_{k=1}^{K}2\eta_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\cdot\left(\lambda_{k}-\bar{\lambda}\right)" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msup><mrow><mo>(</mo><msub><mi>λ</mi><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup><mo>≤</mo><msup><mrow><mo>(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 0\leq\left(\lambda_{K+1}-\bar{\lambda}\right)^{2}\leq\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\sum_{k=1}^{K}2\eta_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\cdot\left(\lambda_{k}-\bar{\lambda}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex195.m1" class="ltx_math_unparsed" alttext="\displaystyle-\sum_{k=1}^{K}2\eta_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\cdot\left(\lambda_{k}-\bar{\lambda}\right)+\sum_{k=1}^{K}2\eta_{k}\tilde{c}_{k}\left(\lambda_{k}-\bar{\lambda}\right)+\sum_{k=1}^{K}\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msup><mrow><mo>(</mo><msub><mi>η</mi><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><msup><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\sum_{k=1}^{K}2\eta_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\cdot\left(\lambda_{k}-\bar{\lambda}\right)+\sum_{k=1}^{K}2\eta_{k}\tilde{c}_{k}\left(\lambda_{k}-\bar{\lambda}\right)+\sum_{k=1}^{K}\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p16" class="ltx_para">
<p id="A5.SS2.p16.1" class="ltx_p"><span id="A5.SS2.p16.1.1" class="ltx_text">Hence, we have</span></p>
<table id="A5.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex196"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex196.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{k=1}^{K}2\eta_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\cdot\bar{\lambda}-\sum_{k=1}^{K}2\eta_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)]\cdot\lambda_{k}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>λ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=1}^{K}2\eta_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\cdot\bar{\lambda}-\sum_{k=1}^{K}2\eta_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[\hat{c}_{k}(x,y)-b^{c}_{k}(x,y)]\cdot\lambda_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex197.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\sum_{k=1}^{K}\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2}+\sum_{k=1}^{K}2\eta_{k}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)-\hat{c}_{k}(x,y)+b^{c}_{k}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msup><mrow><mo>(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msup><mrow><mo>(</mo><msub><mi>η</mi><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><msup><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\sum_{k=1}^{K}\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2}+\sum_{k=1}^{K}2\eta_{k}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)-\hat{c}_{k}(x,y)+b^{c}_{k}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex198"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex198.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}2\eta_{k}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}2\eta_{k}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p17" class="ltx_para">
<p id="A5.SS2.p17.1" class="ltx_p"><span id="A5.SS2.p17.1.1" class="ltx_text">Using Lemma <a href="#Thmlemma6" title='Lemma 6. ‣ E.2 Suboptimality and Constraint Violation ‣ Appendix E Proofs for Algorithm 𝙾⁢"-"⁢𝙿𝙳⁢"-"⁢𝙳𝙿𝙾 ‣ Primal-Dual Direct Preference Optimizationfor Constrained LLM Alignment' class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we have</span></p>
<table id="A5.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex199"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex199.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\sum_{k=1}^{K}2\eta_{k}\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\cdot\bar{\lambda}+f(\pi^{*};\hat{r}_{k}+b^{r}_{k})-f(\pi_{k};\hat{r}_{k}+b^{r}_{k})\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><mrow><mo>(</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⋅</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>+</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo>;</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mo>;</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\sum_{k=1}^{K}2\eta_{k}\left(\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\cdot\bar{\lambda}+f(\pi^{*};\hat{r}_{k}+b^{r}_{k})-f(\pi_{k};\hat{r}_{k}+b^{r}_{k})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex200"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex200.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\sum_{k=1}^{K}\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2}+\sum_{k=1}^{K}2\eta_{k}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)-\hat{c}_{k}(x,y)+b^{c}_{k}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msup><mrow><mo>(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msup><mrow><mo>(</mo><msub><mi>η</mi><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><msup><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\sum_{k=1}^{K}\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2}+\sum_{k=1}^{K}2\eta_{k}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)-\hat{c}_{k}(x,y)+b^{c}_{k}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex201"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex201.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}2\eta_{k}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}2\eta_{k}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex202"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex202.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{\textup{(a)}}{\leq}\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\sum_{k=1}^{K}\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2}+4\sum_{k=1}^{K}\eta_{k}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>≤</mo><mtext mathsize="0.700em">(a)</mtext></mover><msup><mrow><mo>(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msup><mrow><mo>(</mo><msub><mi>η</mi><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><msup><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>4</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>η</mi><mi>k</mi></msub><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\textup{(a)}}{\leq}\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\sum_{k=1}^{K}\left(\eta_{k}\right)^{2}\left(\tilde{c}_{k}\right)^{2}+4\sum_{k=1}^{K}\eta_{k}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex203"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex203.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}2\eta_{k}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mn>2</mn><msub><mi>η</mi><mi>k</mi></msub><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}2\eta_{k}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p17.2" class="ltx_p"><span id="A5.SS2.p17.2.1" class="ltx_text">where inequality (a) uses the definition of event <math id="A5.SS2.p17.m1" class="ltx_Math" alttext="\mathcal{G}^{\textup{on}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mtext>on</mtext></msup><annotation encoding="application/x-tex">\mathcal{G}^{\textup{on}}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p18" class="ltx_para">
<p id="A5.SS2.p18.1" class="ltx_p"><span id="A5.SS2.p18.1.1" class="ltx_text">Recall that <math id="A5.SS2.p18.m1" class="ltx_Math" alttext="\eta_{k}=\eta" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>k</mi></msub><mo>=</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">\eta_{k}=\eta</annotation></semantics></math>. Then, we have</span></p>
<table id="A5.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex204"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex204.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi_{k})\right)+\bar{\lambda}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi_{k})\right)+\bar{\lambda}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex205"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex205.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{1}{2\eta}\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\frac{\eta}{2}\sum_{k=1}^{K}\left(\tilde{c}_{k}\right)^{2}+2\sum_{k=1}^{K}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle><msup><mrow><mo>(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msup><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{2\eta}\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\frac{\eta}{2}\sum_{k=1}^{K}\left(\tilde{c}_{k}\right)^{2}+2\sum_{k=1}^{K}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex206"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex206.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex207"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex207.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi^{*};\hat{r}_{k}+b^{r}_{k})\right)-\sum_{k=1}^{K}\left(f(\pi_{k})-f(\pi_{k};\hat{r}_{k}+b^{r}_{k})\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo>;</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mo>;</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi^{*};\hat{r}_{k}+b^{r}_{k})\right)-\sum_{k=1}^{K}\left(f(\pi_{k})-f(\pi_{k};\hat{r}_{k}+b^{r}_{k})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex208"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex208.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{1}{2\eta}\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\frac{\eta(C_{\max})^{2}K}{2}+2\sum_{k=1}^{K}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle><msup><mrow><mo>(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{2\eta}\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\frac{\eta(C_{\max})^{2}K}{2}+2\sum_{k=1}^{K}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex209"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex209.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex210"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex210.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+K\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[r^{*}(x,y)-\left(\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)\right)]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo>(</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+K\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi^{*}(\cdot|x)}[r^{*}(x,y)-\left(\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)\right)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex211"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex211.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[r^{*}(x,y)-\left(\hat{r}(x,y)+b^{r}_{k}(x,y)\right)]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo>(</mo><mover accent="true"><mi>r</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[r^{*}(x,y)-\left(\hat{r}(x,y)+b^{r}_{k}(x,y)\right)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex212"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex212.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{1}{2\eta}\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\frac{\eta(C_{\max})^{2}K}{2}+2\sum_{k=1}^{K}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle><msup><mrow><mo>(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{2\eta}\left(\lambda_{1}-\bar{\lambda}\right)^{2}+\frac{\eta(C_{\max})^{2}K}{2}+2\sum_{k=1}^{K}\lambda_{k}\cdot\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex213"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex213.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{k=1}^{K}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)+2\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{r}_{k}(x,y)]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><msub><mi>λ</mi><mi>k</mi></msub><mo>−</mo><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>)</mo></mrow><mrow><mo>(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{k=1}^{K}\left(\lambda_{k}-\bar{\lambda}\right)\left(\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right)+2\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{r}_{k}(x,y)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p19" class="ltx_para">
<p id="A5.SS2.p19.1" class="ltx_p"><span id="A5.SS2.p19.1.1" class="ltx_text">Let <math id="A5.SS2.p19.m1" class="ltx_Math" alttext="\bar{\lambda}=0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bar{\lambda}=0</annotation></semantics></math>. Recall that <math id="A5.SS2.p19.m2" class="ltx_Math" alttext="\pi^{\textup{out}}_{K}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>K</mi><mtext>out</mtext></msubsup><annotation encoding="application/x-tex">\pi^{\textup{out}}_{K}</annotation></semantics></math> is the uniform policy over <math id="A5.SS2.p19.m3" class="ltx_Math" alttext="\pi_{1},\dots,\pi_{K}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>π</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{1},\dots,\pi_{K}</annotation></semantics></math> and <math id="A5.SS2.p19.m4" class="ltx_Math" alttext="\eta:=\frac{\lambda_{1}}{C_{\max}\sqrt{K}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>:=</mo><mfrac><msub><mi>λ</mi><mn>1</mn></msub><mrow><msub><mi>C</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>K</mi></msqrt></mrow></mfrac></mrow><annotation encoding="application/x-tex">\eta:=\frac{\lambda_{1}}{C_{\max}\sqrt{K}}</annotation></semantics></math>. Then, we have</span></p>
<table id="A5.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex214"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex214.m1" class="ltx_Math" alttext="\displaystyle\quad f(\pi^{*})-f(\pi^{\textup{out}}_{K})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>K</mi><mtext>out</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad f(\pi^{*})-f(\pi^{\textup{out}}_{K})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex215"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex215.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{K}\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi_{k})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{K}\sum_{k=1}^{K}\left(f(\pi^{*})-f(\pi_{k})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex216"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex216.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{\lambda_{1}C_{\max}}{\sqrt{K}}+\frac{2\rho}{K}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]+\frac{\rho}{K}\sum_{k=1}^{K}\left|\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right|" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>max</mi></msub></mrow><msqrt><mi>K</mi></msqrt></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ρ</mi><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mo fence="false" rspace="0.167em">|</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>c</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\lambda_{1}C_{\max}}{\sqrt{K}}+\frac{2\rho}{K}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{c}_{k}(x,y)]+\frac{\rho}{K}\sum_{k=1}^{K}\left|\tilde{c}_{k}-\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[c^{*}(x,y)]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex217"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex217.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\frac{2}{K}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{r}_{k}(x,y)]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><msup><mrow></mrow><mi>p</mi></msup><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{2}{K}\sum_{k=1}^{K}\mathbb{E}_{x\sim\mathcal{D}^{p},y\sim\pi_{k}(\cdot|x)}[b^{r}_{k}(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex218"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex218.m1" class="ltx_Math" alttext="\displaystyle=O\Bigg(\frac{\lambda_{1}C_{\max}}{\sqrt{K}}+\rho C_{\max}\sqrt{\frac{\log\left(\frac{K}{\delta}\right)}{N^{\textup{CE}}}}+\rho W\sqrt{\frac{\log\left(\frac{|\mathcal{X}||\mathcal{Y}|N^{\textup{CE}}K}{\delta}\right)}{M^{\textup{CE}}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>max</mi></msub></mrow><msqrt><mi>K</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>K</mi><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow><msup><mi>N</mi><mtext>CE</mtext></msup></mfrac></mstyle></msqrt></mrow><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mtext>CE</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow><msup><mi>M</mi><mtext>CE</mtext></msup></mfrac></mstyle></msqrt></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=O\Bigg(\frac{\lambda_{1}C_{\max}}{\sqrt{K}}+\rho C_{\max}\sqrt{\frac{\log\left(\frac{K}{\delta}\right)}{N^{\textup{CE}}}}+\rho W\sqrt{\frac{\log\left(\frac{|\mathcal{X}||\mathcal{Y}|N^{\textup{CE}}K}{\delta}\right)}{M^{\textup{CE}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex219"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex219.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\rho\sqrt{\frac{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{K}{\delta}\right)\right)+\gamma^{\textup{on}}(C_{\max})^{2}}\cdot" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>ρ</mi><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>C</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>C</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>K</mi><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo lspace="0.222em">⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\rho\sqrt{\frac{\left(\exp\left(C_{\max}\right)+\exp\left(-C_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{K}{\delta}\right)\right)+\gamma^{\textup{on}}(C_{\max})^{2}}\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex220"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex220.m1" class="ltx_Math" alttext="\displaystyle\quad\sqrt{|\mathcal{X}||\mathcal{Y}|K\left(\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+C^{\textup{base}}K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)\right)}" display="inline" intent=":literal"><semantics><msqrt><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><mi>K</mi></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msup><mi>C</mi><mtext>base</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></msqrt><annotation encoding="application/x-tex">\displaystyle\quad\sqrt{|\mathcal{X}||\mathcal{Y}|K\left(\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+C^{\textup{base}}K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex221"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex221.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sqrt{\frac{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{K}{\delta}\right)\right)+\gamma^{\textup{on}}(R_{\max})^{2}}\cdot" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>R</mi><mi>max</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow><mo>)</mo></mrow><mn>2</mn></msup><msup><mi>N</mi><mtext>on</mtext></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>K</mi><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo lspace="0.222em">⋅</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sqrt{\frac{\left(\exp\left(R_{\max}\right)+\exp\left(-R_{\max}\right)+2\right)^{2}}{N^{\textup{on}}}\left(|\mathcal{X}||\mathcal{Y}|+\log\left(\frac{K}{\delta}\right)\right)+\gamma^{\textup{on}}(R_{\max})^{2}}\cdot</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex222"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex222.m1" class="ltx_Math" alttext="\displaystyle\quad\sqrt{|\mathcal{X}||\mathcal{Y}|K\left(\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+C^{\textup{base}}K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)\right)}." display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><mi>K</mi></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>C</mi><mtext>base</mtext></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mtext>on</mtext></msup><mo>+</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn><mi>r</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><msup><mi>C</mi><mtext>base</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mtext>on</mtext></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></msqrt><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\sqrt{|\mathcal{X}||\mathcal{Y}|K\left(\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)+\frac{1}{C^{\textup{base}}}\log\left(\frac{\gamma^{\textup{on}}+|\mathcal{D}^{r}_{1}|+C^{\textup{base}}K}{|\mathcal{X}||\mathcal{Y}|\gamma^{\textup{on}}}\right)\right)}.</annotation></semantics></math></td>
