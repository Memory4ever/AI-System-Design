<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex112.m2" class="ltx_Math" alttext="\displaystyle\pi(y|x)\!=\!\frac{\pi_{\textup{ref}}(y|x)\cdot\exp\left(\frac{1}{\beta}\left(\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\lambda_{k}\left(c(x,y)-b^{c}_{k}(x,y)\right)\right)\right)}{\sum_{y^{\prime}\in\mathcal{Y}}\pi_{\textup{ref}}(y^{\prime}|x)\cdot\exp\left(\frac{1}{\beta}\left(\hat{r}_{k}(x,y^{\prime})+b^{r}_{k}(x,y^{\prime})-\lambda_{k}\left(c(x,y^{\prime})-b^{c}_{k}(x,y^{\prime})\right)\right)\right)}\!:" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.108em">=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mrow><mrow><msub><mo>∑</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>b</mi><mi>k</mi><mi>c</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0.108em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\pi(y|x)\!=\!\frac{\pi_{\textup{ref}}(y|x)\cdot\exp\left(\frac{1}{\beta}\left(\hat{r}_{k}(x,y)+b^{r}_{k}(x,y)-\lambda_{k}\left(c(x,y)-b^{c}_{k}(x,y)\right)\right)\right)}{\sum_{y^{\prime}\in\mathcal{Y}}\pi_{\textup{ref}}(y^{\prime}|x)\cdot\exp\left(\frac{1}{\beta}\left(\hat{r}_{k}(x,y^{\prime})+b^{r}_{k}(x,y^{\prime})-\lambda_{k}\left(c(x,y^{\prime})-b^{c}_{k}(x,y^{\prime})\right)\right)\right)}\!:</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E32.m1" class="ltx_math_unparsed" alttext="\displaystyle c\in\mathcal{C}\Bigg\}." display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle c\in\mathcal{C}\Bigg\}.</annotation></semantics></math></td>
