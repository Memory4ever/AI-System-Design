<th id="S6.T6.2.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r">T<math id="S6.T6.m4" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>T</th>
<th id="S6.T6.2.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column">S<math id="S6.T6.m5" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>S</th>
<th id="S6.T6.2.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column">T<math id="S6.T6.m6" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>T</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T6.2.3" class="ltx_tr">
<td id="S6.T6.2.3.1" class="ltx_td ltx_align_left ltx_border_t">LST (Static)</td>
<td id="S6.T6.2.3.2" class="ltx_td ltx_align_center ltx_border_t">4</td>
