<th id="A1.T8.8.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T8.8.1.2.1" class="ltx_text ltx_font_bold">Ave Patch Size</span></th>
<th id="A1.T8.8.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" colspan="2">HellaSwag</th>
<th id="A1.T8.8.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" colspan="2">StoryCloze</th>
<th id="A1.T8.8.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2">TopicStoryCloze</th></tr>
<tr id="A1.T8.8.2" class="ltx_tr">
<th id="A1.T8.8.2.1" class="ltx_td ltx_th ltx_th_column"></th>
<th id="A1.T8.8.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column">(tokens)</th>
<th id="A1.T8.8.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column">S<math id="A1.T8.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>S</th>
<th id="A1.T8.8.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r">T<math id="A1.T8.m2" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>T</th>
<th id="A1.T8.8.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column">S<math id="A1.T8.m3" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>S</th>
<th id="A1.T8.8.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r">T<math id="A1.T8.m4" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>T</th>
<th id="A1.T8.8.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column">S<math id="A1.T8.m5" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>S</th>
<th id="A1.T8.8.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column">T<math id="A1.T8.m6" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>T</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T8.8.3" class="ltx_tr">
<td id="A1.T8.8.3.1" class="ltx_td ltx_align_left ltx_border_t">LST (Word Align)</td>
<td id="A1.T8.8.3.2" class="ltx_td ltx_align_center ltx_border_t">5.8<sup id="A1.T8.8.3.2.1" class="ltx_sup">*</sup></td>
<td id="A1.T8.8.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T8.8.3.3.1" class="ltx_text ltx_font_bold">40.0</span></td>
<td id="A1.T8.8.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">49.9</td>
