<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Notation in Depth</h2>

<div id="A1.p1" class="ltx_para ltx_noindent">
<p id="A1.p1.1" class="ltx_p">As established in section <a href="#S3.SS1" title="3.1 ARMOR Matrix Factorization ‣ 3 Methods ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, for a block diagonal matrix <math id="A1.p1.m1" class="ltx_Math" alttext="D\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">D\in\mathbb{R}^{d\times d}</annotation></semantics></math> with block size <math id="A1.p1.m2" class="ltx_Math" alttext="d_{\mathrm{block}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>block</mi></msub><annotation encoding="application/x-tex">d_{\mathrm{block}}</annotation></semantics></math>, we denote the individual blocks as:</p>
<table id="A1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex4.m1" class="ltx_Math" alttext="D=\begin{bmatrix}D^{\left(1\right)}&amp;0&amp;\cdots&amp;0\\
0&amp;D^{\left(2\right)}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;\cdots&amp;D^{\left(\frac{d}{d_{\mathrm{block}}}\right)}\end{bmatrix}" display="block" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msup><mi>D</mi><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow></msup></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msup><mi>D</mi><mrow><mo>(</mo><mn>2</mn><mo>)</mo></mrow></msup></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><msup><mi>D</mi><mrow><mo>(</mo><mfrac><mi>d</mi><msub><mi>d</mi><mi>block</mi></msub></mfrac><mo>)</mo></mrow></msup></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">D=\begin{bmatrix}D^{\left(1\right)}&amp;0&amp;\cdots&amp;0\\
0&amp;D^{\left(2\right)}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;\cdots&amp;D^{\left(\frac{d}{d_{\mathrm{block}}}\right)}\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p1.2" class="ltx_p">where <math id="A1.p1.m3" class="ltx_Math" alttext="D^{\left(i\right)}\in\mathbb{R}^{d_{\mathrm{block}}\times d_{\mathrm{block}}}\quad\forall\quad i\in[1,d/d_{\mathrm{block}}]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>D</mi><mrow><mo>(</mo><mi>i</mi><mo>)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mi>block</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi>block</mi></msub></mrow></msup></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mo>∀</mo><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mrow><mi>d</mi><mo>/</mo><msub><mi>d</mi><mi>block</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D^{\left(i\right)}\in\mathbb{R}^{d_{\mathrm{block}}\times d_{\mathrm{block}}}\quad\forall\quad i\in[1,d/d_{\mathrm{block}}]</annotation></semantics></math>. More generally for a matrix <math id="A1.p1.m4" class="ltx_Math" alttext="C\in\mathbb{R}^{d_{1}\times d_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">C\in\mathbb{R}^{d_{1}\times d_{2}}</annotation></semantics></math> we denote the <math id="A1.p1.m5" class="ltx_Math" alttext="d_{\mathrm{block}}\times d_{\mathrm{block}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>block</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi>block</mi></msub></mrow><annotation encoding="application/x-tex">d_{\mathrm{block}}\times d_{\mathrm{block}}</annotation></semantics></math> matrix blocks as:</p>
<table id="A1.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex5.m1" class="ltx_Math" alttext="C=\begin{bmatrix}C^{\left(1,1\right)}&amp;C^{\left(1,2\right)}&amp;\cdots&amp;C^{\left(1,\frac{d_{2}}{d_{\mathrm{block}}}\right)}\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
C^{\left(\frac{d_{1}}{d_{\mathrm{block}}},1\right)}&amp;C^{\left(\frac{d_{1}}{d_{\mathrm{block}}},2\right)}&amp;\cdots&amp;C^{\left(\frac{d_{1}}{d_{\mathrm{block}}},\frac{d_{2}}{d_{\mathrm{block}}}\right)}\\
\end{bmatrix}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msup><mi>C</mi><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>)</mo></mrow></msup></mtd><mtd><msup><mi>C</mi><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>)</mo></mrow></msup></mtd><mtd><mo>⋯</mo></mtd><mtd><msup><mi>C</mi><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mfrac><msub><mi>d</mi><mn>2</mn></msub><msub><mi>d</mi><mi>block</mi></msub></mfrac><mo>)</mo></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd><msup><mi>C</mi><mrow><mo>(</mo><mfrac><msub><mi>d</mi><mn>1</mn></msub><msub><mi>d</mi><mi>block</mi></msub></mfrac><mo>,</mo><mn>1</mn><mo>)</mo></mrow></msup></mtd><mtd><msup><mi>C</mi><mrow><mo>(</mo><mfrac><msub><mi>d</mi><mn>1</mn></msub><msub><mi>d</mi><mi>block</mi></msub></mfrac><mo>,</mo><mn>2</mn><mo>)</mo></mrow></msup></mtd><mtd><mo>⋯</mo></mtd><mtd><msup><mi>C</mi><mrow><mo>(</mo><mfrac><msub><mi>d</mi><mn>1</mn></msub><msub><mi>d</mi><mi>block</mi></msub></mfrac><mo>,</mo><mfrac><msub><mi>d</mi><mn>2</mn></msub><msub><mi>d</mi><mi>block</mi></msub></mfrac><mo>)</mo></mrow></msup></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">C=\begin{bmatrix}C^{\left(1,1\right)}&amp;C^{\left(1,2\right)}&amp;\cdots&amp;C^{\left(1,\frac{d_{2}}{d_{\mathrm{block}}}\right)}\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
C^{\left(\frac{d_{1}}{d_{\mathrm{block}}},1\right)}&amp;C^{\left(\frac{d_{1}}{d_{\mathrm{block}}},2\right)}&amp;\cdots&amp;C^{\left(\frac{d_{1}}{d_{\mathrm{block}}},\frac{d_{2}}{d_{\mathrm{block}}}\right)}\\
\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>ARMOR Optimization Algorithm in Depth</h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.1" class="ltx_p">In section <a href="#A2.SS1" title="B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>, we elaborate on the sparse core update step more formally. Additionally we provided pseudo code for both the sparse core update and the continuous parameter update steps in <a href="#A2.SS2" title="B.2 Algorithm Pseudocode ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>.</p>
</div>
<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>The Sparse Core Update Step in Depth</h3>

<div id="A2.SS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.p1.1" class="ltx_p">
Decomposing equation <a href="#S3.E2" title="In 3.2 Optimization Objective ‣ 3 Methods ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> into independent subproblems at the block matrix level:</p>
<table id="A2.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E5.m1" class="ltx_Math" alttext="\mathcal{L}_{W,X}(\theta)=\sum_{i=1}\sum_{j=1}\ell_{X}^{(i,j)}(\theta^{\left(i,j\right)})=\sum_{i=1}\sum_{j=1}\left\lVert\bar{W}^{\left(i,j\right)}-A^{\left(i\right)}\left(W^{\prime\left(i,j\right)}\odot M^{\left(i,j\right)}\right)B^{\left(j\right)}\right\rVert_{F,\mathrm{diag}\left(XX^{T}\right)^{\left(j\right)}}^{2}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>W</mi><mo>,</mo><mi>X</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></munder><mrow><msubsup><mi mathvariant="normal">ℓ</mi><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></munder><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></munder><msubsup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msup><mo>−</mo><mrow><msup><mi>A</mi><mrow><mo>(</mo><mi>i</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>W</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msup><mi>M</mi><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup></mrow></mrow><mo>‖</mo></mrow><mrow><mi>F</mi><mo>,</mo><mrow><mi>diag</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mi>T</mi></msup></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup></mrow></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{W,X}(\theta)=\sum_{i=1}\sum_{j=1}\ell_{X}^{(i,j)}(\theta^{\left(i,j\right)})=\sum_{i=1}\sum_{j=1}\left\lVert\bar{W}^{\left(i,j\right)}-A^{\left(i\right)}\left(W^{\prime\left(i,j\right)}\odot M^{\left(i,j\right)}\right)B^{\left(j\right)}\right\rVert_{F,\mathrm{diag}\left(XX^{T}\right)^{\left(j\right)}}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p1.2" class="ltx_p">where <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="i\in[d_{\mathrm{out}}/d_{\mathrm{block}}]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>d</mi><mi>out</mi></msub><mo>/</mo><msub><mi>d</mi><mi>block</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[d_{\mathrm{out}}/d_{\mathrm{block}}]</annotation></semantics></math> and <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="j\in[d_{\mathrm{in}}/d_{\mathrm{block}}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>d</mi><mi>in</mi></msub><mo>/</mo><msub><mi>d</mi><mi>block</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[d_{\mathrm{in}}/d_{\mathrm{block}}]</annotation></semantics></math>. We optimize each block subproblem in parallel, for the remainder of this section we will consider block <math id="A2.SS1.p1.m3" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math>. Optimizing these subproblems still requires a sweep over a exponential search space, so we adopt a greedy approach that optimizes a single sparse group for each subproblem.</p>
</div>
<section id="A2.SS1.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Optimizing the Sparse Group</h5>

<div id="A2.SS1.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS0.Px1.p1.1" class="ltx_p">After selecting group <math id="A2.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="i^{\prime},k" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">i^{\prime},k</annotation></semantics></math>, we freeze all values beyond <math id="A2.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="{\left(W^{\prime}\odot M\right)^{\left(i,j\right)}}_{i^{\prime},\left[k\right]}" display="inline" intent=":literal"><semantics><mmultiscripts><mrow><mo>(</mo><mrow><msup><mi>W</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>M</mi></mrow><mo>)</mo></mrow><mrow></mrow><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><mrow></mrow></mmultiscripts><annotation encoding="application/x-tex">{\left(W^{\prime}\odot M\right)^{\left(i,j\right)}}_{i^{\prime},\left[k\right]}</annotation></semantics></math>, which we optimize with the 2:4 constraint. This is computationally feasible since we only have to sweep over <math id="A2.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="{4\choose 2}=6" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mn>4</mn><mn>2</mn></mfrac><mo>)</mo></mrow><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">{4\choose 2}=6</annotation></semantics></math> possible mask choices. Let us consider one such mask <math id="A2.SS1.SSS0.Px1.p1.m4" class="ltx_Math" alttext="m\in\{0,1\}^{4}\quad\mathrm{s.t.}\quad\|m\|_{0}=2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>m</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mn>4</mn></msup></mrow><mspace style="width:1em;" width="1em"></mspace><mi>s</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi></mrow><mo lspace="0em">.</mo><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>m</mi><mo stretchy="false">‖</mo></mrow><mn>0</mn></msub><mo>=</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">m\in\{0,1\}^{4}\quad\mathrm{s.t.}\quad\|m\|_{0}=2</annotation></semantics></math>, which has unmasked indices <math id="A2.SS1.SSS0.Px1.p1.m5" class="ltx_Math" alttext="i_{1},i_{2}\in[4]" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>i</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>4</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i_{1},i_{2}\in[4]</annotation></semantics></math> ie <math id="A2.SS1.SSS0.Px1.p1.m6" class="ltx_Math" alttext="m_{i_{1}}=m_{i_{2}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><msub><mi>i</mi><mn>1</mn></msub></msub><mo>=</mo><msub><mi>m</mi><msub><mi>i</mi><mn>2</mn></msub></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{i_{1}}=m_{i_{2}}=1</annotation></semantics></math>. Let us denote the unmasked elements for this mask as <math id="A2.SS1.SSS0.Px1.p1.m7" class="ltx_Math" alttext="w_{m}\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">w_{m}\mathbb{R}^{2}</annotation></semantics></math>, and <math id="A2.SS1.SSS0.Px1.p1.m8" class="ltx_Math" alttext="k^{\prime}=4(k-1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k^{\prime}=4(k-1)</annotation></semantics></math>. For this mask choice, the corresponding best-case proxy loss is given by:</p>
<table id="A2.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E6.m1" class="ltx_math_unparsed" alttext="\ell_{X}^{(i,j)}(m)=\min_{w_{m}}\left\lVert\bar{W}^{\left(i,j\right)}-A^{\left(i\right)}W^{\prime\prime\left(i,j\right)}B^{\left(j\right)}-A^{\left(i\right)}_{:,i^{\prime}}w_{m}B^{\left(j\right)}_{\{k^{\prime}+i_{1},k^{\prime}+i_{2}\},:}\right\rVert_{F,\mathrm{diag}\left(XX^{T}\right)^{\left(j\right)}}^{2}" display="block" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">ℓ</mi><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><munder><mi>min</mi><msub><mi>w</mi><mi>m</mi></msub></munder><msubsup><mrow><mo>‖</mo><msup><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msup><mo>−</mo><msup><mi>A</mi><mrow><mo>(</mo><mi>i</mi><mo>)</mo></mrow></msup><msup><mi>W</mi><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msup><msup><mi>B</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo>−</mo><msubsup><mi>A</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mrow><mo>(</mo><mi>i</mi><mo>)</mo></mrow></msubsup><msub><mi>w</mi><mi>m</mi></msub><msubsup><mi>B</mi><mrow><mo stretchy="false">{</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup><mo>+</mo><mi>i</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup><mo>+</mo><mi>i</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">}</mo><mo>,</mo><mo>:</mo></mrow><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msubsup><mo>‖</mo></mrow><mrow><mi>F</mi><mo>,</mo><mrow><mi>diag</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mi>T</mi></msup></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup></mrow></mrow><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\ell_{X}^{(i,j)}(m)=\min_{w_{m}}\left\lVert\bar{W}^{\left(i,j\right)}-A^{\left(i\right)}W^{\prime\prime\left(i,j\right)}B^{\left(j\right)}-A^{\left(i\right)}_{:,i^{\prime}}w_{m}B^{\left(j\right)}_{\{k^{\prime}+i_{1},k^{\prime}+i_{2}\},:}\right\rVert_{F,\mathrm{diag}\left(XX^{T}\right)^{\left(j\right)}}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px1.p1.2" class="ltx_p">where <math id="A2.SS1.SSS0.Px1.p1.m9" class="ltx_math_unparsed" alttext="W^{\prime\prime\left(i,j\right)}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">W^{\prime\prime\left(i,j\right)}</annotation></semantics></math> represents the frozen remainder of the sparse core:</p>
<table id="A2.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex6.m1" class="ltx_math_unparsed" alttext="W^{\prime\prime\left(i,j\right)}_{n,p}=\begin{cases}0&amp;\text{if }n=i^{\prime},k^{\prime}+1\leq p\leq k^{\prime}+4\\
M^{\left(i,j\right)}_{n,p}W^{\prime\left(i,j\right)}_{n,p}&amp;\text{otherwise}\end{cases}\quad\forall\quad n,p\in[d_{\mathrm{block}}]" display="block" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mrow><mi>n</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msubsup><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>=</mo><msup><mi>i</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mi>p</mi><mo>≤</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><mn>4</mn></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>M</mi><mrow><mi>n</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>n</mi><mo>,</mo><mi>p</mi></mrow><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></mrow></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow><mo lspace="0.167em" rspace="0.167em">∀</mo><mi>n</mi><mo>,</mo><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>d</mi><mi>block</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">W^{\prime\prime\left(i,j\right)}_{n,p}=\begin{cases}0&amp;\text{if }n=i^{\prime},k^{\prime}+1\leq p\leq k^{\prime}+4\\
M^{\left(i,j\right)}_{n,p}W^{\prime\left(i,j\right)}_{n,p}&amp;\text{otherwise}\end{cases}\quad\forall\quad n,p\in[d_{\mathrm{block}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px1.p1.3" class="ltx_p">Equation <a href="#A2.E6" title="In Optimizing the Sparse Group ‣ B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> can be arranged into a linear least squares problem with a closed form solution. For ease of notation, let <math id="A2.SS1.SSS0.Px1.p1.m10" class="ltx_math_unparsed" alttext="\Delta W=\bar{W}^{\left(i,j\right)}-A^{\left(i\right)}W^{\prime\prime\left(i,j\right)}B^{\left(j\right)}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mi>W</mi><mo>=</mo><mover accent="true"><mi>W</mi><mo>¯</mo></mover><msup><mrow></mrow><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msup><mo>−</mo><mi>A</mi><msup><mrow></mrow><mrow><mo>(</mo><mi>i</mi><mo>)</mo></mrow></msup><mi>W</mi><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></msup><mi>B</mi><msup><mrow></mrow><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\Delta W=\bar{W}^{\left(i,j\right)}-A^{\left(i\right)}W^{\prime\prime\left(i,j\right)}B^{\left(j\right)}</annotation></semantics></math>, <math id="A2.SS1.SSS0.Px1.p1.m11" class="ltx_math_unparsed" alttext="B^{\prime}=B^{\left(j\right)}_{\{k^{\prime}+i_{1},k^{\prime}+i_{2}\},:}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><msup><mrow></mrow><mo>′</mo></msup><mo>=</mo><mi>B</mi><msup><mrow></mrow><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup><mo>+</mo><mi>i</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup><mo>+</mo><mi>i</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">}</mo><mo>,</mo><mo>:</mo></mrow></msub></mrow><annotation encoding="application/x-tex">B^{\prime}=B^{\left(j\right)}_{\{k^{\prime}+i_{1},k^{\prime}+i_{2}\},:}</annotation></semantics></math>, <math id="A2.SS1.SSS0.Px1.p1.m12" class="ltx_math_unparsed" alttext="a=A^{\left(i\right)}_{:,i^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mi>A</mi><msup><mrow></mrow><mrow><mo>(</mo><mi>i</mi><mo>)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>i</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">a=A^{\left(i\right)}_{:,i^{\prime}}</annotation></semantics></math> and <math id="A2.SS1.SSS0.Px1.p1.m13" class="ltx_Math" alttext="D^{\left(j\right)}=\mathrm{diag}\left(XX^{T}\right)^{\left(j\right)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo>=</mo><mrow><mi>diag</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mi>T</mi></msup></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">D^{\left(j\right)}=\mathrm{diag}\left(XX^{T}\right)^{\left(j\right)}</annotation></semantics></math>. Solving the least squares problem results in an optimal <math id="A2.SS1.SSS0.Px1.p1.m14" class="ltx_Math" alttext="\ell^{*}_{m}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">ℓ</mi><mi>m</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\ell^{*}_{m}</annotation></semantics></math></p>
<table id="A2.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E7.m1" class="ltx_Math" alttext="\ell^{*}_{m}=\|\Delta W\|_{F,D^{\left(j\right)}}^{2}-\frac{1}{\|a\|_{2}^{2}}\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)^{T}\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)^{\dagger}\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)" display="block" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">ℓ</mi><mi>m</mi><mo>∗</mo></msubsup><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>,</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup></mrow><mn>2</mn></msubsup><mo>−</mo><mrow><mfrac><mn>1</mn><msubsup><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi>T</mi></mrow></msup></mrow><mo>)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell^{*}_{m}=\|\Delta W\|_{F,D^{\left(j\right)}}^{2}-\frac{1}{\|a\|_{2}^{2}}\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)^{T}\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)^{\dagger}\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px1.p1.4" class="ltx_p">The first term is independent of the mask choice <math id="A2.SS1.SSS0.Px1.p1.m15" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> for the group, thus when sweeping over the possible masks, we only compute the second term for efficiency. The optimum is achieved with unmasked weights <math id="A2.SS1.SSS0.Px1.p1.m16" class="ltx_Math" alttext="w^{*}_{m}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mi>m</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">w^{*}_{m}</annotation></semantics></math>:</p>
<table id="A2.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E8.m1" class="ltx_Math" alttext="w^{*}_{m}=\frac{1}{\|a\|_{2}^{2}}\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)^{\dagger}\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mi>m</mi><mo>∗</mo></msubsup><mo>=</mo><mrow><mfrac><mn>1</mn><msubsup><mrow><mo stretchy="false">‖</mo><mi>a</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi>T</mi></mrow></msup></mrow><mo>)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w^{*}_{m}=\frac{1}{\|a\|_{2}^{2}}\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)^{\dagger}\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="A2.SS1.SSS0.Px1.p1.5" class="ltx_p">After sweeping over all <math id="A2.SS1.SSS0.Px1.p1.m17" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math> possible masks, we select the mask <math id="A2.SS1.SSS0.Px1.p1.m18" class="ltx_Math" alttext="m^{*}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">m^{*}</annotation></semantics></math>, with nonzero values at <math id="A2.SS1.SSS0.Px1.p1.m19" class="ltx_math_unparsed" alttext="i_{1}^{*},i_{2}*" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mo>∗</mo></msup><mo>,</mo><mi>i</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.222em">∗</mo></mrow><annotation encoding="application/x-tex">i_{1}^{*},i_{2}*</annotation></semantics></math>, that achieves the minimum best-case proxy loss as given by equation <a href="#A2.E7" title="In Optimizing the Sparse Group ‣ B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>. We substitute the corresponding optimal <math id="A2.SS1.SSS0.Px1.p1.m20" class="ltx_Math" alttext="w_{m^{*}}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><msup><mi>m</mi><mo>∗</mo></msup><mo>∗</mo></msubsup><annotation encoding="application/x-tex">w_{m^{*}}^{*}</annotation></semantics></math> given by equation <a href="#A2.E8" title="In Optimizing the Sparse Group ‣ B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> into <math id="A2.SS1.SSS0.Px1.p1.m21" class="ltx_Math" alttext="W^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>′</mo></msup><annotation encoding="application/x-tex">W^{\prime}</annotation></semantics></math> to fully update sparse core, i.e. we set <math id="A2.SS1.SSS0.Px1.p1.m22" class="ltx_Math" alttext="\left(W^{\prime\left(i,j\right)}_{\mathrm{new}}\right)_{i^{\prime},k^{\prime}+i_{1}^{*}}=w_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>(</mo><msubsup><mi>W</mi><mi>new</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></mrow></msubsup><mo>)</mo></mrow><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><msubsup><mi>i</mi><mn>1</mn><mo>∗</mo></msubsup></mrow></mrow></msub><mo>=</mo><msub><mi>w</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\left(W^{\prime\left(i,j\right)}_{\mathrm{new}}\right)_{i^{\prime},k^{\prime}+i_{1}^{*}}=w_{1}</annotation></semantics></math> and <math id="A2.SS1.SSS0.Px1.p1.m23" class="ltx_Math" alttext="\left(W^{\prime\left(i,j\right)}_{\mathrm{new}}\right)_{i^{\prime},k^{\prime}+i_{2}^{*}}=w_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>(</mo><msubsup><mi>W</mi><mi>new</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow></mrow></msubsup><mo>)</mo></mrow><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>+</mo><msubsup><mi>i</mi><mn>2</mn><mo>∗</mo></msubsup></mrow></mrow></msub><mo>=</mo><msub><mi>w</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\left(W^{\prime\left(i,j\right)}_{\mathrm{new}}\right)_{i^{\prime},k^{\prime}+i_{2}^{*}}=w_{2}</annotation></semantics></math>.</p>
</div>
<div id="A2.SS1.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS0.Px1.p2.1" class="ltx_p">The 2:4 semi-structured sparsity allows for efficient calculation of equations <a href="#A2.E7" title="In Optimizing the Sparse Group ‣ B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> and <a href="#A2.E8" title="In Optimizing the Sparse Group ‣ B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. Since there are only 2 unmasked values for each group <math id="A2.SS1.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi>T</mi></mrow></msup></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)</annotation></semantics></math> and <math id="A2.SS1.SSS0.Px1.p2.m2" class="ltx_Math" alttext="\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)</annotation></semantics></math> are of shape <math id="A2.SS1.SSS0.Px1.p2.m3" class="ltx_Math" alttext="2\times 2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2\times 2</annotation></semantics></math> and <math id="A2.SS1.SSS0.Px1.p2.m4" class="ltx_Math" alttext="2\times 1" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2\times 1</annotation></semantics></math>. Thus the computational cost for solving for <math id="A2.SS1.SSS0.Px1.p2.m5" class="ltx_Math" alttext="\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)^{\dagger}\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi>T</mi></mrow></msup></mrow><mo>)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)^{\dagger}\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)</annotation></semantics></math> are negligible. Rather, calculating equations <a href="#A2.E7" title="In Optimizing the Sparse Group ‣ B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> and <a href="#A2.E8" title="In Optimizing the Sparse Group ‣ B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> are dominated by calculating <math id="A2.SS1.SSS0.Px1.p2.m6" class="ltx_Math" alttext="\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi>T</mi></mrow></msup></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(B^{\prime}D^{\left(j\right)}B^{\prime T}\right)</annotation></semantics></math> and <math id="A2.SS1.SSS0.Px1.p2.m7" class="ltx_Math" alttext="\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>(</mo><mi>j</mi><mo>)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(B^{\prime}D^{\left(j\right)}\Delta W^{T}a\right)</annotation></semantics></math>, which scale with <math id="A2.SS1.SSS0.Px1.p2.m8" class="ltx_Math" alttext="d_{\mathrm{block}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>d</mi><mi>block</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">d_{\mathrm{block}}^{2}</annotation></semantics></math>. We update all <math id="A2.SS1.SSS0.Px1.p2.m9" class="ltx_Math" alttext="d_{\mathrm{in}}d_{\mathrm{out}}/d_{\mathrm{block}}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>in</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>out</mi></msub></mrow><mo>/</mo><msubsup><mi>d</mi><mi>block</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">d_{\mathrm{in}}d_{\mathrm{out}}/d_{\mathrm{block}}^{2}</annotation></semantics></math> blocks at once, thus the overall computational complexity is <math id="A2.SS1.SSS0.Px1.p2.m10" class="ltx_Math" alttext="\mathcal{O}(d_{\mathrm{in}}d_{\mathrm{out}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>in</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>out</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(d_{\mathrm{in}}d_{\mathrm{out}})</annotation></semantics></math>, scaling linearly with parameter size.</p>
</div>
</section>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Algorithm Pseudocode</h3>

<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Continuous Optimization via Sequential Gradient Descent</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            Current parameters <math id="alg2.l1.m1" class="ltx_Math" alttext="A,B,W^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><msup><mi>W</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">A,B,W^{\prime}</annotation></semantics></math>, mask <math id="alg2.l1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, normalized weight <math id="alg2.l1.m3" class="ltx_Math" alttext="\overline{W}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>W</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{W}</annotation></semantics></math>, calibration data <math id="alg2.l1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            Updated continuous parameters <math id="alg2.l2.m1" class="ltx_Math" alttext="A,B,W^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><msup><mi>W</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">A,B,W^{\prime}</annotation></semantics></math>.

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
            <span id="alg2.l3.2" class="ltx_text ltx_font_bold">function</span> <span id="alg2.l3.3" class="ltx_text ltx_font_smallcaps">ContinuousUpdate</span>(<math id="alg2.l3.m1" class="ltx_Math" alttext="A,B,W^{\prime},M,\overline{W},X" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><msup><mi>W</mi><mo>′</mo></msup><mo>,</mo><mi>M</mi><mo>,</mo><mover accent="true"><mi>W</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">A,B,W^{\prime},M,\overline{W},X</annotation></semantics></math>)

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
              <math id="alg2.l4.m1" class="ltx_Math" alttext="\hat{W}\leftarrow A(W^{\prime}\odot M)B" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>W</mi><mo>^</mo></mover><mo stretchy="false">←</mo><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>W</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{W}\leftarrow A(W^{\prime}\odot M)B</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              <math id="alg2.l5.m1" class="ltx_Math" alttext="L\leftarrow||\overline{W}-\hat{W}||_{F,diag(XX^{T})}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">←</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>W</mi><mo stretchy="true">¯</mo></mover><mo>−</mo><mover accent="true"><mi>W</mi><mo>^</mo></mover></mrow><mo stretchy="false">‖</mo></mrow><mrow><mi>F</mi><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mi>T</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">L\leftarrow||\overline{W}-\hat{W}||_{F,diag(XX^{T})}</annotation></semantics></math> <span id="alg2.l5.2" class="ltx_text" style="float:right;"><math id="alg2.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Compute proxy loss from Eq. <a href="#S3.E2" title="In 3.2 Optimization Objective ‣ 3 Methods ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
              <span id="alg2.l6.2" class="ltx_text" style="float:right;"><math id="alg2.l6.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update block diagonal matrix A
</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
              <math id="alg2.l7.m1" class="ltx_Math" alttext="\eta_{A}\leftarrow\text{ComputeLearningRate}(A,L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>A</mi></msub><mo stretchy="false">←</mo><mrow><mtext>ComputeLearningRate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{A}\leftarrow\text{ComputeLearningRate}(A,L)</annotation></semantics></math> <span id="alg2.l7.2" class="ltx_text" style="float:right;"><math id="alg2.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Based on local smoothness, Eq. <a href="#A4.E9" title="In D.1 Proxy Loss 𝛽-smooth With Respect to 𝐴 ‣ Appendix D Beta Smoothness of Proxy Loss ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
              <math id="alg2.l8.m1" class="ltx_Math" alttext="A\leftarrow A-\eta_{A}\nabla_{A}L" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo stretchy="false">←</mo><mrow><mi>A</mi><mo>−</mo><mrow><msub><mi>η</mi><mi>A</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>A</mi></msub><mi>L</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">A\leftarrow A-\eta_{A}\nabla_{A}L</annotation></semantics></math>

</div>
<div id="alg2.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
              <span id="alg2.l9.2" class="ltx_text" style="float:right;"><math id="alg2.l9.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update block diagonal matrix B
</span>
</div>
<div id="alg2.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
              <math id="alg2.l10.m1" class="ltx_Math" alttext="\eta_{B}\leftarrow\text{ComputeLearningRate}(B,L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>B</mi></msub><mo stretchy="false">←</mo><mrow><mtext>ComputeLearningRate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{B}\leftarrow\text{ComputeLearningRate}(B,L)</annotation></semantics></math> <span id="alg2.l10.2" class="ltx_text" style="float:right;"><math id="alg2.l10.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Eq. <a href="#A4.E10" title="In D.2 Proxy Loss 𝛽-smooth With Respect to 𝐵 ‣ Appendix D Beta Smoothness of Proxy Loss ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>
</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
              <math id="alg2.l11.m1" class="ltx_Math" alttext="B\leftarrow B-\eta_{B}\nabla_{B}L" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo stretchy="false">←</mo><mrow><mi>B</mi><mo>−</mo><mrow><msub><mi>η</mi><mi>B</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>B</mi></msub><mi>L</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B\leftarrow B-\eta_{B}\nabla_{B}L</annotation></semantics></math>

</div>
<div id="alg2.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
              <span id="alg2.l12.2" class="ltx_text" style="float:right;"><math id="alg2.l12.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update underlying weight matrix W’
</span>
</div>
<div id="alg2.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
              <math id="alg2.l13.m1" class="ltx_Math" alttext="\eta_{W^{\prime}}\leftarrow\text{ComputeLearningRate}(W^{\prime},L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><msup><mi>W</mi><mo>′</mo></msup></msub><mo stretchy="false">←</mo><mrow><mtext>ComputeLearningRate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>′</mo></msup><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{W^{\prime}}\leftarrow\text{ComputeLearningRate}(W^{\prime},L)</annotation></semantics></math> <span id="alg2.l13.2" class="ltx_text" style="float:right;"><math id="alg2.l13.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Eq. <a href="#A4.E11" title="In D.3 Proxy Loss 𝛽-smooth With Respect to 𝑊^′ ‣ Appendix D Beta Smoothness of Proxy Loss ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>
</span>
</div>
<div id="alg2.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
              
              <math id="alg2.l14.m1" class="ltx_Math" alttext="W^{\prime}\leftarrow W^{\prime}-\eta_{W^{\prime}}\nabla_{W^{\prime}}L" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><msup><mi>W</mi><mo>′</mo></msup><mo>−</mo><mrow><msub><mi>η</mi><msup><mi>W</mi><mo>′</mo></msup></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msup><mi>W</mi><mo>′</mo></msup></msub><mi>L</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">W^{\prime}\leftarrow W^{\prime}-\eta_{W^{\prime}}\nabla_{W^{\prime}}L</annotation></semantics></math>

</div>
<div id="alg2.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
              <span id="alg2.l15.2" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l15.m1" class="ltx_Math" alttext="A,B,W^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><msup><mi>W</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">A,B,W^{\prime}</annotation></semantics></math>

</div>
<div id="alg2.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
            <span id="alg2.l16.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l16.3" class="ltx_text ltx_font_bold">function</span>
</div>
</div>
</figure>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Greedy Sparse Core Update</figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            Current parameters <math id="alg3.l1.m1" class="ltx_Math" alttext="A,B,W^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><msup><mi>W</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">A,B,W^{\prime}</annotation></semantics></math>, mask <math id="alg3.l1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, normalized weight <math id="alg3.l1.m3" class="ltx_Math" alttext="\overline{W}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>W</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{W}</annotation></semantics></math>, calibration data <math id="alg3.l1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.

</div>
<div id="alg3.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            Updated sparse core parameters <math id="alg3.l2.m1" class="ltx_Math" alttext="W^{\prime},M" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mo>′</mo></msup><mo>,</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W^{\prime},M</annotation></semantics></math>.

</div>
<div id="alg3.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
            <span id="alg3.l3.2" class="ltx_text ltx_font_bold">function</span> <span id="alg3.l3.3" class="ltx_text ltx_font_smallcaps">SparseCoreUpdate</span>(<math id="alg3.l3.m1" class="ltx_Math" alttext="A,B,W^{\prime},M,\overline{W},X" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><msup><mi>W</mi><mo>′</mo></msup><mo>,</mo><mi>M</mi><mo>,</mo><mover accent="true"><mi>W</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">A,B,W^{\prime},M,\overline{W},X</annotation></semantics></math>)

</div>
<div id="alg3.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
              <span id="alg3.l4.2" class="ltx_text ltx_font_bold">for</span> each block <math id="alg3.l4.m1" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math> in parallel <span id="alg3.l4.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
               <span id="alg3.l5.2" class="ltx_text" style="float:right;"><math id="alg3.l5.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Select a single 2:4 sparse group to update within the block
</span>
</div>
<div id="alg3.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
               <span id="alg3.l6.2" class="ltx_text ltx_font_bold">for</span> each sparse group <math id="alg3.l6.m1" class="ltx_Math" alttext="(i^{\prime},k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i^{\prime},k)</annotation></semantics></math> in block <math id="alg3.l6.m2" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math> <span id="alg3.l6.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
                 <math id="alg3.l7.m1" class="ltx_Math" alttext="p^{(i,j)}_{(i^{\prime},k)}\propto\left\lVert\nabla_{{\left(M\odot W^{\prime}\right)^{\left(i,j\right)}}_{i^{\prime},\left[k\right]}}\ell^{(i,j)}\right\rVert_{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mrow><mo stretchy="false">(</mo><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∝</mo><msub><mrow><mo>‖</mo><mrow><msub><mo rspace="0.167em">∇</mo><mmultiscripts><mrow><mo>(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><msup><mi>W</mi><mo>′</mo></msup></mrow><mo>)</mo></mrow><mrow></mrow><mrow><mo>(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>)</mo></mrow><mrow><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><mrow><mo>[</mo><mi>k</mi><mo>]</mo></mrow></mrow><mrow></mrow></mmultiscripts></msub><msup><mi mathvariant="normal">ℓ</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>‖</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">p^{(i,j)}_{(i^{\prime},k)}\propto\left\lVert\nabla_{{\left(M\odot W^{\prime}\right)^{\left(i,j\right)}}_{i^{\prime},\left[k\right]}}\ell^{(i,j)}\right\rVert_{1}</annotation></semantics></math> <span id="alg3.l7.2" class="ltx_text" style="float:right;"><math id="alg3.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Calculate selection probability
</span>
</div>
<div id="alg3.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
               <span id="alg3.l8.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l8.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
               Select group <math id="alg3.l9.m1" class="ltx_Math" alttext="(i^{\prime*},k^{*})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>i</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>∗</mo></mrow></msup><mo>,</mo><msup><mi>k</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i^{\prime*},k^{*})</annotation></semantics></math> based on probabilities <math id="alg3.l9.m2" class="ltx_Math" alttext="p^{(i,j)}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">p^{(i,j)}</annotation></semantics></math>.

</div>
<div id="alg3.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
               <span id="alg3.l10.2" class="ltx_text" style="float:right;"><math id="alg3.l10.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Find the best mask and weights for the selected group
</span>
</div>
<div id="alg3.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
               Let <math id="alg3.l11.m1" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> be the set of all <math id="alg3.l11.m2" class="ltx_Math" alttext="\binom{4}{2}=6" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mn>4</mn><mn>2</mn></mfrac><mo>)</mo></mrow><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">\binom{4}{2}=6</annotation></semantics></math> possible masks for a group of 4.

</div>
<div id="alg3.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
               <math id="alg3.l12.m1" class="ltx_Math" alttext="l_{best}\leftarrow\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">l_{best}\leftarrow\infty</annotation></semantics></math>

</div>
<div id="alg3.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
               <span id="alg3.l13.2" class="ltx_text ltx_font_bold">for</span> each candidate mask <math id="alg3.l13.m1" class="ltx_Math" alttext="m\in\mathcal{M}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow><annotation encoding="application/x-tex">m\in\mathcal{M}</annotation></semantics></math> <span id="alg3.l13.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
              
                 Calculate the resulting loss <math id="alg3.l14.m1" class="ltx_Math" alttext="l_{m}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>l</mi><mi>m</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">l_{m}^{*}</annotation></semantics></math> using Eq. <a href="#A2.E7" title="In Optimizing the Sparse Group ‣ B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>

</div>
<div id="alg3.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
                 <span id="alg3.l15.2" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l15.m1" class="ltx_Math" alttext="l_{m}^{*}&lt;l_{best}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>l</mi><mi>m</mi><mo>∗</mo></msubsup><mo>&lt;</mo><msub><mi>l</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">l_{m}^{*}&lt;l_{best}</annotation></semantics></math> <span id="alg3.l15.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg3.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
                  <math id="alg3.l16.m1" class="ltx_Math" alttext="l_{best}\leftarrow l_{m}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">←</mo><msubsup><mi>l</mi><mi>m</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">l_{best}\leftarrow l_{m}^{*}</annotation></semantics></math>

</div>
<div id="alg3.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">17:</span>
              
              
                  <math id="alg3.l17.m1" class="ltx_Math" alttext="m^{*}\leftarrow m" display="inline" intent=":literal"><semantics><mrow><msup><mi>m</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">m^{*}\leftarrow m</annotation></semantics></math>

</div>
<div id="alg3.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">18:</span>
              
              
                 <span id="alg3.l18.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l18.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg3.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">19:</span>
              
              
               <span id="alg3.l19.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l19.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">20:</span>
              
              
               Calculate optimal weights <math id="alg3.l20.m1" class="ltx_Math" alttext="w_{m}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mi>m</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">w_{m}^{*}</annotation></semantics></math> for the unmasked entries using Eq. <a href="#A2.E8" title="In Optimizing the Sparse Group ‣ B.1 The Sparse Core Update Step in Depth ‣ Appendix B ARMOR Optimization Algorithm in Depth ‣ ARMOR: High-Performance Semi-Structured Pruning via Adaptive Matrix Factorization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>

</div>
<div id="alg3.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">21:</span>
              
              
               <span id="alg3.l21.2" class="ltx_text" style="float:right;"><math id="alg3.l21.m1" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update the mask M and weights W’ for the chosen group
</span>
</div>
<div id="alg3.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">22:</span>
              
              
               Update mask for group <math id="alg3.l22.m1" class="ltx_Math" alttext="(i^{\prime*},k^{*})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>i</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>∗</mo></mrow></msup><mo>,</mo><msup><mi>k</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i^{\prime*},k^{*})</annotation></semantics></math> in <math id="alg3.l22.m2" class="ltx_Math" alttext="M^{(i,j)}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">M^{(i,j)}</annotation></semantics></math> with <math id="alg3.l22.m3" class="ltx_Math" alttext="m^{*}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">m^{*}</annotation></semantics></math>.

</div>
<div id="alg3.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">23:</span>
              
              
               Update corresponding weights in <math id="alg3.l23.m1" class="ltx_Math" alttext="W^{\prime(i,j)}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">W^{\prime(i,j)}</annotation></semantics></math> with <math id="alg3.l23.m2" class="ltx_Math" alttext="w_{m}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mi>m</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">w_{m}^{*}</annotation></semantics></math>.

</div>
<div id="alg3.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">24:</span>
              
              
              <span id="alg3.l24.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l24.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">25:</span>
              
              
              <span id="alg3.l25.2" class="ltx_text ltx_font_bold">return</span> <math id="alg3.l25.m1" class="ltx_Math" alttext="W^{\prime},M" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mo>′</mo></msup><mo>,</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W^{\prime},M</annotation></semantics></math>

</div>
<div id="alg3.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">26:</span>
              
              
            <span id="alg3.l26.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l26.3" class="ltx_text ltx_font_bold">function</span>
</div>
</div>
</figure>
