lic</span><span id="lstnumberx149.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Goods</span><span id="lstnumberx149.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Game</span><span id="lstnumberx149.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">with</span><span id="lstnumberx149.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">N</span><span id="lstnumberx149.31" class="ltx_text ltx_font_typewriter">=4</span><span id="lstnumberx149.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx149.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">players</span><span id="lstnumberx149.34" class="ltx_text ltx_font_typewriter">.</span>
</div>
