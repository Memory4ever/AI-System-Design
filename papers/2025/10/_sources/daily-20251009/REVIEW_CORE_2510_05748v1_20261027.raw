text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Hunt</span><span id="lstnumberx1.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Game</span><span id="lstnumberx1.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">with</span><span id="lstnumberx1.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">N</span><span id="lstnumberx1.31" class="ltx_text ltx_font_typewriter">=4</span><span id="lstnumberx1.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">players</span><span id="lstnumberx1.34" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx2" class="ltx_listingline">
</div>
<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_font_typewriter">###</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">OBJECTIVE</span>
</div>
<div id="lstnumberx4" class="ltx_listingline"><span id="lstnumberx4.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Your</span><span id="lstnumberx4.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sole</span><span id="lstnumberx4.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">objective</span><span id="lstnumberx4.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx4.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx4.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">maximize</span><span id="lstnumberx4.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">your</span><span id="lstnumberx4.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">personal</span><span id="lstnumberx4.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">score</span><span id="lstnumberx4.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">over</span><span id="lstnumberx4.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">all</span><span id="lstnumberx4.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">rounds</span><span id="lstnumberx4.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx4.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx4.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">game</span><span id="lstnumberx4.30" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx5" class="ltx_listingline">
</div>
<div id="lstnumberx6" class="ltx_listingline"><span id="lstnumberx6.1" class="ltx_text ltx_font_typewriter">###</span><span id="lstnumberx6.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">GAME</span><span id="lstnumberx6.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">RULES</span>
</div>
<div id="lstnumberx7" class="ltx_listingline"><span id="lstnumberx7.1" class="ltx_text ltx_font_typewriter">1.</span><span id="lstnumberx7.2" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx7.3" class="ltx_text ltx_font_typewriter">**</span><span id="lstnumberx7.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Players</span><span id="lstnumberx7.5" class="ltx_text ltx_font_typewriter">:**</span><span id="lstnumberx7.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">There</span><span id="lstnumberx7.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx7.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.11" class="ltx_text ltx_font_typewriter">4</span><span id="lstnumberx7.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">players</span><span id="lstnumberx7.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">in</span><span id="lstnumberx7.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">total</span><span id="lstnumberx7.18" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx8" class="ltx_listingline"><span id="lstnumberx8.1" class="ltx_text ltx_font_typewriter">2.</span><span id="lstnumberx8.2" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx8.3" class="ltx_text ltx_font_typewriter">**</span><span id="lstnumberx8.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Rounds</span><span id="lstnumberx8.5" class="ltx_text ltx_font_typewriter">:**</span><span id="lstnumberx8.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx8.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx8.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx8.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">game</span><span id="lstnumberx8.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx8.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">will</span><span id="lstnumberx8.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx8.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">last</span><span id="lstnumberx8.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx8.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">for</span><span id="lstnumberx8.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx8.17" class="ltx_text ltx_font_typewriter">10</span><span id="lstnumberx8.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx8.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">rounds</span><span id="lstnumberx8.20" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx9" class="ltx_listingline"><span id="lstnumberx9.1" class="ltx_text ltx_font_typewriter">3.</span><span id="lstnumberx9.2" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx9.3" class="ltx_text ltx_font_typewriter">**</span><span id="lstnumberx9.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Actions</span><span id="lstnumberx9.5" class="ltx_text ltx_font_typewriter">:**</span><span id="lstnumberx9.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">In</span><span id="lstnumberx9.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">each</span><span id="lstnumberx9.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">round</span><span id="lstnumberx9.12" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx9.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">you</span><span id="lstnumberx9.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">must</span><span id="lstnumberx9.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">secretly</span><span id="lstnumberx9.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx9.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">simultaneously</span><span id="lstnumberx9.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">choose</span><span id="lstnumberx9.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">one</span><span id="lstnumberx9.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx9.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">two</span><span id="lstnumberx9.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">actions</span><span id="lstnumberx9.33" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx9.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.35" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx9.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Hunt</span><span id="lstnumberx9.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Stag</span><span id="lstnumberx9.39" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx9.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx9.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.43" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx9.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Hunt</span><span id="lstnumberx9.45" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Hare</span><span id="lstnumberx9.47" class="ltx_text ltx_font_typewriter">’.</span>
</div>
