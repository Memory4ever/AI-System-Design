<tr id="A4.T8.2.1.9" class="ltx_tr">
<td id="A4.T8.2.1.9.1" class="ltx_td ltx_align_center">C7</td>
<td id="A4.T8.2.1.9.2" class="ltx_td ltx_align_left">Data-Centric AI</td>
<td id="A4.T8.2.1.9.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="A4.T8.2.1.9.3.1" class="ltx_inline-block ltx_align_top" style="width:213.4pt;">
<span id="A4.T8.2.1.9.3.1.1" class="ltx_p ltx_align_left">data, model, training, loss, class</span>
</span></td>
<td id="A4.T8.2.1.9.4" class="ltx_td ltx_align_center">0.41</td>
<td id="A4.T8.2.1.9.5" class="ltx_td ltx_nopad_r ltx_align_center">974</td></tr>
