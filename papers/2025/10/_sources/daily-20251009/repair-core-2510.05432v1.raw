            <span id="alg1.l14.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l14.m1" class="ltx_Math" alttext="\mathcal{P}_{final}\neq\text{null}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo>≠</mo><mtext>null</mtext></mrow><annotation encoding="application/x-tex">\mathcal{P}_{final}\neq\text{null}</annotation></semantics></math> <span id="alg1.l14.3" class="ltx_text ltx_font_bold">then</span>

</div>
