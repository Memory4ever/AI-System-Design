<td id="A2.T7.2.4.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:0.0pt;padding-right:0.0pt;"><math id="A2.T7.m19" class="ltx_Math" alttext="-0.015" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.015</mn></mrow><annotation encoding="application/x-tex">-0.015</annotation></semantics></math></td></tr>
