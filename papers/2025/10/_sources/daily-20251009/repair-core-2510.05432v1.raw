<td id="A2.T7.2.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:0.0pt;padding-right:0.0pt;">Solution Leakage</td>
<td id="A2.T7.2.5.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:0.0pt;padding-right:0.0pt;"><math id="A2.T7.m20" class="ltx_Math" alttext="2.04" display="inline" intent=":literal"><semantics><mn>2.04</mn><annotation encoding="application/x-tex">2.04</annotation></semantics></math></td>
<td id="A2.T7.2.5.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:0.0pt;padding-right:0.0pt;"><math id="A2.T7.m21" class="ltx_Math" alttext="2.06" display="inline" intent=":literal"><semantics><mn>2.06</mn><annotation encoding="application/x-tex">2.06</annotation></semantics></math></td>
<td id="A2.T7.2.5.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:0.0pt;padding-right:0.0pt;"><math id="A2.T7.m22" class="ltx_Math" alttext="0.602" display="inline" intent=":literal"><semantics><mn>0.602</mn><annotation encoding="application/x-tex">0.602</annotation></semantics></math></td>
<td id="A2.T7.2.5.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:0.0pt;padding-right:0.0pt;"><math id="A2.T7.m23" class="ltx_Math" alttext="0.207" display="inline" intent=":literal"><semantics><mn>0.207</mn><annotation encoding="application/x-tex">0.207</annotation></semantics></math></td>
