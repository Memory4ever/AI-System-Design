<td id="A2.T7.2.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:0.0pt;padding-right:0.0pt;">Ambiguity</td>
<td id="A2.T7.2.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-left:0.0pt;padding-right:0.0pt;"><math id="A2.T7.m15" class="ltx_Math" alttext="4.22" display="inline" intent=":literal"><semantics><mn>4.22</mn><annotation encoding="application/x-tex">4.22</annotation></semantics></math></td>
