<table id="A2.T5.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A2.T5.2.1.1" class="ltx_tr">
<th id="A2.T5.2.1.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt"></th>
<td id="A2.T5.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m1" class="ltx_Math" alttext="Q_{11}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>11</mn></msub><annotation encoding="application/x-tex">Q_{11}</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m2" class="ltx_Math" alttext="Q_{22}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>22</mn></msub><annotation encoding="application/x-tex">Q_{22}</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m3" class="ltx_Math" alttext="Q_{33}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>33</mn></msub><annotation encoding="application/x-tex">Q_{33}</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m4" class="ltx_Math" alttext="Q_{44}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>44</mn></msub><annotation encoding="application/x-tex">Q_{44}</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.6" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m5" class="ltx_Math" alttext="Q_{55}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>55</mn></msub><annotation encoding="application/x-tex">Q_{55}</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.7" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m6" class="ltx_Math" alttext="Q_{66}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>66</mn></msub><annotation encoding="application/x-tex">Q_{66}</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.8" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m7" class="ltx_Math" alttext="Q_{77}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>77</mn></msub><annotation encoding="application/x-tex">Q_{77}</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.9" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m8" class="ltx_Math" alttext="R_{11}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>11</mn></msub><annotation encoding="application/x-tex">R_{11}</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.10" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m9" class="ltx_Math" alttext="R_{22}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>22</mn></msub><annotation encoding="application/x-tex">R_{22}</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.11" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m10" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.12" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m11" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math></td>
<td id="A2.T5.2.1.1.13" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m12" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math></td>
