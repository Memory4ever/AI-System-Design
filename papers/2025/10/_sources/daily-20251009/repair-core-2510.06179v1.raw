#000000;" color="#000000" fill="#E6E6E6"><path d="M -51.18 -60.24 M -51.18 -60.24 L -51.18 20.87 L 51.18 20.87 L 51.18 -60.24 Z M 51.18 20.87"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M -21.65 -12.22 h 43.31 v 24.43 h -43.31 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -16.26 -4.14)"><foreignObject style="--ltx-fo-width:2.35em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="32.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F5.pic1.m1" class="ltx_Math" alttext="\pi^{\theta}(x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mi>θ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\theta}(x)</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M -21.65 -51.18 h 43.31 v 23.62 h -43.31 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -7.01 -45.09)"><foreignObject style="--ltx-fo-width:1.01em;--ltx-fo-height:0.83em;--ltx-fo-depth:0em;font-size:10pt;" height="11.43" overflow="visible" transform="matrix(1 0 0 -1 0 11.43)" width="14.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F5.pic1.m2" class="ltx_Math" alttext="\mathcal{E}^{i}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\mathcal{E}^{i}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-width="0.8pt"><path style="fill:none" d="M 22.21 0 L 41.89 0 L 41.89 -39.37 L 28.68 -39.37"></path><g transform="matrix(-1.0 0.0 0.0 -1.0 28.68 -39.37)"><path style="stroke:none" d="M 6.48 0 C 4.56 0.36 1.44 1.44 -0.72 2.7 L -0.72 -2.7 C 1.44 -1.44 4.56 -0.36 6.48 0"></path></g></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-width="0.8pt"><path style="fill:none" d="M -22.21 -39.37 L -41.89 -39.37 L -41.89 0 L -28.68 0"></path><g transform="matrix(1.0 0.0 0.0 1.0 -28.68 0)"><path style="stroke:none" d="M 6.48 0 C 4.56 0.36 1.44 1.44 -0.72 2.7 L -0.72 -2.7 C 1.44 -1.44 4.56 -0.36 6.48 0"></path></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M -159.45 -39.37 h 43.31 v 23.62 h -43.31 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -141.04 -32.36)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="6.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F5.pic1.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M -159.45 -0.25 h 43.31 v 24.11 h -43.31 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -151.73 7.83)"><foreignObject style="--ltx-fo-width:2.01