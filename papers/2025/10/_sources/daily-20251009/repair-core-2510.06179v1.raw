<td id="A2.T5.2.1.1.15" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T5.m14" class="ltx_Math" alttext="\mu_{f}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\mu_{f}</annotation></semantics></math></td>
