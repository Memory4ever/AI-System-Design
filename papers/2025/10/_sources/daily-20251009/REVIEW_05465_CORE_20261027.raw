<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Appendix</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Dataset Construction</h3>

<section id="A1.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.1.1 </span>Filtering Wikipedia for controversial sections</h4>

<div id="A1.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS1.SSS1.p1.1" class="ltx_p">We used a regular expression to filter down to controversial sections. Here is the list of regular expression patterns that were used for that purpose:</p>
</div>
<figure id="LST1" class="ltx_float ltx_lstlisting">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float">Listing 1: </span>Regular expressions for matching controversial section titles</figcaption>
<div id="LST1.2" class="ltx_listing ltx_lst_numbers_left ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing" style="--ltx-bg-color:#F5F5F5;"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">1</span>
                
                
                
              <span id="lstnumberx1.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">_PATTERNS</span><span id="lstnumberx1.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.4" class="ltx_text ltx_font_typewriter">=</span><span id="lstnumberx1.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.6" class="ltx_text ltx_font_typewriter">[</span>
</div>
<div id="lstnumberx2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">2</span>
                
                
                
              <span id="lstnumberx2.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx2.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">r</span><span id="lstnumberx2.4" class="ltx_text ltx_font_typewriter">'\</span><span id="lstnumberx2.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">bCriticism</span><span id="lstnumberx2.6" class="ltx_text ltx_font_typewriter">?</span><span id="lstnumberx2.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx2.8" class="ltx_text ltx_font_typewriter">?\</span><span id="lstnumberx2.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">b</span><span id="lstnumberx2.10" class="ltx_text ltx_font_typewriter">',</span><span id="lstnumberx2.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">r</span><span id="lstnumberx2.13" class="ltx_text ltx_font_typewriter">'\</span><span id="lstnumberx2.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">bControvers</span><span id="lstnumberx2.15" class="ltx_text ltx_font_typewriter">(?:</span><span id="lstnumberx2.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">y</span><span id="lstnumberx2.17" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx2.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ies</span><span id="lstnumberx2.19" class="ltx_text ltx_font_typewriter">)\</span><span id="lstnumberx2.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">b</span><span id="lstnumberx2.21" class="ltx_text ltx_font_typewriter">',</span><span id="lstnumberx2.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">r</span><span id="lstnumberx2.24" class="ltx_text ltx_font_typewriter">'\</span><span id="lstnumberx2.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">bDisputes</span><span id="lstnumberx2.26" class="ltx_text ltx_font_typewriter">?\</span><span id="lstnumberx2.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">b</span><span id="lstnumberx2.28" class="ltx_text ltx_font_typewriter">',</span>
</div>
