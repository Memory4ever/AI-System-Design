            <span id="lstnumberx174.2" class="ltx_text ltx_font_typewriter">#</span><span id="lstnumberx174.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx174.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Task</span>
