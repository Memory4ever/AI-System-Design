            <span id="lstnumberx106.2" class="ltx_text ltx_font_typewriter">{{</span><span id="lstnumberx106.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx106.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">system_prompt</span><span id="lstnumberx106.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx106.6" class="ltx_text ltx_font_typewriter">}}</span>
</div>
<div id="lstnumberx107" class="ltx_listingline">
