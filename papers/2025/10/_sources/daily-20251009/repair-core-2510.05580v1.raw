<tr id="A1.T4.2.1.10" class="ltx_tr">
<td id="A1.T4.2.1.10.1" class="ltx_td ltx_align_center ltx_border_r"><span id="A1.T4.2.1.10.1.1" class="ltx_text ltx_font_italic">MAR</span> Latent Dimension</td>
<td id="A1.T4.2.1.10.2" class="ltx_td ltx_align_center">2048</td></tr>
