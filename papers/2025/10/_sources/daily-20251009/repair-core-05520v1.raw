<div id="A6.T6.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:310.5pt;height:50.6pt;vertical-align:-23.6pt;"><span class="ltx_transformed_inner" style="transform:translate(-70.5pt,11.5pt) scale(0.68778781913816,0.68778781913816) ;">
<table id="A6.T6.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A6.T6.2.1.1" class="ltx_tr">
<th id="A6.T6.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="A6.T6.2.1.1.1.1" class="ltx_text ltx_font_bold">Methods</span></th>
<th id="A6.T6.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="A6.T6.2.1.1.2.1" class="ltx_text ltx_font_bold">Times</span></th>
<th id="A6.T6.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="A6.T6.2.1.1.3.1" class="ltx_text ltx_font_bold">Meaning</span></th>
