<td id="S1.T1.2.5.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S1.T1.2.5.2.1" class="ltx_text ltx_font_typewriter">the mayor of Wuhan named Jiang Daqiao</span></td>
