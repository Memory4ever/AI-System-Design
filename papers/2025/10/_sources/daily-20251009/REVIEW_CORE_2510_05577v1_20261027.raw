<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Token Cost</h3>

<figure id="A4.T9" class="ltx_table">
<table id="A4.T9.2" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A4.T9.2.1" class="ltx_tr">
<th id="A4.T9.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t" rowspan="2"><span id="A4.T9.2.1.1.1" class="ltx_text ltx_font_bold ltx_align_center">Method</span></th>
<th id="A4.T9.2.1.2" class="ltx_td ltx_align_center ltx_align_top ltx_th ltx_th_column ltx_border_t" colspan="4"><span id="A4.T9.2.1.2.1" class="ltx_text ltx_font_bold">HotpotQA</span></th></tr>
<tr id="A4.T9.2.2" class="ltx_tr">
<th id="A4.T9.2.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_t">
<span id="A4.T9.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="A4.T9.2.2.1.1.1" class="ltx_p ltx_align_center">Easy</span>
