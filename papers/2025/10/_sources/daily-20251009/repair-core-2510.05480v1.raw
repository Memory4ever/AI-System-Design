</div>
<div id="alg1.5.10" class="ltx_listingline"><span id="alg1.5.10.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.10.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.10.3" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.10.4" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.10.5" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.5.10.6" class="ltx_text ltx_font_bold" style="font-size:80%;">9</span></span>
              <span id="alg1.5.10.7" class="ltx_text" style="font-size:80%;">j += 1</span>
</div>
<div id="alg1.5.11" class="ltx_listingline"><span id="alg1.5.11.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.11.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.11.3" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.11.4" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.5.11.5" class="ltx_text ltx_font_bold" style="font-size:80%;">10</span></span>
              <span id="alg1.5.11.6" class="ltx_text" style="font-size:80%;">end if</span>
</div>
<div id="alg1.5.12" class="ltx_listingline"><span id="alg1.5.12.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.12.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.12.3" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.5.12.4" class="ltx_text ltx_font_bold" style="font-size:80%;">11</span></span>
              <span id="alg1.5.12.5" class="ltx_text" style="font-size:80%;">end while</span>
</div>
<div id="alg1.5.13" class="ltx_listingline"><span id="alg1.5.13.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.13.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.13.3" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.5.13.4" class="ltx_text ltx_font_bold" style="font-size:80%;">12</span></span>
              <span id="alg1.5.13.5" class="ltx_text" style="font-size:80%;">Select answers samples </span><math id="alg1.m13" class="ltx_Math" alttext="x_{j}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">x</mi><mi mathsize="0.800em">j</mi></msub><annotation encoding="application/x-tex">x_{j}</annotation></semantics></math><span id="alg1.5.13.6" class="ltx_text" style="font-size:80%;"> and construct prompt </span><math id="alg1.m14" class="ltx_Math" alttext="x_{\text{easy}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">x</mi><mtext mathsize="0.800em">easy</mtext></msub><annotation encoding="application/x-tex">x_{\text{easy}}</annotation></semantics></math><span id="alg1.5.13.7" class="ltx_text" style="font-size:80%;"> in Fig. </span><a href="#S2.F3" title="Fig. 3 ‣ II-B Domain-Aware Reasoning Learning (DARL) ‣ II Proposed Framework ‣ Vul-R2: A Reasoning LLM for Automated Vulnerability Repair" class="ltx_ref" style="font-size:80%;"><span class="ltx_text ltx_ref_tag">3</span></a><span id="alg1.5.13.8" class="ltx_text" style="font-size:80%;"> (5)
</span>
</div>
<div id="alg1.5.14" class="ltx_listingline"><span id="alg1.5.14.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.14.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.5.14.3" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.5.14.4" class="ltx_text ltx_font_bold" style="font-size:80%;">13</span></span>
