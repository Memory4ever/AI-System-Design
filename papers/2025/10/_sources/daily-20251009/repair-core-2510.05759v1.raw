<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F4.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S4.F4.sf1.4" class="ltx_text" style="font-size:90%;">Results across depth <math id="S4.F4.sf1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math></span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
