<td id="S5.T1.4.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m9" class="ltx_Math" alttext="0.402" display="inline" intent=":literal"><semantics><mn>0.402</mn><annotation encoding="application/x-tex">0.402</annotation></semantics></math></td>
<td id="S5.T1.4.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m10" class="ltx_Math" alttext="0.514" display="inline" intent=":literal"><semantics><mn>0.514</mn><annotation encoding="application/x-tex">0.514</annotation></semantics></math></td>
<td id="S5.T1.4.3.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m11" class="ltx_Math" alttext="0.206" display="inline" intent=":literal"><semantics><mn>0.206</mn><annotation encoding="application/x-tex">0.206</annotation></semantics></math></td>
<td id="S5.T1.4.3.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m12" class="ltx_Math" alttext="0.224" display="inline" intent=":literal"><semantics><mn>0.224</mn><annotation encoding="application/x-tex">0.224</annotation></semantics></math></td>
<td id="S5.T1.4.3.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m13" class="ltx_Math" alttext="0.318" display="inline" intent=":literal"><semantics><mn>0.318</mn><annotation encoding="application/x-tex">0.318</annotation></semantics></math></td>
<td id="S5.T1.4.3.7" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T1.m14" class="ltx_Math" alttext="0.333" display="inline" intent=":literal"><semantics><mn>0.333</mn><annotation encoding="application/x-tex">0.333</annotation></semantics></math></td>
