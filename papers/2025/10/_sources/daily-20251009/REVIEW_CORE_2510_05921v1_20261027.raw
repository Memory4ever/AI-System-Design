<td id="S5.T2.4.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m4" class="ltx_Math" alttext="0.540" display="inline" intent=":literal"><semantics><mn>0.540</mn><annotation encoding="application/x-tex">0.540</annotation></semantics></math></td>
