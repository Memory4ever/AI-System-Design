<td id="S5.T1.4.1.4" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_tt" rowspan="2"><span id="S5.T1.4.1.4.1" class="ltx_text"><math id="S5.T1.m7" class="ltx_Math" alttext="\bf\Delta\%" display="inline" intent=":literal"><semantics><mrow><mi>𝚫</mi><mo>%</mo></mrow><annotation encoding="application/x-tex">\bf\Delta\%</annotation></semantics></math></span></td></tr>
