<td id="S4.T1.5.9.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S4.T1.5.9.3.1" class="ltx_text ltx_font_bold">71.05</span></td>
<td id="S4.T1.5.9.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S4.T1.5.9.4.1" class="ltx_text ltx_font_bold">57.9</span></td>
