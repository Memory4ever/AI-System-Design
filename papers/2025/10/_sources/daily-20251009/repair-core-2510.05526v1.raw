<tbody id="A2.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex61.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex61.m2" class="ltx_Math" alttext="\displaystyle 6\epsilon+\frac{2}{N}\Big[\|\xi^{*}\|_{1}+\log\Big(\frac{|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)\Big]+\frac{4R\epsilon}{(3+e^{R})^{2}}-\frac{E_{r}^{2}}{2(3+e^{R})^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>ξ</mi><mo>∗</mo></msup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msup><mi>e</mi><mi>R</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>E</mi><mi>r</mi><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msup><mi>e</mi><mi>R</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle 6\epsilon+\frac{2}{N}\Big[\|\xi^{*}\|_{1}+\log\Big(\frac{|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)\Big]+\frac{4R\epsilon}{(3+e^{R})^{2}}-\frac{E_{r}^{2}}{2(3+e^{R})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E45.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E45.m2" class="ltx_Math" alttext="\displaystyle 7\epsilon+\frac{2}{N}\Big[\|\xi^{*}\|_{1}+\log\Big(\frac{|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)\Big]-\frac{E_{r}^{2}}{2(3+e^{R})^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>ξ</mi><mo>∗</mo></msup><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>E</mi><mi>r</mi><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msup><mi>e</mi><mi>R</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 7\epsilon+\frac{2}{N}\Big[\|\xi^{*}\|_{1}+\log\Big(\frac{|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)\Big]-\frac{E_{r}^{2}}{2(3+e^{R})^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
<p id="A2.p13.3" class="ltx_p"><span id="A2.p13.3.1" class="ltx_text">which proves Eq. (<a href="#A2.E39" title="Equation 39 ‣ Lemma 8. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>). Here, (a) uses the following inequality and (b) uses <math id="A2.p13.m21" class="ltx_Math" alttext="(3+e^{R})^{2}&gt;6e^{R}+e^{2R}&gt;6R+2R=8R" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msup><mi>e</mi><mi>R</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>&gt;</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>R</mi></msup></mrow><mo>+</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msup></mrow><mo>&gt;</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo>=</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">(3+e^{R})^{2}&gt;6e^{R}+e^{2R}&gt;6R+2R=8R</annotation></semantics></math>.</span></p>
<table id="A2.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
