<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{=}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{=}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex77.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\Big[\log q_{\pi_{r^{{\dagger}}},0}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})-\log q_{\pi,0}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})\Big]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mrow><msub><mi>π</mi><msup><mi>r</mi><mo>†</mo></msup></msub><mo>,</mo><mn>0</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mrow><mi>π</mi><mo>,</mo><mn>0</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\Big[\log q_{\pi_{r^{{\dagger}}},0}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})-\log q_{\pi,0}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})\Big]</annotation></semantics></math></td>
