<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex86.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{1}{4}\sum_{i=1}^{t}\mathbb{E}_{\mu_{i}}\Big\{\sigma[r^{\pi^{\prime}}(x_{i},a_{i}^{w})-r^{\pi^{\prime}}(x_{i},a_{i}^{\ell})]-\sigma[r^{*}(x_{i},a_{i}^{w})-r^{*}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{*}]\Big\}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub><msup><mrow><mo stretchy="false">{</mo><mi>σ</mi><mrow><mo stretchy="false">[</mo><msup><mi>r</mi><msup><mi>π</mi><mo>′</mo></msup></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><msup><mi>π</mi><mo>′</mo></msup></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>σ</mi><mrow><mo stretchy="false">[</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>y</mi><mi>i</mi></msub><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{4}\sum_{i=1}^{t}\mathbb{E}_{\mu_{i}}\Big\{\sigma[r^{\pi^{\prime}}(x_{i},a_{i}^{w})-r^{\pi^{\prime}}(x_{i},a_{i}^{\ell})]-\sigma[r^{*}(x_{i},a_{i}^{w})-r^{*}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{*}]\Big\}^{2}</annotation></semantics></math></td>
