<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex34.m1" class="ltx_math_unparsed" alttext="\displaystyle+\lambda(|\xi_{i}^{*}|-|\xi_{r,i}|)\big\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>λ</mi><mrow><mo stretchy="false">(</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>ξ</mi><mrow><mi>r</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\lambda(|\xi_{i}^{*}|-|\xi_{r,i}|)\big\}</annotation></semantics></math></td>
