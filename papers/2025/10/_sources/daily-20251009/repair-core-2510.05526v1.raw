<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex85.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{1}{8}\sum_{i=1}^{t}\mathbb{E}_{\mu_{i}}\Bigg[\sum_{y\in\{-1,1\}}\big|q_{\pi^{\prime},0}(y|x_{i},a_{i}^{(1)},a_{i}^{(-1)})-p_{r^{*},\xi_{i}^{*}}(y|x_{i},a_{i}^{(1)},a_{i}^{(-1)})\big|^{2}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>8</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></munder></mstyle><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><msub><mi>q</mi><mrow><msup><mi>π</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>p</mi><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{8}\sum_{i=1}^{t}\mathbb{E}_{\mu_{i}}\Bigg[\sum_{y\in\{-1,1\}}\big|q_{\pi^{\prime},0}(y|x_{i},a_{i}^{(1)},a_{i}^{(-1)})-p_{r^{*},\xi_{i}^{*}}(y|x_{i},a_{i}^{(1)},a_{i}^{(-1)})\big|^{2}\Bigg]</annotation></semantics></math></td>
