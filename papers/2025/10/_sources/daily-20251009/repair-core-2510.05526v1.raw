<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex63.m2" class="ltx_math_unparsed" alttext="\displaystyle\Big|\mathbb{E}_{\mathcal{D}}\big\{\big[r^{*}(x_{1},a_{1}^{w})-r^{*}(x_{1},a_{1}^{\ell})-r^{{\dagger}}(x_{1},a_{1}^{w})+r^{{\dagger}}(x_{1},a_{1}^{\ell})\big]^{2}\big\}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mrow><mo stretchy="false">{</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi>a</mi><mn>1</mn><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi>a</mi><mn>1</mn><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>†</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi>a</mi><mn>1</mn><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>r</mi><mo>†</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi>a</mi><mn>1</mn><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mn>2</mn></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Big|\mathbb{E}_{\mathcal{D}}\big\{\big[r^{*}(x_{1},a_{1}^{w})-r^{*}(x_{1},a_{1}^{\ell})-r^{{\dagger}}(x_{1},a_{1}^{w})+r^{{\dagger}}(x_{1},a_{1}^{\ell})\big]^{2}\big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
