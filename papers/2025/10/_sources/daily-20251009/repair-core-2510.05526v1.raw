<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex87.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{1}{4}\sum_{i=1}^{t}\Big\{\Big[\mathbb{E}_{\mu_{i}}\big[\sigma[r^{\pi_{r^{*}}}(x_{i},a_{i}^{w})-r^{\pi_{r^{*}}}(x_{i},a_{i}^{\ell})]-\sigma[r^{\pi^{\prime}}(x_{i},a_{i}^{w})-r^{\pi^{\prime}}(x_{i},a_{i}^{\ell})]\big]^{2}\Big]-\frac{1}{2}|\xi_{i}^{*}|\Big\}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo stretchy="false">{</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>σ</mi><mrow><mo stretchy="false">[</mo><msup><mi>r</mi><msub><mi>π</mi><msup><mi>r</mi><mo>∗</mo></msup></msub></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><msub><mi>π</mi><msup><mi>r</mi><mo>∗</mo></msup></msub></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>σ</mi><mrow><mo stretchy="false">[</mo><msup><mi>r</mi><msup><mi>π</mi><mo>′</mo></msup></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><msup><mi>π</mi><mo>′</mo></msup></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mn>2</mn></msup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{4}\sum_{i=1}^{t}\Big\{\Big[\mathbb{E}_{\mu_{i}}\big[\sigma[r^{\pi_{r^{*}}}(x_{i},a_{i}^{w})-r^{\pi_{r^{*}}}(x_{i},a_{i}^{\ell})]-\sigma[r^{\pi^{\prime}}(x_{i},a_{i}^{w})-r^{\pi^{\prime}}(x_{i},a_{i}^{\ell})]\big]^{2}\Big]-\frac{1}{2}|\xi_{i}^{*}|\Big\}</annotation></semantics></math></td>
