<tbody id="A2.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex99.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex99.m2" class="ltx_Math" alttext="\displaystyle(2\epsilon)(4R)=8R\epsilon," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle(2\epsilon)(4R)=8R\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p16.7" class="ltx_p"><span id="A2.p16.7.1" class="ltx_text">where (a) uses Eq. (<a href="#A2.E29" title="Equation 29 ‣ Lemma 2. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>), and (b) uses <math id="A2.p16.m30" class="ltx_Math" alttext="\|r^{{\dagger}}-r\|_{\infty}\leq\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>r</mi><mo>†</mo></msup><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\|r^{{\dagger}}-r\|_{\infty}\leq\epsilon</annotation></semantics></math> and Lemma <a href="#Thmlemma3" title="Lemma 3. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</span></p>
</div>
<div id="A2.p17" class="ltx_para">
<p id="A2.p17.1" class="ltx_p"><span id="A2.p17.1.1" class="ltx_text">Finally, we conclude the proof as follows.</span></p>
<table id="A2.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex100.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{t}\log\frac{\sigma\big[r^{\pi}(x_{i},a_{i}^{w})-r^{\pi}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{\pi}\big]}{\sigma\big[r^{*}(x_{i},a_{i}^{w})-r^{*}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{*}\big]}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><msup><mi>r</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ξ</mi><mi>i</mi><mi>π</mi></msubsup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{t}\log\frac{\sigma\big[r^{\pi}(x_{i},a_{i}^{w})-r^{\pi}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{\pi}\big]}{\sigma\big[r^{*}(x_{i},a_{i}^{w})-r^{*}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{*}\big]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex101.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex101.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{t}\Big[\log\frac{\sigma\big[r^{\pi}(x_{i},a_{i}^{w})-r^{\pi}(x_{i},a_{i}^{\ell})\big]}{\sigma\big[r^{*}(x_{i},a_{i}^{w})-r^{*}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{*}\big]}+\sigma(R)|\xi_{i}^{\pi}|\Big]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msup><mi>r</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mi>π</mi></msubsup><mo stretchy="false">|</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{t}\Big[\log\frac{\sigma\big[r^{\pi}(x_{i},a_{i}^{w})-r^{\pi}(x_{i},a_{i}^{\ell})\big]}{\sigma\big[r^{*}(x_{i},a_{i}^{w})-r^{*}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{*}\big]}+\sigma(R)|\xi_{i}^{\pi}|\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex102.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{=}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{=}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex102.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{t}\big[2W_{i}(\pi)+\sigma(R)|\xi_{i}^{\pi}|\big]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mi>π</mi></msubsup><mo stretchy="false">|</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{t}\big[2W_{i}(\pi)+\sigma(R)|\xi_{i}^{\pi}|\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex103.m1" class="ltx_Math" alttext="\displaystyle\overset{(c)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex103.m2" class="ltx_math_unparsed" alttext="\displaystyle 2\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)+4t\epsilon+\sum_{i=1}^{t}\Big\{\frac{1}{4}|\xi_{i}^{*}|+\sigma(R)|\xi_{i}^{\pi}|" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mi>log</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo><mn>4</mn><mi>t</mi><mi>ϵ</mi><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo stretchy="false">{</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mi>π</mi></msubsup><mo fence="false" stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)+4t\epsilon+\sum_{i=1}^{t}\Big\{\frac{1}{4}|\xi_{i}^{*}|+\sigma(R)|\xi_{i}^{\pi}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex104.m1" class="ltx_math_unparsed" alttext="\displaystyle-\frac{1}{2(3+e^{R})^{2}}\mathbb{E}_{\mu_{i}}\Big[\big[r^{\pi_{r^{*}}}(x_{i},a_{i}^{w})-r^{\pi_{r^{*}}}(x_{i},a_{i}^{\ell})-r^{\pi}(x_{i},a_{i}^{w})+r^{\pi}(x_{i},a_{i}^{\ell})\big]^{2}\Big]\Big\}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msup><mi>e</mi><mi>R</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mi>r</mi><msub><mi>π</mi><msup><mi>r</mi><mo>∗</mo></msup></msub></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><msub><mi>π</mi><msup><mi>r</mi><mo>∗</mo></msup></msub></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mi>π</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>r</mi><mi>π</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mn>2</mn></msup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{2(3+e^{R})^{2}}\mathbb{E}_{\mu_{i}}\Big[\big[r^{\pi_{r^{*}}}(x_{i},a_{i}^{w})-r^{\pi_{r^{*}}}(x_{i},a_{i}^{\ell})-r^{\pi}(x_{i},a_{i}^{w})+r^{\pi}(x_{i},a_{i}^{\ell})\big]^{2}\Big]\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex105.m1" class="ltx_Math" alttext="\displaystyle\overset{(d)}{=}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">d</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(d)}{=}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex105.m2" class="ltx_math_unparsed" alttext="\displaystyle 2\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)+4t\epsilon+\sum_{i=1}^{t}\Big\{\frac{1}{4}|\xi_{i}^{*}|+\sigma(R)|\xi_{i}^{\pi}|" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mi>log</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo><mn>4</mn><mi>t</mi><mi>ϵ</mi><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo stretchy="false">{</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mi>π</mi></msubsup><mo fence="false" stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)+4t\epsilon+\sum_{i=1}^{t}\Big\{\frac{1}{4}|\xi_{i}^{*}|+\sigma(R)|\xi_{i}^{\pi}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex106.m1" class="ltx_math_unparsed" alttext="\displaystyle-\frac{1}{2(3+e^{R})^{2}}\mathbb{E}_{\mu_{i}}\Big[\big[r^{*}(x_{i},a_{i}^{(1)})-r^{*}(x_{i},a_{i}^{(-1)})-r^{\pi}(x_{i},a_{i}^{(1)})+r^{\pi}(x_{i},a_{i}^{(-1)})\big]^{2}\Big]\Big\}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msup><mi>e</mi><mi>R</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mi>π</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>r</mi><mi>π</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mn>2</mn></msup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{2(3+e^{R})^{2}}\mathbb{E}_{\mu_{i}}\Big[\big[r^{*}(x_{i},a_{i}^{(1)})-r^{*}(x_{i},a_{i}^{(-1)})-r^{\pi}(x_{i},a_{i}^{(1)})+r^{\pi}(x_{i},a_{i}^{(-1)})\big]^{2}\Big]\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex107.m1" class="ltx_Math" alttext="\displaystyle\overset{(e)}{=}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">e</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(e)}{=}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex107.m2" class="ltx_math_unparsed" alttext="\displaystyle 2\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)+4t\epsilon+\sum_{i=1}^{t}\Big\{\frac{1}{4}|\xi_{i}^{*}|+\sigma(R)|\xi_{i}^{\pi}|" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mi>log</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo><mn>4</mn><mi>t</mi><mi>ϵ</mi><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo stretchy="false">{</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup><mo fence="false" stretchy="false">|</mo><mo lspace="0em">+</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mi>π</mi></msubsup><mo fence="false" stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)+4t\epsilon+\sum_{i=1}^{t}\Big\{\frac{1}{4}|\xi_{i}^{*}|+\sigma(R)|\xi_{i}^{\pi}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex108.m1" class="ltx_math_unparsed" alttext="\displaystyle-\frac{1}{2(3+e^{R})^{2}}\mathbb{E}_{x\sim\rho,a^{(1)}\sim\pi_{i}(\cdot|x),a^{(-1)}\sim\pi_{\rm ref}(\cdot|x)}\big[f_{\pi}^{2}(x,a^{(1)},a^{(-1)})\big]\Big\}," display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msup><mi>e</mi><mi>R</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>a</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>,</mo><mi>a</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msubsup><mi>f</mi><mi>π</mi><mn>2</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo stretchy="false">}</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{2(3+e^{R})^{2}}\mathbb{E}_{x\sim\rho,a^{(1)}\sim\pi_{i}(\cdot|x),a^{(-1)}\sim\pi_{\rm ref}(\cdot|x)}\big[f_{\pi}^{2}(x,a^{(1)},a^{(-1)})\big]\Big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p17.2" class="ltx_p"><span id="A2.p17.2.1" class="ltx_text">where (a) uses Eq. (<a href="#A2.E33" title="Equation 33 ‣ Lemma 4. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>) from Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, (b) uses <math id="A2.p17.m1" class="ltx_Math" alttext="W_{i}(\pi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{i}(\pi)</annotation></semantics></math> defined by Eq. (<a href="#A2.E48" title="Equation 48 ‣ Proof. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a>), (c) uses Eq. (<a href="#A2.E52" title="Equation 52 ‣ Proof. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">52</span></a>), (d) uses Eq. (<a href="#A2.E29" title="Equation 29 ‣ Lemma 2. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) and <math id="A2.p17.m2" class="ltx_Math" alttext="\{a_{i}^{w},a_{i}^{\ell}\}=\{a_{i}^{(1)},a_{i}^{(-1)}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">}</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{a_{i}^{w},a_{i}^{\ell}\}=\{a_{i}^{(1)},a_{i}^{(-1)}\}</annotation></semantics></math> (based on Assumption <a href="#Thmassum1" title="Assumption 1. ‣ 3.1 Our Offline RLHF-COV Objective ‣ 3 Our Offline DPO-COV Algorithm ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), and (e) uses Eq. (<a href="#A2.E46" title="Equation 46 ‣ Lemma 9. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a>).
∎</span></p>
</div>
</div>
<div id="Thmlemma10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma10.2" class="ltx_text ltx_font_bold">Lemma 10</span></span><span id="Thmlemma10.3" class="ltx_text ltx_font_bold"> </span>(Azuma-Hoeffding Inequality <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib60" title="" class="ltx_ref">Xie et al.,, 2024</a>)</cite>)<span id="Thmlemma10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma10.p1" class="ltx_para">
<p id="Thmlemma10.p1.1" class="ltx_p"><span id="Thmlemma10.p1.1.1" class="ltx_text ltx_font_italic">The random variables <math id="Thmlemma10.p1.m1" class="ltx_Math" alttext="\{X_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{X_{t}\}_{t=1}^{T}</annotation></semantics></math> satisfy <math id="Thmlemma10.p1.m2" class="ltx_Math" alttext="|X_{t}|\leq C" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">|X_{t}|\leq C</annotation></semantics></math> almost surely. Then with probability at least <math id="Thmlemma10.p1.m3" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, we have</span></p>
<table id="A2.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E53.m1" class="ltx_Math" alttext="\displaystyle\Big|\sum_{t=1}^{T}[X_{t}-\mathbb{E}(X_{t}|X_{1},\ldots,X_{t-1})]\Big|\leq C\sqrt{8T\log(2/\delta)}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|\sum_{t=1}^{T}[X_{t}-\mathbb{E}(X_{t}|X_{1},\ldots,X_{t-1})]\Big|\leq C\sqrt{8T\log(2/\delta)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmlemma11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma11.2" class="ltx_text ltx_font_bold">Lemma 11</span></span><span id="Thmlemma11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma11.p1" class="ltx_para">
<p id="Thmlemma11.p1.1" class="ltx_p"><span id="Thmlemma11.p1.1.1" class="ltx_text ltx_font_italic">Fixing any <math id="Thmlemma11.p1.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, <math id="Thmlemma11.p1.m2" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, the online dataset <math id="Thmlemma11.p1.m3" class="ltx_Math" alttext="\{x_{i},a_{i}^{(1)},a_{i}^{(-1)},y_{i}\}_{i=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{x_{i},a_{i}^{(1)},a_{i}^{(-1)},y_{i}\}_{i=1}^{T}</annotation></semantics></math> generated from Algorithm <a href="#alg2" title="Algorithm 2 ‣ 4 Our Online DPO-COV Algorithm ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> satisfies the following inequality for all <math id="Thmlemma11.p1.m4" class="ltx_Math" alttext="t=1,\ldots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\ldots,T</annotation></semantics></math> and <math id="Thmlemma11.p1.m5" class="ltx_Math" alttext="\pi\in\Pi_{\mathcal{R}}\overset{\rm def}{=}\{\pi_{r}:r\in\mathcal{R}\}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi class="ltx_font_mathcaligraphic">ℛ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>r</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi\in\Pi_{\mathcal{R}}\overset{\rm def}{=}\{\pi_{r}:r\in\mathcal{R}\}</annotation></semantics></math> simultaneously with probability at least <math id="Thmlemma11.p1.m6" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>.</span></p>
<table id="A2.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex109.m1" class="ltx_math_unparsed" alttext="\displaystyle\Bigg|\Big[\sum_{i=1}^{t}\log\frac{\pi(a_{i}^{(-1)}|x_{i})}{\pi_{r^{*}}(a_{i}^{(-1)}|x_{i})}\Big]\!-\!t\mathbb{E}_{x\sim\rho,a\sim\pi_{\rm ref}(\cdot|x)}\!\Big[\!\log\frac{\pi(a|x)}{\pi_{r^{*}}(a|x)}\Big]\Bigg|\!\leq\!\frac{4R}{\beta}\sqrt{2t\log\Big[\frac{2T\mathcal{N}_{\epsilon}(\mathcal{R})}{\delta}\Big]}\!+\!\frac{4t\epsilon}{\beta}." display="inline" intent=":literal"><semantics><mrow><mo fence="false" maxsize="2.600em" minsize="2.600em" rspace="0.167em" stretchy="true">|</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><msup><mi>r</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo lspace="0.052em" rspace="0.052em">−</mo><mi>t</mi><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi>ρ</mi><mo>,</mo><mi>a</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><msup><mi>r</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mpadded style="width:0.275em;" width="0.275em"><mo fence="false" maxsize="2.600em" minsize="2.600em" stretchy="true">|</mo></mpadded><mo rspace="0.108em">≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mi>β</mi></mfrac></mstyle><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></msqrt><mo lspace="0.052em" rspace="0.052em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mi>β</mi></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Bigg|\Big[\sum_{i=1}^{t}\log\frac{\pi(a_{i}^{(-1)}|x_{i})}{\pi_{r^{*}}(a_{i}^{(-1)}|x_{i})}\Big]\!-\!t\mathbb{E}_{x\sim\rho,a\sim\pi_{\rm ref}(\cdot|x)}\!\Big[\!\log\frac{\pi(a|x)}{\pi_{r^{*}}(a|x)}\Big]\Bigg|\!\leq\!\frac{4R}{\beta}\sqrt{2t\log\Big[\frac{2T\mathcal{N}_{\epsilon}(\mathcal{R})}{\delta}\Big]}\!+\!\frac{4t\epsilon}{\beta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.10" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p18" class="ltx_para">
<p id="A2.p18.1" class="ltx_p"><span id="A2.p18.1.1" class="ltx_text">For any <math id="A2.p18.m1" class="ltx_Math" alttext="r\in\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">r\in\mathcal{R}</annotation></semantics></math>, denote <math id="A2.p18.m2" class="ltx_Math" alttext="X_{i}(r)=\log\frac{\pi_{r}(a_{i}^{(-1)}|x_{i})}{\pi_{r^{*}}(a_{i}^{(-1)}|x_{i})}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>π</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><msup><mi>r</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">X_{i}(r)=\log\frac{\pi_{r}(a_{i}^{(-1)}|x_{i})}{\pi_{r^{*}}(a_{i}^{(-1)}|x_{i})}</annotation></semantics></math> which satisfies <math id="A2.p18.m3" class="ltx_Math" alttext="|X_{i}(r)|\leq\frac{2R}{\beta}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>X</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em