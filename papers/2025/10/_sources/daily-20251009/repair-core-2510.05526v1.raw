<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex90.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{8}\sum_{i=1}^{t}\Big\{|\xi_{i}^{*}|\!-\!\frac{2}{(3+e^{R})^{2}}\mathbb{E}_{\mu_{i}}\Big[\big[r^{\pi_{r^{*}}}(x_{i},a_{i}^{w})\!-\!r^{\pi_{r^{*}}}(x_{i},a_{i}^{\ell})\!-\!r^{\pi_{r^{{\dagger}}}}(x_{i},a_{i}^{w})\!+\!r^{\pi_{r^{{\dagger}}}}(x_{i},a_{i}^{\ell})\big]^{2}\Big]\Big\}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>8</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">|</mo></mrow><mo lspace="0.052em" rspace="0.052em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msup><mi>e</mi><mi>R</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><msup><mi>r</mi><msub><mi>π</mi><msup><mi>r</mi><mo>∗</mo></msup></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.052em" rspace="0.052em">−</mo><mrow><msup><mi>r</mi><msub><mi>π</mi><msup><mi>r</mi><mo>∗</mo></msup></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false