<tbody id="A2.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex36.m1" class="ltx_Math" alttext="\displaystyle\overset{(c)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex36.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{N}\sum_{i=1}^{N}\big\{|\xi_{i}^{*}|+2\log\mathbb{E}_{\mathcal{D}}\big[\exp[Z_{i}(r)]\big]\big\}+\frac{2}{N}\log\Big(\frac{|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>Z</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>N</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{N}\sum_{i=1}^{N}\big\{|\xi_{i}^{*}|+2\log\mathbb{E}_{\mathcal{D}}\big[\exp[Z_{i}(r)]\big]\big\}+\frac{2}{N}\log\Big(\frac{|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex37.m1" class="ltx_Math" alttext="\displaystyle\overset{(d)}{=}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">d</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(d)}{=}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex37.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{2}{N}\sum_{i=1}^{N}\log\mathbb{E}_{\mathcal{D}}\Bigg\{\mathbb{E}_{y_{i}\sim p_{r^{*},\xi_{i}^{*}}(\cdot|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}\Bigg[\sqrt{\frac{p_{r,0}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}{p_{r^{*},\xi_{i}^{*}}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}}\Bigg|x_{i},a_{i}^{(1)},a_{i}^{(-1)}\Bigg]\Bigg\}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mi>log</mi><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mrow><mo stretchy="false">{</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mrow><mi>r</mi><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo