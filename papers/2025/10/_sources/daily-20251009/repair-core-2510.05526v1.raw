<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex33.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{N}\sum_{i=1}^{N}\big\{\log\sigma[r(x_{i},a_{i}^{w})-r(x_{i},a_{i}^{\ell})]+\sigma(R)|\xi_{r,i}|-\log\sigma[r^{*}(x_{i},a_{i}^{w})-r^{*}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{*}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mo stretchy="false">{</mo><mi>log</mi><mi>σ</mi><mrow><mo stretchy="false">[</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>ξ</mi><mrow><mi>r</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em">−</mo><mi>log</mi><mi>σ</mi><mrow><mo stretchy="false">[</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>r</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>y</mi><mi>i</mi></msub><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{N}\sum_{i=1}^{N}\big\{\log\sigma[r(x_{i},a_{i}^{w})-r(x_{i},a_{i}^{\ell})]+\sigma(R)|\xi_{r,i}|-\log\sigma[r^{*}(x_{i},a_{i}^{w})-r^{*}(x_{i},a_{i}^{\ell})+y_{i}\xi_{i}^{*}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
