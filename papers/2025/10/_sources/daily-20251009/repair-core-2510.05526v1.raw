<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex62.m1" class="ltx_Math" alttext="\displaystyle|E_{r^{{\dagger}}}^{2}-E_{r}^{2}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>E</mi><msup><mi>r</mi><mo>†</mo></msup><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>E</mi><mi>r</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|E_{r^{{\dagger}}}^{2}-E_{r}^{2}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
