<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex76.m1" class="ltx_Math" alttext="\displaystyle|W_{i}(\pi_{r^{{\dagger}}})-W_{i}(\pi)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><msup><mi>r</mi><mo>†</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|W_{i}(\pi_{r^{{\dagger}}})-W_{i}(\pi)|</annotation></semantics></math></td>
