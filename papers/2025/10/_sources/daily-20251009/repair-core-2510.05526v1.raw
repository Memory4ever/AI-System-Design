<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex78.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\Big|\log\sigma\big[r^{\pi_{r^{{\dagger}}}}(x_{i},a_{i}^{w})-r^{\pi_{r^{{\dagger}}}}(x_{i},a_{i}^{\ell})\big]-\log\sigma\big[r^{\pi}(x_{i},a_{i}^{w})-r^{\pi}(x_{i},a_{i}^{\ell})\big]\Big|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msup><mi>r</mi><msub><mi>π</mi><msup><mi>r</mi><mo>†</mo></msup></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><msub><mi>π</mi><msup><mi>r</mi><mo>†</mo></msup></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msup><mi>r</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>r</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\Big|\log\sigma\big[r^{\pi_{r^{{\dagger}}}}(x_{i},a_{i}^{w})-r^{\pi_{r^{{\dagger}}}}(x_{i},a_{i}^{\ell})\big]-\log\sigma\big[r^{\pi}(x_{i},a_{i}^{w})-r^{\pi}(x_{i},a_{i}^{\ell})\big]\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E50.m1" class="ltx_Math" alttext="\displaystyle\overset{(c)}{=}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">c</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(c)}{=}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E50.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\Big|\log\sigma\big[r_{1}(x_{i},a_{i}^{w})-r_{1}(x_{i},a_{i}^{\ell})\big]-\log\sigma\big[r_{0}(x_{i},a_{i}^{w})-r_{0}(x_{i},a_{i}^{\ell})\big]\Big|\overset{(d)}{\leq}\epsilon," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>r</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi>w</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>r</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">d</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\Big|\log\sigma\big[r_{1}(x_{i},a_{i}^{w})-r_{1}(x_{i},a_{i}^{\ell})\big]-\log\sigma\big[r_{0}(x_{i},a_{i}^{w})-r_{0}(x_{i},a_{i}^{\ell})\big]\Big|\overset{(d)}{\leq}\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A2.p16.3" class="ltx_p"><span id="A2.p16.3.1" class="ltx_text">where (a) and (b) use Eq. (<a href="#A2.E48" title="Equation 48 ‣ Proof. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a>), (c) uses the above notation that <math id="A2.p16.m8" class="ltx_Math" alttext="r_{u}=ur^{\pi_{r^{{\dagger}}}}+(1-u)r^{\pi}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>u</mi></msub><mo>=</mo><mrow><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><msub><mi>π</mi><msup><mi>r</mi><mo>†</mo></msup></msub></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>π</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{u}=ur^{\pi_{r^{{\dagger}}}}+(1-u)r^{\pi}</annotation></semantics></math> (<math id="A2.p16.m9" class="ltx_Math" alttext="u\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">u\in[0,1]</annotation></semantics></math>), and (d) uses Eq. (<a href="#A2.E49" title="Equation 49 ‣ Proof. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">49</span></a>). Then based on Algorithm <a href="#alg2" title="Algorithm 2 ‣ 4 Our Online DPO-COV Algorithm ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and Assumption <a href="#Thmassum1" title="Assumption 1. ‣ 3.1 Our Offline RLHF-COV Objective ‣ 3 Our Offline DPO-COV Algorithm ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, given <math id="A2.p16.m10" class="ltx_Math" alttext="(x_{i},a_{i}^{(1)},a_{i}^{(-1)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{i},a_{i}^{(1)},a_{i}^{(-1)})</annotation></semantics></math>, the label <math id="A2.p16.m11" class="ltx_Math" alttext="y_{i}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>i</mi></msub><annotation encoding="application/x-tex">y_{i}</annotation></semantics></math> is generated with probability distribution <math id="A2.p16.m12" class="ltx_Math" alttext="p_{r^{*},\xi_{i}}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo>,</mo><msub><mi>ξ</mi><mi>i</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{r^{*},\xi_{i}}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})</annotation></semantics></math> defined by Eq. (<a href="#A2.E41" title="Equation 41 ‣ Proof. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>). Therefore, given any <math id="A2.p16.m13" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math> and <math id="A2.p16.m14" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, by Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> with <math id="A2.p16.m15" class="ltx_Math" alttext="\lambda^{\prime}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi>λ</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda^{\prime}=1</annotation></semantics></math>, the following inequality holds for <math id="A2.p16.m16" class="ltx_Math" alttext="t=1,\ldots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\ldots,T</annotation></semantics></math> and finitely many <math id="A2.p16.m17" class="ltx_Math" alttext="\pi^{\prime}\in\mathcal{N}_{\epsilon}(\mathcal{R})" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>′</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\prime}\in\mathcal{N}_{\epsilon}(\mathcal{R})</annotation></semantics></math> simultaneously with probability at least <math id="A2.p16.m18" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>.</span></p>
<table id="A2.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex79.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{t}W_{i}(\pi^{\prime})\leq\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)+\sum_{i=1}^{t}\log\mathbb{E}_{\mu_{i}}[e^{W_{i}(\pi^{\prime})}]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>e</mi><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{t}W_{i}(\pi^{\prime})\leq\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)+\sum_{i=1}^{t}\log\mathbb{E}_{\mu_{i}}[e^{W_{i}(\pi^{\prime})}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p16.4" class="ltx_p"><span id="A2.p16.4.1" class="ltx_text">where <math id="A2.p16.m19" class="ltx_Math" alttext="\mu_{i}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mu_{i}</annotation></semantics></math> denotes the distribution of the <math id="A2.p16.m20" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th online data sample <math id="A2.p16.m21" class="ltx_Math" alttext="(x_{i},a_{i}^{(-1)},a_{i}^{(1)},y_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{i},a_{i}^{(-1)},a_{i}^{(1)},y_{i})</annotation></semantics></math> generated by Algorithm <a href="#alg2" title="Algorithm 2 ‣ 4 Our Online DPO-COV Algorithm ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. We further upper bound the above inequality as follows.</span></p>
<table id="A2.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{t}W_{i}(\pi^{\prime})-\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{t}W_{i}(\pi^{\prime})-\log\Big(\frac{T|\mathcal{N}_{\epsilon}(\mathcal{R})|}{\delta}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex81.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex81.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{t}\log\mathbb{E}_{\mu_{i}}[e^{W_{i}(\pi^{\prime})}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>e</mi><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{t}\log\mathbb{E}_{\mu_{i}}[e^{W_{i}(\pi^{\prime})}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex82.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{eq:Wi}}{=}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>=</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#A2.E48" title="Equation 48 ‣ Proof. ‣ Appendix B Supporting Lemmas ‣ Appendix ‣ Provably Mitigating Corruption, Overoptimization, and Verbosity Simultaneously in Offline and Online RLHF/DPO Alignment" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">48</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{eq:Wi}}{=}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex82.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=1}^{t}\log\mathbb{E}_{\mu_{i}}\Bigg\{\mathbb{E}_{y_{i}\sim p_{r^{*},\xi_{i}^{*}}(\cdot|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}\Bigg[\sqrt{\frac{q_{\pi^{\prime},0}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}{p_{r^{*},\xi_{i}^{*}}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}}\Bigg|x_{i},a_{i}^{(1)},a_{i}^{(-1)}\Bigg]\Bigg\}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mi>log</mi><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub><mrow><mo stretchy="false">{</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mrow><msup><mi>π</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></msqrt><mo fence="false" maxsize="2.600em" minsize="2.600em" rspace="0.167em" stretchy="true">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{t}\log\mathbb{E}_{\mu_{i}}\Bigg\{\mathbb{E}_{y_{i}\sim p_{r^{*},\xi_{i}^{*}}(\cdot|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}\Bigg[\sqrt{\frac{q_{\pi^{\prime},0}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}{p_{r^{*},\xi_{i}^{*}}(y_{i}|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}}\Bigg|x_{i},a_{i}^{(1)},a_{i}^{(-1)}\Bigg]\Bigg\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex83.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex83.m2" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{t}\mathbb{E}_{\mu_{i}}\Bigg[\sum_{y\in\{-1,1\}}\sqrt{q_{\pi^{\prime},0}(y|x_{i},a_{i}^{(1)},a_{i}^{(-1)})p_{r^{*},\xi_{i}^{*}}(y|x_{i},a_{i}^{(1)},a_{i}^{(-1)})}-1\Bigg]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><msub><mi>μ</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></munder></mstyle><msqrt><mrow><msub><mi>q</mi><mrow><msup><mi>π</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><msup><mi>r</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mi>ξ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><m