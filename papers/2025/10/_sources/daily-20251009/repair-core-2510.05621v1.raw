/span></span></foreignObject></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -59.06 -357.58)"><foreignObject style="--ltx-fo-width:15.38em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.23em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="212.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
