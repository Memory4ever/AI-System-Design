<figure id="S5.F9" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S5.F9.sf1" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2510.05699v1/v_hist_200000_0_400.svg" id="S5.F9.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:342/251;" width="342" height="251"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F9.sf1.3" class="ltx_text" style="font-size:80%;">(a)</span> </span><span id="S5.F9.sf1.4" class="ltx_text" style="font-size:80%;">MIA via <math id="S5.F9.sf1.m2" class="ltx_Math" alttext="\mathsf{Vocabulary~Overlap}" display="inline" intent=":literal"><semantics><mrow><mi>𝖵𝗈𝖼𝖺𝖻𝗎𝗅𝖺𝗋𝗒</mi><mo lspace="0.280em" rspace="0em">​</mo><mi>𝖮𝗏𝖾𝗋𝗅𝖺𝗉</mi></mrow><annotation encoding="application/x-tex">\mathsf{Vocabulary~Overlap}</annotation></semantics></math></span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S5.F9.sf2" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2510.05699v1/v_hist_200000_800_1200.svg" id="S5.F9.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:342/251;" width="342" height="251"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F9.sf2.3" class="ltx_text" style="font-size:80%;">(b)</span> </span><span id="S5.F9.sf2.4" class="ltx_text" style="font-size:80%;">MIA via <math id="S5.F9.sf2.m2" class="ltx_Math" alttext="\mathsf{Vocabulary~Overlap}" display="inline" intent=":literal"><semantics><mrow><mi>𝖵𝗈𝖼𝖺𝖻𝗎𝗅𝖺𝗋𝗒</mi><mo lspace="0.280em" rspace="0em">​</mo><mi>𝖮𝗏𝖾𝗋𝗅𝖺𝗉</mi></mrow><annotation encoding="application/x-tex">\mathsf{Vocabulary~Overlap}</annotation></semantics></math></span></figcaption>
