<td id="S5.T2.2.1.9.17" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.2.1.9.17.1" class="ltx_text ltx_underline">0.705</span></td>
<td id="S5.T2.2.1.9.18" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb"><span id="S5.T2.2.1.9.18.1" class="ltx_text ltx_underline">27.88%</span></td></tr>
