</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S4.F5.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.05699v1/110000_power_law.svg" id="S4.F5.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:342/251;" width="342" height="251"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F5.sf2.3" class="ltx_text" style="font-size:80%;">(b)</span> </span><span id="S4.F5.sf2.4" class="ltx_text" style="font-size:80%;">Vocabulary Size: <math id="S4.F5.sf2.m2" class="ltx_Math" alttext="110\text{,\,}000" display="inline" intent=":literal"><semantics><mrow><mn>110</mn><mo lspace="0em" rspace="0em">​</mo><mtext>, </mtext><mo lspace="0em" rspace="0em">​</mo><mn>000</mn></mrow><annotation encoding="application/x-tex">110\text{,\,}000</annotation></semantics></math></span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
