<td id="S5.T2.2.1.9.12" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.2.1.9.12.1" class="ltx_text ltx_underline">22.41%</span></td>
<td id="S5.T2.2.1.9.13" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.2.1.9.13.1" class="ltx_text ltx_underline">0.707</span></td>
<td id="S5.T2.2.1.9.14" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.2.1.9.14.1" class="ltx_text ltx_underline">0.681</span></td>
