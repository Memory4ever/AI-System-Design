<td id="S5.T2.2.1.8.17" class="ltx_td ltx_align_center"><span id="S5.T2.2.1.8.17.1" class="ltx_text ltx_font_bold">0.711</span></td>
<td id="S5.T2.2.1.8.18" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T2.2.1.8.18.1" class="ltx_text ltx_font_bold">34.61%</span></td></tr>
<tr id="S5.T2.2.1.9" class="ltx_tr">
<td id="S5.T2.2.1.9.1" class="ltx_td ltx_align_left ltx_border_bb"><math id="S5.T2.m19" class="ltx_Math" alttext="\mathsf{Frequency~Estimation}" display="inline" intent=":literal"><semantics><mrow><mi>𝖥𝗋𝖾𝗊𝗎𝖾𝗇𝖼𝗒</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>𝖤𝗌𝗍𝗂𝗆𝖺𝗍𝗂𝗈𝗇</mi></mrow><annotation encoding="application/x-tex">\mathsf{Frequency~Estimation}</annotation></semantics></math></td>
<td id="S5.T2.2.1.9.2" class="ltx_td ltx_align_center ltx_border_bb">●</td>
