<div id="alg0.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg0.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
              <math id="alg0.l19.m1" class="ltx_Math" alttext="\tilde{\mathcal{V}}_{\text{out}}\leftarrow\mathcal{V}_{\text{out}}\setminus\mathcal{V}_{\text{non}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>~</mo></mover><mtext>out</mtext></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>out</mtext></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathcal{V}}_{\text{out}}\leftarrow\mathcal{V}_{\text{out}}\setminus\mathcal{V}_{\text{non}}</annotation></semantics></math> <span id="alg0.l19.3" class="ltx_text" style="float:right;"><span id="alg0.l19.3.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> <math id="alg0.l19.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <em id="alg0.l19.3.1.1" class="ltx_emph ltx_font_italic" style="font-size:90%;">filter non-distinctive tokens in <math id="alg0.l19.m3" class="ltx_Math" alttext="\mathcal{V}_{\text{out}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">𝒱</mi><mtext style="--ltx-fg-color:#0000FF;" class="ltx_mathvariant_italic" mathcolor="#0000FF">out</mtext></msub><annotation encoding="application/x-tex">\mathcal{V}_{\text{out}}</annotation></semantics></math></em></span>
</span>
</div>
<div id="alg0.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg0.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
              <math id="alg0.l20.m1" class="ltx_Math" alttext="J_{\text{out}}\leftarrow J_{\text{out}}+\dfrac{|\tilde{\mathcal{V}}_{\text{out}}\cap\tilde{\mathcal{V}}_{\text{target}}|}{|\tilde{\mathcal{V}}_{\text{out}}\cup\tilde{\mathcal{V}}_{\text{target}}|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mtext>out</mtext></msub><mo stretchy="false">←</mo><mrow><msub><mi>J</mi><mtext>out</mtext></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>~</mo></mover><mtext>out</mtext></msub><mo>∩</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>~</mo></mover><mtext>target</mtext></msub></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>~</mo></mover><mtext>out</mtext></msub><mo>∪</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>~</mo></mover><mtext>target</mtext></msub></mrow><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">J_{\text{out}}\leftarrow J_{\text{out}}+\dfrac{|\tilde{\mathcal{V}}_{\text{out}}\cap\tilde{\mathcal{V}}_{\text{target}}|}{|\tilde{\mathcal{V}}_{\text{out}}\cup\tilde{\mathcal{V}}_{\text{target}}|}</annotation></semantics></math> <span id="alg0.l20.3" class="ltx_text" style="float:right;"><span id="alg0.l20.3.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> <math id="alg0.l20.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <em id="alg0.l20.3.1.1" class="ltx_emph ltx_font_italic" style="font-size:90%;">sum Jaccard index in <math id="alg0.l20.m3" class="ltx_Math" alttext="\mathbb{V}_{\text{out}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝕍</mi><mtext style="--ltx-fg-color:#0000FF;" class="ltx_mathvariant_italic" mathcolor="#0000FF">out</mtext></msub><annotation encoding="application/x-tex">\mathbb{V}_{\text{out}}</annotation></semantics></math></em></span>
</span>
</div>
<div id="alg0.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg0.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
             <span id="alg0.l21.3" class="ltx_text ltx_font_bold">end</span> <span id="alg0.l21.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg0.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg0.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
             <span id="alg0.l22.3" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#B1B1B1;"># Step 4: Compute membership signal</span>

</div>
<div id="alg0.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg0.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
              
              
             <math id="alg0.l23.m1" class="ltx_Math" alttext="\textsc{Signal}\leftarrow\dfrac{1}{2}+\dfrac{J_{\text{in}}}{2|\mathbb{V}_{\text{in}}|}-\dfrac{J_{\text{out}}}{2|\mathbb{V}_{\text{out}}|}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">Signal</mtext><mo stretchy="false">←</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>J</mi><mtext>in</mtext></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝕍</mi><mtext>in</mtext></msub><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>J</mi><mtext>out</mtext></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝕍</mi><mtext>out</mtext></msub><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\textsc{Signal}\leftarrow\dfrac{1}{2}+\dfrac{J_{\text{in}}}{2|\mathbb{V}_{\text{in}}|}-\dfrac{J_{\text{out}}}{2|\mathbb{V}_{\text{out}}|}</annotation></semantics></math>

</div>
<div id="alg0.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg0.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              
             <span id="alg0.l24.3" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#B1B1B1;"># Step 5: Infer the membership</span>

</div>
<div id="alg0.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg0.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
              
              
             <span id="alg0.l25.3" class="ltx_text ltx_font_bold">return</span>  <math id="alg0.l25.m1" class="ltx_math_unparsed" alttext="\mathbbm{1}\left[\textsc{Signal}&gt;\tau\right]" display="inline" intent=":literal"><semantics><mrow><mn>𝟙</mn><mrow><mo>[</mo><mtext class="ltx_font_smallcaps">Signal</mtext><mo>&gt;</mo><mi>τ</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbbm{1}\left[\textsc{Signal}&gt;\tau\right]</annotation></semantics></math>

</div>
</div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.5" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> <span id="alg1.6" class="ltx_text ltx_font_bold">MIA via <math id="alg1.m6" class="ltx_Math" alttext="\mathsf{Vocabulary~Overlap}" display="inline" intent=":literal"><semantics><mrow><mi>𝖵𝗈𝖼𝖺𝖻𝗎𝗅𝖺𝗋𝗒</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>𝖮𝗏𝖾𝗋𝗅𝖺𝗉</mi></mrow><annotation encoding="application/x-tex">\mathsf{Vocabulary~Overlap}</annotation></semantics></math>.</span>
We train <math id="alg1.m7" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> shadow tokenizers with and without target dataset <math id="alg1.m8" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, filter out non-distinctive tokens, and compute the membership signal. If the signal is larger than a threshold <math id="alg1.m9" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, the dataset <math id="alg1.m10" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is inferred as a member. Otherwise, it is inferred as a non-member.
</figcaption>
</figure>
<div id="S4.SS2.p4" class="ltx_para">
<ol id="S4.I2" class="ltx_enumerate" style="--ltx-enum-leftmargin:1.8em;">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p">The adversary randomly samples a collection of datasets <math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="\mathcal{D}_{\textup{aux}}\leftarrow\mathbb{D}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>aux</mtext></msub><mo stretchy="false">←</mo><mi>𝔻</mi></mrow><annotation encoding="application/x-tex">\mathcal{D}_{\textup{aux}}\leftarrow\mathbb{D}</annotation></semantics></math> for <math id="S4.I2.i1.p1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> times, and trains <math id="S4.I2.i1.p1.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> shadow tokenizers considering inclusion or exclusion of the target dataset <math id="S4.I2.i1.p1.m4" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>. This process results in vocabulary sets <math id="S4.I2.i1.p1.m5" class="ltx_Math" alttext="\mathbb{V}_{\text{in}}" display="inline" intent=":literal"><semantics><msub><mi>𝕍</mi><mtext>in</mtext></msub><annotation encoding="application/x-tex">\mathbb{V}_{\text{in}}</annotation></semantics></math> and <math id="S4.I2.i1.p1.m6" class="ltx_Math" alttext="\mathbb{V}_{\text{out}}" display="inline" intent=":literal"><semantics><msub><mi>𝕍</mi><mtext>out</mtext></msub><annotation encoding="application/x-tex">\mathbb{V}_{\text{out}}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p">The adversary computes the non-distinctive tokens as:</p>
<table id="S4.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E3.m1" class="ltx_Math" alttext="\mathcal{V}_{\text{non}}=(\bigcup_{\mathcal{V}_{\text{in}}\in\mathbb{V}_{\text{in}}}\hskip-5.0pt\mathcal{V}_{\text{in}})\hskip 1.00006pt\bigcap\hskip 1.00006pt(\bigcup_{\mathcal{V}_{\text{in}}\in\mathbb{V}_{\text{out}}}\hskip-5.0pt\mathcal{V}_{\text{out}})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><munder><mo lspace="0em" movablelimits="false">⋃</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>in</mtext></msub><mo>∈</mo><msub><mi>𝕍</mi><mtext>in</mtext></msub></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>in</mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.267em" rspace="0em">​</mo><mrow><mo movablelimits="false" rspace="0.100em">⋂</mo><mrow><mo stretchy="false">(</mo><mrow><munder><mo lspace="0em" movablelimits="false">⋃</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>in</mtext></msub><mo>∈</mo><msub><mi>𝕍</mi><mtext>out</mtext></msub></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>out</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{V}_{\text{non}}=(\bigcup_{\mathcal{V}_{\text{in}}\in\mathbb{V}_{\text{in}}}\hskip-5.0pt\mathcal{V}_{\text{in}})\hskip 1.00006pt\bigcap\hskip 1.00006pt(\bigcup_{\mathcal{V}_{\text{in}}\in\mathbb{V}_{\text{out}}}\hskip-5.0pt\mathcal{V}_{\text{out}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
</div></li>
<li id="S4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S4.I2.i3.p1" class="ltx_para">
<p id="S4.I2.i3.p1.1" class="ltx_p">The adversary calculates the overfitting signals using the Jaccard index <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite> for each <math id="S4.I2.i3.p1.m1" class="ltx_Math" alttext="J(\mathcal{V}_{\text{in}}\backslash\mathcal{V}_{\text{non}},\mathcal{V}_{\text{target}}\backslash\mathcal{V}_{\text{non}})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>in</mtext></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub></mrow><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>target</mtext></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\mathcal{V}_{\text{in}}\backslash\mathcal{V}_{\text{non}},\mathcal{V}_{\text{target}}\backslash\mathcal{V}_{\text{non}})</annotation></semantics></math> and <math id="S4.I2.i3.p1.m2" class="ltx_Math" alttext="J(\mathcal{V}_{\text{out}}\backslash\mathcal{V}_{\text{non}},\mathcal{V}_{\text{target}}\backslash\mathcal{V}_{\text{non}})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>out</mtext></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub></mrow><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>target</mtext></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\mathcal{V}_{\text{out}}\backslash\mathcal{V}_{\text{non}},\mathcal{V}_{\text{target}}\backslash\mathcal{V}_{\text{non}})</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iv)</span> 
<div id="S4.I2.i4.p1" class="ltx_para">
<p id="S4.I2.i4.p1.1" class="ltx_p">The membership signal for dataset <math id="S4.I2.i4.p1.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is defined as:</p>
<table id="S4.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex1.m1" class="ltx_Math" alttext="\displaystyle\hskip-22.0pt\frac{1}{2}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\hskip-22.0pt\frac{1}{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex1.m2" class="ltx_Math" alttext="\displaystyle+\frac{\sum_{\mathcal{V}_{\text{in}}\in\mathbb{V}_{\text{in}}}{J(\mathcal{V}_{\text{in}}\backslash\mathcal{V}_{\text{non}},\mathcal{V}_{\text{target}}\backslash\mathcal{V}_{\text{non}})}}{2|\mathbb{V}_{\text{in}}|}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>in</mtext></msub><mo>∈</mo><msub><mi>𝕍</mi><mtext>in</mtext></msub></mrow></msub><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>in</mtext></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub></mrow><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>target</mtext></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝕍</mi><mtext>in</mtext></msub><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\sum_{\mathcal{V}_{\text{in}}\in\mathbb{V}_{\text{in}}}{J(\mathcal{V}_{\text{in}}\backslash\mathcal{V}_{\text{non}},\mathcal{V}_{\text{target}}\backslash\mathcal{V}_{\text{non}})}}{2|\mathbb{V}_{\text{in}}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E4.m1" class="ltx_Math" alttext="\displaystyle-\frac{\sum_{\mathcal{V}_{\text{out}}\in\mathbb{V}_{\text{out}}}J(\mathcal{V}_{\text{out}}\backslash\mathcal{V}_{\text{non}},\mathcal{V}_{\text{target}}\backslash\mathcal{V}_{\text{non}})}{2|\mathbb{V}_{\text{out}}|}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>out</mtext></msub><mo>∈</mo><msub><mi>𝕍</mi><mtext>out</mtext></msub></mrow></msub><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>out</mtext></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub></mrow><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>target</mtext></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>non</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝕍</mi><mtext>out</mtext></msub><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\sum_{\mathcal{V}_{\text{out}}\in\mathbb{V}_{\text{out}}}J(\mathcal{V}_{\text{out}}\backslash\mathcal{V}_{\text{non}},\mathcal{V}_{\text{target}}\backslash\mathcal{V}_{\text{non}})}{2|\mathbb{V}_{\text{out}}|},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S4.I2.i4.p1.2" class="ltx_p">where it ranges from 0 to 1.</p>
</div></li>
<li id="S4.I2.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(v)</span> 
<div id="S4.I2.i5.p1" class="ltx_para">
<p id="S4.I2.i5.p1.1" class="ltx_p">If the membership signal is larger than a decision-making threshold <math id="S4.I2.i5.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, output 1 (<span id="S4.I2.i5.p1.1.1" class="ltx_text ltx_font_italic">member</span>). Otherwise, output 0.</p>
</div></li>
</ol>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p">The detailed process of this attack is outlined in Algorithm <a href="#alg1" title="Algorithm 1 ‣ 4.2 Improved MIA via 𝖵𝗈𝖼𝖺𝖻𝗎𝗅𝖺𝗋𝗒⁢𝖮𝗏𝖾𝗋𝗅𝖺𝗉 ‣ 4 Attack Methodology ‣ Membership Inference Attacks on Tokenizers of Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. However, like other shadow-based MIAs <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib94" title="" class="ltx_ref">94</a>, <a href="#bib.bib103" title="" class="ltx_ref">103</a>, <a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite>, we find that MIA via <math id="S4.SS2.p5.m1" class="ltx_Math" alttext="\mathsf{Vocabulary~Overlap}" display="inline" intent=":literal"><semantics><mrow><mi>𝖵𝗈𝖼𝖺𝖻𝗎𝗅𝖺𝗋𝗒</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>𝖮𝗏𝖾𝗋𝗅𝖺𝗉</mi></mrow><annotation encoding="application/x-tex">\mathsf{Vocabulary~Overlap}</annotation></semantics></math> requires multiple shadow tokenizers (e.g., 96) to effectively capture membership signals. As a result, training such a large number of shadow tokenizers incurs a substantial time cost.</p>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3 </span>Efficient MIA via <math id="S4.SS3.m1" class="ltx_Math" alttext="\mathsf{Frequency~Estimation}" display="inline" intent=":literal"><semantics><mrow><mi>𝖥𝗋𝖾𝗊𝗎𝖾𝗇𝖼𝗒</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>𝖤𝗌𝗍𝗂𝗆𝖺𝗍𝗂𝗈𝗇</mi></mrow><annotation encoding="application/x-tex">\mathsf{Frequency~Estimation}</annotation></semantics></math></h3>

<figure id="S4.F4" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S4.F4.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.05699v1/intial_80000_obs.svg" id="S4.F4.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:342/250;" width="342" height="250"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F4.sf1.3" class="ltx_text" style="font-size:80%;">(a)</span> </span><span id="S4.F4.sf1.4" class="ltx_text" style="font-size:80%;">Vocabulary Size: <math id="S4.F4.sf1.m2" class="ltx_Math" alttext="80\text{,\,}000" display="inline" intent=":literal"><semantics><mrow><mn>80</mn><mo lspace="0em" rspace="0em">​</mo><mtext>, </mtext><mo lspace="0em" rspace="0em">​</mo><mn>000</mn></mrow><annotation encoding="application/x-tex">80\text{,\,}000</annotation></semantics></math></span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S4.F4.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.05699v1/intial_140000_obs.svg" id="S4.F4.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:342/249;" width="342" height="249"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F4.sf2.3" class="ltx_text" style="font-size:80%;">(b)</span> </span><span id="S4.F4.sf2.4" class="ltx_text" style="font-size:80%;">Vocabulary Size: <math id="S4.F4.sf2.m2" class="ltx_Math" alttext="140\text{,\,}000" display="inline" intent=":literal"><semantics><mrow><mn>140</mn><mo lspace="0em" rspace="0em">​</mo><mtext>, </mtext><mo lspace="0em" rspace="0em">​</mo><mn>000</mn></mrow><annotation encoding="application/x-tex">140\text{,\,}000</annotation></semantics></math></span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>Distinctive tokens in MIA via <math id="S4.F4.m2" class="ltx_Math" alttext="\mathsf{Vocabulary~Overlap}" display="inline" intent=":literal"><semantics><mrow><mi>𝖵𝗈𝖼𝖺𝖻𝗎𝗅𝖺𝗋𝗒</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>𝖮𝗏𝖾𝗋𝗅𝖺𝗉</mi></mrow><annotation encoding="application/x-tex">\mathsf{Vocabulary~Overlap}</annotation></semantics></math>.</figcaption>
</figure>
<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">MIA via <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="\mathsf{Vocabulary~Overlap}" display="inline" intent=":literal"><semantics><mrow><mi>𝖵𝗈𝖼𝖺𝖻𝗎𝗅𝖺𝗋𝗒</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>𝖮𝗏𝖾𝗋𝗅𝖺𝗉</mi></mrow><annotation encoding="application/x-tex">\mathsf{Vocabulary~Overlap}</annotation></semantics></math> raises a natural question: Can we design an attack that relies on fewer shadow tokenizers and thus reduces the overall time cost? To address this, we investigate whether it is possible to identify distinctive tokens directly by analyzing their statistical characteristics. Motivated by this, we examine such distinctive tokens and derive two key insights: ❶ The distinctive tokens of dataset <math id="S4.SS3.p1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> appear infrequently in the training data of the tokenizer trained on <math id="S4.SS3.p1.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>. ❷ As shown in Figure <a href="#S4.F4" title="Figure 4 ‣ 4.3 Efficient MIA via 𝖥𝗋𝖾𝗊𝗎𝖾𝗇𝖼𝗒⁢𝖤𝗌𝗍𝗂𝗆𝖺𝗍𝗂𝗈𝗇 ‣ 4 Attack Methodology ‣ Membership Inference Attacks on Tokenizers of Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> and Figure <a href="#A1.F12" title="Figure 12 ‣ Appendix A Proof of Theorem ‣ Membership Inference Attacks on Tokenizers of Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>, the majority of occurrences of these distinctive tokens in the underlying distribution <math id="S4.SS3.p1.m4" class="ltx_Math" alttext="\mathbb{D}" display="inline" intent=":literal"><semantics><mi>𝔻</mi><annotation encoding="application/x-tex">\mathbb{D}</annotation></semantics></math> are found in the dataset <math id="S4.SS3.p1.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>.
Given these characteristics, if dataset <math id="S4.SS3.p1.m6" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is excluded from the tokenizer’s training data, the frequency of such distinctive tokens becomes lower. As a result, these tokens with low frequency are unlikely to be merged into the vocabulary during tokenizer training, since BPE primarily merges the most frequent tokens.
This observation suggests that including dataset <math id="S4.SS3.p1.m7" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> in the training data is almost a necessary condition for some tokens to be merged into the tokenizer’s vocabulary. Motivated by these insights, we introduce the MIA via <math id="S4.SS3.p1.m8" class="ltx_Math" alttext="\mathsf{Frequency~Estimation}" display="inline" intent=":literal"><semantics><mrow><mi>𝖥𝗋𝖾𝗊𝗎𝖾𝗇𝖼𝗒</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>𝖤𝗌𝗍𝗂𝗆𝖺𝗍𝗂𝗈𝗇</mi></mrow><annotation encoding="application/x-tex">\mathsf{Frequency~Estimation}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p2" class="ltx_para ltx_noindent">
<p id="S4.SS3.p2.1" class="ltx_p"><span id="S4.SS3.p2.1.1" class="ltx_text ltx_font_bold">Design Intuition.</span>   It is hypothesized that tokenizer training probably exhibits overfitting by incorporating distinctive tokens from the training datasets into its vocabulary <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>, <a href="#bib.bib65" title="" class="ltx_ref">65</a>]</cite>. Building on this intuition, an adversary could exploit such overfitting by evaluating whether including dataset <math id="S4.SS3.p2.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> in the training data is necessary for the merging of some tokens in vocabulary <math id="S4.SS3.p2.m2" class="ltx_Math" alttext="\mathcal{V}_{\text{target}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>target</mtext></msub><annotation encoding="application/x-tex">\mathcal{V}_{\text{target}}</annotation></semantics></math>. If the presence of such distinctive tokens in <math id="S4.SS3.p2.m3" class="ltx_Math" alttext="\mathcal{V}_{\text{target}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext>target</mtext></msub><annotation encoding="application/x-tex">\mathcal{V}_{\text{target}}</annotation></semantics></math> strongly depends on dataset <math id="S4.SS3.p2.m4" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, it is likely <math id="S4.SS3.p2.m5" class="ltx_Math" alttext="D\in\mathcal{D}_{\textup{mem}}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>mem</mtext></msub></mrow><annotation encoding="application/x-tex">D\in\mathcal{D}_{\textup{mem}}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p3" class="ltx_para ltx_noindent">
<p id="S4.SS3.p3.1" class="ltx_p"><span id="S4.SS3.p3.1.1" class="ltx_text ltx_font_bold">Necessity Evaluation.</span>   However, no existing metric evaluates this necessity. To fill this gap, we introduce a new metric: Relative Token Frequency with Self-information (RTF-SI).</p>
</div>
<div id="S4.Thmexample1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmexample1.2" class="ltx_text ltx_font_bold">Definition 4.1</span></span><span id="S4.Thmexample1.3" class="ltx_text ltx_font_bold"> </span>(<span id="S4.Thmexample1.4" class="ltx_text ltx_font_bold">Relative Token Frequency with Self-information</span>)<span id="S4.Thmexample1.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmexample1.p1" class="ltx_para">
<p id="S4.Thmexample1.p1.1" class="ltx_p"><span id="S4.Thmexample1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmexample1.p1.m1" class="ltx_Math" alttext="\mathbb{D}" display="inline" intent=":literal"><semantics><mi>𝔻</mi><annotation encoding="application/x-tex">\mathbb{D}</annotation></semantics></math> denote a data distribution. Given a dataset <math id="S4.Thmexample1.p1.m2" class="ltx_Math" alttext="D\subseteq\mathbb{D}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊆</mo><mi>𝔻</mi></mrow><annotation encoding="application/x-tex">D\subseteq\mathbb{D}</annotation></semantics></math> and a target tokenizer’s vocabulary <math id="S4.Thmexample1.p1.m3" class="ltx_Math" alttext="\mathcal{V}_{\text{target}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub><annotation encoding="application/x-tex">\mathcal{V}_{\text{target}}</annotation></semantics></math>, the Relative Token Frequency with Self-Information (RTF-SI) of a token <math id="S4.Thmexample1.p1.m4" class="ltx_Math" alttext="t_{i}\in\mathcal{V}_{\text{target}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>i</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub></mrow><annotation encoding="application/x-tex">t_{i}\in\mathcal{V}_{\text{target}}</annotation></semantics></math> in <math id="S4.Thmexample1.p1.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is defined as:</span></p>
<table id="S4.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E5.m1" class="ltx_Math" alttext="\mathrm{RTF\text{-}SI}(D,t_{i},\mathcal{V}_{\text{target}}):=\operatorname{RTF}(t_{i},D)\cdot\operatorname{SI}(t_{i},\mathcal{V}_{\text{target}})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>RTF</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>SI</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><msub><mi>t</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>RTF</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo>,</mo><mi>D</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>SI</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{RTF\text{-}SI}(D,t_{i},\mathcal{V}_{\text{target}}):=\operatorname{RTF}(t_{i},D)\cdot\operatorname{SI}(t_{i},\mathcal{V}_{\text{target}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S4.Thmexample1.p1.2" class="ltx_p"><span id="S4.Thmexample1.p1.2.1" class="ltx_text ltx_font_italic">where the relative token frequency (RTF) is calculated as:</span></p>
<table id="S4.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E6.m1" class="ltx_Math" alttext="\operatorname{RTF}(t_{i},D)=\frac{n_{D}(t_{i})}{\sum_{D^{\prime}\in\mathbb{D}}n_{D^{\prime}}(t_{i})}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>RTF</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo>,</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>n</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mo>∑</mo><mrow><msup><mi>D</mi><mo>′</mo></msup><mo>∈</mo><mi>𝔻</mi></mrow></msub><mrow><msub><mi>n</mi><msup><mi>D</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{RTF}(t_{i},D)=\frac{n_{D}(t_{i})}{\sum_{D^{\prime}\in\mathbb{D}}n_{D^{\prime}}(t_{i})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S4.Thmexample1.p1.3" class="ltx_p"><span id="S4.Thmexample1.p1.3.1" class="ltx_text ltx_font_italic">with <math id="S4.Thmexample1.p1.m6" class="ltx_Math" alttext="n_{D}(t_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">n_{D}(t_{i})</annotation></semantics></math> denoting the count of token <math id="S4.Thmexample1.p1.m7" class="ltx_Math" alttext="t_{i}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>i</mi></msub><annotation encoding="application/x-tex">t_{i}</annotation></semantics></math> in the dataset <math id="S4.Thmexample1.p1.m8" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>. The self-information (SI) is given by:</span></p>
<table id="S4.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E7.m1" class="ltx_Math" alttext="\operatorname{SI}(t_{i},\mathcal{V}_{\text{target}})=-\log\Pr\left(t_{i}\mid\mathcal{V}_{\text{target}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>SI</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>t</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{SI}(t_{i},\mathcal{V}_{\text{target}})=-\log\Pr\left(t_{i}\mid\mathcal{V}_{\text{target}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S4.Thmexample1.p1.4" class="ltx_p"><span id="S4.Thmexample1.p1.4.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmexample1.p1.m9" class="ltx_Math" alttext="\Pr\left(t_{i}\mid\mathcal{V}_{\text{target}}\right)" display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>t</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\Pr\left(t_{i}\mid\mathcal{V}_{\text{target}}\right)</annotation></semantics></math> is the frequency of token <math id="S4.Thmexample1.p1.m10" class="ltx_Math" alttext="t_{i}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>i</mi></msub><annotation encoding="application/x-tex">t_{i}</annotation></semantics></math> appearing in the training data <math id="S4.Thmexample1.p1.m11" class="ltx_Math" alttext="\mathcal{D}_{\textup{mem}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>mem</mtext></msub><annotation encoding="application/x-tex">\mathcal{D}_{\textup{mem}}</annotation></semantics></math> associated with the vocabulary <math id="S4.Thmexample1.p1.m12" class="ltx_Math" alttext="\mathcal{V}_{\text{target}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub><annotation encoding="application/x-tex">\mathcal{V}_{\text{target}}</annotation></semantics></math>. Ideally, this probability is computed as:</span></p>
<table id="S4.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E8.m1" class="ltx_Math" alttext="\Pr\left(t_{i}\mid\mathcal{V}_{\text{target}}\right)=\frac{\sum_{D^{\prime}\in\mathcal{D}_{\textup{mem}}}n_{D^{\prime}}(t_{i})}{\sum_{t^{\prime}\in\mathcal{V}_{\text{target}}}\sum_{D^{\prime}\in\mathcal{D}_{\textup{mem}}}n_{D^{\prime}}(t^{\prime})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>t</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>D</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>mem</mtext></msub></mrow></msub><mrow><msub><mi>n</mi><msup><mi>D</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mo>∑</mo><mrow><msup><mi>t</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mtext class="ltx_mathvariant_italic">target</mtext></msub></mrow></msub><mrow><msub><mo lspace="0.167em">∑</mo><mrow><msup><mi>D</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>mem</mtext></msub></mrow></msub><mrow><msub><mi>n</mi><msup><mi>D</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pr\left(t_{i}\mid\mathcal{V}_{\text{target}}\right)=\frac{\sum_{D^{\prime}\in\mathcal{D}_{\textup{mem}}}n_{D^{\prime}}(t_{i})}{\sum_{t^{\prime}\in\mathcal{V}_{\text{target}}}\sum_{D^{\prime}\in\mathcal{D}_{\textup{mem}}}n_{D^{\prime}}(t^{\prime})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div>
</div>
