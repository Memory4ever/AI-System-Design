<td id="S5.T2.2.1.8.10" class="ltx_td ltx_align_center"><span id="S5.T2.2.1.8.10.1" class="ltx_text ltx_font_bold">0.736</span></td>
<td id="S5.T2.2.1.8.11" class="ltx_td ltx_align_center"><span id="S5.T2.2.1.8.11.1" class="ltx_text ltx_font_bold">0.696</span></td>
<td id="S5.T2.2.1.8.12" class="ltx_td ltx_align_center"><span id="S5.T2.2.1.8.12.1" class="ltx_text ltx_font_bold">29.72%</span></td>
