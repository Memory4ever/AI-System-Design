<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F5.sf4.3" class="ltx_text" style="font-size:80%;">(d)</span> </span><span id="S4.F5.sf4.4" class="ltx_text" style="font-size:80%;">Vocabulary Size: <math id="S4.F5.sf4.m2" class="ltx_Math" alttext="170\text{,\,}000" display="inline" intent=":literal"><semantics><mrow><mn>170</mn><mo lspace="0em" rspace="0em">​</mo><mtext>, </mtext><mo lspace="0em" rspace="0em">​</mo><mn>000</mn></mrow><annotation encoding="application/x-tex">170\text{,\,}000</annotation></semantics></math></span></figcaption>
