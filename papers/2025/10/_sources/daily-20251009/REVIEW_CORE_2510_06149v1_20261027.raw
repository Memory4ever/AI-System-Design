<tbody id="A2.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex63.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\beta^{2}\tau_{\beta}\sum_{i=0}^{2\tau_{\beta}}(1-\beta\gamma\Delta)^{t-i}+\beta\tau_{\beta}\sum_{i=0}^{2\tau_{\beta}}(1-\beta\gamma\Delta)^{t-i}q^{i}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup><msub><mi>τ</mi><mi>β</mi></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub></mrow></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mi>γ</mi><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup><mo>+</mo><mi>β</mi><msub><mi>τ</mi><mi>β</mi></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub></mrow></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mi>γ</mi><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup><msup><mi>q</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\beta^{2}\tau_{\beta}\sum_{i=0}^{2\tau_{\beta}}(1-\beta\gamma\Delta)^{t-i}+\beta\tau_{\beta}\sum_{i=0}^{2\tau_{\beta}}(1-\beta\gamma\Delta)^{t-i}q^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex64.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\beta(\beta\tau_{\beta}+q^{\tau_{\beta}})\sum_{i=2\tau_{\beta}+1}^{t}(1-\beta\gamma\Delta)^{t-i}+\beta\tau_{\beta}\sum_{i=2\tau_{\beta}+1}^{t}(1-\beta\gamma\Delta)^{t-i}q^{i}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>β</mi><msub><mi>τ</mi><mi>β</mi></msub><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><mi>β</mi></msub></msup><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mi>γ</mi><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup><mo>+</mo><mi>β</mi><msub><mi>τ</mi><mi>β</mi></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mi>γ</mi><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup><msup><mi>q</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\beta(\beta\tau_{\beta}+q^{\tau_{\beta}})\sum_{i=2\tau_{\beta}+1}^{t}(1-\beta\gamma\Delta)^{t-i}+\beta\tau_{\beta}\sum_{i=2\tau_{\beta}+1}^{t}(1-\beta\gamma\Delta)^{t-i}q^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex65.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\beta^{2}\sum_{i=0}^{t}(1-\beta\gamma\Delta)^{t-i}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mi>β</mi><mn>2</mn></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mi>γ</mi><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\beta^{2}\sum_{i=0}^{t}(1-\beta\gamma\Delta)^{t-i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex66.m1" class="ltx_Math" alttext="\displaystyle\lesssim(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\frac{\beta\tau_{\beta}}{\gamma\Delta}+\beta\tau_{\beta}^{2}h^{t}+\frac{\beta\tau_{\beta}+q^{\tau_{\beta}}}{\gamma\Delta}+\beta\tau_{\beta}th^{t}+\frac{\beta}{\gamma\Delta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub></mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mi>β</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mi>t</mi></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><mi>β</mi></msub></msup></mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mi>t</mi></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\frac{\beta\tau_{\beta}}{\gamma\Delta}+\beta\tau_{\beta}^{2}h^{t}+\frac{\beta\tau_{\beta}+q^{\tau_{\beta}}}{\gamma\Delta}+\beta\tau_{\beta}th^{t}+\frac{\beta}{\gamma\Delta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p3.2" class="ltx_p">where in the second inequality, we used Lemma <a href="#A3.Thmtheorem14" title="Lemma C.14. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.14</span></a> and Lemma <a href="#A3.Thmtheorem15" title="Lemma C.15. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.15</span></a> with <math id="A2.SS1.p3.m1" class="ltx_Math" alttext="q=\max\{\rho,\lambda\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>ρ</mi><mo>,</mo><mi>λ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q=\max\{\rho,\lambda\}</annotation></semantics></math>. In the last inequality, we used <math id="A2.SS1.p3.m2" class="ltx_Math" alttext="h=\max\left\{1-\beta\gamma\Delta,~\rho,~\lambda\right\}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo rspace="0.497em">,</mo><mi>ρ</mi><mo rspace="0.497em">,</mo><mi>λ</mi></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h=\max\left\{1-\beta\gamma\Delta,~\rho,~\lambda\right\}</annotation></semantics></math>. Summarizing the terms, we get</p>
<table id="A2.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex67.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\lesssim(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\mathcal{O}\left(\beta\tau_{\beta}+h^{\tau_{\beta}}+\beta\tau_{\beta}th^{t}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≲</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub></mrow><mo>+</mo><msup><mi>h</mi><msub><mi>τ</mi><mi>β</mi></msub></msup><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mi>t</mi></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\lesssim(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\mathcal{O}\left(\beta\tau_{\beta}+h^{\tau_{\beta}}+\beta\tau_{\beta}th^{t}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p3.3" class="ltx_p">∎</p>
</div>
<div id="A2.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem B.3</span></span><span id="A2.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem3.p1" class="ltx_para">
<p id="A2.Thmtheorem3.p1.1" class="ltx_p"><span id="A2.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Suppose the Markov chain <math id="A2.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\{S^{\mu}_{t}\}_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{S^{\mu}_{t}\}_{t\in\mathbb{N}}</annotation></semantics></math> is uniformly geometrically ergodic with a rate parameter <math id="A2.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\rho\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in(0,1)</annotation></semantics></math> and the step-size ratio parameter is chosen to satisfy <math id="A2.Thmtheorem3.p1.m3" class="ltx_Math" alttext="c_{\alpha}\geq\Delta+\sqrt{\frac{1}{\Delta^{2}(1-\lambda)^{4}}-\frac{1}{(1-\lambda)^{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>≥</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">c_{\alpha}\geq\Delta+\sqrt{\frac{1}{\Delta^{2}(1-\lambda)^{4}}-\frac{1}{(1-\lambda)^{2}}}</annotation></semantics></math>. With <math id="A2.Thmtheorem3.p1.m4" class="ltx_Math" alttext="\lambda\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in[0,1)</annotation></semantics></math> and decreasing step-sizes <math id="A2.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\beta_{t}=\frac{\beta_{0}}{(t+1)^{s}},~s\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>=</mo><mfrac><msub><mi>β</mi><mn>0</mn></msub><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mrow><mo rspace="0.497em">,</mo><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}=\frac{\beta_{0}}{(t+1)^{s}},~s\in(0,1)</annotation></semantics></math>, the iterates of the projected average-reward implicit TD(<math id="A2.Thmtheorem3.p1.m6" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) algorithm satisfy the following finite-time error bound, for <math id="A2.Thmtheorem3.p1.m7" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>,</span></p>
<table id="A2.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex68.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\lesssim\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\mathcal{O}\left\{\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\tau_{\beta_{t}}t^{-s}+q^{\tau_{\beta_{t}}}\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≲</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow><mo>}</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\lesssim\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\mathcal{O}\left\{\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\tau_{\beta_{t}}t^{-s}+q^{\tau_{\beta_{t}}}\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem3.p1.2" class="ltx_p"><span id="A2.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">for some constant <math id="A2.Thmtheorem3.p1.m8" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>,
<math id="A2.Thmtheorem3.p1.m9" class="ltx_Math" alttext="\gamma_{0}=\min\left\{\frac{1}{1+c_{\alpha}\beta_{0}},\frac{(1-\lambda)^{2}}{(1-\lambda)^{2}+\beta_{0}}\right\}~\text{and}~q=\max\{\rho,\lambda\}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></mrow></mfrac><mo>,</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></mfrac><mo>}</mo></mrow></mrow><mo lspace="0.330em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">and</mtext><mo lspace="0.330em" rspace="0em">​</mo><mi>q</mi></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>ρ</mi><mo>,</mo><mi>λ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma_{0}=\min\left\{\frac{1}{1+c_{\alpha}\beta_{0}},\frac{(1-\lambda)^{2}}{(1-\lambda)^{2}+\beta_{0}}\right\}~\text{and}~q=\max\{\rho,\lambda\}.</annotation></semantics></math></span></p>
</div>
</div>
<div id="A2.SS1.p4" class="ltx_para ltx_noindent">
<p id="A2.SS1.p4.1" class="ltx_p"><span id="A2.SS1.p4.1.1" class="ltx_text ltx_font_bold">Proof.</span> Starting from (<a href="#A2.E16" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) with the identity <math id="A2.SS1.p4.m1" class="ltx_Math" alttext="1-\beta_{i}\gamma_{i}\Delta\leq\exp(-\beta_{i}\gamma_{i}\Delta)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi>β</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\beta_{i}\gamma_{i}\Delta\leq\exp(-\beta_{i}\gamma_{i}\Delta)</annotation></semantics></math> for all <math id="A2.SS1.p4.m2" class="ltx_Math" alttext="i\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">i\in\mathbb{N}</annotation></semantics></math>, we have</p>
<table id="A2.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex69.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex69.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\exp\left(-\Delta\sum_{i=0}^{t}\beta_{i}\gamma_{i}\right)\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msub><mi>β</mi><mi>i</mi></msub><msub><mi>γ</mi><mi>i</mi></msub><mo>)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><msup><mo lspace="0em">∥</mo><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\left(-\Delta\sum_{i=0}^{t}\beta_{i}\gamma_{i}\right)\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex70.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+2\sum_{i=0}^{t}\exp\left(-\Delta\sum_{k=i+1}^{t}\beta_{k}\gamma_{k}\right)\beta_{i}\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})+\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msub><mi>β</mi><mi>k</mi></msub><msub><mi>γ</mi><mi>k</mi></msub><mo>)</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+2\sum_{i=0}^{t}\exp\left(-\Delta\sum_{k=i+1}^{t}\beta_{k}\gamma_{k}\right)\beta_{i}\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})+\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex71.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+G\sum_{i=0}^{t}\exp\left(-\Delta\sum_{k=i+1}^{t}\beta_{k}\gamma_{k}\right)\beta^{2}_{i}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>G</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msub><mi>β</mi><mi>k</mi></msub><msub><mi>γ</mi><mi>k</mi></msub><mo>)</mo></mrow><msubsup><mi>β</mi><mi>i</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+G\sum_{i=0}^{t}\exp\left(-\Delta\sum_{k=i+1}^{t}\beta_{k}\gamma_{k}\right)\beta^{2}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex72.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\exp\left(-\Delta\gamma_{0}\sum_{i=0}^{t}\beta_{i}\right)\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msub><mi>β</mi><mi>i</mi></msub><mo>)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><msup><mo lspace="0em">∥</mo><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\left(-\Delta\gamma_{0}\sum_{i=0}^{t}\beta_{i}\right)\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex73.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+2\sum_{i=0}^{t}\exp\left(-\Delta\gamma_{0}\sum_{k=i+1}^{t}\beta_{k}\right)\beta_{i}\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})+\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msub><mi>β</mi><mi>k</mi></msub><mo>)</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+2\sum_{i=0}^{t}\exp\left(-\Delta\gamma_{0}\sum_{k=i+1}^{t}\beta_{k}\right)\beta_{i}\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})+\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex74.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+G\sum_{i=0}^{t}\exp\left(-\Delta\gamma_{0}\sum_{k=i+1}^{t}\beta_{k}\right)\beta^{2}_{i}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>G</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msub><mi>β</mi><mi>k</mi></msub><mo>)</mo></mrow><msubsup><mi>β</mi><mi>i</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+G\sum_{i=0}^{t}\exp\left(-\Delta\gamma_{0}\sum_{k=i+1}^{t}\beta_{k}\right)\beta^{2}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p4.2" class="ltx_p">where the second inequality follows from the fact that <math id="A2.SS1.p4.m3" class="ltx_Math" alttext="\gamma_{i}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\gamma_{i}</annotation></semantics></math> is increasing. The final expression can be re-expressed as</p>
<table id="A2.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E17.m1" class="ltx_math_unparsed" alttext="\displaystyle\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{i=0}^{t}\frac{1}{(i+1)^{s}}\right\}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><msup><mo lspace="0em">∥</mo><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{i=0}^{t}\frac{1}{(i+1)^{s}}\right\}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
<tbody id="A2.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E18.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+2\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})+\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+2\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})+\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
<tbody id="A2.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E19.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+G\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta^{2}_{i}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>G</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msubsup><mi>β</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+G\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta^{2}_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p4.3" class="ltx_p">The first term in (<a href="#A2.E17" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) admits the following bound</p>
<table id="A2.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E20.m1" class="ltx_math_unparsed" alttext="\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{i=0}^{t}\frac{1}{(i+1)^{s}}\right\}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}\leq\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}." display="block" intent=":literal"><semantics><mrow><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac><mo>}</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><msup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msup><mo lspace="0.0835em">≤</mo><mi>exp</mi><mrow><mo>[</mo><mo lspace="0em">−</mo><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac><mrow><mo stretchy="false">{</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><msup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{i=0}^{t}\frac{1}{(i+1)^{s}}\right\}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}\leq\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p5" class="ltx_para ltx_noindent">
<p id="A2.SS1.p5.1" class="ltx_p">For the second term in (<a href="#A2.E18" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>), we first note that</p>
<table id="A2.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex76.m1" class="ltx_math_unparsed" alttext="\displaystyle 2\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})+\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})+\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_math_unparsed" alttext="\displaystyle\lesssim\sum_{i=0}^{2\tau_{\beta_{t}}}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\left(\tau_{\beta_{t}}\beta_{0}+iq^{i}\right)" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mrow><mo>(</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msub><mi>β</mi><mn>0</mn></msub><mo>+</mo><mi>i</mi><msup><mi>q</mi><mi>i</mi></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\sum_{i=0}^{2\tau_{\beta_{t}}}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\left(\tau_{\beta_{t}}\beta_{0}+iq^{i}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex78.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\left(\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mrow><mo>(</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>+</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>q</mi><mi>i</mi></msup><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\left(\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E21.m1" class="ltx_math_unparsed" alttext="\displaystyle\lesssim\tau_{\beta_{t}}\beta_{0}\sum_{i=0}^{2\tau_{\beta_{t}}}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\tau_{\beta_{t}}\beta_{0}\sum_{i=0}^{2\tau_{\beta_{t}}}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
<tbody id="A2.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E22.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\tau_{\beta_{t}}\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><msup><mi>q</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\tau_{\beta_{t}}\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
<tbody id="A2.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E23.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\tau_{\beta_{t}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\beta_{i-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\tau_{\beta_{t}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\beta_{i-2\tau_{\beta_{t}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
<tbody id="A2.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E24.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+q^{\tau_{\beta_{t}}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+q^{\tau_{\beta_{t}}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p5.2" class="ltx_p">where we used Lemma <a href="#A3.Thmtheorem14" title="Lemma C.14. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.14</span></a> and Lemma <a href="#A3.Thmtheorem15" title="Lemma C.15. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.15</span></a> in the first inequality. We first establish an upper bound on (<a href="#A2.E21" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) using Lemma <a href="#A3.Thmtheorem17" title="Lemma C.17. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.17</span></a>.</p>
<table id="A2.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex79.m1" class="ltx_math_unparsed" alttext="\displaystyle\tau_{\beta_{t}}\beta_{0}\sum_{i=0}^{2\tau_{\beta_{t}}}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\tau_{\beta_{t}}\beta_{0}\sum_{i=0}^{2\tau_{\beta_{t}}}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex79.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\tau_{\beta_{t}}\beta_{0}e^{\Delta\gamma_{0}\beta_{0}}}{\Delta\gamma_{0}}\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{(1-s)}\left\{(1+t)^{1-s}-(1+2\tau_{\beta_{t}})^{1-s}\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo>}</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\tau_{\beta_{t}}\beta_{0}e^{\Delta\gamma_{0}\beta_{0}}}{\Delta\gamma_{0}}\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{(1-s)}\left\{(1+t)^{1-s}-(1+2\tau_{\beta_{t}})^{1-s}\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle\lesssim\tau_{\beta_{t}}\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{(1-s)}\left\{(1+t)^{1-s}-(1+2\tau_{\beta_{t}})^{1-s}\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo>}</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\tau_{\beta_{t}}\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{(1-s)}\left\{(1+t)^{1-s}-(1+2\tau_{\beta_{t}})^{1-s}\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p6" class="ltx_para ltx_noindent">
<p id="A2.SS1.p6.1" class="ltx_p">Next, we obtain an upper bound on (<a href="#A2.E22" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>). To this end, consider</p>
<table id="A2.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E25.m1" class="ltx_math_unparsed" alttext="\displaystyle\tau_{\beta_{t}}\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><msup><mi>q</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\tau_{\beta_{t}}\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E25.m2" class="ltx_math_unparsed" alttext="\displaystyle=\tau_{\beta_{t}}\sum_{i=0}^{\left\lfloor t/2\right\rfloor}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mo>⌊</mo><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo>⌋</mo></mrow></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><msup><mi>q</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\tau_{\beta_{t}}\sum_{i=0}^{\left\lfloor t/2\right\rfloor}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
<tbody id="A2.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E26.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\tau_{\beta_{t}}\sum_{i=\left\lfloor t/2\right\rfloor+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mo>⌊</mo><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo>⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><msup><mi>q</mi><mi>i</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\tau_{\beta_{t}}\sum_{i=\left\lfloor t/2\right\rfloor+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p6.2" class="ltx_p">The term in (<a href="#A2.E25" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>) admits the following bound</p>
<table id="A2.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex81.m1" class="ltx_math_unparsed" alttext="\displaystyle\eqref{decr_err_second_first}\leq\tau_{\beta_{t}}\beta_{0}\sum_{i=0}^{\left\lfloor t/2\right\rfloor}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=\left\lfloor t/2\right\rfloor+1}^{t}\frac{1}{(k+1)^{s}}\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><mtext>(</mtext><mtext><a href="#A2.E25" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a></mtext><mtext>)</mtext></mrow><mo>≤</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mo>⌊</mo><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo>⌋</mo></mrow></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mrow><mo>⌊</mo><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo>⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eqref{decr_err_second_first}\leq\tau_{\beta_{t}}\beta_{0}\sum_{i=0}^{\left\lfloor t/2\right\rfloor}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=\left\lfloor t/2\right\rfloor+1}^{t}\frac{1}{(k+1)^{s}}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p6.3" class="ltx_p">Since</p>
<table id="A2.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex82.m1" class="ltx_Math" alttext="\sum_{k=\left\lfloor t/2\right\rfloor+1}^{t}\frac{1}{(k+1)^{s}}\geq\int_{\left\lfloor t/2\right\rfloor+1}^{t}x^{-s}dx\geq\frac{t^{1-s}-(t/2+1)^{1-s}}{1-s}=\Omega\left(t^{1-s}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mrow><mo>⌊</mo><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo>⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mrow><mo rspace="0.111em">≥</mo><mrow><msubsup><mo>∫</mo><mrow><mrow><mo>⌊</mo><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo>⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><msup><mi>x</mi><mrow><mo>−</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>≥</mo><mfrac><mrow><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac><mo>=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{k=\left\lfloor t/2\right\rfloor+1}^{t}\frac{1}{(k+1)^{s}}\geq\int_{\left\lfloor t/2\right\rfloor+1}^{t}x^{-s}dx\geq\frac{t^{1-s}-(t/2+1)^{1-s}}{1-s}=\Omega\left(t^{1-s}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p6.4" class="ltx_p">we have</p>
<table id="A2.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex83.m1" class="ltx_Math" alttext="\eqref{decr_err_second_first}\lesssim\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>(</mtext><mtext><a href="#A2.E25" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a></mtext><mtext>)</mtext></mrow><mo>≲</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\eqref{decr_err_second_first}\lesssim\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p6.5" class="ltx_p">for some constant <math id="A2.SS1.p6.m1" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>. For the term in (<a href="#A2.E26" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>), we have</p>
<table id="A2.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex84.m1" class="ltx_Math" alttext="\eqref{decr_err_second_second}\leq\tau_{\beta_{t}}\sum_{i=\left\lfloor t/2\right\rfloor+1}^{t}\beta_{i}q^{i}\leq\tau_{\beta_{t}}\sum_{i=\left\lfloor t/2\right\rfloor+1}^{t}\frac{\beta_{0}}{(t/2)^{s}}q^{i}\lesssim\frac{\tau_{\beta_{t}}}{t^{s}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>(</mtext><mtext><a href="#A2.E26" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a></mtext><mtext>)</mtext></mrow><mo>≤</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mo>⌊</mo><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo>⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><mrow><msub><mi>β</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mo>⌊</mo><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo>⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><mrow><mfrac><msub><mi>β</mi><mn>0</mn></msub><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow></mrow></mrow><mo>≲</mo><mfrac><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>t</mi><mi>s</mi></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\eqref{decr_err_second_second}\leq\tau_{\beta_{t}}\sum_{i=\left\lfloor t/2\right\rfloor+1}^{t}\beta_{i}q^{i}\leq\tau_{\beta_{t}}\sum_{i=\left\lfloor t/2\right\rfloor+1}^{t}\frac{\beta_{0}}{(t/2)^{s}}q^{i}\lesssim\frac{\tau_{\beta_{t}}}{t^{s}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p6.6" class="ltx_p">And hence, we get the bound for (<a href="#A2.E22" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), given by</p>
<table id="A2.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex85.m1" class="ltx_math_unparsed" alttext="\tau_{\beta_{t}}\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}\lesssim\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\frac{\tau_{\beta_{t}}}{t^{s}}." display="block" intent=":literal"><semantics><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><msup><mi>q</mi><mi>i</mi></msup><mo>≲</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mi>t</mi><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>c</mi><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>)</mo></mrow><mo>+</mo><mfrac><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>t</mi><mi>s</mi></msup></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tau_{\beta_{t}}\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}q^{i}\lesssim\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\frac{\tau_{\beta_{t}}}{t^{s}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p6.7" class="ltx_p">Next, we obtain an upper bound on (<a href="#A2.E23" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>). From Lemma <a href="#A3.Thmtheorem17" title="Lemma C.17. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.17</span></a>,</p>
<table id="A2.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex86.m1" class="ltx_math_unparsed" alttext="\displaystyle\tau_{\beta_{t}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\beta_{i-2\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}\left(\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{2(1-s)}\left\{(t+1)^{1-s}-1\right\}\right]+\beta_{t-2\tau_{\beta_{t}}}\right)." display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>≲</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mrow><mo>(</mo><mi>exp</mi><mrow><mo>[</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo>{</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn><mo>}</mo></mrow><mo>]</mo></mrow><mo>+</mo><msub><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tau_{\beta_{t}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\beta_{i-2\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}\left(\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{2(1-s)}\left\{(t+1)^{1-s}-1\right\}\right]+\beta_{t-2\tau_{\beta_{t}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p7" class="ltx_para ltx_noindent">
<p id="A2.SS1.p7.1" class="ltx_p">The only remaining term is the one in (<a href="#A2.E24" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>), whose bound is given by</p>
<table id="A2.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex87.m1" class="ltx_math_unparsed" alttext="\displaystyle q^{\tau_{\beta_{t}}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\lesssim q^{\tau_{\beta_{t}}}," display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mo>≲</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle q^{\tau_{\beta_{t}}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta_{i}\lesssim q^{\tau_{\beta_{t}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p7.2" class="ltx_p">where we have used (<a href="#A3.E53" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>). Combining altogether to obtain a bound of (<a href="#A2.E18" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>), we get</p>
<table id="A2.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="A2.Ex88.1.1" class="ltx_text ltx_markedasmath">(<a href="#A2.E18" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>)</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex88.m2" class="ltx_Math" alttext="\displaystyle\lesssim\tau_{\beta_{t}}\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{(1-s)}\left\{(1+t)^{1-s}-(1+2\tau_{\beta_{t}})^{1-s}\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo>}</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\tau_{\beta_{t}}\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{(1-s)}\left\{(1+t)^{1-s}-(1+2\tau_{\beta_{t}})^{1-s}\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex89.m1" class="ltx_Math" alttext="\displaystyle\quad+\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\frac{\tau_{\beta_{t}}}{t^{s}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>t</mi><mi>s</mi></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\frac{\tau_{\beta_{t}}}{t^{s}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex90.m1" class="ltx_Math" alttext="\displaystyle\quad+\tau_{\beta_{t}}\left(\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{2(1-s)}\left\{(1+t)^{1-s}-1\right\}\right]+\beta_{t-2\tau_{\beta_{t}}}\right)+q^{\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo>}</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\tau_{\beta_{t}}\left(\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{2(1-s)}\left\{(1+t)^{1-s}-1\right\}\right]+\beta_{t-2\tau_{\beta_{t}}}\right)+q^{\tau_{\beta_{t}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E27.m1" class="ltx_Math" alttext="\displaystyle\quad\lesssim\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\tau_{\beta_{t}}t^{-s}+q^{\tau_{\beta_{t}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="1.278em">≲</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\lesssim\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\tau_{\beta_{t}}t^{-s}+q^{\tau_{\beta_{t}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p7.3" class="ltx_p">for some constant <math id="A2.SS1.p7.m1" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>.
<br class="ltx_break"></p>
</div>
<div id="A2.SS1.p8" class="ltx_para ltx_noindent">
<p id="A2.SS1.p8.1" class="ltx_p">Lastly, from Lemma <a href="#A3.Thmtheorem16" title="Lemma C.16. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.16</span></a>, the last term in (<a href="#A2.E19" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) is upper bounded by</p>
<table id="A2.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex91.m1" class="ltx_math_unparsed" alttext="\displaystyle G\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta^{2}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mi mathvariant="normal">Δ</mi><msub><mi>γ</mi><mn>0</mn></msub><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><msubsup><mi>β</mi><mi>i</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle G\sum_{i=0}^{t}\exp\left\{-\Delta\gamma_{0}\beta_{0}\sum_{k=i+1}^{t}\frac{1}{(k+1)^{s}}\right\}\beta^{2}_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex91.m2" class="ltx_math_unparsed" alttext="\displaystyle\lesssim\exp\left\{-\frac{\Delta\gamma_{0}}{2}\beta_{0}\sum_{k=0}^{t}\frac{1}{(k+1)^{s}}\right\}+\beta_{t}" display="inline" intent=":literal"><semantics><mrow><mo>≲</mo><mi>exp</mi><mrow><mo>{</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></mstyle><msub><mi>β</mi><mn>0</mn></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mstyle><mo>}</mo></mrow><mo>+</mo><msub><mi>β</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\exp\left\{-\frac{\Delta\gamma_{0}}{2}\beta_{0}\sum_{k=0}^{t}\frac{1}{(k+1)^{s}}\right\}+\beta_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E28.m1" class="ltx_Math" alttext="\displaystyle\lesssim\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]+\beta_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]+\beta_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p8.2" class="ltx_p">Combining (<a href="#A2.E20" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>), (<a href="#A2.E27" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>) and (<a href="#A2.E28" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>), we have</p>
<table id="A2.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex92.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex92.m2" class="ltx_Math" alttext="\displaystyle\lesssim\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex93.m1" class="ltx_Math" alttext="\displaystyle\quad+\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\tau_{\beta_{t}}t^{-s}+q^{\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\tau_{\beta_{t}}t^{-s}+q^{\tau_{\beta_{t}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex94.m1" class="ltx_Math" alttext="\displaystyle\quad+\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]+\beta_{t}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><msub><mi>β</mi><mi>t</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]+\beta_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p8.3" class="ltx_p">which can be further succinctly written as</p>
<table id="A2.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex95.m1" class="ltx_Math" alttext="\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\leq\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\mathcal{O}\left\{\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\tau_{\beta_{t}}t^{-s}+q^{\tau_{\beta_{t}}}\right\}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow><mo>}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\leq\exp\left[-\frac{\Delta\gamma_{0}\beta_{0}}{1-s}\{(1+t)^{1-s}-1\}\right]\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\mathcal{O}\left\{\tau_{\beta_{t}}t\exp\left(-ct^{1-s}\right)+\tau_{\beta_{t}}t^{-s}+q^{\tau_{\beta_{t}}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p8.4" class="ltx_p">for some constant <math id="A2.SS1.p8.m1" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>.
 ∎</p>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Supporting lemmas</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">Our goal is to establish a finite-time error bound on <math id="A3.p1.m1" class="ltx_Math" alttext="\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|</annotation></semantics></math>. To this end, we state the preliminary lemmas and provide their proofs. The first lemma establishes a norm bound on the eligibility trace.</p>
</div>
<div id="A3.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma C.1</span></span><span id="A3.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem1.p1" class="ltx_para">
<p id="A3.Thmtheorem1.p1.1" class="ltx_p"><span id="A3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Given an exponential weighting parameter <math id="A3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\lambda\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in[0,1)</annotation></semantics></math>, <math id="A3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\|\boldsymbol{z}_{t}\|\leq\frac{1}{1-\lambda}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\|\boldsymbol{z}_{t}\|\leq\frac{1}{1-\lambda}</annotation></semantics></math> for all <math id="A3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent">
<p id="A3.p2.1" class="ltx_p"><span id="A3.p2.1.1" class="ltx_text ltx_font_bold">Proof.</span> From the definition of the eligibility trace, <math id="A3.p2.m1" class="ltx_Math" alttext="\boldsymbol{z}_{t}=\sum_{i=0}^{t}\lambda^{t-i}\boldsymbol{\phi_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>𝒊</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{z}_{t}=\sum_{i=0}^{t}\lambda^{t-i}\boldsymbol{\phi_{i}}</annotation></semantics></math>, we observe
<math id="A3.p2.m2" class="ltx_Math" alttext="\|\boldsymbol{z}_{t}\|=\left\|\sum_{i=0}^{t}\lambda^{t-i}\boldsymbol{\phi_{i}}\right\|\leq\sum_{i=0}^{t}\lambda^{t-i}\leq\frac{1}{1-\lambda}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>=</mo><mrow><mo>‖</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>𝒊</mi></msub></mrow></mrow><mo>‖</mo></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></msubsup><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\boldsymbol{z}_{t}\|=\left\|\sum_{i=0}^{t}\lambda^{t-i}\boldsymbol{\phi_{i}}\right\|\leq\sum_{i=0}^{t}\lambda^{t-i}\leq\frac{1}{1-\lambda}.</annotation></semantics></math>
The first inequality comes from the triangle inequality, given <math id="A3.p2.m3" class="ltx_Math" alttext="\|\boldsymbol{\phi_{i}}\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>𝒊</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\boldsymbol{\phi_{i}}\|\leq 1</annotation></semantics></math>. The latter is true by the sum of a geometric series.
 ∎</p>
</div>
<div id="A3.p3" class="ltx_para ltx_noindent">
<p id="A3.p3.1" class="ltx_p">Next lemma provides explicit bounds on the error incurred by replacing the true, steady-state eligibility trace with its <math id="A3.p3.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>‑step truncated version.</p>
</div>
<div id="A3.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma C.2</span></span><span id="A3.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem2.p1" class="ltx_para">
<p id="A3.Thmtheorem2.p1.1" class="ltx_p"><span id="A3.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Given an initial state <math id="A3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="s_{0}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s_{0}\in\mathcal{S}</annotation></semantics></math>, suppose <math id="A3.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\{S^{\mu}_{t}\}_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{S^{\mu}_{t}\}_{t\in\mathbb{N}}</annotation></semantics></math> is uniformly geometrically ergodic with a rate parameter <math id="A3.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\rho\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in(0,1)</annotation></semantics></math>. For all <math id="A3.Thmtheorem2.p1.m4" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, let <math id="A3.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\tau\in\{0,\cdots,t\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\cdots,t\}</annotation></semantics></math>, then</span></p>
<ol id="A3.I1" class="ltx_enumerate">
<li id="A3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A3.I1.i1.p1" class="ltx_para">
<p id="A3.I1.i1.p1.1" class="ltx_p"><math id="A3.I1.i1.p1.m1" class="ltx_math_unparsed" alttext="\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\right)\right\|\lesssim\tau q^{t}+\lambda^{\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>‖</mo></mrow><mo>≲</mo><mi>τ</mi><msup><mi>q</mi><mi>t</mi></msup><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow><annotation encoding="application/x-tex">\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\right)\right\|\lesssim\tau q^{t}+\lambda^{\tau}</annotation></semantics></math></p>
</div></li>
<li id="A3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A3.I1.i2.p1" class="ltx_para">
<p id="A3.I1.i2.p1.1" class="ltx_p"><math id="A3.I1.i2.p1.m1" class="ltx_math_unparsed" alttext="\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t}^{\top}\right)\right\|\lesssim\tau q^{t}+\lambda^{\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>‖</mo></mrow><mo>≲</mo><mi>τ</mi><msup><mi>q</mi><mi>t</mi></msup><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow><annotation encoding="application/x-tex">\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t}^{\top}\right)\right\|\lesssim\tau q^{t}+\lambda^{\tau}</annotation></semantics></math></p>
</div></li>
<li id="A3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A3.I1.i3.p1" class="ltx_para">
<p id="A3.I1.i3.p1.1" class="ltx_p"><math id="A3.I1.i3.p1.m1" class="ltx_math_unparsed" alttext="\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t+1}^{\top}\right)\right\|\lesssim\tau q^{t}+\lambda^{\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>‖</mo></mrow><mo>≲</mo><mi>τ</mi><msup><mi>q</mi><mi>t</mi></msup><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow><annotation encoding="application/x-tex">\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t+1}^{\top}\right)\right\|\lesssim\tau q^{t}+\lambda^{\tau}</annotation></semantics></math></p>
</div></li>
</ol>
<p id="A3.Thmtheorem2.p1.2" class="ltx_p"><span id="A3.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A3.Thmtheorem2.p1.m6" class="ltx_Math" alttext="q:=\max\{\lambda,\rho\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>,</mo><mi>ρ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q:=\max\{\lambda,\rho\}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p4" class="ltx_para ltx_noindent">
<p id="A3.p4.1" class="ltx_p"><span id="A3.p4.1.1" class="ltx_text ltx_font_bold">Proof.</span> We leverage the steady-state expression of the eligibility trace <math id="A3.p4.m1" class="ltx_Math" alttext="\boldsymbol{z}_{t}=\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></msubsup><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{z}_{t}=\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}</annotation></semantics></math> whenever the expectation is with respect to the stationary distribution induced by the policy <math id="A3.p4.m2" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>. 
<br class="ltx_break"></p>
</div>
<div id="A3.p5" class="ltx_para ltx_noindent">
<p id="A3.p5.1" class="ltx_p">Proof of the first statement:</p>
<table id="A3.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex96.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex96.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\right)-\mathbb{E}^{\mu}\left(\sum_{l=t-\tau}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\right)-\mathbb{E}^{\mu}\left(\sum_{l=t-\tau}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex97.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=-\infty}^{t}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\right)-\sum_{l=t-\tau}^{t}\lambda^{t-l}\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=-\infty}^{t}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\right)-\sum_{l=t-\tau}^{t}\lambda^{t-l}\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex98.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left\{\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\right)\right\}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left\{\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\right)\right\}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex99.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left[\sum_{s\in\mathcal{S}}\left\{\pi_{s}^{\mu}\boldsymbol{\phi}(s)-p^{\mu}(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0})\boldsymbol{\phi}(s)\right\}\right]+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><mo>{</mo><mrow><mrow><msubsup><mi>π</mi><mi>s</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>p</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mn>0</mn><mi>μ</mi></msubsup><mo>=</mo><msub><mi>s</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left[\sum_{s\in\mathcal{S}}\left\{\pi_{s}^{\mu}\boldsymbol{\phi}(s)-p^{\mu}(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0})\boldsymbol{\phi}(s)\right\}\right]+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p5.2" class="ltx_p">Note that <math id="A3.p5.m1" class="ltx_Math" alttext="\sup_{s\in\mathcal{S}}|\pi_{s}^{\mu}-p^{\mu}(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0})|\lesssim\rho^{l}" display="inline" intent=":literal"><semantics><mrow><msub><mo>sup</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><mo fence="false" lspace="0.278em">|</mo><mrow><mrow><msubsup><mi>π</mi><mi>s</mi><mi>μ</mi></msubsup><mo>−</mo><mrow><msup><mi>p</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mn>0</mn><mi>μ</mi></msubsup><mo>=</mo><msub><mi>s</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mphantom></mphantom><mo>≲</mo><msup><mi>ρ</mi><mi>l</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\sup_{s\in\mathcal{S}}|\pi_{s}^{\mu}-p^{\mu}(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0})|\lesssim\rho^{l}</annotation></semantics></math> for some <math id="A3.p5.m2" class="ltx_Math" alttext="\rho\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in(0,1)</annotation></semantics></math> follows from the geometric ergodicity of the Markov chain <math id="A3.p5.m3" class="ltx_Math" alttext="\{S^{\mu}_{t}\}_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{S^{\mu}_{t}\}_{t\in\mathbb{N}}</annotation></semantics></math>. From the finiteness of <math id="A3.p5.m4" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> and normalized features, we have</p>
<table id="A3.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex100.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\right)\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\right)\right\|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex100.m2" class="ltx_Math" alttext="\displaystyle\lesssim\sum_{l=t-\tau}^{t}\lambda^{t-l}\rho^{l}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mi>l</mi></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\sum_{l=t-\tau}^{t}\lambda^{t-l}\rho^{l}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex101.m1" class="ltx_Math" alttext="\displaystyle\lesssim\sum_{l=t-\tau}^{t}q^{t}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\quad\text{where}~q=\max\{\lambda,\rho\}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>q</mi><mi>t</mi></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>where</mtext><mo lspace="0.330em" rspace="0em">​</mo><mi>q</mi></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">}</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\sum_{l=t-\tau}^{t}q^{t}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\quad\text{where}~q=\max\{\lambda,\rho\}\in(0,1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex102.m1" class="ltx_Math" alttext="\displaystyle\lesssim\tau q^{t}+\lambda^{\tau}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>t</mi></msup></mrow><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\tau q^{t}+\lambda^{\tau}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p6" class="ltx_para ltx_noindent">
<p id="A3.p6.1" class="ltx_p">Proof of the second statement:</p>
<table id="A3.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex103.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t}^{\top}\right)\ =\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\sum_{l=t-\tau}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo rspace="0.500em">)</mo></mrow><mo>=</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t}^{\top}\right)\ =\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\sum_{l=t-\tau}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex104.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=-\infty}^{t}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)-\sum_{l=t-\tau}^{t}\lambda^{t-l}\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=-\infty}^{t}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)-\sum_{l=t-\tau}^{t}\lambda^{t-l}\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex105.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left\{\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)\right\}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left\{\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)\right\}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex106.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left[\sum_{s\in\mathcal{S}}\left\{\pi_{s}^{\mu}\boldsymbol{\phi}(s)\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{t}^{\top}|S^{\mu}_{l}=s\right)-p^{\mu}(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0})\boldsymbol{\phi}(s)\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{t}^{\top}|S^{\mu}_{l}=s\right)\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><mo>{</mo><mrow><mrow><msubsup><mi>π</mi><mi>s</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>p</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mn>0</mn><mi>μ</mi></msubsup><mo>=</mo><msub><mi>s</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left[\sum_{s\in\mathcal{S}}\left\{\pi_{s}^{\mu}\boldsymbol{\phi}(s)\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{t}^{\top}|S^{\mu}_{l}=s\right)-p^{\mu}(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0})\boldsymbol{\phi}(s)\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{t}^{\top}|S^{\mu}_{l}=s\right)\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex107.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{l}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{l}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p6.2" class="ltx_p">By the same logic as in the first statement, we have</p>
<table id="A3.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex108.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t}^{\top}\right)\right\|\lesssim\sum_{l=t-\tau}^{t}\lambda^{t-l}\rho^{l}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\lesssim\tau q^{t}+\lambda^{\tau}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>‖</mo></mrow><mo>≲</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><msup><mi>ρ</mi><mi>l</mi></msup><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo>≲</mo><mi>τ</mi><msup><mi>q</mi><mi>t</mi></msup><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t}^{\top}\right)\right\|\lesssim\sum_{l=t-\tau}^{t}\lambda^{t-l}\rho^{l}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\lesssim\tau q^{t}+\lambda^{\tau},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p6.3" class="ltx_p">where <math id="A3.p6.m1" class="ltx_Math" alttext="q=\max\{\lambda,\rho\}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">}</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q=\max\{\lambda,\rho\}\in(0,1)</annotation></semantics></math>. 
<br class="ltx_break"></p>
</div>
<div id="A3.p7" class="ltx_para ltx_noindent">
<p id="A3.p7.1" class="ltx_p">Proof of the third statement:</p>
<table id="A3.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex109.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t+1}^{\top}\right)\ =\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\sum_{l=t-\tau}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo rspace="0.500em">)</mo></mrow><mo>=</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t+1}^{\top}\right)\ =\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\sum_{l=t-\tau}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex110.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=-\infty}^{t}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)-\sum_{l=t-\tau}^{t}\lambda^{t-l}\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=-\infty}^{t}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)-\sum_{l=t-\tau}^{t}\lambda^{t-l}\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex111.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left\{\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)\right\}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left\{\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)\right\}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{t+1}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex112.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left[\sum_{s\in\mathcal{S}}\left\{\pi_{s}^{\mu}\boldsymbol{\phi}(s)\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{t+1}^{\top}|S^{\mu}_{l}=s\right)-p^{\mu}\left(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0}\right)\boldsymbol{\phi}(s)\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{t+1}^{\top}|S^{\mu}_{l}=s\right)\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><mo>{</mo><mrow><mrow><msubsup><mi>π</mi><mi>s</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>p</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mn>0</mn><mi>μ</mi></msubsup><mo>=</mo><msub><mi>s</mi><mn>0</mn></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left[\sum_{s\in\mathcal{S}}\left\{\pi_{s}^{\mu}\boldsymbol{\phi}(s)\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{t+1}^{\top}|S^{\mu}_{l}=s\right)-p^{\mu}\left(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0}\right)\boldsymbol{\phi}(s)\mathbb{E}^{\mu}\left(\boldsymbol{\phi}_{t+1}^{\top}|S^{\mu}_{l}=s\right)\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex113.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{l+1}^{\top}\right)," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{\phi}_{l}\boldsymbol{\phi}_{l+1}^{\top}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p7.2" class="ltx_p">where in the last equality, we use the law of iterated expectations. Following the proof of the first statement, we have</p>
<table id="A3.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex114.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t+1}^{\top}\right)\right\|\lesssim\sum_{l=t-\tau}^{t}\lambda^{t-l}\rho^{l}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\lesssim\tau q^{t}+\lambda^{\tau}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>)</mo></mrow><mo>‖</mo></mrow><mo>≲</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><msup><mi>ρ</mi><mi>l</mi></msup><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo>≲</mo><mi>τ</mi><msup><mi>q</mi><mi>t</mi></msup><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top}\right)-\mathbb{E}^{\mu}\left(\boldsymbol{z}_{t-\tau:t}\boldsymbol{\phi}_{t+1}^{\top}\right)\right\|\lesssim\sum_{l=t-\tau}^{t}\lambda^{t-l}\rho^{l}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\lesssim\tau q^{t}+\lambda^{\tau},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p7.3" class="ltx_p">where <math id="A3.p7.m1" class="ltx_Math" alttext="q=\max\{\lambda,\rho\}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">}</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q=\max\{\lambda,\rho\}\in(0,1)</annotation></semantics></math>.
 ∎</p>
</div>
<div id="A3.p8" class="ltx_para ltx_noindent">
<p id="A3.p8.1" class="ltx_p">Subsequent lemma provides explicit bounds on the error incurred by replacing the steady-state reward expectation with its non steady-state version.</p>
</div>
<div id="A3.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma C.3</span></span><span id="A3.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem3.p1" class="ltx_para">
<p id="A3.Thmtheorem3.p1.1" class="ltx_p"><span id="A3.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Given an initial state <math id="A3.Thmtheorem3.p1.m1" class="ltx_Math" alttext="s_{0}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s_{0}\in\mathcal{S}</annotation></semantics></math>, suppose <math id="A3.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\{S^{\mu}_{t}\}_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{S^{\mu}_{t}\}_{t\in\mathbb{N}}</annotation></semantics></math> is uniformly geometrically ergodic with a rate parameter <math id="A3.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\rho\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in(0,1)</annotation></semantics></math>. For <math id="A3.Thmtheorem3.p1.m4" class="ltx_Math" alttext="\tau\in\{0,\cdots,t\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\cdots,t\}</annotation></semantics></math>,</span></p>
<ol id="A3.I2" class="ltx_enumerate">
<li id="A3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A3.I2.i1.p1" class="ltx_para">
<p id="A3.I2.i1.p1.1" class="ltx_p"><math id="A3.I2.i1.p1.m1" class="ltx_Math" alttext="|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t})|\lesssim\rho^{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≲</mo><msup><mi>ρ</mi><mi>t</mi></msup></mrow><annotation encoding="application/x-tex">|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t})|\lesssim\rho^{t}</annotation></semantics></math></p>
</div></li>
<li id="A3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A3.I2.i2.p1" class="ltx_para">
<p id="A3.I2.i2.p1.1" class="ltx_p"><math id="A3.I2.i2.p1.m1" class="ltx_math_unparsed" alttext="\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t}\boldsymbol{z}_{t-\tau:t})\|\lesssim\tau q^{t}+\lambda^{\tau}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≲</mo><mi>τ</mi><msup><mi>q</mi><mi>t</mi></msup><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow><annotation encoding="application/x-tex">\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t}\boldsymbol{z}_{t-\tau:t})\|\lesssim\tau q^{t}+\lambda^{\tau}</annotation></semantics></math></p>
</div></li>
</ol>
<p id="A3.Thmtheorem3.p1.2" class="ltx_p"><span id="A3.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A3.Thmtheorem3.p1.m5" class="ltx_Math" alttext="q:=\max\{\lambda,\rho\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>,</mo><mi>ρ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q:=\max\{\lambda,\rho\}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p9" class="ltx_para ltx_noindent">
<p id="A3.p9.1" class="ltx_p"><span id="A3.p9.1.1" class="ltx_text ltx_font_bold">Proof.</span> For the first statement, notice that</p>
<table id="A3.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex115.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t})=\sum_{s\in\mathcal{S}}r\{s,\mu(s)\}\left\{\pi_{s}^{\mu}-p^{\mu}(S^{\mu}_{t}=s|S^{\mu}_{0}=s_{0})\right\}\Longrightarrow|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t})|\lesssim\rho^{k}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>s</mi><mo>,</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msubsup><mi>π</mi><mi>s</mi><mi>μ</mi></msubsup><mo>−</mo><mrow><msup><mi>p</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mn>0</mn><mi>μ</mi></msubsup><mo>=</mo><msub><mi>s</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo stretchy="false">⟹</mo><mphantom></mphantom></mrow><mo fence="false">|</mo><mrow><mrow><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mphantom></mphantom><mo>≲</mo><msup><mi>ρ</mi><mi>k</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t})=\sum_{s\in\mathcal{S}}r\{s,\mu(s)\}\left\{\pi_{s}^{\mu}-p^{\mu}(S^{\mu}_{t}=s|S^{\mu}_{0}=s_{0})\right\}\Longrightarrow|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t})|\lesssim\rho^{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p9.2" class="ltx_p">where the last inequality follows from the uniform geometric ergodicity of the Markov chain <math id="A3.p9.m1" class="ltx_Math" alttext="\{S^{\mu}_{t}\}_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{S^{\mu}_{t}\}_{t\in\mathbb{N}}</annotation></semantics></math>. For the second statement, we again leverage the steady-state expression of the eligibility trace <math id="A3.p9.m2" class="ltx_Math" alttext="\boldsymbol{z}_{t}=\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></msubsup><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{z}_{t}=\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}</annotation></semantics></math> whenever the expectation is with respect to the steady-state distribution induced by the policy <math id="A3.p9.m3" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>.</p>
<table id="A3.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex116.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t}\boldsymbol{z}_{t-\tau:t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t}\boldsymbol{z}_{t-\tau:t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex116.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\right)-\mathbb{E}^{\mu}\left(R^{\mu}_{t}\sum_{l=t-\tau}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\sum_{l=-\infty}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\right)-\mathbb{E}^{\mu}\left(R^{\mu}_{t}\sum_{l=t-\tau}^{t}\lambda^{t-l}\boldsymbol{\phi}_{l}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex117.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=-\infty}^{t}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)-\sum_{l=t-\tau}^{t}\lambda^{t-l}\mathbb{E}^{\mu}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=-\infty}^{t}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)-\sum_{l=t-\tau}^{t}\lambda^{t-l}\mathbb{E}^{\mu}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex118.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left\{\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)-\mathbb{E}^{\mu}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)\right\}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left\{\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)-\mathbb{E}^{\mu}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)\right\}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex119.m1" class="ltx_Math" alttext="\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left[\sum_{s\in\mathcal{S}}\{\pi^{\mu}_{s}-p^{\mu}(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0})\}\boldsymbol{\phi}(s)\mathbb{E}^{\mu}(R^{\mu}_{t}|S^{\mu}_{l}=s)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder></mstyle><mrow><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>π</mi><mi>s</mi><mi>μ</mi></msubsup><mo>−</mo><mrow><msup><mi>p</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mn>0</mn><mi>μ</mi></msubsup><mo>=</mo><msub><mi>s</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>S</mi><mi>l</mi><mi>μ</mi></msubsup><mo>=</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{l=t-\tau}^{t}\lambda^{t-l}\left[\sum_{s\in\mathcal{S}}\{\pi^{\mu}_{s}-p^{\mu}(S^{\mu}_{l}=s|S^{\mu}_{0}=s_{0})\}\boldsymbol{\phi}(s)\mathbb{E}^{\mu}(R^{\mu}_{t}|S^{\mu}_{l}=s)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex120.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo>(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>l</mi></msub><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\left(R^{\mu}_{t}\boldsymbol{\phi}_{l}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p9.3" class="ltx_p">Taking the norm on both sides with the uniform geometric ergodicity of the Markov chain <math id="A3.p9.m4" class="ltx_Math" alttext="\{S^{\mu}_{t}\}_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{S^{\mu}_{t}\}_{t\in\mathbb{N}}</annotation></semantics></math>, we have</p>
<table id="A3.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex121.m1" class="ltx_math_unparsed" alttext="\displaystyle\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t}\boldsymbol{z}_{t-\tau:t})\|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">∥</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(R^{\mu}_{t}\boldsymbol{z}_{t-\tau:t})\|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex121.m2" class="ltx_Math" alttext="\displaystyle\lesssim\sum_{l=t-\tau}^{t}\lambda^{t-l}\rho^{l}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mi>l</mi></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\sum_{l=t-\tau}^{t}\lambda^{t-l}\rho^{l}+\sum_{l=-\infty}^{t-\tau-1}\lambda^{t-l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex122.m1" class="ltx_Math" alttext="\displaystyle\lesssim\tau q^{t}+\lambda^{\tau}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>t</mi></msup></mrow><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\tau q^{t}+\lambda^{\tau},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p9.4" class="ltx_p">where the last inequality follows from <math id="A3.p9.m5" class="ltx_Math" alttext="q=\max\{\lambda,\rho\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>,</mo><mi>ρ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q=\max\{\lambda,\rho\}</annotation></semantics></math>.
 ∎</p>
</div>
<div id="A3.p10" class="ltx_para ltx_noindent">
<p id="A3.p10.1" class="ltx_p">Lemma below establishes uniform bounds on the norm of <math id="A3.p10.m1" class="ltx_Math" alttext="\boldsymbol{A}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑨</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\boldsymbol{A}_{t}</annotation></semantics></math> and <math id="A3.p10.m2" class="ltx_Math" alttext="\boldsymbol{b}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝒃</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\boldsymbol{b}_{t}</annotation></semantics></math>, which will appear in the finite-time error bounds.</p>
</div>
<div id="A3.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma C.4</span></span><span id="A3.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem4.p1" class="ltx_para">
<p id="A3.Thmtheorem4.p1.1" class="ltx_p"><span id="A3.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem4.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, <math id="A3.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\|\boldsymbol{A}_{t}\|\leq A_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝐀</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>A</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}_{t}\|\leq A_{\max}</annotation></semantics></math> and <math id="A3.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\|\boldsymbol{b}_{t}\|\leq b_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝐛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>b</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{b}_{t}\|\leq b_{\max}</annotation></semantics></math> for some constants <math id="A3.Thmtheorem4.p1.m4" class="ltx_Math" alttext="A_{\max},b_{\max}\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>max</mi></msub><mo>,</mo><mrow><msub><mi>b</mi><mi>max</mi></msub><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">A_{\max},b_{\max}\in\mathbb{R}_{&gt;0}</annotation></semantics></math></span></p>
</div>
</div>
<div id="A3.p11" class="ltx_para ltx_noindent">
<p id="A3.p11.1" class="ltx_p"><span id="A3.p11.1.1" class="ltx_text ltx_font_bold">Proof.</span></p>
<table id="A3.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex123.m1" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{A}_{t}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{A}_{t}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex123.m2" class="ltx_Math" alttext="\displaystyle\leq\|\boldsymbol{A}_{t}\|^{2}_{F}\leq c_{\alpha}^{2}+\|\boldsymbol{z}_{t}\|^{2}+\|\boldsymbol{z}_{t}\|^{2}\|\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top}\|^{2}\leq c_{\alpha}^{2}+\frac{5}{\left(1-\lambda\right)^{2}}=:A^{2}_{\max}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mi>c</mi><mi>α</mi><mn>2</mn></msubsup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>−</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>c</mi><mi>α</mi><mn>2</mn></msubsup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>5</mn><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo>)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>A</mi><mi>max</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\|\boldsymbol{A}_{t}\|^{2}_{F}\leq c_{\alpha}^{2}+\|\boldsymbol{z}_{t}\|^{2}+\|\boldsymbol{z}_{t}\|^{2}\|\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top}\|^{2}\leq c_{\alpha}^{2}+\frac{5}{\left(1-\lambda\right)^{2}}=:A^{2}_{\max}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex124.m1" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{b}_{t}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒃</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{b}_{t}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex124.m2" class="ltx_Math" alttext="\displaystyle\leq c_{\alpha}^{2}+\frac{1}{(1-\lambda)^{2}}=:b^{2}_{\max}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mi>c</mi><mi>α</mi><mn>2</mn></msubsup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>b</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{\alpha}^{2}+\frac{1}{(1-\lambda)^{2}}=:b^{2}_{\max},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p11.2" class="ltx_p">where in the equality for <math id="A3.p11.m1" class="ltx_Math" alttext="\|\boldsymbol{b}_{t}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒃</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\|\boldsymbol{b}_{t}\|^{2}</annotation></semantics></math>, we used the fact <math id="A3.p11.m2" class="ltx_Math" alttext="|R^{\mu}_{t}|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|R^{\mu}_{t}|\leq 1</annotation></semantics></math> for all <math id="A3.p11.m3" class="ltx_Math" alttext="t\in\mathbb{N}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}.</annotation></semantics></math>
 ∎</p>
</div>
<div id="A3.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem5.2" class="ltx_text ltx_font_bold">Lemma C.5</span></span><span id="A3.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem5.p1" class="ltx_para">
<p id="A3.Thmtheorem5.p1.1" class="ltx_p"><span id="A3.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem5.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, <math id="A3.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\|\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}}\|\leq\frac{(1+c_{\alpha})\beta_{t}}{(1-\lambda)^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐃</mi><mi>t</mi></msub><mo>−</mo><munder accentunder="true"><msub><mi>𝐃</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\|\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}}\|\leq\frac{(1+c_{\alpha})\beta_{t}}{(1-\lambda)^{2}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p12" class="ltx_para ltx_noindent">
<p id="A3.p12.1" class="ltx_p"><span id="A3.p12.1.1" class="ltx_text ltx_font_bold">Proof.</span> By the definition of the operator norm, we know</p>
<table id="A3.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex125.m1" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}}\|\leq\max\left\{\left|\frac{1}{1+c_{\alpha}\beta_{t}}-\gamma_{t}\right|,\left|\frac{1}{1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}-\gamma_{t}\right|\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑫</mi><mi>t</mi></msub><mo>−</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mrow></mfrac></mstyle><mo>−</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mfrac></mstyle><mo>−</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mo>|</mo></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}}\|\leq\max\left\{\left|\frac{1}{1+c_{\alpha}\beta_{t}}-\gamma_{t}\right|,\left|\frac{1}{1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}-\gamma_{t}\right|\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p12.2" class="ltx_p">Note that</p>
<table id="A3.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex126.m1" class="ltx_Math" alttext="\displaystyle\left|\frac{1}{1+c_{\alpha}\beta_{t}}-\gamma_{t}\right|\leq\left|\frac{1}{1+c_{\alpha}\beta_{t}}-\frac{(1-\lambda)^{2}}{(1-\lambda)^{2}+\beta_{t}}\right|\leq\left|\frac{\{1-(1-\lambda)^{2}c_{\alpha}\}\beta_{t}}{(1-\lambda)^{2}}\right|\leq\frac{(1+c_{\alpha})\beta_{t}}{(1-\lambda)^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mrow></mfrac></mstyle><mo>−</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mo>|</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>α</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>|</mo></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\frac{1}{1+c_{\alpha}\beta_{t}}-\gamma_{t}\right|\leq\left|\frac{1}{1+c_{\alpha}\beta_{t}}-\frac{(1-\lambda)^{2}}{(1-\lambda)^{2}+\beta_{t}}\right|\leq\left|\frac{\{1-(1-\lambda)^{2}c_{\alpha}\}\beta_{t}}{(1-\lambda)^{2}}\right|\leq\frac{(1+c_{\alpha})\beta_{t}}{(1-\lambda)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p12.3" class="ltx_p">Since</p>
<table id="A3.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex127.m1" class="ltx_Math" alttext="\displaystyle\left|\frac{1}{1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}-\frac{1}{1+c_{\alpha}\beta_{t}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\frac{1}{1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}-\frac{1}{1+c_{\alpha}\beta_{t}}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex127.m2" class="ltx_Math" alttext="\displaystyle\leq\left|\frac{c_{\alpha}\beta_{t}-\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}{(1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2})(1+c_{\alpha}\beta_{t})}\right|\leq\left\{c_{\alpha}+\frac{1}{(1-\lambda)^{2}}\right\}\beta_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>|</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mo>{</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\frac{c_{\alpha}\beta_{t}-\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}{(1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2})(1+c_{\alpha}\beta_{t})}\right|\leq\left\{c_{\alpha}+\frac{1}{(1-\lambda)^{2}}\right\}\beta_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex128.m1" class="ltx_Math" alttext="\displaystyle\left|\frac{1}{1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}-\frac{(1-\lambda)^{2}}{(1-\lambda)^{2}+\beta_{t}}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\frac{1}{1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}-\frac{(1-\lambda)^{2}}{(1-\lambda)^{2}+\beta_{t}}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex128.m2" class="ltx_Math" alttext="\displaystyle\leq\left|\frac{\{1-(1-\lambda)^{2}\|\boldsymbol{z}_{t}\|^{2}\}\beta_{t}}{(1-\lambda)^{2}}\right|\leq\frac{\beta_{t}}{(1-\lambda)^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>|</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>|</mo></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mi>t</mi></msub><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\frac{\{1-(1-\lambda)^{2}\|\boldsymbol{z}_{t}\|^{2}\}\beta_{t}}{(1-\lambda)^{2}}\right|\leq\frac{\beta_{t}}{(1-\lambda)^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p12.4" class="ltx_p">we have</p>
<table id="A3.Ex129" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex129.m1" class="ltx_Math" alttext="\left|\frac{1}{1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}-\gamma_{t}\right|\leq\frac{(1+c_{\alpha})\beta_{t}}{(1-\lambda)^{2}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mfrac><mo>−</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mo>|</mo></mrow><mo>≤</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\frac{1}{1+\beta_{t}\|\boldsymbol{z}_{t}\|^{2}}-\gamma_{t}\right|\leq\frac{(1+c_{\alpha})\beta_{t}}{(1-\lambda)^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p12.5" class="ltx_p">which yields the desired bound.
 ∎</p>
</div>
<div id="A3.p13" class="ltx_para ltx_noindent">
<p id="A3.p13.1" class="ltx_p">The following lemma establishes a uniform bound on the norm of the function <math id="A3.p13.m1" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math>.</p>
</div>
<div id="A3.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma C.6</span></span><span id="A3.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem6.p1" class="ltx_para">
<p id="A3.Thmtheorem6.p1.1" class="ltx_p"><span id="A3.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem6.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, <math id="A3.Thmtheorem6.p1.m2" class="ltx_Math" alttext="\boldsymbol{\Theta}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}" display="inline" intent=":literal"><semantics><mrow><mi>𝚯</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>𝚵</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>𝚵</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\Theta}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}</annotation></semantics></math>,
<math id="A3.Thmtheorem6.p1.m3" class="ltx_Math" alttext="\|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})\|\leq C_{\zeta}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>C</mi><mi>ζ</mi></msub></mrow><annotation encoding="application/x-tex">\|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})\|\leq C_{\zeta}</annotation></semantics></math> for some constant <math id="A3.Thmtheorem6.p1.m4" class="ltx_Math" alttext="C_{\zeta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>ζ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{\zeta}&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p14" class="ltx_para ltx_noindent">
<p id="A3.p14.1" class="ltx_p"><span id="A3.p14.1.1" class="ltx_text ltx_font_bold">Proof.</span> Note that <math id="A3.p14.m1" class="ltx_Math" alttext="\|\underline{\boldsymbol{D}_{t}}\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\underline{\boldsymbol{D}_{t}}\|\leq 1</annotation></semantics></math>, <math id="A3.p14.m2" class="ltx_Math" alttext="\|\boldsymbol{A}_{t}\|\leq A_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>A</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}_{t}\|\leq A_{\max}</annotation></semantics></math> and <math id="A3.p14.m3" class="ltx_Math" alttext="\|\boldsymbol{b}_{t}\|\leq b_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝒃</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>b</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{b}_{t}\|\leq b_{\max}</annotation></semantics></math>,</p>
<table id="A3.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex130.m1" class="ltx_Math" alttext="\displaystyle\|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})\|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex130.m2" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\left\|\boldsymbol{\Theta^{*}}\right\|\left\|\underline{\boldsymbol{D}_{t}}\right\|\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\|+\left\|\boldsymbol{\boldsymbol{b}_{t}}-\boldsymbol{b}\right\|\left\|\underline{\boldsymbol{D}_{t}}\right\|\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo>‖</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi></mrow><mo stretchy="false">‖</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>‖</mo><mrow><msub><mi>𝒃</mi><mi>𝒕</mi></msub><mo>−</mo><mi>𝒃</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\left\|\boldsymbol{\Theta^{*}}\right\|\left\|\underline{\boldsymbol{D}_{t}}\right\|\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\|+\left\|\boldsymbol{\boldsymbol{b}_{t}}-\boldsymbol{b}\right\|\left\|\underline{\boldsymbol{D}_{t}}\right\|\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex131.m1" class="ltx_Math" alttext="\displaystyle\leq 2\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|R_{\boldsymbol{\Theta}}^{2}+2\left\|\boldsymbol{b}_{t}-\boldsymbol{b}\right\|R_{\boldsymbol{\Theta}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><mi>𝒃</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|R_{\boldsymbol{\Theta}}^{2}+2\left\|\boldsymbol{b}_{t}-\boldsymbol{b}\right\|R_{\boldsymbol{\Theta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex132.m1" class="ltx_Math" alttext="\displaystyle\leq 4A_{\max}R_{\boldsymbol{\Theta}}^{2}+4b_{\max}R_{\boldsymbol{\Theta}}=:C_{\zeta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>C</mi><mi>ζ</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4A_{\max}R_{\boldsymbol{\Theta}}^{2}+4b_{\max}R_{\boldsymbol{\Theta}}=:C_{\zeta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p14.2" class="ltx_p">∎</p>
</div>
<div id="A3.p15" class="ltx_para ltx_noindent">
<p id="A3.p15.1" class="ltx_p">Two lemmas below respectively establish Lipschitzness of the function <math id="A3.p15.m1" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> with respect to <math id="A3.p15.m2" class="ltx_Math" alttext="\boldsymbol{\Theta}" display="inline" intent=":literal"><semantics><mi>𝚯</mi><annotation encoding="application/x-tex">\boldsymbol{\Theta}</annotation></semantics></math> component and the deviance bound with respect to <math id="A3.p15.m3" class="ltx_Math" alttext="\boldsymbol{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\boldsymbol{X}</annotation></semantics></math> component.</p>
</div>
<div id="A3.Thmtheorem7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem7.2" class="ltx_text ltx_font_bold">Lemma C.7</span></span><span id="A3.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem7.p1" class="ltx_para">
<p id="A3.Thmtheorem7.p1.1" class="ltx_p"><span id="A3.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem7.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, <math id="A3.Thmtheorem7.p1.m2" class="ltx_Math" alttext="\boldsymbol{\Theta_{1}},\boldsymbol{\Theta_{2}}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo>,</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>𝚵</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>𝚵</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\Theta_{1}},\boldsymbol{\Theta_{2}}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}</annotation></semantics></math>,</span></p>
<table id="A3.Ex133" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex133.m1" class="ltx_Math" alttext="\left|\zeta_{t}(\boldsymbol{\Theta_{1}},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta_{2}},\boldsymbol{X}_{t})\right|\leq L_{\zeta}\|\boldsymbol{\Theta_{1}}-\boldsymbol{\Theta_{2}}\|," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\zeta_{t}(\boldsymbol{\Theta_{1}},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta_{2}},\boldsymbol{X}_{t})\right|\leq L_{\zeta}\|\boldsymbol{\Theta_{1}}-\boldsymbol{\Theta_{2}}\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem7.p1.2" class="ltx_p"><span id="A3.Thmtheorem7.p1.2.1" class="ltx_text ltx_font_italic">for some constant <math id="A3.Thmtheorem7.p1.m3" class="ltx_Math" alttext="L_{\zeta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>ζ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L_{\zeta}&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p16" class="ltx_para ltx_noindent">
<p id="A3.p16.1" class="ltx_p"><span id="A3.p16.1.1" class="ltx_text ltx_font_bold">Proof.</span></p>
<table id="A3.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex134.m1" class="ltx_Math" alttext="\displaystyle\left|\zeta_{t}(\boldsymbol{\Theta_{1}},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta_{2}},\boldsymbol{X}_{t})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\zeta_{t}(\boldsymbol{\Theta_{1}},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta_{2}},\boldsymbol{X}_{t})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex134.m2" class="ltx_Math" alttext="\displaystyle=\left\langle\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)\boldsymbol{\Theta^{*}},\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}})\right\rangle+\left\langle\boldsymbol{b}_{t}-\boldsymbol{b},\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}})\right\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup></mrow><mo>,</mo><mrow><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo>+</mo><mrow><mo>⟨</mo><mrow><mrow><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><mi>𝒃</mi></mrow><mo>,</mo><mrow><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\langle\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)\boldsymbol{\Theta^{*}},\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}})\right\rangle+\left\langle\boldsymbol{b}_{t}-\boldsymbol{b},\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}})\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex135.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\|\boldsymbol{\Theta^{*}}\|\|\underline{\boldsymbol{D}_{t}}\|\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|+\left\|\boldsymbol{b}_{t}-\boldsymbol{b}\right\|\|\underline{\boldsymbol{D}_{t}}\|\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>‖</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><mrow><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mo>+</mo><mrow><mo>‖</mo><mrow><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><mi>𝒃</mi></mrow><mo>‖</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\|\boldsymbol{\Theta^{*}}\|\|\underline{\boldsymbol{D}_{t}}\|\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|+\left\|\boldsymbol{b}_{t}-\boldsymbol{b}\right\|\|\underline{\boldsymbol{D}_{t}}\|\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex136.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|R_{\boldsymbol{\Theta}}\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|+\left\|\boldsymbol{b}_{t}-\boldsymbol{b}\right\|\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo>‖</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>‖</mo><mrow><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><mi>𝒃</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|R_{\boldsymbol{\Theta}}\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|+\left\|\boldsymbol{b}_{t}-\boldsymbol{b}\right\|\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex137.m1" class="ltx_Math" alttext="\displaystyle\leq(2A_{\max}R_{\boldsymbol{\Theta}}+2b_{\max})\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>max</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(2A_{\max}R_{\boldsymbol{\Theta}}+2b_{\max})\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex138.m1" class="ltx_Math" alttext="\displaystyle=:L_{\zeta}\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><mrow><msub><mi>L</mi><mi>ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=:L_{\zeta}\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p16.2" class="ltx_p">where in the first inequality, we used the Cauchy-Schwarz inequality. The second and third inequalities follow from <math id="A3.p16.m1" class="ltx_Math" alttext="\|\underline{\boldsymbol{D}_{t}}\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\underline{\boldsymbol{D}_{t}}\|\leq 1</annotation></semantics></math>, <math id="A3.p16.m2" class="ltx_Math" alttext="\|\boldsymbol{A}_{t}\|\leq A_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>A</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}_{t}\|\leq A_{\max}</annotation></semantics></math> and <math id="A3.p16.m3" class="ltx_Math" alttext="\|\boldsymbol{b}_{t}\|\leq b_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝒃</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>b</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{b}_{t}\|\leq b_{\max}</annotation></semantics></math>.
 ∎</p>
</div>
<div id="A3.Thmtheorem8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem8.2" class="ltx_text ltx_font_bold">Lemma C.8</span></span><span id="A3.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem8.p1" class="ltx_para">
<p id="A3.Thmtheorem8.p1.1" class="ltx_p"><span id="A3.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem8.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, <math id="A3.Thmtheorem8.p1.m2" class="ltx_Math" alttext="\boldsymbol{\Theta}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}" display="inline" intent=":literal"><semantics><mrow><mi>𝚯</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>𝚵</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>𝚵</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\Theta}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}</annotation></semantics></math>, let <math id="A3.Thmtheorem8.p1.m3" class="ltx_Math" alttext="\tau\in\{0,\cdots,t\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\cdots,t\}</annotation></semantics></math>, then we have</span></p>
<table id="A3.Ex139" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex139.m1" class="ltx_math_unparsed" alttext="\left|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|\lesssim\lambda^{\tau}." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msub><mi>ζ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ζ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≲</mo><msup><mi>λ</mi><mi>τ</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|\lesssim\lambda^{\tau}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p17" class="ltx_para ltx_noindent">
<p id="A3.p17.1" class="ltx_p"><span id="A3.p17.1.1" class="ltx_text ltx_font_bold">Proof.</span> Note that</p>
<table id="A3.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex140.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msub><mi>ζ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ζ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex140.m2" class="ltx_math_unparsed" alttext="\displaystyle=\left\langle\left(\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\right)\boldsymbol{\Theta^{*}},\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right\rangle+\left\langle\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t},\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right\rangle" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo>⟨</mo><mrow><mo>(</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>,</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow><mo>⟩</mo></mrow><mo>+</mo><mrow><mo>⟨</mo><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝒃</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>,</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\langle\left(\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\right)\boldsymbol{\Theta^{*}},\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right\rangle+\left\langle\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t},\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E29.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 2\left\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\right\|R_{\boldsymbol{\Theta}}^{2}+2\left\|\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t}\right\|R_{\boldsymbol{\Theta}}." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>2</mn><mrow><mo>‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup><mo>+</mo><mn>2</mn><mrow><mo>‖</mo><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝒃</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow><msub><mi>R</mi><mi>𝚯</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\left\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\right\|R_{\boldsymbol{\Theta}}^{2}+2\left\|\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t}\right\|R_{\boldsymbol{\Theta}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A3.p17.2" class="ltx_p">where we used <math id="A3.p17.m1" class="ltx_Math" alttext="\|\boldsymbol{\Theta^{*}}\|\leq R_{\boldsymbol{\Theta}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{\Theta^{*}}\|\leq R_{\boldsymbol{\Theta}}</annotation></semantics></math>, <math id="A3.p17.m2" class="ltx_Math" alttext="\|\boldsymbol{\Theta}\|\leq R_{\boldsymbol{\Theta}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>𝚯</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{\Theta}\|\leq R_{\boldsymbol{\Theta}}</annotation></semantics></math>, <math id="A3.p17.m3" class="ltx_Math" alttext="\|\underline{\boldsymbol{D}_{t}}\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\underline{\boldsymbol{D}_{t}}\|\leq 1</annotation></semantics></math>. To obtain a bound on <math id="A3.p17.m4" class="ltx_math_unparsed" alttext="\left\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow><annotation encoding="application/x-tex">\left\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\right\|</annotation></semantics></math> and <math id="A3.p17.m5" class="ltx_math_unparsed" alttext="\left\|\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t}\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝒃</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow><annotation encoding="application/x-tex">\left\|\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t}\right\|</annotation></semantics></math>, note that</p>
<table id="A3.Ex141" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex141.m1" class="ltx_math_unparsed" alttext="\|\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t}\|\leq\sum_{l=0}^{t-\tau}\lambda^{t-l}\leq\lambda^{\tau}/(1-\lambda)." display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em" rspace="0.111em">≤</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></munderover><msup><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mi>l</mi></mrow></msup><mo>≤</mo><msup><mi>λ</mi><mi>τ</mi></msup><mo>/</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t}\|\leq\sum_{l=0}^{t-\tau}\lambda^{t-l}\leq\lambda^{\tau}/(1-\lambda).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p17.3" class="ltx_p">Now consider</p>
<table id="A3.Ex142" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex142.m1" class="ltx_math_unparsed" alttext="\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}=\begin{bmatrix}0&amp;0\\
-(\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t})&amp;(\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t})(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top}),\end{bmatrix}" display="block" intent=":literal"><semantics><mrow><mi>𝑨</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝒛</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝒛</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>−</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><mo>,</mo></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}=\begin{bmatrix}0&amp;0\\
-(\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t})&amp;(\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t})(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top}),\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p17.4" class="ltx_p">whose operator norm satisfies the following bound</p>
<table id="A3.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E30.m1" class="ltx_math_unparsed" alttext="\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\|^{2}\leq\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\|_{F}^{2}\leq\|\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t}\|^{2}+\|\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t}\|^{2}\left\|\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top}\right\|^{2}\leq 5\lambda^{2\tau}/(1-\lambda)^{2}." display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msup><mo lspace="0.0835em" rspace="0em">≤</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mi>F</mi><mn>2</mn></msubsup><mo lspace="0.0835em" rspace="0em">≤</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><msup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msup><msup><mrow><mo>‖</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>−</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mn>5</mn><msup><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></msup><mo>/</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\|^{2}\leq\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\|_{F}^{2}\leq\|\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t}\|^{2}+\|\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t}\|^{2}\left\|\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top}\right\|^{2}\leq 5\lambda^{2\tau}/(1-\lambda)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="A3.p17.5" class="ltx_p">Similarly, consider</p>
<table id="A3.Ex143" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex143.m1" class="ltx_math_unparsed" alttext="\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t}=\begin{bmatrix}0\\
R^{\mu}_{t}(\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t})\end{bmatrix}," display="block" intent=":literal"><semantics><mrow><mi>𝒃</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝒃</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mrow><mi>R</mi><msup><mrow></mrow><mi>μ</mi></msup><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝒛</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t}=\begin{bmatrix}0\\
R^{\mu}_{t}(\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t})\end{bmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p17.6" class="ltx_p">for which the Euclidean norm is bounded as follows</p>
<table id="A3.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E31.m1" class="ltx_math_unparsed" alttext="\|\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t}\|\leq\|\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t}\|\leq\lambda^{\tau}/(1-\lambda)." display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝒃</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em" rspace="0em">≤</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≤</mo><msup><mi>λ</mi><mi>τ</mi></msup><mo>/</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\boldsymbol{b}_{t}-\boldsymbol{b}_{t-\tau:t}\|\leq\|\boldsymbol{z}_{t}-\boldsymbol{z}_{t-\tau:t}\|\leq\lambda^{\tau}/(1-\lambda).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A3.p17.7" class="ltx_p">Plugging (<a href="#A3.E30" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) and (<a href="#A3.E31" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>) into (<a href="#A3.E29" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>), we have</p>
<table id="A3.Ex144" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex144.m1" class="ltx_math_unparsed" alttext="\left|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|\lesssim\lambda^{\tau}." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msub><mi>ζ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ζ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≲</mo><msup><mi>λ</mi><mi>τ</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\zeta_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|\lesssim\lambda^{\tau}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p17.8" class="ltx_p">∎</p>
</div>
<div id="A3.p18" class="ltx_para ltx_noindent">
<p id="A3.p18.1" class="ltx_p">As we did for the function <math id="A3.p18.m1" class="ltx_Math" alttext="\zeta_{t}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\zeta_{t}</annotation></semantics></math>, we next establish boundedness, Lipschitzness of the function <math id="A3.p18.m2" class="ltx_Math" alttext="\xi_{t}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\xi_{t}</annotation></semantics></math> with respect to <math id="A3.p18.m3" class="ltx_Math" alttext="\boldsymbol{\Theta}" display="inline" intent=":literal"><semantics><mi>𝚯</mi><annotation encoding="application/x-tex">\boldsymbol{\Theta}</annotation></semantics></math> as well as the deviance bound with respect to <math id="A3.p18.m4" class="ltx_Math" alttext="\boldsymbol{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\boldsymbol{X}</annotation></semantics></math> component.</p>
</div>
<div id="A3.Thmtheorem9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem9.2" class="ltx_text ltx_font_bold">Lemma C.9</span></span><span id="A3.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem9.p1" class="ltx_para">
<p id="A3.Thmtheorem9.p1.1" class="ltx_p"><span id="A3.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem9.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N},~\boldsymbol{\Theta}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><mo rspace="0.497em">,</mo><mrow><mi>𝚯</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>𝚵</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>𝚵</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\in\mathbb{N},~\boldsymbol{\Theta}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}</annotation></semantics></math>,
<math id="A3.Thmtheorem9.p1.m2" class="ltx_Math" alttext="|\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})|\leq C_{\xi}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>C</mi><mi>ξ</mi></msub></mrow><annotation encoding="application/x-tex">|\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})|\leq C_{\xi}</annotation></semantics></math> for some constant <math id="A3.Thmtheorem9.p1.m3" class="ltx_Math" alttext="C_{\xi}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>ξ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{\xi}&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p19" class="ltx_para ltx_noindent">
<p id="A3.p19.1" class="ltx_p"><span id="A3.p19.1.1" class="ltx_text ltx_font_bold">Proof.</span></p>
<table id="A3.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex145.m1" class="ltx_Math" alttext="\displaystyle|\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex145.m2" class="ltx_Math" alttext="\displaystyle=\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex146.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\right\|\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\left\|\underline{\boldsymbol{D}_{t}}\right\|\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi></mrow><mo>‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\right\|\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\left\|\underline{\boldsymbol{D}_{t}}\right\|\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex147.m1" class="ltx_Math" alttext="\displaystyle\leq 8R_{\boldsymbol{\Theta}}^{2}A_{\max}=:C_{\xi}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>max</mi></msub></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>C</mi><mi>ξ</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq 8R_{\boldsymbol{\Theta}}^{2}A_{\max}=:C_{\xi}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p19.2" class="ltx_p">where in the first inequality, we used Cauchy-Schwarz inequality and in the second inequality, we used <math id="A3.p19.m1" class="ltx_Math" alttext="\|\underline{\boldsymbol{D}_{t}}\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\underline{\boldsymbol{D}_{t}}\|\leq 1</annotation></semantics></math>, <math id="A3.p19.m2" class="ltx_Math" alttext="\|\boldsymbol{A}_{t}\|\leq A_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>A</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}_{t}\|\leq A_{\max}</annotation></semantics></math> and <math id="A3.p19.m3" class="ltx_Math" alttext="\|\boldsymbol{A}\|\leq A_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>A</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}\|\leq A_{\max}</annotation></semantics></math>.
 ∎</p>
</div>
<div id="A3.p20" class="ltx_para ltx_noindent">
<p id="A3.p20.1" class="ltx_p">Two lemmas below respectively establish Lipschitzness of the function <math id="A3.p20.m1" class="ltx_Math" alttext="\xi_{t}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\xi_{t}</annotation></semantics></math> with respect to <math id="A3.p20.m2" class="ltx_Math" alttext="\boldsymbol{\Theta}" display="inline" intent=":literal"><semantics><mi>𝚯</mi><annotation encoding="application/x-tex">\boldsymbol{\Theta}</annotation></semantics></math> component and the deviance bound with respect to <math id="A3.p20.m3" class="ltx_Math" alttext="\boldsymbol{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\boldsymbol{X}</annotation></semantics></math> component.</p>
</div>
<div id="A3.Thmtheorem10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem10.2" class="ltx_text ltx_font_bold">Lemma C.10</span></span><span id="A3.Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem10.p1" class="ltx_para">
<p id="A3.Thmtheorem10.p1.1" class="ltx_p"><span id="A3.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem10.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N},~\boldsymbol{\Theta_{1}},\boldsymbol{\Theta_{2}}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><mo rspace="0.497em">,</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo>,</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>𝚵</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>𝚵</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\in\mathbb{N},~\boldsymbol{\Theta_{1}},\boldsymbol{\Theta_{2}}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}</annotation></semantics></math>,</span></p>
<table id="A3.Ex148" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex148.m1" class="ltx_Math" alttext="\left|\xi_{t}(\boldsymbol{\Theta_{1}},\boldsymbol{X}_{t})-\xi_{t}(\boldsymbol{\Theta_{2}},\boldsymbol{X}_{t})\right|\leq L_{\xi}\|\boldsymbol{\Theta_{1}}-\boldsymbol{\Theta_{2}}\|," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mi>ξ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\xi_{t}(\boldsymbol{\Theta_{1}},\boldsymbol{X}_{t})-\xi_{t}(\boldsymbol{\Theta_{2}},\boldsymbol{X}_{t})\right|\leq L_{\xi}\|\boldsymbol{\Theta_{1}}-\boldsymbol{\Theta_{2}}\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem10.p1.2" class="ltx_p"><span id="A3.Thmtheorem10.p1.2.1" class="ltx_text ltx_font_italic">for some constant <math id="A3.Thmtheorem10.p1.m2" class="ltx_Math" alttext="L_{\xi}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>ξ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L_{\xi}&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p21" class="ltx_para ltx_noindent">
<p id="A3.p21.1" class="ltx_p"><span id="A3.p21.1.1" class="ltx_text ltx_font_bold">Proof.</span></p>
<table id="A3.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex149.m1" class="ltx_Math" alttext="\displaystyle\left|\xi_{t}(\boldsymbol{\Theta_{1}},\boldsymbol{X}_{t})-\xi_{t}(\boldsymbol{\Theta_{2}},\boldsymbol{X}_{t})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\xi_{t}(\boldsymbol{\Theta_{1}},\boldsymbol{X}_{t})-\xi_{t}(\boldsymbol{\Theta_{2}},\boldsymbol{X}_{t})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex149.m2" class="ltx_Math" alttext="\displaystyle=\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})-(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})-(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex150.m1" class="ltx_Math" alttext="\displaystyle\leq\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})-(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})-(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex151.m1" class="ltx_Math" alttext="\displaystyle\quad+\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})-(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})-(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})\right|</annotation></semantics></math></td>
