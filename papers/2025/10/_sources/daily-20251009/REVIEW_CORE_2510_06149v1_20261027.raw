<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex51.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)^{\top}\left(\boldsymbol{A}_{t}^{\top}-\boldsymbol{A}^{\top}\right)\underline{\boldsymbol{D}_{t}}\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)-\frac{\Delta\gamma_{t}}{2}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mo>⊤</mo></msubsup><mo>−</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)^{\top}\left(\boldsymbol{A}_{t}^{\top}-\boldsymbol{A}^{\top}\right)\underline{\boldsymbol{D}_{t}}\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)-\frac{\Delta\gamma_{t}}{2}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.9" class="ltx_p">where the first inequality is the direct consequence of Lemma <a href="#S4.Thmtheorem1" title="Lemma 4.1 (Lemma 2 of []). ‣ 4 Theoretical Analysis ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, i.e.,</p>
<table id="A2.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex52.m1" class="ltx_Math" alttext="(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})^{\top}\boldsymbol{A}^{\top}\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)\leq-\frac{\Delta}{2}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2},\quad(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})\in\mathbb{R}\times\mathbb{O}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mo>−</mo><mrow><mfrac><mi mathvariant="normal">Δ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝕆</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})^{\top}\boldsymbol{A}^{\top}\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)\leq-\frac{\Delta}{2}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2},\quad(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})\in\mathbb{R}\times\mathbb{O},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.10" class="ltx_p">as long as <math id="A2.SS1.p1.m25" class="ltx_Math" alttext="c_{\alpha}\geq\Delta+\sqrt{\frac{1}{\Delta^{2}(1-\lambda)^{4}}-\frac{1}{(1-\lambda)^{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>≥</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">c_{\alpha}\geq\Delta+\sqrt{\frac{1}{\Delta^{2}(1-\lambda)^{4}}-\frac{1}{(1-\lambda)^{2}}}</annotation></semantics></math>. Therefore, we obtain the following bound for the first term</p>
<table id="A2.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E10.m1" class="ltx_Math" alttext="2\beta_{t}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})^{\top}\boldsymbol{A}_{t}^{\top}\underline{\boldsymbol{D}_{t}}\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)\leq 2\beta_{t}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})-\beta_{t}\gamma_{t}\Delta\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}" display="block" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">2\beta_{t}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})^{\top}\boldsymbol{A}_{t}^{\top}\underline{\boldsymbol{D}_{t}}\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)\leq 2\beta_{t}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})-\beta_{t}\gamma_{t}\Delta\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p1.11" class="ltx_p">which holds almost surely. For the second term, notice that</p>
<table id="A2.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E11.m1" class="ltx_Math" alttext="-2\beta_{t}\left\{\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)\boldsymbol{\Theta^{*}}+\left(\boldsymbol{b}_{t}-\boldsymbol{b}\right)\right\}^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})=-2\beta_{t}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>{</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><mi>𝒃</mi></mrow><mo>)</mo></mrow></mrow><mo>}</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-2\beta_{t}\left\{\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)\boldsymbol{\Theta^{*}}+\left(\boldsymbol{b}_{t}-\boldsymbol{b}\right)\right\}^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})=-2\beta_{t}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p1.12" class="ltx_p">For the last two terms, applying Cauchy-Schwarz inequality with <math id="A2.SS1.p1.m26" class="ltx_Math" alttext="\|\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}}\|\leq\frac{(1+c_{\alpha})\beta_{t}}{(1-\lambda)^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑫</mi><mi>t</mi></msub><mo>−</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\|\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}}\|\leq\frac{(1+c_{\alpha})\beta_{t}}{(1-\lambda)^{2}}</annotation></semantics></math> (see Lemma <a href="#A3.Thmtheorem5" title="Lemma C.5. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.5</span></a>) gives us</p>
<table id="A2.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E12.m1" class="ltx_Math" alttext="\displaystyle 2\beta_{t}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})^{\top}\boldsymbol{A}_{t}^{\top}(\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}})\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑫</mi><mi>t</mi></msub><mo>−</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\beta_{t}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})^{\top}\boldsymbol{A}_{t}^{\top}(\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}})\left(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E12.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{8R_{\boldsymbol{\Theta}}^{2}A_{\max}(1+c_{\alpha})\beta_{t}^{2}}{(1-\lambda)^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>t</mi><mn>2</mn></msubsup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{8R_{\boldsymbol{\Theta}}^{2}A_{\max}(1+c_{\alpha})\beta_{t}^{2}}{(1-\lambda)^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
<tbody id="A2.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E13.m1" class="ltx_Math" alttext="\displaystyle-2\beta_{t}\left\{\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)\boldsymbol{\Theta^{*}}+\left(\boldsymbol{b}_{t}-\boldsymbol{b}\right)\right\}^{\top}(\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}})(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>{</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msub><mi>𝒃</mi><mi>t</mi></msub><mo>−</mo><mi>𝒃</mi></mrow><mo>)</mo></mrow></mrow><mo>}</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑫</mi><mi>t</mi></msub><mo>−</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-2\beta_{t}\left\{\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)\boldsymbol{\Theta^{*}}+\left(\boldsymbol{b}_{t}-\boldsymbol{b}\right)\right\}^{\top}(\boldsymbol{D}_{t}-\underline{\boldsymbol{D}_{t}})(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E13.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{8R_{\boldsymbol{\Theta}}(A_{\max}R_{\boldsymbol{\Theta}}+b_{\max})(1+c_{\alpha})\beta_{t}^{2}}{(1-\lambda)^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>A</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo>+</mo><msub><mi>b</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>t</mi><mn>2</mn></msubsup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{8R_{\boldsymbol{\Theta}}(A_{\max}R_{\boldsymbol{\Theta}}+b_{\max})(1+c_{\alpha})\beta_{t}^{2}}{(1-\lambda)^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p1.13" class="ltx_p">where <math id="A2.SS1.p1.m27" class="ltx_Math" alttext="A_{\max}:=\sqrt{c_{\alpha}^{2}+\frac{5}{(1-\lambda)^{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>max</mi></msub><mo>:=</mo><msqrt><mrow><msubsup><mi>c</mi><mi>α</mi><mn>2</mn></msubsup><mo>+</mo><mfrac><mn>5</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></msqrt></mrow><annotation encoding="application/x-tex">A_{\max}:=\sqrt{c_{\alpha}^{2}+\frac{5}{(1-\lambda)^{2}}}</annotation></semantics></math> and <math id="A2.SS1.p1.m28" class="ltx_Math" alttext="b_{\max}:=\sqrt{c_{\alpha}^{2}+\frac{1}{(1-\lambda)^{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>max</mi></msub><mo>:=</mo><msqrt><mrow><msubsup><mi>c</mi><mi>α</mi><mn>2</mn></msubsup><mo>+</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></msqrt></mrow><annotation encoding="application/x-tex">b_{\max}:=\sqrt{c_{\alpha}^{2}+\frac{1}{(1-\lambda)^{2}}}</annotation></semantics></math>, which respectively serves as a uniform bound on <math id="A2.SS1.p1.m29" class="ltx_Math" alttext="\|\boldsymbol{A}_{t}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}_{t}\|</annotation></semantics></math> and <math id="A2.SS1.p1.m30" class="ltx_Math" alttext="\|\boldsymbol{b}_{t}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><msub><mi>𝒃</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|\boldsymbol{b}_{t}\|</annotation></semantics></math>.
Combining (<a href="#A2.E10" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>), (<a href="#A2.E11" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>), (<a href="#A2.E12" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) and (<a href="#A2.E13" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>), we get</p>
<table id="A2.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E14.m1" class="ltx_Math" alttext="(*)\leq-\beta_{t}\gamma_{t}\Delta\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}+2\beta_{t}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})-2\beta_{t}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})+G_{1}\beta_{t}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow><mo>≤</mo><mrow><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>G</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(*)\leq-\beta_{t}\gamma_{t}\Delta\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}+2\beta_{t}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})-2\beta_{t}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})+G_{1}\beta_{t}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p1.14" class="ltx_p">where <math id="A2.SS1.p1.m31" class="ltx_Math" alttext="G_{1}=\{8R_{\boldsymbol{\Theta}}(2A_{\max}R_{\boldsymbol{\Theta}}+b_{\max})(1+c_{\alpha})\}/(1-\lambda)^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo>+</mo><msub><mi>b</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>/</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">G_{1}=\{8R_{\boldsymbol{\Theta}}(2A_{\max}R_{\boldsymbol{\Theta}}+b_{\max})(1+c_{\alpha})\}/(1-\lambda)^{2}</annotation></semantics></math>.</p>
</div>
<div id="A2.SS1.p2" class="ltx_para">
<p id="A2.SS1.p2.1" class="ltx_p">Next, we obtain an upper bound of the expression in <math id="A2.SS1.p2.m1" class="ltx_math_unparsed" alttext="(**)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(**)</annotation></semantics></math>. Thanks to the fact <math id="A2.SS1.p2.m2" class="ltx_Math" alttext="\|\boldsymbol{D}_{t}\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\boldsymbol{D}_{t}\|\leq 1</annotation></semantics></math>, we get</p>
<table id="A2.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E15.m1" class="ltx_math_unparsed" alttext="(**)\leq\beta_{t}^{2}\|\boldsymbol{\boldsymbol{A}_{t}}\widehat{\boldsymbol{\Theta}}_{t}+\boldsymbol{\boldsymbol{b}_{t}}\|^{2}\leq 2\beta_{t}^{2}\left(A_{\max}^{2}R_{\boldsymbol{\Theta}}^{2}+b_{\max}^{2}\right)=:G_{2}\beta_{t}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow><mo>≤</mo><msubsup><mi>β</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝑨</mi><mi>𝒕</mi></msub><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>+</mo><msub><mi>𝒃</mi><mi>𝒕</mi></msub><msup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msup><mo lspace="0.0835em">≤</mo><mn>2</mn><msubsup><mi>β</mi><mi>t</mi><mn>2</mn></msubsup><mrow><mo>(</mo><msubsup><mi>A</mi><mi>max</mi><mn>2</mn></msubsup><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>b</mi><mi>max</mi><mn>2</mn></msubsup><mo>)</mo></mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msub><mi>G</mi><mn>2</mn></msub><msubsup><mi>β</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(**)\leq\beta_{t}^{2}\|\boldsymbol{\boldsymbol{A}_{t}}\widehat{\boldsymbol{\Theta}}_{t}+\boldsymbol{\boldsymbol{b}_{t}}\|^{2}\leq 2\beta_{t}^{2}\left(A_{\max}^{2}R_{\boldsymbol{\Theta}}^{2}+b_{\max}^{2}\right)=:G_{2}\beta_{t}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p2.2" class="ltx_p">Combining (<a href="#A2.E14" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) and (<a href="#A2.E15" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>), we have</p>
<table id="A2.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex53.m1" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\leq(1-\beta_{t}\gamma_{t}\Delta)\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}+2\beta_{t}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})-2\beta_{t}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})+G\beta_{t}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\leq(1-\beta_{t}\gamma_{t}\Delta)\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}+2\beta_{t}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})-2\beta_{t}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})+G\beta_{t}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p2.3" class="ltx_p">with <math id="A2.SS1.p2.m3" class="ltx_Math" alttext="G=G_{1}+G_{2}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><msub><mi>G</mi><mn>1</mn></msub><mo>+</mo><msub><mi>G</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">G=G_{1}+G_{2}</annotation></semantics></math>. Taking expectations of both sides, we have</p>
<table id="A2.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex54.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex54.m2" class="ltx_Math" alttext="\displaystyle\leq(1-\beta_{t}\gamma_{t}\Delta)\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}+2\beta_{t}\mathbb{E}^{\mu}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})-2\beta_{t}\mathbb{E}^{\mu}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})+G\beta_{t}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1-\beta_{t}\gamma_{t}\Delta)\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}+2\beta_{t}\mathbb{E}^{\mu}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})-2\beta_{t}\mathbb{E}^{\mu}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})+G\beta_{t}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex55.m1" class="ltx_Math" alttext="\displaystyle\leq(1-\beta_{t}\gamma_{t}\Delta)\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}+2\beta_{t}\left|\mathbb{E}^{\mu}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})\right|+2\beta_{t}\left|\mathbb{E}^{\mu}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})\right|+G\beta_{t}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1-\beta_{t}\gamma_{t}\Delta)\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t}\|^{2}+2\beta_{t}\left|\mathbb{E}^{\mu}\xi_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})\right|+2\beta_{t}\left|\mathbb{E}^{\mu}\zeta_{t}(\widehat{\boldsymbol{\Theta}}_{t},\boldsymbol{X}_{t})\right|+G\beta_{t}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex56.m1" class="ltx_Math" alttext="\displaystyle\leq\left\{\prod_{i=0}^{t}(1-\beta_{i}\gamma_{i}\Delta)\right\}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\{\prod_{i=0}^{t}(1-\beta_{i}\gamma_{i}\Delta)\right\}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex57.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+2\sum_{i=0}^{t}\left\{\prod_{k=i+1}^{t}(1-\beta_{k}\gamma_{k}\Delta)\right\}\beta_{i}\left\{\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\right\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>{</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>k</mi></msub><msub><mi>γ</mi><mi>k</mi></msub><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mrow><mo>{</mo><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+2\sum_{i=0}^{t}\left\{\prod_{k=i+1}^{t}(1-\beta_{k}\gamma_{k}\Delta)\right\}\beta_{i}\left\{\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E16.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+G\sum_{i=0}^{t}\left\{\prod_{k=i+1}^{t}(1-\beta_{k}\gamma_{k}\Delta)\right\}\beta_{i}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>G</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>{</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>k</mi></msub><msub><mi>γ</mi><mi>k</mi></msub><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><msubsup><mi>β</mi><mi>i</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+G\sum_{i=0}^{t}\left\{\prod_{k=i+1}^{t}(1-\beta_{k}\gamma_{k}\Delta)\right\}\beta_{i}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p2.4" class="ltx_p">where we have used the identity <math id="A2.SS1.p2.m4" class="ltx_Math" alttext="1-\beta_{i}\gamma_{i}\Delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1-\beta_{i}\gamma_{i}\Delta\in(0,1)</annotation></semantics></math> for all <math id="A2.SS1.p2.m5" class="ltx_Math" alttext="i\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">i\in\mathbb{N}</annotation></semantics></math>, which is true by the assumption <math id="A2.SS1.p2.m6" class="ltx_Math" alttext="c_{\alpha}\geq\Delta+\sqrt{\frac{1}{\Delta^{2}(1-\lambda)^{4}}-\frac{1}{(1-\lambda)^{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>≥</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">c_{\alpha}\geq\Delta+\sqrt{\frac{1}{\Delta^{2}(1-\lambda)^{4}}-\frac{1}{(1-\lambda)^{2}}}</annotation></semantics></math>.</p>
</div>
<div id="A2.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem B.2</span></span><span id="A2.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem2.p1" class="ltx_para">
<p id="A2.Thmtheorem2.p1.1" class="ltx_p"><span id="A2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Suppose the Markov chain <math id="A2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\{S^{\mu}_{t}\}_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{S^{\mu}_{t}\}_{t\in\mathbb{N}}</annotation></semantics></math> is uniformly geometrically ergodic with a rate parameter <math id="A2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\rho\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in(0,1)</annotation></semantics></math> and the step-size ratio parameter is chosen to satisfy <math id="A2.Thmtheorem2.p1.m3" class="ltx_Math" alttext="c_{\alpha}\geq\Delta+\sqrt{\frac{1}{\Delta^{2}(1-\lambda)^{4}}-\frac{1}{(1-\lambda)^{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>≥</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">c_{\alpha}\geq\Delta+\sqrt{\frac{1}{\Delta^{2}(1-\lambda)^{4}}-\frac{1}{(1-\lambda)^{2}}}</annotation></semantics></math>. With <math id="A2.Thmtheorem2.p1.m4" class="ltx_Math" alttext="\lambda\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in[0,1)</annotation></semantics></math> and constant step-size <math id="A2.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\beta_{t}=\beta" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>=</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\beta_{t}=\beta</annotation></semantics></math>, the iterates of the projected average-reward implicit TD(<math id="A2.Thmtheorem2.p1.m6" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) algorithm satisfy the following finite-time error bound</span></p>
<table id="A2.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex58.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\lesssim(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\mathcal{O}\left(\beta\tau_{\beta}+h^{\tau_{\beta}}+\beta t\tau_{\beta}h^{t}\right),\quad t\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≲</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub></mrow><mo>+</mo><msup><mi>h</mi><msub><mi>τ</mi><mi>β</mi></msub></msup><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mi>t</mi></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}\lesssim(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}+\mathcal{O}\left(\beta\tau_{\beta}+h^{\tau_{\beta}}+\beta t\tau_{\beta}h^{t}\right),\quad t\geq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem2.p1.2" class="ltx_p"><span id="A2.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where
<math id="A2.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\gamma=\min\left\{\frac{1}{1+c_{\alpha}\beta},\frac{(1-\lambda)^{2}}{(1-\lambda)^{2}+\beta}\right\}~\text{and}~h=\max\left\{1-\beta\gamma\Delta,~\rho,~\lambda\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>=</mo><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></mfrac><mo>,</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mi>β</mi></mrow></mfrac><mo>}</mo></mrow></mrow><mo lspace="0.330em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">and</mtext><mo lspace="0.330em" rspace="0em">​</mo><mi>h</mi></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo rspace="0.497em">,</mo><mi>ρ</mi><mo rspace="0.497em">,</mo><mi>λ</mi></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma=\min\left\{\frac{1}{1+c_{\alpha}\beta},\frac{(1-\lambda)^{2}}{(1-\lambda)^{2}+\beta}\right\}~\text{and}~h=\max\left\{1-\beta\gamma\Delta,~\rho,~\lambda\right\}.</annotation></semantics></math></span></p>
</div>
</div>
<div id="A2.SS1.p3" class="ltx_para ltx_noindent">
<p id="A2.SS1.p3.1" class="ltx_p"><span id="A2.SS1.p3.1.1" class="ltx_text ltx_font_bold">Proof.</span> Starting from (<a href="#A2.E16" title="In B.1 Proof of Main Theorems ‣ Appendix B Theoretical results ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), we have</p>
<table id="A2.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex59.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{t+1}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex59.m2" class="ltx_Math" alttext="\displaystyle\leq(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex60.m1" class="ltx_math_unparsed" alttext="\displaystyle+2\beta\sum_{i=0}^{t}(1-\beta\gamma\Delta)^{t-i}\left\{\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\right\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mi>β</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mi>γ</mi><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup><mrow><mo>{</mo><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+2\beta\sum_{i=0}^{t}(1-\beta\gamma\Delta)^{t-i}\left\{\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex61.m1" class="ltx_math_unparsed" alttext="\displaystyle+G\beta^{2}\sum_{i=0}^{t}(1-\beta\gamma\Delta)^{t-i}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>G</mi><msup><mi>β</mi><mn>2</mn></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>β</mi><mi>γ</mi><mi mathvariant="normal">Δ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle+G\beta^{2}\sum_{i=0}^{t}(1-\beta\gamma\Delta)^{t-i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex62.m1" class="ltx_Math" alttext="\displaystyle\lesssim(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim(1-\beta\gamma\Delta)^{t+1}\|\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0}\|^{2}</annotation></semantics></math></td>
