<tbody id="A3.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex152.m1" class="ltx_Math" alttext="\displaystyle=\left|(\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})\right|+\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>|</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|(\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}})\right|+\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}})^{\top}\left(\boldsymbol{A}_{t}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex153.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\right\|\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\|\underline{\boldsymbol{D}_{t}}\|\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}}\right\|+\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}}\right\|\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\|\underline{\boldsymbol{D}_{t}}\|\left\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo>‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\right\|\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\|\underline{\boldsymbol{D}_{t}}\|\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{1}}\right\|+\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta_{2}}\right\|\left\|\boldsymbol{A}_{t}-\boldsymbol{A}\right\|\|\underline{\boldsymbol{D}_{t}}\|\left\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex154.m1" class="ltx_Math" alttext="\displaystyle\leq 4R_{\boldsymbol{\Theta}}A_{\max}\left\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟐</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟏</mn></msub></mrow><mo>‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4R_{\boldsymbol{\Theta}}A_{\max}\left\|\boldsymbol{\Theta_{2}}-\boldsymbol{\Theta_{1}}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex155.m1" class="ltx_Math" alttext="\displaystyle=:L_{\xi}\left\|\boldsymbol{\Theta_{1}}-\boldsymbol{\Theta_{2}}\right\|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><mrow><msub><mi>L</mi><mi>ξ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>𝚯</mi><mn>𝟏</mn></msub><mo>−</mo><msub><mi>𝚯</mi><mn>𝟐</mn></msub></mrow><mo>‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=:L_{\xi}\left\|\boldsymbol{\Theta_{1}}-\boldsymbol{\Theta_{2}}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p21.2" class="ltx_p">where in the first inequality, we used the triangle inequality. The rest of the inequalities follow from Cauchy-Schwarz inequality, <math id="A3.p21.m1" class="ltx_Math" alttext="\|\underline{\boldsymbol{D}_{t}}\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\underline{\boldsymbol{D}_{t}}\|\leq 1</annotation></semantics></math>, <math id="A3.p21.m2" class="ltx_Math" alttext="\|\boldsymbol{A}_{t}\|\leq A_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>A</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}_{t}\|\leq A_{\max}</annotation></semantics></math> and <math id="A3.p21.m3" class="ltx_Math" alttext="\|\boldsymbol{A}\|\leq A_{\max}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>A</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}\|\leq A_{\max}</annotation></semantics></math>.
 ∎</p>
</div>
<div id="A3.Thmtheorem11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem11.2" class="ltx_text ltx_font_bold">Lemma C.11</span></span><span id="A3.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem11.p1" class="ltx_para">
<p id="A3.Thmtheorem11.p1.1" class="ltx_p"><span id="A3.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem11.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N},~\boldsymbol{\Theta}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><mo rspace="0.497em">,</mo><mrow><mi>𝚯</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>𝚵</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>𝚵</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\in\mathbb{N},~\boldsymbol{\Theta}\in\{\boldsymbol{\Xi}:\|\boldsymbol{\Xi}\|\leq R_{\boldsymbol{\Theta}}\}</annotation></semantics></math>, let <math id="A3.Thmtheorem11.p1.m2" class="ltx_Math" alttext="\tau\in\{0,\cdots,t\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\cdots,t\}</annotation></semantics></math>, then we have</span></p>
<table id="A3.Ex156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex156.m1" class="ltx_math_unparsed" alttext="\left|\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|\lesssim\lambda^{\tau}." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msub><mi>ξ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ξ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≲</mo><msup><mi>λ</mi><mi>τ</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|\lesssim\lambda^{\tau}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p22" class="ltx_para ltx_noindent">
<p id="A3.p22.1" class="ltx_p"><span id="A3.p22.1.1" class="ltx_text ltx_font_bold">Proof.</span> Note that</p>
<table id="A3.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex157.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msub><mi>ξ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ξ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t})-\xi_{t}(\boldsymbol{\Theta},\boldsymbol{X}_{t-\tau:t})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex157.m2" class="ltx_math_unparsed" alttext="\displaystyle=\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})^{\top}(\boldsymbol{A}_{t}-\boldsymbol{A})^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})-(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})^{\top}(\boldsymbol{A}_{t-\tau:t}-\boldsymbol{A})^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em">|</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>−</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})^{\top}(\boldsymbol{A}_{t}-\boldsymbol{A})^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})-(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})^{\top}(\boldsymbol{A}_{t-\tau:t}-\boldsymbol{A})^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex158.m1" class="ltx_math_unparsed" alttext="\displaystyle=\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})^{\top}(\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t})^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em">|</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left|(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})^{\top}(\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t})^{\top}\underline{\boldsymbol{D}_{t}}(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex159.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\right\|\left\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\right\|\|\underline{\boldsymbol{D}_{t}}\|\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\right\|" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo>‖</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo>‖</mo></mrow><mrow><mo>‖</mo><msub><mi>𝑨</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0.167em">∥</mo><mrow><mo>‖</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mi>𝚯</mi><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\right\|\left\|\boldsymbol{A}_{t}-\boldsymbol{A}_{t-\tau:t}\right\|\|\underline{\boldsymbol{D}_{t}}\|\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex160.m1" class="ltx_Math" alttext="\displaystyle\lesssim\lambda^{\tau}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\lambda^{\tau}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p22.2" class="ltx_p">where the first inequality follows from the Cauchy-Schwarz. The last inequality follows from (<a href="#A3.E30" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) with the fact <math id="A3.p22.m1" class="ltx_Math" alttext="\|\underline{\boldsymbol{D}_{t}}\|\leq 1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>t</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\underline{\boldsymbol{D}_{t}}\|\leq 1.</annotation></semantics></math>
 ∎</p>
</div>
<div id="A3.p23" class="ltx_para ltx_noindent">
<p id="A3.p23.1" class="ltx_p">The next two lemmas will serve as key ingredients in establishing bounds on the non-steady state expectations of <math id="A3.p23.m1" class="ltx_Math" alttext="\zeta_{t}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\zeta_{t}</annotation></semantics></math> and <math id="A3.p23.m2" class="ltx_Math" alttext="\xi_{t}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\xi_{t}</annotation></semantics></math> terms.</p>
</div>
<div id="A3.Thmtheorem12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem12.2" class="ltx_text ltx_font_bold">Lemma C.12</span></span><span id="A3.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem12.p1" class="ltx_para">
<p id="A3.Thmtheorem12.p1.1" class="ltx_p"><span id="A3.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem12.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, let <math id="A3.Thmtheorem12.p1.m2" class="ltx_Math" alttext="\tau\in\{0,\cdots,t\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\cdots,t\}</annotation></semantics></math>, then we have</span></p>
<table id="A3.Ex161" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex161.m1" class="ltx_math_unparsed" alttext="\|\mathbb{E}^{\mu}\left(\boldsymbol{A}_{t-\tau:t}\right)-\boldsymbol{A}\|\lesssim\tau q^{t}+\lambda^{\tau}" display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>−</mo><mi>𝑨</mi><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≲</mo><mi>τ</mi><msup><mi>q</mi><mi>t</mi></msup><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow><annotation encoding="application/x-tex">\|\mathbb{E}^{\mu}\left(\boldsymbol{A}_{t-\tau:t}\right)-\boldsymbol{A}\|\lesssim\tau q^{t}+\lambda^{\tau}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem12.p1.2" class="ltx_p"><span id="A3.Thmtheorem12.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A3.Thmtheorem12.p1.m3" class="ltx_Math" alttext="q:=\max\{\lambda,\rho\}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>,</mo><mi>ρ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q:=\max\{\lambda,\rho\}.</annotation></semantics></math></span></p>
</div>
</div>
<div id="A3.p24" class="ltx_para ltx_noindent">
<p id="A3.p24.1" class="ltx_p"><span id="A3.p24.1.1" class="ltx_text ltx_font_bold">Proof.</span> Note that</p>
<table id="A3.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex162.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}^{\mu}\left(\boldsymbol{A}_{t-\tau:t}\right)-\boldsymbol{A}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>−</mo><mi>𝑨</mi></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\left(\boldsymbol{A}_{t-\tau:t}\right)-\boldsymbol{A}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex162.m2" class="ltx_math_unparsed" alttext="\displaystyle=\begin{bmatrix}-c_{\alpha}&amp;0\\
-\mathbb{E}^{\mu}(\boldsymbol{z}_{t-\tau:t})&amp;\mathbb{E}^{\mu}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}\end{bmatrix}-\begin{bmatrix}-c_{\alpha}&amp;0\\
-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t})&amp;\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mo>−</mo><msub><mi>c</mi><mi>α</mi></msub></mrow></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mrow><mo>−</mo><mi>𝔼</mi><msup><mrow></mrow><mi>μ</mi></msup><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>−</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo>−</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mo>−</mo><msub><mi>c</mi><mi>α</mi></msub></mrow></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>−</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}-c_{\alpha}&amp;0\\
-\mathbb{E}^{\mu}(\boldsymbol{z}_{t-\tau:t})&amp;\mathbb{E}^{\mu}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}\end{bmatrix}-\begin{bmatrix}-c_{\alpha}&amp;0\\
-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t})&amp;\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex163.m1" class="ltx_math_unparsed" alttext="\displaystyle=\begin{bmatrix}0&amp;0\\
\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(\boldsymbol{z}_{t-\tau:t})&amp;\mathbb{E}^{\mu}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}\end{bmatrix}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mrow><mi>𝔼</mi><msup><mrow></mrow><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mi>𝔼</mi><msup><mrow></mrow><mi>μ</mi></msup><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>−</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>−</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}0&amp;0\\
\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(\boldsymbol{z}_{t-\tau:t})&amp;\mathbb{E}^{\mu}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p24.2" class="ltx_p">Therefore,</p>
<table id="A3.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex164"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex164.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\mathbb{E}^{\mu}(\boldsymbol{A}_{t-\tau:t})-\boldsymbol{A}\right\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝑨</mi><mo>‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}^{\mu}(\boldsymbol{A}_{t-\tau:t})-\boldsymbol{A}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex164.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\|\mathbb{E}^{\mu}(\boldsymbol{A}_{t-\tau:t})-\boldsymbol{A}\right\|_{F}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msubsup><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝑨</mi><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\mathbb{E}^{\mu}(\boldsymbol{A}_{t-\tau:t})-\boldsymbol{A}\right\|_{F}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex165.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(\boldsymbol{z}_{t-\tau:t})\right\|^{2}+\left\|\mathbb{E}^{\mu}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msup><mrow><mo>‖</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">{</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>−</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">{</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo>−</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(\boldsymbol{z}_{t-\tau:t})\right\|^{2}+\left\|\mathbb{E}^{\mu}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}\{\boldsymbol{z}_{t}(\boldsymbol{\phi}_{t+1}^{\top}-\boldsymbol{\phi}_{t}^{\top})\}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex166.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(\boldsymbol{z}_{t-\tau:t})\right\|^{2}+2\left\|\mathbb{E}^{\mu}(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top})-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top})\right\|^{2}+2\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top})-\mathbb{E}^{\mu}(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msup><mrow><mo>‖</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>2</mn><msup><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>2</mn><msup><mrow><mo>‖</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>t</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t})-\mathbb{E}^{\mu}(\boldsymbol{z}_{t-\tau:t})\right\|^{2}+2\left\|\mathbb{E}^{\mu}(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top})-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t+1}^{\top})\right\|^{2}+2\left\|\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top})-\mathbb{E}^{\mu}(\boldsymbol{z}_{t}\boldsymbol{\phi}_{t}^{\top})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex167.m1" class="ltx_Math" alttext="\displaystyle\lesssim\left(\tau q^{t}+\lambda^{\tau}\right)^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><msup><mrow><mo>(</mo><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>t</mi></msup></mrow><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\left(\tau q^{t}+\lambda^{\tau}\right)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p24.3" class="ltx_p">where the last line follows from Lemma <a href="#A3.Thmtheorem2" title="Lemma C.2. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a>.
 ∎</p>
</div>
<div id="A3.Thmtheorem13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem13.2" class="ltx_text ltx_font_bold">Lemma C.13</span></span><span id="A3.Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem13.p1" class="ltx_para">
<p id="A3.Thmtheorem13.p1.1" class="ltx_p"><span id="A3.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="A3.Thmtheorem13.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, let <math id="A3.Thmtheorem13.p1.m2" class="ltx_Math" alttext="\tau\in\{0,\cdots,t\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\cdots,t\}</annotation></semantics></math>, then we have</span></p>
<table id="A3.Ex168" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex168.m1" class="ltx_math_unparsed" alttext="\|\mathbb{E}^{\mu}\left(\boldsymbol{b}_{t-\tau:t}\right)-\boldsymbol{b}\|\lesssim\tau q^{t}+\lambda^{\tau}," display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒃</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>−</mo><mi>𝒃</mi><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≲</mo><mi>τ</mi><msup><mi>q</mi><mi>t</mi></msup><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\|\mathbb{E}^{\mu}\left(\boldsymbol{b}_{t-\tau:t}\right)-\boldsymbol{b}\|\lesssim\tau q^{t}+\lambda^{\tau},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem13.p1.2" class="ltx_p"><span id="A3.Thmtheorem13.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A3.Thmtheorem13.p1.m3" class="ltx_Math" alttext="q=\max\{\lambda,\rho\}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>,</mo><mi>ρ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q=\max\{\lambda,\rho\}.</annotation></semantics></math></span></p>
</div>
</div>
<div id="A3.p25" class="ltx_para ltx_noindent">
<p id="A3.p25.1" class="ltx_p"><span id="A3.p25.1.1" class="ltx_text ltx_font_bold">Proof.</span> Note that</p>
<table id="A3.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex169"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex169.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}^{\mu}\left(\boldsymbol{b}_{t-\tau:t}\right)-\boldsymbol{b}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒃</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>−</mo><mi>𝒃</mi></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\left(\boldsymbol{b}_{t-\tau:t}\right)-\boldsymbol{b}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex169.m2" class="ltx_math_unparsed" alttext="\displaystyle=\begin{bmatrix}c_{\alpha}\mathbb{E}^{\mu}(R^{\mu}_{t})-c_{\alpha}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})\\
\mathbb{E}^{\mu}(R^{\mu}_{t}\boldsymbol{z}_{t-\tau:t})-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>𝔼</mi><msup><mrow></mrow><mi>μ</mi></msup><mo stretchy="false">(</mo><mi>R</mi><msup><mrow></mrow><mi>μ</mi></msup><msub><mrow></mrow><mi>t</mi></msub><mi>𝒛</mi><msub><mrow></mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo><mo>−</mo><mi>𝔼</mi><msup><mrow></mrow><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mo stretchy="false">(</mo><mi>R</mi><msup><mrow></mrow><mi>μ</mi></msup><msub><mrow></mrow><mi>t</mi></msub><mi>𝒛</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}c_{\alpha}\mathbb{E}^{\mu}(R^{\mu}_{t})-c_{\alpha}\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})\\
\mathbb{E}^{\mu}(R^{\mu}_{t}\boldsymbol{z}_{t-\tau:t})-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p25.2" class="ltx_p">Therefore,</p>
<table id="A3.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex170"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex170.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\mathbb{E}^{\mu}\left(\boldsymbol{b}_{t-\tau:t}\right)-\boldsymbol{b}\right\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒃</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>−</mo><mi>𝒃</mi><mo>‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}^{\mu}\left(\boldsymbol{b}_{t-\tau:t}\right)-\boldsymbol{b}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex170.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq c_{\alpha}^{2}\left|\mathbb{E}^{\mu}(R_{t})-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})\right|^{2}+\left\|\mathbb{E}^{\mu}(R_{t}\boldsymbol{z}_{t-\tau:t})-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msubsup><mi>c</mi><mi>α</mi><mn>2</mn></msubsup><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow><msup><mo fence="false">|</mo><mn>2</mn></msup><mo lspace="0em">+</mo><msup><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>t</mi></msub><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><msup><mi>𝝅</mi><mi>μ</mi></msup></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{\alpha}^{2}\left|\mathbb{E}^{\mu}(R_{t})-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t})\right|^{2}+\left\|\mathbb{E}^{\mu}(R_{t}\boldsymbol{z}_{t-\tau:t})-\mathbb{E}^{\boldsymbol{\pi}^{\mu}}(R^{\mu}_{t}\boldsymbol{z}_{t})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex171.m1" class="ltx_Math" alttext="\displaystyle\lesssim c_{\alpha}^{2}\rho^{2t}+\left(\tau q^{t}+\lambda^{\tau}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><msubsup><mi>c</mi><mi>α</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mo>+</mo><msup><mrow><mo>(</mo><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>t</mi></msup></mrow><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim c_{\alpha}^{2}\rho^{2t}+\left(\tau q^{t}+\lambda^{\tau}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex172.m1" class="ltx_Math" alttext="\displaystyle\lesssim\left(\tau q^{t}+\lambda^{\tau}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><msup><mrow><mo>(</mo><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>t</mi></msup></mrow><mo>+</mo><msup><mi>λ</mi><mi>τ</mi></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\left(\tau q^{t}+\lambda^{\tau}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p25.3" class="ltx_p">where the second inequality follows from Lemma <a href="#A3.Thmtheorem3" title="Lemma C.3. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.3</span></a>.
 ∎</p>
</div>
<div id="A3.p26" class="ltx_para ltx_noindent">
<p id="A3.p26.1" class="ltx_p">We now establish bounds on the expectation of <math id="A3.p26.m1" class="ltx_Math" alttext="\zeta_{t}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\zeta_{t}</annotation></semantics></math>.</p>
</div>
<div id="A3.Thmtheorem14" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem14.2" class="ltx_text ltx_font_bold">Lemma C.14</span></span><span id="A3.Thmtheorem14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem14.p1" class="ltx_para">
<p id="A3.Thmtheorem14.p1.1" class="ltx_p"><span id="A3.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="A3.Thmtheorem14.p1.m1" class="ltx_Math" alttext="(\beta_{t})_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">(\beta_{t})_{t\in\mathbb{N}}</annotation></semantics></math> is a non-increasing sequence and <math id="A3.Thmtheorem14.p1.m2" class="ltx_Math" alttext="q=\max\{\lambda,\rho\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>,</mo><mi>ρ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q=\max\{\lambda,\rho\}</annotation></semantics></math>. Given <math id="A3.Thmtheorem14.p1.m3" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, suppose <math id="A3.Thmtheorem14.p1.m4" class="ltx_Math" alttext="i&gt;2\tau_{\beta_{t}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">i&gt;2\tau_{\beta_{t}}</annotation></semantics></math> then,</span></p>
<table id="A3.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex173"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex173.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≲</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem14.p1.2" class="ltx_p"><span id="A3.Thmtheorem14.p1.2.1" class="ltx_text ltx_font_italic">Otherwise,</span></p>
<table id="A3.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex174.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{0}+iq^{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≲</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{0}+iq^{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p27" class="ltx_para ltx_noindent">
<p id="A3.p27.1" class="ltx_p"><span id="A3.p27.1.1" class="ltx_text ltx_font_bold">Proof.</span> We begin by considering the case <math id="A3.p27.m1" class="ltx_Math" alttext="i&gt;2\tau_{\beta_{t}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">i&gt;2\tau_{\beta_{t}}</annotation></semantics></math>. From the triangle inequality, we have</p>
<table id="A3.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E32.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E32.m2" class="ltx_Math" alttext="\displaystyle\leq\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
<tbody id="A3.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E33.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
<tbody id="A3.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E34.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
<p id="A3.p27.2" class="ltx_p">To obtain an upper bound of (<a href="#A3.E32" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>), note that</p>
<table id="A3.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex175"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex175.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex176.m1" class="ltx_Math" alttext="\displaystyle\leq\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\boldsymbol{\Theta}_{i-1},\boldsymbol{X}_{i})\right|+\cdots+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}+1},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\boldsymbol{\Theta}_{i-1},\boldsymbol{X}_{i})\right|+\cdots+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}+1},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35.m1" class="ltx_Math" alttext="\displaystyle\leq L_{\zeta}\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>L</mi><mi>ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq L_{\zeta}\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A3.p27.3" class="ltx_p">where we used Lemma <a href="#A3.Thmtheorem7" title="Lemma C.7. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.7</span></a> in the second inequality. For <math id="A3.p27.m2" class="ltx_Math" alttext="\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|</annotation></semantics></math>, we observe the following inequality</p>
<table id="A3.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex177.m1" class="ltx_Math" alttext="\displaystyle\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex177.m2" class="ltx_Math" alttext="\displaystyle=\left\|\boldsymbol{\Pi}\left[\Pi_{R_{\boldsymbol{\Theta}}}\left\{\widehat{\boldsymbol{\Theta}}_{l}+\beta_{l}\underline{\boldsymbol{D}_{l}}\left(\boldsymbol{A}_{l}\widehat{\boldsymbol{\Theta}}_{l}+\boldsymbol{b}_{l}\right)\right\}\right]-\boldsymbol{\Pi}\left(\Pi_{R_{\boldsymbol{\Theta}}}\widehat{\boldsymbol{\Theta}}_{l}\right)\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>‖</mo><mrow><mrow><mi>𝚷</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi mathvariant="normal">Π</mi><msub><mi>R</mi><mi>𝚯</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub><mo>+</mo><mrow><msub><mi>β</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>l</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝑨</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>+</mo><msub><mi>𝒃</mi><mi>l</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝚷</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathvariant="normal">Π</mi><msub><mi>R</mi><mi>𝚯</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\boldsymbol{\Pi}\left[\Pi_{R_{\boldsymbol{\Theta}}}\left\{\widehat{\boldsymbol{\Theta}}_{l}+\beta_{l}\underline{\boldsymbol{D}_{l}}\left(\boldsymbol{A}_{l}\widehat{\boldsymbol{\Theta}}_{l}+\boldsymbol{b}_{l}\right)\right\}\right]-\boldsymbol{\Pi}\left(\Pi_{R_{\boldsymbol{\Theta}}}\widehat{\boldsymbol{\Theta}}_{l}\right)\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex178"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex178.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\Pi_{R_{\boldsymbol{\Theta}}}\left\{\widehat{\boldsymbol{\Theta}}_{l}+\beta_{l}\underline{\boldsymbol{D}_{l}}\left(\boldsymbol{A}_{l}\widehat{\boldsymbol{\Theta}}_{l}+\boldsymbol{b}_{l}\right)\right\}-\Pi_{R_{\boldsymbol{\Theta}}}\widehat{\boldsymbol{\Theta}}_{l}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>‖</mo><mrow><mrow><msub><mi mathvariant="normal">Π</mi><msub><mi>R</mi><mi>𝚯</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub><mo>+</mo><mrow><msub><mi>β</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>l</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝑨</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>+</mo><msub><mi>𝒃</mi><mi>l</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Π</mi><msub><mi>R</mi><mi>𝚯</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow></mrow><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\Pi_{R_{\boldsymbol{\Theta}}}\left\{\widehat{\boldsymbol{\Theta}}_{l}+\beta_{l}\underline{\boldsymbol{D}_{l}}\left(\boldsymbol{A}_{l}\widehat{\boldsymbol{\Theta}}_{l}+\boldsymbol{b}_{l}\right)\right\}-\Pi_{R_{\boldsymbol{\Theta}}}\widehat{\boldsymbol{\Theta}}_{l}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex179.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\widehat{\boldsymbol{\Theta}}_{l}+\beta_{l}\underline{\boldsymbol{D}_{l}}\left\{\boldsymbol{A}_{l}\widehat{\boldsymbol{\Theta}}_{l}+\boldsymbol{b}_{l}\right\}-\widehat{\boldsymbol{\Theta}}_{l}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>‖</mo><mrow><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub><mo>+</mo><mrow><msub><mi>β</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>l</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>𝑨</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>+</mo><msub><mi>𝒃</mi><mi>l</mi></msub></mrow><mo>}</mo></mrow></mrow></mrow><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\widehat{\boldsymbol{\Theta}}_{l}+\beta_{l}\underline{\boldsymbol{D}_{l}}\left\{\boldsymbol{A}_{l}\widehat{\boldsymbol{\Theta}}_{l}+\boldsymbol{b}_{l}\right\}-\widehat{\boldsymbol{\Theta}}_{l}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex180"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex180.m1" class="ltx_Math" alttext="\displaystyle\leq\beta_{l}\left\|\boldsymbol{A}_{l}\widehat{\boldsymbol{\Theta}}_{l}+\boldsymbol{b}_{l}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>β</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝑨</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>+</mo><msub><mi>𝒃</mi><mi>l</mi></msub></mrow><mo>‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\beta_{l}\left\|\boldsymbol{A}_{l}\widehat{\boldsymbol{\Theta}}_{l}+\boldsymbol{b}_{l}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E36.m1" class="ltx_Math" alttext="\displaystyle\leq\beta_{l}(A_{\max}R_{\boldsymbol{\Theta}}+b_{\max})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>β</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>A</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo>+</mo><msub><mi>b</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\beta_{l}(A_{\max}R_{\boldsymbol{\Theta}}+b_{\max}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
<p id="A3.p27.4" class="ltx_p">The first and second inequalities follow from the non-expansiveness of the projection operators, while the third inequality follows from the bound <math id="A3.p27.m3" class="ltx_Math" alttext="\|\underline{\boldsymbol{D}_{l}}\|\leq 1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>l</mi></msub><mo stretchy="true">¯</mo></munder><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\underline{\boldsymbol{D}_{l}}\|\leq 1.</annotation></semantics></math> Plugging (<a href="#A3.E36" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) back to (<a href="#A3.E35" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>), we have</p>
<table id="A3.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E37.m1" class="ltx_Math" alttext="\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\beta_{l}" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo rspace="0.111em">≲</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover><msub><mi>β</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\beta_{l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="A3.p27.5" class="ltx_p">Next, by applying Lemma <a href="#A3.Thmtheorem8" title="Lemma C.8. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.8</span></a> together with Jensen’s inequality, we immediately observe the upper bound of the term in (<a href="#A3.E33" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>), namely,</p>
<table id="A3.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E38.m1" class="ltx_math_unparsed" alttext="\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\lambda^{\tau_{\beta_{t}}}." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≲</mo><msup><mi>λ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\lambda^{\tau_{\beta_{t}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="A3.p27.6" class="ltx_p">We now obtain an upper bound of the term in (<a href="#A3.E34" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>). To this end, let us set</p>
<table id="A3.Ex181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex181.m1" class="ltx_math_unparsed" alttext="f_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}):=\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})," display="block" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝒀</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><msub><mi>ζ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}):=\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.7" class="ltx_p">where <math id="A3.p27.m4" class="ltx_math_unparsed" alttext="\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}=\left(S^{\mu}_{i-\tau_{\beta_{t}}},S^{\mu}_{i-\tau_{\beta_{t}}+1},\cdots,S^{\mu}_{i-1},\boldsymbol{X}_{i}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒀</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mo>(</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mi>μ</mi></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}=\left(S^{\mu}_{i-\tau_{\beta_{t}}},S^{\mu}_{i-\tau_{\beta_{t}}+1},\cdots,S^{\mu}_{i-1},\boldsymbol{X}_{i}\right)</annotation></semantics></math>. We further define <math id="A3.p27.m5" class="ltx_Math" alttext="\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><annotation encoding="application/x-tex">\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}</annotation></semantics></math> and <math id="A3.p27.m6" class="ltx_math_unparsed" alttext="\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}" display="inline" intent=":literal"><semantics><mrow><mi>𝒀</mi><msup><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo></msup><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}</annotation></semantics></math> as random variables drawn independently from the marginal distributions of <math id="A3.p27.m7" class="ltx_Math" alttext="\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><annotation encoding="application/x-tex">\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}}</annotation></semantics></math> and <math id="A3.p27.m8" class="ltx_math_unparsed" alttext="\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}" display="inline" intent=":literal"><semantics><mrow><mi>𝒀</mi><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}</annotation></semantics></math> respectively. Since</p>
<table id="A3.Ex182" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex182.m1" class="ltx_Math" alttext="\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}}\to S^{\mu}_{i-2\tau_{\beta_{t}}}\to S^{\mu}_{i-\tau_{\beta_{t}}}\to S^{\mu}_{i}\to\boldsymbol{X}_{i}=(S^{\mu}_{i},S^{\mu}_{i+1},\boldsymbol{z}_{i})" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo stretchy="false">→</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mi>μ</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mi>μ</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>S</mi><mi>i</mi><mi>μ</mi></msubsup><mo stretchy="false">→</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>S</mi><mi>i</mi><mi>μ</mi></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo>,</mo><msub><mi>𝒛</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}}\to S^{\mu}_{i-2\tau_{\beta_{t}}}\to S^{\mu}_{i-\tau_{\beta_{t}}}\to S^{\mu}_{i}\to\boldsymbol{X}_{i}=(S^{\mu}_{i},S^{\mu}_{i+1},\boldsymbol{z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.8" class="ltx_p">forms a Markov chain, an application of Lemma 9 in <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite> results in</p>
<table id="A3.Ex183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex183.m1" class="ltx_math_unparsed" alttext="\left|\mathbb{E}^{\mu}f_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\left|\mathbb{E}f_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|+\rho^{\tau_{\beta_{t}}}," display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝒀</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em" rspace="0em">≲</mo><mo fence="false" rspace="0.167em">|</mo><mi>𝔼</mi><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>,</mo><mmultiscripts><mi>𝒀</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0em">+</mo><msup><mi>ρ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}f_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\left|\mathbb{E}f_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|+\rho^{\tau_{\beta_{t}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.9" class="ltx_p">for all <math id="A3.p27.m9" class="ltx_Math" alttext="i&gt;2\tau_{\beta_{t}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">i&gt;2\tau_{\beta_{t}}</annotation></semantics></math>. Since <math id="A3.p27.m10" class="ltx_Math" alttext="\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><annotation encoding="application/x-tex">\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}</annotation></semantics></math> and <math id="A3.p27.m11" class="ltx_math_unparsed" alttext="\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}" display="inline" intent=":literal"><semantics><mrow><mi>𝒀</mi><msup><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo></msup><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}</annotation></semantics></math> are independent to each other, we get</p>
<table id="A3.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex184"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex184.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}f_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>,</mo><mmultiscripts><mi>𝒀</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}f_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex184.m2" class="ltx_math_unparsed" alttext="\displaystyle=\boldsymbol{\Theta^{*}}^{\top}\mathbb{E}^{\mu}\left(\boldsymbol{A}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}\mathbb{E}^{\mu}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>𝔼</mi><mi>μ</mi></msup><msup><mrow><mo>(</mo><msub><mi>𝑨</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>−</mo><mi>𝑨</mi><mo>)</mo></mrow><mo>⊤</mo></msup><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{\Theta^{*}}^{\top}\mathbb{E}^{\mu}\left(\boldsymbol{A}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}\mathbb{E}^{\mu}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex185"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex185.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\mathbb{E}^{\mu}\left(\boldsymbol{b}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{b}\right)^{\top}\underline{\boldsymbol{D}_{i}}\mathbb{E}^{\mu}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msup><mrow><mo>(</mo><msub><mi>𝒃</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>−</mo><mi>𝒃</mi><mo>)</mo></mrow><mo>⊤</mo></msup><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\mathbb{E}^{\mu}\left(\boldsymbol{b}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{b}\right)^{\top}\underline{\boldsymbol{D}_{i}}\mathbb{E}^{\mu}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.10" class="ltx_p">From the Cauchy-Schwarz inequality coupled with the Jensen’s inequality, we get</p>
<table id="A3.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex186"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex186.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|\mathbb{E}f_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><mi>𝔼</mi><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>,</mo><mmultiscripts><mi>𝒀</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}f_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex186.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq 2\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)\right\|R_{\boldsymbol{\Theta}}^{2}+2\left\|\mathbb{E}^{\mu}\left(\boldsymbol{b}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{b}\right)\right\|R_{\boldsymbol{\Theta}}\lesssim\tau_{\beta_{t}}q^{i}+\lambda^{\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>2</mn><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝑨</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>−</mo><mi>𝑨</mi><mo>)</mo></mrow><mo>‖</mo></mrow><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup><mo>+</mo><mn>2</mn><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><msub><mi>𝒃</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>−</mo><mi>𝒃</mi><mo>)</mo></mrow><mo>‖</mo></mrow><msub><mi>R</mi><mi>𝚯</mi></msub><mo>≲</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>q</mi><mi>i</mi></msup><mo>+</mo><msup><mi>λ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)\right\|R_{\boldsymbol{\Theta}}^{2}+2\left\|\mathbb{E}^{\mu}\left(\boldsymbol{b}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{b}\right)\right\|R_{\boldsymbol{\Theta}}\lesssim\tau_{\beta_{t}}q^{i}+\lambda^{\tau_{\beta_{t}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.11" class="ltx_p">where the second inequality is due to Lemma <a href="#A3.Thmtheorem12" title="Lemma C.12. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.12</span></a> and Lemma <a href="#A3.Thmtheorem13" title="Lemma C.13. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.13</span></a>. Therefore, we get</p>
<table id="A3.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E39.m1" class="ltx_math_unparsed" alttext="\left|\mathbb{E}^{\mu}f_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\tau_{\beta_{t}}q^{i}+\lambda^{\tau_{\beta_{t}}}+\rho^{\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}," display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝒀</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≲</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>q</mi><mi>i</mi></msup><mo>+</mo><msup><mi>λ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>+</mo><msup><mi>ρ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>≲</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>q</mi><mi>i</mi></msup><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}f_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\tau_{\beta_{t}}q^{i}+\lambda^{\tau_{\beta_{t}}}+\rho^{\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="A3.p27.12" class="ltx_p">with <math id="A3.p27.m12" class="ltx_Math" alttext="q=\max\{\lambda,\rho\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>,</mo><mi>ρ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q=\max\{\lambda,\rho\}</annotation></semantics></math>. Combining (<a href="#A3.E37" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>), (<a href="#A3.E38" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>) and (<a href="#A3.E39" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>), we get</p>
<table id="A3.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex187"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex187.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\beta_{l}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≲</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>β</mi><mi>l</mi></msub></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow><mo>≲</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\beta_{l}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.13" class="ltx_p">Next we consider the case <math id="A3.p27.m13" class="ltx_Math" alttext="i\leq 2\tau_{\beta_{t}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">i\leq 2\tau_{\beta_{t}}</annotation></semantics></math>. From the triangle inequality, we have</p>
<table id="A3.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex188.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\leq\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\leq\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|+\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.14" class="ltx_p">From Lemma <a href="#A3.Thmtheorem7" title="Lemma C.7. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.7</span></a> combined with (<a href="#A3.E36" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>), we have</p>
<table id="A3.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E40.m1" class="ltx_Math" alttext="\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=0}^{i-1}\beta_{l}\lesssim\tau_{\beta_{t}}\beta_{0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo rspace="0.111em">≲</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover><msub><mi>β</mi><mi>l</mi></msub></mrow><mo>≲</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=0}^{i-1}\beta_{l}\lesssim\tau_{\beta_{t}}\beta_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="A3.p27.15" class="ltx_p">For the second term, since <math id="A3.p27.m14" class="ltx_Math" alttext="\widehat{\boldsymbol{\Theta}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\widehat{\boldsymbol{\Theta}}_{0}</annotation></semantics></math> is deterministic,</p>
<table id="A3.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex189.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})=\left\langle\mathbb{E}^{\mu}\left(\boldsymbol{A}_{i}-\boldsymbol{A}\right)\boldsymbol{\Theta^{*}},\underline{\boldsymbol{D}_{i}}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0})\right\rangle+\left\langle\mathbb{E}^{\mu}\left(\boldsymbol{b}-\boldsymbol{b}_{i}\right),\underline{\boldsymbol{D}_{i}}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0})\right\rangle," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>i</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup></mrow><mo>,</mo><mrow><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow><mo>+</mo><mrow><mo>⟨</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝒃</mi><mo>−</mo><msub><mi>𝒃</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>,</mo><mrow><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})=\left\langle\mathbb{E}^{\mu}\left(\boldsymbol{A}_{i}-\boldsymbol{A}\right)\boldsymbol{\Theta^{*}},\underline{\boldsymbol{D}_{i}}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0})\right\rangle+\left\langle\mathbb{E}^{\mu}\left(\boldsymbol{b}-\boldsymbol{b}_{i}\right),\underline{\boldsymbol{D}_{i}}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0})\right\rangle,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.16" class="ltx_p">and therefore</p>
<table id="A3.E41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E41.m1" class="ltx_Math" alttext="\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|\leq 2\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A}_{i}-\boldsymbol{A}\right)\right\|R_{\boldsymbol{\Theta}}^{2}+2\left\|\mathbb{E}^{\mu}\left(\boldsymbol{b}-\boldsymbol{b}_{i}\right)\right\|R_{\boldsymbol{\Theta}}\lesssim iq^{i}+\lambda^{i}\lesssim iq^{i}" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>i</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝒃</mi><mo>−</mo><msub><mi>𝒃</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow></mrow><mo>≲</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow><mo>+</mo><msup><mi>λ</mi><mi>i</mi></msup></mrow><mo>≲</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|\leq 2\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A}_{i}-\boldsymbol{A}\right)\right\|R_{\boldsymbol{\Theta}}^{2}+2\left\|\mathbb{E}^{\mu}\left(\boldsymbol{b}-\boldsymbol{b}_{i}\right)\right\|R_{\boldsymbol{\Theta}}\lesssim iq^{i}+\lambda^{i}\lesssim iq^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
<p id="A3.p27.17" class="ltx_p">where the second inequality follows from Lemma <a href="#A3.Thmtheorem12" title="Lemma C.12. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.12</span></a> and the last inequality is by the definition <math id="A3.p27.m15" class="ltx_Math" alttext="q:=\max\{\lambda,\rho\}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">}</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q:=\max\{\lambda,\rho\}\in(0,1)</annotation></semantics></math>. Combining (<a href="#A3.E40" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>) and (<a href="#A3.E41" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>), we get</p>
<table id="A3.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex190.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{0}+iq^{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≲</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{0}+iq^{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.18" class="ltx_p">∎</p>
</div>
<div id="A3.Thmtheorem15" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem15.2" class="ltx_text ltx_font_bold">Lemma C.15</span></span><span id="A3.Thmtheorem15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem15.p1" class="ltx_para">
<p id="A3.Thmtheorem15.p1.1" class="ltx_p"><span id="A3.Thmtheorem15.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="A3.Thmtheorem15.p1.m1" class="ltx_Math" alttext="(\beta_{t})_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">(\beta_{t})_{t\in\mathbb{N}}</annotation></semantics></math> is a non-increasing sequence and <math id="A3.Thmtheorem15.p1.m2" class="ltx_Math" alttext="q=\max\{\lambda,\rho\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>,</mo><mi>ρ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q=\max\{\lambda,\rho\}</annotation></semantics></math>. Given <math id="A3.Thmtheorem15.p1.m3" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, suppose <math id="A3.Thmtheorem15.p1.m4" class="ltx_Math" alttext="i&gt;2\tau_{\beta_{t}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">i&gt;2\tau_{\beta_{t}}</annotation></semantics></math> then,</span></p>
<table id="A3.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex191.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≲</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem15.p1.2" class="ltx_p"><span id="A3.Thmtheorem15.p1.2.1" class="ltx_text ltx_font_italic">Otherwise,</span></p>
<table id="A3.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex192"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex192.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{0}+iq^{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≲</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{0}+iq^{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p28" class="ltx_para ltx_noindent">
<p id="A3.p28.1" class="ltx_p"><span id="A3.p28.1.1" class="ltx_text ltx_font_bold">Proof.</span> We begin by considering the case <math id="A3.p28.m1" class="ltx_Math" alttext="i&gt;2\tau_{\beta_{t}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">i&gt;2\tau_{\beta_{t}}</annotation></semantics></math>. Again by the triangle inequality, we have</p>
<table id="A3.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E42.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E42.m2" class="ltx_Math" alttext="\displaystyle\leq\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
<tbody id="A3.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E43.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
<tbody id="A3.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E44.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
</table>
<p id="A3.p28.2" class="ltx_p">To obtain an upper bound of (<a href="#A3.E42" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>), note that</p>
<table id="A3.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex193.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex193.m2" class="ltx_Math" alttext="\displaystyle\leq\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\boldsymbol{\Theta}_{i-1},\boldsymbol{X}_{i})\right|+\cdots" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝚯</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mo lspace="0em">⋯</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\boldsymbol{\Theta}_{i-1},\boldsymbol{X}_{i})\right|+\cdots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex194.m1" class="ltx_Math" alttext="\displaystyle\quad+\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}+1},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}+1},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E45.m1" class="ltx_Math" alttext="\displaystyle\leq L_{\xi}\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>L</mi><mi>ξ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq L_{\xi}\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
<p id="A3.p28.3" class="ltx_p">where the second inequality is due to Lemma <a href="#A3.Thmtheorem10" title="Lemma C.10. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.10</span></a>. Recall from (<a href="#A3.E36" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) that</p>
<table id="A3.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex195.m1" class="ltx_Math" alttext="\displaystyle\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|\leq\beta_{l}(A_{\max}R_{\boldsymbol{\Theta}}+b_{\max})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>l</mi></msub></mrow><mo>‖</mo></mrow><mo>≤</mo><mrow><msub><mi>β</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>A</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>𝚯</mi></msub></mrow><mo>+</mo><msub><mi>b</mi><mi>max</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\widehat{\boldsymbol{\Theta}}_{l+1}-\widehat{\boldsymbol{\Theta}}_{l}\right\|\leq\beta_{l}(A_{\max}R_{\boldsymbol{\Theta}}+b_{\max}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.4" class="ltx_p">Plugging (<a href="#A3.E36" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) back to (<a href="#A3.E45" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>), we have</p>
<table id="A3.E46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E46.m1" class="ltx_Math" alttext="\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\beta_{l}" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo rspace="0.111em">≲</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover><msub><mi>β</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\beta_{l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
<p id="A3.p28.5" class="ltx_p">Next, by applying Lemma <a href="#A3.Thmtheorem11" title="Lemma C.11. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.11</span></a> together with Jensen’s inequality, we immediately obtain the upper bound of the term in (<a href="#A3.E43" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>), namely,</p>
<table id="A3.E47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E47.m1" class="ltx_math_unparsed" alttext="\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\lambda^{\tau_{\beta_{t}}}." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≲</mo><msup><mi>λ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\lambda^{\tau_{\beta_{t}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
</table>
<p id="A3.p28.6" class="ltx_p">We now obtain an upper bound of the term in (<a href="#A3.E44" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>). To this end, let us set</p>
<table id="A3.Ex196" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex196.m1" class="ltx_math_unparsed" alttext="g_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}):=\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i})," display="block" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝒀</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><msub><mi>ξ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">g_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}):=\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{X}_{i-\tau_{\beta_{t}}:i}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.7" class="ltx_p">where <math id="A3.p28.m2" class="ltx_math_unparsed" alttext="\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}=\left(S^{\mu}_{i-\tau_{\beta_{t}}},S^{\mu}_{i-\tau_{\beta_{t}}+1},\cdots,S^{\mu}_{i-1},\boldsymbol{X}_{i}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒀</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mo>(</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mi>μ</mi></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}=\left(S^{\mu}_{i-\tau_{\beta_{t}}},S^{\mu}_{i-\tau_{\beta_{t}}+1},\cdots,S^{\mu}_{i-1},\boldsymbol{X}_{i}\right)</annotation></semantics></math>. We further define <math id="A3.p28.m3" class="ltx_Math" alttext="\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><annotation encoding="application/x-tex">\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}</annotation></semantics></math> and <math id="A3.p28.m4" class="ltx_math_unparsed" alttext="\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}" display="inline" intent=":literal"><semantics><mrow><mi>𝒀</mi><msup><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo></msup><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}</annotation></semantics></math> as random variables drawn independently from the marginal distributions of <math id="A3.p28.m5" class="ltx_Math" alttext="\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><annotation encoding="application/x-tex">\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}}</annotation></semantics></math> and <math id="A3.p28.m6" class="ltx_math_unparsed" alttext="\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}" display="inline" intent=":literal"><semantics><mrow><mi>𝒀</mi><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i}</annotation></semantics></math> respectively. Since</p>
<table id="A3.Ex197" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex197.m1" class="ltx_Math" alttext="\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}}\to S^{\mu}_{i-2\tau_{\beta_{t}}}\to S^{\mu}_{i-\tau_{\beta_{t}}}\to S^{\mu}_{i}\to\boldsymbol{X}_{i}=(S^{\mu}_{i},S^{\mu}_{i+1},\boldsymbol{z}_{i})" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo stretchy="false">→</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mi>μ</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mi>μ</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>S</mi><mi>i</mi><mi>μ</mi></msubsup><mo stretchy="false">→</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>S</mi><mi>i</mi><mi>μ</mi></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo>,</mo><msub><mi>𝒛</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}}\to S^{\mu}_{i-2\tau_{\beta_{t}}}\to S^{\mu}_{i-\tau_{\beta_{t}}}\to S^{\mu}_{i}\to\boldsymbol{X}_{i}=(S^{\mu}_{i},S^{\mu}_{i+1},\boldsymbol{z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.8" class="ltx_p">forms a Markov chain, an application of Lemma 9 in <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite> results in</p>
<table id="A3.Ex198" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex198.m1" class="ltx_math_unparsed" alttext="\left|\mathbb{E}^{\mu}g_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\left|\mathbb{E}g_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|+\rho^{\tau_{\beta_{t}}}," display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>g</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝒀</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em" rspace="0em">≲</mo><mo fence="false" rspace="0.167em">|</mo><mi>𝔼</mi><msub><mi>g</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>,</mo><mmultiscripts><mi>𝒀</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0em">+</mo><msup><mi>ρ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}g_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\left|\mathbb{E}g_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|+\rho^{\tau_{\beta_{t}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.9" class="ltx_p">for all <math id="A3.p28.m7" class="ltx_Math" alttext="i&gt;2\tau_{\beta_{t}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">i&gt;2\tau_{\beta_{t}}</annotation></semantics></math>. Since <math id="A3.p28.m8" class="ltx_Math" alttext="\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><annotation encoding="application/x-tex">\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}</annotation></semantics></math> and <math id="A3.p28.m9" class="ltx_math_unparsed" alttext="\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}" display="inline" intent=":literal"><semantics><mrow><mi>𝒀</mi><msup><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo></msup><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}</annotation></semantics></math> are independent to each other, we get</p>
<table id="A3.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex199"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex199.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}g_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mi>g</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>,</mo><mmultiscripts><mi>𝒀</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}g_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex199.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><msup><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>⊤</mo></msup><msup><mrow><mo>(</mo><mmultiscripts><mi>𝑨</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>−</mo><mi>𝑨</mi><mo>)</mo></mrow><mo>⊤</mo></msup><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex200"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex200.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[\text{Trace}\left\{\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><mtext>Trace</mtext><mrow><mo>{</mo><msup><mrow><mo>(</mo><mmultiscripts><mi>𝑨</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>−</mo><mi>𝑨</mi><mo>)</mo></mrow><mo>⊤</mo></msup><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><msup><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>⊤</mo></msup><mo>}</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\text{Trace}\left\{\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex201"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex201.m1" class="ltx_math_unparsed" alttext="\displaystyle=\text{Trace}\left[\mathbb{E}\left\{\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mtext>Trace</mtext><mrow><mo>[</mo><mi>𝔼</mi><mrow><mo>{</mo><msup><mrow><mo>(</mo><mmultiscripts><mi>𝑨</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>−</mo><mi>𝑨</mi><mo>)</mo></mrow><mo>⊤</mo></msup><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><msup><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>⊤</mo></msup><mo>}</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\text{Trace}\left[\mathbb{E}\left\{\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex202"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex202.m1" class="ltx_math_unparsed" alttext="\displaystyle=\text{Trace}\left[\mathbb{E}^{\mu}\left\{\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\right\}\underline{\boldsymbol{D}_{i}}\mathbb{E}^{\mu}\left\{\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mtext>Trace</mtext><mrow><mo>[</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>{</mo><msup><mrow><mo>(</mo><mmultiscripts><mi>𝑨</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>−</mo><mi>𝑨</mi><mo>)</mo></mrow><mo>⊤</mo></msup><mo>}</mo></mrow><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>{</mo><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><msup><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>⊤</mo></msup><mo>}</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\text{Trace}\left[\mathbb{E}^{\mu}\left\{\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}-\boldsymbol{A}\right)^{\top}\right\}\underline{\boldsymbol{D}_{i}}\mathbb{E}^{\mu}\left\{\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.10" class="ltx_p">where the last equality comes from the independence between <math id="A3.p28.m10" class="ltx_Math" alttext="\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><annotation encoding="application/x-tex">\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}</annotation></semantics></math> and <math id="A3.p28.m11" class="ltx_math_unparsed" alttext="\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}" display="inline" intent=":literal"><semantics><mrow><mi>𝒀</mi><msup><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo></msup><msub><mrow></mrow><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i}</annotation></semantics></math>. By the Von-Neumann’s trace inequality (see Theorem 7.4.1.1 of <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib16" title="" class="ltx_ref">16</a>]</cite>) with a nuclear norm notation <math id="A3.p28.m12" class="ltx_math_unparsed" alttext="\|\cdot\|_{*}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{*}</annotation></semantics></math>, we have</p>
<table id="A3.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex203"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex203.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|\mathbb{E}g_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><mi>𝔼</mi><msub><mi>g</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>,</mo><mmultiscripts><mi>𝒀</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}g_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex203.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}\right)-\boldsymbol{A}\right\|\left\|\underline{\boldsymbol{D}_{i}}\mathbb{E}^{\mu}\left\{\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right\|_{*}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><mmultiscripts><mi>𝑨</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>−</mo><mi>𝑨</mi><mo>‖</mo></mrow><msub><mrow><mo>‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>{</mo><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><msup><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>⊤</mo></msup><mo>}</mo></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}\right)-\boldsymbol{A}\right\|\left\|\underline{\boldsymbol{D}_{i}}\mathbb{E}^{\mu}\left\{\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right\|_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex204"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex204.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}\right)-\boldsymbol{A}\right\|\left\|\underline{\boldsymbol{D}_{i}}\right\|\left\|\mathbb{E}^{\mu}\left\{\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right\|_{*}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><mmultiscripts><mi>𝑨</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>−</mo><mi>𝑨</mi><mo>‖</mo></mrow><mrow><mo>‖</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><mo>‖</mo></mrow><msub><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>{</mo><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><msup><mrow><mo>(</mo><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>⊤</mo></msup><mo>}</mo></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}\right)-\boldsymbol{A}\right\|\left\|\underline{\boldsymbol{D}_{i}}\right\|\left\|\mathbb{E}^{\mu}\left\{\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right\|_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.11" class="ltx_p">where the second inequality is due to an identity <math id="A3.p28.m13" class="ltx_Math" alttext="\|\boldsymbol{A}\boldsymbol{B}\|_{*}\leq\|\boldsymbol{A}\|\|\boldsymbol{B}\|_{*}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑩</mi></mrow><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub><mo>≤</mo><mrow><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝑩</mi><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\|\boldsymbol{A}\boldsymbol{B}\|_{*}\leq\|\boldsymbol{A}\|\|\boldsymbol{B}\|_{*}</annotation></semantics></math>. Furthermore, notice that</p>
<table id="A3.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex205"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex205.m1" class="ltx_Math" alttext="\displaystyle\left\|\mathbb{E}^{\mu}\left\{\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right\|_{*}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mrow><mo>(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>}</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathbb{E}^{\mu}\left\{\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\}\right\|_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex205.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}^{\mu}\left\{\left\|\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\|_{*}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}^{\mu}\left\{\left\|\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)\left(\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right)^{\top}\right\|_{*}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex206"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex206.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}^{\mu}\left\{\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right\|^{2}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}^{\mu}\left\{\left\|\boldsymbol{\Theta^{*}}-\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}}\right\|^{2}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex207"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex207.m1" class="ltx_Math" alttext="\displaystyle\leq 4R_{\boldsymbol{\Theta}}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4R_{\boldsymbol{\Theta}}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.12" class="ltx_p">where the first inequality is due to Jensen’s inequality. Therefore, we arrive at</p>
<table id="A3.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex208"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex208.m1" class="ltx_math_unparsed" alttext="\displaystyle\left|\mathbb{E}^{\mu}g_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}\right)-\boldsymbol{A}\right\|\lesssim\tau_{\beta_{t}}q^{i}+\lambda^{\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>g</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝚯</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><mrow></mrow></mmultiscripts><mo>,</mo><mmultiscripts><mi>𝒀</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≲</mo><mrow><mo>‖</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mrow><mo>(</mo><mmultiscripts><mi>𝑨</mi><mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow><mrow></mrow></mmultiscripts><mo>)</mo></mrow><mo>−</mo><mi>𝑨</mi><mo>‖</mo></mrow><mo>≲</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>q</mi><mi>i</mi></msup><mo>+</mo><msup><mi>λ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}g_{i}(\boldsymbol{\Theta^{\prime}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y^{\prime}}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\left\|\mathbb{E}^{\mu}\left(\boldsymbol{A^{\prime}}_{i-\tau_{\beta_{t}}:i}\right)-\boldsymbol{A}\right\|\lesssim\tau_{\beta_{t}}q^{i}+\lambda^{\tau_{\beta_{t}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.13" class="ltx_p">where the last inequality follows from Lemma <a href="#A3.Thmtheorem12" title="Lemma C.12. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.12</span></a>. This then gives us</p>
<table id="A3.E48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E48.m1" class="ltx_math_unparsed" alttext="\left|\mathbb{E}^{\mu}g_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\tau_{\beta_{t}}q^{i}+\lambda^{\tau_{\beta_{t}}}+\rho^{\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}," display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><msub><mi>g</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>,</mo><msub><mi>𝒀</mi><mrow><mrow><mi>i</mi><mo>−</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≲</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>q</mi><mi>i</mi></msup><mo>+</mo><msup><mi>λ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>+</mo><msup><mi>ρ</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>≲</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><msup><mi>q</mi><mi>i</mi></msup><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}g_{i}(\widehat{\boldsymbol{\Theta}}_{i-2\tau_{\beta_{t}}},\boldsymbol{Y}_{i-\tau_{\beta_{t}}:i})\right|\lesssim\tau_{\beta_{t}}q^{i}+\lambda^{\tau_{\beta_{t}}}+\rho^{\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
<p id="A3.p28.14" class="ltx_p">for <math id="A3.p28.m14" class="ltx_Math" alttext="q=\max\{\lambda,\rho\}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>,</mo><mi>ρ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q=\max\{\lambda,\rho\}</annotation></semantics></math>. Combining (<a href="#A3.E46" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a>), (<a href="#A3.E47" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">47</span></a>) and (<a href="#A3.E48" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a>), we get</p>
<table id="A3.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex209"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex209.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\beta_{l}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≲</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>β</mi><mi>l</mi></msub></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow><mo>≲</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow><mo>+</mo><msup><mi>q</mi><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=i-2\tau_{\beta_{t}}}^{i-1}\beta_{l}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}\lesssim\tau_{\beta_{t}}\beta_{i-2\tau_{\beta_{t}}}+\tau_{\beta_{t}}q^{i}+q^{\tau_{\beta_{t}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.15" class="ltx_p">Next we consider the case <math id="A3.p28.m15" class="ltx_Math" alttext="i\leq 2\tau_{\beta_{t}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">i\leq 2\tau_{\beta_{t}}</annotation></semantics></math>. From the triangle inequality, we have</p>
<table id="A3.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex210"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex210.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\leq\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|+\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\leq\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|+\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.16" class="ltx_p">From Lemma <a href="#A3.Thmtheorem10" title="Lemma C.10. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.10</span></a> combined with (<a href="#A3.E36" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>), we have</p>
<table id="A3.E49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E49.m1" class="ltx_Math" alttext="\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=0}^{i-1}\beta_{l}\lesssim\tau_{\beta_{t}}\beta_{0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo rspace="0.111em">≲</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover><msub><mi>β</mi><mi>l</mi></msub></mrow><mo>≲</mo><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})-\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|\lesssim\sum_{l=0}^{i-1}\beta_{l}\lesssim\tau_{\beta_{t}}\beta_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
<p id="A3.p28.17" class="ltx_p">For the second term, since <math id="A3.p28.m16" class="ltx_Math" alttext="\widehat{\boldsymbol{\Theta}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\widehat{\boldsymbol{\Theta}}_{0}</annotation></semantics></math> is deterministic,</p>
<table id="A3.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex211"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex211.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})=(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0})^{\top}\mathbb{E}^{\mu}\left(\boldsymbol{A_{i}}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑨</mi><mi>𝒊</mi></msub><mo>−</mo><mi>𝑨</mi></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>𝑫</mi><mi>i</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚯</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">∗</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})=(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0})^{\top}\mathbb{E}^{\mu}\left(\boldsymbol{A_{i}}-\boldsymbol{A}\right)^{\top}\underline{\boldsymbol{D}_{i}}(\boldsymbol{\Theta^{*}}-\widehat{\boldsymbol{\Theta}}_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.18" class="ltx_p">and therefore</p>
<table id="A3.E50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E50.m1" class="ltx_Math" alttext="\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|\leq 4R_{\boldsymbol{\Theta}}^{2}\left\|\mathbb{E}\boldsymbol{A}_{i}-\boldsymbol{A}\right\|\lesssim iq^{i}+\lambda^{i}\lesssim iq^{i}" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mn>0</mn></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>𝚯</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mi>i</mi></msub></mrow><mo>−</mo><mi>𝑨</mi></mrow><mo>‖</mo></mrow></mrow><mo>≲</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow><mo>+</mo><msup><mi>λ</mi><mi>i</mi></msup></mrow><mo>≲</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}^{\mu}\xi_{i}(\widehat{\boldsymbol{\Theta}}_{0},\boldsymbol{X}_{i})\right|\leq 4R_{\boldsymbol{\Theta}}^{2}\left\|\mathbb{E}\boldsymbol{A}_{i}-\boldsymbol{A}\right\|\lesssim iq^{i}+\lambda^{i}\lesssim iq^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A3.p28.19" class="ltx_p">where the second inequality follows from Lemma <a href="#A3.Thmtheorem12" title="Lemma C.12. ‣ Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.12</span></a> and in the last inequality we used the definition <math id="A3.p28.m17" class="ltx_Math" alttext="q:=\max\{\lambda,\rho\}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">}</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q:=\max\{\lambda,\rho\}\in(0,1)</annotation></semantics></math>. Combining (<a href="#A3.E49" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">49</span></a>) and (<a href="#A3.E50" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">50</span></a>), we get</p>
<table id="A3.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex212"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex212.m1" class="ltx_Math" alttext="\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{0}+iq^{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>𝔼</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≲</mo><mrow><mrow><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathbb{E}^{\mu}\zeta_{i}(\widehat{\boldsymbol{\Theta}}_{i},\boldsymbol{X}_{i})\right|\lesssim\tau_{\beta_{t}}\beta_{0}+iq^{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p28.20" class="ltx_p">∎</p>
</div>
<div id="A3.Thmtheorem16" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem16.2" class="ltx_text ltx_font_bold">Lemma C.16</span></span><span id="A3.Thmtheorem16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem16.p1" class="ltx_para">
<p id="A3.Thmtheorem16.p1.1" class="ltx_p"><span id="A3.Thmtheorem16.p1.1.1" class="ltx_text ltx_font_italic">For <math id="A3.Thmtheorem16.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, let <math id="A3.Thmtheorem16.p1.m2" class="ltx_Math" alttext="\beta_{t}=\frac{\beta_{0}}{(t+1)^{s}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>=</mo><mfrac><msub><mi>β</mi><mn>0</mn></msub><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mrow><annotation encoding="application/x-tex">\beta_{t}=\frac{\beta_{0}}{(t+1)^{s}}</annotation></semantics></math> and <math id="A3.Thmtheorem16.p1.m3" class="ltx_Math" alttext="s\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s\in(0,1)</annotation></semantics></math>. With <math id="A3.Thmtheorem16.p1.m4" class="ltx_Math" alttext="\gamma&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma&gt;0</annotation></semantics></math>,</span></p>
<table id="A3.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex213"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex213.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=0}^{t}\left(e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\right)\beta^{2}_{i}\leq 2\left(K_{b}e^{-\frac{\gamma}{2}\sum_{k=0}^{t}\beta_{k}}+\beta_{t}\right)\frac{e^{\frac{\gamma\beta_{0}}{2}}}{\gamma}," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>(</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>)</mo></mrow><msubsup><mi>β</mi><mi>i</mi><mn>2</mn></msubsup><mo>≤</mo><mn>2</mn><mrow><mo>(</mo><msub><mi>K</mi><mi>b</mi></msub><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>+</mo><msub><mi>β</mi><mi>t</mi></msub><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></msup><mi>γ</mi></mfrac></mstyle><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=0}^{t}\left(e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\right)\beta^{2}_{i}\leq 2\left(K_{b}e^{-\frac{\gamma}{2}\sum_{k=0}^{t}\beta_{k}}+\beta_{t}\right)\frac{e^{\frac{\gamma\beta_{0}}{2}}}{\gamma},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem16.p1.2" class="ltx_p"><span id="A3.Thmtheorem16.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A3.Thmtheorem16.p1.m5" class="ltx_Math" alttext="K_{b}=\beta_{0}e^{\frac{\gamma}{2}\sum_{k=0}^{i_{0}}\beta_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>b</mi></msub><mo>=</mo><mrow><msub><mi>β</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup></mstyle><msub><mi>β</mi><mi>k</mi></msub></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">K_{b}=\beta_{0}e^{\frac{\gamma}{2}\sum_{k=0}^{i_{0}}\beta_{k}}</annotation></semantics></math> for some <math id="A3.Thmtheorem16.p1.m6" class="ltx_Math" alttext="i_{0}\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">i_{0}\in\mathbb{N}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p29" class="ltx_para ltx_noindent">
<p id="A3.p29.1" class="ltx_p"><span id="A3.p29.1.1" class="ltx_text ltx_font_bold">Proof.</span> Let <math id="A3.p29.m1" class="ltx_Math" alttext="T_{t}=\sum_{i=0}^{t-1}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>β</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">T_{t}=\sum_{i=0}^{t-1}\beta_{i}</annotation></semantics></math> and use the convention <math id="A3.p29.m2" class="ltx_Math" alttext="\sum_{k=t+1}^{t}\beta_{k}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></msubsup><msub><mi>β</mi><mi>k</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{k=t+1}^{t}\beta_{k}=0</annotation></semantics></math> and <math id="A3.p29.m3" class="ltx_Math" alttext="\sum_{k=t+1}^{t}\beta^{2}_{k}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></msubsup><msubsup><mi>β</mi><mi>k</mi><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{k=t+1}^{t}\beta^{2}_{k}=0</annotation></semantics></math>. Notice that</p>
<table id="A3.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex214"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex214.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=0}^{t}\left(e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>(</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>)</mo></mrow><msub><mi>β</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=0}^{t}\left(e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)\beta_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex214.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\left(\sup_{i\geq 0}e^{\frac{\gamma}{2}\beta_{i}}\right)\left\{\sum_{i=0}^{t}\left(e^{-\frac{\gamma}{2}\sum_{k=i}^{t}\beta_{k}}\right)\beta_{i}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><msup><mi>e</mi><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>i</mi></msub></mrow></msup><mo>)</mo></mrow><mrow><mo>{</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>(</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>)</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\sup_{i\geq 0}e^{\frac{\gamma}{2}\beta_{i}}\right)\left\{\sum_{i=0}^{t}\left(e^{-\frac{\gamma}{2}\sum_{k=i}^{t}\beta_{k}}\right)\beta_{i}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex215"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex215.m1" class="ltx_Math" alttext="\displaystyle=\left(\sup_{i\geq 0}e^{\frac{\gamma}{2}\beta_{i}}\right)\left\{\sum_{i=0}^{t}\left(e^{-\frac{\gamma}{2}(T_{t+1}-T_{i})}\right)\beta_{i}\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><msup><mi>e</mi><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>i</mi></msub></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mo>(</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>T</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>i</mi></msub></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\sup_{i\geq 0}e^{\frac{\gamma}{2}\beta_{i}}\right)\left\{\sum_{i=0}^{t}\left(e^{-\frac{\gamma}{2}(T_{t+1}-T_{i})}\right)\beta_{i}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex216"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex216.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\sup_{i\geq 0}e^{\frac{\gamma}{2}\beta_{i}}\right)\int_{0}^{T_{t+1}}e^{-\frac{\gamma}{2}(T_{t+1}-s)}ds" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><msup><mi>e</mi><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>i</mi></msub></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\sup_{i\geq 0}e^{\frac{\gamma}{2}\beta_{i}}\right)\int_{0}^{T_{t+1}}e^{-\frac{\gamma}{2}(T_{t+1}-s)}ds</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E51.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\sup_{i\geq 0}e^{\frac{\gamma}{2}\beta_{i}}\right)\frac{2}{\gamma}\leq\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><msup><mi>e</mi><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>i</mi></msub></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>γ</mi></mfrac></mstyle></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></msup></mrow><mi>γ</mi></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\sup_{i\geq 0}e^{\frac{\gamma}{2}\beta_{i}}\right)\frac{2}{\gamma}\leq\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="A3.p29.2" class="ltx_p">where we have used the definition of the left-Riemann sum in the first inequality. The last inequality is due to the fact that <math id="A3.p29.m4" class="ltx_Math" alttext="\{\beta_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>β</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\beta_{t}\}</annotation></semantics></math> is a non-increasing sequence. Now consider</p>
<table id="A3.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex217"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex217.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=0}^{t}\left(e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\right)\beta^{2}_{i}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>(</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>)</mo></mrow><msubsup><mi>β</mi><mi>i</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=0}^{t}\left(e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\right)\beta^{2}_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex217.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\sup_{0\leq i\leq t}\left(\beta_{i}e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)\left\{\sum_{i=0}^{t}\left(e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)\beta_{i}\right\}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">≤</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>t</mi></mrow></munder><mrow><mo>(</mo><msub><mi>β</mi><mi>i</mi></msub><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>)</mo></mrow><mrow><mo>{</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mo>(</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>)</mo></mrow><msub><mi>β</mi><mi>i</mi></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{0\leq i\leq t}\left(\beta_{i}e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)\left\{\sum_{i=0}^{t}\left(e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)\beta_{i}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E52.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\sup_{0\leq i\leq t}\left(\beta_{i}e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">≤</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>t</mi></mrow></munder><mrow><mo>(</mo><msub><mi>β</mi><mi>i</mi></msub><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></msup></mrow><mi>γ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{0\leq i\leq t}\left(\beta_{i}e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
<p id="A3.p29.3" class="ltx_p">where the last inequality follows from (<a href="#A3.E51" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">51</span></a>). Note that <math id="A3.p29.m5" class="ltx_math_unparsed" alttext="\beta_{i}e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><msub><mrow></mrow><mi>i</mi></msub><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\beta_{i}e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}</annotation></semantics></math> is eventually increasing, i.e., after some time <math id="A3.p29.m6" class="ltx_Math" alttext="i_{0}\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">i_{0}\in\mathbb{N}</annotation></semantics></math>, for all <math id="A3.p29.m7" class="ltx_Math" alttext="t\geq i_{0}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>i</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">t\geq i_{0}</annotation></semantics></math>, we have</p>
<table id="A3.Ex218" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex218.m1" class="ltx_math_unparsed" alttext="\sup_{i_{0}\leq i\leq t}\left\{\beta_{i}\exp\left(-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}\right)\right\}\leq\beta_{t}," display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><msub><mi>i</mi><mn>0</mn></msub><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>t</mi></mrow></munder><mrow><mo lspace="0em">{</mo><msub><mi>β</mi><mi>i</mi></msub><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><msub><mi>β</mi><mi>k</mi></msub><mo>)</mo></mrow><mo>}</mo></mrow><mo>≤</mo><msub><mi>β</mi><mi>t</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\sup_{i_{0}\leq i\leq t}\left\{\beta_{i}\exp\left(-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}\right)\right\}\leq\beta_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p29.4" class="ltx_p">where we used the convention <math id="A3.p29.m8" class="ltx_Math" alttext="\sum_{k=t+1}^{t}\beta_{k}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></msubsup><msub><mi>β</mi><mi>k</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{k=t+1}^{t}\beta_{k}=0</annotation></semantics></math>. Therefore, we have</p>
<table id="A3.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex219"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="A3.Ex219.1.1" class="ltx_text ltx_markedasmath">(<a href="#A3.E52" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">52</span></a>)</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex219.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\{\sup_{0\leq i\leq i_{0}}\left(\beta_{i}e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)+\beta_{t}\right\}\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo>{</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><msub><mi>i</mi><mn>0</mn></msub></mrow></munder><mrow><mo>(</mo><msub><mi>β</mi><mi>i</mi></msub><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>)</mo></mrow><mo>+</mo><msub><mi>β</mi><mi>t</mi></msub><mo>}</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></msup></mrow><mi>γ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\{\sup_{0\leq i\leq i_{0}}\left(\beta_{i}e^{-\frac{\gamma}{2}\sum_{k=i+1}^{t}\beta_{k}}\right)+\beta_{t}\right\}\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex220"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex220.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\{e^{-\frac{\gamma}{2}\sum_{k=0}^{t}\beta_{k}}\sup_{0\leq i\leq i_{0}}\left(\beta_{i}e^{\frac{\gamma}{2}\sum_{k=0}^{i}\beta_{k}}\right)+\beta_{t}\right\}\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo>{</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">sup</mo><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><msub><mi>i</mi><mn>0</mn></msub></mrow></munder><mrow><mo>(</mo><msub><mi>β</mi><mi>i</mi></msub><msup><mi>e</mi><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>i</mi></msubsup></mstyle><msub><mi>β</mi><mi>k</mi></msub></mrow></mrow></msup><mo>)</mo></mrow><mo>+</mo><msub><mi>β</mi><mi>t</mi></msub><mo>}</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></msup></mrow><mi>γ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\{e^{-\frac{\gamma}{2}\sum_{k=0}^{t}\beta_{k}}\sup_{0\leq i\leq i_{0}}\left(\beta_{i}e^{\frac{\gamma}{2}\sum_{k=0}^{i}\beta_{k}}\right)+\beta_{t}\right\}\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex221"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex221.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left(K_{b}e^{-\frac{\gamma}{2}\sum_{k=0}^{t}\beta_{k}}+\beta_{t}\right)\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma}," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo>(</mo><msub><mi>K</mi><mi>b</mi></msub><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mi>γ</mi><mn>2</mn></mfrac><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mo>+</mo><msub><mi>β</mi><mi>t</mi></msub><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></msup></mrow><mi>γ</mi></mfrac></mstyle><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(K_{b}e^{-\frac{\gamma}{2}\sum_{k=0}^{t}\beta_{k}}+\beta_{t}\right)\frac{2e^{\frac{\gamma\beta_{0}}{2}}}{\gamma},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p29.5" class="ltx_p">where <math id="A3.p29.m9" class="ltx_Math" alttext="K_{b}=\beta_{0}e^{\frac{\gamma}{2}\sum_{k=0}^{i_{0}}\beta_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>b</mi></msub><mo>=</mo><mrow><msub><mi>β</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>i</mi><mn>0</mn></msub></msubsup></mstyle><msub><mi>β</mi><mi>k</mi></msub></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">K_{b}=\beta_{0}e^{\frac{\gamma}{2}\sum_{k=0}^{i_{0}}\beta_{k}}</annotation></semantics></math>.
 ∎</p>
</div>
<div id="A3.Thmtheorem17" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem17.2" class="ltx_text ltx_font_bold">Lemma C.17</span></span><span id="A3.Thmtheorem17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem17.p1" class="ltx_para">
<p id="A3.Thmtheorem17.p1.1" class="ltx_p"><span id="A3.Thmtheorem17.p1.1.1" class="ltx_text ltx_font_italic">For <math id="A3.Thmtheorem17.p1.m1" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, let <math id="A3.Thmtheorem17.p1.m2" class="ltx_Math" alttext="\beta_{t}=\frac{\beta_{0}}{(t+1)^{s}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>=</mo><mfrac><msub><mi>β</mi><mn>0</mn></msub><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup></mfrac></mrow><annotation encoding="application/x-tex">\beta_{t}=\frac{\beta_{0}}{(t+1)^{s}}</annotation></semantics></math> and <math id="A3.Thmtheorem17.p1.m3" class="ltx_Math" alttext="s\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s\in(0,1)</annotation></semantics></math>. With <math id="A3.Thmtheorem17.p1.m4" class="ltx_Math" alttext="\gamma&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma&gt;0</annotation></semantics></math> and <math id="A3.Thmtheorem17.p1.m5" class="ltx_Math" alttext="\tau\in\{0,\cdots,t\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\cdots,t\}</annotation></semantics></math>,</span></p>
<ol id="A3.I3" class="ltx_enumerate">
<li id="A3.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A3.I3.i1.p1" class="ltx_para">
<p id="A3.I3.i1.p1.1" class="ltx_p"><math id="A3.I3.i1.p1.m1" class="ltx_math_unparsed" alttext="\sum_{i=0}^{\tau}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i}\leq\frac{e^{\gamma\beta_{0}}}{\gamma}e^{-\frac{\gamma\beta_{0}}{1-s}\left\{(1+t)^{1-s}-\left(1+\tau\right)^{1-s}\right\}}" display="inline" intent=":literal"><semantics><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>τ</mi></msup><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mi>β</mi><msub><mrow></mrow><mi>i</mi></msub><mo>≤</mo><mfrac><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mi>γ</mi></mfrac><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mrow><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>τ</mi></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo>}</mo></mrow></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\sum_{i=0}^{\tau}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i}\leq\frac{e^{\gamma\beta_{0}}}{\gamma}e^{-\frac{\gamma\beta_{0}}{1-s}\left\{(1+t)^{1-s}-\left(1+\tau\right)^{1-s}\right\}}</annotation></semantics></math><span id="A3.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A3.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A3.I3.i2.p1" class="ltx_para">
<p id="A3.I3.i2.p1.1" class="ltx_p"><math id="A3.I3.i2.p1.m1" class="ltx_math_unparsed" alttext="\sum_{i=2\tau_{\beta_{t}}+1}^{t}\left(e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\beta_{i}\right)\leq\left[e^{\frac{-\gamma\beta_{0}}{2(1-s)}\left\{(t+1)^{1-s}-1\right\}}D_{\beta}\mathbb{I}_{\left(2\tau_{\beta_{t}}+1&lt;i_{\beta}\right)}+\beta_{t-2\tau_{\beta_{t}}}\right]\frac{2e^{\gamma\beta_{0}/2}}{\gamma}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></msubsup><mrow><mo lspace="0em">(</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><msub><mi>β</mi><mi>i</mi></msub><mo>)</mo></mrow><mo>≤</mo><mrow><mo>[</mo><msup><mi>e</mi><mrow><mfrac><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo>}</mo></mrow></mrow></msup><msub><mi>D</mi><mi>β</mi></msub><msub><mi>𝕀</mi><mrow><mo>(</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>&lt;</mo><msub><mi>i</mi><mi>β</mi></msub></mrow><mo>)</mo></mrow></msub><mo>+</mo><msub><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>]</mo></mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mo>/</mo><mn>2</mn></mrow></msup></mrow><mi>γ</mi></mfrac></mrow><annotation encoding="application/x-tex">\sum_{i=2\tau_{\beta_{t}}+1}^{t}\left(e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\beta_{i}\right)\leq\left[e^{\frac{-\gamma\beta_{0}}{2(1-s)}\left\{(t+1)^{1-s}-1\right\}}D_{\beta}\mathbb{I}_{\left(2\tau_{\beta_{t}}+1&lt;i_{\beta}\right)}+\beta_{t-2\tau_{\beta_{t}}}\right]\frac{2e^{\gamma\beta_{0}/2}}{\gamma}</annotation></semantics></math></p>
</div></li>
</ol>
<p id="A3.Thmtheorem17.p1.2" class="ltx_p"><span id="A3.Thmtheorem17.p1.2.1" class="ltx_text ltx_font_italic">where
<math id="A3.Thmtheorem17.p1.m6" class="ltx_Math" alttext="D_{\beta}=\exp\{\left(\gamma/2\right)\sum_{k=0}^{i_{\beta}}\beta_{k}\}\beta_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>β</mi></msub><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>(</mo><mrow><mi>γ</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>i</mi><mi>β</mi></msub></msubsup><msub><mi>β</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{\beta}=\exp\{\left(\gamma/2\right)\sum_{k=0}^{i_{\beta}}\beta_{k}\}\beta_{0}</annotation></semantics></math> for some <math id="A3.Thmtheorem17.p1.m7" class="ltx_Math" alttext="i_{f_{\beta}}\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><msub><mi>f</mi><mi>β</mi></msub></msub><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">i_{f_{\beta}}\in\mathbb{N}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.p30" class="ltx_para ltx_noindent">
<p id="A3.p30.1" class="ltx_p"><span id="A3.p30.1.1" class="ltx_text ltx_font_bold">Proof.</span> Let <math id="A3.p30.m1" class="ltx_Math" alttext="T_{t}=\sum_{i=0}^{t-1}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi>β</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">T_{t}=\sum_{i=0}^{t-1}\beta_{i}</annotation></semantics></math> and use the convention <math id="A3.p30.m2" class="ltx_Math" alttext="\sum_{k=t+1}^{t}\beta_{k}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></msubsup><msub><mi>β</mi><mi>k</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{k=t+1}^{t}\beta_{k}=0</annotation></semantics></math>. For the first statement,</p>
<table id="A3.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex222"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex222.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=0}^{\tau}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>τ</mi></msup><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mi>β</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=0}^{\tau}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex222.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\max_{i\geq 0}\left(e^{\gamma\beta_{i}}\right)\sum_{i=0}^{\tau}e^{-\gamma\sum_{k=i}^{t}\beta_{k}}\beta_{i}=e^{\gamma\beta_{0}}\sum_{i=0}^{\tau}e^{-\gamma\left(T_{t+1}-T_{i}\right)}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><munder><mi>max</mi><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><mo>(</mo><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>i</mi></msub></mrow></msup><mo>)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>τ</mi></munderover></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mi>i</mi></msub><mo>=</mo><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>τ</mi></munderover></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>T</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></msup><msub><mi>β</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{i\geq 0}\left(e^{\gamma\beta_{i}}\right)\sum_{i=0}^{\tau}e^{-\gamma\sum_{k=i}^{t}\beta_{k}}\beta_{i}=e^{\gamma\beta_{0}}\sum_{i=0}^{\tau}e^{-\gamma\left(T_{t+1}-T_{i}\right)}\beta_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex223"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex223.m1" class="ltx_Math" alttext="\displaystyle\leq e^{\gamma\beta_{0}}\int_{0}^{T_{\tau+1}}e^{-\gamma\left(T_{t+1}-s\right)}ds\leq\frac{e^{\gamma\beta_{0}}}{\gamma}e^{-\gamma\left(T_{t+1}-T_{\tau+1}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><msub><mi>T</mi><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mi>s</mi></mrow><mo>)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>T</mi><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{\gamma\beta_{0}}\int_{0}^{T_{\tau+1}}e^{-\gamma\left(T_{t+1}-s\right)}ds\leq\frac{e^{\gamma\beta_{0}}}{\gamma}e^{-\gamma\left(T_{t+1}-T_{\tau+1}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex224"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex224.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{e^{\gamma\beta_{0}}}{\gamma}e^{-\gamma\beta_{0}\sum_{k=\tau+1}^{t}1/(1+k)^{s}}\leq\frac{e^{\gamma\beta_{0}}}{\gamma}e^{-\frac{\gamma\beta_{0}}{1-s}\left\{(1+t)^{1-s}-\left(1+\tau\right)^{1-s}\right\}}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mi>γ</mi></mfrac></mstyle><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mi>β</mi><msub><mrow></mrow><mn>0</mn></msub><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mn>1</mn><mo>/</mo><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>k</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mi>s</mi></msup></mrow></msup><mo>≤</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mi>γ</mi></mfrac></mstyle><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mrow><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>τ</mi></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup></mrow><mo>}</mo></mrow></mrow></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{e^{\gamma\beta_{0}}}{\gamma}e^{-\gamma\beta_{0}\sum_{k=\tau+1}^{t}1/(1+k)^{s}}\leq\frac{e^{\gamma\beta_{0}}}{\gamma}e^{-\frac{\gamma\beta_{0}}{1-s}\left\{(1+t)^{1-s}-\left(1+\tau\right)^{1-s}\right\}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p30.2" class="ltx_p">For the second statement, first notice that</p>
<table id="A3.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex225"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex225.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mi>β</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex225.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\max_{i\geq 0}\left(e^{\gamma\beta_{i}}\right)\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\sum_{k=i}^{t}\beta_{k}}\beta_{i}=e^{\gamma\beta_{0}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\left(T_{t+1}-T_{i}\right)}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><munder><mi>max</mi><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><mo>(</mo><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>i</mi></msub></mrow></msup><mo>)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mi>i</mi></msub><mo>=</mo><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>T</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></msup><msub><mi>β</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{i\geq 0}\left(e^{\gamma\beta_{i}}\right)\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\sum_{k=i}^{t}\beta_{k}}\beta_{i}=e^{\gamma\beta_{0}}\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\left(T_{t+1}-T_{i}\right)}\beta_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E53.m1" class="ltx_Math" alttext="\displaystyle\leq e^{\gamma\beta_{0}}\int_{T_{2\tau_{\beta_{t}}+1}}^{T_{t+1}}e^{-\gamma\left(T_{t+1}-s\right)}ds=\frac{e^{\gamma\beta_{0}}}{\gamma}\left\{1-e^{-\gamma\left(T_{t+1}-T_{2\tau_{\beta_{t}}+1}\right)}\right\}\leq\frac{e^{\gamma\beta_{0}}}{\gamma}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>T</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></msub><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></msubsup></mstyle><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mi>s</mi></mrow><mo>)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>T</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>T</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow></msup></mrow><mo>}</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></msup><mi>γ</mi></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{\gamma\beta_{0}}\int_{T_{2\tau_{\beta_{t}}+1}}^{T_{t+1}}e^{-\gamma\left(T_{t+1}-s\right)}ds=\frac{e^{\gamma\beta_{0}}}{\gamma}\left\{1-e^{-\gamma\left(T_{t+1}-T_{2\tau_{\beta_{t}}+1}\right)}\right\}\leq\frac{e^{\gamma\beta_{0}}}{\gamma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A3.p30.3" class="ltx_p">Then, we have</p>
<table id="A3.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex226"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex226.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mi>β</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mi>β</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\beta_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex226.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\max_{i\in\left[2\tau_{\beta_{t}}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><munder><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>t</mi></mrow><mo>]</mo></mrow></mrow></munder><mrow><mo>{</mo><msup><mi>e</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>}</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>e</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{i\in\left[2\tau_{\beta_{t}}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E54.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\max_{i\in\left[2\tau_{\beta_{t}}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}\frac{2e^{\gamma\beta_{0}/2}}{\gamma}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><munder><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>t</mi></mrow><mo>]</mo></mrow></mrow></munder><mrow><mo>{</mo><msup><mi>e</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>}</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mo>/</mo><mn>2</mn></mrow></msup></mrow><mi>γ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{i\in\left[2\tau_{\beta_{t}}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}\frac{2e^{\gamma\beta_{0}/2}}{\gamma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="A3.p30.4" class="ltx_p">where the second inequality follows from (<a href="#A3.E53" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>). To bound the first term in (<a href="#A3.E54" title="In Appendix C Supporting lemmas ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">54</span></a>), note that the sequence <math id="A3.p30.m3" class="ltx_math_unparsed" alttext="\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}_{i\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msup><mi>e</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}_{i\in\mathbb{N}}</annotation></semantics></math> is eventually increasing. In other words, there exists <math id="A3.p30.m4" class="ltx_Math" alttext="i_{\beta}\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>i</mi><mi>β</mi></msub><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">i_{\beta}\in\mathbb{N}</annotation></semantics></math> such that,</p>
<table id="A3.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex227"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex227.m1" class="ltx_math_unparsed" alttext="\displaystyle\max_{i\in\left[2\tau_{\beta_{t}}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>t</mi></mrow><mo>]</mo></mrow></mrow></munder><mrow><mo>{</mo><msup><mi>e</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\max_{i\in\left[2\tau_{\beta_{t}}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex227.m2" class="ltx_math_unparsed" alttext="\displaystyle=\beta_{t-2\tau_{\beta_{t}}}\quad\text{if}\quad 2\tau_{\beta_{t}}+1\geq i_{\beta}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>β</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mtext>if</mtext><mn>2</mn><mi>τ</mi><msub><mrow></mrow><msub><mi>β</mi><mi>t</mi></msub></msub><mo>+</mo><mn>1</mn><mo>≥</mo><mi>i</mi><msub><mrow></mrow><mi>β</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\beta_{t-2\tau_{\beta_{t}}}\quad\text{if}\quad 2\tau_{\beta_{t}}+1\geq i_{\beta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p30.5" class="ltx_p">If <math id="A3.p30.m5" class="ltx_Math" alttext="2\tau_{\beta_{t}}+1&lt;i_{\beta}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>&lt;</mo><msub><mi>i</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">2\tau_{\beta_{t}}+1&lt;i_{\beta}</annotation></semantics></math>, then</p>
<table id="A3.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex228"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex228.m1" class="ltx_math_unparsed" alttext="\displaystyle\max_{i\in\left[2\tau_{\beta_{t}}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}" display="inline" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>t</mi></mrow><mo>]</mo></mrow></mrow></munder><mrow><mo>{</mo><msup><mi>e</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\max_{i\in\left[2\tau_{\beta_{t}}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex229"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex229.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\max_{i\in\left[2\tau_{\beta}+1,i_{\beta}\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}+\max_{i\in\left[i_{\beta}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><munder><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>β</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msub><mi>i</mi><mi>β</mi></msub></mrow><mo>]</mo></mrow></mrow></munder><mrow><mo>{</mo><msup><mi>e</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>}</mo></mrow><mo>+</mo><munder><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>i</mi><mi>β</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>t</mi></mrow><mo>]</mo></mrow></mrow></munder><mrow><mo>{</mo><msup><mi>e</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{i\in\left[2\tau_{\beta}+1,i_{\beta}\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}+\max_{i\in\left[i_{\beta}+1,t\right]}\left\{e^{\left(-\gamma/2\right)\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex230"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex230.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq e^{\left(-\gamma/2\right)\sum_{k=0}^{t}\beta_{k}}\max_{i\in\left[2\tau_{\beta_{t}}+1,i_{\beta}\right]}\left\{e^{\left(\gamma/2\right)\sum_{k=0}^{i}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}+\beta_{t-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><munder><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo>[</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msub><mi>i</mi><mi>β</mi></msub></mrow><mo>]</mo></mrow></mrow></munder><mrow><mo>{</mo><msup><mi>e</mi><mrow><mrow><mo>(</mo><mrow><mi>γ</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>i</mi></msubsup></mstyle><msub><mi>β</mi><mi>k</mi></msub></mrow></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>}</mo></mrow><mo>+</mo><msub><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{\left(-\gamma/2\right)\sum_{k=0}^{t}\beta_{k}}\max_{i\in\left[2\tau_{\beta_{t}}+1,i_{\beta}\right]}\left\{e^{\left(\gamma/2\right)\sum_{k=0}^{i}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\right\}+\beta_{t-2\tau_{\beta_{t}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex231"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex231.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq e^{-\left(\gamma/2\right)\sum_{k=0}^{t}\beta_{k}}e^{\left(\gamma/2\right)\sum_{k=0}^{i_{\beta}}\beta_{k}}\beta_{0}+\beta_{t-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mo>(</mo><mi>γ</mi><mo>/</mo><mn>2</mn><mo rspace="0.167em">)</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><mi>e</mi><msup><mrow></mrow><mrow><mrow><mo>(</mo><mrow><mi>γ</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>i</mi><mi>β</mi></msub></msubsup></mstyle><msub><mi>β</mi><mi>k</mi></msub></mrow></mrow></msup><mi>β</mi><msub><mrow></mrow><mn>0</mn></msub><mo>+</mo><mi>β</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{-\left(\gamma/2\right)\sum_{k=0}^{t}\beta_{k}}e^{\left(\gamma/2\right)\sum_{k=0}^{i_{\beta}}\beta_{k}}\beta_{0}+\beta_{t-2\tau_{\beta_{t}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex232"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex232.m1" class="ltx_Math" alttext="\displaystyle\leq e^{\frac{-\gamma\beta_{0}}{2(1-s)}\left\{(t+1)^{1-s}-1\right\}}D_{\beta}+\beta_{t-2\tau_{\beta_{t}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mi>e</mi><mrow><mfrac><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo>}</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>β</mi></msub></mrow><mo>+</mo><msub><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{\frac{-\gamma\beta_{0}}{2(1-s)}\left\{(t+1)^{1-s}-1\right\}}D_{\beta}+\beta_{t-2\tau_{\beta_{t}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p30.6" class="ltx_p">where <math id="A3.p30.m6" class="ltx_Math" alttext="D_{\beta}=e^{\left(\gamma/2\right)\sum_{k=0}^{i_{\beta}}\beta_{k}}\beta_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>β</mi></msub><mo>=</mo><mrow><msup><mi>e</mi><mrow><mrow><mo>(</mo><mrow><mi>γ</mi><mo>/</mo><mn>2</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>i</mi><mi>β</mi></msub></msubsup></mstyle><msub><mi>β</mi><mi>k</mi></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">D_{\beta}=e^{\left(\gamma/2\right)\sum_{k=0}^{i_{\beta}}\beta_{k}}\beta_{0}</annotation></semantics></math>. Combining everything, we get</p>
<table id="A3.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex233"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex233.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\beta_{i}\leq\left[e^{\frac{-\gamma\beta_{0}}{2(1-s)}\left\{(t+1)^{1-s}-1\right\}}D_{\beta}\mathbb{I}_{\left(2\tau_{\beta_{t}}+1&lt;i_{\beta}\right)}+\beta_{t-2\tau_{\beta_{t}}}\right]\frac{2e^{\gamma\beta_{0}/2}}{\gamma}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mi>γ</mi><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>β</mi><msub><mrow></mrow><mi>k</mi></msub></mrow></msup><msub><mi>β</mi><mrow><mi>i</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><msub><mi>β</mi><mi>i</mi></msub><mo>≤</mo><mrow><mo>[</mo><msup><mi>e</mi><mrow><mfrac><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo>}</mo></mrow></mrow></msup><msub><mi>D</mi><mi>β</mi></msub><msub><mi>𝕀</mi><mrow><mo>(</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>&lt;</mo><msub><mi>i</mi><mi>β</mi></msub></mrow><mo>)</mo></mrow></msub><mo>+</mo><msub><mi>β</mi><mrow><mi>t</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><msub><mi>β</mi><mi>t</mi></msub></msub></mrow></mrow></msub><mo>]</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>0</mn></msub></mrow><mo>/</mo><mn>2</mn></mrow></msup></mrow><mi>γ</mi></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=2\tau_{\beta_{t}}+1}^{t}e^{-\gamma\sum_{k=i+1}^{t}\beta_{k}}\beta_{i-2\tau_{\beta_{t}}}\beta_{i}\leq\left[e^{\frac{-\gamma\beta_{0}}{2(1-s)}\left\{(t+1)^{1-s}-1\right\}}D_{\beta}\mathbb{I}_{\left(2\tau_{\beta_{t}}+1&lt;i_{\beta}\right)}+\beta_{t-2\tau_{\beta_{t}}}\right]\frac{2e^{\gamma\beta_{0}/2}}{\gamma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p30.7" class="ltx_p">∎</p>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Additional Experimental Details</h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">We provide detailed explanations of the experimental setups for both evaluation and control experiments in this supplementary results section. For each run, we set the exponential weight parameter <math id="A4.p1.m1" class="ltx_Math" alttext="\lambda=0.25" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0.25</mn></mrow><annotation encoding="application/x-tex">\lambda=0.25</annotation></semantics></math> and the step-size ratio parameter <math id="A4.p1.m2" class="ltx_Math" alttext="c_{\alpha}=1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">c_{\alpha}=1.0</annotation></semantics></math>. Under this hyperparameter configuration, we evaluate four methods: (i) average-reward TD(<math id="A4.p1.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>), (ii) average-reward implicit TD(<math id="A4.p1.m4" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) without projection, and (iii–iv) average-reward implicit TD(<math id="A4.p1.m5" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) with projection, using parameter radius <math id="A4.p1.m6" class="ltx_Math" alttext="R_{\boldsymbol{\Theta}}\in\{1000,\ 5000\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>𝚯</mi></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1000</mn><mo>,</mo><mn> 5000</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">R_{\boldsymbol{\Theta}}\in\{1000,\ 5000\}</annotation></semantics></math>. For the projection of the average-reward estimate, we fix the radius <math id="A4.p1.m7" class="ltx_Math" alttext="R_{\omega}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>ω</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R_{\omega}=1</annotation></semantics></math>, which safely bounds the true average-reward since <math id="A4.p1.m8" class="ltx_Math" alttext="\omega^{\mu}\in[-1,\ 1]" display="inline" intent=":literal"><semantics><mrow><msup><mi>ω</mi><mi>μ</mi></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn> 1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\omega^{\mu}\in[-1,\ 1]</annotation></semantics></math> by construction in all our settings.</p>
</div>
<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Evaluation Experiments</h3>

<section id="A4.SS1.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Computing true parameters.</h5>

<div id="A4.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A4.SS1.SSS0.Px1.p1.1" class="ltx_p">We compute the oracle quantities used in the loss <math id="A4.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="(\widehat{\omega}_{t}-\omega^{\mu})^{2}+\|\Pi_{\mathbb{O}}(\widehat{\boldsymbol{\theta}}_{t}-\boldsymbol{\theta}^{*})\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>ω</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msup><mi>ω</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>𝕆</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>𝜽</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msup><mi>𝜽</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">(\widehat{\omega}_{t}-\omega^{\mu})^{2}+\|\Pi_{\mathbb{O}}(\widehat{\boldsymbol{\theta}}_{t}-\boldsymbol{\theta}^{*})\|^{2}</annotation></semantics></math> as follows. Given a transition matrix <math id="A4.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\boldsymbol{P}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{P}^{\mu}</annotation></semantics></math>, reward vector <math id="A4.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\boldsymbol{r}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝒓</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{r}^{\mu}</annotation></semantics></math>, and feature matrix <math id="A4.SS1.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\boldsymbol{\Phi}" display="inline" intent=":literal"><semantics><mi>𝚽</mi><annotation encoding="application/x-tex">\boldsymbol{\Phi}</annotation></semantics></math>, we first obtain the stationary distribution <math id="A4.SS1.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\boldsymbol{\pi}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝝅</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{\pi}^{\mu}</annotation></semantics></math> satisfying <math id="A4.SS1.SSS0.Px1.p1.m6" class="ltx_Math" alttext="{\boldsymbol{\pi}^{\mu}}^{\top}\boldsymbol{P}^{\mu}={\boldsymbol{\pi}^{\mu}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mmultiscripts><mi>𝝅</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑷</mi><mi>μ</mi></msup></mrow><mo>=</mo><mmultiscripts><mi>𝝅</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow><annotation encoding="application/x-tex">{\boldsymbol{\pi}^{\mu}}^{\top}\boldsymbol{P}^{\mu}={\boldsymbol{\pi}^{\mu}}^{\top}</annotation></semantics></math> and <math id="A4.SS1.SSS0.Px1.p1.m7" class="ltx_Math" alttext="{\boldsymbol{\pi}^{\mu}}^{\top}\boldsymbol{e}=1" display="inline" intent=":literal"><semantics><mrow><mrow><mmultiscripts><mi>𝝅</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mi>𝒆</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\boldsymbol{\pi}^{\mu}}^{\top}\boldsymbol{e}=1</annotation></semantics></math>. The average reward is then <math id="A4.SS1.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\omega^{\mu}={\boldsymbol{\pi}^{\mu}}^{\top}{\boldsymbol{r}}^{\mu}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ω</mi><mi>μ</mi></msup><mo>=</mo><mrow><mmultiscripts><mi>𝝅</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒓</mi><mi>μ</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\omega^{\mu}={\boldsymbol{\pi}^{\mu}}^{\top}{\boldsymbol{r}}^{\mu}</annotation></semantics></math>. In addition, to compute the optimal weight vector <math id="A4.SS1.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\boldsymbol{\theta}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝜽</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\boldsymbol{\theta}^{*}</annotation></semantics></math>, we first solve for the basic differential value <math id="A4.SS1.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\boldsymbol{v}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝒗</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{v}^{\mu}</annotation></semantics></math>, which is the unique solution to</p>
<table id="A4.Ex234" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex234.m1" class="ltx_Math" alttext="(\boldsymbol{I}-\boldsymbol{P}^{\mu})\boldsymbol{v}^{\mu}=\boldsymbol{r}^{\mu}-\omega^{\mu}\boldsymbol{e},\qquad{\boldsymbol{\pi}^{\mu}}^{\top}\boldsymbol{v}^{\mu}=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝑰</mi><mo>−</mo><msup><mi>𝑷</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mi>μ</mi></msup></mrow><mo>=</mo><mrow><msup><mi>𝒓</mi><mi>μ</mi></msup><mo>−</mo><mrow><msup><mi>ω</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒆</mi></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mmultiscripts><mi>𝝅</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mi>μ</mi></msup></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\boldsymbol{I}-\boldsymbol{P}^{\mu})\boldsymbol{v}^{\mu}=\boldsymbol{r}^{\mu}-\omega^{\mu}\boldsymbol{e},\qquad{\boldsymbol{\pi}^{\mu}}^{\top}\boldsymbol{v}^{\mu}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.SSS0.Px1.p1.2" class="ltx_p">Because <math id="A4.SS1.SSS0.Px1.p1.m11" class="ltx_Math" alttext="\boldsymbol{e}" display="inline" intent=":literal"><semantics><mi>𝒆</mi><annotation encoding="application/x-tex">\boldsymbol{e}</annotation></semantics></math> and <math id="A4.SS1.SSS0.Px1.p1.m12" class="ltx_Math" alttext="\boldsymbol{v}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝒗</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{v}^{\mu}</annotation></semantics></math> are included as columns of <math id="A4.SS1.SSS0.Px1.p1.m13" class="ltx_Math" alttext="\boldsymbol{\Phi}" display="inline" intent=":literal"><semantics><mi>𝚽</mi><annotation encoding="application/x-tex">\boldsymbol{\Phi}</annotation></semantics></math>, which is of full rank, the optimal weight vector <math id="A4.SS1.SSS0.Px1.p1.m14" class="ltx_Math" alttext="\boldsymbol{\theta}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝜽</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\boldsymbol{\theta}^{*}</annotation></semantics></math> can be obtained from solving the linear system
<math id="A4.SS1.SSS0.Px1.p1.m15" class="ltx_Math" alttext="\boldsymbol{\Phi}\boldsymbol{\theta}^{*}=\boldsymbol{v}^{\mu}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜽</mi><mo>∗</mo></msup></mrow><mo>=</mo><msup><mi>𝒗</mi><mi>μ</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{\Phi}\boldsymbol{\theta}^{*}=\boldsymbol{v}^{\mu}.</annotation></semantics></math>
In an analogous fashion, to compute the projection to the space <math id="A4.SS1.SSS0.Px1.p1.m16" class="ltx_Math" alttext="\mathbb{O}" display="inline" intent=":literal"><semantics><mi>𝕆</mi><annotation encoding="application/x-tex">\mathbb{O}</annotation></semantics></math>, we solve for <math id="A4.SS1.SSS0.Px1.p1.m17" class="ltx_Math" alttext="\boldsymbol{\theta}_{\boldsymbol{e}}" display="inline" intent=":literal"><semantics><msub><mi>𝜽</mi><mi>𝒆</mi></msub><annotation encoding="application/x-tex">\boldsymbol{\theta}_{\boldsymbol{e}}</annotation></semantics></math> satisfying <math id="A4.SS1.SSS0.Px1.p1.m18" class="ltx_Math" alttext="\boldsymbol{\Phi}\boldsymbol{\theta}_{\boldsymbol{e}}=\boldsymbol{e}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝚽</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜽</mi><mi>𝒆</mi></msub></mrow><mo>=</mo><mi>𝒆</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{\Phi}\boldsymbol{\theta}_{\boldsymbol{e}}=\boldsymbol{e}.</annotation></semantics></math>
Recall that <math id="A4.SS1.SSS0.Px1.p1.m19" class="ltx_Math" alttext="\boldsymbol{\theta}_{\boldsymbol{e}}" display="inline" intent=":literal"><semantics><msub><mi>𝜽</mi><mi>𝒆</mi></msub><annotation encoding="application/x-tex">\boldsymbol{\theta}_{\boldsymbol{e}}</annotation></semantics></math> defines the projection direction that removes the constant component of the error. The projection operator to the space <math id="A4.SS1.SSS0.Px1.p1.m20" class="ltx_Math" alttext="\mathbb{O}" display="inline" intent=":literal"><semantics><mi>𝕆</mi><annotation encoding="application/x-tex">\mathbb{O}</annotation></semantics></math>, can be expressed as <math id="A4.SS1.SSS0.Px1.p1.m21" class="ltx_Math" alttext="\boldsymbol{I}-\frac{\boldsymbol{\theta}_{e}{\boldsymbol{\theta}_{e}}^{\top}}{\|\boldsymbol{\theta}_{e}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑰</mi><mo>−</mo><mfrac><mrow><msub><mi>𝜽</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝜽</mi><mi>e</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜽</mi><mi>e</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\boldsymbol{I}-\frac{\boldsymbol{\theta}_{e}{\boldsymbol{\theta}_{e}}^{\top}}{\|\boldsymbol{\theta}_{e}\|^{2}}</annotation></semantics></math>, i.e., <math id="A4.SS1.SSS0.Px1.p1.m22" class="ltx_Math" alttext="\Pi_{\mathbb{O}}(\boldsymbol{\theta})=\left(\boldsymbol{I}-\frac{\boldsymbol{\theta}_{e}{\boldsymbol{\theta}_{e}}^{\top}}{\|\boldsymbol{\theta}_{e}\|^{2}}\right)\boldsymbol{\theta}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Π</mi><mi>𝕆</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mi>𝑰</mi><mo>−</mo><mfrac><mrow><msub><mi>𝜽</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝜽</mi><mi>e</mi><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜽</mi><mi>e</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pi_{\mathbb{O}}(\boldsymbol{\theta})=\left(\boldsymbol{I}-\frac{\boldsymbol{\theta}_{e}{\boldsymbol{\theta}_{e}}^{\top}}{\|\boldsymbol{\theta}_{e}\|^{2}}\right)\boldsymbol{\theta}.</annotation></semantics></math></p>
</div>
</section>
<section id="A4.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.1.1 </span>MRP</h4>

<section id="A4.SS1.SSS1.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Experiment setup.</h5>

<div id="A4.SS1.SSS1.Px1.p1" class="ltx_para">
<p id="A4.SS1.SSS1.Px1.p1.1" class="ltx_p">We describe the construction of transition probabilities, rewards, and the feature matrix following <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib46" title="" class="ltx_ref">46</a>]</cite>; details are reproduced here for completeness.</p>
</div>
<div id="A4.SS1.SSS1.Px1.p2" class="ltx_para">
<ul id="A4.I1" class="ltx_itemize">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i1.p1" class="ltx_para">
<p id="A4.I1.i1.p1.1" class="ltx_p"><span id="A4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Transition probabilities:</span> For each state <math id="A4.I1.i1.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, we generated a probability distribution over the <math id="A4.I1.i1.p1.m2" class="ltx_Math" alttext="|\mathcal{S}|=100" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">|\mathcal{S}|=100</annotation></semantics></math> states by drawing (<math id="A4.I1.i1.p1.m3" class="ltx_Math" alttext="|\mathcal{S}|-1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\mathcal{S}|-1</annotation></semantics></math>) i.i.d samples from <math id="A4.I1.i1.p1.m4" class="ltx_Math" alttext="\mathrm{Unif}[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Unif}[0,1]</annotation></semantics></math>. We then sorted them, and took successive differences. The final entry was set to ensure the components sum to one.</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p"><span id="A4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Rewards:</span> Each state <math id="A4.I1.i2.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> received a reward sampled independently from <math id="A4.I1.i2.p1.m2" class="ltx_Math" alttext="\mathrm{Unif}[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Unif}[0,1]</annotation></semantics></math>.</p>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i3.p1" class="ltx_para">
<p id="A4.I1.i3.p1.1" class="ltx_p"><span id="A4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Feature matrix:</span> Let <math id="A4.I1.i3.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> denote the feature dimension. We draw <math id="A4.I1.i3.p1.m2" class="ltx_Math" alttext="\widetilde{\boldsymbol{\Phi}}\in\mathbb{R}^{|\mathcal{S}|\times(d-2)}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚽</mi><mo>~</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\widetilde{\boldsymbol{\Phi}}\in\mathbb{R}^{|\mathcal{S}|\times(d-2)}</annotation></semantics></math> with i.i.d. <math id="A4.I1.i3.p1.m3" class="ltx_Math" alttext="\mathrm{Bernoulli}(0.5)" display="inline" intent=":literal"><semantics><mrow><mi>Bernoulli</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0.5</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Bernoulli}(0.5)</annotation></semantics></math> entries. We then appended the all-ones vector <math id="A4.I1.i3.p1.m4" class="ltx_Math" alttext="\boldsymbol{e}" display="inline" intent=":literal"><semantics><mi>𝒆</mi><annotation encoding="application/x-tex">\boldsymbol{e}</annotation></semantics></math> and the basic differential value <math id="A4.I1.i3.p1.m5" class="ltx_Math" alttext="\boldsymbol{v}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝒗</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{v}^{\mu}</annotation></semantics></math> as columns to form</p>
<table id="A4.Ex235" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex235.m1" class="ltx_Math" alttext="\boldsymbol{\Phi}=\left[\widetilde{\boldsymbol{\Phi}}\;\;\boldsymbol{e}\;\;\boldsymbol{v}^{\mu}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝚽</mi><mo>=</mo><mrow><mo>[</mo><mrow><mover accent="true"><mi>𝚽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝒆</mi><mo lspace="0.560em" rspace="0em">​</mo><msup><mi>𝒗</mi><mi>μ</mi></msup></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{\Phi}=\left[\widetilde{\boldsymbol{\Phi}}\;\;\boldsymbol{e}\;\;\boldsymbol{v}^{\mu}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I1.i3.p1.2" class="ltx_p">If needed, we repeated the sampling until <math id="A4.I1.i3.p1.m6" class="ltx_Math" alttext="\boldsymbol{\Phi}" display="inline" intent=":literal"><semantics><mi>𝚽</mi><annotation encoding="application/x-tex">\boldsymbol{\Phi}</annotation></semantics></math> had full column rank, then was row-normalized so that <math id="A4.I1.i3.p1.m7" class="ltx_Math" alttext="\|\boldsymbol{\phi}(s)\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\boldsymbol{\phi}(s)\|\leq 1</annotation></semantics></math> for all <math id="A4.I1.i3.p1.m8" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
</section>
<section id="A4.SS1.SSS1.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Additional results.</h5>

<div id="A4.SS1.SSS1.Px2.p1" class="ltx_para">
<p id="A4.SS1.SSS1.Px2.p1.1" class="ltx_p">We report additional MRP results under a decaying step-size schedule. For each schedule, we run 50 independent trials, initialize <math id="A4.SS1.SSS1.Px2.p1.m1" class="ltx_Math" alttext="\boldsymbol{\theta}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝜽</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\boldsymbol{\theta}_{0}</annotation></semantics></math> by sampling each coordinate from <math id="A4.SS1.SSS1.Px2.p1.m2" class="ltx_Math" alttext="\mathrm{Unif}[-1,1]" display="inline" intent=":literal"><semantics><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Unif}[-1,1]</annotation></semantics></math>, and set the initial average-reward estimate <math id="A4.SS1.SSS1.Px2.p1.m3" class="ltx_Math" alttext="\widehat{\omega}_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ω</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{\omega}_{0}=0</annotation></semantics></math>. Complementing the constant step-size results in the main text, Figure <a href="#A4.F5" title="Figure 5 ‣ Additional results. ‣ D.1.1 MRP ‣ D.1 Evaluation Experiments ‣ Appendix D Additional Experimental Details ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> shows performance under <math id="A4.SS1.SSS1.Px2.p1.m4" class="ltx_Math" alttext="\beta_{t}=\beta_{0}/(t+1)^{0.99}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>/</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>0.99</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}=\beta_{0}/(t+1)^{0.99}</annotation></semantics></math> for initial step-sizes <math id="A4.SS1.SSS1.Px2.p1.m5" class="ltx_Math" alttext="\beta_{0}\in\{0.1,0.2,\ldots,3.0\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0.1</mn><mo>,</mo><mn>0.2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>3.0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\beta_{0}\in\{0.1,0.2,\ldots,3.0\}</annotation></semantics></math> using the same hyperparameters <math id="A4.SS1.SSS1.Px2.p1.m6" class="ltx_Math" alttext="(\lambda=0.25,\,c_{\alpha}=1.0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>=</mo><mn>0.25</mn></mrow><mo>,</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>=</mo><mn>1.0</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda=0.25,\,c_{\alpha}=1.0)</annotation></semantics></math>. Solid lines denote the mean loss across runs and shaded regions indicate 95<math id="A4.SS1.SSS1.Px2.p1.m7" class="ltx_Math" alttext="\%" display="inline" intent=":literal"><semantics><mo>%</mo><annotation encoding="application/x-tex">\%</annotation></semantics></math> confidence intervals. As <math id="A4.SS1.SSS1.Px2.p1.m8" class="ltx_Math" alttext="\beta_{0}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\beta_{0}</annotation></semantics></math> increases, average-reward implicit TD(<math id="A4.SS1.SSS1.Px2.p1.m9" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) methods keep the loss controlled, whereas average-reward TD(<math id="A4.SS1.SSS1.Px2.p1.m10" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) diverges for step-sizes larger than 2.0. For <math id="A4.SS1.SSS1.Px2.p1.m11" class="ltx_Math" alttext="\beta_{t}=1.8/(t+1)^{0.99}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>=</mo><mrow><mn>1.8</mn><mo>/</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>0.99</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}=1.8/(t+1)^{0.99}</annotation></semantics></math>, the full loss trajectory (right panel) further underscores the gap: average-reward TD(<math id="A4.SS1.SSS1.Px2.p1.m12" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) remains markedly worse than its implicit counterparts.</p>
</div>
<figure id="A4.F5" class="ltx_figure">

<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A4.F5.4" class="ltx_text" style="font-size:90%;">Figure 5</span>: </span><span id="A4.F5.5" class="ltx_text" style="font-size:90%;">MRP experiment results under decaying step-size schedule <math id="A4.F5.m4" class="ltx_Math" alttext="\beta_{t}=\beta_{0}/(t+1)^{0.99}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>/</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>0.99</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}=\beta_{0}/(t+1)^{0.99}</annotation></semantics></math>, with exponential weighting parameter and step-size ratio set to <math id="A4.F5.m5" class="ltx_Math" alttext="(\lambda,c_{\alpha})=(0.25,1.0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0.25</mn><mo>,</mo><mn>1.0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\lambda,c_{\alpha})=(0.25,1.0)</annotation></semantics></math>. Solid lines denote the mean, and shaded regions represent 95% confidence intervals. (Left) Loss value for initial step-sizes from 0.1 to 3.0.
(Right) Full trajectory of the loss value with initial step-size <math id="A4.F5.m6" class="ltx_Math" alttext="\beta_{0}=1.8" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>=</mo><mn>1.8</mn></mrow><annotation encoding="application/x-tex">\beta_{0}=1.8</annotation></semantics></math>.</span></figcaption><div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F5.fig1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06149v1/figure/MRP/s_decay/Arxiv_summary_plot_CUT_lamb0.25_alpha1.00.png" id="A4.F5.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:476/417;" width="476" height="417" alt="Refer to caption">
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F5.fig2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06149v1/figure/MRP/s_decay/Arxiv_alpha_1.8_full.png" id="A4.F5.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:476/417;" width="476" height="417" alt="Refer to caption">
</figure></div></div>
</figure>
</section>
</section>
<section id="A4.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.1.2 </span>Boyan Chain</h4>

<section id="A4.SS1.SSS2.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Experiment setup.</h5>

<div id="A4.SS1.SSS2.Px1.p1" class="ltx_para">
<p id="A4.SS1.SSS2.Px1.p1.1" class="ltx_p">We describe the construction of the transition probabilities, reward function, and feature matrix for the average-reward Boyan chain.
The original Boyan chain was introduced by <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> and later adapted to the average-reward setting by <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib45" title="" class="ltx_ref">45</a>]</cite>. The chain consists of 13 states and two actions, denoted by <math id="A4.SS1.SSS2.Px1.p1.m1" class="ltx_Math" alttext="\{s_{0},s_{1},\ldots,s_{12}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>s</mi><mn>12</mn></msub></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{s_{0},s_{1},\ldots,s_{12}\}</annotation></semantics></math> and <math id="A4.SS1.SSS2.Px1.p1.m2" class="ltx_Math" alttext="\{a_{0},a_{1}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{a_{0},a_{1}\}</annotation></semantics></math>, respectively.</p>
</div>
<div id="A4.SS1.SSS2.Px1.p2" class="ltx_para">
<ul id="A4.I2" class="ltx_itemize">
<li id="A4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i1.p1" class="ltx_para">
<p id="A4.I2.i1.p1.1" class="ltx_p"><span id="A4.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Transition probabilities:</span> The transition probabilities of the Boyan chain are defined as</p>
<table id="A4.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex236"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex236.m1" class="ltx_Math" alttext="\displaystyle p(s_{i-2}\mid s_{i},a_{0})=1,\quad p(s_{i-1}\mid s_{i},a_{1})=1,\quad\forall i\in\{2,3,\ldots,12\}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>12</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle p(s_{i-2}\mid s_{i},a_{0})=1,\quad p(s_{i-1}\mid s_{i},a_{1})=1,\quad\forall i\in\{2,3,\ldots,12\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex237"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex237.m1" class="ltx_Math" alttext="\displaystyle p(s_{0}\mid s_{1},a_{0})=p(s_{0}\mid s_{1},a_{1})=1," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle p(s_{0}\mid s_{1},a_{0})=p(s_{0}\mid s_{1},a_{1})=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex238"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex238.m1" class="ltx_Math" alttext="\displaystyle p(s_{j}\mid s_{0},a_{0})=p(s_{j}\mid s_{0},a_{1})=\tfrac{1}{13},\quad\forall j\in\{0,1,\ldots,12\}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mn>13</mn></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>12</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle p(s_{j}\mid s_{0},a_{0})=p(s_{j}\mid s_{0},a_{1})=\tfrac{1}{13},\quad\forall j\in\{0,1,\ldots,12\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i2.p1" class="ltx_para">
<p id="A4.I2.i2.p1.1" class="ltx_p"><span id="A4.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Reward:</span> The reward function is defined as <math id="A4.I2.i2.p1.m1" class="ltx_Math" alttext="r(i,a_{0})=0.5" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><msub><mi>a</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">r(i,a_{0})=0.5</annotation></semantics></math> and <math id="A4.I2.i2.p1.m2" class="ltx_Math" alttext="r(i,a_{1})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r(i,a_{1})=1</annotation></semantics></math> for all <math id="A4.I2.i2.p1.m3" class="ltx_Math" alttext="i\in\{0,1,\ldots,12\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>12</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{0,1,\ldots,12\}</annotation></semantics></math>.</p>
</div></li>
<li id="A4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i3.p1" class="ltx_para">
<p id="A4.I2.i3.p1.1" class="ltx_p"><span id="A4.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">Feature matrix:</span>
Consistent with the MRP experiment, we first construct the matrix <math id="A4.I2.i3.p1.m1" class="ltx_Math" alttext="\widetilde{\boldsymbol{\Phi}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝚽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\boldsymbol{\Phi}}</annotation></semantics></math>, and append both the all-ones vector <math id="A4.I2.i3.p1.m2" class="ltx_Math" alttext="\boldsymbol{e}" display="inline" intent=":literal"><semantics><mi>𝒆</mi><annotation encoding="application/x-tex">\boldsymbol{e}</annotation></semantics></math> and the differential value function <math id="A4.I2.i3.p1.m3" class="ltx_Math" alttext="\boldsymbol{v}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝒗</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{v}^{\mu}</annotation></semantics></math> as columns</p>
<table id="A4.Ex239" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex239.m1" class="ltx_Math" alttext="\boldsymbol{\Phi}=\left[\widetilde{\boldsymbol{\Phi}}\;\;\boldsymbol{e}\;\;\boldsymbol{v}^{\mu}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝚽</mi><mo>=</mo><mrow><mo>[</mo><mrow><mover accent="true"><mi>𝚽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝒆</mi><mo lspace="0.560em" rspace="0em">​</mo><msup><mi>𝒗</mi><mi>μ</mi></msup></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{\Phi}=\left[\widetilde{\boldsymbol{\Phi}}\;\;\boldsymbol{e}\;\;\boldsymbol{v}^{\mu}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I2.i3.p1.2" class="ltx_p">Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, the matrix <math id="A4.I2.i3.p1.m4" class="ltx_Math" alttext="\widetilde{\boldsymbol{\Phi}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝚽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\boldsymbol{\Phi}}</annotation></semantics></math> is constructed by linearly interpolating between the one-hot vectors <math id="A4.I2.i3.p1.m5" class="ltx_Math" alttext="(1,0,0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,0,0,0)</annotation></semantics></math> and <math id="A4.I2.i3.p1.m6" class="ltx_Math" alttext="(0,0,0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0,0,1)</annotation></semantics></math> in increments of <math id="A4.I2.i3.p1.m7" class="ltx_Math" alttext="1/4" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">1/4</annotation></semantics></math>. Specifically, the representation starts with state <math id="A4.I2.i3.p1.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> as <math id="A4.I2.i3.p1.m9" class="ltx_Math" alttext="(1,0,0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,0,0,0)</annotation></semantics></math>, then passes through intermediate states such as <math id="A4.I2.i3.p1.m10" class="ltx_Math" alttext="(\tfrac{3}{4},\tfrac{1}{4},0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mfrac><mn>3</mn><mn>4</mn></mfrac><mo>,</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tfrac{3}{4},\tfrac{1}{4},0,0)</annotation></semantics></math> and <math id="A4.I2.i3.p1.m11" class="ltx_Math" alttext="(\tfrac{1}{2},\tfrac{1}{2},0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>,</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tfrac{1}{2},\tfrac{1}{2},0,0)</annotation></semantics></math>, eventually reaching <math id="A4.I2.i3.p1.m12" class="ltx_Math" alttext="(0,0,0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0,0,1)</annotation></semantics></math>. Finally, we normalize each row to ensure <math id="A4.I2.i3.p1.m13" class="ltx_Math" alttext="\|\boldsymbol{\phi}(s)\|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\boldsymbol{\phi}(s)\|\leq 1</annotation></semantics></math> for all <math id="A4.I2.i3.p1.m14" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
</section>
<section id="A4.SS1.SSS2.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Additional results.</h5>

<div id="A4.SS1.SSS2.Px2.p1" class="ltx_para">
<p id="A4.SS1.SSS2.Px2.p1.1" class="ltx_p">We also report extended results for the Boyan experiments. For each step-size schedule, we conduct <math id="A4.SS1.SSS2.Px2.p1.m1" class="ltx_Math" alttext="50" display="inline" intent=":literal"><semantics><mn>50</mn><annotation encoding="application/x-tex">50</annotation></semantics></math> independent runs with <math id="A4.SS1.SSS2.Px2.p1.m2" class="ltx_Math" alttext="T=2000" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2000</mn></mrow><annotation encoding="application/x-tex">T=2000</annotation></semantics></math>.
Each component of the parameter vector <math id="A4.SS1.SSS2.Px2.p1.m3" class="ltx_Math" alttext="\widehat{\theta}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\widehat{\theta}_{0}</annotation></semantics></math> is initialized as <math id="A4.SS1.SSS2.Px2.p1.m4" class="ltx_Math" alttext="\mathcal{U}[-1,1]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}[-1,1]</annotation></semantics></math>, and the initial average-reward estimate is set to <math id="A4.SS1.SSS2.Px2.p1.m5" class="ltx_Math" alttext="\widehat{\omega}_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ω</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{\omega}_{0}=0</annotation></semantics></math>.
In each experiment, we first sample actions in each state from a <math id="A4.SS1.SSS2.Px2.p1.m6" class="ltx_Math" alttext="\text{Binomial}(n=13,p=0.5)" display="inline" intent=":literal"><semantics><mrow><mtext>Binomial</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>=</mo><mn>13</mn></mrow><mo>,</mo><mrow><mi>p</mi><mo>=</mo><mn>0.5</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Binomial}(n=13,p=0.5)</annotation></semantics></math> distribution. The sampled action will determine the deterministic policy to be evaluated. For each such sampled deterministic policy, an associated transition probability matrix <math id="A4.SS1.SSS2.Px2.p1.m7" class="ltx_Math" alttext="\boldsymbol{P}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{P}^{\mu}</annotation></semantics></math> is induced. We provide results under the constant step-size schedule. The results as a function of the initial step-size, with hyperparameters <math id="A4.SS1.SSS2.Px2.p1.m8" class="ltx_Math" alttext="(\lambda,c_{\alpha})=(0.25,1.0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0.25</mn><mo>,</mo><mn>1.0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\lambda,c_{\alpha})=(0.25,1.0)</annotation></semantics></math>, are shown in Figure <a href="#A4.F6" title="Figure 6 ‣ Additional results. ‣ D.1.2 Boyan Chain ‣ D.1 Evaluation Experiments ‣ Appendix D Additional Experimental Details ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. As shown in the left panel, the loss increases monotonically with the step-size across all methods. However, the growth is substantially reduced for the average-reward implicit TD(<math id="A4.SS1.SSS2.Px2.p1.m9" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>). In contrast, the average-reward TD(<math id="A4.SS1.SSS2.Px2.p1.m10" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) diverges under similar conditions. The right panel further illustrates the trajectory of the loss value over training. At a moderately large initial step-size (<math id="A4.SS1.SSS2.Px2.p1.m11" class="ltx_Math" alttext="\beta_{0}=0.5" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\beta_{0}=0.5</annotation></semantics></math>), the loss of average-reward TD(<math id="A4.SS1.SSS2.Px2.p1.m12" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) exceeds that of its implicit counterpart.</p>
</div>
<figure id="A4.F6" class="ltx_figure">

<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A4.F6.3" class="ltx_text" style="font-size:90%;">Figure 6</span>: </span><span id="A4.F6.4" class="ltx_text" style="font-size:90%;">Boyan experiment results under the constant step-size, with exponential weighting parameter and step-size ratio set to <math id="A4.F6.m4" class="ltx_Math" alttext="(\lambda,c_{\alpha})=(0.25,1.0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0.25</mn><mo>,</mo><mn>1.0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\lambda,c_{\alpha})=(0.25,1.0)</annotation></semantics></math>. The solid line represents the mean, and the shaded region denotes the 95% confidence interval. (Left) Loss value with initial step-size <math id="A4.F6.m5" class="ltx_Math" alttext="\beta_{0}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\beta_{0}</annotation></semantics></math>, from 0.1 to 3.0. (Right) Loss value over iterations with <math id="A4.F6.m6" class="ltx_Math" alttext="\beta_{0}=0.5" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\beta_{0}=0.5</annotation></semantics></math>.</span></figcaption><div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F6.fig1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06149v1/figure/Boyan/constant/Arxiv_summary_plot_CUT_lamb0.25_alpha1.00.png" id="A4.F6.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:476/417;" width="476" height="417" alt="Refer to caption">
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F6.fig2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06149v1/figure/Boyan/constant/Arxiv_alpha_0.5_full.png" id="A4.F6.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:476/417;" width="476" height="417" alt="Refer to caption">
</figure></div></div>
</figure>
</section>
</section>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Control Experiments</h3>

<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.1" class="ltx_p">We provide details of the control experiment setup. For each action <math id="A4.SS2.p1.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, we form the joint feature
<math id="A4.SS2.p1.m2" class="ltx_Math" alttext="\boldsymbol{\phi}(s,a)=\boldsymbol{\phi}_{\mathrm{RBF}}(s)\otimes e_{a}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mi>RBF</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>e</mi><mi>a</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{\phi}(s,a)=\boldsymbol{\phi}_{\mathrm{RBF}}(s)\otimes e_{a},</annotation></semantics></math>
where <math id="A4.SS2.p1.m3" class="ltx_Math" alttext="e_{a}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mi>a</mi></msub><annotation encoding="application/x-tex">e_{a}</annotation></semantics></math> is the one‐hot encoding of <math id="A4.SS2.p1.m4" class="ltx_Math" alttext="a\in\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">a\in\mathcal{A}</annotation></semantics></math>.
The state-action value function is approximated by <math id="A4.SS2.p1.m5" class="ltx_Math" alttext="\widehat{Q}(s,a)=\boldsymbol{\phi}(s,a)^{\top}\widehat{\boldsymbol{\theta}}_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝜽</mi><mo>^</mo></mover><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{Q}(s,a)=\boldsymbol{\phi}(s,a)^{\top}\widehat{\boldsymbol{\theta}}_{t}</annotation></semantics></math>, where <math id="A4.SS2.p1.m6" class="ltx_Math" alttext="\widehat{\boldsymbol{\theta}}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝜽</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\widehat{\boldsymbol{\theta}}_{t}</annotation></semantics></math> denotes the weight parameter at iteration <math id="A4.SS2.p1.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. We adopt SARSA with <math id="A4.SS2.p1.m8" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-greedy exploration: the agent selects the greedy action with probability <math id="A4.SS2.p1.m9" class="ltx_Math" alttext="1-\epsilon" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">1-\epsilon</annotation></semantics></math> and a random action with probability <math id="A4.SS2.p1.m10" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>. The exploration parameter <math id="A4.SS2.p1.m11" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> starts at <math id="A4.SS2.p1.m12" class="ltx_Math" alttext="0.25" display="inline" intent=":literal"><semantics><mn>0.25</mn><annotation encoding="application/x-tex">0.25</annotation></semantics></math>, drops to <math id="A4.SS2.p1.m13" class="ltx_Math" alttext="0.125" display="inline" intent=":literal"><semantics><mn>0.125</mn><annotation encoding="application/x-tex">0.125</annotation></semantics></math> after 5000 iterations, and is set to <math id="A4.SS2.p1.m14" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> after 10000 iterations. Each experiment runs for <math id="A4.SS2.p1.m15" class="ltx_Math" alttext="T=15000" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>15000</mn></mrow><annotation encoding="application/x-tex">T=15000</annotation></semantics></math> steps, with 30 independent runs. Each component of the initial parameter estimate <math id="A4.SS2.p1.m16" class="ltx_Math" alttext="\widehat{\theta}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\widehat{\theta}_{0}</annotation></semantics></math> is initialized from <math id="A4.SS2.p1.m17" class="ltx_Math" alttext="\mathcal{U}[-0.5,0.5]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>0.5</mn></mrow><mo>,</mo><mn>0.5</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}[-0.5,0.5]</annotation></semantics></math> and the initial average-reward estimate is <math id="A4.SS2.p1.m18" class="ltx_Math" alttext="\widehat{\omega}_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ω</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{\omega}_{0}=0</annotation></semantics></math>. The step-size schedule is <math id="A4.SS2.p1.m19" class="ltx_Math" alttext="\beta_{t}=\beta_{0}/(t+400)^{0.99}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>/</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>400</mn></mrow><mo stretchy="false">)</mo></mrow><mn>0.99</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}=\beta_{0}/(t+400)^{0.99}</annotation></semantics></math>, with <math id="A4.SS2.p1.m20" class="ltx_Math" alttext="\beta_{0}\in\{400\times 0.25,\ 400\times 0.50,\ \ldots,\ 400\times 1.5\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mn>400</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>0.25</mn></mrow><mo>,</mo><mrow><mn> 400</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>0.50</mn></mrow><mo rspace="0.667em">,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn> 400</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1.5</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\beta_{0}\in\{400\times 0.25,\ 400\times 0.50,\ \ldots,\ 400\times 1.5\}</annotation></semantics></math>. Hence, the effective initial step-size <math id="A4.SS2.p1.m21" class="ltx_Math" alttext="\beta_{0}/400^{0.99}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>/</mo><msup><mn>400</mn><mn>0.99</mn></msup></mrow><annotation encoding="application/x-tex">\beta_{0}/400^{0.99}</annotation></semantics></math> ranges from 0.25 to 1.5.</p>
</div>
<section id="A4.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.2.1 </span>Access-Control</h4>

<section id="A4.SS2.SSS1.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Experiment setup</h5>

<div id="A4.SS2.SSS1.Px1.p1" class="ltx_para">
<p id="A4.SS2.SSS1.Px1.p1.1" class="ltx_p">We explain the state space, action space, and the reward function of the access-control experiment.</p>
</div>
<div id="A4.SS2.SSS1.Px1.p2" class="ltx_para">
<ul id="A4.I3" class="ltx_itemize">
<li id="A4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I3.i1.p1" class="ltx_para">
<p id="A4.I3.i1.p1.1" class="ltx_p"><span id="A4.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">States and actions:</span> The state space is defined by the number of free servers and the class of arriving customer. Let <math id="A4.I3.i1.p1.m1" class="ltx_Math" alttext="n\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">n\in\mathbb{N}</annotation></semantics></math> be the total number of servers and <math id="A4.I3.i1.p1.m2" class="ltx_Math" alttext="\mathcal{C}=\{1,2,\ldots,C\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>C</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}=\{1,2,\ldots,C\}</annotation></semantics></math> the set of customer classes.
The state at time <math id="A4.I3.i1.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is
<math id="A4.I3.i1.p1.m4" class="ltx_Math" alttext="S^{\mu}_{t}=(k_{t},c_{t})\in\{0,1,\ldots,n\}\times\mathcal{C}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>t</mi></msub><mo>,</mo><msub><mi>c</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S^{\mu}_{t}=(k_{t},c_{t})\in\{0,1,\ldots,n\}\times\mathcal{C},</annotation></semantics></math>
where <math id="A4.I3.i1.p1.m5" class="ltx_Math" alttext="k_{t}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>t</mi></msub><annotation encoding="application/x-tex">k_{t}</annotation></semantics></math> is the number of free servers and <math id="A4.I3.i1.p1.m6" class="ltx_Math" alttext="c_{t}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>t</mi></msub><annotation encoding="application/x-tex">c_{t}</annotation></semantics></math> is the class of the arriving customer.
Arrivals are equiprobable, that is:
<math id="A4.I3.i1.p1.m7" class="ltx_Math" alttext="\mathbb{P}(c_{t}=c)=\tfrac{1}{C}~\text{for each }c\in\mathcal{C}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mi>t</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>C</mi></mfrac><mo lspace="0.330em" rspace="0em">​</mo><mtext>for each </mtext><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}(c_{t}=c)=\tfrac{1}{C}~\text{for each }c\in\mathcal{C},</annotation></semantics></math>
and this distribution is unknown to the decision maker. The decision maker either accepts the customer (action <math id="A4.I3.i1.p1.m8" class="ltx_Math" alttext="a_{0}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mn>0</mn></msub><annotation encoding="application/x-tex">a_{0}</annotation></semantics></math>) and assigns a free server, or rejects the customer (action <math id="A4.I3.i1.p1.m9" class="ltx_Math" alttext="a_{1}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mn>1</mn></msub><annotation encoding="application/x-tex">a_{1}</annotation></semantics></math>). Hence, the feasible action set is</p>
<table id="A4.Ex240" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex240.m1" class="ltx_Math" alttext="\mathcal{A}(S^{\mu}_{t})=\begin{cases}\{a_{0}\ (\text{accept}),a_{1}\ (\text{reject})\},&amp;k_{t}&gt;0,\\
\{a_{1}\ (\text{reject})\},&amp;k_{t}=0.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo stretchy="false">{</mo><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>accept</mtext><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>reject</mtext><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>k</mi><mi>t</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo stretchy="false">{</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>reject</mtext><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>k</mi><mi>t</mi></msub><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}(S^{\mu}_{t})=\begin{cases}\{a_{0}\ (\text{accept}),a_{1}\ (\text{reject})\},&amp;k_{t}&gt;0,\\
\{a_{1}\ (\text{reject})\},&amp;k_{t}=0.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I3.i2.p1" class="ltx_para">
<p id="A4.I3.i2.p1.1" class="ltx_p"><span id="A4.I3.i2.p1.1.1" class="ltx_text ltx_font_bold">Reward:</span>
The one-step reward is
<math id="A4.I3.i2.p1.m1" class="ltx_math_unparsed" alttext="R^{\mu}_{t}=\frac{2^{c_{t}}}{2^{C}}\mathbb{I}\{a_{t}=a_{0}\}," display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo>=</mo><mfrac><msup><mn>2</mn><msub><mi>c</mi><mi>t</mi></msub></msup><msup><mn>2</mn><mi>C</mi></msup></mfrac><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mi>t</mi></msub><mo>=</mo><msub><mi>a</mi><mn>0</mn></msub><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">R^{\mu}_{t}=\frac{2^{c_{t}}}{2^{C}}\mathbb{I}\{a_{t}=a_{0}\},</annotation></semantics></math>
i.e., the decision maker receives <math id="A4.I3.i2.p1.m2" class="ltx_Math" alttext="2^{c_{t}}/2^{C}" display="inline" intent=":literal"><semantics><mrow><msup><mn>2</mn><msub><mi>c</mi><mi>t</mi></msub></msup><mo>/</mo><msup><mn>2</mn><mi>C</mi></msup></mrow><annotation encoding="application/x-tex">2^{c_{t}}/2^{C}</annotation></semantics></math> if the customer is accepted and <math id="A4.I3.i2.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> otherwise.</p>
</div></li>
<li id="A4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I3.i3.p1" class="ltx_para">
<p id="A4.I3.i3.p1.1" class="ltx_p"><span id="A4.I3.i3.p1.1.1" class="ltx_text ltx_font_bold">State transitions:</span>
If <math id="A4.I3.i3.p1.m1" class="ltx_Math" alttext="a_{t}=a_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>=</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">a_{t}=a_{0}</annotation></semantics></math> and <math id="A4.I3.i3.p1.m2" class="ltx_Math" alttext="k_{t}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mi>t</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k_{t}&gt;0</annotation></semantics></math>, one available server is allocated. Let
<math id="A4.I3.i3.p1.m3" class="ltx_math_unparsed" alttext="\tilde{k}_{t}=k_{t}-\mathbb{I}\{a_{t}=a_{0}\}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>k</mi><mo>~</mo></mover><mi>t</mi></msub><mo>=</mo><msub><mi>k</mi><mi>t</mi></msub><mo>−</mo><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mi>t</mi></msub><mo>=</mo><msub><mi>a</mi><mn>0</mn></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{k}_{t}=k_{t}-\mathbb{I}\{a_{t}=a_{0}\}</annotation></semantics></math>
then <math id="A4.I3.i3.p1.m4" class="ltx_Math" alttext="b_{t}=n-\tilde{k}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>n</mi><mo>−</mo><msub><mover accent="true"><mi>k</mi><mo>~</mo></mover><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">b_{t}=n-\tilde{k}_{t}</annotation></semantics></math> is the number of busy servers immediately after the action.
Each occupied server completes independently with probability <math id="A4.I3.i3.p1.m5" class="ltx_Math" alttext="p\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p\in(0,1)</annotation></semantics></math> at the end of the period. Therefore, the number of free servers at the next step is
<math id="A4.I3.i3.p1.m6" class="ltx_Math" alttext="k_{t+1}=\min\{n,\ \tilde{k}_{t}+Y_{t}\}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>k</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>n</mi><mo rspace="0.667em">,</mo><mrow><msub><mover accent="true"><mi>k</mi><mo>~</mo></mover><mi>t</mi></msub><mo>+</mo><msub><mi>Y</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">k_{t+1}=\min\{n,\ \tilde{k}_{t}+Y_{t}\},</annotation></semantics></math>
where
<math id="A4.I3.i3.p1.m7" class="ltx_Math" alttext="Y_{t}\sim\mathrm{Binomial}(b_{t},p)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo>∼</mo><mrow><mi>Binomial</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>t</mi></msub><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Y_{t}\sim\mathrm{Binomial}(b_{t},p).</annotation></semantics></math>
Lastly, the next arriving class <math id="A4.I3.i3.p1.m8" class="ltx_Math" alttext="c_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">c_{t+1}</annotation></semantics></math> is drawn independently and uniformly from <math id="A4.I3.i3.p1.m9" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="A4.SS2.SSS1.Px1.p2.1" class="ltx_p">The goal is to find an optimal policy <math id="A4.SS2.SSS1.Px1.p2.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> that maximizes the average-reward <math id="A4.SS2.SSS1.Px1.p2.m2" class="ltx_Math" alttext="\omega^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\omega^{\mu}</annotation></semantics></math>. We follow the setup in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>]</cite>, with <math id="A4.SS2.SSS1.Px1.p2.m3" class="ltx_Math" alttext="C=4" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">C=4</annotation></semantics></math> customer classes, <math id="A4.SS2.SSS1.Px1.p2.m4" class="ltx_Math" alttext="n=10" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">n=10</annotation></semantics></math> total servers, and a service completion rate <math id="A4.SS2.SSS1.Px1.p2.m5" class="ltx_Math" alttext="p=0.06" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0.06</mn></mrow><annotation encoding="application/x-tex">p=0.06</annotation></semantics></math>. Accepted customers occupy a server until completion, at which point the server is freed. For feature representation, states are rescaled to <math id="A4.SS2.SSS1.Px1.p2.m6" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> and embedded via a single-scale random Fourier feature map <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib24" title="" class="ltx_ref">24</a>, <a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite> implemented with scikit-learn’s <span id="A4.SS2.SSS1.Px1.p2.1.1" class="ltx_text ltx_font_typewriter">RBFSampler</span>. The map uses twenty randomly drawn features and sets the inverse length-scale parameter to one, so that inner products in the resulting feature space provide a good approximation to the RBF kernel.</p>
</div>
</section>
</section>
<section id="A4.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.2.2 </span>Pendulum</h4>

<section id="A4.SS2.SSS2.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Experiment Setup</h5>

<div id="A4.SS2.SSS2.Px1.p1" class="ltx_para">
<p id="A4.SS2.SSS2.Px1.p1.1" class="ltx_p">At each time step <math id="A4.SS2.SSS2.Px1.p1.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, the state is
<math id="A4.SS2.SSS2.Px1.p1.m2" class="ltx_Math" alttext="S_{t}^{\mu}=(\cos\eta_{t},\sin\eta_{t},\dot{\eta}_{t})," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>S</mi><mi>t</mi><mi>μ</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>η</mi><mi>t</mi></msub></mrow><mo>,</mo><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><msub><mi>η</mi><mi>t</mi></msub></mrow><mo>,</mo><msub><mover accent="true"><mi>η</mi><mo>˙</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{t}^{\mu}=(\cos\eta_{t},\sin\eta_{t},\dot{\eta}_{t}),</annotation></semantics></math>
where <math id="A4.SS2.SSS2.Px1.p1.m3" class="ltx_Math" alttext="\eta_{t}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\eta_{t}</annotation></semantics></math> is the pendulum angle and <math id="A4.SS2.SSS2.Px1.p1.m4" class="ltx_Math" alttext="\dot{\eta}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>η</mi><mo>˙</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\dot{\eta}_{t}</annotation></semantics></math> its angular velocity. The action corresponds to applying a torque to the pendulum. We discretize the continuous action space <math id="A4.SS2.SSS2.Px1.p1.m5" class="ltx_Math" alttext="[-2,2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-2,2]</annotation></semantics></math> into five actions <math id="A4.SS2.SSS2.Px1.p1.m6" class="ltx_Math" alttext="(\mathcal{A}=\{-2,-1,0,1,2\})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{A}=\{-2,-1,0,1,2\})</annotation></semantics></math>. Unlike the episodic setting, this environment has no terminal state and runs indefinitely, so we optimize the long-run average-reward. The per step reward is
<math id="A4.SS2.SSS2.Px1.p1.m7" class="ltx_Math" alttext="R_{t}^{\mu}=-\frac{\eta_{t}^{2}+0.1\dot{\eta}_{t}^{2}+0.001a_{t}^{2}}{16.27}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>R</mi><mi>t</mi><mi>μ</mi></msubsup><mo>=</mo><mrow><mo>−</mo><mfrac><mrow><msubsup><mi>η</mi><mi>t</mi><mn>2</mn></msubsup><mo>+</mo><mrow><mn>0.1</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>η</mi><mo>˙</mo></mover><mi>t</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>0.001</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><mn>16.27</mn></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">R_{t}^{\mu}=-\frac{\eta_{t}^{2}+0.1\dot{\eta}_{t}^{2}+0.001a_{t}^{2}}{16.27},</annotation></semantics></math>
where the normalization factor 16.27 scales the reward into <math id="A4.SS2.SSS2.Px1.p1.m8" class="ltx_Math" alttext="[-1,0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-1,0]</annotation></semantics></math>. We use the Gymnasium implementation of the pendulum environment <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib37" title="" class="ltx_ref">37</a>]</cite>. To approximate the state–action value, we use random Fourier features to approximate the RBF kernel. Concretely, we create two separate <span id="A4.SS2.SSS2.Px1.p1.1.1" class="ltx_text ltx_font_typewriter">RBFSampler</span> feature vectors—one using an inverse length-scale of 0.5 and the other 1.0, each with 150 features, and then concatenate them into a single 300-dimensional feature representation.</p>
</div>
</section>
</section>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3 </span>Effect of Step-Size Ratio</h3>

<div id="A4.SS3.p1" class="ltx_para">
<p id="A4.SS3.p1.1" class="ltx_p">In this section, we study how the step-size ratio <math id="A4.SS3.p1.m1" class="ltx_Math" alttext="c_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>α</mi></msub><annotation encoding="application/x-tex">c_{\alpha}</annotation></semantics></math> affects stability and performance.
We revisit the policy evaluation settings for the MRP and average-reward Boyan chain described in Sections <a href="#A4.SS1.SSS1" title="D.1.1 MRP ‣ D.1 Evaluation Experiments ‣ Appendix D Additional Experimental Details ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1.1</span></a> and <a href="#A4.SS1.SSS2" title="D.1.2 Boyan Chain ‣ D.1 Evaluation Experiments ‣ Appendix D Additional Experimental Details ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1.2</span></a>, respectively.
As in the main experiments, we report the loss value of the form <math id="A4.SS3.p1.m2" class="ltx_Math" alttext="\bigl(\widehat{\omega}-\omega^{\mu}\bigr)^{2}+\bigl\|\Pi_{\mathbb{O}}(\widehat{\boldsymbol{\theta}}-\boldsymbol{\theta}^{\ast})\bigr\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mover accent="true"><mi>ω</mi><mo>^</mo></mover><mo>−</mo><msup><mi>ω</mi><mi>μ</mi></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>𝕆</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>^</mo></mover><mo>−</mo><msup><mi>𝜽</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\bigl(\widehat{\omega}-\omega^{\mu}\bigr)^{2}+\bigl\|\Pi_{\mathbb{O}}(\widehat{\boldsymbol{\theta}}-\boldsymbol{\theta}^{\ast})\bigr\|^{2}</annotation></semantics></math> as the evaluation metric. Under the decaying step-size schedule <math id="A4.SS3.p1.m3" class="ltx_Math" alttext="\beta_{t}=\beta_{0}/(t+1)^{0.99}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>/</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>0.99</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}=\beta_{0}/(t+1)^{0.99}</annotation></semantics></math>, we vary the step-size ratio <math id="A4.SS3.p1.m4" class="ltx_Math" alttext="c_{\alpha}\in\{0.01,0.05,0.1,0.125,0.25,\dots,1.5\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0.01</mn><mo>,</mo><mn>0.05</mn><mo>,</mo><mn>0.1</mn><mo>,</mo><mn>0.125</mn><mo>,</mo><mn>0.25</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1.5</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c_{\alpha}\in\{0.01,0.05,0.1,0.125,0.25,\dots,1.5\}</annotation></semantics></math> while fixing the exponential weighting parameter <math id="A4.SS3.p1.m5" class="ltx_Math" alttext="\lambda=0.25" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0.25</mn></mrow><annotation encoding="application/x-tex">\lambda=0.25</annotation></semantics></math> and the initial step-size <math id="A4.SS3.p1.m6" class="ltx_Math" alttext="\beta_{0}=1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\beta_{0}=1.0</annotation></semantics></math>. Figure <a href="#A4.F7" title="Figure 7 ‣ D.3 Effect of Step-Size Ratio ‣ Appendix D Additional Experimental Details ‣ Implicit Updates for Average-Reward Temporal Difference Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> summarizes the result.
For small values of <math id="A4.SS3.p1.m7" class="ltx_Math" alttext="c_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>α</mi></msub><annotation encoding="application/x-tex">c_{\alpha}</annotation></semantics></math> (e.g., <math id="A4.SS3.p1.m8" class="ltx_Math" alttext="c_{\alpha}\leq 0.1" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>≤</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">c_{\alpha}\leq 0.1</annotation></semantics></math>), the average-reward implicit TD(<math id="A4.SS3.p1.m9" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) method exhibits a modest increase in the loss value. However, beyond this threshold, the method remains stable across the entire range of <math id="A4.SS3.p1.m10" class="ltx_Math" alttext="c_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>α</mi></msub><annotation encoding="application/x-tex">c_{\alpha}</annotation></semantics></math> values.</p>
</div>
<figure id="A4.F7" class="ltx_figure">

<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A4.F7.3" class="ltx_text" style="font-size:90%;">Figure 7</span>: </span><span id="A4.F7.4" class="ltx_text" style="font-size:90%;">Effect of the step-size ratio <math id="A4.F7.m4" class="ltx_Math" alttext="c_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>α</mi></msub><annotation encoding="application/x-tex">c_{\alpha}</annotation></semantics></math> in both the MRP and Boyan experiments under a decaying step-size schedule, with exponential weighting parameter <math id="A4.F7.m5" class="ltx_Math" alttext="\lambda=0.25" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0.25</mn></mrow><annotation encoding="application/x-tex">\lambda=0.25</annotation></semantics></math> and initial step-size <math id="A4.F7.m6" class="ltx_Math" alttext="\beta_{0}=1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>0</mn></msub><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\beta_{0}=1.0</annotation></semantics></math>. Solid lines denote mean values; shaded regions represent 95% confidence intervals. (Left) MRP  (Right) Boyan</span></figcaption><div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F7.fig1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06149v1/figure/MRP/cal_effect/MRP_lam0.25_alpha1.00_vs_cal_s_decay.png" id="A4.F7.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:476/417;" width="476" height="417" alt="Refer to caption">
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F7.fig2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06149v1/figure/Boyan/cal_effect/Boyan_lam0.25_alpha1.00_vs_cal_s_decay.png" id="A4.F7.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:476/417;" width="476" height="417" alt="Refer to caption">
</figure></div></div>
</figure>
</section>
</section>
