<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.F9.4" class="ltx_text" style="font-size:90%;">Figure 9</span>: </span><span id="A3.F9.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Ablation Study of Masking Strategies (A)<span id="A3.F9.5.1" class="ltx_text ltx_font_medium"> </span></span></figcaption>
</figure>
