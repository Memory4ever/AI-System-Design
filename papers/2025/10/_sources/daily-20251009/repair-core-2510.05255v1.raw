              <span id="alg1.l21.3" class="ltx_text" style="font-size:80%;">Compute gradient </span><math id="alg1.l21.m1" class="ltx_Math" alttext="g=\nabla_{\theta}\mathcal{L}_{\mathrm{tr}}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">g</mi><mo mathsize="0.800em">=</mo><mrow><mrow><msub><mo mathsize="0.800em" rspace="0.167em">∇</mo><mi mathsize="0.800em">θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℒ</mi><mi mathsize="0.800em">tr</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">θ</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g=\nabla_{\theta}\mathcal{L}_{\mathrm{tr}}(\theta)</annotation></semantics></math><span id="alg1.l21.4" class="ltx_text" style="font-size:80%;">; clip
</span><math id="alg1.l21.m2" class="ltx_Math" alttext="g\leftarrow g\cdot\min\!\big(1,c_{\max}/\|g\|\big)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">g</mi><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">g</mi><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">⋅</mo><mrow><mpadded style="width:1.693em;" width="1.693em"><mi mathsize="0.800em">min</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">,</mo><mrow><msub><mi mathsize="0.800em">c</mi><mi mathsize="0.800em">max</mi></msub><mo maxsize="0.800em" minsize="0.800em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">‖</mo><mi mathsize="0.800em">g</mi><mo maxsize="0.800em" minsize="0.800em" stretchy="true">‖</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g\leftarrow g\cdot\min\!\big(1,c_{\max}/\|g\|\big)</annotation></semantics></math><span id="alg1.l21.5" class="ltx_text" style="font-size:80%;">; perform a weight-decayed step
</span><math id="alg1.l21.m3" class="ltx_Math" alttext="\theta\leftarrow\theta-\gamma_{e}\,(g+\lambda\,\theta)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">θ</mi><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">θ</mi><mo mathsize="0.800em">−</mo><mrow><msub><mi mathsize="0.800em">γ</mi><mi mathsize="0.800em">e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">g</mi><mo mathsize="0.800em">+</mo><mrow><mi mathsize="0.800em">λ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathsize="0.800em">θ</mi></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\leftarrow\theta-\gamma_{e}\,(g+\lambda\,\theta)</annotation></semantics></math><span id="alg1.l21.6" class="ltx_text" style="font-size:80%;">.
</span>
</div>
