<td id="S4.T3.6.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S4.T3.6.1.2.9.1" class="ltx_text ltx_font_bold">MS<sup id="S4.T3.6.1.2.9.1.1" class="ltx_sup"><span id="S4.T3.6.1.2.9.1.1.1" class="ltx_text ltx_font_italic">3</span></sup>M Speedup (×)</span></td>
