<tr id="S3.T2.7.2" class="ltx_tr">
<th id="S3.T2.7.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.2.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Feature</span></th>
<th id="S3.T2.7.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.2.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Unit</span></th>
<th id="S3.T2.7.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 3.0pt;">
<span id="S3.T2.7.2.3.1" class="ltx_inline-block ltx_align_top" style="width:120.8pt;">
<span id="S3.T2.7.2.3.1.1" class="ltx_p"><span id="S3.T2.7.2.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Meaning</span></span>
</span></th>
<th id="S3.T2.7.2.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.2.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Min</span></th>
<th id="S3.T2.7.2.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.2.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Max</span></th>
<th id="S3.T2.7.2.6" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.2.6.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Mean</span></th>
<th id="S3.T2.7.2.7" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.2.7.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Std</span></th></tr>
<tr id="S3.T2.7.3" class="ltx_tr">
<td id="S3.T2.7.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.3.1.1" class="ltx_text" style="font-size:70%;">MCS</span></td>
<td id="S3.T2.7.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.3.2.1" class="ltx_text" style="font-size:70%;">index</span></td>
<td id="S3.T2.7.3.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding:0.5pt 3.0pt;">
<span id="S3.T2.7.3.3.1" class="ltx_inline-block ltx_align_top" style="width:120.8pt;">
<span id="S3.T2.7.3.3.1.1" class="ltx_p"><span id="S3.T2.7.3.3.1.1.1" class="ltx_text" style="font-size:70%;">Modulation and coding level chosen for transmission</span></span>
</span></td>
<td id="S3.T2.7.3.4" class="ltx_td ltx_align_right ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.3.4.1" class="ltx_text" style="font-size:70%;">0.00</span></td>
<td id="S3.T2.7.3.5" class="ltx_td ltx_align_right ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.3.5.1" class="ltx_text" style="font-size:70%;">26.67</span></td>
<td id="S3.T2.7.3.6" class="ltx_td ltx_align_right ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.3.6.1" class="ltx_text" style="font-size:70%;">9.06</span></td>
<td id="S3.T2.7.3.7" class="ltx_td ltx_align_right ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.3.7.1" class="ltx_text" style="font-size:70%;">4.94</span></td></tr>
<tr id="S3.T2.7.4" class="ltx_tr">
<td id="S3.T2.7.4.1" class="ltx_td ltx_align_left" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.4.1.1" class="ltx_text" style="font-size:70%;">CQI</span></td>
<td id="S3.T2.7.4.2" class="ltx_td ltx_align_center" style="padding:0.5pt 3.0pt;"><span id="S3.T2.7.4.2.1" class="ltx_text" style="font-size:70%;">index</span></td>
