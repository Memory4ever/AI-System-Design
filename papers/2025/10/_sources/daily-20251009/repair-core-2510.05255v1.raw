<td id="S2.T1.4.1.83.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="3"><em id="S2.T1.4.1.83.1.1" class="ltx_emph ltx_font_italic" style="font-size:70%;">Complexity variables (baselines &amp; analysis)</em></td></tr>
<tr id="S2.T1.4.1.84" class="ltx_tr">
<td id="S2.T1.4.1.84.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S2.T1.m145" class="ltx_Math" alttext="d_{h}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">d</mi><mi mathsize="0.700em">h</mi></msub><annotation encoding="application/x-tex">d_{h}</annotation></semantics></math></td>
