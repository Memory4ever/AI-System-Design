<th id="S5.T5.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Point</th>
<th id="S5.T5.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">95% CI (low)</th>
<th id="S5.T5.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">95% CI (high)</th></tr>
</thead>
<tbody class="ltx_tbody">
