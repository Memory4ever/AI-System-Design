              <span id="alg1.l20.3" class="ltx_text" style="font-size:80%;">Training loss on a batch </span><math id="alg1.l20.m1" class="ltx_Math" alttext="\mathcal{B}\subset\mathcal{I}_{\mathrm{tr}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℬ</mi><mo mathsize="0.800em">⊂</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℐ</mi><mi mathsize="0.800em">tr</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{B}\subset\mathcal{I}_{\mathrm{tr}}</annotation></semantics></math><span id="alg1.l20.4" class="ltx_text" style="font-size:80%;">:
</span><math id="alg1.l20.m2" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{tr}}(\theta)=\frac{1}{|\mathcal{B}|}\sum_{t\in\mathcal{B}}\|f_{\theta}(\widetilde{\mathbf{X}}_{t})-\widetilde{\mathbf{y}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℒ</mi><mi mathsize="0.800em">tr</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">θ</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo mathsize="0.800em">=</mo><mrow><mfrac><mn mathsize="0.800em">1</mn><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℬ</mi><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo maxsize="0.800em" minsize="0.800em" rspace="0em" stretchy="true">∑</mo><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℬ</mi></mrow></msub><msubsup><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">‖</mo><mrow><mrow><msub><mi mathsize="0.800em">f</mi><mi mathsize="0.800em">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mover accent="true"><mi mathsize="0.800em">𝐗</mi><mo>~</mo></mover><mi mathsize="0.800em">t</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo mathsize="0.800em">−</mo><msub><mover accent="true"><mi mathsize="0.800em">𝐲</mi><mo>~</mo></mover><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">1</mn></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">‖</mo></mrow><mn mathsize="0.800em">2</mn><mn mathsize="0.800em">2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{tr}}(\theta)=\frac{1}{|\mathcal{B}|}\sum_{t\in\mathcal{B}}\|f_{\theta}(\widetilde{\mathbf{X}}_{t})-\widetilde{\mathbf{y}}_{t+1}\|_{2}^{2}</annotation></semantics></math><span id="alg1.l20.5" class="ltx_text" style="font-size:80%;">.
</span>
</div>
<div id="alg1.l21" class="ltx_listingline">
