<td id="S2.T1.4.1.84.3" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S2.T1.m146" class="ltx_Math" alttext="\mathbb{Z}_{+}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">ℤ</mi><mo mathsize="0.700em">+</mo></msub><annotation encoding="application/x-tex">\mathbb{Z}_{+}</annotation></semantics></math></td></tr>
