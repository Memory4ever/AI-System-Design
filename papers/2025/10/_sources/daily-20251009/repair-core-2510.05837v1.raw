<td id="S4.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.8pt;padding-right:3.8pt;">
<table id="S4.T3.2.1.2.1" class="ltx_tabular ltx_align_middle">
