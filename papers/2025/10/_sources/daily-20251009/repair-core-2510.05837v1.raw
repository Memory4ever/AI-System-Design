</table></td>
<td id="S4.T3.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.8pt;padding-right:3.8pt;">
<table id="S4.T3.2.1.3.1" class="ltx_tabular ltx_align_middle">
<tr id="S4.T3.2.1.3.1.1" class="ltx_tr">
<td id="S4.T3.2.1.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.8pt;padding-right:3.8pt;"><span id="S4.T3.2.1.3.1.1.1.1" class="ltx_text ltx_font_bold">Olympiad</span></td></tr>
