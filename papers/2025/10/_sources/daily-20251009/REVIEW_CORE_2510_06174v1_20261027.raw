<td id="A7.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-bottom: 6.0pt;"><math id="A7.T1.m1" class="ltx_Math" alttext="H_{1,\mathrm{bpd}}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mrow><mn>1</mn><mo>,</mo><mi>bpd</mi></mrow></msub><annotation encoding="application/x-tex">H_{1,\mathrm{bpd}}</annotation></semantics></math></td>
<td id="A7.T1.2.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 6.0pt;">
<span id="A7.T1.2.2.2.1" class="ltx_inline-block ltx_align_top" style="width:172.5pt;">
<span id="A7.T1.2.2.2.1.1" class="ltx_p">Closed-form Gaussian entropy at <math id="A7.T1.m2" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math></span>
</span></td>
<td id="A7.T1.2.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-bottom: 6.0pt;">Exact</td></tr>
<tr id="A7.T1.2.3" class="ltx_tr">
<td id="A7.T1.2.3.1" class="ltx_td ltx_align_left" style="padding-bottom: 6.0pt;"><math id="A7.T1.m3" class="ltx_Math" alttext="I_{\theta,\mathrm{bpd}}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mrow><mi>θ</mi><mo>,</mo><mi>bpd</mi></mrow></msub><annotation encoding="application/x-tex">I_{\theta,\mathrm{bpd}}</annotation></semantics></math></td>
<td id="A7.T1.2.3.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-bottom: 6.0pt;">
<span id="A7.T1.2.3.2.1" class="ltx_inline-block ltx_align_top" style="width:172.5pt;">
<span id="A7.T1.2.3.2.1.1" class="ltx_p">Monte Carlo over <math id="A7.T1.m4" class="ltx_Math" alttext="(\mathbf{x}_{0},\mathbf{z})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{x}_{0},\mathbf{z})</annotation></semantics></math> + quadrature of <math id="A7.T1.m5" class="ltx_Math" alttext="\|\mathbf{s}_{\boldsymbol{\theta}}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐬</mi><mi>𝜽</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\|\mathbf{s}_{\boldsymbol{\theta}}\|^{2}</annotation></semantics></math></span>
</span></td>
<td id="A7.T1.2.3.3" class="ltx_td ltx_align_left" style="padding-bottom: 6.0pt;">Finite-batch; quadrature; model fit</td></tr>
<tr id="A7.T1.2.4" class="ltx_tr">
<td id="A7.T1.2.4.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-bottom: 6.0pt;"><math id="A7.T1.m6" class="ltx_Math" alttext="I_{\mathrm{diff},\mathrm{bpd}}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mrow><mi>diff</mi><mo>,</mo><mi>bpd</mi></mrow></msub><annotation encoding="application/x-tex">I_{\mathrm{diff},\mathrm{bpd}}</annotation></semantics></math></td>
