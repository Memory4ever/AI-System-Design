<td id="A3.T14.2.1.6.3" class="ltx_td ltx_align_left ltx_border_rr">X1 mouse button</td>
<td id="A3.T14.2.1.6.4" class="ltx_td ltx_align_left ltx_border_r">APPS</td>
<td id="A3.T14.2.1.6.5" class="ltx_td ltx_align_center ltx_border_r">93</td>
<td id="A3.T14.2.1.6.6" class="ltx_td ltx_align_left ltx_border_r">Applications key</td></tr>
<tr id="A3.T14.2.1.7" class="ltx_tr">
<th id="A3.T14.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r">XBUTTON2</th>
<th id="A3.T14.2.1.7.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">6</th>
<td id="A3.T14.2.1.7.3" class="ltx_td ltx_align_left ltx_border_rr">X2 mouse button</td>
<td id="A3.T14.2.1.7.4" class="ltx_td ltx_align_left ltx_border_r">NUMPAD0–9</td>
<td id="A3.T14.2.1.7.5" class="ltx_td ltx_align_center ltx_border_r">96–105</td>
<td id="A3.T14.2.1.7.6" class="ltx_td ltx_align_left ltx_border_r">Numpad 0–9</td></tr>
<tr id="A3.T14.2.1.8" class="ltx_tr">
<th id="A3.T14.2.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r">BACK</th>
<th id="A3.T14.2.1.8.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">8</th>
<td id="A3.T14.2.1.8.3" class="ltx_td ltx_align_left ltx_border_rr">Backspace key</td>
