<td id="S5.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="S5.T2.2.1.3.1" class="ltx_text ltx_font_bold">pythia-2.8b</span></td></tr>
<tr id="S5.T2.2.2" class="ltx_tr">
