<td id="S5.T2.2.2.3" class="ltx_td ltx_align_left"><span id="S5.T2.2.2.3.1" class="ltx_text ltx_font_bold">No</span></td>
<td id="S5.T2.2.2.4" class="ltx_td ltx_align_left"><span id="S5.T2.2.2.4.1" class="ltx_text ltx_font_bold">Embedding-space</span></td>
<td id="S5.T2.2.2.5" class="ltx_td ltx_align_left"><span id="S5.T2.2.2.5.1" class="ltx_text ltx_font_bold">No</span></td></tr>
<tr id="S5.T2.2.3" class="ltx_tr">
<td id="S5.T2.2.3.1" class="ltx_td ltx_align_left"><span id="S5.T2.2.3.1.1" class="ltx_text ltx_font_bold">Attack</span></td>
<td id="S5.T2.2.3.2" class="ltx_td ltx_align_left"><span id="S5.T2.2.3.2.1" class="ltx_text ltx_font_bold">clusters</span></td>
