<tr id="A4.T8.1.9" class="ltx_tr">
<td id="A4.T8.1.9.1" class="ltx_td ltx_align_left">CoLA</td>
<td id="A4.T8.1.9.2" class="ltx_td ltx_align_center"><span id="A4.T8.1.9.2.1" class="ltx_text ltx_font_bold">36.28</span></td>
