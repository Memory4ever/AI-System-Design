<td id="Sx4.T6.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="Sx4.T6.1.1.2.1" class="ltx_text ltx_font_bold">MMLU Avg.</span></td>
<td id="Sx4.T6.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="Sx4.T6.1.1.3.1" class="ltx_text ltx_font_bold">Params. (%)</span></td></tr>
