<td id="Sx4.T6.1.3.2" class="ltx_td ltx_align_center"><span id="Sx4.T6.1.3.2.1" class="ltx_text ltx_font_bold">59.62</span></td>
<td id="Sx4.T6.1.3.3" class="ltx_td ltx_align_center"><span id="Sx4.T6.1.3.3.1" class="ltx_text ltx_font_bold">0.522</span></td></tr>
