<td id="Sx4.T3.1.4.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx4.T3.1.4.3.1" class="ltx_text ltx_font_bold">0.5220</span></td>
<td id="Sx4.T3.1.4.4" class="ltx_td ltx_align_center ltx_border_bb">✓</td>
