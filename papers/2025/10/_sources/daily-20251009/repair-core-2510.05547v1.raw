<span id="S7.F3.pic1.2.2" class="ltx_p"><span id="S7.F3.pic1.2.2.1" class="ltx_text" style="font-size:70%;">Retrieve robotics knowledge</span></span>
</span></span></span></foreignObject></g><g style="--ltx-fill-color:#CCFFCC;" fill="#CCFFCC"><path d="M 38.45 -140.31 L -38.45 -140.31 C -41.5 -140.31 -43.98 -142.79 -43.98 -145.85 L -43.98 -169.11 C -43.98 -172.17 -41.5 -174.65 -38.45 -174.65 L 38.45 -174.65 C 41.5 -174.65 43.98 -172.17 43.98 -169.11 L 43.98 -145.85 C 43.98 -142.79 41.5 -140.31 38.45 -140.31 Z M -43.98 -174.65"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -39.37 -151.55)"><foreignObject style="--ltx-fo-width:7.14em;--ltx-fo-height:0.48em;--ltx-fo-depth:1.34em;font-size:10pt;" height="25.11" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="98.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S7.F3.pic1.3" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:7.14em;">
<span id="S7.F3.pic1.3.1" class="ltx_p"></span>
<span id="S7.F3.pic1.3.2" class="ltx_p"><span id="S7.F3.pic1.3.2.1" class="ltx_text" style="font-size:70%;">Generate scan plan</span></span>
</span></span></span></foreignObject></g><g style="--ltx-fill-color:#CCCCFF;" fill="#CCCCFF"><path d="M 38.45 -219 L -38.45 -219 C -41.5 -219 -43.98 -221.48 -43.98 -224.54 L -43.98 -247.9 C -43.98 -250.96 -41.5 -253.44 -38.45 -253.44 L 38.45 -253.44 C 41.5 -253.44 43.98 -250.96 43.98 -247.9 L 43.98 -224.54 C 43.98 -221.48 41.5 -219 38.45 -219 Z M -43.98 -253.44"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -39.37 -230.34)"><foreignObject style="--ltx-fo-width:7.14em;--ltx-fo-height:0.49em;--ltx-fo-depth:1.34em;font-size:10pt;" height="25.21" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="98.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
