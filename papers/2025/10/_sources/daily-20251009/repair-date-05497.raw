{"data":{"id":"10.48550/arxiv.2510.05497","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05497","prefix":"10.48550","suffix":"arxiv.2510.05497","identifiers":[{"identifier":"2510.05497","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.05497"}],"creators":[{"name":"Yu, Zhongkai","nameType":"Personal","givenName":"Zhongkai","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Guan, Yue","nameType":"Personal","givenName":"Yue","familyName":"Guan","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Zihao","nameType":"Personal","givenName":"Zihao","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Chenyang","nameType":"Personal","givenName":"Chenyang","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Zhengding","nameType":"Personal","givenName":"Zhengding","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Pei, Shuyi","nameType":"Personal","givenName":"Shuyi","familyName":"Pei","affiliation":[],"nameIdentifiers":[]},{"name":"Kang, Yangwook","nameType":"Personal","givenName":"Yangwook","familyName":"Kang","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Yufei","nameType":"Personal","givenName":"Yufei","familyName":"Ding","affiliation":[],"nameIdentifiers":[]},{"name":"Tsai, Po-An","nameType":"Personal","givenName":"Po-An","familyName":"Tsai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Patterns behind Chaos: Forecasting Data Movement for Efficient Large-Scale MoE LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T01:31:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:17:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-04T09:23:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-05T01:31:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-05T07:59:52Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-08T01:23:06Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-02T18:32:07Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-06T00:04:19Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-05-12T10:04:18Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-05-13T00:54:15Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large-scale Mixture of Experts (MoE) Large Language Models (LLMs) have recently become the frontier open-weight models, achieving remarkable model capability similar to proprietary ones. But their random expert selection mechanism introduces significant data movement overhead that becomes the dominant bottleneck in multi-unit LLM serving systems.\n To understand the patterns underlying this data movement, we conduct comprehensive data-movement-centric profiling across four state-of-the-art large-scale MoE models released in 2025 (200B-1000B) using over 24,000 requests spanning diverse workloads. We perform systematic analysis from both temporal and spatial perspectives and distill six key insights to guide the design of diverse serving systems. We verify these insights on both future wafer-scale GPU architectures and existing GPU systems. On wafer-scale GPUs, lightweight architectural modifications guided by our insights yield a 6.6$\\times$ average speedup across four 200B--1000B models. On existing GPU systems, our insights drive the design of a prefill-aware expert placement algorithm that achieves up to 1.25$\\times$ speedup on MoE computation. Our work presents the first comprehensive data-centric analysis of large-scale MoE models together with a concrete design study applying the learned lessons. Our profiling traces are publicly available at \\href{https://huggingface.co/datasets/core12345/MoE_expert_selection_trace}{\\textcolor{blue}{https://huggingface.co/datasets/core12345/MoE\\_expert\\_selection\\_trace}}.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.05497","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:50:14.000Z","registered":"2025-10-08T01:50:15.000Z","published":"2025","updated":"2026-05-13T02:57:35.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.05497","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}