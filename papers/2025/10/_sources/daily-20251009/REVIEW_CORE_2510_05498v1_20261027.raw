<p id="S3.T3.2.1" class="ltx_p"><span id="S3.T3.2.1.1" class="ltx_text">
<span id="S3.T3.2.1.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<span class="ltx_thead">
<span id="S3.T3.2.1.1.1.1" class="ltx_tr">
<span id="S3.T3.2.1.1.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt ltx_rowspan ltx_rowspan_2"><span id="S3.T3.2.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Dataset</span></span>
<span id="S3.T3.2.1.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt ltx_colspan ltx_colspan_3"><span id="S3.T3.2.1.1.1.1.2.1" class="ltx_text ltx_font_bold">Chain-of-Thought</span></span>
<span id="S3.T3.2.1.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt ltx_colspan ltx_colspan_3"><span id="S3.T3.2.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Neutral</span></span>
<span id="S3.T3.2.1.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt ltx_colspan ltx_colspan_3"><span id="S3.T3.2.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Anti-Chain-of-Thought</span></span></span>
<span id="S3.T3.2.1.1.1.2" class="ltx_tr">
<span id="S3.T3.2.1.1.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T3.2.1.1.1.2.1.1" class="ltx_text ltx_font_bold">No-Steering</span></span>
<span id="S3.T3.2.1.1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T3.2.1.1.1.2.2.1" class="ltx_text ltx_font_bold">DoM</span></span>
<span id="S3.T3.2.1.1.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S3.T3.2.1.1.1.2.3.1" class="ltx_text ltx_font_bold">PDS</span></span>
<span id="S3.T3.2.1.1.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T3.2.1.1.1.2.4.1" class="ltx_text ltx_font_bold">No-Steering</span></span>
