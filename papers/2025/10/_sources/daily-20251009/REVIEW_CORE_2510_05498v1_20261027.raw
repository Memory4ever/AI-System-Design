<th id="S3.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.1.2.2.1" class="ltx_text ltx_font_bold">DoM</span></th>
<th id="S3.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.1.2.3.1" class="ltx_text ltx_font_bold">PDS</span></th>
<th id="S3.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.1.2.4.1" class="ltx_text ltx_font_bold">Baseline</span></th>
<th id="S3.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.1.2.5.1" class="ltx_text ltx_font_bold">DoM</span></th>
<th id="S3.T1.2.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.1.2.6.1" class="ltx_text ltx_font_bold">PDS</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.2.1.3" class="ltx_tr">
<th id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">CoT</th>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">71%</td>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">75%</td>
<td id="S3.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.1.3.4.1" class="ltx_text ltx_font_bold">78%</span></td>
<td id="S3.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">49%</td>
<td id="S3.T1.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">50%</td>
<td id="S3.T1.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.1.3.7.1" class="ltx_text ltx_font_bold">53%</span></td></tr>
