<th id="A4.F5.2.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right ltx_th ltx_th_row" style="padding-bottom: -1.42262pt;padding-left:1.0pt;padding-right:1.0pt;"><span id="A4.F5.2.4.1.1" class="ltx_text" style="position:relative; bottom:8.5pt;--ltx-fg-color:#E69F00;">NoiseDiff</span></th>
<td id="A4.F5.2.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: -1.42262pt;padding-left:1.0pt;padding-right:1.0pt;"><img src="2510.05509v1/assets/imgs/img_interp_compressed/chair_noisediff.jpg" id="A4.F5.g4" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:432/33;" width="432" height="33" alt="Refer to caption"></td></tr>
<tr id="A4.F5.2.5" class="ltx_tr">
<th id="A4.F5.2.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right ltx_th ltx_th_row" style="padding-bottom: -1.42262pt;padding-left:1.0pt;padding-right:1.0pt;"><span id="A4.F5.2.5.1.1" class="ltx_text" style="position:relative; bottom:8.5pt;--ltx-fg-color:#D55E00;">GeoDiff</span></th>
