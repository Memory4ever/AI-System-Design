<td id="A4.F5.2.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: -1.42262pt;padding-left:1.0pt;padding-right:1.0pt;"><img src="2510.05509v1/assets/imgs/img_interp_compressed/chair_nao.jpg" id="A4.F5.g3" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:432/33;" width="432" height="33" alt="Refer to caption"></td></tr>
