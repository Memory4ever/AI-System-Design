<span id="A6.I24.i3.p1.1" class="ltx_p"><span id="A6.I24.i3.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Command:</span></span>
</span>
<span id="A6.I24.i3.p2" class="ltx_para ltx_noindent">
<span id="A6.I24.i3.p2.1" class="ltx_p"><span id="A6.I24.i3.p2.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">tool.execute(query="Tropicos ID for the Order Helotiales")</span></span>
