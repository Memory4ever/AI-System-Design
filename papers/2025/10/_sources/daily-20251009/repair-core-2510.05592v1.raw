</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.07 49.86)"><foreignObject style="--ltx-fo-width:36.7em;--ltx-fo-height:141.8em;--ltx-fo-depth:2.65em;font-size:10pt;" height="1998.78" overflow="visible" transform="matrix(1 0 0 -1 0 1962.11)" width="507.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A6.SS2.p3.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.7em;">
<span id="A6.SS2.p3.pic1.2.1" class="ltx_p"><span id="A6.SS2.p3.pic1.2.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Action Step 1: Initial Attempt<span id="A6.SS2.p3.pic1.2.1.1.1" class="ltx_text"></span></span></span>
<span id="A6.I5" class="ltx_itemize ltx_leftmargin_flush">
<span id="A6.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
