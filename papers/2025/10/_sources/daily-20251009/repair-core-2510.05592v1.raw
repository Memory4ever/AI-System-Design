<th id="S4.T3.2.1.2.8" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">31.0</th>
<th id="S4.T3.2.1.2.9" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">38.5</th></tr>
</thead>
<tbody class="ltx_tbody">
