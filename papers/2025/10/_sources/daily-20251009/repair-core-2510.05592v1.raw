<span id="A6.I24.i1.p1.1" class="ltx_p"><span id="A6.I24.i1.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Tool:</span><span id="A6.I24.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A6.I24.i1.p1.1.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">Wikipedia Search</span></span>
