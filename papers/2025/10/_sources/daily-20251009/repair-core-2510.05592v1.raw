<th id="S4.T3.2.1.1.7" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.2.1.1.7.1" class="ltx_text ltx_font_bold">AMC23</span></th>
<th id="S4.T3.2.1.1.8" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.2.1.1.8.1" class="ltx_text ltx_font_bold">GameOf24</span></th>
<th id="S4.T3.2.1.1.9" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.2.1.1.9.1" class="ltx_text ltx_font_bold">Avg.</span></th></tr>
<tr id="S4.T3.2.1.2" class="ltx_tr">
<th id="S4.T3.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">Qwen-2.5-7B</th>
<th id="S4.T3.2.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">Frozen</th>
<th id="S4.T3.2.1.2.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">58.4</th>
<th id="S4.T3.2.1.2.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">60.0</th>
<th id="S4.T3.2.1.2.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">17.2</th>
