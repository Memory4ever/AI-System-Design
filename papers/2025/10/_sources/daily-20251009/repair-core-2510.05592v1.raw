</span>
<span id="A5.I24.i3.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A5.I24.i3.p2.pic1" class="ltx_picture" color="#000000" height="8.61" overflow="visible" version="1.1" viewBox="0 0 525.52 8.61" width="525.52"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,8.61) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#F0F8FF;" fill="#F0F8FF" fill-opacity="1.0"><path style="stroke:none" d="M 0 1.38 L 0 7.23 C 0 7.99 0.62 8.61 1.38 8.61 L 524.14 8.61 C 524.9 8.61 525.52 7.99 525.52 7.23 L 525.52 1.38 C 525.52 0.62 524.9 0 524.14 0 L 1.38 0 C 0.62 0 0 0.62 0 1.38 Z"></path></g><g style="--ltx-fill-color:#F0F8FF;" fill="#F0F8FF" fill-opacity="1.0"><path style="stroke:none" d="M 0 1.38 L 0 7.23 C 0 7.99 0.62 8.61 1.38 8.61 L 524.14 8.61 C 524.9 8.61 525.52 7.99 525.52 7.23 L 525.52 1.38 C 525.52 0.62 524.9 0 524.14 0 L 1.38 0 C 0.62 0 0 0.62 0 1.38 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 4.15 3.07)"><foreignObject style="--ltx-fo-width:35.6em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.22em;font-size:10pt;" height="12.76" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="492.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
