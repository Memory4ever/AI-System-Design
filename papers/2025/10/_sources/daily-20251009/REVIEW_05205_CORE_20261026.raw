<td id="A4.T5.3.2.5" class="ltx_td ltx_align_center ltx_border_t">1D</td>
<td id="A4.T5.3.2.6" class="ltx_td ltx_align_center ltx_border_t">GMNIST</td>
<td id="A4.T5.3.2.7" class="ltx_td ltx_align_center ltx_border_t">Galaxy</td></tr>
<tr id="A4.T5.3.3" class="ltx_tr">
<th id="A4.T5.3.3.1" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row">
<span id="A4.T5.3.3.1.1" class="ltx_inline-block ltx_align_middle" style="width:100.0pt;">
<span id="A4.T5.3.3.1.1.1" class="ltx_p">Method</span>
</span></th>
<td id="A4.T5.3.3.2" class="ltx_td ltx_align_center">Manifold</td>
<td id="A4.T5.3.3.3" class="ltx_td ltx_align_center">Full Res.</td>
<td id="A4.T5.3.3.4" class="ltx_td ltx_align_center ltx_border_r">Images</td>
<td id="A4.T5.3.3.5" class="ltx_td ltx_align_center">Manifold</td>
<td id="A4.T5.3.3.6" class="ltx_td ltx_align_center">Full Res.</td>
<td id="A4.T5.3.3.7" class="ltx_td ltx_align_center">Images</td></tr>
<tr id="A4.T5.3.4" class="ltx_tr">
<th id="A4.T5.3.4.1" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row ltx_border_tt">
<span id="A4.T5.3.4.1.1" class="ltx_inline-block ltx_align_middle" style="width:100.0pt;">
<span id="A4.T5.3.4.1.1.1" class="ltx_p">PCPCA <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx29" title="" class="ltx_ref">29</a>]</cite></span>
</span></th>
<td id="A4.T5.3.4.2" class="ltx_td ltx_align_center ltx_border_tt">5 s</td>
<td id="A4.T5.3.4.3" class="ltx_td ltx_align_center ltx_border_tt">1 m</td>
<td id="A4.T5.3.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">–</td>
<td id="A4.T5.3.4.5" class="ltx_td ltx_align_center ltx_border_tt"><math id="A4.T5.m1" class="ltx_Math" alttext="&lt;" display="inline" intent=":literal"><semantics><mo>&lt;</mo><annotation encoding="application/x-tex">&lt;</annotation></semantics></math> 0.1 ms</td>
<td id="A4.T5.3.4.6" class="ltx_td ltx_align_center ltx_border_tt">1.5 ms</td>
<td id="A4.T5.3.4.7" class="ltx_td ltx_align_center ltx_border_tt">–</td></tr>
<tr id="A4.T5.3.5" class="ltx_tr">
<th id="A4.T5.3.5.1" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row">
<span id="A4.T5.3.5.1.1" class="ltx_inline-block ltx_align_middle" style="width:100.0pt;">
<span id="A4.T5.3.5.1.1.1" class="ltx_p ltx_align_left">CLVM - Linear <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">28</a>]</cite></span>
</span></th>
<td id="A4.T5.3.5.2" class="ltx_td ltx_align_center">1.5 m</td>
<td id="A4.T5.3.5.3" class="ltx_td ltx_align_center">10 m</td>
