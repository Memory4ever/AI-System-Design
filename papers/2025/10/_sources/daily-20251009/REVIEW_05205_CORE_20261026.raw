<th id="A4.T5.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3">Inference Time / Sample</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T5.3.2" class="ltx_tr">
<th id="A4.T5.3.2.1" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row"></th>
<td id="A4.T5.3.2.2" class="ltx_td ltx_align_center ltx_border_t">1D</td>
