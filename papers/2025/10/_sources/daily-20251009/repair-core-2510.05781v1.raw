<td id="S4.T5.2.1.1.3" class="ltx_td ltx_align_right ltx_border_tt">MoNE</td></tr>
<tr id="S4.T5.2.1.2" class="ltx_tr">
<td id="S4.T5.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t" colspan="3"><span id="S4.T5.2.1.2.1.1" class="ltx_text ltx_font_bold">Configuration</span></td></tr>
<tr id="S4.T5.2.1.3" class="ltx_tr">
