<td id="A1.T6.4.1.1.9" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.2pt;padding-right:3.2pt;" rowspan="2"><span id="A1.T6.4.1.1.9.1" class="ltx_text"># <math id="A1.T6.m1" class="ltx_Math" alttext="\text{N}_{k}" display="inline" intent=":literal"><semantics><msub><mtext>N</mtext><mi>k</mi></msub><annotation encoding="application/x-tex">\text{N}_{k}</annotation></semantics></math>/<math id="A1.T6.m2" class="ltx_Math" alttext="d_{\mathrm{model}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>model</mi></msub><annotation encoding="application/x-tex">d_{\mathrm{model}}</annotation></semantics></math></span></td></tr>
<tr id="A1.T6.4.1.2" class="ltx_tr">
<td id="A1.T6.4.1.2.1" class="ltx_td ltx_align_center" style="padding-left:3.2pt;padding-right:3.2pt;">Size</td>
<td id="A1.T6.4.1.2.2" class="ltx_td ltx_align_center" style="padding-left:3.2pt;padding-right:3.2pt;">Size</td>
