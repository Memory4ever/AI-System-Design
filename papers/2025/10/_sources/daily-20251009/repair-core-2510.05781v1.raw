<tr id="A1.T6.4.1.3" class="ltx_tr">
<td id="A1.T6.4.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;">Traditional MoE <span id="A1.T6.4.1.3.1.1" class="ltx_text" style="--ltx-fg-color:#808080;">290M/925M</span></td>
<td id="A1.T6.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;">12</td>
