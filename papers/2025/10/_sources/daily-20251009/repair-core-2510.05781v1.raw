<td id="S4.T5.2.1.4.3" class="ltx_td ltx_align_right">1024</td></tr>
<tr id="S4.T5.2.1.5" class="ltx_tr">
<td id="S4.T5.2.1.5.1" class="ltx_td ltx_align_left">New tokens</td>
<td id="S4.T5.2.1.5.2" class="ltx_td ltx_align_right">128</td>
