<div id="A2.SS2.p22" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS2.p22.pic1" class="ltx_picture" height="212.86" overflow="visible" version="1.1" viewBox="0 0 477.38 212.86" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,212.86) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D9999;" fill="#3D9999" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 206.96 C 0 210.22 2.64 212.86 5.91 212.86 L 471.47 212.86 C 474.73 212.86 477.38 210.22 477.38 206.96 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2FFFF;" fill="#F2FFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 187.21 L 475.41 187.21 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 196.58)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
