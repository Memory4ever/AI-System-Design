<td id="A2.T5.2.8.1" class="ltx_td ltx_align_left">   Learning Rate</td>
<td id="A2.T5.2.8.2" class="ltx_td ltx_align_left"><math id="A2.T5.m3" class="ltx_Math" alttext="5\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5\times 10^{-4}</annotation></semantics></math></td></tr>
