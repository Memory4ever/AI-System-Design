<td id="S4.T4.2.5.2" class="ltx_td ltx_align_right">72.2</td>
<td id="S4.T4.2.5.3" class="ltx_td ltx_align_right">77.1</td>
<td id="S4.T4.2.5.4" class="ltx_td ltx_align_right">4.9</td></tr>
<tr id="S4.T4.2.6" class="ltx_tr">
<td id="S4.T4.2.6.1" class="ltx_td ltx_align_left">Qwen2.5 3B</td>
<td id="S4.T4.2.6.2" class="ltx_td ltx_align_right">47.8</td>
<td id="S4.T4.2.6.3" class="ltx_td ltx_align_right">50.6</td>
<td id="S4.T4.2.6.4" class="ltx_td ltx_align_right">2.8</td></tr>
<tr id="S4.T4.2.7" class="ltx_tr">
<td id="S4.T4.2.7.1" class="ltx_td ltx_align_left">Qwen2.5 72B</td>
<td id="S4.T4.2.7.2" class="ltx_td ltx_align_right">81.7</td>
<td id="S4.T4.2.7.3" class="ltx_td ltx_align_right">81.8</td>
<td id="S4.T4.2.7.4" class="ltx_td ltx_align_right">0.1</td></tr>
<tr id="S4.T4.2.8" class="ltx_tr">
<td id="S4.T4.2.8.1" class="ltx_td ltx_align_left">Qwen2.5 7B</td>
<td id="S4.T4.2.8.2" class="ltx_td ltx_align_right">63.5</td>
<td id="S4.T4.2.8.3" class="ltx_td ltx_align_right">72.2</td>
<td id="S4.T4.2.8.4" class="ltx_td ltx_align_right">8.7</td></tr>
<tr id="S4.T4.2.9" class="ltx_tr">
<td id="S4.T4.2.9.1" class="ltx_td ltx_align_left">GPT-4o-mini</td>
<td id="S4.T4.2.9.2" class="ltx_td ltx_align_right">71.4</td>
<td id="S4.T4.2.9.3" class="ltx_td ltx_align_right">76.9</td>
<td id="S4.T4.2.9.4" class="ltx_td ltx_align_right">5.5</td></tr>
<tr id="S4.T4.2.10" class="ltx_tr">
<td id="S4.T4.2.10.1" class="ltx_td ltx_align_left">GPT-5-nano</td>
<td id="S4.T4.2.10.2" class="ltx_td ltx_align_right">83.5</td>
