</table></td>
<td id="S7.T9.4.1.4.5" class="ltx_td ltx_align_center ltx_border_r">
<table id="S7.T9.4.1.4.5.1" class="ltx_tabular ltx_align_middle">
<tr id="S7.T9.4.1.4.5.1.1" class="ltx_tr">
<td id="S7.T9.4.1.4.5.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S7.T9.4.1.4.5.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000080;">6.61</span> / <span id="S7.T9.4.1.4.5.1.1.1.2" class="ltx_text" style="--ltx-fg-color:#800000;">32.22</span></td></tr>
</table></td>
<td id="S7.T9.4.1.4.6" class="ltx_td ltx_align_center">
