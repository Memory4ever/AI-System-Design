<section id="A6.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Update for <math id="A6.SS0.SSS0.Px1.m1" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math>.</h4>

<div id="A6.SS0.SSS0.Px1.p1" class="ltx_para">
<table id="A6.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex40.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial}{\partial\mathbf{A}}=-2\mathbf{B}\mathbf{M}\mathbf{W}^{\top}+2\mathbf{A}\mathbf{B}\mathbf{M}\mathbf{B}^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>𝐀</mi></mrow></mfrac></mstyle><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁𝐌𝐖</mi><mo>⊤</mo></msup></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀𝐁𝐌𝐁</mi><mo>⊤</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial}{\partial\mathbf{A}}=-2\mathbf{B}\mathbf{M}\mathbf{W}^{\top}+2\mathbf{A}\mathbf{B}\mathbf{M}\mathbf{B}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS0.SSS0.Px1.p1.1" class="ltx_p">Setting to zero:</p>
<table id="A6.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex41.m1" class="ltx_Math" alttext="\displaystyle\mathbf{A}=\mathbf{W}\mathbf{M}\mathbf{B}^{\top}(\mathbf{B}\mathbf{M}\mathbf{B}^{\top})^{\dagger}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐀</mi><mo>=</mo><mrow><msup><mi>𝐖𝐌𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐁𝐌𝐁</mi><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{A}=\mathbf{W}\mathbf{M}\mathbf{B}^{\top}(\mathbf{B}\mathbf{M}\mathbf{B}^{\top})^{\dagger}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A6.SS0.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Update for <math id="A6.SS0.SSS0.Px2.m1" class="ltx_Math" alttext="\mathbf{B}" display="inline" intent=":literal"><semantics><mi>𝐁</mi><annotation encoding="application/x-tex">\mathbf{B}</annotation></semantics></math>.</h4>

