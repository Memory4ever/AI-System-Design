<tbody class="ltx_tbody">
<tr id="S5.T3.2.3" class="ltx_tr">
<th id="S5.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">LLaMA-2-7B</th>
