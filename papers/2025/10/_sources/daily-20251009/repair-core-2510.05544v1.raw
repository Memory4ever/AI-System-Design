<th id="S5.T3.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T3.2.1.2.1" class="ltx_text ltx_font_bold">Methods</span></th>
<th id="S5.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.75pt;padding-bottom:0.75pt;" colspan="3"><span id="S5.T3.2.1.3.1" class="ltx_text ltx_font_bold">Compression</span></th></tr>
<tr id="S5.T3.2.2" class="ltx_tr">
<th id="S5.T3.2.2.1" class="ltx_td ltx_th ltx_th_row" style="padding-top:0.75pt;padding-bottom:0.75pt;"></th>
<th id="S5.T3.2.2.2" class="ltx_td ltx_th ltx_th_column ltx_th_row" style="padding-top:0.75pt;padding-bottom:0.75pt;"></th>
