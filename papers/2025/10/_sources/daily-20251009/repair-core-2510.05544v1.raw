<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex42.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial}{\partial\mathbf{B}}=-2\mathbf{A}^{\top}\mathbf{W}\mathbf{M}+2\mathbf{A}^{\top}\mathbf{A}\mathbf{B}\mathbf{M}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>𝐁</mi></mrow></mfrac></mstyle><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐖𝐌</mi></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀𝐁𝐌</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial}{\partial\mathbf{B}}=-2\mathbf{A}^{\top}\mathbf{W}\mathbf{M}+2\mathbf{A}^{\top}\mathbf{A}\mathbf{B}\mathbf{M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS0.SSS0.Px2.p1.1" class="ltx_p">Setting to zero:</p>
