<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex43.m1" class="ltx_Math" alttext="\displaystyle\mathbf{B}=(\mathbf{A}^{\top}\mathbf{A})^{\dagger}\mathbf{A}^{\top}\mathbf{W}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐁</mi><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{B}=(\mathbf{A}^{\top}\mathbf{A})^{\dagger}\mathbf{A}^{\top}\mathbf{W}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
