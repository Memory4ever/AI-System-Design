<span id="lstnumberx13" class="ltx_listingline"><span id="lstnumberx13.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">total_capacity</span><span id="lstnumberx13.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx13.3" class="ltx_text ltx_font_typewriter">=</span><span id="lstnumberx13.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx13.5" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter ltx_font_bold">sum</span><span id="lstnumberx13.6" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx13.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">row</span><span id="lstnumberx13.8" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx13.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">capacity_index</span><span id="lstnumberx13.10" class="ltx_text ltx_font_typewriter">]</span><span id="lstnumberx13.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx13.12" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">for</span><span id="lstnumberx13.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx13.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">row</span><span id="lstnumberx13.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx13.16" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">in</span><span id="lstnumberx13.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx13.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">table</span><span id="lstnumberx13.19" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx13.20" class="ltx_text ltx_lst_string ltx_font_typewriter">"data"</span><span id="lstnumberx13.21" class="ltx_text ltx_font_typewriter">])</span>
</span>
<span id="lstnumberx14" class="ltx_listingline">
</span>
