<td id="S5.T2.6.1.11.18" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#FFF2B2;padding:0.6pt 3.0pt;"><span id="S5.T2.6.1.11.18.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF2B2;">74.9</span></td>
<td id="S5.T2.6.1.11.19" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#FFF2B2;padding:0.6pt 3.0pt;"><span id="S5.T2.6.1.11.19.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF2B2;">25.1</span></td>
<td id="S5.T2.6.1.11.20" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#FFF2B2;padding:0.6pt 3.0pt;"><span id="S5.T2.6.1.11.20.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF2B2;">27.2</span></td>
