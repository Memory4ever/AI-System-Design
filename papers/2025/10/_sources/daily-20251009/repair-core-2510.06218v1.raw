<div id="S4.T5.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:314.5pt;height:58.8pt;vertical-align:-27.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-39.3pt,7.4pt) scale(0.8,0.8) ;">
