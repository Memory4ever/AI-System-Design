<div id="lstnumberx33" class="ltx_listingline"><span id="lstnumberx33.1" class="ltx_text ltx_font_italic">-</span><span id="lstnumberx33.2" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx33.3" class="ltx_text ltx_font_italic">1.0</span><span id="lstnumberx33.4" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx33.5" class="ltx_text ltx_font_italic">=</span><span id="lstnumberx33.6" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx33.7" class="ltx_text ltx_lst_identifier ltx_font_italic">Identical</span><span id="lstnumberx33.8" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx33.9" class="ltx_text ltx_lst_identifier ltx_font_italic">or</span><span id="lstnumberx33.10" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx33.11" class="ltx_text ltx_lst_identifier ltx_font_italic">nearly</span><span id="lstnumberx33.12" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx33.13" class="ltx_text ltx_lst_identifier ltx_font_italic">identical</span><span id="lstnumberx33.14" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx33.15" class="ltx_text ltx_lst_identifier ltx_font_italic">scenes</span><span id="lstnumberx33.16" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx33.17" class="ltx_text ltx_font_italic">(</span><span id="lstnumberx33.18" class="ltx_text ltx_lst_identifier ltx_font_italic">same</span><span id="lstnumberx33.19" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx33.20" class="ltx_text ltx_lst_identifier ltx_font_italic">room</span><span id="lstnumberx33.21" class="ltx_text ltx_font_italic">/</span><span id="lstnumberx33.22" class="ltx_text ltx_lst_identifier ltx_font_italic">location</span><span id="lstnumberx33.23" class="ltx_text ltx_font_italic">)</span>
</div>
<div id="lstnumberx34" class="ltx_listingline"><span id="lstnumberx34.1" class="ltx_text ltx_font_italic">-</span><span id="lstnumberx34.2" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx34.3" class="ltx_text ltx_lst_identifier ltx_font_italic">Values</span><span id="lstnumberx34.4" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx34.5" class="ltx_text ltx_lst_identifier ltx_font_italic">in</span><span id="lstnumberx34.6" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx34.7" class="ltx_text ltx_lst_identifier ltx_font_italic">between</span><span id="lstnumberx34.8" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx34.9" class="ltx_text ltx_lst_identifier ltx_font_italic">represent</span><span id="lstnumberx34.10" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx34.11" class="ltx_text ltx_lst_identifier ltx_font_italic">varying</span><span id="lstnumberx34.12" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx34.13" class="ltx_text ltx_lst_identifier ltx_font_italic">degrees</span><span id="lstnumberx34.14" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx34.15" class="ltx_text ltx_lst_identifier ltx_font_italic">of</span><span id="lstnumberx34.16" class="ltx_text ltx_lst_space ltx_font_italic"> </span><span id="lstnumberx34.17" class="ltx_text ltx_lst_identifier ltx_font_italic">similarity</span>
</div>
