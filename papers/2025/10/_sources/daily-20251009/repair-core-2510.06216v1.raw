<td id="S4.T6.6.1.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T6.6.1.6.2.1" class="ltx_text ltx_font_bold">3.477</span></td>
<td id="S4.T6.6.1.6.3" class="ltx_td ltx_align_center ltx_border_bb">0.0648</td>
