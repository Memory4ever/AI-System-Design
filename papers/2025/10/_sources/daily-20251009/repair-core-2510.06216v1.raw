<th id="S4.T6.6.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">VideoDepthAnything <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite></th>
<td id="S4.T6.6.1.4.2" class="ltx_td ltx_align_center">4.865</td>
<td id="S4.T6.6.1.4.3" class="ltx_td ltx_align_center">0.0896</td>
<td id="S4.T6.6.1.4.4" class="ltx_td ltx_align_center">0.427</td>
