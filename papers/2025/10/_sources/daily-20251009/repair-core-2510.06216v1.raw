<div id="S4.T6.6" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:46.6pt;vertical-align:-21.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-98.1pt,13.3pt) scale(0.637383692216954,0.637383692216954) ;">
