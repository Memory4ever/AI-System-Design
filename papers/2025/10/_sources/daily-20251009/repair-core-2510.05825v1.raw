<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span>AIME 2024 (Llama3.2-1B)</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A4.F20.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.05825v1/eval_ablation_aime-2025_1B_20250909.svg" id="A4.F20.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/419;" width="548" height="419"></object>
