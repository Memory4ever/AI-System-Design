<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Additional Experiments</h2>

<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>General Results on Mathematical Benchmarks</h3>

<figure id="A4.F14" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F14.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.05825v1/eval_benchmark_gsm8k_1.5B_20250820.svg" id="A4.F14.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/425;" width="548" height="425"></object>
