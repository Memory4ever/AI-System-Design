            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
          <math id="alg3.l6.m1" class="ltx_Math" alttext="\mathbf{z}_{1}\sim p(\mathbf{z}_{1}|\mathbf{c})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mn>1</mn></msub><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐜</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{1}\sim p(\mathbf{z}_{1}|\mathbf{c})</annotation></semantics></math> <span id="alg3.l6.2" class="ltx_text" style="float:right;"><math id="alg3.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Sample initial step
</span>
</div>
