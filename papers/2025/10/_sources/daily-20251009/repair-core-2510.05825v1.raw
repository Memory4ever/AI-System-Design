            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
          <math id="alg3.l7.m1" class="ltx_Math" alttext="w_{1}\leftarrow 1/N" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>1</mn></msub><mo stretchy="false">←</mo><mrow><mn>1</mn><mo>/</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">w_{1}\leftarrow 1/N</annotation></semantics></math> <span id="alg3.l7.2" class="ltx_text" style="float:right;"><math id="alg3.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initialize weights
</span>
</div>
