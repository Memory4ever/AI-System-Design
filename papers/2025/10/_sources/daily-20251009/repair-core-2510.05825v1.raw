<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Particle Filtering with Entropic Annealing (<span id="alg2.5" class="ltx_text ltx_font_typewriter">ePF</span>)</figcaption>
<div id="alg2.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          
</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          <math id="alg2.l2.m1" class="ltx_Math" alttext="\mathbf{c}" display="inline" intent=":literal"><semantics><mi>𝐜</mi><annotation encoding="application/x-tex">\mathbf{c}</annotation></semantics></math>, <math id="alg2.l2.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, <math id="alg2.l2.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, <math id="alg2.l2.m4" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> <span id="alg2.l2.2" class="ltx_text" style="float:right;"><math id="alg2.l2.m5" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Task Input; Particle Budget; Steps; Threshold
</span>
</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          <math id="alg2.l3.m1" class="ltx_Math" alttext="p(\mathbf{z}_{t}|\mathbf{z}_{t-1},\mathbf{c})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐜</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(\mathbf{z}_{t}|\mathbf{z}_{t-1},\mathbf{c})</annotation></semantics></math> <span id="alg2.l3.2" class="ltx_text" style="float:right;"><math id="alg2.l3.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Sampling/Dynamics Model
</span>
</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
          <math id="alg2.l4.m1" class="ltx_Math" alttext="p(\mathbf{o}_{t}|\mathbf{z}_{t},\mathbf{c})=\delta(s-g(\mathbf{z}_{t},\mathbf{c}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐨</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐳</mi><mi>t</mi></msub><mo>,</mo><mi>𝐜</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo>,</mo><mi>𝐜</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p(\mathbf{o}_{t}|\mathbf{z}_{t},\mathbf{c})=\delta(s-g(\mathbf{z}_{t},\mathbf{c}))</annotation></semantics></math> <span id="alg2.l4.2" class="ltx_text" style="float:right;"><math id="alg2.l4.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Reward/Observation Model
</span>
</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
          
</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
          <math id="alg2.l6.m1" class="ltx_Math" alttext="\mathbf{z}_{1}\sim p(\mathbf{z}_{1}|\mathbf{c})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mn>1</mn></msub><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐜</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{1}\sim p(\mathbf{z}_{1}|\mathbf{c})</annotation></semantics></math> <span id="alg2.l6.2" class="ltx_text" style="float:right;"><math id="alg2.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Sample initial step
</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
          <math id="alg2.l7.m1" class="ltx_Math" alttext="w_{1}\leftarrow 1/N" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>1</mn></msub><mo stretchy="false">←</mo><mrow><mn>1</mn><mo>/</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">w_{1}\leftarrow 1/N</annotation></semantics></math> <span id="alg2.l7.2" class="ltx_text" style="float:right;"><math id="alg2.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initialize weights
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
          <math id="alg2.l8.m1" class="ltx_Math" alttext="\mathcal{P}=\{(\mathbf{z}^{i}_{1},w^{i}_{1})\}^{N}_{i=1}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mn>1</mn><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>w</mi><mn>1</mn><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{P}=\{(\mathbf{z}^{i}_{1},w^{i}_{1})\}^{N}_{i=1}</annotation></semantics></math> <span id="alg2.l8.2" class="ltx_text" style="float:right;"><math id="alg2.l8.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initialize Particles
</span>
</div>
<div id="alg2.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
          <span id="alg2.l9.2" class="ltx_text ltx_font_bold">for</span> step <math id="alg2.l9.m1" class="ltx_Math" alttext="t=2" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">t=2</annotation></semantics></math> to <math id="alg2.l9.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> <span id="alg2.l9.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
            <span id="alg2.l10.2" class="ltx_text ltx_font_bold">for</span> particle <math id="alg2.l10.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> to <math id="alg2.l10.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> <span id="alg2.l10.3" class="ltx_text ltx_font_bold">do</span> <span id="alg2.l10.4" class="ltx_text" style="float:right;"><math id="alg2.l10.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> State Estimation step <math id="alg2.l10.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>
</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
             <math id="alg2.l11.m1" class="ltx_Math" alttext="\mathbf{z}^{i}_{t}\sim p(\mathbf{z}_{t}|\mathbf{z}_{t-1},\mathbf{c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mi>t</mi><mi>i</mi></msubsup><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝐜</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}^{i}_{t}\sim p(\mathbf{z}_{t}|\mathbf{z}_{t-1},\mathbf{c})</annotation></semantics></math> <span id="alg2.l11.2" class="ltx_text" style="float:right;"><math id="alg2.l11.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Propagation
</span>
</div>
<div id="alg2.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
            
             <math id="alg2.l12.m1" class="ltx_math_unparsed" alttext="s^{i}_{t}\leftarrow g(\mathbf{z}^{i}_{t:T},\mathbf{c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">←</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mi>i</mi></msubsup><mo>,</mo><mi>𝐜</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s^{i}_{t}\leftarrow g(\mathbf{z}^{i}_{t:T},\mathbf{c})</annotation></semantics></math> <span id="alg2.l12.2" class="ltx_text" style="float:right;"><math id="alg2.l12.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Scoring
</span>
</div>
<div id="alg2.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">13:</span>
            
            
             <math id="alg2.l13.m1" class="ltx_Math" alttext="r^{i}_{t}\leftarrow\log s^{i}_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">←</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mi>s</mi><mi>t</mi><mi>i</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">r^{i}_{t}\leftarrow\log s^{i}_{t}</annotation></semantics></math>

</div>
<div id="alg2.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            
            <span id="alg2.l14.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l14.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">15:</span>
            
            
            <math id="alg2.l15.m1" class="ltx_math_unparsed" alttext="w^{i}_{t}\leftarrow\exp(r^{i}_{t})/\sum^{N}_{j=1}\exp(r^{j}_{t}),\quad i=1,...,N" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">←</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>r</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">/</mo><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mi>exp</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>r</mi><mi>t</mi><mi>j</mi></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">w^{i}_{t}\leftarrow\exp(r^{i}_{t})/\sum^{N}_{j=1}\exp(r^{j}_{t}),\quad i=1,...,N</annotation></semantics></math> <span id="alg2.l15.2" class="ltx_text" style="float:right;"><math id="alg2.l15.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Compute Resampling Distribution
</span>
</div>
<div id="alg2.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">16:</span>
            
            
            <math id="alg2.l16.m1" class="ltx_Math" alttext="ESS_{n}(t)=\sum^{N}_{j=1}(w^{i}_{t})^{-2}/N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>/</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">ESS_{n}(t)=\sum^{N}_{j=1}(w^{i}_{t})^{-2}/N</annotation></semantics></math> <span id="alg2.l16.2" class="ltx_text" style="float:right;"><math id="alg2.l16.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Effective Sample Size Resampling Distribution
</span>
</div>
<div id="alg2.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">17:</span>
            
            
            <span id="alg2.l17.2" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l17.m1" class="ltx_Math" alttext="ESS_{n}(t)&lt;\tau" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">ESS_{n}(t)&lt;\tau</annotation></semantics></math> <span id="alg2.l17.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">18:</span>
            
            
             <math id="alg2.l18.m1" class="ltx_Math" alttext="\beta_{t}^{-1}=1/ESS_{n}(t)(1-t/T)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mrow><mn>1</mn><mo>/</mo><mi>E</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>t</mi><mo>/</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}^{-1}=1/ESS_{n}(t)(1-t/T)</annotation></semantics></math> <span id="alg2.l18.2" class="ltx_text" style="float:right;"><math id="alg2.l18.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Temperature Annealing
</span>
</div>
<div id="alg2.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">19:</span>
            
            
             <math id="alg2.l19.m1" class="ltx_Math" alttext="\beta_{t}^{-1}=\texttt{max}(\beta_{t}^{-1},1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mtext class="ltx_mathvariant_monospace">max</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>β</mi><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}^{-1}=\texttt{max}(\beta_{t}^{-1},1)</annotation></semantics></math> <span id="alg2.l19.2" class="ltx_text" style="float:right;"><math id="alg2.l19.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Bound Temperature
</span>
</div>
<div id="alg2.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">20:</span>
            
            
             <math id="alg2.l20.m1" class="ltx_math_unparsed" alttext="w^{i}_{t}\leftarrow\exp(r^{i}_{t}~\beta_{t})/\sum^{N}_{j=1}\exp(r^{j}_{t}~\beta_{t}),\quad i=1,...,N" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">←</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>r</mi><mi>t</mi><mi>i</mi></msubsup><msub><mi>β</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">/</mo><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mi>exp</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>r</mi><mi>t</mi><mi>j</mi></msubsup><msub><mi>β</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">w^{i}_{t}\leftarrow\exp(r^{i}_{t}~\beta_{t})/\sum^{N}_{j=1}\exp(r^{j}_{t}~\beta_{t}),\quad i=1,...,N</annotation></semantics></math> <span id="alg2.l20.2" class="ltx_text" style="float:right;"><math id="alg2.l20.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update Resampling Distribution
</span>
</div>
<div id="alg2.l21" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">21:</span>
            
            
            <span id="alg2.l21.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l21.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg2.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">22:</span>
            
            
            <math id="alg2.l22.m1" class="ltx_Math" alttext="\{k_{i}\}^{N}_{i=1}\sim\texttt{Systematic}\left[w_{t}\right]" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo>∼</mo><mrow><mtext class="ltx_mathvariant_monospace">Systematic</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>w</mi><mi>t</mi></msub><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{k_{i}\}^{N}_{i=1}\sim\texttt{Systematic}\left[w_{t}\right]</annotation></semantics></math>
<span id="alg2.l22.2" class="ltx_text" style="float:right;"><math id="alg2.l22.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Sample <math id="alg2.l22.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> indexes with Stratified Replacement
</span>
</div>
<div id="alg2.l23" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">23:</span>
            
            
            <math id="alg2.l23.m1" class="ltx_math_unparsed" alttext="\mathbf{z}_{t}\leftarrow\mathbf{z}_{t}\left[k_{1:N}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">←</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mrow><mo>[</mo><msub><mi>k</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{t}\leftarrow\mathbf{z}_{t}\left[k_{1:N}\right]</annotation></semantics></math> <span id="alg2.l23.2" class="ltx_text" style="float:right;"><math id="alg2.l23.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Sample Selection
</span>
</div>
<div id="alg2.l24" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">24:</span>
            
            
            <math id="alg2.l24.m1" class="ltx_Math" alttext="\mathcal{P}\leftarrow\mathcal{P}\cup\{(\mathbf{z}_{t},w_{t})\}^{N}_{i=1}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>∪</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo>,</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}\leftarrow\mathcal{P}\cup\{(\mathbf{z}_{t},w_{t})\}^{N}_{i=1}</annotation></semantics></math> <span id="alg2.l24.2" class="ltx_text" style="float:right;"><math id="alg2.l24.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update Particles
</span>
</div>
<div id="alg2.l25" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">25:</span>
            
            
          <span id="alg2.l25.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l25.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l26" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">26:</span>
            
            
          <span id="alg2.l26.2" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l26.m1" class="ltx_math_unparsed" alttext="\mathbf{x}\sim p(\mathbf{x}|\mathbf{z}_{1:T},\mathbf{c})" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∼</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐳</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>,</mo><mi>𝐜</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\sim p(\mathbf{x}|\mathbf{z}_{1:T},\mathbf{c})</annotation></semantics></math>

</div>
</div>
</figure>
