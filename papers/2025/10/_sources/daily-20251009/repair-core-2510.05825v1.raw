<figure id="A4.F19.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.05825v1/eval_benchmark_aime-2024_1.7B_20250826_max.svg" id="A4.F19.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/425;" width="548" height="425"></object>
