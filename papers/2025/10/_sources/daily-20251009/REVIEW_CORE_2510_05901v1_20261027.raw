<tr id="S3.T4.2.1.3" class="ltx_tr">
<td id="S3.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_border_r">   Softmax</td>
<td id="S3.T4.2.1.3.2" class="ltx_td ltx_align_center"><span id="S3.T4.2.1.3.2.1" class="ltx_text ltx_font_bold">67.90</span></td>
<td id="S3.T4.2.1.3.3" class="ltx_td ltx_align_center"><span id="S3.T4.2.1.3.3.1" class="ltx_text ltx_font_bold">61.74</span></td>
<td id="S3.T4.2.1.3.4" class="ltx_td ltx_align_center"><span id="S3.T4.2.1.3.4.1" class="ltx_text ltx_font_bold">29.69</span></td>
<td id="S3.T4.2.1.3.5" class="ltx_td ltx_align_center"><span id="S3.T4.2.1.3.5.1" class="ltx_text ltx_font_bold">45.82</span></td>
<td id="S3.T4.2.1.3.6" class="ltx_td ltx_align_center"><span id="S3.T4.2.1.3.6.1" class="ltx_text ltx_font_bold">52.64</span></td>
