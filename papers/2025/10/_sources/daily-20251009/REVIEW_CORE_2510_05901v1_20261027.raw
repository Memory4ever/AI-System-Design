<td id="S3.T4.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">80.01</td>
<td id="S3.T4.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">52.22</td>
<td id="S3.T4.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">74.60</td>
<td id="S3.T4.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t">69.93</td>
<td id="S3.T4.2.1.2.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">53.51</td>
<td id="S3.T4.2.1.2.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">68.26</td>
