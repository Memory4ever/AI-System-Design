<td id="S5.T4.2.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:-1pt 1.5pt;">Scholar</td>
<td id="S5.T4.2.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:-1pt 1.5pt;">Design</td>
<td id="S5.T4.2.1.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_tt" style="padding:-1pt 1.5pt;">Checker</td>
<td id="S5.T4.2.1.1.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:-1pt 1.5pt;"><span id="S5.T4.2.1.1.4.1" class="ltx_text ltx_font_bold">Content</span> <math id="S5.T4.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S5.T4.2.1.1.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:-1pt 1.5pt;"><span id="S5.T4.2.1.1.5.1" class="ltx_text ltx_font_bold">Design</span> <math id="S5.T4.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
