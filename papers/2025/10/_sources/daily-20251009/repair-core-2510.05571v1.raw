<td id="S5.T3.2.1.12.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="S5.T3.2.1.12.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F7E3E3;">0.189</span></td>
