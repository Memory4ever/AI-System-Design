<tr id="A3.T3.2.5" class="ltx_tr">
<th id="A3.T3.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="A3.T3.m30" class="ltx_Math" alttext="\mathrm{GN}" display="inline" intent=":literal"><semantics><mi>GN</mi><annotation encoding="application/x-tex">\mathrm{GN}</annotation></semantics></math> variance</th>
