<figure id="alg1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>Stratified GRPO</figcaption>
<div id="alg1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.4.1" class="ltx_listingline">





















































<div id="alg1.4.1.1" class="ltx_listing ltx_listing">
<div id="alg1.l0" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">0:</span>
              
              
             Policy <math id="alg1.l0.m1" class="ltx_Math" alttext="p_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">p_{\theta}</annotation></semantics></math>, batch <math id="alg1.l0.m2" class="ltx_Math" alttext="B=\{\tau_{1},\dots,\tau_{K}\}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>τ</mi><mi>K</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B=\{\tau_{1},\dots,\tau_{K}\}</annotation></semantics></math> with rewards <math id="alg1.l0.m3" class="ltx_Math" alttext="\{R_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>R</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{R_{i}\}</annotation></semantics></math>, blending <math id="alg1.l0.m4" class="ltx_Math" alttext="\alpha\!\in\![0,1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.108em" rspace="0.108em">∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\!\in\![0,1]</annotation></semantics></math>, stabilizer <math id="alg1.l0.m5" class="ltx_Math" alttext="\varepsilon\!&gt;\!0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo lspace="0.108em">&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon\!&gt;\!0</annotation></semantics></math>.

</div>
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
             Compute global stats: <math id="alg1.l1.m1" class="ltx_Math" alttext="\bar{R}_{\mathrm{global}}\!\leftarrow\!\tfrac{1}{K}\sum_{i}R_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub><mo lspace="0.108em" rspace="0.108em" stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><msub><mi>R</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{R}_{\mathrm{global}}\!\leftarrow\!\tfrac{1}{K}\sum_{i}R_{i}</annotation></semantics></math>
;
</div>
<div id="alg1.4.1.1.1" class="ltx_listingline"><math id="alg1.m1" class="ltx_Math" alttext="\widehat{\sigma}_{\mathrm{global}}\!\leftarrow\!\sqrt{\tfrac{1}{K}\sum_{i}(R_{i}-\bar{R}_{\mathrm{global}})^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>global</mi></msub><mo lspace="0.108em" rspace="0.108em" stretchy="false">←</mo><msqrt><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">∑</mo><mi>i</mi></msub><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\widehat{\sigma}_{\mathrm{global}}\!\leftarrow\!\sqrt{\tfrac{1}{K}\sum_{i}(R_{i}-\bar{R}_{\mathrm{global}})^{2}}</annotation></semantics></math>.

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
             For all <math id="alg1.l2.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, set <math id="alg1.l2.m2" class="ltx_Math" alttext="A_{\mathrm{GN}}(\tau_{i})\!\leftarrow\!(R_{i}-\bar{R}_{\mathrm{global}})/(\widehat{\sigma}_{\mathrm{global}}+\varepsilon)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>GN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.108em" stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>global</mi></msub><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{\mathrm{GN}}(\tau_{i})\!\leftarrow\!(R_{i}-\bar{R}_{\mathrm{global}})/(\widehat{\sigma}_{\mathrm{global}}+\varepsilon)</annotation></semantics></math>.

</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
             Partition indices into per-prompt, per-stratum groups <math id="alg1.l3.m1" class="ltx_Math" alttext="I_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I_{k}(x)</annotation></semantics></math> (e.g., by search count).

</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
             <span id="alg1.l4.2" class="ltx_text ltx_font_bold">for</span> each prompt <math id="alg1.l4.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> <span id="alg1.l4.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              <span id="alg1.l5.2" class="ltx_text ltx_font_bold">for</span> each stratum <math id="alg1.l5.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> with index set <math id="alg1.l5.m2" class="ltx_Math" alttext="I_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I_{k}(x)</annotation></semantics></math> <span id="alg1.l5.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
               <math id="alg1.l6.m1" class="ltx_Math" alttext="n_{k}\!\leftarrow\!|I_{k}(x)|" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0.108em" rspace="0.108em" stretchy="false">←</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>I</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">n_{k}\!\leftarrow\!|I_{k}(x)|</annotation></semantics></math>;  <math id="alg1.l6.m2" class="ltx_Math" alttext="\bar{R}_{k}\!\leftarrow\!\tfrac{1}{n_{k}}\!\sum_{i\in I_{k}(x)}\!R_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><mo lspace="0.108em" rspace="0.108em" stretchy="false">←</mo><mrow><mfrac><mn>1</mn><msub><mi>n</mi><mi>k</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><msub><mi>I</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><msub><mi>R</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{R}_{k}\!\leftarrow\!\tfrac{1}{n_{k}}\!\sum_{i\in I_{k}(x)}\!R_{i}</annotation></semantics></math>;  <math id="alg1.l6.m3" class="ltx_Math" alttext="\widehat{\sigma}_{k}\!\leftarrow\!\sqrt{\tfrac{1}{n_{k}}\!\sum_{i\in I_{k}(x)}(R_{i}-\bar{R}_{k})^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0.108em" rspace="0.108em" stretchy="false">←</mo><msqrt><mrow><mfrac><mn>1</mn><msub><mi>n</mi><mi>k</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><msub><mi>I</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\widehat{\sigma}_{k}\!\leftarrow\!\sqrt{\tfrac{1}{n_{k}}\!\sum_{i\in I_{k}(x)}(R_{i}-\bar{R}_{k})^{2}}</annotation></semantics></math>.

</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
               <span id="alg1.l7.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l7.m1" class="ltx_Math" alttext="i\in I_{k}(x)" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><msub><mi>I</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i\in I_{k}(x)</annotation></semantics></math> <span id="alg1.l7.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
                <math id="alg1.l8.m1" class="ltx_Math" alttext="A_{\mathrm{SAN}}(\tau_{i})\!\leftarrow\!(R_{i}-\bar{R}_{k})/(\widehat{\sigma}_{k}+\varepsilon)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.108em" stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{\mathrm{SAN}}(\tau_{i})\!\leftarrow\!(R_{i}-\bar{R}_{k})/(\widehat{\sigma}_{k}+\varepsilon)</annotation></semantics></math>.

</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
                <math id="alg1.l9.m1" class="ltx_Math" alttext="A_{\mathrm{blend}}(\tau_{i})\!\leftarrow\!\alpha\,A_{\mathrm{SAN}}(\tau_{i})+(1-\alpha)\,A_{\mathrm{GN}}(\tau_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>blend</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.108em" stretchy="false">←</mo><mrow><mrow><mi>α</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>A</mi><mi>GN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{\mathrm{blend}}(\tau_{i})\!\leftarrow\!\alpha\,A_{\mathrm{SAN}}(\tau_{i})+(1-\alpha)\,A_{\mathrm{GN}}(\tau_{i})</annotation></semantics></math>.

</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
               <span id="alg1.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
              <span id="alg1.l11.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l11.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
             <span id="alg1.l12.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l12.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
             Return gradient estimate <math id="alg1.l13.m1" class="ltx_Math" alttext="\widehat{g}_{\mathrm{blend}}\leftarrow\tfrac{1}{K}\sum_{i=1}^{K}A_{\mathrm{blend}}(\tau_{i})\,\nabla_{\theta}\log p_{\theta}(\tau_{i}\mid x)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>blend</mi></msub><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mrow><msub><mi>A</mi><mi>blend</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{g}_{\mathrm{blend}}\leftarrow\tfrac{1}{K}\sum_{i=1}^{K}A_{\mathrm{blend}}(\tau_{i})\,\nabla_{\theta}\log p_{\theta}(\tau_{i}\mid x)</annotation></semantics></math>.

</div>
</div>
</div>
</div>
</figure>
<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Related Work</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Reinforcement Learning for Large Language Models</h3>

<div id="A1.SS1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS1.p1.1" class="ltx_p">Reinforcement learning (RL) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib10" title="" class="ltx_ref">Kaelbling et al., 1996</a>; <a href="#bib.bib25" title="" class="ltx_ref">Sutton et al., 1999</a>)</cite> has become a central component in post-training large language models (LLMs). The most widely adopted paradigm is Reinforcement Learning from Human Feedback (RLHF), which learns a reward model from human preferences and then optimizes a policy with RL algorithms, most often Proximal Policy Optimization (PPO) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">Ouyang et al., 2022</a>; <a href="#bib.bib20" title="" class="ltx_ref">Schulman et al., 2017</a>)</cite>. Although effective, RLHF can be computationally expensive and brittle due to reward model training and distribution shift. To reduce the cost and instability of explicit reward modeling, direct alignment methods like DPO optimize preference data without training a separate reward model <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib18" title="" class="ltx_ref">Rafailov et al., 2023</a>; <a href="#bib.bib38" title="" class="ltx_ref">Zhu et al., 2025</a>)</cite>. A complementary line of work targets reasoning by exploiting verifiable outcomes using Reinforcement Learning with Verifiable Rewards (RLVR) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib5" title="" class="ltx_ref">DeepSeek-AI et al., 2025</a>; <a href="#bib.bib21" title="" class="ltx_ref">Shao et al., 2024</a>; <a href="#bib.bib2" title="" class="ltx_ref">Ahmadian et al., 2024</a>; <a href="#bib.bib34" title="" class="ltx_ref">Yu et al., 2025</a>)</cite>. A prominent approach is Group Relative Policy Optimization (GRPO) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib21" title="" class="ltx_ref">Shao et al., 2024</a>)</cite>, which removes PPO’s dependency on a learned value function by using group-based baselines, and RLOO <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib2" title="" class="ltx_ref">Ahmadian et al., 2024</a>)</cite> revisits REINFORCE <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Williams, 1992</a>)</cite> with simplifications tailored to LLM training. However, most of these advances target general conversational capabilities. By contrast, the systematic study of RL algorithms for LLM agents, especially search agents that interleave generation with search over external information and require long-horizon reasoning, remains underexplored. Our work addresses this gap by providing a systematic analysis of the LLM search agent setting and proposing RL algorithms tailored to its unique challenges.</p>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Large Language Model Search Agents</h3>

<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.p1.1" class="ltx_p">Large language models (LLMs) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib1" title="" class="ltx_ref">Achiam et al., 2023</a>; <a href="#bib.bib26" title="" class="ltx_ref">Team, 2024</a>; <a href="#bib.bib36" title="" class="ltx_ref">Zhao et al., 2023</a>)</cite> exhibit strong reasoning capabilities <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib5" title="" class="ltx_ref">DeepSeek-AI et al., 2025</a>)</cite>. Building on this capacity, recent work has developed agentic workflows that equip LLMs with external tools for complex problem solving <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Schick et al., 2023</a>)</cite>. A prominent instantiation is the LLM search agent, which treats a search engine as a callable tool at inference time <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Schick et al., 2023</a>)</cite>: the model iteratively proposes queries, retrieves evidence, and updates its reasoning based on retrieved documents <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib28" title="" class="ltx_ref">Trivedi et al., 2023</a>)</cite>. Two main approaches have emerged. One line of work uses carefully designed prompts to instruct LLMs to interleave reasoning and retrieval <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib28" title="" class="ltx_ref">Trivedi et al., 2023</a>; <a href="#bib.bib33" title="" class="ltx_ref">Yao et al., 2023</a>)</cite>. Another line curates trajectories that mix reasoning with search and then applies supervised fine-tuning <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Schick et al., 2023</a>; <a href="#bib.bib3" title="" class="ltx_ref">Asai et al., 2023</a>)</cite>. More recently, several studies <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib4" title="" class="ltx_ref">Chen et al., 2025</a>; <a href="#bib.bib8" title="" class="ltx_ref">Jin et al., 2025</a>; <a href="#bib.bib23" title="" class="ltx_ref">Song et al., 2025</a>; <a href="#bib.bib37" title="" class="ltx_ref">Zheng et al., 2025</a>)</cite> show that complex search-and-reasoning behaviors can be acquired directly from outcome-based rewards using RL algorithms such as PPO or GRPO. However, these RL applications typically adopt general-purpose algorithms without addressing the specific intricacies of the search agent setting. Our work identifies and formalizes cross-stratum bias as a fundamental challenge for LLM search agents, arising from the heterogeneous nature of agent trajectories that use different search strategies. To overcome this, we propose Stratified GRPO, a principled algorithm designed to eliminate this bias and improve learning more effective search policies for LLM search agents.</p>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Proofs of Theoretical Results</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Proof of <a href="#Thmtheorem1" title="Theorem 1 (Variance Reduction via Stratified Baselines). ‣ Advantage Bias and Variance Decomposition. ‣ 2.2 Cross-Stratum Bias in Policy-Gradient Baselines ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A2.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.p1.1" class="ltx_p"><span id="A2.SS1.p1.1.1" class="ltx_text">By construction, both advantage estimators are centered, meaning their sample mean over the batch <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is zero:</span></p>
<table id="A2.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E8.m1" class="ltx_Math" alttext="\frac{1}{K}\sum_{i=1}^{K}\hat{A}_{G}(\tau_{i})=0,\qquad\frac{1}{K}\sum_{i=1}^{K}\hat{A}_{S}(\tau_{i})=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></munder><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{K}\sum_{i=1}^{K}\hat{A}_{G}(\tau_{i})=0,\qquad\frac{1}{K}\sum_{i=1}^{K}\hat{A}_{S}(\tau_{i})=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p1.2" class="ltx_p"><span id="A2.SS1.p1.2.1" class="ltx_text">The variance of the global advantage estimator is the total sample variance of the rewards:</span></p>
<table id="A2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex14.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{G}]=\frac{1}{K}\sum_{i=1}^{K}(R_{i}-\bar{R}_{\mathrm{global}})^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>G</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{G}]=\frac{1}{K}\sum_{i=1}^{K}(R_{i}-\bar{R}_{\mathrm{global}})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.3" class="ltx_p"><span id="A2.SS1.p1.3.1" class="ltx_text">We decompose this total variance by partitioning the sum by stratum and adding and subtracting the stratum mean <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="\bar{R}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\bar{R}_{k}</annotation></semantics></math> within the squared term:</span></p>
<table id="A2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex15.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}[\hat{A}_{G}]" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>G</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}[\hat{A}_{G}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex15.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}\bigl((R_{i}-\bar{R}_{k})+(\bar{R}_{k}-\bar{R}_{\mathrm{global}})\bigr)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></munder></mstyle><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}\bigl((R_{i}-\bar{R}_{k})+(\bar{R}_{k}-\bar{R}_{\mathrm{global}})\bigr)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex16.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}2(R_{i}-\bar{R}_{k})(\bar{R}_{k}-\bar{R}_{\mathrm{global}})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></munder></mstyle><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}2(R_{i}-\bar{R}_{k})(\bar{R}_{k}-\bar{R}_{\mathrm{global}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(\bar{R}_{k}-\bar{R}_{\mathrm{global}})^{2}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(\bar{R}_{k}-\bar{R}_{\mathrm{global}})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.4" class="ltx_p"><span id="A2.SS1.p1.4.1" class="ltx_text">The cross-term in the above equation vanishes because, for each stratum <math id="A2.SS1.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, the inner sum <math id="A2.SS1.p1.m4" class="ltx_Math" alttext="\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></msub><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})=0</annotation></semantics></math> by the definition of <math id="A2.SS1.p1.m5" class="ltx_Math" alttext="\bar{R}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\bar{R}_{k}</annotation></semantics></math>. The above expression thus simplifies to the well-known variance decomposition formula:</span></p>
<table id="A2.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E9.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{G}]=\underbrace{\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})^{2}}_{\text{Within-Stratum Variance}}+\underbrace{\frac{1}{K}\sum_{k=0}^{I-1}n_{k}(\bar{R}_{k}-\bar{R}_{\mathrm{global}})^{2}}_{\text{Between-Stratum Variance}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>G</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><munder><munder accentunder="true"><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></munder><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Within-Stratum Variance</mtext></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Between-Stratum Variance</mtext></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{G}]=\underbrace{\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})^{2}}_{\text{Within-Stratum Variance}}+\underbrace{\frac{1}{K}\sum_{k=0}^{I-1}n_{k}(\bar{R}_{k}-\bar{R}_{\mathrm{global}})^{2}}_{\text{Between-Stratum Variance}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p1.5" class="ltx_p"><span id="A2.SS1.p1.5.1" class="ltx_text">The first term in <a href="#A2.E9" title="In Proof. ‣ B.1 Proof of ‣ Appendix B Proofs of Theoretical Results ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">9</span></a> is precisely the definition of <math id="A2.SS1.p1.m6" class="ltx_Math" alttext="\mathrm{Var}[\hat{A}_{S}]" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}[\hat{A}_{S}]</annotation></semantics></math>, since</span></p>
<table id="A2.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{i=1}^{K}\bigl(\hat{A}_{S}(\tau_{i})-\bar{\hat{A}}_{S}\bigr)^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mover accent="true"><mover accent="true"><mi>A</mi><mo>^</mo></mover><mo>¯</mo></mover><mi>S</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{i=1}^{K}\bigl(\hat{A}_{S}(\tau_{i})-\bar{\hat{A}}_{S}\bigr)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.6" class="ltx_p"><span id="A2.SS1.p1.6.1" class="ltx_text">where <math id="A2.SS1.p1.m7" class="ltx_Math" alttext="\bar{\hat{A}}_{S}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mover accent="true"><mi>A</mi><mo>^</mo></mover><mo>¯</mo></mover><mi>S</mi></msub><annotation encoding="application/x-tex">\bar{\hat{A}}_{S}</annotation></semantics></math> is the sample mean of the stratified advantages over the entire batch. As established in <a href="#A2.E8" title="In Proof. ‣ B.1 Proof of ‣ Appendix B Proofs of Theoretical Results ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">8</span></a>, this mean is zero (<math id="A2.SS1.p1.m8" class="ltx_Math" alttext="\bar{\hat{A}}_{S}=0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mover accent="true"><mi>A</mi><mo>^</mo></mover><mo>¯</mo></mover><mi>S</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bar{\hat{A}}_{S}=0</annotation></semantics></math>). Therefore, the variance simplifies to the mean squared value:</span></p>
<table id="A2.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{i=1}^{K}\bigl(\hat{A}_{S}(\tau_{i})\bigr)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{i=1}^{K}\bigl(\hat{A}_{S}(\tau_{i})\bigr)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.7" class="ltx_p"><span id="A2.SS1.p1.7.1" class="ltx_text">To evaluate this sum, we partition it according to the strata <math id="A2.SS1.p1.m9" class="ltx_Math" alttext="\{B_{k}\}_{k=0}^{I-1}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>B</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\{B_{k}\}_{k=0}^{I-1}</annotation></semantics></math>:</span></p>
<table id="A2.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex21.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}\bigl(\hat{A}_{S}(\tau_{i})\bigr)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></munder><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}\bigl(\hat{A}_{S}(\tau_{i})\bigr)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.8" class="ltx_p"><span id="A2.SS1.p1.8.1" class="ltx_text">Finally, we substitute the definition of the stratified advantage, <math id="A2.SS1.p1.m10" class="ltx_Math" alttext="\hat{A}_{S}(\tau_{i})=R_{i}-\bar{R}_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{A}_{S}(\tau_{i})=R_{i}-\bar{R}_{k}</annotation></semantics></math>, for trajectories within each stratum <math id="A2.SS1.p1.m11" class="ltx_Math" alttext="B_{k}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>k</mi></msub><annotation encoding="application/x-tex">B_{k}</annotation></semantics></math>:</span></p>
<table id="A2.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></munder><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{k=0}^{I-1}\sum_{\tau_{i}\in B_{k}}(R_{i}-\bar{R}_{k})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.9" class="ltx_p"><span id="A2.SS1.p1.9.1" class="ltx_text">This expression is identical to the first term in the variance decomposition identity (<a href="#A2.E9" title="In Proof. ‣ B.1 Proof of ‣ Appendix B Proofs of Theoretical Results ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">9</span></a>), thus proving the assertion.</span></p>
</div>
<div id="A2.SS1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS1.p2.1" class="ltx_p"><span id="A2.SS1.p2.1.1" class="ltx_text">The second term in <a href="#A2.E9" title="In Proof. ‣ B.1 Proof of ‣ Appendix B Proofs of Theoretical Results ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">9</span></a>, the between-stratum variance, is a weighted sum of squares and is therefore non-negative. This yields the inequality:</span></p>
<table id="A2.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E10.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{G}]=\operatorname{Var}[\hat{A}_{S}]+\frac{1}{K}\sum_{k=0}^{I-1}n_{k}(\bar{R}_{k}-\bar{R}_{\mathrm{global}})^{2}\geq\operatorname{Var}[\hat{A}_{S}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>G</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo>≥</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{G}]=\operatorname{Var}[\hat{A}_{S}]+\frac{1}{K}\sum_{k=0}^{I-1}n_{k}(\bar{R}_{k}-\bar{R}_{\mathrm{global}})^{2}\geq\operatorname{Var}[\hat{A}_{S}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p2.2" class="ltx_p"><span id="A2.SS1.p2.2.1" class="ltx_text">Equality holds if and only if the between-stratum variance component is zero. This requires every term in the sum to be zero, which means <math id="A2.SS1.p2.m1" class="ltx_Math" alttext="\bar{R}_{k}=\bar{R}_{\mathrm{global}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>=</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub></mrow><annotation encoding="application/x-tex">\bar{R}_{k}=\bar{R}_{\mathrm{global}}</annotation></semantics></math> for all <math id="A2.SS1.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. This condition is met only when all stratum means coincide. Otherwise, the between-stratum variance is strictly positive, and the inequality is strict.
∎</span></p>
</div>
</div>
<div id="Thmremark1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark1.2" class="ltx_text ltx_font_bold">Remark 1</span></span><span id="Thmremark1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmremark1.p1" class="ltx_para">
<p id="Thmremark1.p1.1" class="ltx_p"><a href="#A2.E9" title="In Proof. ‣ B.1 Proof of ‣ Appendix B Proofs of Theoretical Results ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">9</span></a><span id="Thmremark1.p1.1.1" class="ltx_text ltx_font_italic"> is the finite-sample form of the classical
<em id="Thmremark1.p1.1.1.1" class="ltx_emph ltx_font_upright">within–between variance decomposition</em> in ANOVA.
It shows that replacing the global baseline with stratum-specific baselines
always weakly reduces the variance of advantage estimates, and strictly reduces it whenever the strata have heterogeneous reward means.</span></p>
</div>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Proof of <a href="#Thmproposition2" title="Proposition 2 (Invariance to Positive Affine Reward Transforms). ‣ Advantage Invariance and Robustness. ‣ 2.3 Stratified Advantage Normalization: Definition and Theoretical Guarantees ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="A2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.p1.1" class="ltx_p"><span id="A2.SS2.p1.1.1" class="ltx_text">Let a stratum for a given prompt <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> be denoted by <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="B_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{k}(x)</annotation></semantics></math>, containing <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="n_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">n_{k}(x)</annotation></semantics></math> trajectories with rewards <math id="A2.SS2.p1.m4" class="ltx_Math" alttext="\{R_{1},\dots,R_{n_{k}(x)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>R</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>R</mi><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{R_{1},\dots,R_{n_{k}(x)}\}</annotation></semantics></math>. The empirical mean and standard deviation are</span></p>
<table id="A2.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex23.m1" class="ltx_Math" alttext="\widehat{\mu}_{k}(x)=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}R_{i}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></munderover><msub><mi>R</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{k}(x)=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}R_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p"><span id="A2.SS2.p1.2.1" class="ltx_text">and</span></p>
<table id="A2.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\widehat{\sigma}_{k}(x)=\sqrt{\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}(R_{i}-\widehat{\mu}_{k}(x))^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\sigma}_{k}(x)=\sqrt{\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}(R_{i}-\widehat{\mu}_{k}(x))^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.3" class="ltx_p"><span id="A2.SS2.p1.3.1" class="ltx_text">Without loss of generality, suppose that <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="n_{k}\geq 2" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>k</mi></msub><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n_{k}\geq 2</annotation></semantics></math>, and <math id="A2.SS2.p1.m6" class="ltx_Math" alttext="\widehat{\sigma}_{k}(x)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{\sigma}_{k}(x)&gt;0</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.p2.1" class="ltx_p"><span id="A2.SS2.p2.1.1" class="ltx_text">Consider the affine transformation <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="R^{\prime}_{i}=aR_{i}+b" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>i</mi><mo>′</mo></msubsup><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>i</mi></msub></mrow><mo>+</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">R^{\prime}_{i}=aR_{i}+b</annotation></semantics></math> for <math id="A2.SS2.p2.m2" class="ltx_Math" alttext="a&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a&gt;0</annotation></semantics></math>. We first compute the new empirical mean <math id="A2.SS2.p2.m3" class="ltx_Math" alttext="\widehat{\mu}^{\prime}_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}^{\prime}_{k}(x)</annotation></semantics></math> and standard deviation <math id="A2.SS2.p2.m4" class="ltx_Math" alttext="\widehat{\sigma}^{\prime}_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\sigma}^{\prime}_{k}(x)</annotation></semantics></math> for the transformed rewards.</span></p>
</div>
<div id="A2.SS2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS2.p3.1" class="ltx_p"><span id="A2.SS2.p3.1.1" class="ltx_text">The new mean is:</span></p>
<table id="A2.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex25.m1" class="ltx_Math" alttext="\widehat{\mu}^{\prime}_{k}(x)=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}R^{\prime}_{i}=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}(aR_{i}+b)=a\left(\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}R_{i}\right)+b=a\widehat{\mu}_{k}(x)+b." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></munderover><msubsup><mi>R</mi><mi>i</mi><mo>′</mo></msubsup></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></munderover><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>i</mi></msub></mrow><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></munderover><msub><mi>R</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mi>b</mi></mrow><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>b</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\mu}^{\prime}_{k}(x)=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}R^{\prime}_{i}=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}(aR_{i}+b)=a\left(\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}R_{i}\right)+b=a\widehat{\mu}_{k}(x)+b.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.2" class="ltx_p"><span id="A2.SS2.p3.2.1" class="ltx_text">The new variance is:</span></p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex26.m1" class="ltx_Math" alttext="\displaystyle(\widehat{\sigma}^{\prime}_{k}(x))^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle(\widehat{\sigma}^{\prime}_{k}(x))^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}(R^{\prime}_{i}-\widehat{\mu}^{\prime}_{k}(x))^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>R</mi><mi>i</mi><mo>′</mo></msubsup><mo>−</mo><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}(R^{\prime}_{i}-\widehat{\mu}^{\prime}_{k}(x))^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex27.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}\bigl((aR_{i}+b)-(a\widehat{\mu}_{k}(x)+b)\bigr)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>i</mi></msub></mrow><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}\bigl((aR_{i}+b)-(a\widehat{\mu}_{k}(x)+b)\bigr)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex28.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}\bigl(a(R_{i}-\widehat{\mu}_{k}(x))\bigr)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}\bigl(a(R_{i}-\widehat{\mu}_{k}(x))\bigr)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex29.m1" class="ltx_Math" alttext="\displaystyle=a^{2}\left(\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}(R_{i}-\widehat{\mu}_{k}(x))^{2}\right)=a^{2}(\widehat{\sigma}_{k}(x))^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=a^{2}\left(\frac{1}{n_{k}(x)}\sum_{i=1}^{n_{k}(x)}(R_{i}-\widehat{\mu}_{k}(x))^{2}\right)=a^{2}(\widehat{\sigma}_{k}(x))^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.3" class="ltx_p"><span id="A2.SS2.p3.3.1" class="ltx_text">Since <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="a&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a&gt;0</annotation></semantics></math>, the new standard deviation is <math id="A2.SS2.p3.m2" class="ltx_Math" alttext="\widehat{\sigma}^{\prime}_{k}(x)=\sqrt{a^{2}(\widehat{\sigma}_{k}(x))^{2}}=a\widehat{\sigma}_{k}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msqrt><mrow><msup><mi>a</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></msqrt><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\sigma}^{\prime}_{k}(x)=\sqrt{a^{2}(\widehat{\sigma}_{k}(x))^{2}}=a\widehat{\sigma}_{k}(x)</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.p4" class="ltx_para">
<p id="A2.SS2.p4.1" class="ltx_p"><span id="A2.SS2.p4.1.1" class="ltx_text">Finally, we compute the new advantage <math id="A2.SS2.p4.m1" class="ltx_Math" alttext="A^{\prime}_{\text{SAN}}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mtext>SAN</mtext><mo>′</mo></msubsup><annotation encoding="application/x-tex">A^{\prime}_{\text{SAN}}</annotation></semantics></math> for an arbitrary trajectory <math id="A2.SS2.p4.m2" class="ltx_Math" alttext="\tau_{i}\in B_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>i</mi></msub><mo>∈</mo><mrow><msub><mi>B</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{i}\in B_{k}(x)</annotation></semantics></math>:</span></p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex30.m1" class="ltx_Math" alttext="\displaystyle A^{\prime}_{\text{SAN}}(\tau_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mtext>SAN</mtext><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle A^{\prime}_{\text{SAN}}(\tau_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex30.m2" class="ltx_Math" alttext="\displaystyle=\frac{R^{\prime}_{i}-\widehat{\mu}^{\prime}_{k}(x)}{\widehat{\sigma}^{\prime}_{k}(x)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>R</mi><mi>i</mi><mo>′</mo></msubsup><mo>−</mo><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{R^{\prime}_{i}-\widehat{\mu}^{\prime}_{k}(x)}{\widehat{\sigma}^{\prime}_{k}(x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex31.m1" class="ltx_Math" alttext="\displaystyle=\frac{(aR_{i}+b)-(a\widehat{\mu}_{k}(x)+b)}{a\widehat{\sigma}_{k}(x)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>i</mi></msub></mrow><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(aR_{i}+b)-(a\widehat{\mu}_{k}(x)+b)}{a\widehat{\sigma}_{k}(x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\displaystyle=\frac{a(R_{i}-\widehat{\mu}_{k}(x))}{a\widehat{\sigma}_{k}(x)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{a(R_{i}-\widehat{\mu}_{k}(x))}{a\widehat{\sigma}_{k}(x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_Math" alttext="\displaystyle=\frac{R_{i}-\widehat{\mu}_{k}(x)}{\widehat{\sigma}_{k}(x)}=A_{\text{SAN}}(\tau_{i})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mrow><msub><mi>A</mi><mtext>SAN</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{R_{i}-\widehat{\mu}_{k}(x)}{\widehat{\sigma}_{k}(x)}=A_{\text{SAN}}(\tau_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p4.2" class="ltx_p"><span id="A2.SS2.p4.2.1" class="ltx_text">This shows that the advantage computed from the transformed rewards is identical to the original, completing the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Proof of <a href="#Thmtheorem2" title="Theorem 2 (Variance Decomposition for Normalized Stratified Advantage). ‣ Variance Decomposition. ‣ 2.3 Stratified Advantage Normalization: Definition and Theoretical Guarantees ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="A2.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p"><span id="A2.SS3.p1.1.1" class="ltx_text">We prove the identity by introducing the variance of the intermediate stratified estimator, <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{S}]" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{S}]</annotation></semantics></math>, and decomposing the total difference into two parts. The total difference can be written as a telescoping sum:</span></p>
<table id="A2.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E11.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}[\hat{A}_{G}]-\operatorname{Var}[A_{\rm SAN}]=\big(\operatorname{Var}[\hat{A}_{G}]-\operatorname{Var}[\hat{A}_{S}]\big)+\big(\operatorname{Var}[\hat{A}_{S}]-\operatorname{Var}[A_{\rm SAN}]\big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>G</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>G</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}[\hat{A}_{G}]-\operatorname{Var}[A_{\rm SAN}]=\big(\operatorname{Var}[\hat{A}_{G}]-\operatorname{Var}[\hat{A}_{S}]\big)+\big(\operatorname{Var}[\hat{A}_{S}]-\operatorname{Var}[A_{\rm SAN}]\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p1.2" class="ltx_p"><span id="A2.SS3.p1.2.1" class="ltx_text">By <a href="#Thmtheorem1" title="Theorem 1 (Variance Reduction via Stratified Baselines). ‣ Advantage Bias and Variance Decomposition. ‣ 2.2 Cross-Stratum Bias in Policy-Gradient Baselines ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a>,</span></p>
<table id="A2.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex34.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{G}]-\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}(\bar{R}_{k}-\bar{R}_{\rm global})^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>G</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{G}]-\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}(\bar{R}_{k}-\bar{R}_{\rm global})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.3" class="ltx_p"><span id="A2.SS3.p1.3.1" class="ltx_text">Moreover, by direct expansion, the empirical variance of the stratified advantage is</span></p>
<table id="A2.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex35.m1" class="ltx_Math" alttext="\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\sigma_{k}^{2},\qquad\operatorname{Var}[A_{\rm SAN}]=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\frac{\sigma_{k}^{2}}{(\sigma_{k}+\varepsilon)^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[\hat{A}_{S}]=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\sigma_{k}^{2},\qquad\operatorname{Var}[A_{\rm SAN}]=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\frac{\sigma_{k}^{2}}{(\sigma_{k}+\varepsilon)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.4" class="ltx_p"><span id="A2.SS3.p1.4.1" class="ltx_text">Then we can compute their difference:</span></p>
<table id="A2.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex36.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}[\hat{A}_{S}]-\operatorname{Var}[A_{\rm SAN}]=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\sigma_{k}^{2}-\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\frac{\sigma_{k}^{2}}{(\sigma_{k}+\varepsilon)^{2}}=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\sigma_{k}^{2}\left(1-\frac{1}{(\sigma_{k}+\varepsilon)^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>S</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>I</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>n</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}[\hat{A}_{S}]-\operatorname{Var}[A_{\rm SAN}]=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\sigma_{k}^{2}-\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\frac{\sigma_{k}^{2}}{(\sigma_{k}+\varepsilon)^{2}}=\frac{1}{K}\sum_{k=0}^{I-1}n_{k}\sigma_{k}^{2}\left(1-\frac{1}{(\sigma_{k}+\varepsilon)^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.5" class="ltx_p"><span id="A2.SS3.p1.5.1" class="ltx_text">Substituting the two expressions into <a href="#A2.E11" title="In Proof. ‣ B.3 Proof of ‣ Appendix B Proofs of Theoretical Results ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">11</span></a> can get the final result.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Proof of <a href="#Thmtheorem3" title="Theorem 3 (Population SAN Expectation). ‣ The Gradient Bias Trade-off. ‣ 2.3 Stratified Advantage Normalization: Definition and Theoretical Guarantees ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="A2.SS4.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.p1.1" class="ltx_p">Proving <a href="#Thmtheorem3" title="Theorem 3 (Population SAN Expectation). ‣ The Gradient Bias Trade-off. ‣ 2.3 Stratified Advantage Normalization: Definition and Theoretical Guarantees ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3</span></a> relies on the following two lemmas:</p>
</div>
<div id="Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma 1</span></span><span id="Thmlemma1.3" class="ltx_text ltx_font_bold"> </span>(Conditional expectation of the score function)<span id="Thmlemma1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma1.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma1.p1.1" class="ltx_p"><span id="Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="B\subseteq\{\tau\}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⊆</mo><mrow><mo stretchy="false">{</mo><mi>τ</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B\subseteq\{\tau\}</annotation></semantics></math> be a fixed stratum and fix the context <math id="Thmlemma1.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
Assume <math id="Thmlemma1.p1.m3" class="ltx_Math" alttext="p_{\theta}(\tau\mid x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(\tau\mid x)</annotation></semantics></math> is differentiable in <math id="Thmlemma1.p1.m4" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, and that differentiation
may be interchanged with summation/integration.
Define</span></p>
<table id="A2.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E12.m1" class="ltx_Math" alttext="Z(\theta;x)\coloneqq\operatorname{Pr}_{\theta}(\tau\in B\mid x)=\sum_{\tau\in B}p_{\theta}(\tau\mid x)\quad\text{(or the corresponding integral in the continuous case)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi>Pr</mi><mi>θ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow></munder><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">(or the corresponding integral in the continuous case)</mtext></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z(\theta;x)\coloneqq\operatorname{Pr}_{\theta}(\tau\in B\mid x)=\sum_{\tau\in B}p_{\theta}(\tau\mid x)\quad\text{(or the corresponding integral in the continuous case)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="Thmlemma1.p1.2" class="ltx_p"><span id="Thmlemma1.p1.2.1" class="ltx_text ltx_font_italic">If <math id="Thmlemma1.p1.m5" class="ltx_Math" alttext="Z(\theta;x)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Z(\theta;x)&gt;0</annotation></semantics></math>, then</span></p>
<table id="A2.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex37.m1" class="ltx_math_unparsed" alttext="\mathbb{E}\!\left[\nabla_{\theta}\log p_{\theta}(\tau\mid x)\;\middle|\;\tau\in B,x\right]=\nabla_{\theta}\log\operatorname{Pr}_{\theta}(\tau\in B\mid x)." display="block" intent=":literal"><semantics><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mrow><mo>[</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="true">|</mo><mi>τ</mi><mo>∈</mo><mi>B</mi><mo>,</mo><mi>x</mi><mo>]</mo></mrow><mo>=</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>Pr</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>∈</mo><mi>B</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\left[\nabla_{\theta}\log p_{\theta}(\tau\mid x)\;\middle|\;\tau\in B,x\right]=\nabla_{\theta}\log\operatorname{Pr}_{\theta}(\tau\in B\mid x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma1.p1.3" class="ltx_p"><span id="Thmlemma1.p1.3.1" class="ltx_text ltx_font_italic">In particular, this conditional expectation equals zero if and only if
<math id="Thmlemma1.p1.m6" class="ltx_Math" alttext="\Pr_{\theta}(\tau\in B\mid x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pr</mi><mi>θ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Pr_{\theta}(\tau\in B\mid x)</annotation></semantics></math> is constant in <math id="Thmlemma1.p1.m7" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS4.p2" class="ltx_para ltx_noindent">
<p id="A2.SS4.p2.1" class="ltx_p"><span id="A2.SS4.p2.1.1" class="ltx_text">By definition, the conditional distribution restricted to <math id="A2.SS4.p2.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is</span></p>
<table id="A2.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex38.m1" class="ltx_Math" alttext="p_{\theta}(\tau\mid x,\tau\in B)=\frac{p_{\theta}(\tau\mid x)}{Z(\theta;x)},\quad\tau\in B." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>x</mi><mo>,</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p_{\theta}(\tau\mid x,\tau\in B)=\frac{p_{\theta}(\tau\mid x)}{Z(\theta;x)},\quad\tau\in B.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p2.2" class="ltx_p"><span id="A2.SS4.p2.2.1" class="ltx_text">Hence, using <math id="A2.SS4.p2.m2" class="ltx_math_unparsed" alttext="p\nabla\log p=\nabla p" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>log</mi><mi>p</mi><mo>=</mo><mo rspace="0.167em">∇</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">p\nabla\log p=\nabla p</annotation></semantics></math> and assuming we can exchange differentiation
and summation/integration,</span></p>
<table id="A2.Ex39" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex39X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex39X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\!\left[\nabla_{\theta}\log p_{\theta}(\tau\mid x)\;\middle|\;\tau\in B,x\right]" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>[</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>log</mi><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>τ</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="true">|</mo><mi>τ</mi><mo>∈</mo><mi>B</mi><mo>,</mo><mi>x</mi><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\!\left[\nabla_{\theta}\log p_{\theta}(\tau\mid x)\;\middle|\;\tau\in B,x\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex39X.m3" class="ltx_Math" alttext="\displaystyle=\sum_{\tau\in B}p_{\theta}(\tau\mid x,\tau\in B)\,\nabla_{\theta}\log p_{\theta}(\tau\mid x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow></munder></mstyle><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>x</mi><mo>,</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\tau\in B}p_{\theta}(\tau\mid x,\tau\in B)\,\nabla_{\theta}\log p_{\theta}(\tau\mid x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex39Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex39Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{Z(\theta;x)}\sum_{\tau\in B}p_{\theta}(\tau\mid x)\,\nabla_{\theta}\log p_{\theta}(\tau\mid x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow></munder></mstyle><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{Z(\theta;x)}\sum_{\tau\in B}p_{\theta}(\tau\mid x)\,\nabla_{\theta}\log p_{\theta}(\tau\mid x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex39Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex39Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{Z(\theta;x)}\sum_{\tau\in B}\nabla_{\theta}p_{\theta}(\tau\mid x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow></munder></mstyle><mrow><mrow><msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{Z(\theta;x)}\sum_{\tau\in B}\nabla_{\theta}p_{\theta}(\tau\mid x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex39Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex39Xc.m2" class="ltx_Math" alttext="\displaystyle=\frac{\nabla_{\theta}Z(\theta;x)}{Z(\theta;x)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi>Z</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\nabla_{\theta}Z(\theta;x)}{Z(\theta;x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex39Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex39Xd.m2" class="ltx_Math" alttext="\displaystyle=\nabla_{\theta}\log Z(\theta;x)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\nabla_{\theta}\log Z(\theta;x),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p2.3" class="ltx_p"><span id="A2.SS4.p2.3.1" class="ltx_text">where the sum can be replaced by an integral if <math id="A2.SS4.p2.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is continuous. This proves the stated identity.
The final claim about vanishing follows immediately.
∎</span></p>
</div>
</div>
<div id="Thmremark2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark2.2" class="ltx_text ltx_font_bold">Remark 2</span></span><span id="Thmremark2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmremark2.p1" class="ltx_para">
<p id="Thmremark2.p1.1" class="ltx_p"><span id="Thmremark2.p1.1.1" class="ltx_text ltx_font_italic">The identity above does <em id="Thmremark2.p1.1.1.1" class="ltx_emph ltx_font_upright">not</em> imply the conditional expectation is zero
unless <math id="Thmremark2.p1.m1" class="ltx_Math" alttext="\Pr_{\theta}(\tau\in B\mid x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pr</mi><mi>θ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>∈</mo><mi>B</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Pr_{\theta}(\tau\in B\mid x)</annotation></semantics></math> is independent of <math id="Thmremark2.p1.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>.
If the stratum <math id="Thmremark2.p1.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> depends on <math id="Thmremark2.p1.m4" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> (i.e., <math id="Thmremark2.p1.m5" class="ltx_Math" alttext="B=B(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B=B(\theta)</annotation></semantics></math>), differentiating
<math id="Thmremark2.p1.m6" class="ltx_Math" alttext="\Pr_{\theta}(\tau\in B(\theta)\mid x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Pr</mi><mi>θ</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Pr_{\theta}(\tau\in B(\theta)\mid x)</annotation></semantics></math> introduces additional terms due to the moving
support; the above proof assumes <math id="Thmremark2.p1.m7" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is fixed.</span></p>
</div>
</div>
<div id="Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma 2</span></span><span id="Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Conditional Advantage–Score Identity)<span id="Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma2.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma2.p1.1" class="ltx_p"><span id="Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">For any stratum <math id="Thmlemma2.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, the following identity holds:</span></p>
<table id="A2.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E13.m1" class="ltx_Math" alttext="\mathbb{E}_{\theta}\big[(R(\tau)-\mu_{k}(\theta))\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\;\big|\;S=k\big]=\nabla_{\theta}\mu_{k}(\theta)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.447em" stretchy="true">|</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\theta}\big[(R(\tau)-\mu_{k}(\theta))\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\;\big|\;S=k\big]=\nabla_{\theta}\mu_{k}(\theta),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="Thmlemma2.p1.2" class="ltx_p"><span id="Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma2.p1.m2" class="ltx_Math" alttext="\mu_{k}(\theta)\coloneqq\mathbb{E}_{\theta}[R(\tau)\mid S=k]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{k}(\theta)\coloneqq\mathbb{E}_{\theta}[R(\tau)\mid S=k]</annotation></semantics></math> is the mean reward in stratum <math id="Thmlemma2.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS4.p3" class="ltx_para">
<p id="A2.SS4.p3.1" class="ltx_p"><span id="A2.SS4.p3.1.1" class="ltx_text">This identity is a standard result from policy gradient theory, derived by applying the log-derivative trick to the gradient of an expectation and introducing the stratum mean <math id="A2.SS4.p3.m1" class="ltx_Math" alttext="\mu_{k}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{k}(\theta)</annotation></semantics></math> as a variance-reducing baseline. For detailed derivations, see the original REINFORCE paper by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib30" title="" class="ltx_ref">Williams (1992)</a></cite> and the textbook treatment in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib24" title="" class="ltx_ref">Sutton &amp; Barto (2018)</a></cite>.
∎</span></p>
</div>
</div>
<div id="A2.SS4.p4" class="ltx_para ltx_noindent">
<p id="A2.SS4.p4.1" class="ltx_p">Next, we give a proof of <a href="#Thmtheorem3" title="Theorem 3 (Population SAN Expectation). ‣ The Gradient Bias Trade-off. ‣ 2.3 Stratified Advantage Normalization: Definition and Theoretical Guarantees ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3</span></a>:</p>
</div>
<div id="A2.SS4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS4.p5" class="ltx_para ltx_noindent">
<p id="A2.SS4.p5.1" class="ltx_p"><span id="A2.SS4.p5.1.1" class="ltx_text">We prove the identity by first applying the law of total expectation to decompose the total expectation over the strata <math id="A2.SS4.p5.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>:</span></p>
<table id="A2.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex40.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\theta}\big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\big]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\theta}\big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex40.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k}\mathbb{E}_{\theta}\big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\,\mathbf{1}_{S=k}\big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k}\mathbb{E}_{\theta}\big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\,\mathbf{1}_{S=k}\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E14.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k}p_{k}(\theta)\,\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\,\big|\,S=k\Big]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k}p_{k}(\theta)\,\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\,\big|\,S=k\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p5.2" class="ltx_p"><span id="A2.SS4.p5.2.1" class="ltx_text">Now, we analyze the conditional expectation for a single stratum <math id="A2.SS4.p5.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. The key is to decompose the score function using the chain rule of probability, <math id="A2.SS4.p5.m3" class="ltx_Math" alttext="p_{\theta}(\tau)=p_{\theta}(\tau\mid S=k)\,p_{k}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(\tau)=p_{\theta}(\tau\mid S=k)\,p_{k}(\theta)</annotation></semantics></math>. Taking the log-gradient gives the identity:</span></p>
<table id="A2.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex41.m1" class="ltx_Math" alttext="\nabla_{\theta}\log p_{\theta}(\tau)=\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)+\nabla_{\theta}\log p_{k}(\theta)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\log p_{\theta}(\tau)=\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)+\nabla_{\theta}\log p_{k}(\theta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p5.3" class="ltx_p"><span id="A2.SS4.p5.3.1" class="ltx_text">Substituting this into the conditional expectation allows us to split it into two terms by linearity:</span></p>
<table id="A2.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex42.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\,\big|\,S=k\Big]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\,\big|\,S=k\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex43.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad=\underbrace{\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\,\big|\,S=k\Big]}_{\text{Term 1: Conditional Score Part}}+\underbrace{\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{k}(\theta)\,\big|\,S=k\Big]}_{\text{Term 2: Marginal Score Part}}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><munder accentunder="true"><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mtext>Term 1: Conditional Score Part</mtext></msub><mo>+</mo><munder accentunder="true"><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mtext>Term 2: Marginal Score Part</mtext></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad=\underbrace{\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\,\big|\,S=k\Big]}_{\text{Term 1: Conditional Score Part}}+\underbrace{\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{k}(\theta)\,\big|\,S=k\Big]}_{\text{Term 2: Marginal Score Part}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p5.4" class="ltx_p"><span id="A2.SS4.p5.4.1" class="ltx_text">We analyze each term separately.</span></p>
</div>
</div>
<section id="A2.SS4.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Term 2 (Marginal Score Part).</h4>

<div id="A2.SS4.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS0.Px1.p1.1" class="ltx_p">The term <math id="A2.SS4.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\nabla_{\theta}\log p_{k}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\log p_{k}(\theta)</annotation></semantics></math> depends only on the stratum index <math id="A2.SS4.SSS0.Px1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and the parameter <math id="A2.SS4.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, so it is a constant with respect to the expectation conditional on <math id="A2.SS4.SSS0.Px1.p1.m4" class="ltx_Math" alttext="S=k" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">S=k</annotation></semantics></math>. We can therefore factor it out:</p>
<table id="A2.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex44.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{k}(\theta)\,\big|\,S=k\Big]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{k}(\theta)\,\big|\,S=k\Big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex44.m2" class="ltx_Math" alttext="\displaystyle=\left(\nabla_{\theta}\log p_{k}(\theta)\right)\cdot\mathbb{E}_{\theta}[A_{\mathrm{SAN}}(\tau)\mid S=k]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\nabla_{\theta}\log p_{k}(\theta)\right)\cdot\mathbb{E}_{\theta}[A_{\mathrm{SAN}}(\tau)\mid S=k]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex45.m1" class="ltx_Math" alttext="\displaystyle=\left(\nabla_{\theta}\log p_{k}(\theta)\right)\cdot\frac{\mathbb{E}_{\theta}[R(\tau)-\mu_{k}(\theta)\mid S=k]}{\sigma_{k}(\theta)+\varepsilon}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\nabla_{\theta}\log p_{k}(\theta)\right)\cdot\frac{\mathbb{E}_{\theta}[R(\tau)-\mu_{k}(\theta)\mid S=k]}{\sigma_{k}(\theta)+\varepsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex46.m1" class="ltx_Math" alttext="\displaystyle=\left(\nabla_{\theta}\log p_{k}(\theta)\right)\cdot\frac{\mu_{k}(\theta)-\mu_{k}(\theta)}{\sigma_{k}(\theta)+\varepsilon}=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\nabla_{\theta}\log p_{k}(\theta)\right)\cdot\frac{\mu_{k}(\theta)-\mu_{k}(\theta)}{\sigma_{k}(\theta)+\varepsilon}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS0.Px1.p1.2" class="ltx_p">Thus, the second term vanishes exactly. This is the crucial step where the structural part of the gradient is eliminated.</p>
</div>
</section>
<section id="A2.SS4.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Term 1 (Conditional Score Part).</h4>

<div id="A2.SS4.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS0.Px2.p1.1" class="ltx_p">For this term, we substitute the definition of <math id="A2.SS4.SSS0.Px2.p1.m1" class="ltx_Math" alttext="A_{\mathrm{SAN}}(\tau)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{\mathrm{SAN}}(\tau)</annotation></semantics></math>, noting that conditional on <math id="A2.SS4.SSS0.Px2.p1.m2" class="ltx_Math" alttext="S=k" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">S=k</annotation></semantics></math>, <math id="A2.SS4.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\mu_{S}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{S}(\theta)</annotation></semantics></math> becomes the constant <math id="A2.SS4.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\mu_{k}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{k}(\theta)</annotation></semantics></math>:</p>
<table id="A2.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex47.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\,\big|\,S=k\Big]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\theta}\Big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\,\big|\,S=k\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex48.m1" class="ltx_Math" alttext="\displaystyle\qquad=\mathbb{E}_{\theta}\left[\frac{R(\tau)-\mu_{k}(\theta)}{\sigma_{k}(\theta)+\varepsilon}\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\,\middle|\,S=k\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="2.278em">=</mo><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0.170em" stretchy="true">|</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad=\mathbb{E}_{\theta}\left[\frac{R(\tau)-\mu_{k}(\theta)}{\sigma_{k}(\theta)+\varepsilon}\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\,\middle|\,S=k\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49.m1" class="ltx_Math" alttext="\displaystyle\qquad=\frac{1}{\sigma_{k}(\theta)+\varepsilon}\,\mathbb{E}_{\theta}\Big[(R(\tau)-\mu_{k}(\theta))\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\,\big|\,S=k\Big]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="2.278em">=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.337em" stretchy="true">|</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad=\frac{1}{\sigma_{k}(\theta)+\varepsilon}\,\mathbb{E}_{\theta}\Big[(R(\tau)-\mu_{k}(\theta))\,\nabla_{\theta}\log p_{\theta}(\tau\mid S=k)\,\big|\,S=k\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS0.Px2.p1.2" class="ltx_p">The remaining expectation is precisely the Conditional Advantage–Score Identity (<a href="#Thmlemma2" title="Lemma 2 (Conditional Advantage–Score Identity). ‣ B.4 Proof of ‣ Appendix B Proofs of Theoretical Results ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2</span></a>), which equals <math id="A2.SS4.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\nabla_{\theta}\mu_{k}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\mu_{k}(\theta)</annotation></semantics></math>. Therefore, the first term equals:</p>
<table id="A2.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex50.m1" class="ltx_Math" alttext="\frac{1}{\sigma_{k}(\theta)+\varepsilon}\,\nabla_{\theta}\mu_{k}(\theta)." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac><mo lspace="0.337em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{\sigma_{k}(\theta)+\varepsilon}\,\nabla_{\theta}\mu_{k}(\theta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A2.SS4.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Conclusion.</h4>

<div id="A2.SS4.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS0.Px3.p1.1" class="ltx_p">Substituting the results for Term 1 and Term 2 back into the original sum over strata, we obtain the final result:</p>
<table id="A2.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex51.m1" class="ltx_Math" alttext="\mathbb{E}_{\theta}\big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\big]=\sum_{k}p_{k}(\theta)\left(\frac{1}{\sigma_{k}(\theta)+\varepsilon}\,\nabla_{\theta}\mu_{k}(\theta)+0\right)=\sum_{k}\frac{p_{k}(\theta)}{\sigma_{k}(\theta)+\varepsilon}\,\nabla_{\theta}\mu_{k}(\theta)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mn>1</mn><mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac><mo lspace="0.337em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>0</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder><mrow><mfrac><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac><mo lspace="0.337em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\theta}\big[A_{\mathrm{SAN}}(\tau)\,\nabla_{\theta}\log p_{\theta}(\tau)\big]=\sum_{k}p_{k}(\theta)\left(\frac{1}{\sigma_{k}(\theta)+\varepsilon}\,\nabla_{\theta}\mu_{k}(\theta)+0\right)=\sum_{k}\frac{p_{k}(\theta)}{\sigma_{k}(\theta)+\varepsilon}\,\nabla_{\theta}\mu_{k}(\theta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS0.Px3.p1.2" class="ltx_p">This completes the proof.
∎</p>
</div>
</section>
</section>
<section id="A2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.5 </span>Proof of <a href="#Thmproposition3" title="Proposition 3 (Exact Advantage Decomposition). ‣ The Structural Flaw in Global Normalization. ‣ 2.4 Structural Comparison of SAN and Global Normalization ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="A2.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS5.p1" class="ltx_para">
<p id="A2.SS5.p1.1" class="ltx_p"><span id="A2.SS5.p1.1.1" class="ltx_text">The proof follows from direct algebraic manipulation. We start from the right-hand side (RHS) and substitute the definitions of <math id="A2.SS5.p1.m1" class="ltx_Math" alttext="\alpha_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{k}(x)</annotation></semantics></math>, <math id="A2.SS5.p1.m2" class="ltx_Math" alttext="A_{\mathrm{SAN}}(\tau_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{\mathrm{SAN}}(\tau_{i})</annotation></semantics></math>, and <math id="A2.SS5.p1.m3" class="ltx_Math" alttext="\Delta_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta_{k}(x)</annotation></semantics></math>:</span></p>
<table id="A2.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="A2.Ex52.1.1" class="ltx_text ltx_markedasmath">RHS</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex52.m2" class="ltx_Math" alttext="\displaystyle=\alpha_{k}(x)\cdot A_{\mathrm{SAN}}(\tau_{i})+\Delta_{k}(x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>A</mi><mi>SAN</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha_{k}(x)\cdot A_{\mathrm{SAN}}(\tau_{i})+\Delta_{k}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="3"></td></tr></tbody>
<tbody id="A2.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex53.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\widehat{\sigma}_{k}(x)+\varepsilon}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}\right)\cdot\left(\frac{R(\tau_{i})-\widehat{\mu}_{k}(x)}{\widehat{\sigma}_{k}(x)+\varepsilon}\right)+\left(\frac{\widehat{\mu}_{k}(x)-\bar{R}_{\mathrm{global}}(x)}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\widehat{\sigma}_{k}(x)+\varepsilon}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}\right)\cdot\left(\frac{R(\tau_{i})-\widehat{\mu}_{k}(x)}{\widehat{\sigma}_{k}(x)+\varepsilon}\right)+\left(\frac{\widehat{\mu}_{k}(x)-\bar{R}_{\mathrm{global}}(x)}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="A2.Ex53.5.1" class="ltx_text ltx_markedasmath">(by definition)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex54.m1" class="ltx_Math" alttext="\displaystyle=\frac{R(\tau_{i})-\widehat{\mu}_{k}(x)}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}+\frac{\widehat{\mu}_{k}(x)-\bar{R}_{\mathrm{global}}(x)}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{R(\tau_{i})-\widehat{\mu}_{k}(x)}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}+\frac{\widehat{\mu}_{k}(x)-\bar{R}_{\mathrm{global}}(x)}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="A2.Ex54.5.1" class="ltx_text ltx_markedasmath">(cancel <math id="A2.Ex54.m2.m1" class="ltx_Math" alttext="(\widehat{\sigma}_{k}(x)+\varepsilon)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\widehat{\sigma}_{k}(x)+\varepsilon)</annotation></semantics></math>)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex55.m1" class="ltx_Math" alttext="\displaystyle=\frac{(R(\tau_{i})-\widehat{\mu}_{k}(x))+(\widehat{\mu}_{k}(x)-\bar{R}_{\mathrm{global}}(x))}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(R(\tau_{i})-\widehat{\mu}_{k}(x))+(\widehat{\mu}_{k}(x)-\bar{R}_{\mathrm{global}}(x))}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="A2.Ex55.5.1" class="ltx_text ltx_markedasmath">(combine terms)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex56.m1" class="ltx_Math" alttext="\displaystyle=\frac{R(\tau_{i})-\bar{R}_{\mathrm{global}}(x)}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>global</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ε</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{R(\tau_{i})-\bar{R}_{\mathrm{global}}(x)}{\widehat{\sigma}_{\mathrm{global}}(x)+\varepsilon}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="A2.Ex56.5.1" class="ltx_text ltx_markedasmath">(cancel <math id="A2.Ex56.m2.m1" class="ltx_Math" alttext="\widehat{\mu}_{k}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mu}_{k}(x)</annotation></semantics></math>)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex57.m1" class="ltx_Math" alttext="\displaystyle=A_{\mathrm{GN}}(\tau_{i})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>A</mi><mi>GN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=A_{\mathrm{GN}}(\tau_{i}).</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex57.m2" class="ltx_Math" alttext="\displaystyle\text{(definition of $A_{\mathrm{GN}}$)}\qed" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>(definition of </mtext><msub><mi>A</mi><mi>GN</mi></msub><mtext>)</mtext></mrow><mo class="ltx_mathvariant_italic" lspace="0em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{(definition of $A_{\mathrm{GN}}$)}\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
<section id="A2.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.6 </span>Proof of <a href="#Thmtheorem4" title="Theorem 4 (Conditional Properties of SAN and GN Advantages). ‣ Analysis as a Signal Carrier. ‣ 2.4 Structural Comparison of SAN and Global Normalization ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4</span></a></h3>

<div id="A2.SS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS6.p1" class="ltx_para ltx_noindent">
<p id="A2.SS6.p1.1" class="ltx_p"><span id="A2.SS6.p1.1.1" class="ltx_text">The proof proceeds by direct calculation of the conditional expectation and variance for each estimator in the large-sample limit. All quantities are conditioned on a fixed prompt <math id="A2.SS6.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS6.p2" class="ltx_para ltx_noindent">
<p id="A2.SS6.p2.1" class="ltx_p"><span id="A2.SS6.p2.1.1" class="ltx_text">First, we prove the results for <math id="A2.SS6.p2.m1" class="ltx_Math" alttext="A_{\mathrm{SAN}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>SAN</mi></msub><annotation encoding="application/x-tex">A_{\mathrm{SAN}}</annotation></semantics></math>. The SAN advantage for a trajectory <math id="A2.SS6.p2.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> in stratum <math id="A2.SS6.p2.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is defined as <math id="A2.SS6.p2.m4" class="ltx_Math" alttext="A_{\mathrm{SAN}}(\tau)=\frac{R(\tau)-\mu_{k}}{\sigma_{k}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow><msub><mi>σ</mi><mi>k</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">A_{\mathrm{SAN}}(\tau)=\frac{R(\tau)-\mu_{k}}{\sigma_{k}}</annotation></semantics></math> (ignoring <math id="A2.SS6.p2.m5" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math> for clarity in the limit).
By the linearity of expectation,</span></p>
<table id="A2.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex58.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[A_{\mathrm{SAN}}(\tau)\mid k,x]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>SAN</mi></msub><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[A_{\mathrm{SAN}}(\tau)\mid k,x]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex58.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[\frac{R(\tau)-\mu_{k}}{\sigma_{k}}\;\middle|\;k,x\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow><msub><mi>σ</mi><mi>k</mi></msub></mfrac></mstyle><mo stretchy="true">|</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{R(\tau)-\mu_{k}}{\sigma_{k}}\;\middle|\;k,x\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex59.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{\sigma_{k}}\big(\mathbb{E}[R(\tau)\mid k,x]-\mu_{k}\big)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>σ</mi><mi>k</mi></msub></mfrac></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><msub><mi>μ</mi><mi>k</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma_{k}}\big(\mathbb{E}[R(\tau)\mid k,x]-\mu_{k}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex60.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sigma_{k}}(\mu_{k}-\mu_{k})=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>σ</mi><mi>k</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo>−</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma_{k}}(\mu_{k}-\mu_{k})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p2.2" class="ltx_p"><span id="A2.SS6.p2.2.1" class="ltx_text">This shows that SAN is an unbiased signal carrier within each stratum. Next, by the properties of variance, <math id="A2.SS6.p2.m6" class="ltx_Math" alttext="\operatorname{Var}(cX+d)=c^{2}\operatorname{Var}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Var}(cX+d)=c^{2}\operatorname{Var}(X)</annotation></semantics></math>,</span></p>
<table id="A2.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex61.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}(A_{\mathrm{SAN}}(\tau)\mid k,x)" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>k</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}(A_{\mathrm{SAN}}(\tau)\mid k,x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex61.m2" class="ltx_math_unparsed" alttext="\displaystyle=\operatorname{Var}\left(\frac{R(\tau)-\mu_{k}}{\sigma_{k}}\;\middle|\;k,x\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>Var</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow><msub><mi>σ</mi><mi>k</mi></msub></mfrac></mstyle><mo stretchy="true">|</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Var}\left(\frac{R(\tau)-\mu_{k}}{\sigma_{k}}\;\middle|\;k,x\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex62.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sigma_{k}^{2}}\operatorname{Var}(R(\tau)-\mu_{k}\mid k,x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>k</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma_{k}^{2}}\operatorname{Var}(R(\tau)-\mu_{k}\mid k,x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex63.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sigma_{k}^{2}}\operatorname{Var}(R(\tau)\mid k,x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>k</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma_{k}^{2}}\operatorname{Var}(R(\tau)\mid k,x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex64.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sigma_{k}^{2}}{\sigma_{k}^{2}}=1." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sigma_{k}^{2}}{\sigma_{k}^{2}}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p2.3" class="ltx_p"><span id="A2.SS6.p2.3.1" class="ltx_text">This shows that SAN provides a consistently scaled (unit variance) carrier in every stratum.</span></p>
</div>
<div id="A2.SS6.p3" class="ltx_para ltx_noindent">
<p id="A2.SS6.p3.1" class="ltx_p"><span id="A2.SS6.p3.1.1" class="ltx_text">Second, we prove the results for <math id="A2.SS6.p3.m1" class="ltx_Math" alttext="A_{\mathrm{GN}}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>GN</mi></msub><annotation encoding="application/x-tex">A_{\mathrm{GN}}</annotation></semantics></math>.
The GN advantage is defined as <math id="A2.SS6.p3.m2" class="ltx_Math" alttext="A_{\mathrm{GN}}(\tau)=\frac{R(\tau)-\mu}{\sigma}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>GN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>μ</mi></mrow><mi>σ</mi></mfrac></mrow><annotation encoding="application/x-tex">A_{\mathrm{GN}}(\tau)=\frac{R(\tau)-\mu}{\sigma}</annotation></semantics></math>. So</span></p>
<table id="A2.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex65.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[A_{\mathrm{GN}}(\tau)\mid k,x]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>GN</mi></msub><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[A_{\mathrm{GN}}(\tau)\mid k,x]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex65.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[\frac{R(\tau)-\mu}{\sigma}\;\middle|\;k,x\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>μ</mi></mrow><mi>σ</mi></mfrac></mstyle><mo stretchy="true">|</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{R(\tau)-\mu}{\sigma}\;\middle|\;k,x\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex66.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{\sigma}\big(\mathbb{E}[R(\tau)\mid k,x]-\mu\big)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>σ</mi></mfrac></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>μ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma}\big(\mathbb{E}[R(\tau)\mid k,x]-\mu\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex67.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mu_{k}-\mu}{\sigma}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo>−</mo><mi>μ</mi></mrow><mi>σ</mi></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mu_{k}-\mu}{\sigma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p3.2" class="ltx_p"><span id="A2.SS6.p3.2.1" class="ltx_text">This is generally non-zero whenever stratum means differ (<math id="A2.SS6.p3.m3" class="ltx_Math" alttext="\mu_{k}\neq\mu" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo>≠</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">\mu_{k}\neq\mu</annotation></semantics></math>), which confirms that GN is a biased carrier within the stratum. This non-zero expectation represents a spurious signal. Next,</span></p>
<table id="A2.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex68.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}(A_{\mathrm{GN}}(\tau)\mid k,x)" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>A</mi><mi>GN</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>k</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}(A_{\mathrm{GN}}(\tau)\mid k,x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex68.m2" class="ltx_math_unparsed" alttext="\displaystyle=\operatorname{Var}\left(\frac{R(\tau)-\mu}{\sigma}\;\middle|\;k,x\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>Var</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>μ</mi></mrow><mi>σ</mi></mfrac></mstyle><mo stretchy="true">|</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Var}\left(\frac{R(\tau)-\mu}{\sigma}\;\middle|\;k,x\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex69.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sigma^{2}}\operatorname{Var}(R(\tau)-\mu\mid k,x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>σ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>μ</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>k</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma^{2}}\operatorname{Var}(R(\tau)-\mu\mid k,x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex70.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sigma^{2}}\operatorname{Var}(R(\tau)\mid k,x)=\frac{\sigma_{k}^{2}}{\sigma^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>σ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>k</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><msup><mi>σ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma^{2}}\operatorname{Var}(R(\tau)\mid k,x)=\frac{\sigma_{k}^{2}}{\sigma^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p3.3" class="ltx_p"><span id="A2.SS6.p3.3.1" class="ltx_text">This shows that the variance of the GN carrier is not consistent across strata; it depends on the ratio of the stratum’s variance to the global variance.</span></p>
</div>
<div id="A2.SS6.p4" class="ltx_para">
<p id="A2.SS6.p4.1" class="ltx_p"><span id="A2.SS6.p4.1.1" class="ltx_text">The analysis of the conditional statistics reveals the structural superiority of SAN. Within any given stratum, SAN provides a zero-mean, unit-variance signal carrier, which serves as a pure and consistent baseline for the policy gradient calculation. GN, in contrast, introduces a spurious signal (a non-zero mean) and has an inconsistent variance, making it a biased and less reliable signal carrier. This completes the proof. ∎</span></p>
</div>
</div>
</section>
<section id="A2.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.7 </span>Proof of <a href="#Thmtheorem5" title="Theorem 5 (Global Moments of SAN and GN). ‣ Analysis as a Signal Carrier. ‣ 2.4 Structural Comparison of SAN and Global Normalization ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5</span></a></h3>

<div id="A2.SS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS7.p1" class="ltx_para ltx_noindent">
<p id="A2.SS7.p1.1" class="ltx_p"><span id="A2.SS7.p1.1.1" class="ltx_text ltx_font_bold">For (a)<span id="A2.SS7.p1.1.1.1" class="ltx_text ltx_font_medium">, applying the law of total expectation,</span></span></p>
<table id="A2.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex71.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[A_{\mathrm{SAN}}\mid x]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[A_{\mathrm{SAN}}\mid x]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex71.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{k}p_{k}(x)\,\mathbb{E}\!\left[\frac{R-\mu_{k}(x)}{\sigma_{k}(x)}\,\Big|\,S{=}k,x\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><msub><mi>p</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>R</mi><mo>−</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo fence="false" lspace="0.170em" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><mi>S</mi><mo>=</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k}p_{k}(x)\,\mathbb{E}\!\left[\frac{R-\mu_{k}(x)}{\sigma_{k}(x)}\,\Big|\,S{=}k,x\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex72.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k}p_{k}(x)\,\frac{\mathbb{E}[R-\mu_{k}(x)\mid S{=}k,x]}{\sigma_{k}(x)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>R</mi><mo>−</mo><mi>μ</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><mo>=</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k}p_{k}(x)\,\frac{\mathbb{E}[R-\mu_{k}(x)\mid S{=}k,x]}{\sigma_{k}(x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex73.m1" class="ltx_Math" alttext="\displaystyle=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex74.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[A_{\mathrm{GN}}\mid x]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>A</mi><mi>GN</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[A_{\mathrm{GN}}\mid x]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex74.m2" class="ltx_Math" alttext="\displaystyle=\frac{\mathbb{E}[R\mid x]-\mu(x)}{\sigma(x)}=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbb{E}[R\mid x]-\mu(x)}{\sigma(x)}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS7.p2" class="ltx_para ltx_noindent">
<p id="A2.SS7.p2.1" class="ltx_p"><span id="A2.SS7.p2.1.1" class="ltx_text ltx_font_bold">For (b)<span id="A2.SS7.p2.1.1.1" class="ltx_text ltx_font_medium">, by the law of total variance,</span></span></p>
<table id="A2.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex75.m1" class="ltx_math_unparsed" alttext="\operatorname{Var}(A_{\mathrm{SAN}}\mid x)=\mathbb{E}\!\left[\operatorname{Var}(A_{\mathrm{SAN}}\mid S,x)\right]+\operatorname{Var}\!\left(\mathbb{E}[A_{\mathrm{SAN}}\mid S,x]\right)." display="block" intent=":literal"><semantics><mrow><mi>Var</mi><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mrow><mo>[</mo><mi>Var</mi><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>+</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mrow><mo>(</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><mo>,</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}(A_{\mathrm{SAN}}\mid x)=\mathbb{E}\!\left[\operatorname{Var}(A_{\mathrm{SAN}}\mid S,x)\right]+\operatorname{Var}\!\left(\mathbb{E}[A_{\mathrm{SAN}}\mid S,x]\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.p2.2" class="ltx_p"><span id="A2.SS7.p2.2.1" class="ltx_text">We now analyze each of the two terms in the right-hand side separately.</span></p>
</div>
<div id="A2.SS7.p3" class="ltx_para ltx_noindent">
<p id="A2.SS7.p3.1" class="ltx_p"><span id="A2.SS7.p3.1.1" class="ltx_text">From Theorem <a href="#Thmtheorem4" title="Theorem 4 (Conditional Properties of SAN and GN Advantages). ‣ Analysis as a Signal Carrier. ‣ 2.4 Structural Comparison of SAN and Global Normalization ‣ 2 Methods ‣ Stratified GRPO: Handling Structural Heterogeneity in Reinforcement Learning of LLM Search Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we know that the idealized SAN advantage is conditionally unbiased in every stratum:</span></p>
<table id="A2.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex76.m1" class="ltx_math_unparsed" alttext="\mathbb{E}[A_{\mathrm{SAN}}\mid S=k,x]=0,\quad\text{for all strata }k." display="block" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><mo>=</mo><mi>k</mi><mo>,</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn><mo rspace="1.167em">,</mo><mtext>for all strata </mtext><mi>k</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[A_{\mathrm{SAN}}\mid S=k,x]=0,\quad\text{for all strata }k.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.p3.2" class="ltx_p"><span id="A2.SS7.p3.2.1" class="ltx_text">Since the conditional expectation is a constant (zero) regardless of the stratum <math id="A2.SS7.p3.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, its variance is zero:</span></p>
<table id="A2.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex77.m1" class="ltx_math_unparsed" alttext="\operatorname{Var}\!\left(\mathbb{E}[A_{\mathrm{SAN}}\mid S,x]\right)=\operatorname{Var}(0)=0." display="block" intent=":literal"><semantics><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mrow><mo>(</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><mo>,</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo>=</mo><mi>Var</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}\!\left(\mathbb{E}[A_{\mathrm{SAN}}\mid S,x]\right)=\operatorname{Var}(0)=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS7.p4" class="ltx_para ltx_noindent">
<p id="A2.SS7.p4.1" class="ltx_p"><span id="A2.SS7.p4.1.1" class="ltx_text">Next, we evaluate the first term, which is the expected variance within strata. We start with the inner term, the variance conditional on a specific stratum <math id="A2.SS7.p4.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>:</span></p>
<table id="A2.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex78.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}(A_{\mathrm{SAN}}\mid S=k,x)" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}(A_{\mathrm{SAN}}\mid S=k,x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex78.m2" class="ltx_Math" alttext="\displaystyle=\operatorname{Var}\left(\frac{R-\mu_{k}(x)}{\sigma_{k}(x)}\,\Bigg|\,k,x\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>R</mi><mo>−</mo><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.170em" mathsize="2.600em" rspace="0.170em">|</mo><mrow><mi>k</mi><mo>,</mo><mi>x</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Var}\left(\frac{R-\mu_{k}(x)}{\sigma_{k}(x)}\,\Bigg|\,k,x\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex79.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sigma^{2}_{k}(x)}\operatorname{Var}(R\mid k,x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>k</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma^{2}_{k}(x)}\operatorname{Var}(R\mid k,x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sigma_{k}^{2}(x)}{\sigma^{2}_{k}(x)}=1." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sigma_{k}^{2}(x)}{\sigma^{2}_{k}(x)}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.p4.2" class="ltx_p"><span id="A2.SS7.p4.2.1" class="ltx_text">Now, we take the expectation of this quantity over the random stratum <math id="A2.SS7.p4.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. This is equivalent to a weighted average over all strata, where the weights are the probabilities <math id="A2.SS7.p4.m3" class="ltx_Math" alttext="p_{k}(x):=P(S=k\mid x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{k}(x):=P(S=k\mid x)</annotation></semantics></math>:</span></p>
<table id="A2.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex81.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\!\left[\operatorname{Var}(A_{\mathrm{SAN}}\mid S,x)\right]" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>S</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\!\left[\operatorname{Var}(A_{\mathrm{SAN}}\mid S,x)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex81.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k}p_{k}(x)\cdot\operatorname{Var}(A_{\mathrm{SAN}}\mid S=k,x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k}p_{k}(x)\cdot\operatorname{Var}(A_{\mathrm{SAN}}\mid S=k,x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex82.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k}p_{k}(x)\frac{\sigma_{k}^{2}(x)}{\sigma^{2}_{k}(x)}=\sum_{k}p_{k}(x)=1." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k}p_{k}(x)\frac{\sigma_{k}^{2}(x)}{\sigma^{2}_{k}(x)}=\sum_{k}p_{k}(x)=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS7.p5" class="ltx_para ltx_noindent">
<p id="A2.SS7.p5.1" class="ltx_p"><span id="A2.SS7.p5.1.1" class="ltx_text">Finally, we add the two components back together:</span></p>
<table id="A2.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex83.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}(A_{\mathrm{SAN}}\mid x)" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}(A_{\mathrm{SAN}}\mid x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex83.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\!\left[\operatorname{Var}(A_{\mathrm{SAN}}\mid S,x)\right]+\operatorname{Var}\!\left(\mathbb{E}[A_{\mathrm{SAN}}\mid S,x]\right)=1+0=1." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mrow><mo>[</mo><mi>Var</mi><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>+</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mrow><mo>(</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>A</mi><mi>SAN</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><mo>,</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo>=</mo><mn>1</mn><mo>+</mo><mn>0</mn><mo>=</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\!\left[\operatorname{Var}(A_{\mathrm{SAN}}\mid S,x)\right]+\operatorname{Var}\!\left(\mathbb{E}[A_{\mathrm{SAN}}\mid S,x]\right)=1+0=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS7.p6" class="ltx_para ltx_noindent">
<p id="A2.SS7.p6.1" class="ltx_p"><span id="A2.SS7.p6.1.1" class="ltx_text">For <math id="A2.SS7.p6.m1" class="ltx_Math" alttext="\mathrm{GN}" display="inline" intent=":literal"><semantics><mi>GN</mi><annotation encoding="application/x-tex">\mathrm{GN}</annotation></semantics></math>, since <math id="A2.SS7.p6.m2" class="ltx_Math" alttext="A_{\mathrm{GN}}=(R-\mu(x))/\sigma(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>GN</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{\mathrm{GN}}=(R-\mu(x))/\sigma(x)</annotation></semantics></math>,</span></p>
<table id="A2.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex84.m1" class="ltx_Math" alttext="\operatorname{Var}(A_{\mathrm{GN}}\mid x)=\frac{\operatorname{Var}(R\mid x)}{\sigma^{2}(x)}=\frac{\sigma^{2}(x)}{\sigma^{2}(x)}=1.\qed" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>GN</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}(A_{\mathrm{GN}}\mid x)=\frac{\operatorname{Var}(R\mid x)}{\sigma^{2}(x)}=\frac{\sigma^{2}(x)}{\sigma^{2}(x)}=1.\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Comparison of Local vs. Global Moments of <math id="A3.m1" class="ltx_Math" alttext="\mathrm{SAN}" display="inline" intent=":literal"><semantics><mi>SAN</mi><annotation encoding="application/x-tex">\mathrm{SAN}</annotation></semantics></math> and <math id="A3.m2" class="ltx_Math" alttext="\mathrm{GN}" display="inline" intent=":literal"><semantics><mi>GN</mi><annotation encoding="application/x-tex">\mathrm{GN}</annotation></semantics></math> Advantages</h2>

<figure id="A3.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 3: </span>Local (conditional on stratum <math id="A3.T3.m10" class="ltx_Math" alttext="S{=}k" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">S{=}k</annotation></semantics></math>) vs. global (marginal over <math id="A3.T3.m11" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>) moments of <math id="A3.T3.m12" class="ltx_Math" alttext="\mathrm{SAN}" display="inline" intent=":literal"><semantics><mi>SAN</mi><annotation encoding="application/x-tex">\mathrm{SAN}</annotation></semantics></math> and <math id="A3.T3.m13" class="ltx_Math" alttext="\mathrm{GN}" display="inline" intent=":literal"><semantics><mi>GN</mi><annotation encoding="application/x-tex">\mathrm{GN}</annotation></semantics></math> advantages. Here <math id="A3.T3.m14" class="ltx_Math" alttext="\sigma_{k}^{2}=\mathrm{Var}(R\mid S{=}k,x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma_{k}^{2}=\mathrm{Var}(R\mid S{=}k,x)</annotation></semantics></math> and <math id="A3.T3.m15" class="ltx_Math" alttext="\sigma^{2}=\mathrm{Var}(R\mid x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma^{2}=\mathrm{Var}(R\mid x)</annotation></semantics></math>. For <math id="A3.T3.m16" class="ltx_Math" alttext="\varepsilon=0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon=0</annotation></semantics></math>, <math id="A3.T3.m17" class="ltx_Math" alttext="\mathrm{SAN}" display="inline" intent=":literal"><semantics><mi>SAN</mi><annotation encoding="application/x-tex">\mathrm{SAN}</annotation></semantics></math> achieves joint standardization (local &amp; global), whereas <math id="A3.T3.m18" class="ltx_Math" alttext="\mathrm{GN}" display="inline" intent=":literal"><semantics><mi>GN</mi><annotation encoding="application/x-tex">\mathrm{GN}</annotation></semantics></math> only standardizes globally.</figcaption>
<table id="A3.T3.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A3.T3.2.1" class="ltx_tr">
<th id="A3.T3.2.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt"></th>
<th id="A3.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T3.2.1.2.1" class="ltx_text ltx_font_bold">Local (given <math id="A3.T3.m19" class="ltx_Math" alttext="S{=}k" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">S{=}k</annotation></semantics></math>)</span></th>
<th id="A3.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T3.2.1.3.1" class="ltx_text ltx_font_bold">Global (marginal over <math id="A3.T3.m20" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A3.T3.2.2" class="ltx_tr">
<th id="A3.T3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T3.m21" class="ltx_Math" alttext="\mathrm{SAN}" display="inline" intent=":literal"><semantics><mi>SAN</mi><annotation encoding="application/x-tex">\mathrm{SAN}</annotation></semantics></math> mean</th>
<td id="A3.T3.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T3.m22" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td>
<td id="A3.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T3.m23" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td></tr>
<tr id="A3.T3.2.3" class="ltx_tr">
<th id="A3.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A3.T3.m24" class="ltx_Math" alttext="\mathrm{SAN}" display="inline" intent=":literal"><semantics><mi>SAN</mi><annotation encoding="application/x-tex">\mathrm{SAN}</annotation></semantics></math> variance</th>
<td id="A3.T3.2.3.2" class="ltx_td ltx_align_center"><math id="A3.T3.m25" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td>
<td id="A3.T3.2.3.3" class="ltx_td ltx_align_center"><math id="A3.T3.m26" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td></tr>
<tr id="A3.T3.2.4" class="ltx_tr">
<th id="A3.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T3.m27" class="ltx_Math" alttext="\mathrm{GN}" display="inline" intent=":literal"><semantics><mi>GN</mi><annotation encoding="application/x-tex">\mathrm{GN}</annotation></semantics></math> mean</th>
<td id="A3.T3.2.4.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T3.m28" class="ltx_Math" alttext="\frac{\mu_{k}-\mu}{\sigma}" display="inline" intent=":literal"><semantics><mfrac><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo>−</mo><mi>μ</mi></mrow><mi>σ</mi></mfrac><annotation encoding="application/x-tex">\frac{\mu_{k}-\mu}{\sigma}</annotation></semantics></math></td>
