<tr id="S4.T4.4.1.3" class="ltx_tr">
<td id="S4.T4.4.1.3.1" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.T4.m5" class="ltx_Math" alttext="\pi_{0}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\pi_{0}</annotation></semantics></math>-FAST-DROID</td>
<td id="S4.T4.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t">41.7</td>
<td id="S4.T4.4.1.3.3" class="ltx_td ltx_align_center ltx_border_t">37.5</td>
<td id="S4.T4.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t">45.8</td>
<td id="S4.T4.4.1.3.5" class="ltx_td ltx_align_center ltx_border_t">25.0</td>
<td id="S4.T4.4.1.3.6" class="ltx_td ltx_align_center ltx_border_t">37.5</td></tr>
<tr id="S4.T4.4.1.4" class="ltx_tr" style="--ltx-bg-color:#F2F2FF;">
