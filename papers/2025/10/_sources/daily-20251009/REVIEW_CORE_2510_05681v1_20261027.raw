<td id="S4.T3.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">56.3</td>
<td id="S4.T3.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">50.0</td>
<td id="S4.T3.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">53.1</td></tr>
<tr id="S4.T3.1.1.3" class="ltx_tr" style="--ltx-bg-color:#F2F2FF;">
