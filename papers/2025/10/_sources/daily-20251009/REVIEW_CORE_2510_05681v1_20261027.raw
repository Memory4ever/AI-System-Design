<td id="A2.T8.4.1.5.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="A2.T8.4.1.5.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2FF;">38.9</span></td>
