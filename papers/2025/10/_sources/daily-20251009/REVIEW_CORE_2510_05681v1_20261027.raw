<td id="S4.T4.4.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S4.T4.4.1.1.3.1" class="ltx_text ltx_font_bold">Average</span></td></tr>
<tr id="S4.T4.4.1.2" class="ltx_tr">
<td id="S4.T4.4.1.2.1" class="ltx_td ltx_align_center ltx_border_t">Box to Bowl</td>
