<td id="A1.T7.2.1.4.3" class="ltx_td ltx_align_center">64</td>
<td id="A1.T7.2.1.4.4" class="ltx_td ltx_align_center ltx_border_r">64</td>
<td id="A1.T7.2.1.4.5" class="ltx_td ltx_align_center ltx_border_r">64</td>
