<td id="A1.T6.2.1.3" class="ltx_td ltx_align_center ltx_border_tt">CLIP FID<math id="A1.T6.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
