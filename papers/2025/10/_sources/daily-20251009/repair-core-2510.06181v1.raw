<td id="S3.T1.2.10.9" class="ltx_td ltx_align_center ltx_border_b"><math id="S3.T1.m64" class="ltx_Math" alttext="1.16" display="inline" intent=":literal"><semantics><mn>1.16</mn><annotation encoding="application/x-tex">1.16</annotation></semantics></math></td></tr>
