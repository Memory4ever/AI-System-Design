<td id="S6.T3.6.14.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.6.14.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#D9D9FF;">34.13</span></td>
<td id="S6.T3.6.14.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.6.14.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#D9D9FF;">43.39</span></td></tr>
<tr id="S6.T3.6.15" class="ltx_tr">
<td id="S6.T3.6.15.1" class="ltx_td ltx_align_left">SmolLM2-360M-Instruct</td>
<td id="S6.T3.6.15.2" class="ltx_td ltx_align_center">21.50</td>
