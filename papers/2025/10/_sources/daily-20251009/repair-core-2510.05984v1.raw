<td id="S3.T1.2.5.6" class="ltx_td ltx_align_center"><math id="S3.T1.m8" class="ltx_Math" alttext="3.81\pm 0.07" display="inline" intent=":literal"><semantics><mrow><mn>3.81</mn><mo>±</mo><mn>0.07</mn></mrow><annotation encoding="application/x-tex">3.81\pm 0.07</annotation></semantics></math></td></tr>
