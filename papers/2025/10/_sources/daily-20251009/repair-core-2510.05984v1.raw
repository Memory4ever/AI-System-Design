<td id="S3.T1.2.8.5" class="ltx_td ltx_align_center">0.0070</td>
<td id="S3.T1.2.8.6" class="ltx_td ltx_align_center"><math id="S3.T1.m11" class="ltx_Math" alttext="4.19\pm 0.09" display="inline" intent=":literal"><semantics><mrow><mn>4.19</mn><mo>±</mo><mn>0.09</mn></mrow><annotation encoding="application/x-tex">4.19\pm 0.09</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.9" class="ltx_tr">
