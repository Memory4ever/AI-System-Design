<td id="S3.T1.2.1.4" class="ltx_td ltx_align_center ltx_border_tt">FD (<math id="S3.T1.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</td>
<td id="S3.T1.2.1.5" class="ltx_td ltx_align_center ltx_border_tt">RTF (<math id="S3.T1.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</td>
