<td id="S3.T1.2.4.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m7" class="ltx_Math" alttext="3.94\pm 0.10" display="inline" intent=":literal"><semantics><mrow><mn>3.94</mn><mo>±</mo><mn>0.10</mn></mrow><annotation encoding="application/x-tex">3.94\pm 0.10</annotation></semantics></math></td></tr>
