</msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>β</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></munderover></mstyle><mrow><msubsup><mi mathvariant="normal">Φ</mi><mi>h</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>h</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{1}{\beta_{\mathcal{N}_{k}+1}}\sum_{i=1}^{\mathcal{N}_{k}}\Phi_{h}^{\top}(s_{ih},a_{ih})\Phi_{h}(s_{ih},a_{ih})+\Sigma_{h}^{*-1}\right)^{-1}(\frac{1}{\beta_{\mathcal{N}_{k}+1}}\sum_{i=1}^{\mathcal{N}_{k}}\Phi_{h}^{\top}(s_{ih},a_{ih})b^{\text{MT}(k)}_{ih}+\Sigma_{h}^{*-1}\widehat{\theta}^{(k)}_{h}),</annotation></semantics></math></td>
