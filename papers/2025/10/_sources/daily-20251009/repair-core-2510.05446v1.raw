<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex18.m1" class="ltx_Math" alttext="\displaystyle\Sigma^{TS}_{nh}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></msubsup><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Sigma^{TS}_{nh}\leftarrow</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex18.m2" class="ltx_Math" alttext="\displaystyle\left(\frac{1}{\beta_{n}}\sum_{i=1}^{n-1}\Phi_{h}^{\top}(s_{ih},a_{ih})\Phi_{h}(s_{ih},a_{ih})+\Sigma_{h}^{*-1}\right)^{-1}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>β</mi><mi>n</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi mathvariant="normal">Φ</mi><mi>h</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><msubsup><mi mathvariant="normal">Σ</mi><mi>h</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></msubsup></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\left(\frac{1}{\beta_{n}}\sum_{i=1}^{n-1}\Phi_{h}^{\top}(s_{ih},a_{ih})\Phi_{h}(s_{ih},a_{ih})+\Sigma_{h}^{*-1}\right)^{-1}</annotation></semantics></math></td>
