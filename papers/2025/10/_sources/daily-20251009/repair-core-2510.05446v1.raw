<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex219.m1" class="ltx_math_unparsed" alttext="\displaystyle\left(\text{REV}_{*}(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}-1)-\text{REV}(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+2,h}^{\text{TS}(k)}\},\{\Sigma_{\mathcal{N}_{k}+2,h}^{\text{MTS}(k)}\},N-\mathcal{N}_{k}-1)\right)\bigg|\mathcal{J}\bigg]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><msub><mtext class="ltx_mathvariant_italic">REV</mtext><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>−</mo><mtext class="ltx_mathvariant_italic">REV</mtext><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">MTS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mi class="ltx_font_mathcaligraphic">𝒥</mi><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\text{REV}_{*}(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}-1)-\text{REV}(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+2,h}^{\text{TS}(k)}\},\{\Sigma_{\mathcal{N}_{k}+2,h}^{\text{MTS}(k)}\},N-\mathcal{N}_{k}-1)\right)\bigg|\mathcal{J}\bigg]</annotation></semantics></math></td>
