<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E13Xa.m2" class="ltx_Math" alttext="\displaystyle\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}]" display="inline" intent=":literal"><semantics><mrow><mtext>REV</mtext><mo>(</mo><mo stretchy="false">{</mo><mi>θ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mo stretchy="false">{</mo><mi>θ</mi><msub><mrow></mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mo stretchy="false">{</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mi>N</mi><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><msub><mrow></mrow><mi>k</mi></msub><mo>)</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E13Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
