            <span id="alg1.l8.3" class="ltx_text ltx_font_bold">while</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="n\leq N" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">n\leq N</annotation></semantics></math> <span id="alg1.l8.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
              Run TSRL(<math id="alg1.l9.m1" class="ltx_Math" alttext="\{\theta^{*}_{h}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\theta^{*}_{h}\}</annotation></semantics></math>,<math id="alg1.l9.m2" class="ltx_Math" alttext="\{\Sigma^{*}_{h}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi mathvariant="normal">Σ</mi><mi>h</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\Sigma^{*}_{h}\}</annotation></semantics></math>, 1)

</div>
