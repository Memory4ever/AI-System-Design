            <span id="alg1.l1.3" class="ltx_text ltx_font_bold">Input:</span> 
</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            Data <math id="alg1.l2.m1" class="ltx_Math" alttext="\left\{\Phi_{1}(s_{i1},a_{i1}),r_{i1},\ldots,\Phi_{H}(s_{iH},a_{iH}),r_{iH}\right\}_{i&lt;n}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><mrow><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>r</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">Φ</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>r</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow></msub></mrow><mo>}</mo></mrow><mrow><mi>i</mi><mo>&lt;</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\left\{\Phi_{1}(s_{i1},a_{i1}),r_{i1},\ldots,\Phi_{H}(s_{iH},a_{iH}),r_{iH}\right\}_{i&lt;n}</annotation></semantics></math>, exploration parameter <math id="alg1.l2.m2" class="ltx_Math" alttext="\lambda_{e}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>e</mi></msub><annotation encoding="application/x-tex">\lambda_{e}</annotation></semantics></math>, prior mean vectors <math id="alg1.l2.m3" class="ltx_Math" alttext="\{\theta^{*}_{h}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\theta^{*}_{h}\}</annotation></semantics></math>,
covariance matrixs <math id="alg1.l2.m4" class="ltx_Math" alttext="\{\Sigma^{*}_{h}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi mathvariant="normal">Σ</mi><mi>h</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\Sigma^{*}_{h}\}</annotation></semantics></math>, epochs’ amounts <math id="alg1.l2.m5" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, and noise parameter <math id="alg1.l2.m6" class="ltx_Math" alttext="\{\beta_{n}\}_{n=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>β</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{\beta_{n}\}_{n=1}^{N}</annotation></semantics></math>, <math id="alg1.l2.m7" class="ltx_Math" alttext="\widetilde{\theta}_{H+1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mrow><mi>H</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{\theta}_{H+1}=0</annotation></semantics></math>.

</div>
