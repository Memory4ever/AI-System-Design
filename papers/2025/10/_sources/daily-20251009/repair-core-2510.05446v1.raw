<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex216.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{E}_{\{\theta_{h}^{(k)}\},\{\widehat{\theta}_{h}^{(k)}\}}\bigg[\max_{\theta:\|\theta-\theta_{nh}^{\text{TS}(k)}\|\leq C}\left(\frac{d\mathcal{N}(\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)},\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MTS}(k)})}{d\mathcal{N}(\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)},\Sigma_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)})}\right)^{H}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><munder><mi>max</mi><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>θ</mi><mo>−</mo><msubsup><mi>θ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>C</mi></mrow></mrow></munder><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">TS</mtext><mo lspace="0em" rspace="0em