</mrow></msup><mo>,</mo><mi>N</mi><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">)</mo><mo>)</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mi class="ltx_font_mathcaligraphic">𝒥</mi><mo maxsize="2.100em" minsize="2.100em">]</mo><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>n</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left(\text{REV}_{*}(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k})-\text{REV}(\{\theta_{h}^{(k)}\},\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)},\Sigma_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)},N-\mathcal{N}_{k})\right)\bigg|\mathcal{J}\bigg]+\sum_{n=\mathcal{N}_{k}+1}^{N}\mathbb{E}_{\{\theta_{h}^{(k)}\},\{\widehat{\theta}_{h}^{(k)}\}}</annotation></semantics></math></td>
