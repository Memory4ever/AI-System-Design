<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex117.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\int_{\left\|\chi_{h}^{\text{MT}(k)}\right\|\geq 4\sqrt{\beta\mathcal{N}_{k}\log_{e}(2KN)}}\frac{\exp\left(-\left\|\chi_{h}^{\text{MT}(k)}\right\|^{2}/2\beta\right)}{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}\frac{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}{(2\pi\beta)^{\mathcal{N}_{k}/2}}d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mrow><mo>‖</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>‖</mo></mrow><mo>≥</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mi>e</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mo>‖</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mo>‖</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mr