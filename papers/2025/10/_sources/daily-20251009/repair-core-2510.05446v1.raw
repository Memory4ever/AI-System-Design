><mtext class="ltx_mathvariant_italic">TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">MTS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>H</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}_{\{\theta_{h}^{(k)}\},\{\widehat{\theta}_{h}^{(k)}\}}\bigg[\max_{\theta:\|\theta-\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)}\|\leq C}\left(\frac{d\mathcal{N}(\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)},\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MTS}(k)})}{d\mathcal{N}(\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)},\Sigma_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)})}\right)^{H}</annotation><