<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex73.m1" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}\left[\sum_{h=1}^{H}|w^{n}(h,s_{nh},a_{nh})|\right]+\mathbb{E}\left[\sum_{h=1}^{H}\frac{\nu_{h}(s_{nh},a_{nh})}{l_{n}(h,s_{h},a_{h})+\nu_{h}(s_{nh},a_{nh})}H\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><mrow><mo stretchy="false">|</mo><mrow><msup><mi>w</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ν</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msub><mi>l</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ν</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}\left[\sum_{h=1}^{H}|w^{n}(h,s_{nh},a_{nh})|\right]+\mathbb{E}\left[\sum_{h=1}^{H}\frac{\nu_{h}(s_{nh},a_{nh})}{l_{n}(h,s_{h},a_{h})+\nu_{h}(s_{nh},a_{nh})}H\right]</annotation></semantics></math></td>
