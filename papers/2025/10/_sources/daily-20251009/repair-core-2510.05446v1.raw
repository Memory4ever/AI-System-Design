<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex71.m1" class="ltx_Math" alttext="\displaystyle+\mathbb{E}\left[\sum_{h=1}^{H}\frac{\nu_{h}(s_{nh},a_{nh})}{l_{n}(h,s_{h},a_{h})+\nu_{h}(s_{nh},a_{nh})}|\theta_{h}^{*}(s_{nh},a_{nh})-\widehat{R}_{h,s_{nh},a_{nh}}+\langle\widehat{P}_{h,s_{nh},a_{nh}},\widetilde{V}_{n,h+1}\rangle|\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ν</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msub><mi>l</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ν</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><msubsup><mi>θ</mi><mi>h</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mover accent="true"><mi>R</mi><mo>^</mo></mover><mrow><mi>h</mi><mo>,</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub></mrow></msub></mrow><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><mi>h</mi><mo>,</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}\left[\sum_{h=1}^{H}\frac{\nu_{h}(s_{nh},a_{nh})}{l_{n}(h,s_{h},a_{h})+\nu_{h}(s_{nh},a_{nh})}|\theta_{h}^{*}(s_{nh},a_{nh})-\widehat{R}_{h,s_{nh},a_{nh}}+\langle\widehat{P}_{h,s_{nh},a_{nh}},\widetilde{V}_{n,h+1}\rangle|\right]</annotation></semantics></math></td>
