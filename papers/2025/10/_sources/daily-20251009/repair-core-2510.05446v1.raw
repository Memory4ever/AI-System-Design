</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              Run TSRL(<math id="alg1.l5.m1" class="ltx_Math" alttext="\{0\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0\}</annotation></semantics></math>,<math id="alg1.l5.m2" class="ltx_Math" alttext="\{\frac{1}{\lambda}\mathbf{I}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mfrac><mn>1</mn><mi>λ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\frac{1}{\lambda}\mathbf{I}\}</annotation></semantics></math>, 1)

