<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex122.m1" class="ltx_Math" alttext="\displaystyle\int_{\chi_{h}^{\text{MT}(k)}}\frac{\exp\left(-\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\|^{2}/2\beta\right)}{(2\pi\beta)^{\mathcal{N}_{k}/2}}d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></msub></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">(</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow></mrow><mo fence="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\chi_{h}^{\text{MT}(k)}}\frac{\exp\left(-\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\|^{2}/2\beta\right)}{(2\pi\beta)^{\mathcal{N}_{k}/2}}d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex123.m1" class="ltx_math_unparsed" alttext="\displaystyle+\int_{\|\chi_{h}^{\text{MT}(k)}\|\geq 4\sqrt{\beta\mathcal{N}_{k}\log_{e}(2KN)}}\frac{\exp\left(-\sum_{h=1}^{H}\|\chi_{h}^{\text{MT}(k)}\|^{2}/2\beta\right)}{(2\pi\beta)^{\mathcal{N}_{k}/2}}d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mi>e</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em" rspace="0.055em">−</mo><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>H</mi></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mi>d</mi><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\int_{\|\chi_{h}^{\text{MT}(k)}\|\geq 4\sqrt{\beta\mathcal{N}_{k}\log_{e}(2KN)}}\frac{\exp\left(-\sum_{h=1}^{H}\|\chi_{h}^{\text{MT}(k)}\|^{2}/2\beta\right)}{(2\pi\beta)^{\mathcal{N}_{k}/2}}d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.p12" class="ltx_para">
<p id="A4.SS2.p12.2" class="ltx_p">Then we plug it back to previous equation <a href="#A4.E14" title="In D.2 Details for the proof of Theorem ‣ Appendix D Proof of Theorem ‣ Prior-Aligned Meta-RL: Thompson Sampling with Learned Priors and Guarantees in Finite-Horizon MDPs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>, we have</p>
<table id="A4.E15" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E15X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E15X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\{\chi_{h}^{\text{MT}(k)}\}}\left[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mo stretchy="false">{</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><msub><mtext>REV</mtext><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mtext>REV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\{\chi_{h}^{\text{MT}(k)}\}}\left[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="5" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(15)</span></td></tr>
<tr id="A4.E15Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E15Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\max_{\{\|\chi_{h}^{\text{MT}(k)}\|\leq 4\sqrt{\beta\mathcal{N}_{k}\log_{e}(2KN)}\}}\exp\left(\sum_{h=1}^{H}\frac{\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\|^{2}-\sum_{h=1}^{H}\|\chi_{h}^{\text{MT}(k)}\|^{2}}{2\beta}\right)\mathbb{E}_{\{\chi_{h}^{\text{TS}(k)}\}}\bigg[\text{REV}_{*}(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k})" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>max</mi><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≤</mo><mn>4</mn><msqrt><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mi>e</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt><mo stretchy="false">}</mo></mrow></msub><mi>exp</mi><mo>(</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>H</mi></msup><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo rspace="0.055em">−</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></msubsup><msup><mrow><mo stretchy="false">‖</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.100em" minsize="2.100em">[</mo><mtext>REV</mtext><msub><mrow></mrow><mo>∗</mo></msub><mo stretchy="false">(</mo><mo stretchy="false">{</mo><mi>θ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mi>N</mi><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{\{\|\chi_{h}^{\text{MT}(k)}\|\leq 4\sqrt{\beta\mathcal{N}_{k}\log_{e}(2KN)}\}}\exp\left(\sum_{h=1}^{H}\frac{\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\|^{2}-\sum_{h=1}^{H}\|\chi_{h}^{\text{MT}(k)}\|^{2}}{2\beta}\right)\mathbb{E}_{\{\chi_{h}^{\text{TS}(k)}\}}\bigg[\text{REV}_{*}(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E15Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E15Xb.m2" class="ltx_Math" alttext="\displaystyle-\text{REV}(\{\theta_{h}^{(k)}\},\{\{\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)}\}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{TS}(h)}\},N-\mathcal{N}_{k})\mid\mathcal{E}\bigg]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mtext>REV</mtext><mo stretchy="false">(</mo><mo stretchy="false">{</mo><mi>θ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mo stretchy="false">{</mo><mo stretchy="false">{</mo><mi>θ</mi><msub><mrow></mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow></msub><msup><mrow></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">}</mo><mo stretchy="false">}</mo><mo>,</mo><mo stretchy="false">{</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow></msub><msup><mrow></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mi>N</mi><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\text{REV}(\{\theta_{h}^{(k)}\},\{\{\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)}\}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{TS}(h)}\},N-\mathcal{N}_{k})\mid\mathcal{E}\bigg]</annotation></semantics></math></td>
