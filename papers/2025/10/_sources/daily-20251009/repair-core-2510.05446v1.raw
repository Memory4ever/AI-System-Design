<tbody id="A5.Ex220"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex220.m1" class="ltx_math_unparsed" alttext="\displaystyle+\mathbb{E}_{\{\theta_{h}^{(k)}\},\{\widehat{\theta}_{h}^{(k)}\}}\left[\int_{\theta:\|\theta-\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)}\|&gt;C}\text{REV}_{*}(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k})d\mathcal{N}(\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)},\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MTS}(k)})\middle|\mathcal{J}\right]," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>θ</mi><mo>−</mo><msubsup><mi>θ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mo>&gt;</mo><mi>C</mi></mrow></mrow></msub></mstyle><msub><mtext class="ltx_mathvariant_italic">REV</mtext><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext class="ltx_mathvariant_italic">MTS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mi class="ltx_font_mathcaligraphic">𝒥</mi><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}_{\{\theta_{h}^{(k)}\},\{\widehat{\theta}_{h}^{(k)}\}}\left[\int_{\theta:\|\theta-\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)}\|&gt;C}\text{REV}_{*}(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k})d\mathcal{N}(\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)},\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MTS}(k)})\middle|\mathcal{J}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.Thmtheorem6.p6" class="ltx_para">
<p id="A5.Thmtheorem6.p6.2" class="ltx_p"><span id="A5.Thmtheorem6.p6.2.1" class="ltx_text ltx_font_italic">where <math id="A5.Thmtheorem6.p6.m1" class="ltx_Math" alttext="C=5/2\sqrt{2\beta M\log_{e}(KN)}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mrow><mn>5</mn><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">C=5/2\sqrt{2\beta M\log_{e}(KN)}</annotation></semantics></math>. Inductively, we have</span></p>
<table id="A5.E28" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E28X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
