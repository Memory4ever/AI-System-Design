<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E13Xb.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\{\theta_{h}^{(k)}\},\{\widehat{\theta}_{h}^{(k)}\},\{\chi_{h}^{\text{MT}(k)}}\}[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>θ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mo stretchy="false">{</mo><mover accent="true"><mi>θ</mi><mo>^</mo></mover><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mo stretchy="false">{</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></msub><mo stretchy="false">}</mo><mo stretchy="false">[</mo><mtext>REV</mtext><msub><mrow></mrow><mo>∗</mo></msub><mo>(</mo><mo stretchy="false">{</mo><mi>θ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mi>N</mi><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><msub><mrow></mrow><mi>k</mi></msub><mo>)</mo><mo>−</mo><mtext>REV</mtext><mo>(</mo><mo stretchy="false">{</mo><mi>θ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mo stretchy="false">{</mo><mi>θ</mi><msub><mrow></mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mo stretchy="false">{</mo><mi mathvariant="normal">Σ</mi><msub><mrow></mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">}</mo><mo>,</mo><mi>N</mi><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><msub><mrow></mrow><mi>k</mi></msub><mo>)</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\{\theta_{h}^{(k)}\},\{\widehat{\theta}_{h}^{(k)}\},\{\chi_{h}^{\text{MT}(k)}}\}[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E13Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E13Xc.m2" class="ltx_Math" alttext="\displaystyle-\mathbb{E}_{\{\theta_{h}^{(k)}\},\{\widehat{\theta}_{h}^{(k)}\},\{\chi_{h}^{\text{TS}(k)}\}}[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}]." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msub><mtext>REV</mtext><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mtext>REV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\mathbb{E}_{\{\theta_{h}^{(k)}\},\{\widehat{\theta}_{h}^{(k)}\},\{\chi_{h}^{\text{TS}(k)}\}}[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{TS}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.p9" class="ltx_para">
<p id="A4.SS2.p9.1" class="ltx_p">We will use our prior alignment technique to express the first term in Eq. <a href="#A4.E13" title="In D.2 Details for the proof of Theorem ‣ Appendix D Proof of Theorem ‣ Prior-Aligned Meta-RL: Thompson Sampling with Learned Priors and Guarantees in Finite-Horizon MDPs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a> in terms of the second term in Eq. <a href="#A4.E13" title="In D.2 Details for the proof of Theorem ‣ Appendix D Proof of Theorem ‣ Prior-Aligned Meta-RL: Thompson Sampling with Learned Priors and Guarantees in Finite-Horizon MDPs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>; in other words, we will use a change of measure suggested by Eq. <a href="#A4.E10" title="In D.1 “Prior Alignment” Proof Strategy ‣ Appendix D Proof of Theorem ‣ Prior-Aligned Meta-RL: Thompson Sampling with Learned Priors and Guarantees in Finite-Horizon MDPs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> to express the true regret of our MTSRL algorithm as a function of the true regret of the meta oracle.</p>
</div>
<div id="A4.SS2.p10" class="ltx_para">
<p id="A4.SS2.p10.2" class="ltx_p">We start by expanding the first term of Eq. <a href="#A4.E13" title="In D.2 Details for the proof of Theorem ‣ Appendix D Proof of Theorem ‣ Prior-Aligned Meta-RL: Thompson Sampling with Learned Priors and Guarantees in Finite-Horizon MDPs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a> as</p>
<table id="A4.E14" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E14X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E14X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\{\chi_{h}^{\text{MT}(k)}\}}" display="inline" intent=":literal"><semantics><msub><mi>𝔼</mi><mrow><mo stretchy="false">{</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow></msub><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\{\chi_{h}^{\text{MT}(k)}\}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E14X.m3" class="ltx_Math" alttext="\displaystyle\left[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}\right]" display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mrow><mrow><mrow><msub><mtext>REV</mtext><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mtext>REV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\mid\mathcal{E}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(14)</span></td></tr>
<tr id="A4.E14Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E14Xa.m2" class="ltx_Math" alttext="\displaystyle=\int_{\{\chi_{h}^{\text{MT}(k)}\}}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\{\chi_{h}^{\text{MT}(k)}\}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E14Xa.m3" class="ltx_Math" alttext="\displaystyle\frac{\exp\left(-\sum_{h=1}^{H}\|\chi_{h}^{\text{MT}(k)}\|^{2}/2\beta\right)}{(2\pi\beta)^{H\mathcal{N}_{k}/2}}\left[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em" rspace="0.055em">−</mo><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>H</mi></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></mrow><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mtext>REV</mtext><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mtext>REV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>θ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi mathvariant="normal">Σ</mi><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>h</mi></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\exp\left(-\sum_{h=1}^{H}\|\chi_{h}^{\text{MT}(k)}\|^{2}/2\beta\right)}{(2\pi\beta)^{H\mathcal{N}_{k}/2}}\left[\text{REV}_{*}\left(\{\theta_{h}^{(k)}\},N-\mathcal{N}_{k}\right)-\text{REV}\left(\{\theta_{h}^{(k)}\},\{\theta_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},\{\Sigma_{\mathcal{N}_{k}+1,h}^{\text{MT}(k)}\},N-\mathcal{N}_{k}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E14Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E14Xb.m2" class="ltx_Math" alttext="\displaystyle d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow><mo fence="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.p11" class="ltx_para">
<p id="A4.SS2.p11.1" class="ltx_p">Given a realization of <math id="A4.SS2.p11.m1" class="ltx_Math" alttext="\chi_{h}^{\text{MT}(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><annotation encoding="application/x-tex">\chi_{h}^{\text{MT}(k)}</annotation></semantics></math>, we denote <math id="A4.SS2.p11.m2" class="ltx_Math" alttext="\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})</annotation></semantics></math> (with some abuse of notation) as the corresponding realization of <math id="A4.SS2.p11.m3" class="ltx_Math" alttext="\chi_{h}^{\text{TS}(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><annotation encoding="application/x-tex">\chi_{h}^{\text{TS}(k)}</annotation></semantics></math> that satisfies Eq. <a href="#A4.E10" title="In D.1 “Prior Alignment” Proof Strategy ‣ Appendix D Proof of Theorem ‣ Prior-Aligned Meta-RL: Thompson Sampling with Learned Priors and Guarantees in Finite-Horizon MDPs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>. Note that this is a unique one-to-one mapping. We then perform a change of measure to continue:</p>
<table id="A4.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex115.m1" class="ltx_Math" alttext="\displaystyle\int_{\chi_{h}^{\text{MT}(k)}}\frac{\exp\left(-\left\|\chi_{h}^{\text{MT}(k)}\right\|^{2}/2\beta\right)}{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}\frac{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}{(2\pi\beta)^{\mathcal{N}_{k}/2}}d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></msub></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mo>‖</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mo>‖</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">(</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mo>‖</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">(</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow></mrow><mo fence="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\chi_{h}^{\text{MT}(k)}}\frac{\exp\left(-\left\|\chi_{h}^{\text{MT}(k)}\right\|^{2}/2\beta\right)}{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}\frac{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}{(2\pi\beta)^{\mathcal{N}_{k}/2}}d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex116.m1" class="ltx_Math" alttext="\displaystyle=\int_{\left\|\chi_{h}^{\text{MT}(k)}\right\|\leq 4\sqrt{\beta\mathcal{N}_{k}\log_{e}(2KN)}}\frac{\exp\left(-\left\|\chi_{h}^{\text{MT}(k)}\right\|^{2}/2\beta\right)}{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}\frac{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}{(2\pi\beta)^{\mathcal{N}_{k}/2}}d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mrow><mo>‖</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>‖</mo></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mi>e</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow></msub></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mo>‖</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mo>‖</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">(</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>(</mo><mo lspace="0em">−</mo><mo>‖</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>TS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">(</mo><mi>χ</mi><msub><mrow></mrow><mi>h</mi></msub><msup><mrow></mrow><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>β</mi><mo>)</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>k</mi></msub><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>χ</mi><mi>h</mi><mrow><mtext>MT</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow></mrow></mrow><mo fence="false">|</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\left\|\chi_{h}^{\text{MT}(k)}\right\|\leq 4\sqrt{\beta\mathcal{N}_{k}\log_{e}(2KN)}}\frac{\exp\left(-\left\|\chi_{h}^{\text{MT}(k)}\right\|^{2}/2\beta\right)}{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}\frac{\exp\left(-\left\|\chi_{h}^{\text{TS}(k)}(\chi_{h}^{\text{MT}(k)})\right\|^{2}/2\beta\right)}{(2\pi\beta)^{\mathcal{N}_{k}/2}}d\chi_{h}^{\text{MT}(k)}\mid\mathcal{E}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
