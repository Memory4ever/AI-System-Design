<span id="S7.F13.4.1.2.1" class="ltx_inline-block ltx_align_top">
<span id="S7.F13.4.1.2.1.1" class="ltx_p">Bicubic</span>
</span></td>
<td id="S7.F13.4.1.3" class="ltx_td ltx_align_center">
<span id="S7.F13.4.1.3.1" class="ltx_inline-block ltx_align_top">
<span id="S7.F13.4.1.3.1.1" class="ltx_p">GaussianImage <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>]</cite></span>
</span></td>
<td id="S7.F13.4.1.4" class="ltx_td ltx_align_center">
<span id="S7.F13.4.1.4.1" class="ltx_inline-block ltx_align_top">
<span id="S7.F13.4.1.4.1.1" class="ltx_p">R-SMoE (Ours)</span>
</span></td>
<td id="S7.F13.4.1.5" class="ltx_td ltx_align_center">
<span id="S7.F13.4.1.5.1" class="ltx_inline-block ltx_align_top">
<span id="S7.F13.4.1.5.1.1" class="ltx_p">Bicubic</span>
