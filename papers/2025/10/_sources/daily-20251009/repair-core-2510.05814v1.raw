<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S7.F13.sf12.2" class="ltx_text" style="font-size:90%;">((l))</span> </span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<table id="S7.F13.4" class="ltx_tabular ltx_figure_panel ltx_minipage ltx_align_middle" style="width:327.8pt;">
