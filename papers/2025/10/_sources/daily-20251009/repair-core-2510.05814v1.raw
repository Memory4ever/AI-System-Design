<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S1.F1.sf3.2" class="ltx_text" style="font-size:90%;">((c))</span> </span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S1.F1.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.05814v1/figures/SMoE_demo/jpeg_009.jpg" id="S1.F1.sf4.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:115/115;" width="115" height="115" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S1.F1.sf4.2" class="ltx_text" style="font-size:90%;">((d))</span> </span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
