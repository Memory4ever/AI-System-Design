<td id="S6.T3.2.2.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" rowspan="2"><span id="S6.T3.2.2.2.1" class="ltx_text">0.84 (<span id="S6.T3.2.2.2.1.1" class="ltx_text ltx_font_italic">p</span> = 0.02)</span></td></tr>
<tr id="S6.T3.2.3" class="ltx_tr">
<th id="S6.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S6.T3.2.3.1.1" class="ltx_text ltx_font_italic">- w/ Func. (Ours)</span></th></tr>
<tr id="S6.T3.2.4" class="ltx_tr">
<th id="S6.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Gemini-2.0-Flash</th>
