<td id="S3.T1.2.1.10.2" class="ltx_td ltx_align_center">13.04</td>
<td id="S3.T1.2.1.10.3" class="ltx_td ltx_align_center">13.64</td></tr>
<tr id="S3.T1.2.1.11" class="ltx_tr">
<td id="S3.T1.2.1.11.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t">Inter-Agreement</td>
<td id="S3.T1.2.1.11.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">93.33</td>
