<th id="S6.T3.2.1.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T3.2.1.2.1" class="ltx_text ltx_font_bold">Pearson (<span id="S6.T3.2.1.2.1.1" class="ltx_text ltx_font_italic">p</span>-value)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
