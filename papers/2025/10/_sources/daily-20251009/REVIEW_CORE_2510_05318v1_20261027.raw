<td id="A9.T9.2.1.3.1" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.3.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#ECECEC;">get_schema</span></td>
<td id="A9.T9.2.1.3.2" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">DB</span></td>
<td id="A9.T9.2.1.3.3" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.3.3.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#ECECEC;">-</span></td>
<td id="A9.T9.2.1.3.4" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">Database Schema</span></td>
<td id="A9.T9.2.1.3.5" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.3.5.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">1</span></td></tr>
<tr id="A9.T9.2.1.4" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="A9.T9.2.1.4.1" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.4.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFFFFF;">get_all_column_meanings</span></td>
<td id="A9.T9.2.1.4.2" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">DB</span></td>
<td id="A9.T9.2.1.4.3" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.4.3.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFFFFF;">-</span></td>
<td id="A9.T9.2.1.4.4" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.4.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">All Columns’ Meanings</span></td>
<td id="A9.T9.2.1.4.5" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.4.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">1</span></td></tr>
<tr id="A9.T9.2.1.5" class="ltx_tr" style="--ltx-bg-color:#ECECEC;">
<td id="A9.T9.2.1.5.1" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.5.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#ECECEC;">get_column_meaning</span></td>
<td id="A9.T9.2.1.5.2" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.5.2.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">DB</span></td>
<td id="A9.T9.2.1.5.3" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.5.3.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#ECECEC;">table, column</span></td>
<td id="A9.T9.2.1.5.4" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.5.4.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">Column Meaning</span></td>
<td id="A9.T9.2.1.5.5" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.5.5.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">0.5</span></td></tr>
<tr id="A9.T9.2.1.6" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="A9.T9.2.1.6.1" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.6.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFFFFF;">get_all_external_knowledge_names</span></td>
<td id="A9.T9.2.1.6.2" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.6.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">DB</span></td>
<td id="A9.T9.2.1.6.3" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.6.3.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFFFFF;">-</span></td>
<td id="A9.T9.2.1.6.4" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.6.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">All Knowledge Names</span></td>
<td id="A9.T9.2.1.6.5" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.6.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">0.5</span></td></tr>
<tr id="A9.T9.2.1.7" class="ltx_tr" style="--ltx-bg-color:#ECECEC;">
<td id="A9.T9.2.1.7.1" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.7.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#ECECEC;">get_knowledge_definition</span></td>
<td id="A9.T9.2.1.7.2" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.7.2.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">DB</span></td>
