<td id="S5.T2.6.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:0.75pt;padding-bottom:0.75pt;" rowspan="2"><span id="S5.T2.6.1.1.4.1" class="ltx_text ltx_font_bold">Reward* <math id="S5.T2.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S5.T2.6.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:0.75pt;padding-bottom:0.75pt;" rowspan="2"><span id="S5.T2.6.1.1.5.1" class="ltx_text">
<span id="S5.T2.6.1.1.5.1.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T2.6.1.1.5.1.1.1" class="ltx_tr">
<span id="S5.T2.6.1.1.5.1.1.1.1" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T2.6.1.1.5.1.1.1.1.1" class="ltx_text ltx_font_bold">Avg.</span></span></span>
<span id="S5.T2.6.1.1.5.1.1.2" class="ltx_tr">
<span id="S5.T2.6.1.1.5.1.1.2.1" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T2.6.1.1.5.1.1.2.1.1" class="ltx_text ltx_font_bold">Cost <math id="S5.T2.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></span></span>
</span></span></td></tr>
<tr id="S5.T2.6.1.2" class="ltx_tr">
<td id="S5.T2.6.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T2.6.1.2.1.1" class="ltx_text ltx_font_bold">BI</span></td>
<td id="S5.T2.6.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T2.6.1.2.2.1" class="ltx_text ltx_font_bold">DM</span></td>
<td id="S5.T2.6.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T2.6.1.2.3.1" class="ltx_text ltx_font_bold">Overall</span></td>
<td id="S5.T2.6.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T2.6.1.2.4.1" class="ltx_text ltx_font_bold">BI</span></td>
