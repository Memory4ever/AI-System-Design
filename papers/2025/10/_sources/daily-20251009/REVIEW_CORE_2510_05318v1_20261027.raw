<tr id="A9.T9.2.1.8" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="A9.T9.2.1.8.1" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.8.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFFFFF;">get_all_knowledge_definitions</span></td>
<td id="A9.T9.2.1.8.2" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.8.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">DB</span></td>
<td id="A9.T9.2.1.8.3" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.8.3.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFFFFF;">-</span></td>
<td id="A9.T9.2.1.8.4" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.8.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">All Knowledge Definitions</span></td>
<td id="A9.T9.2.1.8.5" class="ltx_td ltx_align_left"><span id="A9.T9.2.1.8.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">1</span></td></tr>
<tr id="A9.T9.2.1.9" class="ltx_tr" style="--ltx-bg-color:#ECECEC;">
<td id="A9.T9.2.1.9.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A9.T9.2.1.9.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#ECECEC;">ask</span></td>
<td id="A9.T9.2.1.9.2" class="ltx_td ltx_align_left ltx_border_t"><span id="A9.T9.2.1.9.2.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">User</span></td>
<td id="A9.T9.2.1.9.3" class="ltx_td ltx_align_left ltx_border_t"><span id="A9.T9.2.1.9.3.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#ECECEC;">question</span></td>
<td id="A9.T9.2.1.9.4" class="ltx_td ltx_align_left ltx_border_t"><span id="A9.T9.2.1.9.4.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">User Clarification</span></td>
<td id="A9.T9.2.1.9.5" class="ltx_td ltx_align_left ltx_border_t"><span id="A9.T9.2.1.9.5.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">2</span></td></tr>
<tr id="A9.T9.2.1.10" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="A9.T9.2.1.10.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A9.T9.2.1.10.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFFFFF;">submit</span></td>
<td id="A9.T9.2.1.10.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="A9.T9.2.1.10.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">User</span></td>
<td id="A9.T9.2.1.10.3" class="ltx_td ltx_align_left ltx_border_bb"><span id="A9.T9.2.1.10.3.1" class="ltx_text ltx_font_typewriter" style="--ltx-bg-color:#FFFFFF;">sql</span></td>
<td id="A9.T9.2.1.10.4" class="ltx_td ltx_align_left ltx_border_bb"><span id="A9.T9.2.1.10.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">User Feedback</span></td>
