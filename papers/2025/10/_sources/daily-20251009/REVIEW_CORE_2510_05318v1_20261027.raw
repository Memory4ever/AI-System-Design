<td id="A11.T10.6.1.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">40.95 <span id="A11.T10.6.1.4.3.1" class="ltx_text" style="--ltx-fg-color:#915C82;">( +6.67)</span></td>
<td id="A11.T10.6.1.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">20.33 <span id="A11.T10.6.1.4.4.1" class="ltx_text" style="--ltx-fg-color:#915C82;">( +3.33)</span></td>
