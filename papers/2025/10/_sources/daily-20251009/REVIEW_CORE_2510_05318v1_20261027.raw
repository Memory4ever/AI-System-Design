<span id="A7.T7.4.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;--ltx-bg-color:#E6E6E6;">
<span id="A7.T7.4.1.2.1.1.1" class="ltx_p"><span id="A7.T7.4.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Decimal Ambiguity</span></span>
</span></td>
<td id="A7.T7.4.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A7.T7.4.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:156.5pt;--ltx-bg-color:#E6E6E6;">
<span id="A7.T7.4.1.2.2.1.1" class="ltx_p"><span id="A7.T7.4.1.2.2.1.1.1" class="ltx_text ltx_font_typewriter">ROUND</span> function is used in solution SQL</span>
</span></td>
<td id="A7.T7.4.1.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A7.T7.4.1.2.3.1" class="ltx_inline-block ltx_align_top" style="width:156.5pt;--ltx-bg-color:#E6E6E6;">
<span id="A7.T7.4.1.2.3.1.1" class="ltx_p"><span id="A7.T7.4.1.2.3.1.1.1" class="ltx_text ltx_font_italic">"Show average score in 2 decimal"</span> <math id="A7.T7.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6" stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> <span id="A7.T7.4.1.2.3.1.1.2" class="ltx_text ltx_font_italic">"Show average score"</span></span>
</span></td></tr>
<tr id="A7.T7.4.1.3" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="A7.T7.4.1.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A7.T7.4.1.3.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;--ltx-bg-color:#FFFFFF;">
<span id="A7.T7.4.1.3.1.1.1" class="ltx_p"><span id="A7.T7.4.1.3.1.1.1.1" class="ltx_text ltx_font_bold">Join Ambiguity</span></span>
</span></td>
<td id="A7.T7.4.1.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A7.T7.4.1.3.2.1" class="ltx_inline-block ltx_align_top" style="width:156.5pt;--ltx-bg-color:#FFFFFF;">
<span id="A7.T7.4.1.3.2.1.1" class="ltx_p">Non-default join (e.g., <span id="A7.T7.4.1.3.2.1.1.1" class="ltx_text ltx_font_typewriter">LEFT JOIN</span>) is used in solution SQL</span>
</span></td>
