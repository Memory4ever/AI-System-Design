<tr id="S6.T3.2.5" class="ltx_tr">
<th id="S6.T3.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S6.T3.2.5.1.1" class="ltx_text ltx_font_italic">- w/ Func. (Ours)</span></th></tr>
