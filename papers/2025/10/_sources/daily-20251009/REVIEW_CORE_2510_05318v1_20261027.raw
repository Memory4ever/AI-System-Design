<tr id="S3.T1.2.1.3" class="ltx_tr">
<td id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left"># BI tasks</td>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_center">195</td>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_center">410</td></tr>
<tr id="S3.T1.2.1.4" class="ltx_tr">
<td id="S3.T1.2.1.4.1" class="ltx_td ltx_align_left"># DM tasks</td>
<td id="S3.T1.2.1.4.2" class="ltx_td ltx_align_center">105</td>
<td id="S3.T1.2.1.4.3" class="ltx_td ltx_align_center">190</td></tr>
<tr id="S3.T1.2.1.5" class="ltx_tr">
<td id="S3.T1.2.1.5.1" class="ltx_td ltx_align_left"># Distinct Test Cases</td>
<td id="S3.T1.2.1.5.2" class="ltx_td ltx_align_center">135</td>
<td id="S3.T1.2.1.5.3" class="ltx_td ltx_align_center">191</td></tr>
<tr id="S3.T1.2.1.6" class="ltx_tr">
<td id="S3.T1.2.1.6.1" class="ltx_td ltx_align_left"># Tokens / User Query</td>
<td id="S3.T1.2.1.6.2" class="ltx_td ltx_align_center">40.22</td>
<td id="S3.T1.2.1.6.3" class="ltx_td ltx_align_center">32.95</td></tr>
<tr id="S3.T1.2.1.7" class="ltx_tr">
<td id="S3.T1.2.1.7.1" class="ltx_td ltx_align_left ltx_border_t"># Tokens / SQL</td>
<td id="S3.T1.2.1.7.2" class="ltx_td ltx_align_center ltx_border_t">361.52</td>
<td id="S3.T1.2.1.7.3" class="ltx_td ltx_align_center ltx_border_t">252.21</td></tr>
<tr id="S3.T1.2.1.8" class="ltx_tr">
<td id="S3.T1.2.1.8.1" class="ltx_td ltx_align_left"># Ambiguities / Task</td>
<td id="S3.T1.2.1.8.2" class="ltx_td ltx_align_center">5.16</td>
