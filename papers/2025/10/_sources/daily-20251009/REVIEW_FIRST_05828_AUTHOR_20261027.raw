<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Christian Marinoni - Ph.D. in Deep Learning & Audio-Visual AI</title>
    <meta name="description"
        content="Christian Marinoni is a Ph.D. in ICT at Sapienza University of Rome specializing in deep generative models, multi-modal learning, and audio-visual applications. Explore his research, publications, and projects.">
    <meta name="keywords" content="Christian Marinoni, AI researcher">
    <meta name="author" content="Christian Marinoni">

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Christian Marinoni - Ph.D. in Deep Learning & Audio-Visual AI">
    <meta property="og:description"
        content="Ph.D. in ICT, specializing in deep generative models, multi-modal learning, and audio-visual applications at Sapienza University of Rome.">
    <meta property="og:url" content="https://www.chrismarinoni.com">
    <meta property="og:image" content="https://www.chrismarinoni.com/imgs/profile.jpg">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Christian Marinoni - Ph.D. in Deep Learning & Audio-Visual AI">
    <meta name="twitter:description"
        content="PostDoc Researcher at the Italian Institute of Technology (IIT). Working on deep generative models to bridge the gap between audio and visual domains.">

    <link rel="stylesheet" href="style.css">
</head>

<body>
    <noscript>
        <div class="cv-mode-container">
            <header class="cv-header">
                <img src="imgs/profile.jpg" alt="Christian Marinoni" class="cv-photo">
                <div>
                    <h1>Christian Marinoni</h1>
                    <h2>PostDoc Researcher at the Italian Institute of Technology (IIT).
                        Ph.D. in ICT, specializing in deep generative models and multi-modal learning for audio-visual
                        applications.</h2>
                </div>
            </header>
            <section class="cv-section">
                <h2>Education</h2>
                <div class="cv-item">
                    <h3>Ph.D. Student in ICT</h3>
                    <p>Sapienza University of Rome | Nov 2022 - Jan 2026</p>
                </div>
                <div class="cv-item">
                    <h3>Visiting Research Period @ CVSSP</h3>
                    <p>University of Surrey | Jul 2025 - Oct 2025</p>
                </div>
                <div class="cv-item">
                    <h3>M.Sc. in Artificial Intelligence & Robotics (110/110 cum laude)</h3>
                    <p>Sapienza University of Rome | Oct 2019 - May 2022</p>
                </div>
                <div class="cv-item">
                    <h3>B.Sc. in Computer & System Engineering (108/110)</h3>
                    <p>Sapienza University of Rome | Oct 2016 - Oct 2019</p>
                </div>
            </section>
            <section class="cv-section">
                <h2>Skills</h2>
                <div class="cv-item">
                    <h3>Programming & Libraries</h3>
                    <p>Python (advanced), C, Java, PyTorch, TensorFlow, Numpy</p>
                </div>
                <div class="cv-item">
                    <h3>Core Interests</h3>
                    <p>Deep Generative Modelling, Multi-modal Learning, 3D Audio, Audio-Visual Generation</p>
                </div>
                <div class="cv-item">
                    <h3>Other Activities</h3>
                    <p>Reviewer (IJCNN, ICASSP, MLSP), Grand Challenge Co-organizer (L3DAS22, L3DAS23)</p>
                </div>
            </section>
            <section class="cv-section">
                <h2>Selected Projects</h2>
                <div class="cv-item">
                    <h3>Con360-AV</h3>
                    <p>Controllable audio-visual generation from 360-degree environments using diffusion models with
                        spatial awareness.</p>
                    <p><a href="https://arxiv.org/abs/2510.06060v1">View Publication</a></p>
                </div>
                <div class="cv-item">
                    <h3>StereoSync</h3>
                    <p>Video-aligned stereo audio generation with temporal and spatial synchronization using diffusion
                        models.</p>
                    <p><a href="https://arxiv.org/abs/2510.05828v1">View Publication</a></p>
                </div>
                <div class="cv-item">
                    <h3>Fol AI</h3>
                    <p>Two-stage generative framework for Foley sound design with temporal and semantic control.</p>
                    <p><a href="https://arxiv.org/abs/2412.15023v3">View Publication</a></p>
                </div>
            </section>
            <section class="cv-section">
                <h2>Contact</h2>
                <p>LinkedIn: <a href="https://www.linkedin.com/in/christian-marinoni/">christian-marinoni</a></p>
                <p>Google Scholar: <a href="https://scholar.google.com/citations?user=24V7UaIAAAAJ">View Profile</a></p>
            </section>
        </div>
    </noscript>

    <div id="accessibility-banner" class="accessibility-banner">
        <div class="banner-content">
            <p><strong>Looking for an easier-to-read CV format?</strong></p>
            <button id="toggle-cv-mode" class="banner-btn">Switch to CV Mode</button>
        </div>
        <button class="banner-close" id="close-banner">&times;</button>
    </div>

    <div id="cv-mode-view"></div>

    <div id="cv-chat-window" class="cv-chat-window" style="display: none;">
        <div class="cv-chat-header">
            <span>Chris-bot</span>
            <button class="cv-chat-minimize">&times;</button>
        </div>
        <div class="cv-chat-display" id="cv-chat-display">
            <div class="chat-message bot">Hello! I'm Chris-bot. Feel free to ask me anything about Christian's CV or
                research! :) Bear in mind that I may be hallucinating and that my context window is not very large.
            </div>
        </div>
        <form class="cv-chat-input-form" id="cv-chat-form">
            <input type="text" id="cv-chat-input" placeholder="Ask about the CV..." autocomplete="off">
            <button type="submit">Send</button>
        </form>
    </div>

    <div id="xp-interface">
        <div class="desktop">
            <div class="desktop-icon" data-window-id="about-window">
                <img src="imgs/folder_usr.png" alt="User Icon">
                <span>About Me</span>
            </div>
            <div class="desktop-icon" data-window-id="projects-window">
                <img src="imgs/folder_proj.png" alt="Folder Icon about projects">
                <span>My Projects</span>
            </div>
            <div class="desktop-icon" data-window-id="contact-window">
                <img src="imgs/folder_cont.png" alt="Email Icon">
                <span>Contact</span>
            </div>
            <div class="desktop-icon" data-window-id="chat-window">
                <img src="imgs/chat_icon.png" alt="Chat Icon">
                <span>Chris-bot</span>
            </div>
            <div class="desktop-icon" id="broken-icon">
                <img src="imgs/dont_click.png" alt="Broken Icon">
                <span>Don't Click</span>
            </div>
        </div>

        <div id="about-window" class="window" style="width: 500px; top: 10%; left: 10%;">
            <div class="title-bar">
                <div class="title-bar-text">
                    <img src="imgs/folder_usr.png" alt="User Icon">
                    <span>User Properties</span>
                </div>
                <div class="title-bar-controls">
                    <button class="minimize" data-symbol="0"></button>
                    <button class="maximize" data-symbol="1"></button>
                    <button class="close" data-symbol="r"></button>
                </div>
            </div>
            <div class="window-content user-properties-content">
                <div class="user-tabs">
                    <div class="tab active" data-tab="general">General</div>
                    <div class="tab" data-tab="work">Work</div>
                    <div class="tab" data-tab="education">Education</div>
                    <div class="tab" data-tab="skills">Skills</div>
                </div>
                <div id="general" class="tab-content active">
                    <div class="tab-general">
                        <img src="imgs/profile.jpg" alt="User Image" data-content="about.image">
                        <div>
                            <h3 data-content="about.name"></h3>
                            <p data-content="about.bio"></p>
                        </div>
                    </div>
                </div>
                <div id="education" class="tab-content">
                    <ul id="education-list"></ul>
                </div>
                <div id="work" class="tab-content">
                    <ul id="work-list"></ul>
                </div>
                <div id="skills" class="tab-content">
                    <ul id="skills-list"></ul>
                </div>
            </div>
        </div>

        <div id="projects-window" class="window" style="width: 600px; top: 20%; left: 25%;">
            <div class="title-bar">
                <div class="title-bar-text">
                    <img src="imgs/folder_proj.png" alt="Folder Icon">
                    <span>My Projects</span>
                </div>
                <div class="title-bar-controls">
                    <button class="minimize" data-symbol="0"></button>
                    <button class="maximize" data-symbol="1"></button>
                    <button class="close" data-symbol="r"></button>
                </div>
            </div>
            <div class="window-content">
                <p>Main research projects and topics. Click an icon to learn more.</p>
                <div class="projects-grid" id="projects-grid"></div>
            </div>
        </div>

        <div id="contact-window" class="window" style="width: 400px; top: 15%; left: 50%;">
            <div class="title-bar">
                <div class="title-bar-text">
                    <img src="imgs/folder_cont.png" alt="Email Icon">
                    <span>Contact Me</span>
                </div>
                <div class="title-bar-controls">
                    <button class="minimize" data-symbol="0"></button>
                    <button class="maximize" data-symbol="1"></button>
                    <button class="close" data-symbol="r"></button>
                </div>
            </div>
            <div class="window-content contact-form">
                <div class="form-group">
                    <label for="to">To:</label>
                    <input type="text" id="to" disabled>
                </div>
                <div class="form-group">
                    <label for="from">From:</label>
                    <input type="text" id="from" placeholder="your.email@example.com">
                </div>
                <div class="form-group">
                    <label for="subject">Subject:</label>
                    <input type="text" id="subject" placeholder="Portfolio Inquiry">
                </div>
                <div class="form-group">
                    <textarea id="body" placeholder="Your message here..."></textarea>
                </div>
                <button class="send-button" id="send-email-btn">Send</button>
                <div class="contact-socials">
                    <span>Find me on:</span>
                    <a id="linkedin-link" href="#" target="_blank">
                        <img src="data:image/svg+xml;base64,"
                            alt="LinkedIn"> LinkedIn
                    </a>
                    <a id="scholar-link" href="#" target="_blank">
                        <img src="data:image/svg+xml;base64,"
                            alt="Google Scholar"> Scholar
                    </a>
                </div>
            </div>
        </div>

        <div id="memory-game-window" class="window" style="width: 480px; top: 20%; left: 20%;">
            <div class="title-bar">
                <div class="title-bar-text">
                    <img src="imgs/memory_icon.png" alt="Game Icon">
                    <span>Proji-Memory</span>
                </div>
                <div class="title-bar-controls">
                    <button class="minimize" data-symbol="0"></button>
                    <button class="maximize" data-symbol="1"></button>
                    <button class="close" data-symbol="r"></button>
                </div>
            </div>
            <div class="window-content" id="memory-game-content"></div>
        </div>

        <div id="minesweeper-window" class="window" style="width: 350px; top: 10%; left: 40%;">
            <div class="title-bar">
                <div class="title-bar-text">
                    <img src="imgs/sweeper.png" alt="Game Icon">
                    <span>Error-Sweeper</span>
                </div>
                <div class="title-bar-controls">
                    <button class="minimize" data-symbol="0"></button>
                    <button class="maximize" data-symbol="1"></button>
                    <button class="close" data-symbol="r"></button>
                </div>
            </div>
            <div class="window-content">
                <div id="minesweeper-controls">
                    <span id="mine-count">010</span>
                    <span id="minesweeper-status">🙂</span>
                    <span id="mine-timer">000</span>
                </div>
                <div id="minesweeper-grid"></div>
            </div>
        </div>

        <div id="chat-window" class="window" style="width: 400px; height: 500px; top: 10%; left: 55%;">
            <div class="title-bar">
                <div class="title-bar-text">
                    <img src="imgs/chat_icon.png" alt="Chat Icon">
                    <span>Chris-bot</span>
                </div>
                <div class="title-bar-controls">
                    <button class="minimize" data-symbol="0"></button>
                    <button class="maximize" data-symbol="1"></button>
                    <button class="close" data-symbol="r"></button>
                </div>
            </div>
            <div class="window-content chat-content">
                <div class="chat-display" id="chat-display">
                    <div class="chat-message bot">Hello! I'm Chris-bot, an AI assistant. Feel free to ask me anything
                        about Christian's portfolio or research! :)</div>
                </div>
                <form class="chat-input-form" id="chat-form">
                    <input type="text" id="chat-input" placeholder="Ask about 'StereoSync'..." autocomplete="off">
                    <button type="submit">Send</button>
                </form>
            </div>
        </div>

        <div class="bsod">
            <p style="text-align: center; background: #aaa; color: #0000AA; width: 200px; margin: 2em auto;">ContactMe
            </p>
            <p>A fatal exception 0E has occurred at 0028:C0011E36 in VXD VMM(01) + 00010E36.</p>
            <p>This "error" was intentional.</p>
            <p style="margin-top: 2em;">Curious about this website and the projects behind it?</p>
            <p>Why not contact me and have a chat about my research? ;)</p>
            <p style="text-align: center; margin-top: 2em;">Click anywhere to continue _</p>
        </div>

        <div id="screensaver-overlay">
            <div id="dvd-logo">
                <img src="imgs/profile_round.png" alt="User Image" data-content="about.image_round">
            </div>
        </div>

        <div id="login-overlay">
            <div class="login-box">
                <h2>To log in, click your user name</h2>
                <div class="login-user" id="login-user-btn">
                    <img src="imgs/profile_round.png" alt="User Image" data-content="about.image_round">
                    <span data-content="about.name"></span>
                    <span id="login-arrow">→</span>
                </div>
            </div>
        </div>

        <div class="taskbar">
            <button class="start-button">Start</button>
            <button class="exit-cv-button" id="exit-cv-button" style="display: none;">Exit CV Mode</button>
            <div class="task-list"></div>
            <div class="system-tray">
                <span id="clock"></span>
            </div>
        </div>

        <div class="start-menu">
            <div class="start-menu-header">
                <img src="imgs/profile_round.png" alt="User" data-content="about.image_round">
                <span data-content="about.name"></span>
                <button class="settings-gear" id="settings-gear" title="Settings">⚙</button>
            </div>
            <div class="start-menu-body">
                <div class="start-menu-left">
                    <div class="start-menu-item" data-window-id="about-window">
                        <img src="imgs/folder_usr.png" alt="User Icon">
                        <span>About Me</span>
                    </div>
                    <div class="start-menu-item" data-window-id="projects-window">
                        <img src="imgs/folder_proj.png" alt="Folder Icon">
                        <span>My Projects</span>
                    </div>
                    <div class="start-menu-item" data-window-id="contact-window">
                        <img src="imgs/folder_cont.png" alt="Email Icon">
                        <span>Contact</span>
                    </div>
                    <div class="start-menu-item" data-window-id="chat-window">
                        <img src="imgs/chat_icon.png" alt="Chat Icon">
                        <span>Chat with Chris-bot</span>
                    </div>
                    <div class="start-menu-divider"></div>
                    <div class="start-menu-item" id="cv-mode-menu-item">
                        <img src="imgs/folder_usr.png" alt="CV Icon">
                        <span>CV Mode</span>
                    </div>
                    <div class="start-menu-divider"></div>
                    <div class="start-menu-item" data-window-id="memory-game-window">
                        <img src="imgs/memory_icon.png" alt="Mememory Game Icon">
                        <span>Proji-Memory</span>
                    </div>
                    <div class="start-menu-item" data-window-id="minesweeper-window">
                        <img src="imgs/sweeper.png" alt="Error-sweeper Icon">
                        <span>Error-Sweeper</span>
                    </div>
                    <div class="start-menu-divider"></div>
                    <div class="start-menu-item" id="log-off-btn">
                        <img src="imgs/logoff.png" alt="Log out Icon">
                        <span>Log out</span>
                    </div>
                </div>
            </div>
        </div>

        <script src="script.js"></script>

