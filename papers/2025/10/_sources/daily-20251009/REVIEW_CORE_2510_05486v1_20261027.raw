<span id="S3.T1.2.6.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S3.T1.m10" class="ltx_math_unparsed" alttext="S^{m}-{S^{m}}^{\prime}=\{s\in S\mid\forall b\in s," display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mi>m</mi></msup><mo>−</mo><mmultiscripts><mi>S</mi><mrow></mrow><mi>m</mi><mrow></mrow><mo>′</mo></mmultiscripts><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>s</mi><mo>∈</mo><mi>S</mi><mo lspace="0em" rspace="0.167em">∣</mo><mo rspace="0.167em">∀</mo><mi>b</mi><mo>∈</mo><mi>s</mi><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">S^{m}-{S^{m}}^{\prime}=\{s\in S\mid\forall b\in s,</annotation></semantics></math></span></span>
