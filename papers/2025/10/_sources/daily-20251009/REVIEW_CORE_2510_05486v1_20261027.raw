<span id="S3.T1.2.6.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S3.T1.m11" class="ltx_math_unparsed" alttext="\text{height(b)}&gt;1\}" display="inline" intent=":literal"><semantics><mrow><mtext>height(b)</mtext><mo>&gt;</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\text{height(b)}&gt;1\}</annotation></semantics></math></span></span>
</span></span><span id="S3.T1.2.6.3.3" class="ltx_text"></span></td>
