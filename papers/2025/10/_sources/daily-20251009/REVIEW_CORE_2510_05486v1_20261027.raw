<td id="S3.T1.2.6.2" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="S3.T1.2.6.2.1" class="ltx_text"></span><span id="S3.T1.2.6.2.2" class="ltx_text">
