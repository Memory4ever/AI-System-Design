<td id="Sx6.T5.1.1.3" class="ltx_td ltx_align_center ltx_border_t">IS<math id="Sx6.T5.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="Sx6.T5.1.1.4" class="ltx_td ltx_align_center ltx_border_t">mIoU<math id="Sx6.T5.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="Sx6.T5.1.2" class="ltx_tr">
<td id="Sx6.T5.1.2.1" class="ltx_td ltx_align_center ltx_border_t">0.7</td>
<td id="Sx6.T5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">25.7</td>
<td id="Sx6.T5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">17.2</td>
<td id="Sx6.T5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">67.8</td></tr>
