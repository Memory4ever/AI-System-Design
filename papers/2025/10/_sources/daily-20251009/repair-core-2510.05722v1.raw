<td id="Sx4.T3.1.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx4.T3.1.1.2.1" class="ltx_text ltx_font_bold">Class</span></td>
<td id="Sx4.T3.1.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx4.T3.1.1.3.1" class="ltx_text ltx_font_bold">Caption</span></td>
<td id="Sx4.T3.1.1.4" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx4.T3.1.1.4.1" class="ltx_text ltx_font_bold">Our prompt</span></td></tr>
