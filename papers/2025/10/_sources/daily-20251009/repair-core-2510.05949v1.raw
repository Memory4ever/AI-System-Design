          <span id="lstnumberx4.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">  </span><span id="lstnumberx4.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">J</span><span id="lstnumberx4.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx4.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">=</span><span id="lstnumberx4.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx4.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">jacobian</span><span id="lstnumberx4.8" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx4.9" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#FF00FF;">lambda</span><span id="lstnumberx4.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx4.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">x</span><span id="lstnumberx4.12" class="ltx_text ltx_font_typewriter" style="font-size:80%;">:</span><span id="lstnumberx4.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx4.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">model</span><span id="lstnumberx4.15" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx4.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">x</span><span id="lstnumberx4.17" class="ltx_text ltx_font_typewriter" style="font-size:80%;">).</span><span id="lstnumberx4.18" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#FF00FF;">sum</span><span id="lstnumberx4.19" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(0),</span><span id="lstnumberx4.