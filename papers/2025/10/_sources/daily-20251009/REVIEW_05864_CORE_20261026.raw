</span></td>
<td id="S5.T2.2.2.7" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S5.T2.2.2.7.1" class="ltx_inline-block ltx_align_top" style="width:14.2pt;">
<span id="S5.T2.2.2.7.1.1" class="ltx_p">Llama</span>
</span></td>
<td id="S5.T2.2.2.8" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S5.T2.2.2.8.1" class="ltx_inline-block ltx_align_top" style="width:14.2pt;">
<span id="S5.T2.2.2.8.1.1" class="ltx_p">Qwen</span>
</span></td>
<td id="S5.T2.2.2.9" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S5.T2.2.2.9.1" class="ltx_inline-block ltx_align_top" style="width:14.2pt;">
<span id="S5.T2.2.2.9.1.1" class="ltx_p">Mistral</span>
</span></td></tr>
<tr id="S5.T2.2.3" class="ltx_tr">
<td id="S5.T2.2.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S5.T2.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:0.9pt;">
<span id="S5.T2.2.3.1.1.1" class="ltx_p">
<span id="S5.T2.2.3.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.8pt;height:18.3pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:18.3pt;transform:translate(-5.8pt,-5.8pt) rotate(-90deg) ;">
<span id="S5.T2.2.3.1.1.1.1.1" class="ltx_p">IHC</span>
</span></span></span>
</span></td>
<td id="S5.T2.2.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t"></td>
<td id="S5.T2.2.3.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S5.T2.2.3.3.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="S5.T2.2.3.3.1.1" class="ltx_p">Macro-F1</span>
</span></td>
<td id="S5.T2.2.3.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S5.T2.2.3.4.1" class="ltx_inline-block ltx_align_top" style="width:14.2pt;">
<span id="S5.T2.2.3.4.1.1" class="ltx_p">58.40</span>
</span></td>
<td id="S5.T2.2.3.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S5.T2.2.3.5.1" class="ltx_inline-block ltx_align_top" style="width:14.2pt;">
<span id="S5.T2.2.3.5.1.1" class="ltx_p">68.96</span>
