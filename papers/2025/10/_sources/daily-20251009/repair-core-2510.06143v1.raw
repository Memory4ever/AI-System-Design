<td id="S4.T1.2.10.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.10.2.1" class="ltx_text ltx_font_bold">20 (60.61%)</span></td>
<td id="S4.T1.2.10.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.10.3.1" class="ltx_text ltx_font_bold">15 (45.45%)</span></td></tr>
