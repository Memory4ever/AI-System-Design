<td id="S9.T2.4.1.8.4" class="ltx_td ltx_align_center"><math id="S9.T2.m2" class="ltx_Math" alttext="1\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-5}</annotation></semantics></math></td></tr>
<tr id="S9.T2.4.1.9" class="ltx_tr">
<td id="S9.T2.4.1.9.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_r">Twist relaxation</td>
