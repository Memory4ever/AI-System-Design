<td id="S4.T3.4.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="S4.T3.4.1.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Generic</span></td>
