<td id="S4.T3.4.2.8" class="ltx_td ltx_align_center"><span id="S4.T3.4.2.8.1" class="ltx_text" style="font-size:90%;">F<sub id="S4.T3.4.2.8.1.1" class="ltx_sub"><span id="S4.T3.4.2.8.1.1.1" class="ltx_text ltx_font_italic">1&gt;</span></sub></span></td>
