<td id="S4.T3.4.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.3.7.1" class="ltx_text" style="font-size:90%;">0.06</span></td>
<td id="S4.T3.4.3.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T3.4.3.8.1" class="ltx_text" style="font-size:90%;">0.07</span></td>
<td id="S4.T3.4.3.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.3.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.28</span></td>
<td id="S4.T3.4.3.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.3.10.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.10</span></td>
<td id="S4.T3.4.3.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.3.11.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.11</span></td></tr>
<tr id="S4.T3.4.4" class="ltx_tr">
<td id="S4.T3.4.4.1" class="ltx_td ltx_align_left"><span id="S4.T3.4.4.1.1" class="ltx_text" style="font-size:90%;">Claude3</span></td>
