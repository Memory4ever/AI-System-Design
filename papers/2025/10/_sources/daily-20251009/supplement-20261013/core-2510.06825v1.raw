<span id="A3.I2.i5.p1.1" class="ltx_p"><span id="A3.I2.i5.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Data Analysis</span><span id="A3.I2.i5.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="A3.I2.i5.p1.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math><span id="A3.I2.i5.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> Use data processing tools + python_sandbox</span></span>
