<tr id="S5.T3.3.2" class="ltx_tr">
<td id="S5.T3.3.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><math id="S5.T3.m6" class="ltx_Math" alttext="\textbf{WM}_{\textbf{RGB}}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_bold">WM</mtext><mtext class="ltx_mathvariant_bold">RGB</mtext></msub><annotation encoding="application/x-tex">\textbf{WM}_{\textbf{RGB}}</annotation></semantics></math>  (sim)</td>
