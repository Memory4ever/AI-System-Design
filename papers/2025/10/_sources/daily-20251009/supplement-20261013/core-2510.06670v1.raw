<td id="S4.T3.2.1.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">ShareGPT</td>
<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">66.03</td>
