<span id="S3.T5.1.17.1.1" class="ltx_inline-block ltx_align_top" style="width:199.2pt;">
<span id="S3.T5.1.17.1.1.1" class="ltx_p">Percentage <math id="S3.T5.m3" class="ltx_Math" alttext="GSP" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">GSP</annotation></semantics></math> Actions</span>
</span></td>
