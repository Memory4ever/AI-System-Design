<tr id="S6.T1.5.5" class="ltx_tr">
<td id="S6.T1.5.5.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.5.1.1" class="ltx_text" style="font-size:90%;">CodeSearchNet <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib26" title="" class="ltx_ref">Husain et al., 2019</a>)</cite></span></td>
<td id="S6.T1.5.5.2" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.5.2.1" class="ltx_text" style="font-size:90%;">294.0</span></td>
<td id="S6.T1.5.5.3" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.5.3.1" class="ltx_text" style="font-size:90%;">0.40</span></td></tr>
