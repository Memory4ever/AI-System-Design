<td id="S6.T1.5.3.2" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.3.2.1" class="ltx_text" style="font-size:90%;">59.5</span></td>
<td id="S6.T1.5.3.3" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.3.3.1" class="ltx_text" style="font-size:90%;">0.23</span></td></tr>
<tr id="S6.T1.5.4" class="ltx_tr">
<td id="S6.T1.5.4.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.4.1.1" class="ltx_text" style="font-size:90%;">MSMARCO <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib9" title="" class="ltx_ref">Chen et al., 2024a</a>)</cite></span></td>
<td id="S6.T1.5.4.2" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.4.2.1" class="ltx_text" style="font-size:90%;">73.5</span></td>
