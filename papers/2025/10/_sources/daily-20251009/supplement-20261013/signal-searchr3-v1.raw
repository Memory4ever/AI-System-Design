<td id="S6.T1.5.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.2.1.1" class="ltx_text" style="font-size:90%;">TriviaQA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib28" title="" class="ltx_ref">Joshi et al., 2017</a>)</cite></span></td>
<td id="S6.T1.5.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.2.2.1" class="ltx_text" style="font-size:90%;">30.4</span></td>
<td id="S6.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T1.5.2.3.1" class="ltx_text" style="font-size:90%;">0.21</span></td></tr>
