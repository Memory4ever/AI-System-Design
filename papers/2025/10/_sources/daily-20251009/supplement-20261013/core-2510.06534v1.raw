<span id="A1.SS2.p1.pic1.2.19" class="ltx_p" style="width:438.5pt;"><span id="A1.SS2.p1.pic1.2.19.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS2.p1.pic1.2.19.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:438.5pt;"></span></span></span>
<span id="A1.SS2.p1.pic1.2.20" class="ltx_p" style="width:438.5pt;"><span id="A1.SS2.p1.pic1.2.20.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS2.p1.pic1.2.20.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:438.5pt;">
