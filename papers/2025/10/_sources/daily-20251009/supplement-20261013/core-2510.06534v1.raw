<td id="S6.T3.2.1.3.3" class="ltx_td ltx_align_center">Evaluation</td>
<td id="S6.T3.2.1.3.4" class="ltx_td ltx_align_center">Search</td>
<td id="S6.T3.2.1.3.5" class="ltx_td ltx_align_center">Recovery</td>
<td id="S6.T3.2.1.3.6" class="ltx_td"></td>
<td id="S6.T3.2.1.3.7" class="ltx_td"></td>
<td id="S6.T3.2.1.3.8" class="ltx_td"></td></tr>
<tr id="S6.T3.2.1.4" class="ltx_tr">
<td id="S6.T3.2.1.4.1" class="ltx_td ltx_align_left ltx_border_t">Qwen3-1.7B</td>
<td id="S6.T3.2.1.4.2" class="ltx_td ltx_align_center ltx_border_t">28.3</td>
<td id="S6.T3.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t">18.1</td>
<td id="S6.T3.2.1.4.4" class="ltx_td ltx_align_center ltx_border_t">18.2</td>
<td id="S6.T3.2.1.4.5" class="ltx_td ltx_align_center ltx_border_t">39.7</td>
<td id="S6.T3.2.1.4.6" class="ltx_td ltx_align_center ltx_border_t">15.3</td>
<td id="S6.T3.2.1.4.7" class="ltx_td ltx_align_center ltx_border_t">3.9</td>
<td id="S6.T3.2.1.4.8" class="ltx_td ltx_align_center ltx_border_t">4.0</td></tr>
