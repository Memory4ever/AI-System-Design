<td id="S5.T2.4.1.20.1" class="ltx_td ltx_align_left ltx_border_b">Llama3.2-3B-Instruct + Behavior Prime + RL</td>
<td id="S5.T2.4.1.20.2" class="ltx_td ltx_align_center ltx_border_b">25.6</td>
<td id="S5.T2.4.1.20.3" class="ltx_td ltx_align_center ltx_border_b">11.5</td>
<td id="S5.T2.4.1.20.4" class="ltx_td ltx_align_center ltx_border_b">8.3</td>
