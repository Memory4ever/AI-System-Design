<td id="S5.T2.4.1.18.1" class="ltx_td ltx_align_left">Qwen3-1.7B + Behavior Prime (Correct) + RL</td>
<td id="S5.T2.4.1.18.2" class="ltx_td ltx_align_center"><span id="S5.T2.4.1.18.2.1" class="ltx_text ltx_font_bold">30.8</span></td>
<td id="S5.T2.4.1.18.3" class="ltx_td ltx_align_center">23.1</td>
<td id="S5.T2.4.1.18.4" class="ltx_td ltx_align_center"><span id="S5.T2.4.1.18.4.1" class="ltx_text ltx_font_bold">16.7</span></td>
<td id="S5.T2.4.1.18.5" class="ltx_td ltx_align_center ltx_border_r">25.2</td>
