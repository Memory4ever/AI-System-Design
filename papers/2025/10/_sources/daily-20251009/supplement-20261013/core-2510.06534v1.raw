<td id="S5.T2.4.1.18.7" class="ltx_td ltx_align_center ltx_border_r">7.8</td>
<td id="S5.T2.4.1.18.8" class="ltx_td ltx_align_center"><span id="S5.T2.4.1.18.8.1" class="ltx_text ltx_font_bold">23.6</span></td></tr>
<tr id="S5.T2.4.1.19" class="ltx_tr">
<td id="S5.T2.4.1.19.1" class="ltx_td ltx_align_left ltx_border_t">Llama3.2-3B-Instruct + RL</td>
<td id="S5.T2.4.1.19.2" class="ltx_td ltx_align_center ltx_border_t">12.8</td>
