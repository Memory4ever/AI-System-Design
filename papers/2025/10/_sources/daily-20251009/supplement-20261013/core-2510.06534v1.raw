</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Prompt for LLM-Judge Evaluation</h3>

<div id="A1.SS4.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SS4.p1.pic1" class="ltx_picture" height="202.6" overflow="visible" version="1.1" viewBox="0 0 650 202.6" width="650"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,202.6) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#BFBFBF;" fill="#BFBFBF" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 196.69 C 0 199.96 2.64 202.6 5.91 202.6 L 644.09 202.6 C 647.36 202.6 650 199.96 650 196.69 L 650 5.91 C 650 2.64 647.36 0 644.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 178.49 L 648.03 178.49 L 648.03 5.91 C 648.03 3.73 646.27 1.97 644.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 187.09)"><foreignObject style="--ltx-fo-width:43.85em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="606.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.SS4.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:43.85em;">
<span id="A1.SS4.p1.pic1.1.1" class="ltx_p"><span id="A1.SS4.p1.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;">Prompt For LLM-Judge Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 17.24)"><foreignObject style="--ltx-fo-width:41.76em;--ltx-fo-height:10.8em;--ltx-fo-depth:0.25em;font-size:10pt;" height="152.9" overflow="visible" transform="matrix(1 0 0 -1 0 149.44)" width="577.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.SS4.p1.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:41.76em;">
<span id="A1.SS4.p1.pic1.2.1" class="ltx_p"><span id="A1.SS4.p1.pic1.2.1.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS4.p1.pic1.2.1.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:438.5pt;"></span></span></span>
<span id="A1.SS4.p1.pic1.2.2" class="ltx_p" style="width:438.5pt;"><span id="A1.SS4.p1.pic1.2.2.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS4.p1.pic1.2.2.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A1.SS4.p1.pic1.2.2.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A1.SS4.p1.pic1.2.2.1.3" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:438.5pt;">
<span id="A1.SS4.p1.pic1.p2" class="ltx_para ltx_noindent">
<span id="A1.SS4.p1.pic1.p2.1" class="ltx_p">Please determine if the predicted answer is SEMANTICALLY equivalent to the labeled answer.</span>
</span></span></span></span>
<span id="A1.SS4.p1.pic1.2.3" class="ltx_p" style="width:438.5pt;"><span id="A1.SS4.p1.pic1.2.3.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS4.p1.pic1.2.3.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:438.5pt;">
<span id="A1.SS4.p1.pic1.p3" class="ltx_para ltx_noindent">
<span id="A1.SS4.p1.pic1.p3.1" class="ltx_p">Question:  {question}</span>
</span></span></span></span>
<span id="A1.SS4.p1.pic1.2.4" class="ltx_p" style="width:438.5pt;"><span id="A1.SS4.p1.pic1.2.4.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS4.p1.pic1.2.4.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:438.5pt;">
<span id="A1.SS4.p1.pic1.p4" class="ltx_para ltx_noindent">
<span id="A1.SS4.p1.pic1.p4.1" class="ltx_p">Labeled Answer:  {gt_answer}</span>
</span></span></span></span>
<span id="A1.SS4.p1.pic1.2.5" class="ltx_p" style="width:438.5pt;"><span id="A1.SS4.p1.pic1.2.5.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS4.p1.pic1.2.5.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:438.5pt;">
<span id="A1.SS4.p1.pic1.p5" class="ltx_para ltx_noindent">
<span id="A1.SS4.p1.pic1.p5.1" class="ltx_p">Predicted Answer: {pred_answer}</span>
</span></span></span></span>
<span id="A1.SS4.p1.pic1.2.6" class="ltx_p" style="width:438.5pt;"><span id="A1.SS4.p1.pic1.2.6.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS4.p1.pic1.2.6.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:438.5pt;"></span></span></span>
<span id="A1.SS4.p1.pic1.2.7" class="ltx_p" style="width:438.5pt;"><span id="A1.SS4.p1.pic1.2.7.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS4.p1.pic1.2.7.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:438.5pt;">
<span id="A1.SS4.p1.pic1.p7" class="ltx_para ltx_noindent">
<span id="A1.SS4.p1.pic1.p7.1" class="ltx_p">{{</span>
</span></span></span></span>
<span id="A1.SS4.p1.pic1.2.8" class="ltx_p" style="width:438.5pt;"><span id="A1.SS4.p1.pic1.2.8.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:438.5pt;--ltx-fg-color:#000000;"><span id="A1.SS4.p1.pic1.2.8.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:438.5pt;">
