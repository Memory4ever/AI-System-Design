<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">have</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">complete</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">freedom</span><span id="lstnumberx3.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx3.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">choose</span><span id="lstnumberx3.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx3.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">set</span><span id="lstnumberx3.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx3.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">operators</span><span id="lstnumberx3.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">you</span><span id="lstnumberx3.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">want</span><span id="lstnumberx3.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx3.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">replace</span><span id="lstnumberx3.28" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx3.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx3.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">may</span><span id="lstnumberx3.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">make</span><span id="lstnumberx3.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx3.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">decision</span><span id="lstnumberx3.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx3.41" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter">replace</span><span id="lstnumberx3.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter">some</span><span id="lstnumberx3.45" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter">operators</span><span id="lstnumberx3.47" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.48" class="ltx_text ltx_lst_identifier ltx_font_typewriter">with</span><span id="lstnumberx3.49" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter">custom</span><span id="lstnumberx3.51" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.52" class="ltx_text ltx_lst_identifier ltx_font_typewriter">cuda</span><span id="lstnumberx3.53" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.54" class="ltx_text ltx_lst_identifier ltx_font_typewriter">kernels</span><span id="lstnumberx3.55" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.56" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx3.57" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.58" class="ltx_text ltx_lst_identifier ltx_font_typewriter">leave</span><span id="lstnumberx3.59" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.60" class="ltx_text ltx_lst_identifier ltx_font_typewriter">others</span><span id="lstnumberx3.61" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter">unchanged</span><span id="lstnumberx3.63" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx3.64" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.65" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx3.66" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.67" class="ltx_text ltx_lst_identifier ltx_font_typewriter">may</span><span id