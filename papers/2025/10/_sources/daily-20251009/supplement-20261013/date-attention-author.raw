_fill_lanczos_center_2.png><link rel=apple-touch-icon type=image/png href=/images/icon_hu0b7a4cb9992c9ac0e91bd28ffd38dd00_9727_192x192_fill_lanczos_center_2.png><link rel=canonical href=https://www.ravid-shwartz-ziv.com/publication/attention-sinks-compression-valleys/><meta property="twitter:card" content="summary_large_image"><meta property="twitter:site" content="@ziv_ravid"><meta property="twitter:creator" content="@ziv_ravid"><meta property="og:site_name" content="Ravid Shwartz Ziv"><meta property="og:url" content="https://www.ravid-shwartz-ziv.com/publication/attention-sinks-compression-valleys/"><meta property="og:title" content="Attention Sinks and Compression Valleys in LLMs are Two Sides of the Same Coin | Ravid Shwartz Ziv"><meta property="og:description" content="Connecting attention sinks to representation compression to explain how information changes across LLM layers."><meta property="og:image" content="https://www.ravid-shwartz-ziv.com/img/ravid-shwartz-ziv-social-v3.png"><meta property="twitter:image" content="https://www.ravid-shwartz-ziv.com/img/ravid-shwartz-ziv-social-v3.png"><meta property="og:locale" content="en-us"><meta property="article:published_time" content="2025-10-07T21:27:24+00:00"><meta property="article:modified_time" content="2026-08-26T14:28:56-04:00"><script type=application/ld+json>{"@context":"https://schema.org","@type":"Article","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.ravid-shwartz-ziv.com/publication/attention-sinks-compression-valleys/"},"headline":"Attention Sinks and Compression Valleys in LLMs are Two Sides of the Same Coin","datePublished":"2025-10-07T21:27:24Z","dateModified":"2026-08-26T14:28:56-04:00","author":{"@type":"Person","name":"Enrique Queipo-de-Llano"},"publisher":{"@type":"Organization","name":"Ravid Shwartz Ziv","logo":{"@type":"ImageObject","url":"https://www.ravid-shwartz-ziv.com/images/logo_hu0f76066babba471aea3aa4f20fb6fb27_115025_192x192_fit_lanczos_2.png"}},"description":"Connecting 