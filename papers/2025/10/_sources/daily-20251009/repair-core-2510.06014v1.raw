<tr id="A6.T3.2.1.4" class="ltx_tr">
<td id="A6.T3.2.1.4.1" class="ltx_td ltx_align_left ltx_border_r"><a href="https://openai.com/index/introducing-o3-and-o4-mini/" title="" class="ltx_ref ltx_href">o3</a> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">OpenAI, 2025b</a>)</cite></td>
<td id="A6.T3.2.1.4.2" class="ltx_td ltx_align_center ltx_border_r">/</td>
