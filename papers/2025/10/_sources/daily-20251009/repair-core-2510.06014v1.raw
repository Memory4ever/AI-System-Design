<tr id="S3.T1.2.5" class="ltx_tr">
<td id="S3.T1.2.5.1" class="ltx_td ltx_align_left">o3-mini</td>
<td id="S3.T1.2.5.2" class="ltx_td ltx_align_right">0.1306</td>
<td id="S3.T1.2.5.3" class="ltx_td ltx_align_right">0.0374</td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_right">0.1888</td>
<td id="S3.T1.2.5.5" class="ltx_td ltx_align_right">0.0302</td>
<td id="S3.T1.2.5.6" class="ltx_td ltx_align_right">0.1649</td>
<td id="S3.T1.2.5.7" class="ltx_td ltx_align_right">0.0221</td>
<td id="S3.T1.2.5.8" class="ltx_td ltx_align_right">0.1663</td>
