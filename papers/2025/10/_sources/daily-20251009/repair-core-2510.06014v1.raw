<td id="S3.T1.2.2.7" class="ltx_td ltx_align_right ltx_border_t">ARISE</td>
<td id="S3.T1.2.2.8" class="ltx_td ltx_align_right ltx_border_t">SM<math id="S3.T1.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>1000</td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<td id="S3.T1.2.3.1" class="ltx_td ltx_align_left ltx_border_t">o1</td>
