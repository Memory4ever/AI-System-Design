<td id="A6.T3.2.1.4.5" class="ltx_td ltx_align_center ltx_border_r">Effort</td>
<td id="A6.T3.2.1.4.6" class="ltx_td ltx_align_center">OpenAI</td></tr>
<tr id="A6.T3.2.1.5" class="ltx_tr">
<td id="A6.T3.2.1.5.1" class="ltx_td ltx_align_left ltx_border_r"><a href="https://openai.com/index/openai-o3-mini/" title="" class="ltx_ref ltx_href">o3-mini</a> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">OpenAI, 2025d</a>)</cite></td>
<td id="A6.T3.2.1.5.2" class="ltx_td ltx_align_center ltx_border_r">/</td>
<td id="A6.T3.2.1.5.3" class="ltx_td ltx_align_center ltx_border_r">2025-01</td>
<td id="A6.T3.2.1.5.4" class="ltx_td ltx_align_center ltx_border_r">200K</td>
