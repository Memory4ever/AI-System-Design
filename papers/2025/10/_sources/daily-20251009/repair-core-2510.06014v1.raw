<td id="S3.T1.2.3.5" class="ltx_td ltx_align_right ltx_border_t">0.0183</td>
<td id="S3.T1.2.3.6" class="ltx_td ltx_align_right ltx_border_t">0.1228</td>
<td id="S3.T1.2.3.7" class="ltx_td ltx_align_right ltx_border_t">0.0385</td>
<td id="S3.T1.2.3.8" class="ltx_td ltx_align_right ltx_border_t">0.1509</td>
<td id="S3.T1.2.3.9" class="ltx_td ltx_align_right ltx_border_t">0.0504</td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<td id="S3.T1.2.4.1" class="ltx_td ltx_align_left">o3</td>
<td id="S3.T1.2.4.2" class="ltx_td ltx_align_right">0.2993</td>
<td id="S3.T1.2.4.3" class="ltx_td ltx_align_right">0.0782</td>
<td id="S3.T1.2.4.4" class="ltx_td ltx_align_right">0.1673</td>
<td id="S3.T1.2.4.5" class="ltx_td ltx_align_right">0.0186</td>
<td id="S3.T1.2.4.6" class="ltx_td ltx_align_right">0.2124</td>
<td id="S3.T1.2.4.7" class="ltx_td ltx_align_right">0.0589</td>
