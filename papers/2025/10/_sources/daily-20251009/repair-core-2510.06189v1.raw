<td id="S6.T3.2.1.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:1.75pt;padding-bottom:1.75pt;">
<span id="S6.T3.2.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:79.7pt;">
<span id="S6.T3.2.1.2.1.1.1" class="ltx_p"><span id="S6.T3.2.1.2.1.1.1.1" class="ltx_text"></span><span id="S6.T3.2.1.2.1.1.1.2" class="ltx_text">
<span id="S6.T3.2.1.2.1.1.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S6.T3.2.1.2.1.1.1.2.1.1" class="ltx_tr">
<span id="S6.T3.2.1.2.1.1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:1.75pt;padding-bottom:1.75pt;">Runtime</span></span>
<span id="S6.T3.2.1.2.1.1.1.2.1.2" class="ltx_tr">
<span id="S6.T3.2.1.2.1.1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:1.75pt;padding-bottom:1.75pt;">Errors</span></span>
</span></span><span id="S6.T3.2.1.2.1.1.1.3" class="ltx_text"></span></span>
</span></td>
<td id="S6.T3.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.75pt;padding-bottom:1.75pt;"><span id="S6.T3.2.1.2.2.1" class="ltx_text ltx_font_italic">Syntax &amp; Interface Errors</span></td>
<td id="S6.T3.2.1.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:1.75pt;padding-bottom:1.75pt;">
<span id="S6.T3.2.1.2.3.1" class="ltx_inline-block ltx_align_top" style="width:250.4pt;">
