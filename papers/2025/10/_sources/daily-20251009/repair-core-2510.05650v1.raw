              <math id="alg3.m10" class="ltx_Math" alttext="S[\text{longterm\_summary}][i]\leftarrow L_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">longterm_summary</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow><annotation encoding="application/x-tex">S[\text{longterm\_summary}][i]\leftarrow L_{i}</annotation></semantics></math><span id="alg3.7.5.4" class="ltx_text" style="--ltx-fg-color:#000000;">;</span>
</div>
<div id="alg3.7.6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.7.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">4</span></span>
              <math id="alg3.m11" class="ltx_Math" alttext="S[\text{interaction\_log}][i][t]\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">interaction_log</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">S[\text{interaction\_log}][i][t]\leftarrow</annotation></semantics></math><span id="alg3.7.6.2" class="ltx_text" style="--ltx-fg-color:#000000;"> {
</span>
</div>
<div id="alg3.7.7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.7.7.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">5</span></span>
              <span id="alg3.7.7.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="alg3.m12" class="ltx_Math" alttext="\text{teacher\_interactions}:~s_{i}^{t}.\text{teacher\_content}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">teacher_interactions</mtext><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.608em">:</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">.</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">teacher_content</mtext></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\text{teacher\_interactions}:~s_{i}^{t}.\text{teacher\_content},</annotation></semantics></math><span id="alg3.7.7.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span>
</div>
