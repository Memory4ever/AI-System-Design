<span id="A2.T1.5.8.3.1.1" class="ltx_p ltx_align_left"><span id="A2.T1.5.8.3.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Daily Utilities</span></span>
</span></td>
