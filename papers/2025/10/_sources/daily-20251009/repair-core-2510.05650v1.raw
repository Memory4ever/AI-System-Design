<td id="A3.T4.9.3.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A3.T4.9.3.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">41</span></td>
