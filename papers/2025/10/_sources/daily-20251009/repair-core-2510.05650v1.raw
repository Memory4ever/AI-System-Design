<td id="A3.T4.9.3.7" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A3.T4.9.3.7.1" class="ltx_text" style="--ltx-fg-color:#000000;">0.293</span></td></tr>
