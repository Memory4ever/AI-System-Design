</span></span></span></span>
<span id="A7.F61.pic1.2.7" class="ltx_p" style="width:440.7pt;"><span id="A7.F61.pic1.2.7.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F61.pic1.2.7.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:440.7pt;"></span></span></span>
<span id="A7.F61.pic1.2.8" class="ltx_p" style="width:440.7pt;"><span id="A7.F61.pic1.2.8.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F61.pic1.2.8.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
<span id="A7.F61.pic1.p8" class="ltx_para ltx_noindent">
<span id="A7.F61.pic1.p8.1" class="ltx_p"># Rating Criteria:</span>
</span></span></span></span>
<span id="A7.F61.pic1.2.9" class="ltx_p" style="width:440.7pt;"><span id="A7.F61.pic1.2.9.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F61.pic1.2.9.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
