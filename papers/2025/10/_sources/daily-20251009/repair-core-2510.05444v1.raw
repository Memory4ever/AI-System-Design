<span id="A7.F47.pic1.p15.1" class="ltx_p">"Feature Name": "name of feature",</span>
</span></span></span></span>
<span id="A7.F47.pic1.2.16" class="ltx_p" style="width:440.7pt;"><span id="A7.F47.pic1.2.16.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F47.pic1.2.16.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
