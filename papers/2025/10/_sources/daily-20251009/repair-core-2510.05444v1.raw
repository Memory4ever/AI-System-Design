<td id="S6.T3.2.1.19.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">8.82</td>
<td id="S6.T3.2.1.19.5" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">7.53</td></tr>
