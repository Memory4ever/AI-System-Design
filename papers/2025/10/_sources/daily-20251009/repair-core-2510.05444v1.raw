<td id="S4.T2.2.1.2.7" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.2.1.2.7.1" class="ltx_text ltx_font_italic">Cost ($)</span></td></tr>
