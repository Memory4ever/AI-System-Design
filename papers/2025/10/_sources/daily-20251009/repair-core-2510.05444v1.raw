<span id="A7.F63.pic1.2.26" class="ltx_p" style="width:440.7pt;"><span id="A7.F63.pic1.2.26.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F63.pic1.2.26.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:440.7pt;"></span></span></span>
<span id="A7.F63.pic1.2.27" class="ltx_p" style="width:440.7pt;"><span id="A7.F63.pic1.2.27.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F63.pic1.2.27.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
<span id="A7.F63.pic1.p27" class="ltx_para ltx_noindent">
<span id="A7.F63.pic1.p27.1" class="ltx_p">3. **Comparison and Reasoning**</span>
</span></span></span></span>
<span id="A7.F63.pic1.2.28" class="ltx_p" style="width:440.7pt;"><span id="A7.F63.pic1.2.28.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F63.pic1.2.28.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"></span><span id="A7.F63.pic1.2.28.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A7.F63.pic1.2.28.1.3" class="ltx_text ltx_inline-block" style="width:21.1pt;"> </span><span id="A7.F63.pic1.2.28.1.4" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:419.6pt;">
