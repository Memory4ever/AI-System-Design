<span id="A7.F48.pic1.p31" class="ltx_para ltx_noindent">
<span id="A7.F48.pic1.p31.1" class="ltx_p">### 2. New Features</span>
</span></span></span></span>
<span id="A7.F48.pic1.2.32" class="ltx_p" style="width:440.7pt;"><span id="A7.F48.pic1.2.32.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F48.pic1.2.32.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
<span id="A7.F48.pic1.p32" class="ltx_para ltx_noindent">
<span id="A7.F48.pic1.p32.1" class="ltx_p">```json</span>
</span></span></span></span>
<span id="A7.F48.pic1.2.33" class="ltx_p" style="width:440.7pt;"><span id="A7.F48.pic1.2.33.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F48.pic1.2.33.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
