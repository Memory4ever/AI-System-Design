<span id="A7.F48.pic1.p33.1" class="ltx_p">[</span>
</span></span></span></span>
<span id="A7.F48.pic1.2.34" class="ltx_p" style="width:440.7pt;"><span id="A7.F48.pic1.2.34.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F48.pic1.2.34.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
<span id="A7.F48.pic1.p34" class="ltx_para ltx_noindent">
<span id="A7.F48.pic1.p34.1" class="ltx_p">{{</span>
</span></span></span></span>
<span id="A7.F48.pic1.2.35" class="ltx_p" style="width:440.7pt;"><span id="A7.F48.pic1.2.35.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F48.pic1.2.35.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
<span id="A7.F48.pic1.p35" class="ltx_para ltx_noindent">
<span id="A7.F48.pic1.p35.1" class="ltx_p">"Feature Name": "name of feature",</span>
</span></span></span></span>
<span id="A7.F48.pic1.2.36" class="ltx_p" style="width:440.7pt;"><span id="A7.F48.pic1.2.36.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F48.pic1.2.36.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
