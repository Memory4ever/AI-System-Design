<span id="A7.F44.pic1.p3" class="ltx_para ltx_noindent">
<span id="A7.F44.pic1.p3.1" class="ltx_p"># User Message Style</span>
</span></span></span></span>
<span id="A7.F44.pic1.2.4" class="ltx_p" style="width:440.7pt;"><span id="A7.F44.pic1.2.4.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F44.pic1.2.4.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
<span id="A7.F44.pic1.p4" class="ltx_para ltx_noindent">
<span id="A7.F44.pic1.p4.1" class="ltx_p">{user_message_style}</span>
</span></span></span></span>
<span id="A7.F44.pic1.2.5" class="ltx_p" style="width:440.7pt;"><span id="A7.F44.pic1.2.5.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F44.pic1.2.5.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:440.7pt;"></span></span></span>
