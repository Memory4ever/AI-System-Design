<span id="A7.F50.pic1.2.23" class="ltx_p" style="width:440.7pt;"><span id="A7.F50.pic1.2.23.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F50.pic1.2.23.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
