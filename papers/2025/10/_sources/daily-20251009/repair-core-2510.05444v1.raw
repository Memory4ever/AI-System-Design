</span></span><span id="S6.T3.2.1.2.3.3" class="ltx_text"></span></td>
<td id="S6.T3.2.1.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S6.T3.2.1.2.4.1" class="ltx_text"></span> <span id="S6.T3.2.1.2.4.2" class="ltx_text">
