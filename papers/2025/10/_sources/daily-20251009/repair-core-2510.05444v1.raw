<figure id="A7.F55" class="ltx_figure"><span class="ltx_inline-block"><svg id="A7.F55.pic1" class="ltx_picture ltx_centering" height="640.65" overflow="visible" version="1.1" viewBox="0 0 653.15 640.65" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,640.65) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 622.61 C 0 625.87 2.64 628.51 5.91 628.51 L 647.24 628.51 C 650.51 628.51 653.15 625.87 653.15 622.61 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 622.61 C 1.97 624.78 3.73 626.54 5.91 626.54 L 647.24 626.54 C 649.42 626.54 651.18 624.78 651.18 622.61 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g transform="matrix(1.0 0.0 0.0 1.0 15 618.51)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0)"><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 0 2.95 L 0 19.19 C 0 20.82 1.32 22.14 2.95 22.14 L 381.05 22.14 C 382.68 22.14 384 20.82 384 19.19 L 384 2.95 C 384 1.32 382.68 0 381.05 0 L 2.95 0 C 1.32 0 0 1.32 0 2.95 Z"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 2.95 L 0 19.19 C 0 20.82 1.32 22.14 2.95 22.14 L 381.05 22.14 C 382.68 22.14 384 20.82 384 19.19 L 384 2.95 C 384 1.32 382.68 0 381.05 0 L 2.95 0 C 1.32 0 0 1.32 0 2.95 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 11.81 7.61)"><foreignObject style="--ltx-fo-width:26.13em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="361.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A7.F55.pic1.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;">Extract Document Preference Features from User Messages</span></span></span></foreignObject></g></g></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 17.24)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:42.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="595" overflow="visible" transform="matrix(1 0 0 -1 0 591.54)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A7.F55.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:44.07em;">
<span id="A7.F55.pic1.2.1" class="ltx_p"><span id="A7.F55.pic1.2.1.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F55.pic1.2.1.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"></span><span id="A7.F55.pic1.2.1.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A7.F55.pic1.2.1.1.3" class="ltx_text ltx_inline-block" style="width:21.1pt;"> </span><span id="A7.F55.pic1.2.1.1.4" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:419.6pt;">
<span id="A7.F55.pic1.p1" class="ltx_para ltx_noindent">
<span id="A7.F55.pic1.p1.1" class="ltx_p">You are a **document preference analysis expert**. Your goal is to review **real user messages** for a specific document type and propose **additional document preferences** that aren’t already covered by the existing preferences.</span>
</span></span></span></span>
<span id="A7.F55.pic1.2.2" class="ltx_p" style="width:440.7pt;"><span id="A7.F55.pic1.2.2.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F55.pic1.2.2.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:440.7pt;"></span></span></span>
<span id="A7.F55.pic1.2.3" class="ltx_p" style="width:440.7pt;"><span id="A7.F55.pic1.2.3.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F55.pic1.2.3.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"></span><span id="A7.F55.pic1.2.3.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A7.F55.pic1.2.3.1.3" class="ltx_text ltx_inline-block" style="width:21.1pt;"> </span><span id="A7.F55.pic1.2.3.1.4" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:419.6pt;">
<span id="A7.F55.pic1.p3" class="ltx_para ltx_noindent">
<span id="A7.F55.pic1.p3.1" class="ltx_p">A *preference* refers to any specified style, tone, structure, format, or other guidance about how the document should be written.</span>
</span></span></span></span>
<span id="A7.F55.pic1.2.4" class="ltx_p" style="width:440.7pt;"><span id="A7.F55.pic1.2.4.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F55.pic1.2.4.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:440.7pt;"></span></span></span>
<span id="A7.F55.pic1.2.5" class="ltx_p" style="width:440.7pt;"><span id="A7.F55.pic1.2.5.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F55.pic1.2.5.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
<span id="A7.F55.pic1.p5" class="ltx_para ltx_noindent">
<span id="A7.F55.pic1.p5.1" class="ltx_p"># Input</span>
</span></span></span></span>
<span id="A7.F55.pic1.2.6" class="ltx_p" style="width:440.7pt;"><span id="A7.F55.pic1.2.6.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F55.pic1.2.6.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
<span id="A7.F55.pic1.p6" class="ltx_para ltx_noindent">
<span id="A7.F55.pic1.p6.1" class="ltx_p">## Document Type</span>
</span></span></span></span>
<span id="A7.F55.pic1.2.7" class="ltx_p" style="width:440.7pt;"><span id="A7.F55.pic1.2.7.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:440.7pt;--ltx-fg-color:#000000;"><span id="A7.F55.pic1.2.7.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:440.7pt;">
