<td id="A2.T4.2.1.12.4" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="A2.T4.2.1.12.4.1" class="ltx_text ltx_font_bold">8.41</span></td>
