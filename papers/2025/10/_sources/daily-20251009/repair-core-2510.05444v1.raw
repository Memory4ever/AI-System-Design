-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="287.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A7.F23.p1.pic1.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;">Document Creation Simulator-AI Conversation</span></span></span></foreignObject></g></g></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 13.78)"><foreignObject style="--ltx-fo-width:13.43em;--ltx-fo-height:15.15em;--ltx-fo-depth:0em;font-size:10pt;" height="209.63" overflow="visible" transform="matrix(1 0 0 -1 0 209.63)" width="185.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
