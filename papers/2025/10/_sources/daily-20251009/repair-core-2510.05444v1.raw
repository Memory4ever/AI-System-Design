<td id="S4.T2.2.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">zero-shot</td>
<td id="S4.T2.2.1.3.2" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">5.8</td>
<td id="S4.T2.2.1.3.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">87.6</td>
<td id="S4.T2.2.1.3.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.02</td>
<td id="S4.T2.2.1.3.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">6.0</td>
<td id="S4.T2.2.1.3.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">77.5</td>
<td id="S4.T2.2.1.3.7" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.05</td></tr>
<tr id="S4.T2.2.1.4" class="ltx_tr">
<td id="S4.T2.2.1.4.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">zero-shot-cot</td>
<td id="S4.T2.2.1.4.2" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">7.3</td>
