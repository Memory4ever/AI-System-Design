<th id="A2.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><math id="A2.T3.m2" class="ltx_math_unparsed" alttext="\mathbf{KL}_{p||t}\downarrow" display="inline" intent=":literal"><semantics><mrow><mi>𝐊𝐋</mi><msub><mrow></mrow><mrow><mi>p</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>t</mi></mrow></msub><mo stretchy="false">↓</mo></mrow><annotation encoding="application/x-tex">\mathbf{KL}_{p||t}\downarrow</annotation></semantics></math></th></tr>
