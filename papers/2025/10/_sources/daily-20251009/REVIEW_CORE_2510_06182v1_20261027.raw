<th id="A2.T3.2.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="A2.T3.m6" class="ltx_Math" alttext="t_{\text{entity}}{}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mtext>entity</mtext></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t_{\text{entity}}{}=1</annotation></semantics></math></th>
