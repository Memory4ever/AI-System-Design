<figure id="A1.F5.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.06162v1/x5.svg" id="A1.F5.sf1.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:548/548;" width="548" height="548"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(a) </span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A1.F5.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.06162v1/x6.svg" id="A1.F5.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:548/476;" width="548" height="476"></object>
