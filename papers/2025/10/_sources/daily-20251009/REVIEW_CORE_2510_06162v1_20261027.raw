<figure id="A1.F3.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.06162v1/breast.svg" id="A1.F3.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/411;" width="548" height="411"></object>
