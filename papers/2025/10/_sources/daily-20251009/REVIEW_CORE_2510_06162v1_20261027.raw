<br class="ltx_break">   with <math id="alg1.l6.m2" class="ltx_Math" alttext="N_{ij}\sim\mathcal{N}(0," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">N_{ij}\sim\mathcal{N}(0,</annotation></semantics></math> <span id="alg1.l6.2" class="ltx_text"><math id="alg1.l6.m3" class="ltx_Math" style="--ltx-bg-color:#FFB3FF;" alttext="\sigma" display="inline" intent=":literal"><semantics><mi style="--ltx-bg-color:#FFB3FF;" mathbackground="#FFB3FF">σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math></span><math id="alg1.l6.m4" class="ltx_Math" alttext="\sigma_{j})" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><msub><mi>σ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\sigma_{j})</annotation></semantics></math> and
<math id="alg1.l6.m5" class="ltx_Math" alttext="\sigma_{j}=\mathrm{std}(" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo>=</mo><mrow><mi>std</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma_{j}=\mathrm{std}(</annotation></semantics></math><span id="alg1.l6.3" class="ltx_text"><math id="alg1.l6.m6" class="ltx_math_unparsed" style="--ltx-bg-color:#B3FFFF;" alttext="X_{wide_{:,j}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">X</mi><msub><mrow></mrow><mrow><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">w</mi><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">i</mi><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">d</mi><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">e</mi><msub><mrow></mrow><mrow><mo style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF" rspace="0em">:</mo><mo style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">,</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">j</mi></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">X_{wide_{:,j}}</annotation></semantics></math></span><math id="alg1.l6.m7" class="ltx_Math" alttext=")" display="inline" intent=":literal"><semantics><mo stretchy="false">)</mo><annotation encoding="application/x-tex">)</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">7:</span>
                
                
              Add noise <span id="alg1.l7.2" class="ltx_text"><math id="alg1.l7.m1" class="ltx_Math" style="--ltx-bg-color:#B3FFFF;" alttext="X_{wide}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">X</mi><mrow><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">w</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">e</mi></mrow></msub><annotation encoding="application/x-tex">X_{wide}</annotation></semantics></math></span><math id="alg1.l7.m2" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math><span id="alg1.l7.3" class="ltx_text"><math id="alg1.l7.m3" class="ltx_Math" style="--ltx-bg-color:#B3FFFF;" alttext="X_{wide}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">X</mi><mrow><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">w</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">e</mi></mrow></msub><annotation encoding="application/x-tex">X_{wide}</annotation></semantics></math></span><math id="alg1.l7.m4" class="ltx_Math" alttext="+N" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">+N</annotation></semantics></math>

</div>
<div id="alg1.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">8:</span>
                
                
              <span id="alg1.l8.2" class="ltx_text ltx_font_bold">return</span> <span id="alg1.l8.3" class="ltx_text"><math id="alg1.l8.m1" class="ltx_Math" style="--ltx-bg-color:#B3FFFF;" alttext="X_{wide}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">X</mi><mrow><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">w</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#B3FFFF;" mathbackground="#B3FFFF">e</mi></mrow></msub><annotation encoding="application/x-tex">X_{wide}</annotation></semantics></math></span>

</div>
</div>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<div id="S4.F2.2" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_middle" style="width:119.2pt;"><img src="2510.06162v1/widening.png" id="S4.F2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:148/157;" width="148" height="157" alt="Refer to caption">
</div></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>Pseudocode (left) and illustration (right) for sampling from our HDLSS prior.</figcaption>
</figure>
<div id="S4.SS1.p3" class="ltx_para ltx_noindent">
<p id="S4.SS1.p3.1" class="ltx_p">Specifically, we describe our procedure in <a href="#alg1" title="In Figure 2 ‣ 4.1 A Prior for Synthetic HDLSS Data Generation ‣ 4 Methodology ‣ TabPFN-Wide: Continued Pre-Training for Extreme Feature Counts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">1</span></a>, which takes as input the features <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> of a dataset, during training sampled from the TabICL prior with a moderate feature count <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, and then artificially <span id="S4.SS1.p3.1.1" class="ltx_text ltx_font_italic">widens</span> it to <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="d\gg m" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≫</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">d\gg m</annotation></semantics></math> dimensions. For this, we first sample a masked linear layer (lines 1 and 2) with sparsity <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and, second, apply this sparse linear projection to obtain <math id="S4.SS1.p3.m5" class="ltx_Math" alttext="X_{wide}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><annotation encoding="application/x-tex">X_{wide}</annotation></semantics></math> (line 3). Afterwards, we add Gaussian distributed noise (line 4). With this procedure, we can generate thousands of new features highly correlated to the original feature set, mimicking HDLSS data.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para ltx_noindent">
<p id="S4.SS1.p4.1" class="ltx_p">Our procedure can generate new features that form correlated clusters as new features depend on only a subset of the original features. The sparsity parameter <math id="S4.SS1.p4.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> controls this structure: small values yield new features influenced by few or no originals, resulting in sparse correlation patterns, whereas large values produce new features that are mixtures of many originals, leading to dense correlation patterns. <a href="#S4.F3" title="In 4.1 A Prior for Synthetic HDLSS Data Generation ‣ 4 Methodology ‣ TabPFN-Wide: Continued Pre-Training for Extreme Feature Counts" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">3</span></a> compares real-world HDLSS biomedical data (a) with synthetic datasets (b–f), with <math id="S4.SS1.p4.m2" class="ltx_Math" alttext="p=0.02" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">p=0.02</annotation></semantics></math> showing the closest match to the real correlation structure.</p>
</div>
<figure id="S4.F3" class="ltx_figure">
<table id="S4.F3.2" class="ltx_tabular ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S4.F3.2.1" class="ltx_tr">
<td id="S4.F3.2.1.1" class="ltx_td ltx_nopad_r ltx_align_center">real-world</td>
<td id="S4.F3.2.1.2" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S4.F3.m1" class="ltx_Math" alttext="p=0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p=0</annotation></semantics></math></td>
<td id="S4.F3.2.1.3" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S4.F3.m2" class="ltx_Math" alttext="p=0.01" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">p=0.01</annotation></semantics></math></td>
<td id="S4.F3.2.1.4" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S4.F3.m3" class="ltx_Math" alttext="p=0.02" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0.02</mn></mrow><annotation encoding="application/x-tex">p=0.02</annotation></semantics></math></td>
<td id="S4.F3.2.1.5" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S4.F3.m4" class="ltx_Math" alttext="p=0.1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">p=0.1</annotation></semantics></math></td>
<td id="S4.F3.2.1.6" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S4.F3.m5" class="ltx_Math" alttext="p=1.0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">p=1.0</annotation></semantics></math></td>
<td id="S4.F3.2.1.7" class="ltx_td"></td></tr>
<tr id="S4.F3.2.2" class="ltx_tr">
<td id="S4.F3.2.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><img src="2510.06162v1/figures/prior_correlation/mrna.png" id="S4.F3.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:85/85;" width="85" height="85" alt="Refer to caption"></td>
<td id="S4.F3.2.2.2" class="ltx_td ltx_nopad_r ltx_align_center"><img src="2510.06162v1/figures/prior_correlation/sparsity0.png" id="S4.F3.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:85/85;" width="85" height="85" alt="Refer to caption"></td>
<td id="S4.F3.2.2.3" class="ltx_td ltx_nopad_r ltx_align_center"><img src="2510.06162v1/figures/prior_correlation/sparsity001.png" id="S4.F3.g3" class="ltx_graphics ltx_img_square" style="aspect-ratio:85/85;" width="85" height="85" alt="Refer to caption"></td>
<td id="S4.F3.2.2.4" class="ltx_td ltx_nopad_r ltx_align_center"><img src="2510.06162v1/figures/prior_correlation/sparsity002.png" id="S4.F3.g4" class="ltx_graphics ltx_img_square" style="aspect-ratio:85/85;" width="85" height="85" alt="Refer to caption"></td>
<td id="S4.F3.2.2.5" class="ltx_td ltx_nopad_r ltx_align_center"><img src="2510.06162v1/figures/prior_correlation/sparsity01.png" id="S4.F3.g5" class="ltx_graphics ltx_img_square" style="aspect-ratio:85/85;" width="85" height="85" alt="Refer to caption"></td>
<td id="S4.F3.2.2.6" class="ltx_td ltx_nopad_r ltx_align_center"><img src="2510.06162v1/figures/prior_correlation/sparsity1.png" id="S4.F3.g6" class="ltx_graphics ltx_img_square" style="aspect-ratio:85/85;" width="85" height="85" alt="Refer to caption"></td>
<td id="S4.F3.2.2.7" class="ltx_td ltx_nopad_r ltx_align_center"><img src="2510.06162v1/figures/prior_correlation/colorbar.png" id="S4.F3.g7" class="ltx_graphics ltx_img_portrait" style="aspect-ratio:28/85;" width="28" height="85" alt="Refer to caption"></td></tr>
<tr id="S4.F3.2.3" class="ltx_tr">
<td id="S4.F3.2.3.1" class="ltx_td ltx_nopad_r ltx_align_center">(a)</td>
<td id="S4.F3.2.3.2" class="ltx_td ltx_nopad_r ltx_align_center">(b)</td>
