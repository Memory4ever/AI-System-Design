              Sample weights <math id="alg1.l3.m1" class="ltx_Math" alttext="W\in\mathbb{R}^{m\times\hbox{\pagecolor{orange!30}d}}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mtext style="--ltx-bg-color:#FFD9B3;" mathbackground="#FFD9B3">d</mtext></mrow></msup></mrow><annotation encoding="application/x-tex">W\in\mathbb{R}^{m\times\hbox{\pagecolor{orange!30}d}}</annotation></semantics></math> with <math id="alg1.l3.m2" class="ltx_Math" alttext="W_{ij}\sim\mathcal{N}(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W_{ij}\sim\mathcal{N}(0,1)</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
