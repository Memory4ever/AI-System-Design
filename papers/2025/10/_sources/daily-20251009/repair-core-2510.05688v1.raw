<p id="A3.T10.10.1.8.1.1" class="ltx_p">niah_multikey_3</p>
</span></div></th>
<th id="A3.T10.10.1.9" class="ltx_td ltx_align_left ltx_th ltx_th_column">
<div id="A3.T10.10.1.9.1" class="ltx_inline-block ltx_transformed_outer" style="width:9.0pt;height:71.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:71.9pt;transform:translate(-31.5pt,-31.5pt) rotate(-90deg) ;">
<p id="A3.T10.10.1.9.1.1" class="ltx_p">niah_multivalue</p>
</span></div></th></tr>
<tr id="A3.T10.10.2" class="ltx_tr">
<th id="A3.T10.10.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t">
<div id="A3.T10.10.2.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:58.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:58.4pt;transform:translate(-25.7pt,-25.7pt) rotate(-90deg) ;">
<p id="A3.T10.10.2.1.1.1" class="ltx_p">Authors code</p>
</span></div></th>
<th id="A3.T10.10.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t">
<table id="A3.T10.10.2.2.1" class="ltx_tabular ltx_align_middle">
<tr id="A3.T10.10.2.2.1.1" class="ltx_tr">
<td id="A3.T10.10.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">A = B</td></tr>
<tr id="A3.T10.10.2.2.1.2" class="ltx_tr">
<td id="A3.T10.10.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">+ questions processed via</td></tr>
<tr id="A3.T10.10.2.2.1.3" class="ltx_tr">
<td id="A3.T10.10.2.2.1.3.1" class="ltx_td ltx_nopad_r ltx_align_left">dense attention</td></tr>
</table></th>
<th id="A3.T10.10.2.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t">
<table id="A3.T10.10.2.3.1" class="ltx_tabular ltx_align_middle">
<tr id="A3.T10.10.2.3.1.1" class="ltx_tr">
<td id="A3.T10.10.2.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">A =B (core paper description)</td></tr>
<tr id="A3.T10.10.2.3.1.2" class="ltx_tr">
<td id="A3.T10.10.2.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">+ dense layers(0,16)</td></tr>
