<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Additional Experiments Results and Details</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Pareto plots for Llama-3.1-8B-Instruct</h3>

<figure id="A1.F6" class="ltx_figure"><img src="2510.05688v1/images/combined_attention_results.png" id="A1.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:494/344;" width="494" height="344" alt="Refer to caption">
