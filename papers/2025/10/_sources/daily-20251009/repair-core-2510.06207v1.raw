<td id="S4.T5.2.1.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T5.2.1.3.4.1" class="ltx_text" style="font-size:50%;">95</span></td>
