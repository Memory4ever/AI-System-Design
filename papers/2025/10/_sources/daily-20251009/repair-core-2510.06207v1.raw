<td id="S4.T2.8.1.8.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:1.45pt 1.0pt;"><span id="S4.T2.8.1.8.2.1" class="ltx_text" style="font-size:144%;">55/50</span></td>
<td id="S4.T2.8.1.8.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:1.45pt 1.0pt;"><span id="S4.T2.8.1.8.3.1" class="ltx_text" style="font-size:144%;">80/70</span></td>
<td id="S4.T2.8.1.8.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:1.45pt 1.0pt;"><span id="S4.T2.8.1.8.4.1" class="ltx_text" style="font-size:144%;">90/90</span></td>
<td id="S4.T2.8.1.8.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:1.45pt 1.0pt;"><span id="S4.T2.8.1.8.5.1" class="ltx_text" style="font-size:144%;">40/30</span></td></tr>
<tr id="S4.T2.8.1.9" class="ltx_tr">
<td id="S4.T2.8.1.9.1" class="ltx_td ltx_nopad_l ltx_align_center ltx_border_t" style="padding:1.45pt 1.0pt;" colspan="5"><span id="S4.T2.8.1.9.1.1" class="ltx_text" style="font-size:144%;"></span><span id="S4.T2.8.1.9.1.2" class="ltx_text ltx_font_bold" style="font-size:144%;">Place the apples in the drawer and make sure to avoid obstacles.</span></td></tr>
<tr id="S4.T2.8.1.10" class="ltx_tr">
