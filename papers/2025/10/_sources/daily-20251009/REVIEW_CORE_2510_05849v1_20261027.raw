<td id="S5.T1.2.4.1" class="ltx_td ltx_align_left">Band gap</td>
<td id="S5.T1.2.4.2" class="ltx_td ltx_align_left">10 eV</td>
<td id="S5.T1.2.4.3" class="ltx_td ltx_align_center">12</td>
<td id="S5.T1.2.4.4" class="ltx_td ltx_align_left"><math id="S5.T1.m8" class="ltx_math_unparsed" alttext="\exp(-(P_{c}-y)^{2}/2\sigma_{y}^{2})" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>c</mi></msub><mo>−</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><msubsup><mi>σ</mi><mi>y</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\exp(-(P_{c}-y)^{2}/2\sigma_{y}^{2})</annotation></semantics></math></td>
