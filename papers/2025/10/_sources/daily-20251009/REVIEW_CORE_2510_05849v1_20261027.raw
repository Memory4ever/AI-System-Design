<th id="S5.T1.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">Target <math id="S5.T1.m2" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></th>
<th id="S5.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Atoms <math id="S5.T1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></th>
<th id="S5.T1.2.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">Potential function <math id="S5.T1.m4" class="ltx_Math" alttext="g(c)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(c)</annotation></semantics></math></th>
<th id="S5.T1.2.1.5" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt">Scale <math id="S5.T1.m5" class="ltx_Math" alttext="\sigma_{y}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>y</mi></msub><annotation encoding="application/x-tex">\sigma_{y}</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.2.2" class="ltx_tr">
<td id="S5.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t">Bulk modulus</td>
<td id="S5.T1.2.2.2" class="ltx_td ltx_align_left ltx_border_t">300 GPa</td>
<td id="S5.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t">4</td>
<td id="S5.T1.2.2.4" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T1.m6" class="ltx_math_unparsed" alttext="\exp(-(P_{c}-y)^{2}/2\sigma_{y}^{2})" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>c</mi></msub><mo>−</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>/</mo><mn>2</mn><msubsup><mi>σ</mi><mi>y</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\exp(-(P_{c}-y)^{2}/2\sigma_{y}^{2})</annotation></semantics></math></td>
<td id="S5.T1.2.2.5" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">10 GPa</td></tr>
<tr id="S5.T1.2.3" class="ltx_tr">
<td id="S5.T1.2.3.1" class="ltx_td ltx_align_left">Shear modulus</td>
