<p id="A3.I1.i2.I1.i4.p1.1" class="ltx_p"><span id="A3.I1.i2.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">PIQA</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib9" title="" class="ltx_ref">Bisk et al., 2020</a>)</cite></p>
</div></li>
<li id="A3.I1.i2.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A3.I1.i2.I1.i5.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A3.I1.i2.I1.i5.p1" class="ltx_para ltx_noindent">
<p id="A3.I1.i2.I1.i5.p1.1" class="ltx_p"><span id="A3.I1.i2.I1.i5.p1.1.1" class="ltx_text ltx_font_bold">HellaSwag (HSwag)</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib69" title="" class="ltx_ref">Zellers et al., 2019</a>)</cite></p>
</div></li>
<li id="A3.I1.i2.I1.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A3.I1.i2.I1.i6.1" class="ltx_text ltx_font_bold">–</span></span> 
