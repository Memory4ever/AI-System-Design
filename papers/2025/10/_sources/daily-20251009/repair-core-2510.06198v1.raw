<tr id="A1.T4.2.3" class="ltx_tr">
<th id="A1.T4.2.3.1" class="ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;" colspan="4"><span id="A1.T4.2.3.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Phi – TACRED</span></th></tr>
