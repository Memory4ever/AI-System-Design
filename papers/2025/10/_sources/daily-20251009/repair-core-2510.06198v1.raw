<div id="A1.SS10.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SS10.p1.pic1" class="ltx_picture" height="606" overflow="visible" version="1.1" viewBox="0 0 550 606" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,606) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#2934BE;" fill="#2934BE" fill-opacity="1.0"><path style="stroke:none" d="M 0 7.61 L 0 598.39 C 0 602.59 3.41 606 7.61 606 L 542.39 606 C 546.59 606 550 602.59 550 598.39 L 550 7.61 C 550 3.41 546.59 0 542.39 0 L 7.61 0 C 3.41 0 0 3.41 0 7.61 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 7.61 L 0.69 584.56 L 549.31 584.56 L 549.31 7.61 C 549.31 3.79 546.21 0.69 542.39 0.69 L 7.61 0.69 C 3.79 0.69 0.69 3.79 0.69 7.61 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 591.88)"><foreignObject style="--ltx-fo-width:32em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.18" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="442.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
