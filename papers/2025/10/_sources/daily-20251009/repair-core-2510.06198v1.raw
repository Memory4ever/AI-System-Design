riter"> </span><span id="lstnumberx37.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">on</span><span id="lstnumberx37.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx37.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx37.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx37.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">US</span><span id="lstnumberx37.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx37.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">economic</span><span id="lstnumberx37.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx37.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">recovery</span><span id="lstnumberx37.32" class="ltx_text ltx_font_typewriter">.’’</span>
</div>
