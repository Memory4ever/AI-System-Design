<span id="A1.SS4.tab4.1.1.1.1.1.1.27.1.1" class="ltx_inline-block ltx_align_top" style="width:398.3pt;">
<span id="A1.SS4.tab4.1.1.1.1.1.1.27.1.1.1" class="ltx_p">Both summaries describe a relationship where one <span id="A1.SS4.tab4.1.1.1.1.1.1.27.1.1.1.1" class="ltx_text" style="--ltx-bg-color:#FFCCCC;">entity</span> (Karr Ingham/Ahmed Rashid) is responsible for <span id="A1.SS4.tab4.1.1.1.1.1.1.27.1.1.1.2" class="ltx_text" style="--ltx-bg-color:#FFCCCC;">producing or creating</span> another <span id="A1.SS4.tab4.1.1.1.1.1.1.27.1.1.1.3" class="ltx_text" style="--ltx-bg-color:#FFCCCC;">entity</span> (Texas Petro Index/”Failure of Nation Building”).</span>
</span></span></span>
<span id="A1.SS4.tab4.1.1.1.1.1.1.28" class="ltx_tr">
<span id="A1.SS4.tab4.1.1.1.1.1.1.28.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.SS4.tab4.1.1.1.1.1.1.28.1.1" class="ltx_inline-block ltx_align_top" style="width:398.3pt;">
<span id="A1.SS4.tab4.1.1.1.1.1.1.28.1.1.1" class="ltx_p">Conclusion: Yes.</span>
</span></span></span>
