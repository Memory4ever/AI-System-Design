<th id="A1.T4.2.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row" style="padding-left:1.0pt;padding-right:1.0pt;">no_yes</th>
<td id="A1.T4.2.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;">24</td>
<td id="A1.T4.2.4.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;">26</td>
<td id="A1.T4.2.4.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;">29</td></tr>
<tr id="A1.T4.2.5" class="ltx_tr">
<th id="A1.T4.2.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row" style="padding-left:1.0pt;padding-right:1.0pt;">yes_no</th>
