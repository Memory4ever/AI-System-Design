<figure id="S5.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.06198v1/Phi_KL.svg" id="S5.F2.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:181/102;" width="181" height="102"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>Phi-KL</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S5.F2.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.06198v1/Phi_L.svg" id="S5.F2.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:181/102;" width="181" height="102"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(c) </span>Phi-Response Length</figcaption>
