<p id="A1.SS4.tab6.1" class="ltx_p ltx_align_center"><span id="A1.SS4.tab6.1.1" class="ltx_text ltx_inline-block" style="width:397.5pt;">
<span id="A1.SS4.tab6.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:417.0pt;height:601.8pt;vertical-align:-298.4pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<span id="A1.SS4.tab6.1.1.1.1" class="ltx_p"><span id="A1.SS4.tab6.1.1.1.1.1" class="ltx_text">
<span id="A1.SS4.tab6.1.1.1.1.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
