</div>
<div id="lstnumberx14" class="ltx_listingline"><span id="lstnumberx14.1" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx14.2" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx14.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Points</span><span id="lstnumberx14.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx14.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">deducted</span><span id="lstnumberx14.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">when</span><span id="lstnumberx14.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx14.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">model</span><span id="lstnumberx14.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">confuses</span><span id="lstnumberx14.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">similar</span><span id="lstnumberx14.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">relations</span><span id="lstnumberx14.21" class="ltx_text ltx_font_typewriter">,</span>
</div>
<div id="lstnumberx15" class="ltx_listingline"><span id="lstnumberx15.1" class="ltx_text ltx_lst_space ltx_font_typewriter">      </span><span id="lstnumberx15.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">e</span><span id="lstnumberx15.3" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx15.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">g</span><span id="lstnumberx15.5" class="ltx_text ltx_font_typewriter">.,</span><span id="lstnumberx15.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.7" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx15.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">city</span><span id="lstnumberx15.9" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx15.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">vs</span><span id="lstnumberx15.12" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx15.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.14" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx15.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">country</span><span id="lstnumberx15.16" class="ltx_text ltx_font_typewriter">",</span><span id="lstnumberx15.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx15.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.20" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx15.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">reference</span><span id="lstnumberx15.22" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx15.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">vs</span><span id="lstnumberx15.25" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx15.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.27" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx15.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">alternate_name</span><span id="lstnumberx15.29" class="ltx_text ltx_font_typewriter">".</span>
