<tr id="A1.T5.2.10" class="ltx_tr">
<th id="A1.T5.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:1pt 3.0pt;"><math id="A1.T5.m2" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>-sampling</th>
<td id="A1.T5.2.10.2" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">49.2</td>
