<th id="A1.T5.2.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding:1pt 3.0pt;">Calibrated-<math id="A1.T5.m3" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math></th>
<td id="A1.T5.2.12.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 3.0pt;">48.6</td>
