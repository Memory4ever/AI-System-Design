<td id="A2.T6.4.1.3.3" class="ltx_td ltx_align_left">Linear, GELU, Linear</td>
<td id="A2.T6.4.1.3.4" class="ltx_td ltx_align_left">Expert logits (per patch)</td></tr>
<tr id="A2.T6.4.1.4" class="ltx_tr">
<td id="A2.T6.4.1.4.1" class="ltx_td ltx_align_left ltx_border_bb">FTR/LTR</td>
