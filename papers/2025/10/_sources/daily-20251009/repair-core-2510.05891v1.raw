<td id="S4.T1.6.1.3.1" class="ltx_td ltx_align_left ltx_border_ttt" style="padding:1pt 3.0pt;">CNNSpot<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib55" title="" class="ltx_ref">55</a>]</cite></td>
