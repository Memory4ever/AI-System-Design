<tr id="S4.T1.6.1.4" class="ltx_tr">
<td id="S4.T1.6.1.4.1" class="ltx_td ltx_align_left" style="padding:1pt 3.0pt;">FreDect <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite></td>
<td id="S4.T1.6.1.4.2" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">99.80</td>
