<td id="S5.T2.2.1.7.4" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:-1.5pt;padding-bottom:-1.5pt;">0.422(<span id="S5.T2.2.1.7.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#228B22;">+0.028</span>)</td>
