<span id="S1.T1.2.1.1.1.9.4" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S1.T1.2.1.1.1.9.4.1" class="ltx_text" style="--ltx-fg-color:#008080;">✓</span></span>
<span id="S1.T1.2.1.1.1.9.5" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S1.T1.2.1.1.1.9.5.1" class="ltx_text" style="--ltx-fg-color:#BF0040;">✗</span></span>
