<tr id="S5.T1.4.5" class="ltx_tr">
<th id="S5.T1.4.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Spotlighting</th>
<td id="S5.T1.4.5.2" class="ltx_td ltx_align_left"><span id="S5.T1.4.5.2.1" class="ltx_text ltx_align_right ltx_inline-block" style="width:28.0pt;--ltx-bg-color:#CCFF99;"><math id="S5.T1.m19" class="ltx_Math" alttext="71.66" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#CCFF99;" mathbackground="#CCFF99">71.66</mn><annotation encoding="application/x-tex">71.66</annotation></semantics></math></span><math id="S5.T1.m20" class="ltx_Math" alttext="\pm 3.5" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#BFBFBF;" mathcolor="#BFBFBF">±</mo><mn style="--ltx-fg-color:#BFBFBF;" mathcolor="#BFBFBF">3.5</mn></mrow><annotation encoding="application/x-tex">\pm 3.5</annotation></semantics></math></td>
<td id="S5.T1.4.5.3" class="ltx_td ltx_align_left"><span id="S5.T1.4.5.3.1" class="ltx_text ltx_align_right ltx_inline-block" style="width:28.0pt;--ltx-bg-color:#CCFF99;"><math id="S5.T1.m21" class="ltx_Math" alttext="55.64" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#CCFF99;" mathbackground="#CCFF99">55.64</mn><annotation encoding="application/x-tex">55.64</annotation></semantics></math></span><math id="S5.T1.m22" class="ltx_Math" alttext="\pm 3.9" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#BFBFBF;" mathcolor="#BFBFBF">±</mo><mn style="--ltx-fg-color:#BFBFBF;" mathcolor="#BFBFBF">3.9</mn></mrow><annotation encoding="application/x-tex">\pm 3.9</annotation></semantics></math></td>
<td id="S5.T1.4.5.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S5.T1.4.5.4.1" class="ltx_text ltx_align_right ltx_inline-block" style="width:28.0pt;--ltx-bg-color:#FF9999;"><math id="S5.T1.m23" class="ltx_Math" alttext="41.65" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#FF9999;" mathbackground="#FF9999">41.65</mn><annotation encoding="application/x-tex">41.65</annotation></semantics></math></span><math id="S5.T1.m24" class="ltx_Math" alttext="\pm 3.9" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#BFBFBF;" mathcolor="#BFBFBF">±</mo><mn style="--ltx-fg-color:#BFBFBF;" mathcolor="#BFBFBF">3.9</mn></mrow><annotation encoding="application/x-tex">\pm 3.9</annotation></semantics></math></td></tr>
<tr id="S5.T1.4.6" class="ltx_tr">
<th id="S5.T1.4.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Toolfilter</th>
