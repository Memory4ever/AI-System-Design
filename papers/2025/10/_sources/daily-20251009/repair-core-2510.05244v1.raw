></foreignObject></g></g></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.52 12.64)"><foreignObject style="--ltx-fo-width:36.78em;--ltx-fo-height:4.29em;--ltx-fo-depth:0em;font-size:10pt;" height="59.42" overflow="visible" transform="matrix(1 0 0 -1 0 59.42)" width="508.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
