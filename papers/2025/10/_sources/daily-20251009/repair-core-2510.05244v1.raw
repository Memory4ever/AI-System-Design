<tr id="S5.T1.4.4" class="ltx_tr">
<th id="S5.T1.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Repeat prompt</th>
<td id="S5.T1.4.4.2" class="ltx_td ltx_align_left"><span id="S5.T1.4.4.2.1" class="ltx_text ltx_font_bold ltx_align_right ltx_inline-block" style="width:32.2pt;--ltx-bg-color:#99FF99;"><math id="S5.T1.m13" class="ltx_Math" alttext="85.53" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#99FF99;" mathbackground="#99FF99">85.53</mn><annotation encoding="application/x-tex">85.53</annotation></semantics></math></span><math id="S5.T1.m14" class="ltx_Math" alttext="\pm 2.8" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#BFBFBF;" mathcolor="#BFBFBF">±</mo><mn style="--ltx-fg-color:#BFBFBF;" mathcolor="#BFBFBF">2.8</mn></mrow><annotation encoding="application/x-tex">\pm 2.8</annotation></semantics></math></td>
