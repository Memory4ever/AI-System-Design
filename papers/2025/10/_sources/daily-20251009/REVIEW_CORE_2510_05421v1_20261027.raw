<span id="S4.T2.2.1.1.1.2.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.25pt 4.0pt;">Speedup</span></span>
</span>
<span class="ltx_tbody">
