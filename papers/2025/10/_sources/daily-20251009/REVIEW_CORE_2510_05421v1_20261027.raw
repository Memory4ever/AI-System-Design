<th id="S4.T1.2.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column">budget</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.2.3" class="ltx_tr">
<th id="S4.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">DVI (our work)</th>
