<th id="S5.T1.2.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S5.T1.2.5.1.1" class="ltx_text ltx_font_bold">Cliff-as-a-judge</span></th>
<td id="S5.T1.2.5.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:1.0pt;padding-right:1.0pt;">True</td>
