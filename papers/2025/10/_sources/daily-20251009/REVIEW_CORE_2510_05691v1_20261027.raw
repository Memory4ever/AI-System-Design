<td id="S2.T1.2.1.16.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S2.T1.2.1.16.4.1" class="ltx_text ltx_font_bold">50.0</span></td>
<td id="S2.T1.2.1.16.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S2.T1.2.1.16.5.1" class="ltx_text ltx_font_bold">55.9</span></td>
<td id="S2.T1.2.1.16.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S2.T1.2.1.16.6.1" class="ltx_text ltx_font_bold">37.6</span></td>
