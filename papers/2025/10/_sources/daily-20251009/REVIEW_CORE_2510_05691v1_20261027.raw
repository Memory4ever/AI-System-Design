<td id="S2.T1.2.1.15.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S2.T1.2.1.15.5.1" class="ltx_text ltx_underline">44.9</span></td>
<td id="S2.T1.2.1.15.6" class="ltx_td ltx_align_center">-</td>
