<th id="S3.T2.2.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="4"><em id="S3.T2.2.1.5.1.1" class="ltx_emph ltx_font_italic">Data Quality <math id="S3.T2.m5" class="ltx_Math" alttext="(k=3,n=4,T_{\max}=4)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>=</mo><mn>3</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>=</mo><mn>4</mn></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>max</mi></msub><mo>=</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k=3,n=4,T_{\max}=4)</annotation></semantics></math></em></th></tr>
