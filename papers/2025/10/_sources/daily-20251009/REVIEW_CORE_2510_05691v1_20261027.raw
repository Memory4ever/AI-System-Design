<td id="S2.T1.2.1.16.8" class="ltx_td ltx_align_center ltx_border_bb"><span id="S2.T1.2.1.16.8.1" class="ltx_text ltx_font_bold">51.3</span></td>
<td id="S2.T1.2.1.16.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S2.T1.2.1.16.9.1" class="ltx_text ltx_font_bold">53.2</span></td>
<td id="S2.T1.2.1.16.10" class="ltx_td ltx_align_center ltx_border_bb"><span id="S2.T1.2.1.16.10.1" class="ltx_text ltx_font_bold">36.0</span></td>
<td id="S2.T1.2.1.16.11" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S2.T1.2.1.16.11.1" class="ltx_text ltx_font_bold">47.2</span></td>
