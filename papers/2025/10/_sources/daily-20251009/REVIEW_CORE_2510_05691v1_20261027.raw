<td id="S3.T2.2.1.4.2" class="ltx_td ltx_align_center">134.9</td>
<td id="S3.T2.2.1.4.3" class="ltx_td ltx_align_center">743.2</td>
<td id="S3.T2.2.1.4.4" class="ltx_td ltx_align_center">-</td></tr>
