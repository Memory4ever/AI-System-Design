<td id="S3.T2.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T2.2.1.1.2.1" class="ltx_text ltx_font_bold">Pruning Search</span></td>
<td id="S3.T2.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T2.2.1.1.3.1" class="ltx_text ltx_font_bold">No Pruning Search</span></td>
<td id="S3.T2.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T2.2.1.1.4.1" class="ltx_text ltx_font_bold">Full Node Search</span></td></tr>
