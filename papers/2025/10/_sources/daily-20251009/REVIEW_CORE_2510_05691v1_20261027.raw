<tr id="S3.T2.2.1.3" class="ltx_tr">
<th id="S3.T2.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Theoretical Expansion Counts</th>
<td id="S3.T2.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m2" class="ltx_Math" alttext="(4k+3knl)l" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">(4k+3knl)l</annotation></semantics></math></td>
<td id="S3.T2.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m3" class="ltx_Math" alttext="\sum_{i=1}^{l}{i^{2}(4k+3knl)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></msubsup><mrow><msup><mi>i</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{l}{i^{2}(4k+3knl)}</annotation></semantics></math></td>
<td id="S3.T2.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m4" class="ltx_Math" alttext="(2k(k+1))^{l}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>l</mi></msup><annotation encoding="application/x-tex">(2k(k+1))^{l}</annotation></semantics></math></td></tr>
