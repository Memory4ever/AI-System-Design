<figure id="S3.F4" class="ltx_figure"><img src="2510.05381v1/images/Space_DPQ_PDQ_llama_mistral.png" id="S3.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:333/176;" width="333" height="176" alt="Refer to caption">
