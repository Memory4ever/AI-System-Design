<td id="S5.T5.2.2.4" class="ltx_td ltx_align_center ltx_border_t">87.8</td>
<td id="S5.T5.2.2.5" class="ltx_td ltx_align_center ltx_border_t">87.8</td>
<td id="S5.T5.2.2.6" class="ltx_td ltx_align_center ltx_border_t">88.8</td>
<td id="S5.T5.2.2.7" class="ltx_td ltx_align_center ltx_border_t">87.2</td>
<td id="S5.T5.2.2.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">90.4</td></tr>
<tr id="S5.T5.2.3" class="ltx_tr">
<td id="S5.T5.2.3.1" class="ltx_td ltx_align_left">QA2</td>
<td id="S5.T5.2.3.2" class="ltx_td ltx_align_center">63.2</td>
<td id="S5.T5.2.3.3" class="ltx_td ltx_align_center">67.0</td>
<td id="S5.T5.2.3.4" class="ltx_td ltx_align_center">68.4</td>
<td id="S5.T5.2.3.5" class="ltx_td ltx_align_center">69.4</td>
<td id="S5.T5.2.3.6" class="ltx_td ltx_align_center">71.4</td>
<td id="S5.T5.2.3.7" class="ltx_td ltx_nopad_r ltx_align_center">71.2</td></tr>
<tr id="S5.T5.2.4" class="ltx_tr">
<td id="S5.T5.2.4.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" rowspan="2"><span id="S5.T5.2.4.1.1" class="ltx_text">Ours</span></td>
<td id="S5.T5.2.4.2" class="ltx_td ltx_align_left ltx_border_t">QA1</td>
<td id="S5.T5.2.4.3" class="ltx_td ltx_align_center ltx_border_t">88.2</td>
<td id="S5.T5.2.4.4" class="ltx_td ltx_align_center ltx_border_t">88.4</td>
<td id="S5.T5.2.4.5" class="ltx_td ltx_align_center ltx_border_t">88.6</td>
<td id="S5.T5.2.4.6" class="ltx_td ltx_align_center ltx_border_t">89.8</td>
<td id="S5.T5.2.4.7" class="ltx_td ltx_align_center ltx_border_t">89.8</td>
<td id="S5.T5.2.4.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">92.2</td></tr>
<tr id="S5.T5.2.5" class="ltx_tr">
<td id="S5.T5.2.5.1" class="ltx_td ltx_align_left ltx_border_bb">QA2</td>
<td id="S5.T5.2.5.2" class="ltx_td ltx_align_center ltx_border_bb">65.4</td>
<td id="S5.T5.2.5.3" class="ltx_td ltx_align_center ltx_border_bb">70.6</td>
<td id="S5.T5.2.5.4" class="ltx_td ltx_align_center ltx_border_bb">72.4</td>
