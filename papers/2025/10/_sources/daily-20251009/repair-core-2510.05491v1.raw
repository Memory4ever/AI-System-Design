<span id="S4.T2.5.1.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Memory cost of</span></span>
<span id="S4.T2.5.1.2.2.1.2" class="ltx_tr">
<span id="S4.T2.5.1.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">optimizer states (GB)</span></span>
</span></span><span id="S4.T2.5.1.2.3" class="ltx_text"></span></td>
<td id="S4.T2.5.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T2.5.1.3.1" class="ltx_text"></span> <span id="S4.T2.5.1.3.2" class="ltx_text">
<span id="S4.T2.5.1.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T2.5.1.3.2.1.1" class="ltx_tr">
<span id="S4.T2.5.1.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Optimizer step</span></span>
