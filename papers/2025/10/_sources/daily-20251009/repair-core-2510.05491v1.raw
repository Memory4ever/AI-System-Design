<span id="S4.T2.5.1.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">time (s)</span></span>
</span></span><span id="S4.T2.5.1.3.3" class="ltx_text"></span></td>
<td id="S4.T2.5.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T2.5.1.4.1" class="ltx_text"></span> <span id="S4.T2.5.1.4.2" class="ltx_text">
<span id="S4.T2.5.1.4.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T2.5.1.4.2.1.1" class="ltx_tr">
<span id="S4.T2.5.1.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Training step</span></span>
<span id="S4.T2.5.1.4.2.1.2" class="ltx_tr">
<span id="S4.T2.5.1.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">time (s)</span></span>
</span></span><span id="S4.T2.5.1.4.3" class="ltx_text"></span></td></tr>
<tr id="S4.T2.5.2" class="ltx_tr">
<td id="S4.T2.5.2.1" class="ltx_td ltx_align_left ltx_border_t">AdamW</td>
<td id="S4.T2.5.2.2" class="ltx_td ltx_align_center ltx_border_t">40.56</td>
<td id="S4.T2.5.2.3" class="ltx_td ltx_align_center ltx_border_t">0.02</td>
<td id="S4.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t">28.73</td></tr>
<tr id="S4.T2.5.3" class="ltx_tr">
<td id="S4.T2.5.3.1" class="ltx_td ltx_align_left">Muon</td>
<td id="S4.T2.5.3.2" class="ltx_td ltx_align_center">21.14</td>
<td id="S4.T2.5.3.3" class="ltx_td ltx_align_center">0.83</td>
<td id="S4.T2.5.3.4" class="ltx_td ltx_align_center">29.56 (2.8%<math id="S4.T2.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</td></tr>
<tr id="S4.T2.5.4" class="ltx_tr">
<td id="S4.T2.5.4.1" class="ltx_td ltx_align_left">Muon + Adam</td>
<td id="S4.T2.5.4.2" class="ltx_td ltx_align_center">40.56</td>
<td id="S4.T2.5.4.3" class="ltx_td ltx_align_center">0.85</td>
<td id="S4.T2.5.4.4" class="ltx_td ltx_align_center">29.58 (3.0%<math id="S4.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</td></tr>
<tr id="S4.T2.5.5" class="ltx_tr">
<td id="S4.T2.5.5.1" class="ltx_td ltx_align_left ltx_border_t">NorMuon</td>
<td id="S4.T2.5.5.2" class="ltx_td ltx_align_center ltx_border_t">21.19</td>
<td id="S4.T2.5.5.3" class="ltx_td ltx_align_center ltx_border_t">0.84</td>
<td id="S4.T2.5.5.4" class="ltx_td ltx_align_center ltx_border_t">29.57 (2.9%<math id="S4.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</td></tr>
<tr id="S4.T2.5.6" class="ltx_tr">
<td id="S4.T2.5.6.1" class="ltx_td ltx_align_left ltx_border_bb">w/o orthogonalization distribution</td>
<td id="S4.T2.5.6.2" class="ltx_td ltx_align_center ltx_border_bb">-</td>
<td id="S4.T2.5.6.3" class="ltx_td ltx_align_center ltx_border_bb">2.29</td>
<td id="S4.T2.5.6.4" class="ltx_td ltx_align_center ltx_border_bb">31.04 (8.1%<math id="S4.T2.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</td></tr>
</table>
</figure>
