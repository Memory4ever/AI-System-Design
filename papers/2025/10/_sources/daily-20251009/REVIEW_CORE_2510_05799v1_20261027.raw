<th id="S4.T2.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="S4.T2.2.1.2.1.1" class="ltx_text ltx_font_bold">NMOS ↑</span></th>
<td id="S4.T2.2.1.2.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">4.15</td>
