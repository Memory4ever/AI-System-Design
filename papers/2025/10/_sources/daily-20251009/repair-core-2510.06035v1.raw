<td id="S2.T2.1.8.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S2.T2.1.8.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#008000;">different blocks</span></td>
<td id="S2.T2.1.8.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S2.T2.1.8.4.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#009900;">✓</span></td>
<td id="S2.T2.1.8.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S2.T2.1.8.5.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#009900;">✓</span></td>
