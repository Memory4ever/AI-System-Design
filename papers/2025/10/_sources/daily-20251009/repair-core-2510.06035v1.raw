<td id="S2.T2.1.7.7" class="ltx_td ltx_align_left" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S2.T2.m4" class="ltx_Math" alttext="80.9" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">80.9</mn><annotation encoding="application/x-tex">80.9</annotation></semantics></math><sup id="S2.T2.1.7.7.1" class="ltx_sup"><span id="S2.T2.1.7.7.1.1" class="ltx_text" style="font-size:90%;">†</span></sup></td></tr>
