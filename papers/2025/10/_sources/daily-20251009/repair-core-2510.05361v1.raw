<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex98.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex98.m2" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\omega_{j}(1-\beta_{j})(1-p_{j})\sum_{\tau=0}^{T-1}\sum_{t=\tau+1}^{T}\frac{q_{x}^{t-\tau}-q_{j}^{t-\tau}}{q_{x}-q_{j}}\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>x</mi><mo>′</mo></msubsup></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup><mo>−</mo><msubsup><mi>q</mi><mi>j</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup></mrow><mrow><msub><mi>q</mi><mi>x</mi></msub><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>τ</mi></msub><mo>−</mo><msubsup><mi>g</mi><mi>τ</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\omega_{j}(1-\beta_{j})(1-p_{j})\sum_{\tau=0}^{T-1}\sum_{t=\tau+1}^{T}\frac{q_{x}^{t-\tau}-q_{j}^{t-\tau}}{q_{x}-q_{j}}\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex99.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex99.m2" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\frac{\omega_{j}(1-\beta_{j})(1-p_{j})}{q_{x}-q_{j}}\sum_{\tau=0}^{T-1}\left(\frac{q_{x}(1-q_{x}^{T-\tau})}{1-q_{x}}-\frac{q_{j}(1-q_{j}^{T-\tau})}{1-q_{j}}\right)\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>x</mi><mo>′</mo></msubsup></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>x</mi></msub><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>q</mi><mi>x</mi><mrow><mi>T</mi><mo>−</mo><mi>τ</mi></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>x</mi></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>q</mi><mi>j</mi><mrow><mi>T</mi><mo>−</mo><mi>τ</mi></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>τ</mi></msub><mo>−</mo><msubsup><mi>g</mi><mi>τ</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\frac{\omega_{j}(1-\beta_{j})(1-p_{j})}{q_{x}-q_{j}}\sum_{\tau=0}^{T-1}\left(\frac{q_{x}(1-q_{x}^{T-\tau})}{1-q_{x}}-\frac{q_{j}(1-q_{j}^{T-\tau})}{1-q_{j}}\right)\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex100.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex100.m2" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\frac{\omega_{j}(1-\beta_{j})(1-p_{j})}{q_{x}-q_{j}}\sum_{\tau=0}^{T-1}\left(\frac{q_{x}}{1-q_{x}}-\frac{q_{j}}{1-q_{j}}\right)\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>x</mi><mo>′</mo></msubsup></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>x</mi></msub><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mi>x</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>x</mi></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mi>j</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>τ</mi></msub><mo>−</mo><msubsup><mi>g</mi><mi>τ</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\frac{\omega_{j}(1-\beta_{j})(1-p_{j})}{q_{x}-q_{j}}\sum_{\tau=0}^{T-1}\left(\frac{q_{x}}{1-q_{x}}-\frac{q_{j}}{1-q_{j}}\right)\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex101.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex101.m2" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\frac{\omega_{j}(1-\beta_{j})(1-p_{j})}{(1-q_{x})(1-q_{j})}\sum_{\tau=0}^{T-1}\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>x</mi><mo>′</mo></msubsup></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>τ</mi></msub><mo>−</mo><msubsup><mi>g</mi><mi>τ</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\frac{\omega_{j}(1-\beta_{j})(1-p_{j})}{(1-q_{x})(1-q_{j})}\sum_{\tau=0}^{T-1}\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS1.p9" class="ltx_para ltx_noindent">
<p id="A4.SS1.p9.1" class="ltx_p"><span id="A4.SS1.p9.1.1" class="ltx_text">Now, let us optimize the factor</span></p>
<table id="A4.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex102.m1" class="ltx_Math" alttext="\frac{q^{\prime}_{x}}{1-q_{x}}=\frac{(1-p_{x})(1+\nicefrac{{1}}{{s}})}{1-(1-p_{x})(1+s)}" display="block" intent=":literal"><semantics><mrow><mfrac><msubsup><mi>q</mi><mi>x</mi><mo>′</mo></msubsup><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>x</mi></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mpadded voffset="0.3em"><mn mathsize="0.700em">1</mn></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mi mathsize="0.700em">s</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\frac{q^{\prime}_{x}}{1-q_{x}}=\frac{(1-p_{x})(1+\nicefrac{{1}}{{s}})}{1-(1-p_{x})(1+s)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p9.2" class="ltx_p"><span id="A4.SS1.p9.2.1" class="ltx_text">by choosing optimal value for <math id="A4.SS1.p9.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> introduced earlier. By the first order optimality condition, we find that the optimal value is <math id="A4.SS1.p9.m2" class="ltx_Math" alttext="s^{*}=\frac{1}{\sqrt{1-p_{x}}}-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>∗</mo></msup><mo>=</mo><mrow><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow></msqrt></mfrac><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">s^{*}=\frac{1}{\sqrt{1-p_{x}}}-1</annotation></semantics></math>. Hence, the minimal value of the factor is</span></p>
<table id="A4.EGx25" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex103.m1" class="ltx_Math" alttext="\displaystyle\frac{q^{\prime}_{x}}{1-q_{x}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msubsup><mi>q</mi><mi>x</mi><mo>′</mo></msubsup><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>x</mi></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{q^{\prime}_{x}}{1-q_{x}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex103.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex103.m3" class="ltx_Math" alttext="\displaystyle\frac{1-p_{x}}{(1-\sqrt{1-p_{x}})^{2}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{1-p_{x}}{(1-\sqrt{1-p_{x}})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex104.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex104.m2" class="ltx_Math" alttext="\displaystyle\frac{(1-p_{x})(1-\sqrt{1-p_{x}})^{2}}{(1-\sqrt{1-p_{x}})^{2}(1+\sqrt{1-p_{x}})^{2}}=\frac{(1-p_{x})(1+\sqrt{1-p_{x}})^{2}}{p_{x}^{2}}\leq\frac{4(1-p_{x})}{p_{x}^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>p</mi><mi>x</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>p</mi><mi>x</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{(1-p_{x})(1-\sqrt{1-p_{x}})^{2}}{(1-\sqrt{1-p_{x}})^{2}(1+\sqrt{1-p_{x}})^{2}}=\frac{(1-p_{x})(1+\sqrt{1-p_{x}})^{2}}{p_{x}^{2}}\leq\frac{4(1-p_{x})}{p_{x}^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS1.p10" class="ltx_para ltx_noindent">
<p id="A4.SS1.p10.1" class="ltx_p"><span id="A4.SS1.p10.1.1" class="ltx_text">Letting</span></p>
<table id="A4.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex105.m1" class="ltx_Math" alttext="\psi=\frac{4(1-p_{x})}{p_{x}^{2}}\sum_{j=1}^{N}\omega_{j}\frac{(1-\beta_{j})(1-p_{j})}{1-q_{j}}=\frac{4(1-p_{x})}{p_{x}^{2}}\sum_{j=1}^{N}\omega_{j}\frac{(1-\beta_{j})(1-p_{j})}{1-(1-p_{j})\beta_{j}}" display="block" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>=</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>p</mi><mi>x</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></mfrac></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>p</mi><mi>x</mi><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mrow></mfrac></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi=\frac{4(1-p_{x})}{p_{x}^{2}}\sum_{j=1}^{N}\omega_{j}\frac{(1-\beta_{j})(1-p_{j})}{1-q_{j}}=\frac{4(1-p_{x})}{p_{x}^{2}}\sum_{j=1}^{N}\omega_{j}\frac{(1-\beta_{j})(1-p_{j})}{1-(1-p_{j})\beta_{j}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p10.2" class="ltx_p"><span id="A4.SS1.p10.2.1" class="ltx_text">and continuing the chain of bounds, we get</span></p>
<table id="A4.EGx26" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex106.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{MT}\sum_{t=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}{\|x_{t}-x_{t}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{MT}\sum_{t=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}{\|x_{t}-x_{t}^{m}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex107.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex107.m2" class="ltx_math_unparsed" alttext="\displaystyle\eta^{2}\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\left[\frac{1}{K}\sum_{m=1}^{M}\mathbb{E}{\|g_{t}-g_{t}^{m}\|^{2}}\right]" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>K</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>g</mi><mi>t</mi><mi>m</mi></msubsup><msup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\left[\frac{1}{K}\sum_{m=1}^{M}\mathbb{E}{\|g_{t}-g_{t}^{m}\|^{2}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex108.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex108.m2" class="ltx_math_unparsed" alttext="\displaystyle\eta^{2}\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\left[\frac{12L^{2}}{M}\sum_{m=1}^{M}\mathbb{E}\left\lVert x_{t}-x_{t}^{m}\right\rVert^{2}+6(B^{2}-1)\mathbb{E}\|\nabla f(x_{t})\|^{2}+2\sigma^{2}+6G^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mi>M</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mi>𝔼</mi><msup><mrow><mo>‖</mo><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo>‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>6</mn><mrow><mo stretchy="false">(</mo><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mn>2</mn><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn><msup><mi>G</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\left[\frac{12L^{2}}{M}\sum_{m=1}^{M}\mathbb{E}\left\lVert x_{t}-x_{t}^{m}\right\rVert^{2}+6(B^{2}-1)\mathbb{E}\|\nabla f(x_{t})\|^{2}+2\sigma^{2}+6G^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex109.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex109.m2" class="ltx_math_unparsed" alttext="\displaystyle 12\eta^{2}L^{2}\psi\cdot\frac{1}{TM}\sum_{t=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}\left\lVert x_{t}-x_{t}^{m}\right\rVert^{2}" display="inline" intent=":literal"><semantics><mrow><mn>12</mn><msup><mi>η</mi><mn>2</mn></msup><msup><mi>L</mi><mn>2</mn></msup><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mi>𝔼</mi><msup><mrow><mo>‖</mo><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle 12\eta^{2}L^{2}\psi\cdot\frac{1}{TM}\sum_{t=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}\left\lVert x_{t}-x_{t}^{m}\right\rVert^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex110.m1" class="ltx_math_unparsed" alttext="\displaystyle+\;6\eta^{2}(B^{2}-1)\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\|\nabla f(x_{t})\|^{2}+2\eta^{2}\psi(\sigma^{2}+3G^{2})." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn> 6</mn><msup><mi>η</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mn>2</mn><msup><mi>η</mi><mn>2</mn></msup><mi>ψ</mi><mrow><mo stretchy="false">(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn><msup><mi>G</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\;6\eta^{2}(B^{2}-1)\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\|\nabla f(x_{t})\|^{2}+2\eta^{2}\psi(\sigma^{2}+3G^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p10.3" class="ltx_p"><span id="A4.SS1.p10.3.1" class="ltx_text">Assuming <math id="A4.SS1.p10.m1" class="ltx_Math" alttext="12\eta^{2}L^{2}\psi\leq\nicefrac{{1}}{{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo>≤</mo><mrow><mpadded voffset="0.3em"><mn mathsize="0.700em">1</mn></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mn mathsize="0.700em">2</mn></mrow></mrow><annotation encoding="application/x-tex">12\eta^{2}L^{2}\psi\leq\nicefrac{{1}}{{2}}</annotation></semantics></math> and reordering the first term in the bound, we arrive</span></p>
<table id="A4.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex111.m1" class="ltx_math_unparsed" alttext="\frac{1}{MT}\sum_{t=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}{\|x_{t}-x_{t}^{m}\|^{2}}\leq 12\eta^{2}(B^{2}-1)\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\|\nabla f(x_{t})\|^{2}+4\eta^{2}\psi(\sigma^{2}+3G^{2})." display="block" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><msup><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msup><mo lspace="0.0835em">≤</mo><mn>12</mn><msup><mi>η</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mi>T</mi></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mn>4</mn><msup><mi>η</mi><mn>2</mn></msup><mi>ψ</mi><mrow><mo stretchy="false">(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn><msup><mi>G</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{MT}\sum_{t=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}{\|x_{t}-x_{t}^{m}\|^{2}}\leq 12\eta^{2}(B^{2}-1)\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\|\nabla f(x_{t})\|^{2}+4\eta^{2}\psi(\sigma^{2}+3G^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p10.4" class="ltx_p"><span id="A4.SS1.p10.4.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmthm4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmthm4.2" class="ltx_text ltx_font_bold">Lemma 4</span></span><span id="Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmthm4.p1" class="ltx_para ltx_noindent">
<p id="Thmthm4.p1.1" class="ltx_p"><span id="Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">Under smoothness and bounded heterogeneity assumptions <a href="#Thmasp1" title="Assumption 1 (Lower bound and smoothness). ‣ 3 Convergence Guarantees for MT-DAO ‣ MT-DAO: Multi-timescale Distributed Adaptive Optimizers with Local Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and <a href="#Thmasp3" title="Assumption 3 (Bounded heterogeneity). ‣ 3 Convergence Guarantees for MT-DAO ‣ MT-DAO: Multi-timescale Distributed Adaptive Optimizers with Local Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we have</span></p>
<table id="A4.Ex112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex112.m1" class="ltx_Math" alttext="\frac{1}{M}\sum_{m=1}^{M}\left\|\nabla f_{m}(y^{m})-\frac{1}{K}\sum_{i=1}^{K}\nabla f_{i}(y^{i})\right\|^{2}\leq\frac{6L^{2}}{M}\sum_{m=1}^{M}\left\lVert y-y^{m}\right\rVert^{2}+3(B^{2}-1)\|\nabla f(y)\|^{2}+3G^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>M</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>m</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≤</mo><mrow><mrow><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mi>M</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><msup><mrow><mo>‖</mo><mrow><mi>y</mi><mo>−</mo><msup><mi>y</mi><mi>m</mi></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{M}\sum_{m=1}^{M}\left\|\nabla f_{m}(y^{m})-\frac{1}{K}\sum_{i=1}^{K}\nabla f_{i}(y^{i})\right\|^{2}\leq\frac{6L^{2}}{M}\sum_{m=1}^{M}\left\lVert y-y^{m}\right\rVert^{2}+3(B^{2}-1)\|\nabla f(y)\|^{2}+3G^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmthm4.p1.2" class="ltx_p"><span id="Thmthm4.p1.2.1" class="ltx_text ltx_font_italic">for any <math id="Thmthm4.p1.m1" class="ltx_Math" alttext="y^{1},\dots,y^{m}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msup><mi>y</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>y</mi><mi>m</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">y^{1},\dots,y^{m}\in\mathbb{R}^{d}</annotation></semantics></math> and <math id="Thmthm4.p1.m2" class="ltx_Math" alttext="y=\mathbb{E}_{m}[y^{m}]" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>y</mi><mi>m</mi></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y=\mathbb{E}_{m}[y^{m}]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS1.p11" class="ltx_para">
<p id="A4.SS1.p11.1" class="ltx_p"><span id="A4.SS1.p11.1.1" class="ltx_text">The proof follows from Lemma 5 of <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite> as the result does not depend on the optimizer.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h3 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Wall-Clock Time Modeling</h3>

<div id="A5.p1" class="ltx_para ltx_noindent">
<p id="A5.p1.1" class="ltx_p">To assess the practical benefits of our proposal, we analyze its impact on total wall-clock time by modeling two distinct synchronization strategies: a simple unified frequency approach and a desynchronized approach based on optimizer state half-lives. We adopt the model from <span id="A5.p1.1.1" class="ltx_text ltx_font_typewriter">DES-LOC</span> <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite> for estimating total training time.</p>
</div>
<section id="A5.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Wall-Clock Time Model</h4>

<div id="A5.SS1.p1" class="ltx_para ltx_noindent">
<p id="A5.SS1.p1.1" class="ltx_p">The total wall-clock time is modeled as the sum of computational and communication time: <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="t_{\text{total}}=t_{\text{compute}}+t_{\text{comms}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mtext>total</mtext></msub><mo>=</mo><mrow><msub><mi>t</mi><mtext>compute</mtext></msub><mo>+</mo><msub><mi>t</mi><mtext>comms</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">t_{\text{total}}=t_{\text{compute}}+t_{\text{comms}}</annotation></semantics></math>. The computation time, <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="t_{\text{compute}}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mtext>compute</mtext></msub><annotation encoding="application/x-tex">t_{\text{compute}}</annotation></semantics></math>, is a function of model and dataset size, while the communication time, <math id="A5.SS1.p1.m3" class="ltx_Math" alttext="t_{\text{comms}}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mtext>comms</mtext></msub><annotation encoding="application/x-tex">t_{\text{comms}}</annotation></semantics></math>, depends on the number and size of synchronization events.</p>
</div>
<div id="A5.SS1.p2" class="ltx_para ltx_noindent">
<p id="A5.SS1.p2.1" class="ltx_p">For a training process of <math id="A5.SS1.p2.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> total steps, the communication time for an AllReduce operation <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib50" title="" class="ltx_ref">50</a>]</cite> depends on the payload size, number of workers <math id="A5.SS1.p2.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, bandwidth <math id="A5.SS1.p2.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, and latency <math id="A5.SS1.p2.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. The total time for different methods and strategies is:</p>
<ul id="A5.I1" class="ltx_itemize">
<li id="A5.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A5.I1.ix1.p1" class="ltx_para ltx_noindent">
<p id="A5.I1.ix1.p1.1" class="ltx_p"><span id="A5.I1.ix1.p1.1.1" class="ltx_text ltx_font_bold">Unified Frequency Methods:</span> Parameters and all optimizer states are synchronized together every <math id="A5.I1.ix1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> steps. The total payload is <math id="A5.I1.ix1.p1.m2" class="ltx_Math" alttext="3d" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">3d</annotation></semantics></math> (for parameters, first and second momenta). This applies to <span id="A5.I1.ix1.p1.1.2" class="ltx_text ltx_font_typewriter">Local</span> <span id="A5.I1.ix1.p1.1.3" class="ltx_text ltx_font_typewriter">Adam</span> and a baseline version of our method, <span id="A5.I1.ix1.p1.1.4" class="ltx_text ltx_font_typewriter">MT-DAO</span> (Unified).</p>
<table id="A5.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E5.m1" class="ltx_Math" alttext="t_{\text{total},\text{Unified}}=t_{\text{compute}}+\frac{T}{K}\cdot\bigg[\frac{2(3d)}{B}\bigg(1-\frac{1}{M}\bigg)+l\bigg]" display="block" intent=":literal"><semantics><mrow><msub><mi>t</mi><mrow><mtext>total</mtext><mo>,</mo><mtext>Unified</mtext></mrow></msub><mo>=</mo><mrow><msub><mi>t</mi><mtext>compute</mtext></msub><mo>+</mo><mrow><mfrac><mi>T</mi><mi>K</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>B</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>M</mi></mfrac></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mi>l</mi></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{\text{total},\text{Unified}}=t_{\text{compute}}+\frac{T}{K}\cdot\bigg[\frac{2(3d)}{B}\bigg(1-\frac{1}{M}\bigg)+l\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
</div></li>
<li id="A5.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="A5.I1.ix2.p1" class="ltx_para ltx_noindent">
<p id="A5.I1.ix2.p1.1" class="ltx_p"><span id="A5.I1.ix2.p1.1.1" class="ltx_text ltx_font_bold">Half-Life Based Methods:</span> Parameters (<math id="A5.I1.ix2.p1.m1" class="ltx_Math" alttext="K_{x}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>x</mi></msub><annotation encoding="application/x-tex">K_{x}</annotation></semantics></math>), first momentum (<math id="A5.I1.ix2.p1.m2" class="ltx_Math" alttext="K_{u}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>u</mi></msub><annotation encoding="application/x-tex">K_{u}</annotation></semantics></math>), and second momentum (<math id="A5.I1.ix2.p1.m3" class="ltx_Math" alttext="K_{v}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>v</mi></msub><annotation encoding="application/x-tex">K_{v}</annotation></semantics></math>) are synchronized at different frequencies. This applies to <span id="A5.I1.ix2.p1.1.2" class="ltx_text ltx_font_typewriter">DES</span>-<span id="A5.I1.ix2.p1.1.3" class="ltx_text ltx_font_typewriter">LOC</span> and our proposed method, <span id="A5.I1.ix2.p1.1.4" class="ltx_text ltx_font_typewriter">MT-DAO</span> (Half-Life).</p>
<table id="A5.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E6.m1" class="ltx_Math" alttext="t_{\text{total},\text{Half-Life}}=t_{\text{compute}}+\bigg(\frac{T}{K_{x}}+\frac{T}{K_{u}}+\frac{T}{K_{v}}\bigg)\cdot\bigg[\frac{2d}{B}\bigg(1-\frac{1}{M}\bigg)+l\bigg]" display="block" intent=":literal"><semantics><mrow><msub><mi>t</mi><mrow><mtext>total</mtext><mo>,</mo><mtext>Half-Life</mtext></mrow></msub><mo>=</mo><mrow><msub><mi>t</mi><mtext>compute</mtext></msub><mo>+</mo><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mfrac><mi>T</mi><msub><mi>K</mi><mi>x</mi></msub></mfrac><mo>+</mo><mfrac><mi>T</mi><msub><mi>K</mi><mi>u</mi></msub></mfrac><mo>+</mo><mfrac><mi>T</mi><msub><mi>K</mi><mi>v</mi></msub></mfrac></mrow><mo maxsize="2.100em" minsize="2.100em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mi>B</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>M</mi></mfrac></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mi>l</mi></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{\text{total},\text{Half-Life}}=t_{\text{compute}}+\bigg(\frac{T}{K_{x}}+\frac{T}{K_{u}}+\frac{T}{K_{v}}\bigg)\cdot\bigg[\frac{2d}{B}\bigg(1-\frac{1}{M}\bigg)+l\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
</div></li>
</ul>
<p id="A5.SS1.p2.2" class="ltx_p"><span id="A5.SS1.p2.2.1" class="ltx_text ltx_font_bold">Limitation:</span> This model does not account for any potential overlap between computation and communication.</p>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Experimental Configuration</h4>

<div id="A5.SS2.p1" class="ltx_para ltx_noindent">
<p id="A5.SS2.p1.1" class="ltx_p">We compare the two synchronization strategies. The <span id="A5.SS2.p1.1.1" class="ltx_text ltx_font_bold">Unified Frequency</span> strategy serves as a baseline, where all states are synchronized together every <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="K_{x}=32" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>x</mi></msub><mo>=</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">K_{x}=32</annotation></semantics></math> steps. This includes <span id="A5.SS2.p1.1.2" class="ltx_text ltx_font_typewriter">Local</span> <span id="A5.SS2.p1.1.3" class="ltx_text ltx_font_typewriter">Adam</span>, <span id="A5.SS2.p1.1.4" class="ltx_text ltx_font_typewriter">Local</span> <span id="A5.SS2.p1.1.5" class="ltx_text ltx_font_typewriter">ADOPT</span>, and a variant of our method, <span id="A5.SS2.p1.1.6" class="ltx_text ltx_font_typewriter">MT-DAO</span> (Unified), which uses a high <math id="A5.SS2.p1.m2" class="ltx_Math" alttext="\beta_{1}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\beta_{1}</annotation></semantics></math> value but is forced to sync at the same frequent rate as its parameters. These methods have equivalent communication costs and will overlap for an iso-token budget, however, the results in <a href="#S5" title="5 Evaluation ‣ MT-DAO: Multi-timescale Distributed Adaptive Optimizers with Local Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5</span></a> show that <span id="A5.SS2.p1.1.7" class="ltx_text ltx_font_typewriter">MT-DAO</span> achieves the same perplexity as <span id="A5.SS2.p1.1.8" class="ltx_text ltx_font_typewriter">Local</span> <span id="A5.SS2.p1.1.9" class="ltx_text ltx_font_typewriter">ADOPT</span> in many fewer optimization steps, outperforming on time-to-perplexity metrics.</p>
</div>
<div id="A5.SS2.p2" class="ltx_para ltx_noindent">
<p id="A5.SS2.p2.1" class="ltx_p">The <span id="A5.SS2.p2.1.1" class="ltx_text ltx_font_bold">Half-Life Based</span> strategy aims to improve efficiency by synchronizing states less frequently if they change slowly. The synchronization frequency is set based on the state’s half-life, <math id="A5.SS2.p2.m1" class="ltx_Math" alttext="\tau_{0.5}(\beta)=\ln(0.5)/\ln(\beta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mn>0.5</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0.5</mn><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{0.5}(\beta)=\ln(0.5)/\ln(\beta)</annotation></semantics></math>. This includes <span id="A5.SS2.p2.1.2" class="ltx_text ltx_font_typewriter">DES</span>-<span id="A5.SS2.p2.1.3" class="ltx_text ltx_font_typewriter">LOC</span> and <span id="A5.SS2.p2.1.4" class="ltx_text ltx_font_typewriter">MT-DAO</span> (Half-Life). The quasi-hyperbolic (QH) configuration of <span id="A5.SS2.p2.1.5" class="ltx_text ltx_font_typewriter">MT-DAO</span> allows it to use an extremely high <math id="A5.SS2.p2.m2" class="ltx_Math" alttext="\beta_{1}=0.999" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><mn>0.999</mn></mrow><annotation encoding="application/x-tex">\beta_{1}=0.999</annotation></semantics></math>, leading to a very long half-life and thus a much lower communication frequency for its first momentum. We use <math id="A5.SS2.p2.m3" class="ltx_Math" alttext="\beta_{2}=0.999" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>=</mo><mn>0.999</mn></mrow><annotation encoding="application/x-tex">\beta_{2}=0.999</annotation></semantics></math> for ADAM variants and <math id="A5.SS2.p2.m4" class="ltx_Math" alttext="\beta_{2}=0.9999" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>=</mo><mn>0.9999</mn></mrow><annotation encoding="application/x-tex">\beta_{2}=0.9999</annotation></semantics></math> for ADOPT variants.</p>
</div>
<div id="A5.SS2.p3" class="ltx_para ltx_noindent">
<p id="A5.SS2.p3.1" class="ltx_p">Table <a href="#A5.T3" title="Table 3 ‣ E.2 Experimental Configuration ‣ Appendix E Wall-Clock Time Modeling ‣ Appendix ‣ MT-DAO: Multi-timescale Distributed Adaptive Optimizers with Local Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> details the configurations for both strategies.</p>
</div>
<figure id="A5.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A5.T3.3" class="ltx_text" style="font-size:90%;">Table 3</span>: </span><span id="A5.T3.4" class="ltx_text" style="font-size:90%;">Hyperparameter configurations and synchronization frequencies (<math id="A5.T3.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>) for modeled methods, grouped by synchronization strategy. For the Half-Life strategy, momentum frequencies are set to the closest power of two to their half-life.</span></figcaption>
<div id="A5.T3.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:90.1pt;vertical-align:-43.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-84.9pt,22.2pt) scale(0.670097284481162,0.670097284481162) ;">
