<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex29.m2" class="ltx_Math" alttext="\displaystyle-\frac{\eta}{2}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}-\frac{\eta}{2}\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{t}^{m})\right\|^{2}}+\frac{\eta L^{2}}{2M}\sum_{m=1}^{M}\underbrace{\mathbb{E}{\left\|x_{t}-x_{t}^{m}\right\|^{2}}}_{\rm Lemma\;\ref{lem:x-xm}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><munder><munder accentunder="true"><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>Lemma</mi><mo lspace="0.280em" rspace="0em">​</mo><mtext><a href="#Thmthm3" title="Lemma 3. ‣ D.1 Key Lemmas ‣ Appendix D Convergence Analysis of MT-DAO-SGDM ‣ Appendix ‣ MT-DAO: Multi-timescale Distributed Adaptive Optimizers with Local Updates" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">3</span></a></mtext></mrow></munder></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta}{2}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}-\frac{\eta}{2}\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{t}^{m})\right\|^{2}}+\frac{\eta L^{2}}{2M}\sum_{m=1}^{M}\underbrace{\mathbb{E}{\left\|x_{t}-x_{t}^{m}\right\|^{2}}}_{\rm Lemma\;\ref{lem:x-xm}}</annotation></semantics></math></td>
