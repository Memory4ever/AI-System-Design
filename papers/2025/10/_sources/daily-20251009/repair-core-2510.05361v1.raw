<p id="A4.p10.3" class="ltx_p">Notice that</p>
<table id="A4.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex46.m1" class="ltx_Math" alttext="\eta_{0}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\left(4L\max\left(\beta_{\omega},6\sqrt{\psi\max(1,B^{2}-1)}\right)\right)^{-1}" display="block" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>0</mn></msub><mover><mo>=</mo><mi>def</mi></mover><msup><mrow><mo>(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>β</mi><mi>ω</mi></msub><mo>,</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>ψ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\eta_{0}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\left(4L\max\left(\beta_{\omega},6\sqrt{\psi\max(1,B^{2}-1)}\right)\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p10.4" class="ltx_p">satisfies all three bounds. Then, with any <math id="A4.p10.m3" class="ltx_Math" alttext="\eta\leq\eta_{0}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≤</mo><msub><mi>η</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\eta\leq\eta_{0}</annotation></semantics></math> we get</p>
<table id="A4.EGx10" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex47.m1" class="ltx_Math" alttext="\displaystyle\frac{\mathbb{E}[f(z_{T})-f(z_{0})]}{T}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mi>T</mi></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\mathbb{E}[f(z_{T})-f(z_{0})]}{T}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex47.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex47.m3" class="ltx_math_unparsed" alttext="\displaystyle-\frac{\eta}{4T}\sum_{t=0}^{T-1}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em">∥</mo><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta}{4T}\sum_{t=0}^{T-1}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex48.m1" class="ltx_Math" alttext="\displaystyle+\;\frac{\eta^{2}L}{2M}\sigma^{2}+\frac{\eta^{3}\rho L^{2}\beta_{\omega}^{2}}{2M}\sigma^{2}+2\eta^{3}L^{2}\psi(\sigma^{2}+3G^{2})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\;\frac{\eta^{2}L}{2M}\sigma^{2}+\frac{\eta^{3}\rho L^{2}\beta_{\omega}^{2}}{2M}\sigma^{2}+2\eta^{3}L^{2}\psi(\sigma^{2}+3G^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p10.5" class="ltx_p">Noticing that <math id="A4.p10.m4" class="ltx_Math" alttext="z_{0}=x_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mn>0</mn></msub><mo>=</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">z_{0}=x_{0}</annotation></semantics></math> and <math id="A4.p10.m5" class="ltx_Math" alttext="f^{*}\leq f(z_{T})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>≤</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}\leq f(z_{T})</annotation></semantics></math>, we have</p>
<table id="A4.EGx11" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex49.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}\leq\frac{4(f(x_{0})-f^{*})}{\eta T}+\frac{2\eta L}{M}\sigma^{2}+\frac{4\eta^{2}L^{2}\beta_{\omega}^{2}}{M}\sigma^{2}+8\eta^{2}L^{2}\psi(\sigma^{2}+3G^{2})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup></mrow><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}\leq\frac{4(f(x_{0})-f^{*})}{\eta T}+\frac{2\eta L}{M}\sigma^{2}+\frac{4\eta^{2}L^{2}\beta_{\omega}^{2}}{M}\sigma^{2}+8\eta^{2}L^{2}\psi(\sigma^{2}+3G^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.p11" class="ltx_para ltx_noindent">
<p id="A4.p11.1" class="ltx_p">Furthermore, choosing <math id="A4.p11.m1" class="ltx_Math" alttext="\eta=\min(\eta_{0},\frac{1}{\sqrt{T}})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mn>0</mn></msub><mo>,</mo><mfrac><mn>1</mn><msqrt><mi>T</mi></msqrt></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta=\min(\eta_{0},\frac{1}{\sqrt{T}})</annotation></semantics></math>, we get the following rate:</p>
<table id="A4.EGx12" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex50.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex51.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex51.m2" class="ltx_Math" alttext="\displaystyle\max\left(1,\frac{1}{\eta_{0}\sqrt{T}}\right)\frac{4(f(x_{0})-f^{*})}{\sqrt{T}}+\frac{2L\sigma^{2}}{M\sqrt{T}}+\frac{4L^{2}\beta_{\omega}^{2}\sigma^{2}}{MT}+\frac{8L^{2}\psi(\sigma^{2}+3G^{2})}{T}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\max\left(1,\frac{1}{\eta_{0}\sqrt{T}}\right)\frac{4(f(x_{0})-f^{*})}{\sqrt{T}}+\frac{2L\sigma^{2}}{M\sqrt{T}}+\frac{4L^{2}\beta_{\omega}^{2}\sigma^{2}}{MT}+\frac{8L^{2}\psi(\sigma^{2}+3G^{2})}{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex52.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex52.m2" class="ltx_Math" alttext="\displaystyle\frac{4(f(x_{0})-f^{*})}{\sqrt{T}}+\frac{2L\sigma^{2}}{M\sqrt{T}}+\frac{4(f(x_{0})-f^{*})}{\eta_{0}T}+\frac{4L^{2}\beta_{\omega}^{2}\sigma^{2}}{MT}+\frac{8L^{2}\psi(\sigma^{2}+3G^{2})}{T}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{4(f(x_{0})-f^{*})}{\sqrt{T}}+\frac{2L\sigma^{2}}{M\sqrt{T}}+\frac{4(f(x_{0})-f^{*})}{\eta_{0}T}+\frac{4L^{2}\beta_{\omega}^{2}\sigma^{2}}{MT}+\frac{8L^{2}\psi(\sigma^{2}+3G^{2})}{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex53.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex53.m2" class="ltx_Math" alttext="\displaystyle\frac{4}{\sqrt{T}}\left(f(x_{0})-f^{*}+\frac{L\sigma^{2}}{2M}\right)+\mathcal{O}\left(\frac{1+\beta_{\omega}^{2}+\psi}{T}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>4</mn><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mo>+</mo><mi>ψ</mi></mrow><mi>T</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{4}{\sqrt{T}}\left(f(x_{0})-f^{*}+\frac{L\sigma^{2}}{2M}\right)+\mathcal{O}\left(\frac{1+\beta_{\omega}^{2}+\psi}{T}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<section id="A4.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Key Lemmas</h4>

<div id="Thmthm2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmthm2.2" class="ltx_text ltx_font_bold">Lemma 2</span></span><span id="Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmthm2.p1" class="ltx_para ltx_noindent">
<p id="Thmthm2.p1.1" class="ltx_p"><span id="Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="Thmthm2.p1.m1" class="ltx_Math" alttext="T\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T\geq 1</annotation></semantics></math>, we have</span></p>
<table id="A4.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E3.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T-1}\left\lVert z_{t}-x_{t}\right\rVert^{2}\leq\frac{\eta^{2}\beta_{\omega}^{2}}{M}T\sigma^{2}+\eta^{2}\beta_{\omega}^{2}\sum_{t=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{t}^{m})\right\|^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mrow><mo>‖</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup></mrow><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T-1}\left\lVert z_{t}-x_{t}\right\rVert^{2}\leq\frac{\eta^{2}\beta_{\omega}^{2}}{M}T\sigma^{2}+\eta^{2}\beta_{\omega}^{2}\sum_{t=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{t}^{m})\right\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
<p id="Thmthm2.p1.2" class="ltx_p"><span id="Thmthm2.p1.2.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="A4.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex54.m1" class="ltx_Math" alttext="\beta_{\omega}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\sum_{j=1}^{N}\frac{\omega_{j}\beta_{j}}{1-\beta_{j}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>β</mi><mi>ω</mi></msub><mover><mo rspace="0.111em">=</mo><mi>def</mi></mover><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mfrac><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\beta_{\omega}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\sum_{j=1}^{N}\frac{\omega_{j}\beta_{j}}{1-\beta_{j}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS1.p1" class="ltx_para ltx_noindent">
<p id="A4.SS1.p1.1" class="ltx_p"><span id="A4.SS1.p1.1.1" class="ltx_text">Since <math id="A4.SS1.p1.m1" class="ltx_Math" alttext="u_{-1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u_{-1}=0</annotation></semantics></math>, unrolling the update rule of momentum, for any <math id="A4.SS1.p1.m2" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math> we get</span></p>
<table id="A4.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex55.m1" class="ltx_Math" alttext="\displaystyle u_{t}^{j}=\beta_{j}u^{j}_{t-1}+(1-\beta_{j})g_{t}=(1-\beta_{j})\sum_{\tau=0}^{t}\beta_{j}^{t-\tau}g^{\tau}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mi>t</mi><mi>j</mi></msubsup><mo>=</mo><mrow><mrow><msub><mi>β</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>t</mi></msub></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mi>j</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mi>τ</mi></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}^{j}=\beta_{j}u^{j}_{t-1}+(1-\beta_{j})g_{t}=(1-\beta_{j})\sum_{\tau=0}^{t}\beta_{j}^{t-\tau}g^{\tau}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.2" class="ltx_p"><span id="A4.SS1.p1.2.1" class="ltx_text">Using this and the definition of the average iterates, we have</span></p>
<table id="A4.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex56.m1" class="ltx_Math" alttext="\displaystyle z_{t}^{j}-x_{t}^{j}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>t</mi><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>j</mi></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle z_{t}^{j}-x_{t}^{j}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex56.m2" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\beta_{j}}{1-\beta_{j}}(x_{t}^{j}-x_{t-1}^{j})=-\frac{\eta\beta_{j}}{1-\beta_{j}}u^{j}_{t}=-\eta\beta_{j}\sum_{\tau=0}^{t}\beta_{j}^{t-\tau}g_{\tau}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mi>j</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><msubsup><mi>u</mi><mi>t</mi><mi>j</mi></msubsup><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>η</mi><msub><mi>β</mi><mi>j</mi></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msubsup><mi>β</mi><mi>j</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup><msub><mi>g</mi><mi>τ</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\beta_{j}}{1-\beta_{j}}(x_{t}^{j}-x_{t-1}^{j})=-\frac{\eta\beta_{j}}{1-\beta_{j}}u^{j}_{t}=-\eta\beta_{j}\sum_{\tau=0}^{t}\beta_{j}^{t-\tau}g_{\tau}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex57.m1" class="ltx_Math" alttext="\displaystyle z_{t}-x_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle z_{t}-x_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex57.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{j}[z_{t}^{j}-x_{t}^{j}]=\mathbb{E}_{j}\left[-\eta\beta_{j}\sum_{\tau=0}^{t}\beta_{j}^{t-\tau}g_{\tau}\right]=-\eta\sum_{\tau=0}^{t}\mathbb{E}_{j}\left[\beta_{j}^{t-\tau+1}\right]g_{\tau}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi>j</mi></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>z</mi><mi>t</mi><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>j</mi></msubsup><mo stretchy="false">]</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mi>j</mi></msub><mrow><mo>[</mo><mo lspace="0em">−</mo><mi>η</mi><msub><mi>β</mi><mi>j</mi></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msubsup><mi>β</mi><mi>j</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup><msub><mi>g</mi><mi>τ</mi></msub><mo>]</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>η</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msub><mi>𝔼</mi><mi>j</mi></msub><mrow><mo>[</mo><msubsup><mi>β</mi><mi>j</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><mo>]</mo></mrow><msub><mi>g</mi><mi>τ</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{j}[z_{t}^{j}-x_{t}^{j}]=\mathbb{E}_{j}\left[-\eta\beta_{j}\sum_{\tau=0}^{t}\beta_{j}^{t-\tau}g_{\tau}\right]=-\eta\sum_{\tau=0}^{t}\mathbb{E}_{j}\left[\beta_{j}^{t-\tau+1}\right]g_{\tau}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex58.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\eta\sum_{\tau=0}^{t}\beta_{\omega}^{(t-\tau+1)}g_{\tau},\quad\text{where }\beta_{\omega}^{(\tau)}=\mathbb{E}_{j}\left[\beta_{j}^{\tau}\right]=\sum_{j=1}^{N}\omega_{j}\beta_{j}^{\tau}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>η</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msubsup><mi>β</mi><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><msub><mi>g</mi><mi>τ</mi></msub><mo rspace="1.167em">,</mo><mtext>where </mtext><msubsup><mi>β</mi><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msub><mi>𝔼</mi><mi>j</mi></msub><mrow><mo>[</mo><msubsup><mi>β</mi><mi>j</mi><mi>τ</mi></msubsup><mo>]</mo></mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><msub><mi>ω</mi><mi>j</mi></msub><msubsup><mi>β</mi><mi>j</mi><mi>τ</mi></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\eta\sum_{\tau=0}^{t}\beta_{\omega}^{(t-\tau+1)}g_{\tau},\quad\text{where }\beta_{\omega}^{(\tau)}=\mathbb{E}_{j}\left[\beta_{j}^{\tau}\right]=\sum_{j=1}^{N}\omega_{j}\beta_{j}^{\tau}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS1.p2" class="ltx_para ltx_noindent">
<p id="A4.SS1.p2.1" class="ltx_p"><span id="A4.SS1.p2.1.1" class="ltx_text">Let us make another notation for the sum of weights in the above sum and bound it as follows:</span></p>
</div>
<div id="A4.SS1.p3" class="ltx_para ltx_noindent">
<table id="A4.EGx16" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex59.m1" class="ltx_Math" alttext="\displaystyle s_{t}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\displaystyle s_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex59.m2" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\mathrm{def}}}{{=}}" display="inline" intent=":literal"><semantics><mover><mo>=</mo><mi>def</mi></mover><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\mathrm{def}}}{{=}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex59.m3" class="ltx_Math" alttext="\displaystyle\sum_{\tau=0}^{t}\beta_{\omega}^{(t-\tau+1)}=\sum_{\tau=0}^{t}\sum_{j=1}^{N}\omega_{j}\beta_{j}^{t-\tau+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msubsup><mi>β</mi><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>j</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\tau=0}^{t}\beta_{\omega}^{(t-\tau+1)}=\sum_{\tau=0}^{t}\sum_{j=1}^{N}\omega_{j}\beta_{j}^{t-\tau+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex60.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex60.m2" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{N}\omega_{j}\sum_{\tau=0}^{t}\beta_{j}^{t-\tau+1}=\sum_{j=1}^{N}\omega_{j}\frac{\beta_{j}-\beta_{j}^{t+2}}{1-\beta_{j}}\leq\sum_{j=1}^{N}\frac{\omega_{j}\beta_{j}}{1-\beta_{j}}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\beta_{\omega}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><msubsup><mi>β</mi><mi>j</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>β</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>β</mi><mi>j</mi><mrow><mi>t</mi><mo>+</mo><mn>2</mn></mrow></msubsup></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle></mrow><mover><mo>=</mo><mi>def</mi></mover><msub><mi>β</mi><mi>ω</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{N}\omega_{j}\sum_{\tau=0}^{t}\beta_{j}^{t-\tau+1}=\sum_{j=1}^{N}\omega_{j}\frac{\beta_{j}-\beta_{j}^{t+2}}{1-\beta_{j}}\leq\sum_{j=1}^{N}\frac{\omega_{j}\beta_{j}}{1-\beta_{j}}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\beta_{\omega}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS1.p4" class="ltx_para">
<p id="A4.SS1.p4.1" class="ltx_p"><span id="A4.SS1.p4.1.1" class="ltx_text">Using convexity of squared norm, we have</span></p>
<table id="A4.EGx17" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex61.m1" class="ltx_Math" alttext="\displaystyle\left\lVert z_{t}-x_{t}\right\rVert^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>‖</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\left\lVert z_{t}-x_{t}\right\rVert^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex61.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex61.m3" class="ltx_Math" alttext="\displaystyle\eta^{2}s_{t}^{2}\left\|\sum_{\tau=0}^{t}\frac{\beta_{\omega}^{(t-\tau+1)}}{s_{t}}g_{\tau}\right\|^{2}\leq\eta^{2}s_{t}^{2}\sum_{\tau=0}^{t}\frac{\beta_{\omega}^{(t-\tau+1)}}{s_{t}}\|g_{\tau}\|^{2}\leq\eta^{2}\beta_{\omega}\sum_{\tau=0}^{t}\beta_{\omega}^{(t-\tau+1)}\|g_{\tau}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>s</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>β</mi><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><msub><mi>s</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>τ</mi></msub></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>s</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>β</mi><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><msub><mi>s</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>τ</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>≤</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>τ</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}s_{t}^{2}\left\|\sum_{\tau=0}^{t}\frac{\beta_{\omega}^{(t-\tau+1)}}{s_{t}}g_{\tau}\right\|^{2}\leq\eta^{2}s_{t}^{2}\sum_{\tau=0}^{t}\frac{\beta_{\omega}^{(t-\tau+1)}}{s_{t}}\|g_{\tau}\|^{2}\leq\eta^{2}\beta_{\omega}\sum_{\tau=0}^{t}\beta_{\omega}^{(t-\tau+1)}\|g_{\tau}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p4.2" class="ltx_p"><span id="A4.SS1.p4.2.1" class="ltx_text">Summing over the iterates yields</span></p>
<table id="A4.EGx18" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex62.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T-1}\mathbb{E}\left\lVert z_{t}-x_{t}\right\rVert^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T-1}\mathbb{E}\left\lVert z_{t}-x_{t}\right\rVert^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex62.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex62.m3" class="ltx_Math" alttext="\displaystyle\eta^{2}\beta_{\omega}\sum_{t=0}^{T-1}\sum_{\tau=0}^{t}\beta_{\omega}^{(t-\tau+1)}\mathbb{E}\|g_{\tau}\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>β</mi><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>τ</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}\beta_{\omega}\sum_{t=0}^{T-1}\sum_{\tau=0}^{t}\beta_{\omega}^{(t-\tau+1)}\mathbb{E}\|g_{\tau}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex63.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex63.m2" class="ltx_Math" alttext="\displaystyle\eta^{2}\beta_{\omega}\sum_{\tau=0}^{T-1}\sum_{t=\tau}^{T-1}\beta_{\omega}^{(t-\tau+1)}\mathbb{E}\|g_{\tau}\|^{2}=\eta^{2}\beta_{\omega}\sum_{\tau=0}^{T-1}\left(\sum_{t=1}^{T-\tau}\beta_{\omega}^{(t)}\right)\mathbb{E}\|g_{\tau}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mi>τ</mi></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>β</mi><mi>ω</mi><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>τ</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mi>τ</mi></mrow></munderover></mstyle><msubsup><mi>β</mi><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>τ</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}\beta_{\omega}\sum_{\tau=0}^{T-1}\sum_{t=\tau}^{T-1}\beta_{\omega}^{(t-\tau+1)}\mathbb{E}\|g_{\tau}\|^{2}=\eta^{2}\beta_{\omega}\sum_{\tau=0}^{T-1}\left(\sum_{t=1}^{T-\tau}\beta_{\omega}^{(t)}\right)\mathbb{E}\|g_{\tau}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex64.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex64.m2" class="ltx_Math" alttext="\displaystyle\eta^{2}\beta_{\omega}\sum_{\tau=0}^{T-1}\left(\sum_{j=1}^{N}\omega_{j}\frac{\beta_{j}-\beta_{j}^{T-\tau+1}}{1-\beta_{j}}\right)\mathbb{E}\|g_{\tau}\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>β</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>β</mi><mi>j</mi><mrow><mrow><mi>T</mi><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>τ</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}\beta_{\omega}\sum_{\tau=0}^{T-1}\left(\sum_{j=1}^{N}\omega_{j}\frac{\beta_{j}-\beta_{j}^{T-\tau+1}}{1-\beta_{j}}\right)\mathbb{E}\|g_{\tau}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex65.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex65.m2" class="ltx_Math" alttext="\displaystyle\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\|g_{\tau}\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>τ</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\|g_{\tau}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex66.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex66.m2" class="ltx_Math" alttext="\displaystyle\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}g_{\tau}^{m}-\nabla f_{m}(x_{\tau}^{m})\right\|^{2}+\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{\tau}^{m})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msubsup><mi>g</mi><mi>τ</mi><mi>m</mi></msubsup></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>τ</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>τ</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}g_{\tau}^{m}-\nabla f_{m}(x_{\tau}^{m})\right\|^{2}+\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{\tau}^{m})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex67.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex67.m2" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}\beta_{\omega}^{2}}{M^{2}}\sum_{\tau=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}\left\|g_{\tau}^{m}-\nabla f_{m}(x_{\tau}^{m})\right\|^{2}+\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{\tau}^{m})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup></mrow><msup><mi>M</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>g</mi><mi>τ</mi><mi>m</mi></msubsup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>τ</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>τ</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}\beta_{\omega}^{2}}{M^{2}}\sum_{\tau=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}\left\|g_{\tau}^{m}-\nabla f_{m}(x_{\tau}^{m})\right\|^{2}+\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{\tau}^{m})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex68.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex68.m2" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}\beta_{\omega}^{2}}{M}T\sigma^{2}+\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{\tau}^{m})\right\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup></mrow><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>τ</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}\beta_{\omega}^{2}}{M}T\sigma^{2}+\eta^{2}\beta_{\omega}^{2}\sum_{\tau=0}^{T-1}\mathbb{E}\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{\tau}^{m})\right\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p4.3" class="ltx_p"><span id="A4.SS1.p4.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmthm3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmthm3.2" class="ltx_text ltx_font_bold">Lemma 3</span></span><span id="Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmthm3.p1" class="ltx_para ltx_noindent">
<p id="Thmthm3.p1.1" class="ltx_p"><span id="Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">If <math id="Thmthm3.p1.m1" class="ltx_Math" alttext="24\eta^{2}L^{2}\psi\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>24</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">24\eta^{2}L^{2}\psi\leq 1</annotation></semantics></math>, then</span></p>
<table id="A4.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex69.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{MT}\sum_{t=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}\left\lVert x_{t}-x_{t}^{m}\right\rVert^{2}\leq 12\eta^{2}(B^{2}-1)\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\|\nabla f(x_{t})\|^{2}+4\eta^{2}\psi(\sigma^{2}+3G^{2})," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mi>𝔼</mi><msup><mrow><mo>‖</mo><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mn>12</mn><msup><mi>η</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mn>4</mn><msup><mi>η</mi><mn>2</mn></msup><mi>ψ</mi><mrow><mo stretchy="false">(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn><msup><mi>G</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{MT}\sum_{t=0}^{T-1}\sum_{m=1}^{M}\mathbb{E}\left\lVert x_{t}-x_{t}^{m}\right\rVert^{2}\leq 12\eta^{2}(B^{2}-1)\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\|\nabla f(x_{t})\|^{2}+4\eta^{2}\psi(\sigma^{2}+3G^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmthm3.p1.2" class="ltx_p"><span id="Thmthm3.p1.2.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="A4.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex70.m1" class="ltx_Math" alttext="\psi=\frac{4(1-p_{x})}{p_{x}^{2}}\cdot\sum_{j=1}^{N}\omega_{j}\frac{(1-\beta_{j})(1-p_{j})}{1-(1-p_{j})\beta_{j}}" display="block" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>=</mo><mrow><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>p</mi><mi>x</mi><mn>2</mn></msubsup></mfrac><mo lspace="0.222em" rspace="0.055em">⋅</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mrow></mfrac></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi=\frac{4(1-p_{x})}{p_{x}^{2}}\cdot\sum_{j=1}^{N}\omega_{j}\frac{(1-\beta_{j})(1-p_{j})}{1-(1-p_{j})\beta_{j}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS1.p5" class="ltx_para ltx_noindent">
<p id="A4.SS1.p5.1" class="ltx_p"><span id="A4.SS1.p5.1.1" class="ltx_text">Let us expand the term <math id="A4.SS1.p5.m1" class="ltx_Math" alttext="\mathbb{E}{\|x_{t+1}-x_{t+1}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{E}{\|x_{t+1}-x_{t+1}^{m}\|^{2}}</annotation></semantics></math> using <math id="A4.SS1.p5.m2" class="ltx_Math" alttext="x_{t+1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">x_{t+1}^{m}</annotation></semantics></math>’s probabilistic update rule:</span></p>
<table id="A4.EGx20" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex71.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}{\|x_{t+1}-x_{t+1}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}{\|x_{t+1}-x_{t+1}^{m}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex71.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex71.m3" class="ltx_Math" alttext="\displaystyle p_{x}\cdot 0+(1-p_{x})\cdot\mathbb{E}{\|x_{t}-\eta u_{t}-(x_{t}^{m}-\eta u_{t}^{m})\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>x</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>0</mn></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝔼</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>t</mi><mi>m</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{x}\cdot 0+(1-p_{x})\cdot\mathbb{E}{\|x_{t}-\eta u_{t}-(x_{t}^{m}-\eta u_{t}^{m})\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex72.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex72.m2" class="ltx_Math" alttext="\displaystyle(1-p_{x})\cdot\mathbb{E}{\|x_{t}-x_{t}^{m}-\eta(u_{t}-u_{t}^{m})\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝔼</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle(1-p_{x})\cdot\mathbb{E}{\|x_{t}-x_{t}^{m}-\eta(u_{t}-u_{t}^{m})\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex73.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex73.m2" class="ltx_Math" alttext="\displaystyle(1-p_{x})(1+s)\mathbb{E}{\|x_{t}-x_{t}^{m}\|^{2}}+\eta^{2}(1-p_{x})(1+\nicefrac{{1}}{{s}})\mathbb{E}{\|u_{t}-u_{t}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mpadded voffset="0.3em"><mn>1</mn></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mi>s</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-p_{x})(1+s)\mathbb{E}{\|x_{t}-x_{t}^{m}\|^{2}}+\eta^{2}(1-p_{x})(1+\nicefrac{{1}}{{s}})\mathbb{E}{\|u_{t}-u_{t}^{m}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex74.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex74.m2" class="ltx_Math" alttext="\displaystyle\eta^{2}(1-p_{x})(1+\nicefrac{{1}}{{s}})\sum_{\tau=1}^{t}((1-p_{x})(1+s))^{t-\tau}\mathbb{E}{\|u_{\tau}-u_{\tau}^{m}\|^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mpadded voffset="0.3em"><mn>1</mn></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mi>s</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>u</mi><mi>τ</mi></msub><mo>−</mo><msubsup><mi>u</mi><mi>τ</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}(1-p_{x})(1+\nicefrac{{1}}{{s}})\sum_{\tau=1}^{t}((1-p_{x})(1+s))^{t-\tau}\mathbb{E}{\|u_{\tau}-u_{\tau}^{m}\|^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p5.2" class="ltx_p"><span id="A4.SS1.p5.2.1" class="ltx_text">where <math id="A4.SS1.p5.m3" class="ltx_Math" alttext="s&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s&gt;0</annotation></semantics></math> will be chosen later. Next we expand the term <math id="A4.SS1.p5.m4" class="ltx_Math" alttext="\mathbb{E}{\|u_{t}^{j}-u_{t}^{j,m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>u</mi><mi>t</mi><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{E}{\|u_{t}^{j}-u_{t}^{j,m}\|^{2}}</annotation></semantics></math> using <math id="A4.SS1.p5.m5" class="ltx_Math" alttext="u_{t}^{j,m}" display="inline" intent=":literal"><semantics><msubsup><mi>u</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup><annotation encoding="application/x-tex">u_{t}^{j,m}</annotation></semantics></math>’s probabilistic update rule:</span></p>
<table id="A4.EGx21" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex75.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}{\|u_{t}^{j}-u_{t}^{j,m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>u</mi><mi>t</mi><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}{\|u_{t}^{j}-u_{t}^{j,m}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex75.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex75.m3" class="ltx_Math" alttext="\displaystyle p_{j}\cdot 0+(1-p_{j})\cdot\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}(\beta_{j}u_{t-1}^{j,m}+(1-\beta_{j})g_{t-1}^{m})-(\beta_{j}u_{t-1}^{j,m}+(1-\beta_{j})g_{t-1}^{m})\right\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>0</mn></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝔼</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>β</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>m</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>β</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>m</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{j}\cdot 0+(1-p_{j})\cdot\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}(\beta_{j}u_{t-1}^{j,m}+(1-\beta_{j})g_{t-1}^{m})-(\beta_{j}u_{t-1}^{j,m}+(1-\beta_{j})g_{t-1}^{m})\right\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex76.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex76.m2" class="ltx_Math" alttext="\displaystyle(1-p_{j})\mathbb{E}{\left\|\beta_{j}(u_{t-1}^{j}-u_{t-1}^{j,m})+(1-\beta_{j})(g_{t-1}-g_{t-1}^{m})\right\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi>β</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msubsup><mi>g</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>m</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle(1-p_{j})\mathbb{E}{\left\|\beta_{j}(u_{t-1}^{j}-u_{t-1}^{j,m})+(1-\beta_{j})(g_{t-1}-g_{t-1}^{m})\right\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex77.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex77.m2" class="ltx_Math" alttext="\displaystyle(1-p_{j})\beta_{j}\mathbb{E}{\|(u_{t-1}^{j}-u_{t-1}^{j,m})\|^{2}}+(1-p_{j})(1-\beta_{j})\mathbb{E}{\|g_{t-1}-g_{t-1}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msubsup><mi>g</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-p_{j})\beta_{j}\mathbb{E}{\|(u_{t-1}^{j}-u_{t-1}^{j,m})\|^{2}}+(1-p_{j})(1-\beta_{j})\mathbb{E}{\|g_{t-1}-g_{t-1}^{m}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex78.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex78.m2" class="ltx_Math" alttext="\displaystyle(1-p_{j})(1-\beta_{j})\sum_{\tau=0}^{t-1}((1-p_{j})\beta_{j})^{t-\tau-1}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>τ</mi></msub><mo>−</mo><msubsup><mi>g</mi><mi>τ</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-p_{j})(1-\beta_{j})\sum_{\tau=0}^{t-1}((1-p_{j})\beta_{j})^{t-\tau-1}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
