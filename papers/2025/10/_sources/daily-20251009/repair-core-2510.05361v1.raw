<tbody id="A4.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex6.m1" class="ltx_Math" alttext="\displaystyle x_{t+1}^{j}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>j</mi></msubsup><annotation encoding="application/x-tex">\displaystyle x_{t+1}^{j}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex6.m2" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\mathrm{def}}}{{=}}" display="inline" intent=":literal"><semantics><mover><mo>=</mo><mi>def</mi></mover><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\mathrm{def}}}{{=}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex6.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{m}[x_{t+1}^{j,m}]=x_{t}^{j}-\eta u_{t}^{j},\quad x_{t+1}^{m}=\mathbb{E}_{j}[x_{t+1}^{j,m}]=\text{ (line 14) }." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>j</mi></msubsup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>t</mi><mi>j</mi></msubsup></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mtext> (line 14) </mtext></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{m}[x_{t+1}^{j,m}]=x_{t}^{j}-\eta u_{t}^{j},\quad x_{t+1}^{m}=\mathbb{E}_{j}[x_{t+1}^{j,m}]=\text{ (line 14) }.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.2" class="ltx_p">For the sake of notation, we also let <math id="A4.p2.m7" class="ltx_Math" alttext="u_{t}^{m}=\Delta_{t}^{m}=\mathbb{E}_{j}[u_{t}^{j,m}],\,u_{t}=\mathbb{E}_{m}[u_{t}^{m}],\,x_{t}=\mathbb{E}_{m}[x_{t}^{m}]" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mi>t</mi><mi>m</mi></msubsup><mo>=</mo><msubsup><mi mathvariant="normal">Δ</mi><mi>t</mi><mi>m</mi></msubsup><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>u</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>u</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{t}^{m}=\Delta_{t}^{m}=\mathbb{E}_{j}[u_{t}^{j,m}],\,u_{t}=\mathbb{E}_{m}[u_{t}^{m}],\,x_{t}=\mathbb{E}_{m}[x_{t}^{m}]</annotation></semantics></math> in the upcoming derivations.</p>
</div>
<div id="A4.p3" class="ltx_para ltx_noindent">
<p id="A4.p3.1" class="ltx_p"><span id="A4.p3.1.1" class="ltx_text ltx_underline">Step 1 (virtual iterates).</span> Letting <math id="A4.p3.m1" class="ltx_Math" alttext="x_{-1}^{j}=x_{0}^{j}=x_{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup><mo>=</mo><msubsup><mi>x</mi><mn>0</mn><mi>j</mi></msubsup><mo>=</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">x_{-1}^{j}=x_{0}^{j}=x_{0}</annotation></semantics></math>, define the global virtual iterations as follows</p>
<table id="A4.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex7.m1" class="ltx_Math" alttext="z_{t}^{j}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\frac{1}{1-\beta_{j}}x_{t}^{j}-\frac{\beta_{j}}{1-\beta_{j}}x_{t-1}^{j},\quad\text{and}\quad z_{t}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\mathbb{E}_{j}[z_{t}^{j}]\quad\text{for }t\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>z</mi><mi>t</mi><mi>j</mi></msubsup><mover><mo>=</mo><mi>def</mi></mover><mrow><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>t</mi><mi>j</mi></msubsup></mrow><mo>−</mo><mrow><mfrac><msub><mi>β</mi><mi>j</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>z</mi><mi>t</mi></msub><mover><mo>=</mo><mi>def</mi></mover><mrow><msub><mi>𝔼</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>z</mi><mi>t</mi><mi>j</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>≥</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">z_{t}^{j}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\frac{1}{1-\beta_{j}}x_{t}^{j}-\frac{\beta_{j}}{1-\beta_{j}}x_{t-1}^{j},\quad\text{and}\quad z_{t}\stackrel{{\scriptstyle\mathrm{def}}}{{=}}\mathbb{E}_{j}[z_{t}^{j}]\quad\text{for }t\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.2" class="ltx_p">The key property of this virtual iterates we are going to exploit in the next steps is that they follow averaged gradients, namely for any <math id="A4.p3.m2" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math> we have</p>
<table id="A4.EGx2" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex8.m1" class="ltx_Math" alttext="\displaystyle z_{t+1}-z_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>z</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle z_{t+1}-z_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex8.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex8.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{j}[z_{t+1}^{j}-z_{t}^{j}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>z</mi><mi>t</mi><mi>j</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{j}[z_{t+1}^{j}-z_{t}^{j}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex9.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex9.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{j}\left[\left(\frac{1}{1-\beta_{j}}x_{t+1}^{j}-\frac{\beta_{j}}{1-\beta_{j}}x_{t}^{j}\right)-\left(\frac{1}{1-\beta_{j}}x_{t}^{j}-\frac{\beta_{j}}{1-\beta_{j}}x_{t-1}^{j}\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mi>j</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>t</mi><mi>j</mi></msubsup></mrow></mrow><mo>)</mo></mrow><mo>−</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>t</mi><mi>j</mi></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mi>j</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{j}\left[\left(\frac{1}{1-\beta_{j}}x_{t+1}^{j}-\frac{\beta_{j}}{1-\beta_{j}}x_{t}^{j}\right)-\left(\frac{1}{1-\beta_{j}}x_{t}^{j}-\frac{\beta_{j}}{1-\beta_{j}}x_{t-1}^{j}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex10.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex10.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{j}\left[\frac{1}{1-\beta_{j}}(x_{t+1}^{j}-x_{t}^{j})-\frac{\beta_{j}}{1-\beta_{j}}(x_{t}^{j}-x_{t-1}^{j})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>j</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mi>j</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>j</mi></msubsup><mo>−</mo><msubsup><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{j}\left[\frac{1}{1-\beta_{j}}(x_{t+1}^{j}-x_{t}^{j})-\frac{\beta_{j}}{1-\beta_{j}}(x_{t}^{j}-x_{t-1}^{j})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex11.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex11.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{j}\left[\frac{1}{1-\beta_{j}}(-\eta u_{t}^{j})-\frac{\beta_{j}}{1-\beta_{j}}(-\eta u_{t-1}^{j})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>t</mi><mi>j</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>β</mi><mi>j</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{j}\left[\frac{1}{1-\beta_{j}}(-\eta u_{t}^{j})-\frac{\beta_{j}}{1-\beta_{j}}(-\eta u_{t-1}^{j})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex12.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex12.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{j}\left[\frac{-\eta}{1-\beta_{j}}(u_{t}^{j}-\beta_{j}u_{t-1}^{j})\right]=\mathbb{E}_{j}[-\eta g_{t}]=-\eta g_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>−</mo><mi>η</mi></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>u</mi><mi>t</mi><mi>j</mi></msubsup><mo>−</mo><mrow><msub><mi>β</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>t</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{j}\left[\frac{-\eta}{1-\beta_{j}}(u_{t}^{j}-\beta_{j}u_{t-1}^{j})\right]=\mathbb{E}_{j}[-\eta g_{t}]=-\eta g_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.p4" class="ltx_para ltx_noindent">
<p id="A4.p4.1" class="ltx_p"><span id="A4.p4.1.1" class="ltx_text ltx_underline">Step 2 (smoothness over virtual iterates).</span> Then we apply smoothness of the global loss function <math id="A4.p4.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> over these global virtual iterates.</p>
<table id="A4.EGx3" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex13.m1" class="ltx_Math" alttext="\displaystyle f(z_{t+1})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f(z_{t+1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex13.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
