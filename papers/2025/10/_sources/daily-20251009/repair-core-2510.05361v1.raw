<div id="A4.SS1.p7" class="ltx_para ltx_noindent">
<p id="A4.SS1.p7.1" class="ltx_p"><span id="A4.SS1.p7.1.1" class="ltx_text">Next, we bound the gradient term above.</span></p>
<table id="A4.EGx23" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex89.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{t}^{m}-g_{t}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>g</mi><mi>t</mi><mi>m</mi></msubsup><mo>−</mo><msub><mi>g</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{t}^{m}-g_{t}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex89.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex89.m3" class="ltx_Math" alttext="\displaystyle\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\left\|g_{t}^{m}-\frac{1}{M}\sum_{i=1}^{K}g_{t}^{i}\right\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>g</mi><mi>t</mi><mi>m</mi></msubsup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><msubsup><mi>g</mi><mi>t</mi><mi>i</mi></msubsup></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\left\|g_{t}^{m}-\frac{1}{M}\sum_{i=1}^{K}g_{t}^{i}\right\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
