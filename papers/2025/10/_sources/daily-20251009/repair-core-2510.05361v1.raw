              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
            <span id="alg4.l14.3" class="ltx_text" style="font-size:80%;">      </span><math id="alg4.l14.m1" class="ltx_Math" alttext="u_{t}^{j,m}\leftarrow\begin{cases}\mathbb{E}_{m}[\beta_{j}u_{t-1}^{j,m}+(1-\beta_{j})g_{t}^{m}],&{\color[rgb]{0.75,0,0.25}\text{with probability }p_{j}}\\
\beta_{j}u_{t-1}^{j,m}+(1-\beta_{j})g_{t}^{m},&amp;\text{with probability }1-p_{j}\end{cases}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">u</mi><mi mathsize="0.800em">t</mi><mrow><mi mathsize="0.800em">j</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">m</mi></mrow></msubsup><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi mathsize="0.800em">𝔼</mi><mi mathsize="0.800em">m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><msub><mi mathsize="0.800em">β</mi><mi mathsize="0.800em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">u</mi><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow><mrow><mi mathsize="0.800em">j</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">m</mi></mrow></msubsup></mrow><mo mathsize="0.800em">+</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">−</mo><msub><mi mathsize="0.800em">β</mi><mi mathsize="0.800em">j</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">g</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">m</mi></msubsup></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow></mrow><mo mathsize="0.800em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" mathsize="0.800em">with probability </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" mathsize="0.800em">p</mi><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" mathsize="0.800em">j</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mi mathsize="0.800em">β</mi><mi mathsize="0.800em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">u</mi><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow><mrow><mi mathsize="0.800em">j</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">m</mi></mrow></msubsup></mrow><mo mathsize="0.800em">+</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">−</mo><msub><mi mathsize="0.800em">β</mi><mi mathsize="0.800em">j</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">g</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">m</mi></msubsup></mrow></mrow><mo mathsize="0.800em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext mathsize="0.800em">with probability </mtext><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.800em">1</mn></mrow><mo mathsize="0.800em">−</mo><msub><mi mathsize="0.800em">p</mi><mi mathsize="0.800em">j</mi></msub></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">u_{t}^{j,m}\leftarrow\begin{cases}\mathbb{E}_{m}[\beta_{j}u_{t-1}^{j,m}+(1-\beta_{j})g_{t}^{m}],&amp;{\color[rgb]{0.75,0,0.25}\text{with probability }p_{j}}\\
\beta_{j}u_{t-1}^{j,m}+(1-\beta_{j})g_{t}^{m},&amp;\text{with probability }1-p_{j}\end{cases}</annotation></semantics></math><span id="alg4.l14.4" class="ltx_text" style="font-size:80%;"> </span><span id="alg4.l14.5" class="ltx_text" style="font-size:80%;float:right;"><span id="alg4.l14.5.1" class="ltx_text" style="font-size:88%;--ltx-fg-color:#BF0040;">sync <math id="alg4.l14.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040">u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math></span>
    </span>
</div>
<div id="alg4.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
            <span id="alg4.l15.3" class="ltx_text" style="font-size:80%;">    </span><math id="alg4.l15.m1" class="ltx_Math" alttext="\Delta_{t}^{m}\leftarrow\sum_{j=1}^{N}\omega_{j}u_{t}^{j,m}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">m</mi></msubsup><mo mathsize="0.800em" rspace="0.111em" stretchy="false">←</mo><mrow><msubsup><mo maxsize="0.800em" minsize="0.800em" stretchy="true">∑</mo><mrow><mi mathsize="0.800em">j</mi><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">1</mn></mrow><mi mathsize="0.800em">N</mi></msubsup><mrow><msub><mi mathsize="0.800em">ω</mi><mi mathsize="0.800em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">u</mi><mi mathsize="0.800em">t</mi><mrow><mi mathsize="0.800em">j</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">m</mi></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{t}^{m}\leftarrow\sum_{j=1}^{N}\omega_{j}u_{t}^{j,m}</annotation></semantics></math><span id="alg4.l15.4" class="ltx_text" style="font-size:80%;"> </span><span id="alg4.l15.5" class="ltx_text" style="font-size:80%;float:right;"><span id="alg4.l15.5.1" class="ltx_text" style="font-size:88%;--ltx-fg-color:#BF0040;">form combined update direction</span>
</span>
</div>
<div id="alg4.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
            <span id="alg4.l16.3" class="ltx_text" style="font-size:80%;">    </span><math id="alg4.l16.m1" class="ltx_Math" alttext="x_{t+1}^{m}\leftarrow\begin{cases}\mathbb{E}_{m}[x_{t}^{m}-\eta_{t}\Delta_{t}^{m}],&{\color[rgb]{0.75,0,0.25}\text{with probability }p_{x}}\\
x_{t}^{m}-\eta_{t}\Delta_{t}^{m},&amp;\text{with probability }1-p_{x}\end{cases}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">x</mi><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">1</mn></mrow><mi mathsize="0.800em">m</mi></msubsup><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi mathsize="0.800em">𝔼</mi><mi mathsize="0.800em">m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><msubsup><mi mathsize="0.800em">x</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">m</mi></msubsup><mo mathsize="0.800em">−</mo><mrow><msub><mi mathsize="0.800em">η</mi><mi mathsize="0.800em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">m</mi></msubsup></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow></mrow><mo mathsize="0.800em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" mathsize="0.800em">with probability </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" mathsize="0.800em">p</mi><mi style="--ltx-fg-color:#BF0040;" mathcolor="#BF0040" mathsize="0.800em">x</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi mathsize="0.800em">x</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">m</mi></msubsup><mo mathsize="0.800em">−</mo><mrow><msub><mi mathsize="0.800em">η</mi><mi mathsize="0.800em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">m</mi></msubsup></mrow></mrow><mo mathsize="0.800em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext mathsize="0.800em">with probability </mtext><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.800em">1</mn></mrow><mo mathsize="0.800em">−</mo><msub><mi mathsize="0.800em">p</mi><mi mathsize="0.800em">x</mi></msub></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">x_{t+1}^{m}\leftarrow\begin{cases}\mathbb{E}_{m}[x_{t}^{m}-\eta_{t}\Delta_{t}^{m}],&amp;{\color[rgb]{0.75,0,0.25}\text{with probability }p_{x}}\\
x_{t}^{m}-\eta_{t}\Delta_{t}^{m},&amp;\text{with probability }1-p_{x}\end{cases}</annotation></semantics></math><span id="alg4.l16.4" class="ltx_text" style="font-size:80%;"> </span><span id="alg4.l16.5" class="ltx_text" style="font-size:80%;float:right;"><span id="alg4.l16.5.1" class="ltx_text" style="font-size:88%;--ltx-fg-color:#808080;">sync <math id="alg4.l16.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math></span>
   </span>
</div>
</div>
</figure>
<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">In order to facilitate the technical presentation, we model synchronization frequencies by assigning probabilities to each averaging event. For example, the parameters <math id="A4.p1.m1" class="ltx_Math" alttext="x_{t}^{m}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><annotation encoding="application/x-tex">x_{t}^{m}</annotation></semantics></math> are synchronized with the probability <math id="A4.p1.m2" class="ltx_Math" alttext="p_{x}=\frac{1}{K_{x}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>x</mi></msub><mo>=</mo><mfrac><mn>1</mn><msub><mi>K</mi><mi>x</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">p_{x}=\frac{1}{K_{x}}</annotation></semantics></math>, which is statistically equivalent to performing the averaging in every <math id="A4.p1.m3" class="ltx_Math" alttext="\frac{1}{p_{x}}=K_{x}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><msub><mi>p</mi><mi>x</mi></msub></mfrac><mo>=</mo><msub><mi>K</mi><mi>x</mi></msub></mrow><annotation encoding="application/x-tex">\frac{1}{p_{x}}=K_{x}</annotation></semantics></math> iteration. Similarly, momentum <math id="A4.p1.m4" class="ltx_Math" alttext="u_{t}^{j,m}" display="inline" intent=":literal"><semantics><msubsup><mi>u</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup><annotation encoding="application/x-tex">u_{t}^{j,m}</annotation></semantics></math> synchronization happens with probability <math id="A4.p1.m5" class="ltx_Math" alttext="p_{j}=\frac{1}{K_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>j</mi></msub><mo>=</mo><mfrac><mn>1</mn><msub><mi>K</mi><mi>j</mi></msub></mfrac></mrow><annotation encoding="application/x-tex">p_{j}=\frac{1}{K_{j}}</annotation></semantics></math>, which can differ from <math id="A4.p1.m6" class="ltx_Math" alttext="p_{x}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>x</mi></msub><annotation encoding="application/x-tex">p_{x}</annotation></semantics></math>. Note that QHM structure is included since we can choose <math id="A4.p1.m7" class="ltx_Math" alttext="\beta_{1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta_{1}=0</annotation></semantics></math> and get <math id="A4.p1.m8" class="ltx_Math" alttext="u_{t}^{1,m}=g_{t}^{m}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mrow><mn>1</mn><mo>,</mo><mi>m</mi></mrow></msubsup><mo>=</mo><msubsup><mi>g</mi><mi>t</mi><mi>m</mi></msubsup></mrow><annotation encoding="application/x-tex">u_{t}^{1,m}=g_{t}^{m}</annotation></semantics></math>.</p>
</div>
<div id="A4.p2" class="ltx_para ltx_noindent">
<p id="A4.p2.1" class="ltx_p"><span id="A4.p2.1.1" class="ltx_text ltx_underline">Auxiliary notation.</span> Let <math id="A4.p2.m1" class="ltx_Math" alttext="\mathbb{E}_{m}" display="inline" intent=":literal"><semantics><msub><mi>𝔼</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\mathbb{E}_{m}</annotation></semantics></math> and <math id="A4.p2.m2" class="ltx_Math" alttext="\mathbb{E}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝔼</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\mathbb{E}_{j}</annotation></semantics></math> be the averaging operators with weights <math id="A4.p2.m3" class="ltx_Math" alttext="\frac{1}{M}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mi>M</mi></mfrac><annotation encoding="application/x-tex">\frac{1}{M}</annotation></semantics></math> across <math id="A4.p2.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> workers and <math id="A4.p2.m5" class="ltx_Math" alttext="\omega_{j}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\omega_{j}</annotation></semantics></math> across <math id="A4.p2.m6" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> momenta.</p>
<table id="A4.EGx1" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A4.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex4.m1" class="ltx_Math" alttext="\displaystyle u_{t}^{j}" display="inline" intent=":literal"><semantics><msubsup><mi>u</mi><mi>t</mi><mi>j</mi></msubsup><annotation encoding="application/x-tex">\displaystyle u_{t}^{j}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex4.m2" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\mathrm{def}}}{{=}}" display="inline" intent=":literal"><semantics><mover><mo>=</mo><mi>def</mi></mover><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\mathrm{def}}}{{=}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex4.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{m}[u_{t}^{j,m}]=\beta_{j}u_{t-1}^{j}+(1-\beta_{j})g_{t},\text{where }g_{t}=\mathbb{E}_{m}[g_{t}^{m}]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>u</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>β</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>t</mi></msub></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mtext>where </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>g</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{m}[u_{t}^{j,m}]=\beta_{j}u_{t-1}^{j}+(1-\beta_{j})g_{t},\text{where }g_{t}=\mathbb{E}_{m}[g_{t}^{m}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex5.m1" class="ltx_Math" alttext="\displaystyle x_{t+1}^{j,m}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle x_{t+1}^{j,m}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex5.m2" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\mathrm{def}}}{{=}}" display="inline" intent=":literal"><semantics><mover><mo>=</mo><mi>def</mi></mover><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\mathrm{def}}}{{=}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex5.m3" class="ltx_Math" alttext="\displaystyle\begin{cases}\mathbb{E}_{m}[x_{t}^{j,m}-\eta u_{t}^{j,m}],&amp;\text{with probability }p_{x}\\
x_{t}^{j,m}-\eta u_{t}^{j,m},&amp;\text{with probability }1-p_{x}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝔼</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>with probability </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>x</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi>x</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>t</mi><mrow><mi>j</mi><mo>,</mo><mi>m</mi></mrow></msubsup></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>with probability </mtext><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>−</mo><msub><mi>p</mi><mi>x</mi></msub></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}\mathbb{E}_{m}[x_{t}^{j,m}-\eta u_{t}^{j,m}],&amp;\text{with probability }p_{x}\\
x_{t}^{j,m}-\eta u_{t}^{j,m},&amp;\text{with probability }1-p_{x}\end{cases}</annotation></semantics></math></td>
