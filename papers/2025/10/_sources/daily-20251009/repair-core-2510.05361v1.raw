><mrow><msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>z</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></munder></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f(z_{t})+\underbrace{\langle\nabla f(x_{t}),z_{t+1}-z_{t}\rangle}_{I}+\underbrace{\langle\nabla f(z_{t})-\nabla f(x_{t}),z_{t+1}-z_{t}\rangle}_{II}+\underbrace{\frac{L}{2}\|z_{t+1}-z_{t}\|^{2}}_{III}.</annotation></semantics></math></td>
