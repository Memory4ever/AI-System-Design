<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex80.m2" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{N}\omega_{j}(1-p_{j})(1-\beta_{j})\sum_{\tau=0}^{t-1}((1-p_{j})\beta_{j})^{t-\tau-1}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>τ</mi></msub><mo>−</mo><msubsup><mi>g</mi><mi>τ</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{N}\omega_{j}(1-p_{j})(1-\beta_{j})\sum_{\tau=0}^{t-1}((1-p_{j})\beta_{j})^{t-\tau-1}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}</annotation></semantics></math></td>
