<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex44.m2" class="ltx_Math" alttext="\displaystyle\iff" display="inline" intent=":literal"><semantics><mo stretchy="false">⇔</mo><annotation encoding="application/x-tex">\displaystyle\iff</annotation></semantics></math></td>
