<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex92.m3" class="ltx_Math" alttext="\displaystyle\frac{2}{M}\sum_{m=1}^{M}\mathbb{E}{\left\|g_{t}^{m}-\nabla f_{m}(x_{t}^{m})\right\|^{2}}-2\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}(g_{t}^{m}-\nabla f_{m}(x_{t}^{m}))\right\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>g</mi><mi>t</mi><mi>m</mi></msubsup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>g</mi><mi>t</mi><mi>m</mi></msubsup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2}{M}\sum_{m=1}^{M}\mathbb{E}{\left\|g_{t}^{m}-\nabla f_{m}(x_{t}^{m})\right\|^{2}}-2\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}(g_{t}^{m}-\nabla f_{m}(x_{t}^{m}))\right\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
