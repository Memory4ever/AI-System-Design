<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex31.m1" class="ltx_Math" alttext="\displaystyle+\;\frac{\eta^{2}L}{2K}\sigma^{2}+\frac{\eta^{2}L}{2}\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{t}^{m})\right\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\;\frac{\eta^{2}L}{2K}\sigma^{2}+\frac{\eta^{2}L}{2}\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{t}^{m})\right\|^{2}}</annotation></semantics></math></td>
