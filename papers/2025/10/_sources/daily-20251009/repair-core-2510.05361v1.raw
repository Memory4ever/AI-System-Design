<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex79.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}{\|u_{t}-u_{t}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}{\|u_{t}-u_{t}^{m}\|^{2}}</annotation></semantics></math></td>
