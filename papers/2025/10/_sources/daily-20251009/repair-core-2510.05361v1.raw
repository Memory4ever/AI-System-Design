<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex43.m1" class="ltx_Math" alttext="\displaystyle 12\eta^{2}L^{2}(B^{2}-1)\psi\leq\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle 12\eta^{2}L^{2}(B^{2}-1)\psi\leq\frac{1}{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.Ex43.m2" class="ltx_Math" alttext="\displaystyle\iff" display="inline" intent=":literal"><semantics><mo stretchy="false">⇔</mo><annotation encoding="application/x-tex">\displaystyle\iff</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="A4.Ex43.1.3.1" class="ltx_text ltx_markedasmath">to bound the first term</span></td>
