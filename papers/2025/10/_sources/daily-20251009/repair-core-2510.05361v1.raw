<td id="S5.T1.7.1.3.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb"><math id="S5.T1.m36" class="ltx_Math" alttext="+3.7\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>3.7</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+3.7\%</annotation></semantics></math></td></tr>
