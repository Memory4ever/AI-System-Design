<section id="A4" class="ltx_appendix">
<h3 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Convergence Analysis of <span id="A4.2" class="ltx_text ltx_font_typewriter">MT-DAO</span>-<span id="A4.3" class="ltx_text ltx_font_typewriter">SGDM</span></h3>

<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.5" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> <span id="alg4.6" class="ltx_text ltx_font_typewriter">MT-DAO</span>-<span id="alg4.7" class="ltx_text ltx_font_typewriter">SGDM</span>, probabilistic variant</figcaption>
