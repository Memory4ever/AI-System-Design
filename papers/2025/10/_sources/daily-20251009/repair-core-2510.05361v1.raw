<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex91.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\;\frac{2}{M}\sum_{m=1}^{M}\mathbb{E}{\left\|\nabla f_{m}(x_{t}^{m})-\frac{1}{M}\sum_{i=1}^{M}\nabla f_{i}(x_{t}^{i})\right\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.502em">+</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>M</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mi>𝔼</mi><msup><mrow><mo>‖</mo><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\;\frac{2}{M}\sum_{m=1}^{M}\mathbb{E}{\left\|\nabla f_{m}(x_{t}^{m})-\frac{1}{M}\sum_{i=1}^{M}\nabla f_{i}(x_{t}^{i})\right\|^{2}}</annotation></semantics></math></td>
