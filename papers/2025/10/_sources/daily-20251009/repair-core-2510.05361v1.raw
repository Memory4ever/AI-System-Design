<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex84.m2" class="ltx_Math" alttext="\displaystyle\eta^{2}q^{\prime}_{x}\sum_{\tau=1}^{t}q_{x}^{t-\tau}\frac{1}{M}\sum_{m=1}^{M}\sum_{\nu=0}^{\tau-1}\left(\sum_{j=1}^{N}\omega_{j}(1-p_{j})(1-\beta_{j})q_{j}^{\tau-\nu-1}\right)\mathbb{E}{\|g_{\nu}-g_{\nu}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>x</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>q</mi><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>ν</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>j</mi><mrow><mi>τ</mi><mo>−</mo><mi>ν</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>ν</mi></msub><mo>−</mo><msubsup><mi>g</mi><mi>ν</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}q^{\prime}_{x}\sum_{\tau=1}^{t}q_{x}^{t-\tau}\frac{1}{M}\sum_{m=1}^{M}\sum_{\nu=0}^{\tau-1}\left(\sum_{j=1}^{N}\omega_{j}(1-p_{j})(1-\beta_{j})q_{j}^{\tau-\nu-1}\right)\mathbb{E}{\|g_{\nu}-g_{\nu}^{m}\|^{2}}</annotation></semantics></math></td>
