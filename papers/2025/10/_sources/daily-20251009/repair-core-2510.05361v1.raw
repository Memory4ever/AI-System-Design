<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex39.m1" class="ltx_math_unparsed" alttext="\displaystyle+\;\frac{\eta L^{2}}{2}\left(12\eta^{2}(B^{2}-1)\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\|\nabla f(\theta^{t})\|^{2}+4\eta^{2}\psi(\sigma^{2}+3G^{2})\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.502em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mrow><mo>(</mo><mn>12</mn><msup><mi>η</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mn>4</mn><msup><mi>η</mi><mn>2</mn></msup><mi>ψ</mi><mrow><mo stretchy="false">(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn><msup><mi>G</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\;\frac{\eta L^{2}}{2}\left(12\eta^{2}(B^{2}-1)\psi\cdot\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}\|\nabla f(\theta^{t})\|^{2}+4\eta^{2}\psi(\sigma^{2}+3G^{2})\right)</annotation></semantics></math></td>
