<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E4.m2" class="ltx_Math" alttext="\displaystyle\eta^{2}q^{\prime}_{x}\sum_{\tau=1}^{t}q_{x}^{t-\tau}\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|u_{\tau}-u_{\tau}^{m}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>x</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><msubsup><mi>q</mi><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>u</mi><mi>τ</mi></msub><mo>−</mo><msubsup><mi>u</mi><mi>τ</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}q^{\prime}_{x}\sum_{\tau=1}^{t}q_{x}^{t-\tau}\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|u_{\tau}-u_{\tau}^{m}\|^{2}}</annotation></semantics></math></td>
