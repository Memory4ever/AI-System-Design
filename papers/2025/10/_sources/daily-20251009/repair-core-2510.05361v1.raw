<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex28.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}\underbrace{\langle\nabla f(x_{t}),z_{t+1}-z_{t}\rangle}_{I}+\mathbb{E}\underbrace{\langle\nabla f(z_{t})-\nabla f(x_{t}),z_{t+1}-z_{t}\rangle}_{II}+\mathbb{E}\underbrace{\frac{L}{2}\|z_{t+1}-z_{t}\|^{2}}_{III}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>z</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="true">⏟</mo></munder><mi>I</mi></munder></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>z</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></munder></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>z</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\underbrace{\langle\nabla f(x_{t}),z_{t+1}-z_{t}\rangle}_{I}+\mathbb{E}\underbrace{\langle\nabla f(z_{t})-\nabla f(x_{t}),z_{t+1}-z_{t}\rangle}_{II}+\mathbb{E}\underbrace{\frac{L}{2}\|z_{t+1}-z_{t}\|^{2}}_{III}</annotation></semantics></math></td>
