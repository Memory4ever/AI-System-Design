<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex40.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{\eta}{2}\left(1-12\eta^{2}L^{2}(B^{2}-1)\psi\right)\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mn>2</mn></mfrac></mstyle><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mn>12</mn><msup><mi>η</mi><mn>2</mn></msup><msup><mi>L</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>ψ</mi><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em">∥</mo><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta}{2}\left(1-12\eta^{2}L^{2}(B^{2}-1)\psi\right)\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}{\|\nabla f(x_{t})\|^{2}}</annotation></semantics></math></td>
