<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex33.m1" class="ltx_Math" alttext="\displaystyle+\;\frac{\eta\rho L^{2}}{2}\underbrace{\mathbb{E}{\|z_{t}-x_{t}\|^{2}}}_{\rm Lemma\;\ref{lem:z-x}}+\frac{\eta L^{2}}{2M}\sum_{m=1}^{M}\underbrace{\mathbb{E}{\left\|x_{t}-x_{t}^{m}\right\|^{2}}}_{\rm Lemma\;\ref{lem:x-xm}}+\frac{\eta^{2}L}{2M}\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>Lemma</mi><mo lspace="0.280em" rspace="0em">​</mo><mtext><a href="#Thmthm2" title="Lemma 2. ‣ D.1 Key Lemmas ‣ Appendix D Convergence Analysis of MT-DAO-SGDM ‣ Appendix ‣ MT-DAO: Multi-timescale Distributed Adaptive Optimizers with Local Updates" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow></munder></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><munder><munder accentunder="true"><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mi>Lemma</mi><mo lspace="0.280em" rspace="0em">​</mo><mtext><a href="#Thmthm3" title="Lemma 3. ‣ D.1 Key Lemmas ‣ Appendix D Convergence Analysis of MT-DAO-SGDM ‣ Appendix ‣ MT-DAO: Multi-timescale Distributed Adaptive Optimizers with Local Updates" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">3</span></a></mtext></mrow></munder></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\;\frac{\eta\rho L^{2}}{2}\underbrace{\mathbb{E}{\|z_{t}-x_{t}\|^{2}}}_{\rm Lemma\;\ref{lem:z-x}}+\frac{\eta L^{2}}{2M}\sum_{m=1}^{M}\underbrace{\mathbb{E}{\left\|x_{t}-x_{t}^{m}\right\|^{2}}}_{\rm Lemma\;\ref{lem:x-xm}}+\frac{\eta^{2}L}{2M}\sigma^{2}.</annotation></semantics></math></td>
