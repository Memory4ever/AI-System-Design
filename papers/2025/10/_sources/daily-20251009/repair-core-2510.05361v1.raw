<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex41.m1" class="ltx_math_unparsed" alttext="\displaystyle-\;\frac{\eta}{2}\left(1-\frac{1}{\rho}-\eta L-\eta^{2}\beta_{\omega}^{2}\rho L^{2}\right)\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{t}^{m})\right\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.502em">−</mo><mstyle displaystyle="true"><mfrac><mi>η</mi><mn>2</mn></mfrac></mstyle><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ρ</mi></mfrac></mstyle><mo>−</mo><mi>η</mi><mi>L</mi><mo>−</mo><msup><mi>η</mi><mn>2</mn></msup><msubsup><mi>β</mi><mi>ω</mi><mn>2</mn></msubsup><mi>ρ</mi><msup><mi>L</mi><mn>2</mn></msup><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>𝔼</mi><msup><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>m</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle-\;\frac{\eta}{2}\left(1-\frac{1}{\rho}-\eta L-\eta^{2}\beta_{\omega}^{2}\rho L^{2}\right)\frac{1}{T}\sum_{t=0}^{T-1}\mathbb{E}{\left\|\frac{1}{M}\sum_{m=1}^{M}\nabla f_{m}(x_{t}^{m})\right\|^{2}}</annotation></semantics></math></td>
