<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex93.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\;\frac{12L^{2}}{M}\sum_{m=1}^{M}\mathbb{E}\left\lVert x_{t}-x_{t}^{m}\right\rVert^{2}+6(B^{2}-1)\mathbb{E}\|\nabla f(x_{t})\|^{2}+6G^{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.502em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mi>M</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mi>𝔼</mi><msup><mrow><mo>‖</mo><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>m</mi></msubsup><mo>‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>6</mn><mrow><mo stretchy="false">(</mo><msup><mi>B</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>𝔼</mi><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mn>6</mn><msup><mi>G</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\;\frac{12L^{2}}{M}\sum_{m=1}^{M}\mathbb{E}\left\lVert x_{t}-x_{t}^{m}\right\rVert^{2}+6(B^{2}-1)\mathbb{E}\|\nabla f(x_{t})\|^{2}+6G^{2}</annotation></semantics></math></td>
