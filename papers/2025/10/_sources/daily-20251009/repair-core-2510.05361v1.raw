<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex97.m2" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\omega_{j}(1-\beta_{j})(1-p_{j})\sum_{t=1}^{T}\sum_{\tau=0}^{t-1}\frac{q_{x}^{t-\tau}-q_{j}^{t-\tau}}{q_{x}-q_{j}}\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>x</mi><mo>′</mo></msubsup></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msub><mi>ω</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>q</mi><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup><mo>−</mo><msubsup><mi>q</mi><mi>j</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msubsup></mrow><mrow><msub><mi>q</mi><mi>x</mi></msub><mo>−</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>g</mi><mi>τ</mi></msub><mo>−</mo><msubsup><mi>g</mi><mi>τ</mi><mi>m</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}q^{\prime}_{x}}{T}\sum_{j=1}^{N}\omega_{j}(1-\beta_{j})(1-p_{j})\sum_{t=1}^{T}\sum_{\tau=0}^{t-1}\frac{q_{x}^{t-\tau}-q_{j}^{t-\tau}}{q_{x}-q_{j}}\left[\frac{1}{M}\sum_{m=1}^{M}\mathbb{E}{\|g_{\tau}-g_{\tau}^{m}\|^{2}}\right]</annotation></semantics></math></td>
