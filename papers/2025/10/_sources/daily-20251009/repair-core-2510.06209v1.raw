<td id="S4.T2.5.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">0.7548</td></tr>
<tr id="S4.T2.5.3" class="ltx_tr">
<th id="S4.T2.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Gen</th>
<td id="S4.T2.5.3.2" class="ltx_td ltx_align_center">0.0300</td>
<td id="S4.T2.5.3.3" class="ltx_td ltx_align_center">0.2859</td>
<td id="S4.T2.5.3.4" class="ltx_td ltx_nopad_r ltx_align_center">0.8594</td></tr>
<tr id="S4.T2.5.4" class="ltx_tr">
<th id="S4.T2.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Gen w/o bbox</th>
<td id="S4.T2.5.4.2" class="ltx_td ltx_align_center ltx_border_t">0.0437</td>
<td id="S4.T2.5.4.3" class="ltx_td ltx_align_center ltx_border_t">0.3814</td>
<td id="S4.T2.5.4.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">1.1216</td></tr>
<tr id="S4.T2.5.5" class="ltx_tr">
<th id="S4.T2.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Gen w/o road map</th>
<td id="S4.T2.5.5.2" class="ltx_td ltx_align_center">0.0348</td>
