<td id="S4.T2.5.6.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">0.8593</td></tr>
<tr id="S4.T2.5.7" class="ltx_tr">
<th id="S4.T2.5.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Gen w/o time-of-day</th>
<td id="S4.T2.5.7.2" class="ltx_td ltx_align_center ltx_border_bb">0.0299</td>
