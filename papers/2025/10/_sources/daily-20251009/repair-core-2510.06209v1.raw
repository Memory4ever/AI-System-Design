</span></th>
<td id="S4.T1.5.2.2" class="ltx_td ltx_align_center ltx_border_t">45.54</td>
<td id="S4.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_t">0.8739</td>
<td id="S4.T1.5.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">68.46%</td></tr>
<tr id="S4.T1.5.3" class="ltx_tr">
<th id="S4.T1.5.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_bb">
