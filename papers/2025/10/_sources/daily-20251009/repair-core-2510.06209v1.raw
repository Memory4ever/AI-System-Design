<th id="S4.T7.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">ADE@1s</th>
<th id="S4.T7.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">ADE@3s</th>
<th id="S4.T7.5.1.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt">ADE@5s</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T7.5.2" class="ltx_tr">
<th id="S4.T7.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Train on real</th>
<td id="S4.T7.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T7.5.2.2.1" class="ltx_text ltx_font_bold">0.0275</span></td>
<td id="S4.T7.5.2.3" class="ltx_td ltx_align_center ltx_border_t">0.2470</td>
<td id="S4.T7.5.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">0.7372</td></tr>
<tr id="S4.T7.5.3" class="ltx_tr">
<th id="S4.T7.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">fine-tune on real</th>
<td id="S4.T7.5.3.2" class="ltx_td ltx_align_center">0.0284</td>
