<td id="S4.T5.5.4.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T5.5.4.3.1" class="ltx_text ltx_font_bold">0.2543</span></td>
<td id="S4.T5.5.4.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb"><span id="S4.T5.5.4.4.1" class="ltx_text ltx_font_bold">0.7333</span></td></tr>
