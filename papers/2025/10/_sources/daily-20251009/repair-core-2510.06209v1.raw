<td id="S4.T2.5.5.4" class="ltx_td ltx_nopad_r ltx_align_center">0.9111</td></tr>
<tr id="S4.T2.5.6" class="ltx_tr">
<th id="S4.T2.5.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Gen w/o weather</th>
<td id="S4.T2.5.6.2" class="ltx_td ltx_align_center ltx_border_t">0.0299</td>
