<td id="S3.T2.2.1.11.9" class="ltx_td ltx_align_center">49.67<math id="S3.T2.m72" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>3.20</td></tr>
