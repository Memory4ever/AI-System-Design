<td id="S3.T2.2.1.12.9" class="ltx_td ltx_align_center">47.67<math id="S3.T2.m80" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.03</td></tr>
