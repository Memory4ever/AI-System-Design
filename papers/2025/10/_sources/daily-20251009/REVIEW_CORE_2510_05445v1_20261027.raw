<td id="S3.T2.2.1.3.2" class="ltx_td ltx_align_center ltx_border_tt">51.23<math id="S3.T2.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.46</td>
<td id="S3.T2.2.1.3.3" class="ltx_td ltx_align_center ltx_border_tt">41.87<math id="S3.T2.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.91</td>
