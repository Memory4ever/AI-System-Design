<td id="S3.T2.2.1.14.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_tt">61.33<math id="S3.T2.m94" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.15</td>
<td id="S3.T2.2.1.14.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_tt">71.78<math id="S3.T2.m95" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.54</td>
<td id="S3.T2.2.1.14.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_tt">60.33<math id="S3.T2.m96" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.53</td></tr>
