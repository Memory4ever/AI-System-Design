<td id="S3.T2.2.1.13.6" class="ltx_td ltx_align_center">66.53<math id="S3.T2.m85" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.93</td>
<td id="S3.T2.2.1.13.7" class="ltx_td ltx_align_center">50.00<math id="S3.T2.m86" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.00</td>
<td id="S3.T2.2.1.13.8" class="ltx_td ltx_align_center"><span id="S3.T2.2.1.13.8.1" class="ltx_text ltx_underline">62.67<math id="S3.T2.m87" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>4.51</span></td>
<td id="S3.T2.2.1.13.9" class="ltx_td ltx_align_center"><span id="S3.T2.2.1.13.9.1" class="ltx_text ltx_underline">50.67<math id="S3.T2.m88" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>5.86</span></td></tr>
