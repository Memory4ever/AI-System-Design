<td id="S3.T2.2.1.12.6" class="ltx_td ltx_align_center"><span id="S3.T2.2.1.12.6.1" class="ltx_text ltx_underline">68.13<math id="S3.T2.m77" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.61</span></td>
<td id="S3.T2.2.1.12.7" class="ltx_td ltx_align_center"><span id="S3.T2.2.1.12.7.1" class="ltx_text ltx_underline">51.67<math id="S3.T2.m78" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.58</span></td>
