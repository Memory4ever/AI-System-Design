<td id="S3.T2.2.1.14.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_tt">92.95<math id="S3.T2.m89" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.35</td>
<td id="S3.T2.2.1.14.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_tt">87.00<math id="S3.T2.m90" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.73</td>
