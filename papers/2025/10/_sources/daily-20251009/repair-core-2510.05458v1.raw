</div>
<div id="lstnumberx101" class="ltx_listingline">&lt;<span id="lstnumberx101.1" class="ltx_text ltx_lst_identifier">tone</span>&gt;<span id="lstnumberx101.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.3" class="ltx_text ltx_lst_identifier">The</span><span id="lstnumberx101.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.5" class="ltx_text ltx_lst_identifier">explanation</span><span id="lstnumberx101.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.7" class="ltx_text ltx_lst_identifier">should</span><span id="lstnumberx101.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.9" class="ltx_text ltx_lst_identifier">be</span><span id="lstnumberx101.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.11" class="ltx_text ltx_lst_identifier">simple</span>,<span id="lstnumberx101.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.13" class="ltx_text ltx_lst_identifier">concise</span><span id="lstnumberx101.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.15" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx101.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.17" class="ltx_text ltx_lst_identifier">declarative</span>.<span id="lstnumberx101.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.19" class="ltx_text ltx_lst_identifier">It</span><span id="lstnumberx101.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.21" class="ltx_text ltx_lst_identifier">should</span><span id="lstnumberx101.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.23" class="ltx_text ltx_lst_identifier">be</span><span id="lstnumberx101.24" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.25" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx101.26" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.27" class="ltx_text ltx_lst_identifier">single</span><span id="lstnumberx101.28" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.29" class="ltx_text ltx_lst_identifier">sentence</span><span id="lstnumberx101.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.31" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx101.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.33" class="ltx_text ltx_lst_identifier">opposes</span><span id="lstnumberx101.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.35" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx101.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx101.37" class="ltx_text ltx_lst_identifier">inference</span>.<span id="lstnumberx101.38" class="ltx_text ltx_lst_space"> </span>&lt;/<span id="lstnumberx101.39" class="ltx_text ltx_lst_identifier">tone</span>&gt;
