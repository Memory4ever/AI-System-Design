<td id="S4.T2.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">-0.137</td>
<td id="S4.T2.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.294</td></tr>
<tr id="S4.T2.2.1.3" class="ltx_tr">
<th id="S4.T2.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">GPT-4o</th>
<td id="S4.T2.2.1.3.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.2.1.3.2.1" class="ltx_text ltx_font_bold">0.153</span></td>
<td id="S4.T2.2.1.3.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">0.341</td></tr>
<tr id="S4.T2.2.1.4" class="ltx_tr">
<th id="S4.T2.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">GPT-4o-mini</th>
<td id="S4.T2.2.1.4.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">0.095</td>
<td id="S4.T2.2.1.4.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">0.186</td></tr>
<tr id="S4.T2.2.1.5" class="ltx_tr">
<th id="S4.T2.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">Llama-3.1-8B-Instruct</th>
<td id="S4.T2.2.1.5.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">0.010</td>
<td id="S4.T2.2.1.5.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">0.359</td></tr>
