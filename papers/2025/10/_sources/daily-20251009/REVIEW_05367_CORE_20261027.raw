<tr id="S2.T2.2.1.25" class="ltx_tr">
<td id="S2.T2.2.1.25.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">- chunk</td>
<td id="S2.T2.2.1.25.2" class="ltx_td ltx_align_center ltx_border_bb">3.55</td>
