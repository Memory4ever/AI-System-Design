</div>
<div id="alg1.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">26:</span>
              
              
              <math id="alg1.l26.m1" class="ltx_Math" alttext="\mathrm{all\_metrics}\leftarrow\texttt{hash\_map}()" display="inline" intent=":literal"><semantics><mrow><mrow><mi>all</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>metrics</mi></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">hash_map</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{all\_metrics}\leftarrow\texttt{hash\_map}()</annotation></semantics></math>

</div>
