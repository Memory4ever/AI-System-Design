</div>
<div id="alg1.l29" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">29:</span>
              
              
              <math id="alg1.l29.m1" class="ltx_Math" alttext="\mathrm{best\_desc}\leftarrow\argmax_{d}\mathrm{all\_metrics}[d].\mathrm{cv\_metric}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>best</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>desc</mi></mrow><mo stretchy="false">←</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>d</mi></msub><mo>⁡</mo><mi>all</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>metrics</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>cv</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>metric</mi></mrow></mrow><annotation encoding="application/x-tex">\mathrm{best\_desc}\leftarrow\argmax_{d}\mathrm{all\_metrics}[d].\mathrm{cv\_metric}</annotation></semantics></math>

</div>
<div id="alg1.l30" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">30:</span>
              
              
              <span id="alg1.l30.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l30.m1" class="ltx_Math" alttext="\mathrm{all\_metrics}[\mathrm{best\_desc}].\mathrm{test\_metric}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>all</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>metrics</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>best</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>desc</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>test</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>metric</mi></mrow></mrow><annotation encoding="application/x-tex">\mathrm{all\_metrics}[\mathrm{best\_desc}].\mathrm{test\_metric}</annotation></semantics></math>

</div>
</div>
