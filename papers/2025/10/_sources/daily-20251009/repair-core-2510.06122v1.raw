              <span id="alg1.l27.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l27.m1" class="ltx_Math" alttext="d\in\mathrm{all\_descriptors}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><mrow><mi>all</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>descriptors</mi></mrow></mrow><annotation encoding="application/x-tex">d\in\mathrm{all\_descriptors}</annotation></semantics></math> <span id="alg1.l27.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l28" class="ltx_listingline">
