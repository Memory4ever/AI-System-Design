<figure id="A3.F4.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06048v1/figures/160m-kl.png" id="A3.F4.sf4.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:127/96;" width="127" height="96" alt="Refer to caption">
