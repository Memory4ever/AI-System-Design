<figure id="A6.F7.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06048v1/figures/val_loss_r4.png" id="A6.F7.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:121/95;" width="121" height="95" alt="Refer to caption">
