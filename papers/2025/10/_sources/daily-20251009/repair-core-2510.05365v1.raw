<th id="S4.T5.5.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T5.5.1.2.1" class="ltx_text ltx_font_bold">Model</span></th>
<th id="S4.T5.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.5.1.3.1" class="ltx_text ltx_font_bold">Mutation</span></th>
<th id="S4.T5.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.5.1.4.1" class="ltx_text ltx_font_bold">%BRT (Closed)</span></th>
<th id="S4.T5.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.5.1.5.1" class="ltx_text ltx_font_bold">%BRT (Open)</span></th></tr>
