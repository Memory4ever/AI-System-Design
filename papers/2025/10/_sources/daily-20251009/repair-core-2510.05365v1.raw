<tr id="S4.T5.5.2" class="ltx_tr">
<th id="S4.T5.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="6"><span id="S4.T5.5.2.1.1" class="ltx_text">Defects4J</span></th>
<th id="S4.T5.5.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="3"><span id="S4.T5.5.2.2.1" class="ltx_text">StarCoder</span></th>
<td id="S4.T5.5.2.3" class="ltx_td ltx_align_center ltx_border_t">Meaningful Mask</td>
<td id="S4.T5.5.2.4" class="ltx_td ltx_align_center ltx_border_t">10.7%</td>
<td id="S4.T5.5.2.5" class="ltx_td ltx_align_center ltx_border_t">34.9%</td></tr>
<tr id="S4.T5.5.3" class="ltx_tr">
<td id="S4.T5.5.3.1" class="ltx_td ltx_align_center">Rephrased</td>
<td id="S4.T5.5.3.2" class="ltx_td ltx_align_center">22.5%</td>
<td id="S4.T5.5.3.3" class="ltx_td ltx_align_center">65.3%</td></tr>
