<td id="S4.T2.10.1.10" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S4.T2.10.1.10.1" class="ltx_text" style="font-size:90%;"><math id="S4.T2.m5" class="ltx_Math" alttext="\textrm{\bf FID}_{\textrm{\bf SDoF}}\downarrow" display="inline" intent=":literal"><semantics><mrow><msub><mtext class="ltx_mathvariant_bold">FID</mtext><mtext class="ltx_mathvariant_bold">SDoF</mtext></msub><mo stretchy="false">↓</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\textrm{\bf FID}_{\textrm{\bf SDoF}}\downarrow</annotation></semantics></math></span></td></tr>
