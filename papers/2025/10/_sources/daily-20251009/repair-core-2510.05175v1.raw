            <math id="alg2.l49.m1" class="ltx_Math" alttext="O_{13}=\hbox{\pagecolor{violet!15}$m_{4}+m_{9}+m_{14}+m_{18}+m_{22}+h_{7}$}" display="inline" intent=":literal"><semantics><mrow><msub><mi>O</mi><mn>13</mn></msub><mo>=</mo><mrow><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">4</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">9</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">14</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">18</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">22</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">h</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">7</mn></msub></mrow></mrow><annotation encoding="application/x-tex">O_{13}=\hbox{\pagecolor{violet!15}$m_{4}+m_{9}+m_{14}+m_{18}+m_{22}+h_{7}$}</annotation></semantics></math>

</div>
<div id="alg2.l50" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l50.1" class="ltx_text" style="font-size:80%;">50:</span></span>
              
              
            <math id="alg2.l50.m1" class="ltx_Math" alttext="O_{14}=\hbox{\pagecolor{violet!15}$-m_{4}-m_{8}-m_{9}-m_{18}+m_{24}+h_{8}$}" display="inline" intent=":literal"><semantics><mrow><msub><mi>O</mi><mn>14</mn></msub><mo>=</mo><mrow><mrow><mrow><mo>−</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">4</mn></msub></mrow><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">−</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">8</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">−</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">9</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">−</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">18</mn></msub></mrow><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">24</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">h</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">8</mn></msub></mrow></mrow><annotation encoding="application/x-tex">O_{14}=\hbox{\pagecolor{violet!15}$-m_{4}-m_{8}-m_{9}-m_{18}+m_{24}+h_{8}$}</annotation></semantics></math>

</div>
<div id="alg2.l51" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l51.1" class="ltx_text" style="font-size:80%;">51:</span></span>
              
              
            <math id="alg2.l51.m1" class="ltx_Math" alttext="O_{15}=\hbox{\pagecolor{violet!15}$m_{2}+m_{5}-m_{8}+m_{13}+m_{14}-m_{19}+h_{9}$}" display="inline" intent=":literal"><semantics><mrow><msub><mi>O</mi><mn>15</mn></msub><mo>=</mo><mrow><mrow><mrow><mrow><mrow><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">2</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">5</mn></msub></mrow><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">−</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">8</mn></msub></mrow><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">13</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">14</mn></msub></mrow><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">−</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">19</mn></msub></mrow><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">h</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">9</mn></msub></mrow></mrow><annotation encoding="application/x-tex">O_{15}=\hbox{\pagecolor{violet!15}$m_{2}+m_{5}-m_{8}+m_{13}+m_{14}-m_{19}+h_{9}$}</annotation></semantics></math>

</div>
<div id="alg2.l52" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l52.1" class="ltx_text" style="font-size:80%;">52:</span></span>
              
              
            <math id="alg2.l52.m1" class="ltx_Math" alttext="O_{16}=\hbox{\pagecolor{violet!15}$m_{3}+m_{8}+m_{15}-m_{16}+m_{22}+m_{23}+h_{10}$}" display="inline" intent=":literal"><semantics><mrow><msub><mi>O</mi><mn>16</mn></msub><mo>=</mo><mrow><mrow><mrow><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">3</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">8</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">15</mn></msub></mrow><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">−</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">16</mn></msub></mrow><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">22</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">m</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">23</mn></msub><mo style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">+</mo><msub><mi style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">h</mi><mn style="--ltx-bg-color:#ECD9EC;" mathbackground="#ECD9EC">10</mn></msub></mrow></mrow><annotation encoding="application/x-tex">O_{16}=\hbox{\pagecolor{violet!15}$m_{3}+m_{8}+m_{15}-m_{16}+m_{22}+m_{23}+h_{10}$}</annotation></semantics></math>

</div>
