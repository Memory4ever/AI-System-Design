<td id="S4.T2.3.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">26.3</td>
<td id="S4.T2.3.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">8.2</td>
<td id="S4.T2.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">16.1</td>
<td id="S4.T2.3.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">15.5</td></tr>
<tr id="S4.T2.3.1.4" class="ltx_tr">
<th id="S4.T2.3.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:3.0pt;padding-right:3.0pt;">Extrinsics + KPE</th>
<td id="S4.T2.3.1.4.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">17.9</td>
<td id="S4.T2.3.1.4.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">7.6</td>
