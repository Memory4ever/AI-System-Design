<td id="S4.F7.3.1.1" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.F7.3.1.1.1" class="ltx_text" style="font-size:80%;">In-Domain Lab Datasets</span></td>
<td id="S4.F7.3.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.F7.3.1.2.1" class="ltx_text ltx_font_italic" style="font-size:80%;">Zero-shot<span id="S4.F7.3.1.2.1.1" class="ltx_text ltx_font_upright"> EgoExo4D</span></span></td></tr>
