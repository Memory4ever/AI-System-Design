<td id="A1.T12.6.2.2" class="ltx_td ltx_align_left"><span id="A1.T12.6.2.2.1" class="ltx_text" style="font-size:90%;">(mean <math id="A1.T12.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> stderr)</span></td></tr>
<tr id="A1.T12.6.3" class="ltx_tr">
<th id="A1.T12.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Multi-task SAC* <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib17" title="" class="ltx_ref">Yu et al., 2019</a>)</cite></th>
<td id="A1.T12.6.3.2" class="ltx_td ltx_align_left ltx_border_t"><math id="A1.T12.m2" class="ltx_Math" alttext="0.25\pm 0.090" display="inline" intent=":literal"><semantics><mrow><mn>0.25</mn><mo>±</mo><mn>0.090</mn></mrow><annotation encoding="application/x-tex">0.25\pm 0.090</annotation></semantics></math></td></tr>
<tr id="A1.T12.6.4" class="ltx_tr">
<th id="A1.T12.6.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Soft Modularization <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">Yang et al., 2020</a>)</cite></th>
<td id="A1.T12.6.4.2" class="ltx_td ltx_align_left"><math id="A1.T12.m3" class="ltx_Math" alttext="0.44\pm 0.082" display="inline" intent=":literal"><semantics><mrow><mn>0.44</mn><mo>±</mo><mn>0.082</mn></mrow><annotation encoding="application/x-tex">0.44\pm 0.082</annotation></semantics></math></td></tr>
