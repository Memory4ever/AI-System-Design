<h1 class="ltx_title ltx_title_document">Sci-Phi: A Large Language Model Spatial Audio Descriptor</h1>
<div class="ltx_authors">
<span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Xilin Jiang<math id="m1" class="ltx_Math" alttext="{}^{\textbf{1}}" display="inline" intent=":literal"><semantics><msup><mrow></mrow><mtext class="ltx_mathvariant_bold">1</mtext></msup><annotation encoding="application/x-tex">{}^{\textbf{1}}</annotation></semantics></math>
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Student Member
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">IEEE
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Hannes Gamper<math id="m2" class="ltx_Math" alttext="{}^{\textbf{2}}" display="inline" intent=":literal"><semantics><msup><mrow></mrow><mtext class="ltx_mathvariant_bold">2</mtext></msup><annotation encoding="application/x-tex">{}^{\textbf{2}}</annotation></semantics></math>
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Member
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">IEEE
<br class="ltx_break">and Sebastian Braun<math id="m3" class="ltx_Math" alttext="{}^{\textbf{2}}" display="inline" intent=":literal"><semantics><msup><mrow></mrow><mtext class="ltx_mathvariant_bold">2</mtext></msup><annotation encoding="application/x-tex">{}^{\textbf{2}}</annotation></semantics></math>
</span></span>
