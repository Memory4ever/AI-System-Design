<td id="A4.T7.pic1.1.1.3.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><math id="A4.T7.pic1.m4" class="ltx_Math" alttext="18.2" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">18.2</mn><annotation encoding="application/x-tex">18.2</annotation></semantics></math></td></tr>
