<td id="A4.T7.pic1.1.1.4.2" class="ltx_td ltx_align_center"><math id="A4.T7.pic1.m5" class="ltx_Math" alttext="62.0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">62.0</mn><annotation encoding="application/x-tex">62.0</annotation></semantics></math></td>
