<tr id="S3.T1.5.1.6" class="ltx_tr">
<th id="S3.T1.5.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" colspan="5"><span id="S3.T1.5.1.6.1.1" class="ltx_text ltx_font_bold">Qwen3-8B</span></th></tr>
<tr id="S3.T1.5.1.7" class="ltx_tr">
