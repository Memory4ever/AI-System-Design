<th id="S3.T1.5.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt"><span id="S3.T1.5.1.1.2.1" class="ltx_text ltx_font_bold">Feature</span></th>
<td id="S3.T1.5.1.1.3" class="ltx_td ltx_align_right ltx_border_tt"><span id="S3.T1.5.1.1.3.1" class="ltx_text ltx_font_bold">Pearson <math id="S3.T1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> [95% CI]</span></td>
<td id="S3.T1.5.1.1.4" class="ltx_td ltx_align_right ltx_border_tt"><span id="S3.T1.5.1.1.4.1" class="ltx_text ltx_font_bold">Spearman <math id="S3.T1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> [95% CI]</span></td>
<td id="S3.T1.5.1.1.5" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_tt"><span id="S3.T1.5.1.1.5.1" class="ltx_text ltx_font_bold">Kendall <math id="S3.T1.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> [95% CI]</span></td></tr>
