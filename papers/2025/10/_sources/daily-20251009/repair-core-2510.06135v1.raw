<td id="S4.T2.2.1.21.3" class="ltx_td ltx_align_center"><span id="S4.T2.2.1.21.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F0F0F0;">49.0<span id="S4.T2.2.1.21.3.1.1" class="ltx_text ltx_font_medium"> <span id="S4.T2.2.1.21.3.1.1.1" class="ltx_text" style="--ltx-fg-color:#008000;">(+22.0)</span></span></span></td>
