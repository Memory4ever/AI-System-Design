<tr id="S3.T1.2.1.4" class="ltx_tr">
<th id="S3.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">K2</th>
<td id="S3.T1.2.1.4.2" class="ltx_td ltx_align_center">27.8</td>
<td id="S3.T1.2.1.4.3" class="ltx_td ltx_align_center">11.2</td>
<td id="S3.T1.2.1.4.4" class="ltx_td ltx_align_center">38.2</td>
