<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex6.m1" class="ltx_Math" alttext="x_{t}\leftarrow tx_{1}+\left(\left(1-t\right)+t\sigma_{\min}\right)x_{0}" display="block" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>min</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{t}\leftarrow tx_{1}+\left(\left(1-t\right)+t\sigma_{\min}\right)x_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
