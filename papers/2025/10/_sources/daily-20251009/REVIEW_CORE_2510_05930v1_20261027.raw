            <span id="alg1.l14.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l14.m1" class="ltx_Math" alttext="\nabla_{\theta}\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\mathcal{L}(\theta)</annotation></semantics></math>

</div>
</div>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="alg2" class="ltx_float ltx_figure_panel ltx_float_algorithm ltx_minipage ltx_align_center ltx_align_top ltx_framed ltx_framed_top" style="width:190.8pt;">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> CDC Flow Matching</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            <span id="alg2.l1.2" class="ltx_text ltx_font_bold">Input:</span> Samples <math id="alg2.l1.m1" class="ltx_Math" alttext="\mathcal{D}=\{x^{(i)}\}^{N}_{i=1}\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo>⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{D}=\{x^{(i)}\}^{N}_{i=1}\subset\mathbb{R}^{d}</annotation></semantics></math> from <math id="alg2.l1.m2" class="ltx_Math" alttext="\nu(x)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(x)</annotation></semantics></math> together with their local covariance square-root <math id="alg2.l1.m3" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x^{(i)})^{0.5}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mn>0.5</mn></msup></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x^{(i)})^{0.5}</annotation></semantics></math>; parameterized vector field <math id="alg2.l1.m4" class="ltx_Math" alttext="v^{\theta}(x,t)" display="inline" intent=":literal"><semantics><mrow><msup><mi>v</mi><mi>θ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">v^{\theta}(x,t)</annotation></semantics></math>.

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            <span id="alg2.l2.2" class="ltx_text ltx_font_bold">Output:</span> Gradient <math id="alg2.l2.m1" class="ltx_Math" alttext="\nabla_{\theta}\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\mathcal{L}(\theta)</annotation></semantics></math> for updating parameters <math id="alg2.l2.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
            Sample <math id="alg2.l3.m1" class="ltx_Math" alttext="x_{1}\leftarrow x^{(i)}\sim\nu(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">←</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>∼</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{1}\leftarrow x^{(i)}\sim\nu(x)</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
            Sample <math id="alg2.l4.m1" class="ltx_Math" alttext="t\sim\text{Uniform}[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∼</mo><mrow><mtext>Uniform</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\sim\text{Uniform}[0,1]</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
