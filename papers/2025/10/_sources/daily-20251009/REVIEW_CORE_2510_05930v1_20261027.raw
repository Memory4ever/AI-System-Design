<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex7.m1" class="ltx_Math" alttext="v_{t}(x_{t}\mid x_{1})\leftarrow x_{1}-\left(1-\sigma_{\min}\right)x_{0}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>σ</mi><mi>min</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{t}(x_{t}\mid x_{1})\leftarrow x_{1}-\left(1-\sigma_{\min}\right)x_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg1.l11" class="ltx_listingline">
