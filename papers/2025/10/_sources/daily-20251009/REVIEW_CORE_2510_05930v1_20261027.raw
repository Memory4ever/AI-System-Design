            Sample <math id="alg2.l5.m1" class="ltx_Math" alttext="x_{0}\sim\mathcal{N}\left(0,\mathbf{I}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mi>𝐈</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{0}\sim\mathcal{N}\left(0,\mathbf{I}\right)</annotation></semantics></math>

</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
            Define

<table id="A4.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex9.m1" class="ltx_Math" alttext="x_{t}\leftarrow tx_{1}+\left(\left(1-t\right)\mathbf{I}+t\widehat{\mathbf{\Gamma}}(x_{1})^{0.5}\right)x_{0}" display="block" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mn>0.5</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{t}\leftarrow tx_{1}+\left(\left(1-t\right)\mathbf{I}+t\widehat{\mathbf{\Gamma}}(x_{1})^{0.5}\right)x_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
            Define the target conditional vector field

<table id="A4.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex10.m1" class="ltx_Math" alttext="v_{t}(x_{t}\mid x_{1})\leftarrow x_{1}-\left(\mathbf{I}-\widehat{\mathbf{\Gamma}}(x_{1})^{0.5}\right)x_{0}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mn>0.5</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{t}(x_{t}\mid x_{1})\leftarrow x_{1}-\left(\mathbf{I}-\widehat{\mathbf{\Gamma}}(x_{1})^{0.5}\right)x_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
            Compute the loss

<table id="A4.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex11.m1" class="ltx_Math" alttext="\mathcal{L}(\theta)=\bigl\|v^{\theta}(x_{t},t)-v_{t}(x_{t}\mid x_{1})\bigr\|^{2}" display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msup><mi>v</mi><mi>θ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>v</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)=\bigl\|v^{\theta}(x_{t},t)-v_{t}(x_{t}\mid x_{1})\bigr\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
            Compute the gradient <math id="alg2.l9.m1" class="ltx_Math" alttext="\nabla_{\theta}\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\mathcal{L}(\theta)</annotation></semantics></math>

</div>
<div id="alg2.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
            <span id="alg2.l10.2" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l10.m1" class="ltx_Math" alttext="\nabla_{\theta}\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\mathcal{L}(\theta)</annotation></semantics></math>

</div>
</div>
</figure></div></div>
</figure>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Optimal estimation of the carré du champ matrix</h2>

<div id="A5.p1" class="ltx_para ltx_noindent">
<p id="A5.p1.1" class="ltx_p">In Section <a href="#S3.SS2" title="3.2 Estimating the carré du champ ‣ 3 Regularised Flow matching on generalised data manifolds ‣ Carré du champ flow matching: better quality-generalisation tradeoff in generative models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, we estimate the local geometry at a sample <math id="A5.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> using the carré du champ matrix <math id="A5.p1.m2" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x)</annotation></semantics></math>, which we define as the mean-centred covariance of the sample’s neighbours.
We now prove that this choice is optimal in the sense that it is the best local Gaussian approximation to the data.
Specifically, the Gaussian that maximises the expected log-likelihood of the kernel <math id="A5.p1.m3" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math> is the one whose mean and covariance match the empirical mean and covariance.</p>
</div>
<div id="Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 2</span></span><span id="Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem2.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem2.p1.1" class="ltx_p"><span id="Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem2.p1.m1" class="ltx_Math" alttext="P_{xy}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><annotation encoding="application/x-tex">P_{xy}</annotation></semantics></math> be a transition kernel on <math id="Thmtheorem2.p1.m2" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math>. Let <math id="Thmtheorem2.p1.m3" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math> denote the probability measure supported on the <math id="Thmtheorem2.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> nearest neighbours of <math id="Thmtheorem2.p1.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> obtained by restricting and renormalising <math id="Thmtheorem2.p1.m6" class="ltx_Math" alttext="P_{xy}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><annotation encoding="application/x-tex">P_{xy}</annotation></semantics></math> (<a href="#S3.E11" title="In 3.2 Estimating the carré du champ ‣ 3 Regularised Flow matching on generalised data manifolds ‣ Carré du champ flow matching: better quality-generalisation tradeoff in generative models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>).
Assume <math id="Thmtheorem2.p1.m7" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math> has finite second moments.
Then the unique maximiser over <math id="Thmtheorem2.p1.m8" class="ltx_Math" alttext="m\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">m\in\mathbb{R}^{d}</annotation></semantics></math> and <math id="Thmtheorem2.p1.m9" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> over the space of positive definite matrices of the expected log-likelihood of a sample <math id="Thmtheorem2.p1.m10" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> from a Gaussian density <math id="Thmtheorem2.p1.m11" class="ltx_Math" alttext="\mathcal{N}(m,\mathbf{\Sigma})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(m,\mathbf{\Sigma})</annotation></semantics></math></span></p>
<table id="A5.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex12.m1" class="ltx_Math" alttext="(m,\mathbf{\Sigma})\;\longmapsto\;\mathbb{E}_{Y\sim P_{x}}\!\left[\log\mathcal{N}(Y;m,\Sigma)\right]" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>𝚺</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo rspace="0.558em" stretchy="false">⟼</mo><mrow><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(m,\mathbf{\Sigma})\;\longmapsto\;\mathbb{E}_{Y\sim P_{x}}\!\left[\log\mathcal{N}(Y;m,\Sigma)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p1.2" class="ltx_p"><span id="Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">is given by matching the first two moments of <math id="Thmtheorem2.p1.m12" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math>:</span></p>
<table id="A5.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex13.m1" class="ltx_Math" alttext="m^{*}(x)=\mathbb{E}_{Y\sim P_{x}}[Y],\qquad\mathbf{\Sigma}^{*}(x):=\widehat{\mathbf{\Gamma}}(x)=\mathbb{E}_{P_{x}}\!\left[(Y-m^{*})(Y-m^{*})^{\top}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>m</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>Y</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msup><mi>𝚺</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>P</mi><mi>x</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><msup><mi>m</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><msup><mi>m</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">m^{*}(x)=\mathbb{E}_{Y\sim P_{x}}[Y],\qquad\mathbf{\Sigma}^{*}(x):=\widehat{\mathbf{\Gamma}}(x)=\mathbb{E}_{P_{x}}\!\left[(Y-m^{*})(Y-m^{*})^{\top}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p1.3" class="ltx_p"><span id="Thmtheorem2.p1.3.1" class="ltx_text ltx_font_italic">Equivalently, <math id="Thmtheorem2.p1.m13" class="ltx_Math" alttext="\mathcal{N}(m^{*},\mathbf{\Sigma}^{*})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>m</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>𝚺</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(m^{*},\mathbf{\Sigma}^{*})</annotation></semantics></math> minimises <math id="Thmtheorem2.p1.m14" class="ltx_math_unparsed" alttext="\mathrm{KL}(P_{x}\,\|\,\mathcal{N}(m,\mathbf{\Sigma}))" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>x</mi></msub><mo lspace="0em" rspace="0.337em">∥</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{KL}(P_{x}\,\|\,\mathcal{N}(m,\mathbf{\Sigma}))</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p2" class="ltx_para ltx_noindent">
<p id="A5.p2.1" class="ltx_p"><span id="A5.p2.1.1" class="ltx_text">For <math id="A5.p2.m1" class="ltx_Math" alttext="\Sigma\succ 0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Sigma\succ 0</annotation></semantics></math>, the log-likelihood of a sample <math id="A5.p2.m2" class="ltx_Math" alttext="Y\\
N(m,\mathbf{\Sigma})" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y\\
N(m,\mathbf{\Sigma})</annotation></semantics></math> is</span></p>
<table id="A5.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex14.m1" class="ltx_Math" alttext="\log\mathcal{N}(Y)=-\frac{d}{2}\log(2\pi)-\frac{1}{2}\log\det\mathbf{\Sigma}-\frac{1}{2}(Y-m)^{\top}\mathbf{\Sigma}^{-1}(Y-m)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mfrac><mi>d</mi><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo movablelimits="false" rspace="0.167em">det</mo><mi>𝚺</mi></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log\mathcal{N}(Y)=-\frac{d}{2}\log(2\pi)-\frac{1}{2}\log\det\mathbf{\Sigma}-\frac{1}{2}(Y-m)^{\top}\mathbf{\Sigma}^{-1}(Y-m).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.2" class="ltx_p"><span id="A5.p2.2.1" class="ltx_text">Taking the expectation with respect to <math id="A5.p2.m3" class="ltx_Math" alttext="Y\sim P_{x}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow><annotation encoding="application/x-tex">Y\sim P_{x}</annotation></semantics></math> gives</span></p>
<table id="A5.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex15.m1" class="ltx_Math" alttext="\mathbb{E}_{Y\sim P_{x}}\left[\log\mathcal{N}(Y;m,\mathbf{\Sigma})\right]=-\frac{d}{2}\log(2\pi)-\frac{1}{2}\log\det\mathbf{\Sigma}-\frac{1}{2}\mathbb{E}_{Y\sim P_{x}}\left[(Y-m)^{\top}\mathbf{\Sigma}^{-1}(Y-m)\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mfrac><mi>d</mi><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo movablelimits="false" rspace="0.167em">det</mo><mi>𝚺</mi></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{Y\sim P_{x}}\left[\log\mathcal{N}(Y;m,\mathbf{\Sigma})\right]=-\frac{d}{2}\log(2\pi)-\frac{1}{2}\log\det\mathbf{\Sigma}-\frac{1}{2}\mathbb{E}_{Y\sim P_{x}}\left[(Y-m)^{\top}\mathbf{\Sigma}^{-1}(Y-m)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.3" class="ltx_p"><span id="A5.p2.3.1" class="ltx_text">We can differentiate with respect to <math id="A5.p2.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> to get</span></p>
<table id="A5.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex16.m1" class="ltx_Math" alttext="\frac{\partial}{\partial m}\mathbb{E}_{Y\sim P_{x}}\left[\log\mathcal{N}(Y;m,\mathbf{\Sigma})\right]=\mathbf{\Sigma}^{-1}(\mathbb{E}_{Y\sim P_{x}}[Y]-m)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>m</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>Y</mi><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\partial}{\partial m}\mathbb{E}_{Y\sim P_{x}}\left[\log\mathcal{N}(Y;m,\mathbf{\Sigma})\right]=\mathbf{\Sigma}^{-1}(\mathbb{E}_{Y\sim P_{x}}[Y]-m),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.4" class="ltx_p"><span id="A5.p2.4.1" class="ltx_text">which is zero at the maximum <math id="A5.p2.m5" class="ltx_Math" alttext="m^{*}(x)=\mathbb{E}_{Y\sim P_{x}}[Y]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>m</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>Y</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m^{*}(x)=\mathbb{E}_{Y\sim P_{x}}[Y]</annotation></semantics></math>.
To find the optimal <math id="A5.p2.m6" class="ltx_Math" alttext="\mathbf{\Sigma}" display="inline" intent=":literal"><semantics><mi>𝚺</mi><annotation encoding="application/x-tex">\mathbf{\Sigma}</annotation></semantics></math>, let <math id="A5.p2.m7" class="ltx_Math" alttext="S_{x}=\mathbb{E}[(Y-m^{*})(Y-m^{*})^{\top}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>x</mi></msub><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><msup><mi>m</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><msup><mi>m</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{x}=\mathbb{E}[(Y-m^{*})(Y-m^{*})^{\top}]</annotation></semantics></math>. We can rewrite the expectation term as</span></p>
<table id="A5.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex17.m1" class="ltx_Math" alttext="\mathbb{E}[\log\mathcal{N}(Y;m^{*},\mathbf{\Sigma})]=\tfrac{1}{2}\log\det\mathbf{\Sigma}^{-1}-\tfrac{1}{2}\mathrm{tr}(\mathbf{\Sigma}^{-1}S_{x})+\text{const}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><msup><mi>m</mi><mo>∗</mo></msup><mo>,</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo movablelimits="false" rspace="0.167em">det</mo><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>tr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mtext>const</mtext></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\log\mathcal{N}(Y;m^{*},\mathbf{\Sigma})]=\tfrac{1}{2}\log\det\mathbf{\Sigma}^{-1}-\tfrac{1}{2}\mathrm{tr}(\mathbf{\Sigma}^{-1}S_{x})+\text{const},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.5" class="ltx_p"><span id="A5.p2.5.1" class="ltx_text">which is strictly concave in <math id="A5.p2.m8" class="ltx_Math" alttext="\mathbf{\Sigma}^{-1}\succ 0" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>≻</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbf{\Sigma}^{-1}\succ 0</annotation></semantics></math>.
Differentiating with respect to <math id="A5.p2.m9" class="ltx_Math" alttext="\mathbf{\Sigma}^{-1}" display="inline" intent=":literal"><semantics><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\mathbf{\Sigma}^{-1}</annotation></semantics></math> we obtain</span></p>
<table id="A5.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex18.m1" class="ltx_Math" alttext="\frac{\partial}{\partial\mathbf{\Sigma}^{-1}}\mathbb{E}_{Y\sim P_{x}}\left[\log\mathcal{N}(Y;m^{*},\mathbf{\Sigma})\right]=\frac{1}{2}\mathbf{\Sigma}-\frac{1}{2}S_{x}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><msup><mi>𝚺</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><msup><mi>m</mi><mo>∗</mo></msup><mo>,</mo><mi>𝚺</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>x</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial}{\partial\mathbf{\Sigma}^{-1}}\mathbb{E}_{Y\sim P_{x}}\left[\log\mathcal{N}(Y;m^{*},\mathbf{\Sigma})\right]=\frac{1}{2}\mathbf{\Sigma}-\frac{1}{2}S_{x}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.6" class="ltx_p"><span id="A5.p2.6.1" class="ltx_text">This quantity is zero at the maximum <math id="A5.p2.m10" class="ltx_Math" alttext="\mathbf{\Sigma}^{*}=\mathbb{E}_{Y\sim P_{x}}\left[(Y-m^{*})(Y-m^{*})^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝚺</mi><mo>∗</mo></msup><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><msup><mi>m</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><msup><mi>m</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{\Sigma}^{*}=\mathbb{E}_{Y\sim P_{x}}\left[(Y-m^{*})(Y-m^{*})^{\top}\right]</annotation></semantics></math>, and uniqueness follows from strict concavity.
Thus, the optimal covariance is given by <math id="A5.p2.m11" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}:=\mathbb{E}_{Y\sim P_{x}}\left[(Y-m^{*})(Y-m^{*})^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo>:=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>Y</mi><mo>∼</mo><msub><mi>P</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><msup><mi>m</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>−</mo><msup><mi>m</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}:=\mathbb{E}_{Y\sim P_{x}}\left[(Y-m^{*})(Y-m^{*})^{\top}\right]</annotation></semantics></math>, the centred covariance of the neighbours of <math id="A5.p2.m12" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A5.p3" class="ltx_para ltx_noindent">
<p id="A5.p3.1" class="ltx_p">This theorem justifies using the mean-centred local covariance of the diffusion kernel’s neighbourhood as the statistically optimal covariance for a local Gaussian fit.</p>
</div>
<section id="A5.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Rescaling the carré du champ matrix</h4>

<div id="A5.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A5.SS0.SSS0.Px1.p1.1" class="ltx_p">If the bandwidth of the kernel is set appropriately, the carré du champ matrix <math id="A5.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x^{(i)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x^{(i)})</annotation></semantics></math> will capture the local shape of the density near a training point <math id="A5.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math>.
However, depending on the bandwidth, samples from <math id="A5.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\mathcal{N}(x^{(i)},\widehat{\mathbf{\Gamma}}(x^{(i)}))" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(x^{(i)},\widehat{\mathbf{\Gamma}}(x^{(i)}))</annotation></semantics></math> may be far from <math id="A5.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math>.
To quantify this, we may diagonalise <math id="A5.SS0.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}=Q^{\top}\text{diag}(\lambda_{1},...,\lambda_{d})Q" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo>=</mo><mrow><msup><mi>Q</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}=Q^{\top}\text{diag}(\lambda_{1},...,\lambda_{d})Q</annotation></semantics></math>, where <math id="A5.SS0.SSS0.Px1.p1.m6" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is the orthonormal matrix of principal components of <math id="A5.SS0.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}</annotation></semantics></math>, then <math id="A5.SS0.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}</annotation></semantics></math> represents Gaussian noise with variance <math id="A5.SS0.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math> in the direction of the component <math id="A5.SS0.SSS0.Px1.p1.m10" class="ltx_Math" alttext="Q_{i}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>i</mi></msub><annotation encoding="application/x-tex">Q_{i}</annotation></semantics></math>.
Then, if samples are drawn randomly from <math id="A5.SS0.SSS0.Px1.p1.m11" class="ltx_Math" alttext="\mathcal{N}(x,\widehat{\mathbf{\Gamma}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(x,\widehat{\mathbf{\Gamma}})</annotation></semantics></math>, their expected squared distance from <math id="A5.SS0.SSS0.Px1.p1.m12" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is</p>
<table id="A5.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex19.m1" class="ltx_Math" alttext="\mathbb{E}\big(\|X-x\|^{2}\big)=\mathrm{tr}(\widehat{\mathbf{\Gamma}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>X</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\big(\|X-x\|^{2}\big)=\mathrm{tr}(\widehat{\mathbf{\Gamma}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS0.SSS0.Px1.p1.2" class="ltx_p">This means that excessive noise in directions normal to the manifold can reduce the fidelity of the geometric regularisation.
Thus, to control the maximum amount of noise added to the data by <math id="A5.SS0.SSS0.Px1.p1.m13" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}</annotation></semantics></math> in any direction, we need to rescale <math id="A5.SS0.SSS0.Px1.p1.m14" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}</annotation></semantics></math> such that the largest eigenvalue <math id="A5.SS0.SSS0.Px1.p1.m15" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> is of the right scale.</p>
</div>
<div id="A5.SS0.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A5.SS0.SSS0.Px1.p2.1" class="ltx_p">As a heuristic, we would like the noise added by <math id="A5.SS0.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x^{(i)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x^{(i)})</annotation></semantics></math> to be small enough that it is contained in the gaps between the training point <math id="A5.SS0.SSS0.Px1.p2.m2" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math> and its neighbours.
This way, the training signal is still dominated by the <span id="A5.SS0.SSS0.Px1.p2.1.1" class="ltx_text ltx_font_italic">location</span> of the training data, with the carré du champ adding a small, unintrusive amount of <span id="A5.SS0.SSS0.Px1.p2.1.2" class="ltx_text ltx_font_italic">directional</span> training on top of that.
If <math id="A5.SS0.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\pi(x^{(i)})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(x^{(i)})</annotation></semantics></math> is the nearest neighbour of <math id="A5.SS0.SSS0.Px1.p2.m4" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math>, then we choose to ensure that all the eigenvalues of <math id="A5.SS0.SSS0.Px1.p2.m5" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x^{(i)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x^{(i)})</annotation></semantics></math> are no larger than <math id="A5.SS0.SSS0.Px1.p2.m6" class="ltx_Math" alttext="\|x^{(i)}-\pi(x^{(i)})\|^{2}/9" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>/</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">\|x^{(i)}-\pi(x^{(i)})\|^{2}/9</annotation></semantics></math>.
This means that, in any given direction, the noise added has standard deviation at most <math id="A5.SS0.SSS0.Px1.p2.m7" class="ltx_Math" alttext="\|x^{(i)}-\pi(x^{(i)})\|/3" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>/</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\|x^{(i)}-\pi(x^{(i)})\|/3</annotation></semantics></math>, so at least <math id="A5.SS0.SSS0.Px1.p2.m8" class="ltx_Math" alttext="99.7\%" display="inline" intent=":literal"><semantics><mrow><mn>99.7</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">99.7\%</annotation></semantics></math> of it will be closer to <math id="A5.SS0.SSS0.Px1.p2.m9" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math> than its nearest neighbour <math id="A5.SS0.SSS0.Px1.p2.m10" class="ltx_Math" alttext="\pi(x^{(i)})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(x^{(i)})</annotation></semantics></math>.</p>
</div>
<div id="A5.SS0.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="A5.SS0.SSS0.Px1.p3.1" class="ltx_p">This local heuristic is effective except in the case that <math id="A5.SS0.SSS0.Px1.p3.m1" class="ltx_Math" alttext="x^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">x^{(i)}</annotation></semantics></math> is very isolated, in which case <math id="A5.SS0.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\|x^{(i)}-\pi(x^{(i)})\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|x^{(i)}-\pi(x^{(i)})\|</annotation></semantics></math> is very large.
To avoid adding too much excess noise to these points, we will also cap the maximum noise level at <math id="A5.SS0.SSS0.Px1.p3.m3" class="ltx_Math" alttext="c_{\max}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>max</mi></msub><annotation encoding="application/x-tex">c_{\max}</annotation></semantics></math>, defined to be the <math id="A5.SS0.SSS0.Px1.p3.m4" class="ltx_Math" alttext="90^{th}" display="inline" intent=":literal"><semantics><msup><mn>90</mn><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">90^{th}</annotation></semantics></math> percentile of all the local constraints <math id="A5.SS0.SSS0.Px1.p3.m5" class="ltx_Math" alttext="\|x^{(i)}-\pi(x^{(i)})\|^{2}/9" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>/</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">\|x^{(i)}-\pi(x^{(i)})\|^{2}/9</annotation></semantics></math>.
This limits the scale of the noise at the <math id="A5.SS0.SSS0.Px1.p3.m6" class="ltx_Math" alttext="10\%" display="inline" intent=":literal"><semantics><mrow><mn>10</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">10\%</annotation></semantics></math> most outlying points in the data, which we can guarantee by ensuring that all the eigenvalues are below <math id="A5.SS0.SSS0.Px1.p3.m7" class="ltx_Math" alttext="c_{\max}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>max</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">c_{\max}^{2}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS0.SSS0.Px1.p4" class="ltx_para ltx_noindent">
<p id="A5.SS0.SSS0.Px1.p4.1" class="ltx_p">To meet both the local and global constraints, we rescale <math id="A5.SS0.SSS0.Px1.p4.m1" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x^{(i)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x^{(i)})</annotation></semantics></math> by</p>
<table id="A5.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E33.m1" class="ltx_Math" alttext="c_{i}=\frac{1}{\lambda_{1}^{i}}\min\Big(\frac{\|x^{(i)}-\pi(x^{(i)})\|^{2}}{9},c_{\max}^{2}\Big)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><msubsup><mi>λ</mi><mn>1</mn><mi>i</mi></msubsup></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mn>9</mn></mfrac><mo>,</mo><msubsup><mi>c</mi><mi>max</mi><mn>2</mn></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">c_{i}=\frac{1}{\lambda_{1}^{i}}\min\Big(\frac{\|x^{(i)}-\pi(x^{(i)})\|^{2}}{9},c_{\max}^{2}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A5.SS0.SSS0.Px1.p4.2" class="ltx_p">where <math id="A5.SS0.SSS0.Px1.p4.m2" class="ltx_Math" alttext="\lambda_{1}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>λ</mi><mn>1</mn><mi>i</mi></msubsup><annotation encoding="application/x-tex">\lambda_{1}^{i}</annotation></semantics></math> is the largest eigenvalue of <math id="A5.SS0.SSS0.Px1.p4.m3" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x^{(i)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x^{(i)})</annotation></semantics></math>.
The largest eigenvalue of the rescaled matrix will then be the smaller of <math id="A5.SS0.SSS0.Px1.p4.m4" class="ltx_Math" alttext="\|x^{(i)}-\pi(x^{(i)})\|^{2}/4" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>/</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">\|x^{(i)}-\pi(x^{(i)})\|^{2}/4</annotation></semantics></math> and <math id="A5.SS0.SSS0.Px1.p4.m5" class="ltx_Math" alttext="c_{\max}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>max</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">c_{\max}^{2}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS0.SSS0.Px1.p5" class="ltx_para ltx_noindent">
<p id="A5.SS0.SSS0.Px1.p5.1" class="ltx_p">The above method describes a heuristic for setting the size of the carré du champ at each point, but, in particular cases, we may attain better performance by further globally rescaling <math id="A5.SS0.SSS0.Px1.p5.m1" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x_{i})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x_{i})</annotation></semantics></math>.
We therefore use the carré du champ <math id="A5.SS0.SSS0.Px1.p5.m2" class="ltx_Math" alttext="\gamma c_{i}\widehat{\mathbf{\Gamma}}(x^{(i)})" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma c_{i}\widehat{\mathbf{\Gamma}}(x^{(i)})</annotation></semantics></math>, where <math id="A5.SS0.SSS0.Px1.p5.m3" class="ltx_Math" alttext="c_{i}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>i</mi></msub><annotation encoding="application/x-tex">c_{i}</annotation></semantics></math> is from (<a href="#A5.E33" title="In Rescaling the carré du champ matrix ‣ Appendix E Optimal estimation of the carré du champ matrix ‣ Carré du champ flow matching: better quality-generalisation tradeoff in generative models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>) and <math id="A5.SS0.SSS0.Px1.p5.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is a tuneable hyperparameter that
defaults to <math id="A5.SS0.SSS0.Px1.p5.m5" class="ltx_Math" alttext="1.0" display="inline" intent=":literal"><semantics><mn>1.0</mn><annotation encoding="application/x-tex">1.0</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Computational complexity and runtimes</h2>

<div id="A6.p1" class="ltx_para ltx_noindent">
<p id="A6.p1.1" class="ltx_p">The conditional paths in CDC-FM require <math id="A6.p1.m1" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x_{1})^{1/2}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x_{1})^{1/2}</annotation></semantics></math>, for which we have to compute and diagonalise <math id="A6.p1.m2" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x_{1})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x_{1})</annotation></semantics></math>.
Since we truncate the diffusion kernel to have only <math id="A6.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> non-zero entries per point (the neighbours of the point), the carré du champ at each point has rank at most <math id="A6.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, so we can avoid
working with full <math id="A6.p1.m5" class="ltx_Math" alttext="d\times d" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d\times d</annotation></semantics></math> covariance matrices.
Instead, we project the neighbour differences into their <math id="A6.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-dimensional span and compute <math id="A6.p1.m7" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x_{1})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x_{1})</annotation></semantics></math> in
this reduced basis.
The resulting <math id="A6.p1.m8" class="ltx_Math" alttext="k\times k" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">k\times k</annotation></semantics></math> matrices capture the full spectrum while being far cheaper to store and diagonalise.
The dominant costs are therefore <math id="A6.p1.m9" class="ltx_Math" alttext="O(k^{2}d)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(k^{2}d)</annotation></semantics></math> for the projection step and <math id="A6.p1.m10" class="ltx_Math" alttext="O(k^{3})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(k^{3})</annotation></semantics></math> for the eigen-decomposition, rather than <math id="A6.p1.m11" class="ltx_Math" alttext="O(d^{3})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(d^{3})</annotation></semantics></math>.
In practice, <math id="A6.p1.m12" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is small even when the dimension <math id="A6.p1.m13" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is high, so the computation effectively takes <math id="A6.p1.m14" class="ltx_Math" alttext="\mathcal{O}(N(\log(N)+d))" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(N(\log(N)+d))</annotation></semantics></math> time and <math id="A6.p1.m15" class="ltx_Math" alttext="\mathcal{O}(Nd)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nd)</annotation></semantics></math> space.
The complexities of the different steps are given in Table <a href="#A6.T1" title="Table A1 ‣ Appendix F Computational complexity and runtimes ‣ Carré du champ flow matching: better quality-generalisation tradeoff in generative models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A1</span></a>. We also report the empirical preprocessing time for the CIFAR-10 experiments in Table <a href="#A6.T2" title="Table A2 ‣ Appendix F Computational complexity and runtimes ‣ Carré du champ flow matching: better quality-generalisation tradeoff in generative models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A2</span></a>.</p>
</div>
<figure id="A6.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table A1: </span><span id="A6.T1.3" class="ltx_text ltx_font_bold">Compute and memory complexity.</span>
Here, <math id="A6.T1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is the number of training points, <math id="A6.T1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is the number of neighbours, and <math id="A6.T1.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is the ambient dimension.
</figcaption>
<table id="A6.T1.4" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A6.T1.4.1" class="ltx_tr">
<th id="A6.T1.4.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A6.T1.4.1.1.1" class="ltx_text ltx_font_bold">Step</span></th>
<th id="A6.T1.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T1.4.1.2.1" class="ltx_text ltx_font_bold">Compute</span></th>
<th id="A6.T1.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T1.4.1.3.1" class="ltx_text ltx_font_bold">Memory</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A6.T1.4.2" class="ltx_tr">
<th id="A6.T1.4.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">k-NN graph construction</th>
<td id="A6.T1.4.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A6.T1.m7" class="ltx_Math" alttext="\mathcal{O}(N\log(N))" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(N\log(N))</annotation></semantics></math></td>
<td id="A6.T1.4.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A6.T1.m8" class="ltx_Math" alttext="\mathcal{O}(Nk+Nkd)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nk+Nkd)</annotation></semantics></math></td></tr>
<tr id="A6.T1.4.3" class="ltx_tr">
<th id="A6.T1.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Diffusion kernel</th>
<td id="A6.T1.4.3.2" class="ltx_td ltx_align_center"><math id="A6.T1.m9" class="ltx_Math" alttext="\mathcal{O}(Nk)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nk)</annotation></semantics></math></td>
<td id="A6.T1.4.3.3" class="ltx_td ltx_align_center"><math id="A6.T1.m10" class="ltx_Math" alttext="\mathcal{O}(Nk)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nk)</annotation></semantics></math></td></tr>
<tr id="A6.T1.4.4" class="ltx_tr">
<th id="A6.T1.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Form covariance terms in <math id="A6.T1.m11" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math></th>
<td id="A6.T1.4.4.2" class="ltx_td ltx_align_center"><math id="A6.T1.m12" class="ltx_Math" alttext="\mathcal{O}(Nkd)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nkd)</annotation></semantics></math></td>
<td id="A6.T1.4.4.3" class="ltx_td ltx_align_center"><math id="A6.T1.m13" class="ltx_Math" alttext="\mathcal{O}(Nkd)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nkd)</annotation></semantics></math></td></tr>
<tr id="A6.T1.4.5" class="ltx_tr">
<th id="A6.T1.4.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Project covariance terms to <math id="A6.T1.m14" class="ltx_Math" alttext="\mathbb{R}^{k}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>k</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{k}</annotation></semantics></math></th>
<td id="A6.T1.4.5.2" class="ltx_td ltx_align_center"><math id="A6.T1.m15" class="ltx_Math" alttext="\mathcal{O}(Nk^{2}d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nk^{2}d)</annotation></semantics></math></td>
<td id="A6.T1.4.5.3" class="ltx_td ltx_align_center"><math id="A6.T1.m16" class="ltx_Math" alttext="\mathcal{O}(Nkd+Nk^{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nkd+Nk^{2})</annotation></semantics></math></td></tr>
<tr id="A6.T1.4.6" class="ltx_tr">
<th id="A6.T1.4.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Diagonalise <math id="A6.T1.m17" class="ltx_Math" alttext="\widehat{\mathbf{\Gamma}}(x_{i})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚪</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbf{\Gamma}}(x_{i})</annotation></semantics></math> in <math id="A6.T1.m18" class="ltx_Math" alttext="\mathbb{R}^{k}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>k</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{k}</annotation></semantics></math></th>
<td id="A6.T1.4.6.2" class="ltx_td ltx_align_center"><math id="A6.T1.m19" class="ltx_Math" alttext="\mathcal{O}(Nk^{3})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>3</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nk^{3})</annotation></semantics></math></td>
<td id="A6.T1.4.6.3" class="ltx_td ltx_align_center"><math id="A6.T1.m20" class="ltx_Math" alttext="\mathcal{O}(Nk^{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nk^{2})</annotation></semantics></math></td></tr>
<tr id="A6.T1.4.7" class="ltx_tr">
<th id="A6.T1.4.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="A6.T1.4.7.1.1" class="ltx_text ltx_font_bold">Overall complexity</span></th>
<td id="A6.T1.4.7.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="A6.T1.m21" class="ltx_Math" alttext="\mathcal{O}\!\left(N(\log(N)+k^{2}d+k^{3})\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><msup><mi>k</mi><mn>3</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\!\left(N(\log(N)+k^{2}d+k^{3})\right)</annotation></semantics></math></td>
<td id="A6.T1.4.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="A6.T1.m22" class="ltx_Math" alttext="\mathcal{O}(Nkd+Nk^{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(Nkd+Nk^{2})</annotation></semantics></math></td></tr>
</tbody>
</table>
</figure>
<figure id="A6.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table A2: </span><span id="A6.T2.3" class="ltx_text ltx_font_bold">Preprocessing empirical runtimes.</span>
Runtimes are reported in seconds for CIFAR-10 subsets of varying sizes and were ran on NVIDIA A10s.</figcaption>
<table id="A6.T2.4" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A6.T2.4.1" class="ltx_tr">
<th id="A6.T2.4.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A6.T2.4.1.1.1" class="ltx_text ltx_font_bold">Dataset size</span></th>
<th id="A6.T2.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T2.4.1.2.1" class="ltx_text ltx_font_bold">KNN graph (s)</span></th>
