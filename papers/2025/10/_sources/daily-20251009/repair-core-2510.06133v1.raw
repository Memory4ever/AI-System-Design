<td id="S5.T1.14.1.20.3" class="ltx_td ltx_align_center" style="padding:0.7pt 3.0pt;"><span id="S5.T1.14.1.20.3.1" class="ltx_text" style="font-size:80%;">4.31</span></td>
<td id="S5.T1.14.1.20.4" class="ltx_td ltx_align_center" style="padding:0.7pt 3.0pt;"><span id="S5.T1.14.1.20.4.1" class="ltx_text" style="font-size:80%;">5.48 (</span><span id="S5.T1.14.1.20.4.2" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#008000;">+27%</span><span id="S5.T1.14.1.20.4.3" class="ltx_text" style="font-size:80%;">)</span></td>
<td id="S5.T1.14.1.20.5" class="ltx_td ltx_align_center ltx_border_r" style="padding:0.7pt 3.0pt;"><span id="S5.T1.14.1.20.5.1" class="ltx_text" style="font-size:80%;">4.77 (</span><span id="S5.T1.14.1.20.5.2" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#008000;">+11%</span><span id="S5.T1.14.1.20.5.3" class="ltx_text" style="font-size:80%;">)</span></td>
<td id="S5.T1.14.1.20.6" class="ltx_td ltx_align_center" style="padding:0.7pt 3.0pt;"><span id="S5.T1.14.1.20.6.1" class="ltx_text" style="font-size:80%;">1</span></td>
<td id="S5.T1.14.1.20.7" class="ltx_td ltx_align_center" style="padding:0.7pt 3.0pt;"><span id="S5.T1.14.1.20.7.1" class="ltx_text" style="font-size:80%;">3.30</span></td>
<td id="S5.T1.14.1.20.8" class="ltx_td ltx_align_center" style="padding:0.7pt 3.0pt;"><span id="S5.T1.14.1.20.8.1" class="ltx_text" style="font-size:80%;">4.11 (</span><span id="S5.T1.14.1.20.8.2" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#008000;">+25%</span><span id="S5.T1.14.1.20.8.3" class="ltx_text" style="font-size:80%;">)</span></td>
<td id="S5.T1.14.1.20.9" class="ltx_td ltx_align_center" style="padding:0.7pt 3.0pt;"><span id="S5.T1.14.1.20.9.1" class="ltx_text" style="font-size:80%;">3.66 (</span><span id="S5.T1.14.1.20.9.2" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#008000;">+11%</span><span id="S5.T1.14.1.20.9.3" class="ltx_text" style="font-size:80%;">)</span></td></tr>
