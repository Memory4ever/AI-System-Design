<td id="S5.T1.14.1.19.9" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.7pt 3.0pt;"><span id="S5.T1.14.1.19.9.1" class="ltx_text ltx_font_bold" style="font-size:80%;">55.77 <sub id="S5.T1.14.1.19.9.1.1" class="ltx_sub"><span id="S5.T1.14.1.19.9.1.1.1" class="ltx_text ltx_font_italic">+0.35</span></sub></span></td></tr>
