<figure id="S4.T3" class="ltx_table">
<div id="S4.T3.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:338.1pt;height:149.1pt;vertical-align:-71.5pt;"><span class="ltx_transformed_inner" style="transform:translate(30.7pt,-13.5pt) scale(1.22201251406554,1.22201251406554) ;">
<table id="S4.T3.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S4.T3.2.1.1" class="ltx_tr">
<td id="S4.T3.2.1.1.1" class="ltx_td ltx_align_left ltx_border_tt" rowspan="2"><span id="S4.T3.2.1.1.1.1" class="ltx_text ltx_font_bold">Method</span></td>
