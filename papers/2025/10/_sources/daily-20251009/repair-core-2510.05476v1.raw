<td id="S3.T2.2.1.4.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S3.T2.2.1.4.2.1" class="ltx_text ltx_font_typewriter">name</span>, <span id="S3.T2.2.1.4.2.2" class="ltx_text ltx_font_typewriter">size</span>, <span id="S3.T2.2.1.4.2.3" class="ltx_text ltx_font_typewriter">*obj_handle</span></td>
