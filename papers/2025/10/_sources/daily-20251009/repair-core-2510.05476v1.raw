<span id="S2.T1.2.1.8.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S2.T1.2.1.8.1.2.1.1.1.1" class="ltx_text ltx_font_typewriter">CXL Memory Sharing</span></span></span>
<span id="S2.T1.2.1.8.1.2.1.2" class="ltx_tr">
<span id="S2.T1.2.1.8.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S2.T1.2.1.8.1.2.1.2.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">(with caching; no cache flushing)</span></span></span>
</span></span><span id="S2.T1.2.1.8.1.3" class="ltx_text"></span></td>
<td id="S2.T1.2.1.8.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">790 <math id="S2.T1.m7" class="ltx_Math" alttext="ns" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">ns</annotation></semantics></math></td>
<td id="S2.T1.2.1.8.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">9.9 GB/s</td></tr>
