<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E57.m1" class="ltx_math_unparsed" alttext="\displaystyle=\nabla_{\phi}\biggr[\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\frac{\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}(\cdot\mid{\mathbf{q}})}\bigr[r({\mathbf{q}},{\bm{x}}_{0})\bigl]}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl]=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\nabla_{\phi}V_{g_{\phi}}({\mathbf{q}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl]," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mo>∇</mo><mi>ϕ</mi></msub><mo lspace="0em" mathsize="2.100em" rspace="0em">[</mo><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" mathsize="1.200em" rspace="0em">[</mo><mi>r</mi><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><mi>𝒙</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em">]</mo></mrow><mrow><mrow><msub><mi>std</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em" rspace="0em">]</mo><mo lspace="0em">=</mo><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><mo lspace="0em" mathsize="2.100em" rspace="0em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi>V</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msub><mi>std</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em" rspace="0em">]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\nabla_{\phi}\biggr[\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\frac{\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}(\cdot\mid{\mathbf{q}})}\bigr[r({\mathbf{q}},{\bm{x}}_{0})\bigl]}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl]=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\nabla_{\phi}V_{g_{\phi}}({\mathbf{q}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p7.2" class="ltx_p"><span id="A3.SS2.p7.2.1" class="ltx_text">where we define state-wise value function as the expectation of terminal reward starting from the state, <em id="A3.SS2.p7.2.1.1" class="ltx_emph ltx_font_italic">i.e</em>.<span id="A3.SS2.p7.2.1.2" class="ltx_text"></span>, <math id="A3.SS2.p7.m2" class="ltx_math_unparsed" alttext="V_{g_{\phi}}({\bm{x}}_{n}|{\mathbf{q}})\coloneq\mathbb{E}_{{\bm{x}}_{0:{n-1}}\sim p_{g_{\phi}}(\cdot\mid{\mathbf{q}},{\bm{x}}_{n})}\bigr[r({\mathbf{q}},{\bm{x}}_{0})\bigl]" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>≔</mo><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo>,</mo><mi>𝒙</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" mathsize="1.200em" rspace="0em">[</mo><mi>r</mi><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em">]</mo></mrow><annotation encoding="application/x-tex">V_{g_{\phi}}({\bm{x}}_{n}|{\mathbf{q}})\coloneq\mathbb{E}_{{\bm{x}}_{0:{n-1}}\sim p_{g_{\phi}}(\cdot\mid{\mathbf{q}},{\bm{x}}_{n})}\bigr[r({\mathbf{q}},{\bm{x}}_{0})\bigl]</annotation></semantics></math> and we denote value function at the initial state as <math id="A3.SS2.p7.m3" class="ltx_math_unparsed" alttext="V_{g_{\phi}}({\mathbf{q}})\coloneq\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}(\cdot\mid{\mathbf{q}})}\bigr[r({\mathbf{q}},{\bm{x}}_{0})\bigl]" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>≔</mo><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" mathsize="1.200em" rspace="0em">[</mo><mi>r</mi><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo><mo lspace="0em" mathsize="1.200em">]</mo></mrow><annotation encoding="application/x-tex">V_{g_{\phi}}({\mathbf{q}})\coloneq\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}(\cdot\mid{\mathbf{q}})}\bigr[r({\mathbf{q}},{\bm{x}}_{0})\bigl]</annotation></semantics></math>. Accordingly, state-wise action-value function can be defined as <math id="A3.SS2.p7.m4" class="ltx_Math" alttext="Q_{g_{\phi}}({\bm{x}}_{n},a_{n}|{\mathbf{q}})=\sum_{{\bm{x}}_{n-1}}\pi_{\theta}({\bm{x}}_{n-1}|{\bm{x}}_{n},a_{n})\cdot V_{g_{\phi}}({\bm{x}}_{n-1}|{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒙</mi><mi>n</mi></msub><mo>,</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><mrow><msub><mo>∑</mo><msub><mi>𝒙</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>n</mi></msub><mo>,</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>V</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q_{g_{\phi}}({\bm{x}}_{n},a_{n}|{\mathbf{q}})=\sum_{{\bm{x}}_{n-1}}\pi_{\theta}({\bm{x}}_{n-1}|{\bm{x}}_{n},a_{n})\cdot V_{g_{\phi}}({\bm{x}}_{n-1}|{\mathbf{q}})</annotation></semantics></math>.
Please note that Eq. (<a href="#A3.E51" title="In Proof. ‣ C.2 Surrogate loss of output-level reward maximization ‣ Appendix C Detailed Proof ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">51</span></a>)-<a href="#A3.E56" title="In Proof. ‣ C.2 Surrogate loss of output-level reward maximization ‣ Appendix C Detailed Proof ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">56</span></a> is conceptually equivalent to reversing the derivation process of REINFORCE with baseline <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib28" title="" class="ltx_ref">Williams, 1992</a>)</cite>. Since we want to show that <math id="A3.SS2.p7.m5" class="ltx_Math" alttext="\nabla_{\phi}\mathcal{L}_{\rm{token}}\mathrel{\vbox{\halign{\hfil$#$\cr\propto\cr\kern 2.0pt\cr\sim\cr\kern-2.0pt\cr}}}\nabla_{\phi}\mathcal{L}_{\rm{output}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>token</mi></msub></mrow><mtable align="bottom" rowspacing="0pt"><mtr><mtd class="ltx_nopad_r" columnalign="right"><mo>∝</mo></mtd></mtr><mtr><mtd class="ltx_nopad_r" columnalign="right"><mo>∼</mo></mtd></mtr></mtable><mrow><msub><mo lspace="0.278em" rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>output</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\phi}\mathcal{L}_{\rm{token}}\mathrel{\vbox{\halign{\hfil$#$\cr\propto\cr\kern 2.0pt\cr\sim\cr\kern-2.0pt\cr}}}\nabla_{\phi}\mathcal{L}_{\rm{output}}</annotation></semantics></math>, we breakdown <math id="A3.SS2.p7.m6" class="ltx_Math" alttext="\nabla_{\phi}V_{g_{\phi}}({\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi>V</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\phi}V_{g_{\phi}}({\mathbf{q}})</annotation></semantics></math> using Lemma <a href="#Thmlemma2" title="Lemma 2 (Policy gradient theorem in sparse-reward, finite-horizon, episodic, and non-stationary MDP). ‣ C.2 Surrogate loss of output-level reward maximization ‣ Appendix C Detailed Proof ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>:</span></p>
</div>
<div id="A3.SS2.p8" class="ltx_para ltx_noindent">
<table id="A3.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E58.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\phi}\mathcal{L}_{\rm{output}}(\phi)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>output</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\phi}\mathcal{L}_{\rm{output}}(\phi)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E58.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\nabla_{\phi}V_{g_{\phi}}({\mathbf{q}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><mo lspace="0em" mathsize="2.100em" rspace="0em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi>V</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msub><mi>std</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\nabla_{\phi}V_{g_{\phi}}({\mathbf{q}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
<tbody id="A3.E59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E59.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\sum_{\bm{x}}p_{g_{\phi}}({\bm{x}}|{\mathbf{q}})\sum Q_{g_{\phi}}({\bm{x}},a|{\mathbf{q}})\nabla_{\phi}g_{\phi}(a|{\bm{x}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><mo lspace="0em" mathsize="2.100em" rspace="0em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mi>𝒙</mi></msub><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><mrow><msub><mi>Q</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi>g</mi><mi>ϕ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mrow><mrow><msub><mi>std</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\sum_{\bm{x}}p_{g_{\phi}}({\bm{x}}|{\mathbf{q}})\sum Q_{g_{\phi}}({\bm{x}},a|{\mathbf{q}})\nabla_{\phi}g_{\phi}(a|{\bm{x}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(59)</span></td></tr></tbody>
<tbody id="A3.E60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E60.m1" class="ltx_math_unparsed" alttext="\displaystyle\approx\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\sum_{\bm{x}}p_{g_{\phi_{\rm{old}}}}({\bm{x}}|{\mathbf{q}})\sum Q_{g_{\phi_{\rm{old}}}}({\bm{x}},a|{\mathbf{q}})\nabla_{\phi}g_{\phi}(a|{\bm{x}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl]." display="inline" intent=":literal"><semantics><mrow><mo>≈</mo><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><mo lspace="0em" mathsize="2.100em" rspace="0em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mi>𝒙</mi></msub><mrow><msub><mi>p</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><mrow><msub><mi>Q</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi>g</mi><mi>ϕ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mrow><mrow><msub><mi>std</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em" rspace="0em">]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\approx\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\sum_{\bm{x}}p_{g_{\phi_{\rm{old}}}}({\bm{x}}|{\mathbf{q}})\sum Q_{g_{\phi_{\rm{old}}}}({\bm{x}},a|{\mathbf{q}})\nabla_{\phi}g_{\phi}(a|{\bm{x}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(60)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p8.1" class="ltx_p"><span id="A3.SS2.p8.1.1" class="ltx_text">where <math id="A3.SS2.p8.m1" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math> comes from every state, <em id="A3.SS2.p8.1.1.1" class="ltx_emph ltx_font_italic">i.e</em>.<span id="A3.SS2.p8.1.1.2" class="ltx_text"></span>, <math id="A3.SS2.p8.m2" class="ltx_Math" alttext="{\bm{x}}\in\mathcal{X}_{0}\cup\mathcal{X}_{1}\cup\dots\cup\mathcal{X}_{L}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mn>0</mn></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mn>1</mn></msub><mo>∪</mo><mi mathvariant="normal">⋯</mi><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>L</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}\in\mathcal{X}_{0}\cup\mathcal{X}_{1}\cup\dots\cup\mathcal{X}_{L}</annotation></semantics></math>.
Here, Eq. (<a href="#A3.E58" title="In Proof. ‣ C.2 Surrogate loss of output-level reward maximization ‣ Appendix C Detailed Proof ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">58</span></a>) = Eq. (<a href="#A3.E60" title="In Proof. ‣ C.2 Surrogate loss of output-level reward maximization ‣ Appendix C Detailed Proof ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">60</span></a>) exactly holds at the first optimization step where <math id="A3.SS2.p8.m3" class="ltx_Math" alttext="\phi=\phi_{\rm{old}}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>=</mo><msub><mi>ϕ</mi><mi>old</mi></msub></mrow><annotation encoding="application/x-tex">\phi=\phi_{\rm{old}}</annotation></semantics></math>.
On the other side, we now show that <math id="A3.SS2.p8.m4" class="ltx_Math" alttext="\nabla_{\phi}\mathcal{L}_{\rm{token}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>token</mi></msub></mrow><annotation encoding="application/x-tex">\nabla_{\phi}\mathcal{L}_{\rm{token}}</annotation></semantics></math> is equivalent to Eq. (<a href="#A3.E60" title="In Proof. ‣ C.2 Surrogate loss of output-level reward maximization ‣ Appendix C Detailed Proof ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">60</span></a>). We start by converting the expectation into a probability-weighted sum as follows:</span></p>
<table id="A3.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E61.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathcal{L}_{\rm{token}}(\phi)=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\mathbb{E}_{{\bm{x}}_{0:L,a_{1:L}}\sim p_{g_{\phi_{\rm{old}}}}(\cdot\mid{\mathbf{q}})}\Biggl[\sum_{n=1}^{L}\frac{g_{\phi}(a_{n}\mid{\bm{x}}_{n})}{g_{\phi_{\rm old}}(a_{n}\mid{\bm{x}}_{n})}A({\mathbf{q}},{\bm{x}}_{0})\Biggr]" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>token</mi></msub><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi><mo>,</mo><mi>a</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>g</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\rm{token}}(\phi)=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\mathbb{E}_{{\bm{x}}_{0:L,a_{1:L}}\sim p_{g_{\phi_{\rm{old}}}}(\cdot\mid{\mathbf{q}})}\Biggl[\sum_{n=1}^{L}\frac{g_{\phi}(a_{n}\mid{\bm{x}}_{n})}{g_{\phi_{\rm old}}(a_{n}\mid{\bm{x}}_{n})}A({\mathbf{q}},{\bm{x}}_{0})\Biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(61)</span></td></tr></tbody>
<tbody id="A3.E62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E62.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\Biggl[\sum_{\begin{subarray}{c}{\bm{x}}_{0},\dots,{\bm{x}}_{L}\\
a_{1},\dots,a_{L}\end{subarray}}\prod_{n=1}^{L}\biggl(\pi_{\theta}({\bm{x}}_{n-1}|{\bm{x}}_{n},a_{n})\cdot g_{\phi_{\rm{old}}}(a_{n},{\bm{x}}_{n})\biggr)\biggl(\sum_{n=1}^{L}\frac{g_{\phi}(a_{n}\mid{\bm{x}}_{n})}{g_{\phi_{\rm old}}(a_{n}\mid{\bm{x}}_{n})}A({\mathbf{q}},{\bm{x}}_{0})\biggr)\Biggr]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝒙</mi><mi>L</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>L</mi></msub></mrow></mtd></mtr></mtable></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>n</mi></msub><mo>,</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>g</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\Biggl[\sum_{\begin{subarray}{c}{\bm{x}}_{0},\dots,{\bm{x}}_{L}\\
a_{1},\dots,a_{L}\end{subarray}}\prod_{n=1}^{L}\biggl(\pi_{\theta}({\bm{x}}_{n-1}|{\bm{x}}_{n},a_{n})\cdot g_{\phi_{\rm{old}}}(a_{n},{\bm{x}}_{n})\biggr)\biggl(\sum_{n=1}^{L}\frac{g_{\phi}(a_{n}\mid{\bm{x}}_{n})}{g_{\phi_{\rm old}}(a_{n}\mid{\bm{x}}_{n})}A({\mathbf{q}},{\bm{x}}_{0})\biggr)\Biggr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p8.2" class="ltx_p"><span id="A3.SS2.p8.2.1" class="ltx_text">For further explanation, we want to recap <math id="A3.SS2.p8.m5" class="ltx_Math" alttext="p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{n-1}|{\bm{x}}_{n})=\pi_{\theta}({\bm{x}}_{n-1}|{\bm{x}}_{n},a_{n})\cdot g_{\phi_{\rm{old}}}(a_{n}|{\bm{x}}_{n})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>n</mi></msub><mo>,</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{n-1}|{\bm{x}}_{n})=\pi_{\theta}({\bm{x}}_{n-1}|{\bm{x}}_{n},a_{n})\cdot g_{\phi_{\rm{old}}}(a_{n}|{\bm{x}}_{n})</annotation></semantics></math>.
Please note that <math id="A3.SS2.p8.m6" class="ltx_Math" alttext="p_{g_{\phi_{\rm{old}}}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{g_{\phi_{\rm{old}}}}&gt;0</annotation></semantics></math> only if <math id="A3.SS2.p8.m7" class="ltx_Math" alttext="{\bm{x}}_{n}^{a_{n}}=\mathbb{M}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒙</mi><mi>n</mi><msub><mi>a</mi><mi>n</mi></msub></msubsup><mo>=</mo><mi>𝕄</mi></mrow><annotation encoding="application/x-tex">{\bm{x}}_{n}^{a_{n}}=\mathbb{M}</annotation></semantics></math> and <math id="A3.SS2.p8.m8" class="ltx_Math" alttext="{\bm{x}}_{n-1}^{a_{n}}\neq\mathbb{M}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒙</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><msub><mi>a</mi><mi>n</mi></msub></msubsup><mo>≠</mo><mi>𝕄</mi></mrow><annotation encoding="application/x-tex">{\bm{x}}_{n-1}^{a_{n}}\neq\mathbb{M}</annotation></semantics></math> since <math id="A3.SS2.p8.m9" class="ltx_Math" alttext="g_{\phi_{\rm{old}}}(a_{n}|{\bm{x}}_{n})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g_{\phi_{\rm{old}}}(a_{n}|{\bm{x}}_{n})=0</annotation></semantics></math> for <math id="A3.SS2.p8.m10" class="ltx_Math" alttext="{\bm{x}}_{n}^{a_{n}}\neq\mathbb{M}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒙</mi><mi>n</mi><msub><mi>a</mi><mi>n</mi></msub></msubsup><mo>≠</mo><mi>𝕄</mi></mrow><annotation encoding="application/x-tex">{\bm{x}}_{n}^{a_{n}}\neq\mathbb{M}</annotation></semantics></math>, <math id="A3.SS2.p8.m11" class="ltx_Math" alttext="\pi_{\theta}({\bm{x}}_{n-1}|{\bm{x}}_{n},a_{n})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>n</mi></msub><mo>,</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\pi_{\theta}({\bm{x}}_{n-1}|{\bm{x}}_{n},a_{n})=0</annotation></semantics></math> for all <math id="A3.SS2.p8.m12" class="ltx_Math" alttext="{\bm{x}}_{n-1}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\bm{x}}_{n-1}</annotation></semantics></math> satisfying <math id="A3.SS2.p8.m13" class="ltx_Math" alttext="x_{n-1}^{a_{n}}=\mathbb{M}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><msub><mi>a</mi><mi>n</mi></msub></msubsup><mo>=</mo><mi>𝕄</mi></mrow><annotation encoding="application/x-tex">x_{n-1}^{a_{n}}=\mathbb{M}</annotation></semantics></math> by definition.
To simplify the derivation process, we consider <math id="A3.SS2.p8.m14" class="ltx_Math" alttext="\widehat{\mathcal{L}}_{\rm{token,i}}(\phi,{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mrow><mi>token</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathcal{L}}_{\rm{token,i}}(\phi,{\mathbf{q}})</annotation></semantics></math> defined as follows:</span></p>
<table id="A3.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E63.m1" class="ltx_math_unparsed" alttext="\displaystyle\widehat{\mathcal{L}}_{\rm{token,i}}(\phi,{\mathbf{q}})=\sum_{\begin{subarray}{c}{\bm{x}}_{0},\dots,{\bm{x}}_{L}\\
a_{1},\dots,a_{L}\end{subarray}}p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{0:L}|{\mathbf{q}})\frac{g_{\phi}(a_{i}\mid{\bm{x}}_{i})}{g_{\phi_{\rm old}}(a_{i}\mid{\bm{x}}_{i})}r({\mathbf{q}},{\bm{x}}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mrow><mi>token</mi><mo>,</mo><mi>i</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝒙</mi><mi>L</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>L</mi></msub></mrow></mtd></mtr></mtable></munder></mstyle><msub><mi>p</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>g</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widehat{\mathcal{L}}_{\rm{token,i}}(\phi,{\mathbf{q}})=\sum_{\begin{subarray}{c}{\bm{x}}_{0},\dots,{\bm{x}}_{L}\\
a_{1},\dots,a_{L}\end{subarray}}p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{0:L}|{\mathbf{q}})\frac{g_{\phi}(a_{i}\mid{\bm{x}}_{i})}{g_{\phi_{\rm old}}(a_{i}\mid{\bm{x}}_{i})}r({\mathbf{q}},{\bm{x}}_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
