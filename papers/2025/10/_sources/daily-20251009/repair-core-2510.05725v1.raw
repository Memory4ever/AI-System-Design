<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E38.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{\beta}(w_{\epsilon}^{+}(r_{g_{\phi^{*}}}({\mathbf{q}}))-\log Z_{\phi^{*}}\hskip 28.45274pt\because\forall{\bm{x}}_{0}\in\mathcal{X},p_{\theta^{*}}({\bm{x}}|{\mathbf{q}})&gt;0\rightarrow r({\mathbf{q}},{\bm{x}}_{0})=1" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mi>ϵ</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><msub><mi>g</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>log</mi><msub><mi>Z</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub><mo>∵</mo><mo rspace="0.167em">∀</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><msub><mi>p</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mn>0</mn><mo stretchy="false">→</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\beta}(w_{\epsilon}^{+}(r_{g_{\phi^{*}}}({\mathbf{q}}))-\log Z_{\phi^{*}}\hskip 28.45274pt\because\forall{\bm{x}}_{0}\in\mathcal{X},p_{\theta^{*}}({\bm{x}}|{\mathbf{q}})&gt;0\rightarrow r({\mathbf{q}},{\bm{x}}_{0})=1</annotation></semantics></math></td>
