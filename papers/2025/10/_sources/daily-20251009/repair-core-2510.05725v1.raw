</div>
<div id="alg2.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
                 For each <math id="alg2.l15.m1" class="ltx_math_unparsed" alttext="{\bm{x}}_{0:L}^{(g)}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{x}}_{0:L}^{(g)}</annotation></semantics></math>, pre-compute <math id="alg2.l15.m2" class="ltx_math_unparsed" alttext="p_{g_{\phi}}({\bm{x}}_{0:L}^{(g)}|{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{g_{\phi}}({\bm{x}}_{0:L}^{(g)}|{\mathbf{q}})</annotation></semantics></math>

