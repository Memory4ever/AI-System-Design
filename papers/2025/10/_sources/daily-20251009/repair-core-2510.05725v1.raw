<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex12.m1" class="ltx_Math" alttext="\displaystyle\hskip 170.71652pt\because\forall r\in\{0,1\},\;\;w_{e}^{+}(r)\geq 0,\;w_{e}^{-}(r)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="17.348em">∵</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>r</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo rspace="0.727em">,</mo><mrow><mrow><msubsup><mi>w</mi><mi>e</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.447em">,</mo><mrow><mrow><msubsup><mi>w</mi><mi>e</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 170.71652pt\because\forall r\in\{0,1\},\;\;w_{e}^{+}(r)\geq 0,\;w_{e}^{-}(r)\geq 0</annotation></semantics></math></td>
