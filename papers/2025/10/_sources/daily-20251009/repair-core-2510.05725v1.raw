<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E76.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 113.81102pt\cdot\sum_{a_{i}}g_{\phi}(a_{i}\mid{\bm{x}}_{i})\cdot\sum_{{\bm{x}}_{i-1}}\biggl(\pi_{\theta}({\bm{x}}_{i-1}|{\bm{x}}_{i},a_{i},{\mathbf{q}})\cdot V_{\phi_{\rm{old}}}({\bm{x}}_{i-1}|{\mathbf{q}})\biggr)\Biggr)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>a</mi><mi>i</mi></msub></munder></mstyle><msub><mi>g</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></munder></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo>,</mo><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><mi>𝐪</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>V</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 113.81102pt\cdot\sum_{a_{i}}g_{\phi}(a_{i}\mid{\bm{x}}_{i})\cdot\sum_{{\bm{x}}_{i-1}}\biggl(\pi_{\theta}({\bm{x}}_{i-1}|{\bm{x}}_{i},a_{i},{\mathbf{q}})\cdot V_{\phi_{\rm{old}}}({\bm{x}}_{i-1}|{\mathbf{q}})\biggr)\Biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(76)</span></td></tr></tbody>
<tbody id="A3.E77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E77.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\bm{x}}_{i}\sim p_{g_{\phi_{\rm{old}}}}(\cdot|{\mathbf{q}})}[\sum g_{\phi}(a_{i}|{\bm{x}}_{i})\cdot Q_{g_{\phi_{\rm{old}}}}({\bm{x}}_{i},a_{i}|{\mathbf{q}})]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mi>g</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>Q</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo>,</mo><msub><mi>a</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}}_{i}\sim p_{g_{\phi_{\rm{old}}}}(\cdot|{\mathbf{q}})}[\sum g_{\phi}(a_{i}|{\bm{x}}_{i})\cdot Q_{g_{\phi_{\rm{old}}}}({\bm{x}}_{i},a_{i}|{\mathbf{q}})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(77)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p9" class="ltx_para">
<p id="A3.SS2.p9.1" class="ltx_p"><span id="A3.SS2.p9.1.1" class="ltx_text">Then,</span></p>
<table id="A3.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E78.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\phi}\mathcal{L}_{\rm{token}}(\phi)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>token</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\phi}\mathcal{L}_{\rm{token}}(\phi)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E78.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{L}\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\Biggl[\frac{\widehat{\mathcal{L}}_{\rm{token,i}}(\phi)}{{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}}\Biggr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mrow><mi>token</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msub><mi>std</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{L}\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\Biggl[\frac{\widehat{\mathcal{L}}_{\rm{token,i}}(\phi)}{{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}}\Biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(78)</span></td></tr></tbody>
<tbody id="A3.E79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E79.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\frac{\sum_{i=1}^{L}\mathbb{E}_{{\bm{x}}_{i}\sim p_{g_{\phi_{\rm{old}}}}(\cdot|{\mathbf{q}})}[\sum\nabla_{\phi}g_{\phi}(a_{i}|{\bm{x}}_{i})\cdot Q_{g_{\phi_{\rm{old}}}}({\bm{x}}_{i},a_{i}|{\mathbf{q}})]}{{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>L</mi></msup><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝒙</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">[</mo><mo lspace="0em">∑</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>ϕ</mi></msub><mi>g</mi><msub><mrow></mrow><mi>ϕ</mi></msub><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>Q</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow><mrow><mrow><msub><mi>std</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\frac{\sum_{i=1}^{L}\mathbb{E}_{{\bm{x}}_{i}\sim p_{g_{\phi_{\rm{old}}}}(\cdot|{\mathbf{q}})}[\sum\nabla_{\phi}g_{\phi}(a_{i}|{\bm{x}}_{i})\cdot Q_{g_{\phi_{\rm{old}}}}({\bm{x}}_{i},a_{i}|{\mathbf{q}})]}{{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(79)</span></td></tr></tbody>
<tbody id="A3.E80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E80.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\sum_{\bm{x}}p_{g_{\phi_{\rm{old}}}}({\bm{x}}|{\mathbf{q}})\sum Q_{g_{\phi_{\rm{old}}}}({\bm{x}},a|{\mathbf{q}})\nabla_{\phi}g_{\phi}(a|{\bm{x}},{\mathbf{q}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝐪</mi><mo>∼</mo><msub><mi>ρ</mi><mi class="ltx_font_mathcaligraphic">𝒬</mi></msub></mrow></msub><mo lspace="0em" mathsize="2.100em" rspace="0em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mi>𝒙</mi></msub><mrow><msub><mi>p</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∑</mo><mrow><msub><mi>Q</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi>g</mi><mi>ϕ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mi>𝒙</mi><mo>,</mo><mi>𝐪</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mrow><mrow><msub><mi>std</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em" rspace="0em">]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\mathbf{q}}\sim\rho_{\mathcal{Q}}}\biggr[\frac{\sum_{\bm{x}}p_{g_{\phi_{\rm{old}}}}({\bm{x}}|{\mathbf{q}})\sum Q_{g_{\phi_{\rm{old}}}}({\bm{x}},a|{\mathbf{q}})\nabla_{\phi}g_{\phi}(a|{\bm{x}},{\mathbf{q}})}{\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon}\biggl].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(80)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p9.2" class="ltx_p"><span id="A3.SS2.p9.2.1" class="ltx_text">Eq. (<a href="#A3.E78" title="In Proof. ‣ C.2 Surrogate loss of output-level reward maximization ‣ Appendix C Detailed Proof ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">78</span></a>) holds where <math id="A3.SS2.p9.m1" class="ltx_Math" alttext="r_{g_{\phi_{\rm{old}}}}({\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{g_{\phi_{\rm{old}}}}({\mathbf{q}})</annotation></semantics></math> in <math id="A3.SS2.p9.m2" class="ltx_Math" alttext="A({\mathbf{q}},{\bm{x}}_{0})=(r(q,{\bm{x}}_{0})-r_{g_{\phi_{\rm{old}}}}({\mathbf{q}}))/(\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>r</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>std</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A({\mathbf{q}},{\bm{x}}_{0})=(r(q,{\bm{x}}_{0})-r_{g_{\phi_{\rm{old}}}}({\mathbf{q}}))/(\mathrm{std}_{g_{\phi_{\rm old}}}({\mathbf{q}})+\epsilon)</annotation></semantics></math> can be deleted as we have done in <math id="A3.SS2.p9.m3" class="ltx_Math" alttext="\nabla_{\phi}\mathcal{L}_{\rm{output}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>output</mi></msub></mrow><annotation encoding="application/x-tex">\nabla_{\phi}\mathcal{L}_{\rm{output}}</annotation></semantics></math>.
Since Eq. (<a href="#A3.E60" title="In Proof. ‣ C.2 Surrogate loss of output-level reward maximization ‣ Appendix C Detailed Proof ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">60</span></a>) and Eq. (<a href="#A3.E80" title="In Proof. ‣ C.2 Surrogate loss of output-level reward maximization ‣ Appendix C Detailed Proof ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">80</span></a>) are identical, we conclude <math id="A3.SS2.p9.m4" class="ltx_Math" alttext="\nabla_{\phi}\mathcal{L}_{\rm{token}}\approx\nabla_{\phi}\mathcal{L}_{\rm{output}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>token</mi></msub></mrow><mo>≈</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>output</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\phi}\mathcal{L}_{\rm{token}}\approx\nabla_{\phi}\mathcal{L}_{\rm{output}}</annotation></semantics></math> and <math id="A3.SS2.p9.m5" class="ltx_Math" alttext="\nabla_{\phi}\mathcal{L}_{\rm{token}}=\nabla_{\phi}\mathcal{L}_{\rm{output}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>token</mi></msub></mrow><mo>=</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>output</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\phi}\mathcal{L}_{\rm{token}}=\nabla_{\phi}\mathcal{L}_{\rm{output}}</annotation></semantics></math> at the first optimization step where <math id="A3.SS2.p9.m6" class="ltx_Math" alttext="\phi=\phi_{\rm{old}}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>=</mo><msub><mi>ϕ</mi><mi>old</mi></msub></mrow><annotation encoding="application/x-tex">\phi=\phi_{\rm{old}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Surrogate loss of output-level KL divergence</h3>

<div id="A3.SS3.p1" class="ltx_para ltx_noindent">
<p id="A3.SS3.p1.1" class="ltx_p">Our final goal is to provide evidence that by performing gradient ascent on <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="\mathcal{L}_{\rm{KL}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\rm{KL}}</annotation></semantics></math>, we can expect to decrease <math id="A3.SS3.p1.m2" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)</annotation></semantics></math>. We provide two propositions here. The first proposition shows that trajectory-wise KL divergence is the upper bound of output-level KL divergence. The second proposition shows that the gradient of trajectory-wise KL divergence is equivalent to <math id="A3.SS3.p1.m3" class="ltx_Math" alttext="\mathcal{L}_{\rm{KL}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\rm{KL}}</annotation></semantics></math>.</p>
</div>
<div id="Thmprop2" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop2.2" class="ltx_text ltx_font_bold">Proposition 2</span></span><span id="Thmprop2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop2.p1" class="ltx_para">
<p id="Thmprop2.p1.1" class="ltx_p"><span id="Thmprop2.p1.1.1" class="ltx_text ltx_font_italic">For MDMs where <math id="Thmprop2.p1.m1" class="ltx_math_unparsed" alttext="p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})=\sum_{{\bm{x}}_{1},...,{\bm{x}}_{L}}p_{\phi}({\bm{x}}_{0:L}|{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><msub><mo>∑</mo><mrow><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐱</mi><mi>L</mi></msub></mrow></msub><msub><mi>p</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})=\sum_{{\bm{x}}_{1},...,{\bm{x}}_{L}}p_{\phi}({\bm{x}}_{0:L}|{\mathbf{q}})</annotation></semantics></math>, consider the terminal KL divergence <math id="Thmprop2.p1.m2" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)</annotation></semantics></math> and trajectory-wise KL divergence <math id="Thmprop2.p1.m3" class="ltx_math_unparsed" alttext="D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)</annotation></semantics></math> defined as follows:</span></p>
<table id="A3.EGx42" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A3.E81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E81.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)=\mathbb{E}_{\tau\sim p_{g_{\rm{\phi}}}({\bm{x}}_{0}|{\mathbf{q}})}\biggl[\log\frac{p_{g_{\rm{\phi}}}({\bm{x}}_{0}|{\mathbf{q}})}{p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})}\biggr]," display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>τ</mi><mo>∼</mo><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>log</mi><mfrac><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)=\mathbb{E}_{\tau\sim p_{g_{\rm{\phi}}}({\bm{x}}_{0}|{\mathbf{q}})}\biggl[\log\frac{p_{g_{\rm{\phi}}}({\bm{x}}_{0}|{\mathbf{q}})}{p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})}\biggr],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(81)</span></td></tr></tbody>
<tbody id="A3.E82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E82.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}\biggl[\log\frac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})}\biggr]" display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}\biggl[\log\frac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(82)</span></td></tr></tbody>
</table>
<p id="Thmprop2.p1.2" class="ltx_p"><span id="Thmprop2.p1.2.1" class="ltx_text ltx_font_italic">Then, <math id="Thmprop2.p1.m4" class="ltx_math_unparsed" alttext="D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)</annotation></semantics></math> is upper bound of <math id="Thmprop2.p1.m5" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)</annotation></semantics></math>:</span></p>
<table id="A3.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E83.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)&lt;D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)." display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>&lt;</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)&lt;D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(83)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS3.p2" class="ltx_para">
<table id="A3.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E84.m1" class="ltx_Math" alttext="\displaystyle D_{\mathrm{KL}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>KL</mi></msub><annotation encoding="application/x-tex">\displaystyle D_{\mathrm{KL}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E84.m2" class="ltx_math_unparsed" alttext="\displaystyle\left(p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0}\mid{\mathbf{q}})\right)=\mathbb{E}_{{\bm{x}}_{0}\sim p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})}\left[\log\frac{p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0}\mid{\mathbf{q}})}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msub><mi>𝒙</mi><mn>0</mn></msub><mo>∼</mo><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0}\mid{\mathbf{q}})\right)=\mathbb{E}_{{\bm{x}}_{0}\sim p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})}\left[\log\frac{p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0}\mid{\mathbf{q}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(84)</span></td></tr></tbody>
<tbody id="A3.E85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E85.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\left[\log\frac{p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0}\mid{\mathbf{q}})}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\left[\log\frac{p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0}\mid{\mathbf{q}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(85)</span></td></tr></tbody>
<tbody id="A3.E86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E86.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\left[\log\frac{p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}-\log\frac{p_{g_{\phi}}({\bm{x}}_{1:L}\mid{\bm{x}}_{0},{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{1:L}\mid{\bm{x}}_{0},{\mathbf{q}})}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>−</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\left[\log\frac{p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}-\log\frac{p_{g_{\phi}}({\bm{x}}_{1:L}\mid{\bm{x}}_{0},{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{1:L}\mid{\bm{x}}_{0},{\mathbf{q}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(86)</span></td></tr></tbody>
<tbody id="A3.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E87.m1" class="ltx_math_unparsed" alttext="\displaystyle=D_{\mathrm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}}),|,p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>,</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=D_{\mathrm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}}),|,p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(87)</span></td></tr></tbody>
<tbody id="A3.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E88.m1" class="ltx_math_unparsed" alttext="\displaystyle-\mathbb{E}_{{\bm{x}}_{0}\sim p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})}\left[D_{\mathrm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{1:L}\mid{\bm{x}}_{0},{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{1:L}\mid{\bm{x}}_{0},{\mathbf{q}})\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>𝔼</mi><mrow><msub><mi>𝒙</mi><mn>0</mn></msub><mo>∼</mo><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\mathbb{E}_{{\bm{x}}_{0}\sim p_{g_{\phi}}({\bm{x}}_{0}\mid{\mathbf{q}})}\left[D_{\mathrm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{1:L}\mid{\bm{x}}_{0},{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{1:L}\mid{\bm{x}}_{0},{\mathbf{q}})\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(88)</span></td></tr></tbody>
<tbody id="A3.E89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E89.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq D_{\mathrm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq D_{\mathrm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(89)</span></td></tr></tbody>
</table>
<p id="A3.SS3.p2.1" class="ltx_p"><span id="A3.SS3.p2.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A3.SS3.p3" class="ltx_para ltx_noindent">
<p id="A3.SS3.p3.1" class="ltx_p">Therefore, we can lower <math id="A3.SS3.p3.m1" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\!\left(p_{g_{\phi}}({\bm{x}}_{0}|{\mathbf{q}})\,\|\,p_{g_{\mathrm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})\right)</annotation></semantics></math> by decreasing <math id="A3.SS3.p3.m2" class="ltx_math_unparsed" alttext="D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)</annotation></semantics></math>.
Now we show that <math id="A3.SS3.p3.m3" class="ltx_math_unparsed" alttext="\nabla_{\phi}D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)=\nabla_{\phi}\mathcal{L}_{\rm{KL}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>=</mo><msub><mo rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub></mrow><annotation encoding="application/x-tex">\nabla_{\phi}D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}|{\mathbf{q}})\right)=\nabla_{\phi}\mathcal{L}_{\rm{KL}}</annotation></semantics></math>:</p>
</div>
<div id="Thmprop3" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop3.2" class="ltx_text ltx_font_bold">Proposition 3</span></span><span id="Thmprop3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop3.p1" class="ltx_para">
<p id="Thmprop3.p1.1" class="ltx_p"><span id="Thmprop3.p1.1.1" class="ltx_text ltx_font_italic">Consider the trajectory-wise KL divergence <math id="Thmprop3.p1.m1" class="ltx_math_unparsed" alttext="D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)</annotation></semantics></math> and tractable <math id="Thmprop3.p1.m2" class="ltx_Math" alttext="\mathcal{L}_{\rm{KL}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\rm{KL}}</annotation></semantics></math> defined as follows:</span></p>
<table id="A3.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E90.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathcal{L}_{\rm KL}({\bm{x}}_{0:L},a_{1:L},{\mathbf{q}})={\rm StopGrad}\!\Bigl(\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\phi_{\rm old}}}({\bm{x}}_{0:L}|{\mathbf{q}})}\cdot\bigl(1+\log\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\rm ref}}({\bm{x}}_{0:L}|{\mathbf{q}})}\bigr)\Bigr)\cdot\sum_{n=1}^{L}\log g_{\phi}(a_{n}\mid{\bm{x}}_{n})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>,</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mpadded style="width:4.164em;" width="4.164em"><mi>StopGrad</mi></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>1</mn><mo>+</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mi>log</mi><msub><mi>g</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\rm KL}({\bm{x}}_{0:L},a_{1:L},{\mathbf{q}})={\rm StopGrad}\!\Bigl(\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\phi_{\rm old}}}({\bm{x}}_{0:L}|{\mathbf{q}})}\cdot\bigl(1+\log\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\rm ref}}({\bm{x}}_{0:L}|{\mathbf{q}})}\bigr)\Bigr)\cdot\sum_{n=1}^{L}\log g_{\phi}(a_{n}\mid{\bm{x}}_{n})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
</table>
<p id="Thmprop3.p1.2" class="ltx_p"><span id="Thmprop3.p1.2.1" class="ltx_text ltx_font_italic">Then, the gradient of <math id="Thmprop3.p1.m3" class="ltx_math_unparsed" alttext="D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)</annotation></semantics></math> and <math id="Thmprop3.p1.m4" class="ltx_Math" alttext="\mathbb{E}[\mathcal{L}_{\rm{KL}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\mathcal{L}_{\rm{KL}}]</annotation></semantics></math> are equal:</span></p>
<table id="A3.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E91.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla_{\phi}D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)=\nabla_{\phi}\mathbb{E}_{{\bm{x}}_{0:L},a_{0:L}\sim p_{g_{\phi_{\rm{old}}}}}[\mathcal{L}_{\rm{KL}}]" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>ϕ</mi></msub><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>=</mo><msub><mo rspace="0.167em">∇</mo><mi>ϕ</mi></msub><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub></mrow></msub><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\phi}D_{\rm{KL}}\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)=\nabla_{\phi}\mathbb{E}_{{\bm{x}}_{0:L},a_{0:L}\sim p_{g_{\phi_{\rm{old}}}}}[\mathcal{L}_{\rm{KL}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS3.p4" class="ltx_para ltx_noindent">
<table id="A3.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E92.m1" class="ltx_Math" alttext="\displaystyle D_{\rm{KL}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>KL</mi></msub><annotation encoding="application/x-tex">\displaystyle D_{\rm{KL}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E92.m2" class="ltx_math_unparsed" alttext="\displaystyle\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})||p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(92)</span></td></tr></tbody>
<tbody id="A3.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E93.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\!\left[\log\frac{p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\!\left[\log\frac{p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(93)</span></td></tr></tbody>
<tbody id="A3.E94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E94.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\!\left[\frac{p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}{p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\cdot\log\frac{p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\!\left[\frac{p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}{p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\cdot\log\frac{p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(94)</span></td></tr></tbody>
<tbody id="A3.E95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E95.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\bm{x}}_{0:L}\sim p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\!\left[\frac{p_{g_{\phi}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}{p_{g_{\phi_{\rm{old}}}}({\bm{x}}_{0:L}\mid{\mathbf{q}})}\cdot\sum_{i=1}^{L}\log\frac{p_{g_{\phi}}({\bm{x}}_{i-1}\mid{\bm{x}}_{i},{\mathbf{q}})}{p_{g_{\mathrm{ref}}}({\bm{x}}_{i-1}\mid{\bm{x}}_{i},{\mathbf{q}})}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>∼</mo><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub><