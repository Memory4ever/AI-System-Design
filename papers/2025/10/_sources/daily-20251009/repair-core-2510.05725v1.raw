<div id="alg2.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">20:</span>
              
              
               Make mini-batch <math id="alg2.l20.m1" class="ltx_Math" alttext="\{B\}_{i=1}^{b}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mi>B</mi><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><annotation encoding="application/x-tex">\{B\}_{i=1}^{b}</annotation></semantics></math> such that <math id="alg2.l20.m2" class="ltx_Math" alttext="B_{1}\cup B_{2}\cup\dots\cup B_{b}=\{1,L\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>B</mi><mn>2</mn></msub><mo>∪</mo><mi mathvariant="normal">⋯</mi><mo>∪</mo><msub><mi>B</mi><mi>b</mi></msub></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi>L</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B_{1}\cup B_{2}\cup\dots\cup B_{b}=\{1,L\}</annotation></semantics></math> and <math id="alg2.l20.m3" class="ltx_Math" alttext="B_{i}\cap B_{j}=\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mi>i</mi></msub><mo>∩</mo><msub><mi>B</mi><mi>j</mi></msub></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">B_{i}\cap B_{j}=\emptyset</annotation></semantics></math> for all <math id="alg2.l20.m4" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>

</div>
<div id="alg2.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">21:</span>
              
              
               <span id="alg2.l21.2" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l21.m1" class="ltx_Math" alttext="B\in\{B_{i}\}_{i=1}^{b}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>∈</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>B</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">B\in\{B_{i}\}_{i=1}^{b}</annotation></semantics></math> <span id="alg2.l21.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">22:</span>
              
              
                 For each <math id="alg2.l22.m1" class="ltx_Math" alttext="n\in B" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">n\in B</annotation></semantics></math> and <math id="alg2.l22.m2" class="ltx_math_unparsed" alttext="g\in\{1,..,G\}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0.0835em">.</mo><mo lspace="0.0835em" rspace="0.167em">.</mo><mo>,</mo><mi>G</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">g\in\{1,..,G\}</annotation></semantics></math>, <math id="alg2.l22.m3" class="ltx_Math" alttext="\widetilde{{\mathbf{H}}}_{n}^{(g)}\leftarrow\phi_{\rm{TF}}({\mathbf{H}}_{n}^{(g)})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>𝐇</mi><mo>~</mo></mover><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">←</mo><mrow><msub><mi>ϕ</mi><mi>TF</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐇</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\mathbf{H}}}_{n}^{(g)}\leftarrow\phi_{\rm{TF}}({\mathbf{H}}_{n}^{(g)})</annotation></semantics></math>

</div>
<div id="alg2.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">23:</span>
              
              
                 For each <math id="alg2.l23.m1" class="ltx_Math" alttext="n\in B" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">n\in B</annotation></semantics></math> and <math id="alg2.l23.m2" class="ltx_math_unparsed" alttext="g\in\{1,..,G\}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0.0835em">.</mo><mo lspace="0.0835em" rspace="0.167em">.</mo><mo>,</mo><mi>G</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">g\in\{1,..,G\}</annotation></semantics></math>, construct <math id="alg2.l23.m3" class="ltx_Math" alttext="{\mathbf{s}}_{n}^{(g)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐬</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">{\mathbf{s}}_{n}^{(g)}</annotation></semantics></math> using Eq. (<a href="#A2.E22" title="In Policy model inference process. ‣ Appendix B Training recipe in detail ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>)

</div>
<div id="alg2.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">24:</span>
              
              
                 <math id="alg2.l24.m1" class="ltx_math_unparsed" alttext="g_{\phi}(\cdot|{\bm{x}}_{n}^{(g)})\leftarrow\phi_{\rm{MLP}}({\mathbf{s}}_{n}^{(g)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝒙</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><msub><mi>ϕ</mi><mi>MLP</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐬</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{\phi}(\cdot|{\bm{x}}_{n}^{(g)})\leftarrow\phi_{\rm{MLP}}({\mathbf{s}}_{n}^{(g)})</annotation></semantics></math>

</div>
<div id="alg2.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">25:</span>
              
              
                 <math id="alg2.l25.m1" class="ltx_Math" alttext="\mathcal{L}_{\phi}\leftarrow\frac{1}{|B|}\sum_{n\in B,g\in G}\min\bigl(\frac{g_{\phi}(a_{n}^{(g)}|{\bm{x}}_{n}^{(g)})}{g_{\phi_{\rm{old}}}(a_{n}^{(g)}|{\bm{x}}_{n}^{(g)})}A_{g},\text{clip}(\frac{g_{\phi}(a_{n}^{(g)}|{\bm{x}}_{n}^{(g)})}{g_{\phi_{\rm{old}}}(a_{n}^{(g)}|{\bm{x}}_{n}^{(g)})},1-\epsilon,1+\epsilon)A_{g}\bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ϕ</mi></msub><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi>B</mi><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mrow><mi>n</mi><mo>∈</mo><mi>B</mi></mrow><mo>,</mo><mrow><mi>g</mi><mo>∈</mo><mi>G</mi></mrow></mrow></msub><mrow><mi>min</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mfrac><mrow><msub><mi>g</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>𝒙</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>𝒙</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>g</mi></msub></mrow><mo>,</mo><mrow><mtext>clip</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msub><mi>g</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>𝒙</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>𝒙</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>g</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\phi}\leftarrow\frac{1}{|B|}\sum_{n\in B,g\in G}\min\bigl(\frac{g_{\phi}(a_{n}^{(g)}|{\bm{x}}_{n}^{(g)})}{g_{\phi_{\rm{old}}}(a_{n}^{(g)}|{\bm{x}}_{n}^{(g)})}A_{g},\text{clip}(\frac{g_{\phi}(a_{n}^{(g)}|{\bm{x}}_{n}^{(g)})}{g_{\phi_{\rm{old}}}(a_{n}^{(g)}|{\bm{x}}_{n}^{(g)})},1-\epsilon,1+\epsilon)A_{g}\bigr)</annotation></semantics></math>

</div>
<div id="alg2.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">26:</span>
              
              
                 <span id="alg2.l26.2" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l26.m1" class="ltx_Math" alttext="D=\rm{CE}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mi>CE</mi></mrow><annotation encoding="application/x-tex">D=\rm{CE}</annotation></semantics></math> <span id="alg2.l26.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l27" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">27:</span>
              
              
                  <math id="alg2.l27.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\phi}\leftarrow\mathcal{L}_{\phi}-\beta\cdot\sum_{g\in G}\sum_{n\in B}{\rm{CE}}(g_{\rm{conf}}(\cdot|{\bm{x}}_{n}^{(g)})||g_{\phi}(\cdot|{\bm{x}}_{n}^{(g)}))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ϕ</mi></msub><mo stretchy="false">←</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ϕ</mi></msub><mo>−</mo><mi>β</mi><mo lspace="0.222em" rspace="0.055em">⋅</mo><msub><mo rspace="0em">∑</mo><mrow><mi>g</mi><mo>∈</mo><mi>G</mi></mrow></msub><msub><mo>∑</mo><mrow><mi>n</mi><mo>∈</mo><mi>B</mi></mrow></msub><mi>CE</mi><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>conf</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝒙</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>g</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝒙</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\phi}\leftarrow\mathcal{L}_{\phi}-\beta\cdot\sum_{g\in G}\sum_{n\in B}{\rm{CE}}(g_{\rm{conf}}(\cdot|{\bm{x}}_{n}^{(g)})||g_{\phi}(\cdot|{\bm{x}}_{n}^{(g)}))</annotation></semantics></math>

</div>
<div id="alg2.l28" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">28:</span>
              
              
                 <span id="alg2.l28.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l28.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg2.l29" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">29:</span>
              
              
                 <span id="alg2.l29.2" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l29.m1" class="ltx_Math" alttext="D=\mathcal{L}_{\rm{KL}}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub></mrow><annotation encoding="application/x-tex">D=\mathcal{L}_{\rm{KL}}</annotation></semantics></math> <span id="alg2.l29.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l30" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">30:</span>
              
              
                  <math id="alg2.l30.m1" class="ltx_Math" alttext="\mathcal{L}_{\phi}\leftarrow\mathcal{L}_{\phi}-\beta\cdot\sum_{g\in G}\kappa_{g}\sum_{n\in B}\log g_{\phi}(a_{n}^{(g)}\mid{\bm{x}}_{n}^{(g)})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ϕ</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ϕ</mi></msub><mo>−</mo><mrow><mi>β</mi><mo lspace="0.222em" rspace="0.055em">⋅</mo><mrow><msub><mo>∑</mo><mrow><mi>g</mi><mo>∈</mo><mi>G</mi></mrow></msub><mrow><msub><mi>κ</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>n</mi><mo>∈</mo><mi>B</mi></mrow></msub><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>g</mi><mi>ϕ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msubsup><mi>𝒙</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\phi}\leftarrow\mathcal{L}_{\phi}-\beta\cdot\sum_{g\in G}\kappa_{g}\sum_{n\in B}\log g_{\phi}(a_{n}^{(g)}\mid{\bm{x}}_{n}^{(g)})</annotation></semantics></math>

</div>
<div id="alg2.l31" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">31:</span>
              
              
                 <span id="alg2.l31.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l31.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg2.l32" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">32:</span>
              
              
                 Update <math id="alg2.l32.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> by performing gradient ascent on <math id="alg2.l32.m2" class="ltx_Math" alttext="\mathcal{L}_{\rm{UPO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>UPO</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\rm{UPO}}</annotation></semantics></math>

</div>
<div id="alg2.l33" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">33:</span>
              
              
               <span id="alg2.l33.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l33.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l34" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">34:</span>
              
              
              <span id="alg2.l34.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l34.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l35" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">35:</span>
              
              
            <span id="alg2.l35.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l35.3" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg2.l36" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">36:</span>
              
              
            <span id="alg2.l36.2" class="ltx_text ltx_font_bold">Output:</span> <math id="alg2.l36.m1" class="ltx_Math" alttext="g_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">g_{\phi}</annotation></semantics></math>

</div>
</div>
</figure>
<section id="A2.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Sampling algorithm.</h4>

<div id="A2.SS2.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS0.Px1.p1.1" class="ltx_p">We provide generalized sampling algorithm of large-scale MDMs in Algorithm <a href="#alg1" title="Algorithm 1 ‣ B.2 Algorithms ‣ Appendix B Training recipe in detail ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. The sampling trajectory differs by unmasking policy <math id="A2.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>, and we can perform various sampling by setting <math id="A2.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> as <math id="A2.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="g_{\rm{rand}}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>rand</mi></msub><annotation encoding="application/x-tex">g_{\rm{rand}}</annotation></semantics></math>, <math id="A2.SS2.SSS0.Px1.p1.m4" class="ltx_Math" alttext="g_{\rm{conf}}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>conf</mi></msub><annotation encoding="application/x-tex">g_{\rm{conf}}</annotation></semantics></math>, <math id="A2.SS2.SSS0.Px1.p1.m5" class="ltx_Math" alttext="g_{\rm{conf}^{\tau}}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><msup><mi>conf</mi><mi>τ</mi></msup></msub><annotation encoding="application/x-tex">g_{\rm{conf}^{\tau}}</annotation></semantics></math>, <math id="A2.SS2.SSS0.Px1.p1.m6" class="ltx_Math" alttext="g_{\rm{Top-K}}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mrow><mi>Top</mi><mo>−</mo><mi>K</mi></mrow></msub><annotation encoding="application/x-tex">g_{\rm{Top-K}}</annotation></semantics></math>, or <math id="A2.SS2.SSS0.Px1.p1.m7" class="ltx_Math" alttext="g_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">g_{\phi}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Unmasking policy training algorithm.</h4>

<div id="A2.SS2.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS0.Px2.p1.1" class="ltx_p">We provide a memory-efficient unmasking policy model training algorithm in Algorithm <a href="#alg2" title="Algorithm 2 ‣ B.2 Algorithms ‣ Appendix B Training recipe in detail ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. We have previously mentioned how we utilize the extracted features and token distribution of MDM as input to the unmasking policy model. We also have provided how the gradient of <math id="A2.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\mathcal{L}_{\rm{UPO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>UPO</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\rm{UPO}}</annotation></semantics></math> can be measured by the token-wise gradient of <math id="A2.SS2.SSS0.Px2.p1.m2" class="ltx_math_unparsed" alttext="g_{\phi}(\cdot|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{\phi}(\cdot|{\bm{x}})</annotation></semantics></math>. Summing up all techniques, we can perform training without using GPU memory more than the amount of original MDM occupies. Indeed, we have confirmed that training can be performed with only one A100 40GB GPU.</p>
</div>
<div id="A2.SS2.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS0.Px2.p2.1" class="ltx_p">Specifically, the algorithm is divided into two phases: the sampling phase and the gradient update phase. At the sampling phase, we sample various sequences from <math id="A2.SS2.SSS0.Px2.p2.m1" class="ltx_math_unparsed" alttext="p_{g_{\phi_{\rm{old}}}}(\cdot|{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{g_{\phi_{\rm{old}}}}(\cdot|{\mathbf{q}})</annotation></semantics></math>. In this phase, we gather the extracted feature of the MDM transformer, the token distribution of MDM, the mask token index, and record the probability of the trajectory. At the gradient update phase, we can perform mini-batch training where all the gradients of <math id="A2.SS2.SSS0.Px2.p2.m2" class="ltx_math_unparsed" alttext="g_{\phi}(\cdot|{\bm{x}}_{n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{\phi}(\cdot|{\bm{x}}_{n})</annotation></semantics></math> in <math id="A2.SS2.SSS0.Px2.p2.m3" class="ltx_Math" alttext="\mathcal{L}_{\rm{UPO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>UPO</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\rm{UPO}}</annotation></semantics></math> are independent of others. Furthermore, since we have gathered all the information of <math id="A2.SS2.SSS0.Px2.p2.m4" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> that is needed to update the gradient in the sampling phase, we can free the memory of MDM <math id="A2.SS2.SSS0.Px2.p2.m5" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>. The only parameters requiring forward and backward process in the gradient update phase is the unmasking policy model, which is much smaller than MDM (<span id="A2.SS2.SSS0.Px2.p2.1.1" class="ltx_text ltx_font_italic">e.g.</span>, LLaDA: 8B, corresponding policy model: 134M). Therefore, we can perform memory-efficient training. For more details, please refer to the algorithm table.</p>
</div>
</section>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Detailed Proof</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">In this section, we provide full proofs omitted in the main paper.</p>
</div>
<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>proof of KL tightening for MDM policy</h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">See <a href="#Thmthm2" title="Theorem 2 (Reference-KL Tightening for MDM Policy Improvement). ‣ 3.3 Theoretical analysis ‣ 3 Improving Unmasking Policy Beyond a Reference Policy ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></p>
</div>
<div id="A3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.p2.1" class="ltx_p"><span id="A3.SS1.p2.1.1" class="ltx_text">We first recall the GRPO policy training dynamics learning Eq. (<a href="#S3.E11" title="In 3.2 Reformulating the problem as reinforcement learning ‣ 3 Improving Unmasking Policy Beyond a Reference Policy ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) proven by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib16" title="" class="ltx_ref">Mroueh (2025)</a></cite>:</span></p>
</div>
<div id="Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma 1</span></span><span id="Thmlemma1.3" class="ltx_text ltx_font_bold"> </span>(GRPO Policy Dynamic <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">Mroueh, 2025</a>)</cite>)<span id="Thmlemma1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma1.p1" class="ltx_para">
<p id="Thmlemma1.p1.1" class="ltx_p"><span id="Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Optimal GRPO iterations policies solving Eq. (<a href="#S3.E11" title="In 3.2 Reformulating the problem as reinforcement learning ‣ 3 Improving Unmasking Policy Beyond a Reference Policy ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) satisfy the following recursion, for <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math>:</span></p>
<table id="A3.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex9.m1" class="ltx_Math" alttext="\displaystyle p_{g_{\phi_{n}}}({\bm{x}}_{0}|{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>n</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{g_{\phi_{n}}}({\bm{x}}_{0}|{\mathbf{q}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex9.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{Z_{n-1}({\mathbf{q}})}p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>Z</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{Z_{n-1}({\mathbf{q}})}p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E31.m1" class="ltx_math_unparsed" alttext="\displaystyle\cdot\exp(\frac{1}{\beta}(w_{\epsilon}^{+}(r_{g_{\phi_{n-1}}}({\mathbf{q}}))\cdot r({\mathbf{q}},{\bm{x}}_{0}))-w_{\epsilon}^{-}(r_{g_{\phi_{n-1}}}({\mathbf{q}}))\cdot(1-r({\mathbf{q}},{\bm{x}}_{0}))))" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mi>ϵ</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>w</mi><mi>ϵ</mi><mo>−</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\exp(\frac{1}{\beta}(w_{\epsilon}^{+}(r_{g_{\phi_{n-1}}}({\mathbf{q}}))\cdot r({\mathbf{q}},{\bm{x}}_{0}))-w_{\epsilon}^{-}(r_{g_{\phi_{n-1}}}({\mathbf{q}}))\cdot(1-r({\mathbf{q}},{\bm{x}}_{0}))))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="Thmlemma1.p1.2" class="ltx_p"><span id="Thmlemma1.p1.2.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="A3.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E32.m1" class="ltx_math_unparsed" alttext="\displaystyle Z_{n-1}({\mathbf{q}})=r_{g_{\rm{ref}}}({\mathbf{q}})\exp(\frac{1}{\beta}(w_{\epsilon}^{+}(r_{g_{\phi_{n-1}}}({\mathbf{q}}))+(1-r_{g_{\rm{ref}}})({\mathbf{q}})\exp(-\frac{1}{\beta}(w_{\epsilon}^{-}(r_{g_{\phi_{n-1}}}({\mathbf{q}}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>r</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>exp</mi><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mi>ϵ</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>r</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mi>ϵ</mi><mo>−</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{n-1}({\mathbf{q}})=r_{g_{\rm{ref}}}({\mathbf{q}})\exp(\frac{1}{\beta}(w_{\epsilon}^{+}(r_{g_{\phi_{n-1}}}({\mathbf{q}}))+(1-r_{g_{\rm{ref}}})({\mathbf{q}})\exp(-\frac{1}{\beta}(w_{\epsilon}^{-}(r_{g_{\phi_{n-1}}}({\mathbf{q}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="Thmlemma1.p1.3" class="ltx_p"><span id="Thmlemma1.p1.3.1" class="ltx_text ltx_font_italic">and <math id="Thmlemma1.p1.m2" class="ltx_Math" alttext="w_{\epsilon}^{+}(r)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mi>ϵ</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w_{\epsilon}^{+}(r)</annotation></semantics></math> and <math id="Thmlemma1.p1.m3" class="ltx_Math" alttext="w_{\epsilon}^{-}(r)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mi>ϵ</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w_{\epsilon}^{-}(r)</annotation></semantics></math> are defined as follows:</span></p>
<table id="A3.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E33.m1" class="ltx_Math" alttext="\displaystyle w_{\epsilon}^{+}(r)=\frac{1-r}{r(1-r)+\epsilon},\;\;\;\;w_{\epsilon}^{-}(r)=\frac{r}{r(1-r)+\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>w</mi><mi>ϵ</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow><mo rspace="1.287em">,</mo><mrow><mrow><msubsup><mi>w</mi><mi>ϵ</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mi>r</mi><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle w_{\epsilon}^{+}(r)=\frac{1-r}{r(1-r)+\epsilon},\;\;\;\;w_{\epsilon}^{-}(r)=\frac{r}{r(1-r)+\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.p3" class="ltx_para">
<p id="A3.SS1.p3.1" class="ltx_p"><span id="A3.SS1.p3.1.1" class="ltx_text">Under Theorem <a href="#Thmthm1" title="Theorem 1 (Restatement of GRPO convergence theorem ( , )). ‣ 3.3 Theoretical analysis ‣ 3 Improving Unmasking Policy Beyond a Reference Policy ‣ Improving Discrete Diffusion Unmasking Policies Beyond Explicit Reference Policies" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, at the fixed point, we can substitute the converged policy into the recursion and compare the two KL terms. The next steps simply expand the KL difference.
Then, for the convergence point where <math id="A3.SS1.p3.m1" class="ltx_Math" alttext="\lim_{n\rightarrow{\infty}}r_{g_{\phi_{n}}}=r_{g^{*}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msub><mi>r</mi><msub><mi>g</mi><msub><mi>ϕ</mi><mi>n</mi></msub></msub></msub></mrow><mo>=</mo><msub><mi>r</mi><msup><mi>g</mi><mo>∗</mo></msup></msub></mrow><annotation encoding="application/x-tex">\lim_{n\rightarrow{\infty}}r_{g_{\phi_{n}}}=r_{g^{*}}</annotation></semantics></math>:</span></p>
<table id="A3.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E34.m1" class="ltx_Math" alttext="\displaystyle D_{\rm{KL}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>KL</mi></msub><annotation encoding="application/x-tex">\displaystyle D_{\rm{KL}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E34.m2" class="ltx_math_unparsed" alttext="\displaystyle(p_{\rm{\theta^{*}}}({\bm{x}}_{0}|{\mathbf{q}})||p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}}))-D_{\rm{KL}}(p_{\rm{\theta^{*}}}({\bm{x}}_{0}|{\mathbf{q}})||p_{g_{\phi^{*}}}({\bm{x}}_{0}|{\mathbf{q}}))" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(p_{\rm{\theta^{*}}}({\bm{x}}_{0}|{\mathbf{q}})||p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}}))-D_{\rm{KL}}(p_{\rm{\theta^{*}}}({\bm{x}}_{0}|{\mathbf{q}})||p_{g_{\phi^{*}}}({\bm{x}}_{0}|{\mathbf{q}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
<tbody id="A3.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{p_{\theta^{*}}}[\log p_{\theta^{*}}({\bm{x}}_{0}|{\mathbf{q}})-\log p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})]-\mathbb{E}_{p_{\theta^{*}}}[\log p_{\theta^{*}}({\bm{x}}_{0}|{\mathbf{q}})-\log p_{g_{\phi^{*}}}({\bm{x}}_{0}|{\mathbf{q}})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><msub><mi>p</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><msub><mi>p</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><msub><mi>g</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{p_{\theta^{*}}}[\log p_{\theta^{*}}({\bm{x}}_{0}|{\mathbf{q}})-\log p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})]-\mathbb{E}_{p_{\theta^{*}}}[\log p_{\theta^{*}}({\bm{x}}_{0}|{\mathbf{q}})-\log p_{g_{\phi^{*}}}({\bm{x}}_{0}|{\mathbf{q}})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
<tbody id="A3.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E36.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{p_{\theta^{*}}}[\log p_{g_{\phi^{*}}}({\bm{x}}_{0}|{\mathbf{q}})-\log p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>p</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><msub><mi>g</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{p_{\theta^{*}}}[\log p_{g_{\phi^{*}}}({\bm{x}}_{0}|{\mathbf{q}})-\log p_{g_{\rm{ref}}}({\bm{x}}_{0}|{\mathbf{q}})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
<tbody id="A3.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E37.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{p_{\theta^{*}}}[\frac{1}{\beta}(w_{\epsilon}^{+}(r_{g_{\phi^{*}}}({\mathbf{q}}))\cdot r({\mathbf{q}},{\bm{x}}_{0}))-w_{\epsilon}^{-}(r_{g_{\phi^{*}}}({\mathbf{q}}))\cdot(1-r({\mathbf{q}},{\bm{x}}_{0}))]-\log Z_{\phi^{*}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><msub><mi>p</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>w</mi><mi>ϵ</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><msub><mi>g</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msubsup><mi>w</mi><mi>ϵ</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><msub><mi>g</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><msup><mi>ϕ</mi><mo>∗</mo></msup></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{p_{\theta^{*}}}[\frac{1}{\beta}(w_{\epsilon}^{+}(r_{g_{\phi^{*}}}({\mathbf{q}}))\cdot r({\mathbf{q}},{\bm{x}}_{0}))-w_{\epsilon}^{-}(r_{g_{\phi^{*}}}({\mathbf{q}}))\cdot(1-r({\mathbf{q}},{\bm{x}}_{0}))]-\log Z_{\phi^{*}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
