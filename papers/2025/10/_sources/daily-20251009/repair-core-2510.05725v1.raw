<span id="S3.T1.p3.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">Top-K Realization</span></span>
<span id="S3.T1.p3.1.2.1.2" class="ltx_tr">
<span id="S3.T1.p3.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="S3.T1.p3.m1" class="ltx_Math" alttext="g_{\rm Top\text{-}K}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mrow><mi>Top</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msub><annotation encoding="application/x-tex">g_{\rm Top\text{-}K}</annotation></semantics></math></span></span>
</span></span><span id="S3.T1.p3.1.3" class="ltx_text"></span></span>
</span></span></span></span>
<span id="S3.T1.2.1.1.1.2" class="ltx_tr">
<span id="S3.T1.2.1.1.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S3.T1.2.1.1.1.2.1.1" class="ltx_text"></span> <span id="S3.T1.2.1.1.1.2.1.2" class="ltx_text">
<span id="S3.T1.2.1.1.1.2.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T1.2.1.1.1.2.1.2.1.1" class="ltx_tr">
<span id="S3.T1.2.1.1.1.2.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">Divergence</span></span>
<span id="S3.T1.2.1.1.1.2.1.2.1.2" class="ltx_tr">
<span id="S3.T1.2.1.1.1.2.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="S3.T1.m6" class="ltx_math_unparsed" alttext="D(p_{g_{\phi}}\!||p_{g_{\rm ref}})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(p_{g_{\phi}}\!||p_{g_{\rm ref}})</annotation></semantics></math></span></span>
</span></span><span id="S3.T1.2.1.1.1.2.1.3" class="ltx_text"></span></span>
<span id="S3.T1.2.1.1.1.2.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S3.T1.2.1.1.1.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:111.3pt;">
<span id="S3.T1.2.1.1.1.2.2.1.1" class="ltx_p ltx_align_center">Cross-Entropy Loss</span>
</span></span>
<span id="S3.T1.2.1.1.1.2.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t ltx_colspan ltx_colspan_2" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S3.T1.2.1.1.1.2.3.1" class="ltx_inline-block ltx_align_center ltx_align_middle ltx_transformed_outer" style="width:254.4pt;height:19.5pt;vertical-align:-8.9pt;"><span class="ltx_transformed_inner" style="transform:translate(-25.4pt,1.2pt) scale(0.886825232464337,0.886825232464337) ;">
<span id="S3.T1.2.1.1.1.2.3.1.1" class="ltx_p"><math id="S3.T1.m7" class="ltx_math_unparsed" alttext="\mathcal{L}_{\rm KL}({\bm{x}}_{0:L},a_{1:L},{\mathbf{q}})={\rm StopGrad}\!\Bigl(\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\phi_{\rm old}}}({\bm{x}}_{0:L}|{\mathbf{q}})}\cdot\bigl(1+\log\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\rm ref}}({\bm{x}}_{0:L}|{\mathbf{q}})}\bigr)\Bigr)\cdot\sum_{n=1}^{L}\log g_{\phi}(a_{n}\mid{\bm{x}}_{n})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo>,</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mpadded style="width:4.164em;" width="4.164em"><mi>StopGrad</mi></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>1</mn><mo>+</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mfrac><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo rspace="0.055em">⋅</mo><msubsup><mo>∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><mi>log</mi><msub><mi>g</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒙</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\rm KL}({\bm{x}}_{0:L},a_{1:L},{\mathbf{q}})={\rm StopGrad}\!\Bigl(\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\phi_{\rm old}}}({\bm{x}}_{0:L}|{\mathbf{q}})}\cdot\bigl(1+\log\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L}|{\mathbf{q}})}{p_{g_{\rm ref}}({\bm{x}}_{0:L}|{\mathbf{q}})}\bigr)\Bigr)\cdot\sum_{n=1}^{L}\log g_{\phi}(a_{n}\mid{\bm{x}}_{n})</annotation></semantics></math></span>
</span></span></span></span>
<span id="S3.T1.2.1.1.1.3" class="ltx_tr">
<span id="S3.T1.2.1.1.1.3.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><span id="S3.T1.2.1.1.1.3.1.1" class="ltx_text"></span> <span id="S3.T1.2.1.1.1.3.1.2" class="ltx_text">
