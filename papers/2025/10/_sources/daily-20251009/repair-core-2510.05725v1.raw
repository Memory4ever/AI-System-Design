<div id="alg2.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">17:</span>
              
              
                  <math id="alg2.l17.m1" class="ltx_math_unparsed" alttext="\kappa_{g}\leftarrow\Bigl(\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L})}{p_{g_{\phi_{\rm old}}}({\bm{x}}_{0:L})}\cdot\bigl(1+\log\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L})}{p_{g_{\rm ref}}({\bm{x}}_{0:L})}\bigr)\Bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>g</mi></msub><mo stretchy="false">←</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><msub><mi>ϕ</mi><mi>old</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>1</mn><mo>+</mo><mi>log</mi><mfrac><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ϕ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><msub><mi>g</mi><mi>ref</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mfrac><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{g}\leftarrow\Bigl(\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L})}{p_{g_{\phi_{\rm old}}}({\bm{x}}_{0:L})}\cdot\bigl(1+\log\tfrac{p_{g_{\phi}}({\bm{x}}_{0:L})}{p_{g_{\rm ref}}({\bm{x}}_{0:L})}\bigr)\Bigr)</annotation></semantics></math>

