<td id="S4.T1.2.2.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T1.2.2.9.1" class="ltx_text ltx_font_bold">mAP</span></td>
<td id="S4.T1.2.2.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.10.1" class="ltx_text ltx_font_bold">R@1</span></td>
<td id="S4.T1.2.2.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.11.1" class="ltx_text ltx_font_bold">R@5</span></td>
<td id="S4.T1.2.2.12" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.12.1" class="ltx_text ltx_font_bold">R@10</span></td>
