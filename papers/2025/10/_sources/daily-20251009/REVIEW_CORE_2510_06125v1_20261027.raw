<td id="S6.T7.2.5.2" class="ltx_td ltx_align_left ltx_border_bb">0.0010</td>
<td id="S6.T7.2.5.3" class="ltx_td ltx_align_left ltx_border_bb">0.0030</td>
<td id="S6.T7.2.5.4" class="ltx_td ltx_align_left ltx_border_bb">0.1%</td>
