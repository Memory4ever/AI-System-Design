<td id="S7.T9.5.4.3" class="ltx_td ltx_align_left"><span id="S7.T9.5.4.3.1" class="ltx_text" style="font-size:90%;">1307</span></td></tr>
<tr id="S7.T9.5.5" class="ltx_tr">
<th id="S7.T9.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S7.T9.5.5.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Female: Recid</span></th>
<td id="S7.T9.5.5.2" class="ltx_td ltx_align_left"><span id="S7.T9.5.5.2.1" class="ltx_text" style="font-size:90%;">1426</span></td>
<td id="S7.T9.5.5.3" class="ltx_td ltx_align_left"><span id="S7.T9.5.5.3.1" class="ltx_text" style="font-size:90%;">1391</span></td></tr>
