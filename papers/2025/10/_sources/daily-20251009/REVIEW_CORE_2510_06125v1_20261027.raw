<th id="S6.T7.2.2.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S6.T7.2.2.3.1" class="ltx_text ltx_font_bold">Pruned</span></th>
<th id="S6.T7.2.2.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S6.T7.2.2.4.1" class="ltx_text ltx_font_bold">Quantized</span></th>
<th id="S6.T7.2.2.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S6.T7.2.2.5.1" class="ltx_text ltx_font_bold">Pruned</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T7.2.3" class="ltx_tr">
<th id="S6.T7.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">COMPAS</th>
<td id="S6.T7.2.3.2" class="ltx_td ltx_align_left ltx_border_t">0.0092</td>
<td id="S6.T7.2.3.3" class="ltx_td ltx_align_left ltx_border_t">0.0001</td>
<td id="S6.T7.2.3.4" class="ltx_td ltx_align_left ltx_border_t">0.9%</td>
<td id="S6.T7.2.3.5" class="ltx_td ltx_align_left ltx_border_t">1.2%</td></tr>
