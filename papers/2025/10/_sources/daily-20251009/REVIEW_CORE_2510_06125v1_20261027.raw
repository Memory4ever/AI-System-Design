<th id="S4.T3.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Age <math id="S4.T3.m1" class="ltx_Math" alttext="&lt;" display="inline" intent=":literal"><semantics><mo>&lt;</mo><annotation encoding="application/x-tex">&lt;</annotation></semantics></math> 35</th>
<td id="S4.T3.2.6.2" class="ltx_td ltx_align_right">45,859</td></tr>
<tr id="S4.T3.2.7" class="ltx_tr">
