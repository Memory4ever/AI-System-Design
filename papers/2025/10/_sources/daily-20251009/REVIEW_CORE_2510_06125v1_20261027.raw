<tr id="S6.T6.4.1.5" class="ltx_tr">
<td id="S6.T6.4.1.5.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="S6.T6.4.1.5.1.1" class="ltx_text">Trauma</span></td>
