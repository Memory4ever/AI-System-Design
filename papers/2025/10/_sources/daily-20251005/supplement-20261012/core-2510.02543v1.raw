<figure id="S3.F2" class="ltx_figure"><img src="2510.02543v1/imgs/klocr-mixture.png" id="S3.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:215/139;" width="215" height="139" alt="Refer to caption">
