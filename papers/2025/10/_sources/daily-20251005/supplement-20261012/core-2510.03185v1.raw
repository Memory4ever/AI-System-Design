<span id="A7.SS3.p2.pic1.2.27" class="ltx_p"><span id="A7.SS3.p2.pic1.2.27.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;"> "incorrect_expressions": [
</span></span>
<span id="A7.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<span id="A7.Ex68"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex68.m1" class="ltx_Math" alttext="\displaystyle\qquad E_{i}=E_{0}\cos\!\left(\omega t-kz\right),\quad\omega=2\pi\nu,\quad k=\tfrac{\omega}{c}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:1.216em;" width="1.216em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">cos</mi></mpadded><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ν</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mfrac></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad E_{i}=E_{0}\cos\!\left(\omega t-kz\right),\quad\omega=2\pi\nu,\quad k=\tfrac{\omega}{c},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex69"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex69.m1" class="ltx_Math" alttext="\displaystyle\qquad\phi_{i}(t)=\omega t-k(Vt)=\omega t-\tfrac{\omega}{c}Vt=\omega t\!\left(1-\tfrac{V}{c}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.191em;" width="0.191em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\phi_{i}(t)=\omega t-k(Vt)=\omega t-\tfrac{\omega}{c}Vt=\omega t\!\left(1-\tfrac{V}{c}\right),</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex70"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex70.m1" class="ltx_Math" alttext="\displaystyle\qquad\omega^{\prime}-k^{\prime}V=\omega\!\left(1-\tfrac{V}{c}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mpadded style="width:0.488em;" width="0.488em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi></mpadded><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\omega^{\prime}-k^{\prime}V=\omega\!\left(1-\tfrac{V}{c}\right),</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex71"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex71.m1" class="ltx_Math" alttext="\displaystyle\qquad\omega^{\prime}=\omega\frac{1-\tfrac{V}{c}}{1-\tfrac{nV}{c}}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mfrac></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mfrac></mrow></mfrac></mstyle></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\omega^{\prime}=\omega\frac{1-\tfrac{V}{c}}{1-\tfrac{nV}{c}},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex72"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex72.m1" class="ltx_Math" alttext="\displaystyle\qquad\nu^{\prime}=\nu\frac{1-\tfrac{V}{c}}{1-\tfrac{nV}{c}}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ν</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ν</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mfrac></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mfrac></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\nu^{\prime}=\nu\frac{1-\tfrac{V}{c}}{1-\tfrac{nV}{c}}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
