<div id="lstnumberx163" class="ltx_listingline"><span id="lstnumberx163.1" class="ltx_text ltx_lst_space">        </span>”<span id="lstnumberx163.2" class="ltx_text ltx_lst_identifier">formula</span>”:<span id="lstnumberx163.3" class="ltx_text ltx_lst_space"> </span>”<span id="lstnumberx163.4" class="ltx_text ltx_lst_identifier">$$</span>-\<span id="lstnumberx163.5" class="ltx_text ltx_lst_identifier">varepsilon_0</span><span id="lstnumberx163.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx163.7" class="ltx_text ltx_lst_identifier">A</span><span id="lstnumberx163.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx163.9" class="ltx_text ltx_lst_identifier">b</span><span id="lstnumberx163.10" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx163.11" class="ltx_text ltx_lst_identifier">cdot</span><span id="lstnumberx163.12" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx163.13" class="ltx_text ltx_lst_identifier">frac</span>{1}{<span id="lstnumberx163.14" class="ltx_text ltx_lst_identifier">b</span>}<span id="lstnumberx163.15" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx163.16" class="ltx_text ltx_lst_identifier">cdot</span><span id="lstnumberx163.17" class="ltx_text ltx_lst_space"> </span>2<span id="lstnumberx163.18" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx163.19" class="ltx_text ltx_lst_identifier">cdot</span><span id="lstnumberx163.20" class="ltx_text ltx_lst_space"> </span>2\<span id="lstnumberx163.21" class="ltx_text ltx_lst_identifier">pi</span><span id="lstnumberx163.22" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx163.23" class="ltx_text ltx_lst_space"> </span>-4\<span id="lstnumberx163.24" class="ltx_text ltx_lst_identifier">pi</span><span id="lstnumberx163.25" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx163.26" class="ltx_text ltx_lst_identifier">varepsilon_0</span><span id="lstnumberx163.27" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx163.28" class="ltx_text ltx_lst_identifier">A$$</span>”,
</div>
