<td id="S6.T1.2.1.4.7" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#F2F9FF;padding-left:4.0pt;padding-right:4.0pt;"><span id="S6.T1.2.1.4.7.1" class="ltx_text" style="--ltx-bg-color:#F2F9FF;">50.21</span></td>
