<span id="A7.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<span id="A7.Ex76"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex76.m1" class="ltx_Math" alttext="\displaystyle\qquad\frac{\partial L}{\partial r}=mr\dot{\theta}^{2}+\frac{k}{r^{2}}-\frac{k^{\prime}}{r^{3}}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">˙</mo></mover><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msup></mfrac></mstyle></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\frac{\partial L}{\partial r}=mr\dot{\theta}^{2}+\frac{k}{r^{2}}-\frac{k^{\prime}}{r^{3}},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex77"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex77.m1" class="ltx_Math" alttext="\displaystyle\qquad m\ddot{r}=mr\dot{\theta}^{2}+\frac{k}{r^{2}}-\frac{k^{\prime}}{r^{3}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">¨</mo></mover></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">˙</mo></mover><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad m\ddot{r}=mr\dot{\theta}^{2}+\frac{k}{r^{2}}-\frac{k^{\prime}}{r^{3}}</annotation></semantics></math></span>
