<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex115.m1" class="ltx_Math" alttext="\displaystyle\qquad A=\tfrac{1}{\lambda^{2}\sigma_{t}^{2}T}," display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad A=\tfrac{1}{\lambda^{2}\sigma_{t}^{2}T},</annotation></semantics></math></span>
