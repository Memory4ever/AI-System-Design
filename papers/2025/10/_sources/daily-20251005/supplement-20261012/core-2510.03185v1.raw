<span id="A7.Ex117"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex117.m1" class="ltx_Math" alttext="\displaystyle\qquad x=\tfrac{12}{10^{-12}N_{A}}\cdot\tfrac{T_{1/2}^{3}}{(\ln 2)^{3}\sigma_{t}^{2}T}\cdot e^{\lambda t}," display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn><mrow><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi></msub></mrow></mfrac><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msubsup><mrow><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo lspace="0.167em">⁡</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mfrac><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad x=\tfrac{12}{10^{-12}N_{A}}\cdot\tfrac{T_{1/2}^{3}}{(\ln 2)^{3}\sigma_{t}^{2}T}\cdot e^{\lambda t},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex118"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex118.m1" class="ltx_Math" alttext="\displaystyle\qquad x=\tfrac{12\cdot(5730)^{3}}{10^{-12}\cdot 6.023\times 10^{23}\cdot(\ln 2)^{3}\cdot 2500}\cdot e^{(\ln 2)\cdot 5000/5730}," display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5730</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msup></mrow><mrow><mrow><mrow><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></mrow></msup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">6.023</mn></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">23</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo lspace="0.167em">⁡</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">⋅</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2500</mn></mrow></mfrac><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo lspace="0.167em">⁡</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">⋅</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5000</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5730</mn></mrow></msup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad x=\tfrac{12\cdot(5730)^{3}}{10^{-12}\cdot 6.023\times 10^{23}\cdot(\ln 2)^{3}\cdot 2500}\cdot e^{(\ln 2)\cdot 5000/5730},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex119"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex119.m1" class="ltx_Math" alttext="\displaystyle\qquad\lambda^{2}\sigma_{t}^{2}TA^{2}-A-A_{B}=0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\lambda^{2}\sigma_{t}^{2}TA^{2}-A-A_{B}=0,</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex120"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex120.m1" class="ltx_Math" alttext="\displaystyle\qquad A=\tfrac{1+\sqrt{1+4\lambda^{2}\sigma_{t}^{2}TA_{B}}}{2\lambda^{2}\sigma_{t}^{2}T}," display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></msub></mrow></mrow></msqrt></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad A=\tfrac{1+\sqrt{1+4\lambda^{2}\sigma_{t}^{2}TA_{B}}}{2\lambda^{2}\sigma_{t}^{2}T},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex121"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex121.m1" class="ltx_Math" alttext="\displaystyle\qquad N=\tfrac{1+\sqrt{1+4\lambda^{2}\sigma_{t}^{2}TA_{B}}}{2\lambda^{3}\sigma_{t}^{2}T}," display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></msub></mrow></mrow></msqrt></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad N=\tfrac{1+\sqrt{1+4\lambda^{2}\sigma_{t}^{2}TA_{B}}}{2\lambda^{3}\sigma_{t}^{2}T},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex122"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex122.m1" class="ltx_Math" alttext="\displaystyle\qquad x=\tfrac{12}{10^{-12}N_{A}}\cdot\tfrac{1+\sqrt{1+4\lambda^{2}\sigma_{t}^{2}TA_{B}}}{2\lambda^{3}\sigma_{t}^{2}T}\cdot e^{\lambda t}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn><mrow><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi></msub></mrow></mfrac><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></msub></mrow></mrow></msqrt></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mfrac><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad x=\tfrac{12}{10^{-12}N_{A}}\cdot\tfrac{1+\sqrt{1+4\lambda^{2}\sigma_{t}^{2}TA_{B}}}{2\lambda^{3}\sigma_{t}^{2}T}\cdot e^{\lambda t}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A7.SS3.p6.pic1.2.4" class="ltx_p"><span id="A7.SS3.p6.pic1.2.4.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;"> ],
<br class="ltx_break" style="--ltx-break-space:5.0pt;"><span id="A7.SS3.p6.pic1.2.4.1.1" class="ltx_text ltx_font_serif">
</span></span></span>
<span id="A7.SS3.p6.pic1.2.5" class="ltx_p"><span id="A7.SS3.p6.pic1.2.5.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">"related_correct_expressions": [<span id="A7.SS3.p6.pic1.2.5.1.1" class="ltx_text ltx_font_serif">
</span></span></span>
<span id="A7.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<span id="A7.Ex123"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex123.m1" class="ltx_Math" alttext="\displaystyle\qquad A=\lambda N," display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad A=\lambda N,</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex124"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex124.m1" class="ltx_Math" alttext="\displaystyle\qquad\tfrac{dA}{dt}=-\lambda A," display="inline" intent=":literal"><semantics><mrow><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\tfrac{dA}{dt}=-\lambda A,</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex125"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex125.m1" class="ltx_Math" alttext="\displaystyle\qquad\lambda=\tfrac{\ln 2}{T_{1/2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo lspace="0.167em">⁡</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></msub></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\lambda=\tfrac{\ln 2}{T_{1/2}},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex126"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex126.m1" class="ltx_Math" alttext="\displaystyle\qquad N=N_{0}e^{-\lambda t}," display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></mrow></msup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad N=N_{0}e^{-\lambda t},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="A7.Ex127"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_eqn_cell"></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex127.m1" class="ltx_Math" alttext="\displaystyle\qquad N_{0}=10^{-12}\tfrac{xN_{A}}{12}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi></msub></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad N_{0}=10^{-12}\tfrac{xN_{A}}{12}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A7.SS3.p6.pic1.2.6" class="ltx_p"><span id="A7.SS3.p6.pic1.2.6.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;"> ],
<br class="ltx_break" style="--ltx-break-space:5.0pt;"><span id="A7.SS3.p6.pic1.2.6.1.1" class="ltx_text ltx_font_serif">
</span></span></span>
<span id="A7.SS3.p6.pic1.2.7" class="ltx_p"><span id="A7.SS3.p6.pic1.2.7.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">"rationale": "The student mixed time units: <math id="A7.SS3.p6.pic1.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> and <math id="A7.SS3.p6.pic1.m2" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math> are in years while the counting time <math id="A7.SS3.p6.pic1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> was used in hours, so formulas combining <math id="A7.SS3.p6.pic1.m4" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> and <math id="A7.SS3.p6.pic1.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> (e.g. A = 1/(<math id="A7.SS3.p6.pic1.m6" class="ltx_Math" alttext="\lambda^{2}\sigma_{t}^{2}T" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><annotation encoding="application/x-tex">\lambda^{2}\sigma_{t}^{2}T</annotation></semantics></math>) and subsequent N and x expressions) are dimensionally inconsistent. The algebraic manipulations themselves are otherwise coherent, but the unit mismatch renders the numerical/physical results incorrect. The same unit inconsistency propagates into the background-case quadratic and its solutions.",
<span id="A7.SS3.p6.pic1.2.7.1.1" class="ltx_text ltx_font_serif">
</span></span></span><pre id="A7.SS3.p6.pic1.2.8" class="ltx_verbatim ltx_font_typewriter" style="--ltx-fg-color:#000000;">}
</pre>
</span></span></span></foreignObject></g></g></svg></span>
</div>
