<br class="ltx_break"><a href="https://huggingface.co/meta-llama/Llama-3.3-70B-Instruct" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/meta-llama/Llama-3.3-70B-Instruct</a></p>
</div></li>
<li id="A2.I1.i10" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i10.p1" class="ltx_para">
<p id="A2.I1.i10.p1.1" class="ltx_p"><span id="A2.I1.i10.p1.1.1" class="ltx_text ltx_font_bold">GLM-4</span>  <em id="A2.I1.i10.p1.1.2" class="ltx_emph ltx_font_italic">zai-org/glm-4-9b-chat-hf</em>
<br class="ltx_break"><a href="https://huggingface.co/zai-org/glm-4-9b-chat-hf" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/zai-org/glm-4-9b-chat-hf</a></p>
</div></li>
