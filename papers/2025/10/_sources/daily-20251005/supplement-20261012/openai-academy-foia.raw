f54a00d537","enabled":true}},"pageContext":{"pageLayout":null,"currentPageSource":"code","resolvedPageConfigData":null,"isLowCodePage":false},"resource":{"id":"68e19b00de8b389a9d167d6b","blogCategory":null,"category":"resource","slug":"managing-foia-requests-with-custom-gpts-2025-10-04","title":"Managing FOIA Requests with Custom GPTs ","subTitle":"See how your agency could modernize its approach to information management.","summary":null,"editorMode":"plate","content":"[{\"children\":[{\"text\":\"\",\"color\":\"rgba(0, 0, 0, 0.9)\",\"backgroundColor\":\"rgb(255, 255, 255)\"}],\"type\":\"p\",\"id\":\"Xn2ufZ31P6\"},{\"children\":[{\"text\":\"\"}],\"type\":\"media_embed\",\"url\":\"https://vimeo.com/1124514056/965e1a8c1c?share=copy\",\"defaultEmbedView\":\"\u003cdiv style=\\\"left: 0; width: 100%; height: 0; position: relative; padding-bottom: 56.338%;\\\"\u003e\u003ciframe src=\\\"https://player.vimeo.com/video/1124514056?h=965e1a8c1c\u0026app_id=122963\\\" style=\\\"top: 0; left: 0; width: 100%; height: 100%; position: absolute; border: 0;\\\" allowfullscreen scrolling=\\\"no\\\" allow=\\\"encrypted-media *;\\\"\u003e\u003c/iframe\u003e\u003c/div\u003e\",\"id\":\"6DXvZ9pjp0\"},{\"type\":\"p\",\"id\":\"SLfDGiCSh5\",\"children\":[{\"color\":\"rgba(0, 0, 0, 0.9)\",\"backgroundColor\":\"rgb(255, 255, 255)\",\"text\":\"\"}]},{\"type\":\"p\",\"id\":\"8M9Z8NdeZ2\",\"children\":[{\"color\":\"rgba(0, 0, 0, 0.9)\",\"backgroundColor\":\"rgb(255, 255, 255)\",\"text\":\"Across government, teams manage a steady flow of public information requests.\\n\\nThe process is essential, but it’s often repetitive, manual, and time-consuming.\\n\\nIn this short demo, \"},{\"target\":\"_blank\",\"type\":\"a\",\"url\":\"https://www.linkedin.com/in/lauren-oliphant-9770a09a/\",\"children\":[{\"text\":\"Lauren Oliphant\",\"color\":\"rgba(0, 0, 0, 0.9)\",\"backgroundColor\":\"rgb(255, 255, 255)\"}],\"id\":\"A_Qj_f3_0p\"},{\"text\":\" Solutions Engineer at OpenAI for Government, shows how a custom GPT can help:\\n\\n • Retrieve case details from approved data sources\\n • Flag sensitive information for review and redaction\\n • Draft courteous, constituent updates in seconds\\n\\nThe result: faster turnaround, less administrative strain, and more time for mission-critical work—while human staff retain full control over what’s released.\\n\\nSee how your agency could modernize its approach to information management.\\n\\nWatch the demo and learn how to get started with a custom GPT.\",\"color\":\"rgba(0, 0, 0, 0.9)\",\"backgroundColor\":\"rgb(255, 255, 255)\"}]}]","coverUrl":"https://d2xo500swnpgl1.cloudfront.net/uploads/oaiacademy/cover-image-gov-3--18a279f0-6e65-431a-b04c-9da67f17adc1-1759616127422.jpeg","source":null,"tags":[{"id":"6a19d33e5f0fcb71f51ef875","name":"Public \u0026 Social Impact"},{"id":"69f12749f3007cd0f6c90a77","name":"ChatGPT"},{"id":"6a19d33b5f0fcb71f51ef805","name":"Advanced \u0026 Builder Skills"},{"id":"6942ec964d73ecacc8421f3f","name":"Government"}],"gatePolicy":null,"accessPolicy":"webAccess","enableTableOfContents":true,"publishedAt":"2025-10-04T22:11:05.841Z","createdAt":"2025-10-04T22:09:04.871Z","updatedAt":"2026-05-29T18:06:57.107Z","club":null,"commentSetting":{"enableComments":false,"requireCommentsApproval":false,"enableThumbsUp":false,"displayThumbsUpMembers":false},"commentsCount":0,"voteCount":0,"voted":false,"authors":[{"id":"68128a53aa996449137be47e","avatarUrl":"https://d2xo500swnpgl1.cloudfront.net/uploads/oaiacademy/E03025Z7DT4-U08N36M5L7Q-6510f753fd0d-512-0bd0eccc-234b-49fb-8bef-3d4cbc1917f3-1746045521402.jpeg","displayName":"Lauren Oliphant","title":"Solutions Engineer","company":"OpenAI","linkedInUrl":"https://www.linkedin.com/in/lauren-oliphant-9770a09a/","bio":null}],"externalUrl":null,"relatedContents":{"popularContents":{"totalCount":395,"records":[{"id":"67dc1fe4f70f9645ce77a899","slug":"organization-and-automation-managing-time-and-tasks-with-ai-2025-03-20","title":"Organization and Automation: Managing Time 