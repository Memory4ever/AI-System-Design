<td id="S5.T7.1.1.2" class="ltx_td ltx_align_center ltx_border_tt">Success Rate</td></tr>
<tr id="S5.T7.1.2" class="ltx_tr">
<th id="S5.T7.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">100</th>
<td id="S5.T7.1.2.2" class="ltx_td ltx_align_center ltx_border_t">62%</td></tr>
