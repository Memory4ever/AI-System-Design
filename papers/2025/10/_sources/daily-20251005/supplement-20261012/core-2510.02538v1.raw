<td id="S5.T5.1.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">-53%</td>
<td id="S5.T5.1.4.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">-24%</td>
