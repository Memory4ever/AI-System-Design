               <math id="alg1.l9.m1" class="ltx_Math" alttext="\text{policy}_{i}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mtext>policy</mtext><mi>i</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\text{policy}_{i}\leftarrow</annotation></semantics></math> <span id="alg1.l9.2" class="ltx_text ltx_underline">overtake</span>;

</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              <span id="alg1.l10.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
