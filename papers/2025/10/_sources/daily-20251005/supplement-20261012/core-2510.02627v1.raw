               <math id="alg1.l11.m1" class="ltx_Math" alttext="g_{i}^{t+1}\leftarrow g_{l,j+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">←</mo><msub><mi>g</mi><mrow><mi>l</mi><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">g_{i}^{t+1}\leftarrow g_{l,j+1}</annotation></semantics></math>;
  
</div>
<div id="alg1.l12" class="ltx_listingline">
