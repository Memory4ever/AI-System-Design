               Execute enter–pass–return sequence in lane <math id="alg1.l8.m1" class="ltx_Math" alttext="l^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>l</mi><mo>′</mo></msup><annotation encoding="application/x-tex">l^{\prime}</annotation></semantics></math>;

</div>
<div id="alg1.l9" class="ltx_listingline">
