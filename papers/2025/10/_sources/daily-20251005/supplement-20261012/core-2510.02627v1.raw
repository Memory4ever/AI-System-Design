<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In HiD2: A Trajectory Generator for High-Density Traffic and Diverse Agent-Interaction Scenarios" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
</ol></nav>
</nav>
<div class="ltx_page_main">
<div id="infobox" class="infobox">
  <a id="license-tr" href="https://info.arxiv.org/help/license/index.html#licenses-available">
