               Maintain <math id="alg1.l14.m1" class="ltx_Math" alttext="v(t+\Delta t)\approx v(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v(t+\Delta t)\approx v(t)</annotation></semantics></math>;

</div>
<div id="alg1.l15" class="ltx_listingline">
