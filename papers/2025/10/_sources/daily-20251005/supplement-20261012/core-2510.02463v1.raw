<th id="S3.T2.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:-0.5pt 3.0pt;">
<span id="S3.T2.2.1.2.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T2.2.1.2.1.1" class="ltx_p"><span id="S3.T2.2.1.2.1.1.1" class="ltx_text ltx_font_bold">Value</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T2.2.2" class="ltx_tr">
<th id="S3.T2.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-bottom: 2.0pt;padding:-0.5pt 3.0pt;">Transparency</th>
