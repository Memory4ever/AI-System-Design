<td id="Sx2.T1.1.4.2" class="ltx_td ltx_align_right">254</td>
<td id="Sx2.T1.1.4.3" class="ltx_td ltx_align_right">160</td>
<td id="Sx2.T1.1.4.4" class="ltx_td ltx_align_right">391</td>
<td id="Sx2.T1.1.4.5" class="ltx_td ltx_align_right">158</td>
<td id="Sx2.T1.1.4.6" class="ltx_td ltx_align_right">222</td>
