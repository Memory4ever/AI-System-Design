<td id="Sx2.T1.1.5.4" class="ltx_td ltx_align_right ltx_border_bb">853</td>
<td id="Sx2.T1.1.5.5" class="ltx_td ltx_align_right ltx_border_bb">298</td>
<td id="Sx2.T1.1.5.6" class="ltx_td ltx_align_right ltx_border_bb">504</td>
