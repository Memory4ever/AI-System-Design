<td id="S4.T2.3.1.5.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.3.1.5.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">80.0</span></td>
<td id="S4.T2.3.1.5.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.3.1.5.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">80.0</span></td>
<td id="S4.T2.3.1.5.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.3.1.5.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">83.3</span></td>
<td id="S4.T2.3.1.5.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.3.1.5.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">84.2</span></td></tr>
