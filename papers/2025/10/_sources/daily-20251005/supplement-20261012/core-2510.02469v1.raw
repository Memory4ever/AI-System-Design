<td id="S4.T2.3.1.5.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.3.1.5.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">88.9</span></td>
