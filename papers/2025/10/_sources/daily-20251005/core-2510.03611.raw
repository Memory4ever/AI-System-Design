<th id="S4.T3.5.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T3.5.1.1.1.1" class="ltx_text ltx_font_bold">Capability</span></th>
<th id="S4.T3.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T3.5.1.1.2.1" class="ltx_text ltx_font_bold">GPT-4o</span></th>
