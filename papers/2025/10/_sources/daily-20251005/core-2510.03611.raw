<th id="S3.T2.5.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.5.1.1.5.1" class="ltx_text ltx_font_bold">FP</span></th>
<th id="S3.T2.5.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.5.1.1.6.1" class="ltx_text ltx_font_bold">FN</span></th>
<th id="S3.T2.5.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.5.1.1.7.1" class="ltx_text ltx_font_bold">Precision</span></th>
<th id="S3.T2.5.1.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.5.1.1.8.1" class="ltx_text ltx_font_bold">Recall</span></th>
<th id="S3.T2.5.1.1.9" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.5.1.1.9.1" class="ltx_text ltx_font_bold">Memory Drift</span></th></tr>
</thead>
