</div>
<div id="alg2.l13" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
                  
                  
                <span id="alg2.l13.3" class="ltx_text ltx_font_bold" style="font-size:90%;">return</span><span id="alg2.l13.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l13.m1" class="ltx_Math" alttext="\mathcal{T}_{\text{cases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mtext mathsize="0.900em">cases</mtext></msub><annotation encoding="application/x-tex">\mathcal{T}_{\text{cases}}</annotation></semantics></math><span id="alg2.l13.5" class="ltx_text" style="font-size:90%;">
</span>
