<figure id="S3.F4.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.03611v1/figures/at_plots_colm/edge/v4/metric_drift_conn5.png" id="S3.F4.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/233;" width="476" height="233" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F4.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S3.F4.sf1.4" class="ltx_text" style="font-size:90%;">GPT-4o</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
