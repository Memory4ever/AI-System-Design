                <span id="alg1.l21.3" class="ltx_text ltx_font_bold" style="font-size:90%;">return</span><span id="alg1.l21.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l21.m1" class="ltx_Math" alttext="\mathcal{C},\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mo mathsize="0.900em">,</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi></mrow><annotation encoding="application/x-tex">\mathcal{C},\mathcal{D}</annotation></semantics></math><span id="alg1.l21.5" class="ltx_text" style="font-size:90%;">
</span>
