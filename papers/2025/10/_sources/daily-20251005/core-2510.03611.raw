<figure id="S4.F5.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.03611v1/figures/at_plots_colm/overlay/overlay_radar_conn5.png" id="S4.F5.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/405;" width="476" height="405" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F5.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S4.F5.sf2.4" class="ltx_text" style="font-size:90%;">GPT-4o(subgraph and clique)</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
