<tr id="A4.T7.2.6" class="ltx_tr">
<td id="A4.T7.2.6.1" class="ltx_td ltx_align_left ltx_border_t">Accuracy</td>
<td id="A4.T7.2.6.2" class="ltx_td ltx_border_t"></td>
