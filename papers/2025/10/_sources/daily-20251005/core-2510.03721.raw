<td id="A4.T7.2.4.2" class="ltx_td ltx_align_center">0.95</td>
<td id="A4.T7.2.4.3" class="ltx_td ltx_align_center">0.97</td>
<td id="A4.T7.2.4.4" class="ltx_td ltx_align_center">0.96</td>
<td id="A4.T7.2.4.5" class="ltx_td ltx_align_center">2500</td></tr>
<tr id="A4.T7.2.5" class="ltx_tr">
<td id="A4.T7.2.5.1" class="ltx_td ltx_align_left">Unclear</td>
<td id="A4.T7.2.5.2" class="ltx_td ltx_align_center">0.99</td>
