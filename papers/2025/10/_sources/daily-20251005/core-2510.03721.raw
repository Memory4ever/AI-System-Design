<td id="S4.T1.2.1.1.7" class="ltx_td ltx_align_left ltx_border_tt"><span id="S4.T1.2.1.1.7.1" class="ltx_text ltx_font_bold">Southeast Asian</span></td>
<td id="S4.T1.2.1.1.8" class="ltx_td ltx_align_left ltx_border_tt"><span id="S4.T1.2.1.1.8.1" class="ltx_text ltx_font_bold">White</span></td></tr>
<tr id="S4.T1.2.1.2" class="ltx_tr">
<td id="S4.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">
<div id="S4.T1.2.1.2.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:25pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:25.0pt;transform:translate(-9.0pt,-9.0pt) rotate(-90deg) ;">
<p id="S4.T1.2.1.2.1.1.1" class="ltx_p"><span id="S4.T1.2.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Male</span></p>
</span></div></td>
<td id="S4.T1.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.2.1.2.2.1" class="ltx_text"></span><span id="S4.T1.2.1.2.2.2" class="ltx_text">
<span id="S4.T1.2.1.2.2.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.2.1.2.2.2.1.1" class="ltx_tr">
<span id="S4.T1.2.1.2.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">basketball</span></span>
<span id="S4.T1.2.1.2.2.2.1.2" class="ltx_tr">
<span id="S4.T1.2.1.2.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">football</span></span>
<span id="S4.T1.2.1.2.2.2.1.3" class="ltx_tr">
<span id="S4.T1.2.1.2.2.2.1.3.1" class="ltx_td ltx_nopad_r ltx_align_left">assault/injury</span></span>
<span id="S4.T1.2.1.2.2.2.1.4" class="ltx_tr">
