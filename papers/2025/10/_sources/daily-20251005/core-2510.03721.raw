</span></span><span id="S4.T1.2.1.2.2.3" class="ltx_text"></span></td>
<td id="S4.T1.2.1.2.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.2.1.2.3.1" class="ltx_text"></span><span id="S4.T1.2.1.2.3.2" class="ltx_text">
<span id="S4.T1.2.1.2.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.2.1.2.3.2.1.1" class="ltx_tr">
<span id="S4.T1.2.1.2.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">anime/comics</span></span>
<span id="S4.T1.2.1.2.3.2.1.2" class="ltx_tr">
<span id="S4.T1.2.1.2.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">video games</span></span>
