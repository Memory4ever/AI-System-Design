<td id="A4.T7.2.3.2" class="ltx_td ltx_align_center">0.98</td>
<td id="A4.T7.2.3.3" class="ltx_td ltx_align_center">0.96</td>
<td id="A4.T7.2.3.4" class="ltx_td ltx_align_center">0.97</td>
<td id="A4.T7.2.3.5" class="ltx_td ltx_align_center">2500</td></tr>
<tr id="A4.T7.2.4" class="ltx_tr">
