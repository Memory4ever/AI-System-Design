<td id="A4.T7.2.6.4" class="ltx_td ltx_align_center ltx_border_t">0.97</td>
<td id="A4.T7.2.6.5" class="ltx_td ltx_align_center ltx_border_t">10000</td></tr>
<tr id="A4.T7.2.7" class="ltx_tr">
<td id="A4.T7.2.7.1" class="ltx_td ltx_align_left">Macro Avg</td>
