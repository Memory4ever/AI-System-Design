<figure id="S2.F5.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.03747v1/SSIM_comparison-eps-converted-to.svg" id="S2.F5.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:72/54;" width="72" height="54"></object>
