<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">TABLE III: </span>Quantitative comparison of LoRA patching and adversarial training methods in bypassing Disrupting<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>.</figcaption>
<div id="S2.T3.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:35.4pt;vertical-align:-15.9pt;"><span class="ltx_transformed_inner" style="transform:translate(-67.8pt,6.9pt) scale(0.717731695705699,0.717731695705699) ;">
<table id="S2.T3.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S2.T3.2.1.1" class="ltx_tr">
<td id="S2.T3.2.1.1.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">Methods</td>
<td id="S2.T3.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="S2.T3.m1" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math><math id="S2.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S2.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt">SSIM<math id="S2.T3.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S2.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">DSR<math id="S2.T3.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S2.T3.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt">Training Time (h) <math id="S2.T3.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S2.T3.2.1.1.6" class="ltx_td ltx_align_center ltx_border_tt">#Training Params (M) <math id="S2.T3.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
