<td id="S6.T1.4.1.3.2" class="ltx_td ltx_align_right">50%</td>
<td id="S6.T1.4.1.3.3" class="ltx_td ltx_align_right">53.33%</td>
<td id="S6.T1.4.1.3.4" class="ltx_td ltx_align_right">3.33%</td></tr>
<tr id="S6.T1.4.1.4" class="ltx_tr">
<td id="S6.T1.4.1.4.1" class="ltx_td ltx_align_left"><span id="S6.T1.4.1.4.1.1" class="ltx_text ltx_font_bold">ExpeRepair</span></td>
