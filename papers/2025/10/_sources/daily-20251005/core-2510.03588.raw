<td id="S6.T2.4.1.19.1" class="ltx_td ltx_align_left ltx_border_bbbb ltx_border_t"><span id="S6.T2.4.1.19.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">Refine</span></td>
<td id="S6.T2.4.1.19.2" class="ltx_td ltx_align_left ltx_border_bbbb ltx_border_t">Claude 3.7 Sonnet + Gemini 2.5 Pro</td>
<td id="S6.T2.4.1.19.3" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t">51.67% (155)</td>
<td id="S6.T2.4.1.19.4" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t">63.8% (319)</td>
<td id="S6.T2.4.1.19.5" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_t">85.67%</td>
