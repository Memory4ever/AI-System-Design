<td id="S5.T2.2.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S5.T2.2.1.7.1" class="ltx_text ltx_font_bold">MPMA</span></td></tr>
<tr id="S5.T2.2.2" class="ltx_tr">
<td id="S5.T2.2.2.1" class="ltx_td ltx_border_r" style="padding-top:0.25pt;padding-bottom:0.25pt;"></td>
<td id="S5.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S5.T2.2.2.2.1" class="ltx_text ltx_font_bold">Baseline</span></td>
<td id="S5.T2.2.2.3" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S5.T2.2.2.3.1" class="ltx_text ltx_font_bold">(Ours)</span></td>
<td id="S5.T2.2.2.4" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S5.T2.2.2.4.1" class="ltx_text ltx_font_bold">(Ours)</span></td>
