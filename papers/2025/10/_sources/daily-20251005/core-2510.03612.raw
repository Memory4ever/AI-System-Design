<td id="S5.T2.2.2.6" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S5.T2.2.2.6.1" class="ltx_text ltx_font_bold">(Name)</span></td>
<td id="S5.T2.2.2.7" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S5.T2.2.2.7.1" class="ltx_text ltx_font_bold">(Desc.)</span></td></tr>
