<td id="S3.T1.6.1.6.6" class="ltx_td ltx_align_center ltx_border_t">Low</td>
<td id="S3.T1.6.1.6.7" class="ltx_td ltx_align_left ltx_border_t">Mathematical Function Search</td></tr>
