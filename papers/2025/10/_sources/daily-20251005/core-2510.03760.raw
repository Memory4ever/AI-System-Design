<td id="S3.T1.6.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T1.6.1.3.3.1" class="ltx_text" style="--ltx-fg-color:#AA0000;">✘</span>/<span id="S3.T1.6.1.3.3.2" class="ltx_text" style="--ltx-fg-color:#009900;">✔<sup id="S3.T1.6.1.3.3.2.1" class="ltx_sup"><span id="S3.T1.6.1.3.3.2.1.1" class="ltx_text ltx_font_italic">‡</span></sup></span></td>
