<td id="S4.T3.4.20.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding:0.5pt 2.4pt;" colspan="6"><math id="S4.T3.m59" class="ltx_Math" alttext="\Psi=\big(\Psi_{\text{A}}+\Psi_{\text{B}}+\Psi_{\text{C}}\big)/3\;=\;\textbf{-0.0568}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em" mathvariant="normal">Ψ</mi><mo mathsize="0.800em">=</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi mathsize="0.800em" mathvariant="normal">Ψ</mi><mtext mathsize="0.800em">A</mtext></msub><mo mathsize="0.800em">+</mo><msub><mi mathsize="0.800em" mathvariant="normal">Ψ</mi><mtext mathsize="0.800em">B</mtext></msub><mo mathsize="0.800em">+</mo><msub><mi mathsize="0.800em" mathvariant="normal">Ψ</mi><mtext mathsize="0.800em">C</mtext></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.800em">3</mn></mrow><mo lspace="0.558em" mathsize="0.800em" rspace="0.558em">=</mo><mtext class="ltx_mathvariant_bold" mathsize="0.800em">-0.0568</mtext></mrow><annotation encoding="application/x-tex">\Psi=\big(\Psi_{\text{A}}+\Psi_{\text{B}}+\Psi_{\text{C}}\big)/3\;=\;\textbf{-0.0568}</annotation></semantics></math></td></tr>
