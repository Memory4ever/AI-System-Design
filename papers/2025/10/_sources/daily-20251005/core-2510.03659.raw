<span id="A2.T4.6.2.5.1.1" class="ltx_p"><span id="A2.T4.6.2.5.1.1.1" class="ltx_text" style="font-size:70%;">2</span></span>
</span></td>
<td id="A2.T4.6.2.6" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.6pt 2.0pt;">
<span id="A2.T4.6.2.6.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T4.6.2.6.1.1" class="ltx_p"><span id="A2.T4.6.2.6.1.1.1" class="ltx_text" style="font-size:70%;">18</span></span>
</span></td>
<td id="A2.T4.6.2.7" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding:0.6pt 2.0pt;">
<span id="A2.T4.6.2.7.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T4.6.2.7.1.1" class="ltx_p"><span id="A2.T4.6.2.7.1.1.1" class="ltx_text" style="font-size:70%;">10</span></span>
</span></td></tr>
<tr id="A2.T4.6.3" class="ltx_tr">
<th id="A2.T4.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.6pt 2.0pt;"><span id="A2.T4.6.3.1.1" class="ltx_text" style="font-size:70%;">Qwen-2.5-3B</span></th>
<td id="A2.T4.6.3.2" class="ltx_td ltx_align_left" style="padding:0.6pt 2.0pt;">
