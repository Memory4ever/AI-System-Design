<td id="A3.T5.15.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 4.0pt;"><span id="A3.T5.15.2.3.1" class="ltx_text" style="font-size:80%;">10</span></td>
<td id="A3.T5.15.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 4.0pt;"><span id="A3.T5.15.2.4.1" class="ltx_text" style="font-size:80%;">150</span></td></tr>
