<span id="A2.T4.6.1.3.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T4.6.1.3.1.1" class="ltx_p"><span id="A2.T4.6.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Interpretability</span></span>
</span></th>
<th id="A2.T4.6.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 2.0pt;">
<span id="A2.T4.6.1.4.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T4.6.1.4.1.1" class="ltx_p"><span id="A2.T4.6.1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Absorption</span></span>
</span></th>
