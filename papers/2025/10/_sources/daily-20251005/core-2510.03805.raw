<td id="S5.T1.2.2.7" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.0pt;">
<span id="S5.T1.2.2.7.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T1.2.2.7.1.1" class="ltx_p">ACC.</span>
</span></td>
<td id="S5.T1.2.2.8" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.0pt;">
<span id="S5.T1.2.2.8.1" class="ltx_inline-block ltx_align_top">
