<li class="ltx_tocentry ltx_tocentry_subsubsection"><a href="#S3.SS9.SSS7" title="In 3.9 Evaluation Metrics ‣ 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3.9.7 </span>Poisoning Success Rate</span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S3.SS10" title="In 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3.10 </span>Defense Method: Spectral Signature Defense</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S3.SS11" title="In 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3.11 </span>Post-Defense ICL Evaluation and Sentiment-Based Validation</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S3.SS12" title="In 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3.12 </span>Sentiment-Based Validation</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S3.SS13" title="In 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3.13 </span>Accuracy Analysis</span></a>
<ol class="ltx_toclist ltx_toclist_subsection">
<li class="ltx_tocentry ltx_tocentry_paragraph"><a href="#S3.SS13.SSS0.Px1" title="In 3.13 Accuracy Analysis ‣ 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title">Observations</span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S3.SS14" title="In 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3.14 </span>Interpretation</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S3.SS15" title="In 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3.15 </span>Post-Defense NLP Analysis</span></a>
<ol class="ltx_toclist ltx_toclist_subsection">
<li class="ltx_tocentry ltx_tocentry_subsubsection"><a href="#S3.SS15.SSS1" title="In 3.15 Post-Defense NLP Analysis ‣ 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3.15.1 </span>Sentiment Classification</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsubsection"><a href="#S3.SS15.SSS2" title="In 3.15 Post-Defense NLP Analysis ‣ 3 Methodology ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3.15.2 </span>Topic Clustering</span></a></li>
</ol></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S4" title="In “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">4 </span>Result Analysis</span></a>
<ol class="ltx_toclist ltx_toclist_section">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S4.SS1" title="In 4 Result Analysis ‣ “From Theory to Practice: Evaluating Data Poisoning Attacks and Defenses in In-Context Learning on Social Media Health Discourse" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">4.1 </span>Summary of Key Metrics</span></a></li>
