{"data":{"id":"10.48550/arxiv.2510.03093","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03093","prefix":"10.48550","suffix":"arxiv.2510.03093","identifiers":[{"identifier":"2510.03093","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.03093"}],"creators":[{"name":"Pareras, Oriol","nameType":"Personal","givenName":"Oriol","familyName":"Pareras","affiliation":[],"nameIdentifiers":[]},{"name":"Gállego, Gerard I.","nameType":"Personal","givenName":"Gerard I.","familyName":"Gállego","affiliation":[],"nameIdentifiers":[]},{"name":"Costa, Federico","nameType":"Personal","givenName":"Federico","familyName":"Costa","affiliation":[],"nameIdentifiers":[]},{"name":"España-Bonet, Cristina","nameType":"Personal","givenName":"Cristina","familyName":"España-Bonet","affiliation":[],"nameIdentifiers":[]},{"name":"Hernando, Javier","nameType":"Personal","givenName":"Javier","familyName":"Hernando","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revisiting Direct Speech-to-Text Translation with Speech LLMs: Better Scaling than CoT Prompting?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Sound (cs.SD)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T15:23:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:45:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-23T10:54:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-18T01:06:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icassp55912.2026.11464161","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Recent work on Speech-to-Text Translation (S2TT) has focused on LLM-based models, introducing the increasingly adopted Chain-of-Thought (CoT) prompting, where the model is guided to first transcribe the speech and then translate it. CoT typically outperforms direct prompting primarily because it can exploit abundant Automatic Speech Recognition (ASR) and Text-to-Text Translation (T2TT) datasets to explicitly model its steps. In this paper, we systematically compare CoT and Direct prompting under increasing amounts of S2TT data. To this end, we pseudo-label an ASR corpus by translating its transcriptions into six European languages, and train LLM-based S2TT systems with both prompting strategies at different data scales. Our results show that Direct improves more consistently as the amount of data increases, suggesting that it may become a more effective approach as larger S2TT resources are created.","descriptionType":"Abstract"},{"description":"To appear in Proc. ICASSP 2026, May 04-08, 2026, Barcelona, Spain","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.03093","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:43:45.000Z","registered":"2025-10-06T01:43:46.000Z","published":"2025","updated":"2026-08-18T