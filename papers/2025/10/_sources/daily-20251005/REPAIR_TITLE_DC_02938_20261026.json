{"data":{"id":"10.48550/arxiv.2510.02938","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02938","prefix":"10.48550","suffix":"arxiv.2510.02938","identifiers":[{"identifier":"2510.02938","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.02938"}],"creators":[{"name":"Lee, Yohan","nameType":"Personal","givenName":"Yohan","familyName":"Lee","affiliation":[],"nameIdentifiers":[]},{"name":"Song, Yongwoo","nameType":"Personal","givenName":"Yongwoo","familyName":"Song","affiliation":[],"nameIdentifiers":[]},{"name":"Kim, Sangyeop","nameType":"Personal","givenName":"Sangyeop","familyName":"Kim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Finding Diamonds in Conversation Haystacks: A Benchmark for Conversational Data Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T12:29:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:37:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-16T15:01:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-17T02:39:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We present the Conversational Data Retrieval (CDR) benchmark, the first comprehensive test set for evaluating systems that retrieve conversation data for product insights. With 1.6k queries across five analytical tasks and 9.1k conversations, our benchmark provides a reliable standard for measuring conversational data retrieval performance. Our evaluation of 16 popular embedding models shows that even the best models reach only around NDCG@10 of 0.51, revealing a substantial gap between document and conversational data retrieval capabilities. Our work identifies unique challenges in conversational data retrieval (implicit state recognition, turn dynamics, contextual references) while providing practical query templates and detailed error analysis across different task categories. The benchmark dataset and code are available at https://github.com/l-yohai/CDR-Benchmark.","descriptionType":"Abstract"},{"description":"Accepted by EMNLP 2025 Industry Track","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.02938","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-06T01:39:58.000Z","registered":"2025-10-06T01:39:58.000Z","published":"2025","updated":"2026-02-17T04:46:04.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.02938