    <p class="title is-5 mathjax">
      
        HugAgent: A Human Simulation Benchmark for Individual-Level Reasoning
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+C+J">Chance Jiajie Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Mo%2C+Z">Zhenze Mo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tang%2C+Y">Yuhan Tang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Qu%2C+A">Ao Qu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wu%2C+J">Jiayi Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhao%2C+K+I">Kaiya Ivy Zhao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gan%2C+Y">Yulu Gan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fan%2C+J">Jie Fan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yu%2C+J">Jiangbo Yu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jiang%2C+H">Hang Jiang</a>, 
      
