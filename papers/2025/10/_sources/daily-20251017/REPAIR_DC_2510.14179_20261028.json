{"data":{"id":"10.48550/arxiv.2510.14179","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.14179","prefix":"10.48550","suffix":"arxiv.2510.14179","identifiers":[{"identifier":"2510.14179","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.14179"}],"creators":[{"name":"Xu, Yuancheng","nameType":"Personal","givenName":"Yuancheng","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Xian, Wenqi","nameType":"Personal","givenName":"Wenqi","familyName":"Xian","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Li","nameType":"Personal","givenName":"Li","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Philip, Julien","nameType":"Personal","givenName":"Julien","familyName":"Philip","affiliation":[],"nameIdentifiers":[]},{"name":"Taşel, Ahmet Levent","nameType":"Personal","givenName":"Ahmet Levent","familyName":"Taşel","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Yiwei","nameType":"Personal","givenName":"Yiwei","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Burgert, Ryan","nameType":"Personal","givenName":"Ryan","familyName":"Burgert","affiliation":[],"nameIdentifiers":[]},{"name":"He, Mingming","nameType":"Personal","givenName":"Mingming","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Hermann, Oliver","nameType":"Personal","givenName":"Oliver","familyName":"Hermann","affiliation":[],"nameIdentifiers":[]},{"name":"Pilarski, Oliver","nameType":"Personal","givenName":"Oliver","familyName":"Pilarski","affiliation":[],"nameIdentifiers":[]},{"name":"Garg, Rahul","nameType":"Personal","givenName":"Rahul","familyName":"Garg","affiliation":[],"nameIdentifiers":[]},{"name":"Debevec, Paul","nameType":"Personal","givenName":"Paul","familyName":"Debevec","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Ning","nameType":"Personal","givenName":"Ning","familyName":"Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Virtually Being: Customizing Camera-Controllable Video Diffusion Models with Multi-View Performance Captures"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-16T00:20:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-17T00:15:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"We introduce a framework that enables both multi-view character consistency and 3D camera control in video diffusion models through a novel customization data pipeline. We train the character consistency component with recorded volumetric capture performances re-rendered with diverse camera trajectories via 4D Gaussian Splatting (4DGS), lighting variability obtained with a video relighting model. We fine-tune state-of-the-art open-source video diffusion models on this data to provide strong multi-view identity preservation, precise camera control, and lighting adaptability. Our framework also supports core capabilities for virtual production, including multi-subject generation using two approaches: joint training and noise blending, the latter enabling efficient composition of independently customized models at inference time; it also achieves scene and real-life video customization as well as control over motion and spatial layout during customization. Extensive experiments show improved video quality, higher personalization accuracy, and enhanced camera control and lighting adaptability, advancing the integration of video generation into virtual production. Our project page is available at: https://eyeline-labs.github.io/Virtually-Being.","descriptionType":"Abstract"},{"description":"Accepted to SIGGRAPH Asia 2025","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.14179","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-17T02:12:14.000Z","registered":"2025-10-17T02:12:15.000Z","published":"2025","updated":"2025-10-17T02:12:15.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.14179","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}