</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
              Estimate depth maps: <math id="alg1.l14.m1" class="ltx_Math" alttext="\{D_{i}^{t}\}_{i=1}^{N_{\text{views}}}\leftarrow\text{DepthNet}(I_{i}^{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>D</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>N</mi><mtext>views</mtext></msub></msubsup><mo stretchy="false">←</mo><mrow><mtext>DepthNet</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>I</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{D_{i}^{t}\}_{i=1}^{N_{\text{views}}}\leftarrow\text{DepthNet}(I_{i}^{t})</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
              Predict 3D Gaussian Parameters for each frame: <math id="alg1.l15.m1" class="ltx_Math" alttext="\mathcal{G}^{t}\leftarrow\text{GaussianNet}(I_{i}^{t},D_{i}^{t},\mathbf{P}_{i}^{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>t</mi></msup><mo stretchy="false">←</mo><mrow><mtext>GaussianNet</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>I</mi><mi>i</mi><mi>t</mi></msubsup><mo>,</mo><msubsup><mi>D</mi><mi>i</mi><mi>t</mi></msubsup><mo>,</mo><msubsup><mi>𝐏</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}^{t}\leftarrow\text{GaussianNet}(I_{i}^{t},D_{i}^{t},\mathbf{P}_{i}^{t})</annotation></semantics></math>

</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
            <span id="alg1.l16.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l16.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
            <span id="alg1.l17.3" class="ltx_text ltx_font_bold">return</span> Complete 3D dynamic scene <math id="alg1.l17.m1" class="ltx_math_unparsed" alttext="\mathcal{G}^{1:T}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{G}^{1:T}</annotation></semantics></math>

</div>
</div>
