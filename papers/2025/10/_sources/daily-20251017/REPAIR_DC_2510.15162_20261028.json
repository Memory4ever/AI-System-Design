{"data":{"id":"10.48550/arxiv.2510.15162","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.15162","prefix":"10.48550","suffix":"arxiv.2510.15162","identifiers":[{"identifier":"2510.15162","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.15162"}],"creators":[{"name":"Wang, Weizhi","nameType":"Personal","givenName":"Weizhi","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Rongmei","nameType":"Personal","givenName":"Rongmei","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Shiyang","nameType":"Personal","givenName":"Shiyang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Lockard, Colin","nameType":"Personal","givenName":"Colin","familyName":"Lockard","affiliation":[],"nameIdentifiers":[]},{"name":"Sarkhel, Ritesh","nameType":"Personal","givenName":"Ritesh","familyName":"Sarkhel","affiliation":[],"nameIdentifiers":[]},{"name":"Lokegaonkar, Sanket","nameType":"Personal","givenName":"Sanket","familyName":"Lokegaonkar","affiliation":[],"nameIdentifiers":[]},{"name":"Shang, Jingbo","nameType":"Personal","givenName":"Jingbo","familyName":"Shang","affiliation":[],"nameIdentifiers":[]},{"name":"Yan, Xifeng","nameType":"Personal","givenName":"Xifeng","familyName":"Yan","affiliation":[],"nameIdentifiers":[]},{"name":"Zalmout, Nasser","nameType":"Personal","givenName":"Nasser","familyName":"Zalmout","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xian","nameType":"Personal","givenName":"Xian","familyName":"Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Train a Unified Multimodal Data Quality Classifier with Synthetic Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-16T21:53:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-20T00:09:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The Multimodal Large Language Models (MLLMs) are continually pre-trained on a mixture of image-text caption data and interleaved document data, while the high-quality data filtering towards image-text interleaved document data is under-explored. We propose to train an efficient MLLM as a Unified Mulitmodal Data Quality Classifier to Filter both high-quality image-text caption and interleaved data (UniFilter). To address the challenge of collecting diverse labeled multimodal data, we introduce a semi-synthetic approach that leverages readily available raw images and generates corresponding text across four quality levels. This method enables efficient creation of sample-score pairs for both caption and interleaved document data to train UniFilter. We apply UniFilter to curate high-quality caption data from DataComp caption dataset and interleaved data from the OBELICS image-text interleaved dataset. MLLMs pre-trained on the filtered data demonstrate significantly enhanced capabilities compared to those trained on baseline-filtered data, achieving stronger zero-shot reasoning and in-context learning capabilities. After visual supervised fine-tuning, these UniFilter-induced MLLMs achieve stronger performance on various benchmarks, highlighting the downstream benefits of high-quality multimodal pre-training. We release the synthetic training data used for training UniFilter, the UniFilter model checkpoints, and the high-quality interleaved document subset OBELICS-HQ, curated by UniFilter, to the community for reproduction and further development.","descriptionType":"Abstract"},{"description":"EMNLP 2025 Findings","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.15162","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-20T01:35:45.000Z","registered":"2025-10-20T01:35:45.000Z","published":"2025","updated":"2025-10-20T01:35:45.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.15162","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}