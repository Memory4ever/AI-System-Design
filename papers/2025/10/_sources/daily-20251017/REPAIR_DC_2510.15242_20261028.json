{"data":{"id":"10.48550/arxiv.2510.15242","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.15242","prefix":"10.48550","suffix":"arxiv.2510.15242","identifiers":[{"identifier":"2510.15242","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.15242"}],"creators":[{"name":"Feng, Shengyu","nameType":"Personal","givenName":"Shengyu","familyName":"Feng","affiliation":[],"nameIdentifiers":[]},{"name":"He, Yun","nameType":"Personal","givenName":"Yun","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Shuang","nameType":"Personal","givenName":"Shuang","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Beibin","nameType":"Personal","givenName":"Beibin","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Xiong, Yuanhao","nameType":"Personal","givenName":"Yuanhao","familyName":"Xiong","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Songlin","nameType":"Personal","givenName":"Songlin","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Mandyam, Karishma","nameType":"Personal","givenName":"Karishma","familyName":"Mandyam","affiliation":[],"nameIdentifiers":[]},{"name":"Katz-Samuels, Julian","nameType":"Personal","givenName":"Julian","familyName":"Katz-Samuels","affiliation":[],"nameIdentifiers":[]},{"name":"Bi, Shengjie","nameType":"Personal","givenName":"Shengjie","familyName":"Bi","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Licheng","nameType":"Personal","givenName":"Licheng","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Hejia","nameType":"Personal","givenName":"Hejia","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Sankararaman, Karthik Abinav","nameType":"Personal","givenName":"Karthik Abinav","familyName":"Sankararaman","affiliation":[],"nameIdentifiers":[]},{"name":"Fang, Han","nameType":"Personal","givenName":"Han","familyName":"Fang","affiliation":[],"nameIdentifiers":[]},{"name":"Y