{"data":{"id":"10.48550/arxiv.2510.13797","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.13797","prefix":"10.48550","suffix":"arxiv.2510.13797","identifiers":[{"identifier":"2510.13797","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.13797"}],"creators":[{"name":"Monea, Giovanni","nameType":"Personal","givenName":"Giovanni","familyName":"Monea","affiliation":[],"nameIdentifiers":[]},{"name":"Feldman, Yair","nameType":"Personal","givenName":"Yair","familyName":"Feldman","affiliation":[],"nameIdentifiers":[]},{"name":"Padmanabhan, Shankar","nameType":"Personal","givenName":"Shankar","familyName":"Padmanabhan","affiliation":[],"nameIdentifiers":[]},{"name":"Brantley, Kianté","nameType":"Personal","givenName":"Kianté","familyName":"Brantley","affiliation":[],"nameIdentifiers":[]},{"name":"Artzi, Yoav","nameType":"Personal","givenName":"Yoav","familyName":"Artzi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Breadcrumbs Reasoning: Memory-Efficient Reasoning with Compression Beacons"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-15T17:57:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-16T01:07:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-10T00:06:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-11T02:07:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-29T13:06:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-30T02:06:13Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The scalability of large language models for long-context reasoning is severely constrained by the linear growth of their Transformer key-value cache, which incurs significant memory and computational costs. We posit that as a model generates reasoning tokens, the informational value of past generated tokens diminishes, creating an opportunity for compression. In this work, we propose to periodically compress the generation KV cache with a learned, special-purpose token and evict compressed entries. We train the model to perform this compression via a modified joint distillation and reinforcement learning (RL) framework. Our training method minimizes overhead over the conventional RL process, as it leverages RL outputs for distillation. Empirically, our method achieves a superior memory-accuracy Pareto frontier compared to both the model without cache compression and training-free compression techniques.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.13797","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-16T02:10:16.000Z","registered":"2025-10-16T02:10:17.000Z","published":"2025","updated":"2025-12-30T03:51:41.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.13797","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}