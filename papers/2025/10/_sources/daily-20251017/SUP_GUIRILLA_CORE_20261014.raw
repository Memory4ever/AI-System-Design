<tbody class="ltx_tbody">
<tr id="S4.T3.3.1.2" class="ltx_tr">
<td id="S4.T3.3.1.2.1" class="ltx_td ltx_align_left ltx_border_t">UI-TARS (7B)</td>
<td id="S4.T3.3.1.2.2" class="ltx_td ltx_align_left ltx_border_t">Multi-OS</td>
<td id="S4.T3.3.1.2.3" class="ltx_td ltx_align_left ltx_border_t">Real + Synthetic</td>
<td id="S4.T3.3.1.2.4" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.T3.m1" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>20M (est.)</td>
<td id="S4.T3.3.1.2.5" class="ltx_td ltx_align_left ltx_border_t">91.6%</td>
<td id="S4.T3.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t">35.7%</td>
