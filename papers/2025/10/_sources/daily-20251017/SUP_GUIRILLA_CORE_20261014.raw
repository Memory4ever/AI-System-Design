<td id="S4.T3.3.1.11.4" class="ltx_td ltx_align_left"><span id="S4.T3.3.1.11.4.1" class="ltx_text ltx_font_bold">6.8K</span></td>
<td id="S4.T3.3.1.11.5" class="ltx_td ltx_align_left"><span id="S4.T3.3.1.11.5.1" class="ltx_text ltx_font_bold">53.55%</span></td>
<td id="S4.T3.3.1.11.6" class="ltx_td ltx_align_center"><span id="S4.T3.3.1.11.6.1" class="ltx_text ltx_font_bold">7.34%</span></td>
<td id="S4.T3.3.1.11.7" class="ltx_td ltx_align_center"><span id="S4.T3.3.1.11.7.1" class="ltx_text ltx_font_bold">7.95%</span></td></tr>
