{"data":{"id":"10.48550/arxiv.2510.14467","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.14467","prefix":"10.48550","suffix":"arxiv.2510.14467","identifiers":[{"identifier":"2510.14467","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.14467"}],"creators":[{"name":"Chen, Shang-Fu","nameType":"Personal","givenName":"Shang-Fu","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Yong, Co","nameType":"Personal","givenName":"Co","familyName":"Yong","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Shao-Hua","nameType":"Personal","givenName":"Shao-Hua","familyName":"Sun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Restoring Noisy Demonstration for Imitation Learning With Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-16T09:09:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-17T00:38:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tnnls.2025.3607111.","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Imitation learning (IL) aims to learn a policy from expert demonstrations and has been applied to various applications. By learning from the expert policy, IL methods do not require environmental interactions or reward signals. However, most existing imitation learning algorithms assume perfect expert demonstrations, but expert demonstrations often contain imperfections caused by errors from human experts or sensor/control system inaccuracies. To address the above problems, this work proposes a filter-and-restore framework to best leverage expert demonstrations with inherent noise. Our proposed method first filters clean samples from the demonstrations and then learns conditional diffusion models to recover the noisy ones. We evaluate our proposed framework and existing methods in various domains, including robot arm manipulation, dexterous manipulation, and locomotion. The experiment results show that our proposed framework consistently outperforms existing methods across all the tasks. Ablation studies further validate the effectiveness of each component and demonstrate the framework's robustness to different noise types and levels. These results confirm the practical applicability of our framework to noisy offline demonstration data.","descriptionType":"Abstract"},{"description":"Published in IEEE Transactions on Neural Networks and Learning Systems (TNNLS)","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.14467","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-17T02:38:22.000Z","registered":"2025-10-17T02:38:23.000Z","published":"2025","updated":"2025-10-17T02