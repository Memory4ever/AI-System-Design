<td id="S4.T6.6.1.3.8" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S4.T6.6.1.3.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FDD9D7;">78.33</span></td>
