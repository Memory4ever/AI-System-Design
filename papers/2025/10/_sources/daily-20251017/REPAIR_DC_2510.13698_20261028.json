{"data":{"id":"10.48550/arxiv.2510.13698","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.13698","prefix":"10.48550","suffix":"arxiv.2510.13698","identifiers":[{"identifier":"2510.13698","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.13698"}],"creators":[{"name":"Park, Jonghyun","nameType":"Personal","givenName":"Jonghyun","familyName":"Park","affiliation":[],"nameIdentifiers":[]},{"name":"Seo, Minhyuk","nameType":"Personal","givenName":"Minhyuk","familyName":"Seo","affiliation":[],"nameIdentifiers":[]},{"name":"Yeo, Chaewon","nameType":"Personal","givenName":"Chaewon","familyName":"Yeo","affiliation":[],"nameIdentifiers":[]},{"name":"Choi, Jonghyun","nameType":"Personal","givenName":"Jonghyun","familyName":"Choi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Attention Misses Visual Risk: Risk-Adaptive Steering for Multimodal Safety Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-15T15:57:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-16T01:00:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-03T02:09:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-04T02:10:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-27T01:19:31Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-30T00:15:31Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-14T06:18:50Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-15T00:29:13Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Even modern AI models often remain vulnerable to multimodal queries in which harmful intent is embedded in images. A widely used approach for safety alignment is training with extensive multimodal safety datasets, but the costs of data curation and training are often prohibitive. To mitigate these costs, inference-time alignment has recently been explored, but they often lack generalizability across diverse multimodal jailbreaks and still incur notable overhead due to extra forward passes for response refinement or heavy pre-deployment calibration procedures. Here, we identify insufficient visual attention to safety-critical image regions as one of the key causes of multimodal safety failures. Building on this insight, we propose Multimodal Risk-Adaptive Steering (MoRAS), which enhances safety-critical visual attention via concise visual contexts for accurate multimodal risk assessment. This risk signal enables risk-adaptive steering for direct refusals, reducing inference overhead while remaining generalizable across diverse multimodal jailbreaks. Notably, MoRAS requires only a small calibration set to estimate multimodal risk, substantially reducing pre-deployment overhead. We conduct various empirical validations across multiple benchmarks and MLLM backbones, and observe that the proposed MoRAS consistently mitigates jailbreaks, preserves utility, and reduces computational overhead compared to state-of-the-art inference-time defenses.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.13698","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-16T02:07:43.000Z","registered":"2025-10-16T02:07:44.000Z","published":"2025","updated":"2026-07-15T02:16:15.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.13698","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}