<td id="S4.T2.2.1.5.3" class="ltx_td ltx_align_center">75.61<math id="S4.T2.m14" class="ltx_Math" alttext="\pm 0.26" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.26</mn></mrow><annotation encoding="application/x-tex">\pm 0.26</annotation></semantics></math></td>
<td id="S4.T2.2.1.5.4" class="ltx_td ltx_align_center">75.65<math id="S4.T2.m15" class="ltx_Math" alttext="\pm 0.23" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.23</mn></mrow><annotation encoding="application/x-tex">\pm 0.23</annotation></semantics></math></td>
