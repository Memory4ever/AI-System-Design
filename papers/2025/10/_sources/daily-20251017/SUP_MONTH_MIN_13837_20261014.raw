<td id="S4.T2.2.1.3.2" class="ltx_td ltx_align_center">76.26<math id="S4.T2.m5" class="ltx_Math" alttext="\pm 0.27" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.27</mn></mrow><annotation encoding="application/x-tex">\pm 0.27</annotation></semantics></math></td>
<td id="S4.T2.2.1.3.3" class="ltx_td ltx_align_center">75.98<math id="S4.T2.m6" class="ltx_Math" alttext="\pm 0.27" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.27</mn></mrow><annotation encoding="application/x-tex">\pm 0.27</annotation></semantics></math></td>
<td id="S4.T2.2.1.3.4" class="ltx_td ltx_align_center">76.04<math id="S4.T2.m7" class="ltx_Math" alttext="\pm 0.32" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.32</mn></mrow><annotation encoding="application/x-tex">\pm 0.32</annotation></semantics></math></td>
<td id="S4.T2.2.1.3.5" class="ltx_td ltx_align_center">76.00<math id="S4.T2.m8" class="ltx_Math" alttext="\pm 0.29" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.29</mn></mrow><annotation encoding="application/x-tex">\pm 0.29</annotation></semantics></math></td></tr>
