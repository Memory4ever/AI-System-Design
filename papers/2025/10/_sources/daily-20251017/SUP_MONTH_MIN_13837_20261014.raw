<td id="S4.T2.2.1.1.4" class="ltx_td ltx_align_center ltx_border_t">Recall</td>
<td id="S4.T2.2.1.1.5" class="ltx_td ltx_align_center ltx_border_t">F1</td></tr>
<tr id="S4.T2.2.1.2" class="ltx_tr">
<th id="S4.T2.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt">HateBERT</th>
<td id="S4.T2.2.1.2.2" class="ltx_td ltx_align_center ltx_border_tt">76.23<math id="S4.T2.m1" class="ltx_Math" alttext="\pm 0.15" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.15</mn></mrow><annotation encoding="application/x-tex">\pm 0.15</annotation></semantics></math></td>
<td id="S4.T2.2.1.2.3" class="ltx_td ltx_align_center ltx_border_tt">75.97<math id="S4.T2.m2" class="ltx_Math" alttext="\pm 0.15" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.15</mn></mrow><annotation encoding="application/x-tex">\pm 0.15</annotation></semantics></math></td>
<td id="S4.T2.2.1.2.4" class="ltx_td ltx_align_center ltx_border_tt">76.10<math id="S4.T2.m3" class="ltx_Math" alttext="\pm 0.24" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.24</mn></mrow><annotation encoding="application/x-tex">\pm 0.24</annotation></semantics></math></td>
<td id="S4.T2.2.1.2.5" class="ltx_td ltx_align_center ltx_border_tt">76.01<math id="S4.T2.m4" class="ltx_Math" alttext="\pm 0.18" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.18</mn></mrow><annotation encoding="application/x-tex">\pm 0.18</annotation></semantics></math></td></tr>
<tr id="S4.T2.2.1.3" class="ltx_tr">
