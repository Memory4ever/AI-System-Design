<td id="S2.T1.2.1.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.4.2.1" class="ltx_text ltx_font_bold">61.47</span></td>
<td id="S2.T1.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.4.3.1" class="ltx_text ltx_font_bold">61.49</span></td>
<td id="S2.T1.2.1.4.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.2.1.4.4.1" class="ltx_text ltx_font_bold">58.97</span></td>
