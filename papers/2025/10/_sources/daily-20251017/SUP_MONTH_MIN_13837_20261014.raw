<td id="S4.T2.2.1.4.3" class="ltx_td ltx_align_center">76.05<math id="S4.T2.m10" class="ltx_Math" alttext="\pm 0.15" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.15</mn></mrow><annotation encoding="application/x-tex">\pm 0.15</annotation></semantics></math></td>
<td id="S4.T2.2.1.4.4" class="ltx_td ltx_align_center">76.10<math id="S4.T2.m11" class="ltx_Math" alttext="\pm 0.15" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.15</mn></mrow><annotation encoding="application/x-tex">\pm 0.15</annotation></semantics></math></td>
<td id="S4.T2.2.1.4.5" class="ltx_td ltx_align_center">76.06<math id="S4.T2.m12" class="ltx_Math" alttext="\pm 0.14" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.14</mn></mrow><annotation encoding="application/x-tex">\pm 0.14</annotation></semantics></math></td></tr>
