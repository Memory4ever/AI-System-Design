<td id="S4.T4.6.1.5.2" class="ltx_td ltx_align_center">0.359</td></tr>
<tr id="S4.T4.6.1.6" class="ltx_tr">
<td id="S4.T4.6.1.6.1" class="ltx_td ltx_align_left">dolphin-2.6-mixtral-8x7b</td>
<td id="S4.T4.6.1.6.2" class="ltx_td ltx_align_center">0.280</td></tr>
<tr id="S4.T4.6.1.7" class="ltx_tr">
<td id="S4.T4.6.1.7.1" class="ltx_td ltx_align_left ltx_border_t" colspan="2"><span id="S4.T4.6.1.7.1.1" class="ltx_text ltx_font_italic">Agent Systems with Memory</span></td></tr>
<tr id="S4.T4.6.1.8" class="ltx_tr">
<td id="S4.T4.6.1.8.1" class="ltx_td ltx_align_left ltx_border_t">MemGPT <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite> with dolphin-2.6-mixtral-8x7b</td>
<td id="S4.T4.6.1.8.2" class="ltx_td ltx_align_center ltx_border_t">0.405</td></tr>
