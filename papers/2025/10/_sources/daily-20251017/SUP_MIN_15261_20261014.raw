            CN <math id="algorithm1.m12" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> [ <math id="algorithm1.m13" class="ltx_Math" alttext="tag\texttt{.get\_context()}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_monospace">.get_context()</mtext></mrow><annotation encoding="application/x-tex">tag\texttt{.get\_context()}</annotation></semantics></math> <span id="algorithm1.10.17.2" class="ltx_text ltx_font_bold">for</span> <math id="algorithm1.m14" class="ltx_Math" alttext="tag" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">tag</annotation></semantics></math> <math id="algorithm1.m15" class="ltx_Math" alttext="in" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">in</annotation></semantics></math> T ]
</div>
