            T.<span id="algorithm1.10.16.2" class="ltx_text ltx_font_typewriter">extend(<math id="algorithm1.m11" class="ltx_math_unparsed" alttext="PG.\texttt{get\_tags}(\text{T}))" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mi>G</mi><mo lspace="0em" rspace="0.167em">.</mo><mtext class="ltx_mathvariant_monospace">get_tags</mtext><mrow><mo stretchy="false">(</mo><mtext>T</mtext><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">PG.\texttt{get\_tags}(\text{T}))</annotation></semantics></math></span>
