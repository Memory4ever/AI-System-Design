{"data":{"id":"10.48550/arxiv.2510.13799","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.13799","prefix":"10.48550","suffix":"arxiv.2510.13799","identifiers":[{"identifier":"2510.13799","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.13799"}],"creators":[{"name":"Gu, Jia-Chen","nameType":"Personal","givenName":"Jia-Chen","familyName":"Gu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Junyi","nameType":"Personal","givenName":"Junyi","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Di","nameType":"Personal","givenName":"Di","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Yuankai","nameType":"Personal","givenName":"Yuankai","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Chang, Kai-Wei","nameType":"Personal","givenName":"Kai-Wei","familyName":"Chang","affiliation":[],"nameIdentifiers":[]},{"name":"Peng, Nanyun","nameType":"Personal","givenName":"Nanyun","familyName":"Peng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BRIEF-Pro: Universal Context Compression with Short-to-Long Synthesis for Fast and Accurate Multi-Hop Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-15T17:57:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-16T01:07:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-27T01:17:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-28T01:10:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"As retrieval-augmented generation (RAG) tackles complex tasks, increasingly expanded contexts offer richer information, but at the cost of higher latency and increased cognitive load on the model. To mitigate this bottleneck, especially for intricate multi-hop questions, we introduce BRIEF-Pro. It is a universal, lightweight compressor that distills relevant evidence for a given query from retrieved documents into a concise summary for seamless integration into in-context RAG. Using seed data consisting of relatively short contexts (fewer than 1k words), BRIEF-Pro is trained to perform abstractive compression of extended contexts exceeding 10k words across a wide range of scenarios. Furthermore, BRIEF-Pro offers flexible user control over summary length by allowing users to specify the desired number of sentences. Experiments on four open-domain multi-hop question-answering datasets show that BRIEF-Pro generates more concise and relevant summaries, enhancing performance across small, large, and proprietary language models. With the 70B reader model, 32x compression by BRIEF-Pro improves QA performance by 4.67% on average over LongLLMLingua's 9x, while requiring only 23% of its computational overhead.","descriptionType":"Abstract"},{"description":"Accepted by ACL 2026 Findings. Code and data: https://github.com/JasonForJoy/BRIEF","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.13799","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-16T02:10:19.000Z","registered":"2025-10-16T02:10:20.000Z","published":"2025","updated":"2026-04-28T04:05:55.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.13799","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}