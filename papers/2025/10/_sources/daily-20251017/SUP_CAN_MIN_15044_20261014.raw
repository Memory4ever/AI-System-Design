<section id="Pt0.Ax1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix">Appendix</h2>

<section id="Pt0.Ax1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A1 </span>IQNN-CS Training Procedure</h3>

<div id="Pt0.Ax1.SS1.p1" class="ltx_para">
<p id="Pt0.Ax1.SS1.p1.1" class="ltx_p">The IQNN-CS architecture is trained using a hybrid quantum-classical pipeline as detailed in Algorithm <a href="#alg1" title="Algorithm 1 ‣ A1 IQNN-CS Training Procedure ‣ Appendix ‣ IQNN-CS: Interpretable Quantum Neural Network for Credit Scoring" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="font-size:70%;"><span class="ltx_tag ltx_tag_float"><span id="alg1.5" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> IQNN-CS Training Procedure</figcaption>
<div id="alg1.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg1.l1.3" class="ltx_text" style="font-size:70%;">Raw Datasets (</span><math id="alg1.l1.m1" class="ltx_Math" alttext="D_{raw1},D_{raw2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">D</mi><mrow><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">w</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><msub><mi mathsize="0.700em">D</mi><mrow><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">w</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">D_{raw1},D_{raw2}</annotation></semantics></math><span id="alg1.l1.4" class="ltx_text" style="font-size:70%;">), NumEpochs (</span><math id="alg1.l1.m2" class="ltx_Math" alttext="N_{epochs}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">N</mi><mrow><mi mathsize="0.700em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">s</mi></mrow></msub><annotation encoding="application/x-tex">N_{epochs}</annotation></semantics></math><span id="alg1.l1.5" class="ltx_text" style="font-size:70%;">), BatchSize (</span><math id="alg1.l1.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math><span id="alg1.l1.6" class="ltx_text" style="font-size:70%;">), LearningRate (</span><math id="alg1.l1.m4" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math><span id="alg1.l1.7" class="ltx_text" style="font-size:70%;">), PCA Dimensions (</span><math id="alg1.l1.m5" class="ltx_Math" alttext="d_{PCA1},d_{PCA2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">d</mi><mrow><mi mathsize="0.700em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">A</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><msub><mi mathsize="0.700em">d</mi><mrow><mi mathsize="0.700em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">A</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">d_{PCA1},d_{PCA2}</annotation></semantics></math><span id="alg1.l1.8" class="ltx_text" style="font-size:70%;">), Qubit Counts (</span><math id="alg1.l1.m6" class="ltx_Math" alttext="N_{Q1},N_{Q2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">N</mi><mrow><mi mathsize="0.700em">Q</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><msub><mi mathsize="0.700em">N</mi><mrow><mi mathsize="0.700em">Q</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">N_{Q1},N_{Q2}</annotation></semantics></math><span id="alg1.l1.9" class="ltx_text" style="font-size:70%;">)
</span>
</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg1.l2.3" class="ltx_text" style="font-size:70%;">Trained IQNN-CS model (</span><math id="alg1.l2.m1" class="ltx_Math" alttext="M_{IQNN-CS}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">M</mi><mrow><mrow><mi mathsize="0.700em">I</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">Q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">N</mi></mrow><mo mathsize="0.700em">−</mo><mrow><mi mathsize="0.700em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">S</mi></mrow></mrow></msub><annotation encoding="application/x-tex">M_{IQNN-CS}</annotation></semantics></math><span id="alg1.l2.4" class="ltx_text" style="font-size:70%;">)
</span>
</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg1.l3.3" class="ltx_text" style="font-size:70%;">Initialize the IQNN-CS model structure (</span><math id="alg1.l3.m1" class="ltx_Math" alttext="M_{IQNN-CS}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">M</mi><mrow><mrow><mi mathsize="0.700em">I</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">Q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">N</mi></mrow><mo mathsize="0.700em">−</mo><mrow><mi mathsize="0.700em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">S</mi></mrow></mrow></msub><annotation encoding="application/x-tex">M_{IQNN-CS}</annotation></semantics></math><span id="alg1.l3.4" class="ltx_text" style="font-size:70%;">):
</span>
</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg1.l4.3" class="ltx_text" style="font-size:70%;">  Define classical pre-processing network </span><math id="alg1.l4.m1" class="ltx_Math" alttext="M_{classical\_pre}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">M</mi><mrow><mi mathsize="0.700em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi></mrow></msub><annotation encoding="application/x-tex">M_{classical\_pre}</annotation></semantics></math><span id="alg1.l4.4" class="ltx_text" style="font-size:70%;"> using </span><math id="alg1.l4.m2" class="ltx_Math" alttext="d_{PCA}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">d</mi><mrow><mi mathsize="0.700em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">A</mi></mrow></msub><annotation encoding="application/x-tex">d_{PCA}</annotation></semantics></math><span id="alg1.l4.5" class="ltx_text" style="font-size:70%;"> input dimensions.
</span>
</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
