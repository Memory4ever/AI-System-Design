<td id="S4.T3.3.1.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;" rowspan="2"><span id="S4.T3.3.1.1.2.1" class="ltx_text ltx_font_bold">Methods</span></td>
<td id="S4.T3.3.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;" rowspan="2"><span id="S4.T3.3.1.1.3.1" class="ltx_text">
<span id="S4.T3.3.1.1.3.1.1" class="ltx_inline-block">
<span id="S4.T3.3.1.1.3.1.1.1" class="ltx_p"><span id="S4.T3.3.1.1.3.1.1.1.1" class="ltx_text ltx_font_bold">AvgOverall</span><sup id="S4.T3.3.1.1.3.1.1.1.2" class="ltx_sup"><span id="S4.T3.3.1.1.3.1.1.1.2.1" class="ltx_text ltx_font_bold">Edit</span></sup><span id="S4.T3.3.1.1.3.1.1.1.3" class="ltx_text ltx_font_bold"> </span><math id="S4.T3.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
