{"data":{"id":"10.48550/arxiv.2510.13849","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.13849","prefix":"10.48550","suffix":"arxiv.2510.13849","identifiers":[{"identifier":"2510.13849","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.13849"}],"creators":[{"name":"Goncharov, Andrey","nameType":"Personal","givenName":"Andrey","familyName":"Goncharov","affiliation":[],"nameIdentifiers":[]},{"name":"Kondusov, Nikolai","nameType":"Personal","givenName":"Nikolai","familyName":"Kondusov","affiliation":[],"nameIdentifiers":[]},{"name":"Zaytsev, Alexey","nameType":"Personal","givenName":"Alexey","familyName":"Zaytsev","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Language steering in latent space to mitigate unintended code-switching"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-11T19:49:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-17T00:00:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T12:36:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T03:04:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-15T11:13:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-16T00:43:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-10-16T17:02:53Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-10-19T01:24:55Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-10-19T10:02:14Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-10-20T02:08:46Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Multilingual Large Language Models (LLMs) often exhibit hallucinations such as unintended code-switching, reducing reliability in downstream tasks. We propose latent-space language steering, a lightweight inference-time method that identifies language directions via Principal Component Analysis (PCA) on parallel translations and steers token embeddings along these axes to control language identity. Our approach mitigates code-switching (reduced next-token distributional divergence by up to 55\\%, reduced Code-Switching Index by 63--99\\%) while preserving broad semantic direction with negligible computational overhead and requires only minimal parallel data for calibration. Additionally, we evaluate language classification using a single principal component (96-100\\% accuracy) and further analyze the layer-wise evolution of language representations.","descriptionType":"Abstract"},{"description":"Published at AINL 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.13849","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-17T01:49:14.000Z","registered":"2025-10-17T01:49:15.000Z","published":"2025","updated":"2026-10-20T05:15:46.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.13849","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}