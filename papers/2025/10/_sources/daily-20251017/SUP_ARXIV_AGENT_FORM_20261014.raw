        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.14966">pdf</a>, <a href="https://arxiv.org/ps/2510.14966">ps</a>, <a href="https://arxiv.org/format/2510.14966">other</a>]&nbsp;</span>
