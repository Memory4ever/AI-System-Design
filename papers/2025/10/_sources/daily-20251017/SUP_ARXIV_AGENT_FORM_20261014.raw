        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.14548">pdf</a>, <a href="https://arxiv.org/ps/2510.14548">ps</a>, <a href="https://arxiv.org/format/2510.14548">other</a>]&nbsp;</span>
