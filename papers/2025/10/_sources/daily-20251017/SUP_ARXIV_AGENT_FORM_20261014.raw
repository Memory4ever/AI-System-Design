        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.14967">pdf</a>, <a href="https://arxiv.org/ps/2510.14967">ps</a>, <a href="https://arxiv.org/format/2510.14967">other</a>]&nbsp;</span>
