    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Zhao%2C+H">Han Zhao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+J">Jiaxuan Zhang</a>, 
      
