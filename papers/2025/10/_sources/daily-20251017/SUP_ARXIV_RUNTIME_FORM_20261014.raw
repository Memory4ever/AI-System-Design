    <p class="title is-5 mathjax">
      
        Automotive Crash Dynamics <span class="search-hit mathjax">Modeling</span> Accelerated with Machine Learning
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Nabian%2C+M+A">Mohammad Amin Nabian</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chavare%2C+S">Sudeep Chavare</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Akhare%2C+D">Deepak Akhare</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ranade%2C+R">Rishikesh Ranade</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cherukuri%2C+R">Ram Cherukuri</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tadepalli%2C+S">Srinivas Tadepalli</a>
      
