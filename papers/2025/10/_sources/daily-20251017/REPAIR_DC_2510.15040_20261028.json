{"data":{"id":"10.48550/arxiv.2510.15040","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.15040","prefix":"10.48550","suffix":"arxiv.2510.15040","identifiers":[{"identifier":"2510.15040","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.15040"}],"creators":[{"name":"Gu, Xinyi","nameType":"Personal","givenName":"Xinyi","familyName":"Gu","affiliation":[],"nameIdentifiers":[]},{"name":"Mao, Jiayuan","nameType":"Personal","givenName":"Jiayuan","familyName":"Mao","affiliation":[],"nameIdentifiers":[]},{"name":"Hong, Zhang-Wei","nameType":"Personal","givenName":"Zhang-Wei","familyName":"Hong","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Zhuoran","nameType":"Personal","givenName":"Zhuoran","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Pengyuan","nameType":"Personal","givenName":"Pengyuan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Joshi, Dhiraj","nameType":"Personal","givenName":"Dhiraj","familyName":"Joshi","affiliation":[],"nameIdentifiers":[]},{"name":"Feris, Rogerio","nameType":"Personal","givenName":"Rogerio","familyName":"Feris","affiliation":[],"nameIdentifiers":[]},{"name":"He, Zexue","nameType":"Personal","givenName":"Zexue","familyName":"He","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Composition-Grounded Data Synthesis for Visual Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-16T18:00:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-20T00:01:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T18:45:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-05T02:19:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Pretrained multi-modal large language models (MLLMs) demonstrate strong performance on diverse multimodal tasks, but remain limited in reasoning capabilities for domains where annotations are difficult to collect. In this work, we focus on artificial image domains such as charts, rendered documents, and webpages, which are abundant in practice yet lack large-scale human annotated reasoning datasets. We introduce COGS (COmposition-Grounded data Synthesis), a data-efficient framework for equipping MLLMs with advanced reasoning abilities from a small set of seed questions. The key idea is to decompose each seed question into primitive perception and reasoning factors, which can then be systematically recomposed with new images to generate large collections of synthetic question-answer pairs. Each generated question is paired with subquestions and intermediate answers, enabling reinforcement learning with factor-level process rewards. Experiments on chart reasoning show that COGS substantially improves performance on unseen questions, with the largest gains on reasoning-heavy and compositional questions. Moreover, training with a factor-level mixture of different seed data yields better transfer across multiple datasets, suggesting that COGS induces generalizable capabilities rather than dataset-specific overfitting. We further demonstrate that the framework extends beyond charts to other domains such as webpages.","descriptionType":"Abstract"},{"description":"ICLR2026 camera-ready version. Project page: https://cogsynthesis.github.io","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.15040","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-20T01:32:54.000Z","registered":"2025-10-20T01:32:55.000Z","published":"2025","updated":"2026-03-05T03:44:47.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.15040","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}