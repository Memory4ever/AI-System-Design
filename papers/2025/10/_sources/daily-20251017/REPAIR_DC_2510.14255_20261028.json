{"data":{"id":"10.48550/arxiv.2510.14255","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.14255","prefix":"10.48550","suffix":"arxiv.2510.14255","identifiers":[{"identifier":"2510.14255","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.14255"}],"creators":[{"name":"Shen, Liao","nameType":"Personal","givenName":"Liao","familyName":"Shen","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Wentao","nameType":"Personal","givenName":"Wentao","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Yiran","nameType":"Personal","givenName":"Yiran","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Jiahe","nameType":"Personal","givenName":"Jiahe","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Ge, Tiezheng","nameType":"Personal","givenName":"Tiezheng","familyName":"Ge","affiliation":[],"nameIdentifiers":[]},{"name":"Cao, Zhiguo","nameType":"Personal","givenName":"Zhiguo","familyName":"Cao","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Bo","nameType":"Personal","givenName":"Bo","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identity-Preserving Image-to-Video Generation via Reward-Guided Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-16T03:13:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-17T00:23:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-20T19:00:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-22T00:07:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-23T11:15:51Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-24T00:44:16Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-30T11:36:24Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-31T01:38:54Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Recent advances in image-to-video (I2V) generation have achieved remarkable progress in synthesizing high-quality, temporally coherent videos from static images. Among all the applications of I2V, human-centric video generation includes a large portion. However, existing I2V models encounter difficulties in maintaining identity consistency between the input human image and the generated video, especially when the person in the video exhibits significant expression changes and movements. This issue becomes critical when the human face occupies merely a small fraction of the image. Since humans are highly sensitive to identity variations, this poses a critical yet under-explored challenge in I2V generation. In this paper, we propose Identity-Preserving Reward-guided Optimization (IPRO), a novel video diffusion framework based on reinforcement learning to enhance identity preservation. Instead of introducing auxiliary modules or altering model architectures, our approach introduces a direct and effective tuning algorithm that optimizes diffusion models using a face identity scorer. To improve performance and accelerate convergence, our method backpropagates the reward signal through the last steps of the sampling chain, enabling richer gradient feedback. We also propose a novel facial scoring mechanism that treats faces in ground-truth videos as facial feature pools, providing multi-angle facial information to enhance generalization. A KL-divergence regularization is further incorporated to stabilize training and prevent overfitting to the reward signal. Extensive experiments on Wan 2.2 I2V model and our in-house I2V model demonstrate the effectiveness of our method. Our project and code are available at https://ipro-alimama.github.io/.","descriptionType":"Abstract"},{"description":"accepted by CVPR 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.14255","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-17T02:14:26.000Z","registered":"2025-10-17T02:14:27.000Z","published":"2025","updated":"2026-03-31T04:03:22.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.14255","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}