{"data":{"id":"10.48550/arxiv.2510.17853","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.17853","prefix":"10.48550","suffix":"arxiv.2510.17853","identifiers":[{"identifier":"2510.17853","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.17853"}],"creators":[{"name":"Choi, Yee Man","nameType":"Personal","givenName":"Yee Man","familyName":"Choi","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Xuehang","nameType":"Personal","givenName":"Xuehang","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Fung, Yi R.","nameType":"Personal","givenName":"Yi R.","familyName":"Fung","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Qingyun","nameType":"Personal","givenName":"Qingyun","familyName":"Wang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CiteGuard: Faithful Citation Attribution for LLMs via Retrieval-Augmented Validation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Digital Libraries (cs.DL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-15T00:32:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-22T00:01:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-24T15:36:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-27T00:58:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-26T16:50:53Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-27T02:40:26Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-13T01:44:44Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-14T01:18:35Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large Language Models (LLMs) have emerged as powerful assistants for scientific writing. However, concerns remain about the quality and reliability of the generated text, including citation accuracy and faithfulness. While most recent work relies on methods such as LLM-as-a-Judge, the reliability of LLM-as-a-Judge alone is also in doubt. In this work, we reframe citation evaluation as a problem of citation attribution alignment, which assesses whether LLM-generated citations match those a human author would include for the same text. We propose CiteGuard, a retrieval-aware agent framework designed to provide more faithful grounding for citation validation. CiteGuard improves over the prior baseline by 10 percentage points and achieves up to 68.1% accuracy on the CiteME benchmark, approaching human performance (69.2%). It also identifies alternative valid citations and demonstrates generalization ability for cross-domain citation attribution. Our code is available at https://github.com/KathCYM/CiteGuard.","descriptionType":"Abstract"},{"description":"Project Page: https://kathcym.github.io/CiteGuard_Page/. ACL 2026 Main Conference","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.17853","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"dow