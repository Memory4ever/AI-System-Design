{"data":{"id":"10.48550/arxiv.2510.14126","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.14126","prefix":"10.48550","suffix":"arxiv.2510.14126","identifiers":[{"identifier":"2510.14126","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.14126"}],"creators":[{"name":"Pagonas, Nikos","nameType":"Personal","givenName":"Nikos","familyName":"Pagonas","affiliation":[],"nameIdentifiers":[]},{"name":"Chung, Yeounoh","nameType":"Personal","givenName":"Yeounoh","familyName":"Chung","affiliation":[],"nameIdentifiers":[]},{"name":"Kaffes, Kostis","nameType":"Personal","givenName":"Kostis","familyName":"Kaffes","affiliation":[],"nameIdentifiers":[]},{"name":"Krishnamurthy, Arvind","nameType":"Personal","givenName":"Arvind","familyName":"Krishnamurthy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cortex: Workflow-Aware Resource Pooling and Scheduling for Agentic Serving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-15T21:49:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-17T00:11:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We introduce Cortex, a prototype workflow-aware serving platform designed for agentic workloads. The core principle of Cortex is stage isolation: it provisions dedicated resource pools for each distinct stage of an agentic workflow. This simple yet powerful strategy mitigates inter-stage interference in compute and memory, leading to better KV cache utilization, higher throughput, and more predictable performance. By customizing resource allocation and scheduling within each distinct stage of agentic workflows, Cortex lays the groundwork for more advanced, agent-native serving paradigms, including malleable resource management, speculative execution of workflow branches, and a shared, multi-tiered cache for \"agentic state.\"","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.14126","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-17T02:10:37.000Z","registered":"2025-10-17T02:10:38.000Z","published":"2025","updated":"2025-10-17T02:10:38.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.14126","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}