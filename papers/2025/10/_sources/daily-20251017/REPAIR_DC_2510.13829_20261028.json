{"data":{"id":"10.48550/arxiv.2510.13829","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.13829","prefix":"10.48550","suffix":"arxiv.2510.13829","identifiers":[{"identifier":"2510.13829","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.13829"}],"creators":[{"name":"Park, Shinwoo","nameType":"Personal","givenName":"Shinwoo","familyName":"Park","affiliation":[],"nameIdentifiers":[]},{"name":"Park, Hyejin","nameType":"Personal","givenName":"Hyejin","familyName":"Park","affiliation":[],"nameIdentifiers":[]},{"name":"An, Hyeseon","nameType":"Personal","givenName":"Hyeseon","familyName":"An","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Yo-Sub","nameType":"Personal","givenName":"Yo-Sub","familyName":"Han","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Linguistics-Aware LLM Watermarking via Syntactic Predictability"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-10T07:26:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-17T00:00:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-06T15:15:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-07T01:33:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-16T10:08:45Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-17T00:40:26Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-17T07:45:33Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-20T00:31:49Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"As large language models (LLMs) continue to advance rapidly, reliable governance tools have become critical. Publicly verifiable watermarking is particularly essential for fostering a trustworthy AI ecosystem. A central challenge persists: balancing text quality against detection robustness. Recent studies have sought to navigate this trade-off by leveraging signals from model output distributions (e.g., token-level entropy); however, their reliance on these model-specific signals presents a significant barrier to public verification, as the detection process requires access to the logits of the underlying model. We introduce STELA, a novel framework that aligns watermark strength with the linguistic degrees of freedom inherent in language. STELA dynamically modulates the signal using part-of-speech (POS) n-gram-modeled linguistic indeterminacy, weakening it in grammatically constrained contexts to preserve quality and strengthening it in contexts with greater linguistic flexibility to enhance detectability. Our detector operates without access to any model logits, thus facilitating publicly verifiable detection. Through extensive experiments on typologically diverse languages-analytic English, isolating Chinese, and agglutinative Korean-we show that STELA surpasses prior methods in detection robustness. Our code is available at https://github.com/Shinwoo-Park/stela_watermark.","descriptionType":"Abstract"},{"description":"ACL 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.13829","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-17T01:48:40.000Z","registered":"2025-10-17T01:48:41.000Z","published":"2025","updated":"2026-04-20T02:09:19.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.13829","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}