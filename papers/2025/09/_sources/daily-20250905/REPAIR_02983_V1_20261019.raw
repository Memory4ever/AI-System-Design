<tr id="S4.T1.8.4" class="ltx_tr">
<th id="S4.T1.8.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-top:0.5pt;padding-bottom:0.5pt;">E. F.</th>
<td id="S4.T1.8.4.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.957</td>
<td id="S4.T1.8.4.3" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.124</td>
<td id="S4.T1.8.4.4" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.051</td>
<td id="S4.T1.8.4.5" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">1.479</td>
<td id="S4.T1.8.4.6" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.045</td>
<td id="S4.T1.8.4.7" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.950</td>
