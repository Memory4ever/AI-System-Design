<tr id="S6.T2.7.2" class="ltx_tr">
<th id="S6.T2.7.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="S6.T2.7.2.1.1" class="ltx_text ltx_font_bold">Para.</span></th>
<td id="S6.T2.7.2.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S6.T2.7.2.2.1" class="ltx_text ltx_font_bold">Type IC</span></td>
<td id="S6.T2.7.2.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S6.T2.7.2.3.1" class="ltx_text ltx_font_bold">Type 3C</span></td>
<td id="S6.T2.7.2.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S6.T2.7.2.4.1" class="ltx_text ltx_font_bold">Type 7C</span></td></tr>
<tr id="S6.T2.7.3" class="ltx_tr">
<th id="S6.T2.7.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" colspan="4"><span class="ltx_rule" style="width:100%;height:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></th></tr>
<tr id="S6.T2.7.4" class="ltx_tr">
<th id="S6.T2.7.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r"><math id="S6.T2.m1" class="ltx_Math" alttext="\beta_{c}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\beta_{c}</annotation></semantics></math></th>
<td id="S6.T2.7.4.2" class="ltx_td ltx_align_center ltx_border_r">{0.83, 0.44, 0.55}</td>
<td id="S6.T2.7.4.3" class="ltx_td ltx_align_center ltx_border_r">{3.18, 1.14, 1.47}</td>
<td id="S6.T2.7.4.4" class="ltx_td ltx_align_center ltx_border_r">{3.18, 3.55, 4.40}</td></tr>
<tr id="S6.T2.7.5" class="ltx_tr">
<th id="S6.T2.7.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><math id="S6.T2.m2" class="ltx_Math" alttext="B_{c}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>c</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">B_{c}^{\infty}</annotation></semantics></math></th>
<td id="S6.T2.7.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">{0.01, 0.40, 0.44}</td>
