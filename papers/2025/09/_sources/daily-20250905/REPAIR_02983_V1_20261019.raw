<tr id="S6.T2.7.6" class="ltx_tr">
<th id="S6.T2.7.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><math id="S6.T2.m3" class="ltx_Math" alttext="\sigma_{h}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\sigma_{h}</annotation></semantics></math></th>
<td id="S6.T2.7.6.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.1</td>
<td id="S6.T2.7.6.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.2</td>
<td id="S6.T2.7.6.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.3</td></tr>
<tr id="S6.T2.7.7" class="ltx_tr">
<th id="S6.T2.7.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><math id="S6.T2.m4" class="ltx_Math" alttext="k_{M}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>M</mi></msub><annotation encoding="application/x-tex">k_{M}</annotation></semantics></math></th>
<td id="S6.T2.7.7.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.001</td>
<td id="S6.T2.7.7.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.002</td>
<td id="S6.T2.7.7.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.003</td></tr>
<tr id="S6.T2.7.8" class="ltx_tr">
<th id="S6.T2.7.8.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" colspan="4"><span class="ltx_rule" style="width:100%;height:1.0pt;--ltx-bg-color:black;display:inline-block;"> </span></th></tr>
<tr id="S6.T2.7.9" class="ltx_tr">
<th id="S6.T2.7.9.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="S6.T2.7.9.1.1" class="ltx_text ltx_font_bold">V. R.</span></th>
