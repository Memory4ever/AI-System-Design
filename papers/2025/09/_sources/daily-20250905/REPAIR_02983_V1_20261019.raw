<th id="S4.T1.8.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;" colspan="5"><span id="S4.T1.8.1.3.1" class="ltx_text ltx_font_bold">SQUID</span></th></tr>
<tr id="S4.T1.8.2" class="ltx_tr">
