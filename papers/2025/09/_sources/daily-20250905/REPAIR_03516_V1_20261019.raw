<td id="S4.T2.18.1.32.9" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T2.18.1.32.9.1" class="ltx_text" style="--ltx-fg-color:#319B62;"><span id="S4.T2.18.1.32.9.1.1" class="ltx_text ltx_underline">66.1</span></span></td>
