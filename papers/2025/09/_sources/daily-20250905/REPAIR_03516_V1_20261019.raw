<td id="S4.T2.18.1.32.11" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T2.18.1.32.11.1" class="ltx_text" style="--ltx-fg-color:#319B62;"><span id="S4.T2.18.1.32.11.1.1" class="ltx_text ltx_underline">82.8</span></span></td>
<td id="S4.T2.18.1.32.12" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T2.18.1.32.12.1" class="ltx_text" style="--ltx-fg-color:#319B62;"><span id="S4.T2.18.1.32.12.1.1" class="ltx_text ltx_underline">83.0</span></span></td>
<td id="S4.T2.18.1.32.13" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T2.18.1.32.13.1" class="ltx_text" style="--ltx-fg-color:#319B62;"><span id="S4.T2.18.1.32.13.1.1" class="ltx_text ltx_font_bold">76.3</span></span></td>
