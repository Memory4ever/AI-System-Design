<th id="S3.T1.2.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">MLP</th>
<th id="S3.T1.2.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Transformer</th>
<th id="S3.T1.2.1.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">LSTM</th>
<th id="S3.T1.2.1.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Mamba</th>
<th id="S3.T1.2.1.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">FAN</th>
<th id="S3.T1.2.1.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">FNO</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.2.2" class="ltx_tr">
<th id="S3.T1.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="4"><span id="S3.T1.2.2.1.1" class="ltx_text"><math id="S3.T1.m2" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math></span></th>
<th id="S3.T1.2.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">0.1</th>
<td id="S3.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.2.3.1" class="ltx_text ltx_font_bold">0.0142</span></td>
<td id="S3.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.2.4.1" class="ltx_text ltx_font_bold ltx_font_italic">0.0203</span></td>
<td id="S3.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t">0.0270</td>
<td id="S3.T1.2.2.6" class="ltx_td ltx_align_center ltx_border_t">0.1507</td>
<td id="S3.T1.2.2.7" class="ltx_td ltx_align_center ltx_border_t">0.1216</td>
<td id="S3.T1.2.2.8" class="ltx_td ltx_align_center ltx_border_t">0.0584</td>
<td id="S3.T1.2.2.9" class="ltx_td ltx_align_center ltx_border_t">0.0743</td>
<td id="S3.T1.2.2.10" class="ltx_td ltx_align_center ltx_border_t">0.1194</td>
<td id="S3.T1.2.2.11" class="ltx_td ltx_align_center ltx_border_t">0.1173</td>
<td id="S3.T1.2.2.12" class="ltx_td ltx_align_center ltx_border_t">0.0767</td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<th id="S3.T1.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">0.2</th>
<td id="S3.T1.2.3.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.3.2.1" class="ltx_text ltx_font_bold">0.0550</span></td>
<td id="S3.T1.2.3.3" class="ltx_td ltx_align_center"><span id="S3.T1.2.3.3.1" class="ltx_text ltx_font_bold ltx_font_italic">0.0770</span></td>
<td id="S3.T1.2.3.4" class="ltx_td ltx_align_center">0.0959</td>
<td id="S3.T1.2.3.5" class="ltx_td ltx_align_center">0.1946</td>
<td id="S3.T1.2.3.6" class="ltx_td ltx_align_center">0.1273</td>
<td id="S3.T1.2.3.7" class="ltx_td ltx_align_center">0.3903</td>
<td id="S3.T1.2.3.8" class="ltx_td ltx_align_center">0.1462</td>
<td id="S3.T1.2.3.9" class="ltx_td ltx_align_center">0.2934</td>
<td id="S3.T1.2.3.10" class="ltx_td ltx_align_center">0.4266</td>
<td id="S3.T1.2.3.11" class="ltx_td ltx_align_center">0.1305</td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<th id="S3.T1.2.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">0.3</th>
<td id="S3.T1.2.4.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.4.2.1" class="ltx_text ltx_font_bold">0.1206</span></td>
<td id="S3.T1.2.4.3" class="ltx_td ltx_align_center"><span id="S3.T1.2.4.3.1" class="ltx_text ltx_font_bold ltx_font_italic">0.1681</span></td>
<td id="S3.T1.2.4.4" class="ltx_td ltx_align_center">0.1999</td>
<td id="S3.T1.2.4.5" class="ltx_td ltx_align_center">0.2947</td>
<td id="S3.T1.2.4.6" class="ltx_td ltx_align_center">0.2408</td>
<td id="S3.T1.2.4.7" class="ltx_td ltx_align_center">0.4635</td>
<td id="S3.T1.2.4.8" class="ltx_td ltx_align_center">0.5209</td>
<td id="S3.T1.2.4.9" class="ltx_td ltx_align_center">0.3781</td>
<td id="S3.T1.2.4.10" class="ltx_td ltx_align_center">0.7023</td>
<td id="S3.T1.2.4.11" class="ltx_td ltx_align_center">0.1979</td></tr>
<tr id="S3.T1.2.5" class="ltx_tr">
<th id="S3.T1.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">0.4</th>
<td id="S3.T1.2.5.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.5.2.1" class="ltx_text ltx_font_bold">0.2155</span></td>
<td id="S3.T1.2.5.3" class="ltx_td ltx_align_center"><span id="S3.T1.2.5.3.1" class="ltx_text ltx_font_bold ltx_font_italic">0.2892</span></td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_center">0.3543</td>
<td id="S3.T1.2.5.5" class="ltx_td ltx_align_center">0.6241</td>
