<td id="S3.T1.2.7.3" class="ltx_td ltx_align_center"><span id="S3.T1.2.7.3.1" class="ltx_text ltx_font_bold">0.0724</span></td>
<td id="S3.T1.2.7.4" class="ltx_td ltx_align_center">0.0922</td>
<td id="S3.T1.2.7.5" class="ltx_td ltx_align_center">0.2812</td>
<td id="S3.T1.2.7.6" class="ltx_td ltx_align_center">0.1550</td>
<td id="S3.T1.2.7.7" class="ltx_td ltx_align_center">0.5346</td>
