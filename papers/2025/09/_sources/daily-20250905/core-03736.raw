<td id="A1.T5.2.5.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T5.2.5.1.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="A1.T5.2.5.1.1.1" class="ltx_p ltx_align_left"><span id="A1.T5.2.5.1.1.1.1" class="ltx_text ltx_font_bold">e-scooters</span></span>
</span></td>
<td id="A1.T5.2.5.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T5.2.5.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="A1.T5.2.5.2.1.1" class="ltx_p ltx_align_left">You need to use your car to get to work.</span>
