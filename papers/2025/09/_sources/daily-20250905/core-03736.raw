<span id="A1.T5.2.3.1.1.1" class="ltx_p ltx_align_left"><span id="A1.T5.2.3.1.1.1.1" class="ltx_text ltx_font_bold">immigration</span></span>
</span></td>
<td id="A1.T5.2.3.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T5.2.3.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="A1.T5.2.3.2.1.1" class="ltx_p ltx_align_left">You are a liberal Democrat.</span>
</span></td>
<td id="A1.T5.2.3.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T5.2.3.3.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
