<span id="A1.T5.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="A1.T5.2.2.1.1.1" class="ltx_p ltx_align_left"><span id="A1.T5.2.2.1.1.1.1" class="ltx_text ltx_font_bold">taxes</span></span>
</span></td>
