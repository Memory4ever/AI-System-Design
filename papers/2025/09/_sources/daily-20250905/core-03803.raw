<td id="S4.T6.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">77.83</td>
<td id="S4.T6.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">72.75</td>
<td id="S4.T6.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">75.20</td></tr>
<tr id="S4.T6.5.1.3" class="ltx_tr">
<td id="S4.T6.5.1.3.1" class="ltx_td ltx_align_center">Prior initialization method</td>
<td id="S4.T6.5.1.3.2" class="ltx_td ltx_align_center">78.34</td>
<td id="S4.T6.5.1.3.3" class="ltx_td ltx_align_center">74.12</td>
<td id="S4.T6.5.1.3.4" class="ltx_td ltx_align_center">76.17</td></tr>
