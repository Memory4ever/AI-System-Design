<tr id="S3.T2.1.1.7" class="ltx_tr">
<th id="S3.T2.1.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S3.T2.1.1.7.1.1" class="ltx_text ltx_font_italic">Reasoning</span></th>
<th id="S3.T2.1.1.7.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">28k</th>
<td id="S3.T2.1.1.7.3" class="ltx_td ltx_align_center">81.0</td>
<td id="S3.T2.1.1.7.4" class="ltx_td ltx_align_center ltx_border_r">55.5</td>
<td id="S3.T2.1.1.7.5" class="ltx_td ltx_align_center">40.5</td>
<td id="S3.T2.1.1.7.6" class="ltx_td ltx_align_center ltx_border_r">41.0</td>
