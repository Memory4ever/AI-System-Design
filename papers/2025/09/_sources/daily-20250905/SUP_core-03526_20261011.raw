<tr id="S3.T2.1.1.6" class="ltx_tr">
<th id="S3.T2.1.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S3.T2.1.1.6.1.1" class="ltx_text ltx_font_italic">Planning</span></th>
<th id="S3.T2.1.1.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">42k</th>
