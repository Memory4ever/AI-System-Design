<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Detailed TRIAL Algorithm</h2>

<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>TRIAL: Multi-turn Jailbreak</figcaption>
<div id="algorithm1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.4.1" class="ltx_listingline"><span id="algorithm1.4.1.1" class="ltx_text"><span id="algorithm1.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>Harmful query <math id="algorithm1.m1" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math>, attack model <math id="algorithm1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, victim model <math id="algorithm1.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, judge model <math id="algorithm1.m4" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>, helper model <math id="algorithm1.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, iterations <math id="algorithm1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>,
</div>
<div id="algorithm1.4.2" class="ltx_listingline"><span id="algorithm1.4.2.1" class="ltx_text"><span id="algorithm1.4.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>Victim responses, <math id="algorithm1.m7" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>
</div>
<div id="algorithm1.4.3" class="ltx_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold">Initialize:</span> Conversation history <math id="algorithm1.m8" class="ltx_Math" alttext="H_{C}\leftarrow[\,]" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>C</mi></msub><mo stretchy="false">←</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">H_{C}\leftarrow[\,]</annotation></semantics></math> 
</div>
<div id="algorithm1.4.4" class="ltx_listingline"><math id="algorithm1.m9" class="ltx_Math" alttext="C_{\zeta}\leftarrow\text{generate\_clue}(\zeta,H)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>ζ</mi></msub><mo stretchy="false">←</mo><mrow><mtext>generate_clue</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ζ</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{\zeta}\leftarrow\text{generate\_clue}(\zeta,H)</annotation></semantics></math> 
</div>
<div id="algorithm1.4.5" class="ltx_listingline"><math id="algorithm1.m10" class="ltx_Math" alttext="S_{\zeta}\leftarrow\text{generate\_scenario}(C_{\zeta},H)" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>ζ</mi></msub><mo stretchy="false">←</mo><mrow><mtext>generate_scenario</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>ζ</mi></msub><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{\zeta}\leftarrow\text{generate\_scenario}(C_{\zeta},H)</annotation></semantics></math> 
</div>
<div id="algorithm1.4.6" class="ltx_listingline"><span id="algorithm1.4.6.1" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.6.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m11" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> <span id="algorithm1.4.6.2.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m12" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math></em> <span id="algorithm1.4.6.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.7.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.7.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m13" class="ltx_Math" alttext="i==0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i==0</annotation></semantics></math></em> <span id="algorithm1.4.7.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m14" class="ltx_Math" alttext="q_{i}\leftarrow\text{init\_attack}(S)" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mtext>init_attack</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{i}\leftarrow\text{init\_attack}(S)</annotation></semantics></math> ; 
</div>
<div id="algorithm1.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m15" class="ltx_Math" alttext="r_{i}\leftarrow\text{get\_victim\_response}(H_{c},V)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mtext>get_victim_response</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>c</mi></msub><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{i}\leftarrow\text{get\_victim\_response}(H_{c},V)</annotation></semantics></math> ; 
</div>
<div id="algorithm1.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.10.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.10.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m16" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math> contains <span id="algorithm1.4.10.2.1" class="ltx_text ltx_font_typewriter">Option B</span></em> <span id="algorithm1.4.10.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m17" class="ltx_Math" alttext="q_{i}\leftarrow\text{pull\_back}()" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mtext>pull_back</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{i}\leftarrow\text{pull\_back}()</annotation></semantics></math>; # <span id="algorithm1.4.11.1" class="ltx_text ltx_font_typewriter">Change to Option A</span> 
</div>
<div id="algorithm1.4.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m18" class="ltx_Math" alttext="H_{c}\leftarrow H_{C}+{\{q_{i},r_{i}\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>c</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>H</mi><mi>C</mi></msub><mo>+</mo><mrow><mo stretchy="false">{</mo><msub><mi>q</mi><mi>i</mi></msub><mo>,</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{c}\leftarrow H_{C}+{\{q_{i},r_{i}\}}</annotation></semantics></math> 
</div>
<div id="algorithm1.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.13.1" class="ltx_text ltx_font_bold">continue</span>

</div>
<div id="algorithm1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m19" class="ltx_Math" alttext="q_{i}\leftarrow\text{attack}(H_{C},C_{\zeta},A)" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mtext>attack</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>C</mi></msub><mo>,</mo><msub><mi>C</mi><mi>ζ</mi></msub><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{i}\leftarrow\text{attack}(H_{C},C_{\zeta},A)</annotation></semantics></math> 
</div>
<div id="algorithm1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m20" class="ltx_Math" alttext="r_{i}\leftarrow\text{get\_victim\_response}(H_{C},V)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mtext>get_victim_response</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>C</mi></msub><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{i}\leftarrow\text{get\_victim\_response}(H_{C},V)</annotation></semantics></math> ; 
