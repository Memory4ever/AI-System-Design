<td id="A4.T9.2.7.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A4.T9.2.7.5.1" class="ltx_text ltx_font_bold">86</span> %</td>
<td id="A4.T9.2.7.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="A4.T9.2.7.6.1" class="ltx_text ltx_font_bold">84%</span></td></tr>
</table>
