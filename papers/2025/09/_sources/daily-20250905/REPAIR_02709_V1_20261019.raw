<td id="A5.T5.1.10.1" class="ltx_td ltx_align_left">Ages 31–40</td>
<td id="A5.T5.1.10.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.11" class="ltx_tr">
<td id="A5.T5.1.11.1" class="ltx_td ltx_align_left">Ages 41–50</td>
<td id="A5.T5.1.11.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.12" class="ltx_tr">
<td id="A5.T5.1.12.1" class="ltx_td ltx_align_left">Ages 51–60</td>
<td id="A5.T5.1.12.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
