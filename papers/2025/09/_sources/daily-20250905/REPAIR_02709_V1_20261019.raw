<div id="A6.T7.st1.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:287.7pt;height:60.6pt;vertical-align:-27.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-1.5pt,0.3pt) scale(1.0,1.0) ;">
