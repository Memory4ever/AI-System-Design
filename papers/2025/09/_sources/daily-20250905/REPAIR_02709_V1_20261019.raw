<td id="A5.T5.1.13.1" class="ltx_td ltx_align_left">Speaks Hindi</td>
<td id="A5.T5.1.13.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.14" class="ltx_tr">
<td id="A5.T5.1.14.1" class="ltx_td ltx_align_left">Speaks Marathi</td>
<td id="A5.T5.1.14.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.15" class="ltx_tr">
<td id="A5.T5.1.15.1" class="ltx_td ltx_align_left">Speaks Gujurati</td>
<td id="A5.T5.1.15.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.16" class="ltx_tr">
<td id="A5.T5.1.16.1" class="ltx_td ltx_align_left">Speaks Kannada</td>
<td id="A5.T5.1.16.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.17" class="ltx_tr">
<td id="A5.T5.1.17.1" class="ltx_td ltx_align_left">Education level 1/7 – illiterate</td>
<td id="A5.T5.1.17.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.18" class="ltx_tr">
<td id="A5.T5.1.18.1" class="ltx_td ltx_align_left">Education level 2/7 – 1–5th Grade Completed</td>
<td id="A5.T5.1.18.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.19" class="ltx_tr">
<td id="A5.T5.1.19.1" class="ltx_td ltx_align_left">Education level 3/7 – 6–9th Grade Completed</td>
<td id="A5.T5.1.19.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.20" class="ltx_tr">
<td id="A5.T5.1.20.1" class="ltx_td ltx_align_left">Education level 4/7 – 10th Grade Passed</td>
<td id="A5.T5.1.20.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.21" class="ltx_tr">
<td id="A5.T5.1.21.1" class="ltx_td ltx_align_left">Education level 5/7 – 12th Grade Passed</td>
<td id="A5.T5.1.21.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.22" class="ltx_tr">
<td id="A5.T5.1.22.1" class="ltx_td ltx_align_left">Education level 6/7 – Graduate</td>
<td id="A5.T5.1.22.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.23" class="ltx_tr">
<td id="A5.T5.1.23.1" class="ltx_td ltx_align_left">Education level 7/7 – Post graduate</td>
<td id="A5.T5.1.23.2" class="ltx_td ltx_nopad_r ltx_align_left">Binary</td></tr>
<tr id="A5.T5.1.24" class="ltx_tr">
<td id="A5.T5.1.24.1" class="ltx_td ltx_align_left">Phone owner 0 (e.g., woman)</td>
