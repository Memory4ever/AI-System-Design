<th id="S4.T2.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Reflexion</th>
<td id="S4.T2.5.2.2" class="ltx_td ltx_align_center ltx_border_t">70.0</td>
<td id="S4.T2.5.2.3" class="ltx_td ltx_align_center ltx_border_t">84.4</td>
<td id="S4.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t">87.2</td>
<td id="S4.T2.5.2.5" class="ltx_td ltx_align_center ltx_border_t">87.8</td>
<td id="S4.T2.5.2.6" class="ltx_td ltx_align_center ltx_border_t">88.3</td></tr>
