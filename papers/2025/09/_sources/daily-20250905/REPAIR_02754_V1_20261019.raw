<tr id="S3.T4.2.1.2" class="ltx_tr">
<td id="S3.T4.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Baseline</td>
<td id="S3.T4.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.724</td>
