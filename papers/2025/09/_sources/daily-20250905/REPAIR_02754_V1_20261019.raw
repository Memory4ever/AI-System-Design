<td id="Sx1.T7.4.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-1pt;padding-bottom:-1pt;">Offroad Likeli. <math id="Sx1.T7.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
