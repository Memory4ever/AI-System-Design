<figure id="S4.T4" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S4.T4.3" class="ltx_text" style="font-size:90%;">Table 4</span>: </span><span id="S4.T4.4" class="ltx_text" style="font-size:90%;">Impact of SFT Data Difficulty on MathVision Benchmark Performance.</span></figcaption>
<table id="S4.T4.5" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S4.T4.5.1" class="ltx_tr">
