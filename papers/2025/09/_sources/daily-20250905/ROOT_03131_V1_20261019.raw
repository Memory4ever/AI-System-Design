<td id="S4.T3.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2pt;padding-bottom:2pt;">0.5320</td></tr>
<tr id="S4.T3.2.1.3" class="ltx_tr">
<td id="S4.T3.2.1.3.1" class="ltx_td ltx_align_center" style="padding-top:2pt;padding-bottom:2pt;">Fine-tuned</td>
