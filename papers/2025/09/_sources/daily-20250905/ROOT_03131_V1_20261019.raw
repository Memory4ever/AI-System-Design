<th id="S4.T2.2.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:1pt;padding-bottom:1pt;">1,005,745</th>
<td id="S4.T2.2.1.3.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">5,098,084</td>
<td id="S4.T2.2.1.3.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">17.83</td></tr>
