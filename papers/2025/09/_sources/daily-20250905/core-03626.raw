<td id="S5.T5.3.4.3" class="ltx_td ltx_align_right" style="padding-top:1pt;padding-bottom:1pt;">23.43s</td></tr>
<tr id="S5.T5.3.5" class="ltx_tr">
<td id="S5.T5.3.5.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S5.T5.3.5.1.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T5.3.5.1.1.1" class="ltx_p ltx_align_left">Wasserstein distance</span>
</span></td>
