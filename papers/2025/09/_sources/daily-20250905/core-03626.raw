<span id="S5.T5.3.2.1.1.1" class="ltx_p ltx_align_left">Cosine similarity</span>
</span></td>
<td id="S5.T5.3.2.2" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">25.01s</td>
<td id="S5.T5.3.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">25.60s</td></tr>
<tr id="S5.T5.3.3" class="ltx_tr">
<td id="S5.T5.3.3.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S5.T5.3.3.1.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T5.3.3.1.1.1" class="ltx_p ltx_align_left">Inverse Wasserstein distance</span>
</span></td>
<td id="S5.T5.3.3.2" class="ltx_td ltx_align_right" style="padding-top:1pt;padding-bottom:1pt;">20.02s</td>
<td id="S5.T5.3.3.3" class="ltx_td ltx_align_right" style="padding-top:1pt;padding-bottom:1pt;">25.20s</td></tr>
<tr id="S5.T5.3.4" class="ltx_tr">
<td id="S5.T5.3.4.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">
