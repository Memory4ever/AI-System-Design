<td id="A7.T7.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">14.5T</td>
<td id="A7.T7.1.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A7.T7.1.1.2.6.1" class="ltx_text ltx_font_bold">28.9T</span></td></tr>
