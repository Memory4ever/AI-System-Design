</div></div><div class="ltx_flex_cell ltx_flex_size_4">
<div id="S4.F6.3" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_middle" style="width:82.8pt;"><img src="2509.04076v1/images/hist_50_baseline_f.png" id="S4.F6.g3" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:115/136;" width="115" height="136" alt="Refer to caption">
<p id="S4.F6.3.1" class="ltx_p ltx_align_center"><span id="S4.F6.3.1.1" class="ltx_text ltx_font_bold">(c)</span></p>
</div></div><div class="ltx_flex_cell ltx_flex_size_4">
<div id="S4.F6.4" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_middle" style="width:82.8pt;"><img src="2509.04076v1/images/hist_50_nopc_f.png" id="S4.F6.g4" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:115/136;" width="115" height="136" alt="Refer to caption">
