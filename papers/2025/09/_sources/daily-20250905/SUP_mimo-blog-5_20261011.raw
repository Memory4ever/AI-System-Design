(() => {
  const root = document.documentElement;
  const selector = '[data-font-text]';
  const imageSelector = '[data-font-image]';
  const pendingSelector = '[data-font-text]:not([data-font-ready]), [data-font-image]:not([data-image-ready])';
  const maxWait = 1500;
  let currentPath = null;
  let cleanup = () => {};

  const isHome = (path) => /^\/(?:zh\/?)?(?:index(?:\.html)?)?$/.test(path);
  const familyName = (name) => name.trim().replace(/^["']|["']$/g, '');

  function stop() {
    cleanup();
    currentPath = null;
    root.classList.remove('home-fonts-loading');
  }

  function start() {
    const path = window.location.pathname;
    if (!isHome(path) || !document.fonts) {
      stop();
      return;
    }
    if (currentPath === path) return;
    stop();
    currentPath = path;

    let active = true;
    let pending = 0;
    let sawText = false;
    const seen = new Set();
    const requests = new Map();
    const busy = new Map();
    const imageListeners = new Set();
    const blockedInteractions = new Set();
    const ranges = new Map();

    function syncInteractions() {
      for (const element of document.querySelectorAll('[data-font-interactive]')) {
        if (element.matches(pendingSelector) || element.querySelector(pendingSelector)) {
          // Native inert also prevents keyboard focus and activation. Keep any
          // pre-existing inert state owned by the component itself.
          if (!element.inert) {
            element.inert = true;
            blockedInteractions.add(element);
          }
        } else if (blockedInteractions.delete(element)) {
          element.inert = false;
        }
      }
    }

    function finish() {
      if (!active) return;
      active = false;
      root.classList.remove('home-fonts-loading');
      clearTimeout(timer);
      observer.disconnect();
      document.removeEventListener('DOMContentLoaded', scan);
      for (const [element, readyKey] of busy) {
        element.dataset[readyKey] = 'fallback';
        element.removeAttribute('aria-busy');
      }
      for (const dispose of imageListeners) dispose();
      for (const element of blockedInteractions) element.inert = false;
      blockedInteractions.clear();
      imageListeners.clear();
      busy.clear();
    }

    function fontRanges() {
      // Called after stylesheets are ready; keep the actual CSS unicode ranges.
      if (ranges.size) return;
      for (const face of document.fonts) {
        const family = familyName(face.family);
        const list = ranges.get(family) || [];
        for (const part of face.unicodeRange.split(',')) {
          const range = part.trim().replace(/^U\+/i, '').split('-');
          const lower = parseInt(range[0].replace(/\?/g, '0'), 16);
          const upper = parseInt((range[1] || range[0]).replace(/\?/g, 'F'), 16);
          list.push([lower, upper]);
        }
        ranges.set(family, list);
      }
    }

    function requiredFonts(element) {
      const samples = new Map();
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
      while (walker.nextNode()) {
        const node = walker.currentNode;
        if (!node.textContent.trim()) continue;
        const style = getComputedStyle(node.parentElement);
        const families = style.fontFamily.split(',').map(familyName);
        for (const character of node.textContent) {
          const point = character.codePointAt(0);
          const family = families.find((name) => (ranges.get(name) || []).some(([a, b]) => a <= point && point <= b));
          if (!family) continue; // System font or a character outside our fonts.
          const spec = `${style.fontStyle} ${style.fontWeight} 16px "${family}"`;
          if (!samples.has(spec)) samples.set(spec, new Set());
          samples.get(spec).add(character);
        }
      }
      return [...samples].map(([spec, chars]) => [spec, [...chars].join('')]);
    }

    function scan() {
      if (!active) return;
      if (document.readyState === 'loading') {
        syncInteractions();
        return;
      }
      fontRanges();
      for (const image of document.querySelectorAll(imageSelector)) {
        if (seen.has(image)) continue;
        seen.add(image);
        sawText = true;
        if (image.complete) {
          image.dataset.imageReady = image.naturalWidth ? 'cached' : 'fallback';
          continue;
        }
        delete image.dataset.imageReady;
        image.setAttribute('aria-busy', 'true');
        busy.set(image, 'imageReady');
        pending++;
        const dispose = () => {
          image.removeEventListener('load', loaded);
          image.removeEventListener('error', failed);
          imageListeners.delete(dispose);
        };
        const reveal = (status) => {
          dispose();
          if (!active) return;
          release(image, status);
        };
        const loaded = () => {
          if (image.decode) image.decode().then(() => reveal('loaded'), () => reveal('fallback'));
          else reveal('loaded');
        };
        const failed = () => reveal('fallback');
        imageListeners.add(dispose);
        image.addEventListener('load', loaded, { once: true });
        image.addEventListener('error', failed, { once: true });
      }
      for (const element of document.querySelectorAll(selector)) {
        if (seen.has(element)) continue;
        seen.add(element);
        sawText = true;
        const rect = element.getBoundingClientRect();
        const style = getComputedStyle(element);
        // Offscreen text, hidden Blog entries and the hero's back face never
        // hold up the visible page. Their fonts still load normally through CSS.
        if (!rect.width || !rect.height || rect.bottom <= 0 || rect.top >= window.innerHeight || style.visibility === 'hidden' || element.closest('[aria-hidden="true"], [data-font-skip]')) {
