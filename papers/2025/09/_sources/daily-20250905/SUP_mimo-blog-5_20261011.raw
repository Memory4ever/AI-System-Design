    cleanup = finish;
    root.classList.add('home-fonts-loading');
    document.querySelectorAll(selector).forEach((element) => delete element.dataset.fontReady);
    observer.observe(root, { childList: true, subtree: true });
    document.addEventListener('DOMContentLoaded', scan, { once: true });
    scan();
  }

  window.__mimoHomeFonts = { start, stop };
  window.addEventListener('pageshow', (event) => { if (event.persisted) stop(); });
  start();
})();
