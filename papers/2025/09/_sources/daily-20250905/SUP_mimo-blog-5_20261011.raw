    background: #fff !important;
    border: 1px solid var(--bg-secondary) !important;
    border-radius: 10px !important;
    overflow: hidden !important;
}

.data-table-wrap .data-table tr {
    border: none !important;
    background: transparent !important;
}

.data-table-wrap .data-table th,
.data-table-wrap .data-table td {
    font-family: var(--font-title) !important;
    padding: 0.8rem 1.25rem !important;
    text-align: left !important;
    border: none !important;
    border-bottom: 1px solid var(--bg-secondary) !important;
}

.data-table-wrap .data-table th + th,
.data-table-wrap .data-table td + td {
    border-left: 1px solid var(--bg-secondary) !important;
}

.data-table-wrap .data-table thead th {
    background: var(--bg-secondary) !important;
    font-weight: 600 !important;
    color: var(--text-primary) !important;
    font-size: 0.68rem !important;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #e0d9d0 !important;
}

.data-table-wrap .data-table tbody tr:last-child td {
    border-bottom: none !important;
}

.data-table-wrap .data-table tbody td {
