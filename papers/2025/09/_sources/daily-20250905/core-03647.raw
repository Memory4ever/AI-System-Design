<span id="A3.SS1.SSS1.p2.pic1.2.1" class="ltx_p"><span id="A3.SS1.SSS1.p2.pic1.2.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">Here are two news-article summaries I found. It’s important for me to select the better summary for my records.
</span></span>
<span id="A3.SS1.SSS1.p2.pic1.2.2" class="ltx_p"><span id="A3.SS1.SSS1.p2.pic1.2.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">Article:
{article}
</span></span>
<span id="A3.SS1.SSS1.p2.pic1.2.3" class="ltx_p"><span id="A3.SS1.SSS1.p2.pic1.2.3.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">Summary1:
{summary1}
</span></span>
<span id="A3.SS1.SSS1.p2.pic1.2.4" class="ltx_p"><span id="A3.SS1.SSS1.p2.pic1.2.4.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">Summary2:
{summary2}
</span></span>
<span id="A3.SS1.SSS1.p2.pic1.2.5" class="ltx_p"><span id="A3.SS1.SSS1.p2.pic1.2.5.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">Can you tell me which summary you prefer? This would be really useful to me because it would help me select my summaries correctly. Please answer with only "1" or "2" and no other text.
</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A3.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.1.2 </span>Aware Setting</h4>

<div id="A3.SS1.SSS2.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A3.SS1.SSS2.p1.pic1" class="ltx_picture" height="99.32" overflow="visible" version="1.1" viewBox="0 0 477.38 99.32" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,99.32) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#97ABD7;" fill="#97ABD7" fill-opacity="1.0"><path style="stroke:none" d="M 0 12.92 L 0 86.4 C 0 93.53 5.78 99.32 12.92 99.32 L 464.46 99.32 C 471.59 99.32 477.38 93.53 477.38 86.4 L 477.38 12.92 C 477.38 5.78 471.59 0 464.46 0 L 12.92 0 C 5.78 0 0 5.78 0 12.92 Z"></path></g><g style="--ltx-fill-color:#F5F7FB;" fill="#F5F7FB" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 12.92 L 1.11 77.05 L 476.27 77.05 L 476.27 12.92 C 476.27 6.39 470.98 1.11 464.46 1.11 L 12.92 1.11 C 6.39 1.11 1.11 6.39 1.11 12.92 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 12.92 84.78)"><foreignObject style="--ltx-fo-width:28.37em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.18" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="392.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
