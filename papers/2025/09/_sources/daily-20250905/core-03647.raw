</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 12.92 11.47)"><foreignObject style="--ltx-fo-width:34.53em;--ltx-fo-height:2.95em;--ltx-fo-depth:0.18em;font-size:10pt;" height="43.31" overflow="visible" transform="matrix(1 0 0 -1 0 40.82)" width="477.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
