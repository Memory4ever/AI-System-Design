<span id="A3.SS1.SSS1.p1.pic1.2.1" class="ltx_p"><span id="A3.SS1.SSS1.p1.pic1.2.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">You are a helpful assistant and a news article summarizer. You help compare summaries to help me with my records. You respond with only "1" or "2" and no other text.
</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A3.SS1.SSS1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A3.SS1.SSS1.p2.pic1" class="ltx_picture" height="165.74" overflow="visible" version="1.1" viewBox="0 0 477.38 165.74" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,165.74) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#F3B0A4;" fill="#F3B0A4" fill-opacity="1.0"><path style="stroke:none" d="M 0 12.92 L 0 152.82 C 0 159.95 5.78 165.74 12.92 165.74 L 464.46 165.74 C 471.59 165.74 477.38 159.95 477.38 152.82 L 477.38 12.92 C 477.38 5.78 471.59 0 464.46 0 L 12.92 0 C 5.78 0 0 5.78 0 12.92 Z"></path></g><g style="--ltx-fill-color:#FEF6F4;" fill="#FEF6F4" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 12.92 L 1.11 143.46 L 476.27 143.46 L 476.27 12.92 C 476.27 6.39 470.98 1.11 464.46 1.11 L 12.92 1.11 C 6.39 1.11 1.11 6.39 1.11 12.92 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 12.92 151.2)"><foreignObject style="--ltx-fo-width:28.37em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.18" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="392.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
