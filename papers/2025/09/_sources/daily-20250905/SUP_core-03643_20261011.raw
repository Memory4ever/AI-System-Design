<span id="S4.SS3.p2.1.5.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:2.5pt 5.0pt;">82.9 <math id="S4.SS3.m21" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.7%</span></span>
<span id="S4.SS3.p2.1.5.4.2.1.2" class="ltx_tr">
