<span id="S4.SS3.p2.1.5.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:2.5pt 5.0pt;">33.3 <math id="S4.SS3.m20" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.6%</span></span>
</span></span><span id="S4.SS3.p2.1.5.3.3" class="ltx_text"></span></td>
