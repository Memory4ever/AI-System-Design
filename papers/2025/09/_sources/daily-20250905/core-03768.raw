<td id="S5.T1.1.9.3" class="ltx_td ltx_align_center ltx_border_t">2</td>
<td id="S5.T1.1.9.4" class="ltx_td ltx_align_center ltx_border_t">–</td>
<td id="S5.T1.1.9.5" class="ltx_td ltx_align_center ltx_border_t">–</td>
