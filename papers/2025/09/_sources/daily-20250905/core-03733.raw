<th id="S5.T8.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">ViT-Base</th>
<th id="S5.T8.2.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">196</th>
<td id="S5.T8.2.3.3" class="ltx_td ltx_align_center">12.1%</td>
<td id="S5.T8.2.3.4" class="ltx_td ltx_align_center">4.8%</td></tr>
<tr id="S5.T8.2.4" class="ltx_tr">
<th id="S5.T8.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">ViT-Large</th>
<th id="S5.T8.2.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">196</th>
