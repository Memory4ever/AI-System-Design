<th id="S5.T7.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Top-1 Accuracy</th>
<th id="S5.T7.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Sparsity</th>
<th id="S5.T7.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">FLOPs Reduction</th></tr>
