<td id="S5.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t">93.5</td>
<td id="S5.T6.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0%</td></tr>
<tr id="S5.T6.2.3" class="ltx_tr">
