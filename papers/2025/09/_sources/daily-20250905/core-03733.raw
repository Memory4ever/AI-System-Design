<th id="S5.T8.2.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">196</th>
<td id="S5.T8.2.2.3" class="ltx_td ltx_align_center ltx_border_t">8.2%</td>
