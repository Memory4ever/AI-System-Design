<th id="S5.T6.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Accuracy</th>
<th id="S5.T6.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Sparsity</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T6.2.2" class="ltx_tr">
