<td id="S5.T7.2.5.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T7.2.5.2.1" class="ltx_text ltx_font_bold">80.1%</span></td>
<td id="S5.T7.2.5.3" class="ltx_td ltx_align_center ltx_border_bb">80%</td>
<td id="S5.T7.2.5.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T7.2.5.4.1" class="ltx_text ltx_font_bold">67%</span></td></tr>
</tbody>
</table>
