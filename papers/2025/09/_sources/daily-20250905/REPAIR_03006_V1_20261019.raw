<tr id="S4.T7.4.1.6" class="ltx_tr">
<th id="S4.T7.4.1.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r"><span id="S4.T7.4.1.6.1.1" class="ltx_text" style="font-size:80%;">StegaStamp_MP(Ours)</span></th>
<td id="S4.T7.4.1.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T7.4.1.6.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">61.396</span></td>
<td id="S4.T7.4.1.6.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T7.4.1.6.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">97.063</span></td>
<td id="S4.T7.4.1.6.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T7.4.1.6.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">59.733</span></td>
<td id="S4.T7.4.1.6.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T7.4.1.6.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">57.48</span></td>
<td id="S4.T7.4.1.6.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T7.4.1.6.6.1" class="ltx_text ltx_font_bold" style="font-size:80%;">68.918</span></td></tr>
