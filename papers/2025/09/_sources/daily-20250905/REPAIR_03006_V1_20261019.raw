<div id="S4.T11.4" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:395.3pt;height:29.8pt;vertical-align:-13.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-49.4pt,3.7pt) scale(0.8,0.8) ;">
<table id="S4.T11.4.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T11.4.1.1" class="ltx_tr">
