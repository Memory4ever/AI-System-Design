<th id="A1.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="A1.T3.2.4.1.1" class="ltx_text ltx_font_bold">Llama 3.3</span></th>
<td id="A1.T3.2.4.2" class="ltx_td ltx_align_center">44.1</td>
<td id="A1.T3.2.4.3" class="ltx_td ltx_align_center">42.3</td>
<td id="A1.T3.2.4.4" class="ltx_td ltx_align_center ltx_border_r">38.8</td>
<td id="A1.T3.2.4.5" class="ltx_td ltx_align_center">+4.7</td></tr>
<tr id="A1.T3.2.5" class="ltx_tr">
<th id="A1.T3.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="A1.T3.2.5.1.1" class="ltx_text ltx_font_bold">Qwen</span></th>
<td id="A1.T3.2.5.2" class="ltx_td ltx_align_center">43.3</td>
<td id="A1.T3.2.5.3" class="ltx_td ltx_align_center">43.7</td>
<td id="A1.T3.2.5.4" class="ltx_td ltx_align_center ltx_border_r">42.2</td>
<td id="A1.T3.2.5.5" class="ltx_td ltx_align_center">+16.2</td></tr>
<tr id="A1.T3.2.6" class="ltx_tr">
<th id="A1.T3.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r"><span id="A1.T3.2.6.1.1" class="ltx_text ltx_font_bold">Deepseek</span></th>
<td id="A1.T3.2.6.2" class="ltx_td ltx_align_center ltx_border_b">40.7</td>
