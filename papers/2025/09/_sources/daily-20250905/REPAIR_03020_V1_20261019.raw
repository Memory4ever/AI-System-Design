<td id="A1.T7.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 4.0pt;"><math id="A1.T7.m1" class="ltx_Math" alttext="\approx 4hrs" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><annotation encoding="application/x-tex">\approx 4hrs</annotation></semantics></math></td>
