<th id="A1.T6.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:0.5pt 4.0pt;"><span id="A1.T6.2.1.2.1" class="ltx_text ltx_font_bold">Instruction(s)</span></th></tr>
