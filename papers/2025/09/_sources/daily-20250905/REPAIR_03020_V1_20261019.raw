<td id="A1.T6.2.3.1" class="ltx_td" style="padding:0.5pt 4.0pt;"></td>
<td id="A1.T6.2.3.2" class="ltx_td ltx_align_left" style="padding:0.5pt 4.0pt;">Retrieve semantically similar text</td></tr>
<tr id="A1.T6.2.4" class="ltx_tr">
<td id="A1.T6.2.4.1" class="ltx_td ltx_align_left" style="padding:0.5pt 4.0pt;">DuReader</td>
<td id="A1.T6.2.4.2" class="ltx_td ltx_align_left" style="padding:0.5pt 4.0pt;">Given a Chinese search query, retrieve web passages that answer the question</td></tr>
