<span id="A1.T4.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:899.0pt;height:313.2pt;vertical-align:-154.1pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<span id="A1.T4.2.1.1.1.1" class="ltx_p"><span id="A1.T4.2.1.1.1.1.1" class="ltx_text">
<span id="A1.T4.2.1.1.1.1.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<span class="ltx_tbody">
<span id="A1.T4.2.1.1.1.1.1.1.1" class="ltx_tr">
