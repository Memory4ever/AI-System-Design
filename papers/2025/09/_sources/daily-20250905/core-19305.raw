<td id="S4.T1.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.2.4.1" class="ltx_text" style="font-size:90%;">91.6</span></td>
<td id="S4.T1.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.2.5.1" class="ltx_text" style="font-size:90%;">86.7</span></td>
<td id="S4.T1.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.2.6.1" class="ltx_text" style="font-size:90%;">86.8</span></td>
<td id="S4.T1.3.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.2.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">95</span></td>
<td id="S4.T1.3.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.2.8.1" class="ltx_text" style="font-size:90%;">53.3</span></td>
<td id="S4.T1.3.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.2.9.1" class="ltx_text" style="font-size:90%;">90.6</span></td>
<td id="S4.T1.3.1.2.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.2.10.1" class="ltx_text" style="font-size:90%;">92.8 <math id="S4.T1.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.1</span></td></tr>
<tr id="S4.T1.3.1.3" class="ltx_tr">
<td id="S4.T1.3.1.3.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.3.1.1" class="ltx_text" style="font-size:90%;">Hopper</span></td>
<td id="S4.T1.3.1.3.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.3.2.1" class="ltx_text" style="font-size:90%;">52.5</span></td>
<td id="S4.T1.3.1.3.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.3.3.1" class="ltx_text" style="font-size:90%;">105.4</span></td>
<td id="S4.T1.3.1.3.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.3.4.1" class="ltx_text" style="font-size:90%;">91.5</span></td>
<td id="S4.T1.3.1.3.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.3.5.1" class="ltx_text" style="font-size:90%;">107.6</span></td>
<td id="S4.T1.3.1.3.6" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.3.6.1" class="ltx_text" style="font-size:90%;">110.0</span></td>
<td id="S4.T1.3.1.3.7" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.3.7.1" class="ltx_text" style="font-size:90%;">108.7</span></td>
<td id="S4.T1.3.1.3.8" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.3.8.1" class="ltx_text" style="font-size:90%;">111.8</span></td>
<td id="S4.T1.3.1.3.9" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.3.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;">114.7<span id="S4.T1.3.1.3.9.1.1" class="ltx_text ltx_font_medium"> <math id="S4.T1.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.3</span></span></td></tr>
<tr id="S4.T1.3.1.4" class="ltx_tr">
<td id="S4.T1.3.1.4.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.4.1.1" class="ltx_text" style="font-size:90%;">Walker2d</span></td>
<td id="S4.T1.3.1.4.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.4.2.1" class="ltx_text" style="font-size:90%;">107.5</span></td>
<td id="S4.T1.3.1.4.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.4.3.1" class="ltx_text" style="font-size:90%;">108.8</span></td>
