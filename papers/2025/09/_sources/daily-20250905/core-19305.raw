<td id="S4.T1.3.1.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.3.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Environment</span></td>
