<th id="S3.T1.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt">Loss</th>
<th id="S3.T1.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">UAR<math id="S3.T1.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math> (%)</th>
<th id="S3.T1.3.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">F1<math id="S3.T1.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math> (%)</th>
