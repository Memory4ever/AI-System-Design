            <span id="alg1.l23.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.l23.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{ce}}\leftarrow\operatorname{CE}\bigl(g(H),Y\bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">ce</mtext></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">CE</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi mathsize="0.900em">g</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">H</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">Y</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{ce}}\leftarrow\operatorname{CE}\bigl(g(H),Y\bigr)</annotation></semantics></math><span id="alg1.l23.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              
            <span id="alg1.l24.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.l24.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{grad}}\leftarrow\sum_{j=1}^{k}\bigl(\nabla_{H}\,\mathcal{L}_{\text{ce}}\;\cdot\;L_{j}\bigr)^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">grad</mtext></msub><mo mathsize="0.900em" rspace="0.111em" stretchy="false">←</mo><mrow><msubsup><mo maxsize="0.900em" minsize="0.900em" rspace="0em" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">j</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">k</mi></msubsup><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">H</mi></msub><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">ce</mtext></msub></mrow><mo lspace="0.222em" mathsize="0.900em" rspace="0.502em">⋅</mo><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">j</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{grad}}\leftarrow\sum_{j=1}^{k}\bigl(\nabla_{H}\,\mathcal{L}_{\text{ce}}\;\cdot\;L_{j}\bigr)^{2}</annotation></semantics></math><span id="alg1.l24.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
              
              
            <span id="alg1.l25.3" class="ltx_text" style="font-size:90%;">  Update </span><math id="alg1.l25.m1" class="ltx_Math" alttext="f_{\text{pen}},g" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">f</mi><mtext mathsize="0.900em">pen</mtext></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">g</mi></mrow><annotation encoding="application/x-tex">f_{\text{pen}},g</annotation></semantics></math><span id="alg1.l25.4" class="ltx_text" style="font-size:90%;"> w.r.t. </span><math id="alg1.l25.m2" class="ltx_Math" alttext="\mathcal{L}_{\text{ce}}+\lambda_{\text{supp}}\,\mathcal{L}_{\text{grad}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">ce</mtext></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">λ</mi><mtext mathsize="0.900em">supp</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">grad</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{ce}}+\lambda_{\text{supp}}\,\mathcal{L}_{\text{grad}}</annotation></semantics></math><span id="alg1.l25.5" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l26.1" class="ltx_text" style="font-size:80%;">26:</span></span>
              
              
            <span id="alg1.l26.3" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg1.l26.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l26.5" class="ltx_text ltx_font_bold" style="font-size:90%;">forreturn</span><span id="alg1.l26.6" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l26.m1" class="ltx_Math" alttext="f_{\text{debiased}}\leftarrow f" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">f</mi><mtext mathsize="0.900em">debiased</mtext></msub><mo mathsize="0.900em" stretchy="false">←</mo><mi mathsize="0.900em">f</mi></mrow><annotation encoding="application/x-tex">f_{\text{debiased}}\leftarrow f</annotation></semantics></math><span id="alg1.l26.7" class="ltx_text" style="font-size:90%;">
</span>
</div>
</div>
</figure>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Experiments &amp; Evaluation Metric</h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Datasets</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">We evaluate our method on diverse set of multi-attribute bias datasets, each designed to probe model robustness under complex spurious correlations:</p>
<ul id="S4.I1" class="ltx_itemize">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">FB-CMNIST</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib31" title="" class="ltx_ref">Sarridis et al. (2024)</a></cite>: This is a synthetic extension of the Colored MNIST dataset<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib1" title="" class="ltx_ref">Bahng et al. (2020)</a></cite>, where each digit is modified with two spurious biases—background color and foreground (digit) color—enabling the study of models under multiple simultaneous correlations.</p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;padding-top:4.0pt;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">CelebA</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib25" title="" class="ltx_ref">Liu et al. (2015)</a></cite>: CelebA comprises real-world face images annotated with 40 binary attributes, including gender, hair color, age, and various facial accessories. We employ this dataset to study multi-attribute bias in a binary gender classification setting. Concretely, we take the Male attribute as our target label and select <span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">Wearing_Lipstick</span> and <span id="S4.I1.i2.p1.1.3" class="ltx_text ltx_font_italic">Heavy_Makeup</span> as spurious attributes since they are known to correlate strongly with the female gender and can introduce significant bias <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib19" title="" class="ltx_ref">Lang et al. (2021b)</a></cite>.</p>
</div></li>
<li id="S4.I1.i3" class="ltx_item" style="list-style-type:none;padding-top:4.0pt;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p"><span id="S4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">COCO</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib23" title="" class="ltx_ref">Lin et al. (2015)</a></cite>: We construct a custom dataset based on the COCO2017 dataset <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib23" title="" class="ltx_ref">Lin et al. (2015)</a></cite> to study gender and object-based biases following the work in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib39" title="" class="ltx_ref">Zhao et al. (2021)</a></cite>. Gender labels are derived from image captions by scanning for gender-indicative keywords. To introduce bias labels, we define two object bias categories using COCO instance annotations. <span id="S4.I1.i3.p1.1.2" class="ltx_text ltx_font_bold">Bias Category 1</span> includes various sports and outdoor objects objects while <span id="S4.I1.i3.p1.1.3" class="ltx_text ltx_font_bold">Bias Category 2</span> includes various indoor and kitchen objects.</p>
</div></li>
</ul>
</div>
<div id="S4.SS1.p2" class="ltx_para ltx_noindent">
<p id="S4.SS1.p2.1" class="ltx_p"><span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_bold">Implementation Details: </span>For FB-CMNIST, a simple 7-layer convolutional neural network was used as both the model backbone and the bias-capturing classifier. For the CelebA and COCO datasets, the standard ResNet-18 architecture was employed. The CMNIST model was trained for 80 epochs, followed by 10 epochs of fine-tuning. Similarly, the ResNet-18 models were trained for 20 epochs and fine-tuned for an additional 10 epochs. In both cases, we used an initial learning rate of <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="10^{-3}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><annotation encoding="application/x-tex">10^{-3}</annotation></semantics></math> for the main training phase and <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="10^{-4}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><annotation encoding="application/x-tex">10^{-4}</annotation></semantics></math> for fine-tuning, both steps were employed with the Adam optimizer. A batch size of 128 was used across all experiments. Table <a href="#S4.T1" title="Table 1 ‣ 4.1 Datasets ‣ 4 Experiments &amp; Evaluation Metric ‣ Multi-Attribute Bias Mitigationvia Representation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> summarizes the hyperparameters used.</p>
</div>
<figure id="S4.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 1: </span>Key hyper-parameters used throughout all experiments.</figcaption>
<div id="S4.T1.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:161.3pt;height:65.9pt;vertical-align:-30.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-9.0pt,3.7pt) scale(0.9,0.9) ;">
<table id="S4.T1.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T1.2.1.1" class="ltx_tr">
<th id="S4.T1.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt">Symbol</th>
<th id="S4.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Meaning</th>
<th id="S4.T1.2.1.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt">Default</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.2.1.2" class="ltx_tr">
<th id="S4.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="S4.T1.m1" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math></th>
<td id="S4.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">ABIL epochs</td>
<td id="S4.T1.2.1.2.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><math id="S4.T1.m2" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math></td></tr>
<tr id="S4.T1.2.1.3" class="ltx_tr">
<th id="S4.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S4.T1.m3" class="ltx_Math" alttext="T_{2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>2</mn></msub><annotation encoding="application/x-tex">T_{2}</annotation></semantics></math></th>
<td id="S4.T1.2.1.3.2" class="ltx_td ltx_align_center">Suppression epochs</td>
<td id="S4.T1.2.1.3.3" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S4.T1.m4" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math></td></tr>
<tr id="S4.T1.2.1.4" class="ltx_tr">
<th id="S4.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S4.T1.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></th>
<td id="S4.T1.2.1.4.2" class="ltx_td ltx_align_center">Bias–loss weight</td>
<td id="S4.T1.2.1.4.3" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S4.T1.m6" class="ltx_Math" alttext="0.2" display="inline" intent=":literal"><semantics><mn>0.2</mn><annotation encoding="application/x-tex">0.2</annotation></semantics></math></td></tr>
<tr id="S4.T1.2.1.5" class="ltx_tr">
<th id="S4.T1.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S4.T1.m7" class="ltx_Math" alttext="\lambda_{\text{supp}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mtext>supp</mtext></msub><annotation encoding="application/x-tex">\lambda_{\text{supp}}</annotation></semantics></math></th>
<td id="S4.T1.2.1.5.2" class="ltx_td ltx_align_center">Gradient penalty</td>
<td id="S4.T1.2.1.5.3" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S4.T1.m8" class="ltx_Math" alttext="10^{-2}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">10^{-2}</annotation></semantics></math></td></tr>
<tr id="S4.T1.2.1.6" class="ltx_tr">
<th id="S4.T1.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="S4.T1.m9" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math></th>
