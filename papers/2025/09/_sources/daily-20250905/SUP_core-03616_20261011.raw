<div id="S5.T7.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:469.2pt;height:84.7pt;vertical-align:-39.9pt;"><span class="ltx_transformed_inner" style="transform:translate(-4.8pt,0.9pt) scale(1.0,1.0) ;">
