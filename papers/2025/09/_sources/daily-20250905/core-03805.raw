<td id="S4.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">805.72 <math id="S4.T1.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 123.85</td>
<td id="S4.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">15.48 <math id="S4.T1.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.52</td></tr>
<tr id="S4.T1.2.1.3" class="ltx_tr">
