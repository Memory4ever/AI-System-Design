<td id="S4.T1.2.1.3.3" class="ltx_td ltx_align_center">800.08 <math id="S4.T1.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 116.87</td>
<td id="S4.T1.2.1.3.4" class="ltx_td ltx_align_center">14.68 <math id="S4.T1.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.51</td></tr>
