<td id="S5.T1.6.1.7.3" class="ltx_td ltx_align_center">✓</td>
<td id="S5.T1.6.1.7.4" class="ltx_td ltx_align_center"><math id="S5.T1.m15" class="ltx_Math" alttext="L_{g}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>g</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L_{g}&lt;1</annotation></semantics></math></td>
<td id="S5.T1.6.1.7.5" class="ltx_td ltx_align_center">✗</td>
<td id="S5.T1.6.1.7.6" class="ltx_td ltx_align_center">✓</td>
<td id="S5.T1.6.1.7.7" class="ltx_td ltx_align_center">✓</td>
<td id="S5.T1.6.1.7.8" class="ltx_td ltx_align_center"><math id="S5.T1.m16" class="ltx_Math" alttext="\mathcal{O}(1/\sqrt{k})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msqrt><mi>k</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(1/\sqrt{k})</annotation></semantics></math></td>
<td id="S5.T1.6.1.7.9" class="ltx_td ltx_nopad_r ltx_align_center">✓</td></tr>
