<th id="S4.T2.fig1.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding:-1pt 4.0pt;">30px</th>
<td id="S4.T2.fig1.2.1.6.2" class="ltx_td ltx_align_center" style="padding:-1pt 4.0pt;">0.806</td>
<td id="S4.T2.fig1.2.1.6.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:-1pt 4.0pt;">0.780</td>
<td id="S4.T2.fig1.2.1.6.4" class="ltx_td ltx_align_center" style="padding:-1pt 4.0pt;">0.647</td>
