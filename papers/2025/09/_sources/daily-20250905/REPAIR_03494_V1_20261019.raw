<td id="S4.T3.fig1.2.1.22.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-1pt 4.0pt;"><span id="S4.T3.fig1.2.1.22.2.1" class="ltx_text ltx_font_bold">0.932</span></td>
