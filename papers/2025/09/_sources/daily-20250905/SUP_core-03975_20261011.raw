</table>
</figure>
<figure id="S3.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 2: </span>Segmentation accuracy (and standard deviation between the datasets) with <math id="S3.T2.m2" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn>12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math> triplets used for training between the proposed Y-Net and the baseline U-Net</figcaption>
<table id="S3.T2.1" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S3.T2.1.1" class="ltx_tr">
<td id="S3.T2.1.1.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;">Model</td>
<td id="S3.T2.1.1.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Dice Score</td>
<td id="S3.T2.1.1.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Jaccard Score</td>
<td id="S3.T2.1.1.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Mean Surface Distance</td>
<td id="S3.T2.1.1.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Recall</td>
