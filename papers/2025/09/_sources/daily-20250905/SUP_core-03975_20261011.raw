<td id="S3.T7.1.11.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">U-Net</td>
<td id="S3.T7.1.11.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">0.37 (0.10)</td>
<td id="S3.T7.1.11.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">0.52 (0.07)</td>
