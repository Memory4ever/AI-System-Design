<td id="S5.T6.5.1.10.6" class="ltx_td ltx_align_right ltx_border_t"><math id="S5.T6.m54" class="ltx_Math" alttext="30.09" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">30.09</mn><annotation encoding="application/x-tex">30.09</annotation></semantics></math><span id="S5.T6.5.1.10.6.1" class="ltx_text" style="font-size:90%;"> M</span></td>
<td id="S5.T6.5.1.10.7" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T6.m55" class="ltx_Math" alttext="14.9" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">14.9</mn><annotation encoding="application/x-tex">14.9</annotation></semantics></math></td></tr>
<tr id="S5.T6.5.1.11" class="ltx_tr">
<td id="S5.T6.5.1.11.1" class="ltx_td ltx_align_left ltx_border_r"><math id="S5.T6.m56" class="ltx_Math" alttext="20\%" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">20</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">20\%</annotation></semantics></math></td>
<td id="S5.T6.5.1.11.2" class="ltx_td ltx_align_right"><math id="S5.T6.m57" class="ltx_Math" alttext="21.63" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">21.63</mn><annotation encoding="application/x-tex">21.63</annotation></semantics></math><span id="S5.T6.5.1.11.2.1" class="ltx_text" style="font-size:90%;"> M</span></td>
<td id="S5.T6.5.1.11.3" class="ltx_td ltx_align_center"><math id="S5.T6.m58" class="ltx_Math" alttext="14.7" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">14.7</mn><annotation encoding="application/x-tex">14.7</annotation></semantics></math></td>
<td id="S5.T6.5.1.11.4" class="ltx_td ltx_align_center ltx_border_r"><math id="S5.T6.m59" class="ltx_Math" alttext="14.7" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">14.7</mn><annotation encoding="application/x-tex">14.7</annotation></semantics></math></td>
<td id="S5.T6.5.1.11.5" class="ltx_td ltx_align_right"><math id="S5.T6.m60" class="ltx_Math" alttext="43.26" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">43.26</mn><annotation encoding="application/x-tex">43.26</annotation></semantics></math><span id="S5.T6.5.1.11.5.1" class="ltx_text" style="font-size:90%;"> M</span></td>
