<td id="A3.T12.4.1.2.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="A3.T12.4.1.2.2.1" class="ltx_text" style="font-size:90%;">11.55</span></td>
<td id="A3.T12.4.1.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="A3.T12.4.1.2.3.1" class="ltx_text" style="font-size:90%;">11.74</span></td>
