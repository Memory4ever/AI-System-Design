<td id="S5.T8.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">60.6%</td></tr>
<tr id="S5.T8.4.1.3" class="ltx_tr">
<th id="S5.T8.4.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.0pt;padding-right:2.0pt;">DiffusionLight</th>
<td id="S5.T8.4.1.3.2" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">0.057</td>
<td id="S5.T8.4.1.3.3" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">0.987</td>
<td id="S5.T8.4.1.3.4" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">60.6%</td></tr>
<tr id="S5.T8.4.1.4" class="ltx_tr">
<th id="S5.T8.4.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.0pt;padding-right:2.0pt;">DiPIR</th>
