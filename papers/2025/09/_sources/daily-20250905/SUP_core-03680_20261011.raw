<td id="S1.F1.2.1.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S1.F1.2.1.2.3.1" class="ltx_text ltx_align_center ltx_inline-block" style="width:113.9pt;">Virtual Object Insertion</span></td></tr>
