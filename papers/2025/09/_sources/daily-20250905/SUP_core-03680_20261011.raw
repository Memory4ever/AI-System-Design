<th id="S5.T8.4.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T8.4.1.1.1.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="S5.T8.4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T8.4.1.1.2.1" class="ltx_text ltx_font_bold">RMSE</span> <math id="S5.T8.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<th id="S5.T8.4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T8.4.1.1.3.1" class="ltx_text ltx_font_bold">SSIM</span> <math id="S5.T8.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S5.T8.4.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T8.4.1.1.4.1" class="ltx_text ltx_font_bold">Ours Preferred</span></th></tr>
