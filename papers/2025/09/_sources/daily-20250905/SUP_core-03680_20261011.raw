<td id="A3.T12.4.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="A3.T12.4.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">CNN</span></td>
