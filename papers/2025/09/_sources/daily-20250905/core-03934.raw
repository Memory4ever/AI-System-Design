<td id="S4.T3.2.3.2" class="ltx_td ltx_align_left">56.19</td>
<td id="S4.T3.2.3.3" class="ltx_td ltx_align_left"><span id="S4.T3.2.3.3.1" class="ltx_text ltx_font_bold">62.48</span> <span id="S4.T3.2.3.3.2" class="ltx_text" style="--ltx-fg-color:#008000;">6.29<math id="S4.T3.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#008000;" mathcolor="#008000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
