<td id="S6.T4.5.1.2" class="ltx_td ltx_align_right ltx_border_tt"><math id="S6.T4.m2" class="ltx_Math" alttext="d_{model}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">d_{model}</annotation></semantics></math></td>
