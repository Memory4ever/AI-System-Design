<td id="S4.T2.5.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="5">% Non-Hallucinations (NH) <math id="S4.T2.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S4.T2.5.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="2">%Abs <math id="S4.T2.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S4.T2.5.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="2">%Abs but NH <math id="S4.T2.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
