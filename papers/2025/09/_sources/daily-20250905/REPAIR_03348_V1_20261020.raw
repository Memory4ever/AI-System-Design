              <span id="alg2.l5.3" class="ltx_text" style="font-size:70%;">   Get action: </span><math id="alg2.l5.m1" class="ltx_math_unparsed" alttext="\boldsymbol{a}_{t}=f_{\varphi}(\boldsymbol{s}_{t-L:t},\boldsymbol{\tilde{s}}^{\prime}_{t+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">𝒂</mi><mi mathsize="0.700em">t</mi></msub><mo mathsize="0.700em">=</mo><msub><mi mathsize="0.700em">f</mi><mi mathsize="0.700em">φ</mi></msub><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">𝒔</mi><mrow><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">L</mi></mrow><mo lspace="0.278em" mathsize="0.700em" rspace="0.278em">:</mo><mi mathsize="0.700em">t</mi></mrow></msub><mo mathsize="0.700em">,</mo><msubsup><mover accent="true"><mi mathsize="0.700em">𝒔</mi><mo>~</mo></mover><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">+</mo><mn mathsize="0.700em">1</mn></mrow><mo mathsize="0.700em">′</mo></msubsup><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{a}_{t}=f_{\varphi}(\boldsymbol{s}_{t-L:t},\boldsymbol{\tilde{s}}^{\prime}_{t+1})</annotation></semantics></math><span id="alg2.l5.4" class="ltx_text" style="font-size:70%;">
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
                
                
              <span id="alg2.l6.3" class="ltx_text" style="font-size:70%;">   Execute bids and get next state </span><math id="alg2.l6.m1" class="ltx_Math" alttext="\boldsymbol{s}_{t+1}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">𝒔</mi><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">+</mo><mn mathsize="0.700em">1</mn></mrow></msub><annotation encoding="application/x-tex">\boldsymbol{s}_{t+1}</annotation></semantics></math><span id="alg2.l6.4" class="ltx_text" style="font-size:70%;"> from the ad system
</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
                
                
              <span id="alg2.l7.3" class="ltx_text" style="font-size:70%;">   Update query: </span><math id="alg2.l7.m1" class="ltx_Math" alttext="\{\boldsymbol{s}_{0},...,\boldsymbol{s}_{t},\boldsymbol{s}_{t+1}\}\leftarrow\{\boldsymbol{s}_{0},...,\boldsymbol{s}_{t}\}\oplus{\boldsymbol{s}}_{t+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><msub><mi mathsize="0.700em">𝒔</mi><mn mathsize="0.700em">0</mn></msub><mo mathsize="0.700em">,</mo><mi mathsize="0.700em" mathvariant="normal">…</mi><mo mathsize="0.700em">,</mo><msub><mi mathsize="0.700em">𝒔</mi><mi mathsize="0.700em">t</mi></msub><mo mathsize="0.700em">,</mo><msub><mi mathsize="0.700em">𝒔</mi><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">+</mo><mn mathsize="0.700em">1</mn></mrow></msub></mrow><mo stretchy="false">}</mo></mrow><mo mathsize="0.700em" stretchy="false">←</mo><mrow><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.700em">𝒔</mi><mn mathsize="0.700em">0</mn></msub><mo mathsize="0.700em">,</mo><mi mathsize="0.700em" mathvariant="normal">…</mi><mo mathsize="0.700em">,</mo><msub><mi mathsize="0.700em">𝒔</mi><mi mathsize="0.700em">t</mi></msub><mo stretchy="false">}</mo></mrow><mo mathsize="0.700em">⊕</mo><msub><mi mathsize="0.700em">𝒔</mi><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">+</mo><mn mathsize="0.700em">1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\{\boldsymbol{s}_{0},...,\boldsymbol{s}_{t},\boldsymbol{s}_{t+1}\}\leftarrow\{\boldsymbol{s}_{0},...,\boldsymbol{s}_{t}\}\oplus{\boldsymbol{s}}_{t+1}</annotation></semantics></math><span id="alg2.l7.4" class="ltx_text" style="font-size:70%;">
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
                
                
              <span id="alg2.l8.3" class="ltx_text ltx_font_bold" style="font-size:70%;">end</span><span id="alg2.l8.4" class="ltx_text" style="font-size:70%;"> </span><span id="alg2.l8.5" class="ltx_text ltx_font_bold" style="font-size:70%;">for</span>
</div>
</div>
</figure></div></div>
