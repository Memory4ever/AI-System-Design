              <span id="alg2.l3.3" class="ltx_text" style="font-size:70%;">   Generate future states </span><math id="alg2.l3.m1" class="ltx_Math" alttext="\{\boldsymbol{\tilde{s}}_{t+1},...,\boldsymbol{\tilde{s}}_{T}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi mathsize="0.700em">𝒔</mi><mo>~</mo></mover><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">+</mo><mn mathsize="0.700em">1</mn></mrow></msub><mo mathsize="0.700em">,</mo><mi mathsize="0.700em" mathvariant="normal">…</mi><mo mathsize="0.700em">,</mo><msub><mover accent="true"><mi mathsize="0.700em">𝒔</mi><mo>~</mo></mover><mi mathsize="0.700em">T</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{\tilde{s}}_{t+1},...,\boldsymbol{\tilde{s}}_{T}\}</annotation></semantics></math><span id="alg2.l3.4" class="ltx_text" style="font-size:70%;"> using completer </span><math id="alg2.l3.m2" class="ltx_Math" alttext="\epsilon_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">ϵ</mi><mi mathsize="0.700em">θ</mi></msub><annotation encoding="application/x-tex">\epsilon_{\theta}</annotation></semantics></math><span id="alg2.l3.5" class="ltx_text" style="font-size:70%;"> by Eq. </span><a href="#S3.E7" title="In 3.1 Completer: Learning to Complete in Training ‣ 3 Causal Auto-Bidding via Diffusion Completer-Aligner ‣ Generative Auto-Bidding in Large-Scale Competitive Auctions via Diffusion Completer-Aligner" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a><span id="alg2.l3.6" class="ltx_text" style="font-size:70%;">
