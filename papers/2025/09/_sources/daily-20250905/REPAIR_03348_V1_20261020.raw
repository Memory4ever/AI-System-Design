              <span id="alg2.l1.3" class="ltx_text" style="font-size:70%;">Initialize: initial state </span><math id="alg2.l1.m1" class="ltx_Math" alttext="\{\boldsymbol{s}_{0}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.700em">𝒔</mi><mn mathsize="0.700em">0</mn></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{s}_{0}\}</annotation></semantics></math><span id="alg2.l1.4" class="ltx_text" style="font-size:70%;">, completer </span><math id="alg2.l1.m2" class="ltx_Math" alttext="\epsilon_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">ϵ</mi><mi mathsize="0.700em">θ</mi></msub><annotation encoding="application/x-tex">\epsilon_{\theta}</annotation></semantics></math><span id="alg2.l1.5" class="ltx_text" style="font-size:70%;">, aligner </span><math id="alg2.l1.m3" class="ltx_Math" alttext="R_{\varphi}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">R</mi><mi mathsize="0.700em">φ</mi></msub><annotation encoding="application/x-tex">R_{\varphi}</annotation></semantics></math><span id="alg2.l1.6" class="ltx_text" style="font-size:70%;">, inverse dynamic model </span><math id="alg2.l1.m4" class="ltx_Math" alttext="f_{\phi}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">f</mi><mi mathsize="0.700em">ϕ</mi></msub><annotation encoding="application/x-tex">f_{\phi}</annotation></semantics></math><span id="alg2.l1.7" class="ltx_text" style="font-size:70%;">
</span>
</div>
