<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E9.2.m2" class="ltx_Math" alttext="\displaystyle=f_{\theta}(x_{1},\ldots,x_{t-1}\,;\,\hat{x}_{t},\ldots,\hat{x}_{t+k-1})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=f_{\theta}(x_{1},\ldots,x_{t-1}\,;\,\hat{x}_{t},\ldots,\hat{x}_{t+k-1}),</annotation></semantics></math></span>
