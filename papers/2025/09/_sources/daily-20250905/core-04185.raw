</div>
<div id="lstnumberx52" class="ltx_listingline"><span id="lstnumberx52.1" class="ltx_text ltx_lst_space">        </span>#<span id="lstnumberx52.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.3" class="ltx_text ltx_lst_identifier">True</span><span id="lstnumberx52.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.5" class="ltx_text ltx_lst_identifier">if</span><span id="lstnumberx52.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.7" class="ltx_text ltx_lst_identifier">query</span><span id="lstnumberx52.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.9" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx52.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.11" class="ltx_text ltx_lst_identifier">key</span><span id="lstnumberx52.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.13" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx52.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.15" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx52.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.17" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx52.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.19" class="ltx_text ltx_lst_identifier">first</span><span id="lstnumberx52.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.21" class="ltx_text ltx_lst_identifier">half</span><span id="lstnumberx52.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.23" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx52.24" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.25" class="ltx_text ltx_lst_identifier">key</span><span id="lstnumberx52.26" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.27" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx52.28" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.29" class="ltx_text ltx_lst_identifier">before</span><span id="lstnumberx52.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.31" class="ltx_text ltx_lst_identifier">or</span><span id="lstnumberx52.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.33" class="ltx_text ltx_lst_identifier">at</span><span id="lstnumberx52.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx52.35" class="ltx_text ltx_lst_identifier">query</span>.
</div>
<div id="lstnumberx53" class="ltx_listingline"><span id="lstnumberx53.1" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx53.2" class="ltx_text ltx_lst_identifier">is_in_top_left_causal</span><span id="lstnumberx53.3" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx53.4" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx53.5" class="ltx_text ltx_lst_identifier">q_idx</span><span id="lstnumberx53.6" class="ltx_text ltx_lst_space"> </span>&lt;<span id="lstnumberx53.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx53.8" class="ltx_text ltx_lst_identifier">half_seq_len</span>)<span id="lstnumberx53.9" class="ltx_text ltx_lst_space"> </span>&amp;<span id="lstnumberx53.10" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx53.11" class="ltx_text ltx_lst_identifier">kv_idx</span><span id="lstnumberx53.12" class="ltx_text ltx_lst_space"> </span>&lt;<span id="lstnumberx53.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx53.14" class="ltx_text ltx_lst_identifier">half_seq_len</span>)<span id="lstnumberx53.15" class="ltx_text ltx_lst_space"> </span>&amp;<span id="lstnumberx53.16" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx53.17" class="ltx_text ltx_lst_identifier">kv_idx</span><span id="lstnumberx53.18" class="ltx_text ltx_lst_space"> </span>&lt;=<span id="lstnumberx53.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx53.20" class="ltx_text ltx_lst_identifier">q_idx</span>)
