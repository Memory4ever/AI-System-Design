</div>
<div id="lstnumberx119" class="ltx_listingline"><span id="lstnumberx119.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx119.2" class="ltx_text ltx_lst_identifier">total_time</span><span id="lstnumberx119.3" class="ltx_text ltx_lst_space"> </span>+=<span id="lstnumberx119.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx119.5" class="ltx_text ltx_lst_identifier">gemm_roofline</span>(<span id="lstnumberx119.6" class="ltx_text ltx_lst_identifier">num_tokens</span>,<span id="lstnumberx119.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx119.8" class="ltx_text ltx_lst_identifier">HIDDEN_DIM</span>,<span id="lstnumberx119.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx119.10" class="ltx_text ltx_lst_identifier">NUM_HEADS</span><span id="lstnumberx119.11" class="ltx_text ltx_lst_space"> </span>*<span id="lstnumberx119.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx119.13" class="ltx_text ltx_lst_identifier">HEAD_DIM</span>)[0]<span id="lstnumberx119.14" class="ltx_text ltx_lst_space"> </span>#<span id="lstnumberx119.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx119.16" class="ltx_text ltx_lst_identifier">Q</span>-<span id="lstnumberx119.17" class="ltx_text ltx_lst_identifier">proj</span>
</div>
<div id="lstnumberx120" class="ltx_listingline"><span id="lstnumberx120.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx120.2" class="ltx_text ltx_lst_identifier">total_time</span><span id="lstnumberx120.3" class="ltx_text ltx_lst_space"> </span>+=<span id="lstnumberx120.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.5" class="ltx_text ltx_lst_identifier">gemm_roofline</span>(<span id="lstnumberx120.6" class="ltx_text ltx_lst_identifier">num_tokens</span>,<span id="lstnumberx120.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.8" class="ltx_text ltx_lst_identifier">HIDDEN_DIM</span>,<span id="lstnumberx120.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.10" class="ltx_text ltx_lst_identifier">NUM_HEADS</span><span id="lstnumberx120.11" class="ltx_text ltx_lst_space"> </span>*<span id="lstnumberx120.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.13" class="ltx_text ltx_lst_identifier">NUM_KV_HEADS</span>)[0]<span id="lstnumberx120.14" class="ltx_text ltx_lst_space"> </span>#<span id="lstnumberx120.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.16" class="ltx_text ltx_lst_identifier">K</span>-<span id="lstnumberx120.17" class="ltx_text ltx_lst_identifier">proj</span>
</div>
<div id="lstnumberx121" class="ltx_listingline"><span id="lstnumberx121.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx121.2" class="ltx_text ltx_lst_identifier">total_time</span><span id="lstnumberx121.3" class="ltx_text ltx_lst_space"> </span>+=<span id="lstnumberx121.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx121.5" class="ltx_text ltx_lst_identifier">gemm_roofline</span>(<span id="lstnumberx121.6" class="ltx_text ltx_lst_identifier">num_tokens</span>,<span id="lstnumberx121.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx121.8" class="ltx_text ltx_lst_identifier">HIDDEN_DIM</span>,<span id="lstnumberx121.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx121.10" class="ltx_text ltx_lst_identifier">NUM_HEADS</span><span id="lstnumberx121.11" class="ltx_text ltx_lst_space"> </span>*<span id="lstnumberx121.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx121.13" class="ltx_text ltx_lst_identifier">NUM_KV_HEADS</span>)[0]<span id="lstnumberx121.14" class="ltx_text ltx_lst_space"> </span>#<span id="lstnumberx121.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx121.16" class="ltx_text ltx_lst_identifier">V</span>-<span id="lstnumberx121.17" class="ltx_text ltx_lst_identifier">proj</span>
</div>
<div id="lstnumberx122" class="ltx_listingline"><span id="lstnumberx122.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx122.2" class="ltx_text ltx_lst_identifier">total_time</span><span id="lstnumberx122.3" class="ltx_text ltx_lst_space"> </span>+=<span id="lstnumberx122.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx122.5" class="ltx_text ltx_lst_identifier">gemm_roofline</span>(<span id="lstnumberx122.6" class="ltx_text ltx_lst_identifier">num_tokens</span>,<span id="lstnumberx122.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx122.8" class="ltx_text ltx_lst_identifier">NUM_HEADS</span><span id="lstnumberx122.9" class="ltx_text ltx_lst_space"> </span>*<span id="lstnumberx122.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx122.11" class="ltx_text ltx_lst_identifier">HEAD_DIM</span>,<span id="lstnumberx122.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx122.13" class="ltx_text ltx_lst_identifier">HIDDEN_DIM</span>)[0]<span id="lstnumberx122.14" class="ltx_text ltx_lst_space"> </span>#<span id="lstnumberx122.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx122.16" class="ltx_text ltx_lst_identifier">out</span>-<span id="lstnumberx122.17" class="ltx_text ltx_lst_identifier">proj</span>
</div>
