<div id="lstnumberx69" class="ltx_listingline"><span id="lstnumberx69.1" class="ltx_text ltx_lst_identifier">from</span><span id="lstnumberx69.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx69.3" class="ltx_text ltx_lst_identifier">torch</span>.<span id="lstnumberx69.4" class="ltx_text ltx_lst_identifier">nn</span>.<span id="lstnumberx69.5" class="ltx_text ltx_lst_identifier">attention</span>.<span id="lstnumberx69.6" class="ltx_text ltx_lst_identifier">flex_attention</span><span id="lstnumberx69.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx69.8" class="ltx_text ltx_lst_identifier">import</span><span id="lstnumberx69.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx69.10" class="ltx_text ltx_lst_identifier">BlockMask</span>,<span id="lstnumberx69.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx69.12" class="ltx_text ltx_lst_identifier">create_block_mask</span>
