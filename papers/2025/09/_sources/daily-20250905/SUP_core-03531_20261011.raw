reignobject_content"></span></span></foreignObject></g></svg></span><span id="S0.F2.pic1.p3.pic1.1.1.1.20" class="ltx_text" style="--ltx-bg-color:#FFFFA6;">,</span><span id="S0.F2.pic1.p3.pic1.1.1.1.21" class="ltx_text" style="--ltx-bg-color:#FFFFA6;"> at</span><span id="S0.F2.pic1.p3.pic1.1.1.1.22" class="ltx_text" style="--ltx-bg-color:#FFFFA2;"> his</span><span id="S0.F2.pic1.p3.pic1.1.1.1.23" class="ltx_text" style="--ltx-bg-color:#FFFF88;"> residence</span>
<br class="ltx_break"><span id="S0.F2.pic1.p3.pic1.1.1.1.24" class="ltx_text" style="--ltx-bg-color:#FFFFAE;">in</span><span id="S0.F2.pic1.p3.pic1.1.1.1.25" class="ltx_text" style="--ltx-bg-color:#FFFFA5;"> San</span><span id="S0.F2.pic1.p3.pic1.1.1.1.26" class="ltx_text" style="--ltx-bg-color:#FFFFC5;"> Diego</span>. During the arrest, the police officers seized Riley’s mobile phone, a <span class="ltx_inline-block"><svg id="S0.F2.pic1.p3.pic1.pic9" class="ltx_picture" height="10.15" overflow="visible" style="vertical-align:-4.23px" version="1.1" viewBox="0 0 116.02 10.15" width="116.02"><g transform="translate(0,10.15) matrix(1 0 0 -1 0 0) translate(58.01,0) translate(0,6.11)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:7.35pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="5.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"></span></span></foreignObject><g style="--ltx-stroke-color:#000000;" stroke="#000000"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:7.35pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="5.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"></span></span></foreignObject><g style="--ltx-fill-color:#000000;" fill="#000000"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:7.35pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="5.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"></span></span></foreignObject><g stroke-width="0.4pt"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:7.35pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="5.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"></span></span></foreignObject><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -57.32 -1.88)"><foreignObject style="--ltx-fo-width:5.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.21em;font-size:7.35pt;" height="8.07" overflow="visible" transform="matrix(1 0 0 -1 0 5.92)" width="55.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S0.F2.pic1.p3.pic1.pic9.1" class="ltx_text" style="--ltx-bg-color:#FFFFC6;"> BlackBerry</span></span></span></foreignObject><foreignObject style="--ltx-fo-width:3em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:7.35pt;" height="5.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.92)" width="30.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S0.F2.pic1.p3.pic1.pic9.2" class="ltx_text" style="--ltx-bg-color:#FFFFAC;"> Curve</span></span></span></foreignObject><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:7.35pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="5.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S0.F2.pic1.p3.pic1.pic9.3" class="ltx_text" style="--ltx-bg-color:#FFFFA8;"> </span></span></span></foreignObject><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:7.35pt;" height="5.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.92)" width="15.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S0.F2.pic1.p3.pic1.pic9.4" class="ltx_text" style="--ltx-bg-color:#FFFF85;">833</span></span></span></foreignObject><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:7.35pt;" height="5.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.92)" width="5.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S0.F2.pic1.p3.pic1.pic9.5" class="ltx_text" style="--ltx-bg-color:#FFFF94;">0</span></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#DC0000;--ltx-fill-color:#DC0000;--ltx-fg-color:#DC0000;" color="#DC0000" fill="#DC0000" stroke="#DC0000" stroke-width="1.0pt"><path style="fill:none" d="M -57.32 -5.42 L 57.32 -5.42"></path></g><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:7.35pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="5.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"></span></span></foreignObject></g></svg></span>, which contained various data, including text messages, emails, and photographs.
</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</span></span></span></span></foreignObject></g></g></g><g style="--ltx-stroke-color:#66FF66;--ltx-fill-color:#E6FFE6;" fill="#E6FFE6" stroke="#66FF66"><path d="M -170.03 92.52 L -249.69 92.52 C -251.98 92.52 -253.84 90.66 -253.84 88.37 L -253.84 49.43 C -253.84 47.14 -251.98 45.28 -249.69 45.28 L -170.03 45.28 C -167.74 45.28 -165.88 47.14 -165.88 49.43 L -165.88 88.37 C -165.88 90.66 -167.74 92.52 -170.03 92.52 Z M -253.84 45.28"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -249.23 83.1)"><foreignObject style="--ltx-fo-width:8.36em;--ltx-fo-height:0.35em;--ltx-fo-depth:2.4em;font-size:10pt;" height="38.01" overflow="visible" transform="matrix(1 0 0 -1 0 4.8)" width="115.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
