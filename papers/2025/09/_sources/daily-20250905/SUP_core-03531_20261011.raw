<span id="A2.F8.pic1.2.1" class="ltx_p"></span>
<span id="A2.F8.pic1.2.2" class="ltx_p ltx_align_left"><span id="A2.F8.pic1.2.2.1" class="ltx_text" style="font-size:50%;">Olanzapine 5-10 mg/day is within accepted ranges for bipolar disorder treatment.</span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FF6666;--ltx-fill-color:#FFE6E6;" fill="#FFE6E6" stroke="#FF6666"><path d="M -169.71 83.02 L -246.62 83.02 C -248.91 83.02 -250.77 81.16 -250.77 78.87 L -250.77 -126.11 C -250.77 -128.4 -248.91 -130.26 -246.62 -130.26 L -169.71 -130.26 C -167.42 -130.26 -165.56 -128.4 -165.56 -126.11 L -165.56 78.87 C -165.56 81.16 -167.42 83.02 -169.71 83.02 Z M -250.77 -130.26"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -246.16 73.6)"><foreignObject style="--ltx-fo-width:8.07em;--ltx-fo-height:0.35em;--ltx-fo-depth:14.4em;font-size:10pt;" height="204.06" overflow="visible" transform="matrix(1 0 0 -1 0 4.8)" width="111.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
