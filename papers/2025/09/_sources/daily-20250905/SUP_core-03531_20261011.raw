<td id="A9.T7.2.4.3" class="ltx_td ltx_align_center"><math id="A9.T7.m7" class="ltx_Math" alttext="34.4" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">34.4</mn><annotation encoding="application/x-tex">34.4</annotation></semantics></math></td>
<td id="A9.T7.2.4.4" class="ltx_td ltx_align_center"><math id="A9.T7.m8" class="ltx_math_unparsed" alttext="(-2.0\,/\,+2.1)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo lspace="0em" mathsize="0.900em">−</mo><mn mathsize="0.900em">2.0</mn><mo lspace="0.392em" maxsize="0.900em" minsize="0.900em" rspace="0.085em" stretchy="true" symmetric="true">/</mo><mo lspace="0.085em" mathsize="0.900em">+</mo><mn mathsize="0.900em">2.1</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><annotation encoding="application/x-tex">(-2.0\,/\,+2.1)</annotation></semantics></math></td></tr>
