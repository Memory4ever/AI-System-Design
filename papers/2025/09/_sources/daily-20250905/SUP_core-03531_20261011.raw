<td id="A7.T4.2.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;" rowspan="5"><span id="A7.T4.2.3.1.1" class="ltx_text" style="font-size:90%;">
<span id="A7.T4.2.3.1.1.1" class="ltx_text"></span><span id="A7.T4.2.3.1.1.2" class="ltx_text">
<span id="A7.T4.2.3.1.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="A7.T4.2.3.1.1.2.1.1" class="ltx_tr">
<span id="A7.T4.2.3.1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span class="ltx_rule" style="width:0.0pt;height:18.5pt;--ltx-bg-color:black;display:inline-block;"></span><span id="A7.T4.2.3.1.1.2.1.1.1.1" class="ltx_text ltx_font_bold">LongFact++</span></span></span>
