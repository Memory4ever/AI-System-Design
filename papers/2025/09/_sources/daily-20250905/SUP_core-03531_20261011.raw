<span id="A2.F9.pic1.p4.1" class="ltx_block ltx_minipage ltx_align_top" style="width:33.6pt;"><span class="ltx_inline-block"><svg id="A2.F9.pic1.pic1" class="ltx_picture" color="#000000" height="19.69" overflow="visible" version="1.1" viewBox="0 0 59.06 19.69" width="59.06"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,19.69) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#BFBFBF;" fill="#BFBFBF" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 13.78 C 0 17.04 2.64 19.69 5.91 19.69 L 53.15 19.69 C 56.41 19.69 59.06 17.04 59.06 13.78 L 59.06 0 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 0.69 L 0.69 13.09 C 0.69 16.35 3.34 18.99 6.6 18.99 L 52.46 18.99 C 55.72 18.99 58.36 16.35 58.36 13.09 L 58.36 0.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 7.4 8.14)"><foreignObject style="--ltx-fo-width:3.2em;--ltx-fo-height:0.34em;--ltx-fo-depth:0.1em;font-size:10pt;" height="6.09" overflow="visible" transform="matrix(1 0 0 -1 0 4.75)" width="44.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
