<td id="A9.T7.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A9.T7.m3" class="ltx_Math" alttext="50.0" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">50.0</mn><annotation encoding="application/x-tex">50.0</annotation></semantics></math></td>
