<th id="Sx5.T4.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="Sx5.T4.1.11.1.1" class="ltx_text ltx_font_bold">TeRA (Ours)</span></th>
<td id="Sx5.T4.1.11.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx5.T4.1.11.2.1" class="ltx_text ltx_font_bold">0.0021</span></td>
<td id="Sx5.T4.1.11.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx5.T4.1.11.3.1" class="ltx_text ltx_font_bold">30.71</span></td>
<td id="Sx5.T4.1.11.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx5.T4.1.11.4.1" class="ltx_text ltx_font_bold">73.10</span></td></tr>
