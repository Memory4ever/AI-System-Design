<th id="Sx5.T4.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">VeRA</th>
<td id="Sx5.T4.1.10.2" class="ltx_td ltx_align_center"><span id="Sx5.T4.1.10.2.1" class="ltx_text ltx_underline">0.0022</span></td>
<td id="Sx5.T4.1.10.3" class="ltx_td ltx_align_center">25.59</td>
