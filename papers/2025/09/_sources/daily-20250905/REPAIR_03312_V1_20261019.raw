<span id="S5.T2.12.2.7.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T2.12.2.7.2.1.1" class="ltx_tr">
<span id="S5.T2.12.2.7.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">Step-level</span></span>
</span></span><span id="S5.T2.12.2.7.3" class="ltx_text"></span></td></tr>
<tr id="S5.T2.12.3" class="ltx_tr" style="--ltx-bg-color:#DFE2F3;">
