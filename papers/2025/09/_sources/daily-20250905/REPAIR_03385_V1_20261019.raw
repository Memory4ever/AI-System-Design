<th id="S3.T2.6.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S3.T2.6.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Example Text Prompt</span></th></tr>
</thead>
