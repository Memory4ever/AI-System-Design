<td id="S5.T4.6.1.2.4" class="ltx_td ltx_align_center ltx_border_tt">7.13</td>
<td id="S5.T4.6.1.2.5" class="ltx_td ltx_align_center ltx_border_tt">5.21</td>
<td id="S5.T4.6.1.2.6" class="ltx_td ltx_align_center ltx_border_tt">5.75</td>
