<th id="S3.T3.4.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S3.T3.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Metric</span></th>
<th id="S3.T3.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T3.4.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Sprinklr-Edge-OCR</span></th>
<th id="S3.T3.4.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T3.4.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Qwen-VL</span></th></tr>
