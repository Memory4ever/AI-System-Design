<td id="S3.T3.4.4.2" class="ltx_td ltx_align_center"><span id="S3.T3.4.4.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.89</span></td>
<td id="S3.T3.4.4.3" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T3.4.4.3.1" class="ltx_text" style="font-size:70%;">10.8</span></td></tr>
