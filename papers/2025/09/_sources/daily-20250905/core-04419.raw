<td id="S3.T1.5.1.10.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.5.1.10.1.1" class="ltx_text"></span> <span id="S3.T1.5.1.10.1.2" class="ltx_text">
