<td id="S4.T2.7.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.7.1.2.8.1" class="ltx_text ltx_font_bold">ARC-c</span></td>
<td id="S4.T2.7.1.2.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.7.1.2.9.1" class="ltx_text ltx_font_bold">GPQA</span></td>
<td id="S4.T2.7.1.2.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.7.1.2.10.1" class="ltx_text ltx_font_bold">Avg</span></td></tr>
<tr id="S4.T2.7.1.3" class="ltx_tr">
<td id="S4.T2.7.1.3.1" class="ltx_td ltx_align_left ltx_border_t">Qwen2.5-Math-7B</td>
<td id="S4.T2.7.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m3" class="ltx_Math" alttext="12.3" display="inline" intent=":literal"><semantics><mn>12.3</mn><annotation encoding="application/x-tex">12.3</annotation></semantics></math></td>
<td id="S4.T2.7.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m4" class="ltx_Math" alttext="4.7" display="inline" intent=":literal"><semantics><mn>4.7</mn><annotation encoding="application/x-tex">4.7</annotation></semantics></math></td>
<td id="S4.T2.7.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m5" class="ltx_Math" alttext="33.0" display="inline" intent=":literal"><semantics><mn>33.0</mn><annotation encoding="application/x-tex">33.0</annotation></semantics></math></td>
<td id="S4.T2.7.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m6" class="ltx_Math" alttext="43.6" display="inline" intent=":literal"><semantics><mn>43.6</mn><annotation encoding="application/x-tex">43.6</annotation></semantics></math></td>
<td id="S4.T2.7.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m7" class="ltx_Math" alttext="8.8" display="inline" intent=":literal"><semantics><mn>8.8</mn><annotation encoding="application/x-tex">8.8</annotation></semantics></math></td>
<td id="S4.T2.7.1.3.7" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m8" class="ltx_Math" alttext="13.6" display="inline" intent=":literal"><semantics><mn>13.6</mn><annotation encoding="application/x-tex">13.6</annotation></semantics></math></td>
