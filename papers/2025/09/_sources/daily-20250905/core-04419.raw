<td id="S5.T5.9.1.2.1" class="ltx_td ltx_align_right ltx_border_t">OFF/ON</td>
<td id="S5.T5.9.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T5.m1" class="ltx_Math" alttext="16.6" display="inline" intent=":literal"><semantics><mn>16.6</mn><annotation encoding="application/x-tex">16.6</annotation></semantics></math></td>
<td id="S5.T5.9.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T5.m2" class="ltx_Math" alttext="11.8" display="inline" intent=":literal"><semantics><mn>11.8</mn><annotation encoding="application/x-tex">11.8</annotation></semantics></math></td>
<td id="S5.T5.9.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T5.m3" class="ltx_Math" alttext="47.3" display="inline" intent=":literal"><semantics><mn>47.3</mn><annotation encoding="application/x-tex">47.3</annotation></semantics></math></td>
<td id="S5.T5.9.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T5.m4" class="ltx_Math" alttext="76.2" display="inline" intent=":literal"><semantics><mn>76.2</mn><annotation encoding="application/x-tex">76.2</annotation></semantics></math></td>
