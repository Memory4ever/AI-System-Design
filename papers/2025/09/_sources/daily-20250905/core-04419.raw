<td id="S3.T1.5.1.7.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m13" class="ltx_Math" alttext="\pi_{ref}=\pi_{\theta_{old}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo>=</mo><msub><mi>π</mi><msub><mi>θ</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></msub></mrow><annotation encoding="application/x-tex">\pi_{ref}=\pi_{\theta_{old}}</annotation></semantics></math></td>
<td id="S3.T1.5.1.7.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m14" class="ltx_Math" alttext="\hat{A}_{CISPO}=\hat{A}_{GRPO}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub><mo>=</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\hat{A}_{CISPO}=\hat{A}_{GRPO}</annotation></semantics></math></td>
<td id="S3.T1.5.1.7.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m15" class="ltx_Math" alttext="\nabla\mathcal{J}_{CISPO}=\nabla\pi_{\theta}(\tau)\frac{\hat{A}_{CISPO}\mathbb{1}_{\text{CIS-Mask}}}{\pi_{ref}(\tau)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">𝟙</mi><mtext>CIS-Mask</mtext></msub></mrow><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nabla\mathcal{J}_{CISPO}=\nabla\pi_{\theta}(\tau)\frac{\hat{A}_{CISPO}\mathbb{1}_{\text{CIS-Mask}}}{\pi_{ref}(\tau)}</annotation></semantics></math></td></tr>
<tr id="S3.T1.5.1.8" class="ltx_tr">
