<td id="S5.T5.9.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T5.9.1.1.2.1" class="ltx_text ltx_font_bold">AIME 24</span></td>
<td id="S5.T5.9.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T5.9.1.1.3.1" class="ltx_text ltx_font_bold">AIME 25</span></td>
<td id="S5.T5.9.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T5.9.1.1.4.1" class="ltx_text ltx_font_bold">AMC</span></td>
<td id="S5.T5.9.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T5.9.1.1.5.1" class="ltx_text ltx_font_bold">MATH-500</span></td>
<td id="S5.T5.9.1.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T5.9.1.1.6.1" class="ltx_text ltx_font_bold">Minerva</span></td>
<td id="S5.T5.9.1.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T5.9.1.1.7.1" class="ltx_text ltx_font_bold">Olympiad</span></td>
