<td id="S5.T6.6.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T6.m10" class="ltx_Math" alttext="39.0" display="inline" intent=":literal"><semantics><mn>39.0</mn><annotation encoding="application/x-tex">39.0</annotation></semantics></math></td></tr>
<tr id="S5.T6.6.1.3" class="ltx_tr">
