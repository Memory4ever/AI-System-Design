<td id="S4.T2.7.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="7"><span id="S4.T2.7.1.1.2.1" class="ltx_text ltx_font_bold">In-Distribution</span></td>
<td id="S4.T2.7.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="S4.T2.7.1.1.3.1" class="ltx_text ltx_font_bold">Out-of-Distribution</span></td></tr>
<tr id="S4.T2.7.1.2" class="ltx_tr">
