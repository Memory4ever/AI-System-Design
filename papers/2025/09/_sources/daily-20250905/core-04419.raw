<td id="S3.T1.5.1.8.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m16" class="ltx_Math" alttext="\pi_{ref}=\pi_{\theta}\left(\frac{\pi_{\theta_{old}}(\tau_{i,j}|q_{i})}{\pi_{\theta}(\tau_{i,j}|q_{i})}\right)^{1/|\tau_{i,j}|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo>=</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mrow><msub><mi>π</mi><msub><mi>θ</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>q</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>q</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">|</mo><msub><mi>τ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\pi_{ref}=\pi_{\theta}\left(\frac{\pi_{\theta_{old}}(\tau_{i,j}|q_{i})}{\pi_{\theta}(\tau_{i,j}|q_{i})}\right)^{1/|\tau_{i,j}|}</annotation></semantics></math></td>
<td id="S3.T1.5.1.8.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m17" class="ltx_Math" alttext="\hat{A}_{GSPO}=\hat{A}_{GRPO}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub><mo>=</mo><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\hat{A}_{GSPO}=\hat{A}_{GRPO}</annotation></semantics></math></td>
<td id="S3.T1.5.1.8.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m18" class="ltx_Math" alttext="\nabla\mathcal{J}_{GSPO}=\nabla\pi_{\theta}(\tau)\frac{\hat{A}_{GSPO}\mathbb{1}_{\text{Seq-Clip}}}{\pi_{ref}(\tau)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">𝟙</mi><mtext>Seq-Clip</mtext></msub></mrow><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nabla\mathcal{J}_{GSPO}=\nabla\pi_{\theta}(\tau)\frac{\hat{A}_{GSPO}\mathbb{1}_{\text{Seq-Clip}}}{\pi_{ref}(\tau)}</annotation></semantics></math></td></tr>
