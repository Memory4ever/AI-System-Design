<td id="S3.T1.5.1.6.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m10" class="ltx_Math" alttext="\pi_{ref}=\pi_{\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo>=</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{ref}=\pi_{\theta}</annotation></semantics></math></td>
<td id="S3.T1.5.1.6.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m11" class="ltx_Math" alttext="\hat{A}_{REINFORCE}=\pm 1" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></msub><mo>=</mo><mrow><mo>±</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\hat{A}_{REINFORCE}=\pm 1</annotation></semantics></math></td>
<td id="S3.T1.5.1.6.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m12" class="ltx_Math" alttext="\nabla\mathcal{J}_{REF.}(\theta)=\nabla\pi_{\theta}(\tau)\frac{\hat{A}_{REF.}}{\pi_{\theta}(\tau)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo lspace="0em">.</mo></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo lspace="0em">.</mo></mrow></msub><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\nabla\mathcal{J}_{REF.}(\theta)=\nabla\pi_{\theta}(\tau)\frac{\hat{A}_{REF.}}{\pi_{\theta}(\tau)}</annotation></semantics></math></td></tr>
