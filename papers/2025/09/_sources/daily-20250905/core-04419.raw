<td id="S4.T3.7.1.4.2" class="ltx_td ltx_align_center"><math id="S4.T3.m19" class="ltx_Math" alttext="0.3" display="inline" intent=":literal"><semantics><mn>0.3</mn><annotation encoding="application/x-tex">0.3</annotation></semantics></math></td>
<td id="S4.T3.7.1.4.3" class="ltx_td ltx_align_center"><math id="S4.T3.m20" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math></td>
<td id="S4.T3.7.1.4.4" class="ltx_td ltx_align_center"><math id="S4.T3.m21" class="ltx_Math" alttext="9.4" display="inline" intent=":literal"><semantics><mn>9.4</mn><annotation encoding="application/x-tex">9.4</annotation></semantics></math></td>
