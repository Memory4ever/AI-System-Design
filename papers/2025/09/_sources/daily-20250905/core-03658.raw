<td id="S5.T3.2.3.3" class="ltx_td ltx_align_center">1.2329</td>
<td id="S5.T3.2.3.4" class="ltx_td ltx_align_center">0.26</td></tr>
<tr id="S5.T3.2.4" class="ltx_tr">
