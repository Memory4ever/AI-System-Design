<th id="S5.T1.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T1.2.1.4.1" class="ltx_text ltx_font_bold">MissRate@2m</span> (<math id="S5.T1.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</th></tr>
<tr id="S5.T1.2.2" class="ltx_tr">
<th id="S5.T1.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" colspan="4"><span id="S5.T1.2.2.1.1" class="ltx_text ltx_font_italic">Prior State-of-the-Art (on Interactive Split)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.2.3" class="ltx_tr">
<th id="S5.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Wayformer <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite></th>
<td id="S5.T1.2.3.2" class="ltx_td ltx_align_center">0.99</td>
<td id="S5.T1.2.3.3" class="ltx_td ltx_align_center">2.30</td>
<td id="S5.T1.2.3.4" class="ltx_td ltx_align_center">0.47</td></tr>
<tr id="S5.T1.2.4" class="ltx_tr">
<th id="S5.T1.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">MotionDiffuser <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">2</a>]</cite></th>
<td id="S5.T1.2.4.2" class="ltx_td ltx_align_center">0.86</td>
<td id="S5.T1.2.4.3" class="ltx_td ltx_align_center">1.92</td>
