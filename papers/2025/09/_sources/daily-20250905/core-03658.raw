<th id="S5.T3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">No Goal</th>
<td id="S5.T3.2.2.2" class="ltx_td ltx_align_center ltx_border_t">0.5925</td>
<td id="S5.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t">1.4351</td>
<td id="S5.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.21</td></tr>
