</span></td></tr>
<tr id="S5.T1.4.4" class="ltx_tr">
<th id="S5.T1.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">RD<sub id="S5.T1.4.4.1.1" class="ltx_sub">addition</sub></th>
<td id="S5.T1.4.4.2" class="ltx_td ltx_align_left ltx_align_top">
