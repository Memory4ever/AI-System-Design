</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.4.2" class="ltx_tr">
<th id="S5.T1.4.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="4"><span id="S5.T1.4.2.1.1" class="ltx_text">LLaMA-3-8B-Instruct</span></th>
