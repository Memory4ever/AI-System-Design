<td id="S3.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="4"><span id="S3.T1.2.1.2.1.1" class="ltx_text">VGG-16</span></td>
<td id="S3.T1.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="S3.T1.2.1.2.2.1" class="ltx_text">Cifar-10</span></td>
<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_left ltx_border_t">G-SCC <math id="S3.T1.m2" class="ltx_Math" alttext="(n=1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n=1)</annotation></semantics></math> (ours)</td>
<td id="S3.T1.2.1.2.4" class="ltx_td ltx_align_left ltx_border_t">50% FLOPs</td>
<td id="S3.T1.2.1.2.5" class="ltx_td ltx_align_right ltx_border_t">92.69</td>
<td id="S3.T1.2.1.2.6" class="ltx_td ltx_align_right ltx_border_t">-0.93</td></tr>
<tr id="S3.T1.2.1.3" class="ltx_tr">
<td id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left">CMA-ES</td>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_left">50% FLOPs</td>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_right">93.55</td>
<td id="S3.T1.2.1.3.4" class="ltx_td ltx_align_right">-0.07</td></tr>
