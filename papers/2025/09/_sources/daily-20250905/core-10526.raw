<th id="S3.T1.2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Dataset</span></th>
<th id="S3.T1.2.1.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="S3.T1.2.1.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.1.1.4.1" class="ltx_text ltx_font_bold">Ratio</span></th>
<th id="S3.T1.2.1.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.1.1.5.1" class="ltx_text ltx_font_bold">Top-1 (%)</span></th>
<th id="S3.T1.2.1.1.6" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><math id="S3.T1.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math><span id="S3.T1.2.1.1.6.1" class="ltx_text ltx_font_bold">Top-1 (%)</span></th></tr>
