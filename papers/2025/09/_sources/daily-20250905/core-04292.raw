<figure id="S3.F5.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.04292v1/Qwen3-235B-A22B.svg" id="S3.F5.sf5.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:371/358;" width="371" height="358"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F5.sf5.4" class="ltx_text" style="font-size:90%;">(e)</span> </span><span id="S3.F5.sf5.5" class="ltx_text" style="font-size:80%;">Qwen3-235B-A22B-Thinking</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S3.F5.sf6" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.04292v1/GLM-4.5.svg" id="S3.F5.sf6.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/458;" width="476" height="458"></object>
