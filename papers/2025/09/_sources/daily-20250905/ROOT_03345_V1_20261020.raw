<span id="S2.T1.6.2.4.1.1" class="ltx_p ltx_align_center"><span id="S2.T1.6.2.4.1.1.1" class="ltx_text ltx_font_sansserif" style="font-size:70%;--ltx-bg-color:#F6DCDA;">✗</span></span>
</span></td>
<td id="S2.T1.6.2.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="--ltx-bg-color:#D7E9DB;padding:0.5pt 2.0pt;">
<span id="S2.T1.6.2.5.1" class="ltx_inline-block ltx_align_middle" style="width:41.4pt;">
<span id="S2.T1.6.2.5.1.1" class="ltx_p ltx_align_center"><span id="S2.T1.6.2.5.1.1.1" class="ltx_text ltx_font_sansserif" style="font-size:70%;--ltx-bg-color:#D7E9DB;">✓</span></span>
