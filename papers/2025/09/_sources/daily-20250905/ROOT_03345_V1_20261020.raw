<div id="alg1.4.1" class="ltx_listingline">

<div id="alg1.4.1.1" class="ltx_listing ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
                
                
              <span id="alg1.l1.2" class="ltx_text ltx_font_bold">if</span> task is infer property <span id="alg1.l1.3" class="ltx_text ltx_font_bold">then</span>

</div>
