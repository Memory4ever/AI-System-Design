</span><span id="A1.SS0.SSS0.Px6.p1.1.1.1.1.1.2" class="ltx_text">   </span><span id="A1.SS0.SSS0.Px6.p1.1.1.1.1.1.3" class="ltx_text"> <span id="A1.SS0.SSS0.Px6.p1.1.1.1.1.1.3.1" class="ltx_text"><math id="A1.SS0.SSS0.Px6.m4" class="ltx_Math" alttext="\forall x(\texttt{mammal}(x)\to\texttt{hariy}(x))" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" rspace="0.167em">∀</mo><mrow><mi style="--ltx-fg-color:#009900;" mathcolor="#009900">x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">(</mo><mrow><mrow><mtext style="--ltx-fg-color:#009900;" class="ltx_mathvariant_monospace" mathcolor="#009900">mammal</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">(</mo><mi style="--ltx-fg-color:#009900;" mathcolor="#009900">x</mi><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">→</mo><mrow><mtext style="--ltx-fg-color:#009900;" class="ltx_mathvariant_monospace" mathcolor="#009900">hariy</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">(</mo><mi style="--ltx-fg-color:#009900;" mathcolor="#009900">x</mi><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\forall x(\texttt{mammal}(x)\to\texttt{hariy}(x))</annotation></semantics></math></span> </span></span>
