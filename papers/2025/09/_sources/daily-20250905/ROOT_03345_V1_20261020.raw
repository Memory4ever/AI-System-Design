<div id="alg1.l14" class="ltx_listingline">
                
                
              <span id="alg1.l14.2" class="ltx_text ltx_font_bold">if</span> task is infer subtype relation <span id="alg1.l14.3" class="ltx_text ltx_font_bold">then</span>

</div>
