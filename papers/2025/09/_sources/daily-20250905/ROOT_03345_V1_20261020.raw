               select a member of the root node

</div>
<div id="alg1.l3" class="ltx_listingline">
                
                
               randomly select a member of the leaf nodes

</div>
<div id="alg1.l4" class="ltx_listingline">
                
                
               randomly select a member of nonleaf nodes

</div>
<div id="alg1.l5" class="ltx_listingline">
                
                
               generates the observations where selected members have the property

</div>
<div id="alg1.l6" class="ltx_listingline">
                
                
              <span id="alg1.l6.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l6.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
                
                
              <span id="alg1.l7.2" class="ltx_text ltx_font_bold">if</span> task is infer membership <span id="alg1.l7.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l8" class="ltx_listingline">
                
                
               select a random leaf node

</div>
<div id="alg1.l9" class="ltx_listingline">
                
                
               randomly select a property of the leaf node

</div>
<div id="alg1.l10" class="ltx_listingline">
                
                
               randomly select a property of the root node

</div>
<div id="alg1.l11" class="ltx_listingline">
                
                
               randomly select a property of the selected node’s non-root ancestors.

</div>
<div id="alg1.l12" class="ltx_listingline">
                
                
               generates the observations where this entity have all properties

</div>
<div id="alg1.l13" class="ltx_listingline">
                
                
              <span id="alg1.l13.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l13.3" class="ltx_text ltx_font_bold">if</span>
