<span id="S2.T1.6.2.1.1.1" class="ltx_p"><span id="S2.T1.6.2.1.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:70%;">ART</span><span id="S2.T1.6.2.1.1.1.2" class="ltx_text ltx_font_sansserif" style="font-size:70%;"> </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S2.T1.6.2.1.1.1.3" class="ltx_text ltx_font_sansserif" style="font-size:70%;">(</span><a href="#bib.bib33" title="" class="ltx_ref">Zhao et al., 2023</a><span id="S2.T1.6.2.1.1.1.5" class="ltx_text ltx_font_sansserif" style="font-size:70%;">)</span></cite></span>
