</span></td>
<td id="S3.T2.3.1.2.6" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="S3.T2.3.1.2.6.1" class="ltx_inline-block" style="width:82.8pt;">
<span id="S3.T2.3.1.2.6.1.1" class="ltx_p ltx_align_center"><span id="S3.T2.3.1.2.6.1.1.1" class="ltx_text ltx_markedasmath" style="font-size:80%;">
<span id="S3.T2.3.1.2.6.1.1.1.1" class="ltx_inline-block ltx_markedasmath ltx_align_bottom">
<span id="S3.T2.3.1.2.6.1.1.1.1.1" class="ltx_p ltx_align_bottom"> <span id="S3.T2.3.1.2.6.1.1.1.1.1.1" class="ltx_text"><span id="S3.T2.3.1.2.6.1.1.1.1.1.1.1" class="ltx_text"><math id="S3.T2.m2.m1.m1" class="ltx_Math" alttext="\displaystyle{\color[rgb]{0.55,0.14,1}o(A)}\mathstrut" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#8C24FF;" mathcolor="#8C24FF">o</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#8C24FF;" mathcolor="#8C24FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#8C24FF;" mathcolor="#8C24FF">A</mi><mo style="--ltx-fg-color:#8C24FF;" mathcolor="#8C24FF" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0.55,0.14,1}o(A)}\mathstrut</annotation></semantics></math></span><span id="S3.T2.3.1.2.6.1.1.1.1.1.1.2" class="ltx_text"><math id="S3.T2.m2.m1.m2" class="ltx_Math" alttext="\displaystyle\hskip 8.00003pt{\color[rgb]{0,0.6,0}\forall x(o(x)\to p(x))}\mathstrut" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" rspace="0.167em">∀</mo><mrow><mi style="--ltx-fg-color:#009900;" mathcolor="#009900">x</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">(</mo><mrow><mrow><mi style="--ltx-fg-color:#009900;" mathcolor="#009900">o</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">(</mo><mi style="--ltx-fg-color:#009900;" mathcolor="#009900">x</mi><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">→</mo><mrow><mi style="--ltx-fg-color:#009900;" mathcolor="#009900">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">(</mo><mi style="--ltx-fg-color:#009900;" mathcolor="#009900">x</mi><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">)</mo></mrow></mrow></mrow><mo