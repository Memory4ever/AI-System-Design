--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 80.53 0) translate(35.29,0) matrix(0.75 0.0 0.0 0.75 -20.76 0)"> <foreignObject style="--ltx-fo-width:3em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.33em;font-size:10pt;" height="14.12" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="41.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi>b</mi><mrow><msup><mi>j</mi><mo>∗</mo></msup><mo>,</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mrow><mi>man</mi></msubsup></span></span></foreignObject> </g> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 140.04 0) translate(23.61,0) matrix(0.75 0.0 0.0 0.75 -9.08 0)"> <foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mo>⋯</mo></span></span></foreignObject> </g> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 176.18 0) translate(34.87,0) matrix(0.75 0.0 0.0 0.75 -20.34 0)"> <foreignObject style="--ltx-fo-width:2.92em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.57" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="40.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi>b</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mrow><mi>man</mi></msubsup></span></span></foreignObject> </g> </g> </g> </g> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.75