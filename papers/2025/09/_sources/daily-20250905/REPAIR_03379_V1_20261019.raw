<span id="S3.T2.2.1.1.1.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tttt" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S3.T2.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>FLOPs</span></span>
