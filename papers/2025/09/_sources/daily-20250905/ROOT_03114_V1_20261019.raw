<tr id="S3.T1.10.6" class="ltx_tr">
<td id="S3.T1.10.6.1" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.6.1.1" class="ltx_text" style="font-size:90%;">TOCH w/ Aug</span></td>
<td id="S3.T1.10.6.2" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.6.2.1" class="ltx_text" style="font-size:90%;">13.22</span></td>
<td id="S3.T1.10.6.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.6.3.1" class="ltx_text" style="font-size:90%;">12.87</span></td>
<td id="S3.T1.10.6.4" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.6.4.1" class="ltx_text" style="font-size:90%;">2.15</span></td>
<td id="S3.T1.10.6.5" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.6.5.1" class="ltx_text" style="font-size:90%;">2.22</span></td>
