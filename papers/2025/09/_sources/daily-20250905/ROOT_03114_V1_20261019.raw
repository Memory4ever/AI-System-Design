<td id="S3.T1.10.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.3.6.1" class="ltx_text" style="font-size:90%;">6.02</span></td>
<td id="S3.T1.10.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.3.7.1" class="ltx_text" style="font-size:90%;">14.77</span></td></tr>
<tr id="S3.T1.10.4" class="ltx_tr">
<td id="S3.T1.10.4.1" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.4.1.1" class="ltx_text" style="font-size:90%;">TOCH <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib59" title="" class="ltx_ref">59</a>)</cite></span></td>
<td id="S3.T1.10.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.4.2.1" class="ltx_text" style="font-size:90%;">15.29</span></td>
