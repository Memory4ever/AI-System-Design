<td id="S3.T1.10.4.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T1.10.4.6.1" class="ltx_text" style="font-size:90%;">3.84</span></td></tr>
