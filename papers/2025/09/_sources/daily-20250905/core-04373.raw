<span id="A1.T3.2.8.1.1.2" class="ltx_p ltx_align_center">(<math id="A1.T3.m7" class="ltx_Math" alttext="\text{Gender}^{+}\text{Instr}^{+}" display="inline" intent=":literal"><semantics><mrow><msup><mtext>Gender</mtext><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mtext>Instr</mtext><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">\text{Gender}^{+}\text{Instr}^{+}</annotation></semantics></math>)</span>
</span></td>
<td id="A1.T3.2.8.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top" style="padding-top:2.5pt;padding-bottom:2.5pt;">
