<span id="S5.F5.sf2.5.2" class="ltx_p"><span id="S5.F5.sf2.5.2.1" class="ltx_text" style="font-size:70%;">(B = 40, 48, 56)</span></span>
</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S5.F5.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.02753v1/DeepSeekV2_qasper.svg" id="S5.F5.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/348;" width="476" height="348"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F5.sf3.4" class="ltx_text" style="font-size:90%;">(c)</span> </span>
<span id="S5.F5.sf3.5" class="ltx_inline-block">
<span id="S5.F5.sf3.5.1" class="ltx_p"><span id="S5.F5.sf3.5.1.1" class="ltx_text" style="font-size:70%;">DeepSeekV2-Lite-Chat</span></span>
<span id="S5.F5.sf3.5.2" class="ltx_p"><span id="S5.F5.sf3.5.2.1" class="ltx_text" style="font-size:70%;">(B = 78, 104, 130)</span></span>
</span></figcaption>
