<td id="S4.T1.5.11.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T1.5.11.6.1" class="ltx_text" style="--ltx-fg-color:#FF0000;--ltx-bg-color:#CCCCCC;">76.0</span></td>
