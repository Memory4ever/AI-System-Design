<td id="S4.T10.1.4.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T10.1.4.2.1" class="ltx_text" style="font-size:70%;">(<span id="S4.T10.1.4.2.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">96.9</span>, <span id="S4.T10.1.4.2.1.2" class="ltx_text" style="--ltx-fg-color:#0000FF;">88.3</span>)</span></td>
<td id="S4.T10.1.4.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T10.1.4.3.1" class="ltx_text" style="font-size:70%;">(82.0, <span id="S4.T10.1.4.3.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">95.1</span>)</span></td></tr>
