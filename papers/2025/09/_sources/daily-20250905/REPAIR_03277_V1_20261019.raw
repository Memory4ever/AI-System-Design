<tr id="S4.T9.1.5" class="ltx_tr">
<td id="S4.T9.1.5.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.1.5.1.1" class="ltx_text" style="font-size:70%;">50%</span></td>
<td id="S4.T9.1.5.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.1.5.2.1" class="ltx_text" style="font-size:70%;">(95.8, 85.1)</span></td>
<td id="S4.T9.1.5.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.1.5.3.1" class="ltx_text" style="font-size:70%;">(81.2, 93.8)</span></td></tr>
