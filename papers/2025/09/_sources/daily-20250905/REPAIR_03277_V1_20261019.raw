<td id="S4.T4.1.8.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S4.T4.1.8.4.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;--ltx-bg-color:#CCCCCC;">85.2</span></td>
