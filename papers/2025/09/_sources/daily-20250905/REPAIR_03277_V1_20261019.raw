<td id="S4.T4.1.6.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S4.T4.1.6.6.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#CCCCCC;">78.6</span></td>
<td id="S4.T4.1.6.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S4.T4.1.6.7.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#CCCCCC;">80.8</span></td></tr>
<tr id="S4.T4.1.7" class="ltx_tr" style="--ltx-bg-color:#CCCCCC;">
<td id="S4.T4.1.7.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S4.T4.1.7.1.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#CCCCCC;">PointAD+-CoOp</span></td>
<td id="S4.T4.1.7.2" class="ltx_td ltx_nopad_r" style="padding-left:0.5pt;padding-right:0.5pt;"></td>
<td id="S4.T4.1.7.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S4.T4.1.7.3.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#0000FF;--ltx-bg-color:#CCCCCC;">94.5</span></td>
<td id="S4.T4.1.7.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S4.T4.1.7.4.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#0000FF;--ltx-bg-color:#CCCCCC;">84.8</span></td>
<td id="S4.T4.1.7.5" class="ltx_td ltx_nopad_r" style="padding-left:0.5pt;padding-right:0.5pt;"></td>
<td id="S4.T4.1.7.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S4.T4.1.7.6.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#0000FF;--ltx-bg-color:#CCCCCC;">79.8</span></td>
<td id="S4.T4.1.7.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S4.T4.1.7.7.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;--ltx-bg-color:#CCCCCC;">83.5</span></td></tr>
<tr id="S4.T4.1.8" class="ltx_tr" style="--ltx-bg-color:#CCCCCC;">
<td id="S4.T4.1.8.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:0.5pt;padding-right:0.5pt;"><span id="S4.T4.1.8.1.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#CCCCCC;">PointAD+</span></td>
