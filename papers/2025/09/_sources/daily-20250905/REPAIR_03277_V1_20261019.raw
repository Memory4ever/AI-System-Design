<td id="S4.T9.1.2.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.1.2.1.1" class="ltx_text" style="font-size:70%;">ratio</span></td>
<td id="S4.T9.1.2.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.1.2.2.1" class="ltx_text" style="font-size:70%;">Local</span></td>
<td id="S4.T9.1.2.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.1.2.3.1" class="ltx_text" style="font-size:70%;">Global</span></td></tr>
<tr id="S4.T9.1.3" class="ltx_tr" style="--ltx-bg-color:#CCCCCC;">
<td id="S4.T9.1.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.1.3.1.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#CCCCCC;">100%</span></td>
