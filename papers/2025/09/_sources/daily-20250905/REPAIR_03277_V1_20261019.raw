<td id="S4.T10.1.6.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T10.1.6.3.1" class="ltx_text" style="font-size:70%;">(81.8, <span id="S4.T10.1.6.3.1.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">94.8</span>)</span></td></tr>
