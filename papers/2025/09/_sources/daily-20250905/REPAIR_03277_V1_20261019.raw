<td id="S4.T10.1.5.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T10.1.5.2.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#CCCCCC;">(<span id="S4.T10.1.5.2.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">96.9</span>, <span id="S4.T10.1.5.2.1.2" class="ltx_text" style="--ltx-fg-color:#FF0000;">88.7</span>)</span></td>
<td id="S4.T10.1.5.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T10.1.5.3.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#CCCCCC;">(<span id="S4.T10.1.5.3.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">82.5</span>, <span id="S4.T10.1.5.3.1.2" class="ltx_text" style="--ltx-fg-color:#0000FF;">94.8</span>)</span></td></tr>
