<tr id="S4.T9.1.4" class="ltx_tr">
<td id="S4.T9.1.4.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.1.4.1.1" class="ltx_text" style="font-size:70%;">70%</span></td>
<td id="S4.T9.1.4.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T9.1.4.2.1" class="ltx_text" style="font-size:70%;">(<span id="S4.T9.1.4.2.1.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">96.2</span>, (<span id="S4.T9.1.4.2.1.2" class="ltx_text" style="--ltx-fg-color:#0000FF;">86.1</span>)</span></td>
