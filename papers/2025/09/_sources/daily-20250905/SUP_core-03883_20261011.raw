<td id="S1.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#F1F8F8;"><span id="S1.T1.2.1.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F1F8F8;">Sha et al. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>]</cite></span></td>
<td id="S1.T1.2.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#F1F8F8;"><span id="S1.T1.2.1.1.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F1F8F8;">Lei et al. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite></span></td>
<td id="S1.T1.2.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S1.T1.2.1.1.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F1F8F8;">Ours</span></td>
<td id="S1.T1.2.1.1.5" class="ltx_td ltx_border_r ltx_border_t"></td></tr>
<tr id="S1.T1.2.1.2" class="ltx_tr">
<td id="S1.T1.2.1.2.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Generation Pipeline</td>
<td id="S1.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">
<span id="S1.T1.2.1.2.2.1" class="ltx_text" style="position:relative; bottom:-0.3pt;"><img src="2509.03883v1/figs/logo/no-icon.png" id="S1.T1.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:16/16;" width="16" height="16" alt="[Uncaptioned image]"></span></td>
<td id="S1.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">
<span id="S1.T1.2.1.2.3.1" class="ltx_text" style="position:relative; bottom:-0.3pt;"><img src="2509.03883v1/figs/logo/no-icon.png" id="S1.T1.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:16/16;" width="16" height="16" alt="[Uncaptioned image]"></span></td>
<td id="S1.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S1.T1.2.1.2.4.1" class="ltx_text" style="position:relative; bottom:-0.3pt;"><img src="2509.03883v1/figs/logo/right-icon.png" id="S1.T1.g3" class="ltx_graphics ltx_img_square" style="aspect-ratio:16/16;" width="16" height="16" alt="[Uncaptioned image]"></span></td>
<td id="S1.T1.2.1.2.5" class="ltx_td ltx_border_r"></td></tr>
<tr id="S1.T1.2.1.3" class="ltx_tr">
