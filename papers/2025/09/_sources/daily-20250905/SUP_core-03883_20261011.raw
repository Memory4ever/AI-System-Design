<td id="S1.T2.2.1.28.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S1.T2.2.1.28.3.1" class="ltx_text" style="position:relative; bottom:-0.3pt;"><img src="2509.03883v1/figs/logo/mapping-icon.png" id="S1.T2.g144" class="ltx_graphics ltx_img_square" style="aspect-ratio:16/16;" width="16" height="16" alt="[Uncaptioned image]"></span></td>
