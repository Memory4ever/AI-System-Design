</table></td>
<td id="S4.T4.2.1.1.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="S4.T4.2.1.1.9.1" class="ltx_text ltx_font_bold">Venue</span></td></tr>
