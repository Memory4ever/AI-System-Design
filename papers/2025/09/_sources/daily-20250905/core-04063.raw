<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex51.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}\int_{\mathbf{x}_{0}}p_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0}(\mathbf{x}_{0})\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}\mathrm{d}\mathbf{x}_{0}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝐱</mi><mn>0</mn></msub></msub></mstyle><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}\int_{\mathbf{x}_{0}}p_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0}(\mathbf{x}_{0})\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}\mathrm{d}\mathbf{x}_{0}</annotation></semantics></math></td>
