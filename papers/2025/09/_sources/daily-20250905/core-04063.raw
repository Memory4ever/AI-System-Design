<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex56.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\theta}\left\langle\mathbf{v}_{\theta}(\mathbf{x}),\int_{\mathbf{x}_{0}}\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0t}(\mathbf{x}_{0}|\mathbf{x})\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\exp(-\mathcal{E}_{t}(\mathbf{x}))}\mathrm{d}\mathbf{x}_{0}\right\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo>⟨</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝐱</mi><mn>0</mn></msub></msub></mstyle><mrow><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\theta}\left\langle\mathbf{v}_{\theta}(\mathbf{x}),\int_{\mathbf{x}_{0}}\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0t}(\mathbf{x}_{0}|\mathbf{x})\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\exp(-\mathcal{E}_{t}(\mathbf{x}))}\mathrm{d}\mathbf{x}_{0}\right\rangle</annotation></semantics></math></td>
