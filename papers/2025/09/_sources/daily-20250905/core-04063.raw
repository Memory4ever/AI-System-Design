<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex55.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0}))]}\mathrm{d}\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0}))]}\mathrm{d}\mathbf{x}</annotation></semantics></math></td>
