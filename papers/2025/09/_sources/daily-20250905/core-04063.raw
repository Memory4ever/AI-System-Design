<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex29.m2" class="ltx_math_unparsed" alttext="\displaystyle-\int_{\mathbf{x}_{0}}\mathrm{div}\left(\frac{q_{t}(\mathbf{x})}{\exp(-\mathcal{E}_{t}(\mathbf{x}))}\right." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝐱</mi><mn>0</mn></msub></msub></mstyle><mi>div</mi><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\int_{\mathbf{x}_{0}}\mathrm{div}\left(\frac{q_{t}(\mathbf{x})}{\exp(-\mathcal{E}_{t}(\mathbf{x}))}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex30.m1" class="ltx_Math" alttext="\displaystyle\left.\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0t}(\mathbf{x}_{0}|\mathbf{x})\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\right)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0t}(\mathbf{x}_{0}|\mathbf{x})\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex31.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex31.m2" class="ltx_Math" alttext="\displaystyle-\mathrm{div}\left(q_{t}(\mathbf{x})\int\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0t}(\mathbf{x}_{0}|\mathbf{x})\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\exp(-\mathcal{E}_{t}(\mathbf{x}))}\mathrm{d}\mathbf{x}_{0}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>div</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow></mrow></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\mathrm{div}\left(q_{t}(\mathbf{x})\int\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0t}(\mathbf{x}_{0}|\mathbf{x})\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\exp(-\mathcal{E}_{t}(\mathbf{x}))}\mathrm{d}\mathbf{x}_{0}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Sx7.SSx1.p1.8" class="ltx_p">So <math id="Sx7.SSx1.p1.m14" class="ltx_Math" alttext="\hat{u}_{t}(\mathbf{x})=\int\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0t}(\mathbf{x}_{0}|\mathbf{x})\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\exp(-\mathcal{E}_{t}(\mathbf{x}))}\mathrm{d}\mathbf{x}_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{u}_{t}(\mathbf{x})=\int\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})p_{0t}(\mathbf{x}_{0}|\mathbf{x})\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\exp(-\mathcal{E}_{t}(\mathbf{x}))}\mathrm{d}\mathbf{x}_{0}</annotation></semantics></math>. 
<br class="ltx_break"><span id="Sx7.SSx1.p1.8.1" class="ltx_text ltx_font_bold">Theorem <a href="#Thmtheorem2" title="Theorem 2. ‣ Energy-weighted flow matching ‣ Preliminaries ‣ Balancing Signal and Variance: Adaptive Offline RL Post-Trainingfor VLA Flow Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></span>
<span id="Sx7.SSx1.p1.8.2" class="ltx_text ltx_font_italic">
<math id="Sx7.SSx1.p1.m15" class="ltx_Math" alttext="p_{0}(\mathbf{x}_{0}),q_{0}(\mathbf{x}_{0}),p_{t}(\mathbf{x}),q_{t}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>q</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{0}(\mathbf{x}_{0}),q_{0}(\mathbf{x}_{0}),p_{t}(\mathbf{x}),q_{t}(\mathbf{x})</annotation></semantics></math><math id="Sx7.SSx1.p1.m16" class="ltx_math_unparsed" alttext=",\mathcal{E}(\mathbf{x}_{0}),\mathcal{E}_{t}(\mathbf{x}_{t}),\\
\hat{\mathbf{u}}_{t}(\mathbf{x}),\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})" display="inline" intent=":literal"><semantics><mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mover accent="true"><mi>𝐮</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">,\mathcal{E}(\mathbf{x}_{0}),\mathcal{E}_{t}(\mathbf{x}_{t}),\\
\hat{\mathbf{u}}_{t}(\mathbf{x}),\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})</annotation></semantics></math> are all defined above. Consider learning a model <math id="Sx7.SSx1.p1.m17" class="ltx_Math" alttext="\mathbf{v}_{\theta}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}_{\theta}(\mathbf{x})</annotation></semantics></math> with the learnable parameter <math id="Sx7.SSx1.p1.m18" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, then define the Energy-weighted Flow Matching (EFM) loss <math id="Sx7.SSx1.p1.m19" class="ltx_Math" alttext="\mathcal{L}_{EFM}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{EFM}</annotation></semantics></math> as:</span></p>
<table id="Sx7.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Sx7.Ex32.m1" class="ltx_Math" alttext="\mathcal{L}_{EFM}(\theta)=\mathbb{E}_{\mathbf{x},t}[\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}_{\tilde{x}\sim p_{t}(\tilde{\mathbf{x}})}[\exp(-\mathcal{E}_{t}(\tilde{\mathbf{x}}))]}||\mathbf{v}_{\theta}(\mathbf{x})-\hat{\mathbf{u}}_{t}(\mathbf{x})||^{2}]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>∼</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>𝐮</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{EFM}(\theta)=\mathbb{E}_{\mathbf{x},t}[\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}_{\tilde{x}\sim p_{t}(\tilde{\mathbf{x}})}[\exp(-\mathcal{E}_{t}(\tilde{\mathbf{x}}))]}||\mathbf{v}_{\theta}(\mathbf{x})-\hat{\mathbf{u}}_{t}(\mathbf{x})||^{2}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Sx7.SSx1.p1.9" class="ltx_p"><span id="Sx7.SSx1.p1.9.1" class="ltx_text ltx_font_italic">and the Conditional Energy-weighted Flow Matching (CEFM) loss <math id="Sx7.SSx1.p1.m20" class="ltx_Math" alttext="\mathcal{L}_{CEFM}(\theta)=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{L}_{CEFM}(\theta)=</annotation></semantics></math>:</span></p>
<table id="Sx7.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Sx7.Ex33.m1" class="ltx_Math" alttext="\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}_{\tilde{x}\sim p_{0}(\tilde{\mathbf{x}}_{0})}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0}))]}||\mathbf{v}_{\theta}(\mathbf{x})-\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})||^{2}]." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>∼</mo><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}_{\tilde{x}\sim p_{0}(\tilde{\mathbf{x}}_{0})}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0}))]}||\mathbf{v}_{\theta}(\mathbf{x})-\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})||^{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Sx7.SSx1.p1.10" class="ltx_p"><span id="Sx7.SSx1.p1.10.1" class="ltx_text ltx_font_italic">Then there is <math id="Sx7.SSx1.p1.m21" class="ltx_Math" alttext="\nabla_{\theta}\mathcal{L}_{EFM}(\theta)=\nabla_{\theta}\mathcal{L}_{CEFM}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\mathcal{L}_{EFM}(\theta)=\nabla_{\theta}\mathcal{L}_{CEFM}(\theta)</annotation></semantics></math>.
<br class="ltx_break"></span>
<span id="Sx7.SSx1.p1.10.2" class="ltx_text ltx_font_bold">Proof</span>: The theorem is proved in three steps. Firstly, we prove the relationship between <math id="Sx7.SSx1.p1.m22" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math> and <math id="Sx7.SSx1.p1.m23" class="ltx_Math" alttext="\mathcal{E}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{t}</annotation></semantics></math>, that is:</p>
<table id="Sx7.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="Sx7.Ex34.m1" class="ltx_Math" alttext="\mathbb{E}_{\mathbf{x}}[\exp(-\mathcal{E}_{t}(\mathbf{x}))]=\mathbb{E}_{\mathbf{x}_{0}}[\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>𝐱</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathbf{x}}[\exp(-\mathcal{E}_{t}(\mathbf{x}))]=\mathbb{E}_{\mathbf{x}_{0}}[\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Sx7.SSx1.p1.11" class="ltx_p">Secondly, we find the relationship between <math id="Sx7.SSx1.p1.m24" class="ltx_Math" alttext="||\mathbf{v}_{\theta}(\mathbf{x})-\hat{\mathbf{u}}_{t}(\mathbf{x})||^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>𝐮</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">||\mathbf{v}_{\theta}(\mathbf{x})-\hat{\mathbf{u}}_{t}(\mathbf{x})||^{2}</annotation></semantics></math> and <math id="Sx7.SSx1.p1.m25" class="ltx_Math" alttext="||\mathbf{v}_{\theta}(\mathbf{x})-\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})||^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">||\mathbf{v}_{\theta}(\mathbf{x})-\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})||^{2}</annotation></semantics></math>.
Lastly, we combine the previous findings and complete the whole proof.
<br class="ltx_break">For the first step, there is:</p>
<table id="Sx7.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Sx7.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex35.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{\mathbf{x}}[\exp(-\mathcal{E}_{t}(\mathbf{x})]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>𝐱</mi></msub><mrow><mo stretchy="false">[</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{x}}[\exp(-\mathcal{E}_{t}(\mathbf{x})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex36.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex36.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\exp(-\mathcal{E}_{t}(\mathbf{x}))\mathrm{d}\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\exp(-\mathcal{E}_{t}(\mathbf{x}))\mathrm{d}\mathbf{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex37.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex37.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\int_{\mathbf{x}_{0}}p_{0t}(\mathbf{x}_{0}|\mathbf{x})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\mathrm{d}\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝐱</mi><mn>0</mn></msub></msub></mstyle><mrow><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\int_{\mathbf{x}_{0}}p_{0t}(\mathbf{x}_{0}|\mathbf{x})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\mathrm{d}\mathbf{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex38.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex38.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}\int_{\mathbf{x}_{0}}p_{0t}(\mathbf{x}_{0}|\mathbf{x})p_{t}(\mathbf{x})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\mathrm{d}\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝐱</mi><mn>0</mn></msub></msub></mstyle><mrow><msub><mi>p</mi><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}\int_{\mathbf{x}_{0}}p_{0t}(\mathbf{x}_{0}|\mathbf{x})p_{t}(\mathbf{x})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\mathrm{d}\mathbf{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex39.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex39.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}\int_{\mathbf{x}_{0}}p_{0}(\mathbf{x}_{0})p_{t0}(\mathbf{x}|\mathbf{x}_{0})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\mathrm{d}\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝐱</mi><mn>0</mn></msub></msub></mstyle><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}\int_{\mathbf{x}_{0}}p_{0}(\mathbf{x}_{0})p_{t0}(\mathbf{x}|\mathbf{x}_{0})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\mathrm{d}\mathbf{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex40.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex40.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}_{0}}\left(p_{0}(\mathbf{x}_{0})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\int_{\mathbf{x}}p_{t0}(\mathbf{x}|\mathbf{x}_{0})\mathrm{d}\mathbf{x}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝐱</mi><mn>0</mn></msub></msub></mstyle><mrow><mo>(</mo><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><msub><mi>p</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}_{0}}\left(p_{0}(\mathbf{x}_{0})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}\int_{\mathbf{x}}p_{t0}(\mathbf{x}|\mathbf{x}_{0})\mathrm{d}\mathbf{x}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex41.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex41.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}_{0}}p_{0}(\mathbf{x}_{0})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝐱</mi><mn>0</mn></msub></msub></mstyle><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}_{0}}p_{0}(\mathbf{x}_{0})\exp(-\beta\mathcal{E}_{t}(\mathbf{x}_{0}))\mathrm{d}\mathbf{x}_{0}.</annotation></semantics></math></td>
