<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex23.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
