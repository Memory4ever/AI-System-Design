<p id="Sx7.SSx1.p1.12" class="ltx_p">For the second step, there is:</p>
<table id="Sx7.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Sx7.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex43.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})-\hat{u}_{t}(\mathbf{x})||^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})-\hat{u}_{t}(\mathbf{x})||^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex44.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex44.m2" class="ltx_Math" alttext="\displaystyle\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}-2\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\hat{u}_{t}(\mathbf{x})\rangle+\nabla_{\theta}||\hat{u}_{t}(\mathbf{x})||^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}-2\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\hat{u}_{t}(\mathbf{x})\rangle+\nabla_{\theta}||\hat{u}_{t}(\mathbf{x})||^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex45.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex45.m2" class="ltx_Math" alttext="\displaystyle\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}-2\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\hat{u}_{t}(\mathbf{x})\rangle." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}-2\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\hat{u}_{t}(\mathbf{x})\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Sx7.SSx1.p2" class="ltx_para">
<p id="Sx7.SSx1.p2.1" class="ltx_p">So we have:
<br class="ltx_break"></p>
<table id="Sx7.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Sx7.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex47.m1" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}[\exp(-\mathcal{E}_{t}(\tilde{\mathbf{x}}))]}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}[\exp(-\mathcal{E}_{t}(\tilde{\mathbf{x}}))]}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex48.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex48.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}_{0}}))]}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝐱</mi><mn>0</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}p_{t}(\mathbf{x})\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}_{0}}))]}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex49.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex49.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}q_{t}(\mathbf{x})\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}q_{t}(\mathbf{x})\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex50.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex50.m2" class="ltx_Math" alttext="\displaystyle\int_{\mathbf{x}}\int_{\mathbf{x}_{0}}q_{t0}(\mathbf{x}|\mathbf{x}_{0})q_{0}(\mathbf{x}_{0})\mathrm{d}\mathbf{x}_{0}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>𝐱</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>𝐱</mi><mn>0</mn></msub></msub></mstyle><mrow><msub><mi>q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐱</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathbf{x}}\int_{\mathbf{x}_{0}}q_{t0}(\mathbf{x}|\mathbf{x}_{0})q_{0}(\mathbf{x}_{0})\mathrm{d}\mathbf{x}_{0}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}\mathrm{d}\mathbf{x}</annotation></semantics></math></td>
