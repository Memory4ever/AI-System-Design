<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex58.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})\rangle\mathrm{d}\mathbf{x}\mathrm{d}\mathbf{x}_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})\rangle\mathrm{d}\mathbf{x}\mathrm{d}\mathbf{x}_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex59.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex59.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})\rangle]." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})\rangle].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Sx7.SSx1.p2.2" class="ltx_p">In the last step, we combine the previous three equations, we have:</p>
<table id="Sx7.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Sx7.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex60.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla_{\theta}\left(\mathbb{E}_{\mathbf{x},t}[\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}_{\tilde{x}\sim p_{t}(\tilde{\mathbf{x}})}[\exp(-\mathcal{E}_{t}(\tilde{\mathbf{x}}))]}||\mathbf{v}_{\theta}(\mathbf{x})-\hat{u}_{t}(\mathbf{x})||^{2}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo>(</mo><msub><mi>𝔼</mi><mrow><mi>𝐱</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔼</mi><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>∼</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐯</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\theta}\left(\mathbb{E}_{\mathbf{x},t}[\frac{\exp(-\mathcal{E}_{t}(\mathbf{x}))}{\mathbb{E}_{\tilde{x}\sim p_{t}(\tilde{\mathbf{x}})}[\exp(-\mathcal{E}_{t}(\tilde{\mathbf{x}}))]}||\mathbf{v}_{\theta}(\mathbf{x})-\hat{u}_{t}(\mathbf{x})||^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex61.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex61.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}\nabla_{\theta}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex62.m1" class="ltx_Math" alttext="\displaystyle-2" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle-2</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex62.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})\rangle]." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}\nabla_{\theta}\langle\mathbf{v}_{\theta}(\mathbf{x}),\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})\rangle].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex63.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex63.m2" class="ltx_math_unparsed" alttext="\displaystyle\nabla_{\theta}\left(\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}||\mathbf{v}_{\theta}(\mathbf{x})-\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})||^{2}\right)." display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo>(</mo><msub><mi>𝔼</mi><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐯</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>𝐮</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\theta}\left(\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}||\mathbf{v}_{\theta}(\mathbf{x})-\mathbf{u}_{t0}(\mathbf{x}|\mathbf{x}_{0})||^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Sx7.SSx1.p2.3" class="ltx_p">So that is <math id="Sx7.SSx1.p2.m1" class="ltx_Math" alttext="\nabla_{\theta}\mathcal{L}_{EFM}(\theta)=\nabla_{\theta}\mathcal{L}_{CEFM}(\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\mathcal{L}_{EFM}(\theta)=\nabla_{\theta}\mathcal{L}_{CEFM}(\theta)</annotation></semantics></math>.</p>
</div>
</section>
<section id="Sx7.SSx2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">Derivation of tuning process of <math id="Sx7.SSx2.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></h3>

<div id="Sx7.SSx2.p1" class="ltx_para">
<p id="Sx7.SSx2.p1.1" class="ltx_p">In this section, we discuss the derivation of <span id="Sx7.SSx2.p1.1.1" class="ltx_text ltx_font_bold">Corollary</span> <a href="#Thmcorollary1" title="Corollary 1. ‣ Adaptive adjustment of the scaling factor 𝛼 ‣ Methodology ‣ Balancing Signal and Variance: Adaptive Offline RL Post-Trainingfor VLA Flow Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and <span id="Sx7.SSx2.p1.1.2" class="ltx_text ltx_font_bold">Corollary</span> <a href="#Thmcorollary2" title="Corollary 2. ‣ Adaptive adjustment of the scaling factor 𝛼 ‣ Methodology ‣ Balancing Signal and Variance: Adaptive Offline RL Post-Trainingfor VLA Flow Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, which are about the dynamic tuning process of the scaling factor <math id="Sx7.SSx2.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.
<br class="ltx_break"><span id="Sx7.SSx2.p1.1.3" class="ltx_text ltx_font_bold">Corollary <a href="#Thmcorollary1" title="Corollary 1. ‣ Adaptive adjustment of the scaling factor 𝛼 ‣ Methodology ‣ Balancing Signal and Variance: Adaptive Offline RL Post-Trainingfor VLA Flow Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></span>
<span id="Sx7.SSx2.p1.1.4" class="ltx_text ltx_font_italic">
Define <math id="Sx7.SSx2.p1.m2" class="ltx_Math" alttext="J(\alpha)=\mathrm{Var}(\hat{g}(\alpha))-\lambda S(\alpha)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">J(\alpha)=\mathrm{Var}(\hat{g}(\alpha))-\lambda S(\alpha),</annotation></semantics></math> then <math id="Sx7.SSx2.p1.m3" class="ltx_Math" alttext="J(\alpha)=\sigma_{L}^{2}[e^{2\alpha^{2}\sigma_{R}^{2}}-e^{\alpha^{2}\sigma_{R}^{2}}]-\lambda\alpha\sigma_{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>σ</mi><mi>L</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">J(\alpha)=\sigma_{L}^{2}[e^{2\alpha^{2}\sigma_{R}^{2}}-e^{\alpha^{2}\sigma_{R}^{2}}]-\lambda\alpha\sigma_{R}^{2}</annotation></semantics></math>.
<br class="ltx_break"></span>
<span id="Sx7.SSx2.p1.1.5" class="ltx_text ltx_font_bold">Proof</span>: By the assumption, all of the <math id="Sx7.SSx2.p1.m4" class="ltx_Math" alttext="R^{*}(\mathbf{A}_{t}^{j},\mathbf{o}_{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐀</mi><mi>t</mi><mi>j</mi></msubsup><mo>,</mo><msub><mi>𝐨</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R^{*}(\mathbf{A}_{t}^{j},\mathbf{o}_{t})</annotation></semantics></math> satisfy the same distribution <math id="Sx7.SSx2.p1.m5" class="ltx_Math" alttext="R^{*}\sim\mathcal{N}(0,\sigma_{R}^{2})" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{*}\sim\mathcal{N}(0,\sigma_{R}^{2})</annotation></semantics></math>, so <math id="Sx7.SSx2.p1.m6" class="ltx_Math" alttext="\hat{w}_{i}=\exp(\alpha R^{*}(\mathbf{A}_{t}^{i},\mathbf{o}_{t}^{i}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>w</mi><mo>^</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐀</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>𝐨</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{w}_{i}=\exp(\alpha R^{*}(\mathbf{A}_{t}^{i},\mathbf{o}_{t}^{i}))</annotation></semantics></math> are also i.i.d. variables.
Then we define <math id="Sx7.SSx2.p1.m7" class="ltx_Math" alttext="m_{1}(\alpha)=\mathbb{E}[\exp(\alpha R^{*})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m_{1}(\alpha)=\mathbb{E}[\exp(\alpha R^{*})]</annotation></semantics></math>, and <math id="Sx7.SSx2.p1.m8" class="ltx_Math" alttext="m_{2}(\alpha)=\mathbb{E}[\exp(2\alpha R^{*})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m_{2}(\alpha)=\mathbb{E}[\exp(2\alpha R^{*})]</annotation></semantics></math>.</p>
</div>
<div id="Sx7.SSx2.p2" class="ltx_para">
<p id="Sx7.SSx2.p2.1" class="ltx_p">Firstly, we derive <math id="Sx7.SSx2.p2.m1" class="ltx_Math" alttext="m_{1}(\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{1}(\alpha)</annotation></semantics></math> and <math id="Sx7.SSx2.p2.m2" class="ltx_Math" alttext="m_{2}(\alpha)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{2}(\alpha)</annotation></semantics></math>:</p>
<table id="Sx7.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Sx7.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex65.m1" class="ltx_Math" alttext="\displaystyle m_{1}(\alpha)=\mathbb{E}[\exp(\alpha R^{*})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle m_{1}(\alpha)=\mathbb{E}[\exp(\alpha R^{*})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex66.m1" class="ltx_Math" alttext="\displaystyle=\int_{-\infty}^{+\infty}\exp(\alpha x)\mathrm{Pr}(R^{*}=x)\mathrm{d}x" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mo>∗</mo></msup><mo>=</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{-\infty}^{+\infty}\exp(\alpha x)\mathrm{Pr}(R^{*}=x)\mathrm{d}x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex67.m1" class="ltx_Math" alttext="\displaystyle=\int_{-\infty}^{+\infty}\frac{1}{\sqrt{2\pi\sigma_{R}}}\exp(\alpha x)\exp(-\frac{x^{2}}{2\sigma_{R}^{2}})\mathrm{d}x" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>x</mi><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{-\infty}^{+\infty}\frac{1}{\sqrt{2\pi\sigma_{R}}}\exp(\alpha x)\exp(-\frac{x^{2}}{2\sigma_{R}^{2}})\mathrm{d}x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex68.m1" class="ltx_Math" alttext="\displaystyle=\int_{-\infty}^{+\infty}\frac{1}{\sqrt{2\pi\sigma_{R}}}\exp(-\frac{1}{2\sigma_{R}^{2}}(x-\sigma_{R}\alpha)^{2})\exp(\frac{1}{2}\sigma_{R}^{2}\alpha^{2})\mathrm{d}x" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub></mrow></msqrt></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{-\infty}^{+\infty}\frac{1}{\sqrt{2\pi\sigma_{R}}}\exp(-\frac{1}{2\sigma_{R}^{2}}(x-\sigma_{R}\alpha)^{2})\exp(\frac{1}{2}\sigma_{R}^{2}\alpha^{2})\mathrm{d}x</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex69.m1" class="ltx_Math" alttext="\displaystyle=\exp(\frac{1}{2}\sigma_{R}^{2}\alpha^{2})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\exp(\frac{1}{2}\sigma_{R}^{2}\alpha^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex70.m1" class="ltx_Math" alttext="\displaystyle m_{2}(\alpha)=\mathbb{E}[\exp(2\alpha R^{*})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle m_{2}(\alpha)=\mathbb{E}[\exp(2\alpha R^{*})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx7.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex71.m1" class="ltx_Math" alttext="\displaystyle=m_{1}(2\alpha)=\exp(\frac{1}{2}4\sigma_{R}^{2}\alpha^{2})=\exp(2\alpha^{2}\sigma_{R}^{2})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>R</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=m_{1}(2\alpha)=\exp(\frac{1}{2}4\sigma_{R}^{2}\alpha^{2})=\exp(2\alpha^{2}\sigma_{R}^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Sx7.SSx2.p2.2" class="ltx_p">Secondly, we start to derive <math id="Sx7.SSx2.p2.m3" class="ltx_Math" alttext="\mathrm{Var}(\hat{g}(\alpha))" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\hat{g}(\alpha))</annotation></semantics></math> and <math id="Sx7.SSx2.p2.m4" class="ltx_Math" alttext="S(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S(\alpha)</annotation></semantics></math>: 
<br class="ltx_break"></p>
<table id="Sx7.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Sx7.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx7.Ex73.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Var}(\hat{g}(\alpha))=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>g</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}(\hat{g}(\alpha))=</annotation></semantics></math></td>
