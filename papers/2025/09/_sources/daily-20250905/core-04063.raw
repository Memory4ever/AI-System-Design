<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx7.Ex52.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}]." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>𝐱</mi><mn>0</mn></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>exp</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{x}_{0},\mathbf{x},t}[\frac{\exp(-\beta\mathcal{E}(\mathbf{x}_{0}))}{\mathbb{E}[\exp(-\beta\mathcal{E}(\tilde{\mathbf{x}}_{0})]}||\mathbf{v}_{\theta}(\mathbf{x})||^{2}].</annotation></semantics></math></td>
