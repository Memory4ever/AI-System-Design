<div id="lstnumberx95" class="ltx_listingline"><span id="lstnumberx95.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">2.</span><span id="lstnumberx95.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx95.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">Each</span><span id="lstnumberx95.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx95.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">stop</span><span id="lstnumberx95.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx95.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">has</span><span id="lstnumberx95.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx95.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">all</span><span id="lstnumberx95.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx95.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">required</span><span id="lstnumberx95.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx95.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">fields</span><span id="lstnumberx95.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx95.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">(place,</span><span id="lstnumberx95.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx95.17" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">arrival_time,</span><span id="lstnumberx95.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx95.19" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">departure_time)</span>
</div>
<div id="lstnumberx96" class="ltx_listingline"><span id="lstnumberx96.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">3.</span><span id="lstnumberx96.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx96.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">Each</span><span id="lstnumberx96.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx96.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">place</span><span id="lstnumberx96.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx96.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">includes</span><span id="lstnumberx96.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx96.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">the</span><span id="lstnumberx96.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx96.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">IATA</span><span id="lstnumberx96.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx96.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">code</span><span id="lstnumberx96.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx96.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">in</span><span id="lstnumberx96.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx96.17" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">parentheses</span>
</div>
<div id="lstnumberx97" class="ltx_listingline"><span id="lstnumberx97.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">4.</span><span id="lstnumberx97.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx97.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">All</span><span id="lstnumberx97.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx97.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">times</span><span id="lstnumberx97.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx97.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">are</span><span id="lstnumberx97.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx97.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">in</span><span id="lstnumberx97.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx97.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">UTC</span><span id="lstnumberx97.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx97.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">and</span><span id="lstnumberx97.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx97.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">follow</span><span id="lstnumberx97.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx97.17" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">the</span><span id="lstnumberx97.18" class="ltx_text ltx_lst_space ltx_