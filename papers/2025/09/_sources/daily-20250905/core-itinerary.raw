<div id="lstnumberx26" class="ltx_listingline"><span id="lstnumberx26.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">3.</span><span id="lstnumberx26.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx26.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">The</span><span id="lstnumberx26.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx26.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">"</span><span id="lstnumberx26.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">place</span><span id="lstnumberx26.7" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">"<span id="lstnumberx26.7.1" class="ltx_text ltx_lst_space">␣</span>field<span id="lstnumberx26.7.2" class="ltx_text ltx_lst_space">␣</span>in<span id="lstnumberx26.7.3" class="ltx_text ltx_lst_space">␣</span>your<span id="lstnumberx26.7.4" class="ltx_text ltx_lst_space">␣</span>JSON<span id="lstnumberx26.7.5" class="ltx_text ltx_lst_space">␣</span>for<span id="lstnumberx26.7.6" class="ltx_text ltx_lst_space">␣</span>each<span id="lstnumberx26.7.7" class="ltx_text ltx_lst_space">␣</span>stop<span id="lstnumberx26.7.8" class="ltx_text ltx_lst_space">␣</span>MUST<span id="lstnumberx26.7.9" class="ltx_text ltx_lst_space">␣</span>EXACTLY<span id="lstnumberx26.7.10" class="ltx_text ltx_lst_space">␣</span>MATCH<span id="lstnumberx26.7.11" class="ltx_text ltx_lst_space">␣</span>the<span id="lstnumberx26.7.12" class="ltx_text ltx_lst_space">␣</span>city<span id="lstnumberx26.7.13" class="ltx_text ltx_lst_space">␣</span>name<span id="lstnumberx26.7.14" class="ltx_text ltx_lst_space">␣</span>and<span id="lstnumberx26.7.15" class="ltx_text ltx_lst_space">␣</span>IATA<span id="lstnumberx26.7.16" class="ltx_text ltx_lst_space">␣</span>code<span id="lstnumberx26.7.17" class="ltx_text ltx_lst_space"