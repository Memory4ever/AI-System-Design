<div id="lstnumberx58" class="ltx_listingline"><span id="lstnumberx58.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">Requirements:</span>
</div>
<div id="lstnumberx59" class="ltx_listingline"><span id="lstnumberx59.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">1.</span><span id="lstnumberx59.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx59.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">All</span><span id="lstnumberx59.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx59.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">times</span><span id="lstnumberx59.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx59.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">MUST</span><span id="lstnumberx59.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx59.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">be</span><span id="lstnumberx59.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx59.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">in</span><span id="lstnumberx59.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx59.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">UTC.</span>
</div>
<div id="lstnumberx60" class="ltx_listingline"><span id="lstnumberx60.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">2.</span><span id="lstnumberx60.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx60.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">Use</span><span id="lstnumberx60.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx60.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">24-hour</span><span id="lstnumberx60.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx60.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">format</span><span id="lstnumberx60.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx60.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">(e.g.,</span><span id="lstnumberx60.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx60.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">14:30,</span><span id="lstnumberx60.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx60.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">00:00</span><span id="lstnumberx60.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx60.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">for</span><span id="lstnumberx60.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx60.17" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">midnight).</span>
</div>
<div id="lstnumberx61" class="ltx_listingline"><span id="lstnumberx61.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">3.</span><span id="lstnumberx61.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx61.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">Travel</span><span id="lstnumberx61.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx61.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">dates</span><span id="lstnumberx61.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx61.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">must</span><span id="lstnumberx61.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx61.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">be</span><span id="lstnumberx61.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx61.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">between</span><span id="lstnumberx61.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx61.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">{date_suggestion_start}</span><span id="lstnumberx61.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx61.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">and</span><span id="lstnumberx61.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx61.17" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">{date_suggestion_end}.</span>
</div>
<div id="lstnumberx62" class="ltx_listingline"><span id="lstnumberx62.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">4.</span><span id="lstnumberx62.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx62.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">Include</span><span id="lstnumberx62.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx62.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">the</span><span id="lstnumberx62.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx62.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">IATA</span><span id="lstnumberx62.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx62.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">airport</span><span id="lstnumberx62.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx62.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">code</span><span id="lstnumberx62.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx62.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">for</span><span id="lstnumberx62.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx62.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">each</span><span id="lstnumberx62.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">␣</span><span id="lstnumberx62.17" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF8040;">city</span><span id="lstnumberx62.18" class="ltx_text ltx_lst_sp