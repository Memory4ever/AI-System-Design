<span id="S5.T2.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S5.T2.2.2.1.1.1" class="ltx_p">Sydney (SYD)</span>
</span></td>
<td id="S5.T2.2.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S5.T2.2.2.2.1" class="ltx_inline-block ltx_align_top" style="width:170.7pt;">
