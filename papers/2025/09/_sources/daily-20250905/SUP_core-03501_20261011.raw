<td id="S4.T6.3.7.2" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r" style="padding-left:2.8pt;padding-right:2.8pt;"><math id="S4.T6.m17" class="ltx_Math" style="--ltx-bg-color:#E7F5FE;" alttext="28.73\%" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#E7F5FE;" mathbackground="#E7F5FE" mathsize="0.900em">28.73</mn><mo style="--ltx-bg-color:#E7F5FE;" mathbackground="#E7F5FE">%</mo></mrow><annotation encoding="application/x-tex">28.73\%</annotation></semantics></math></td>
<td id="S4.T6.3.7.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.8pt;padding-right:2.8pt;"><math id="S4.T6.m18" class="ltx_Math" style="--ltx-bg-color:#E7F5FE;" alttext="\mathbf{0.6041}" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#E7F5FE;" class="ltx_mathvariant_bold" mathbackground="#E7F5FE" mathsize="0.900em" mathvariant="bold">0.6041</mn><annotation encoding="application/x-tex">\mathbf{0.6041}</annotation></semantics></math></td></tr>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_table">Table 6: </span><span id="S4.T6.10" class="ltx_text ltx_font_bold">Timestamp-based Yes/No QA</span> results on QVHighlights before and after applying the visual prompting method, NumberIt <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib55" title="" class="ltx_ref">55</a>]</cite>.
</figcaption>
</figure>
