<td id="S4.T2.3.1.2" class="ltx_td ltx_align_right ltx_border_tt" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T2.3.1.2.1" class="ltx_text"></span><span id="S4.T2.3.1.2.2" class="ltx_text" style="font-size:80%;"> <span id="S4.T2.3.1.2.2.1" class="ltx_text">
