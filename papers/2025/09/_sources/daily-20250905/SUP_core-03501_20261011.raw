<span id="S4.T1.3.1.2.1" class="ltx_inline-block ltx_align_top" style="width:250.4pt;">
<span id="S4.T1.3.1.2.1.1" class="ltx_p"><span id="S4.T1.3.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Description</span></span>
</span></td>
<td id="S4.T1.3.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S4.T1.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Visual Input</span></td>
<td id="S4.T1.3.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S4.T1.3.1.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Task Types (<span id="S4.T1.3.1.4.1.1" class="ltx_text ltx_font_italic">ref.</span> Tab. <a href="#A1.T7" title="Table 7 ‣ A.3.4 Timestamp Reference Token Representation ‣ A.3 Model Details ‣ Appendix A Appendix / Supplemental Material ‣ Strefer: Empowering Video LLMs with Space-Time Referring and Reasoning via Synthetic Instruction Data" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>)</span></td>
<td id="S4.T1.3.1.5" class="ltx_td ltx_align_right ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S4.T1.3.1.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;"># Samples</span></td></tr>
<tr id="S4.T1.3.2" class="ltx_tr">
<td id="S4.T1.3.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><math id="S4.T1.m1" class="ltx_Math" alttext="\mathcal{G}1" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒢</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.800em">1</mn></mrow><annotation encoding="application/x-tex">\mathcal{G}1</annotation></semantics></math></td>
<td id="S4.T1.3.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">
<span id="S4.T1.3.2.2.1" class="ltx_inline-block ltx_align_top" style="width:250.4pt;">
<span id="S4.T1.3.2.2.1.1" class="ltx_p"><span id="S4.T1.3.2.2.1.1.1" class="ltx_text" style="font-size:80%;">Traditional data, template generated</span></span>
