                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Juho Kim
                      
                    </div>
                  
              
            
          
          
          <div class="row-card__subheading__spacer"></div>
          <div class="row-card__subheading__item small-text">
            Proceedings of the IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR) (2026)
          </div>
          
