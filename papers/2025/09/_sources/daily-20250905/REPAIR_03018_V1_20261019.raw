<span class="ltx_tag ltx_tag_listingline"><span class="ltx_text" style="font-size:80%;">14</span></span><span class="ltx_text" style="font-size:80%;"> </span><span class="ltx_rule" style="width:1px;height:100%;background:black;display:inline-block;"> </span><span class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;background:black;display:inline-block;"> </span><span class="ltx_text" style="font-size:80%;"> </span><span class="ltx_text" style="font-size:80%;">
</span>
</div>
