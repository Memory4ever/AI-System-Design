</tr>
</table>
</td>
</tr>
<tr class="ltx_tr">
<td class="ltx_td ltx_align_left ltx_border_t">CPU</td>
<td class="ltx_td ltx_align_center ltx_border_t">1.5%</td>
<td class="ltx_td ltx_align_center ltx_border_t">10.7%</td>
<td class="ltx_td ltx_align_center ltx_border_t">11.0%</td>
