math id="S3.F2.sf3.pic1.m2" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#80FF80;" fill="#80FF80"><path d="M 138.58 0 C 138.58 6.96 132.94 12.6 125.98 12.6 C 119.03 12.6 113.39 6.96 113.39 0 C 113.39 -6.96 119.03 -12.6 125.98 -12.6 C 132.94 -12.6 138.58 -6.96 138.58 0 Z M 125.98 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 120.34 -1.55)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.sf3.pic1.m3" class="ltx_Math" alttext="x_{3}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>3</mn></msub><annotation encoding="application/x-tex">x_{3}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#FF8080;" fill="#FF8080"><path d="M 44.09 94.49 C 44.09 101.45 38.45 107.09 31.5 107.09 C 24.54 107.09 18.9 101.45 18.9 94.49 C 18.9 87.53 24.54 81.89 31.5 81.89 C 38.45 81.89 44.09 87.53 44.09 94.49 Z M 31.5 94.49"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 26.33 92.94)"><foreignObject style="--ltx-fo-width:0.93em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="12.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.sf3.pic1.m4" class="ltx_Math" alttext="o_{1}" display="inline" intent=":literal"><semantics><msub><mi>o</mi><mn>1</mn></msub><annotation encoding="application/x-tex">o_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#FF8080;" fill="#FF8080"><path d="M 107.09 94.49 C 107.09 101.45 101.45 107.09 94.49 107.09 C 87.53 107.09 81.89 101.45 81.89 94.49 C 81.89 87.53 87.53 81.89 94.49 81.89 C 101.45 81.89 107.09 87.53 107.09 94.49 Z M 94.49 94.49"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 89.32 92.94)"><foreignObject style="--ltx-fo-width:0.93em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="12.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.sf3.pic1.m5" class="ltx_Math" alttext="o_{2}" display="inline" intent=":literal"><semantics><msub><mi>o</mi><mn>2</mn></msub><annotation encoding="application/x-tex">o_{2}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 4.05 12.16 L 25.87 77.6"></path><g transform="matrix(0.31622 0.94868 -0.94868 0.31622 25.87 77.6)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g><path style="fill:none" d="M 9.07 9.07 L 81.9 81.9"></path><g transform="matrix(0.7071 0.7071 -0.7071 0.7071 81.9 81.9)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g><path style="fill:none" d="M 58.94 12.16 L 37.13 77.6"></path><g transform="matrix(-0.31622 0.94868 -0.94868 -0.31622 37.13 77.6)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g><path style="fill:none" d="M 67.05 12.16 L 88.86 77.6"></path><g transform="matrix(0.31622 0.94868 -0.94868 0.31622 88.86 77.6)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g><path style="fill:none" d="M 116.92 9.07 L 44.08 81.9"></path><g transform="matrix(-0.7071 0.7071 -0.7071 -0.7071 44.08 81.9)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g><path style="fill:none" d="M 121.93 12.16 L 100.12 77.6"></path><g transform="matrix(-0.31622 0.94868 -0.94868 -0.31622 100.12 77.6)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S3.F2.sf3.4" class="ltx_text" style="font-size:90%;">Focused Attention</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S3.F2.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><span class="ltx_inline-block"><svg id="S3.F2.sf4.pic1" class="ltx_picture ltx_centering" height="120.24" overflow="visible" version="1.1" viewBox="0 0 151.74 120.24" width="151.74"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,120.24) matrix(1 0 0 -1 0 0) translate(12.88,0) translate(0,12.88)"><g style="--ltx-fill-color:#FFFF80;" fill="#FFFF80"><path d="M 12.6 0 C 12.6 6.96 6.96 12.6 0 12.6 C -6.96 12.6 -12.6 6.96 -12.6 0 C -12.6 -6.96 -6.96 -12.6 0 -12.6 C 6.96 -12.6 12.6 -6.96 12.6 0 Z M 0 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 -4.88 -1.55)"><foreignObject style="--ltx-fo-width:0.88em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="12.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.sf4.pic1.m1" class="ltx_Math" alttext="c_{1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>1</mn></msub><annotation encoding="application/x-tex">c_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#80FF80;" fill="#80FF80"><path d="M 75.59 0 C 75.59 6.96 69.95 12.6 62.99 12.6 C 56.03 12.6 50.39 6.96 50.39 0 C 50.39 -6.96 56.03 -12.6 62.99 -12.6 C 69.95 -12.6 75.59 -6.96 75.59 0 Z M 62.99 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.8 0.0 0.0 0.8 57.35 -1.55)"><foreignObject style="--ltx-fo-width:1.02em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="14.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><m