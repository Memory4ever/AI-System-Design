span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 56.45 182.51)"><foreignObject style="--ltx-fo-width:3.22em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="44.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.5" class="ltx_text">Output</span></span></span></foreignObject></g><path style="fill:none" d="M 78.74 -19.69 L 78.74 -8.39"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 78.74 -12.36)"><path d="M 10.98 0 L 0.97 3.33 L 4.11 0 L 0.97 -3.33 Z"></path></g><path style="fill:none" d="M 78.74 158.03 L 78.74 167.09"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 78.74 163.12)"><path d="M 10.98 0 L 0.97 3.33 L 4.11 0 L 0.97 -3.33 Z"></path></g></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-width="0.8pt"><path style="fill:none" d="M 161.97 137.8 M 161.97 137.8 C 166.12 135.72 168.89 130.88 168.89 123.96 L 168.89 92.58 C 168.89 85.66 171.66 80.82 175.81 78.74 C 171.66 76.66 168.89 71.82 168.89 64.9 L 168.89 33.52 C 168.89 26.6 166.12 21.76 161.97 19.69"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#000000;" color="#000000" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 190.76 75.28)"><foreignObject style="--ltx-fo-width:4.15em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="57.39"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.6" class="ltx_text" style="--ltx-fg-color:#000000;">Nx layers</span></span></span></foreignObject></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F3.3" class="ltx_text" style="font-size:90%;">Figure 3</span>: </span><span id="S3.F3.4" class="ltx_text" style="font-size:90%;">Schematic of a stacked TConstFormer network structure.</span></figcaption>
</figure>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Attention Complexity Analysis</h2>

<figure id="S4.F4" class="ltx_figure"><span class="ltx_inline-block"><svg id="S4.F4.pic1" class="ltx_picture ltx_centering" height="189.35" overflow="visible" version="1.1" viewBox="0 0 343.89 189.35" width="343.89"><g transform="translate(0,189.35) matrix(1 0 0 -1 0 0) translate(59.75,0) translate(0,78.43)"><g style="--ltx-stroke-color:#333333;--ltx-fill-color:#FFFF80;" fill="#FFFF80" stroke="#333333" stroke-width="0.8pt"><path d="M 0 0 M 0 0 L 0 78.74 L 157.48 78.74 L 157.48 0 Z M 157.48 78.74"></path></g><g style="--ltx-stroke-color:#333333;--ltx-fill-color:#8080FF;" fill="#8080FF" stroke="#333333" stroke-width="0.8pt"><path d="M 157.48 0 M 157.48 0 L 157.48 78.74 L 255.91 78.74 L 255.91 0 Z M 255.91 78.74"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><g stroke-width="1.0pt"><path style="fill:none" d="M -59.06 -59.06 L 255.91 -59.06"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 92.11 -73.81)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F4.pic1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.6pt"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 0 0 L -53.77 -53.77"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-dasharray="none" stroke-dash