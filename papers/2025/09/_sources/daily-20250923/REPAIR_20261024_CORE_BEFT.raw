<td id="S3.T4.1.6.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.1.6.3.1" class="ltx_text ltx_font_bold">88.6</span></td>
<td id="S3.T4.1.6.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.1.6.4.1" class="ltx_text ltx_font_bold">56.7</span></td>
<td id="S3.T4.1.6.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.1.6.5.1" class="ltx_text ltx_font_bold">90.5</span></td>
<td id="S3.T4.1.6.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.1.6.6.1" class="ltx_text ltx_font_bold">62.1</span></td></tr>
