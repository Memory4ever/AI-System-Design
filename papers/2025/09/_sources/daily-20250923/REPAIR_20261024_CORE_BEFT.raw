<th id="S3.T4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" rowspan="2"><span id="S3.T4.1.1.2.1" class="ltx_text"><math id="S3.T4.m1" class="ltx_Math" alttext="\boldsymbol{b}_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi>𝒃</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">\boldsymbol{b}_{\mathcal{T}}</annotation></semantics></math></span></th>
