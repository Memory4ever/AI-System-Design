<td id="S3.T2.2.1.18.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="S3.T2.2.1.18.3.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="S3.T2.2.1.18.3.1.1" class="ltx_p"><span id="S3.T2.2.1.18.3.1.1.1" class="ltx_text" style="font-size:90%;">Pronoun Reference</span></span>
</span></td>
