<p id="S6.T10.2.1" class="ltx_p"><span id="S6.T10.2.1.1" class="ltx_text" style="font-size:90%;">
<span id="S6.T10.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:553.2pt;height:85.7pt;vertical-align:-40.6pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<span id="S6.T10.2.1.1.1.1" class="ltx_p"><span id="S6.T10.2.1.1.1.1.1" class="ltx_text">
