{"data":{"id":"10.48550/arxiv.2509.15888","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.15888","prefix":"10.48550","suffix":"arxiv.2509.15888","identifiers":[{"identifier":"2509.15888","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.15888"}],"creators":[{"name":"Hu, Senkang","nameType":"Personal","givenName":"Senkang","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Xudong","nameType":"Personal","givenName":"Xudong","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Jinqi","nameType":"Personal","givenName":"Jinqi","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Tao, Yihang","nameType":"Personal","givenName":"Yihang","familyName":"Tao","affiliation":[],"nameIdentifiers":[]},{"name":"Fang, Zihan","nameType":"Personal","givenName":"Zihan","familyName":"Fang","affiliation":[],"nameIdentifiers":[]},{"name":"Dai, Yong","nameType":"Personal","givenName":"Yong","familyName":"Dai","affiliation":[],"nameIdentifiers":[]},{"name":"Kwong, Sam Tak Wu","nameType":"Personal","givenName":"Sam Tak Wu","familyName":"Kwong","affiliation":[],"nameIdentifiers":[]},{"name":"Fang, Yuguang","nameType":"Personal","givenName":"Yuguang","familyName":"Fang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distribution-Aligned Decoding for Efficient LLM Task Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T11:35:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-22T00:42:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-26T07:27:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T00:39:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-12T09:59:05Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-14T00:58:50Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02-10T12:27:34Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-11T01:48:28Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02-28T20:18:28Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-03-03T01:51:45Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Adapting billion-parameter language models to a downstream task is still costly, even with parameter-efficient fine-tuning (PEFT). We re-cast task adaptation as output-distribution alignment: the objective is to steer the output distribution toward the task distribution directly during decoding rather than indirectly through weight updates. Building on this view, we introduce Steering Vector Decoding (SVDecode), a lightweight, PEFT-compatible, and theoretically grounded method. We start with a short warm-start fine-tune and extract a task-aware steering vector from the Kullback-Leibler (KL) divergence gradient between the output distribution of the warm-started and pre-trained models. This steering vector is then used to guide the decoding process to steer the model's output distribution towards the task distribution. We theoretically prove that SVDecode is first-order equivalent to the gradient step of full fine-tuning and derive a globally optimal solution for the strength of the steering vector. Across three tasks and nine benchmarks, SVDecode paired with four standard PEFT methods improves multiple-choice accuracy by up to 5 percentage points and open-ended truthfulness by 2 percentage points, with similar gains (1-2 percentage points) on commonsense datasets without adding trainable parameters beyond the PEFT adapter. SVDecode thus offers a lightweight, theoretically grounded path to stronger task adaptation for large language models. Code is available at https://github.com/dl-m9/SVDecode.","descriptionType":"Abstract"},{"description":"Accepted by NeurIPS'25","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.15888","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-22T01:51:02.000Z","registered":"2025-09-22T01:51:03.000Z","published":"2025","updated":"2026-03-03T05:42:52.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.15888","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}