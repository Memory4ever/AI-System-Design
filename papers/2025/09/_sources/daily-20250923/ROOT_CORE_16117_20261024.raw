<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Proof of Theorems</h2>

<div id="A1.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma A.1</span></span><span id="A1.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(<span id="A1.Thmtheorem1.4" class="ltx_text ltx_font_bold">Distribution Split</span>)<span id="A1.Thmtheorem1.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="A1.Thmtheorem1.p1.1" class="ltx_p"><span id="A1.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Consider the distribution triplet <math id="A1.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\pi^{+}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>+</mo></msup><annotation encoding="application/x-tex">\pi^{+}</annotation></semantics></math>, <math id="A1.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\pi^{-}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>−</mo></msup><annotation encoding="application/x-tex">\pi^{-}</annotation></semantics></math>, and <math id="A1.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\pi^{\text{old}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><annotation encoding="application/x-tex">\pi^{\text{old}}</annotation></semantics></math>, as defined in Section <a href="#S3.SS1" title="3.1 Problem Setup ‣ 3 Diffusion Reinforcement via Negative-aware Finetuning ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>:</span></p>
<table id="A1.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E7.m1" class="ltx_Math" alttext="\pi^{+}({\bm{x}}_{0}|{\bm{c}}):=\pi^{\text{old}}({\bm{x}}_{0}|\mathbf{o}=1,{\bm{c}})=\frac{p(\mathbf{o}=1|{\bm{x}}_{0},{\bm{c}})\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}{p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})}=\frac{r({\bm{x}}_{0},{\bm{c}})}{p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})}\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mrow><mfrac><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{+}({\bm{x}}_{0}|{\bm{c}}):=\pi^{\text{old}}({\bm{x}}_{0}|\mathbf{o}=1,{\bm{c}})=\frac{p(\mathbf{o}=1|{\bm{x}}_{0},{\bm{c}})\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}{p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})}=\frac{r({\bm{x}}_{0},{\bm{c}})}{p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})}\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<table id="A1.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E8.m1" class="ltx_Math" alttext="\pi^{-}({\bm{x}}_{0}|{\bm{c}}):=\pi^{\text{old}}({\bm{x}}_{0}|\mathbf{o}=0,{\bm{c}})=\frac{p(\mathbf{o}=0|{\bm{x}}_{0},{\bm{c}})\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}{p_{\pi^{\text{old}}}(\mathbf{o}=0|{\bm{c}})}=\frac{1-r({\bm{x}}_{0},{\bm{c}})}{1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})}\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><mi>𝐨</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>0</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>0</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{-}({\bm{x}}_{0}|{\bm{c}}):=\pi^{\text{old}}({\bm{x}}_{0}|\mathbf{o}=0,{\bm{c}})=\frac{p(\mathbf{o}=0|{\bm{x}}_{0},{\bm{c}})\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}{p_{\pi^{\text{old}}}(\mathbf{o}=0|{\bm{c}})}=\frac{1-r({\bm{x}}_{0},{\bm{c}})}{1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})}\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem1.p1.2" class="ltx_p"><math id="A1.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})</annotation></semantics></math><span id="A1.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic"> is as a linear combination between its positive split <math id="A1.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\pi^{+}({\bm{x}}_{0}|{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐜</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{+}({\bm{x}}_{0}|{\bm{c}})</annotation></semantics></math> and negative split <math id="A1.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\pi^{-}({\bm{x}}_{0}|{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐜</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{-}({\bm{x}}_{0}|{\bm{c}})</annotation></semantics></math>:</span></p>
<table id="A1.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E9.m1" class="ltx_Math" alttext="\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\pi^{+}({\bm{x}}_{0}|{\bm{c}})+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\pi^{-}({\bm{x}}_{0}|{\bm{c}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\pi^{+}({\bm{x}}_{0}|{\bm{c}})+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\pi^{-}({\bm{x}}_{0}|{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p"><span id="A1.p1.1.1" class="ltx_text">The result follows directly from Eq.(<a href="#A1.E7" title="In Lemma A.1 (Distribution Split). ‣ Appendix A Proof of Theorems ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) and Eq.(<a href="#A1.E8" title="In Lemma A.1 (Distribution Split). ‣ Appendix A Proof of Theorems ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>).
∎</span></p>
</div>
</div>
<div id="A1.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma A.2</span></span><span id="A1.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(<span id="A1.Thmtheorem2.4" class="ltx_text ltx_font_bold">Posterior Split</span>)<span id="A1.Thmtheorem2.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem2.p1" class="ltx_para ltx_noindent">
<p id="A1.Thmtheorem2.p1.1" class="ltx_p"><span id="A1.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">The diffusion posteriors for distribution triplet <math id="A1.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\pi^{+}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>+</mo></msup><annotation encoding="application/x-tex">\pi^{+}</annotation></semantics></math>, <math id="A1.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\pi^{-}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>−</mo></msup><annotation encoding="application/x-tex">\pi^{-}</annotation></semantics></math>, and <math id="A1.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\pi^{\text{old}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><annotation encoding="application/x-tex">\pi^{\text{old}}</annotation></semantics></math> satisfy:</span></p>
<table id="A1.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex13.m1" class="ltx_Math" alttext="\pi^{\text{old}}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})=\alpha({\bm{x}}_{t})\pi^{+}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})+[1-\alpha({\bm{x}}_{t})]\pi^{-}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\text{old}}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})=\alpha({\bm{x}}_{t})\pi^{+}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})+[1-\alpha({\bm{x}}_{t})]\pi^{-}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A1.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\text{where}\quad\quad\alpha({\bm{x}}_{t}):=\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\mathbb{E}_{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}r({\bm{x}}_{0},{\bm{c}})" display="block" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">where</mtext><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext class="ltx_mathvariant_italic">old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{where}\quad\quad\alpha({\bm{x}}_{t}):=\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\mathbb{E}_{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}r({\bm{x}}_{0},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.p2" class="ltx_para ltx_noindent">
<p id="A1.p2.1" class="ltx_p"><span id="A1.p2.1.1" class="ltx_text">Leveraging Bayes’ Rule:</span></p>
<table id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})=\frac{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}{\pi({\bm{x}}_{t}|{\bm{x}}_{0})}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})=\frac{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}{\pi({\bm{x}}_{t}|{\bm{x}}_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p2.2" class="ltx_p"><span id="A1.p2.2.1" class="ltx_text">Replacing all distributions in Eq. (<a href="#A1.E9" title="In Lemma A.1 (Distribution Split). ‣ Appendix A Proof of Theorems ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) (Lemma <a href="#A1.Thmtheorem1" title="Lemma A.1 (Distribution Split). ‣ Appendix A Proof of Theorems ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>) we get</span></p>
<table id="A1.Ex16" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex16X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex16X.m2" class="ltx_Math" alttext="\displaystyle\frac{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}{\pi({\bm{x}}_{t}|{\bm{x}}_{0})}=" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}{\pi({\bm{x}}_{t}|{\bm{x}}_{0})}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16X.m3" class="ltx_Math" alttext="\displaystyle p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}{\pi({\bm{x}}_{t}|{\bm{x}}_{0})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}{\pi({\bm{x}}_{t}|{\bm{x}}_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex16Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16Xa.m2" class="ltx_Math" alttext="\displaystyle+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\frac{\pi^{-}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}{\pi({\bm{x}}_{t}|{\bm{x}}_{0})}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\frac{\pi^{-}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}{\pi({\bm{x}}_{t}|{\bm{x}}_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex16Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex16Xb.m2" class="ltx_Math" alttext="\displaystyle\Rightarrow\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})=" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⇒</mo><mrow><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Rightarrow\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16Xb.m3" class="ltx_Math" alttext="\displaystyle p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex16Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16Xc.m2" class="ltx_Math" alttext="\displaystyle+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\frac{\pi^{-}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\frac{\pi^{-}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p2.3" class="ltx_p"><span id="A1.p2.3.1" class="ltx_text">Diffuse both sides of Eq. (<a href="#A1.E9" title="In Lemma A.1 (Distribution Split). ‣ Appendix A Proof of Theorems ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), we have</span></p>
<table id="A1.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\pi^{-}_{t}({\bm{x}}_{t}|{\bm{c}})" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mi>t</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mi>t</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\pi^{-}_{t}({\bm{x}}_{t}|{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A1.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex18.m1" class="ltx_Math" alttext="p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\frac{\pi^{-}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}=1" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}+[1-p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})]\frac{\pi^{-}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p2.4" class="ltx_p"><span id="A1.p2.4.1" class="ltx_text">Note that</span></p>
<table id="A1.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex19.m1" class="ltx_Math" alttext="p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})=\mathbb{E}_{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}r({\bm{x}}_{0},{\bm{c}})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>π</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})=\mathbb{E}_{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}r({\bm{x}}_{0},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p2.5" class="ltx_p"><span id="A1.p2.5.1" class="ltx_text">We have</span></p>
<table id="A1.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex20.m1" class="ltx_Math" alttext="\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})=\alpha({\bm{x}}_{t})\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})+[1-\alpha({\bm{x}}_{t})]\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})=\alpha({\bm{x}}_{t})\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})+[1-\alpha({\bm{x}}_{t})]\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p2.6" class="ltx_p"><span id="A1.p2.6.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A1.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem A.3</span></span><span id="A1.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(<span id="A1.Thmtheorem3.4" class="ltx_text ltx_font_bold">Improvement Direction</span>)<span id="A1.Thmtheorem3.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem3.p1" class="ltx_para ltx_noindent">
<p id="A1.Thmtheorem3.p1.1" class="ltx_p"><span id="A1.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Consider diffusion models <math id="A1.Thmtheorem3.p1.m1" class="ltx_Math" alttext="{\bm{v}}^{+}" display="inline" intent=":literal"><semantics><msup><mi>𝐯</mi><mo>+</mo></msup><annotation encoding="application/x-tex">{\bm{v}}^{+}</annotation></semantics></math>, <math id="A1.Thmtheorem3.p1.m2" class="ltx_Math" alttext="{\bm{v}}^{-}" display="inline" intent=":literal"><semantics><msup><mi>𝐯</mi><mo>−</mo></msup><annotation encoding="application/x-tex">{\bm{v}}^{-}</annotation></semantics></math>, and <math id="A1.Thmtheorem3.p1.m3" class="ltx_Math" alttext="{\bm{v}}^{\text{old}}" display="inline" intent=":literal"><semantics><msup><mi>𝐯</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><annotation encoding="application/x-tex">{\bm{v}}^{\text{old}}</annotation></semantics></math> for the distribution triplet <math id="A1.Thmtheorem3.p1.m4" class="ltx_Math" alttext="\pi^{+}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>+</mo></msup><annotation encoding="application/x-tex">\pi^{+}</annotation></semantics></math>, <math id="A1.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\pi^{-}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>−</mo></msup><annotation encoding="application/x-tex">\pi^{-}</annotation></semantics></math>, and <math id="A1.Thmtheorem3.p1.m6" class="ltx_Math" alttext="\pi^{\text{old}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><annotation encoding="application/x-tex">\pi^{\text{old}}</annotation></semantics></math>. The directional differences between these models are parallel:</span></p>
<table id="A1.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex21.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\Delta:=" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\Delta:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex21.m2" class="ltx_Math" alttext="\displaystyle[1-\alpha({\bm{x}}_{t})]\;[{\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)]\quad\text{(Reinforcement Guidance)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>𝒗</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝒗</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">(Reinforcement Guidance)</mtext></mrow><annotation encoding="application/x-tex">\displaystyle[1-\alpha({\bm{x}}_{t})]\;[{\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)]\quad\text{(Reinforcement Guidance)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m2" class="ltx_Math" alttext="\displaystyle\quad\alpha({\bm{x}}_{t})\quad\;\;[{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mspace style="width:1.56em;" width="1.56em"></mspace><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>𝒗</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝒗</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\alpha({\bm{x}}_{t})\quad\;\;[{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.Thmtheorem3.p1.2" class="ltx_p"><span id="A1.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A1.Thmtheorem3.p1.m7" class="ltx_Math" alttext="0\leq\alpha({\bm{x}}_{t})\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0\leq\alpha({\bm{x}}_{t})\leq 1</annotation></semantics></math> is a scalar coefficient:</span></p>
<table id="A1.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex23.m1" class="ltx_Math" alttext="\alpha({\bm{x}}_{t}):=\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\mathbb{E}_{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}r({\bm{x}}_{0},{\bm{c}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext class="ltx_mathvariant_italic">old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha({\bm{x}}_{t}):=\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\mathbb{E}_{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})}r({\bm{x}}_{0},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.p3" class="ltx_para ltx_noindent">
<p id="A1.p3.1" class="ltx_p"><span id="A1.p3.1.1" class="ltx_text">According to the relationship between the optimal velocity predictor and the posterior mean of <math id="A1.p3.m1" class="ltx_Math" alttext="{\bm{x}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\bm{x}}_{0}</annotation></semantics></math> (i.e., the optimal <math id="A1.p3.m2" class="ltx_Math" alttext="{\bm{x}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\bm{x}}_{0}</annotation></semantics></math> predictor) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib55" title="" class="ltx_ref">Zheng et al., 2023b</a>)</cite>:</span></p>
<table id="A1.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex24.m1" class="ltx_Math" alttext="{\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)=a_{t}{\bm{x}}_{t}+b_{t}\mathbb{E}_{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{x}}_{0}]" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msub><mi>b</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msup><mi>π</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)=a_{t}{\bm{x}}_{t}+b_{t}\mathbb{E}_{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{x}}_{0}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A1.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex25.m1" class="ltx_Math" alttext="{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)=a_{t}{\bm{x}}_{t}+b_{t}\mathbb{E}_{\pi^{+}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{x}}_{0}]" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒗</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msub><mi>b</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msup><mi>π</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)=a_{t}{\bm{x}}_{t}+b_{t}\mathbb{E}_{\pi^{+}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{x}}_{0}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A1.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex26.m1" class="ltx_Math" alttext="{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)=a_{t}{\bm{x}}_{t}+b_{t}\mathbb{E}_{\pi^{=}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{x}}_{0}]" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒗</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msub><mi>b</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msup><mi>π</mi><mo>=</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)=a_{t}{\bm{x}}_{t}+b_{t}\mathbb{E}_{\pi^{=}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{x}}_{0}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p3.2" class="ltx_p"><span id="A1.p3.2.1" class="ltx_text">where <math id="A1.p3.m3" class="ltx_Math" alttext="a_{t}=\frac{\dot{\sigma}_{t}}{\sigma_{t}},b_{t}=\dot{\alpha}_{t}-\frac{\dot{\sigma}_{t}\alpha_{t}}{\sigma_{t}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>=</mo><mfrac><msub><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mi>t</mi></msub><msub><mi>σ</mi><mi>t</mi></msub></mfrac></mrow><mo>,</mo><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>α</mi><mo>˙</mo></mover><mi>t</mi></msub><mo>−</mo><mfrac><mrow><msub><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><msub><mi>σ</mi><mi>t</mi></msub></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{t}=\frac{\dot{\sigma}_{t}}{\sigma_{t}},b_{t}=\dot{\alpha}_{t}-\frac{\dot{\sigma}_{t}\alpha_{t}}{\sigma_{t}}</annotation></semantics></math>. Based on Lemma <a href="#A1.Thmtheorem2" title="Lemma A.2 (Posterior Split). ‣ Appendix A Proof of Theorems ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> we have</span></p>
<table id="A1.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex27.m1" class="ltx_Math" alttext="{\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)=\alpha({\bm{x}}_{t}){\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)+[1-\alpha({\bm{x}}_{t})]{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)=\alpha({\bm{x}}_{t}){\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)+[1-\alpha({\bm{x}}_{t})]{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p3.3" class="ltx_p"><span id="A1.p3.3.1" class="ltx_text">Rearranging the equation, we complete the proof.
∎</span></p>
</div>
</div>
<div id="A1.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem A.4</span></span><span id="A1.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(<span id="A1.Thmtheorem4.4" class="ltx_text ltx_font_bold">Reinforcement Guidance Optimization</span>)<span id="A1.Thmtheorem4.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem4.p1" class="ltx_para ltx_noindent">
<p id="A1.Thmtheorem4.p1.1" class="ltx_p"><span id="A1.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Consider the training objective:</span></p>
<table id="A1.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E10.m1" class="ltx_Math" alttext="\mathcal{L}(\theta)=\mathbb{E}_{{\bm{c}},\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}}),t}\;r\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}+(1-r)\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo>,</mo><mrow><msup><mi>π</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>𝒗</mi><mi>θ</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>𝒗</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>𝒗</mi><mi>θ</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>𝒗</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)=\mathbb{E}_{{\bm{c}},\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}}),t}\;r\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}+(1-r)\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<table id="A1.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex28.m1" class="ltx_Math" alttext="\quad\quad\text{where}\quad{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t):=(1-\beta){\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)+\beta{\bm{v}}_{\theta}({\bm{x}}_{t},{\bm{c}},t),\quad\text{(Implicit positive policy)}" display="block" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">where</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msubsup><mi>𝒗</mi><mi>θ</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mtext class="ltx_mathvariant_italic">(Implicit positive policy)</mtext></mrow><annotation encoding="application/x-tex">\quad\quad\text{where}\quad{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t):=(1-\beta){\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)+\beta{\bm{v}}_{\theta}({\bm{x}}_{t},{\bm{c}},t),\quad\text{(Implicit positive policy)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A1.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex29.m1" class="ltx_Math" alttext="\;\;\quad\quad\text{and}\;\;\quad{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t):=(1+\beta){\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)-\beta{\bm{v}}_{\theta}({\bm{x}}_{t},{\bm{c}},t).\quad\text{(Implicit negative policy)}" display="block" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_italic">and</mtext><mspace style="width:1.56em;" width="1.56em"></mspace><mrow><mrow><msubsup><mi>𝒗</mi><mi>θ</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo><mspace style="width:1.167em;" width="1.167em"></mspace><mtext class="ltx_mathvariant_italic">(Implicit negative policy)</mtext></mrow><annotation encoding="application/x-tex">\;\;\quad\quad\text{and}\;\;\quad{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t):=(1+\beta){\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)-\beta{\bm{v}}_{\theta}({\bm{x}}_{t},{\bm{c}},t).\quad\text{(Implicit negative policy)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.Thmtheorem4.p1.2" class="ltx_p"><span id="A1.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">Given unlimited data and model capacity, the optimal solution of Eq. (<a href="#A1.E10" title="In Theorem A.4 (Reinforcement Guidance Optimization). ‣ Appendix A Proof of Theorems ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) satisfies</span></p>
<table id="A1.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex30.m1" class="ltx_Math" alttext="{\bm{v}}_{\theta^{*}}({\bm{x}}_{t},{\bm{c}},t)={\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)+\frac{2}{\beta}\Delta({\bm{x}}_{t},{\bm{c}},t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝒗</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>𝒗</mi><mtext class="ltx_mathvariant_italic">old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{v}}_{\theta^{*}}({\bm{x}}_{t},{\bm{c}},t)={\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)+\frac{2}{\beta}\Delta({\bm{x}}_{t},{\bm{c}},t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.p4" class="ltx_para">
<table id="A1.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex31.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\theta)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex31.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}\;r({\bm{x}}_{0},{\bm{c}})\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}+[1-r({\bm{x}}_{0},{\bm{c}})]\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo>,</mo><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>𝒗</mi><mi>θ</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>𝒗</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>𝒗</mi><mi>θ</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>𝒗</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}\;r({\bm{x}}_{0},{\bm{c}})\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}+[1-r({\bm{x}}_{0},{\bm{c}})]\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex32.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\bm{c}}.t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\mathbb{E}_{\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}r({\bm{x}}_{0},{\bm{c}})\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi><mo>,</mo><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">{</mo><msub><mi>𝔼</mi><mrow><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>𝒗</mi><mi>θ</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝒗</mi><msubsup><mo lspace="0em">∥</mo><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{c}}.t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\mathbb{E}_{\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}r({\bm{x}}_{0},{\bm{c}})\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex33.m1" class="ltx_math_unparsed" alttext="\displaystyle+\mathbb{E}_{\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[1-r({\bm{x}}_{0},{\bm{c}})]\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>𝔼</mi><mrow><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>𝒗</mi><mi>θ</mi><mo>−</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝒗</mi><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}_{\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[1-r({\bm{x}}_{0},{\bm{c}})]\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p4.1" class="ltx_p"><span id="A1.p4.1.1" class="ltx_text">From Lemma <a href="#A1.Thmtheorem1" title="Lemma A.1 (Distribution Split). ‣ Appendix A Proof of Theorems ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a> we have <math id="A1.p4.m1" class="ltx_Math" alttext="r({\bm{x}}_{0},{\bm{c}})\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\pi^{+}({\bm{x}}_{0}|{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r({\bm{x}}_{0},{\bm{c}})\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\pi^{+}({\bm{x}}_{0}|{\bm{c}})</annotation></semantics></math>, therefore:</span></p>
<table id="A1.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex34.m1" class="ltx_Math" alttext="\displaystyle r({\bm{x}}_{0},{\bm{c}})\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle r({\bm{x}}_{0},{\bm{c}})\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex34.m2" class="ltx_Math" alttext="\displaystyle=r({\bm{x}}_{0},{\bm{c}})\frac{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})\pi({\bm{x}}_{t}|{\bm{x}}_{0})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>π</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=r({\bm{x}}_{0},{\bm{c}})\frac{\pi^{\text{old}}({\bm{x}}_{0}|{\bm{c}})\pi({\bm{x}}_{t}|{\bm{x}}_{0})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex35.m1" class="ltx_Math" alttext="\displaystyle=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\frac{\pi^{+}({\bm{x}}_{0}|{\bm{c}})\pi({\bm{x}}_{t}|{\bm{x}}_{0})}{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>π</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\frac{\pi^{+}({\bm{x}}_{0}|{\bm{c}})\pi({\bm{x}}_{t}|{\bm{x}}_{0})}{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex36.m1" class="ltx_Math" alttext="\displaystyle=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>p</mi><msup><mi>π</mi><mtext>old</mtext></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐨</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>t</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=p_{\pi^{\text{old}}}(\mathbf{o}=1|{\bm{c}})\frac{\pi^{+}_{t}({\bm{x}}_{t}|{\bm{c}})}{\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex37.m1" class="ltx_Math" alttext="\displaystyle=\alpha({\bm{x}}_{t})\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha({\bm{x}}_{t})\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p4.2" class="ltx_p"><span id="A1.p4.2.1" class="ltx_text">Similarly,</span></p>
<table id="A1.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex39.m1" class="ltx_Math" alttext="\displaystyle[1-r({\bm{x}}_{0},{\bm{c}})]\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})=[1-\alpha({\bm{x}}_{t})]\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle[1-r({\bm{x}}_{0},{\bm{c}})]\pi^{\text{old}}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})=[1-\alpha({\bm{x}}_{t})]\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p4.3" class="ltx_p"><span id="A1.p4.3.1" class="ltx_text">Then,</span></p>
<table id="A1.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex41.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\theta)=" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\theta)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex41.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\mathbb{E}_{\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo>,</mo><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">{</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msub><mi>𝔼</mi><mrow><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>𝒗</mi><mi>θ</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝒗</mi><msubsup><mo lspace="0em">∥</mo><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\mathbb{E}_{\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex42.m1" class="ltx_math_unparsed" alttext="\displaystyle+[1-\alpha({\bm{x}}_{t})]\mathbb{E}_{\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>−</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><msub><mi>𝔼</mi><mrow><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>𝒗</mi><mi>θ</mi><mo>−</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝒗</mi><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle+[1-\alpha({\bm{x}}_{t})]\mathbb{E}_{\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}\|_{2}^{2}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex43.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex43.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-\mathbb{E}_{\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{v}}]\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo>,</mo><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">{</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>𝒗</mi><mi>θ</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><mrow><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo stretchy="false">[</mo><mi>𝒗</mi><mo stretchy="false">]</mo></mrow><msubsup><mo lspace="0em">∥</mo><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-\mathbb{E}_{\pi^{+}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{v}}]\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
