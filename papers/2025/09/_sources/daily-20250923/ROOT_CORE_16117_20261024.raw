<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex45.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex45.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo>,</mo><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">{</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>𝒗</mi><mi>θ</mi><mo>+</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝒗</mi><mo>+</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em">∥</mo><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\|{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex46.m1" class="ltx_math_unparsed" alttext="\displaystyle+[1-\alpha({\bm{x}}_{t})]\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)\|_{2}^{2}\}+C_{1}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>−</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>𝒗</mi><mi>θ</mi><mo>−</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>𝒗</mi><mo>−</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo><mo>+</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle+[1-\alpha({\bm{x}}_{t})]\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)\|_{2}^{2}\}+C_{1}</annotation></semantics></math></td>
