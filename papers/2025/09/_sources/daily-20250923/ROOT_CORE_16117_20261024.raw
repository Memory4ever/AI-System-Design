<p id="A1.p4.4" class="ltx_p"><span id="A1.p4.4.1" class="ltx_text">Combining Theorem <a href="#A1.Thmtheorem3" title="Theorem A.3 (Improvement Direction). ‣ Appendix A Proof of Theorems ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>, we observe that</span></p>
<table id="A1.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex47.m1" class="ltx_Math" alttext="\displaystyle{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒗</mi><mi>θ</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝒗</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{v}}_{\theta}^{+}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex47.m2" class="ltx_Math" alttext="\displaystyle=(1-\beta){\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)+\beta{\bm{v}}_{\theta}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msup><mi>𝒗</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(1-\beta){\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)+\beta{\bm{v}}_{\theta}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{+}({\bm{x}}_{t},{\bm{c}},t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex48.m1" class="ltx_Math" alttext="\displaystyle=\beta[{\bm{v}}_{\theta}-{\bm{v}}^{\text{old}}-\frac{1}{\beta}\frac{\Delta}{\alpha({\bm{x}}_{t})}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒗</mi><mi>θ</mi></msub><mo>−</mo><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\beta[{\bm{v}}_{\theta}-{\bm{v}}^{\text{old}}-\frac{1}{\beta}\frac{\Delta}{\alpha({\bm{x}}_{t})}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex49.m1" class="ltx_Math" alttext="\displaystyle{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒗</mi><mi>θ</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝒗</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex49.m2" class="ltx_Math" alttext="\displaystyle=(1+\beta){\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)-\beta{\bm{v}}_{\theta}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝒗</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(1+\beta){\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)-\beta{\bm{v}}_{\theta}({\bm{x}}_{t},{\bm{c}},t)-{\bm{v}}^{-}({\bm{x}}_{t},{\bm{c}},t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex50.m1" class="ltx_Math" alttext="\displaystyle=-\beta[{\bm{v}}_{\theta}-{\bm{v}}^{\text{old}}-\frac{1}{\beta}\frac{\Delta}{1-\alpha({\bm{x}}_{t})}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒗</mi><mi>θ</mi></msub><mo>−</mo><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\beta[{\bm{v}}_{\theta}-{\bm{v}}^{\text{old}}-\frac{1}{\beta}\frac{\Delta}{1-\alpha({\bm{x}}_{t})}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p4.5" class="ltx_p"><span id="A1.p4.5.1" class="ltx_text">Substituting these results into <math id="A1.p4.m2" class="ltx_Math" alttext="\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)</annotation></semantics></math>:</span></p>
<table id="A1.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex51.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\theta)=" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\theta)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex51.m2" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\beta^{2}\|{\bm{v}}_{\theta}-{\bm{v}}^{\text{old}}-\frac{1}{\beta}\frac{\Delta}{\alpha({\bm{x}}_{t})}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo>,</mo><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">{</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo>−</mo><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><msubsup><mo lspace="0em">∥</mo><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\beta^{2}\|{\bm{v}}_{\theta}-{\bm{v}}^{\text{old}}-\frac{1}{\beta}\frac{\Delta}{\alpha({\bm{x}}_{t})}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex52.m1" class="ltx_math_unparsed" alttext="\displaystyle+[1-\alpha({\bm{x}}_{t})]\beta^{2}\|{\bm{v}}_{\theta}-{\bm{v}}^{\text{old}}-\frac{1}{\beta}\frac{\Delta}{1-\alpha({\bm{x}}_{t})}\|_{2}^{2}\}+C_{1}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>−</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo>−</mo><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo><mo>+</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle+[1-\alpha({\bm{x}}_{t})]\beta^{2}\|{\bm{v}}_{\theta}-{\bm{v}}^{\text{old}}-\frac{1}{\beta}\frac{\Delta}{1-\alpha({\bm{x}}_{t})}\|_{2}^{2}\}+C_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex53.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex53.m2" class="ltx_math_unparsed" alttext="\displaystyle\beta^{2}\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\|{\bm{v}}_{\theta}-({\bm{v}}^{\text{old}}+\frac{1}{\beta}\frac{\Delta}{\alpha({\bm{x}}_{t})})\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>β</mi><mn>2</mn></msup><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo>,</mo><mrow><msubsup><mi>π</mi><mi>t</mi><mtext>old</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">{</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo>−</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em">∥</mo><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{2}\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}_{t}({\bm{x}}_{t}|{\bm{c}})}\{\alpha({\bm{x}}_{t})\|{\bm{v}}_{\theta}-({\bm{v}}^{\text{old}}+\frac{1}{\beta}\frac{\Delta}{\alpha({\bm{x}}_{t})})\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex54.m1" class="ltx_math_unparsed" alttext="\displaystyle+[1-\alpha({\bm{x}}_{t})]\|{\bm{v}}_{\theta}-({\bm{v}}^{\text{old}}+\frac{1}{\beta}\frac{\Delta}{1-\alpha({\bm{x}}_{t})})\|_{2}^{2}\}+C_{1}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>−</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo>−</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo><mo>+</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle+[1-\alpha({\bm{x}}_{t})]\|{\bm{v}}_{\theta}-({\bm{v}}^{\text{old}}+\frac{1}{\beta}\frac{\Delta}{1-\alpha({\bm{x}}_{t})})\|_{2}^{2}\}+C_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex55.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex55.m2" class="ltx_Math" alttext="\displaystyle\beta^{2}\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}({\bm{x}}_{t}|{\bm{c}})}\|{\bm{v}}_{\theta}-\alpha({\bm{x}}_{t})({\bm{v}}^{\text{old}}+\frac{1}{\beta}\frac{\Delta}{\alpha({\bm{x}}_{t})})-[1-\alpha({\bm{x}}_{t})]({\bm{v}}^{\text{old}}+\frac{1}{\beta}\frac{\Delta}{1-\alpha({\bm{x}}_{t})})\|_{2}^{2}+C_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo>,</mo><mrow><msup><mi>π</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝒗</mi><mi>θ</mi></msub><mo>−</mo><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{2}\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}({\bm{x}}_{t}|{\bm{c}})}\|{\bm{v}}_{\theta}-\alpha({\bm{x}}_{t})({\bm{v}}^{\text{old}}+\frac{1}{\beta}\frac{\Delta}{\alpha({\bm{x}}_{t})})-[1-\alpha({\bm{x}}_{t})]({\bm{v}}^{\text{old}}+\frac{1}{\beta}\frac{\Delta}{1-\alpha({\bm{x}}_{t})})\|_{2}^{2}+C_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex56.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex56.m2" class="ltx_Math" alttext="\displaystyle\beta^{2}\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}({\bm{x}}_{t}|{\bm{c}})}\|{\bm{v}}_{\theta}-({\bm{v}}^{\text{old}}+\frac{2}{\beta}\Delta)\|_{2}^{2}+C_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo>,</mo><mrow><msup><mi>π</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝒗</mi><mi>θ</mi></msub><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\beta^{2}\mathbb{E}_{{\bm{c}},t,\pi^{\text{old}}({\bm{x}}_{t}|{\bm{c}})}\|{\bm{v}}_{\theta}-({\bm{v}}^{\text{old}}+\frac{2}{\beta}\Delta)\|_{2}^{2}+C_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p4.6" class="ltx_p"><span id="A1.p4.6.1" class="ltx_text">from which it is obvious that the optimal <math id="A1.p4.m3" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> satisfies <math id="A1.p4.m4" class="ltx_Math" alttext="{\bm{v}}_{\theta^{*}}({\bm{x}}_{t},{\bm{c}},t)={\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)+\frac{2}{\beta}\Delta({\bm{x}}_{t},{\bm{c}},t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>𝒗</mi><mtext>old</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>2</mn><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}_{\theta^{*}}({\bm{x}}_{t},{\bm{c}},t)={\bm{v}}^{\text{old}}({\bm{x}}_{t},{\bm{c}},t)+\frac{2}{\beta}\Delta({\bm{x}}_{t},{\bm{c}},t)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Theoretical Discussions</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Flow SDE</h3>

<div id="A2.SS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.p1.1" class="ltx_p">As flow models are a special case of diffusion models under the rectified schedule <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="\alpha_{t}=1-t,\sigma_{t}=t" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mrow><mo>,</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}=1-t,\sigma_{t}=t</annotation></semantics></math>, the earliest results on diffusion SDEs <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib43" title="" class="ltx_ref">Song et al., 2020b</a>)</cite> can be directly applied without difficulty. FlowGRPO <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib30" title="" class="ltx_ref">Liu et al., 2025</a>)</cite> and DanceGRPO <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib50" title="" class="ltx_ref">Xue et al., 2025</a>)</cite> derive the flow SDE with unexplained hyperparameters <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="g_{t}=a\sqrt{\tfrac{t}{1-t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></msqrt></mrow></mrow><annotation encoding="application/x-tex">g_{t}=a\sqrt{\tfrac{t}{1-t}}</annotation></semantics></math> or additional complexity. We provide a simpler and more principled perspective based solely on the diffusion model framework.</p>
</div>
<div id="A2.SS1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS1.p2.1" class="ltx_p">To leverage the diffusion SDE formulation in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib43" title="" class="ltx_ref">Song et al. (2020b)</a></cite>, we need to match its forward SDE
<math id="A2.SS1.p2.m1" class="ltx_Math" alttext="\mathrm{d}{\bm{x}}_{t}=f(t){\bm{x}}_{t}\mathrm{d}t+g(t)\mathrm{d}{\bm{w}}_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒘</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{d}{\bm{x}}_{t}=f(t){\bm{x}}_{t}\mathrm{d}t+g(t)\mathrm{d}{\bm{w}}_{t}</annotation></semantics></math> with the forward transition kernel <math id="A2.SS1.p2.m2" class="ltx_Math" alttext="{\bm{x}}_{t}=\alpha_{t}{\bm{x}}_{0}+\sigma_{t}\bm{\epsilon}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{t}=\alpha_{t}{\bm{x}}_{0}+\sigma_{t}\bm{\epsilon}</annotation></semantics></math>. As noted in the first two versions of VDM <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib21" title="" class="ltx_ref">Kingma et al., 2021</a>)</cite>, <math id="A2.SS1.p2.m3" class="ltx_Math" alttext="f(t),g(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(t),g(t)</annotation></semantics></math> are related to <math id="A2.SS1.p2.m4" class="ltx_Math" alttext="\alpha_{t},\sigma_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msub><mi>σ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{t},\sigma_{t}</annotation></semantics></math> by <math id="A2.SS1.p2.m5" class="ltx_Math" alttext="f(t)=\frac{\mathrm{d}\log\alpha_{t}}{\mathrm{d}t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">f(t)=\frac{\mathrm{d}\log\alpha_{t}}{\mathrm{d}t}</annotation></semantics></math>, <math id="A2.SS1.p2.m6" class="ltx_Math" alttext="g^{2}(t)=\frac{\mathrm{d}\sigma_{t}^{2}}{\mathrm{d}t}-2\frac{\mathrm{d}\log\alpha_{t}}{\mathrm{d}t}\sigma_{t}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>g</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{2}(t)=\frac{\mathrm{d}\sigma_{t}^{2}}{\mathrm{d}t}-2\frac{\mathrm{d}\log\alpha_{t}}{\mathrm{d}t}\sigma_{t}^{2}</annotation></semantics></math>. Setting <math id="A2.SS1.p2.m7" class="ltx_Math" alttext="\alpha_{t}=1-t,\sigma_{t}=t" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mrow><mo>,</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}=1-t,\sigma_{t}=t</annotation></semantics></math>, we have</p>
<table id="A2.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E11.m1" class="ltx_Math" alttext="f(t)=-\frac{1}{1-t},\quad g^{2}(t)=\frac{2t}{1-t}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msup><mi>g</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">f(t)=-\frac{1}{1-t},\quad g^{2}(t)=\frac{2t}{1-t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p2.2" class="ltx_p">for rectified flow. According to <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib18" title="" class="ltx_ref">Huang et al., 2021</a>)</cite>, the generalized reverse SDE takes the form:</p>
</div>
<div id="A2.SS1.p3" class="ltx_para ltx_noindent">
<table id="A2.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E12.m1" class="ltx_Math" alttext="\mathrm{d}{\bm{x}}_{t}=\left[f(t){\bm{x}}_{t}-\frac{1+\lambda_{t}^{2}}{2}g^{2}(t)\nabla_{{\bm{x}}_{t}}\log\pi_{t}({\bm{x}}_{t})\right]\mathrm{d}t+\lambda_{t}g(t)\mathrm{d}\bar{{\bm{w}}}_{t}" display="block" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mrow><mo>[</mo><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><msubsup><mi>λ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝒘</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{d}{\bm{x}}_{t}=\left[f(t){\bm{x}}_{t}-\frac{1+\lambda_{t}^{2}}{2}g^{2}(t)\nabla_{{\bm{x}}_{t}}\log\pi_{t}({\bm{x}}_{t})\right]\mathrm{d}t+\lambda_{t}g(t)\mathrm{d}\bar{{\bm{w}}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p3.1" class="ltx_p">where <math id="A2.SS1.p3.m1" class="ltx_Math" alttext="\lambda_{t}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda_{t}\in[0,1]</annotation></semantics></math>. Equivalently, it amounts to introducing Langevin dynamics on top of the diffusion ODE, with <math id="A2.SS1.p3.m2" class="ltx_Math" alttext="\lambda_{t}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{t}=0</annotation></semantics></math> corresponding to ODE, and <math id="A2.SS1.p3.m3" class="ltx_Math" alttext="\lambda_{t}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda_{t}=1</annotation></semantics></math> corresponding to the maximum variance SDE in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib43" title="" class="ltx_ref">Song et al. (2020b)</a></cite>. The score function <math id="A2.SS1.p3.m4" class="ltx_Math" alttext="{\bm{s}}_{\theta}({\bm{x}}_{t},t)\approx\nabla_{{\bm{x}}_{t}}\log\pi_{t}({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒔</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><msub><mo>∇</mo><msub><mi>𝒙</mi><mi>t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{s}}_{\theta}({\bm{x}}_{t},t)\approx\nabla_{{\bm{x}}_{t}}\log\pi_{t}({\bm{x}}_{t})</annotation></semantics></math>, noise predictor <math id="A2.SS1.p3.m5" class="ltx_Math" alttext="\bm{\epsilon}_{\theta}({\bm{x}}_{t},t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\epsilon}_{\theta}({\bm{x}}_{t},t)</annotation></semantics></math>, data predictor <math id="A2.SS1.p3.m6" class="ltx_Math" alttext="{\bm{x}}_{\theta}({\bm{x}}_{t},t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{\theta}({\bm{x}}_{t},t)</annotation></semantics></math> and velocity predictor <math id="A2.SS1.p3.m7" class="ltx_Math" alttext="{\bm{v}}_{\theta}({\bm{x}}_{t},t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}_{\theta}({\bm{x}}_{t},t)</annotation></semantics></math> are interconvertible <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib55" title="" class="ltx_ref">Zheng et al., 2023b</a>)</cite>:</p>
<table id="A2.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E13.m1" class="ltx_Math" alttext="\bm{\epsilon}_{\theta}({\bm{x}}_{t},t)=-\sigma_{t}{\bm{s}}_{\theta}({\bm{x}}_{t},t),\quad{\bm{x}}_{\theta}({\bm{x}}_{t},t)=\frac{{\bm{x}}_{t}-\sigma_{t}\bm{\epsilon}_{\theta}({\bm{x}}_{t},t)}{\alpha_{t}},\quad{\bm{v}}_{\theta}({\bm{x}}_{t},t)=\dot{\alpha}_{t}{\bm{x}}_{\theta}({\bm{x}}_{t},t)+\dot{\sigma}_{t}\bm{\epsilon}_{\theta}({\bm{x}}_{t},t)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒔</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>𝒙</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><msub><mi>α</mi><mi>t</mi></msub></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>˙</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>σ</mi><mo>˙</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\epsilon}_{\theta}({\bm{x}}_{t},t)=-\sigma_{t}{\bm{s}}_{\theta}({\bm{x}}_{t},t),\quad{\bm{x}}_{\theta}({\bm{x}}_{t},t)=\frac{{\bm{x}}_{t}-\sigma_{t}\bm{\epsilon}_{\theta}({\bm{x}}_{t},t)}{\alpha_{t}},\quad{\bm{v}}_{\theta}({\bm{x}}_{t},t)=\dot{\alpha}_{t}{\bm{x}}_{\theta}({\bm{x}}_{t},t)+\dot{\sigma}_{t}\bm{\epsilon}_{\theta}({\bm{x}}_{t},t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p3.2" class="ltx_p">Applying these relations to the rectified flow schedule, we can derive:</p>
<table id="A2.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E14.m1" class="ltx_Math" alttext="{\bm{s}}_{\theta}({\bm{x}}_{t},t)=-\frac{{\bm{x}}_{t}+(1-t){\bm{v}}_{\theta}({\bm{x}}_{t},t)}{t}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒔</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>t</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">{\bm{s}}_{\theta}({\bm{x}}_{t},t)=-\frac{{\bm{x}}_{t}+(1-t){\bm{v}}_{\theta}({\bm{x}}_{t},t)}{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p3.3" class="ltx_p">Substituting Eq. (<a href="#A2.E11" title="In B.1 Flow SDE ‣ Appendix B Theoretical Discussions ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) and Eq. (<a href="#A2.E14" title="In B.1 Flow SDE ‣ Appendix B Theoretical Discussions ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) into Eq. (<a href="#A2.E12" title="In B.1 Flow SDE ‣ Appendix B Theoretical Discussions ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>), we have the diffusion SDE under rectified flow:</p>
<table id="A2.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E15.m1" class="ltx_Math" alttext="\mathrm{d}{\bm{x}}_{t}=\left[(1+\lambda_{t}^{2}){\bm{v}}_{\theta}({\bm{x}}_{t},t)+\frac{\lambda_{t}^{2}}{1-t}{\bm{x}}_{t}\right]\mathrm{d}t+\lambda_{t}\sqrt{\frac{2t}{1-t}}\mathrm{d}{\bm{w}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msubsup><mi>λ</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><msubsup><mi>λ</mi><mi>t</mi><mn>2</mn></msubsup><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒘</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{d}{\bm{x}}_{t}=\left[(1+\lambda_{t}^{2}){\bm{v}}_{\theta}({\bm{x}}_{t},t)+\frac{\lambda_{t}^{2}}{1-t}{\bm{x}}_{t}\right]\mathrm{d}t+\lambda_{t}\sqrt{\frac{2t}{1-t}}\mathrm{d}{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p3.4" class="ltx_p">Therefore, the flow SDE in Eq. (<a href="#S2.E2" title="In 2.2 Policy Gradient Algorithms for Diffusion Models ‣ 2 Background ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) is essentially conducting a transformation <math id="A2.SS1.p3.m8" class="ltx_Math" alttext="g_{t}=\lambda_{t}\sqrt{\frac{2t}{1-t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></msqrt></mrow></mrow><annotation encoding="application/x-tex">g_{t}=\lambda_{t}\sqrt{\frac{2t}{1-t}}</annotation></semantics></math> from the interpolation parameter <math id="A2.SS1.p3.m9" class="ltx_Math" alttext="\lambda_{t}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda_{t}\in[0,1]</annotation></semantics></math> to the variance parameter <math id="A2.SS1.p3.m10" class="ltx_Math" alttext="g_{t}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>t</mi></msub><annotation encoding="application/x-tex">g_{t}</annotation></semantics></math>. This also explains the choice <math id="A2.SS1.p3.m11" class="ltx_Math" alttext="g_{t}=a\sqrt{\tfrac{t}{1-t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mi>t</mi><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></msqrt></mrow></mrow><annotation encoding="application/x-tex">g_{t}=a\sqrt{\tfrac{t}{1-t}}</annotation></semantics></math> in FlowGRPO, where <math id="A2.SS1.p3.m12" class="ltx_Math" alttext="a=\sqrt{2}\lambda_{t}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">a=\sqrt{2}\lambda_{t}</annotation></semantics></math> is a scaled version of <math id="A2.SS1.p3.m13" class="ltx_Math" alttext="\lambda_{t}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\lambda_{t}</annotation></semantics></math>, with <math id="A2.SS1.p3.m14" class="ltx_Math" alttext="a=\sqrt{2}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><msqrt><mn>2</mn></msqrt></mrow><annotation encoding="application/x-tex">a=\sqrt{2}</annotation></semantics></math> corresponding to the maximum variance SDE. In comparison, DanceGRPO adopts a fixed variance <math id="A2.SS1.p3.m15" class="ltx_Math" alttext="g_{t}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>t</mi></msub><annotation encoding="application/x-tex">g_{t}</annotation></semantics></math> across timesteps, which is less effective on image models while more stable on video models.</p>
</div>
<div id="A2.SS1.p4" class="ltx_para ltx_noindent">
<p id="A2.SS1.p4.1" class="ltx_p">FlowGRPO and DanceGRPO directly take the Euler discretization of the flow SDE. In principle, there are more accurate ways, such as utilizing the idea of diffusion implicit models <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib42" title="" class="ltx_ref">Song et al., 2020a</a>; <a href="#bib.bib56" title="" class="ltx_ref">Zheng et al., 2024</a>)</cite>, which is equivalent to the first-order discretization after applying exponential integrators <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib17" title="" class="ltx_ref">Hochbruck &amp; Ostermann, 2010</a>; <a href="#bib.bib53" title="" class="ltx_ref">Zhang &amp; Chen, 2022</a>; <a href="#bib.bib12" title="" class="ltx_ref">Gonzalez et al., 2023</a>)</cite>. Specifically, the sampling step from <math id="A2.SS1.p4.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> to <math id="A2.SS1.p4.m2" class="ltx_Math" alttext="s&lt;t" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>&lt;</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">s&lt;t</annotation></semantics></math> can be derived as:</p>
<table id="A2.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E16.m1" class="ltx_Math" alttext="{\bm{x}}_{s}=\left[(1-s)+\sqrt{s^{2}-\rho_{t}^{2}}\right]{\bm{x}}_{t}-\left[(1-s)t-\sqrt{s^{2}-\rho_{t}^{2}}(1-t)\right]{\bm{v}}_{\theta}({\bm{x}}_{t},t)+\rho_{t}\bm{\epsilon},\quad\bm{\epsilon}\sim{\mathcal{N}}(\bm{0},{\mathbf{I}})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒙</mi><mi>s</mi></msub><mo>=</mo><mrow><mrow><mrow><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><msqrt><mrow><msup><mi>s</mi><mn>2</mn></msup><mo>−</mo><msubsup><mi>ρ</mi><mi>t</mi><mn>2</mn></msubsup></mrow></msqrt></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>−</mo><mrow><msqrt><mrow><msup><mi>s</mi><mn>2</mn></msup><mo>−</mo><msubsup><mi>ρ</mi><mi>t</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{s}=\left[(1-s)+\sqrt{s^{2}-\rho_{t}^{2}}\right]{\bm{x}}_{t}-\left[(1-s)t-\sqrt{s^{2}-\rho_{t}^{2}}(1-t)\right]{\bm{v}}_{\theta}({\bm{x}}_{t},t)+\rho_{t}\bm{\epsilon},\quad\bm{\epsilon}\sim{\mathcal{N}}(\bm{0},{\mathbf{I}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p4.2" class="ltx_p">where <math id="A2.SS1.p4.m3" class="ltx_Math" alttext="\rho_{t}=\eta_{t}s\sqrt{1-\frac{s^{2}(1-t)^{2}}{t^{2}(1-s)^{2}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\rho_{t}=\eta_{t}s\sqrt{1-\frac{s^{2}(1-t)^{2}}{t^{2}(1-s)^{2}}}</annotation></semantics></math>, and <math id="A2.SS1.p4.m4" class="ltx_Math" alttext="\eta_{t}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\eta_{t}\in[0,1]</annotation></semantics></math> interpolates between ODE and maximum variance SDE. Compared to the Euler discretization, the DDIM-style discretization avoids singularities at boundaries and is expected to reduce sampling errors. However, as the training loss of FlowGRPO couples with the sampler, and RL requires not only accurate reward signals but also large exploration space, we did not observe notable advantages by replacing the SDE sampler with DDIM.</p>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>High-Order Flow ODE Sampler</h3>

<div id="A2.SS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.p1.1" class="ltx_p">We implement the 2nd-order ODE sampler for flow models based on the DPM-Solver series <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">Lu et al., 2022a</a>; <a href="#bib.bib33" title="" class="ltx_ref">Lu et al., 2022b</a>; <a href="#bib.bib54" title="" class="ltx_ref">Zheng et al., 2023a</a>)</cite>, which uses the multistep method and half the log signal-to-noise ratio (SNR) <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="\lambda_{t}=\log(\alpha_{t}/\sigma_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>/</mo><msub><mi>σ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{t}=\log(\alpha_{t}/\sigma_{t})</annotation></semantics></math> for time discretization. Specifically, for three consecutive timesteps <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="t_{i}&lt;t_{i-1}&lt;t_{i-2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>i</mi></msub><mo>&lt;</mo><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>&lt;</mo><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">t_{i}&lt;t_{i-1}&lt;t_{i-2}</annotation></semantics></math>, where <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="{\bm{x}}_{t_{i-1}},{\bm{x}}_{t_{i-2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo>,</mo><msub><mi>𝒙</mi><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub></msub></mrow><annotation encoding="application/x-tex">{\bm{x}}_{t_{i-1}},{\bm{x}}_{t_{i-2}}</annotation></semantics></math> are already obtained, the update rule for <math id="A2.SS2.p1.m4" class="ltx_Math" alttext="{\bm{x}}_{t_{i}}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><msub><mi>t</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">{\bm{x}}_{t_{i}}</annotation></semantics></math> is:</p>
<table id="A2.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E17.m1" class="ltx_Math" alttext="{\bm{x}}_{t_{i}}=\frac{\sigma_{t_{i}}}{\sigma_{t_{i-1}}}{\bm{x}}_{t_{i-1}}-\alpha_{t_{i}}(e^{-h_{i}}-1)\left[\left(1+\frac{1}{2r_{i}}\right){\bm{x}}_{\theta}({\bm{x}}_{t_{i-1}},t_{i-1})-\frac{1}{2r_{i}}{\bm{x}}_{\theta}({\bm{x}}_{t_{i-2}},t_{i-2})\right]" display="block" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo>=</mo><mrow><mrow><mfrac><msub><mi>σ</mi><msub><mi>t</mi><mi>i</mi></msub></msub><msub><mi>σ</mi><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></mrow><mo>−</mo><mrow><msub><mi>α</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><msub><mi>h</mi><mi>i</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{t_{i}}=\frac{\sigma_{t_{i}}}{\sigma_{t_{i-1}}}{\bm{x}}_{t_{i-1}}-\alpha_{t_{i}}(e^{-h_{i}}-1)\left[\left(1+\frac{1}{2r_{i}}\right){\bm{x}}_{\theta}({\bm{x}}_{t_{i-1}},t_{i-1})-\frac{1}{2r_{i}}{\bm{x}}_{\theta}({\bm{x}}_{t_{i-2}},t_{i-2})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p">where <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="h_{i}=\lambda_{t_{i}}-\lambda_{t_{i-1}},r_{i}=\frac{h_{i-1}}{h_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>λ</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo>−</mo><msub><mi>λ</mi><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></mrow></mrow><mo>,</mo><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>=</mo><mfrac><msub><mi>h</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><msub><mi>h</mi><mi>i</mi></msub></mfrac></mrow></mrow><annotation encoding="application/x-tex">h_{i}=\lambda_{t_{i}}-\lambda_{t_{i-1}},r_{i}=\frac{h_{i-1}}{h_{i}}</annotation></semantics></math>, and the data predictor <math id="A2.SS2.p1.m6" class="ltx_Math" alttext="{\bm{x}}_{\theta}={\bm{x}}_{t}-t{\bm{v}}_{\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mi>θ</mi></msub><mo>=</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{\theta}={\bm{x}}_{t}-t{\bm{v}}_{\theta}</annotation></semantics></math> for rectified flow. High-order solvers are also adopted in MixGRPO <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib27" title="" class="ltx_ref">Li et al., 2025b</a>)</cite> but only for certain steps. Adopting the 2nd-order solver throughout the entire sampling process is infeasible, as <math id="A2.SS2.p1.m7" class="ltx_Math" alttext="\lambda_{t}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\lambda_{t}</annotation></semantics></math> will be infinity at boundaries <math id="A2.SS2.p1.m8" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math> or <math id="A2.SS2.p1.m9" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>. Following common practices, the first and last steps degrade to the first-order solver, which is the default Euler discretization for flow models.</p>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Intuition behind the FlowGRPO Objective</h3>

<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p">We provide some insight into reverse-process diffusion RL by inspecting the FlowGRPO objective in a sampler-agnostic manner. For any first-order SDE sampler, the reverse sampling step from <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> to <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="s&lt;t" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>&lt;</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">s&lt;t</annotation></semantics></math> can be expressed as</p>
<table id="A2.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E18.m1" class="ltx_Math" alttext="{\bm{x}}_{s}=l(s,t){\bm{x}}_{t}-m(s,t){\bm{v}}_{\theta}({\bm{x}}_{t},t)+n(s,t)\bm{\epsilon},\quad\bm{\epsilon}\sim\mathcal{N}(\bf 0,\mathbf{I})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒙</mi><mi>s</mi></msub><mo>=</mo><mrow><mrow><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{s}=l(s,t){\bm{x}}_{t}-m(s,t){\bm{v}}_{\theta}({\bm{x}}_{t},t)+n(s,t)\bm{\epsilon},\quad\bm{\epsilon}\sim\mathcal{N}(\bf 0,\mathbf{I})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p1.2" class="ltx_p">where <math id="A2.SS3.p1.m3" class="ltx_Math" alttext="l(s,t),m(s,t),n(s,t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l(s,t),m(s,t),n(s,t)</annotation></semantics></math> depend only on <math id="A2.SS3.p1.m4" class="ltx_Math" alttext="s,t" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">s,t</annotation></semantics></math> and the sampler. Consider the on-policy case and the branching strategy in MixGRPO. Starting from a shared <math id="A2.SS3.p1.m5" class="ltx_Math" alttext="{\bm{x}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\bm{x}}_{t}</annotation></semantics></math>, a group of <math id="A2.SS3.p1.m6" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> noises <math id="A2.SS3.p1.m7" class="ltx_Math" alttext="\bm{\epsilon}^{(1)},\dots,\bm{\epsilon}^{(N)}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{\epsilon}^{(1)},\dots,\bm{\epsilon}^{(N)}</annotation></semantics></math> are sampled and incorporated into the reverse step to produce multiple samples <math id="A2.SS3.p1.m8" class="ltx_Math" alttext="{\bm{x}}_{s}^{(1)},\dots,{\bm{x}}_{s}^{(N)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒙</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝒙</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\bm{x}}_{s}^{(1)},\dots,{\bm{x}}_{s}^{(N)}</annotation></semantics></math>. They go through further sampling, yielding <math id="A2.SS3.p1.m9" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> clean samples and corresponding advantages <math id="A2.SS3.p1.m10" class="ltx_Math" alttext="A^{(1)},\dots,A^{(N)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">A^{(1)},\dots,A^{(N)}</annotation></semantics></math>. On-policy GRPO minimizes the negative advantage-weighted log likelihoods:</p>
<table id="A2.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E19.m1" class="ltx_math_unparsed" alttext="\mathcal{L}(\theta)=-\frac{1}{N}\sum_{i=1}^{N}A^{(i)}\log p_{\theta}({\bm{x}}_{s}^{(i)}|{\bm{x}}_{t})" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mi>N</mi></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mi>log</mi><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒙</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)=-\frac{1}{N}\sum_{i=1}^{N}A^{(i)}\log p_{\theta}({\bm{x}}_{s}^{(i)}|{\bm{x}}_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p1.3" class="ltx_p">where</p>
<table id="A2.E20" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E20X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E20X.m2" class="ltx_Math" alttext="\displaystyle\log p_{\theta}({\bm{x}}_{s}^{(i)}|{\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒙</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log p_{\theta}({\bm{x}}_{s}^{(i)}|{\bm{x}}_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E20X.m3" class="ltx_Math" alttext="\displaystyle=-\frac{\|{\bm{x}}_{s}^{(i)}-(l(s,t){\bm{x}}_{t}-m(s,t){\bm{v}}_{\theta}({\bm{x}}_{t},t))\|_{2}^{2}}{2n^{2}(s,t)}+C" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>𝒙</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mi>C</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{\|{\bm{x}}_{s}^{(i)}-(l(s,t){\bm{x}}_{t}-m(s,t){\bm{v}}_{\theta}({\bm{x}}_{t},t))\|_{2}^{2}}{2n^{2}(s,t)}+C</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(20)</span></td></tr>
<tr id="A2.E20Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E20Xa.m2" class="ltx_Math" alttext="\displaystyle=-\frac{\|m(s,t){\bm{v}}_{\theta}({\bm{x}}_{t},t)-m(s,t){\bm{v}}_{\texttt{sg}(\theta)}({\bm{x}}_{t},t)+n(s,t)\bm{\epsilon}^{(i)}\|_{2}^{2}}{2n^{2}(s,t)}+C" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mrow><mtext class="ltx_mathvariant_monospace">sg</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mi>C</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{\|m(s,t){\bm{v}}_{\theta}({\bm{x}}_{t},t)-m(s,t){\bm{v}}_{\texttt{sg}(\theta)}({\bm{x}}_{t},t)+n(s,t)\bm{\epsilon}^{(i)}\|_{2}^{2}}{2n^{2}(s,t)}+C</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.4" class="ltx_p"><span id="A2.SS3.p1.4.1" class="ltx_text ltx_font_typewriter">sg</span> emerges because the samples <math id="A2.SS3.p1.m11" class="ltx_Math" alttext="{\bm{x}}_{s}^{(1)},\dots,{\bm{x}}_{s}^{(N)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒙</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝒙</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\bm{x}}_{s}^{(1)},\dots,{\bm{x}}_{s}^{(N)}</annotation></semantics></math> are gradient-free. The gradient of the reverse-step log likelihood w.r.t. <math id="A2.SS3.p1.m12" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> can be surprisingly reduced to a simple form:</p>
<table id="A2.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E21.m1" class="ltx_Math" alttext="\nabla_{\theta}\log p_{\theta}({\bm{x}}_{s}^{(i)}|{\bm{x}}_{t})=-\frac{m(s,t)}{n(s,t)}\nabla_{\theta}((\bm{\epsilon}^{(i)})^{\top}{\bm{v}}_{\theta}({\bm{x}}_{t},t))" display="block" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒙</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mfrac><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\log p_{\theta}({\bm{x}}_{s}^{(i)}|{\bm{x}}_{t})=-\frac{m(s,t)}{n(s,t)}\nabla_{\theta}((\bm{\epsilon}^{(i)})^{\top}{\bm{v}}_{\theta}({\bm{x}}_{t},t))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p1.5" class="ltx_p">and</p>
<table id="A2.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E22.m1" class="ltx_Math" alttext="\nabla_{\theta}\mathcal{L}(\theta)=\frac{m(s,t)}{n(s,t)}\nabla_{\theta}\left[\frac{1}{N}\sum_{i=1}^{N}(A^{(i)}\bm{\epsilon}^{(i)})^{\top}{\bm{v}}_{\theta}({\bm{x}}_{t},t)\right]" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mrow><mo>[</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\mathcal{L}(\theta)=\frac{m(s,t)}{n(s,t)}\nabla_{\theta}\left[\frac{1}{N}\sum_{i=1}^{N}(A^{(i)}\bm{\epsilon}^{(i)})^{\top}{\bm{v}}_{\theta}({\bm{x}}_{t},t)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p1.6" class="ltx_p">Therefore, FlowGRPO essentially aligns the velocity field with the <span id="A2.SS3.p1.6.1" class="ltx_text ltx_font_italic">advantage-weighted noise</span>, while the choice of timesteps and sampler only influences the weighting <math id="A2.SS3.p1.m13" class="ltx_Math" alttext="\frac{m(s,t)}{n(s,t)}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{m(s,t)}{n(s,t)}</annotation></semantics></math> across sampling steps. From this perspective, the training loss of FlowGRPO should be disentangled with sampler parameters like the variance <math id="A2.SS3.p1.m14" class="ltx_Math" alttext="g_{t}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>t</mi></msub><annotation encoding="application/x-tex">g_{t}</annotation></semantics></math>, which current practices fail to address.</p>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Experiment Details</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p"><span id="A3.p1.1.1" class="ltx_text ltx_font_bold">Training Configurations.</span> Our setup largely follows FlowGRPO, adopting the same number of groups per epoch (48), group size (24), LoRA configuration (<math id="A3.p1.m1" class="ltx_Math" alttext="\alpha=64,r=32" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>=</mo><mn>64</mn></mrow><mo>,</mo><mrow><mi>r</mi><mo>=</mo><mn>32</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=64,r=32</annotation></semantics></math>), and learning rate (<math id="A3.p1.m2" class="ltx_Math" alttext="3e-4" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>−</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">3e-4</annotation></semantics></math>). For each collected clean image, forward noising and loss computation are performed exactly on the corresponding sampling timesteps. We employ a 2nd-order ODE sampler for data collection and enable adaptive time weighting by default.</p>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent">
<p id="A3.p2.1" class="ltx_p"><span id="A3.p2.1.1" class="ltx_text ltx_font_bold">Single-Reward.</span> For a head-to-head comparison with FlowGRPO under single-reward settings, we fix the number of sampling steps to 10 to ensure fairness. By default, we set <math id="A3.p2.m1" class="ltx_Math" alttext="\beta=1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta=1</annotation></semantics></math> and <math id="A3.p2.m2" class="ltx_Math" alttext="\eta_{i}=\min(0.001i,0.5)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0.001</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>,</mo><mn>0.5</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{i}=\min(0.001i,0.5)</annotation></semantics></math>, which work stably for most reward models. In the case of OCR, the reward rapidly approaches 1 within 100 iterations but suffers from instability. To address this, we adopt a more conservative soft-update strategy with <math id="A3.p2.m3" class="ltx_Math" alttext="\eta_{\max}=0.999" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>max</mi></msub><mo>=</mo><mn>0.999</mn></mrow><annotation encoding="application/x-tex">\eta_{\max}=0.999</annotation></semantics></math>.</p>
</div>
<div id="A3.p3" class="ltx_para ltx_noindent">
<p id="A3.p3.1" class="ltx_p"><span id="A3.p3.1.1" class="ltx_text ltx_font_bold">Multi-Reward.</span> To comprehensively improve the base model across multiple rewards, we adopt a multi-stage training scheme. The training setup involves three categories of rewards and datasets: (1) PickScore, CLIPScore, and HPSv2.1 on the Pick-a-Pic dataset; (2) GenEval with the three rewards above on the GenEval dataset; and (3) OCR with the three rewards above on the OCR dataset. Since the initial CFG-free generation is of low quality, we first train on (1) for 800 iterations to enhance image quality, followed by (2) for 300 iterations, (1) for 200 iterations, (2) for 200 iterations, and finally (3) for 100 iterations. All rewards are equally weighted, with PickScore divided by 26 for normalization to <math id="A3.p3.m1" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>. By default, we use <math id="A3.p3.m2" class="ltx_Math" alttext="\beta=0.1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">\beta=0.1</annotation></semantics></math> and <math id="A3.p3.m3" class="ltx_Math" alttext="\eta_{i}=\min(0.001i,0.5)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0.001</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>,</mo><mn>0.5</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{i}=\min(0.001i,0.5)</annotation></semantics></math>, while setting <math id="A3.p3.m4" class="ltx_Math" alttext="\eta_{\max}=0.95" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>max</mi></msub><mo>=</mo><mn>0.95</mn></mrow><annotation encoding="application/x-tex">\eta_{\max}=0.95</annotation></semantics></math> for OCR to stabilize training. The number of sampling steps is fixed to 40 to ensure high-fidelity data collection.</p>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Additional Results</h2>

<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">We provide more qualitative comparison between the base model, FlowGRPO and our multi-reward optimized model in Figure <a href="#A4.F11" title="Figure 11 ‣ Appendix D Additional Results ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, Figure <a href="#A4.F12" title="Figure 12 ‣ Appendix D Additional Results ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a> and Figure <a href="#A4.F13" title="Figure 13 ‣ Appendix D Additional Results ‣ DiffusionNFT: Online Diffusion Reinforcement with Forward Process" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>.</p>
</div>
<figure id="A4.F11" class="ltx_figure"><img src="2509.16117v1/qualitative1-crop.png" id="A4.F11.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:548/758;" width="548" height="758" alt="Refer to caption">
<br class="ltx_break ltx_centering">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 11: </span> Qualitative comparison between FlowGRPO and our model on GenEval prompts.</figcaption>
</figure>
<figure id="A4.F12" class="ltx_figure"><img src="2509.16117v1/qualitative2-crop.png" id="A4.F12.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:548/818;" width="548" height="818" alt="Refer to caption">
<br class="ltx_break ltx_centering">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 12: </span> Qualitative comparison between FlowGRPO and our model on OCR prompts.</figcaption>
</figure>
<figure id="A4.F13" class="ltx_figure"><img src="2509.16117v1/qualitative3-crop.png" id="A4.F13.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:548/748;" width="548" height="748" alt="Refer to caption">
<br class="ltx_break ltx_centering">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 13: </span> Qualitative comparison between FlowGRPO and our model on DrawBench prompts.</figcaption>
</figure>
</section>
