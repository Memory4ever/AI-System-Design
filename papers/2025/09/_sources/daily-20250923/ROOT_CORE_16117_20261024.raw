<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex44.m1" class="ltx_math_unparsed" alttext="\displaystyle+[1-\alpha({\bm{x}}_{t})]\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-\mathbb{E}_{\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{v}}]\|_{2}^{2}\}+C_{1}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>−</mo><mi>α</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msubsup><mi>𝒗</mi><mi>θ</mi><mo>−</mo></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><mrow><msubsup><mi>π</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>t</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo stretchy="false">[</mo><mi>𝒗</mi><mo stretchy="false">]</mo></mrow><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo stretchy="false">}</mo><mo>+</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle+[1-\alpha({\bm{x}}_{t})]\|{\bm{v}}_{\theta}^{-}({\bm{x}}_{t},{\bm{c}},t)-\mathbb{E}_{\pi^{-}_{0|t}({\bm{x}}_{0}|{\bm{x}}_{t},{\bm{c}})}[{\bm{v}}]\|_{2}^{2}\}+C_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
