<td id="S5.T1.3.4.2" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.4.2.1" class="ltx_text" style="font-size:90%;">63.8</span></td>
<td id="S5.T1.3.4.3" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.4.3.1" class="ltx_text" style="font-size:90%;">63.6</span></td>
<td id="S5.T1.3.4.4" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.4.4.1" class="ltx_text" style="font-size:90%;">72.0</span></td>
<td id="S5.T1.3.4.5" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.4.5.1" class="ltx_text" style="font-size:90%;">65</span></td>
<td id="S5.T1.3.4.6" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.4.6.1" class="ltx_text" style="font-size:90%;">66.3</span></td>
<td id="S5.T1.3.4.7" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.4.7.1" class="ltx_text" style="font-size:90%;">17</span></td></tr>
