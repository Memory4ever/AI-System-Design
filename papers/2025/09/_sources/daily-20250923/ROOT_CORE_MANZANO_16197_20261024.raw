<td id="S5.T1.3.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.3.4.1" class="ltx_text" style="font-size:90%;">62.3</span></td>
<td id="S5.T1.3.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.3.5.1" class="ltx_text" style="font-size:90%;">77</span></td>
<td id="S5.T1.3.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.3.6.1" class="ltx_text" style="font-size:90%;">80.9</span></td>
<td id="S5.T1.3.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.3.7.1" class="ltx_text" style="font-size:90%;">35</span></td></tr>
<tr id="S5.T1.3.4" class="ltx_tr">
