<td id="S5.T1.3.5.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 5.0pt;"><span id="S5.T1.3.5.4.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#ADD8E6;">73.3</span></td>
