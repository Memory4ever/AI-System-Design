<td id="S5.T2.3.1.34.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S5.T2.3.1.34.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6FA;">86.3</span></td>
<td id="S5.T2.3.1.34.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.3.1.34.5.1" class="ltx_text" style="--ltx-bg-color:#E6E6FA;">89.5</span></td>
<td id="S5.T2.3.1.34.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.3.1.34.6.1" class="ltx_text" style="--ltx-bg-color:#E6E6FA;">88.4</span></td>
