{"data":{"id":"10.48550/arxiv.2509.17729","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17729","prefix":"10.48550","suffix":"arxiv.2509.17729","identifiers":[{"identifier":"2509.17729","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.17729"}],"creators":[{"name":"Zheng, Siming","nameType":"Personal","givenName":"Siming","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Tong","nameType":"Personal","givenName":"Tong","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Lan, Meifang","nameType":"Personal","givenName":"Meifang","familyName":"Lan","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Yuanyuan","nameType":"Personal","givenName":"Yuanyuan","familyName":"Lin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Conditional Distribution Equality Testing Framework using Deep Generative Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Statistics Theory (math.ST)","subjectScheme":"arXiv"},{"lang":"en","subject":"Methodology (stat.ME)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:59:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:31:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T13:57:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:51:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-26T07:41:49Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-27T01:30:36Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"In this paper, we propose a general framework for testing the conditional distribution equality in a two-sample problem, which is most relevant to covariate shift and causal discovery. Our framework is built on neural network-based generative methods and sample splitting techniques by transforming the conditional testing problem into an unconditional one. We introduce the generative classification accuracy-based conditional distribution equality test (GCA-CDET) to illustrate the proposed framework. We establish the convergence rate for the learned generator by deriving new results related to the recently-developed offset Rademacher complexity and prove the testing consistency of GCA-CDET under mild conditions.Empirically, we conduct numerical studies including synthetic datasets and two real-world datasets, demonstrating the effectiveness of our approach. Additional discussions on the optimality of the proposed framework are provided in the online supplementary material.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.17729","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:18:53.000Z","registered":"2025-09-23T03:18:54.000Z","published":"2025","updated":"2025-11-27T03:16:17.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.17729","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}