<td id="S4.T1.st1.2.3.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="S4.T1.st1.m7" class="ltx_Math" alttext="\mathbf{1.0}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">1.0</mn><annotation encoding="application/x-tex">\mathbf{1.0}</annotation></semantics></math></td>
<td id="S4.T1.st1.2.3.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="S4.T1.st1.m8" class="ltx_Math" alttext="0.96" display="inline" intent=":literal"><semantics><mn>0.96</mn><annotation encoding="application/x-tex">0.96</annotation></semantics></math></td>
<td id="S4.T1.st1.2.3.5" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="S4.T1.st1.m9" class="ltx_Math" alttext="0.92" display="inline" intent=":literal"><semantics><mn>0.92</mn><annotation encoding="application/x-tex">0.92</annotation></semantics></math></td>
<td id="S4.T1.st1.2.3.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="S4.T1.st1.m10" class="ltx_Math" alttext="\mathbf{1.0}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">1.0</mn><annotation encoding="application/x-tex">\mathbf{1.0}</annotation></semantics></math></td>
<td id="S4.T1.st1.2.3.7" class="ltx_td" style="padding-top:1pt;padding-bottom:1pt;"></td></tr>
<tr id="S4.T1.st1.2.4" class="ltx_tr">
