</div>
<div id="alg1.l19" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">19:</span>
                
                
              <span id="alg1.l19.2" class="ltx_text ltx_font_bold">function</span> <span id="alg1.l19.3" class="ltx_text ltx_font_smallcaps">RejectSample</span>(<math id="alg1.l19.m1" class="ltx_Math" alttext="R,F,t,S,\rho,T_{\max}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>S</mi><mo>,</mo><mi>ρ</mi><mo>,</mo><msub><mi>T</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">R,F,t,S,\rho,T_{\max}</annotation></semantics></math>)

</div>
<div id="alg1.l20" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">20:</span>
                
                
