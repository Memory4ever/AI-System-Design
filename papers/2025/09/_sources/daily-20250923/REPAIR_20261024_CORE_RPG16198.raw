<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.4 </span>Testing Framework</h3>

<div id="A3.SS4.p1" class="ltx_para ltx_noindent">
<p id="A3.SS4.p1.1" class="ltx_p">As illustrated in Algorithm <a href="#alg3" title="Algorithm 3 ‣ C.4 Testing Framework ‣ Appendix C Appendix of Graph-Guided Repository Generation ‣ RPG: A Repository Planning Graph for Unified and Scalable Codebase Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, the testing framework combines <span id="A3.SS4.p1.1.1" class="ltx_text ltx_font_bold">unit tests</span>, <span id="A3.SS4.p1.1.2" class="ltx_text ltx_font_bold">regression tests</span>, and <span id="A3.SS4.p1.1.3" class="ltx_text ltx_font_bold">integration tests</span> into a unified process. Unit tests validate each new patch at a fine-grained level, regression tests re-execute existing nodes to ensure backward compatibility, and integration tests verify that multiple patched components interact correctly when combined.</p>
</div>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Patch-Oriented Testing with Unit, Regression, and Integration Stages</figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            Patch set <math id="alg3.l1.m1" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>; repo skeleton <math id="alg3.l1.m2" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math>; dependency code <math id="alg3.l1.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>;
existing unit nodes <math id="alg3.l1.m4" class="ltx_Math" alttext="\mathcal{N}_{u}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>u</mi></msub><annotation encoding="application/x-tex">\mathcal{N}_{u}</annotation></semantics></math>; existing integration nodes <math id="alg3.l1.m5" class="ltx_Math" alttext="\mathcal{N}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{N}_{i}</annotation></semantics></math>;
task description <math id="alg3.l1.m6" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>

</div>
<div id="alg3.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            <span id="alg3.l2.2" class="ltx_text ltx_font_bold">function</span> <span id="alg3.l2.3" class="ltx_text ltx_font_smallcaps">TestPatches</span>(<math id="alg3.l2.m1" class="ltx_Math" alttext="\mathcal{P},\mathcal{R},D,\Theta" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>,</mo><mi>D</mi><mo>,</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\mathcal{P},\mathcal{R},D,\Theta</annotation></semantics></math>)

</div>
<div id="alg3.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
              <math id="alg3.l3.m1" class="ltx_Math" alttext="\mathcal{T}_{unit}\leftarrow[]" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{unit}\leftarrow[]</annotation></semantics></math>;  <math id="alg3.l3.m2" class="ltx_Math" alttext="\mathcal{T}_{inte}\leftarrow[]" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{inte}\leftarrow[]</annotation></semantics></math>

</div>
<div id="alg3.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
              <math id="alg3.l4.m1" class="ltx_math_unparsed" alttext="\mathcal{T}_{traj}\leftarrow\{\texttt{unit}:\{\},\texttt{inte}:\{\}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mtext class="ltx_mathvariant_monospace">unit</mtext><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow><mo>,</mo><mtext class="ltx_mathvariant_monospace">inte</mtext><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{traj}\leftarrow\{\texttt{unit}:\{\},\texttt{inte}:\{\}\}</annotation></semantics></math>

</div>
<div id="alg3.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              <math id="alg3.l5.m1" class="ltx_Math" alttext="\mathcal{P}^{\prime}\leftarrow\mathcal{P}\cup\textsc{FindDepPatches}(\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>∪</mo><mrow><mtext class="ltx_font_smallcaps">FindDepPatches</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}^{\prime}\leftarrow\mathcal{P}\cup\textsc{FindDepPatches}(\mathcal{P})</annotation></semantics></math>
<span id="alg3.l5.2" class="ltx_text" style="float:right;"><math id="alg3.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Extend patch set with dependency patches
</span>
</div>
<div id="alg3.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
              <span id="alg3.l6.2" class="ltx_text ltx_font_bold">for</span> patch <math id="alg3.l6.m1" class="ltx_Math" alttext="p\in\mathcal{P}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">p\in\mathcal{P}^{\prime}</annotation></semantics></math> <span id="alg3.l6.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
               <math id="alg3.l7.m1" class="ltx_Math" alttext="n_{old}\leftarrow\textsc{FindExistingUnitNode}(\mathcal{N}_{u},p)" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">FindExistingUnitNode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>u</mi></msub><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n_{old}\leftarrow\textsc{FindExistingUnitNode}(\mathcal{N}_{u},p)</annotation></semantics></math>

</div>
<div id="alg3.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
               <span id="alg3.l8.2" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l8.m1" class="ltx_Math" alttext="n_{old}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">n_{old}\neq\emptyset</annotation></semantics></math> <span id="alg3.l8.3" class="ltx_text ltx_font_bold">and</span> <span id="alg3.l8.4" class="ltx_text ltx_font_smallcaps">SameSignatureOrLogic</span>(<math id="alg3.l8.m2" class="ltx_Math" alttext="n_{old},p" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo>,</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">n_{old},p</annotation></semantics></math>) <span id="alg3.l8.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg3.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
                 <math id="alg3.l9.m1" class="ltx_Math" alttext="n_{new}\leftarrow n_{old}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo stretchy="false">←</mo><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></mrow><annotation encoding="application/x-tex">n_{new}\leftarrow n_{old}</annotation></semantics></math>
<span id="alg3.l9.2" class="ltx_text" style="float:right;"><math id="alg3.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Regression test: reuse existing node if signature/logic unchanged
</span>
</div>
<div id="alg3.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
               <span id="alg3.l10.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg3.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
                 <math id="alg3.l11.m1" class="ltx_Math" alttext="n_{new},traj\leftarrow\textsc{CreateOrUpdateUnitNode}(p,D,\Theta,n_{old})" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>,</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">CreateOrUpdateUnitNode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>D</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n_{new},traj\leftarrow\textsc{CreateOrUpdateUnitNode}(p,D,\Theta,n_{old})</annotation></semantics></math>

</div>
<div id="alg3.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
                 <math id="alg3.l12.m1" class="ltx_math_unparsed" alttext="\mathcal{T}_{traj}[\texttt{unit}][p.\texttt{key}]\leftarrow traj" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mrow><mo stretchy="false">[</mo><mtext class="ltx_mathvariant_monospace">unit</mtext><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><mi>p</mi><mo lspace="0em" rspace="0.167em">.</mo><mtext class="ltx_mathvariant_monospace">key</mtext><mo stretchy="false">]</mo></mrow><mo stretchy="false">←</mo><mi>t</mi><mi>r</mi><mi>a</mi><mi>j</mi></mrow><annotation encoding="application/x-tex">\mathcal{T}_{traj}[\texttt{unit}][p.\texttt{key}]\leftarrow traj</annotation></semantics></math>

</div>
<div id="alg3.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
               <span id="alg3.l13.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l13.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg3.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
              
               <math id="alg3.l14.m1" class="ltx_math_unparsed" alttext="\mathcal{R}.\textsc{InsertFile}(n_{new}.\texttt{test\_file},n_{new}.\texttt{test\_code})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo lspace="0em" rspace="0.167em">.</mo><mtext class="ltx_font_smallcaps">InsertFile</mtext><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0.167em">.</mo><mtext class="ltx_mathvariant_monospace">test_file</mtext><mo>,</mo><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0.167em">.</mo><mtext class="ltx_mathvariant_monospace">test_code</mtext><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}.\textsc{InsertFile}(n_{new}.\texttt{test\_file},n_{new}.\texttt{test\_code})</annotation></semantics></math>

</div>
<div id="alg3.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
               <math id="alg3.l15.m1" class="ltx_Math" alttext="res\leftarrow n_{new}.\textsc{ExecuteTest}()" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">←</mo><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_font_smallcaps">ExecuteTest</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">res\leftarrow n_{new}.\textsc{ExecuteTest}()</annotation></semantics></math>

</div>
<div id="alg3.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
               <math id="alg3.l16.m1" class="ltx_Math" alttext="\mathcal{T}_{unit}.\textsc{append}(res)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_font_smallcaps">append</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{unit}.\textsc{append}(res)</annotation></semantics></math>

</div>
<div id="alg3.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">17:</span>
              
              
              <span id="alg3.l17.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l17.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">18:</span>
              
              
              <span id="alg3.l18.2" class="ltx_text ltx_font_bold">for</span> patch group <math id="alg3.l18.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> clustered by integration-node <span id="alg3.l18.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">19:</span>
              
              
               <math id="alg3.l19.m1" class="ltx_Math" alttext="n_{old}\leftarrow\textsc{FindExistingIntegrationNode}(\mathcal{N}_{i},\mathcal{G})" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">FindExistingIntegrationNode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n_{old}\leftarrow\textsc{FindExistingIntegrationNode}(\mathcal{N}_{i},\mathcal{G})</annotation></semantics></math>

</div>
<div id="alg3.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">20:</span>
              
              
               <span id="alg3.l20.2" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l20.m1" class="ltx_Math" alttext="n_{old}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">n_{old}\neq\emptyset</annotation></semantics></math> <span id="alg3.l20.3" class="ltx_text ltx_font_bold">and</span> <span id="alg3.l20.4" class="ltx_text ltx_font_smallcaps">AllEqual</span>(<math id="alg3.l20.m2" class="ltx_Math" alttext="n_{old},\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">n_{old},\mathcal{G}</annotation></semantics></math>) <span id="alg3.l20.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg3.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">21:</span>
              
              
                 <math id="alg3.l21.m1" class="ltx_Math" alttext="n_{new}\leftarrow n_{old}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo stretchy="false">←</mo><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></mrow><annotation encoding="application/x-tex">n_{new}\leftarrow n_{old}</annotation></semantics></math>
<span id="alg3.l21.2" class="ltx_text" style="float:right;"><math id="alg3.l21.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Regression integration test: reuse existing node
</span>
</div>
<div id="alg3.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">22:</span>
              
              
               <span id="alg3.l22.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg3.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">23:</span>
              
              
                 <math id="alg3.l23.m1" class="ltx_Math" alttext="n_{new},traj\leftarrow\textsc{CreateIntegrationNode}(\mathcal{G},\Theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>,</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">CreateIntegrationNode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n_{new},traj\leftarrow\textsc{CreateIntegrationNode}(\mathcal{G},\Theta)</annotation></semantics></math>

</div>
<div id="alg3.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">24:</span>
              
              
                 <math id="alg3.l24.m1" class="ltx_Math" alttext="\mathcal{T}_{traj}[\texttt{inte}][\mathcal{G}]\leftarrow traj" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mtext class="ltx_mathvariant_monospace">inte</mtext><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{traj}[\texttt{inte}][\mathcal{G}]\leftarrow traj</annotation></semantics></math>

</div>
<div id="alg3.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">25:</span>
              
              
                 <math id="alg3.l25.m1" class="ltx_math_unparsed" alttext="\mathcal{R}.\textsc{InsertFile}(n_{new}.\texttt{test\_file},n_{new}.\texttt{test\_code})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo lspace="0em" rspace="0.167em">.</mo><mtext class="ltx_font_smallcaps">InsertFile</mtext><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0.167em">.</mo><mtext class="ltx_mathvariant_monospace">test_file</mtext><mo>,</mo><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo lspace="0em" rspace="0.167em">.</mo><mtext class="ltx_mathvariant_monospace">test_code</mtext><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}.\textsc{InsertFile}(n_{new}.\texttt{test\_file},n_{new}.\texttt{test\_code})</annotation></semantics></math>

</div>
<div id="alg3.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">26:</span>
              
              
               <span id="alg3.l26.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l26.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg3.l27" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">27:</span>
              
              
               <math id="alg3.l27.m1" class="ltx_Math" alttext="res\leftarrow n_{new}.\textsc{ExecuteTest}()" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">←</mo><msub><mi>n</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_font_smallcaps">ExecuteTest</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">res\leftarrow n_{new}.\textsc{ExecuteTest}()</annotation></semantics></math>

</div>
<div id="alg3.l28" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">28:</span>
              
              
               <math id="alg3.l28.m1" class="ltx_Math" alttext="\mathcal{T}_{inte}.\textsc{append}(res)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_font_smallcaps">append</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{inte}.\textsc{append}(res)</annotation></semantics></math>

</div>
<div id="alg3.l29" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">29:</span>
              
              
              <span id="alg3.l29.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l29.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l30" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">30:</span>
              
              
              <span id="alg3.l30.2" class="ltx_text ltx_font_bold">return</span> <math id="alg3.l30.m1" class="ltx_Math" alttext="\mathcal{T}_{unit}\cup\mathcal{T}_{inte},\mathcal{T}_{traj}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{T}_{unit}\cup\mathcal{T}_{inte},\mathcal{T}_{traj}</annotation></semantics></math>

</div>
<div id="alg3.l31" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">31:</span>
              
              
            <span id="alg3.l31.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l31.3" class="ltx_text ltx_font_bold">function</span>
</div>
</div>
</figure>
<div id="A3.SS4.p2" class="ltx_para ltx_noindent">
<p id="A3.SS4.p2.1" class="ltx_p">As illustrated in Algorithm <a href="#alg4" title="Algorithm 4 ‣ C.4 Testing Framework ‣ Appendix C Appendix of Graph-Guided Repository Generation ‣ RPG: A Repository Planning Graph for Unified and Scalable Codebase Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, the testing pipeline proceeds in a sequence of stages: branch planning, test generation, execution, judgment, and repair. First, a candidate test branch is created for the given code unit(s). Then, test code is generated and wrapped into a <span id="A3.SS4.p2.1.1" class="ltx_text ltx_font_typewriter">TestNode</span> or <span id="A3.SS4.p2.1.2" class="ltx_text ltx_font_typewriter">IntegrationTestNode</span>, which is executed inside a controlled Docker environment. The execution results are judged by an LLM; if failures are detected, the framework automatically generates fix queries and iteratively repairs the test until a validated version is obtained.</p>
</div>
<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.3" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> End-to-End Test Generation, Execution, and Repair</figcaption>
<div id="alg4.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            Repo skeleton <math id="alg4.l1.m1" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math>; tested unit(s) <math id="alg4.l1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>; source code <math id="alg4.l1.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>;
optional prior test node <math id="alg4.l1.m4" class="ltx_Math" alttext="n_{old}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">n_{old}</annotation></semantics></math>; maximum retries <math id="alg4.l1.m5" class="ltx_Math" alttext="T_{\max}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>max</mi></msub><annotation encoding="application/x-tex">T_{\max}</annotation></semantics></math>

</div>
<div id="alg4.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            <span id="alg4.l2.2" class="ltx_text ltx_font_bold">function</span> <span id="alg4.l2.3" class="ltx_text ltx_font_smallcaps">RunTestingPipeline</span>(<math id="alg4.l2.m1" class="ltx_Math" alttext="\mathcal{R},U,C,n_{old}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>,</mo><mi>U</mi><mo>,</mo><mi>C</mi><mo>,</mo><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{R},U,C,n_{old}</annotation></semantics></math>)
<span id="alg4.l2.4" class="ltx_text" style="float:right;"><math id="alg4.l2.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Main entry point for testing workflow
</span>
</div>
<div id="alg4.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
              // — Step 1: Plan test branches —

</div>
<div id="alg4.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
              <math id="alg4.l4.m1" class="ltx_Math" alttext="branch\leftarrow\textsc{GenerateCodeBranch}(C,n_{old},T_{\max})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">GenerateCodeBranch</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo>,</mo><msub><mi>T</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">branch\leftarrow\textsc{GenerateCodeBranch}(C,n_{old},T_{\max})</annotation></semantics></math>

</div>
<div id="alg4.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              // — Step 2: Generate candidate test code —

</div>
<div id="alg4.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
              <math id="alg4.l6.m1" class="ltx_Math" alttext="test\_code\leftarrow\textsc{GenerateTest}(branch,C,U,n_{old})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">GenerateTest</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>,</mo><mi>C</mi><mo>,</mo><mi>U</mi><mo>,</mo><msub><mi>n</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">test\_code\leftarrow\textsc{GenerateTest}(branch,C,U,n_{old})</annotation></semantics></math>

</div>
<div id="alg4.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
              // — Step 3: Build a TestNode —

</div>
<div id="alg4.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
              <span id="alg4.l8.2" class="ltx_text ltx_font_bold">if</span> <math id="alg4.l8.m1" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> represents integration of multiple units <span id="alg4.l8.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg4.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
               <math id="alg4.l9.m1" class="ltx_Math" alttext="n\leftarrow\textsc{IntegrationTestNode}(U,test\_code)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">IntegrationTestNode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n\leftarrow\textsc{IntegrationTestNode}(U,test\_code)</annotation></semantics></math>

</div>
<div id="alg4.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
              <span id="alg4.l10.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg4.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
               <math id="alg4.l11.m1" class="ltx_Math" alttext="n\leftarrow\textsc{UnitTestNode}(U,C,test\_code)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">UnitTestNode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>C</mi><mo>,</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n\leftarrow\textsc{UnitTestNode}(U,C,test\_code)</annotation></semantics></math>

</div>
<div id="alg4.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
              <span id="alg4.l12.2" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l12.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg4.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
              // — Step 4: Execute test code in Docker —

</div>
<div id="alg4.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
              
              <math id="alg4.l14.m1" class="ltx_Math" alttext="result\leftarrow n.\textsc{ExecuteTest}()" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">←</mo><mi>n</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_font_smallcaps">ExecuteTest</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">result\leftarrow n.\textsc{ExecuteTest}()</annotation></semantics></math>

</div>
<div id="alg4.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
              <math id="alg4.l15.m1" class="ltx_math_unparsed" alttext="output\leftarrow result.stdout\parallel result.stderr" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mi>u</mi><mi>t</mi><mi>p</mi><mi>u</mi><mi>t</mi><mo stretchy="false">←</mo><mi>r</mi><mi>e</mi><mi>s</mi><mi>u</mi><mi>l</mi><mi>t</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>s</mi><mi>t</mi><mi>d</mi><mi>o</mi><mi>u</mi><mi>t</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>r</mi><mi>e</mi><mi>s</mi><mi>u</mi><mi>l</mi><mi>t</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>s</mi><mi>t</mi><mi>d</mi><mi>e</mi><mi>r</mi><mi>r</mi></mrow><annotation encoding="application/x-tex">output\leftarrow result.stdout\parallel result.stderr</annotation></semantics></math>

</div>
<div id="alg4.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
              // — Step 5: LLM judge outcome —

</div>
<div id="alg4.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">17:</span>
              
              
