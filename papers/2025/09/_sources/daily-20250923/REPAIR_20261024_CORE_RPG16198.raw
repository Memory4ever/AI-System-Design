</div>
<div id="alg1.l26" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">26:</span>
                
                
                   best_ovl <math id="alg1.l26.m1" class="ltx_Math" alttext="\leftarrow\text{ovl}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">←</mo><mtext>ovl</mtext></mrow><annotation encoding="application/x-tex">\leftarrow\text{ovl}</annotation></semantics></math>;  best_T <math id="alg1.l26.m2" class="ltx_Math" alttext="\leftarrow T_{\text{cand}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">←</mo><msub><mi>T</mi><mtext>cand</mtext></msub></mrow><annotation encoding="application/x-tex">\leftarrow T_{\text{cand}}</annotation></semantics></math> <span id="alg1.l26.2" class="ltx_text" style="float:right;"><math id="alg1.l26.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> update best candidate so far
</span>
</div>
<div id="alg1.l27" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">27:</span>
                
                
