<td id="S7.T3.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">4.6 (15.3/336.1)</td></tr>
<tr id="S7.T3.1.1.3" class="ltx_tr">
<td id="S7.T3.1.1.3.1" class="ltx_td ltx_align_left">10</td>
<td id="S7.T3.1.1.3.2" class="ltx_td ltx_align_center">80.9</td>
<td id="S7.T3.1.1.3.3" class="ltx_td ltx_align_center">5.4 (29.01/542.0)</td></tr>
