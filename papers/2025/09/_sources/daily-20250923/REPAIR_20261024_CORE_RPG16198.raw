<span id="A1.T5.2.6.1.1" class="ltx_inline-block ltx_align_top" style="width:22.8pt;">
<span id="A1.T5.2.6.1.1.1" class="ltx_p ltx_align_left">5</span>
</span></td>
<td id="A1.T5.2.6.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="A1.T5.2.6.2.1" class="ltx_inline-block ltx_align_top" style="width:51.2pt;">
<span id="A1.T5.2.6.2.1.1" class="ltx_p ltx_align_right">613,311</span>
</span></td>
