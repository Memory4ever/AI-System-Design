</div>
<div id="lstnumberx869" class="ltx_listingline"><span id="lstnumberx869.1" class="ltx_text ltx_lst_space ltx_font_typewriter">          </span><span id="lstnumberx869.2" class="ltx_text ltx_font_typewriter">...</span>
</div>
<div id="lstnumberx870" class="ltx_listingline"><span id="lstnumberx870.1" class="ltx_text ltx_lst_space ltx_font_typewriter">        </span><span id="lstnumberx870.2" class="ltx_text ltx_font_typewriter">],</span>
</div>
<div id="lstnumberx871" class="ltx_listingline"><span id="lstnumberx871.1" class="ltx_text ltx_lst_space ltx_font_typewriter">        </span><span id="lstnumberx871.2" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx871.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">pinball_loss</span><span id="lstnumberx871.4" class="ltx_text ltx_font_typewriter">":</span><span id="lstnumberx871.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx871.6" class="ltx_text ltx_font_typewriter">[</span>
