</div>
<div id="alg1.l28" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">28:</span>
                
                
                 <span id="alg1.l28.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l28.m1" class="ltx_Math" alttext="\text{ovl}\leq\rho" display="inline" intent=":literal"><semantics><mrow><mtext>ovl</mtext><mo>≤</mo><mi>ρ</mi></mrow><annotation encoding="application/x-tex">\text{ovl}\leq\rho</annotation></semantics></math> <span id="alg1.l28.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l29" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">29:</span>
                
                
                   <math id="alg1.l29.m1" class="ltx_Math" alttext="T^{\star}\leftarrow T_{\text{cand}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>⋆</mo></msup><mo stretchy="false">←</mo><msub><mi>T</mi><mtext>cand</mtext></msub></mrow><annotation encoding="application/x-tex">T^{\star}\leftarrow T_{\text{cand}}</annotation></semantics></math> <span id="alg1.l29.2" class="ltx_text" style="float:right;"><math id="alg1.l29.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> accept immediately if overlap <math id="alg1.l29.m3" class="ltx_Math" alttext="\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\leq</annotation></semantics></math> threshold
</span>
</div>
