                 <span id="alg1.l31.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l31.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l32" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">32:</span>
                
                
                <span id="alg1.l32.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l32.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l33" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">33:</span>
                
                
                <span id="alg1.l33.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l33.m1" class="ltx_Math" alttext="T^{\star}=\emptyset" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>⋆</mo></msup><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">T^{\star}=\emptyset</annotation></semantics></math> <span id="alg1.l33.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l34" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">34:</span>
                
                
                 <math id="alg1.l34.m1" class="ltx_Math" alttext="T^{\star}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>⋆</mo></msup><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">T^{\star}\leftarrow</annotation></semantics></math> best_T <span id="alg1.l34.2" class="ltx_text" style="float:right;"><math id="alg1.l34.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> fallback: choose least-overlap candidate
</span>
</div>
<div id="alg1.l35" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">35:</span>
                
                
