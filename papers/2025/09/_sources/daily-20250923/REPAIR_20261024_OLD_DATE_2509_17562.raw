{"data":{"id":"10.48550/arxiv.2509.17562","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17562","prefix":"10.48550","suffix":"arxiv.2509.17562","identifiers":[{"identifier":"2509.17562","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.17562"}],"creators":[{"name":"Li, Yuxuan","nameType":"Personal","givenName":"Yuxuan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yicheng","nameType":"Personal","givenName":"Yicheng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Wenhao","nameType":"Personal","givenName":"Wenhao","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Dai, Yimian","nameType":"Personal","givenName":"Yimian","familyName":"Dai","affiliation":[],"nameIdentifiers":[]},{"name":"Cheng, Ming-Ming","nameType":"Personal","givenName":"Ming-Ming","familyName":"Cheng","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xiang","nameType":"Personal","givenName":"Xiang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Jian","nameType":"Personal","givenName":"Jian","familyName":"Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Visual Instruction Pretraining for Domain-Specific Foundation Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T10:57:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:22:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T04:33:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:30:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-28T07:15:09Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-29T01:28:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02-26T07:40:53Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-27T01:30:46Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Modern computer vision is converging on a closed loop in which perception, reasoning and generation mutually reinforce each other. However, this loop remains incomplete: the top-down influence of high-level reasoning on the foundational learning of low-level perceptual features is not yet underexplored. This paper addresses this gap by proposing a new paradigm for pretraining foundation models in downstream domains. We introduce Visual insTruction Pretraining (ViTP), a novel approach that directly leverages reasoning to enhance perception. ViTP embeds a Vision Transformer (ViT) backbone within a Vision-Language Model and pretrains it end-to-end using a rich corpus of visual instruction data curated from target downstream domains. ViTP is powered by our proposed Visual Robustness Learning (VRL), which compels the ViT to learn robust and domain-relevant features from a sparse set of visual tokens. Extensive experiments on 16 challenging remote sensing and medical imaging benchmarks demonstrate that ViTP establishes new state-of-the-art performance across a diverse range of downstream tasks. The code is available at https://github.com/zcablii/ViTP.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.17562","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:14:57.000Z","registered":"2025-09-23T03:14:58.000Z","published":"2025","updated":"2026-02-27T03:14:47.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.17562","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}