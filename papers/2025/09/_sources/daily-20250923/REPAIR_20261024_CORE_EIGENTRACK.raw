<tbody class="ltx_tbody">
<tr id="S3.T2.2.2" class="ltx_tr">
<th id="S3.T2.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" rowspan="5"><span id="S3.T2.2.2.1.1" class="ltx_text" style="font-size:90%;">
<span id="S3.T2.2.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.3pt;height:54.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:54.2pt;transform:translate(-24.0pt,-24.0pt) rotate(-90deg) ;">
<span id="S3.T2.2.2.1.1.1.1" class="ltx_p">Hallucination</span>
</span></span></span></th>
<th id="S3.T2.2.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T2.2.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">EigenTrack</span></th>
