<td id="S5.T1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.1.1.2.4.1" class="ltx_text ltx_font_bold">90.0<math id="S5.T1.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>4.1</span></td></tr>
