<td id="S5.T1.1.1.3.4" class="ltx_td ltx_align_center"><span id="S5.T1.1.1.3.4.1" class="ltx_text ltx_font_bold">80.0<math id="S5.T1.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.0</span></td></tr>
