<div id="lstnumberx20" class="ltx_listingline"><span id="lstnumberx20.1" class="ltx_text ltx_lst_space" style="font-size:80%;">        </span><span id="lstnumberx20.2" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx20.3" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx20.4" class="ltx_text" style="font-size:80%;">’</span><span id="lstnumberx20.5" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">left</span><span id="lstnumberx20.6" class="ltx_text" style="font-size:80%;">’</span><span id="lstnumberx20.7" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx20.8" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">means</span><span id="lstnumberx20.9" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx20.10" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">decrement</span><span id="lstnumberx20.11" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx20.12" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">x</span>
