<div id="lstnumberx22" class="ltx_listingline"><span id="lstnumberx22.1" class="ltx_text ltx_lst_space" style="font-size:80%;">        </span><span id="lstnumberx22.2" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx22.3" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx22.4" class="ltx_text" style="font-size:80%;">’</span><span id="lstnumberx22.5" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">down</span><span id="lstnumberx22.6" class="ltx_text" style="font-size:80%;">’</span><span id="lstnumberx22.7" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx22.8" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">means</span><span id="lstnumberx22.9" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx22.10" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">decrement</span><span id="lstnumberx22.11" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx22.12" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">y</span><span id="lstnumberx22.13" class="ltx_text" style="font-size:80%;">.</span>
