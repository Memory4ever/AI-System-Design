<div id="lstnumberx27" class="ltx_listingline"><span id="lstnumberx27.1" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">Determine</span><span id="lstnumberx27.2" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.3" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">which</span><span id="lstnumberx27.4" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.5" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">reward</span><span id="lstnumberx27.6" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.7" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">condition</span><span id="lstnumberx27.8" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.9" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx27.10" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.11" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">next</span><span id="lstnumberx27.12" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.13" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">observation</span><span id="lstnumberx27.14" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.15" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">meets</span><span id="lstnumberx27.16" class="ltx_text" style="font-size:80%;">,</span><span id="lstnumberx27.17" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.18" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx27.19" class="ltx_text ltx_lst_space" style="font-size:8