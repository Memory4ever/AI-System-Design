</div>
<div id="lstnumberx78" class="ltx_listingline"><span id="lstnumberx78.1" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">Determine</span><span id="lstnumberx78.2" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.3" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">which</span><span id="lstnumberx78.4" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.5" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">reward</span><span id="lstnumberx78.6" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.7" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">condition</span><span id="lstnumberx78.8" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.9" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx78.10" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.11" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">next</span><span id="lstnumberx78.12" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.13" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">observation</span><span id="lstnumberx78.14" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.15" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">meets</span><span id="lstnumberx78.16" class="ltx_text" style="font-size:80%;">,</span><span id="lstnumberx78.17" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.18" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx78.19" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.20" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">respond</span><span id="lstnumberx78.21" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.22" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx78.23" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.24" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">corresponding</span><span id="lstnumberx78.25" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.26" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">reward</span><span id="lstnumberx78.27" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.28" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx78.29" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.30" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">terminal</span><span id="lstnumberx78.31" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx78.32" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">status</span><span id="lstnumberx78.33" class="ltx_text" style="font-size:80%;">:</span>
