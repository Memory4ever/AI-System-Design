</div>
<div id="lstnumberx80" class="ltx_listingline"><span id="lstnumberx80.1" class="ltx_text ltx_lst_space" style="font-size:80%;">    </span><span id="lstnumberx80.2" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx80.3" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx80.5" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.6" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">observation</span><span id="lstnumberx80.7" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.8" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">is</span><span id="lstnumberx80.9" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.10" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">not</span><span id="lstnumberx80.11" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.12" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx80.13" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.14" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">same</span><span id="lstnumberx80.15" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.16" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">as</span><span id="lstnumberx80.17" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.18" class="ltx_text" style="font-size:80%;">&lt;</span><span id="lstnumberx80.19" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">REWARD</span><span id="lstnumberx80.20" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.21" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">LOCATION</span><span id="lstnumberx80.22" class="ltx_text" style="font-size:80%;">&gt;</span><span id="lstnumberx80.23" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.24" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx80.25" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.26" class="ltx_text" style="font-size:80%;">0</span><span id="lstnumberx80.27" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.28" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx80.29" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx80.30" class="ltx_text ltx_lst_keyword" style="font-size:80%;--ltx-fg-color:#000000;">False</span>
</div>
