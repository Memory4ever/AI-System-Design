<div id="lstnumberx76" class="ltx_listingline"><span id="lstnumberx76.1" class="ltx_text ltx_lst_space" style="font-size:80%;">    </span><span id="lstnumberx76.2" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx76.3" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx76.5" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.6" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">location</span><span id="lstnumberx76.7" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.8" class="ltx_text" style="font-size:80%;">[0,0]</span><span id="lstnumberx76.9" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.10" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">is</span><span id="lstnumberx76.11" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.12" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx76.13" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.14" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">bottom</span><span id="lstnumberx76.15" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx76.16" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">left</span><span id="lstnumberx76.17" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.18" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">corner</span><span id="lstnumberx76.19" class="ltx_text" style="font-size:80%;">,</span><span id="lstnumberx76.20" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.21" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx76.22" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.23" class="ltx_text" style="font-size:80%;">[&lt;</span><span id="lstnumberx76.24" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">n</span><span id="lstnumberx76.25" class="ltx_text" style="font-size:80%;">-1&gt;,&lt;</span><span id="lstnumberx76.26" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">n</span><span id="lstnumberx76.27" class="ltx_text" style="font-size:80%;">-1&gt;]</span><span id="lstnumberx76.28" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.29" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">it</span><span id="lstnumberx76.30" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.31" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx76.32" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.33" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">top</span><span id="lstnumberx76.34" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx76.35" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">right</span><span id="lstnumberx76.36" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx76.37" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">corner</span><span id="lstnumberx76.38" class="ltx_text" style="font-size:80%;">.</span>
</div>
