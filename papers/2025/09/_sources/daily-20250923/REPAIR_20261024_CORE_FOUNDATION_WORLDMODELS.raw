<div id="lstnumberx28" class="ltx_listingline"><span id="lstnumberx28.1" class="ltx_text ltx_lst_space" style="font-size:80%;">    </span><span id="lstnumberx28.2" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx28.3" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx28.5" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.6" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">observation</span><span id="lstnumberx28.7" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.8" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">is</span><span id="lstnumberx28.9" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.10" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx28.11" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.12" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">same</span><span id="lstnumberx28.13" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.14" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">as</span><span id="lstnumberx28.15" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.16" class="ltx_text" style="font-size:80%;">&lt;</span><span id="lstnumberx28.17" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">REWARD_LOCATION</span><span id="lstnumberx28.18" class="ltx_text" style="font-size:80%;">&gt;</span><span id="lstnumberx28.19" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.20" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx28.21" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.22" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx28.23" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.24" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">key</span><span id="lstnumberx28.25" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.26" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">was</span><span id="lstnumberx28.27" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.28" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">acquired</span><span id="lstnumberx28.29" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.30" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx28.31" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.32" class="ltx_text" style="font-size:80%;">1</span><span id="lstnumberx28.33" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.34" class="ltx_text ltx_lst_keyword" style="font-size:80%;--ltx-fg-color:#000000;">True</span>
</div>
<div id="lstnumberx29" class="ltx_listingline"><span id="lstnumberx29.1" class="ltx_text ltx_lst_space" style="font-size:80%;">    </span><span id="lstnumberx29.2" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx29.3" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx29.5" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.6" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">observation</span><span id="lstnumberx29.7" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.8" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">is</span><span id="lstnumberx29.9" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.10" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">not</span><span id="lstnumberx29.11" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.12" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx29.13" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.14" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">same</span><span id="lstnumberx29.15" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.16" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">as</span><span id="lstnumberx29.17" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.18" class="ltx_text" style="font-size:80%;">&lt;</span><span id="lstnumberx29.19" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">REWARD_LOCATION</span><span id="lstnumberx29.20" class="ltx_text" style="font-size:80%;">&gt;</span><span id="lstnumberx29.21" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.22" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">or</span><span id="lstnumberx29.23" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.24" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx29.25" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.26" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">key</span><span id="lstnumberx29.27" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.28" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">was</span><span id="lstnumberx29.29" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.30" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">not</span><span id="lstnumberx29.31" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.32" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">acquired</span><span id="lstnumberx29.33" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.34" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx29.35" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.36" class="ltx_text" style="font-size:80%;">0</span><span id="lstnumberx29.37" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.38" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx29.39" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.40" class="ltx_text ltx_lst_keyword" style="font-size:80%;--ltx-fg-color:#000000;">False</span>
</div>
