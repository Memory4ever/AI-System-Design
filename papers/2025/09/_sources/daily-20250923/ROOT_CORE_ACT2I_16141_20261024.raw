<span id="A1.T2.2.1.2.1" class="ltx_inline-block ltx_align_top" style="width:69.0pt;">
<span id="A1.T2.2.1.2.1.1" class="ltx_p"><span id="A1.T2.2.1.2.1.1.1" class="ltx_text ltx_font_bold">Definition</span></span>
</span></th>
<th id="A1.T2.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:1pt 3.0pt;">
<span id="A1.T2.2.1.3.1" class="ltx_inline-block ltx_align_top">
