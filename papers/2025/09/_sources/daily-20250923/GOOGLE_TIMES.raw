        <div class="
          dynamic_media__item
          glue-grid__col
          glue-grid__col--span-4-sm
          
            glue-grid__col--span-12-md
          
          
            glue-grid__col--span-12-lg
          
        ">
          <div class="">
            



  
    





    <!-- Determine the appropriate width based on image_width -->
    
        
    


<!-- For mobile images, use a default width -->


<picture class="media__image media__image">
    
    
        <source media="(min-width: 768px)" srcset="https://storage.googleapis.com/gweb-research2023-media/images/TimeSeriesFM-1-Prompting.width-1250.png" alt="Comparison of few-shot prompting of an LLM (left) with few-shot prompting of a time-series foundation model using an arbitrary number of related in-context time series examples (right)." />
    
    <img src="https://storage.googleapis.com/gweb-research2023-media/images/TimeSeriesFM-1-Prompting.width-1250.png" alt="Comparison of few-shot prompting of an LLM (left) with few-shot prompting of a time-series foundation model using an arbitrary number of related in-context time series examples (right)." loading="lazy" />
    
</picture>
  


          </div>
