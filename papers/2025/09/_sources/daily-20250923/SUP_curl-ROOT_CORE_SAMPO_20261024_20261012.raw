<td id="S4.T1.4.4.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.4.4.3.1" class="ltx_text" style="font-size:90%;">-</span></td>
<td id="S4.T1.4.4.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.4.4.4.1" class="ltx_text" style="font-size:90%;">-</span></td>
<td id="S4.T1.4.4.5" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.4.4.5.1" class="ltx_text" style="font-size:90%;">-</span></td>
<th id="S4.T1.4.4.6" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.4.4.6.1" class="ltx_text" style="font-size:90%;">FitVid <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite></span></th>
<td id="S4.T1.4.4.7" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.4.4.7.1" class="ltx_text" style="font-size:90%;">62.5</span></td>
