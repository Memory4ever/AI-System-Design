<td id="S4.T1.4.1.3" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.4.1.3.1" class="ltx_text" style="font-size:90%;">PSNR↑</span></td>
