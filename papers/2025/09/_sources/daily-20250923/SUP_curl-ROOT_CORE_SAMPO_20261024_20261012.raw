<td id="S4.T1.4.3.9" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.4.3.9.1" class="ltx_text" style="font-size:90%;">80.5</span></td>
<td id="S4.T1.4.3.10" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.4.3.10.1" class="ltx_text" style="font-size:90%;">4.2</span></td></tr>
<tr id="S4.T1.4.4" class="ltx_tr">
<th id="S4.T1.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.4.4.1.1" class="ltx_text" style="font-size:90%;">FitVid <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite></span></th>
