        <span id="alg1.l8.3" class="ltx_text ltx_font_bold" style="font-size:90%;">until</span><span id="alg1.l8.4" class="ltx_text" style="font-size:90%;"> converged
</span>
</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Random Replacement Sampling</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
          
          
        <math id="alg2.l1.m1" class="ltx_Math" alttext="\boldsymbol{x}_{T}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">T</mi></msub><mo mathsize="0.900em">∼</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒩</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">𝟎</mn><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝐈</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{x}_{T}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math><span id="alg2.l1.3" class="ltx_text" style="font-size:90%;">
</span>
</div>
