<td id="S4.T2.2.1.2.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S4.T2.2.1.2.3.1" class="ltx_text" style="font-size:90%;">37.53/0.880</span></td>
<td id="S4.T2.2.1.2.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S4.T2.2.1.2.4.1" class="ltx_text" style="font-size:90%;">37.54/0.879</span></td>
