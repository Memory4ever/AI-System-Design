<div id="alg1.l7" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
          
          
        <math id="alg1.l7.m1" class="ltx_Math" alttext="\hskip 18.49988pt\nabla_{fb}\left\|\boldsymbol{x}_{0}-f_{b}(\sqrt{\bar{\alpha}_{t}}\boldsymbol{x}_{0}+\sqrt{1-\bar{\alpha}_{t}}{\boldsymbol{\epsilon}},\boldsymbol{x}_{0},t)\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mo mathsize="0.900em">∇</mo><mrow><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">b</mi></mrow></msub><mrow><mo>‖</mo><mrow><msub><mi mathsize="0.900em">𝒙</mi><mn mathsize="0.900em">0</mn></msub><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">b</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><msqrt><msub><mover accent="true"><mi mathsize="0.900em">α</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝒙</mi><mn mathsize="0.900em">0</mn></msub></mrow><mo mathsize="0.900em">+</mo><mrow><msqrt><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msub><mover accent="true"><mi mathsize="0.900em">α</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathsize="0.900em" mathvariant="bold-italic">ϵ</mi></mrow></mrow><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝒙</mi><mn mathsize="0.900em">0</mn></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">\hskip 18.49988pt\nabla_{fb}\left\|\boldsymbol{x}_{0}-f_{b}(\sqrt{\bar{\alpha}_{t}}\boldsymbol{x}_{0}+\sqrt{1-\bar{\alpha}_{t}}{\boldsymbol{\epsilon}},\boldsymbol{x}_{0},t)\right\|</annotation></semantics></math><span id="alg1.l7.3" class="ltx_text" style="font-size:90%;">
</span>
</div>
