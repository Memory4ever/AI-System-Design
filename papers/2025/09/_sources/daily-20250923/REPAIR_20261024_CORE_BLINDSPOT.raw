<th id="S4.T2.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T2.2.1.1.2.1" class="ltx_text" style="font-size:90%;">PUCA</span></th>
<th id="S4.T2.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T2.2.1.1.3.1" class="ltx_text" style="font-size:90%;">PUCA (</span><math id="S4.T2.m1" class="ltx_Math" alttext="R^{3},T=8" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathsize="0.900em">R</mi><mn mathsize="0.900em">3</mn></msup><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">T</mi></mrow><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">8</mn></mrow><annotation encoding="application/x-tex">R^{3},T=8</annotation></semantics></math><span id="S4.T2.2.1.1.3.2" class="ltx_text" style="font-size:90%;">)</span></th>
<th id="S4.T2.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T2.2.1.1.4.1" class="ltx_text" style="font-size:90%;">PUCA (</span><math id="S4.T2.m2" class="ltx_Math" alttext="R^{3},T=64" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathsize="0.900em">R</mi><mn mathsize="0.900em">3</mn></msup><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">T</mi></mrow><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">64</mn></mrow><annotation encoding="application/x-tex">R^{3},T=64</annotation></semantics></math><span id="S4.T2.2.1.1.4.2" class="ltx_text" style="font-size:90%;">)</span></th>
<th id="S4.T2.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T2.2.1.1.5.1" class="ltx_text" style="font-size:90%;">Ours(w/o guidance)</span></th>
