        <span id="alg2.l2.3" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg2.l2.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l2.m1" class="ltx_Math" alttext="t=T,\dotsc,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">T</mi></mrow><mo mathsize="0.900em">,</mo><mi mathvariant="normal">…</mi><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">1</mn></mrow><annotation encoding="application/x-tex">t=T,\dotsc,1</annotation></semantics></math><span id="alg2.l2.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l2.6" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg2.l2.7" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l3" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
          
          
        <span id="alg2.l3.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l3.m1" class="ltx_Math" alttext="z\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">z</mi><mo mathsize="0.900em">∼</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒩</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">𝟎</mn><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝐈</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math><span id="alg2.l3.4" class="ltx_text" style="font-size:90%;"> if </span><math id="alg2.l3.m2" class="ltx_Math" alttext="t&gt;1" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">&gt;</mo><mn mathsize="0.900em">1</mn></mrow><annotation encoding="application/x-tex">t&gt;1</annotation></semantics></math><span id="alg2.l3.5" class="ltx_text" style="font-size:90%;">, else </span><math id="alg2.l3.m3" class="ltx_Math" alttext="z=\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">z</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">𝟎</mn></mrow><annotation encoding="application/x-tex">z=\mathbf{0}</annotation></semantics></math><span id="alg2.l3.6" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l4" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
          
          
        <span id="alg2.l4.3" class="ltx_text" style="font-size:90%;">  pixelshuffle </span><math id="alg2.l4.m1" class="ltx_Math" alttext="\boldsymbol{x}_{t}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><annotation encoding="application/x-tex">\boldsymbol{x}_{t}</annotation></semantics></math><span id="alg2.l4.4" class="ltx_text" style="font-size:90%;"> if </span><math id="alg2.l4.m2" class="ltx_Math" alttext="t=T" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">T</mi></mrow><annotation encoding="application/x-tex">t=T</annotation></semantics></math><span id="alg2.l4.5" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l5" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
          
          
        <span id="alg2.l5.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l5.m1" class="ltx_Math" alttext="\epsilon_{\theta}(\boldsymbol{x}_{t})=\frac{\boldsymbol{x}_{t}-\sqrt{\alpha_{t}}\cdot f_{\theta}(\boldsymbol{x}_{t},t)}{\sqrt{1-\alpha_{t}}},\theta\in[u,b]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi mathsize="0.900em">ϵ</mi><mi mathsize="0.900em">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mfrac><mrow><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">−</mo><mrow><mrow><msqrt><msub><mi mathsize="0.900em">α</mi><mi mathsize="0.900em">t</mi></msub></msqrt><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><msub><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="1.280em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><msqrt><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">α</mi><mi mathsize="0.900em">t</mi></msub></mrow></msqrt></mfrac></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">θ</mi><mo mathsize="0.900em">∈</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em">u</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">b</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon_{\theta}(\boldsymbol{x}_{t})=\frac{\boldsymbol{x}_{t}-\sqrt{\alpha_{t}}\cdot f_{\theta}(\boldsymbol{x}_{t},t)}{\sqrt{1-\alpha_{t}}},\theta\in[u,b].</annotation></semantics></math><span id="alg2.l5.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
          
          
        <span id="alg2.l6.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l6.m1" class="ltx_Math" alttext="\epsilon(\boldsymbol{x}_{t})=(1-w)\epsilon_{fb}(\boldsymbol{x}_{t},\boldsymbol{x}_{0})+w\epsilon_{fu}(\boldsymbol{x}_{t})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathsize="0.900em">ϵ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">w</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">ϵ</mi><mrow><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">b</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝒙</mi><mn mathsize="0.900em">0</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">w</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">ϵ</mi><mrow><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em" mathsize="0.900em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon(\boldsymbol{x}_{t})=(1-w)\epsilon_{fb}(\boldsymbol{x}_{t},\boldsymbol{x}_{0})+w\epsilon_{fu}(\boldsymbol{x}_{t}).</annotation></semantics></math><span id="alg2.l6.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
          
          
        <span id="alg2.l7.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l7.m1" class="ltx_Math" alttext="\boldsymbol{x}_{0}|\boldsymbol{x}_{t}=\frac{\boldsymbol{x}_{t}-\sqrt{1-\alpha_{t}}\cdot\epsilon(\boldsymbol{x}_{t})}{\sqrt{\alpha_{t}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝒙</mi><mn mathsize="0.900em">0</mn></msub><mo fence="false">|</mo><mrow><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">=</mo><mfrac><mrow><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">−</mo><mrow><msqrt><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">α</mi><mi mathsize="0.900em">t</mi></msub></mrow></msqrt><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><mrow><mi mathsize="0.900em">ϵ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><msqrt><msub><mi mathsize="0.900em">α</mi><mi mathsize="0.900em">t</mi></msub></msqrt></mfrac></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{x}_{0}|\boldsymbol{x}_{t}=\frac{\boldsymbol{x}_{t}-\sqrt{1-\alpha_{t}}\cdot\epsilon(\boldsymbol{x}_{t})}{\sqrt{\alpha_{t}}}</annotation></semantics></math><span id="alg2.l7.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
          
          
        <span id="alg2.l8.3" class="ltx_text" style="font-size:90%;">  replace </span><math id="alg2.l8.m1" class="ltx_Math" alttext="\boldsymbol{x}_{0}|\boldsymbol{x}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝒙</mi><mn mathsize="0.900em">0</mn></msub><mo fence="false">|</mo><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{x}_{0}|\boldsymbol{x}_{t}</annotation></semantics></math><span id="alg2.l8.4" class="ltx_text" style="font-size:90%;"> with </span><math id="alg2.l8.m2" class="ltx_Math" alttext="\boldsymbol{x}_{0}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">𝒙</mi><mn mathsize="0.900em">0</mn></msub><annotation encoding="application/x-tex">\boldsymbol{x}_{0}</annotation></semantics></math><span id="alg2.l8.5" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l9" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
          
          
        <span id="alg2.l9.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l9.m1" class="ltx_Math" alttext="\boldsymbol{x}_{t-1}=\sqrt{1-\alpha_{t-1}-\sigma_{t}^{2}}\cdot\epsilon(\boldsymbol{x}_{t})\hskip 9.24994pt+\sqrt{\alpha_{t-1}}\boldsymbol{x}_{0}|\boldsymbol{x}_{t}+\sigma_{t}\mathbf{z}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathsize="0.900em">𝒙</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">=</mo><mrow><mrow><msqrt><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">α</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">σ</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">2</mn></msubsup></mrow></msqrt><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><mrow><mi mathsize="0.900em">ϵ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em" rspace="0.930em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msqrt><msub><mi mathsize="0.900em">α</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝒙</mi><mn mathsize="0.900em">0</mn></msub></mrow></mrow></mrow><mo fence="false">|</mo><mrow><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">σ</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">𝐳</mi></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{x}_{t-1}=\sqrt{1-\alpha_{t-1}-\sigma_{t}^{2}}\cdot\epsilon(\boldsymbol{x}_{t})\hskip 9.24994pt+\sqrt{\alpha_{t-1}}\boldsymbol{x}_{0}|\boldsymbol{x}_{t}+\sigma_{t}\mathbf{z},</annotation></semantics></math><span id="alg2.l9.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l10" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
          
          
        <span id="alg2.l10.3" class="ltx_text" style="font-size:90%;">  pixelunshuffle </span><math id="alg2.l10.m1" class="ltx_Math" alttext="\boldsymbol{x}_{t}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi></msub><annotation encoding="application/x-tex">\boldsymbol{x}_{t}</annotation></semantics></math><span id="alg2.l10.4" class="ltx_text" style="font-size:90%;"> if </span><math id="alg2.l10.m2" class="ltx_Math" alttext="t&lt;T" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">&lt;</mo><mi mathsize="0.900em">T</mi></mrow><annotation encoding="application/x-tex">t&lt;T</annotation></semantics></math><span id="alg2.l10.5" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
          <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
          
          
        <span id="alg2.l11.3" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l11.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l11.5" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span>
</div>
