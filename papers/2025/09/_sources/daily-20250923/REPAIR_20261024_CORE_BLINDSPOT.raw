<th id="S4.T2.2.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T2.2.1.1.7.1" class="ltx_text" style="font-size:90%;">Ours</span></th></tr>
</thead>
