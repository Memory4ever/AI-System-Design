<td id="S4.T2.2.1.2.6" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S4.T2.2.1.2.6.1" class="ltx_text" style="font-size:90%;">36.58/0.877</span></td>
<td id="S4.T2.2.1.2.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_t"><span id="S4.T2.2.1.2.7.1" class="ltx_text" style="font-size:90%;">37.90/0.887</span></td></tr>
