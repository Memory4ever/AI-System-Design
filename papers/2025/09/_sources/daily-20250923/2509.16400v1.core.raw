<th id="A5.T1.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A5.T1.2.1.2.1" class="ltx_text ltx_font_bold">Prompt Type</span></th>
<th id="A5.T1.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A5.T1.2.1.3.1" class="ltx_text ltx_font_bold">Grouping Factor</span></th>
