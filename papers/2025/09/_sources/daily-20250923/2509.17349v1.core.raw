<td id="S5.T4.2.1.11.4" class="ltx_td ltx_align_center">0.97</td>
<td id="S5.T4.2.1.11.5" class="ltx_td ltx_align_center"><span id="S5.T4.2.1.11.5.1" class="ltx_text ltx_underline">0.98</span></td>
<td id="S5.T4.2.1.11.6" class="ltx_td ltx_align_center"><span id="S5.T4.2.1.11.6.1" class="ltx_text ltx_font_bold">0.99</span></td>
<td id="S5.T4.2.1.11.7" class="ltx_td ltx_align_center">0.74</td>
<td id="S5.T4.2.1.11.8" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T4.2.1.11.8.1" class="ltx_text ltx_font_bold">0.99</span></td>
<td id="S5.T4.2.1.11.9" class="ltx_td ltx_align_right">461</td></tr>
