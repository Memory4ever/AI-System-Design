<td id="S5.T4.2.1.10.5" class="ltx_td ltx_align_center"><span id="S5.T4.2.1.10.5.1" class="ltx_text ltx_underline">0.97</span></td>
<td id="S5.T4.2.1.10.6" class="ltx_td ltx_align_center"><span id="S5.T4.2.1.10.6.1" class="ltx_text ltx_underline">0.97</span></td>
<td id="S5.T4.2.1.10.7" class="ltx_td ltx_align_center">0.72</td>
<td id="S5.T4.2.1.10.8" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T4.2.1.10.8.1" class="ltx_text ltx_font_bold">0.98</span></td>
<td id="S5.T4.2.1.10.9" class="ltx_td ltx_align_right">523</td></tr>
