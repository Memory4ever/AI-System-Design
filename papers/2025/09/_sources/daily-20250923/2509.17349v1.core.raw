<td id="S5.T4.2.1.12.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T4.2.1.12.5.1" class="ltx_text ltx_underline">0.85</span></td>
<td id="S5.T4.2.1.12.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T4.2.1.12.6.1" class="ltx_text ltx_underline">0.82</span></td>
