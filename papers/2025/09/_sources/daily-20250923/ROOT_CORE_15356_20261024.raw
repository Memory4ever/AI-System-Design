<figure id="A1.F21.sf4" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2509.15356v1/threshold_mistral.svg" id="A1.F21.sf4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/358;" width="476" height="358"></object>
