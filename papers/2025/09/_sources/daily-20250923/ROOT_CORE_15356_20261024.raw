<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Dataset Descriptions, Sources, and Artifacts</h3>

<figure id="A1.SS1.tab1" class="ltx_table">
<div id="A1.SS1.tab1.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:293.6pt;vertical-align:-145.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-66.3pt,56.4pt) scale(0.722234243530582,0.722234243530582) ;">
<table id="A1.SS1.tab1.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A1.SS1.tab1.1.1.1" class="ltx_tr">
<th id="A1.SS1.tab1.1.1.1.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
