<figure id="S4.F6.sf1" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2509.15356v1/base_auc_auc_gpt.svg" id="S4.F6.sf1.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/451;" width="476" height="451"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(a) </span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S4.F6.sf2" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2509.15356v1/base_auc_auc_llama.svg" id="S4.F6.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/451;" width="476" height="451"></object>
