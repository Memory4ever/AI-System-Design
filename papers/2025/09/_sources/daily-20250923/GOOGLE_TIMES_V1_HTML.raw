<td id="A1.T1.5.1.19.3" class="ltx_td ltx_align_right">22,435</td>
<td id="A1.T1.5.1.19.4" class="ltx_td ltx_align_right">16,585,438</td></tr>
<tr id="A1.T1.5.1.20" class="ltx_tr">
