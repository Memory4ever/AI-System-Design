{"data":{"id":"10.48550/arxiv.2509.15476","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.15476","prefix":"10.48550","suffix":"arxiv.2509.15476","identifiers":[{"identifier":"2509.15476","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.15476"}],"creators":[{"name":"Li, Zhu","nameType":"Personal","givenName":"Zhu","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Xiyuan","nameType":"Personal","givenName":"Xiyuan","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yuqing","nameType":"Personal","givenName":"Yuqing","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Nayak, Shekhar","nameType":"Personal","givenName":"Shekhar","familyName":"Nayak","affiliation":[],"nameIdentifiers":[]},{"name":"Coler, Matt","nameType":"Personal","givenName":"Matt","familyName":"Coler","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating Multimodal Large Language Models on Spoken Sarcasm Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Multimedia (cs.MM)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-18T22:44:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-22T00:11:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-18T14:02:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-20T01:21:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Sarcasm detection remains challenging because sarcastic intent often depends on information across text, speech, and vision. We systematically evaluate large language models (LLMs) and multimodal LLMs (MLLMs) for sarcasm detection on English (MUStARD++) and Chinese (MCSD), considering both feature-extraction settings and direct classification. In the feature-extraction settings, audio provides the strongest unimodal performance on both datasets, while multimodal fusion shows dataset-dependent benefits. In direct classification, Qwen2.5-Omni achieves the strongest zero-shot performance among the evaluated models, with further substantial gains after fine-tuning. Error analysis further shows that additional modalities can both correct and introduce errors, highlighting the need for selective multimodal integration.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.15476","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-22T01:40:34.000Z","registered":"2025-09-22T01:40:34.000Z","published":"2025","updated":"2026-10-20T05:15:11.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.15476","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}