<div id="S4.T1.4.2.8.1" class="ltx_inline-block ltx_align_center ltx_align_top ltx_transformed_outer" style="width:6.8pt;height:25.1pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:25.1pt;transform:translate(-9.2pt,-9.2pt) rotate(-90deg) ;">
<p id="S4.T1.4.2.8.1.1" class="ltx_p">MME</p>
</span></div></th>
<th id="S4.T1.4.2.9" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_column" style="padding:1pt 0.1pt;">
<div id="S4.T1.4.2.9.1" class="ltx_inline-block ltx_align_center ltx_align_top ltx_transformed_outer" style="width:6.8pt;height:25.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:25.4pt;transform:translate(-9.3pt,-9.3pt) rotate(-90deg) ;">
<p id="S4.T1.4.2.9.1.1" class="ltx_p">MMB</p>
