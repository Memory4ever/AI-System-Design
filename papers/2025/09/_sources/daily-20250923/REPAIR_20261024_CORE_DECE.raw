<td id="A3.T3.2.10.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0.39</td>
<td id="A3.T3.2.10.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="A3.T3.m7" class="ltx_Math" alttext="&lt;0.05" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">&lt;0.05</annotation></semantics></math></td>
