</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 17.24)"><foreignObject style="--ltx-fo-width:43.85em;--ltx-fo-height:15.09em;--ltx-fo-depth:0.25em;font-size:10pt;" height="212.21" overflow="visible" transform="matrix(1 0 0 -1 0 208.75)" width="606.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
