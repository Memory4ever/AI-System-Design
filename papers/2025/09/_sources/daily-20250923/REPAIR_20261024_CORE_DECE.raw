<td id="A3.T3.2.9.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><math id="A3.T3.m6" class="ltx_Math" alttext="&lt;0.05" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">&lt;0.05</annotation></semantics></math></td>
<td id="A3.T3.2.9.5" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">100</td></tr>
