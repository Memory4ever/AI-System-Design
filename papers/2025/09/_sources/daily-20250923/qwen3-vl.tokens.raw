on\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/complex_instruction_following7.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/judge1.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/judge2.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/judge3.json\" hide=true next=true scroll=true >}}\n{{< /datablock >}}","attributes":{},"children":[{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_instruction_following1.json\" hide=false next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"false","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_instruction_following1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_instruction_following2.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_instruction_following2.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_instruction_following3.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_instruction_following3.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_instruction_following4.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_instruction_following4.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_instruction_following5.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_instruction_following5.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_instruction_following7.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_instruction_following7.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/judge1.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/judge1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/judge2.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/judge2.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/judge3.json\" hide=true next=true scroll=true >}}","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/judge3.json"}],"class":"example-container"},{"type":"space","raw":"\n\n"},{"type":"hr","raw":"---"},{"type":"space","raw":"\n\n"},{"type":"heading","raw":"### 10. Complex Document Understanding & General Parsing  \n","depth":3,"text":"10. Complex Document Understanding & General Parsing","tokens":[{"type":"text","raw":"10. Complex Document Understanding & General Parsing","text":"10. Complex Document Understanding & General Parsing","escaped":false}]},{"type":"paragraph","raw":"Qwen3-VL has enhanced support for long and multi-page documents. It can clearly understand extremely wide web layouts or PDFs with dozens of scanned pages. In addition to supporting QwenVL HTML parsing, it now introduces a new QwenVL Markdown format that preserves text, formulas, tables, and image positions using fewer tokens—improving processing speed and accuracy.","text":"Qwen3-VL has enhanced support for long and multi-page documents. It can clearly understand extremely wide web layouts or PDFs with dozens of scanned pages. In addition to supporting QwenVL HTML parsing, it now introduces a new QwenVL Markdown format that preserves text, formulas, tables, and image positions using fewer tokens—improving processing speed and accuracy.","tokens":[{"type":"text","raw":"Qwen3-VL has enhanced support for long and multi-page documents. It can clearly understand extremely wide web layouts or PDFs with dozens of scanned pages. In addition to supporting QwenVL HTML parsing, it now introduces a new QwenVL Markdown format that preserves text, formulas, tables, and image positions using fewer tokens—improving processing speed and accuracy.","text":"Qwen3-VL has enhanced support for long and multi-page documents. It can clearly understand extremely wide web layouts or PDFs with dozens of scanned pages. In addition to supporting QwenVL HTML parsing, it now introduces a new QwenVL Markdown format that preserves text, formulas, tables, and image positions using fewer tokens—improving processing speed and accuracy.","escaped":false}]},{"type":"space","raw":"\n\n"},{"type":"demo","name":"datablock","raw":"{{< datablock type=\"demo\" class=\"example-container\" >}}\n{{< data src=\"./demos/omniparsing_kie1.json\" hide=false next=true scroll=true >}}\n{{< data src=\"./demos/omniparsing_kie2.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/omniparsing_qwenvl_html1.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/omniparsing_qwenvl_markdown1.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/omniparsing_qwenvl_markdown2.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/complex_doc_understanding1.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/complex_doc_understanding2.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/complex_doc_understanding3.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/complex_doc_understanding5.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/complex_doc_understanding6.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/complex_doc_understanding7.json\" hide=true next=true scroll=true >}}\n{{< /datablock >}}","attributes":{},"children":[{"type":"data","name":"data","raw":"{{< data src=\"./demos/omniparsing_kie1.json\" hide=false next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"false","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/omniparsing_kie1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/omniparsing_kie2.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/omniparsing_kie2.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/omniparsing_qwenvl_html1.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/omniparsing_qwenvl_html1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/omniparsing_qwenvl_markdown1.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/omniparsing_qwenvl_markdown1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/omniparsing_qwenvl_markdown2.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/omniparsing_qwenvl_markdown2.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_doc_understanding1.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_doc_understanding1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_doc_understanding2.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_doc_understanding2.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_doc_understanding3.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_doc_understanding3.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_doc_understanding5.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_doc_understanding5.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_doc_understanding6.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_doc_understanding6.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/complex_doc_understanding7.json\" hide=true next=true scroll=true >}}","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/complex_doc_understanding7.json"}],"class":"example-container"},{"type":"space","raw":"\n\n"},{"type":"hr","raw":"---"},{"type":"space","raw":"\n\n"},{"type":"heading","raw":"### 11. Multilingual OCR & Visual Question Answering  \n","depth":3,"text":"11. Multilingual OCR & Visual Question Answering","tokens":[{"type":"text","raw":"11. Multilingual OCR & Visual Question Answering","text":"11. Multilingual OCR & Visual Question Answering","escaped":false}]},{"type":"paragraph","raw":"Qwen3-VL now supports OCR in 32 languages—up from 10—including Greek, Hebrew, Hindi, Romanian, and Thai. This improvement helps meet diverse regional needs and enables smoother multilingual conversations and document processing.","text":"Qwen3-VL now supports OCR in 32 languages—up from 10—including Greek, Hebrew, Hindi, Romanian, and Thai. This improvement helps meet diverse regional needs and enables smoother multilingual conversations and document processing.","tokens":[{"type":"text","raw":"Qwen3-VL now supports OCR in 32 languages—up from 10—including Greek, Hebrew, Hindi, Romanian, and Thai. This improvement helps meet diverse regional needs and enables smoother multilingual conversations and document processing.","text":"Qwen3-VL now supports OCR in 32 languages—up from 10—including Greek, Hebrew, Hindi, Romanian, and Thai. This improvement helps meet diverse regional needs and enables smoother multilingual conversations and document processing.","escaped":false}]},{"type":"space","raw":"\n\n"},{"type":"demo","name":"datablock","raw":"{{< datablock type=\"demo\" class=\"example-container\" >}}\n{{< data src=\"./demos/multilingual_ocr_Greek.json\" hide=false next=true scroll=true >}}\n{{< data src=\"./demos/multilingual_ocr_Hebrew.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multilingual_ocr_Hindi.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multilingual_ocr_Romanian.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multilingual_ocr_Thai.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multilingual_vqa_Arabic.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multilingual_vqa_Spanish.json\" hide=true next=true scroll=true >}}\n{{< /datablock >}}","attributes":{},"children":[{"type":"data","name":"data","raw":"{{< data src=\"./demos/multilingual_ocr_Greek.json\" hide=false next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"false","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multilingual_ocr_Greek.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multilingual_ocr_Hebrew.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multilingual_ocr_Hebrew.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multilingual_ocr_Hindi.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multilingual_ocr_Hindi.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multilingual_ocr_Romanian.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multilingual_ocr_Romanian.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multilingual_ocr_Thai.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multilingual_ocr_Thai.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multilingual_vqa_Arabic.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multilingual_vqa_Arabic.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multilingual_vqa_Spanish.json\" hide=true next=true scroll=true >}}","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multilingual_vqa_Spanish.json"}],"class":"example-container"},{"type":"space","raw":"\n\n"},{"type":"hr","raw":"---"},{"type":"space","raw":"\n\n"},{"type":"heading","raw":"### 12. Multi-Image and Multi-Round Dialogue  \n","depth":3,"text":"12. Multi-Image and Multi-Round Dialogue","tokens":[{"type":"text","raw":"12. Multi-Image and Multi-Round Dialogue","text":"12. Multi-Image and Multi-Round Dialogue","escaped":false}]},{"type":"paragraph","raw":"Qwen3-VL handles multiple images more effectively—comparing differences, finding connections, and maintaining context across turns. It performs well in extended conversations, remembering earlier discussions and building upon them meaningfully.","text":"Qwen3-VL handles multiple images more effectively—comparing differences, finding connections, and maintaining context across turns. It performs well in extended conversations, remembering earlier discussions and building upon them meaningfully.","tokens":[{"type":"text","raw":"Qwen3-VL handles multiple images more effectively—comparing differences, finding connections, and maintaining context across turns. It performs well in extended conversations, remembering earlier discussions and building upon them meaningfully.","text":"Qwen3-VL handles multiple images more effectively—comparing differences, finding connections, and maintaining context across turns. It performs well in extended conversations, remembering earlier discussions and building upon them meaningfully.","escaped":false}]},{"type":"space","raw":"\n\n"},{"type":"demo","name":"datablock","raw":"{{< datablock type=\"demo\" class=\"example-container\" >}}\n{{< data src=\"./demos/multiimage_conversation1.json\" hide=false next=true scroll=true >}}\n{{< data src=\"./demos/multiimage_conversation2.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multiimage_conversation3.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multiimage_conversation4.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multiimage_conversation5.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multiimage_conversation7.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multiround_conversation1.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/multiround_conversation2.json\" hide=true next=true scroll=true >}}\n{{< /datablock >}}","attributes":{},"children":[{"type":"data","name":"data","raw":"{{< data src=\"./demos/multiimage_conversation1.json\" hide=false next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"false","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multiimage_conversation1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multiimage_conversation2.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multiimage_conversation2.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multiimage_conversation3.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multiimage_conversation3.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multiimage_conversation4.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multiimage_conversation4.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multiimage_conversation5.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multiimage_conversation5.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multiimage_conversation7.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multiimage_conversation7.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multiround_conversation1.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multiround_conversation1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/multiround_conversation2.json\" hide=true next=true scroll=true >}}","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/multiround_conversation2.json"}],"class":"example-container"},{"type":"space","raw":"\n\n"},{"type":"hr","raw":"---"},{"type":"space","raw":"\n\n"},{"type":"heading","raw":"### 13. Video Understanding  \n","depth":3,"text":"13. Video Understanding","tokens":[{"type":"text","raw":"13. Video Understanding","text":"13. Video Understanding","escaped":false}]},{"type":"paragraph","raw":"Qwen3-VL has stronger video comprehension, especially in pinpointing events over time and understanding long videos. It can describe content frame-by-frame and answer questions accurately—even for videos lasting over an hour and a half. It can even watch gameplay videos and generate corresponding game code.","text":"Qwen3-VL has stronger video comprehension, especially in pinpointing events over time and understanding long videos. It can describe content frame-by-frame and answer questions accurately—even for videos lasting over an hour and a half. It can even watch gameplay videos and generate corresponding game code.","tokens":[{"type":"text","raw":"Qwen3-VL has stronger video comprehension, especially in pinpointing events over time and understanding long videos. It can describe content frame-by-frame and answer questions accurately—even for videos lasting over an hour and a half. It can even watch gameplay videos and generate corresponding game code.","text":"Qwen3-VL has stronger video comprehension, especially in pinpointing events over time and understanding long videos. It can describe content frame-by-frame and answer questions accurately—even for videos lasting over an hour and a half. It can even watch gameplay videos and generate corresponding game code.","escaped":false}]},{"type":"space","raw":"\n\n"},{"type":"demo","name":"datablock","raw":"{{< datablock type=\"demo\" class=\"example-container\" >}}\n{{< data src=\"./demos/video_densecap1.json\" hide=false next=true scroll=true >}}\n{{< data src=\"./demos/video_long1.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/video_spatialgrounding1.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/video_think_densecap1.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/video_think_game2code1.json\" hide=true next=true scroll=true >}}\n{{< data src=\"./demos/video_think_reasoning1.json\" hide=true next=true scroll=true >}}\n{{< /datablock >}}","attributes":{},"children":[{"type":"data","name":"data","raw":"{{< data src=\"./demos/video_densecap1.json\" hide=false next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"false","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/video_densecap1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/video_long1.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/video_long1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/video_spatialgrounding1.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/video_spatialgrounding1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/video_think_densecap1.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/video_think_densecap1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/video_think_game2code1.json\" hide=true next=true scroll=true >}}\n","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/video_think_game2code1.json"},{"type":"data","name":"data","raw":"{{< data src=\"./demos/video_think_reasoning1.json\" hide=true next=true scroll=true >}}","attributes":{"scroll":"true"},"hide":"true","next":"true","src":"https://docs.qwenlm.ai/research/qwen3-vl/demos/video_think_reasoning1.json"}],"class":"example-container"},{"type":"space","raw":"\n\n\n\n\n"},{"type":"heading","raw":"## API Usage\n\n","depth":2,"text":"API Usage","tokens":[{"type":"text","raw":"API Usage","text":"API Usage","escaped":false}]},{"type":"paragraph","raw":"To experience the most powerful model in the Qwen3-VL series, `Qwen3-VL-235B-A22B`, you can directly use our official API and obtain your `DASHSCOPE_API_KEY` [here](https://help.aliyun.com/zh/model-studio/get-api-key). Below is a usage example:","text":"To experience the most powerful model in the Qwen3-VL series, `Qwen3-VL-235B-A22B`, you can directly use our official API and obtain your `DASHSCOPE_API_KEY` [here](https://help.aliyun.com/zh/model-studio/get-api-key). Below is a usage example:","tokens":[{"type":"text","raw":"To experience the most powerful model in the Qwen3-VL series, ","text":"To experience the most powerful model in the Qwen3-VL series, ","escaped":false},{"type":"codespan","raw":"`Qwen3-VL-235B-A22B`","text":"Qwen3-VL-235B-A22B"},{"type":"text","raw":", you can directly use our official API and obtain your ","text":", you can directly use our official API and obtain your ","escaped":false},{"type":"codespan","raw":"`DASHSCOPE_API_KEY`","text":"DASHSCOPE_API_KEY"},{"type":"text","raw":" ","text":" ","escaped":false},{"type":"link","raw":"[here](https://help.aliyun.com/zh/model-studio/get-api-key)","href":"https://help.aliyun.com/zh/model-studio/get-api-key","title":null,"text":"here","tokens":[{"type":"text","raw":"here","text":"here","escaped":false}]},{"type":"text","raw":". Below is a usage example:","text":". Below is a usage example:","escaped":false}]},{"type":"code","name":"code","src":"https://docs.qwenlm.ai/research/qwen3-vl/code/743353a1-e6e2-47ae-8481-9073856fa231.py","lang":"python","attributes":{},"raw":"{{< code src=\"./code/743353a1-e6e2-47ae-8481-9073856fa231.py\" lang=\"python\" >}}","tokens":[]},{"type":"paragraph","raw":"}}","text":"}}","tokens":[{"type":"text","raw":"}}","text":"}}","escaped":false}]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"You can find more usage examples [here](https://github.com/QwenLM/Qwen3-VL/tree/main/cookbooks).","text":"You can find more usage examples [here](https://github.com/QwenLM/Qwen3-VL/tree/main/cookbooks).","tokens":[{"type":"text","raw":"You can find more usage examples ","text":"You can find more usage examples ","escaped":false},{"type":"link","raw":"[here](https://github.com/QwenLM/Qwen3-VL/tree/main/cookbooks)","href":"https://github.com/QwenLM/Qwen3-VL/tree/main/cookbooks","title":null,"text":"here","tokens":[{"type":"text","raw":"here","text":"here","escaped":false}]},{"type":"text","raw":".","text":".","escaped":false}]},{"type":"space","raw":"\n\n"},{"type":"heading","raw":"## Summary\n\n","depth":2,"text":"Summary","tokens":[{"type":"text","raw":"Summary","text":"Summary","escaped":false}]},{"type":"paragraph","raw":"Qwen3-VL not only matches or even surpasses current top-tier closed-source models across multiple multimodal benchmarks, but more importantly, it genuinely integrates powerful text-only capabilities with visual understanding, eliminating any bias toward one modality. We have made substantial improvements in key areas including visual perception, spatial reasoning, long video comprehension, multilingual recognition, tool invocation, and code generation—enabling the model not just to \"see\", but to truly “understand, reason, and act\". The Qwen3-VL-235B-A22B model we are open-sourcing today aims to serve as a solid stepping stone for the community’s exploration of large models. Moving forward, we will continue striving to enable multimodal large models to genuinely comprehend events and relationships in the real world, ultimately functioning as reliable assistants capable of proactively completing tasks and solving problems in both digital and physical environments.\n","text":"Qwen3-VL not only matches or even surpasses current top-tier closed-source models across multiple multimodal benchmarks, but more importantly, it genuinely integrates powerful text-only capabilities with visual understanding, eliminating any bias toward one modality. We have made substantial improvements in key areas including visual perception, spatial reasoning, long video comprehension, multilingual recognition, tool invocation, and code generation—enabling the model not just to \"see\", but to truly “understand, reason, and act\". The Qwen3-VL-235B-A22B model we are open-sourcing today aims to serve as a solid stepping stone for the community’s exploration of large models. Moving forward, we will continue striving to enable multimodal large models to genuinely comprehend events and relationships in the real world, ultimately functioning as reliable assistants capable of proactively completing tasks and solving problems in both digital and physical environments.","tokens":[{"type":"text","raw":"Qwen3-VL not only matches or even surpasses current top-tier closed-source models across multiple multimodal benchmarks, but more importantly, it genuinely integrates powerful text-only capabilities with visual understanding, eliminating any bias toward one modality. We have made substantial improvements in key areas including visual perception, spatial reasoning, long video comprehension, multilingual recognition, tool invocation, and code generation—enabling the model not just to \"see\", but to truly “understand, reason, and act\". The Qwen3-VL-235B-A22B model we are open-sourcing today aims to serve as a solid stepping stone for the community’s exploration of large models. Moving forward, we will continue striving to enable multimodal large models to genuinely comprehend events and relationships in the real world, ultimately functioning as reliable assistants capable of proactively completing tasks and solving problems in both digital and physical environments.","text":"Qwen3-VL not only matches or even surpasses current top-tier closed-source models across multiple multimodal benchmarks, but more importantly, it genuinely integrates powerful text-only capabilities with visual understanding, eliminating any bias toward one modality. We have made substantial improvements in key areas including visual perception, spatial reasoning, long video comprehension, multilingual recognition, tool invocation, and code generation—enabling the model not just to \"see\", but to truly “understand, reason, and act\". The Qwen3-VL-235B-A22B model we are open-sourcing today aims to serve as a solid stepping stone for the community’s exploration of large models. Moving forward, we will continue striving to enable multimodal large models to genuinely comprehend events and relationships in the real world, ultimately functioning as reliable assistants capable of proactively completing tasks and solving problems in both digital and physical environments.","escaped":false}]}]