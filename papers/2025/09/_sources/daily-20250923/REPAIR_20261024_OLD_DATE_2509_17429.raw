{"data":{"id":"10.48550/arxiv.2509.17429","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17429","prefix":"10.48550","suffix":"arxiv.2509.17429","identifiers":[{"identifier":"2509.17429","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.17429"}],"creators":[{"name":"Zeng, Zhitao","nameType":"Personal","givenName":"Zhitao","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Yuan, Guojian","nameType":"Personal","givenName":"Guojian","familyName":"Yuan","affiliation":[],"nameIdentifiers":[]},{"name":"Mao, Junyuan","nameType":"Personal","givenName":"Junyuan","familyName":"Mao","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yuxuan","nameType":"Personal","givenName":"Yuxuan","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Jia, Xiaoshuang","nameType":"Personal","givenName":"Xiaoshuang","familyName":"Jia","affiliation":[],"nameIdentifiers":[]},{"name":"Jin, Yueming","nameType":"Personal","givenName":"Yueming","familyName":"Jin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-scale Temporal Prediction via Incremental Generation and Multi-agent Collaboration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"I.2.10","subjectScheme":"ACM"},{"lang":"en","subject":"68T45","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-22T07:22:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:15:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T06:52:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:35:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-26T07:20:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-27T01:29:39Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-24T15:15:35Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-27T01:31:05Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Accurate temporal prediction is the bridge between comprehensive scene understanding and embodied artificial intelligence. However, predicting multiple fine-grained states of a scene at multiple temporal scales is difficult for vision-language models. We formalize the Multi-Scale Temporal Prediction (MSTP) task in general and surgical scenes by decomposing multi-scale into two orthogonal dimensions: the temporal scale, forecasting states of humans and surgery at varying look-ahead intervals, and the state scale, modeling a hierarchy of states in general and surgical scenes. For example, in general scenes, states of contact relationships are finer-grained than states of spatial relationships. In surgical scenes, medium-level steps are finer-grained than high-level phases yet remain constrained by their encompassing phase. To support this unified task, we introduce the first MSTP Benchmark, featuring synchronized annotations across multiple state scales and temporal scales. We further propose a method, Incremental Generation and Multi-agent Collaboration (IG-MC), which integrates two key innovations. First, we present a plug-and-play incremental generation module that continuously synthesizes up-to-date visual previews at expanding temporal scales to inform multiple decision-making agents, keeping decisions and generated visuals synchronized and preventing performance degradation as look-ahead intervals lengthen. Second, we present a decision-driven multi-agent collaboration framework for multi-state prediction, comprising generation, initiation, and multi-state assessment agents that dynamically trigger and evaluate prediction cycles to balance global coherence and local fidelity.","descriptionType":"Abstract"},{"description":"20 pages, 6 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.17429","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:47.000Z","registered":"2025-09-23T03:11:48.000Z","published":"2025","updated":"2026-01-27T04:34:52.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.17429","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}