                          <span id="lstnumberx182.1" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx182.m1" class="ltx_Math" alttext="&lt;" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><annotation encoding="application/x-tex">&lt;</annotation></semantics></math></span><span id="lstnumberx182.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">response</span><span id="lstnumberx182.3" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx182.m2" class="ltx_Math" alttext="&gt;" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><annotation encoding="application/x-tex">&gt;</annotation></semantics></math></span><span id="lstnumberx182.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx182.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">response</span><span id="lstnumberx182.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx182.7" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx182.m3" class="ltx_Math" alttext="&lt;" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><annotation encoding="application/x-tex">&lt;</annotation></semantics></math></span><span id="lstnumberx182.8" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx182.m4" class="ltx_Math" alttext="/" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><annotation encoding="application/x-tex">/</annotation></semantics></math></span><span id="lstnumberx182.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">response</span><span id="lstnumberx182.10" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx182.m5" class="ltx_Math" alttext="&gt;" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><annotation encoding="application/x-tex">&gt;</annotation></semantics></math></span>
</span>
<span id="lstnumberx183" class="ltx_listingline">
                            <span class="ltx_tag ltx_tag_listingline">12</span>
                            
                            
                          
</span>
<span id="lstnumberx184" class="ltx_listingline">
                            <span class="ltx_tag ltx_tag_listingline">13</span>
                            
                            
                          <span id="lstnumberx184.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Now</span><span id="lstnumberx184.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx184.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">begin</span><span id="lstnumberx184.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx184.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">your</span><span id="lstnumberx184.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx184.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">analysis</span><span id="lstnumberx184.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx184.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">and</span><span id="lstnumberx184.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx184.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">response</span><span id="lstnumberx184.12" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">:</span>
