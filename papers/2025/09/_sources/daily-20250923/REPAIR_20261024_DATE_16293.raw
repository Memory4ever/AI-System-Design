ame":"Cheng","familyName":"Ren","affiliation":[],"nameIdentifiers":[]},{"name":"Zhi, Xiaoyun","nameType":"Personal","givenName":"Xiaoyun","familyName":"Zhi","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Menghan","nameType":"Personal","givenName":"Menghan","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Nan, Zhe","nameType":"Personal","givenName":"Zhe","familyName":"Nan","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Zhuolin","nameType":"Personal","givenName":"Zhuolin","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Zhong, Baoquan","nameType":"Personal","givenName":"Baoquan","familyName":"Zhong","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Qinlong","nameType":"Personal","givenName":"Qinlong","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Huan","nameType":"Personal","givenName":"Huan","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Chi, Jinxin","nameType":"Personal","givenName":"Jinxin","familyName":"Chi","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Wang","nameType":"Personal","givenName":"Wang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Yuhan","nameType":"Personal","givenName":"Yuhan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Du, Zixian","nameType":"Personal","givenName":"Zixian","familyName":"Du","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Sida","nameType":"Personal","givenName":"Sida","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yongqiang","nameType":"Personal","givenName":"Yongqiang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Jingzhe","nameType":"Personal","givenName":"Jingzhe","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Zherui","nameType":"Personal","givenName":"Zherui","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Chuan","nameType":"Personal","givenName":"Chuan","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Peng, Yanghua","nameType":"Personal","givenName":"Yanghua","familyName":"Peng","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Haibin","nameType":"Personal","givenName":"Haibin","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Xiao, Wencong","nameType":"Personal","givenName":"Wencong","familyName":"Xiao","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Xin","nameType":"Personal","givenName":"Xin","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Xiang, Liang","nameType":"Personal","givenName":"Liang","familyName":"Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust LLM Training Infrastructure at ByteDance"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T15:08:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:02:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-30T15:06:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-01T01:10:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-10T09:31:38Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-13T00:37:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-20T09:35:27Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-21T01:19:46Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The training scale of large language models (LLMs) has reached tens of thousands of GPUs and is still continuously expanding, enabling faster learning of larger models. Accompanying the expansion of the resource scale is the prevalence of failures (CUDA error, NaN values, job hang, etc.), which poses significant challenges to training stability. Any large-scale LLM training infrastructure should strive for minimal training interruption, efficient fault diagnosis, and effective failure tolerance to enable highly efficient continuous training. This paper presents ByteRobust, a large-scale GPU infrastructure management system tailored for robust and stable training of LLMs. It exploits the uniqueness of LLM training process and gives top priorities to detecting and recovering failures in a routine manner. Leveraging parallelisms and characteristics of LLM training, ByteRobust enables high-capacity fault tolerance, prompt fault demarcation, and localization with an effective data-driven approach, comprehensively ensuring continuous and efficient training of LLM tasks. ByteRobust is deployed on a production GPU platform and achieves 97% ETTR for a three-month training job on 9,600 GPUs.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.16293","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:45:02.000Z","registered":"2025-09-23T02:45:02.000Z","published":"2025","updated":"2025-10-21T03:41:09.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.16293","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}