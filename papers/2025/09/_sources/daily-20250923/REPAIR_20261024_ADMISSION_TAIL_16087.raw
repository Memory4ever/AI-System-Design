<tr id="A2.T7.4.1.3" class="ltx_tr">
<td id="A2.T7.4.1.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="A2.T7.4.1.3.1.1" class="ltx_text ltx_font_italic">w/o <math id="A2.T7.m4" class="ltx_Math" alttext="\mathcal{C}_{\text{sel}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mtext class="ltx_mathvariant_italic">sel</mtext></msub><annotation encoding="application/x-tex">\mathcal{C}_{\text{sel}}</annotation></semantics></math> Min.</span></td>
