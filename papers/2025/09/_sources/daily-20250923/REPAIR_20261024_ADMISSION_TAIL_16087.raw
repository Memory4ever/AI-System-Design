<tr id="S4.T4.4.1.3" class="ltx_tr">
<td id="S4.T4.4.1.3.1" class="ltx_td ltx_border_t"></td>
<td id="S4.T4.4.1.3.2" class="ltx_td ltx_border_r ltx_border_t"></td>
<td id="S4.T4.4.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">42.4</td>
<td id="S4.T4.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t">64.9</td>
