pplication/x-tex">\to</annotation></semantics></math>RANSAC<math id="alg1.l6.m4" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math>Decompose &amp; Perception <math id="alg1.l6.m5" class="ltx_Math" alttext="\mathcal{Y}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#808080;" class="ltx_font_mathcaligraphic" mathcolor="#808080">𝒴</mi><annotation encoding="application/x-tex">\mathcal{Y}</annotation></semantics></math></span>
</span>
