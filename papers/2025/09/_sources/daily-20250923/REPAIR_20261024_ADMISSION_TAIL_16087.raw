            <span id="alg2.l23.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l23.m1" class="ltx_Math" alttext="t_{k}\leftarrow\arg\min_{(t_{j},\mathcal{C}_{t_{j}})\in\mathcal{O}^{(k)}}\left(|\mathcal{C}_{t_{j}}\cap\mathcal{C}_{\text{sel}}|,\ -|\mathcal{C}_{t_{j}}|,\ t_{j}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi mathsize="0.900em">min</mi><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">j</mi></msub><mo mathsize="0.900em">,</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">j</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">∈</mo><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup></mrow></msub><mo>⁡</mo><mrow><mo>(</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">j</mi></msub></msub><mo mathsize="0.900em">∩</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mtext mathsize="0.900em">sel</mtext></msub></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow><mo mathsize="0.900em">,</mo><mrow><mo mathsize="0.900em">−</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">j</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow></mrow><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">j</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{k}\leftarrow\arg\min_{(t_{j},\mathcal{C}_{t_{j}})\in\mathcal{O}^{(k)}}\left(|\mathcal{C}_{t_{j}}\cap\mathcal{C}_{\text{sel}}|,\ -|\mathcal{C}_{t_{j}}|,\ t_{j}\right)</annotation></semantics></math><span id="alg2.l23.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              
            <span id="alg2.l24.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l24.m1" class="ltx_Math" alttext="\mathcal{C}_{\text{sel}}\leftarrow\mathcal{C}_{\text{sel}}\cup\mathcal{C}_{t_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mtext mathsize="0.900em">sel</mtext></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mtext mathsize="0.900em">sel</mtext></msub><mo mathsize="0.900em">∪</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}_{\text{sel}}\leftarrow\mathcal{C}_{\text{sel}}\cup\mathcal{C}_{t_{k}}</annotation></semantics></math><span id="alg2.l24.4" class="ltx_text" style="font-size:90%;">, </span><math id="alg2.l24.m2" class="ltx_Math" alttext="\mathcal{T}_{\text{sel}}\leftarrow\mathcal{T}_{\text{sel}}\cup\{t_{k}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mtext mathsize="0.900em">sel</mtext></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mtext mathsize="0.900em">sel</mtext></msub><mo mathsize="0.900em">∪</mo><mrow><mo maxsize="0.900em" minsize="0.900em">{</mo><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub><mo maxsize="0.900em" minsize="0.900em">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{\text{sel}}\leftarrow\mathcal{T}_{\text{sel}}\cup\{t_{k}\}</annotation></semantics></math><span id="alg2.l24.5" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l25" class="ltx_listingline">
