<td id="A2.T7.4.1.5.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="A2.T7.4.1.5.1.1" class="ltx_text ltx_font_italic">w/o Time Early</span></td>
<td id="A2.T7.4.1.5.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">43.2</td>
<td id="A2.T7.4.1.5.3" class="ltx_td ltx_align_center ltx_border_bb">66.2</td>
<td id="A2.T7.4.1.5.4" class="ltx_td ltx_align_center ltx_border_bb">34.0</td>
<td id="A2.T7.4.1.5.5" class="ltx_td ltx_align_center ltx_border_bb">45.5</td>
<td id="A2.T7.4.1.5.6" class="ltx_td ltx_align_center ltx_border_bb">48.0</td>
<td id="A2.T7.4.1.5.7" class="ltx_td ltx_align_center ltx_border_bb">42.1</td>
