<td id="S4.T4.4.1.3.11" class="ltx_td ltx_align_center ltx_border_t">37.1</td></tr>
<tr id="S4.T4.4.1.4" class="ltx_tr">
<td id="S4.T4.4.1.4.1" class="ltx_td ltx_align_center">✓</td>
<td id="S4.T4.4.1.4.2" class="ltx_td ltx_border_r"></td>
<td id="S4.T4.4.1.4.3" class="ltx_td ltx_align_center ltx_border_r">42.7</td>
