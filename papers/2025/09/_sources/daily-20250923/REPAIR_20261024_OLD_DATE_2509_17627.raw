{"data":{"id":"10.48550/arxiv.2509.17627","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17627","prefix":"10.48550","suffix":"arxiv.2509.17627","identifiers":[{"identifier":"2509.17627","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.17627"}],"creators":[{"name":"Chen, Jinshu","nameType":"Personal","givenName":"Jinshu","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xinghui","nameType":"Personal","givenName":"Xinghui","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Bai, Xu","nameType":"Personal","givenName":"Xu","familyName":"Bai","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Tianxiang","nameType":"Personal","givenName":"Tianxiang","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Pengze","nameType":"Personal","givenName":"Pengze","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Zhuowei","nameType":"Personal","givenName":"Zhuowei","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Gen","nameType":"Personal","givenName":"Gen","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Lijie","nameType":"Personal","givenName":"Lijie","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Songtao","nameType":"Personal","givenName":"Songtao","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Bingchuan","nameType":"Personal","givenName":"Bingchuan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"He, Qian","nameType":"Personal","givenName":"Qian","familyName":"He","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OmniInsert: Mask-Free Video Insertion of Any Reference via Diffusion Transformer Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:35:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:24:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Recent advances in video insertion based on diffusion models are impressive. However, existing methods rely on complex control signals but struggle with subject consistency, limiting their practical applicability. In this paper, we focus on the task of Mask-free Video Insertion and aim to resolve three key challenges: data scarcity, subject-scene equilibrium, and insertion harmonization. To address the data scarcity, we propose a new data pipeline InsertPipe, constructing diverse cross-pair data automatically. Building upon our data pipeline, we develop OmniInsert, a novel unified framework for mask-free video insertion from both single and multiple subject references. Specifically, to maintain subject-scene equilibrium, we introduce a simple yet effective Condition-Specific Feature Injection mechanism to distinctly inject multi-source conditions and propose a novel Progressive Training strategy that enables the model to balance feature injection from subjects and source video. Meanwhile, we design the Subject-Focused Loss to improve the detailed appearance of the subjects. To further enhance insertion harmonization, we propose an Insertive Preference Optimization methodology to optimize the model by simulating human preferences, and incorporate a Context-Aware Rephraser module during reference to seamlessly integrate the subject into the original scenes. To address the lack of a benchmark for the field, we introduce InsertBench, a comprehensive benchmark comprising diverse scenes with meticulously selected subjects. Evaluation on InsertBench indicates OmniInsert outperforms state-of-the-art closed-source commercial solutions. The code will be released.","descriptionType":"Abstract"},{"description":"Github Page: https://phantom-video.github.io/OmniInsert/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.17627","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:16:30.000Z","registered":"2025-09-23T03:16:31.000Z","published":"2025","updated":"2025-09-23T03:16:31.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.17627","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}