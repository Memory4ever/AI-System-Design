<tr id="S2.T1.2.1.5" class="ltx_tr">
<td id="S2.T1.2.1.5.1" class="ltx_td ltx_align_left">   BART</td>
<td id="S2.T1.2.1.5.2" class="ltx_td ltx_align_center">53.82</td>
<td id="S2.T1.2.1.5.3" class="ltx_td ltx_align_center">38.92</td>
<td id="S2.T1.2.1.5.4" class="ltx_td ltx_align_center">43.51</td>
<td id="S2.T1.2.1.5.5" class="ltx_td ltx_align_center">50.89</td>
<td id="S2.T1.2.1.5.6" class="ltx_td ltx_align_center">53.95</td>
<td id="S2.T1.2.1.5.7" class="ltx_td ltx_align_center">58.53</td>
<td id="S2.T1.2.1.5.8" class="ltx_td ltx_align_center">63.36</td>
<td id="S2.T1.2.1.5.9" class="ltx_td ltx_align_center">63.38</td>
<td id="S2.T1.2.1.5.10" class="ltx_td ltx_align_center">63.37</td>
