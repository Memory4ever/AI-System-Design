<td id="S4.T3.2.1.4.2" class="ltx_td ltx_align_center">18.64</td>
<td id="S4.T3.2.1.4.3" class="ltx_td ltx_align_center">15.42</td>
<td id="S4.T3.2.1.4.4" class="ltx_td ltx_align_center">12.78</td>
