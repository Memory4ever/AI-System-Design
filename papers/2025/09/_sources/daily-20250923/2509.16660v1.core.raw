<th id="S4.T3.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S4.T3.2.1.5.1.1" class="ltx_text ltx_font_bold">Mistral</span></th>
<td id="S4.T3.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb">22.97</td>
