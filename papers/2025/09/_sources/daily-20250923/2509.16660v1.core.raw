<th id="S4.T3.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T3.2.1.3.1.1" class="ltx_text ltx_font_bold">BART</span></th>
<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center">19.91</td>
