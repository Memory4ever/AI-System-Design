<td id="S4.T2.2.1.14.7" class="ltx_td ltx_align_center ltx_border_t">3.24% <span id="S4.T2.2.1.14.7.1" class="ltx_text" style="--ltx-fg-color:#009900;">(<math id="S4.T2.m45" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#009900;" mathcolor="#009900" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> 78.86%)</span></td></tr>
