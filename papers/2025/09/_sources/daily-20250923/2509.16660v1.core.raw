<td id="S4.T2.2.1.15.4" class="ltx_td ltx_align_center">1229 <span id="S4.T2.2.1.15.4.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">(<math id="S4.T2.m48" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math> <math id="S4.T2.m49" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math>%)</span></td>
<td id="S4.T2.2.1.15.5" class="ltx_td ltx_align_center">10.29 <span id="S4.T2.2.1.15.5.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">(<math id="S4.T2.m50" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math> 14.46%)</span></td>
<td id="S4.T2.2.1.15.6" class="ltx_td ltx_align_center">9.33 <span id="S4.T2.2.1.15.6.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">(<math id="S4.T2.m51" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math> 3.78%)</span></td></tr>
