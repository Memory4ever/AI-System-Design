<span id="S2.T3.2.4.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T3.2.4.2.1.1" class="ltx_p ltx_align_center">300M</span>
</span></td>
<td id="S2.T3.2.4.3" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:8.0pt;padding-right:8.0pt;">
<span id="S2.T3.2.4.3.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T3.2.4.3.1.1" class="ltx_p ltx_align_center">256</span>
</span></td>
