"use strict";(self.webpackChunk_ice_lite_scaffold=self.webpackChunk_ice_lite_scaffold||[]).push([[6592],{56592:function(e,t,o){var n=o(37609),a=o(69496),i=o(93306),s=o(75271),r=o(76701),l=a.C8.Threshold768,c=a.C8.Threshold1023,d=[a.C8.Threshold767],u=[a.C8.Threshold767,a.C8.Threshold375];t.Z=function(){var e,t,o,a=arguments.length>0&&void 0!==arguments[0]?arguments[0]:{sizeOfLMThresholds:d,sizeOfLMSThresholds:u},h=a.sizeOfLMThresholds,m=void 0===h?d:h,p=a.sizeOfLMSThresholds,w=void 0===p?u:p,g=(0,n._)((0,r.FV)(i.Li),2),f=g[0],y=g[1],v=(0,n._)((0,s.useState)("large"),2),b=v[0],A=v[1],Q=(0,n._)((0,s.useState)("large"),2),k=Q[0],I=Q[1],C=(0,s.useCallback)(function(){(o=new ResizeObserver(function(e){var t=e[0].contentRect.width,o="pc";t<l?o="mobile":t<c&&(o="pad"),y({type:o,width:t})})).observe(document.body)},[]),P={PC:"pc",PAD:"pad",MOBILE:"mobile"},T={ANDROID:"android",IOS:"ios",MAC:"mac",WINDOWS:"windows",UNKNOWN:"unknown"},D=(e=navigator.userAgent.toLocaleLowerCase(),t=T.UNKNOWN,(e.includes("android")?t=T.ANDROID:e.includes("iphone")||e.includes("ipad")||e.includes("ipod")?t=T.IOS:!e.includes("mac")||e.includes("iphone")||e.includes("ipad")||e.includes("ipod")?e.includes("win")&&(t=T.WINDOWS):t=T.MAC,/ipad|playbook/.test(e)||e.includes("mac")&&"ontouchend"in document)?{type:P.PAD,os:t}:/iphone|ipod|android/.test(e)?{type:P.MOBILE,os:t}:{type:P.PC,os:t}),S=D.type,x=D.os,O=S===P.PC,q=S===P.PAD,M=S===P.MOBILE,W=x===T.IOS,E=x===T.ANDROID,R=x===T.MAC,L=x===T.WINDOWS;return(0,s.useEffect)(function(){return function(){o&&o.disconnect()}},[]),(0,s.useEffect)(function(){A(f.width>m[0]?"large":"medium"),I(f.width>w[0]?"large":f.width>w[1]?"medium":"small")},[f.width,w,m]),{deviceWidth:f.width,sizeOfLM:b,sizeOfLMS:k,initDevice:C,isPC:O,isPad:q,isMobile:M,isIos:W,isAndroid:E,isMac:R,isWin:L}}},71375:function(e,t,o){o.d(t,{Gv:function(){return d},Uz:function(){return i},rI:function(){return s},al:function(){return m},Bc:function(){return h},k1:function(){return u},sY:function(){return c}});var n,a,i,s,r=JSON.parse('{"Ambassador Program":"\u5927\u4F7F\u8BA1\u5212","A global program that empowers developers and community leaders to build with Qwen, share real-world use cases, and grow the open-source AI ecosystem through content and events.":"\u8FD9\u662F\u4E00\u4E2A\u65E8\u5728\u8D4B\u80FD\u5F00\u53D1\u8005\u4E0E\u793E\u533A\u9886\u8896\u4F7F\u7528Qwen\u7684\u5168\u7403\u5316\u9879\u76EE\uFF0C\u6211\u4EEC\u5E0C\u671B\u5206\u4EAB\u771F\u5B9E\u4E16\u754C\u7684\u5E94\u7528\u6848\u4F8B\uFF0C\u5E76\u901A\u8FC7\u5185\u5BB9\u521B\u4F5C\u4E0E\u793E\u533A\u6D3B\u52A8\u5171\u540C\u63A8\u52A8\u5F00\u6E90 AI \u751F\u6001\u7684\u53D1\u5C55\u3002","Apply Now":"\u7ACB\u5373\u7533\u8BF7","Who We\'re Looking For":"\u6211\u4EEC\u7684\u5927\u4F7F\u753B\u50CF","We\'re seeking two types of ambassadors to represent Qwen globally.":"\u6211\u4EEC\u6B63\u5728\u5BFB\u627E\u4E24\u7C7B Ambassador\uFF0C\u5728\u5168\u7403\u8303\u56F4\u5185\u4EE3\u8868 Qwen","Dev Ambassador":"\u5F00\u53D1\u8005\u5927\u4F7F","As a Dev Ambassador, you will help grow our developer ecosystem through your projects, insights, and technical contributions.":"\u4F5C\u4E3A\u5F00\u53D1\u8005\u5927\u4F7F\uFF0C\u4F60\u5C06\u901A\u8FC7\u81EA\u5DF1\u7684\u9879\u76EE\u3001\u6D1E\u5BDF\u4E0E\u6280\u672F\u8D21\u732E\uFF0C\u5E2E\u52A9\u6211\u4EEC\u5171\u540C\u62D3\u5C55\u5F00\u53D1\u8005\u751F\u6001\u3002","We\'re looking for passionate builders with a strong understanding of AI, who are deeply engaged in open-source communities, bring a developer mindset with solid technical taste, can build compelling demo cases, and are excited to push boundaries while sharing their work openly.":"\u6211\u4EEC\u6B63\u5728\u5BFB\u627E\u5145\u6EE1\u70ED\u60C5\u7684\u521B\u9020\u8005\uFF1A\u4ED6\u4EEC\u5BF9 AI \u6709\u6DF1\u5165\u7406\u89E3\uFF0C\u79EF\u6781\u53C2\u4E0E\u5F00\u6E90\u793E\u533A\uFF0C\u5177\u5907\u5F00\u53D1\u8005\u601D\u7EF4\u4E0E\u826F\u597D\u7684\u6280\u672F\u54C1\u5473\uFF0C\u80FD\u591F\u6253\u9020\u6709\u5438\u5F15\u529B\u7684 Demo \u6848\u4F8B\uFF0C\u5E76\u4E50\u4E8E\u7A81\u7834\u8FB9\u754C\u3001\u516C\u5F00\u5206\u4EAB\u81EA\u5DF1\u7684\u6210\u679C\u3002","Event Ambassador":"\u6D3B\u52A8\u5927\u4F7F","As an Event Ambassador, you will help grow our developer ecosystem through community meetups, workshops, hackathons, and more.":"\u4F5C\u4E3A\u6D3B\u52A8\u5927\u4F7F\uFF0C\u4F60\u5C06\u901A\u8FC7\u793E\u533A\u805A\u4F1A\u3001Workshop\u3001\u9ED1\u5BA2\u677E\u7B49\u591A\u79CD\u6D3B\u52A8\u5F62\u5F0F\uFF0C\u5E2E\u52A9\u6211\u4EEC\u5171\u540C\u62D3\u5C55\u5F00\u53D1\u8005\u751F\u6001\u3002","We are looking for passionate community leaders who are excited to bring local developers together, represent Qwen by bringing your creativity to life through a wide range of community events. Your efforts will help more developers discover and build with Qwen while fostering a strong local developer ecosystem.":"\u6211\u4EEC\u6B63\u5728\u5BFB\u627E\u5145\u6EE1\u70ED\u60C5\u7684\u793E\u533A\u7EC4\u7EC7\u8005\uFF0C\u4ED6\u4EEC\u4E50\u4E8E\u5C06\u672C\u5730\u5F00\u53D1\u8005\u8FDE\u63A5\u5728\u4E00\u8D77\uFF0C\u5E76\u901A\u8FC7\u5BCC\u6709\u521B\u9020\u529B\u7684\u5404\u7C7B\u793E\u533A\u6D3B\u52A8\u4EE3\u8868 Qwen \u53D1\u58F0\u3002\u4F60\u7684\u52AA\u529B\u5C06\u5E2E\u52A9\u66F4\u591A\u5F00\u53D1\u8005\u4E86\u89E3\u5E76\u4F7F\u7528 Qwen\uFF0C\u540C\u65F6\u63A8\u52A8\u672C\u5730\u5F00\u53D1\u8005\u751F\u6001\u7684\u6210\u957F\u4E0E\u7E41\u8363\u3002","Responsibilities & Benefits":"\u804C\u8D23\u4E0E\u798F\u5229","What you\'ll do and what you\'ll get in return.":"\u4F60\u5C06\u53C2\u4E0E\u7684\u5185\u5BB9\uFF0C\u4EE5\u53CA\u4F60\u5C06\u83B7\u5F97\u7684\u56DE\u62A5","DEV":"DEV","Create Qwen-related content such as cookbooks, demo cases, comparisons, and evaluations; or build open-source projects using Qwen models and share them on platforms like X, Medium, Reddit, etc.":"\u521B\u5EFA Qwen \u76F8\u5173\u5185\u5BB9\uFF08\u5982 Cookbook\u3001Demo \u6848\u4F8B\u3001\u5BF9\u6BD4\u8BC4\u6D4B\uFF09\uFF1B\u6216\u4F7F\u7528 Qwen \u6A21\u578B\u6784\u5EFA\u5F00\u6E90\u9879\u76EE\u5E76\u5728 X\u3001Medium\u3001Reddit \u7B49\u5E73\u53F0\u5206\u4EAB","Actively help answer questions from other users in the Qwen community based on personal experience":"\u57FA\u4E8E\u4E2A\u4EBA\u7ECF\u9A8C\u79EF\u6781\u5E2E\u52A9 Qwen \u793E\u533A\u4E2D\u7684\u5176\u4ED6\u7528\u6237\u89E3\u7B54\u95EE\u9898","Provide product and model improvement suggestions to the official team based on real usage":"\u57FA\u4E8E\u5B9E\u9645\u4F7F\u7528\u5411\u5B98\u65B9\u56E2\u961F\u63D0\u4F9B\u4EA7\u54C1\u548C\u6A21\u578B\u6539\u8FDB\u5EFA\u8BAE","EVENT":"EVENT","Organize online and offline events in your region on behalf of Qwen, including but not limited to meetups, workshops, seminars, and hackathons; help drive collaborations with leading AI labs":"\u4EE3\u8868 Qwen \u5728\u60A8\u6240\u5728\u5730\u533A\u7EC4\u7EC7\u7EBF\u4E0A\u7EBF\u4E0B\u6D3B\u52A8\uFF0C\u5305\u62EC\u4F46\u4E0D\u9650\u4E8E Meetup\u3001\u5DE5\u4F5C\u574A\u3001\u7814\u8BA8\u4F1A\u548C\u9ED1\u5BA2\u677E\uFF1B\u5E2E\u52A9\u63A8\u52A8\u4E0E\u9876\u5C16 AI \u5B9E\u9A8C\u5BA4\u7684\u5408\u4F5C","Collect feedback and suggestions from event participants and share them with the Qwen team":"\u6536\u96C6\u6D3B\u52A8\u53C2\u4E0E\u8005\u7684\u53CD\u9988\u548C\u5EFA\u8BAE\uFF0C\u5E76\u4E0E Qwen \u56E2\u961F\u5206\u4EAB","Ambassador Benefits":"\u5927\u4F7F\u798F\u5229","Exclusive community badge and access to private chats with the model and product teams":"\u4E13\u5C5E\u793E\u533A\u5FBD\u7AE0\u53CA\u4E0E\u6A21\u578B\u548C\u4EA7\u54C1\u56E2\u961F\u7684\u79C1\u5BC6\u804A\u5929\u6743\u9650","Early access (EA) to new Qwen models":"Qwen\u7CFB\u5217\u6A21\u578B\u7684\u5185\u6D4B\u8D44\u683C","Qwen API credits ($50-$100 / month) to support personal projects":"Qwen API \u989D\u5EA6\uFF08$50-$100 / \u6708\uFF09","Annual merchandise package and thank-you card":"\u5E74\u5EA6\u5468\u8FB9\u793C\u5305\u548C\u611F\u8C22\u5361","Opportunities to participate in Qwen Global Developer Conference":"\u53C2\u52A0 Qwen \u5168\u7403\u5F00\u53D1\u8005\u5927\u4F1A\u7684\u673A\u4F1A","Event funding support, swag sponsorship, and official endorsement from Qwen":"\u6D3B\u52A8\u8D44\u91D1\u652F\u6301\u3001\u5468\u8FB9\u8D5E\u52A9\u53CA Qwen \u5B98\u65B9\u80CC\u4E66","Top ambassadors may be upgraded to paid partners":"\u8868\u73B0\u4F18\u79C0\u7684\u5927\u4F7F\u53EF\u5347\u7EA7\u4E3A\u4ED8\u8D39\u5408\u4F5C\u4F19\u4F34","Frequently Asked Questions":"\u5E38\u89C1\u95EE\u9898","Everything you need to know about the program.":"\u5173\u4E8E\u8BA1\u5212\u7684\u4E00\u5207\u3002","How do I know if I\'ve been accepted?":"\u5982\u4F55\u77E5\u9053\u6211\u662F\u5426\u88AB\u5F55\u53D6\uFF1F","We\'ll notify you via email. If you do not receive an onboarding email within 15 business days after applying (please check spam), it means you were not selected this round. You\'re welcome to apply again in the future.":"\u6211\u4EEC\u4F1A\u901A\u8FC7\u90AE\u4EF6\u901A\u77E5\u60A8\u3002\u5982\u679C\u60A8\u5728\u7533\u8BF7\u540E 15 \u4E2A\u5DE5\u4F5C\u65E5\u5185\u672A\u6536\u5230\u5165\u804C\u90AE\u4EF6\uFF08\u8BF7\u68C0\u67E5\u5783\u573E\u90AE\u4EF6\uFF09\uFF0C\u8BF4\u660E\u60A8\u672C\u8F6E\u672A\u88AB\u9009\u4E2D\u3002\u6B22\u8FCE\u672A\u6765\u518D\u6B21\u7533\u8BF7\u3002","What are the requirements to receive $100 credits per month?":"\u83B7\u5F97\u6BCF\u6708 $100 credits \u7684\u8981\u6C42\u662F\u4EC0\u4E48\uFF1F","To receive $100 credits per month, you need to meet the following requirements:":"\u8981\u83B7\u5F97\u6BCF\u6708 $100 credits\uFF0C\u9700\u8981\u6EE1\u8DB3\u4EE5\u4E0B\u6761\u4EF6\uFF1A","Dev Ambassador: At least 4 content outputs per month":"\u5F00\u53D1\u8005\u5927\u4F7F\uFF1A\u6BCF\u6708\u81F3\u5C11 4 \u7BC7\u5185\u5BB9\u4EA7\u51FA","Event Ambassador: At least 1 event + 2 Qwen-related social posts per month":"\u6D3B\u52A8\u5927\u4F7F\uFF1A\u6BCF\u6708\u81F3\u5C11 1 \u573A\u6D3B\u52A8 + 2 \u7BC7 Qwen \u76F8\u5173\u793E\u4EA4\u5E16\u5B50","What if I\'m temporarily unable to contribute?":"\u5982\u679C\u6682\u65F6\u65E0\u6CD5\u8D21\u732E\u600E\u4E48\u529E\uFF1F","No contributions for 2 consecutive months will be considered as automatic withdrawal. You may reapply after 6 months. If you have special circumstances, feel free to reach out to us.":"\u8FDE\u7EED 2 \u4E2A\u6708\u65E0\u8D21\u732E\u5C06\u89C6\u4E3A\u81EA\u52A8\u9000\u51FA\u30026 \u4E2A\u6708\u540E\u53EF\u91CD\u65B0\u7533\u8BF7\u3002\u5982\u6709\u7279\u6B8A\u60C5\u51B5\uFF0C\u6B22\u8FCE\u8054\u7CFB\u6211\u4EEC\u3002","Can I publicly share my Ambassador status?":"\u53EF\u4EE5\u516C\u5F00\u5206\u4EAB\u6211\u7684\u5927\u4F7F\u8EAB\u4EFD\u5417\uFF1F","Yes, we encourage you to share it on any platform.":"\u53EF\u4EE5\uFF0C\u6211\u4EEC\u9F13\u52B1\u60A8\u5728\u4EFB\u4F55\u5E73\u53F0\u5206\u4EAB\u3002","How do I receive the annual merchandise and thank-you card?":"\u5982\u4F55\u6536\u5230\u5E74\u5EA6\u5468\u8FB9\u548C\u611F\u8C22\u5361\uFF1F","We will send out curated merchandise packages during the New Year. All active ambassadors at that time will receive them.":"\u6211\u4EEC\u4F1A\u5728\u65B0\u5E74\u671F\u95F4\u5411\u6240\u6709\u6D3B\u8DC3\u5927\u4F7F\u53D1\u9001\u7CBE\u5FC3\u7B56\u5212\u7684\u5468\u8FB9\u793C\u5305\u3002","Can I be an ambassador for other AI labs at the same time?":"\u53EF\u4EE5\u540C\u65F6\u62C5\u4EFB\u5176\u4ED6 AI \u5B9E\u9A8C\u5BA4\u7684\u5927\u4F7F\u5417\uFF1F","Generally, we do not recommend it.":"\u901A\u5E38\u6211\u4EEC\u4E0D\u5EFA\u8BAE\u3002","What is the process for organizing an event as an Event Ambassador?":"\u4F5C\u4E3A\u6D3B\u52A8\u5927\u4F7F\u7EC4\u7EC7\u6D3B\u52A8\u7684\u6D41\u7A0B\u662F\u4EC0\u4E48\uFF1F","Once you become our ambassador, you\'ll be invited to join the Discord group, where you can download the event proposal template and submit details including your plan, venue, expected attendance, and budget breakdown. We will review and determine the level of support available. If needed, we\'ll schedule a short call to discuss further.":"\u6210\u4E3A\u5927\u4F7F\u540E\uFF0C\u60A8\u5C06\u88AB\u9080\u8BF7\u52A0\u5165 Discord \u7FA4\u7EC4\uFF0C\u5728\u90A3\u91CC\u60A8\u53EF\u4EE5\u4E0B\u8F7D\u6D3B\u52A8\u63D0\u6848\u6A21\u677F\u5E76\u63D0\u4EA4\u5305\u62EC\u8BA1\u5212\u3001\u573A\u5730\u3001\u9884\u671F\u53C2\u4E0E\u4EBA\u6570\u548C\u9884\u7B97\u660E\u7EC6\u5728\u5185\u7684\u8BE6\u7EC6\u4FE1\u606F\u3002\u6211\u4EEC\u5C06\u5BA1\u6838\u5E76\u786E\u5B9A\u53EF\u63D0\u4F9B\u7684\u652F\u6301\u7EA7\u522B\u3002\u5982\u6709\u9700\u8981\uFF0C\u6211\u4EEC\u4F1A\u5B89\u6392\u4E00\u6B21\u7B80\u77ED\u7684\u901A\u8BDD\u8FDB\u4E00\u6B65\u8BA8\u8BBA\u3002","Qwen Ambassador Program Disclaimer":"Qwen \u5927\u4F7F\u8BA1\u5212\u514D\u8D23\u58F0\u660E","By applying to and participating in the Qwen Ambassador Program, you agree to abide by the following terms and conditions. Qwen reserves the right to modify, suspend, or terminate this program at any time without prior notice. Intellectual Property & Content Rights: All photographs, images, videos, and content created during or as part of ambassador activities are the exclusive property of Qwen. Ambassadors grant Qwen unrestricted rights to use, reproduce, modify, and distribute such Content for marketing, promotional, and commercial purposes. Qwen retains all rights to interpret and enforce this policy. Violation of program guidelines may result in immediate removal without compensation. By submitting your application, you acknowledge that you have read and understood these terms.":"\u901A\u8FC7\u7533\u8BF7\u548C\u53C2\u4E0E Qwen \u5927\u4F7F\u8BA1\u5212\uFF0C\u60A8\u540C\u610F\u9075\u5B88\u4EE5\u4E0B\u6761\u6B3E\u548C\u6761\u4EF6\u3002Qwen \u4FDD\u7559\u968F\u65F6\u4FEE\u6539\u3001\u6682\u505C\u6216\u7EC8\u6B62\u672C\u8BA1\u5212\u7684\u6743\u5229\uFF0C\u65E0\u9700\u4E8B\u5148\u901A\u77E5\u3002\u77E5\u8BC6\u4EA7\u6743\u4E0E\u5185\u5BB9\u6743\u5229\uFF1A\u5728\u5927\u4F7F\u6D3B\u52A8\u671F\u95F4\u6216\u4F5C\u4E3A\u5176\u4E00\u90E8\u5206\u521B\u5EFA\u7684\u6240\u6709\u7167\u7247\u3001\u56FE\u50CF\u3001\u89C6\u9891\u548C\u5185\u5BB9\u5747\u4E3A Qwen \u7684\u4E13\u6709\u8D22\u4EA7\u3002\u5927\u4F7F\u6388\u4E88 Qwen \u4E0D\u53D7\u9650\u5236\u5730\u4F7F\u7528\u3001\u590D\u5236\u3001\u4FEE\u6539\u548C\u5206\u53D1\u6B64\u7C7B\u5185\u5BB9\u7684\u6743\u5229\u3002Qwen \u4FDD\u7559\u5BF9\u672C\u653F\u7B56\u7684\u6700\u7EC8\u89E3\u91CA\u6743\u548C\u6267\u884C\u6743\u3002\u8FDD\u53CD\u8BA1\u5212\u6307\u5357\u53EF\u80FD\u5BFC\u81F4\u7ACB\u5373\u79FB\u9664\u4E14\u4E0D\u4E88\u8865\u507F\u3002\u63D0\u4EA4\u7533\u8BF7\u5373\u8868\u793A\u60A8\u5DF2\u9605\u8BFB\u5E76\u7406\u89E3\u8FD9\u4E9B\u6761\u6B3E\u3002","How can I help you today?":"\u6709\u4EC0\u4E48\u6211\u80FD\u5E2E\u60A8\u7684\u5417\uFF1F","More":"\u66F4\u591A","News":"\u65B0\u95FB","Thinking":"\u6DF1\u5EA6\u601D\u8003","Web Search":"\u7F51\u7EDC\u641C\u7D22","Deep Research":"\u6DF1\u5165\u7814\u7A76","Artifacts":"\u9884\u89C8\u6A21\u5F0F","Video Generation":"\u89C6\u9891\u751F\u6210","Image Generation":"\u56FE\u50CF\u751F\u6210","Web Dev":"\u7F51\u9875\u5F00\u53D1","Download":"\u4E0B\u8F7D","Web":"\u7F51\u9875","Overview":"\u6982\u89C8","Qwen Overview":"Qwen \u6982\u89C8","Models":"\u6A21\u578B","Models Overview":"\u6A21\u578B\u6982\u89C8","Terms of Service":"\u7528\u6237\u6761\u6B3E","Privacy Policy":"\u9690\u79C1\u534F\u8BAE","month":"\u6708","Try Qwen everyday":"\u6BCF\u5929\u5C1D\u8BD5\u4F7F\u7528Qwen","Chat on web, IOS and Android":"\u5728\u7F51\u9875\u3001IOS \u548C Android \u4E0A\u804A\u5929","Access to Qwen3 Models":"\u8BBF\u95EE Qwen3 \u6A21\u578B","Limited access to Image and Video Generation":"\u6709\u9650\u6B21\u8BBF\u95EE\u56FE\u50CF\u548C\u89C6\u9891\u751F\u6210\u529F\u80FD","Limited access to Deep Research":"\u6709\u9650\u6B21\u8BBF\u95EE\u6DF1\u5165\u7814\u7A76\u529F\u80FD","POPULAR":"\u6D41\u884C","More usage":"\u66F4\u591A\u4F7F\u7528\u6B21\u6570","More Image and Video Generation usage":"\u66F4\u591A\u56FE\u7247\u548C\u89C6\u9891\u751F\u6210\u4F7F\u7528\u6B21\u6570","More Deep Research usage":"\u66F4\u591A\u6DF1\u5165\u7814\u7A76\u4F7F\u7528\u6B21\u6570","Opportunities to test new models":"\u6D4B\u8BD5\u65B0\u6A21\u578B\u7684\u673A\u4F1A","Opportunities to test new features":"\u6D4B\u8BD5\u65B0\u529F\u80FD\u7684\u673A\u4F1A","QWEN":"QWEN","Ask Qwen, Know More":"\u95EE\u5343\u95EE\uFF0C\u77E5\u66F4\u591A","Unlock Qwen advanced Capabilities":"\u89E3\u9501Qwen\u9AD8\u7EA7\u529F\u80FD","QwQ is a high-performance reasoning model developed by Alibaba, focusing on complex logical reasoning, mathematical problem-solving, and programming tasks.":"QwQ \u662F\u963F\u91CC\u5DF4\u5DF4\u7814\u53D1\u7684\u9AD8\u6027\u80FD\u63A8\u7406\u6A21\u578B\uFF0C\u4E13\u6CE8\u4E8E\u590D\u6742\u903B\u8F91\u63A8\u7406\u3001\u6570\u5B66\u95EE\u9898\u89E3\u51B3\u548C\u7F16\u7A0B\u4EFB\u52A1\u3002","Product":"\u4EA7\u54C1","MCP (Model Context Protocol) , which is a system designed to enhance the integration of AI models like Qwen with external tools, data sources, and real-time functionalities. This protocol allows for seamless interactions between Qwen and various systems or platforms.":"MCP\uFF08\u6A21\u578B\u4E0A\u4E0B\u6587\u534F\u8BAE\uFF09\uFF0C\u8FD9\u662F\u4E00\u4E2A\u65E8\u5728\u589E\u5F3A\u50CFQwen\u8FD9\u6837\u7684AI\u6A21\u578B\u4E0E\u5916\u90E8\u5DE5\u5177\u3001\u6570\u636E\u6E90\u548C\u5B9E\u65F6\u529F\u80FD\u96C6\u6210\u7684\u7CFB\u7EDF\u3002\u8BE5\u534F\u8BAE\u5141\u8BB8Qwen\u4E0E\u5404\u79CD\u7CFB\u7EDF\u6216\u5E73\u53F0\u8FDB\u884C\u65E0\u7F1D\u4EA4\u4E92\u3002","Artifacts offers real-time preview capabilities for code and content, supporting formats like HTML, JavaScript and SVG.":"Artifacts \u63D0\u4F9B\u4EE3\u7801\u548C\u5185\u5BB9\u7684\u5B9E\u65F6\u9884\u89C8\u529F\u80FD\uFF0C\u652F\u6301 HTML\uFF0CJavaScript \u548C SVG  \u7B49\u683C\u5F0F\u3002","Think deeply and solve tough problems.":"\u6DF1\u5165\u601D\u8003\uFF0C\u89E3\u51B3\u96BE\u9898","By spending extra time analyzing and reasoning through complex questions, Qwen excels in reasoning and cognitive tasks, using critical thinking to solve challenging problems in math, science, coding, and more.":"\u901A\u8FC7\u82B1\u8D39\u989D\u5916\u7684\u65F6\u95F4\u5206\u6790\u548C\u63A8\u7406\u590D\u6742\u7684\u95EE\u9898\uFF0CQwen \u5728\u63A8\u7406\u548C\u8BA4\u77E5\u4EFB\u52A1\u4E0A\u8868\u73B0\u51FA\u8272\uFF0C\u5229\u7528\u6279\u5224\u6027\u601D\u7EF4\u89E3\u51B3\u6570\u5B66\u3001\u79D1\u5B66\u3001\u7F16\u7801\u7B49\u9886\u57DF\u7684\u590D\u6742\u95EE\u9898\u3002","Creative writing and exploring ideas together with you":"\u521B\u610F\u5199\u4F5C\uFF0C\u4E0E\u4F60\u4E00\u8D77\u6DF1\u5165\u63A2\u8BA8\u601D\u8003","Qwen combines chain-of-thought reasoning with creative idea generation to craft narratives, develop characters, and explore plots systematically. It serves as a writing assistant, suggesting scenarios and synthesizing ideas into cohesive frameworks. With multi-modal capabilities, it integrates visual and textual reasoning, making it versatile for screenwriting, game design, and immersive storytelling, empowering users to balance creativity with logical coherence.":"Qwen \u5C06\u94FE\u5F0F\u601D\u7EF4\u63A8\u7406\u4E0E\u521B\u610F\u6784\u601D\u76F8\u7ED3\u5408\uFF0C\u7CFB\u7EDF\u5730\u521B\u4F5C\u53D9\u4E8B\u3001\u5851\u9020\u89D2\u8272\u548C\u63A2\u7D22\u60C5\u8282\u3002\u5B83\u5145\u5F53\u5199\u4F5C\u52A9\u624B\uFF0C\u63D0\u51FA\u573A\u666F\u5E76\u5C06\u60F3\u6CD5\u6574\u5408\u4E3A\u8FDE\u8D2F\u7684\u6846\u67B6\u3002\u51ED\u501F\u591A\u6A21\u6001\u80FD\u529B\uFF0C\u5B83\u878D\u5408\u89C6\u89C9\u4E0E\u6587\u672C\u63A8\u7406\uFF0C\u9002\u7528\u4E8E\u7F16\u5267\u3001\u6E38\u620F\u8BBE\u8BA1\u548C\u6C89\u6D78\u5F0F\u53D9\u4E8B\uFF0C\u5E2E\u52A9\u7528\u6237\u5728\u521B\u9020\u529B\u4E0E\u903B\u8F91\u4E00\u81F4\u6027\u4E4B\u95F4\u53D6\u5F97\u5E73\u8861\u3002","Click Search, link the world":"\u70B9\u51FB\u641C\u7D22\uFF0C\u8FDE\u63A5\u4E16\u754C","Qwen\'s web search functionality connects users to a vast digital ecosystem, delivering fast, reliable, and real-time answers enriched with authoritative sources. Whether exploring trending topics, verifying facts, or accessing specialized knowledge, Qwen ensures precision and seamless access to credible insights. Qwen\'s web search empowers users to navigate the expanding web landscape efficiently, bridging the gap between questions and trusted information.":"Qwen \u7684\u7F51\u7EDC\u641C\u7D22\u529F\u80FD\u5C06\u7528\u6237\u8FDE\u63A5\u5230\u4E00\u4E2A\u5E9E\u5927\u7684\u6570\u5B57\u751F\u6001\u7CFB\u7EDF\uFF0C\u63D0\u4F9B\u5FEB\u901F\u3001\u53EF\u9760\u548C\u5B9E\u65F6\u7684\u7B54\u6848\uFF0C\u5E76\u4E14\u7B54\u6848\u6765\u6E90\u4E8E\u6743\u5A01\u6E20\u9053\u3002\u65E0\u8BBA\u662F\u63A2\u7D22\u70ED\u95E8\u8BDD\u9898\u3001\u9A8C\u8BC1\u4E8B\u5B9E\uFF0C\u8FD8\u662F\u83B7\u53D6\u4E13\u4E1A\u77E5\u8BC6\uFF0CQwen\u90FD\u80FD\u786E\u4FDD\u7CBE\u51C6\u5E76\u65E0\u7F1D\u8BBF\u95EE\u53EF\u4FE1\u7684\u89C1\u89E3\u3002Qwen\u7684\u7F51\u7EDC\u641C\u7D22\u4F7F\u7528\u6237\u80FD\u591F\u9AD8\u6548\u5730\u6D4F\u89C8\u4E0D\u65AD\u6269\u5C55\u7684\u7F51\u7EDC\u73AF\u5883\uFF0C\u5F25\u5408\u95EE\u9898\u4E0E\u53EF\u4FE1\u4FE1\u606F\u4E4B\u95F4\u7684\u5DEE\u8DDD\u3002","Read the document and summary.":"\u9605\u8BFB\u6587\u4EF6\u548C\u6458\u8981","By uploading structured or unstructured data files, such as CSV, Excel, or text documents, Qwen can automate data analysis, generate concise summaries, and create insightful visualizations. With the ability to process up to 1 million tokens, Qwen efficiently extracts key insights from lengthy documents, helping you make informed decisions faster.":"\u901A\u8FC7\u4E0A\u4F20\u7ED3\u6784\u5316\u6216\u975E\u7ED3\u6784\u5316\u7684\u6570\u636E\u6587\u4EF6\uFF0C\u5982 CSV\u3001Excel \u6216\u6587\u672C\u6587\u6863\uFF0CQwen\u80FD\u591F\u81EA\u52A8\u8FDB\u884C\u6570\u636E\u5206\u6790\u3001\u751F\u6210\u7B80\u6D01\u7684\u6458\u8981\u5E76\u521B\u5EFA\u5BCC\u6709\u6D1E\u5BDF\u529B\u7684\u53EF\u89C6\u5316\u56FE\u8868\u3002\u51ED\u501F\u5904\u7406\u591A\u8FBE100\u4E07\u4E2A\u4EE4\u724C\u7684\u80FD\u529B\uFF0CQwen\u80FD\u9AD8\u6548\u5730\u4ECE\u5197\u957F\u7684\u6587\u6863\u4E2D\u63D0\u53D6\u5173\u952E\u89C1\u89E3\uFF0C\u52A9\u60A8\u66F4\u5FEB\u505A\u51FA\u660E\u667A\u51B3\u7B56\u3002","Multimodal understanding, let\'s talk about audio, image, and video.":"\u591A\u6A21\u6001\u7406\u89E3\uFF0C\u8BA9\u6211\u4EEC\u8C08\u8C08\u97F3\u9891\u3001\u56FE\u50CF\u548C\u89C6\u9891\u3002","Qwen allows you to process audios, images, and videos without switching models \u2014simply use your preferred model, and the system automatically leverages its counterpart for multimodal inputs.":"\u901A\u4E49\u5343\u95EE\u804A\u5929\u529F\u80FD\u5141\u8BB8\u60A8\u5904\u7406\u97F3\u9891\u3001\u56FE\u50CF\u548C\u89C6\u9891\uFF0C\u800C\u65E0\u9700\u5207\u6362\u6A21\u578B\u2014\u2014\u53EA\u9700\u4F7F\u7528\u60A8\u504F\u597D\u7684\u6A21\u578B\uFF0C\u7CFB\u7EDF\u4F1A\u81EA\u52A8\u5229\u7528\u5176\u5BF9\u5E94\u7684\u591A\u6A21\u6001\u8F93\u5165\u5904\u7406\u80FD\u529B\u3002","Create images and videos":"\u521B\u5EFA\u56FE\u50CF\u548C\u89C6\u9891","Ask Qwen to create images and videos using a simple prompt or detailed paragraph.":"\u8BA9Qwen\u6839\u636E\u7B80\u5355\u7684\u63D0\u793A\u6216\u8BE6\u7EC6\u6BB5\u843D\u521B\u5EFA\u56FE\u50CF\u548C\u89C6\u9891\u3002","Start building websites with HTML! Qwen Artifacts enables users to effortlessly create, reference, and update dynamic HTML content and SVG images in conversations, with real-time visualization.":"\u5F00\u59CB\u4F7F\u7528HTML\u5236\u4F5C\u7F51\u7AD9\u5427\uFF01Qwen Artifacts\u4F7F\u7528\u6237\u80FD\u591F\u5728\u5BF9\u8BDD\u4E2D\u65E0\u7F1D\u751F\u6210\u3001\u5F15\u7528\u548C\u66F4\u65B0\u52A8\u6001HTML\u5185\u5BB9\u548CSVG\u56FE\u50CF\uFF0C\u5E76\u63D0\u4F9B\u5B9E\u65F6\u53EF\u89C6\u5316\u529F\u80FD\u3002","Code generation":"\u4EE3\u7801\u751F\u6210","Chat Completions API":"\u804A\u5929\u8865\u5168 API","Get acess to Qwen series models with a few lines of code. Users use Chat Completions API for downstream tasks, such as question answering, conversion, coding assistance, creative writing, tool use, etc. ":"\u901A\u8FC7\u51E0\u884C\u4EE3\u7801\u5373\u53EF\u8BBF\u95EE\u901A\u4E49\u5343\u95EE\u7CFB\u5217\u6A21\u578B\u3002\u7528\u6237\u4F7F\u7528\u804A\u5929\u8865\u5168API\u6765\u5B8C\u6210\u4E0B\u6E38\u4EFB\u52A1\uFF0C\u5982\u95EE\u7B54\u3001\u8F6C\u6362\u3001\u7F16\u7801\u8F85\u52A9\u3001\u521B\u610F\u5199\u4F5C\u3001\u5DE5\u5177\u4F7F\u7528\u7B49\u3002","Realtime API":"\u5B9E\u65F6 API","Build low-latency, multimodal experiences, including speech-to-speech. This approach is suitable for scenarios such as video chat, audio chat and avatar.":"\u6784\u5EFA\u4F4E\u5EF6\u8FDF\u3001\u591A\u6A21\u5F0F\u7684\u4F53\u9A8C\uFF0C\u5305\u62EC\u8BED\u97F3\u5230\u8BED\u97F3\u3002\u8FD9\u79CD\u65B9\u6CD5\u9002\u7528\u4E8E\u89C6\u9891\u804A\u5929\u3001\u97F3\u9891\u804A\u5929\u548C\u865A\u62DF\u5F62\u8C61\u7B49\u573A\u666F\u3002","Batch API":"\u6279\u91CF API","Use the Batch API to initiate offline tasks that utilize lower-cost computing resources. This approach is suitable for scenarios where immediate results are not required and there is a need for offline processing of large amounts of data, such as model evaluation, semantic extraction of datasets, and batch extraction of text vectors.":"\u4F7F\u7528 Batch API \u6765\u542F\u52A8\u5229\u7528\u8F83\u4F4E\u6210\u672C\u8BA1\u7B97\u8D44\u6E90\u7684\u79BB\u7EBF\u4EFB\u52A1\u3002\u8FD9\u79CD\u65B9\u6CD5\u9002\u7528\u4E8E\u4E0D\u9700\u8981\u5373\u65F6\u7ED3\u679C\uFF0C\u5E76\u4E14\u9700\u8981\u5BF9\u5927\u91CF\u6570\u636E\u8FDB\u884C\u79BB\u7EBF\u5904\u7406\u7684\u573A\u666F\uFF0C\u4F8B\u5982\u6A21\u578B\u8BC4\u4F30\u3001\u6570\u636E\u96C6\u8BED\u4E49\u63D0\u53D6\u548C\u6587\u672C\u5411\u91CF\u7684\u6279\u91CF\u63D0\u53D6\u3002","Enhance model responses with up-to-date and clearly cited answers from the web search.":"\u901A\u8FC7\u7F51\u7EDC\u641C\u7D22\u589E\u5F3A\u6A21\u578B\u54CD\u5E94\uFF0C\u63D0\u4F9B\u6700\u65B0\u4E14\u5F15\u7528\u6E05\u6670\u7684\u7B54\u6848\u3002","Function Call":"\u51FD\u6570\u8C03\u7528","connect large language models to external tools for more complex tasks.":"\u5C06\u5927\u578B\u8BED\u8A00\u6A21\u578B\u8FDE\u63A5\u5230\u5916\u90E8\u5DE5\u5177\u4EE5\u5B8C\u6210\u66F4\u590D\u6742\u7684\u4EFB\u52A1\u3002","Unfortunately, Qwen is only available in certain regions right now. Please contact support if you believe you are receiving this message in error.":"\u975E\u5E38\u62B1\u6B49\uFF0CQwen \u76EE\u524D\u4EC5\u5728\u7279\u5B9A\u5730\u533A\u53EF\u7528\u3002\u5982\u679C\u60A8\u8BA4\u4E3A\u6536\u5230\u6B64\u6D88\u606F\u662F\u9519\u8BEF\u7684\uFF0C\u8BF7\u8054\u7CFB\u652F\u6301\u4EBA\u5458\u3002","Start now":"\u73B0\u5728\u5F00\u59CB","Qwen is an AI assistant for everyone, powered by the Qwen series models. It\u2019s free to use, open to all, and ready to help with creativity, collaboration, and endless possibilities. Just ask, and let Qwen do the rest.":"\u901A\u4E49\u5343\u95EE\u804A\u5929\u52A9\u624B\u662F\u4E00\u6B3E\u9762\u5411\u6240\u6709\u4EBA\u7684AI\u52A9\u624B\uFF0C\u7531\u901A\u4E49\u7CFB\u5217\u6A21\u578B\u63D0\u4F9B\u652F\u6301\u3002\u5B83\u514D\u8D39\u4F7F\u7528\uFF0C\u5BF9\u6240\u6709\u4EBA\u5F00\u653E\uFF0C\u968F\u65F6\u51C6\u5907\u5E2E\u52A9\u60A8\u53D1\u6325\u521B\u610F\u3001\u534F\u4F5C\u548C\u65E0\u9650\u53EF\u80FD\u3002\u53EA\u8981\u63D0\u95EE\uFF0C\u5269\u4E0B\u7684\u4EA4\u7ED9\u901A\u4E49\u5343\u95EE\u804A\u5929\u52A9\u624B\u3002","Download the app":"\u4E0B\u8F7D\u5E94\u7528\u7A0B\u5E8F","Try Free":"\u514D\u8D39\u8BD5\u7528","Get Plus":"\u83B7\u53D6 Plus","Learn more":"\u4E86\u89E3\u66F4\u591A","Building AI Products with Qwen":"\u4F7F\u7528 Qwen \u6784\u5EFA AI \u4EA7\u54C1","Qwen API, which uses an API format compatible with the OpenAI API, means that developers can use the Qwen model services provided by Alibaba Cloud simply by changing the key and base URL. This compatibility allows for the use of the OpenAI SDK and easy integration with services that are OpenAI API compatible. The chat completion service offered by Qwen API can receive prompt inputs and generate text responses, suitable for applications such as question answering, conversation, content creation, translation, summarization, code assistance, and more.":"Qwen API \u4F7F\u7528\u4E0E OpenAI API \u517C\u5BB9\u7684 API \u683C\u5F0F\uFF0C\u8FD9\u610F\u5473\u7740\u5F00\u53D1\u8005\u53EA\u9700\u66F4\u6539\u5BC6\u94A5\u548C\u57FA\u7840URL\uFF0C\u5373\u53EF\u4F7F\u7528\u963F\u91CC\u4E91\u63D0\u4F9B\u7684Qwen\u6A21\u578B\u670D\u52A1\u3002\u8FD9\u79CD\u517C\u5BB9\u6027\u5141\u8BB8\u4F7F\u7528 OpenAI SDK\uFF0C\u5E76\u8F7B\u677E\u96C6\u6210\u4E0E OpenAI API \u517C\u5BB9\u7684\u670D\u52A1\u3002Qwen API \u63D0\u4F9B\u7684\u804A\u5929\u8865\u5168\u670D\u52A1\u53EF\u4EE5\u63A5\u6536\u63D0\u793A\u8F93\u5165\u5E76\u751F\u6210\u6587\u672C\u56DE\u590D\uFF0C\u9002\u7528\u4E8E\u95EE\u7B54\u3001\u5BF9\u8BDD\u3001\u5185\u5BB9\u521B\u4F5C\u3001\u7FFB\u8BD1\u3001\u6458\u8981\u3001\u4EE3\u7801\u8F85\u52A9\u7B49\u5E94\u7528\u3002","Start building":"\u5F00\u59CB\u6784\u5EFA","Our Flagship Models":"\u65D7\u8230\u6A21\u578B","Flagship Models":"Qwen \u65D7\u8230\u6A21\u578B","Unlock the potential of Qwen through APIs":"\u901A\u8FC7 API \u89E3\u9501 Qwen \u7684\u6F5C\u5728\u80FD\u529B","Boost productivity with Qwen Agent":"\u4F7F\u7528 Qwen Agent \u63D0\u5347\u751F\u4EA7\u529B","Go API Platform":"\u524D\u5F80 API \u5E73\u53F0","Qwen is an AI assistant for everyone, powered by the Qwen series models. It\u2019s free to use, open to all, and ready to help with creativity, collaboration, and endless possibilities. ":"Qwen \u662F\u4E00\u6B3E\u9762\u5411\u6240\u6709\u4EBA\u7684 AI \u52A9\u624B\uFF0C\u7531\u901A\u4E49\u7CFB\u5217\u6A21\u578B\u63D0\u4F9B\u652F\u6301\u3002\u5B83\u514D\u8D39\u4F7F\u7528\uFF0C\u5BF9\u6240\u6709\u4EBA\u5F00\u653E\uFF0C\u968F\u65F6\u51C6\u5907\u5E2E\u52A9\u60A8\u53D1\u6325\u521B\u610F\u3001\u534F\u540C\u5408\u4F5C\uFF0C\u5F00\u542F\u65E0\u9650\u53EF\u80FD\u3002","Qwen API, which uses an API format compatible with the OpenAI API.":"Qwen API\uFF0C\u5B83\u4F7F\u7528\u4E0E OpenAI API \u517C\u5BB9\u7684 API \u683C\u5F0F\u3002","Use Qwen on your phone or desktop.":"\u5728\u624B\u673A\u6216\u684C\u9762\u4E0A\u4F7F\u7528\u901A\u4E49\u5343\u95EE\u3002","Use Now":"\u7ACB\u5373\u4F7F\u7528","Products Features":"\u4EA7\u54C1\u529F\u80FD","Explore Qwen":"\u63A2\u7D22 Qwen","Latest Research":"\u6700\u65B0\u7814\u7A76","View all":"\u67E5\u770B\u5168\u90E8","Get started with Qwen":"\u5F00\u59CB\u4F7F\u7528 Qwen","Latest advancements":"\u6700\u65B0\u8FDB\u5C55","Read Me":"\u8BFB\u6211","Newest":"\u6700\u65B0\u7684","Oldest":"\u6700\u8001\u7684","Sort":"\u6392\u5E8F","All":"\u5168\u90E8","Load more":"\u52A0\u8F7D\u66F4\u591A","Explore frontier model technologies":"\u63A2\u7D22\u524D\u6CBF\u6A21\u578B\u6280\u672F","Go to Github":"\u524D\u5F80 Github","For Mobile":"\u79FB\u52A8\u7AEF","Chat on the go, have voice conversations, and ask about photos.":"\u5728\u8DEF\u4E0A\u804A\u5929\uFF0C\u8FDB\u884C\u8BED\u97F3\u5BF9\u8BDD\uFF0C\u5E76\u8BE2\u95EE\u7167\u7247\u76F8\u5173\u4FE1\u606F\u3002","Download for iOS":"\u4E0B\u8F7D iOS \u7248\u672C","iOS":"iOS","Download for Android":"\u4E0B\u8F7D Android \u7248\u672C","For Desktop":"\u684C\u9762\u7AEF","Chat about email, screenshots, files, and anything on your screen.":"\u804A\u804A\u7535\u5B50\u90AE\u4EF6\u3001\u622A\u56FE\u3001\u6587\u4EF6\u4EE5\u53CA\u60A8\u5C4F\u5E55\u4E0A\u7684\u4EFB\u4F55\u5185\u5BB9\u3002","Download for macOS x64":"\u4E0B\u8F7D macOS (x64) \u7248\u672C","Download for macOS arm":"\u4E0B\u8F7D macOS (ARM) \u7248\u672C","Download for macOS":"\u4E0B\u8F7D macOS \u7248\u672C","macOS":"macOS","Download for Windows":"\u4E0B\u8F7D Windows \u7248\u672C","Qwen":"Qwen","Research":"\u7814\u7A76","API Platform":"API \u5E73\u53F0","Try Qwen":"\u4F7F\u7528 Qwen","Try Qwen On":"\u4F7F\u7528\u901A\u4E49\u5343\u95EE","Android":"Android","Windows":"Windows","More Features":"\u66F4\u591A\u529F\u80FD","Pricing":"\u5B9A\u4EF7","Platform Overview":"\u5E73\u53F0\u6982\u89C8","Research Index":"\u7814\u7A76\u7D22\u5F15","Github":"GitHub","Terms & Policles":"\u6761\u6B3E\u4E0E\u653F\u7B56","Powered by Alibaba Cloud":"\u7531\u963F\u91CC\u4E91\u63D0\u4F9B\u652F\u6301","Retry":"\u91CD\u8BD5","The current content is loading incorrectly":"\u5F53\u524D\u5185\u5BB9\u52A0\u8F7D\u4E0D\u6B63\u786E","We\u2019re sorry for the inconvenience. It seems there was an issue loading the requested information. You can try refreshing the page to see if that resolves the problem. If the issue persists, please feel free to reach out to us by emailing feedback@qwen.com , and we\u2019ll be happy to assist you.":"\u6211\u4EEC\u5BF9\u9020\u6210\u7684\u4E0D\u4FBF\u8868\u793A\u6B49\u610F\u3002\u4F3C\u4E4E\u5728\u52A0\u8F7D\u6240\u8BF7\u6C42\u7684\u4FE1\u606F\u65F6\u51FA\u73B0\u4E86\u95EE\u9898\u3002\u60A8\u53EF\u4EE5\u5C1D\u8BD5\u5237\u65B0\u9875\u9762\uFF0C\u770B\u770B\u662F\u5426\u80FD\u89E3\u51B3\u95EE\u9898\u3002\u5982\u679C\u95EE\u9898\u4ECD\u7136\u5B58\u5728\uFF0C\u8BF7\u968F\u65F6\u901A\u8FC7\u7535\u5B50\u90AE\u4EF6feedback@qwen.com\u8054\u7CFB\u6211\u4EEC\uFF0C\u6211\u4EEC\u5C06\u4E50\u610F\u4E3A\u60A8\u63D0\u4F9B\u5E2E\u52A9\u3002","Go Back":"\u8FD4\u56DE","The content loading failed. ":"\u5185\u5BB9\u52A0\u8F7D\u5931\u8D25\u3002","minute":"\u5206\u949F","hour":"\u5C0F\u65F6","second":"\u79D2","words":"\u8BCD","Translations":"\u7FFB\u8BD1","Demo":"\u6F14\u793A","Demo Cases":"\u6F14\u793A\u6848\u4F8B","Expand all demos":"\u5C55\u5F00\u6240\u6709\u6F14\u793A","Inputs":"\u8F93\u5165","Outputs":"\u8F93\u51FA","Qwen Boost productivity with Qwen Agent":"Qwen Agent\u63D0\u5347\u751F\u4EA7\u529B","The Deep Research feature is designed to assist users in conducting in-depth topic research and information synthesis.":"\u6DF1\u5EA6\u7814\u7A76\u529F\u80FD\u65E8\u5728\u5E2E\u52A9\u7528\u6237\u8FDB\u884C\u6DF1\u5165\u7684\u4E3B\u9898\u7814\u7A76\u548C\u4FE1\u606F\u7EFC\u5408\u3002","Begin crafting websites with HTML! Qwen Artifacts empowers users to seamlessly generate, reference, and update dynamic HTML content and SVG images within conversations, complete with real-time visualization.":"\u5F00\u59CB\u4F7F\u7528HTML\u5236\u4F5C\u7F51\u7AD9\u5427\uFF01Qwen Artifacts\u4F7F\u7528\u6237\u80FD\u591F\u5728\u5BF9\u8BDD\u4E2D\u65E0\u7F1D\u751F\u6210\u3001\u5F15\u7528\u548C\u66F4\u65B0\u52A8\u6001HTML\u5185\u5BB9\u548CSVG\u56FE\u50CF\uFF0C\u5E76\u63D0\u4F9B\u5B9E\u65F6\u53EF\u89C6\u5316\u529F\u80FD\u3002","context length":"\u4E0A\u4E0B\u6587\u957F\u5EA6","Usage Policy":"\u4F7F\u7528\u653F\u7B56","Training Data Summary":"\u8BAD\u7EC3\u6570\u636E\u62AB\u9732\u6458\u8981","Cookies Notice":"Cookie \u901A\u77E5","Save":"\u4FDD\u5B58","Read more":"\u8BFB\u66F4\u591A","Build with Qwen API":"\u4F7F\u7528 Qwen API \u6784\u5EFA","Copying to clipboard was successful!":"\u6210\u529F\u590D\u5236\u5230\u526A\u8D34\u677F\uFF01","Contract\xa0sales":"Contract\xa0sales","Contact sales":"\u8054\u7CFB\u9500\u552E\u4EBA\u5458","Search":"\u641C\u7D22","Image":"\u56FE\u50CF","Text":"\u6587\u672C","Video":"\u89C6\u9891","Audio":"\u8BED\u97F3","Try Now":"\u7ACB\u5373\u5C1D\u8BD5","Not available in the current area":"\u5F53\u524D\u533A\u57DF\u4E0D\u53EF\u7528","Download Now":"\u7ACB\u5373\u4E0B\u8F7D","Multimodal Understanding":"\u591A\u6A21\u6001\u7406\u89E3","Qwen VLo empowers your creative projects by transforming ideas into stunning visuals \u2014 now with deeper understanding and precise control.Modify images, transfer styles, generate from scratch, or combine multiple elements \u2014 all with a unified model that understands and creates.":"Qwen VLo \u901A\u8FC7\u5C06\u60F3\u6CD5\u8F6C\u5316\u4E3A\u4EE4\u4EBA\u60CA\u53F9\u7684\u89C6\u89C9\u6548\u679C\u6765\u4E3A\u60A8\u7684\u521B\u610F\u9879\u76EE\u8D4B\u80FD\u2014\u2014\u73B0\u5728\u5177\u5907\u66F4\u6DF1\u5C42\u6B21\u7684\u7406\u89E3\u548C\u7CBE\u51C6\u63A7\u5236\u3002\u4FEE\u6539\u56FE\u50CF\u3001\u8F6C\u6362\u98CE\u683C\u3001\u4ECE\u96F6\u751F\u6210\u6216\u7EC4\u5408\u591A\u4E2A\u5143\u7D20\u2014\u2014\u6240\u6709\u8FD9\u4E9B\u90FD\u7531\u4E00\u4E2A\u80FD\u591F\u7406\u89E3\u548C\u521B\u9020\u7684\u7EDF\u4E00\u6A21\u578B\u5B8C\u6210\u3002","Deep Research is an intelligent agent system that leverages the vast amount of information available on the internet to perform multi-step searches and analytical summaries for complex tasks. It delivers comprehensive and easy-to-read reports, significantly improving users\' efficiency when handling time-consuming tasks. With Deep Research, tasks that used to take hours can now be completed in just a few minutes.":"Deep Research \u662F\u4E00\u4E2A\u667A\u80FD\u4EE3\u7406\u7CFB\u7EDF\uFF0C\u5B83\u5229\u7528\u4E92\u8054\u7F51\u4E0A\u5927\u91CF\u7684\u4FE1\u606F\u6765\u6267\u884C\u591A\u6B65\u9AA4\u641C\u7D22\u548C\u5206\u6790\u603B\u7ED3\uFF0C\u4EE5\u5B8C\u6210\u590D\u6742\u7684\u4EFB\u52A1\u3002\u5B83\u63D0\u4F9B\u5168\u9762\u4E14\u6613\u4E8E\u9605\u8BFB\u7684\u62A5\u544A\uFF0C\u663E\u8457\u63D0\u9AD8\u4E86\u7528\u6237\u5904\u7406\u8017\u65F6\u4EFB\u52A1\u7684\u6548\u7387\u3002\u901A\u8FC7\u6DF1\u5EA6\u7814\u7A76\uFF0C\u4EE5\u524D\u9700\u8981\u82B1\u8D39\u6570\u5C0F\u65F6\u624D\u80FD\u5B8C\u6210\u7684\u4EFB\u52A1\u73B0\u5728\u53EA\u9700\u51E0\u5206\u949F\u5373\u53EF\u5B8C\u6210\u3002","Web Dev empowers web developers to create stunning, functional websites with just a natural language prompt. Simply describe your vision, and get a complete, ready-to-use webpage with clean code and modern design \u2014 no coding or design skills required.":"Web Dev \u8BA9\u7F51\u9875\u5F00\u53D1\u8005\u80FD\u591F\u4EC5\u901A\u8FC7\u81EA\u7136\u8BED\u8A00\u63D0\u793A\u5C31\u80FD\u521B\u5EFA\u51FA\u65E2\u7F8E\u89C2\u53C8\u5B9E\u7528\u7684\u7F51\u7AD9\u3002\u53EA\u9700\u63CF\u8FF0\u4F60\u7684\u613F\u666F\uFF0C\u5C31\u80FD\u83B7\u5F97\u4E00\u4E2A\u5305\u542B\u6574\u6D01\u4EE3\u7801\u548C\u73B0\u4EE3\u8BBE\u8BA1\u7684\u5B8C\u6574\u3001\u5373\u7528\u578B\u7F51\u9875\u2014\u2014\u65E0\u9700\u4EFB\u4F55\u7F16\u7A0B\u6216\u8BBE\u8BA1\u6280\u80FD\u3002","Qwen excels in advanced reasoning and problem-solving. This enables it to tackle complex issues with clarity and precision, leveraging real-time internet data to deliver comprehensive, logical, and actionable solutions.":"Qwen \u5728\u9AD8\u7EA7\u63A8\u7406\u548C\u89E3\u51B3\u95EE\u9898\u65B9\u9762\u8868\u73B0\u51FA\u8272\u3002\u8FD9\u4F7F\u5B83\u80FD\u591F\u6E05\u6670\u51C6\u786E\u5730\u5904\u7406\u590D\u6742\u95EE\u9898\uFF0C\u5229\u7528\u5B9E\u65F6\u4E92\u8054\u7F51\u6570\u636E\u63D0\u4F9B\u5168\u9762\u3001\u903B\u8F91\u6027\u5F3A\u4E14\u53EF\u64CD\u4F5C\u7684\u89E3\u51B3\u65B9\u6848\u3002","Harness the power of intelligent search with Qwen. Quickly find answers, resources, or inspiration from across the web. With advanced filtering and contextual understanding, Qwen delivers precise results that match your query. Whether it\u2019s researching a topic, finding recipes, or discovering new trends, Qwen ensures you have access to the most relevant information at your fingertips.":"\u5229\u7528 Qwen \u7684\u667A\u80FD\u641C\u7D22\u529F\u80FD\uFF0C\u5FEB\u901F\u4ECE\u7F51\u7EDC\u4E0A\u627E\u5230\u7B54\u6848\u3001\u8D44\u6E90\u6216\u7075\u611F\u3002\u51ED\u501F\u5148\u8FDB\u7684\u8FC7\u6EE4\u548C\u4E0A\u4E0B\u6587\u7406\u89E3\u80FD\u529B\uFF0CQwen \u63D0\u4F9B\u4E0E\u60A8\u7684\u67E5\u8BE2\u76F8\u5339\u914D\u7684\u7CBE\u786E\u7ED3\u679C\u3002\u65E0\u8BBA\u662F\u7814\u7A76\u4E3B\u9898\u3001\u67E5\u627E\u98DF\u8C31\u8FD8\u662F\u53D1\u73B0\u65B0\u8D8B\u52BF\uFF0CQwen\u90FD\u80FD\u786E\u4FDD\u60A8\u89E6\u624B\u53EF\u53CA\u6700\u76F8\u5173\u7684\u4FE1\u606F\u3002","Qwen boasts powerful multimodal understanding capabilities, enabling it to process and analyze various types of information such as text, images, audio, and video simultaneously. Whether it\u2019s interpreting data from a chart, extracting key information from an audio clip, or generating comprehensive responses by combining text and images, Qwen handles these tasks with ease. Through advanced cross-modal deep learning technology, Qwen helps you tackle complex tasks more efficiently, enhancing both work productivity and learning experiences.":"Qwen \u62E5\u6709\u5F3A\u5927\u7684\u591A\u6A21\u6001\u7406\u89E3\u80FD\u529B\uFF0C\u80FD\u591F\u540C\u65F6\u5904\u7406\u548C\u5206\u6790\u6587\u672C\u3001\u56FE\u50CF\u3001\u97F3\u9891\u548C\u89C6\u9891\u7B49\u5404\u79CD\u7C7B\u578B\u7684\u4FE1\u606F\u3002\u65E0\u8BBA\u662F\u89E3\u8BFB\u56FE\u8868\u4E2D\u7684\u6570\u636E\u3001\u4ECE\u97F3\u9891\u7247\u6BB5\u4E2D\u63D0\u53D6\u5173\u952E\u4FE1\u606F\uFF0C\u8FD8\u662F\u901A\u8FC7\u7ED3\u5408\u6587\u672C\u548C\u56FE\u50CF\u751F\u6210\u5168\u9762\u7684\u56DE\u5E94\uFF0CQwen \u90FD\u80FD\u8F7B\u677E\u5E94\u5BF9\u8FD9\u4E9B\u4EFB\u52A1\u3002\u901A\u8FC7\u5148\u8FDB\u7684\u8DE8\u6A21\u6001\u6DF1\u5EA6\u5B66\u4E60\u6280\u672F\uFF0CQwen \u5E2E\u52A9\u60A8\u66F4\u9AD8\u6548\u5730\u5904\u7406\u590D\u6742\u4EFB\u52A1\uFF0C\u63D0\u9AD8\u5DE5\u4F5C\u751F\u4EA7\u529B\u548C\u5B66\u4E60\u4F53\u9A8C\u3002","Build with Qwen via OpenAI-compatible API. Power apps for chat, Q&A, creative writing, translation, summarization, and coding. ":"\u901A\u8FC7\u517C\u5BB9 OpenAI \u7684 API \u4F7F\u7528\u901A\u4E49\u5343\u95EE\u6784\u5EFA\u3002\u4E3A\u804A\u5929\u3001\u95EE\u7B54\u3001\u521B\u610F\u5199\u4F5C\u3001\u7FFB\u8BD1\u3001\u6458\u8981\u548C\u7F16\u7A0B\u7B49\u5E94\u7528\u63D0\u4F9B\u652F\u6301\u3002","Input is limited to 1,000 characters. For longer inputs, please visit https://chat.qwen.ai/ to use the full feature.":"\u8F93\u5165\u9650\u5236\u4E3A1,000\u4E2A\u5B57\u7B26\u3002\u5982\u9700\u5904\u7406\u66F4\u957F\u7684\u8F93\u5165\uFF0C\u8BF7\u8BBF\u95EE https://chat.qwen.ai/ \u4F7F\u7528\u5B8C\u6574\u529F\u80FD\u3002","qwencode.title":"\u7528 Qwen Code \u7F16\u7A0B","qwencode.subtitle":"Qwen Code \u662F\u4E00\u6B3E\u5F00\u6E90\u7684\u7EC8\u7AEF AI \u667A\u80FD\u4F53\uFF0C\u4E13\u4E3A Qwen \u7CFB\u5217\u6A21\u578B\u4F18\u5316\u3002\u5B83\u80FD\u5E2E\u52A9\u4F60\u7406\u89E3\u5927\u578B\u4EE3\u7801\u5E93\u3001\u81EA\u52A8\u5316\u7E41\u7410\u5DE5\u4F5C\uFF0C\u52A0\u901F\u4EA4\u4ED8\u3002","qwencode.getStarted":"\u5F00\u6E90\u4ED3\u5E93","qwencode.viewDocs":"\u67E5\u770B\u6587\u6863","qwencode.whyTitle":"\u4E3A\u4EC0\u4E48\u9009\u62E9 Qwen Code\uFF1F","qwencode.why.multiProtocol.title":"\u591A\u534F\u8BAE\u652F\u6301","qwencode.why.multiProtocol.desc":"\u652F\u6301 OpenAI / Anthropic / Gemini \u517C\u5BB9\u7684 API\uFF0C\u4E5F\u53EF\u901A\u8FC7 Qwen OAuth \u767B\u5F55\u3002","qwencode.why.openSource.title":"\u5F00\u6E90\u5171\u8FDB\uFF0C\u534F\u540C\u6F14\u8FDB","qwencode.why.openSource.desc":"\u6846\u67B6\u548C Qwen \u7CFB\u5217\u6A21\u578B\u5747\u4E3A\u5F00\u6E90\u2014\u2014\u5B83\u4EEC\u540C\u6B65\u53D1\u5E03\u3001\u5171\u540C\u6F14\u8FDB\u3002","qwencode.why.agenticWorkflow.title":"\u667A\u80FD\u4F53\u5DE5\u4F5C\u6D41\uFF0C\u529F\u80FD\u4E30\u5BCC","qwencode.why.agenticWorkflow.desc":"\u5185\u7F6E\u4E30\u5BCC\u7684\u5DE5\u5177\uFF08Skills\u3001SubAgents\uFF09\uFF0C\u63D0\u4F9B\u5B8C\u6574\u7684\u667A\u80FD\u4F53\u5DE5\u4F5C\u6D41\u548C\u7C7B\u4F3C Claude Code \u7684\u4F53\u9A8C\u3002","qwencode.why.terminalFirst.title":"\u7EC8\u7AEF\u4F18\u5148\uFF0CIDE \u53CB\u597D","qwencode.why.terminalFirst.desc":"\u4E3A\u547D\u4EE4\u884C\u5F00\u53D1\u8005\u6253\u9020\uFF0C\u540C\u65F6\u652F\u6301 VS Code\u3001Zed \u548C JetBrains IDE \u96C6\u6210\u3002","qwencode.usageTitle":"\u5982\u4F55\u4F7F\u7528 Qwen Code","qwencode.usageTitle.prefix":"\u5728\u4F60\u5DE5\u4F5C\u7684\u5730\u65B9","qwencode.usageTitle.highlight":"\u4F7F\u7528 Qwen Code","qwencode.usage.tab.interactive":"\u4EA4\u4E92\u6A21\u5F0F","qwencode.usage.tab.headless":"\u65E0\u5934\u6A21\u5F0F","qwencode.usage.tab.ide":"IDE","qwencode.usage.tab.sdk":"SDK","qwencode.usage.interactive.title":"\u4EA4\u4E92\u6A21\u5F0F","qwencode.usage.interactive.desc":"\u5728\u9879\u76EE\u76EE\u5F55\u4E2D\u8FD0\u884C \'qwen\' \u5373\u53EF\u542F\u52A8\u4EA4\u4E92\u5F0F\u7EC8\u7AEF\u754C\u9762\u3002\u4F7F\u7528 \'@\' \u5F15\u7528\u672C\u5730\u6587\u4EF6\uFF0C\u83B7\u53D6\u57FA\u4E8E\u4EE3\u7801\u5E93\u4E0A\u4E0B\u6587\u7684\u667A\u80FD\u8F85\u52A9\u3002","qwencode.usage.headless.title":"\u65E0\u5934\u6A21\u5F0F","qwencode.usage.headless.desc":"\u4F7F\u7528 \'-p\' \u53C2\u6570\u53EF\u5728\u65E0\u4EA4\u4E92\u754C\u9762\u4E0B\u8FD0\u884C Qwen Code\u2014\u2014\u975E\u5E38\u9002\u5408\u811A\u672C\u3001\u81EA\u52A8\u5316\u548C CI/CD \u6D41\u6C34\u7EBF\u3002\u5C06 AI \u65E0\u7F1D\u96C6\u6210\u5230\u4F60\u73B0\u6709\u7684\u5DE5\u4F5C\u6D41\u4E2D\u3002","qwencode.usage.ide.title":"IDE \u96C6\u6210","qwencode.usage.ide.desc":"\u5728\u4F60\u559C\u7231\u7684\u7F16\u8F91\u5668\u4E2D\u4F7F\u7528 Qwen Code\u2014\u2014\u652F\u6301 VS Code\u3001Zed \u548C JetBrains IDE\u3002\u65E0\u9700\u79BB\u5F00\u5F00\u53D1\u73AF\u5883\uFF0C\u5373\u53EF\u83B7\u5F97 AI \u9A71\u52A8\u7684\u7F16\u7801\u8F85\u52A9\u3002","qwencode.usage.sdk.title":"\u5F00\u53D1\u8005 SDK","qwencode.usage.sdk.desc":"\u57FA\u4E8E Qwen Code \u6784\u5EFA\u4F60\u81EA\u5DF1\u7684 AI Agent \u548C\u5DE5\u5177\u3002SDK \u63D0\u4F9B\u4E0E CLI \u540C\u6E90\u7684\u5F3A\u5927\u5F15\u64CE\u7684\u7F16\u7A0B\u63A5\u53E3\uFF0C\u8BA9\u4F60\u8F7B\u677E\u6269\u5C55\u548C\u96C6\u6210\u3002","qwencode.install.copy":"\u590D\u5236","qwencode.cta":"\u5F00\u59CB\u4F7F\u7528 Qwen Code","We\'d like to use cookies to remember your preferences and show relevant content. You can accept all cookies for a fully personalized experience, or select only the strictly necessary ones to keep Qwen running securely. For more details, please read our {{Cookie Notice}}.":"\u6211\u4EEC\u5E0C\u671B\u4F7F\u7528 Cookie \u6765\u8BB0\u4F4F\u60A8\u7684\u504F\u597D\u5E76\u5C55\u793A\u76F8\u5173\u5185\u5BB9\u3002\u60A8\u53EF\u4EE5\u63A5\u53D7\u6240\u6709 Cookie \u4EE5\u83B7\u5F97\u5B8C\u5168\u4E2A\u6027\u5316\u7684\u4F53\u9A8C\uFF0C\u6216\u4EC5\u9009\u62E9\u4E25\u683C\u5FC5\u8981\u7684 Cookie \u4EE5\u786E\u4FDD\u901A\u4E49\u5343\u95EE\u804A\u5929\u5B89\u5168\u8FD0\u884C\u3002\u66F4\u591A\u8BE6\u60C5\uFF0C\u8BF7\u9605\u8BFB\u6211\u4EEC\u7684{cookieNotice}\u3002","Take control of your data privacy. On this page, you can manage how Qwen uses cookies to enhance your experience. Review and customize your consent settings below to decide which types of data collection align with your preferences.":"\u638C\u63A7\u60A8\u7684\u6570\u636E\u9690\u79C1\u3002\u5728\u6B64\u9875\u9762\uFF0C\u60A8\u53EF\u4EE5\u7BA1\u7406 Qwen \u5982\u4F55\u4F7F\u7528 Cookie \u6765\u63D0\u5347\u60A8\u7684\u4F53\u9A8C\u3002\u8BF7\u5728\u4E0B\u65B9\u67E5\u770B\u5E76\u81EA\u5B9A\u4E49\u60A8\u7684\u540C\u610F\u8BBE\u7F6E\uFF0C\u4EE5\u51B3\u5B9A\u54EA\u4E9B\u7C7B\u578B\u7684\u6570\u636E\u6536\u96C6\u7B26\u5408\u60A8\u7684\u504F\u597D\u3002","These essential cookies are required for Qwen to function correctly, ensuring secure sessions and basic features like message delivery. Unlike other categories, these cannot be disabled as the service relies on them to operate safely and effectively.":"\u8FD9\u4E9B\u5FC5\u8981 Cookie \u662F Qwen \u6B63\u5E38\u8FD0\u884C\u6240\u5FC5\u9700\u7684\uFF0C\u7528\u4E8E\u786E\u4FDD\u5B89\u5168\u4F1A\u8BDD\u548C\u6D88\u606F\u4F20\u9012\u7B49\u57FA\u672C\u529F\u80FD\u3002\u4E0E\u5176\u4ED6\u7C7B\u522B\u4E0D\u540C\uFF0C\u8FD9\u4E9B Cookie \u65E0\u6CD5\u7981\u7528\uFF0C\u56E0\u4E3A\u670D\u52A1\u4F9D\u8D56\u5B83\u4EEC\u6765\u5B89\u5168\u6709\u6548\u5730\u8FD0\u884C\u3002","Enable these cookies to allow us to deliver personalized content based on your interests and usage patterns. While disabling them won\'t affect Qwen\'s core functionality, it may result in seeing less targeted promotions.":"\u542F\u7528\u8FD9\u4E9B Cookie \u53EF\u8BA9\u6211\u4EEC\u6839\u636E\u60A8\u7684\u5174\u8DA3\u548C\u4F7F\u7528\u4E60\u60EF\u63D0\u4F9B\u4E2A\u6027\u5316\u5185\u5BB9\u3002\u7981\u7528\u5B83\u4EEC\u4E0D\u4F1A\u5F71\u54CD Qwen \u7684\u6838\u5FC3\u529F\u80FD\uFF0C\u4F46\u60A8\u770B\u5230\u7684\u63A8\u5E7F\u5185\u5BB9\u53EF\u80FD\u76F8\u5173\u6027\u8F83\u4F4E\u3002","Manage Cookies":"\u7BA1\u7406 Cookie","Manage":"\u7BA1\u7406","Strictly Necessary Cookies":"\u4E25\u683C\u5FC5\u8981\u7684Cookie","Advertising Cookies":"\u5E7F\u544ACookie","Accept all cookies":"\u63A5\u53D7\u6240\u6709 Cookie","Accept all strictly necessary cookies":"\u63A5\u53D7\u6240\u6709\u4E25\u683C\u5FC5\u8981\u7684 Cookie","Cookie Notice":"Cookie \u901A\u77E5","The PDF cannot be previewed in this browser. Click to download.":"PDF\u65E0\u6CD5\u5728\u6B64\u6D4F\u89C8\u5668\u4E2D\u9884\u89C8\uFF0C\u70B9\u51FB\u4E0B\u8F7D","Ambassador":"\u5927\u4F7F","page_not_found":"\u9875\u9762\u672A\u627E\u5230","page_not_found_desc":"{seconds} \u79D2\u540E\u81EA\u52A8\u8DF3\u8F6C\u81F3\u9996\u9875","back_to_home":"\u8FD4\u56DE\u9996\u9875"}'),l=JSON.parse('{"How can I help you today?":"How can I help you today?","More":"More","News":"News","Thinking":"Thinking","Web Search":"Web Search","Deep Research":"Deep Research","Artifacts":"Artifacts","Video Generation":"Video Generation","Image Generation":"Image Generation","Web Dev":"Web Dev","Download":"Download","Web":"Web","Overview":"Overview","Qwen Overview":"Qwen Overview","Models":"Models","Models Overview":"Models Overview","Terms of Service":"Terms of Service","Privacy Policy":"Privacy Policy","month":"month","Try Qwen everyday":"Try Qwen everyday","Chat on web, IOS and Android":"Chat on web, IOS and Android","Access to Qwen3 Models":"Access to Qwen3 Models","Limited access to Image and Video Generation":"Limited access to Image and Video Generation","Limited access to Deep Research":"Limited access to Deep Research","POPULAR":"POPULAR","More usage":"More usage","More Image and Video Generation usage":"More Image and Video Generation usage","More Deep Research usage":"More Deep Research usage","Opportunities to test new models":"Opportunities to test new models","Opportunities to test new features":"Opportunities to test new features","QWEN":"QWEN","Ask Qwen, Know More":"Ask Qwen, Know More","Unlock Qwen advanced Capabilities":"Unlock Qwen advanced Capabilities","QwQ is a high-performance reasoning model developed by Alibaba, focusing on complex logical reasoning, mathematical problem-solving, and programming tasks.":"QwQ is a high-performance reasoning model developed by Alibaba, focusing on complex logical reasoning, mathematical problem-solving, and programming tasks.","Product":"Product","MCP (Model Context Protocol) , which is a system designed to enhance the integration of AI models like Qwen with external tools, data sources, and real-time functionalities. This protocol allows for seamless interactions between Qwen and various systems or platforms.":"MCP (Model Context Protocol) is a system designed to enhance the integration of AI models like Qwen with external tools, data sources, and real-time functionalities, allowing for seamless interactions between Qwen and various systems or platforms.","Artifacts offers real-time preview capabilities for code and content, supporting formats like HTML, JavaScript and SVG.":"Artifacts offers real-time preview capabilities for code and content, supporting formats like HTML and Markdown. When generating code or documents","Think deeply and solve tough problems.":"Think deeply and solve tough problems.","By spending extra time analyzing and reasoning through complex questions, Qwen excels in reasoning and cognitive tasks, using critical thinking to solve challenging problems in math, science, coding, and more.":"By spending extra time analyzing and reasoning through complex questions, Qwen excels in reasoning and cognitive tasks, using critical thinking to solve challenging problems in math, science, coding, and more.","Creative writing and exploring ideas together with you":"Creative writing and exploring ideas together with you","Qwen combines chain-of-thought reasoning with creative idea generation to craft narratives, develop characters, and explore plots systematically. It serves as a writing assistant, suggesting scenarios and synthesizing ideas into cohesive frameworks. With multi-modal capabilities, it integrates visual and textual reasoning, making it versatile for screenwriting, game design, and immersive storytelling, empowering users to balance creativity with logical coherence.":"Qwen combines chain-of-thought reasoning with creative idea generation to craft narratives, develop characters, and explore plots systematically. It serves as a writing assistant, suggesting scenarios and synthesizing ideas into cohesive frameworks. With multi-modal capabilities, it integrates visual and textual reasoning, making it versatile for screenwriting, game design, and immersive storytelling, empowering users to balance creativity with logical coherence.","Click Search, link the world":"Click Search, link the world","Qwen\'s web search functionality connects users to a vast digital ecosystem, delivering fast, reliable, and real-time answers enriched with authoritative sources. Whether exploring trending topics, verifying facts, or accessing specialized knowledge, Qwen ensures precision and seamless access to credible insights. Qwen\'s web search empowers users to navigate the expanding web landscape efficiently, bridging the gap between questions and trusted information.":"Qwen\'s web search functionality connects users to a vast digital ecosystem, delivering fast, reliable, and real-time answers enriched with authoritative sources. Whether exploring trending topics, verifying facts, or accessing specialized knowledge, Qwen ensures precision and seamless access to credible insights. Qwen\'s web search empowers users to navigate the expanding web landscape efficiently, bridging the gap between questions and trusted information.","Read the document and summary.":"Read the document and summary.","By uploading structured or unstructured data files, such as CSV, Excel, or text documents, Qwen can automate data analysis, generate concise summaries, and create insightful visualizations. With the ability to process up to 1 million tokens, Qwen efficiently extracts key insights from lengthy documents, helping you make informed decisions faster.":"By uploading structured or unstructured data files, such as CSV, Excel, or text documents, Qwen can automate data analysis, generate concise summaries, and create insightful visualizations. With the ability to process up to 1 million tokens, Qwen efficiently extracts key insights from lengthy documents, helping you make informed decisions faster.","Multimodal understanding, let\'s talk about audio, image, and video.":"Multimodal understanding, let\'s talk about audio, image, and video.","Qwen allows you to process audios, images, and videos without switching models \u2014simply use your preferred model, and the system automatically leverages its counterpart for multimodal inputs.":"Qwen allows you to process audios, images, and videos without switching models \u2014simply use your preferred model, and the system automatically leverages its counterpart for multimodal inputs.","Create images and videos":"Create images and videos","Ask Qwen to create images and videos using a simple prompt or detailed paragraph.":"Ask Qwen to create images and videos using a simple prompt or detailed paragraph.","Start building websites with HTML! Qwen Artifacts enables users to effortlessly create, reference, and update dynamic HTML content and SVG images in conversations, with real-time visualization.":"Start building websites with HTML! Qwen Artifacts enables users to effortlessly create, reference, and update dynamic HTML content and SVG images in conversations, with real-time visualization.","Code generation":"Code generation","Chat Completions API":"Chat Completions API","Get acess to Qwen series models with a few lines of code. Users use Chat Completions API for downstream tasks, such as question answering, conversion, coding assistance, creative writing, tool use, etc. ":"Get access to the Qwen series models with just a few lines of code. Users utilize the Chat Completions API for downstream tasks, including question answering, conversion, coding assistance, creative writing, tool usage, and more.","Realtime API":"Realtime API","Build low-latency, multimodal experiences, including speech-to-speech. This approach is suitable for scenarios such as video chat, audio chat and avatar.":"Build low-latency, multimodal experiences, including speech-to-speech. This approach is suitable for scenarios such as video chat, audio chat, and avatar.","Batch API":"Batch API","Use the Batch API to initiate offline tasks that utilize lower-cost computing resources. This approach is suitable for scenarios where immediate results are not required and there is a need for offline processing of large amounts of data, such as model evaluation, semantic extraction of datasets, and batch extraction of text vectors.":"Use the Batch API to initiate offline tasks that utilize lower-cost computing resources. This approach is suitable for scenarios where immediate results are not required and there is a need for offline processing of large amounts of data, such as model evaluation, semantic extraction of datasets, and batch extraction of text vectors.","Enhance model responses with up-to-date and clearly cited answers from the web search.":"Enhance model responses with up-to-date and clearly cited answers from the web search.","Function Call":"Function Call","connect large language models to external tools for more complex tasks.":"Connect large language models to external tools for more complex tasks.","Unfortunately, Qwen is only available in certain regions right now. Please contact support if you believe you are receiving this message in error.":"Unfortunately, Qwen is only available in certain regions right now. Please contact support if you believe you are receiving this message in error.","Start now":"Start now","Qwen is an AI assistant for everyone, powered by the Qwen series models. It\u2019s free to use, open to all, and ready to help with creativity, collaboration, and endless possibilities. Just ask, and let Qwen do the rest.":"Qwen is an AI assistant for everyone, powered by the Qwen series models. It\u2019s free to use, open to all, and ready to help with creativity, collaboration, and endless possibilities. Just ask, and let Qwen do the rest.","Download the app":"Download the app","Try Free":"Try Free","Get Plus":"Get Plus","Learn more":"Learn more","Building AI Products with Qwen":"Building AI Products with Qwen","Qwen API, which uses an API format compatible with the OpenAI API, means that developers can use the Qwen model services provided by Alibaba Cloud simply by changing the key and base URL. This compatibility allows for the use of the OpenAI SDK and easy integration with services that are OpenAI API compatible. The chat completion service offered by Qwen API can receive prompt inputs and generate text responses, suitable for applications such as question answering, conversation, content creation, translation, summarization, code assistance, and more.":"The Qwen API, compatible with the OpenAI API format, allows developers to utilize Alibaba Cloud\'s Qwen model services by merely updating the key and base URL. This compatibility supports use of the OpenAI SDK and seamless integration with OpenAI API-compatible services. The Qwen API\u2019s chat completion service can accept prompts and generate text responses, ideal for applications like question answering, conversation, content creation, translation, summarization, code assistance, and more.","Start building":"Start building","Our Flagship Models":"Our Flagship Models","Flagship Models":"Qwen Our Flagship Models","Unlock the potential of Qwen through APIs":"Unlock the potential of Qwen through APIs","Boost productivity with Qwen Agent":"Boost productivity with Qwen Agent","Go API Platform":"Go API Platform","Qwen is an AI assistant for everyone, powered by the Qwen series models. It\u2019s free to use, open to all, and ready to help with creativity, collaboration, and endless possibilities. ":"Qwen is an AI assistant for everyone, powered by the Qwen series models. It\u2019s free to use, open to all, and ready to help with creativity, collaboration, and endless possibilities.","Qwen API, which uses an API format compatible with the OpenAI API.":"Qwen API, which uses an API format compatible with the OpenAI API.","Use Qwen on your phone or desktop.":"Use Qwen on your phone or desktop.","Use Now":"Use Now","Products Features":"Product Features","Explore Qwen":"Explore Qwen","Latest Research":"Latest Research","View all":"View all","Get started with Qwen":"Get started with Qwen","Latest advancements":"Latest Advancements","Read Me":"Read Me","Newest":"Newest","Oldest":"Oldest","Sort":"Sort","All":"All","Load more":"Load more","Explore frontier model technologies":"Explore cutting-edge model technologies","Go to Github":"Go to Github","For Mobile":"For Mobile","Chat on the go, have voice conversations, and ask about photos.":"Chat on the go, have voice conversations, and ask about photos.","Download for iOS":"Download for iOS","iOS":"iOS","Download for Android":"Download for Android","For Desktop":"For Desktop","Chat about email, screenshots, files, and anything on your screen.":"Chat about email, screenshots, files, and anything on your screen.","Download for macOS x64":"Download for macOS (x64)","Download for macOS arm":"Download for macOS (ARM)","macOS":"macOS","Download for Windows":"Download for Windows","Qwen":"Qwen","Research":"Research","API Platform":"API Platform","Try Qwen":"Try Qwen","Try Qwen On":"Try Qwen On","Android":"Android","Windows":"Windows","More Features":"More Features","Pricing":"Pricing","Platform Overview":"Platform Overview","Research Index":"Research Index","Github":"GitHub","Terms & Policles":"Terms & Policies","Powered by Alibaba Cloud":"Powered by Alibaba Cloud","Retry":"Retry","The current content is loading incorrectly":"The current content is not loading correctly.","We\u2019re sorry for the inconvenience. It seems there was an issue loading the requested information. You can try refreshing the page to see if that resolves the problem. If the issue persists, please feel free to reach out to us by emailing feedback@qwen.com , and we\u2019ll be happy to assist you.":"We\u2019re sorry for the inconvenience. It seems there was an issue loading the requested information. You can try refreshing the page to see if that resolves the problem. If the issue persists, please feel free to reach out to us by emailing feedback@qwen.com, and we\u2019ll be happy to assist you.","Go Back":"Go Back","The content loading failed. ":"The content loading failed.","minute":"minute","hour":"hour","second":"second","words":"words","Translations":"Translations","Demo":"Demo","Demo Cases":"Demo Cases","Expand all demos":"Expand all demos","Inputs":"Inputs","Outputs":"Outputs","Qwen Boost productivity with Qwen Agent":"Boost productivity with Qwen Agent","The Deep Research feature is designed to assist users in conducting in-depth topic research and information synthesis.":"The Deep Research feature is designed to assist users in conducting in-depth topic research and information synthesis.","Begin crafting websites with HTML! Qwen Artifacts empowers users to seamlessly generate, reference, and update dynamic HTML content and SVG images within conversations, complete with real-time visualization.":"Start building websites with HTML! Qwen Artifacts enables users to effortlessly create, reference, and update dynamic HTML content and SVG images in conversations, with real-time visualization.","context length":"context length","Usage Policy":"Usage Policy","Training Data Summary":"Training Data Summary","Cookies Notice":"Cookies Notice","Save":"Save","Read more":"Read more","Build with Qwen API":"Build with Qwen API","Copying to clipboard was successful!":"Copying to clipboard was successful!","Contract\xa0sales":"Contract\xa0sales","Contact sales":"Contact sales","Try Now":"Try Now","Not available in the current area":"Not available in the current area","Download Now":"Download Now","Build with Qwen via OpenAI-compatible API. Power apps for chat, Q&A, creative writing, translation, summarization, and coding. ":"Built with Qwen via OpenAI-compatible API. Power apps for chat, Q&A, creative writing, translation, summarization, and coding.","Input is limited to 1,000 characters. For longer inputs, please visit https://chat.qwen.ai/ to use the full feature.":"Input is limited to 1,000 characters. For longer inputs, please visit https://chat.qwen.ai/ to use the full feature.","qwencode.title":"Code with Qwen Code","qwencode.subtitle":"Qwen Code is an open-source AI agent for the terminal, optimized for Qwen series models. It helps you understand large codebases, automate tedious work, and ship faster.","qwencode.getStarted":"GitHub Repository","qwencode.viewDocs":"View Documentation","qwencode.whyTitle":"Why Qwen Code?","qwencode.why.multiProtocol.title":"Multi-protocol","qwencode.why.multiProtocol.desc":"Use OpenAI / Anthropic / Gemini-compatible APIs, or sign in with Qwen OAuth.","qwencode.why.openSource.title":"Open-source, co-evolving","qwencode.why.openSource.desc":"Both the framework and the Qwen series models are open-source\u2014and they ship and evolve together.","qwencode.why.agenticWorkflow.title":"Agentic workflow, feature-rich","qwencode.why.agenticWorkflow.desc":"Rich built-in tools (Skills, SubAgents) for a full agentic workflow and a Claude Code-like experience.","qwencode.why.terminalFirst.title":"Terminal-first, IDE-friendly","qwencode.why.terminalFirst.desc":"Built for developers who live in the command line, with optional integration for VS Code, Zed, and JetBrains IDEs.","qwencode.usageTitle":"How to Use Qwen Code","qwencode.usageTitle.prefix":"Use Qwen Code","qwencode.usageTitle.highlight":"where you work","qwencode.usage.tab.interactive":"Interactive","qwencode.usage.tab.headless":"Headless","qwencode.usage.tab.ide":"IDE","qwencode.usage.tab.sdk":"SDK","qwencode.usage.interactive.title":"Interactive Mode","qwencode.usage.interactive.desc":"Run \'qwen\' in your project folder to launch the interactive terminal UI. Use \'@\' to reference local files and get contextual assistance for your codebase.","qwencode.usage.headless.title":"Headless Mode","qwencode.usage.headless.desc":"Use \'-p\' flag to run Qwen Code without the interactive UI \u2014 ideal for scripts, automation, and CI/CD pipelines. Integrate AI into your existing workflows seamlessly.","qwencode.usage.ide.title":"IDE Integration","qwencode.usage.ide.desc":"Use Qwen Code inside your favorite editor \u2014 VS Code, Zed, and JetBrains IDEs are all supported. Get AI-powered coding assistance without leaving your development environment.","qwencode.usage.sdk.title":"Developer SDK","qwencode.usage.sdk.desc":"Build your own AI agents and tools on top of Qwen Code. Our SDK provides programmable access to the same powerful engine that drives the CLI.","qwencode.install.copy":"Copy","qwencode.cta":"Get started with Qwen Code","We\'d like to use cookies to remember your preferences and show relevant content. You can accept all cookies for a fully personalized experience, or select only the strictly necessary ones to keep Qwen running securely. For more details, please read our {{Cookie Notice}}.":"We\'d like to use cookies to remember your preferences and show relevant content. You can accept all cookies for a fully personalized experience, or select only the strictly necessary ones to keep Qwen running securely. For more details, please read our {cookieNotice}.","Take control of your data privacy. On this page, you can manage how Qwen uses cookies to enhance your experience. Review and customize your consent settings below to decide which types of data collection align with your preferences.":"Take control of your data privacy. On this page, you can manage how Qwen uses cookies to enhance your experience. Review and customize your consent settings below to decide which types of data collection align with your preferences.","These essential cookies are required for Qwen to function correctly, ensuring secure sessions and basic features like message delivery. Unlike other categories, these cannot be disabled as the service relies on them to operate safely and effectively.":"These essential cookies are required for Qwen to function correctly, ensuring secure sessions and basic features like message delivery. Unlike other categories, these cannot be disabled as the service relies on them to operate safely and effectively.","Enable these cookies to allow us to deliver personalized content based on your interests and usage patterns. While disabling them won\'t affect Qwen\'s core functionality, it may result in seeing less targeted promotions.":"Enable these cookies to allow us to deliver personalized content based on your interests and usage patterns. While disabling them won\'t affect Qwen\'s core functionality, it may result in seeing less targeted promotions.","Manage Cookies":"Manage Cookies","Manage":"Manage","Strictly Necessary Cookies":"Strictly Necessary Cookies","Advertising Cookies":"Advertising Cookies","Accept all cookies":"Accept all cookies","Accept all strictly necessary cookies":"Accept all strictly necessary cookies","Cookie Notice":"Cookie Notice","The PDF cannot be previewed in this browser. Click to download.":"The PDF cannot be previewed in this browser. Click to download.","Ambassador":"Ambassador","page_not_found":"Page Not Found","page_not_found_desc":"Redirecting to homepage in {seconds} seconds","back_to_home":"Back to Home","Ambassador Program":"Ambassador Program","A global program that empowers developers and community leaders to build with Qwen, share real-world use cases, and grow the open-source AI ecosystem through content and events.":"A global program that empowers developers and community leaders to build with Qwen, share real-world use cases, and grow the open-source AI ecosystem through content and events.","Apply Now":"Apply Now","Who We\'re Looking For":"Who We\'re Looking For","We\'re seeking two types of ambassadors to represent Qwen globally.":"We\'re seeking two types of ambassadors to represent Qwen globally.","Dev Ambassador":"Dev Ambassador","As a Dev Ambassador, you will help grow our developer ecosystem through your projects, insights, and technical contributions.":"As a Dev Ambassador, you will help grow our developer ecosystem through your projects, insights, and technical contributions.","We\'re looking for passionate builders with a strong understanding of AI, who are deeply engaged in open-source communities, bring a developer mindset with solid technical taste, can build compelling demo cases, and are excited to push boundaries while sharing their work openly.":"We\'re looking for passionate builders with a strong understanding of AI, who are deeply engaged in open-source communities, bring a developer mindset with solid technical taste, can build compelling demo cases, and are excited to push boundaries while sharing their work openly.","Event Ambassador":"Event Ambassador","As an Event Ambassador, you will help grow our developer ecosystem through community meetups, workshops, hackathons, and more.":"As an Event Ambassador, you will help grow our developer ecosystem through community meetups, workshops, hackathons, and more.","We are looking for passionate community leaders who are excited to bring local developers together, represent Qwen by bringing your creativity to life through a wide range of community events. Your efforts will help more developers discover and build with Qwen while fostering a strong local developer ecosystem.":"We are looking for passionate community leaders who are excited to bring local developers together, represent Qwen by bringing your creativity to life through a wide range of community events. Your efforts will help more developers discover and build with Qwen while fostering a strong local developer ecosystem.","Responsibilities & Benefits":"Responsibilities & Benefits","What you\'ll do and what you\'ll get in return.":"What you\'ll do and what you\'ll get in return.","DEV":"DEV","Create Qwen-related content such as cookbooks, demo cases, comparisons, and evaluations; or build open-source projects using Qwen models and share them on platforms like X, Medium, Reddit, etc.":"Create Qwen-related content such as cookbooks, demo cases, comparisons, and evaluations; or build open-source projects using Qwen models and share them on platforms like X, Medium, Reddit, etc.","Actively help answer questions from other users in the Qwen community based on personal experience":"Actively help answer questions from other users in the Qwen community based on personal experience","Provide product and model improvement suggestions to the official team based on real usage":"Provide product and model improvement suggestions to the official team based on real usage","EVENT":"EVENT","Organize online and offline events in your region on behalf of Qwen, including but not limited to meetups, workshops, seminars, and hackathons; help drive collaborations with leading AI labs":"Organize online and offline events in your region on behalf of Qwen, including but not limited to meetups, workshops, seminars, and hackathons; help drive collaborations with leading AI labs","Collect feedback and suggestions from event participants and share them with the Qwen team":"Collect feedback and suggestions from event participants and share them with the Qwen team","Ambassador Benefits":"Ambassador Benefits","Exclusive community badge and access to private chats with the model and product teams":"Exclusive community badge and access to private chats with the model and product teams","Early access (EA) to new Qwen models":"Early access (EA) to new Qwen models","Qwen API credits ($50-$100 / month) to support personal projects":"Qwen API credits ($50-$100 / month) to support personal projects","Annual merchandise package and thank-you card":"Annual merchandise package and thank-you card","Opportunities to participate in Qwen Global Developer Conference":"Opportunities to participate in Qwen Global Developer Conference","Event funding support, swag sponsorship, and official endorsement from Qwen":"Event funding support, swag sponsorship, and official endorsement from Qwen","Top ambassadors may be upgraded to paid partners":"Top ambassadors may be upgraded to paid partners","Frequently Asked Questions":"Frequently Asked Questions","Everything you need to know about the program.":"Everything you need to know about the program.","How do I know if I\'ve been accepted?":"How do I know if I\'ve been accepted?","We\'ll notify you via email. If you do not receive an onboarding email within 15 business days after applying (please check spam), it means you were not selected this round. You\'re welcome to apply again in the future.":"We\'ll notify you via email. If you do not receive an onboarding email within 15 business days after applying (please check spam), it means you were not selected this round. You\'re welcome to apply again in the future.","What are the requirements to receive $100 credits per month?":"What are the requirements to receive $100 credits per month?","To receive $100 credits per month, you need to meet the following requirements:":"To receive $100 credits per month, you need to meet the following requirements:","Dev Ambassador: At least 4 content outputs per month":"Dev Ambassador: At least 4 content outputs per month","Event Ambassador: At least 1 event + 2 Qwen-related social posts per month":"Event Ambassador: At least 1 event + 2 Qwen-related social posts per month","What if I\'m temporarily unable to contribute?":"What if I\'m temporarily unable to contribute?","No contributions for 2 consecutive months will be considered as automatic withdrawal. You may reapply after 6 months. If you have special circumstances, feel free to reach out to us.":"No contributions for 2 consecutive months will be considered as automatic withdrawal. You may reapply after 6 months. If you have special circumstances, feel free to reach out to us.","Can I publicly share my Ambassador status?":"Can I publicly share my Ambassador status?","Yes, we encourage you to share it on any platform.":"Yes, we encourage you to share it on any platform.","How do I receive the annual merchandise and thank-you card?":"How do I receive the annual merchandise and thank-you card?","We will send out curated merchandise packages during the New Year. All active ambassadors at that time will receive them.":"We will send out curated merchandise packages during the New Year. All active ambassadors at that time will receive them.","Can I be an ambassador for other AI labs at the same time?":"Can I be an ambassador for other AI labs at the same time?","Generally, we do not recommend it.":"Generally, we do not recommend it.","What is the process for organizing an event as an Event Ambassador?":"What is the process for organizing an event as an Event Ambassador?","Once you become our ambassador, you\'ll be invited to join the Discord group, where you can download the event proposal template and submit details including your plan, venue, expected attendance, and budget breakdown. We will review and determine the level of support available. If needed, we\'ll schedule a short call to discuss further.":"Once you become our ambassador, you\'ll be invited to join the Discord group, where you can download the event proposal template and submit details including your plan, venue, expected attendance, and budget breakdown. We will review and determine the level of support available. If needed, we\'ll schedule a short call to discuss further.","Qwen Ambassador Program Disclaimer":"Qwen Ambassador Program Disclaimer","By applying to and participating in the Qwen Ambassador Program, you agree to abide by the following terms and conditions. Qwen reserves the right to modify, suspend, or terminate this program at any time without prior notice. Intellectual Property & Content Rights: All photographs, images, videos, and content created during or as part of ambassador activities are the exclusive property of Qwen. Ambassadors grant Qwen unrestricted rights to use, reproduce, modify, and distribute such Content for marketing, promotional, and commercial purposes. Qwen retains all rights to interpret and enforce this policy. Violation of program guidelines may result in immediate removal without compensation. By submitting your application, you acknowledge that you have read and understood these terms.":"By applying to and participating in the Qwen Ambassador Program, you agree to abide by the following terms and conditions. Qwen reserves the right to modify, suspend, or terminate this program at any time without prior notice. Intellectual Property & Content Rights: All photographs, images, videos, and content created during or as part of ambassador activities are the exclusive property of Qwen. Ambassadors grant Qwen unrestricted rights to use, reproduce, modify, and distribute such Content for marketing, promotional, and commercial purposes. Qwen retains all rights to interpret and enforce this policy. Violation of program guidelines may result in immediate removal without compensation. By submitting your application, you acknowledge that you have read and understood these terms."}');o(9810),(n=i||(i={})).en="EN",n["zh-cn"]="\u7B80\u4F53\u4E2D\u6587",(a=s||(s={})).en="English",a["zh-cn"]="\u7B80\u4F53\u4E2D\u6587";var c={en:l,"zh-cn":r},d="locale_lang",u=Object.keys(c).map(function(e){return{value:e,label:i[e]}}),h=Object.keys(c).map(function(e){return{value:e,label:s[e]}}),m=function(){if(localStorage.getItem(d))return localStorage.getItem(d);var e=navigator.language||navigator.userLanguage||"en";return