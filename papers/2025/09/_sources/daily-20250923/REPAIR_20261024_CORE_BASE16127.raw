<td id="S5.T10.4.1.18.10" class="ltx_td ltx_align_center">81.1</td></tr>
<tr id="S5.T10.4.1.19" class="ltx_tr">
<td id="S5.T10.4.1.19.1" class="ltx_td ltx_align_left">R1-Reward <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib42" title="" class="ltx_ref">Zhao et al., 2025b</a>)</cite></td>
<td id="S5.T10.4.1.19.2" class="ltx_td ltx_align_center">7B</td>
<td id="S5.T10.4.1.19.3" class="ltx_td ltx_align_center"><span id="S5.T10.4.1.19.3.1" class="ltx_text ltx_font_bold">82.2</span></td>
<td id="S5.T10.4.1.19.4" class="ltx_td ltx_align_center"><span id="S5.T10.4.1.19.4.1" class="ltx_text ltx_font_bold">77.5</span></td>
<td id="S5.T10.4.1.19.5" class="ltx_td ltx_align_center"><span id="S5.T10.4.1.19.5.1" class="ltx_text ltx_font_bold">74.0</span></td>
<td id="S5.T10.4.1.19.6" class="ltx_td ltx_align_center"><span id="S5.T10.4.1.19.6.1" class="ltx_text ltx_underline">74.9</span></td>
<td id="S5.T10.4.1.19.7" class="ltx_td ltx_align_center"><span id="S5.T10.4.1.19.7.1" class="ltx_text ltx_font_bold">83.1</span></td>
<td id="S5.T10.4.1.19.8" class="ltx_td ltx_align_center"><span id="S5.T10.4.1.19.8.1" class="ltx_text ltx_underline">79.6</span></td>
<td id="S5.T10.4.1.19.9" class="ltx_td ltx_align_center"><span id="S5.T10.4.1.19.9.1" class="ltx_text ltx_font_bold">99.6</span></td>
<td id="S5.T10.4.1.19.10" class="ltx_td ltx_align_center">86.5</td></tr>
<tr id="S5.T10.4.1.20" class="ltx_tr">
