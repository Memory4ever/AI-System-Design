<td id="S5.T10.4.1.21.5" class="ltx_td ltx_align_center">56.3</td>
<td id="S5.T10.4.1.21.6" class="ltx_td ltx_align_center">64.9</td>
<td id="S5.T10.4.1.21.7" class="ltx_td ltx_align_center">73.1</td>
<td id="S5.T10.4.1.21.8" class="ltx_td ltx_align_center">48.6</td>
<td id="S5.T10.4.1.21.9" class="ltx_td ltx_align_center">72.4</td>
<td id="S5.T10.4.1.21.10" class="ltx_td ltx_align_center">83.5</td></tr>
<tr id="S5.T10.4.1.22" class="ltx_tr">
<td id="S5.T10.4.1.22.1" class="ltx_td ltx_align_left">BaseReward (Qwen 2.5 VL)</td>
