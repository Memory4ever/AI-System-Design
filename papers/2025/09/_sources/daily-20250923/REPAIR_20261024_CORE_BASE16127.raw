<td id="S4.T2.4.1.6.2" class="ltx_td ltx_align_center"><span id="S4.T2.4.1.6.2.1" class="ltx_text" style="--ltx-bg-color:#FFF2E9;">Silu</span></td>
<td id="S4.T2.4.1.6.3" class="ltx_td ltx_align_center"><span id="S4.T2.4.1.6.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF2E9;">67.9</span></td>
<td id="S4.T2.4.1.6.4" class="ltx_td ltx_align_center"><span id="S4.T2.4.1.6.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF2E9;">79.7</span></td>
<td id="S4.T2.4.1.6.5" class="ltx_td ltx_align_center"><span id="S4.T2.4.1.6.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF2E9;">79.1</span></td>
