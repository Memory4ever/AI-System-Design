<td id="S4.T2.4.1.8.3" class="ltx_td ltx_align_center">65.4</td>
<td id="S4.T2.4.1.8.4" class="ltx_td ltx_align_center">63.4</td>
<td id="S4.T2.4.1.8.5" class="ltx_td ltx_align_center">76.9</td>
<td id="S4.T2.4.1.8.6" class="ltx_td ltx_align_center">69.1</td>
<td id="S4.T2.4.1.8.7" class="ltx_td ltx_align_center">68.6</td>
<td id="S4.T2.4.1.8.8" class="ltx_td ltx_align_center">88.2</td>
