<td id="S4.T2.4.1.6.8" class="ltx_td ltx_align_center"><span id="S4.T2.4.1.6.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF2E9;">92.9</span></td>
<td id="S4.T2.4.1.6.9" class="ltx_td ltx_align_center"><span id="S4.T2.4.1.6.9.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF2E9;">80.4</span></td></tr>
