{"data":{"id":"10.48550/arxiv.2509.17167","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17167","prefix":"10.48550","suffix":"arxiv.2509.17167","identifiers":[{"identifier":"2509.17167","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.17167"}],"creators":[{"name":"Yi, Seungjun","nameType":"Personal","givenName":"Seungjun","familyName":"Yi","affiliation":[],"nameIdentifiers":[]},{"name":"Nguyen, Joakim","nameType":"Personal","givenName":"Joakim","familyName":"Nguyen","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Huimin","nameType":"Personal","givenName":"Huimin","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Lim, Terence","nameType":"Personal","givenName":"Terence","familyName":"Lim","affiliation":[],"nameIdentifiers":[]},{"name":"Skrovan, Joseph","nameType":"Personal","givenName":"Joseph","familyName":"Skrovan","affiliation":[],"nameIdentifiers":[]},{"name":"Beri, Mehak","nameType":"Personal","givenName":"Mehak","familyName":"Beri","affiliation":[],"nameIdentifiers":[]},{"name":"Modi, Hitakshi","nameType":"Personal","givenName":"Hitakshi","familyName":"Modi","affiliation":[],"nameIdentifiers":[]},{"name":"Well, Andrew","nameType":"Personal","givenName":"Andrew","familyName":"Well","affiliation":[],"nameIdentifiers":[]},{"name":"Leqi, Liu","nameType":"Personal","givenName":"Liu","familyName":"Leqi","affiliation":[],"nameIdentifiers":[]},{"name":"Markey, Mia","nameType":"Personal","givenName":"Mia","familyName":"Markey","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Ying","nameType":"Personal","givenName":"Ying","familyName":"Ding","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SFT-TA: Supervised Fine-Tuned Agents in Multi-Agent LLMs for Automated Inductive Thematic Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T17:26:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:00:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Thematic Analysis (TA) is a widely used qualitative method that provides a structured yet flexible framework for identifying and reporting patterns in clinical interview transcripts. However, manual thematic analysis is time-consuming and limits scalability. Recent advances in LLMs offer a pathway to automate thematic analysis, but alignment with human results remains limited. To address these limitations, we propose SFT-TA, an automated thematic analysis framework that embeds supervised fine-tuned (SFT) agents within a multi-agent system. Our framework outperforms existing frameworks and the gpt-4o baseline in alignment with human reference themes. We observed that SFT agents alone may underperform, but achieve better results than the baseline when embedded within a multi-agent system. Our results highlight that embedding SFT agents in specific roles within a multi-agent system is a promising pathway to improve alignment with desired outputs for thematic analysis.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.17167","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:05:37.000Z","registered":"2025-09-23T03:05:37.000Z","published":"2025","updated":"2025-09-23T03:05:37.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.17167","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}