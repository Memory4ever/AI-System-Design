<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_minipage ltx_align_top ltx_framed ltx_framed_top" style="width:155.3pt;">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Sampling</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg2.l1.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l1.m1" class="ltx_Math" alttext="i=N" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">i=N</annotation></semantics></math> to <math id="alg2.l1.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> <span id="alg2.l1.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
              <span id="alg2.l2.3" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l2.m1" class="ltx_Math" alttext="i==N" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mphantom></mphantom><mo>=</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">i==N</annotation></semantics></math> <span id="alg2.l2.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l3" class="ltx_listingline">
