<th id="S4.T1.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt">NFE</th>
<th id="S4.T1.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">FID <math id="S4.T1.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<th id="S4.T1.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">IS <math id="S4.T1.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.5.2" class="ltx_tr">
<th id="S4.T1.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">DDPM <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite></th>
<th id="S4.T1.5.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">1000</th>
<td id="S4.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_t">3.17</td>
<td id="S4.T1.5.2.4" class="ltx_td ltx_align_center ltx_border_t">9.46</td></tr>
<tr id="S4.T1.5.3" class="ltx_tr">
<th id="S4.T1.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DDIM <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">38</a>]</cite></th>
<th id="S4.T1.5.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">50</th>
<td id="S4.T1.5.3.3" class="ltx_td ltx_align_center">4.67</td>
<td id="S4.T1.5.3.4" class="ltx_td ltx_align_center">-</td></tr>
<tr id="S4.T1.5.4" class="ltx_tr">
