<figure id="A3.T12.fig2" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:165.6pt;">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.T12.fig2.1" class="ltx_text" style="font-size:90%;">Table 12</span>: </span><span id="A3.T12.fig2.2" class="ltx_text" style="font-size:90%;">Timesteps for Low Resolution on FFHQ64<math id="A3.T12.m5" class="ltx_Math" alttext="\times 64" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mn>64</mn></mrow><annotation encoding="application/x-tex">\times 64</annotation></semantics></math></span></figcaption>
