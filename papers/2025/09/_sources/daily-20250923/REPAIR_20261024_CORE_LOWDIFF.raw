<th id="S4.T1.5.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S4.T1.5.12.1.1" class="ltx_text ltx_font_bold">Ours</span></th>
<th id="S4.T1.5.12.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">22<sup id="S4.T1.5.12.2.1" class="ltx_sup">†</sup></th>
<td id="S4.T1.5.12.3" class="ltx_td ltx_align_center ltx_border_bb">2.11</td>
