<figure id="S4.T3" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="S4.T3.3" class="ltx_text" style="font-size:90%;">Table 3</span>: </span><span id="S4.T3.4" class="ltx_text" style="font-size:90%;">Generation quality and efficiency on FFHQ64<math id="S4.T3.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>64</span></figcaption>
<table id="S4.T3.5" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T3.5.1" class="ltx_tr">
<th id="S4.T3.5.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" rowspan="2"><span id="S4.T3.5.1.1.1" class="ltx_text">Model</span></th>
<th id="S4.T3.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">No. of</th>
<th id="S4.T3.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Model Size</th>
