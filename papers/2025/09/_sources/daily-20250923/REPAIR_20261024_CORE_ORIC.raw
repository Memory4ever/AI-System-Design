<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>LLM-Guided Sampling Method (Positive Question Construction)</h3>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="font-size:90%;"><span class="ltx_tag ltx_tag_float"><span id="alg1.5" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Positive Question Construction</figcaption>
<div id="alg1.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg1.l1.3" class="ltx_text" style="font-size:90%;">Image </span><math id="alg1.l1.m1" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math><span id="alg1.l1.4" class="ltx_text" style="font-size:90%;">, objects </span><math id="alg1.l1.m2" class="ltx_Math" alttext="\mathcal{O}=\{(n_{i},B_{ij})\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi><mo mathsize="0.900em">=</mo><mrow><mo stretchy="false">{</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">n</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">B</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">j</mi></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}=\{(n_{i},B_{ij})\}</annotation></semantics></math><span id="alg1.l1.5" class="ltx_text" style="font-size:90%;">, integer </span><math id="alg1.l1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="alg1.l1.6" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg1.l2.3" class="ltx_text" style="font-size:90%;">Positive question </span><math id="alg1.l2.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math><span id="alg1.l2.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg1.l3.3" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg1.l3.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l3.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math><span id="alg1.l3.5" class="ltx_text" style="font-size:90%;"> to </span><math id="alg1.l3.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="alg1.l3.6" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l3.7" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg1.l3.8" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg1.l4.3" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l4.m1" class="ltx_Math" alttext="A_{i}\leftarrow\text{area}(\bigcup_{j}B_{ij})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">A</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext mathsize="0.900em">area</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mo lspace="0em" maxsize="0.900em" minsize="0.900em" stretchy="true">⋃</mo><mi mathsize="0.900em">j</mi></msub><msub><mi mathsize="0.900em">B</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">j</mi></mrow></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{i}\leftarrow\text{area}(\bigcup_{j}B_{ij})</annotation></semantics></math><span id="alg1.l4.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
