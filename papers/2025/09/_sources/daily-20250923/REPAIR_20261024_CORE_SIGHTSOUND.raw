<span id="S3.T2.2.1.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_t ltx_colspan ltx_colspan_4"><span id="S3.T2.2.1.1.1.1.1.1.1.3.1" class="ltx_text ltx_font_bold">MMAU Test-mini</span></span>
