{"data":{"id":"10.48550/arxiv.2509.17219","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17219","prefix":"10.48550","suffix":"arxiv.2509.17219","identifiers":[{"identifier":"2509.17219","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.17219"}],"creators":[{"name":"Cervera, Matthieu","nameType":"Personal","givenName":"Matthieu","familyName":"Cervera","affiliation":[],"nameIdentifiers":[]},{"name":"Paissan, Francesco","nameType":"Personal","givenName":"Francesco","familyName":"Paissan","affiliation":[],"nameIdentifiers":[]},{"name":"Ravanelli, Mirco","nameType":"Personal","givenName":"Mirco","familyName":"Ravanelli","affiliation":[],"nameIdentifiers":[]},{"name":"Subakan, Cem","nameType":"Personal","givenName":"Cem","familyName":"Subakan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Virtual Consistency for Audio Editing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Sound (cs.SD)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T19:54:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:03:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Free-form, text-based audio editing remains a persistent challenge, despite progress in inversion-based neural methods. Current approaches rely on slow inversion procedures, limiting their practicality. We present a virtual-consistency based audio editing system that bypasses inversion by adapting the sampling process of diffusion models. Our pipeline is model-agnostic, requiring no fine-tuning or architectural changes, and achieves substantial speed-ups over recent neural editing baselines. Crucially, it achieves this efficiency without compromising quality, as demonstrated by quantitative benchmarks and a user study involving 16 participants.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.17219","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:06:50.000Z","registered":"2025-09-23T03:06:51.000Z","published":"2025","updated":"2025-09-23T03:06:51.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.17219","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}