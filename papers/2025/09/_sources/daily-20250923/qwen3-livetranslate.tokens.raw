e,"text":"<audio controls>"},{"type":"html","raw":"<source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-TTS-Flash/方言音色/line8.wav\" type=\"audio/wav\">","inLink":false,"inRawBlock":false,"block":false,"text":"<source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-TTS-Flash/方言音色/line8.wav\" type=\"audio/wav\">"},{"type":"html","raw":"</audio>","inLink":false,"inRawBlock":false,"block":false,"text":"</audio>"}],"header":false,"align":null},{"text":"Professional sidekick in Tianjin-style cross talk.","tokens":[{"type":"text","raw":"Professional sidekick in Tianjin-style cross talk.","text":"Professional sidekick in Tianjin-style cross talk.","escaped":false}],"header":false,"align":null},{"text":"Chinese (Tianjin Dialect)","tokens":[{"type":"text","raw":"Chinese (Tianjin Dialect)","text":"Chinese (Tianjin Dialect)","escaped":false}],"header":false,"align":null}],[{"text":"Kiki","tokens":[{"type":"text","raw":"Kiki","text":"Kiki","escaped":false}],"header":false,"align":null},{"text":"<audio controls><source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-TTS-Flash/方言音色/line10.wav\" type=\"audio/wav\"></audio>","tokens":[{"type":"html","raw":"<audio controls>","inLink":false,"inRawBlock":false,"block":false,"text":"<audio controls>"},{"type":"html","raw":"<source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-TTS-Flash/方言音色/line10.wav\" type=\"audio/wav\">","inLink":false,"inRawBlock":false,"block":false,"text":"<source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-TTS-Flash/方言音色/line10.wav\" type=\"audio/wav\">"},{"type":"html","raw":"</audio>","inLink":false,"inRawBlock":false,"block":false,"text":"</audio>"}],"header":false,"align":null},{"text":"Sweet Hong Kong girlfriend-like voice.","tokens":[{"type":"text","raw":"Sweet Hong Kong girlfriend-like voice.","text":"Sweet Hong Kong girlfriend-like voice.","escaped":false}],"header":false,"align":null},{"text":"Cantonese","tokens":[{"type":"text","raw":"Cantonese","text":"Cantonese","escaped":false}],"header":false,"align":null}],[{"text":"Eric","tokens":[{"type":"text","raw":"Eric","text":"Eric","escaped":false}],"header":false,"align":null},{"text":"<audio controls><source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-TTS-Flash/方言音色/line5.wav\" type=\"audio/wav\"></audio>","tokens":[{"type":"html","raw":"<audio controls>","inLink":false,"inRawBlock":false,"block":false,"text":"<audio controls>"},{"type":"html","raw":"<source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-TTS-Flash/方言音色/line5.wav\" type=\"audio/wav\">","inLink":false,"inRawBlock":false,"block":false,"text":"<source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-TTS-Flash/方言音色/line5.wav\" type=\"audio/wav\">"},{"type":"html","raw":"</audio>","inLink":false,"inRawBlock":false,"block":false,"text":"</audio>"}],"header":false,"align":null},{"text":"A free-spirited man from Chengdu, Sichuan.","tokens":[{"type":"text","raw":"A free-spirited man from Chengdu, Sichuan.","text":"A free-spirited man from Chengdu, Sichuan.","escaped":false}],"header":false,"align":null},{"text":"Chinese (Sichuan Dialect)","tokens":[{"type":"text","raw":"Chinese (Sichuan Dialect)","text":"Chinese (Sichuan Dialect)","escaped":false}],"header":false,"align":null}]]},{"type":"heading","raw":"## What's Next\n\n","depth":2,"text":"What's Next","tokens":[{"type":"text","raw":"What's Next","text":"What's Next","escaped":false}]},{"type":"paragraph","raw":"We will keep advancing the accuracy, naturalness, and emotional fidelity of our speech translation; extend coverage to more languages; and reinforce its robustness across varied and challenging acoustic environments. Our goal is to bridge linguistic divides, enabling conversations to flow as smoothly and naturally as if speaking face to face.","text":"We will keep advancing the accuracy, naturalness, and emotional fidelity of our speech translation; extend coverage to more languages; and reinforce its robustness across varied and challenging acoustic environments. Our goal is to bridge linguistic divides, enabling conversations to flow as smoothly and naturally as if speaking face to face.","tokens":[{"type":"text","raw":"We will keep advancing the accuracy, naturalness, and emotional fidelity of our speech translation; extend coverage to more languages; and reinforce its robustness across varied and challenging acoustic environments. Our goal is to bridge linguistic divides, enabling conversations to flow as smoothly and naturally as if speaking face to face.","text":"We will keep advancing the accuracy, naturalness, and emotional fidelity of our speech translation; extend coverage to more languages; and reinforce its robustness across varied and challenging acoustic environments. Our goal is to bridge linguistic divides, enabling conversations to flow as smoothly and naturally as if speaking face to face.","escaped":false}]}]