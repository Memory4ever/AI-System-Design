<span id="S4.T2.3.1.1.1.1.1.8.11" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t" style="--ltx-bg-color:#FFFFFF;padding-top:5pt;padding-bottom:5pt;"><span id="S4.T2.3.1.1.1.1.1.8.11.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">50%</span></span>
