<td id="S4.T2.5.6.1" class="ltx_td ltx_align_left">DRGN <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib59" title="" class="ltx_ref">59</a>)</cite></td>
<td id="S4.T2.5.6.2" class="ltx_td ltx_align_center">39.8</td></tr>
<tr id="S4.T2.5.7" class="ltx_tr">
<td id="S4.T2.5.7.1" class="ltx_td ltx_align_left">DATran <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib60" title="" class="ltx_ref">60</a>)</cite></td>
<td id="S4.T2.5.7.2" class="ltx_td ltx_align_center">40.1</td></tr>
<tr id="S4.T2.5.8" class="ltx_tr">
<td id="S4.T2.5.8.1" class="ltx_td ltx_align_left">SADCL <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib61" title="" class="ltx_ref">61</a>)</cite></td>
<td id="S4.T2.5.8.2" class="ltx_td ltx_align_center">40.5</td></tr>
<tr id="S4.T2.5.9" class="ltx_tr">
