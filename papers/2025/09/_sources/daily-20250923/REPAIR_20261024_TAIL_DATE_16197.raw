nfei","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Mingfei","nameType":"Personal","givenName":"Mingfei","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Dou, Zi-Yi","nameType":"Personal","givenName":"Zi-Yi","familyName":"Dou","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Wenze","nameType":"Personal","givenName":"Wenze","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Chang","nameType":"Personal","givenName":"Chang","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Dongxu","nameType":"Personal","givenName":"Dongxu","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Dufter, Philipp","nameType":"Personal","givenName":"Philipp","familyName":"Dufter","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zirui","nameType":"Personal","givenName":"Zirui","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Yin, Guoli","nameType":"Personal","givenName":"Guoli","familyName":"Yin","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Zhengdong","nameType":"Personal","givenName":"Zhengdong","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Chen","nameType":"Personal","givenName":"Chen","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Yang","nameType":"Personal","givenName":"Yang","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Pang, Ruoming","nameType":"Personal","givenName":"Ruoming","familyName":"Pang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Zhifeng","nameType":"Personal","givenName":"Zhifeng","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MANZANO: A Simple and Scalable Unified Multimodal Model with a Hybrid Vision Tokenizer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T17:58:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-22T00:59:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Unified multimodal Large Language Models (LLMs) that can both understand and generate visual content hold immense potential. However, existing open-source models often suffer from a performance trade-off between these capabilities. We present Manzano, a simple and scalable unified framework that substantially reduces this tension by coupling a hybrid image tokenizer with a well-curated training recipe. A single shared vision encoder feeds two lightweight adapters that produce continuous embeddings for image-to-text understanding and discrete tokens for text-to-image generation within a common semantic space. A unified autoregressive LLM predicts high-level semantics in the form of text and image tokens, with an auxiliary diffusion decoder subsequently translating the image tokens into pixels. The architecture, together with a unified training recipe over understanding and generation data, enables scalable joint learning of both capabilities. Manzano achieves state-of-the-art results among unified models, and is competitive with specialist models, particularly on text-rich evaluation. Our studies show minimal task conflicts and consistent gains from scaling model size, validating our design choice of a hybrid tokenizer.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.16197","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-22T01:58:42.000Z","registered":"2025-09-22T01:58:43.000Z","published":"2025","updated":"2025-09-22T01:58:43.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.16197","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}