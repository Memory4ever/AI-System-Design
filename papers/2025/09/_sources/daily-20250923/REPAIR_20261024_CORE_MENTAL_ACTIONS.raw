</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.8.2" class="ltx_tr">
<th id="S5.T2.8.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S5.T2.8.2.1.1" class="ltx_text" style="font-size:90%;">evaluation/return_mean_gm</span></th>
