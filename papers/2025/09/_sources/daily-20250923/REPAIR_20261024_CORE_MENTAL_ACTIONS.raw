              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.11.1" class="ltx_text ltx_font_bold">9</span></span>
            <math id="algorithm1.m22" class="ltx_Math" alttext="i^{\star}\leftarrow\textsc{Route}(a_{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>⋆</mo></msup><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">Route</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i^{\star}\leftarrow\textsc{Route}(a_{t})</annotation></semantics></math>
