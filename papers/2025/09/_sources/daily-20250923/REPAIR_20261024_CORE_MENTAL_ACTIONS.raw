            <math id="algorithm1.m24" class="ltx_Math" alttext="A[i^{\star}]\leftarrow A[i^{\star}]+\delta\,r_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>i</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>i</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>r</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">A[i^{\star}]\leftarrow A[i^{\star}]+\delta\,r_{t}</annotation></semantics></math>
</div>
<div id="algorithm1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.14.1" class="ltx_text ltx_font_bold">12</span></span>
            append <math id="algorithm1.m25" class="ltx_Math" alttext="(a_{t},r_{t},i^{\star},A[i^{\star}])" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>r</mi><mi>t</mi></msub><mo>,</mo><msup><mi>i</mi><mo>⋆</mo></msup><mo>,</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>i</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{t},r_{t},i^{\star},A[i^{\star}])</annotation></semantics></math> to <math id="algorithm1.m26" class="ltx_Math" alttext="D_{\text{trajectory}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mtext>trajectory</mtext></msub><annotation encoding="application/x-tex">D_{\text{trajectory}}</annotation></semantics></math>
</div>
<div id="algorithm1.4.15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.15.1" class="ltx_text ltx_font_bold">13</span></span>
            <math id="algorithm1.m27" class="ltx_Math" alttext="D_{\text{codebook}}\leftarrow\{(i,A[i])\mid A[i]\neq 0\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mtext>codebook</mtext></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\text{codebook}}\leftarrow\{(i,A[i])\mid A[i]\neq 0\}</annotation></semantics></math>
</div>
