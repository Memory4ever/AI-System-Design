            <span id="algorithm1.4.10.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.10.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m20" class="ltx_Math" alttext="t\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.10.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m21" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math></em> <span id="algorithm1.4.10.4" class="ltx_text ltx_font_bold">do</span>
</div>
