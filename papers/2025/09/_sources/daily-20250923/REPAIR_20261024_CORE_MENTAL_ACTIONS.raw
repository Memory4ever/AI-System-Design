            <math id="algorithm1.m23" class="ltx_Math" alttext="A\leftarrow(1-\phi)\,A" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϕ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">A\leftarrow(1-\phi)\,A</annotation></semantics></math>   <span id="algorithm1.4.12.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.12.3" class="ltx_text ltx_font_typewriter">global decay (vectorized)</span>
</div>
