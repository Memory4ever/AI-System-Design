            <span id="algorithm1.4.9.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m19" class="ltx_Math" alttext="\argmin_{i\in\{0,\dots,N-1\}}\|a-c_{i}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>a</mi><mo>−</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\argmin_{i\in\{0,\dots,N-1\}}\|a-c_{i}\|_{2}</annotation></semantics></math>
</div>
