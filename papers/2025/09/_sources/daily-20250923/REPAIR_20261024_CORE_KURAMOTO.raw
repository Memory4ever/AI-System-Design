<td id="S2.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S2.T1.2.3.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">47.93</span></td>
<td id="S2.T1.2.3.4" class="ltx_td ltx_align_center"><span id="S2.T1.2.3.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">20.64</span></td></tr>
<tr id="S2.T1.2.4" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
