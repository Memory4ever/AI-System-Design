<td id="S2.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">104.92</td>
<td id="S2.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">62.66</td>
<td id="S2.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t">23.84</td></tr>
<tr id="S2.T1.2.3" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="S2.T1.2.3.1" class="ltx_td ltx_align_center ltx_border_r"><span id="S2.T1.2.3.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Kuramoto Orientation Diffusion (Globally Coupled)</span></td>
