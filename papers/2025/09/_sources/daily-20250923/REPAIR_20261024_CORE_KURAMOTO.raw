</thead>
<tbody class="ltx_tbody">
<tr id="A2.T6.2.2" class="ltx_tr">
<td id="A2.T6.2.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">SGM <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite></td>
<td id="A2.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">38.33</td>
<td id="A2.T6.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">22.40</td>
<td id="A2.T6.2.2.4" class="ltx_td ltx_align_center ltx_border_t">20.37</td></tr>
<tr id="A2.T6.2.3" class="ltx_tr">
<td id="A2.T6.2.3.1" class="ltx_td ltx_align_center ltx_border_r">Reference-only Process (<math id="A2.T6.m3" class="ltx_Math" alttext="K(t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">K(t)=0</annotation></semantics></math>)</td>
<td id="A2.T6.2.3.2" class="ltx_td ltx_align_center ltx_border_r">33.76</td>
<td id="A2.T6.2.3.3" class="ltx_td ltx_align_center ltx_border_r">20.54</td>
<td id="A2.T6.2.3.4" class="ltx_td ltx_align_center">19.01</td></tr>
<tr id="A2.T6.2.4" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="A2.T6.2.4.1" class="ltx_td ltx_align_center ltx_border_r"><span id="A2.T6.2.4.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Kuramoto Orientation Diffusion (Globally Coupled)</span></td>
<td id="A2.T6.2.4.2" class="ltx_td ltx_align_center ltx_border_r"><span id="A2.T6.2.4.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">20.26</span></td>
<td id="A2.T6.2.4.3" class="ltx_td ltx_align_center ltx_border_r"><span id="A2.T6.2.4.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">18.51</span></td>
<td id="A2.T6.2.4.4" class="ltx_td ltx_align_center"><span id="A2.T6.2.4.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">15.42</span></td></tr>
