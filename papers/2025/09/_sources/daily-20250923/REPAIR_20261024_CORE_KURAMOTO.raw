<td id="S2.T1.2.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S2.T1.2.4.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">67.49</span></td>
