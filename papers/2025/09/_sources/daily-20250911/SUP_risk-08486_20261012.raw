</span></td>
<td id="S3.T1.2.2.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.2.4.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S3.T1.2.2.4.1.1" class="ltx_p">GPT-4o <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib1" title="" class="ltx_ref">Achiam et al. (2023)</a></cite></span>
</span></td>
<td id="S3.T1.2.2.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.2.5.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="S3.T1.2.2.5.1.1" class="ltx_p">WR (%)</span>
</span></td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<td id="S3.T1.2.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S3.T1.2.3.1.1.1" class="ltx_p">Harmlessness</span>
</span></td>
<td id="S3.T1.2.3.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.3.2.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
<span id="S3.T1.2.3.2.1.1" class="ltx_p">BeaverTails-Train <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib15" title="" class="ltx_ref">Ji et al. (2023)</a></cite></span>
</span></td>
<td id="S3.T1.2.3.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.3.3.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
<span id="S3.T1.2.3.3.1.1" class="ltx_p">BeaverTails-Test <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib15" title="" class="ltx_ref">Ji et al. (2023)</a></cite></span>
</span></td>
<td id="S3.T1.2.3.4" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.3.4.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S3.T1.2.3.4.1.1" class="ltx_p">beaver-dam-7b <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib15" title="" class="ltx_ref">Ji et al. (2023)</a></cite></span>
</span></td>
<td id="S3.T1.2.3.5" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.3.5.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="S3.T1.2.3.5.1.1" class="ltx_p">SS (%)</span>
</span></td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<td id="S3.T1.2.4.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.4.1.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S3.T1.2.4.1.1.1" class="ltx_p">Honesty</span>
</span></td>
<td id="S3.T1.2.4.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.4.2.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
<span id="S3.T1.2.4.2.1.1" class="ltx_p"><math id="S3.T1.m1" class="ltx_Math" alttext="{1}/{2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{1}/{2}</annotation></semantics></math> of TruthfulQA <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib20" title="" class="ltx_ref">Lin et al. (2021)</a></cite></span>
</span></td>
<td id="S3.T1.2.4.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.4.3.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
<span id="S3.T1.2.4.3.1.1" class="ltx_p"><math id="S3.T1.m2" class="ltx_Math" alttext="{1}/{2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{1}/{2}</annotation></semantics></math> of TruthfulQA <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib20" title="" class="ltx_ref">Lin et al. (2021)</a></cite></span>
</span></td>
<td id="S3.T1.2.4.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="S3.T1.2.4.4.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S3.T1.2.4.4.1.1" class="ltx_p">GPT-Judge</span>
</span></td>
