<div id="lstnumberx2" class="ltx_listingline"><span id="lstnumberx2.1" class="ltx_text ltx_lst_identifier">Solve</span><span id="lstnumberx2.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.3" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx2.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.5" class="ltx_text ltx_lst_identifier">following</span><span id="lstnumberx2.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.7" class="ltx_text ltx_lst_identifier">problem</span><span id="lstnumberx2.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.9" class="ltx_text ltx_lst_identifier">step</span><span id="lstnumberx2.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.11" class="ltx_text ltx_lst_identifier">by</span><span id="lstnumberx2.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.13" class="ltx_text ltx_lst_identifier">step</span>.
</div>
<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_identifier">During</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.3" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_identifier">reasoning</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.7" class="ltx_text ltx_lst_identifier">process</span>,<span id="lstnumberx3.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.9" class="ltx_text ltx_lst_identifier">whenever</span><span id="lstnumberx3.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.11" class="ltx_text ltx_lst_identifier">you</span><span id="lstnumberx3.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.13" class="ltx_text ltx_lst_identifier">encounter</span><span id="lstnumberx3.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.15" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx3.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.17" class="ltx_text ltx_lst_identifier">step</span><span id="lstnumberx3.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.19" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx3.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.21" class="ltx_text ltx_lst_identifier">may</span><span id="lstnumberx3.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.23" class="ltx_text ltx_lst_identifier">benefit</span><span id="lstnumberx3.24" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.25" class="ltx_text ltx_lst_identifier">from</span><span id="lstnumberx3.26" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.27" class="ltx_text ltx_lst_identifier">multiple</span><span id="lstnumberx3.28" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.29" class="ltx_text ltx_lst_identifier">perspectives</span><span id="lstnumberx3.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.31" class="ltx_text ltx_lst_identifier">or</span><span id="lstnumberx3.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.33" class="ltx_text ltx_lst_identifier">independent</span><span id="lstnumberx3.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.35" class="ltx_text ltx_lst_identifier">reasoning</span>,<span id="lstnumberx3.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.37" class="ltx_text ltx_lst_identifier">insert</span><span id="lstnumberx3.38" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.39" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx3.40" class="ltx_text ltx_lst_space"> </span>&lt;<span id="lstnumberx3.41" class="ltx_text ltx_lst_identifier">Parallel</span>&gt;<span id="lstnumberx3.42" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.43" class="ltx_text ltx_lst_identifier">block</span><span id="lstnumberx3.44" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.45" class="ltx_text ltx_lst_identifier">at</span><span id="lstnumberx3.46" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.47" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx3.48" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx3.49" class="ltx_text ltx_lst_identifier">point</span>.
