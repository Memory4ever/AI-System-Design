          <span id="alg1.l20.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l20.m1" class="ltx_Math" alttext="\mathit{format\_valid}" display="inline" intent=":literal"><semantics><mrow><mi>𝑓𝑜𝑟𝑚𝑎𝑡</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑣𝑎𝑙𝑖𝑑</mi></mrow><annotation encoding="application/x-tex">\mathit{format\_valid}</annotation></semantics></math> <span id="alg1.l20.3" class="ltx_text ltx_font_bold">and</span> <math id="alg1.l20.m2" class="ltx_Math" alttext="S\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">S\neq\emptyset</annotation></semantics></math> <span id="alg1.l20.4" class="ltx_text ltx_font_bold">then</span>

