/span><span id="lstnumberx47.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">find</span><span id="lstnumberx47.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx47.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">possible</span><span id="lstnumberx47.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx47.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">values</span><span id="lstnumberx47.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx47.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">of</span><span id="lstnumberx47.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx47.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">b</span><span id="lstnumberx47.26" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">,</span>
</span>
<span id="lstnumberx48" class="ltx_listingline"><span id="lstnumberx48.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">but</span><span id="lstnumberx48.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">only</span><span id="lstnumberx48.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx48.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">factorization</span><span id="lstnumberx48.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">method</span><span id="lstnumberx48.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">yields</span><span id="lstnumberx48.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">valid</span><span id="lstnumberx48.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">bases</span><span id="lstnumberx48.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">greater</span><span id="lstnumberx48.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">than</span><span id="lstnumberx48.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx48.21" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">9.</span>
</span>
<span id="lstnumberx49" class="ltx_listingline"><span id="lstnumberx49.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">&lt;/</span><span id="lstnumberx49.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Summary</span><span id="lstnumberx49.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">&gt;</span>
</span>
</span>
<span id="A2.F5.pic1.1.5" class="ltx_p"><span id="A2.F5.pic1.1.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">Next, consider the condition that <math id="A2.F5.pic1.m13" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math> divides <math id="A2.F5.pic1.m14" class="ltx_Math" alttext="9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">9b+7</annotation></semantics></math>.
From the earlier, <math id="A2.F5.pic1.m15" class="ltx_Math" alttext="9b+7=9(b+7)-56" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn></mrow></mrow><annotation encoding="application/x-tex">9b+7=9(b+7)-56</annotation></semantics></math>.
For <math id="A2.F5.pic1.m16" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math> to divide <math id="A2.F5.pic1.m17" class="ltx_Math" alttext="9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">9b+7</annotation></semantics></math>, it must divide <math id="A2.F5.pic1.m18" class="ltx_Math" alttext="56" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn><annotation encoding="application/x-tex">56</annotation></semantics></math>.
Since <math id="A2.F5.pic1.m19" class="ltx_Math" alttext="b+7\geq 17" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">17</mn></mrow><annotation encoding="application/x-tex">b+7\geq 17</annotation></semantics></math> for <math id="A2.F5.pic1.m20" class="ltx_Math" alttext="b&gt;9" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><annotation encoding="application/x-tex">b&gt;9</annotation></semantics></math>, the only divisors of 56 exceeding 16 are 28 and 56, giving <math id="A2.F5.pic1.m21" class="ltx_Math" alttext="b+7\in\{28,56\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">b+7\in\{28,56\}</annotation></semantics></math> and thus <math id="A2.F5.pic1.m22" class="ltx_Math" alttext="b\in\{21,49\}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">b\in\{21,49\}</annotation></semantics></math>.</span></span>
<span id="A2.F5.pic1.1.6" class="ltx_p"><span id="A2.F5.pic1.1.6.1" class="ltx_text" style="--ltx-fg-color:#000000;">Finally, verify:</span></span>
<span id="A2.F5.pic1.1.7" class="ltx_p"><span id="A2.F5.pic1.1.7.1" class="ltx_text" style="--ltx-fg-color:#000000;">For <math id="A2.F5.pic1.m23" class="ltx_Math" alttext="b=21" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn></mrow><annotation encoding="application/x-tex">b=21</annotation></semantics></math>: <math id="A2.F5.pic1.m24" class="ltx_Math" alttext="17_{21}=21+7=28" display="inline" intent=":literal"><semantics><mrow><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">17</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn></mrow><annotation encoding="application/x-tex">17_{21}=21+7=28</annotation></semantics></math>, <math id="A2.F5.pic1.m25" class="ltx_Math" alttext="97_{21}=9\times 21+7=196" display="inline" intent=":literal"><semantics><mrow><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">97</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">196</mn></mrow><annotation encoding="application/x-tex">97_{21}=9\times 21+7=196</annotation></semantics></math>, <math id="A2.F5.pic1.m26" class="ltx_Math" alttext="196\div 28=7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">196</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">÷</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">196\div 28=7</annotation></semantics></math>.
<br class="ltx_break">For <math id="A2.F5.pic1.m27" class="ltx_Math" alttext="b=49" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn></mrow><annotation encoding="application/x-tex">b=49</annotation></semantics></math>: <math id="A2.F5.pic1.m28" class="ltx_Math" alttext="17_{49}=49+7=56" display="inline" intent=":literal"><semantics><mrow><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">17</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn></mrow><annotation encoding="application/x-tex">17_{49}=49+7=56</annotation></semantics></math>, <math id="A2.F5.pic1.m29" class="ltx_Math" alttext="97_{49}=9\times 49+7=448" display="inline" intent=":literal"><semantics><mrow><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">97</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">448</mn></mrow><annotation encoding="application/x-tex">97_{49}=9\times 49+7=448</annotation></semantics></math>, <math id="A2.F5.pic1.m30" class="ltx_Math" alttext="448\div 56=8" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">448</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">÷</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></mrow><annotation encoding="application/x-tex">448\div 56=8</annotation></semantics></math>.
<br class="ltx_break" style="--ltx-break-space:4.0pt;">
Thus, the sum is <math id="A2.F5.pic1.m31" class="ltx_Math" alttext="21+49=70" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">70</mn></mrow><annotation encoding="application/x-tex">21+49=70</annotation></semantics></math>.
Final Answer: 70</span></span>
</span></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>A qualitative case study showcases that our model uses parallel exploration of two distinct algebraic methods for solving a number theory problem, both converging on the correct answer.</figcaption>
</figure>
<figure id="A2.F6" class="ltx_figure"><span class="ltx_inline-block"><svg id="A2.F6.pic1" class="ltx_picture ltx_centering" height="388.55" overflow="visible" version="1.1" viewBox="0 0 600 388.55" width="600"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,388.55) matrix(1 0 0 -1 0 0)"><clipPath id="pgfcp17"><path d="M -22670.54 -22670.54 L 22670.54 -22670.54 L 22670.54 22670.54 L -22670.54 22670.54 Z M 0 0 L 0 388.55 L 600 388.55 L 600 0 Z"></path></clipPath><g fill-rule="evenodd"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 388.55 L 600 388.55 L 600 0 Z M 1.97 1.97 L 1.97 386.58 L 598.03 386.58 L 598.03 1.97 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 1.97 L 1.97 386.58 L 598.03 386.58 L 598.03 1.97 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.47)"><foreignObject style="--ltx-fo-width:40.23em;--ltx-fo-height:25.89em;--ltx-fo-depth:0.19em;font-size:10pt;" height="361" overflow="visible" transform="matrix(1 0 0 -1 0 358.31)" width="556.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.F6.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:40.23em;">
<span id="A2.F6.pic1.1.1" class="ltx_p"><span id="A2.F6.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Case Study:<span id="A2.F6.pic1.1.1.1.1" class="ltx_text ltx_font_medium"> Find the sum of all integer bases <math id="A2.F6.pic1.m1" class="ltx_Math" alttext="b&gt;9" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><annotation encoding="application/x-tex">b&gt;9</annotation></semantics></math> for which <math id="A2.F6.pic1.m2" class="ltx_Math" alttext="17_{b}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">17</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></msub><annotation encoding="application/x-tex">17_{b}</annotation></semantics></math> is a divisor of <math id="A2.F6.pic1.m3" class="ltx_Math" alttext="97_{b}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">97</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></msub><annotation encoding="application/x-tex">97_{b}</annotation></semantics></math>.</span></span></span>
<span id="A2.F6.pic1.1.2" class="ltx_p"><span id="A2.F6.pic1.1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">First, I need to find all integer bases <math id="A2.F6.pic1.m4" class="ltx_Math" alttext="b&gt;9" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><annotation encoding="application/x-tex">b&gt;9</annotation></semantics></math> for which <math id="A2.F6.pic1.m5" class="ltx_Math" alttext="17_{b}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">17</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></msub><annotation encoding="application/x-tex">17_{b}</annotation></semantics></math> is a divisor of <math id="A2.F6.pic1.m6" class="ltx_Math" alttext="97_{b}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">97</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></msub><annotation encoding="application/x-tex">97_{b}</annotation></semantics></math>. To do this, I’ll start by converting these base-<math id="A2.F6.pic1.m7" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> numbers to base 10, as that’s more familiar.</span></span>
<span id="A2.F6.pic1.1.3" class="ltx_p"><span id="A2.F6.pic1.1.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">In base <math id="A2.F6.pic1.m8" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>, the number <math id="A2.F6.pic1.m9" class="ltx_Math" alttext="17_{b}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">17</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></msub><annotation encoding="application/x-tex">17_{b}</annotation></semantics></math> means <math id="A2.F6.pic1.m10" class="ltx_Math" alttext="1\times b+7=b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow></mrow><annotation encoding="application/x-tex">1\times b+7=b+7</annotation></semantics></math> in base 10. Similarly, <math id="A2.F6.pic1.m11" class="ltx_Math" alttext="97_{b}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">97</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></msub><annotation encoding="application/x-tex">97_{b}</annotation></semantics></math> means <math id="A2.F6.pic1.m12" class="ltx_Math" alttext="9\times b+7=9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow></mrow><annotation encoding="application/x-tex">9\times b+7=9b+7</annotation></semantics></math> in base 10.</span></span>
<span id="A2.F6.pic1.1.4" class="ltx_p"><span id="A2.F6.pic1.1.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">So, the condition that <math id="A2.F6.pic1.m13" class="ltx_Math" alttext="17_{b}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">17</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></msub><annotation encoding="application/x-tex">17_{b}</annotation></semantics></math> divides <math id="A2.F6.pic1.m14" class="ltx_Math" alttext="97_{b}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">97</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></msub><annotation encoding="application/x-tex">97_{b}</annotation></semantics></math> translates to <math id="A2.F6.pic1.m15" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math> dividing <math id="A2.F6.pic1.m16" class="ltx_Math" alttext="9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">9b+7</annotation></semantics></math> in base 10.</span></span>
<span id="A2.F6.pic1.1.5" class="ltx_p"><span id="A2.F6.pic1.1.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">Now, for <math id="A2.F6.pic1.m17" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math> to divide <math id="A2.F6.pic1.m18" class="ltx_Math" alttext="9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">9b+7</annotation></semantics></math>, the remainder when <math id="A2.F6.pic1.m19" class="ltx_Math" alttext="9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">9b+7</annotation></semantics></math> is divided by <math id="A2.F6.pic1.m20" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math> must be zero. I can perform polynomial division or use the remainder theorem to find this.</span></span>
<span id="A2.F6.pic1.1.6" class="ltx_p"><span id="A2.F6.pic1.1.6.1" class="ltx_text" style="--ltx-fg-color:#000000;">Let me compute the remainder of <math id="A2.F6.pic1.m21" class="ltx_Math" alttext="9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">9b+7</annotation></semantics></math> divided by <math id="A2.F6.pic1.m22" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math>.</span></span>
<span id="A2.F6.pic1.1.7" class="ltx_p"><span id="A2.F6.pic1.1.7.1" class="ltx_text" style="--ltx-fg-color:#000000;">Divide <math id="A2.F6.pic1.m23" class="ltx_Math" alttext="9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">9b+7</annotation></semantics></math> by <math id="A2.F6.pic1.m24" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math>:
- The quotient is 9, since <math id="A2.F6.pic1.m25" class="ltx_Math" alttext="9\times(b+7)=9b+63" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">63</mn></mrow></mrow><annotation encoding="application/x-tex">9\times(b+7)=9b+63</annotation></semantics></math>.
- Subtract this from <math id="A2.F6.pic1.m26" class="ltx_Math" alttext="9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">9b+7</annotation></semantics></math>: <math id="A2.F6.pic1.m27" class="ltx_Math" alttext="(9b+7)-(9b+63)=9b+7-9b-63=-56" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">63</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">63</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn></mrow></mrow><annotation encoding="application/x-tex">(9b+7)-(9b+63)=9b+7-9b-63=-56</annotation></semantics></math>.</span></span>
<span id="A2.F6.pic1.1.8" class="ltx_p"><span id="A2.F6.pic1.1.8.1" class="ltx_text" style="--ltx-fg-color:#000000;">So, the remainder is <math id="A2.F6.pic1.m28" class="ltx_Math" alttext="-56" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn></mrow><annotation encoding="application/x-tex">-56</annotation></semantics></math>. For <math id="A2.F6.pic1.m29" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math> to divide <math id="A2.F6.pic1.m30" class="ltx_Math" alttext="9b+7" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">9b+7</annotation></semantics></math>, it must divide <math id="A2.F6.pic1.m31" class="ltx_Math" alttext="-56" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn></mrow><annotation encoding="application/x-tex">-56</annotation></semantics></math>, or equivalently, <math id="A2.F6.pic1.m32" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math> must be a positive divisor of 56.</span></span>
<span id="A2.F6.pic1.1.9" class="ltx_p"><span id="A2.F6.pic1.1.9.1" class="ltx_text" style="--ltx-fg-color:#000000;">The positive divisors of 56 are: 1, 2, 4, 7, 8, 14, 28, 56.</span></span>
<span id="A2.F6.pic1.1.10" class="ltx_p"><span id="A2.F6.pic1.1.10.1" class="ltx_text" style="--ltx-fg-color:#000000;">Since <math id="A2.F6.pic1.m33" class="ltx_Math" alttext="b&gt;9" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><annotation encoding="application/x-tex">b&gt;9</annotation></semantics></math>, we have <math id="A2.F6.pic1.m34" class="ltx_Math" alttext="b+7&gt;16" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">16</mn></mrow><annotation encoding="application/x-tex">b+7&gt;16</annotation></semantics></math>. So, <math id="A2.F6.pic1.m35" class="ltx_Math" alttext="b+7" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">b+7</annotation></semantics></math> must be a divisor greater than 16.
- <math id="A2.F6.pic1.m36" class="ltx_Math" alttext="b+7=28\Rightarrow b=21" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⇒</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn></mrow><annotation encoding="application/x-tex">b+7=28\Rightarrow b=21</annotation></semantics></math> (valid)
- <math id="A2.F6.pic1.m37" class="ltx_Math" alttext="b+7=56\Rightarrow b=49" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⇒</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn></mrow><annotation encoding="application/x-tex">b+7=56\Rightarrow b=49</annotation></semantics></math> (valid)</span></span>
<span id="A2.F6.pic1.1.11" class="ltx_p"><span id="A2.F6.pic1.1.11.1" class="ltx_text" style="--ltx-fg-color:#000000;">So, the valid bases are <math id="A2.F6.pic1.m38" class="ltx_Math" alttext="b=21" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn></mrow><annotation encoding="application/x-tex">b=21</annotation></semantics></math> and <math id="A2.F6.pic1.m39" class="ltx_Math" alttext="b=49" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn></mrow><annotation encoding="application/x-tex">b=49</annotation></semantics></math>. Now, I need to find the sum: <math id="A2.F6.pic1.m40" class="ltx_Math" alttext="21+49=70" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">21</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">49</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">70</mn></mrow><annotation encoding="application/x-tex">21+49=70</annotation></semantics></math>.</span></span>
<span id="A2.F6.pic1.1.12" class="ltx_p"><span id="A2.F6.pic1.1.12.1" class="ltx_text" style="--ltx-fg-color:#000000;">But before finalizing, I should confirm that these are the only valid bases. From the divisor check, only <math id="A2.F6.pic1.m41" class="ltx_Math" alttext="b+7=28" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">28</mn></mrow><annotation encoding="application/x-tex">b+7=28</annotation></semantics></math> and <math id="A2.F6.pic1.m42" class="ltx_Math" alttext="b+7=56" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn></mrow><annotation encoding="application/x-tex">b+7=56</annotation></semantics></math> give <math id="A2.F6.pic1.m43" class="ltx_Math" alttext="b&gt;9" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><annotation encoding="application/x-tex">b&gt;9</annotation></semantics></math>, so no others.</span></span>
