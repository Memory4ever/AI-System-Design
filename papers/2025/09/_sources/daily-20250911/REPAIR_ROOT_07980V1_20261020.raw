<div id="lstnumberx10" class="ltx_listingline"><span id="lstnumberx10.1" class="ltx_text ltx_lst_identifier">Close</span><span id="lstnumberx10.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx10.3" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx10.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx10.5" class="ltx_text ltx_lst_identifier">block</span><span id="lstnumberx10.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx10.7" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx10.8" class="ltx_text ltx_lst_space"> </span>&lt;/<span id="lstnumberx10.9" class="ltx_text ltx_lst_identifier">Parallel</span>&gt;.
