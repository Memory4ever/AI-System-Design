<div id="lstnumberx11" class="ltx_listingline"><span id="lstnumberx11.1" class="ltx_text ltx_lst_identifier">Immediately</span><span id="lstnumberx11.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.3" class="ltx_text ltx_lst_identifier">after</span><span id="lstnumberx11.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.5" class="ltx_text ltx_lst_identifier">each</span><span id="lstnumberx11.6" class="ltx_text ltx_lst_space"> </span>&lt;/<span id="lstnumberx11.7" class="ltx_text ltx_lst_identifier">Parallel</span>&gt;,<span id="lstnumberx11.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.9" class="ltx_text ltx_lst_identifier">write</span><span id="lstnumberx11.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.11" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx11.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.13" class="ltx_text ltx_lst_identifier">concise</span><span id="lstnumberx11.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.15" class="ltx_text ltx_lst_identifier">summary</span><span id="lstnumberx11.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.17" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx11.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.19" class="ltx_text ltx_lst_identifier">insights</span><span id="lstnumberx11.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.21" class="ltx_text ltx_lst_identifier">or</span><span id="lstnumberx11.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.23" class="ltx_text ltx_lst_identifier">conclusions</span><span id="lstnumberx11.24" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.25" class="ltx_text ltx_lst_identifier">drawn</span><span id="lstnumberx11.26" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.27" class="ltx_text ltx_lst_identifier">from</span><span id="lstnumberx11.28" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.29" class="ltx_text ltx_lst_identifier">all</span><span id="lstnumberx11.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.31" class="ltx_text ltx_lst_identifier">paths</span>,<span id="lstnumberx11.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.33" class="ltx_text ltx_lst_identifier">enclosed</span><span id="lstnumberx11.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.35" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx11.36" class="ltx_text ltx_lst_space"> </span>&lt;<span id="lstnumberx11.37" class="ltx_text ltx_lst_identifier">Summary</span>&gt;<span id="lstnumberx11.38" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.39" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx11.40" class="ltx_text ltx_lst_space"> </span>&lt;/<span id="lstnumberx11.41" class="ltx_text ltx_lst_identifier">Summary</span>&gt;<span id="lstnumberx11.42" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.43" class="ltx_text ltx_lst_identifier">tags</span>.
</div>
<div id="lstnumberx12" class="ltx_listingline">
</div>
<div id="lstnumberx13" class="ltx_listingline"><span id="lstnumberx13.1" class="ltx_text ltx_lst_identifier">Repeat</span><span id="lstnumberx13.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx13.3" class="ltx_text ltx_lst_identifier">this</span><span id="lstnumberx13.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx13.5" class="ltx_text ltx_lst_identifier">process</span><span id="lstnumberx13.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx13.7" class="ltx_text ltx_lst_identifier">adaptively</span><span id="lstnumberx13.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx13.9" class="ltx_text ltx_lst_identifier">as</span><span id="lstnumberx13.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx13.11" class="ltx_text ltx_lst_identifier">needed</span><span id="lstnumberx13.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx13.13" class="ltx_text ltx_lst_identifier">throughout</span><span id="lstnumberx13.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx13.15" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx13.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx13.17" class="ltx_text ltx_lst_identifier">reasoning</span>.
</div>
<div id="lstnumberx14" class="ltx_listingline"><span id="lstnumberx14.1" class="ltx_text ltx_lst_identifier">Do</span><span id="lstnumberx14.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.3" class="ltx_text ltx_lst_identifier">not</span><span id="lstnumberx14.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.5" class="ltx_text ltx_lst_identifier">explicitly</span><span id="lstnumberx14.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.7" class="ltx_text ltx_lst_identifier">mention</span><span id="lstnumberx14.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.9" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx14.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.11" class="ltx_text ltx_lst_identifier">you</span><span id="lstnumberx14.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.13" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx14.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.15" class="ltx_text ltx_lst_identifier">triggering</span><span id="lstnumberx14.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.17" class="ltx_text ltx_lst_identifier">parallel</span><span id="lstnumberx14.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.19" class="ltx_text ltx_lst_identifier">thinking</span>-<span id="lstnumberx14.20" class="ltx_text ltx_lst_identifier">just</span><span id="lstnumberx14.21" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.22" class="ltx_text ltx_lst_identifier">insert</span><span id="lstnumberx14.23" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.24" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx14.25" class="ltx_text ltx_lst_space"> </span>&lt;<span id="lstnumberx14.26" class="ltx_text ltx_lst_identifier">Parallel</span>&gt;<span id="lstnumberx14.27" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.28" class="ltx_text ltx_lst_identifier">block</span><span id="lstnumberx14.29" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.30" class="ltx_text ltx_lst_identifier">naturally</span><span id="lstnumberx14.31" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.32" class="ltx_text ltx_lst_identifier">within</span><span id="lstnumberx14.33" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.34" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx14.35" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.36" class="ltx_text ltx_lst_identifier">reasoning</span><span id="lstnumberx14.37" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx14.38" class="ltx_text ltx_lst_identifier">chain</span>.
</div>
