<td id="S3.T2.3.5.2" class="ltx_td ltx_align_center">13.36</td>
<td id="S3.T2.3.5.3" class="ltx_td ltx_align_center">0.756</td>
<td id="S3.T2.3.5.4" class="ltx_td ltx_align_center">0.334</td>
