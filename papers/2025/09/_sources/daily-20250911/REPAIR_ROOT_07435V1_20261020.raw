                </XMApp>
                <XMTok font="italic" fontsize="63%" role="UNKNOWN">a</XMTok>
              </XMApp>
            </XMath>
          </Math></foreignObject></g></g><g transform="translate(168.94,92.28)"><g transform="translate(0,12.62) scale(1,-1)"><foreignObject width="17.14" height="9.70" overflow="visible"><Math mode="inline" tex="\bm{Y}^{\prime}_{g}" text="(Y ^ prime) _ g" xml:id="S2.F2.pic1.m9">
            <XMath xml:id="S2.F2.pic1.m9.1">
              <XMApp xml:id="S2.F2.pic1.m9.1.1">
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMApp xml:id="S2.F2.pic1.m9.1.1.2">
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="bold italic" fontsize="90%" role="UNKNOWN">Y</XMTok>
                  <XMTok fontsize="63%" name="prime" role="SUPOP">′</XMTok>
                </XMApp>
                <XMTok font="italic" fontsize="63%" role="UNKNOWN">g</XMTok>
              </XMApp>
            </XMath>
          </Math></foreignObject></g></g><g transform="translate(169.41,28.39)"><g transform="translate(0,11.16) scale(1,-1)"><foreignObject width="17.14" height="8.24" overflow="visible"><Math mode="inline" tex="\bm{Y}_{g}" text="Y _ g" xml:id="S2.F2.pic1.m10">
            <XMath xml:id="S2.F2.pic1.m10.1">
              <XMApp xml:id="S2.F2.pic1.m10.1.1">
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="bold italic" fontsize="90%" role="UNKNOWN">Y</XMTok>
                <XMTok font="italic" fontsize="63%" role="UNKNOWN">g</XMTok>
              </XMApp>
            </XMath>
          </Math></foreignObject></g></g><g transform="translate(106.48,9.46)"><g transform="scale(1,-1)"><text fontsize="90%" xml:id="S2.F2.pic1.20">(a) LGAA Switcher</text></g></g><g transform="translate(136.29,70.98)"><g transform="translate(0,8.24) scale(1,-1)"><foreignObject width="16.34" height="8.24" overflow="visible"><Math mode="inline" tex="\mathcal{ZC}" text="Z * C" xml:id="S2.F2.pic1.m11">
            <XMath xml:id="S2.F2.pic1.m11.1">
              <XMApp xml:id="S2.F2.pic1.m11.1.1">
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
