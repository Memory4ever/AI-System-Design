          </Math></foreignObject></g></g><g transform="translate(24.61,54.89)"><g transform="translate(0,8.24) scale(1,-1)"><foreignObject width="16.34" height="8.24" overflow="visible"><Math mode="inline" tex="\mathcal{ZC}" text="Z * C" xml:id="S2.F2.pic1.m5">
