          </Math></foreignObject></g></g><g transform="translate(108.84,28.39)"><g transform="translate(0,11.03) scale(1,-1)"><foreignObject width="17.40" height="9.70" overflow="visible"><Math mode="inline" tex="\bm{Y}^{\prime}_{a}" text="(Y ^ prime) _ a" xml:id="S2.F2.pic1.m8">
            <XMath xml:id="S2.F2.pic1.m8.1">
