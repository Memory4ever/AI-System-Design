<td id="S4.T3.10.30.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S4.T3.10.30.2.1" class="ltx_text ltx_font_bold">64.3</span></td>
