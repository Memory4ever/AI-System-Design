<td id="S4.T4.8.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T4.8.1.3.1" class="ltx_text ltx_font_bold">Kitchen</span></td>
<td id="S4.T4.8.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T4.8.1.4.1" class="ltx_text ltx_font_bold">Living Room</span></td>
<td id="S4.T4.8.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T4.8.1.5.1" class="ltx_text ltx_font_bold">Medical Area</span></td>
