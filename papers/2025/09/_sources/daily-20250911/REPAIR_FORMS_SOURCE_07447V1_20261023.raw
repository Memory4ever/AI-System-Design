<td id="S4.T4.8.10.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;">Gemini 2.0 Flash-Lite</td>
<td id="S4.T4.8.10.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;">-</td>
<td id="S4.T4.8.10.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;">53.8 <span id="S4.T4.8.10.3.1" class="ltx_text" style="--ltx-fg-color:#4CAF50;"> <math id="S4.T4.m41" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#4CAF50;" mathcolor="#4CAF50" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>3.0</span></td>
