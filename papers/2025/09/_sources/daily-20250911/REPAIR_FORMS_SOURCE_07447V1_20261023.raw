<td id="A1.tab1.1.3.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A1.tab1.1.3.1.1" class="ltx_text" style="font-size:70%;">Data</span></td>
<td id="A1.tab1.1.3.2" class="ltx_td ltx_align_left ltx_border_bb"><a href="https://huggingface.co/datasets/anonupload/EgoGazeVQA-91-nips25DB" title="" class="ltx_ref ltx_url ltx_font_typewriter" style="font-size:70%;">https://huggingface.co/datasets/anonupload/EgoGazeVQA-91-nips25DB</a></td>
