<td id="A3.T12.2.3.6" class="ltx_td ltx_align_center ltx_border_t">4.8</td>
<td id="A3.T12.2.3.7" class="ltx_td ltx_align_center ltx_border_t">8.4</td></tr>
<tr id="A3.T12.2.4" class="ltx_tr">
<td id="A3.T12.2.4.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t">Qwen2.5VL-72B (acc)</td>
