<td id="A3.T11.2.4.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t">Qwen2.5VL-72B (acc)</td>
<td id="A3.T11.2.4.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_t">58.5</td>
