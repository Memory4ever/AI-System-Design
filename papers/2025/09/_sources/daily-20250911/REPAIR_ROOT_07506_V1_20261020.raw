                <span id="lstnumberx64.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">    </span><span id="lstnumberx64.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#000096;">float</span><span id="lstnumberx64.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx64.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">y</span><span id="lstnumberx64.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx64.7" class="ltx_text ltx_font_typewriter" style="font-size:70%;">=</span><span id="lstnumberx64.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx64.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">__expf</span><span id="lstnumberx64.10" class="ltx_text ltx_font_typewriter" style="font-size:70%;">(-</span><span id="lstnumberx64.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">x</span><span id="lstnumberx64.12" class="ltx_text ltx_font_typewriter" style="font-size:70%;">);</span>
