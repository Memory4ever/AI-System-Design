                <span id="lstnumberx5.2" class="ltx_text ltx_font_typewriter" style="font-size:70%;">{</span>
</div>
<div id="lstnumberx6" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline">6</span>
                  
                  
                  
                <span id="lstnumberx6.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">  </span><span id="lstnumberx6.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#000096;">float</span><span id="lstnumberx6.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx6.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">smax</span><span id="lstnumberx6.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx6.7" class="ltx_text ltx_font_typewriter" style="font-size:70%;">=</span><span id="lstnumberx6.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx6.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">fmaxf</span><span id="lstnumberx6.10" class="ltx_text ltx_font_typewriter" style="font-size:70%;">(</span><span id="lstnumberx6.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">sa</span><span id="lstnumberx6.12" class="ltx_text ltx_font_typewriter" style="font-size:70%;">,</span><span id="lstnumberx6.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx6.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">sb</span><span id="lstnumberx6.15" class="ltx_text ltx_font_typewriter" style="font-size:70%;">);</span><span id="lstnumberx6.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx6.17" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#737373;">//<span id="lstnumberx6.17.1" class="ltx_text ltx_lst_space"> </span>repeated</span>
</div>
