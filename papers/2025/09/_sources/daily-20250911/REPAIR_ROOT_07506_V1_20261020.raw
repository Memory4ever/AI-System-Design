</div>
<div id="lstnumberx4" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline">4</span>
                  
                  
                  
                <span id="lstnumberx4.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#000096;">for</span><span id="lstnumberx4.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;">(</span><span id="lstnumberx4.5" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#000096;">int</span><span id="lstnumberx4.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">d</span><span id="lstnumberx4.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.9" class="ltx_text ltx_font_typewriter" style="font-size:70%;">=</span><span id="lstnumberx4.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.11" class="ltx_text ltx_font_typewriter" style="font-size:70%;">0;</span><span id="lstnumberx4.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">d</span><span id="lstnumberx4.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.15" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#000096;">&lt;</span><span id="lstnumberx4.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">D</span><span id="lstnumberx4.18" class="ltx_text ltx_font_typewriter" style="font-size:70%;">;</span><sp