<td id="S4.T1.3.1.2.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.3.1.2.5.1" class="ltx_text" style="font-size:90%;">RGS</span></td>
<td id="S4.T1.3.1.2.6" class="ltx_td ltx_align_center"><span id="S4.T1.3.1.2.6.1" class="ltx_text" style="font-size:90%;">RR</span></td>
<td id="S4.T1.3.1.2.7" class="ltx_td ltx_align_center"><span id="S4.T1.3.1.2.7.1" class="ltx_text" style="font-size:90%;">SlideGAR</span></td>
<td id="S4.T1.3.1.2.8" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.3.1.2.8.1" class="ltx_text" style="font-size:90%;">RGS</span></td>
<td id="S4.T1.3.1.2.9" class="ltx_td ltx_align_center"><span id="S4.T1.3.1.2.9.1" class="ltx_text" style="font-size:90%;">RR</span></td>
<td id="S4.T1.3.1.2.10" class="ltx_td ltx_align_center"><span id="S4.T1.3.1.2.10.1" class="ltx_text" style="font-size:90%;">SlideGAR</span></td>
<td id="S4.T1.3.1.2.11" class="ltx_td ltx_align_center"><span id="S4.T1.3.1.2.11.1" class="ltx_text" style="font-size:90%;">RGS</span></td></tr>
<tr id="S4.T1.3.1.3" class="ltx_tr">
<th id="S4.T1.3.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S4.T1.3.1.3.1.1" class="ltx_text" style="font-size:90%;">Biology</span></th>
<th id="S4.T1.3.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S4.T1.3.1.3.2.1" class="ltx_text" style="font-size:90%;">11.7</span></th>
<td id="S4.T1.3.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.3.1.3.3.1" class="ltx_text" style="font-size:90%;">31.1</span></td>
<td id="S4.T1.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.3.1.3.4.1" class="ltx_text" style="font-size:90%;">33.9</span></td>
<td id="S4.T1.3.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T1.3.1.3.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">37.0</span></td>
<td id="S4.T1.3.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.3.1.3.6.1" class="ltx_text" style="font-size:90%;">37.6</span></td>
<td id="S4.T1.3.1.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.3.1.3.7.1" class="ltx_text" style="font-size:90%;">37.0</span></td>
