<td id="A6.F9.pic1.1.13.1" class="ltx_td ltx_align_left"><span id="A6.F9.pic1.1.13.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold">Layer 10:</span></td>
<td id="A6.F9.pic1.1.13.2" class="ltx_td ltx_align_left"><span id="A6.F9.pic1.1.13.2.1" class="ltx_text ltx_font_typewriter">IT TAKES NO I<span id="A6.F9.pic1.1.13.2.1.1" class="ltx_text" style="--ltx-bg-color:#FFFF00;">M</span>A<span id="A6.F9.pic1.1.13.2.1.2" class="ltx_text" style="--ltx-bg-color:#FFFF00;">G</span>INATION TO <span id="A6.F9.pic1.1.13.2.1.3" class="ltx_text" style="--ltx-bg-color:#FFFF00;">L</span>IVE WIT<span id="A6.F9.pic1.1.13.2.1.4" class="ltx_text" style="--ltx-bg-color:#FFFF00;">H</span>IN <span id="A6.F9.pic1.1.13.2.1.5" class="ltx_text" style="--ltx-bg-color:#FFFF00;">Y</span>OU<span id="A6.F9.pic1.1.13.2.1.6" class="ltx_text" style="--ltx-bg-color:#FFFF00;">R</span> <span id="A6.F9.pic1.1.13.2.1.7" class="ltx_text" style="--ltx-bg-color:#FFFF00;">M</span>EANS.</span></td></tr>
<tr id="A6.F9.pic1.1.14" class="ltx_tr">
<td id="A6.F9.pic1.1.14.1" class="ltx_td ltx_align_left"><span id="A6.F9.pic1.1.14.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold">Layer 11:</span></td>
<td id="A6.F9.pic1.1.14.2" class="ltx_td ltx_align_left"><span id="A6.F9.pic1.1.14.2.1" class="ltx_text ltx_font_typewriter">IT TAKES NO IMAGINATION TO LIVE WITHIN YOUR MEANS.</span></td></tr>
<tr id="A6.F9.pic1.1.15" class="ltx_tr">
<td id="A6.F9.pic1.1.15.1" class="ltx_td ltx_align_left"><span id="A6.F9.pic1.1.15.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold">Layer 12:</span></td>
<td id="A6.F9.pic1.1.15.2" class="ltx_td ltx_align_left"><span id="A6.F9.pic1.1.15.2.1" class="ltx_text ltx_font_typewriter">IT TAKES NO IMAGINATION TO LIVE WITHIN YOUR MEANS.</span></td></tr>
</tbody>
</table><span id="A6.F9.pic1.2" class="ltx_text ltx_font_typewriter">
