<td id="S5.T2.1.4.6" class="ltx_td ltx_align_center" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="S5.T2.m21" class="ltx_Math" alttext="3.49\pm 0.53" display="inline" intent=":literal"><semantics><mrow><mn>3.49</mn><mo>±</mo><mn>0.53</mn></mrow><annotation encoding="application/x-tex">3.49\pm 0.53</annotation></semantics></math></td>
