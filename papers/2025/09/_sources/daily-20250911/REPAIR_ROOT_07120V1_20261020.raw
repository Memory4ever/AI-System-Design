8 2.77 9.04 1.53 9.04 0 C 9.04 -1.53 10.28 -2.77 11.81 -2.77 C 13.34 -2.77 14.58 -1.53 14.58 0 Z M 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 145.32 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -3.39)"><foreignObject style="--ltx-fo-width:2.18em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="27.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F3.pic1.13" class="ltx_text" style="font-size:90%;">Back</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#E31A1C;--ltx-fill-color:#E31A1C;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#E31A1C" stroke="#E31A1C" stroke-width="1.1pt" transform="matrix(1 0 0 -1 178.68 0) translate(0.76,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path d="M 14.58 0 C 14.58 1.53 13.34 2.77 11.81 2.77 C 10.28 2.77 9.04 1.53 9.04 0 C 9.04 -1.53 10.28 -2.77 11.81 -2.77 C 13.34 -2.77 14.58 -1.53 14.58 0 Z M 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 203.82 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -3.39)"><foreignObject style="--ltx-fo-width:6.11em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="78.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F3.pic1.14" class="ltx_text" style="font-size:90%;">Front &amp; Back</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FF7F00;--ltx-fill-color:#FF7F00;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#FF7F00" stroke="#FF7F00" stroke-width="1.1pt" transform="matrix(1 0 0 -1 286.1 0) translate(0.76,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path d="M 14.58 0 C 14.58 1.53 13.34 2.77 11.81 2.77 C 10.28 2.77 9.04 1.53 9.04 0 C 9.04 -1.53 10.28 -2.77 11.81 -2.77 C 13.34 -2.77 14.58 -1.53 14.58 0 Z M 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 311.25 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -3.39)"><foreignObject style="--ltx-fo-width:1.75em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="22.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F3.pic1.15" class="ltx_text" style="font-size:90%;">Mid</span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_figure">Figure A-3: </span>
<span id="A1.F3.10" class="ltx_text ltx_font_bold">Influence of dropping global attention layers.</span>
We skip the computation of different global attention layers in the aggregator starting with the earliest (Front), last (Back), alternating (Front &amp; Back), or from the middle layers (Middle), and evaluate pose estimation on CO3Dv2 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite>.
The x-axis denotes the total number of skipped layers.
The experiment shows that the model is especially sensitive to pruning of the center layers, and robust against pruning the early and late layers.
</figcaption>
</figure>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix" style="font-size:90%;"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Additional Visualizations</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="font-size:90%;"><span class="ltx_tag ltx_tag_subsection">B.1 </span><math id="A2.SS1.m1" class="ltx_Math" alttext="\pi^{3}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mn>3</mn></msup><annotation encoding="application/x-tex">\pi^{3}</annotation></semantics></math> attention maps are similar to VGGT’s</h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p"><span id="A2.SS1.p1.1.1" class="ltx_text" style="font-size:90%;">We plot the average and maximum value of the global attention matrix for layers in the aggregator of </span><math id="A2.SS1.p1.m1" class="ltx_Math" alttext="\pi^{3}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">π</mi><mn mathsize="0.900em">3</mn></msup><annotation encoding="application/x-tex">\pi^{3}</annotation></semantics></math><span id="A2.SS1.p1.1.2" class="ltx_text" style="font-size:90%;"> in </span><a href="#A2.F4" title="In B.1 𝜋^3 attention maps are similar to VGGT’s ‣ Appendix B Additional Visualizations ‣ Faster VGGT with Block-Sparse Global Attention" class="ltx_ref" style="font-size:90%;"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">A-4</span></a><span id="A2.SS1.p1.1.3" class="ltx_text" style="font-size:90%;">, in the same style as </span><a href="#S3.F4" title="In 3.2 Visualizing Attention Maps ‣ 3 Analyzing VGGT’s Attention Patterns ‣ Faster VGGT with Block-Sparse Global Attention" class="ltx_ref" style="font-size:90%;"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">4</span></a><span id="A2.SS1.p1.1.4" class="ltx_text" style="font-size:90%;"> in the main text.
</span><math id="A2.SS1.p1.m2" class="ltx_Math" alttext="\pi^{3}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">π</mi><mn mathsize="0.900em">3</mn></msup><annotation encoding="application/x-tex">\pi^{3}</annotation></semantics></math><span id="A2.SS1.p1.1.5" class="ltx_text" style="font-size:90%;"> uses less global attention layers in the aggregator than VGGT, but the statistics of the remaining layers closely resemble those of the corresponding layers in VGGT.</span></p>
</div>
