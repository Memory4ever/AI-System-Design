4.2 L 130.21 38.12 M 126.3 38.12 L 130.21 34.2"></path><path style="fill:none" d="M 140.48 36.07 L 144.39 39.98 M 140.48 39.98 L 144.39 36.07"></path><path style="fill:none" d="M 154.29 38.34 L 158.2 42.25 M 154.29 42.25 L 158.2 38.34"></path><path style="fill:none" d="M 166.62 42.41 L 170.53 46.33 M 166.62 46.33 L 170.53 42.41"></path><path style="fill:none" d="M 192.14 44.58 L 196.05 48.5 M 192.14 48.5 L 196.05 44.58"></path><path style="fill:none" d="M 208.93 49.93 L 212.84 53.85 M 208.93 53.85 L 212.84 49.93"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 -37.89 34.36)"><foreignObject style="--ltx-fo-width:2.15em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="27.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F2.pic1.1" class="ltx_text" style="font-size:90%;">ATE</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 103.06 107.94)"><foreignObject style="--ltx-fo-width:3.64em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="46.58"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F2.pic1.2" class="ltx_text" style="font-size:90%;">ScanNet</span></span></span></foreignObject></g></g></g></g><g transform="matrix(1.0 0.0 0.0 1.0 273.14 -16.6)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(38.6,0) translate(0,16.6)"><g style="--ltx-stroke-color:#E6E6E6;--ltx-fill-color:#E6E6E6;--ltx-fg-color:#E6E6E6;" color="#E6E6E6" fill="#E6E6E6" stroke="#E6E6E6" stroke-width="0.4pt"><path style="fill:none" d="M 0 0 L 0 95.21 M 56.15 0 L 56.15 95.21 M 112.31 0 L 112.31 95.21 M 168.46 0 L 168