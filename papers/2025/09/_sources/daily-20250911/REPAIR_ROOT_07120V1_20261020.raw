<td id="S5.T1.3.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;" rowspan="8"><span id="S5.T1.3.2.1.1" class="ltx_text" style="font-size:80%;">
<span id="S5.T1.3.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:5.2pt;height:8.5pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:8.5pt;transform:translate(-1.7pt,-1.7pt) rotate(-90deg) ;">
<span id="S5.T1.3.2.1.1.1.1" class="ltx_p">25</span>
</span></span></span></td>
