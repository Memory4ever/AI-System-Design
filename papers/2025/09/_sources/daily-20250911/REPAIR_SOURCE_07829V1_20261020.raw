<tr id="Ax1.T7.2.6" class="ltx_tr">
<th id="Ax1.T7.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DeepL API Pro</th>
<td id="Ax1.T7.2.6.2" class="ltx_td ltx_align_right">–</td>
