<span id="Ax2.T9.2.5.3.1.1.1.5.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left"><span id="Ax2.T9.2.5.3.1.1.1.5.2.1.1" class="ltx_text" style="position:relative; bottom:-1.3pt;">,</span></span></span>
</span>i morocănoasă… 
<span id="Ax2.T9.2.5.3.1.1.1.6" class="ltx_tabular ltx_align_top">
<span id="Ax2.T9.2.5.3.1.1.1.6.1" class="ltx_tr">
<span id="Ax2.T9.2.5.3.1.1.1.6.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left"><span id="Ax2.T9.2.5.3.1.1.1.6.1.1.1" class="ltx_text"></span>s</span></span>
