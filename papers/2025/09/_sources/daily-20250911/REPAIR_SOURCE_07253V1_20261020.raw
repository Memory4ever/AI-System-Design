yle="font-size:90%;">mRNA</span><span id="lstnumberx96.44" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx96.45" class="ltx_text ltx_lst_identifier" style="font-size:90%;">molecules</span><span id="lstnumberx96.46" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx96.47" class="ltx_text ltx_lst_identifier" style="font-size:90%;">polyadenylated.</span>
