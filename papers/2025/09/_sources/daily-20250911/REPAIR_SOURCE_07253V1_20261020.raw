<span id="S3.F2.pic1.6.1" class="ltx_p"></span>
<span id="S3.F2.pic1.6.2" class="ltx_p ltx_align_left"><span id="S3.F2.pic1.6.2.1" class="ltx_text ltx_font_typewriter" style="font-size:50%;"># Main Title<span id="S3.F2.pic1.6.2.1.1" class="ltx_text ltx_font_serif"> 
