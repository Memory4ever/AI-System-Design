x_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.109" class="ltx_text ltx_lst_identifier" style="font-size:90%;">the</span><span id="lstnumberx95.110" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.111" class="ltx_text ltx_lst_identifier" style="font-size:90%;">cytosol.</span><span id="lstnumberx95.112" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.113" class="ltx_text ltx_lst_identifier" style="font-size:90%;">In</span><span id="lstnumberx95.114" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.115" class="ltx_text ltx_lst_identifier" style="font-size:90%;">contrast,</span><span id="lstnumberx95.116" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.117" class="ltx_text ltx_lst_identifier" style="font-size:90%;">when</span><span id="lstnumberx95.118" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.119" class="ltx_text ltx_lst_identifier" style="font-size:90%;">polyadenylation</span><span id="lstnumberx95.120" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.121" class="ltx_text ltx_lst_identifier" style="font-size:90%;">occurs</span><span id="lstnumberx95.122" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.123" class="ltx_text ltx_lst_identifier" style="font-size:90%;">in</span><span id="lstnumberx95.124" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.125" class="ltx_text ltx_lst_identifier" style="font-size:90%;">bacteria,</span><span id="lstnumberx95.126" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.127" class="ltx_text ltx_lst_identifier" style="font-size:90%;">it</span><span id="lstnumberx95.128" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.129" class="ltx_text ltx_lst_identifier" style="font-size:90%;">promotes</span><span id="lstnumberx95.130" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.131" class="ltx_text ltx_lst_identifier" style="font-size:90%;">RNA</span><span id="lstnumberx95.132" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.133" class="ltx_text ltx_lst_identifier" style="font-size:90%;">degradation.</span><span id="lstnumberx95.134" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.135" class="ltx_text ltx_lst_identifier" style="font-size:90%;">This</span><span id="lstnumberx95.136" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.137" class="ltx_text ltx_lst_identifier" style="font-size:90%;">is</span><span id="lstnumberx95.138" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.139" class="ltx_text ltx_lst_identifier" style="font-size:90%;">also</span><span id="lstnumberx95.140" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.141" class="ltx_text ltx_lst_identifier" style="font-size:90%;">sometimes</span><span id="lstnumberx95.142" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.143" class="ltx_text ltx_lst_identifier" style="font-size:90%;">the</span><span id="lstnumberx95.144" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.145" class="ltx_text ltx_lst_identifier" style="font-size:90%;">case</span><span id="lstnumberx95.146" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.147" class="ltx_text ltx_lst_identifier" style="font-size:90%;">for</span><span id="lstnumberx95.148" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.149" class="ltx_text ltx_lst_identifier" style="font-size:90%;">eukaryotic</span><span id="lstnumberx95.150" class="ltx_text ltx_lst