<span id="A2.T11.2.2.1.1.1" class="ltx_listing ltx_align_left ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_lst_identifier" style="font-size:90%;">Patient</span><span id="lstnumberx1.2" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.3" class="ltx_text ltx_lst_identifier" style="font-size:90%;">is</span><span id="lstnumberx1.4" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;">a</span><span id="lstnumberx1.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.7" class="ltx_text" style="font-size:90%;">45-</span><span id="lstnumberx1.8" class="ltx_text ltx_lst_identifier" style="font-size:90%;">year</span><span id="lstnumberx1.9" class="ltx_text" style="font-size:90%;">-</span><span id="lstnumberx1.10" class="ltx_text ltx_lst_identifier" style="font-size:90%;">old</span><span id="lstnumberx1.11" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.12" class="ltx_text ltx_lst_identifier" style="font-size:90%;">man</span><span id="lstnumberx1.13" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.14" class="ltx_text ltx_lst_identifier" style="font-size:90%;">with</span><span id="lstnumberx1.15" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.16" class="ltx_text ltx_lst_identifier" style="font-size:90%;">a</span><span id="lstnumberx1.17" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.18" class="ltx_text ltx_lst_identifier" style="font-size:90%;">history</span><span id="lstnumberx1.19" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.20" class="ltx_text ltx_lst_identifier" style="font-size:90%;">of</span><span id="lstnumberx1.21" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.22" class="ltx_text ltx_lst_identifier" style="font-size:90%;">anaplastic</span><span id="lstnumberx1.23" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.24" class="ltx_text ltx_lst_identifier" style="font-size:90%;">astrocytoma</span><span id="lstnumberx1.25" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.26" class="ltx_text ltx_lst_identifier" style="font-size:90%;">of</span><span id="lstnumberx1.27" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.28" class="ltx_text ltx_lst_identifier" style="font-size:90%;">the</span><span id="lstnumberx1.29" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.30" class="ltx_text ltx_lst_identifier" style="font-size:90%;">spine</span><span id="lstnumberx1.31" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.32" class="ltx_text ltx_lst_identifier" style="font-size:90%;">complicated</span><span id="lstnumberx1.33" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.34" class="ltx_text ltx_lst_identifier" style="font-size:90%;">by</span><span id="lstnumberx1.35" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.36" class="ltx_text ltx_lst_identifier" style="font-size:90%;">severe</span><span id="lstnumberx1.37" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.38" class="ltx_text ltx_lst_identifier" style="font-size:90%;">lower</span><span id="lstnumberx1.39" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.40" class="ltx_text ltx_lst_identifier" style="font-size:90%;">extremity</span><span id="lstnumberx1.41" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.42" class="ltx_text ltx_lst_identifier" style="font-size:90%;">weakness</span><span id="lstnumberx1.43" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.44" class="ltx_text ltx_lst_identifier" style="font-size:90%;">and</span><span id="lstnumberx1.45" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.46" class="ltx_text ltx_lst_identifier" style="font-size:90%;">urinary</span><span id="lstnumberx1.47" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.48" class="ltx_text ltx_lst_identifier" style="font-size:90%;">retention</span><span id="lstnumberx1.49" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.50" class="ltx_text ltx_lst_identifier" style="font-size:90%;">s</span><span id="lstnumberx1.51" class="ltx_text" style="font-size:90%;">/</span><span id="lstnumberx1.52" class="ltx_text ltx_lst_identifier" style="font-size:90%;">p</span><span id="lstnumberx1.53" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.54" class="ltx_text ltx_lst_identifier" style="font-size:90%;">Foley</span><span id="lstnumberx1.55" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.56" class="ltx_text ltx_lst_identifier" style="font-size:90%;">catheter,</span><span id="lstnumberx1.57" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.58" class="ltx_text ltx_lst_identifier" style="font-size:90%;">high</span><span id="lstnumberx1.59" class="ltx_text" style="font-size:90%;">-</span><span id="lstnumberx1.60" class="ltx_text ltx_lst_identifier" style="font-size:90%;">dose</span><span id="lstnumberx1.61" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.62" class="ltx_text ltx_lst_identifier" style="font-size:90%;">steroids,</span><span id="lstnumberx1.63" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.64" class="ltx_text ltx_lst_identifier" style="font-size:90%;">hypertension,</span><span id="lstnumberx1.65" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.66" class="ltx_text ltx_lst_identifier" style="font-size:90%;">and</span><span id="lstnumberx1.67" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.68" class="ltx_text ltx_lst_identifier" style="font-size:90%;">chronic</span><span id="lstnumberx1.69" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.70" class="ltx_text ltx_lst_identifier" style="font-size:90%;">pain.</span><span id="lstnumberx1.71" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.72" class="ltx_text ltx_lst_identifier" style="font-size:90%;">The</span><span id="lstnumberx1.73" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.74" class="ltx_text ltx_lst_identifier" style="font-size:90%;">tumor</span><span id="lstnumberx1.75" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.76" class="ltx_text ltx_lst_identifier" style="font-size:90%;">is</span><span id="lstnumberx1.77" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.78" class="ltx_text ltx_lst_identifier" style="font-size:90%;">located</span><span id="lstnumberx1.79" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.80" class="ltx_text ltx_lst_identifier" style="font-size:90%;">in</span><span id="lstnumberx1.81" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.82" class="ltx_text ltx_lst_identifier" style="font-size:90%;">the</span><span id="lstnumberx1.83" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.84" class="ltx_text ltx_lst_identifier" style="font-size:90%;">T</span><span id="lstnumberx1.85" class="ltx_text" style="font-size:90%;">-</span><span id="lstnumberx1.86" class="ltx_text ltx_lst_identifier" style="font-size:90%;">L</span><span id="lstnumberx1.87" class="ltx_text ltx_lst_space" style="font-size:90%;">