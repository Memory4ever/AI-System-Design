lstnumberx95.65" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.66" class="ltx_text ltx_lst_identifier" style="font-size:90%;">However,</span><span id="lstnumberx95.67" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.68" class="ltx_text ltx_lst_identifier" style="font-size:90%;">in</span><span id="lstnumberx95.69" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.70" class="ltx_text ltx_lst_identifier" style="font-size:90%;">a</span><span id="lstnumberx95.71" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.72" class="ltx_text ltx_lst_identifier" style="font-size:90%;">few</span><span id="lstnumberx95.73" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.74" class="ltx_text ltx_lst_identifier" style="font-size:90%;">cell</span><span id="lstnumberx95.75" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.76" class="ltx_text ltx_lst_identifier" style="font-size:90%;">types,</span><span id="lstnumberx95.77" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.78" class="ltx_text ltx_lst_identifier" style="font-size:90%;">mRNAs</span><span id="lstnumberx95.79" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.80" class="ltx_text ltx_lst_identifier" style="font-size:90%;">with</span><span id="lstnumberx95.81" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.82" class="ltx_text ltx_lst_identifier" style="font-size:90%;">short</span><span id="lstnumberx95.83" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx95.84" class="ltx_text ltx_lst_identifier" style="font-size:90%;">poly</span><span id="lstnumberx95.85" class="ltx_text" style="font-size:90%;">(</span><span id="lstnumberx95.86" class="ltx_text ltx_lst_identifier" style="fon