<td id="S3.T2.2.9.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="S3.T2.m1" class="ltx_Math" alttext="\mathbf{97.76}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">97.76</mn><annotation encoding="application/x-tex">\mathbf{97.76}</annotation></semantics></math></td>
