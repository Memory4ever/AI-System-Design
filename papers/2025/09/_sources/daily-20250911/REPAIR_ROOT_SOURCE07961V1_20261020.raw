<td id="S5.SS1.tab3.1.11.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:4pt 8.0pt;">Metaphors</td>
<td id="S5.SS1.tab3.1.11.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:4pt 8.0pt;">18</td></tr>
