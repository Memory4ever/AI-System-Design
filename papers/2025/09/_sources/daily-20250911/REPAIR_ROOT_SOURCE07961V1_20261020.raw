<td id="S5.SS2.p7.1.12.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S5.SS2.p7.1.12.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#5B9BAB;">2.3</span></td>
