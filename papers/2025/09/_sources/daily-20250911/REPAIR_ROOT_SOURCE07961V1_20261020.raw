<td id="S5.SS3.p3.2.12.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S5.SS3.p3.2.12.5.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#5B9BAB;">3.3</span></td>
