<td id="S5.SS3.p1.2.12.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S5.SS3.p1.2.12.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#5B9BAB;">9.8</span></td>
<td id="S5.SS3.p1.2.12.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S5.SS3.p1.2.12.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#5B9BAB;">3.1</span></td>
<td id="S5.SS3.p1.2.12.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S5.SS3.p1.2.12.5.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#5B9BAB;">2.2</span></td>
<td id="S5.SS3.p1.2.12.6" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S5.SS3.p1.2.12.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#5B9BAB;">2.3</span></td>
<td id="S5.SS3.p1.2.12.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S5.SS3.p1.2.12.7.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#5B9BAB;">54.7%</span></td>
<td id="S5.SS3.p1.2.12.8" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding:1.5pt 3.0pt;"><span id="S5.SS3.p1.2.12.8.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#5B9BAB;">100%</span></td></tr>
