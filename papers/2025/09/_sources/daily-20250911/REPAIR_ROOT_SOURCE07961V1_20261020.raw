<td id="S5.SS1.tab3.1.11.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:4pt 8.0pt;">Subjective</td>
<td id="S5.SS1.tab3.1.11.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:4pt 8.0pt;">17</td>
<td id="S5.SS1.tab3.1.11.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:4pt 8.0pt;">Communication</td>
