<td id="S4.T2.6.1.4.1" class="ltx_td ltx_align_left ltx_border_t">CLIP</td>
<td id="S4.T2.6.1.4.2" class="ltx_td ltx_align_right ltx_border_t">27.81</td>
<td id="S4.T2.6.1.4.3" class="ltx_td ltx_align_center ltx_border_t">8.42</td>
