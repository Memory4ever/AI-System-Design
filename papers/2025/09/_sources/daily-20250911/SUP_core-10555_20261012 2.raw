<td id="S5.T3.6.1.2.6" class="ltx_td"></td>
<td id="S5.T3.6.1.2.7" class="ltx_td ltx_align_center ltx_border_t">Acc</td>
<td id="S5.T3.6.1.2.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">F1</td></tr>
<tr id="S5.T3.6.1.3" class="ltx_tr">
<td id="S5.T3.6.1.3.1" class="ltx_td ltx_align_left ltx_border_t">CLIP</td>
<td id="S5.T3.6.1.3.2" class="ltx_td ltx_align_center ltx_border_t">77.24</td>
<td id="S5.T3.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t">61.95</td>
<td id="S5.T3.6.1.3.4" class="ltx_td ltx_border_t"></td>
<td id="S5.T3.6.1.3.5" class="ltx_td ltx_align_center ltx_border_t">23.95</td>
<td id="S5.T3.6.1.3.6" class="ltx_td ltx_align_center ltx_border_t">11.52</td>
<td id="S5.T3.6.1.3.7" class="ltx_td ltx_border_t"></td>
<td id="S5.T3.6.1.3.8" class="ltx_td ltx_align_center ltx_border_t">32.22</td>
<td id="S5.T3.6.1.3.9" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">4.40</td></tr>
<tr id="S5.T3.6.1.4" class="ltx_tr">
