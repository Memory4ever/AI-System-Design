</figure>
<figure id="S1.F18" class="ltx_figure"><object type="image/svg+xml" data="2509.10555v1/multibypass.svg" id="S1.F18.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:191/94;" width="191" height="94"></object>
