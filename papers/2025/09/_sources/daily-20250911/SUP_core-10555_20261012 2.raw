</figure>
<figure id="S1.F11" class="ltx_figure"><object type="image/svg+xml" data="2509.10555v1/procedure_type_classifier.svg" id="S1.F11.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:215/217;" width="215" height="217"></object>
