</thead>
<tbody class="ltx_tbody">
<tr id="S5.T4.2.1.2" class="ltx_tr">
<th id="S5.T4.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="2"><span id="S5.T4.2.1.2.1.1" class="ltx_text">CLIP</span></th>
