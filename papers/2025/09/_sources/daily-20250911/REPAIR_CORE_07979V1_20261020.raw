<td id="S5.T4.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">400</td>
<td id="S5.T4.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">374</td>
<td id="S5.T4.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.m3" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>26 (6.5%)</td></tr>
<tr id="S5.T4.2.1.3" class="ltx_tr">
<th id="S5.T4.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">✓</th>
<td id="S5.T4.2.1.3.2" class="ltx_td ltx_align_center">414</td>
