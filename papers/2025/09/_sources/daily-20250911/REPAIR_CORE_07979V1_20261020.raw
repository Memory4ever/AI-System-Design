<td id="S5.T1.2.1.6.6" class="ltx_td ltx_align_center"><span id="S5.T1.2.1.6.6.1" class="ltx_text ltx_font_bold">37.20%</span></td>
<td id="S5.T1.2.1.6.7" class="ltx_td ltx_align_center"><span id="S5.T1.2.1.6.7.1" class="ltx_text ltx_font_bold">1835.62</span></td></tr>
<tr id="S5.T1.2.1.7" class="ltx_tr">
<th id="S5.T1.2.1.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="2"><span id="S5.T1.2.1.7.1.1" class="ltx_text">Qwen2.5-7B</span></th>
<th id="S5.T1.2.1.7.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="2"><span id="S5.T1.2.1.7.2.1" class="ltx_text">CLIP</span></th>
<th id="S5.T1.2.1.7.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S5.T1.2.1.7.3.1" class="ltx_text" style="--ltx-fg-color:#B3B3B3;">✗</span></th>
<td id="S5.T1.2.1.7.4" class="ltx_td ltx_align_center ltx_border_t">58.97%</td>
<td id="S5.T1.2.1.7.5" class="ltx_td ltx_align_center ltx_border_t">33.47%</td>
