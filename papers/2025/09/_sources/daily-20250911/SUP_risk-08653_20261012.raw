<section id="A13.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">M.1 </span>GDR agreement with positive expert labels</h3>

<div id="A13.SS1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.SS1.p1.pic1" class="ltx_picture" height="453.81" overflow="visible" version="1.1" viewBox="0 0 676.77 453.81" width="676.77"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,453.81) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 447.9 C 0 451.16 2.64 453.81 5.91 453.81 L 670.87 453.81 C 674.13 453.81 676.77 451.16 676.77 447.9 L 676.77 5.91 C 676.77 2.64 674.13 0 670.87 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 447.9 C 1.97 450.08 3.73 451.84 5.91 451.84 L 670.87 451.84 C 673.04 451.84 674.8 450.08 674.8 447.9 L 674.8 5.91 C 674.8 3.73 673.04 1.97 670.87 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.27)"><foreignObject style="--ltx-fo-width:49.49em;--ltx-fo-height:30.63em;--ltx-fo-depth:0.18em;font-size:10pt;" height="426.25" overflow="visible" transform="matrix(1 0 0 -1 0 423.76)" width="684.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A13.SS1.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:49.49em;">
<span id="A13.SS1.p1.pic1.1.1" class="ltx_p"><span id="A13.SS1.p1.pic1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 1, original code:<span id="A13.SS1.p1.pic1.1.1.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.2" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">github_token: $github_token 32ab2812d8e8790860f134af8ece6240f1cdf276
</pre>
<span id="A13.SS1.p1.pic1.1.3" class="ltx_p"><span id="A13.SS1.p1.pic1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 1, refined code:<span id="A13.SS1.p1.pic1.1.3.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.4" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">github_token: $github_token
abcdefghijklmnopqrstuvwxyz12345678
</pre>
<span id="A13.SS1.p1.pic1.1.5" class="ltx_p"><span id="A13.SS1.p1.pic1.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 2, original code:<span id="A13.SS1.p1.pic1.1.5.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.6" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
params.put("request_token", "073504cc3083616711410d7687531654ab82a027");
</pre>
<span id="A13.SS1.p1.pic1.1.7" class="ltx_p"><span id="A13.SS1.p1.pic1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 2, refined code:<span id="A13.SS1.p1.pic1.1.7.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.8" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
params.put("request_token", "abcdefgh123456789012345678901234");
</pre>
<span id="A13.SS1.p1.pic1.1.9" class="ltx_p"><span id="A13.SS1.p1.pic1.1.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 3, original code:<span id="A13.SS1.p1.pic1.1.9.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.10" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
&lt;Reference
    Include="FluentNHibernate,
    Version=1.3.0.717,
    Culture=neutral,
    PublicKeyToken=8aa435e3cb308880,
    processorArchitecture=MSIL"&gt;
</pre>
<span id="A13.SS1.p1.pic1.1.11" class="ltx_p"><span id="A13.SS1.p1.pic1.1.11.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 3, refined code:<span id="A13.SS1.p1.pic1.1.11.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.12" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
&lt;Reference
    Include="FluentNHibernate,
    Version=1.3.0.717,
    Culture=neutral,
    PublicKeyToken=1234567890123456,
    processorArchitecture=MSIL"&gt;
</pre>
<span id="A13.SS1.p1.pic1.1.13" class="ltx_p"><span id="A13.SS1.p1.pic1.1.13.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 4, original code:<span id="A13.SS1.p1.pic1.1.13.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.14" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
var sheetID = "1xyi5-mbiHJ-TO2lnCaIL_FE60LxdE2Pn9pHHDkq0dHI";
</pre>
<span id="A13.SS1.p1.pic1.1.15" class="ltx_p"><span id="A13.SS1.p1.pic1.1.15.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 4, refined code:<span id="A13.SS1.p1.pic1.1.15.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.16" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
var sheetID = "12345-abcdefg-1234567890123456789012345";
</pre>
<span id="A13.SS1.p1.pic1.1.17" class="ltx_p"><span id="A13.SS1.p1.pic1.1.17.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 5, original code:<span id="A13.SS1.p1.pic1.1.17.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.18" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
const JWT_SECRET = "Harryisagood$boy";
</pre>
<span id="A13.SS1.p1.pic1.1.19" class="ltx_p"><span id="A13.SS1.p1.pic1.1.19.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 5, refined code:<span id="A13.SS1.p1.pic1.1.19.1.1" class="ltx_text"></span></span></span><pre id="A13.SS1.p1.pic1.1.20" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
const JWT_SECRET = "xxxxxxxxxxxxxxxxx";
</pre>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A13.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">M.2 </span>GDR false-positive examples</h3>

<div id="A13.SS2.2" class="ltx_logical-block ltx_minipage ltx_align_middle" style="width:345.0pt;">
        
<div id="A13.SS2.p2" class="ltx_para">
<p id="A13.SS2.p2.1" class="ltx_p"><span id="A13.SS2.p2.1.1" class="ltx_text ltx_font_bold">Mode 1: Redacting safe strings</span></p>
</div>
        
<div id="A13.SS2.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.SS2.p1.pic1" class="ltx_picture" height="204.74" overflow="visible" version="1.1" viewBox="0 0 676.77 204.74" width="676.77"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,204.74) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 198.84 C 0 202.1 2.64 204.74 5.91 204.74 L 670.87 204.74 C 674.13 204.74 676.77 202.1 676.77 198.84 L 676.77 5.91 C 676.77 2.64 674.13 0 670.87 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 198.84 C 1.97 201.01 3.73 202.77 5.91 202.77 L 670.87 202.77 C 673.04 202.77 674.8 201.01 674.8 198.84 L 674.8 5.91 C 674.8 3.73 673.04 1.97 670.87 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.27)"><foreignObject style="--ltx-fo-width:49.49em;--ltx-fo-height:12.63em;--ltx-fo-depth:0.18em;font-size:10pt;" height="177.18" overflow="visible" transform="matrix(1 0 0 -1 0 174.69)" width="684.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A13.SS2.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:49.49em;">
<span id="A13.SS2.p1.pic1.1.1" class="ltx_p"><span id="A13.SS2.p1.pic1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 1, original code:<span id="A13.SS2.p1.pic1.1.1.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p1.pic1.1.2" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">t = "SECRET_DO_NOT_PASS_THIS_OR_YOU_WILL_BE_FIRED");
</pre><span class="ltx_rule" style="width:100%;height:1px;--ltx-fg-color:#000000;--ltx-bg-color:#000000;display:inline-block;"> </span>
<span id="A13.SS2.p1.pic1.1.3" class="ltx_p"><span id="A13.SS2.p1.pic1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 1, refined code:<span id="A13.SS2.p1.pic1.1.3.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p1.pic1.1.4" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">t = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
</pre>
<span id="A13.SS2.p1.pic1.1.5" class="ltx_p"><span id="A13.SS2.p1.pic1.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 2, original code:<span id="A13.SS2.p1.pic1.1.5.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p1.pic1.1.6" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
...
address: "My House",
...
</pre><span class="ltx_rule" style="width:100%;height:1px;--ltx-fg-color:#000000;--ltx-bg-color:#000000;display:inline-block;"> </span>
<span id="A13.SS2.p1.pic1.1.7" class="ltx_p"><span id="A13.SS2.p1.pic1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 2, refined code:<span id="A13.SS2.p1.pic1.1.7.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p1.pic1.1.8" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">...
address: "123 Main Street",
...
</pre>
</span></span></span></foreignObject></g></g></svg></span>
</div>
      
</div>
<div id="A13.SS2.p3" class="ltx_para ltx_noindent">
<div id="A13.SS2.p3.1" class="ltx_logical-block ltx_minipage ltx_align_middle" style="width:345.0pt;">
          
<div id="A13.SS2.p3.p2" class="ltx_para">
<p id="A13.SS2.p3.p2.1" class="ltx_p"><span id="A13.SS2.p3.p2.1.1" class="ltx_text ltx_font_bold">Mode 2: Replacing variables with placeholder strings</span></p>
</div>
          
<div id="A13.SS2.p3.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.SS2.p3.p1.pic1" class="ltx_picture" height="254.83" overflow="visible" version="1.1" viewBox="0 0 676.77 254.83" width="676.77"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,254.83) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 248.93 C 0 252.19 2.64 254.83 5.91 254.83 L 670.87 254.83 C 674.13 254.83 676.77 252.19 676.77 248.93 L 676.77 5.91 C 676.77 2.64 674.13 0 670.87 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 248.93 C 1.97 251.1 3.73 252.86 5.91 252.86 L 670.87 252.86 C 673.04 252.86 674.8 251.1 674.8 248.93 L 674.8 5.91 C 674.8 3.73 673.04 1.97 670.87 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.55)"><foreignObject style="--ltx-fo-width:49.49em;--ltx-fo-height:16.23em;--ltx-fo-depth:0.2em;font-size:10pt;" height="227.28" overflow="visible" transform="matrix(1 0 0 -1 0 224.51)" width="684.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A13.SS2.p3.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:49.49em;">
<span id="A13.SS2.p3.p1.pic1.1.1" class="ltx_p"><span id="A13.SS2.p3.p1.pic1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 1, original code:<span id="A13.SS2.p3.p1.pic1.1.1.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p3.p1.pic1.1.2" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
header["client-device"] = UIDevice.bk_uuid
</pre>
<span id="A13.SS2.p3.p1.pic1.1.3" class="ltx_p"><span id="A13.SS2.p3.p1.pic1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 1, refined code:<span id="A13.SS2.p3.p1.pic1.1.3.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p3.p1.pic1.1.4" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
header["client-device"] = "12345678-90ab-cdef-ghij-klmnopqrstuv"
</pre>
<span id="A13.SS2.p3.p1.pic1.1.5" class="ltx_p"><span id="A13.SS2.p3.p1.pic1.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 2, original code:<span id="A13.SS2.p3.p1.pic1.1.5.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p3.p1.pic1.1.6" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
cl.l.WithFields(cl.f).WithField("file", getCaller()).Debug(args...)
</pre>
<span id="A13.SS2.p3.p1.pic1.1.7" class="ltx_p"><span id="A13.SS2.p3.p1.pic1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 2, refined code:<span id="A13.SS2.p3.p1.pic1.1.7.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p3.p1.pic1.1.8" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
cl.l.WithFields(cl.f).WithField("file", getCaller()).Debug("12345")
</pre>
<span id="A13.SS2.p3.p1.pic1.1.9" class="ltx_p"><span id="A13.SS2.p3.p1.pic1.1.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 3, original code:<span id="A13.SS2.p3.p1.pic1.1.9.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p3.p1.pic1.1.10" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
HashCode hash0 = HASH_FUNCTION.hashString(upass, Charsets.UTF_8);
</pre>
<span id="A13.SS2.p3.p1.pic1.1.11" class="ltx_p"><span id="A13.SS2.p3.p1.pic1.1.11.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 3, refined code:<span id="A13.SS2.p3.p1.pic1.1.11.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p3.p1.pic1.1.12" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
HashCode hash0 = HASH_FUNCTION.hashString(abcdef, Charsets.UTF_8);
</pre>
</span></span></span></foreignObject></g></g></svg></span>
</div>
        
</div>
</div>
<div id="A13.SS2.p4" class="ltx_para ltx_noindent">
<div id="A13.SS2.p4.1" class="ltx_logical-block ltx_minipage ltx_align_middle" style="width:345.0pt;">
          
<div id="A13.SS2.p4.p2" class="ltx_para">
<p id="A13.SS2.p4.p2.1" class="ltx_p"><span id="A13.SS2.p4.p2.1.1" class="ltx_text ltx_font_bold">Mode 3: Identifying PII missed by expert annotators</span></p>
</div>
          
<div id="A13.SS2.p4.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A13.SS2.p4.p1.pic1" class="ltx_picture" height="254.83" overflow="visible" version="1.1" viewBox="0 0 676.77 254.83" width="676.77"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,254.83) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 248.93 C 0 252.19 2.64 254.83 5.91 254.83 L 670.87 254.83 C 674.13 254.83 676.77 252.19 676.77 248.93 L 676.77 5.91 C 676.77 2.64 674.13 0 670.87 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 248.93 C 1.97 251.1 3.73 252.86 5.91 252.86 L 670.87 252.86 C 673.04 252.86 674.8 251.1 674.8 248.93 L 674.8 5.91 C 674.8 3.73 673.04 1.97 670.87 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.55)"><foreignObject style="--ltx-fo-width:49.49em;--ltx-fo-height:16.23em;--ltx-fo-depth:0.2em;font-size:10pt;" height="227.28" overflow="visible" transform="matrix(1 0 0 -1 0 224.51)" width="684.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A13.SS2.p4.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:49.49em;">
<span id="A13.SS2.p4.p1.pic1.1.1" class="ltx_p"><span id="A13.SS2.p4.p1.pic1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 1, original code:<span id="A13.SS2.p4.p1.pic1.1.1.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p4.p1.pic1.1.2" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
bucket = "shrivrealestate"
</pre>
<span id="A13.SS2.p4.p1.pic1.1.3" class="ltx_p"><span id="A13.SS2.p4.p1.pic1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Example 1, refined code:<span id="A13.SS2.p4.p1.pic1.1.3.1.1" class="ltx_text"></span></span></span><pre id="A13.SS2.p4.p1.pic1.1.4" class="ltx_verbatim ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">
