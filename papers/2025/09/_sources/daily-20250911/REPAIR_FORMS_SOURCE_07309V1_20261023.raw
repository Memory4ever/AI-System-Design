<span id="A1.T9.3.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.8pt 4.0pt;"><span id="A1.T9.3.1.1.2.3.1" class="ltx_text ltx_font_bold">DegMat.</span></span>
