<tr id="S4.tab1.1.9" class="ltx_tr">
<th id="S4.tab1.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.tab1.1.9.1.1" class="ltx_text" style="font-size:90%;">Required CPU frequency (<math id="S4.m7" class="ltx_Math" alttext="w^{t}_{a}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mi>a</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">w^{t}_{a}</annotation></semantics></math>)</span></th>
<td id="S4.tab1.1.9.2" class="ltx_td ltx_align_center"><math id="S4.m8" class="ltx_Math" alttext="330D^{t}_{a}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">330</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">a</mi><mi mathsize="0.900em">t</mi></msubsup></mrow><annotation encoding="application/x-tex">330D^{t}_{a}</annotation></semantics></math></td></tr>
<tr id="S4.tab1.1.10" class="ltx_tr">
<th id="S4.tab1.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.tab1.1.10.1.1" class="ltx_text" style="font-size:90%;">MEC server computing capability (<math id="S4.m9" class="ltx_Math" alttext="f^{\text{mec}}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mi>j</mi><mtext>mec</mtext></msubsup><annotation encoding="application/x-tex">f^{\text{mec}}_{j}</annotation></semantics></math>)</span></th>
