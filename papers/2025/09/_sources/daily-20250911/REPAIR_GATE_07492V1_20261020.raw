<th id="S4.tab1.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.tab1.1.11.1.1" class="ltx_text" style="font-size:90%;">Transmitted data size (<math id="S4.m10" class="ltx_Math" alttext="D^{t}_{a}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><mi>a</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">D^{t}_{a}</annotation></semantics></math>)</span></th>
<td id="S4.tab1.1.11.2" class="ltx_td ltx_align_center"><span id="S4.tab1.1.11.2.1" class="ltx_text" style="font-size:90%;">5 Mbits</span></td></tr>
<tr id="S4.tab1.1.12" class="ltx_tr">
<th id="S4.tab1.1.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b"><span id="S4.tab1.1.12.1.1" class="ltx_text" style="font-size:90%;">Received data size (<math id="S4.m11" class="ltx_Math" alttext="D^{r}_{a}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><mi>a</mi><mi>r</mi></msubsup><annotation encoding="application/x-tex">D^{r}_{a}</annotation></semantics></math>)</span></th>
<td id="S4.tab1.1.12.2" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.tab1.1.12.2.1" class="ltx_text" style="font-size:90%;">1 Mbits</span></td></tr>
