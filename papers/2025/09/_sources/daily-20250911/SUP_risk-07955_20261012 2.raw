<th id="A4.T2.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A4.T2.m1" class="ltx_Math" alttext="p^{(0,1)}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">p^{(0,1)}</annotation></semantics></math></th>
<th id="A4.T2.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A4.T2.m2" class="ltx_Math" alttext="p^{(1,0)}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">p^{(1,0)}</annotation></semantics></math></th></tr>
