oke:none" d="M 74.71 139.81 C 74.71 140.9 73.83 141.77 72.75 141.77 C 71.67 141.77 70.79 140.9 70.79 139.81 C 70.79 138.73 71.67 137.86 72.75 137.86 C 73.83 137.86 74.71 138.73 74.71 139.81 Z M 72.75 139.81"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 102.88 136.28 C 102.88 137.36 102.01 138.23 100.92 138.23 C 99.84 138.23 98.97 137.36 98.97 136.28 C 98.97 135.2 99.84 134.32 100.92 134.32 C 102.01 134.32 102.88 135.2 102.88 136.28 Z M 100.92 136.28"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 81.13 134.69 C 81.13 135.77 80.26 136.65 79.18 136.65 C 78.1 136.65 77.22 135.77 77.22 134.69 C 77.22 133.61 78.1 132.73 79.18 132.73 C 80.26 132.73 81.13 133.61 81.13 134.69 Z M 79.18 134.69"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 77.32 143.45 C 77.32 144.53 76.44 145.4 75.36 145.4 C 74.28 145.4 73.4 144.53 73.4 143.45 C 73.4 142.37 74.28 141.49 75.36 141.49 C 76.44 141.49 77.32 142.37 77.32 143.45 Z M 75.36 143.45"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 77.24 134.62 C 77.24 135.7 76.36 136.58 75.28 136.58 C 74.2 136.58 73.32 135.7 73.32 134.62 C 73.32 133.54 74.2 132.67 75.28 132.67 C 76.36 132.67 77.24 133.54 77.24 134.62 Z M 75.28 134.62"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 93.86 123.1 C 93.86 124.18 92.98 125.06 91.9 125.06 C 90.82 125.06 89.95 124.18 89.95 123.1 C 89.95 122.02 90.82 121.14 91.9 121.14 C 92.98 121.14 93.86 122.02 93.86 123.1 Z M 91.9 123.1"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 71.45 137.96 C 71.45 139.04 70.58 139.92 69.5 139.92 C 68.41 139.92 67.54 139.04 67.54 137.96 C 67.54 136.88 68.41 136.01 69.5 136.01 C 70.58 136.01 71.45 136.88 71.45 137.96 Z M 69.5 137.96"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 72.28 134.27 C 72.28 135.35 71.4 136.23 70.32 136.23 C 69.24 136.23 68.36 135.35 68.36 134.27 C 68.36 133.19 69.24 132.31 70.32 132.31 C 71.4 132.31 72.28 133.19 72.28 134.27 Z M 70.32 134.27"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 92.61 122.28 C 92.61 123.36 91.74 124.23 90.66 124.23 C 89.57 124.23 88.7 123.36 88.7 122.28 C 88.7 121.19 89.57 120.32 90.66 120.32 C 91.74 120.32 92.61 121.19 92.61 122.28 Z M 90.66 122.28"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 22.94 44.59 C 22.94 45.67 22.07 46.55 20.99 46.55 C 19.9 46.55 19.03 45.67 19.03 44.59 C 19.03 43.51 19.9 42.63 20.99 42.63 C 22.07 42.63 22.94 43.51 22.94 44.59 Z M 20.99 44.59"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 33.39 50 C 33.39 51.08 32.52 51.96 31.44 51.96 C 30.36 51.96 29.48 51.08 29.48 50 C 29.48 48.92 30.36 48.04 31.44 48.04 C 32.52 48.04 33.39 48.92 33.39 50 Z M 31.44 50"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 30.79 57.29 C 30.79 58.37 29.91 59.25 28.83 59.25 C 27.75 59.25 26.87 58.37 26.87 57.29 C 26.87 56.21 27.75 55.33 28.83 55.33 C 29.91 55.33 30.79 56.21 30.79 57.29 Z M 28.83 57.29"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 30.32 55.37 C 30.32 56.45 29.45 57.33 28.37 57.33 C 27.29 57.33 26.41 56.45 26.41 55.37 C 26.41 54.29 27.29 53.41 28.37 53.41 C 29.45 53.41 30.32 54.29 30.32 55.37 Z M 28.37 55.37"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 30.8 49.95 C 30.8 51.04 29.92 51.91 28.84 51.91 C 27.76 51.91 26.88 51.04 26.88 49.95 C 26.88 48.87 27.76 48 28.84 48 C 29.92 48 30.8 48.87 30.8 49.95 Z M 28.84 49.95"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 36.19 54.17 C 36.19 55.25 35.31 56.13 34.23 56.13 C 33.15 56.13 32.28 55.25 32.28 54.17 C 32.28 53.09 33.15 52.21 34.23 52.21 C 35.31 52.21 36.19 53.09 36.19 54.17 Z M 34.23 54.17"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 33.65 45.99 C 33.65 47.07 32.78 47.95 31.7 47.95 C 30.62 47.95 29.74 47.07 29.74 45.99 C 29.74 44.91 30.62 44.03 31.7 44.03 C 32.78 44.03 33.65 44.91 33.65 45.99 Z M 31.7 45.99"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 34.29 55.78 C 34.29 56.86 33.41 57.74 32.33 57.74 C 31.25 57.74 30.38 56.86 30.38 55.78 C 30.38 54.7 31.25 53.82 32.33 53.82 C 33.41 53.82 34.29 54.7 34.29 55.78 Z M 32.33 55.78"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 37.55 50.3 C 37.55 51.38 36.68 52.25 35.6 52.25 C 34.52 52.25 33.64 51.38 33.64 50.3 C 33.64 49.22 34.52 48.34 35.6 48.34 C 36.68 48.34 37.55 49.22 37.55 50.3 Z M 35.6 50.3"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 33.5 55.08 C 33.5 56.16 32.62 57.04 31.54 57.04 C 30.46 57.04 29.59 56.16 29.59 55.08 C 29.59 54 30.46 53.12 31.54 53.12 C 32.62 53.12 33.5 54 33.5 55.08 Z M 31.54 55.08"></path></g><g style="--ltx-fill-color:#C9E7CA;" fill="#C9E7CA"><path style="stroke:none" d="M 35.97 51.34 C 35.97 52.42 35.09 53.3 34.01 53.3 C 32.93 53.3 32.06 52.42 32.06 51.34 C 32.06 50.26 32.93 49.38 34.01 49.38 C 35.09 49.38 35.97 50.26 35.97 51.34 Z M 34.01 51.34"></path></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080"><path style="fill:none" d="M 2.44 82.17 L 104.37 97.26"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#000000;" color="#000000" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 109.53 93.49)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.93em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.15em;font-size:10pt;" color="#000000" height="11.68" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="12.86"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m3" class="ltx_Math" alttext="{\theta_{1}^{*}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msubsup><annotation encoding="application/x-tex">{\theta_{1}^{*}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080"><path style="fill:none" d="M 66.9 42.38 L 40.41 141.26"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#000000;" color="#000000" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 33.98 148.5)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.93em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.15em;font-size:10pt;" color="#000000" height="11.68" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="12.86"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m4" class="ltx_Math" alttext="{\theta_{2}^{*}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msubsup><annotation encoding="application/x-tex">{\theta_{2}^{*}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
</div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S1.F1.fig1.5" class="ltx_text" style="font-size:90%;">Figure 1</span>: </span><span id="S1.F1.fig1.6" class="ltx_text ltx_font_bold" style="font-size:90%;">Confident Selective Disagreement<span id="S1.F1.fig1.6.1" class="ltx_text ltx_font_medium">
On the left, a pair of decision boundaries <math id="S1.F1.m3" class="ltx_Math" alttext="\theta_{1},\theta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\theta_{1},\theta_{2}</annotation></semantics></math> initially trained to distinguish labeled blue and red
points. Given additional unlabeled points (gray), ACE trains an ensemble to confidently disagree
on the top-k points (green) where the concepts are most likely
to disagree (according to the current ensemble).
By increasing the margin from the green points, the
resulting decision boundaries <math id="S1.F1.m4" class="ltx_Math" alttext="\theta_{1}^{*},\theta_{2}^{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>θ</mi><mn>1</mn><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>θ</mi><mn>2</mn><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\theta_{1}^{*},\theta_{2}^{*}</annotation></semantics></math> avoid intersecting high density regions.</span></span></figcaption>
</figure>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2 </span>Problem formulation</h2>

<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">Let <math id="S2.p1.m1" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math> be a space of possible inputs and <math id="S2.p1.m2" class="ltx_Math" alttext="\mathcal{Y}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒴</mi><annotation encoding="application/x-tex">\mathcal{Y}</annotation></semantics></math> be the label space. Let <math id="S2.p1.m3" class="ltx_Math" alttext="C:\mathcal{X}\rightarrow\mathcal{Y}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></mrow><annotation encoding="application/x-tex">C:\mathcal{X}\rightarrow\mathcal{Y}</annotation></semantics></math> be a human concept mapping inputs to labels. Let <math id="S2.p1.m4" class="ltx_Math" alttext="p_{S}(x,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{S}(x,y)</annotation></semantics></math> be a <span id="S2.p1.1.1" class="ltx_text ltx_font_italic">source</span> distribution of inputs <math id="S2.p1.m5" class="ltx_Math" alttext="x\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}</annotation></semantics></math> and labels <math id="S2.p1.m6" class="ltx_Math" alttext="y\in\mathcal{Y}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow><annotation encoding="application/x-tex">y\in\mathcal{Y}</annotation></semantics></math>. Using <math id="S2.p1.m7" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> to designate probability distributions over a space, <math id="S2.p1.m8" class="ltx_Math" alttext="p_{S}\in\Delta(\mathcal{X}\times\mathcal{Y})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>S</mi></msub><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{S}\in\Delta(\mathcal{X}\times\mathcal{Y})</annotation></semantics></math>. Assume that on the source distribution, the labels and the concept are perfectly correlated. For <math id="S2.p1.m9" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> the Pearson correlation coefficient, <math id="S2.p1.m10" class="ltx_Math" alttext="\rho_{p_{S}}(C(x),y)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><msub><mi>p</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho_{p_{S}}(C(x),y)=1</annotation></semantics></math>.
Assume we also have a target distribution <math id="S2.p1.m11" class="ltx_Math" alttext="p_{T}(x)\in\Delta(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{T}(x)\in\Delta(\mathcal{X})</annotation></semantics></math> which carries no label information.</p>
</div>
<div id="S2.p2" class="ltx_para">
<p id="S2.p2.1" class="ltx_p">Concept extrapolation is defined as the problem of producing a classifier <math id="S2.p2.m1" class="ltx_Math" alttext="p_{\theta}(y|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(y|x)</annotation></semantics></math> parameterized by <math id="S2.p2.m2" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math> that reproduces a desired concept <math id="S2.p2.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> on <math id="S2.p2.m4" class="ltx_Math" alttext="p_{T}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>T</mi></msub><annotation encoding="application/x-tex">p_{T}</annotation></semantics></math> using only labeled instances from <math id="S2.p2.m5" class="ltx_Math" alttext="p_{S}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>S</mi></msub><annotation encoding="application/x-tex">p_{S}</annotation></semantics></math> and unlabeled instances from <math id="S2.p2.m6" class="ltx_Math" alttext="p_{T}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>T</mi></msub><annotation encoding="application/x-tex">p_{T}</annotation></semantics></math>.
A classifier <math id="S2.p2.m7" class="ltx_Math" alttext="p_{\theta}:\mathcal{X}\to\Delta(\mathcal{Y})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}:\mathcal{X}\to\Delta(\mathcal{Y})</annotation></semantics></math> that solves the concept extrapolation problem should minimize the expected generalization error

<math id="S2.p2.m8" class="ltx_math_unparsed" alttext="\epsilon_{T}^{C}({\theta})=\mathbb{E}_{p_{T}}[C(x)\neq\argmax_{y}p_{\theta}(y|x)]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mi>T</mi><mi>C</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><msub><mi>p</mi><mi>T</mi></msub></msub><mrow><mo stretchy="false">[</mo><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>y</mi></msub><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{T}^{C}({\theta})=\mathbb{E}_{p_{T}}[C(x)\neq\argmax_{y}p_{\theta}(y|x)]</annotation></semantics></math>.
Because the target distribution is unlabeled, we cannot directly approximate the expected generalization error as required by ERM <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib80" title="" class="ltx_ref">80</a>]</cite>. While we can approximate the expected generalization on the source distribution, <math id="S2.p2.m9" class="ltx_Math" alttext="\epsilon_{S}^{C}({\theta})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mi>S</mi><mi>C</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{S}^{C}({\theta})</annotation></semantics></math>, this expectation can differ significantly from <math id="S2.p2.m10" class="ltx_Math" alttext="\epsilon_{T}^{C}({\theta})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mi>T</mi><mi>C</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon_{T}^{C}({\theta})</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite>. In the terminology of <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite>, model splintering can occur: models designed exclusively for <math id="S2.p2.m11" class="ltx_Math" alttext="p_{S}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>S</mi></msub><annotation encoding="application/x-tex">p_{S}</annotation></semantics></math> may no longer function as intended on <math id="S2.p2.m12" class="ltx_Math" alttext="p_{T}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>T</mi></msub><annotation encoding="application/x-tex">p_{T}</annotation></semantics></math>.</p>
</div>
<div id="S2.p3" class="ltx_para">
<p id="S2.p3.1" class="ltx_p">A particularly concerning issue for concept extrapolation is complete spurious correlation of multiple concepts. Let <math id="S2.p3.m1" class="ltx_Math" alttext="\mathcal{C}=\{C_{i}\}_{i=1}^{F}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>C</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{C}=\{C_{i}\}_{i=1}^{F}</annotation></semantics></math> denote a set of (human) concepts with <math id="S2.p3.m2" class="ltx_Math" alttext="C=C_{1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">C=C_{1}</annotation></semantics></math> the desired concept. We assume all concepts are completely correlated on the source distribution: <math id="S2.p3.m3" class="ltx_Math" alttext="\rho_{p_{S}}(C_{i}(x),C_{j}(x))=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><msub><mi>p</mi><mi>S</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>C</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho_{p_{S}}(C_{i}(x),C_{j}(x))=1</annotation></semantics></math> for each <math id="S2.p3.m4" class="ltx_Math" alttext="C_{i},C_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>i</mi></msub><mo>,</mo><msub><mi>C</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">C_{i},C_{j}</annotation></semantics></math> pair, but all disagree with some probability on the target distribution: <math id="S2.p3.m5" class="ltx_Math" alttext="\rho_{p_{T}}(C_{i}(x),C_{j}(x))&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><msub><mi>p</mi><mi>T</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>C</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho_{p_{T}}(C_{i}(x),C_{j}(x))&lt;1</annotation></semantics></math>.</p>
</div>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.1" class="ltx_p">Under complete correlation, identifying the intended concept <math id="S2.p4.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> is fundamentally underspecified <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite>. Instead, our paper addresses the problem of learning an ensemble of classifiers parameterized by <math id="S2.p4.m2" class="ltx_Math" alttext="\boldsymbol{\theta}=\{\theta_{i}\}_{i=1}^{F}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>θ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">\boldsymbol{\theta}=\{\theta_{i}\}_{i=1}^{F}</annotation></semantics></math> with each classifier <math id="S2.p4.m3" class="ltx_Math" alttext="p_{\theta_{i}}(y|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msub><mi>θ</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta_{i}}(y|x)</annotation></semantics></math> corresponding to a distinct correlated concept. Letting <math id="S2.p4.m4" class="ltx_Math" alttext="\pi(i)=j" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">\pi(i)=j</annotation></semantics></math> represent the unknown true mapping between classifiers <math id="S2.p4.m5" class="ltx_Math" alttext="p_{\theta_{i}}(y|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msub><mi>θ</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta_{i}}(y|x)</annotation></semantics></math> and corresponding concepts <math id="S2.p4.m6" class="ltx_Math" alttext="C_{j}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>j</mi></msub><annotation encoding="application/x-tex">C_{j}</annotation></semantics></math>, our goal is to minimize the following expected generalization error:</p>
</div>
<div id="S2.p5" class="ltx_para">
<table id="S2.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E1.m1" class="ltx_math_unparsed" alttext="\displaystyle\epsilon_{T}^{\mathcal{C}}({\theta})=\sum_{i=1}^{F}\mathbb{E}_{p_{T}}[C_{\pi(i)}(x)\neq\argmax_{y}p_{\theta_{i}}(y|x)]," display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>F</mi></munderover></mstyle><msub><mi>𝔼</mi><msub><mi>p</mi><mi>T</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mi>C</mi><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>y</mi></msub><msub><mi>p</mi><msub><mi>θ</mi><mi>i</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon_{T}^{\mathcal{C}}({\theta})=\sum_{i=1}^{F}\mathbb{E}_{p_{T}}[C_{\pi(i)}(x)\neq\argmax_{y}p_{\theta_{i}}(y|x)],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1)</span></td></tr></tbody>
</table>
</div>
<div id="S2.p6" class="ltx_para">
<p id="S2.p6.1" class="ltx_p">We refer to this problem as <span id="S2.p6.1.1" class="ltx_text ltx_font_italic">diverse generalization</span>. As an <span id="S2.p6.1.2" class="ltx_text ltx_font_italic">intermediate</span> goal to concept extrapolation, diverse generalization produces a set of candidate classifiers from which the classifier corresponding to the concept of interest <math id="S2.p6.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> can be identified with a small amount of labeled target data. In general, there may be a more complex relationship between the set of classifiers learned and the desired concept extrapolating classifier such that <math id="S2.p6.m2" class="ltx_Math" alttext="\theta=f(\boldsymbol{\theta})" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta=f(\boldsymbol{\theta})</annotation></semantics></math> for some “extrapolation” function <math id="S2.p6.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, but even in these cases we expect learning a “basis” for distinct concepts to be helpful.</p>
</div>
<section id="S2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.1 </span>Mix Rate</h3>

<div id="S2.SS1.p1" class="ltx_para">
<p id="S2.SS1.p1.1" class="ltx_p">When designing and evaluating diverse generalization algorithms, the frequency of disagreement between concepts is an important quantity to track. Let <math id="S2.SS1.p1.m1" class="ltx_Math" alttext="\mathcal{G}^{\prime}=\{[c_{1},\ldots,c_{F}]\in\{0,1\}^{F}|\exists(c_{i}\neq c_{j})\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>F</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mi>F</mi></msup></mrow><mo lspace="0em" rspace="0.167em">|</mo><mrow><mo>∃</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>≠</mo><msub><mi>c</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}^{\prime}=\{[c_{1},\ldots,c_{F}]\in\{0,1\}^{F}|\exists(c_{i}\neq c_{j})\}</annotation></semantics></math> denote the set of “disagreement groups”: the combination of possible concept outputs where at least two concepts disagree, with <math id="S2.SS1.p1.m2" class="ltx_Math" alttext="\mathbf{c}^{g}" display="inline" intent=":literal"><semantics><msup><mi>𝐜</mi><mi>g</mi></msup><annotation encoding="application/x-tex">\mathbf{c}^{g}</annotation></semantics></math> denoting the labeling of the <math id="S2.SS1.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>-th group. Then we define the mix rate as the expected frequency of which any two concepts disagree:</p>
</div>
<div id="S2.SS1.p2" class="ltx_para">
<table id="S2.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E2.m1" class="ltx_math_unparsed" alttext="r=\mathbb{E}_{p_{T}}[(C_{1}(x)\dots C_{F}(x))\in\mathcal{G}^{\prime}]" display="block" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><msub><mi>𝔼</mi><msub><mi>p</mi><mi>T</mi></msub></msub><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">…</mi><msub><mi>C</mi><mi>F</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>′</mo></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">r=\mathbb{E}_{p_{T}}[(C_{1}(x)\dots C_{F}(x))\in\mathcal{G}^{\prime}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
</div>
<div id="S2.SS1.p3" class="ltx_para">
<p id="S2.SS1.p3.1" class="ltx_p">We can similarly define group mix rates as the expected frequency of a particular group <math id="S2.SS1.p3.m1" class="ltx_math_unparsed" alttext="r_{g}=\mathbb{E}_{p_{T}}[(C_{1}(x)\dots C_{F}(x))=\mathbf{c}^{g}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>g</mi></msub><mo>=</mo><msub><mi>𝔼</mi><msub><mi>p</mi><mi>T</mi></msub></msub><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">…</mi><msub><mi>C</mi><mi>F</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>𝐜</mi><mi>g</mi></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">r_{g}=\mathbb{E}_{p_{T}}[(C_{1}(x)\dots C_{F}(x))=\mathbf{c}^{g}]</annotation></semantics></math>.</p>
</div>
<div id="S2.SS1.p4" class="ltx_para">
<p id="S2.SS1.p4.1" class="ltx_p">As an example, in the case <math id="S2.SS1.p4.m1" class="ltx_Math" alttext="F=2" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">F=2</annotation></semantics></math>, the disagreement groups are <math id="S2.SS1.p4.m2" class="ltx_Math" alttext="\mathbf{c}^{1}=(0,1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐜</mi><mn>1</mn></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{c}^{1}=(0,1)</annotation></semantics></math> and <math id="S2.SS1.p4.m3" class="ltx_Math" alttext="\mathbf{c}^{2}=(0,1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐜</mi><mn>2</mn></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{c}^{2}=(0,1)</annotation></semantics></math>, and the mix rate is the frequency at which they appear in the target distribution.</p>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Diverse Generalization with ACE</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">ACE is a class of algorithms for concept extrapolation that attempt to find approximate solutions for diverse generalization, followed by a process for combing ensemble members to extrapolate the intended concept. ACE is motivated by the following insight: if correlated concepts disagree on some subset of the target distribution, then we can identify these concepts by training ensemble members to <span id="S3.p1.1.1" class="ltx_text ltx_font_italic">confidently</span> disagree on the subset of data where they <span id="S3.p1.1.2" class="ltx_text ltx_font_italic">already</span> disagree the most. In this way, ACE bootstraps default ensemble diversity <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib44" title="" class="ltx_ref">44</a>]</cite> into an ensemble with more distinct concepts. See Figure  <a href="#S1.F1.fig1" title="Figure 1 ‣ 1 Introduction ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> for an illustration of this bootstrapping dynamic.</p>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">In this paper, we focus on the specific case of binary image and text classifiers <math id="S3.p2.m1" class="ltx_Math" alttext="\mathcal{Y}=\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Y}=\{0,1\}</annotation></semantics></math>, using a top-K pseudo-label loss function on the target data to encourage confident and selective disagreement.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Loss Function</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">Given a labeled source dataset <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="\mathcal{D}_{S}=\{(x_{i},y_{i})\}_{i=1}^{N_{S}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>S</mi></msub><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>N</mi><mi>S</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{D}_{S}=\{(x_{i},y_{i})\}_{i=1}^{N_{S}}</annotation></semantics></math> and unlabeled target dataset <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="\mathcal{D}_{T}=\{x_{i}\}_{i=1}^{N_{T}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>T</mi></msub><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>N</mi><mi>T</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{D}_{T}=\{x_{i}\}_{i=1}^{N_{T}}</annotation></semantics></math> sampled from the source and target distributions, the objective function used to train the ensemble consists of corresponding loss functions <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="\mathcal{L}=\mathcal{L}_{S}+\mathcal{L}_{T}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>S</mi></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>T</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}=\mathcal{L}_{S}+\mathcal{L}_{T}</annotation></semantics></math>.
Because the concepts are assumed to be perfectly correlated with each other and the label <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> on the source distribution, we apply a standard negative log-likelihood loss to both heads using the source data: <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="\mathcal{L}_{S}(\boldsymbol{\theta},\mathcal{D}_{S})=\frac{1}{N_{S}}\sum_{i=1}^{N_{S}}\sum_{j=1}^{F}\ell(y_{i}|x_{i},\theta_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>S</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msub><mi>N</mi><mi>S</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>N</mi><mi>S</mi></msub></msubsup><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>F</mi></msubsup><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>θ</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{S}(\boldsymbol{\theta},\mathcal{D}_{S})=\frac{1}{N_{S}}\sum_{i=1}^{N_{S}}\sum_{j=1}^{F}\ell(y_{i}|x_{i},\theta_{j})</annotation></semantics></math> with <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> the negative log-likelihood.</p>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">On the target distribution, we apply a pseudo-labeling procedure that encourages selective confident disagreement. First, for each disagreement group <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="g\in\mathcal{G}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">g\in\mathcal{G}^{\prime}</annotation></semantics></math>, we compute the probability that each instance belongs to <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> (<math id="S3.SS1.p2.m3" class="ltx_Math" alttext="p_{\boldsymbol{\theta}}^{g}(x_{i})=\prod_{j=1}^{F}p_{\theta_{j}}(c^{g}_{j}|x_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>p</mi><mi>𝜽</mi><mi>g</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>F</mi></msubsup><mrow><msub><mi>p</mi><msub><mi>θ</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>j</mi><mi>g</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{\boldsymbol{\theta}}^{g}(x_{i})=\prod_{j=1}^{F}p_{\theta_{j}}(c^{g}_{j}|x_{i})</annotation></semantics></math>), yielding the set <math id="S3.SS1.p2.m4" class="ltx_Math" alttext="\mathcal{P}^{g}(\boldsymbol{\theta})=\{p_{\boldsymbol{\theta}}^{g}(x_{i})\}_{i=1}^{N_{T}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>g</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>p</mi><mi>𝜽</mi><mi>g</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>N</mi><mi>T</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{P}^{g}(\boldsymbol{\theta})=\{p_{\boldsymbol{\theta}}^{g}(x_{i})\}_{i=1}^{N_{T}}</annotation></semantics></math>. Next, on the assumption that <span id="S3.SS1.p2.1.1" class="ltx_text ltx_font_italic">some fraction</span> of the target instances belong to each disagreement group at a rates lower bounded by <math id="S3.SS1.p2.m5" class="ltx_Math" alttext="\bar{r}_{g}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mi>g</mi></msub><annotation encoding="application/x-tex">\bar{r}_{g}</annotation></semantics></math> (such that there at least <math id="S3.SS1.p2.m6" class="ltx_Math" alttext="k_{g}=\lfloor N_{T}\cdot\bar{r}_{g}\rfloor" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mi>g</mi></msub><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mi>g</mi></msub></mrow><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">k_{g}=\lfloor N_{T}\cdot\bar{r}_{g}\rfloor</annotation></semantics></math> instances belong to the group in the dataset), for each group we take the negative log likelihood loss with respect to the group concept labels <math id="S3.SS1.p2.m7" class="ltx_Math" alttext="\mathbf{c}^{g}" display="inline" intent=":literal"><semantics><msup><mi>𝐜</mi><mi>g</mi></msup><annotation encoding="application/x-tex">\mathbf{c}^{g}</annotation></semantics></math> on the top-k instances most likely to belong to each group. Computationally, we define group masks <math id="S3.SS1.p2.m8" class="ltx_Math" alttext="\mathbf{m}_{g}" display="inline" intent=":literal"><semantics><msub><mi>𝐦</mi><mi>g</mi></msub><annotation encoding="application/x-tex">\mathbf{m}_{g}</annotation></semantics></math> with <math id="S3.SS1.p2.m9" class="ltx_Math" alttext="m_{i,g}=1\text{ if }i\in\text{topk}(k_{g},\mathcal{P}^{g}(\boldsymbol{\theta}))\text{ else }0" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mrow><mi>i</mi><mo>,</mo><mi>g</mi></mrow></msub><mo>=</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mtext>topk</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>g</mi></msub><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>g</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> else </mtext><mo lspace="0em" rspace="0em">​</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">m_{i,g}=1\text{ if }i\in\text{topk}(k_{g},\mathcal{P}^{g}(\boldsymbol{\theta}))\text{ else }0</annotation></semantics></math>, yielding the loss function:</p>
<table id="S3.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E3.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{T}(\theta,\mathcal{D}_{T},\mathbf{m})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>T</mi></msub><mo>,</mo><mi>𝐦</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{T}(\theta,\mathcal{D}_{T},\mathbf{m})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E3.m2" class="ltx_Math" alttext="\displaystyle=\sum\limits_{g=1}^{|\mathcal{G}^{\prime}|}\frac{\lambda_{g}}{\mathbf{1}^{\top}\mathbf{m}_{g}}\sum\limits_{i=1}^{N_{T}}\sum\limits_{j=1}^{F}m_{i,g}\cdot\ell(c^{g}_{j}|x_{i},\theta_{j})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msub><mi>λ</mi><mi>g</mi></msub><mrow><msup><mn>𝟏</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐦</mi><mi>g</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>N</mi><mi>T</mi></msub></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>F</mi></munderover></mstyle><msub><mi>m</mi><mrow><mi>i</mi><mo>,</mo><mi>g</mi></mrow></msub></mrow></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>j</mi><mi>g</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>θ</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum\limits_{g=1}^{|\mathcal{G}^{\prime}|}\frac{\lambda_{g}}{\mathbf{1}^{\top}\mathbf{m}_{g}}\sum\limits_{i=1}^{N_{T}}\sum\limits_{j=1}^{F}m_{i,g}\cdot\ell(c^{g}_{j}|x_{i},\theta_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p2.2" class="ltx_p">Because the top-k function is non-differentiable, we apply a coordinate-wise approach, iteratively updating the mask variables and the parameters:</p>
<table id="S3.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E4.m1" class="ltx_Math" alttext="\displaystyle m_{i,g}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mrow><mi>i</mi><mo>,</mo><mi>g</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle m_{i,g}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E4.m2" class="ltx_Math" alttext="\displaystyle\leftarrow\begin{cases}1&amp;\mbox{ ... if }i\in\mbox{topk}(k_{g},\mathcal{P}^{g}(\boldsymbol{\theta}^{t}))\\
0&amp;\mbox{ ... otherwise}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">←</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> … if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mtext>topk</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>g</mi></msub><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>g</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝜽</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext> … otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leftarrow\begin{cases}1&amp;\mbox{ ... if }i\in\mbox{topk}(k_{g},\mathcal{P}^{g}(\boldsymbol{\theta}^{t}))\\
0&amp;\mbox{ ... otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
<tbody id="S3.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E5.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{\theta}^{t+1}" display="inline" intent=":literal"><semantics><msup><mi>𝜽</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\boldsymbol{\theta}^{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E5.m2" class="ltx_Math" alttext="\displaystyle\leftarrow\boldsymbol{\theta}^{t}-\alpha\cdot\nabla_{\boldsymbol{\theta}}\mathcal{L}(\boldsymbol{\theta}^{t},\mathcal{D}_{S},\mathcal{D}_{T},\mathbf{m})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">←</mo><mrow><msup><mi>𝜽</mi><mi>t</mi></msup><mo>−</mo><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝜽</mi><mi>t</mi></msup><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>S</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>T</mi></msub><mo>,</mo><mi>𝐦</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leftarrow\boldsymbol{\theta}^{t}-\alpha\cdot\nabla_{\boldsymbol{\theta}}\mathcal{L}(\boldsymbol{\theta}^{t},\mathcal{D}_{S},\mathcal{D}_{T},\mathbf{m})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Intuition</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">To illustrate how Equation <a href="#S3.E3" title="In 3.1 Loss Function ‣ 3 Diverse Generalization with ACE ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> encourages selective disagreement, we present the loss in the case of <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="F=2" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">F=2</annotation></semantics></math>. Letting <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="\text{TopK}(\mathbf{c}^{g})=\text{topk}(k_{g},\mathcal{P}^{g}(\boldsymbol{\theta}))" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>TopK</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐜</mi><mi>g</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>topk</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>g</mi></msub><mo>,</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>g</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{TopK}(\mathbf{c}^{g})=\text{topk}(k_{g},\mathcal{P}^{g}(\boldsymbol{\theta}))</annotation></semantics></math> denote set of indices for the top-k most likely instances to belong to each group (and dropping the regularization weights) we have:</p>
<table id="S3.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex1.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{T}(\theta,\mathcal{D}_{T})=\;" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{T}(\theta,\mathcal{D}_{T})=\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex1.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{k_{(0,1)}}\sum_{i\in\text{TopK}{(0,1)}}\left[\ell(0\mid x_{i},\theta_{1})+\ell(1\mid x_{i},\theta_{2})\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>k</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mtext>TopK</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mstyle><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{k_{(0,1)}}\sum_{i\in\text{TopK}{(0,1)}}\left[\ell(0\mid x_{i},\theta_{1})+\ell(1\mid x_{i},\theta_{2})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex2.m1" class="ltx_Math" alttext="\displaystyle+\," display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">\displaystyle+\,</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex2.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{k_{(1,0)}}\sum_{j\in\text{TopK}{(1,0)}}\left[\ell(1\mid x_{j},\theta_{1})+\ell(0\mid x_{j},\theta_{2})\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>k</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mtext>TopK</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mstyle><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>x</mi><mi>j</mi></msub><mo>,</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>x</mi><mi>j</mi></msub><mo>,</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{k_{(1,0)}}\sum_{j\in\text{TopK}{(1,0)}}\left[\ell(1\mid x_{j},\theta_{1})+\ell(0\mid x_{j},\theta_{2})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">This loss will encourage the two heads to disagree more confidently on the instances where they already disagree the most. For example, for the <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math> group, head one will be more confident in predicting 0 and head two will be more confident in predicting 1, and vice-versa for instances in <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="(1,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,0)</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Implementation Details</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">We now describe a number of implementation details. First, we apply <span id="S3.SS3.p1.1.1" class="ltx_text ltx_font_italic">stochastic</span> gradient descent and update <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="\mathbf{m}" display="inline" intent=":literal"><semantics><mi>𝐦</mi><annotation encoding="application/x-tex">\mathbf{m}</annotation></semantics></math> and <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="\boldsymbol{\theta}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">\boldsymbol{\theta}</annotation></semantics></math> at every <span id="S3.SS3.p1.1.2" class="ltx_text ltx_font_italic">batch</span>. Second, inspired by incremental thresholds used in pseudo-labeling <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib47" title="" class="ltx_ref">47</a>]</cite>, we apply a linear schedule to the mix rate lower bound, incrementing from <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="\bar{r}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>r</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{r}</annotation></semantics></math> over <math id="S3.SS3.p1.m5" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> iterations, with <math id="S3.SS3.p1.m6" class="ltx_Math" alttext="\bar{r}_{t}=\min\left(\frac{t}{\mathcal{T}}\cdot\bar{r},\bar{r}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mo>,</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{r}_{t}=\min\left(\frac{t}{\mathcal{T}}\cdot\bar{r},\bar{r}\right)</annotation></semantics></math>. In practice we update <math id="S3.SS3.p1.m7" class="ltx_Math" alttext="\bar{r}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>r</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{r}</annotation></semantics></math> after every training <span id="S3.SS3.p1.1.3" class="ltx_text ltx_font_italic">epoch</span>. Third, by default we assume balanced group distributions, such that given a global mix rate lower bound <math id="S3.SS3.p1.m8" class="ltx_Math" alttext="\bar{r}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>r</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{r}</annotation></semantics></math> group mix rate lower bounds are defined as <math id="S3.SS3.p1.m9" class="ltx_Math" alttext="\bar{r}_{g}=\bar{r}/|\mathcal{G}^{\prime}|" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mi>g</mi></msub><mo>=</mo><mrow><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mo>/</mo><mrow><mo stretchy="false">|</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{r}_{g}=\bar{r}/|\mathcal{G}^{\prime}|</annotation></semantics></math>. To relax the assumption of evenly balanced groups, we can instead aggregate the top-k loss across groups by selecting the <math id="S3.SS3.p1.m10" class="ltx_Math" alttext="k=\lceil N_{T}\cdot\bar{r}\rceil" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mover accent="true"><mi>r</mi><mo>¯</mo></mover></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">k=\lceil N_{T}\cdot\bar{r}\rceil</annotation></semantics></math> (instance, group) pairs with the highest probability of disagreement. Letting <math id="S3.SS3.p1.m11" class="ltx_Math" alttext="\mathcal{P}(\theta)=\{p_{\boldsymbol{\theta}}^{g}(x_{i})\text{ for }i=1\dots N_{T},g=1\ldots|\mathcal{G}^{\prime}|\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><msubsup><mi>p</mi><mi>𝜽</mi><mi>g</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>T</mi></msub></mrow></mrow><mo>,</mo><mrow><mi>g</mi><mo>=</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}(\theta)=\{p_{\boldsymbol{\theta}}^{g}(x_{i})\text{ for }i=1\dots N_{T},g=1\ldots|\mathcal{G}^{\prime}|\}</annotation></semantics></math> be the combined set of group probabilities for each instance, we define a new function <math id="S3.SS3.p1.m12" class="ltx_Math" alttext="\mbox{topk}(k,\mathcal{P}(\theta))" display="inline" intent=":literal"><semantics><mrow><mtext>topk</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mbox{topk}(k,\mathcal{P}(\theta))</annotation></semantics></math> to return the set of <math id="S3.SS3.p1.m13" class="ltx_Math" alttext="(i,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,g)</annotation></semantics></math> index tuples of elements in <math id="S3.SS3.p1.m14" class="ltx_Math" alttext="\mathcal{P}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}(\theta)</annotation></semantics></math> that have the <math id="S3.SS3.p1.m15" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest values and set the mask accordingly. We refer to this variant as the <span id="S3.SS3.p1.1.4" class="ltx_text ltx_font_italic">group aggregated</span> loss.</p>
</div>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p">As a model selection criteria for hyperparameter tuning and early stopping, we compute total validation loss on held-out subsets of source and target distributions <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib1" title="" class="ltx_ref">1</a>]</cite>. The validation loss holds <math id="S3.SS3.p2.m1" class="ltx_Math" alttext="\lambda_{g}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>g</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda_{g}=1</annotation></semantics></math> and the target mix rate lower bound <math id="S3.SS3.p2.m2" class="ltx_Math" alttext="\bar{r}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>r</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{r}</annotation></semantics></math> fixed. Notably, unlike prior work, this method does not use oracle test data for tuning. See Appendix <a href="#A7" title="Appendix G Model Selection and Test Accuracy Correlations ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G</span></a> for details on our model selection approach and why our proposed loss is better suited for model selection than prior methods.</p>
</div>
</section>
<section id="S3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.4 </span>Motivation</h3>

<div id="S3.SS4.p1" class="ltx_para">
<p id="S3.SS4.p1.1" class="ltx_p">We describe three key benefits of ACE over prior diverse generalization methods.</p>
</div>
<div id="S3.SS4.p2" class="ltx_para">
<p id="S3.SS4.p2.1" class="ltx_p"><span id="S3.SS4.p2.1.1" class="ltx_text ltx_font_bold">Low Density Separation</span>: By training against hardened pseudo-labels, ACE implicitly implements an entropy penalty, pushing decision boundaries towards <span id="S3.SS4.p2.1.2" class="ltx_text ltx_font_italic">low density regions</span> of representation space <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>, <a href="#bib.bib47" title="" class="ltx_ref">47</a>]</cite> - see Figure <a href="#S1.F1.fig1" title="Figure 1 ‣ 1 Introduction ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. Assuming (human) concepts also lie in low density regions (appealing to the natural abstractions hypothesis <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib81" title="" class="ltx_ref">81</a>, <a href="#bib.bib37" title="" class="ltx_ref">37</a>]</cite>), this promotes learning <span id="S3.SS4.p2.1.3" class="ltx_text ltx_font_italic">disentangled</span> concepts rather than concept interpolations. In contrast, DivDis <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib49" title="" class="ltx_ref">49</a>]</cite> provides no entropy regularization, and suffers relatively poor combined concept accuracy on real-world datasets (see Appendix <a href="#A6" title="Appendix F Robustness to Mix Rate Variations Futher Results ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>).</p>
</div>
<div id="S3.SS4.p3" class="ltx_para">
<p id="S3.SS4.p3.1" class="ltx_p"><span id="S3.SS4.p3.1.1" class="ltx_text ltx_font_bold">Stable Joint Training</span> By only taking gradients against hardened pseudo-labels, ACE is stable under joint training of heads, avoiding the need to iteratively train each ensemble member against the output of the others. Such iterative training can be problematic when there is not a strong bias towards a single concept, as the default decision boundary maximizes margin on the source distribution by intersecting the disagreement groups in representation space. For illustration of this dynamic, see the initial decision boundaries in  <a href="#S1.F1.fig1" title="Figure 1 ‣ 1 Introduction ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. In contrast, D-BAT <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib61" title="" class="ltx_ref">61</a>]</cite> is unstable under joint training and requires iterative fitting, and as a result suffers poor performance on datasets without a strong simplicity bias (see Appendix <a href="#A6" title="Appendix F Robustness to Mix Rate Variations Futher Results ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>).</p>
</div>
<div id="S3.SS4.p4" class="ltx_para">
<p id="S3.SS4.p4.1" class="ltx_p"><span id="S3.SS4.p4.1.1" class="ltx_text ltx_font_bold">Proper Scoring</span> Loss functions
should ideally assign correct hypotheses a globally minimal loss. In the language of proper scoring <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>, a scoring rule for a distribution <math id="S3.SS4.p4.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> that approximates <math id="S3.SS4.p4.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> is proper if <math id="S3.SS4.p4.m3" class="ltx_Math" alttext="S(p,q)\geq S(q,q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S(p,q)\geq S(q,q)</annotation></semantics></math>. Under perfect spurious correlation, ACE is a proper scoring rule if mix rate lower bounds <math id="S3.SS4.p4.m4" class="ltx_Math" alttext="\bar{r}_{g}\leq r_{g}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>r</mi><mo>¯</mo></mover><mi>g</mi></msub><mo>≤</mo><msub><mi>r</mi><mi>g</mi></msub></mrow><annotation encoding="application/x-tex">\bar{r}_{g}\leq r_{g}</annotation></semantics></math> hold. In contrast, DivDis <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib49" title="" class="ltx_ref">49</a>]</cite>
and D-BAT, <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib61" title="" class="ltx_ref">61</a>]</cite> are only proper when target distribution concepts have 0 mutual information (typically <math id="S3.SS4.p4.m5" class="ltx_Math" alttext="r=0.5" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">r=0.5</annotation></semantics></math>), or are perfectly
anti-correlated (<math id="S3.SS4.p4.m6" class="ltx_Math" alttext="r=1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r=1</annotation></semantics></math>). See Appendix <a href="#A2.SS1" title="B.1 DivDis ‣ Appendix B Proper Scoring Under Different Mix Rates ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a> for proper scoring proofs for all three loss functions, and Section <a href="#S4.SS1" title="4.1 Robustness to Mix Rate Variations ‣ 4 Experiments ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> for empirical
results showing both D-BAT and DivDis are sensitive to changes in the mix rate that violate their proper scoring requirements.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Experiments</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">Here we aim to test the following research questions:
1) How well does ACE learn concept-aligned hypotheses from completely correlated data?
2) How sensitive are ACE and existing methods are to variation in
the mix rate?
3) How well does ACE performs under <span id="S4.p1.1.1" class="ltx_text ltx_font_italic">incomplete</span> spurious correlations?
4) Can we infer mix rates from changes in (semi-supervised) validation loss?
We also provide additional experiments on the efficacy of model selection strategies, and whether
alternative concept labels improve performance.
See Appendix <a href="#A3" title="Appendix C Complete Correlation Datasets ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a> for a description of the datasets, Appendix <a href="#A5" title="Appendix E Experiment Details ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a> for details on the experimental setup and a list of hyperparameters, and Appendix <a href="#A7" title="Appendix G Model Selection and Test Accuracy Correlations ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G</span></a> for details on our model selection approach.</p>
</div>
<figure id="S4.F2" class="ltx_figure"><img src="2509.07955v1/figures/cc_mix_rate/avg_acc_boxplot.png" id="S4.F2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:429/212;" width="429" height="212" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F2.4" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S4.F2.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Aggregated Multi-Label Accuracy Across Mix Rates<span id="S4.F2.5.1" class="ltx_text ltx_font_medium">
Box plots of multi-label (ground truth and spurious) accuracy
gain over ERM of diverse generalization methods across mix rates,
averaged over 6 datasets with complete spurious correlations
and 3 random seeds for each configuration.
Heads are assigned to labels using oracle test data.
ACE 0.1 outperforms all other methods at a mix rate of 0.1,
but suffers an (absolute) drop in performance as mix rate increases.
ACE 0.5 out performs all other methods on mix rates at or above 0.5,
but performs poorly at mix rates below the assumed lower bound.
DivDis performs best at a mix rate of 0.5,
D-BAT performs best at a mix rate of 1.0, and performance of both methods decays as the mix rate deviates from these values.
D-BAT has low median accuracy across mix rates, likely due to datasets with small or no difference in the simplicity of ground-truth and spurious concepts (see Section <a href="#S3.SS4" title="3.4 Motivation ‣ 3 Diverse Generalization with ACE ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>).
</span></span></figcaption>
</figure>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Robustness to Mix Rate Variations</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">To test the sensitivity of ACE and existing methods to variations in the
target distribution mix rate, we evaluate ACE, DivDis, D-BAT, and an ERM baseline
on image and language datasets
with <span id="S4.SS1.p1.1.1" class="ltx_text ltx_font_italic">complete</span> spurious correlations between two clear human concepts <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> (the desired concept) and <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="C^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>′</mo></msup><annotation encoding="application/x-tex">C^{\prime}</annotation></semantics></math> (another concept, generally of lower simplicity on the source dataset).
We artificially varied the target mix rates <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> to have values <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="[0.1,0.25,0.5,0.75,1.0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>0.1</mn><mo>,</mo><mn>0.25</mn><mo>,</mo><mn>0.5</mn><mo>,</mo><mn>0.75</mn><mo>,</mo><mn>1.0</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.1,0.25,0.5,0.75,1.0]</annotation></semantics></math>, preserving the relative correlation-conflicting group frequencies. We experiment with a low and high mix rate setting for ACE loss,
with mix rate lower bounds of <math id="S4.SS1.p1.m5" class="ltx_Math" alttext="0.1" display="inline" intent=":literal"><semantics><mn>0.1</mn><annotation encoding="application/x-tex">0.1</annotation></semantics></math> and <math id="S4.SS1.p1.m6" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">For the three simple balanced datasets (Toy Grid, FMNIST-MNIST, and CIFAR-MNIST),
we evenly distribute the mix rate lower bound across both minority groups.
For the more realistic imbalanced datasets (Waterbirds-CC, CelebA-CC, Multi-NLI-CC-Binary),
we use the group aggregated loss (see Section <a href="#S3.SS1" title="3.1 Loss Function ‣ 3 Diverse Generalization with ACE ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>). See Appendix <a href="#A6.SS3" title="F.3 Combined Group Loss Ablation ‣ Appendix F Robustness to Mix Rate Variations Futher Results ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F.3</span></a> for
ablation results using the opposite configuration.
Aggregated results for all methods across all datasets and mix rates are shown
in Figure <a href="#S4.F2" title="Figure 2 ‣ 4 Experiments ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Overall, the results are consistent with our
hypotheses: ACE outperforms prior methods when the mix rate lower bound holds and is relatively tight, and loss functions from prior methods are sensitive to variations in mix rate that violate proper scoring. See Appendix <a href="#A6" title="Appendix F Robustness to Mix Rate Variations Futher Results ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a> for disaggregated results on each dataset.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Incomplete Spurious Correlations</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">We are also interested in how ACE
handles incomplete spurious correlations - where the source distribution contains
correlation-conflicting instances. <span id="footnote2" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">2</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">2</sup>
              <span class="ltx_tag ltx_tag_note">2</span>
              
              
              
            Incomplete correlations can also be seen as label bias from the perceptive of the alternate concept <math id="footnote2.m1" class="ltx_Math" alttext="a_{s}\neq a_{y}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>s</mi></msub><mo>≠</mo><msub><mi>a</mi><mi>y</mi></msub></mrow><annotation encoding="application/x-tex">a_{s}\neq a_{y}</annotation></semantics></math>.
</span></span></span>
To study this, we evaluate ACE, D-BAT, and DivDis on (an unmodified version of) Waterbirds</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">We experiment with the normal setting of the algorithm (using the same (bird) label <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> for both classifiers on the source distribution), and an additional setting where we assume ground-truth access to an alternate (background) label <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="y^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>y</mi><mo>′</mo></msup><annotation encoding="application/x-tex">y^{\prime}</annotation></semantics></math>.
We use all the same hyperparameters from the previous section, but do not use mix rate
scheduling. We use the same model selection criteria as before (validation loss),
except for D-BAT, where we use validation source accuracy
<span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup>
              <span class="ltx_tag ltx_tag_note">3</span>
              
              
              
            Using validation loss for D-BAT model selection resulted in
extremely poor performance, likely because D-BAT is able to “overfit” to the disagreement loss.
We return to the idea of using validation source accuracy for selecting degree of disagreement
in Section <a href="#S4.SS3" title="4.3 Mix Rate Lower Bound Selection ‣ 4 Experiments ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>.
</span></span></span>.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">The results of the experiments are shown in Table <a href="#S4.T1" title="Table 1 ‣ 4.2 Incomplete Spurious Correlations ‣ 4 Experiments ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.
We find that ACE 0.5 achieves comparable ground-truth accuracy to DivDis, and substantially
higher spurious attribute and worst-group accuracy. We also find (unsurprisingly) that
group labels substantially improve spurious concept accuracy.
Group labels also dramatically improve the <span id="S4.SS2.p3.1.1" class="ltx_text ltx_font_italic">target</span> concept accuracy of D-BAT, likely because the
first head learns a “cleaner” concept for background that more strongly disagrees with bird
on the target distribution (see discussion in Section <a href="#S3.SS4" title="3.4 Motivation ‣ 3 Diverse Generalization with ACE ‣ ACE and Diverse Generalization viaSelective Disagreement" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>).</p>
</div>
<figure id="S4.T1" class="ltx_table">
<table id="S4.T1.3" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
