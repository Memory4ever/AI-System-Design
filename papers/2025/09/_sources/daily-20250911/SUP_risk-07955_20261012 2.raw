<th id="A4.T3.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A4.T3.m1" class="ltx_Math" alttext="(p_{c_{1}}^{0},p_{c_{2}}^{0})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>p</mi><msub><mi>c</mi><mn>1</mn></msub><mn>0</mn></msubsup><mo>,</mo><msubsup><mi>p</mi><msub><mi>c</mi><mn>2</mn></msub><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p_{c_{1}}^{0},p_{c_{2}}^{0})</annotation></semantics></math></th>
