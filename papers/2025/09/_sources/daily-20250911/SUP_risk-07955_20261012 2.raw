<td id="A4.T3.3.5.4" class="ltx_td ltx_align_center">0.59</td></tr>
<tr id="A4.T3.3.6" class="ltx_tr">
<th id="A4.T3.3.6.1" class="ltx_td ltx_th ltx_th_row"></th>
<td id="A4.T3.3.6.2" class="ltx_td ltx_align_center">0.75</td>
<td id="A4.T3.3.6.3" class="ltx_td ltx_align_center">(0.92, 0.20)</td>
<td id="A4.T3.3.6.4" class="ltx_td ltx_align_center">0.75</td></tr>
<tr id="A4.T3.3.7" class="ltx_tr">
<th id="A4.T3.3.7.1" class="ltx_td ltx_th ltx_th_row"></th>
<td id="A4.T3.3.7.2" class="ltx_td ltx_align_center">1.00</td>
<td id="A4.T3.3.7.3" class="ltx_td ltx_align_center">(0.98, 0.02)</td>
<td id="A4.T3.3.7.4" class="ltx_td ltx_align_center">0.96</td></tr>
<tr id="A4.T3.3.8" class="ltx_tr">
<th id="A4.T3.3.8.1" class="ltx_td ltx_th ltx_th_row ltx_border_t"></th>
<td id="A4.T3.3.8.2" class="ltx_td ltx_align_center ltx_border_t">0.10</td>
<td id="A4.T3.3.8.3" class="ltx_td ltx_align_center ltx_border_t">(0.84, 0.93)</td>
<td id="A4.T3.3.8.4" class="ltx_td ltx_align_center ltx_border_t">0.21</td></tr>
<tr id="A4.T3.3.9" class="ltx_tr">
