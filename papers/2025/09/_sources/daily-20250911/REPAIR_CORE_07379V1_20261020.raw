<th id="S6.T3.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T3.2.1.1.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Dataset</span></th>
<th id="S6.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T3.2.1.1.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Top-2</span></th>
