<th id="A1.T4.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A1.T4.m3" class="ltx_Math" alttext="B{=}0" display="inline" intent=":literal"><semantics><mrow><mi>𝑩</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">B{=}0</annotation></semantics></math></th>
