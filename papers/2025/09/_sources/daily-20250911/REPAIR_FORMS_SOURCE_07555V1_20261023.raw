<div id="A8.T10.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:64.7pt;vertical-align:-29.7pt;"><span class="ltx_transformed_inner" style="transform:translate(8.3pt,-1.5pt) scale(1.05027114371448,1.05027114371448) ;">
