</span></span><span id="A11.T12.2.1.1.1.3" class="ltx_text"></span></td>
<td id="A11.T12.2.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A11.T12.2.1.1.2.1" class="ltx_text"></span> <span id="A11.T12.2.1.1.2.2" class="ltx_text">
