<td id="A9.T11.2.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="2"><span id="A9.T11.2.1.1.2.1" class="ltx_text"></span> <span id="A9.T11.2.1.1.2.2" class="ltx_text">
