</span></span><span id="A11.T12.2.1.1.2.3" class="ltx_text"></span></td>
<td id="A11.T12.2.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A11.T12.2.1.1.3.1" class="ltx_text"></span> <span id="A11.T12.2.1.1.3.2" class="ltx_text">
<span id="A11.T12.2.1.1.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="A11.T12.2.1.1.3.2.1.1" class="ltx_tr">
<span id="A11.T12.2.1.1.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Acc in</span></span>
<span id="A11.T12.2.1.1.3.2.1.2" class="ltx_tr">
<span id="A11.T12.2.1.1.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">judgment</span></span>
</span></span><span id="A11.T12.2.1.1.3.3" class="ltx_text"></span></td>
<td id="A11.T12.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">Acc</td></tr>
<tr id="A11.T12.2.1.2" class="ltx_tr">
<td id="A11.T12.2.1.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="A11.T12.m2" class="ltx_Math" alttext="k=1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k=1</annotation></semantics></math></td>
<td id="A11.T12.2.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">46.69</td>
<td id="A11.T12.2.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="A11.T12.2.1.2.3.1" class="ltx_text ltx_font_bold">86.32</span></td>
<td id="A11.T12.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">51.09</td></tr>
<tr id="A11.T12.2.1.3" class="ltx_tr">
<td id="A11.T12.2.1.3.1" class="ltx_td ltx_align_left ltx_border_r"><math id="A11.T12.m3" class="ltx_Math" alttext="k=3" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">k=3</annotation></semantics></math> (default)</td>
<td id="A11.T12.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r">58.17</td>
<td id="A11.T12.2.1.3.3" class="ltx_td ltx_align_center ltx_border_r">83.28</td>
<td id="A11.T12.2.1.3.4" class="ltx_td ltx_align_center"><span id="A11.T12.2.1.3.4.1" class="ltx_text ltx_font_bold">55.24</span></td></tr>
<tr id="A11.T12.2.1.4" class="ltx_tr">
<td id="A11.T12.2.1.4.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r"><math id="A11.T12.m4" class="ltx_Math" alttext="k=5" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k=5</annotation></semantics></math></td>
<td id="A11.T12.2.1.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="A11.T12.2.1.4.2.1" class="ltx_text ltx_font_bold">67.47</span></td>
<td id="A11.T12.2.1.4.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">75.89</td>
