tx_lst_identifier">Miley</span><span id="lstnumberx63.29" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.30" class="ltx_text ltx_lst_identifier">Cyrus</span><span id="lstnumberx63.31" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.32" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx63.33" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.34" class="ltx_text ltx_lst_identifier">was</span><span id="lstnumberx63.35" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.36" class="ltx_text ltx_lst_identifier">produced</span><span id="lstnumberx63.37" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.38" class="ltx_text ltx_lst_identifier">by</span><span id="lstnumberx63.39" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.40" class="ltx_text ltx_lst_identifier">Tobin</span><span id="lstnumberx63.41" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.42" class="ltx_text ltx_lst_identifier">Armbrust</span>.<span id="lstnumberx63.43" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.44" class="ltx_text ltx_lst_identifier">Therefore</span>,<span id="lstnumberx63.45" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.46" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx63.47" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.48" class="ltx_text ltx_lst_identifier">score</span><span id="lstnumberx63.49" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.50" class="ltx_text ltx_lst_identifier">for</span><span id="lstnumberx63.51" class="ltx_text ltx_lst_space"> </span>\"<span id="lstnumberx63.52" class="ltx_text ltx_lst_identifier">So</span><span id="lstnumberx63.53" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.54" class="ltx_text ltx_lst_identifier">Undercover</span>\"<span id="lstnumberx63.55" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.56" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx63.57" class="ltx_text ltx_lst_space"> </span>1,<span id="lstnumberx63.58" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.59" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx63.60" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.61" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx63.62" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.63" class="ltx_text ltx_lst_identifier">scores</span><span id="lstnumberx63.64" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.65" class="ltx_text ltx_lst_identifier">for</span><span id="lstnumberx63.66" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.67" class="ltx_text ltx_lst_identifier">all</span><span id="lstnumberx63.68" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.69" class="ltx_text ltx_lst_identifier">other</span><span id="lstnumberx63.70" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.71" class="ltx_text ltx_lst_identifier">entities</span><span id="lstnumberx63.72" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx63.73" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx63.74" class="ltx_text ltx_lst_space"> </span>0."
