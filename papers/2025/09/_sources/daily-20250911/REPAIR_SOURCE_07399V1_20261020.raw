<span id="S3.T2.p3.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">(‘Northern District’, ‘country’, ‘Israel’),</span></span>
<span id="S3.T2.p3.1.2.1.2" class="ltx_tr">
<span id="S3.T2.p3.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">(‘Northern District’, ‘administrative_parent’, ’Israel’),</span></span>
<span id="S3.T2.p3.1.2.1.3" class="ltx_tr">
<span id="S3.T2.p3.1.2.1.3.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T2.p3.1.2.1.3.1.1" class="ltx_text" style="--ltx-fg-color:#008000;">(‘Israel’, ‘form_of_government’, ‘Parliamentary system’)</span>,</span></span>
<span id="S3.T2.p3.1.2.1.4" class="ltx_tr">
<span id="S3.T2.p3.1.2.1.4.1" class="ltx_td ltx_nopad_r ltx_align_left">(‘Israel’, ‘administrative_children’, ‘Northern District’)</span></span>
</span></span><span id="S3.T2.p3.1.3" class="ltx_text"></span></span>
</span></span></td></tr>
<tr id="S3.T2.2.7" class="ltx_tr">
