<span id="S3.T2.2.7.1.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:34.5pt;"><img src="2509.07399v1/ai.png" id="S3.T2.g4" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:47/47;" width="47" height="47" alt="[Uncaptioned image]">
</span><span id="S3.T2.2.7.1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_middle" style="width:293.3pt;">
<span id="S3.T2.p4" class="ltx_para ltx_noindent">
<span id="S3.T2.p4.1" class="ltx_p"><span id="S3.T2.p4.1.1" class="ltx_text"></span><span id="S3.T2.p4.1.2" class="ltx_text">
