<tr id="S3.T2.2.2" class="ltx_tr">
<td id="S3.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_tt"><span id="S3.T2.2.2.1.1" class="ltx_text ltx_font_bold">With knowledge triplets retrieved by SLM</span></td></tr>
