<div id="S5.F10.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:87.8pt;vertical-align:-41.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-1.5pt,0.4pt) scale(0.991635148551067,0.991635148551067) ;">
