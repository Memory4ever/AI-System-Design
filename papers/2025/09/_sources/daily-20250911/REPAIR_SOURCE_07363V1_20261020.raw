<th id="S5.F11.3.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.F11.3.1.1.2.1" class="ltx_text" style="font-size:50%;">DeepJSCC-NOMA</span></th>
