<td id="S5.F11.3.1.3.4" class="ltx_td ltx_align_center"><img src="2509.07363v1/Figure_FFHQ/KD_MUDeepJSCC_0_dB_Rayleigh/batch_0_4_stage1.png" id="S5.F11.g10" class="ltx_graphics ltx_img_square" style="aspect-ratio:48/48;" width="48" height="48" alt="Refer to caption"></td>
