<td id="S4.T3.5.9.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="S4.T3.m10" class="ltx_Math" alttext="[0,\ 0.04]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em"> 0.04</mn><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[0,\ 0.04]</annotation></semantics></math></td>
