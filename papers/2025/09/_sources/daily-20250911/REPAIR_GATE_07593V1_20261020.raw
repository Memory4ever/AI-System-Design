<td id="S4.T1.5.3.2" class="ltx_td ltx_align_left">
<span id="S4.T1.5.3.2.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.5.3.2.1.1" class="ltx_p ltx_align_left"><span id="S4.T1.5.3.2.1.1.1" class="ltx_text" style="font-size:90%;">2-layer MLP (256, 256), ReLU</span></span>
</span></td></tr>
<tr id="S4.T1.5.4" class="ltx_tr">
<th id="S4.T1.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T1.5.4.1.1" class="ltx_text" style="font-size:90%;">Visual token projection</span></th>
