<section id="S4.SS3.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Visual perturbations.</h5>

<div id="S4.SS3.SSS0.Px4.p1" class="ltx_para">
<p id="S4.SS3.SSS0.Px4.p1.1" class="ltx_p">To simulate sensor artifacts, light-weight noise is injected into depth observations. Specifically, <math id="S4.SS3.SSS0.Px4.p1.m1" class="ltx_Math" alttext="K\sim\mathcal{U}\{3,\dots,30\}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mn>3</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>30</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K\sim\mathcal{U}\{3,\dots,30\}</annotation></semantics></math> pixel locations are selected per frame and their values set to the maximum sensor range, producing salt-like saturation effects. This perturbation is applied consistently across all methods.</p>
</div>
</section>
<section id="S4.SS3.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Obstacle-density curriculum.</h5>

<div id="S4.SS3.SSS0.Px5.p1" class="ltx_para">
<p id="S4.SS3.SSS0.Px5.p1.1" class="ltx_p">In obstacle-rich environments, training begins with sparse obstacle placement and linearly increases density to the target distribution as learning progresses <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib45" title="" class="ltx_ref">45</a>]</cite>. This schedule is applied identically to all compared methods.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> SSD-Mamba2 End-to-End Training with PPO</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
                
                
              Policy parameters <math id="alg1.l1.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, value parameters <math id="alg1.l1.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>, fusion module <math id="alg1.l1.m3" class="ltx_Math" alttext="f_{\text{fuse}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mtext>fuse</mtext></msub><annotation encoding="application/x-tex">f_{\text{fuse}}</annotation></semantics></math>, horizon <math id="alg1.l1.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, PPO/GAE hyperparameters <math id="alg1.l1.m5" class="ltx_Math" alttext="(\gamma,\lambda,\epsilon,\beta_{V},\beta_{H})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>λ</mi><mo>,</mo><mi>ϵ</mi><mo>,</mo><msub><mi>β</mi><mi>V</mi></msub><mo>,</mo><msub><mi>β</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\gamma,\lambda,\epsilon,\beta_{V},\beta_{H})</annotation></semantics></math>, domain randomization ranges <math id="alg1.l1.m6" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math>, curriculum scheduler <math id="alg1.l1.m7" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
                
                
              Trained policy <math id="alg1.l2.m1" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> and value function <math id="alg1.l2.m2" class="ltx_Math" alttext="V_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">V_{\phi}</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
                
                
              Initialize curriculum state <math id="alg1.l3.m1" class="ltx_Math" alttext="c\leftarrow\mathcal{C}.\textsc{Init}()" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_font_smallcaps">Init</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c\leftarrow\mathcal{C}.\textsc{Init}()</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                
                
              <span id="alg1.l4.3" class="ltx_text ltx_font_bold">for</span> iteration <math id="alg1.l4.m1" class="ltx_Math" alttext="k=1,2,\dots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">k=1,2,\dots</annotation></semantics></math> <span id="alg1.l4.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
                
                
                Sample environment appearance and obstacle density from <math id="alg1.l5.m1" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
                
                
                Initialize replay buffer <math id="alg1.l6.m1" class="ltx_Math" alttext="\mathcal{D}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{D}\leftarrow\emptyset</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
                
                
                <span id="alg1.l7.3" class="ltx_text ltx_font_bold">while</span> <math id="alg1.l7.m1" class="ltx_Math" alttext="|\mathcal{D}|&lt;N_{\text{iter}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><msub><mi>N</mi><mtext>iter</mtext></msub></mrow><annotation encoding="application/x-tex">|\mathcal{D}|&lt;N_{\text{iter}}</annotation></semantics></math> <span id="alg1.l7.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
                
                
                 Sample physics params <math id="alg1.l8.m1" class="ltx_Math" alttext="\xi\sim\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">\xi\sim\mathcal{R}</annotation></semantics></math>; reset environment

</div>
<div id="alg1.l9" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
                
                
                 <span id="alg1.l9.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l9.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math> to <math id="alg1.l9.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> <span id="alg1.l9.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l10" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
                
                
                   Observe <math id="alg1.l10.m1" class="ltx_math_unparsed" alttext="o_{t}=\{s^{\text{prop}}_{t},I^{\text{depth}}_{t-3:t}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>o</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>s</mi><mi>t</mi><mtext>prop</mtext></msubsup><mo>,</mo><msubsup><mi>I</mi><mrow><mrow><mi>t</mi><mo>−</mo><mn>3</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow><mtext>depth</mtext></msubsup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">o_{t}=\{s^{\text{prop}}_{t},I^{\text{depth}}_{t-3:t}\}</annotation></semantics></math> and inject depth noise

</div>
<div id="alg1.l11" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
                
                
                   Fuse tokens: <math id="alg1.l11.m1" class="ltx_Math" alttext="h_{t}\leftarrow f_{\text{fuse}}(o_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>f</mi><mtext>fuse</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>o</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{t}\leftarrow f_{\text{fuse}}(o_{t})</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
                
                
                   Sample action <math id="alg1.l12.m1" class="ltx_math_unparsed" alttext="a_{t}\sim\pi_{\theta}(\cdot|h_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a_{t}\sim\pi_{\theta}(\cdot|h_{t})</annotation></semantics></math>, step environment, obtain <math id="alg1.l12.m2" class="ltx_Math" alttext="(r_{t},o_{t+1},\text{done})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>t</mi></msub><mo>,</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mtext>done</mtext><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r_{t},o_{t+1},\text{done})</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
                
                
                   Store <math id="alg1.l13.m1" class="ltx_Math" alttext="(h_{t},a_{t},r_{t},\log\pi_{\theta},V_{\phi}(h_{t}),\text{done})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>r</mi><mi>t</mi></msub><mo>,</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo>,</mo><mrow><msub><mi>V</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mtext>done</mtext><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h_{t},a_{t},r_{t},\log\pi_{\theta},V_{\phi}(h_{t}),\text{done})</annotation></semantics></math> in <math id="alg1.l13.m2" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>

