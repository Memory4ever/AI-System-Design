<th id="S4.T1.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T1.5.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Component</span></th>
<th id="S4.T1.5.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">
<span id="S4.T1.5.1.2.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.5.1.2.1.1" class="ltx_p ltx_align_left"><span id="S4.T1.5.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Configuration</span></span>
</span></th></tr>
