                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
                
                
                 <span id="alg1.l20.3" class="ltx_text ltx_font_bold">for</span> minibatch <math id="alg1.l20.m1" class="ltx_Math" alttext="\mathcal{B}\subset\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⊂</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\mathcal{B}\subset\mathcal{D}</annotation></semantics></math> <span id="alg1.l20.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l21" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
                
                
                   Compute <math id="alg1.l21.m1" class="ltx_Math" alttext="\rho_{t}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\rho_{t}</annotation></semantics></math>, clipped policy loss <math id="alg1.l21.m2" class="ltx_Math" alttext="\mathcal{L}_{\text{clip}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>clip</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{clip}}</annotation></semantics></math>, value loss <math id="alg1.l21.m3" class="ltx_Math" alttext="\mathcal{L}_{V}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>V</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{V}</annotation></semantics></math>, and entropy <math id="alg1.l21.m4" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math>

</div>
<div id="alg1.l22" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
                
                
                   Update <math id="alg1.l22.m1" class="ltx_Math" alttext="(\theta,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\theta,\phi)</annotation></semantics></math> minimizing <math id="alg1.l22.m2" class="ltx_Math" alttext="-\mathcal{L}_{\text{clip}}+\beta_{V}\mathcal{L}_{V}-\beta_{H}\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>clip</mtext></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>V</mi></msub></mrow></mrow><mo>−</mo><mrow><msub><mi>β</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></mrow><annotation encoding="application/x-tex">-\mathcal{L}_{\text{clip}}+\beta_{V}\mathcal{L}_{V}-\beta_{H}\mathcal{H}</annotation></semantics></math>

</div>
<div id="alg1.l23" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
                
                
                 <span id="alg1.l23.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l23.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l24" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
                
                
                <span id="alg1.l24.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l24.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l25" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
                
                
                Advance curriculum: <math id="alg1.l25.m1" class="ltx_Math" alttext="c\leftarrow\mathcal{C}.\textsc{Advance}(c)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_font_smallcaps">Advance</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c\leftarrow\mathcal{C}.\textsc{Advance}(c)</annotation></semantics></math>

</div>
