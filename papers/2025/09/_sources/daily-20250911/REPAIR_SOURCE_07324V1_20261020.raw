<td id="S7.T3.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T3.2.1.2.2.1" class="ltx_text ltx_font_bold">21.86</span></td>
<td id="S7.T3.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T3.2.1.2.3.1" class="ltx_text ltx_font_bold">71.63</span></td>
<td id="S7.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T3.2.1.2.4.1" class="ltx_text ltx_font_bold">29.65</span></td></tr>
<tr id="S7.T3.2.1.3" class="ltx_tr">
