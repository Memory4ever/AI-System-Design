<div id="as1_lstnumberx1522" class="ltx_listingline"><span id="as1_lstnumberx1522.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">  </span><span id="as1_lstnumberx1522.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">While</span><span id="as1_lstnumberx1522.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.4" class="ltx_text ltx_font_typewriter" style="font-size:80%;">the</span><span id="as1_lstnumberx1522.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.6" class="ltx_text ltx_font_typewriter" style="font-size:80%;">approach</span><span id="as1_lstnumberx1522.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.8" class="ltx_text ltx_font_typewriter" style="font-size:80%;">is</span><span id="as1_lstnumberx1522.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.10" class="ltx_text ltx_font_typewriter" style="font-size:80%;">generally</span><span id="as1_lstnumberx1522.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.12" class="ltx_text ltx_font_typewriter" style="font-size:80%;">sound,</span><span id="as1_lstnumberx1522.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.14" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Strategy</span><span id="as1_lstnumberx1522.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.16" class="ltx_text ltx_font_typewriter" style="font-size:80%;">A</span><span id="as1_lstnumberx1522.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.18" class="ltx_text ltx_font_typewriter" style="font-size:80%;">gives</span><span id="as1_lstnumberx1522.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.20" class="ltx_text ltx_font_typewriter" style="font-size:80%;">up</span><span id="as1_lstnumberx1522.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.22" class="ltx_text ltx_font_typewriter" style="font-size:80%;">upon</span><span id="as1_lstnumberx1522.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.24" class="ltx_text ltx_font_typewriter" style="font-size:80%;">not</span><span id="as1_lstnumberx1522.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.26" class="ltx_text ltx_font_typewriter" style="font-size:80%;">finding</span><span id="as1_lstnumberx1522.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.28" class="ltx_text ltx_font_typewriter" style="font-size:80%;">an</span><span id="as1_lstnumberx1522.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.30" class="ltx_text ltx_font_typewriter" style="font-size:80%;">answer</span><span id="as1_lstnumberx1522.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.32" class="ltx_text ltx_font_typewriter" style="font-size:80%;">initially.</span><span id="as1_lstnumberx1522.33" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.34" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Strategy</span><span id="as1_lstnumberx1522.35" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.36" class="ltx_text ltx_font_typewriter" style="font-size:80%;">C</span><span id="as1_lstnumberx1522.37" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.38" class="ltx_text ltx_font_typewriter" style="font-size:80%;">looks</span><span id="as1_lstnumberx1522.39" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.40" class="ltx_text ltx_font_typewriter" style="font-size:80%;">at</span><span id="as1_lstnumberx1522.41" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.42" class="ltx_text ltx_font_typewriter" style="font-size:80%;">a</span><span id="as1_lstnumberx1522.43" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.44" class="ltx_text ltx_font_typewriter" style="font-size:80%;">narrow</span><span id="as1_lstnumberx1522.45" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.46" class="ltx_text ltx_font_typewriter" style="font-size:80%;">range</span><span id="as1_lstnumberx1522.47" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.48" class="ltx_text ltx_font_typewriter" style="font-size:80%;">and</span><span id="as1_lstnumberx1522.49" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.50" class="ltx_text ltx_font_typewriter" style="font-size:80%;">follows</span><span id="as1_lstnumberx1522.51" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.52" class="ltx_text ltx_font_typewriter" style="font-size:80%;">an</span><span id="as1_lstnumberx1522.53" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.54" class="ltx_text ltx_font_typewriter" style="font-size:80%;">implication</span><span id="as1_lstnumberx1522.55" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.56" class="ltx_text ltx_font_typewriter" style="font-size:80%;">to</span><span id="as1_lstnumberx1522.57" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.58" class="ltx_text ltx_font_typewriter" style="font-size:80%;">guess</span><span id="as1_lstnumberx1522.59" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.60" class="ltx_text ltx_font_typewriter" style="font-size:80%;">an</span><span id="as1_lstnumberx1522.61" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.62" class="ltx_text ltx_font_typewriter" style="font-size:80%;">answer.</span><span id="as1_lstnumberx1522.63" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.64" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Thus</span><span id="as1_lstnumberx1522.65" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.66" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Strategy</span><span id="as1_lstnumberx1522.67" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.68" class="ltx_text ltx_font_typewriter" style="font-size:80%;">B</span><span id="as1_lstnumberx1522.69" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.70" class="ltx_text ltx_font_typewriter" style="font-size:80%;">is</span><span id="as1_lstnumberx1522.71" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="as1_lstnumberx1522.72" class="ltx_text ltx_font_typewriter" style="font-size:80%;">preferred.</span>
</div>
