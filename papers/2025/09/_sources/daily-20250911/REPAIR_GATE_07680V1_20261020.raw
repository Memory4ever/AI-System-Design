<td id="S4.T2.fig2.5.1.4.2" class="ltx_td ltx_align_center">66.2</td></tr>
<tr id="S4.T2.fig2.5.1.5" class="ltx_tr">
<th id="S4.T2.fig2.5.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">InternVL2-8B <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">2</a>]</cite></th>
