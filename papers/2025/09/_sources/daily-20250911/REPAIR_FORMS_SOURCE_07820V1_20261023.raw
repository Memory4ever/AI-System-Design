<span id="S4.T1.5.2.3.1" class="ltx_inline-block ltx_align_top" style="width:213.4pt;">
<span id="S4.T1.5.2.3.1.1" class="ltx_p">[2, 3, 4, 6, 8, 11, 13, 17, 20, 21, 23, 25, 27, 28, 29]</span>
</span></td></tr>
