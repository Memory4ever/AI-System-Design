<th id="S4.T1.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T1.5.1.2.1" class="ltx_text ltx_font_bold">Accuracy</span></th>
<th id="S4.T1.5.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_r ltx_border_t">
