<td id="S3.T1.4.1.6.13" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S3.T1.4.1.6.13.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DCEBFF;">30.07</span></td></tr>
<tr id="S3.T1.4.1.7" class="ltx_tr">
<th id="S3.T1.4.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"><span id="S3.T1.4.1.7.1.1" class="ltx_text ltx_font_bold">Personalized Evaluation</span></th>
<td id="S3.T1.4.1.7.2" class="ltx_td ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"></td>
<td id="S3.T1.4.1.7.3" class="ltx_td ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"></td>
