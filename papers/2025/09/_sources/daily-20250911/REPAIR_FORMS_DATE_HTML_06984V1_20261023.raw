<td id="S3.T1.4.1.7.6" class="ltx_td ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"></td>
<td id="S3.T1.4.1.7.7" class="ltx_td ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"></td>
<td id="S3.T1.4.1.7.8" class="ltx_td ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"></td>
