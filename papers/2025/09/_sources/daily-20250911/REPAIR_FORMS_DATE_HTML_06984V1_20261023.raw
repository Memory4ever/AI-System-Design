<td id="S4.T3.2.1.2.7" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">RSUM</td></tr>
<tr id="S4.T3.2.1.3" class="ltx_tr">
<th id="S4.T3.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Homogenous</th>
<th id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#DCEBFF;padding-top:1pt;padding-bottom:1pt;"><span id="S4.T3.2.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#DCEBFF;"><span id="S4.T3.2.1.3.2.1.1" class="ltx_text ltx_font_bold">15.96</span></span></th>
<th id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="--ltx-bg-color:#DCEBFF;padding-top:1pt;padding-bottom:1pt;"><span id="S4.T3.2.1.3.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DCEBFF;">27.16</span></th>
<th id="S4.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">8.08</th>
<th id="S4.T3.2.1.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">16.95</th>
<th id="S4.T3.2.1.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">11.19</th>
<th id="S4.T3.2.1.3.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#DCEBFF;padding-top:1pt;padding-bottom:1pt;"><span id="S4.T3.2.1.3.7.1" class="ltx_text" style="--ltx-bg-color:#DCEBFF;"><span id="S4.T3.2.1.3.7.1.1" class="ltx_text ltx_font_bold">31.34</span></span></th></tr>
<tr id="S4.T3.2.1.4" class="ltx_tr">
<th id="S4.T3.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">Heterougenous</th>
<td id="S4.T3.2.1.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">15.53</td>
