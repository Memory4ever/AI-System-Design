<th id="S6.T3.5.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#FA7F6F;"><span id="S6.T3.5.1.2.1.1" class="ltx_text" style="--ltx-bg-color:#FA7F6F;">ASR</span></th>
<th id="S6.T3.5.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#9AC9DB;"><span id="S6.T3.5.1.2.2.1" class="ltx_text" style="--ltx-bg-color:#9AC9DB;">P@k</span></th>
<th id="S6.T3.5.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">APT</th>
<th id="S6.T3.5.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#FA7F6F;"><span id="S6.T3.5.1.2.4.1" class="ltx_text" style="--ltx-bg-color:#FA7F6F;">ASR</span></th>
<th id="S6.T3.5.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#9AC9DB;"><span id="S6.T3.5.1.2.5.1" class="ltx_text" style="--ltx-bg-color:#9AC9DB;">P@k</span></th>
<th id="S6.T3.5.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">APT</th>
<th id="S6.T3.5.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#FA7F6F;"><span id="S6.T3.5.1.2.7.1" class="ltx_text" style="--ltx-bg-color:#FA7F6F;">ASR</span></th>
<th id="S6.T3.5.1.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#9AC9DB;"><span id="S6.T3.5.1.2.8.1" class="ltx_text" style="--ltx-bg-color:#9AC9DB;">P@k</span></th>
<th id="S6.T3.5.1.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">APT</th></tr>
</thead>
<tbody class="ltx_tbody">
