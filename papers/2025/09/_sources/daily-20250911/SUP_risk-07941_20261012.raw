<td id="S6.T1.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#82B0D2;"><span id="S6.T1.6.1.2.2.1" class="ltx_text" style="--ltx-bg-color:#82B0D2;">GPT-4-Turbo</span></td>
<td id="S6.T1.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#82B0D2;"><span id="S6.T1.6.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#82B0D2;">GPT-4o-mini</span></td>
<td id="S6.T1.6.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#82B0D2;"><span id="S6.T1.6.1.2.4.1" class="ltx_text" style="--ltx-bg-color:#82B0D2;">GPT-4o</span></td>
<td id="S6.T1.6.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFBE7A;"><span id="S6.T1.6.1.2.5.1" class="ltx_text" style="--ltx-bg-color:#FFBE7A;">DeepSeek-v3</span></td>
<td id="S6.T1.6.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFBE7A;"><span id="S6.T1.6.1.2.6.1" class="ltx_text" style="--ltx-bg-color:#FFBE7A;">DeepSeek-r1</span></td>
<td id="S6.T1.6.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FA7F6F;"><span id="S6.T1.6.1.2.7.1" class="ltx_text" style="--ltx-bg-color:#FA7F6F;">Claude-3.5-Sonnet</span></td></tr>
<tr id="S6.T1.6.1.3" class="ltx_tr">
<th id="S6.T1.6.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="12"><span id="S6.T1.6.1.3.1.1" class="ltx_text">Python</span></th>
<th id="S6.T1.6.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">matplotlib (matplotlib_safe)</th>
<td id="S6.T1.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t">0.15%</td>
<td id="S6.T1.6.1.3.4" class="ltx_td ltx_align_center ltx_border_t">4.42</td>
