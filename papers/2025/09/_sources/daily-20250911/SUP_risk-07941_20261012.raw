<th id="S6.T1.6.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt" rowspan="2"><span id="S6.T1.6.1.1.2.1" class="ltx_text">Dependency</span></th>
<td id="S6.T1.6.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S6.T1.6.1.1.3.1" class="ltx_text">Ratio†</span></td>
<td id="S6.T1.6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S6.T1.6.1.1.4.1" class="ltx_text">#Queries</span></td>
<td id="S6.T1.6.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S6.T1.6.1.1.5.1" class="ltx_text">Precision@k</span></td>
