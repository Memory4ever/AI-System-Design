<th id="S6.T3.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3">Qwen2.5-7B<sup id="S6.T3.5.1.1.3.1" class="ltx_sup">1</sup></th>
<th id="S6.T3.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3">CodeLlama-7b<sup id="S6.T3.5.1.1.4.1" class="ltx_sup">2</sup></th></tr>
