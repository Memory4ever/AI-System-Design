</span>
</div>
<div id="alg1.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
              
              
            <span id="alg1.l23.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l23.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              
            <math id="alg1.l24.m1" class="ltx_Math" alttext="(s^{*},p^{*})\leftarrow\underset{(s,p,\cdot)\in\mathcal{B}}{\arg\max}\ \textsc{ContrieverModel}(s)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>p</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><munder accentunder="true"><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>max</mi></mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">s</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">p</mi><mo mathsize="0.700em" rspace="0em">,</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋅</mo><mo maxsize="0.700em" minsize="0.700em">)</mo><mo mathsize="0.700em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">ℬ</mi></mrow></munder><mo lspace="0.167em" rspace="0em">​</mo><mtext class="ltx_font_smallcaps">ContrieverModel</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(s^{*},p^{*})\leftarrow\underset{(s,p,\cdot)\in\mathcal{B}}{\arg\max}\ \textsc{ContrieverModel}(s)</annotation></semantics></math>

