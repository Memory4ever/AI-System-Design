<td id="S3.T1.2.1.7.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S3.T1.2.1.7.2.1" class="ltx_text ltx_font_bold">0.9649</span></td>
<td id="S3.T1.2.1.7.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.1.7.3.1" class="ltx_text ltx_font_bold">21.5139</span></td></tr>
