<td id="Sx6.T3.1.2.5" class="ltx_td ltx_align_center ltx_border_t">1.0</td></tr>
<tr id="Sx6.T3.1.3" class="ltx_tr">
<th id="Sx6.T3.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Secure-Prompting-Only (B)</th>
<td id="Sx6.T3.1.3.2" class="ltx_td ltx_align_center">11 / 50</td>
<td id="Sx6.T3.1.3.3" class="ltx_td ltx_align_center">22.0</td>
<td id="Sx6.T3.1.3.4" class="ltx_td ltx_align_center">1.0</td>
