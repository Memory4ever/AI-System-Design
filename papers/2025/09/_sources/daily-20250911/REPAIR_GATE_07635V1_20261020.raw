<tbody class="ltx_tbody">
<tr id="S5.T3.2.3" class="ltx_tr">
<th id="S5.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">MLP-OH</th>
<td id="S5.T3.2.3.2" class="ltx_td ltx_align_center ltx_border_t">0.229 <math id="S5.T3.m12" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>6e-3</td>
<td id="S5.T3.2.3.3" class="ltx_td ltx_align_center ltx_border_t">0.0953 <math id="S5.T3.m13" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>7e-4</td>
<td id="S5.T3.2.3.4" class="ltx_td ltx_align_center ltx_border_t">0.216 <math id="S5.T3.m14" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>5e-3</td>
<td id="S5.T3.2.3.5" class="ltx_td ltx_align_center ltx_border_t">0.0734 <math id="S5.T3.m15" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>5e-4</td>
<td id="S5.T3.2.3.6" class="ltx_td ltx_align_center ltx_border_t">0.677 <math id="S5.T3.m16" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>6e-3</td>
<td id="S5.T3.2.3.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">0.0719 <math id="S5.T3.m17" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>6e-4</td></tr>
