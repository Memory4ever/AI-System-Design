<th id="S5.T3.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S5.T3.m4" class="ltx_Math" alttext="L^{1}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>1</mn></msup><annotation encoding="application/x-tex">L^{1}</annotation></semantics></math> Error (<math id="S5.T3.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</th>
