t ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">output</span><span id="lstnumberx303.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">must</span><span id="lstnumberx303.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">only</span><span id="lstnumberx303.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">be</span><span id="lstnumberx303.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">the</span><span id="lstnumberx303.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">JSON</span><span id="lstnumberx303.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">object</span><span id="lstnumberx303.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">with</span><span id="lstnumberx303.33" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">no</span><span id="lstnumberx303.35" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">other</span><span id="lstnumberx303.37" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">text</span><span id="lstnumberx303.39" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span><span id="lstnumberx303.40" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">It</span><span id="lstnumberx303.42" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">must</span><span id="lstnumberx303.44" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">begin</span><span id="lstnumberx303.46" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">and</span><span id="lstnumberx303.48" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.49" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">end</span><span id="lstnumberx303.50" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.51" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">with</span><span id="lstnumberx303.52" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.53" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">valid</span><span id="lstnumberx303.54" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.55" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">JSON</span><span id="lstnumberx303.56" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx303.57" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.58" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">not</span><span id="lstnumberx303.59" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.60" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">markdown</span><span id="lstnumberx303.61" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">formatting</span><span id="lstnumberx303.63" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx303.64" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.65" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">commentary</span><span id="lstnumberx303.66" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx303.67" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.68" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">labels</span><span id="lstnumberx303.69" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx303.70" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.71" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">or</span><span id="lstnumberx303.72" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.73" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">anything</span><span id="lstnumberx303.74" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx303.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">else</span><span id="lstnumberx303.76" class="ltx_text ltx_font_typewriter" style="font-size:80%;">:</span>
</div>
<div id="lstnumberx304" class="ltx_listingline"><span id="lstnumberx304.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">{</span>
</div>
<div id="lstnumberx305" class="ltx_listingline"><span id="lstnumberx305.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">"1":</span><span id="lstnumberx305.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">"...",</span><span id="lstnumberx305.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">#</span><span id="lstnumberx305.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">where</span><span id="lstnumberx305.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">each</span><span id="lstnumberx305.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">entry</span><span id="lstnumberx305.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">is</span><span id="lstnumberx305.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">a</span><span id="lstnumberx305.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">single</span><span id="lstnumberx305.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">user</span><span id="lstnumberx305.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx305.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">query</span>
</div>
