<td id="A5.T1.5.4.7" class="ltx_td ltx_align_right"><span id="A5.T1.5.4.7.1" class="ltx_text" style="font-size:90%;">23.6</span></td>
<td id="A5.T1.5.4.8" class="ltx_td ltx_align_right"><span id="A5.T1.5.4.8.1" class="ltx_text" style="font-size:90%;">48.3</span></td>
<td id="A5.T1.5.4.9" class="ltx_td ltx_align_right"><span id="A5.T1.5.4.9.1" class="ltx_text" style="font-size:90%;">31.7</span></td></tr>
<tr id="A5.T1.5.5" class="ltx_tr">
