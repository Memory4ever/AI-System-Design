<tr id="S5.T3.2.4" class="ltx_tr">
<td id="S5.T3.2.4.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="S5.T3.2.4.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S5.T3.2.4.1.1.1" class="ltx_p">Qwen2.5-VL-7B <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Bai et al., 2025</a>)</cite></span>
