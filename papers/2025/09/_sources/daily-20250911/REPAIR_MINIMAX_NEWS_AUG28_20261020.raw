,\"@id\":\"https://www.minimax.io/#logo\",\"url\":\"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png\",\"contentUrl\":\"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png\",\"caption\":\"MiniMax\",\"width\":512,\"height\":512},\"slogan\":\"Intelligence with Everyone\",\"foundingDate\":\"2021-12\",\"description\":\"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.\",\"email\":\"api@minimax.io\",\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"customer service\",\"email\":\"api@minimax.io\",\"areaServed\":\"Global\",\"availableLanguage\":[\"en\",\"zh\"]},\"sameAs\":[\"https://github.com/MiniMax-AI\",\"https://x.com/MiniMax__AI\",\"https://www.linkedin.com/company/minimax-ai/\",\"https://huggingface.co/MiniMaxAI\",\"https://minimax.io/discord\",\"https://en.wikipedia.org/wiki/MiniMax_(company)\"]},{\"@type\":\"Brand\",\"@id\":\"https://www.minimax.io/#brand\",\"name\":\"MiniMax\",\"url\":\"https://www.minimax.io\",\"logo\":\"https://filecdn.minimax.chat/public/58eca777-e31f-448a-9823-e2220e49b426.png\",\"description\":\"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.\",\"slogan\":\"Intelligence with Everyone\"},{\"@type\":\"WebSite\",\"@id\":\"https://www.minimax.io/#website\",\"url\":\"https://www.minimax.io\",\"name\":\"MiniMax\",\"description\":\"Building AGI with our mission Intelligence with Everyone. Global leader in multi-modal models and AI-native products with over 200 million users.\",\"publisher\":{\"@id\":\"https://www.minimax.io/#organization\"},\"inLanguage\":\"en-US\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://www.minimax.io/news\"}}},{\"@type\":\"NewsArticle\",\"@id\":\"https://www.minimax.io/news/minimax-hailuo-02-start-end-frames-feature-is-now-live#article\",\"headline\":\"MiniMax-Hailuo-02 Start \u0026 End Frames Feature is Now Live, Mastering Complex Instructions and Extreme Physics-Based Dynamics\",\"description\":\"\",\"image\":[],\"author\":{\"@id\":\"https://www.minimax.io/#organization\"},\"publisher\":{\"@id\":\"https://www.minimax.io/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.minimax.io/news/minimax-hailuo-02-start-end-frames-feature-is-now-live\"},\"articleSection\":\"News\",\"inLanguage\":\"en-US\",\"isAccessibleForFree\":true,\"copyrightYear\":2026,\"copyrightHolder\":{\"@id\":\"https://www.minimax.io/#organization\"}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.minimax.io/news/minimax-hailuo-02-start-end-frames-feature-is-now-live#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.minimax.io\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"What's New\",\"item\":\"https://www.minimax.io/news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"MiniMax-Hailuo-02 Start \u0026 End Frames Feature is Now Live, Mastering Complex Instructions and Extreme Physics-Based Dynamics\",\"item\":\"https://www.minimax.io/news/minimax-hailuo-02-start-end-frames-feature-is-now-live\"}]}]}"])</script><script>self.__next_f.push([1,"7:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$19\"}}],[\"$\",\"$L1a\",null,{\"data\":{\"base_resp\":{\"status_code\":0,\"status_msg\":\"success\"},\"title\":\"MiniMax-Hailuo-02 Start \u0026 End Frames Feature is Now Live\",\"content\":[{\"id\":\"de8d53ee-74bf-409b-9eef-e14664ce210d\",\"type\":\"ArticleTitle\",\"props\":{\"date\":\"Aug, 28, 2025\",\"title\":\"MiniMax-Hailuo-02 Start \u0026 End Frames Feature is Now Live, Mastering Complex Instructions and Extreme Physics-Based Dynamics\",\"buttons\":[{\"text\":\"Try Now\",\"styleType\":\"primary\",\"href\":\"https://hailuoai.video/create\"},{\"text\":\"API Platform\",\"styleType\":\"secondary\",\"href\":\"https://www.minimax.io/platform/document/video_generation?key=66d1439376e52fcee2853049#whYrra7nHOP2eZy9yMMbnnU6\"}]},\"children\":[]},{\"id\":\"b6c6ada1-d7af-4573-a19f-0c777a6cc8c4\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"Since the launch of MiniMax Hailuo 02, we have been continuously exploring the next frontier in video generation technology. Today, we are thrilled to announce a significant update: the \\\"Start and End Frame\\\" feature is now officially live on our web and mobile platforms, accompanied by the innovative \\\"End Frame Only\\\" feature.\u003cbr/\u003e\u003cbr/\u003e\\nBoth 768p and 1080p resolutions support the Start and End Frame and End Frame Only functionalities. The Start Frame functionality is supported for 512p.\"},\"children\":[]},{\"id\":\"fff2bfb3-d32b-42bc-9ce8-f3eadda2eb68\",\"type\":\"ArticleVideo\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/4efe0328-7c51-4254-b172-1ee0c92159ef.mp4\"},\"children\":[]},{\"id\":\"4c2914a8-eb93-47e0-b574-bf953a8a925c\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"The first generation of start-and-end-frames technology often suffered from poor instruction comprehension, limited application scenarios, and high error rates. Hailuo AI's next-generation start-and-end-frame functionality is engineered to deliver a superior experience through industry-leading instruction following, seamless motion dynamics, and boundless creative potential, establishing a new industry benchmark.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\"},\"children\":[]},{\"id\":\"feb0ba97-9606-4e74-ac71-6d7c958e9962\",\"type\":\"ArticleHeader\",\"props\":{\"level\":\"h3\",\"content\":\"Five Core Advantages Establishing a Generational Lead\"},\"children\":[]},{\"id\":\"201df3cf-02e2-4f6c-9d6a-359ccb1e841e\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"\u003cstrong\u003e1. Unmatched Adherence to Complex Instructions\u003c/strong\u003e\u003cbr/\u003e\\nWe fulfill every detail of your creative vision. The model demonstrates exceptional adherence to complex and detailed prompts, from rapid zoom-ins to intricate character animations and specific motion requirements, ensuring that what you describe is what you get.\"},\"children\":[]},{\"id\":\"6ca7af5c-e0b9-4d59-b42c-f339c7ad04f2\",\"type\":\"ArticleVideo\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/0aed4b89-ea8d-489e-b041-80ffed7b8459.mp4\",\"caption\":\"\"},\"children\":[]},{\"id\":\"55f141a4-32e5-4de0-8118-fcbf65b4716c\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"Prompt: \\\"A blank sheet of paper lies flat on a tabletop. The camera executes a rapid push-in from a wide shot, then immediately begins to orbit around the paper. Lines emerge and intertwine across the page like nimble sprites, as colors gradually bloom and spread. As the camera slowly rises, the lines and colors continuously converge and combine, making the silhouette of a building gradually clear. The final shot freezes on the completed architectural drawing, showcasing the magnificent building, perfectly rendered as if it has risen straight from the paper itself.\\\"\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\"},\"children\":[]},{\"id\":\"8209f878-01bd-433a-ab38-a19a9658098e\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"\u003cstrong\u003e2. Extreme Physics-Based Motion Dynamics\u003c/strong\u003e\u003cbr/\u003e\\nBuilding on Hailuo 02's unique capabilities, this feature flawlessly handles complex physical movements. Action sequences, gymnastics, and parkour are rendered with unparalleled smoothness and continuity, showcasing silky-smooth motion.\"},\"children\":[]},{\"id\":\"1c0d96ec-9df2-4503-942c-204be9fede96\",\"type\":\"ArticleVideo\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/eb307be7-9d90-48e2-9caf-a66d536080ef.mp4\"},\"children\":[]},{\"id\":\"7cd050d0-d932-4f95-8324-46cbbd77da70\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"\u003cstrong\u003e3. Dynamic and Cinematic Camera Control\u003c/strong\u003e\u003cbr/\u003e\\nAchieve a new level of artistry with dramatic camera movements. Effortlessly create spatial pans, transformative transitions, and perspective shifts for a truly cinematic feel.\"},\"children\":[]},{\"id\":\"9f1f023c-6037-40f2-81bf-fce648b87f5c\",\"type\":\"ArticleVideo\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/21d30546-3b05-4daa-84b4-0eede59dd76d.mp4\"},\"children\":[]},{\"id\":\"84c3a21b-12be-4eef-98de-129d528b088f\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"\u003cstrong\u003e4. Creativity Beyond Expectations\u003c/strong\u003e\u003cbr/\u003e\\nHailuo AI excels at bridging wide conceptual gaps between the start and end frames, delivering surprising and delightful results. Even with minimal instructions, our AI demonstrates exceptional creativity, turning simple prompts into extraordinary visual narratives.\"},\"children\":[]},{\"id\":\"9eb53b13-ad00-4fa1-b413-a08a781e56d5\",\"type\":\"ArticleVideo\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/4b007e69-2fa0-4a4a-92a7-f9561e7906f2.mp4\"},\"children\":[]},{\"id\":\"4744bc22-aaa6-4d7f-9d0a-f6b2ce40a69e\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"\u003cstrong\u003e5.  \\\"End Frame Only\\\" Suppotred\u003c/strong\u003e\u003cbr/\u003e\\nThis unique feature allows you to define the destination and let the AI generate the journey. Start with the end in mind and watch as Hailuo AI crafts a magical visual story leading up to it.\"},\"children\":[]},{\"id\":\"1703c08b-1d36-4562-aef9-a1f43d3d5fda\",\"type\":\"ArticleVideo\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/576a6187-10b2-47ce-8853-ee36ae0036b6.mp4\"},\"children\":[]},{\"id\":\"af68f8d2-0b05-4d9c-899f-0896f6829429\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"Prompt:\\n\\\"The camera rapidly soars upward, transforming into a fire phoenix.\\\"\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\"},\"children\":[]},{\"id\":\"1c7c2dfb-29b2-4b47-b2a3-c5aff922be68\",\"type\":\"ArticleHeader\",\"props\":{\"level\":\"h3\",\"content\":\"Enhanced Application Scenarios with Precise Control\"},\"children\":[]},{\"id\":\"93172d5f-5051-4725-9122-3b1a0a62acd5\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"\u003cstrong\u003eE-commerce Advertising: Cinematic Product Displays\u003c/strong\u003e\\nThe start-and-end-frame functionality allows for granular control over in-video text and logos, enabling highly detailed and cinematic product showcases and brand advertisements.\"},\"children\":[]},{\"id\":\"0fae72b0-6214-4ccd-845c-a3c34e786877\",\"type\":\"ArticleVideo\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/e1aaa32d-ed1e-48ab-9ee9-ab09b9babdd4.mp4\"},\"children\":[]},{\"id\":\"1ca85ff4-086b-46df-9061-178a3cae54fa\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"Prompt:\\n\\\"A Border Collie approaches from a distance and takes a bite of food from its bowl. It then suddenly and happily stands up on its hind legs, looking at the camera as colorful cartoon stars pop up in the background.\\\"\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\"},\"children\":[]},{\"id\":\"9aefb416-a07b-4ac1-a7e8-f81c8f2a1400\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"\u003cstrong\u003eOne-Click Style Transformation\u003c/strong\u003e\\nDefine the beginning and end frames to produce stunning, high-energy transformation sequences, effortlessly switching between different outfits and styles with seamless transitions.\"},\"children\":[]},{\"id\":\"66040364-6117-4698-91fe-ebb0867d87a2\",\"type\":\"ArticleVideo\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/bd9bca3b-f24a-4f52-91a3-6bfe4c496fb8.mp4\"},\"children\":[]},{\"id\":\"5cd220c1-7973-44b6-923c-29f8bcfdbc6c\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"Prompt:\\n\\\"A woman turns her head to look to the left. A gust of wind blows, sweeping through her hair. With the wind, the woman's clothing and the scene behind her rapidly transform. The camera pulls back to capture the dynamic motion of the woman, now dressed in a Japanese kimono, drawing a sword.\\\"\\n\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\"},\"children\":[]},{\"id\":\"85f3f4ae-87a2-4eea-b327-dec24c5a6c3f\",\"type\":\"ArticleHeader\",\"props\":{\"level\":\"h3\",\"content\":\"One More Thing…\"},\"children\":[]},{\"id\":\"006a3820-0a91-4715-8a20-2064338addb6\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"As a special highlight, the start-and-end-frame functionality also supports detailed animation of text and logos. As demonstrated in our launch video, complex effects like logo formations and text fly-ins are now easily achievable.\\n\"},\"children\":[]},{\"id\":\"0cc24ae4-2a06-4d7a-a696-9d5f1f6ba49d\",\"type\":\"ArticleVideo\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/42408b37-7d0a-406f-80b3-116727995a97.mp4\"},\"children\":[]},{\"id\":\"797d3066-02bb-4da3-bece-70134aaefc65\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"Prompt:\\n\\\"The camera rapidly pushes in on a conch shell. Inside, cosmic formations converge to form a logo as text flies in, word by word.\\\"\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\"},\"children\":[]},{\"id\":\"1ae94120-e24c-4c19-9bcc-0bef884141d3\",\"type\":\"ArticleHeader\",\"props\":{\"level\":\"h3\",\"content\":\"Join Our Creative Challenge!\"},\"children\":[]},{\"id\":\"79c0c92f-65f1-4f16-90bd-aa9ca1f34ea6\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"\\nTo celebrate the launch of the Start and End Frame feature, Hailuo AI is officially kicking off the first \u003cstrong\u003e\\\"AI Video Riddle\\\" Creative Challenge! \u003c/strong\u003eWe provide the \\\"riddle\\\" (the story's beginning and end), and you create the \\\"answer\\\" (the story that connects them).\u003cbr/\u003e\\nBelow are the 'first frame' and the 'last frame' of a story. What happened in between? Why did it end this way? Use Hailuo AI's Start and End Frame functionality to generate a video that reveals your version of the truth. Fabulous prizes await the most imaginative creators!\"},\"children\":[]},{\"id\":\"77bdf065-d351-4dd8-82e1-9cd79c702d33\",\"type\":\"ArticleImage\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/8463bf8d-7b4e-41fd-a46b-9b22253db527.png\",\"aspectRatio\":\"4:1.051\",\"caption\":\"Start Frame \u0026 Last Frame\"},\"children\":[]},{\"id\":\"2e58c4dd-5582-45c3-808b-f98baa729def\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"The greatest stories are born from the infinite possibilities between a beginning and an end. \u003cbr/\u003e\u003cbr/\u003e\\n\\nVisit \\n\u003ca href=\\\"https://hailuoai.video/create\\\" target=\\\"_blank\\\"\u003ehailuoai.video\u003c/a\u003e\\nor open the Hailuo AI app to experience the future of video creation today. It's time to create your own universe.\"},\"children\":[]},{\"id\":\"619a8ea5-abd7-4468-941c-1e3a902c558f\",\"type\":\"ArticleParagraph\",\"props\":{\"content\":\"\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\\n\u003cstrong\u003eIntelligence with everyone.\u003c/strong\u003e\\n\"},\"children\":[]},{\"id\":\"3c05c94a-9666-40f8-904e-112e485ad627\",\"type\":\"ArticleImage\",\"props\":{\"src\":\"https://filecdn.minimax.chat/public/889bb8c5-8bc9-4376-9b22-15b6e4202c31.webp\",\"aspectRatio\":\"4:2.25\"},\"children\":[]}],\"slug\":\"minimax-hailuo-02-start-end-frames-feature-is-now-live\"}}]]\n"])</script></body></html>