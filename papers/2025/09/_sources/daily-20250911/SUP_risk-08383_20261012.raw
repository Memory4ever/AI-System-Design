<td id="A2.T3.2.5.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_l ltx_border_r ltx_border_t" rowspan="4"><span id="A2.T3.2.5.1.1" class="ltx_text"><math id="A2.T3.m7" class="ltx_Math" alttext="\operatorname{InvSqr}" display="inline" intent=":literal"><semantics><mi>InvSqr</mi><annotation encoding="application/x-tex">\operatorname{InvSqr}</annotation></semantics></math></span></td>
<td id="A2.T3.2.5.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Iterations</td>
<td id="A2.T3.2.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">5</td>
