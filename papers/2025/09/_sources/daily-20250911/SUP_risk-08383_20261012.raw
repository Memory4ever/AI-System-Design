<td id="A2.T3.2.4.3" class="ltx_td ltx_align_center ltx_border_r">11.7</td>
<td id="A2.T3.2.4.4" class="ltx_td ltx_align_center ltx_border_r">20.2</td>
<td id="A2.T3.2.4.5" class="ltx_td ltx_align_center ltx_border_r">26.9</td></tr>
