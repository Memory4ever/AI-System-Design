<th id="S4.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding:-0.1pt 3.0pt;">Best <math id="S4.T1.m10" class="ltx_Math" alttext="(p,c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,c)</annotation></semantics></math></th>
