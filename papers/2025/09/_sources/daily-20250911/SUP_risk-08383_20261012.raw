<td id="A2.T3.2.3.4" class="ltx_td ltx_align_center ltx_border_r">22</td>
<td id="A2.T3.2.3.5" class="ltx_td ltx_align_center ltx_border_r">24</td></tr>
<tr id="A2.T3.2.4" class="ltx_tr">
