{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;\Block[fill=mredTransk,rounded-corners]{1-1}{}\scalebox{0.8}{$\nicefrac{{1}}{{2}}$}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;\Block[fill=mredTransk,rounded-corners]{1-1}{}\scalebox{0.8}{$\nicefrac{{1}}{{2}}$}&amp;{\color[rgb]{0.55,0.55,0.55}0}\\
{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;\Block[fill=mredTranskk,rounded-corners]{1-1}{}\scalebox{0.8}{$\nicefrac{{1}}{{3}}$}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;\Block[fill=mredTranskk,rounded-corners]{1-1}{}\scalebox{0.8}{$\nicefrac{{1}}{{3}}$}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;\Block[fill=mredTranskk,rounded-corners]{1-1}{}\scalebox{0.8}{$\nicefrac{{1}}{{3}}$}\\
