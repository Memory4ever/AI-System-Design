{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
