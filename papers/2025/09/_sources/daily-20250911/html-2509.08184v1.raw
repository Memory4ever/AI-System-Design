0&amp;\Block[fill=mred!40,rounded-corners]{1-1}{}A^{(2,1)}&amp;\\
\Block[borders={top,right,tikz={dashed}}]{2-2}{0}&amp;&amp;\Block[]{2-2}{0}\\
&amp;&amp;&amp;\\
