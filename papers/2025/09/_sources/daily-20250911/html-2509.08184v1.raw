{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;\Block[fill=mlightblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
\end{pNiceMatrix}$
}}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p2.2" class="ltx_p">We can compute the first layer’s attention as:</p>
<table id="S5.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex7.m1" class="ltx_Math" alttext="[e_{s_{i}},e_{i}]^{\top}\tilde{A}^{(1)}[e_{s_{j}},e_{j}]=(\log P)_{s_{j},s_{i}}+\lambda\text{sign}(A^{(1)}_{ij})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>e</mi><msub><mi>s</mi><mi>i</mi></msub></msub><mo>,</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>e</mi><msub><mi>s</mi><mi>j</mi></msub></msub><mo>,</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>P</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>s</mi><mi>j</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">[e_{s_{i}},e_{i}]^{\top}\tilde{A}^{(1)}[e_{s_{j}},e_{j}]=(\log P)_{s_{j},s_{i}}+\lambda\text{sign}(A^{(1)}_{ij})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p2.3" class="ltx_p">and applying the softmax:</p>
<table id="S5.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex8.m1" class="ltx_math_unparsed" alttext="\mathcal{A}^{(1)}(h^{(0)}_{1:T};\tilde{A}^{(1)})_{ij}=\frac{e^{(\log P)_{s_{j},s_{i}}+\lambda\text{sign}(A^{(1)}_{i,j})}}{\sum_{r=1}^{i}e^{(\log P)_{s_{r},s_{i}}+\lambda\text{sign}(A^{(1)}_{i,r})}}=\frac{e^{(\log P)_{s_{j},s_{i}}+\lambda\text{sign}(A^{(1)}_{ij})}}{\sum_{r\in\mathcal{K}}e^{(\log P)_{s_{r},s_{i}}+\lambda}+\sum_{r\not\in\mathcal{K}}e^{(\log P)_{s_{r},s_{i}}-\lambda}}\,." display="block" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>h</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mfrac><msup><mi>e</mi><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>P</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>s</mi><mi>j</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup><msup><mi>e</mi><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>P</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>s</mi><mi>r</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><msup><mi>e</mi><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>P</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>s</mi><mi>j</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mrow><mrow><msub><mo>∑</mo><mrow><mi>r</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow></msub><msup><mi>e</mi><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>P</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>s</mi><mi>r</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub><mo>+</mo><mi>λ</mi></mrow></msup></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>r</mi><mo>∉</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow></msub><msup><mi>e</mi><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>P</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>s</mi><mi>r</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub><mo>−</mo><mi>λ</mi></mrow></msup></mrow></mrow></mfrac><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{A}^{(1)}(h^{(0)}_{1:T};\tilde{A}^{(1)})_{ij}=\frac{e^{(\log P)_{s_{j},s_{i}}+\lambda\text{sign}(A^{(1)}_{i,j})}}{\sum_{r=1}^{i}e^{(\log P)_{s_{r},s_{i}}+\lambda\text{sign}(A^{(1)}_{i,r})}}=\frac{e^{(\log P)_{s_{j},s_{i}}+\lambda\text{sign}(A^{(1)}_{ij})}}{\sum_{r\in\mathcal{K}}e^{(\log P)_{s_{r},s_{i}}+\lambda}+\sum_{r\not\in\mathcal{K}}e^{(\log P)_{s_{r},s_{i}}-\lambda}}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p2.4" class="ltx_p">For <span id="S5.SS1.p2.4.1" class="ltx_text"><math id="S5.SS1.p2.m5" class="ltx_Math" alttext="\lambda\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\lambda\to\infty</annotation></semantics></math></span> (in practice, for <math id="S5.SS1.p2.m6" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> large enough) and having denoted <math id="S5.SS1.p2.m7" class="ltx_Math" alttext="\tilde{p}_{i,k}\coloneq\frac{P_{s_{i-k},s_{i}}}{\sum_{r\in\mathcal{K},r&lt;i}P_{s_{i-r},s_{i}}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>≔</mo><mfrac><msub><mi>P</mi><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mrow><mi>r</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow><mo>,</mo><mrow><mi>r</mi><mo>&lt;</mo><mi>i</mi></mrow></mrow></msub></mstyle><msub><mi>P</mi><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>−</mo><mi>r</mi></mrow></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\tilde{p}_{i,k}\coloneq\frac{P_{s_{i-k},s_{i}}}{\sum_{r\in\mathcal{K},r&lt;i}P_{s_{i-r},s_{i}}}</annotation></semantics></math> for <math id="S5.SS1.p2.m8" class="ltx_Math" alttext="i&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i&gt;1</annotation></semantics></math>,</p>
<table id="S5.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex9.m1" class="ltx_math_unparsed" alttext="\lim_{\lambda\to\infty}\mathcal{A}^{(1)}(h^{(0)}_{1:T};\tilde{A}^{(1)})_{ij}=\left\{\begin{array}[]{cl}\tilde{p}_{i,i-j}&amp;\text{if}\;i-j\in\mathcal{K}\\
1&amp;\text{if}\;i=j=1\\
0&amp;\text{elsewhere}\end{array}.\right." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>λ</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>h</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mi>j</mi></mrow></mrow></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if</mtext><mo lspace="0.280em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><mi>j</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if</mtext><mo lspace="0.280em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><mi>j</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>elsewhere</mtext></mtd></mtr></mtable><mo lspace="0.167em">.</mo></mrow></mrow><annotation encoding="application/x-tex">\lim_{\lambda\to\infty}\mathcal{A}^{(1)}(h^{(0)}_{1:T};\tilde{A}^{(1)})_{ij}=\left\{\begin{array}[]{cl}\tilde{p}_{i,i-j}&amp;\text{if}\;i-j\in\mathcal{K}\\
1&amp;\text{if}\;i=j=1\\
0&amp;\text{elsewhere}\end{array}.\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p2.5" class="ltx_p">Therefore, the output at index <math id="S5.SS1.p2.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> after the first layer corresponds to a weighted average of the past tokens <math id="S5.SS1.p2.m10" class="ltx_Math" alttext="h^{(0)}_{i-k}" display="inline" intent=":literal"><semantics><msubsup><mi>h</mi><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">h^{(0)}_{i-k}</annotation></semantics></math> for <math id="S5.SS1.p2.m11" class="ltx_Math" alttext="k\in\mathcal{K}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow><annotation encoding="application/x-tex">k\in\mathcal{K}</annotation></semantics></math> where the weights are given by the normalized probabilities <math id="S5.SS1.p2.m12" class="ltx_Math" alttext="\tilde{p}_{i,k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{p}_{i,k}</annotation></semantics></math>:</p>
<table id="S5.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex10.m1" class="ltx_math_unparsed" alttext="\hat{h}^{(1)}_{i}=\text{Attn}(h^{(0)}_{1:T};\tilde{A}^{(1)})_{i}=\left\{\begin{array}[]{cl}\sum_{j=1}^{i}\mathds{1}\left[i-j\in\mathcal{K}\right]\frac{P_{s_{j},s_{i}}}{\sum_{r\in\mathcal{K}}P_{s_{r},s_{i}}}h^{(0)}_{j}&amp;\text{if}\;i&gt;1\\
h_{1}^{(0)}&amp;\text{if}\;i=1\end{array}\right.=\left\{\begin{array}[]{cl}\sum\limits_{k\in\mathcal{K},k&lt;i}\tilde{p}_{i,k}h^{(0)}_{i-k}&amp;\text{if}\;i&gt;1\\
h_{1}^{(0)}&amp;\text{if}\;i=1\end{array}\right." display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mtext>Attn</mtext><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>h</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mstyle displaystyle="false"><mo>∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mn>𝟙</mn><mo>[</mo><mi>i</mi><mo>−</mo><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>]</mo><mstyle displaystyle="false"><mfrac><msub><mi>P</mi><mrow><msub><mi>s</mi><mi>j</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>r</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow></msub></mstyle><msub><mi>P</mi><mrow><msub><mi>s</mi><mi>r</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub></mrow></mfrac></mstyle><mi>h</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>j</mi></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if</mtext><mo lspace="0.280em" rspace="0em">​</mo><mi>i</mi></mrow><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd><msubsup><mi>h</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if</mtext><mo lspace="0.280em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mstyle displaystyle="false"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo>&lt;</mo><mi>i</mi></mrow></mrow></munder></mstyle><mrow><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>h</mi><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if</mtext><mo lspace="0.280em" rspace="0em">​</mo><mi>i</mi></mrow><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd><msubsup><mi>h</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if</mtext><mo lspace="0.280em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{h}^{(1)}_{i}=\text{Attn}(h^{(0)}_{1:T};\tilde{A}^{(1)})_{i}=\left\{\begin{array}[]{cl}\sum_{j=1}^{i}\mathds{1}\left[i-j\in\mathcal{K}\right]\frac{P_{s_{j},s_{i}}}{\sum_{r\in\mathcal{K}}P_{s_{r},s_{i}}}h^{(0)}_{j}&amp;\text{if}\;i&gt;1\\
h_{1}^{(0)}&amp;\text{if}\;i=1\end{array}\right.=\left\{\begin{array}[]{cl}\sum\limits_{k\in\mathcal{K},k&lt;i}\tilde{p}_{i,k}h^{(0)}_{i-k}&amp;\text{if}\;i&gt;1\\
h_{1}^{(0)}&amp;\text{if}\;i=1\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p2.6" class="ltx_p">With the input vectors <math id="S5.SS1.p2.m13" class="ltx_Math" alttext="h^{(0)}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>h</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">h^{(0)}_{i}</annotation></semantics></math> being the concatenation of the one-hot encoding of the state and position <math id="S5.SS1.p2.m14" class="ltx_Math" alttext="[e_{s_{i}},e_{i}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>e</mi><msub><mi>s</mi><mi>i</mi></msub></msub><mo>,</mo><msub><mi>e</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[e_{s_{i}},e_{i}]</annotation></semantics></math>, the first <math id="S5.SS1.p2.m15" class="ltx_Math" alttext="|\mathcal{S}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|</annotation></semantics></math> entries of <math id="S5.SS1.p2.m16" class="ltx_Math" alttext="\hat{h}^{(1)}_{i}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{h}^{(1)}_{i}</annotation></semantics></math> correspond to <math id="S5.SS1.p2.m17" class="ltx_Math" alttext="\tilde{s}_{i}=\sum_{k\in\mathcal{K},k&lt;i}\tilde{p}_{i,k}e_{s_{i-k}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>s</mi><mo>~</mo></mover><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mrow><mi>k</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo>&lt;</mo><mi>i</mi></mrow></mrow></msub><mrow><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><msub><mi>s</mi><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{s}_{i}=\sum_{k\in\mathcal{K},k&lt;i}\tilde{p}_{i,k}e_{s_{i-k}}</annotation></semantics></math> for <math id="S5.SS1.p2.m18" class="ltx_Math" alttext="i&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i&gt;1</annotation></semantics></math> and <math id="S5.SS1.p2.m19" class="ltx_Math" alttext="\tilde{s}_{1}=e_{s_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>s</mi><mo>~</mo></mover><mn>1</mn></msub><mo>=</mo><msub><mi>e</mi><msub><mi>s</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">\tilde{s}_{1}=e_{s_{1}}</annotation></semantics></math>. The remaining entries, due to the one-hot positional encoding, directly copy the normalized transition probabilities for the transition <math id="S5.SS1.p2.m20" class="ltx_Math" alttext="s_{i-k}\to s_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>s</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">s_{i-k}\to s_{i}</annotation></semantics></math> into the <math id="S5.SS1.p2.m21" class="ltx_Math" alttext="|\mathcal{S}|+(i-k)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">|\mathcal{S}|+(i-k)</annotation></semantics></math>-th element of <math id="S5.SS1.p2.m22" class="ltx_Math" alttext="\hat{h}^{(1)}_{i}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{h}^{(1)}_{i}</annotation></semantics></math>.
To build intuition, we refer to the example in Eq. <a href="#S5.E4" title="In 5.1. Proof of Proposition : Construction for Contiguous Lags ‣ 5. How Can Transformer Do In-Context Selection? ‣ Selective induction Heads: How Transformers Select Causal Structures in Context" class="ltx_ref"><span class="ltx_ref ltx_nolink"><span class="ltx_text ltx_ref_tag">4</span></span></a> where the colors highlight transition probabilities of the same lag:</p>
