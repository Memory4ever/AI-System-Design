{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mblueTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
\end{pNiceMatrix}$
}}}}}\qquad A^{(2,3)}=\noindent\par\noindent\resizebox{}{}{\scalebox{0.6}[0.6]{{\hbox{{\ignorespaces$\;\;\begin{pNiceMatrix}{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mgoldTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mgoldTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mgoldTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mgoldTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mgoldTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mgoldTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;\Block[fill=mgoldTrans,rounded-corners]{1-1}{}\scalebox{0.8}{+}\lambda&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}&amp;{\color[rgb]{0.55,0.55,0.55}\scalebox{0.8}{-}\lambda}\\
\end{pNiceMatrix}$
}}}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p4.2" class="ltx_p">Each head has a diagonal structure with non-zero entries along the diagonals at position <math id="S5.SS1.p4.m13" class="ltx_Math" alttext="nK+h-1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mi>h</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">nK+h-1</annotation></semantics></math> for <math id="S5.SS1.p4.m14" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math> and <math id="S5.SS1.p4.m15" class="ltx_Math" alttext="h\in\{1,\dots,H_{2}\}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>H</mi><mn>2</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">h\in\{1,\dots,H_{2}\}</annotation></semantics></math>, the attention matrices can be formalized as:</p>
<table id="S5.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex12.m1" class="ltx_Math" alttext="A_{ij}^{(2,h)}=\lambda\begin{cases}+1,&amp;\text{if }i\geq j&gt;\hat{k}\text{ and }(i-j)\mod K=h-1\\
-1,&amp;\text{otherwise},\end{cases}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>≥</mo><mi>j</mi><mo>&gt;</mo><mrow><mrow><mover accent="true"><mi>k</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>mod</mo><mi>K</mi></mrow><mo>=</mo><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>otherwise</mtext><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{ij}^{(2,h)}=\lambda\begin{cases}+1,&amp;\text{if }i\geq j&gt;\hat{k}\text{ and }(i-j)\mod K=h-1\\
-1,&amp;\text{otherwise},\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p4.3" class="ltx_p">where the condition <math id="S5.SS1.p4.m16" class="ltx_Math" alttext="i\geq j\geq\hat{k}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≥</mo><mi>j</mi><mo>≥</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">i\geq j\geq\hat{k}</annotation></semantics></math> ensures that all entries in the first <math id="S5.SS1.p4.m17" class="ltx_Math" alttext="\hat{k}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>k</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{k}</annotation></semantics></math> rows and columns are set to <math id="S5.SS1.p4.m18" class="ltx_Math" alttext="-\lambda" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">-\lambda</annotation></semantics></math> and imposes a lower triangular structure due to causal masking.
The modulo operation instead assigns each diagonal multiple of <math id="S5.SS1.p4.m19" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> to <math id="S5.SS1.p4.m20" class="ltx_Math" alttext="+\lambda" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">+\lambda</annotation></semantics></math> (allowing attention) and the remaining diagonals to <math id="S5.SS1.p4.m21" class="ltx_Math" alttext="-\lambda" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">-\lambda</annotation></semantics></math> (masking attention), while <math id="S5.SS1.p4.m22" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> determines the shift of the the first positive diagonal to ensure the heads do not overlap.
The output of each head in the second layer is given by computing:</p>
<table id="S5.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex13.m1" class="ltx_Math" alttext="[[e_{s_{i}},e_{i}],\hat{h}^{(1)}_{i}]^{\top}\tilde{A}^{(2,h)}[[e_{s_{j}},e_{j}],\hat{h}^{(1)}_{j}]\,=\,A^{(2,h)}_{i,j}\,=\,\lambda\text{sign}(A^{(2,h)}_{i,j})\,," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>e</mi><msub><mi>s</mi><mi>i</mi></msub></msub><mo>,</mo><msub><mi>e</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>e</mi><msub><mi>s</mi><mi>j</mi></msub></msub><mo>,</mo><msub><mi>e</mi><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo rspace="0.170em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.448em">=</mo><msubsup><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.448em">=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">[[e_{s_{i}},e_{i}],\hat{h}^{(1)}_{i}]^{\top}\tilde{A}^{(2,h)}[[e_{s_{j}},e_{j}],\hat{h}^{(1)}_{j}]\,=\,A^{(2,h)}_{i,j}\,=\,\lambda\text{sign}(A^{(2,h)}_{i,j})\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p4.4" class="ltx_p">and applying softmax and in the limit as <math id="S5.SS1.p4.m23" class="ltx_Math" alttext="\lambda\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\lambda\to\infty</annotation></semantics></math>, the rows of the attention become uniform for positive entries and zero otherwise:</p>
<table id="S5.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex14.m1" class="ltx_Math" alttext="\mathcal{A}^{(2,h)}_{ij}=\textrm{Softmax}(A^{(2,h)})_{ij}=\frac{\mathds{1}\left[A^{(2,h)}_{ij}=\lambda\right]}{\sum_{m=1}^{i}\mathds{1}\left[A^{(2,h)}_{im}=\lambda\right]}\,." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mtext>Softmax</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>=</mo><mfrac><mrow><mn>𝟙</mn><mo>[</mo><mi>A</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mi>λ</mi><mo>]</mo></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>i</mi></msup><mn>𝟙</mn><mo>[</mo><mi>A</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo>=</mo><mi>λ</mi><mo>]</mo></mrow></mfrac></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{A}^{(2,h)}_{ij}=\textrm{Softmax}(A^{(2,h)})_{ij}=\frac{\mathds{1}\left[A^{(2,h)}_{ij}=\lambda\right]}{\sum_{m=1}^{i}\mathds{1}\left[A^{(2,h)}_{im}=\lambda\right]}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p4.5" class="ltx_p">The output <math id="S5.SS1.p4.m24" class="ltx_Math" alttext="\hat{h}_{i}^{(2,h)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{h}_{i}^{(2,h)}</annotation></semantics></math> of each head is then concatenated into the residual stream.
Fig. <a href="#S5.F2" title="Figure 2 ‣ 5.1. Proof of Proposition : Construction for Contiguous Lags ‣ 5. How Can Transformer Do In-Context Selection? ‣ Selective induction Heads: How Transformers Select Causal Structures in Context" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> shows the output for the <math id="S5.SS1.p4.m25" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>th token<span id="footnote2" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">2</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">2</sup>
              <span class="ltx_tag ltx_tag_note">2</span>
              
              
              
            To simplify the notation we depict with <math id="footnote2.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and single gray block instead of <math id="footnote2.m2" class="ltx_Math" alttext="|\mathcal{S}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|</annotation></semantics></math> elements, the entries correspondent to the semantics and their average after the attention which are not used in the mechanism.</span></span></span> for each attention head <math id="S5.SS1.p4.m26" class="ltx_Math" alttext="\hat{h}^{(2,1)}_{10},\hat{h}^{(2,2)}_{10}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mn>10</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mn>10</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\hat{h}^{(2,1)}_{10},\hat{h}^{(2,2)}_{10}</annotation></semantics></math> and <math id="S5.SS1.p4.m27" class="ltx_Math" alttext="\hat{h}^{(2,3)}_{10}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mn>10</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{h}^{(2,3)}_{10}</annotation></semantics></math> to visualize the mechanism of the second layer.
The arrows of different colors represent how each head aggregates transition probabilities by attending to non-overlapping past tokens and averaging them with uniform weights.
When concatenating the output of the different heads <math id="S5.SS1.p4.m28" class="ltx_Math" alttext="h^{(2)}_{i}=[h^{(0)}_{i},\hat{h}^{(1)}_{i},\hat{h}^{(2,1)}_{i},\dots,\hat{h}^{(2,H_{2})}_{i}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>h</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>h</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>H</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h^{(2)}_{i}=[h^{(0)}_{i},\hat{h}^{(1)}_{i},\hat{h}^{(2,1)}_{i},\dots,\hat{h}^{(2,H_{2})}_{i}]</annotation></semantics></math>, we can see how the <math id="S5.SS1.p4.m29" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>th token stores the transition probabilities of its entire past for each lag.</p>
</div>
