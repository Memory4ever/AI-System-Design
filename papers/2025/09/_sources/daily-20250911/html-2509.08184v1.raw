tex">\mathcal{A}^{(2,2)}</annotation></semantics></math></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#FFB703;--ltx-fill-color:#FFB703;--ltx-fg-color:#FFB703;" color="#FFB703" fill="#FFB703" stroke="#FFB703" stroke-width="1.5pt"><path style="fill:none" d="M 6.92 0 C 26.98 0 0 0 26.98 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 -25.94 0)"><path style="fill:none" d="M -4.7 6.07 C -3.85 2.43 -1.93 0.71 0 0 C -1.93 -0.71 -3.85 -2.43 -4.7 -6.07"></path></g><g style="--ltx-stroke-color:#FFB703;--ltx-fill-color:#FFB703;--ltx-fg-color:#000000;" color="#000000" fill="#FFB703" stroke="#FFB703" transform="matrix(1.0 0.0 0.0 1.0 -16.94 -17.94)"><foreignObject style="--ltx-fo-width:2.45em;--ltx-fo-height:0.89em;--ltx-fo-depth:0em;font-size:10pt;" height="12.29" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="33.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F2.pic1.m7" class="ltx_Math" alttext="\mathcal{A}^{(2,2)}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#FFB703;" class="ltx_font_mathcaligraphic" mathcolor="#FFB703">𝒜</mi><mrow><mo style="--ltx-fg-color:#FFB703;" mathcolor="#FFB703" stretchy="false">(</mo><mn style="--ltx-fg-color:#FFB703;" mathcolor="#FFB703">2</mn><mo style="--ltx-fg-color:#FFB703;" mathcolor="#FFB703">,</mo><mn style="--ltx-fg-color:#FFB703;" mathcolor="#FFB703">2</mn><mo style="--ltx-fg-color:#FFB703;" mathcolor="#FFB703" stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathcal{A}^{(2,2)}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></span></p>
</span></div>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F2.6" class="ltx_text" style="font-size:90%;">Figure 2</span>. </span><span id="S5.F2.7" class="ltx_text ltx_font_bold" style="font-size:90%;">Visualization of the mechanism of the second attention layer in our construction.<span id="S5.F2.7.1" class="ltx_text ltx_font_medium">
The matrix represents the input of the second layer <math id="S5.F2.m7" class="ltx_Math" alttext="h^{(1)}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">h^{(1)}</annotation></semantics></math> whereas the single vectors represent the output for the 10<sup id="S5.F2.7.1.1" class="ltx_sup">th</sup> token <math id="S5.F2.m8" class="ltx_Math" alttext="\hat{h}^{(2,1)}_{10},\hat{h}^{(2,2)}_{10},\hat{h}^{(2,3)}_{10}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>h</mi><mo mathsize="1.110em">^</mo></mover><mn>10</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo mathsize="1.110em">^</mo></mover><mn>10</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo mathsize="1.110em">^</mo></mover><mn>10</mn><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\hat{h}^{(2,1)}_{10},\hat{h}^{(2,2)}_{10},\hat{h}^{(2,3)}_{10}</annotation></semantics></math>. Each of the three attention heads (arrows of different colors) copies non-overlapping transition probabilities at distance <math id="S5.F2.m9" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> from each other from the past. By doing this, the output of the second layer for the current token (<math id="S5.F2.m10" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>) contains all <math id="S5.F2.m11" class="ltx_Math" alttext="\tilde{p}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>p</mi><mo mathsize="1.110em">~</mo></mover><annotation encoding="application/x-tex">\tilde{p}</annotation></semantics></math> for each lag without loss of information.
</span></span></figcaption>
</figure>
<div id="S5.SS1.p5" class="ltx_para ltx_noindent">
<p id="S5.SS1.p5.1" class="ltx_p"><span id="S5.SS1.p5.1.1" class="ltx_text ltx_font_bold">Third layer: average of transition probabilities and lag selection.</span>
To build some intuition, suppose the current token is at position <math id="S5.SS1.p5.m1" class="ltx_Math" alttext="i=10" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">i=10</annotation></semantics></math>, and we are predicting the 11<sup id="S5.SS1.p5.1.2" class="ltx_sup">th</sup> token in the sequence. Given a set of possible lags <math id="S5.SS1.p5.m2" class="ltx_Math" alttext="\{1,2,3\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2,3\}</annotation></semantics></math>, the third attention mechanism must concentrate around one of the tokens at positions <math id="S5.SS1.p5.m3" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math>, <math id="S5.SS1.p5.m4" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math>, or <math id="S5.SS1.p5.m5" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>. This ensures that transitions for all possible lags are considered: If the sequence was generated from the source of lag 1, the token at position <math id="S5.SS1.p5.m6" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math> needs to be copied to predict the transition probabilities for the 11<sup id="S5.SS1.p5.1.3" class="ltx_sup">th</sup> token. For lag <math id="S5.SS1.p5.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, the token at position <math id="S5.SS1.p5.m8" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math> is copied, and so on.
To determine the correct lag based on the sequence’s history, our construction relies on the sum of past transitions up to the current token, <math id="S5.SS1.p5.m9" class="ltx_Math" alttext="\sum_{j&lt;i}\tilde{p}_{j,k}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></msub><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\sum_{j&lt;i}\tilde{p}_{j,k}</annotation></semantics></math>. Therefore, the third attention is constructed such that the entries corresponding to the transitions of possible lags are proportional to the respective cumulative sums. For example, to select which token among the ones in position <math id="S5.SS1.p5.m10" class="ltx_Math" alttext="8,9,10" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo>,</mo><mn>9</mn><mo>,</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">8,9,10</annotation></semantics></math> should be copied to predict <math id="S5.SS1.p5.m11" class="ltx_Math" alttext="11" display="inline" intent=":literal"><semantics><mn>11</mn><annotation encoding="application/x-tex">11</annotation></semantics></math>, the third attention must be such that <math id="S5.SS1.p5.m12" class="ltx_Math" alttext="\mathcal{A}^{(3)}_{10,10}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mn>10</mn><mo>,</mo><mn>10</mn></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathcal{A}^{(3)}_{10,10}</annotation></semantics></math> is proportional exclusively to the sum of transitions of lag 1, i.e., <math id="S5.SS1.p5.m13" class="ltx_Math" alttext="\sum_{j\leq 10}\tilde{p}_{j,1}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≤</mo><mn>10</mn></mrow></msub><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\sum_{j\leq 10}\tilde{p}_{j,1}</annotation></semantics></math> while <math id="S5.SS1.p5.m14" class="ltx_Math" alttext="\mathcal{A}^{(3)}_{10,9}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mn>10</mn><mo>,</mo><mn>9</mn></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathcal{A}^{(3)}_{10,9}</annotation></semantics></math> is exclusively proportional to <math id="S5.SS1.p5.m15" class="ltx_Math" alttext="\sum_{j\leq 10}\tilde{p}_{j,2}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≤</mo><mn>10</mn></mrow></msub><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\sum_{j\leq 10}\tilde{p}_{j,2}</annotation></semantics></math> and <math id="S5.SS1.p5.m16" class="ltx_Math" alttext="\mathcal{A}^{(3)}_{10,8}\propto\sum_{j\leq 10}\tilde{p}_{j,3}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mn>10</mn><mo>,</mo><mn>8</mn></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">∝</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≤</mo><mn>10</mn></mrow></msub><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}^{(3)}_{10,8}\propto\sum_{j\leq 10}\tilde{p}_{j,3}</annotation></semantics></math>. Then, in the limit of the softmax converging to the hardmax, the attention collapses to the entry corresponding to the larger sum and selects the correspondent lag by copying the associated token.
More generally, for this to apply to all rows, the third attention matrix must be constructed such that <math id="S5.SS1.p5.m17" class="ltx_Math" alttext="\mathcal{A}^{(3)}_{i,i}\propto\sum_{j\leq i}\tilde{p}_{j,1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">∝</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≤</mo><mi>i</mi></mrow></msub><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}^{(3)}_{i,i}\propto\sum_{j\leq i}\tilde{p}_{j,1}</annotation></semantics></math>, while <math id="S5.SS1.p5.m18" class="ltx_Math" alttext="\mathcal{A}^{(3)}_{i,i-1}\propto\sum_{j\leq i}\tilde{p}_{j,2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">∝</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≤</mo><mi>i</mi></mrow></msub><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}^{(3)}_{i,i-1}\propto\sum_{j\leq i}\tilde{p}_{j,2}</annotation></semantics></math>, and <math id="S5.SS1.p5.m19" class="ltx_Math" alttext="\mathcal{A}^{(3)}_{i,i-2}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathcal{A}^{(3)}_{i,i-2}</annotation></semantics></math> to <math id="S5.SS1.p5.m20" class="ltx_Math" alttext="\sum_{j\leq i}\tilde{p}_{j,3}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≤</mo><mi>i</mi></mrow></msub><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\sum_{j\leq i}\tilde{p}_{j,3}</annotation></semantics></math>, with all remaining entries set to zero.</p>
</div>
<div id="S5.SS1.p6" class="ltx_para">
<p id="S5.SS1.p6.1" class="ltx_p">This selection mechanism is implemented through the combination of multiple blocks within the third attention matrix, <math id="S5.SS1.p6.m1" class="ltx_Math" alttext="\tilde{A}^{(3)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{A}^{(3)}</annotation></semantics></math>, which acts on the concatenated tokens <math id="S5.SS1.p6.m2" class="ltx_Math" alttext="h^{(2)}_{i}=[h^{(0)}_{i},\hat{h}^{(1)}_{i},\hat{h}^{(2,1)}_{i},\dots,\hat{h}^{(2,H_{2})}_{i}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>h</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>h</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mover accent="true"><mi>h</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>H</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h^{(2)}_{i}=[h^{(0)}_{i},\hat{h}^{(1)}_{i},\hat{h}^{(2,1)}_{i},\dots,\hat{h}^{(2,H_{2})}_{i}]</annotation></semantics></math> and is structured as follows:</p>
<table id="S5.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.EGx5.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.EGx5.m1" class="ltx_Math" alttext="\displaystyle\tilde{A}^{(3)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\displaystyle\tilde{A}^{(3)}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
