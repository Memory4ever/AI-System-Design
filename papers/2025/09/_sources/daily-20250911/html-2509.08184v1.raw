{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;\Block[fill=mredTrans,rounded-corners]{1-1}{}1&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}&amp;{\color[rgb]{0.55,0.55,0.55}0}\\
