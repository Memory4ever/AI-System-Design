<td id="S3.T1.8.24.5" class="ltx_td ltx_align_center" style="padding:-0.5pt 2.0pt;"><span id="S3.T1.8.24.5.1" class="ltx_text" style="--ltx-bg-color:#F9FFF9;">0.76</span></td>
<td id="S3.T1.8.24.6" class="ltx_td ltx_align_center" style="padding:-0.5pt 2.0pt;"><span id="S3.T1.8.24.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F9FFF9;">0.94</span></td>
