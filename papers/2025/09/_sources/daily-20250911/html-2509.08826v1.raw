<td class="ltx_td ltx_align_left ltx_border_tt"><math alttext="73.6_{{\color[rgb]{0,0,0}\definecolor[named]{pgfstrokecolor}{rgb}{0,0,0}+6.6}}" class="ltx_Math" display="inline" id="S4.T2.m5"><semantics><msub><mn>73.6</mn><mrow><mo>+</mo><mn>6.6</mn></mrow></msub><annotation encoding="application/x-tex">73.6_{{\color[rgb]{0,0,0}\definecolor[named]{pgfstrokecolor}{rgb}{0,0,0}+6.6}}</annotation></semantics></math></td>
</tr>
<tr class="ltx_tr">
