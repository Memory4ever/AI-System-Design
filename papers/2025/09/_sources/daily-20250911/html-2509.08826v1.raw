<td class="ltx_td ltx_align_left ltx_border_r">Seedream-3.0-SFT</td>
<td class="ltx_td ltx_align_left">74.1</td>
<td class="ltx_td ltx_align_left"><math alttext="74.9_{{\color[rgb]{0,0,0}\definecolor[named]{pgfstrokecolor}{rgb}{0,0,0}+0.8}}" class="ltx_Math" display="inline" id="S4.T2.m6"><semantics><msub><mn>74.9</mn><mrow><mo>+</mo><mn>0.8</mn></mrow></msub><annotation encoding="application/x-tex">74.9_{{\color[rgb]{0,0,0}\definecolor[named]{pgfstrokecolor}{rgb}{0,0,0}+0.8}}</annotation></semantics></math></td>
