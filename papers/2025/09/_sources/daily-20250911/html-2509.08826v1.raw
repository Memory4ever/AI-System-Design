<td class="ltx_td ltx_align_left ltx_border_tt"><math alttext="72.2_{{\color[rgb]{0,0,0}\definecolor[named]{pgfstrokecolor}{rgb}{0,0,0}+5.2}}" class="ltx_Math" display="inline" id="S4.T2.m3"><semantics><msub><mn>72.2</mn><mrow><mo>+</mo><mn>5.2</mn></mrow></msub><annotation encoding="application/x-tex">72.2_{{\color[rgb]{0,0,0}\definecolor[named]{pgfstrokecolor}{rgb}{0,0,0}+5.2}}</annotation></semantics></math></td>
