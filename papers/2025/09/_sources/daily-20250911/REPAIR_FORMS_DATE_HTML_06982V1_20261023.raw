<td id="S4.T3.5.2.3" class="ltx_td ltx_align_center ltx_border_t">4.53</td>
<td id="S4.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_t">57.06</td></tr>
<tr id="S4.T3.5.3" class="ltx_tr">
