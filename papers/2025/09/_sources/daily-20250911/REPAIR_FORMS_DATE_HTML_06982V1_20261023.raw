<td id="S4.T3.5.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T3.5.1.2.1" class="ltx_text ltx_font_bold">Quality (<math id="S4.T3.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></td>
<td id="S4.T3.5.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T3.5.1.3.1" class="ltx_text ltx_font_bold">HRR (<math id="S4.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></td>
<td id="S4.T3.5.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T3.5.1.4.1" class="ltx_text ltx_font_bold">Wait Tokens (<math id="S4.T3.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></td></tr>
