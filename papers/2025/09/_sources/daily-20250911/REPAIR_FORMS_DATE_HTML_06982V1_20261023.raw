</span></span></span>
<span id="A6.F7.pic1.1.3.8" class="ltx_tr">
<span id="A6.F7.pic1.1.3.8.1" class="ltx_td ltx_align_left ltx_align_top" style="--ltx-bg-color:#E6E6FF;">
<span id="A6.F7.pic1.1.3.8.1.1" class="ltx_inline-block ltx_align_top" style="width:324.6pt;">
