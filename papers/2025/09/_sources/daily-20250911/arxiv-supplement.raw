    </author>
    <author>
      <name>Peter Neigel</name>
    </author>
    <author>
      <name>Raj Bhalwankar</name>
    </author>
    <author>
      <name>Daniel Kondermann</name>
    </author>
    <author>
      <name>Sebastian J. Vollmer</name>
    </author>
