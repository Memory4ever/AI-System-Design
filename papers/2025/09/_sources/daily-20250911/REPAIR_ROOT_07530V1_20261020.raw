<td id="S5.T1.4.1.4.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.4.1.4.4.1" class="ltx_text" style="font-size:80%;">92.60</span></td>
<td id="S5.T1.4.1.4.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.4.1.4.5.1" class="ltx_text" style="font-size:80%;">14.59</span></td>
