<td id="S5.T1.4.1.4.7" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.4.1.4.7.1" class="ltx_text" style="font-size:80%;">0.4695</span></td></tr>
<tr id="S5.T1.4.1.5" class="ltx_tr">
<th id="S5.T1.4.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.4.1.5.1.1" class="ltx_text" style="font-size:80%;">Training-free</span></th>
<th id="S5.T1.4.1.5.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.4.1.5.2.1" class="ltx_text" style="font-size:80%;">Ctrl-X </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S5.T1.4.1.5.2.2" class="ltx_text" style="font-size:80%;">[</span><a href="#bib.bib29" title="" class="ltx_ref">29</a><span id="S5.T1.4.1.5.2.3" class="ltx_text" style="font-size:80%;">]</span></cite></th>
