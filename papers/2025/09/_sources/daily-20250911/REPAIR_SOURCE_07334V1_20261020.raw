<td id="S3.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m1" class="ltx_Math" alttext="&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">&gt;</annotation></semantics></math>10 years</td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
