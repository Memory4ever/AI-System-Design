<td id="S3.T1.2.3.4" class="ltx_td ltx_align_center">UI engineers</td>
<td id="S3.T1.2.3.5" class="ltx_td ltx_align_center"><math id="S3.T1.m2" class="ltx_Math" alttext="&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">&gt;</annotation></semantics></math>10 years</td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<td id="S3.T1.2.4.1" class="ltx_td ltx_align_center">P3</td>
<td id="S3.T1.2.4.2" class="ltx_td ltx_align_center">Male</td>
<td id="S3.T1.2.4.3" class="ltx_td ltx_align_center">32</td>
<td id="S3.T1.2.4.4" class="ltx_td ltx_align_center">UI engineers</td>
<td id="S3.T1.2.4.5" class="ltx_td ltx_align_center">5–10 years</td></tr>
<tr id="S3.T1.2.5" class="ltx_tr">
<td id="S3.T1.2.5.1" class="ltx_td ltx_align_center">P4</td>
<td id="S3.T1.2.5.2" class="ltx_td ltx_align_center">Female</td>
<td id="S3.T1.2.5.3" class="ltx_td ltx_align_center">26</td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_center">UI designers</td>
