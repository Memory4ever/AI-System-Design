<span id="S6.T4.2.1.1.1.1.1.1.4.3" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T4.2.1.1.1.1.1.1.4.3.1" class="ltx_text ltx_underline">86.6</span></span>
