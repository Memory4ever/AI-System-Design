<span id="S6.T4.2.1.1.1.1.1.1.4.12" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S6.T4.2.1.1.1.1.1.1.4.12.1" class="ltx_text ltx_underline">90.2</span></span></span>
