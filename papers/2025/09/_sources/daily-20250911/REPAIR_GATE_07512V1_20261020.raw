<td id="A4.T8.2.3.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A4.T8.2.3.2.1" class="ltx_text ltx_font_bold">88.7</span></td>
