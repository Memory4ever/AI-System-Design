{"data":[{"id":"10.48550/arxiv.2509.07552","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07552","identifiers":[{"identifier":"2509.07552","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peng","familyName":"Li","name":"Li, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yisheng","familyName":"He","name":"He, Yisheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingdong","familyName":"Hu","name":"Hu, Yingdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Dong","name":"Dong, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weihao","familyName":"Yuan","name":"Yuan, Weihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Liu","name":"Liu, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyu","familyName":"Zhu","name":"Zhu, Siyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Cheng","name":"Cheng, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zilong","familyName":"Dong","name":"Dong, Zilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steven","familyName":"Hoi","name":"Hoi, Steven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yike","familyName":"Guo","name":"Guo, Yike","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PanoLAM: Large Avatar Model for Gaussian Full-Head Synthesis from One-shot Unposed Image"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T09:42:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:34:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T11:20:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T00:42:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-10T04:04:34Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-14T00:29:22Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a feed-forward framework for static Gaussian full-head reconstruction and novel-view rendering from a single unposed image. Unlike previous work that relies on time-consuming GAN inversion and test-time optimization, our framework can reconstruct the Gaussian full-head model given a single unposed image in a single forward pass. This enables fast reconstruction and rendering during inference. To mitigate the lack of large-scale 3D head assets, we propose a large-scale synthetic dataset from trained 3D GANs and train our framework using only synthetic data. For efficient high-fidelity generation, we introduce a coarse-to-fine Gaussian head generation pipeline, where sparse points from the FLAME model interact with the image features by transformer blocks for feature extraction and coarse shape reconstruction, which are then densified for high-fidelity reconstruction. To fully leverage the prior knowledge residing in pretrained 3D GANs for effective reconstruction, we propose a dual-branch framework that effectively aggregates the structured spherical triplane feature and unstructured point-based features for more effective Gaussian head reconstruction. Experimental results show the effectiveness of our framework compared to existing work. The dataset is available at https://github.com/PanoLAM/PanoLAM_Dataset."},{"descriptionType":"Other","description":"Accepted to IEEE Transactions on Visualization and Computer Graphics (TVCG)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07552","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:43:57Z","registered":"2025-09-10T01:43:58Z","published":null,"updated":"2026-10-14T08:19:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07330","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07330","identifiers":[{"identifier":"2509.07330","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Li-Chin","familyName":"Chen","name":"Chen, Li-Chin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ji-Tian","familyName":"Sheu","name":"Sheu, Ji-Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuh-Jue","familyName":"Chuang","name":"Chuang, Yuh-Jue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"General Demographic Pre-trained Models for Enhancing Predictive Performance Across Diseases and Population"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T02:02:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:15:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-14T08:57:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:35:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-02T04:11:39Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-03T00:26:02Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Foundation models for healthcare require balancing robust generalization across heterogeneous clinical populations and disease settings with the architectural simplicity needed for deployment. We present a pre-trained model focused on demographic attributes that enhances feature utility across medical domains in a plug-and-play fashion. We introduce the General Demographic Pre-trained (GDP) model, designed to extract intrinsic representations of patient status based on age and sex, the two most ubiquitous clinical features. The composition of GDP was optimized by investigating various encoding methods and visit-reordering schemes. The model was pre-trained and transferability was validated by embedding the learned representations into diverse disease and geographic cohorts characterized by distinct demographic profiles. The optimal model configuration was subsequently validated against top-performing tabular foundation models (TabPFN, TabICL, and TabFM). Our findings demonstrate that concatenating GDP-derived embeddings with raw residual features consistently enhances predictive performance across classification tasks while elevating the relative importance of demographic attributes. The embedding transformation provides superior representational separability compared to the original data distribution, yielding competitive discrimination performance across metrics against all three general-purpose foundation models and tree-based algorithm. GDP has successfully served the purpose of a foundation model, which produce enriched representations that amplify the predictive insight of these features beyond their raw form. The generated embeddings can be directly concatenated with residual features, serving as an enhancement layer that maintains full compatibility with standard tabular classifiers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07330","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:38:45Z","registered":"2025-09-10T01:38:46Z","published":null,"updated":"2026-09-03T02:35:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07274","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07274","identifiers":[{"identifier":"2509.07274","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aida","familyName":"Kostikova","name":"Kostikova, Aida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ole","familyName":"Pütz","name":"Pütz, Ole","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steffen","familyName":"Eger","name":"Eger, Steffen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olga","familyName":"Sabelfeld","name":"Sabelfeld, Olga","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Paassen","name":"Paassen, Benjamin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM Analysis of 150+ years of German Parliamentary Debates on Migration Reveals Shift from Post-War Solidarity to Anti-Solidarity in the Last Decade"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T23:16:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:12:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-02T09:43:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-03T00:37:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-03T07:30:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-06T00:28:52Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08-27T13:31:30Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-08-28T00:54:21Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Migration has been a core topic in German political debate, from postwar expellee displacement to labor migration and recent refugee movements. Large-scale analysis of such political discourse has traditionally required extensive manual annotation, limiting coverage. Large language models (LLMs) offer a scalable alternative. Using a theory-driven annotation scheme, we examine how well LLMs annotate subtypes of solidarity and anti-solidarity in German parliamentary debates and whether the resulting labels support valid downstream inference. We first evaluate multiple LLMs across model size, prompting strategies, fine-tuning, historical versus contemporary data, and systematic errors. The strongest models, especially GPT-5 and gpt-oss-120B, achieve macro- F1 scores comparable to human agreement, although their systematic errors can bias downstream results. We therefore combine soft-label model outputs with Design-based Supervised Learning (DSL) to reduce bias in long-term trend estimates. Beyond the methodological evaluation, we interpret the resulting annotations from a social-scientific perspective across the Reichstag (1867- 1933), West German Bundestag (1949-1990) and Re-Unified German Bundestag (1990-2025) corpus to trace trends in solidarity and anti-solidarity toward migrants, with detailed analysis of postwar Germany (1949-1957) and contemporary Germany (2009-2025). We find relatively high levels of solidarity in the postwar period, especially in group-based and compassionate forms, and a marked rise in anti-solidarity since 2015. We argue that LLMs can support large-scale social-scientific text analysis, but their outputs require rigorous validation and, where systematic errors are present, statistical correction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07274","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:37:27Z","registered":"2025-09-10T01:37:27Z","published":null,"updated":"2026-08-28T02:40:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07260","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07260","identifiers":[{"identifier":"2509.07260","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Wang","name":"Wang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting","familyName":"Dang","name":"Dang, Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Zhang","name":"Zhang, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vassilis","familyName":"Kostakos","name":"Kostakos, Vassilis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael J.","familyName":"Witbrock","name":"Witbrock, Michael J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Jia","name":"Jia, Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HealthSLM-Bench: Benchmarking Small Language Models for Mobile and Wearable Healthcare Monitoring"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T22:36:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:11:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-20T12:03:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T00:28:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-29T11:48:40Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-30T01:56:05Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09-30T12:04:14Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-01T00:58:07Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-07-29T07:27:33Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-07-30T00:28:51Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Mobile and wearable healthcare monitoring play a vital role in facilitating timely interventions, managing chronic health conditions, and ultimately improving individuals' quality of life. Previous studies on large language models (LLMs) have highlighted their impressive generalization abilities and effectiveness in healthcare prediction tasks. However, most LLM-based healthcare solutions are cloud-based, which raises significant privacy concerns and results in increased memory usage and latency. To address these challenges, there is growing interest in compact models, Small Language Models (SLMs), which are lightweight and designed to run locally and efficiently on mobile and wearable devices. Nevertheless, how well these models perform in healthcare prediction remains largely unexplored. We systematically evaluated SLMs on health prediction tasks using zero-shot, few-shot, and instruction fine-tuning approaches, and deployed the best performing fine-tuned SLMs on mobile devices to evaluate their real-world efficiency and predictive performance in practical healthcare scenarios. Our results show that SLMs can achieve performance comparable to LLMs while offering substantial gains in efficiency and privacy. However, challenges remain, particularly in handling class imbalance and few-shot scenarios. These findings highlight SLMs, though imperfect in their current form, as a promising solution for next-generation, privacy-preserving healthcare monitoring."},{"descriptionType":"Other","description":"9 pages, 6 tables, 6 figures. Accepted at NeurIPS 2025 Workshop on GenAI4Health"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07260","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:37:07Z","registered":"2025-09-10T01:37:07Z","published":null,"updated":"2026-07-30T02:19:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07829","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07829","identifiers":[{"identifier":"2509.07829","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mihai","familyName":"Nadas","name":"Nadas, Mihai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laura","familyName":"Diosan","name":"Diosan, Laura","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreea","familyName":"Tomescu","name":"Tomescu, Andreea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrei","familyName":"Piscoran","name":"Piscoran, Andrei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Building Large-Scale English-Romanian Literary Translation Resources with Open Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T15:07:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:50:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-15T16:20:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-16T01:52:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-19T09:02:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-14T01:09:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-28T04:39:41Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-29T00:24:45Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3389/frai.2026.1807431","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Literary translation has recently gained attention as a distinct and complex task in machine translation research, yet translation by small open models remains an open problem, particularly for low-resource languages such as Romanian. We introduce the TinyFabulist Translation Framework (TF2), a unified framework for dataset creation, fine-tuning, and evaluation in English $\\to$ Romanian literary translation. Building on DS-TF1-EN-3M, the largest collection of synthetic English fables to date, our pipeline first generates 15k high-quality Romanian references from the TF1 pool using a high-performing large language model (LLM). We then apply a two-stage fine-tuning process to a 12B-parameter open-weight model: (i) instruction tuning to capture genre-specific narrative style, and (ii) adapter compression for efficient deployment. Evaluation combines a five-dimension LLM-based rubric (accuracy, fluency, coherence, style, cultural adaptation) as the primary comparative framework, alongside corpus-level Bilingual Evaluation Understudy (BLEU) reported as a secondary reference-based consistency metric. Our fine-tuned model (TF2-12B) achieves strong fluency and adequacy, narrowing the gap to top-performing proprietary models under automated and human-anchored evaluation, while being open, accessible, and significantly more cost-effective. We publicly release the fine-tuned model and two large-scale synthetic parallel datasets (DS-TF2-EN-RO-3M and DS-TF2-EN-RO-15K), along with all scripts and evaluation prompts. TF2 provides an end-to-end, reproducible pipeline for research on cost-efficient translation, cross-lingual narrative generation, and the broad adoption of open models for culturally significant literary content in low-resource settings."},{"descriptionType":"Other","description":"21 pages. Published version: Front. Artif. Intell. 9:1807431 (2026). Datasets and models released on Hugging Face"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07829","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:50:40Z","registered":"2025-09-10T01:50:41Z","published":null,"updated":"2026-07-29T02:27:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07068","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07068","identifiers":[{"identifier":"2509.07068","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Javier Mariño","familyName":"Villadamigo","name":"Villadamigo, Javier Mariño","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rikkert","familyName":"Frederix","name":"Frederix, Rikkert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tilman","familyName":"Plehn","name":"Plehn, Tilman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timea","familyName":"Vitos","name":"Vitos, Timea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramon","familyName":"Winterhalder","name":"Winterhalder, Ramon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FASTColor -- Full-color Amplitude Surrogate Toolkit for QCD"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T18:00:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-09T00:24:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-23T14:00:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-24T00:50:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.21468/scipostphys.21.1.001","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"High-multiplicity events remain a bottleneck for LHC simulations due to their computational cost. We present a ML-surrogate approach to accelerate matrix element reweighting from leading-color (LC) to full-color (FC) accuracy, building on recent advancements in LC event generation. Comparing a variety of modern network architectures for representative QCD processes, we achieve speed-up of around a factor two over the current LC-to-FC baseline. We also show how transformers learn and exploit underlying symmetries, to improve generalization. Given the gained trust in trained networks and developments in learned uncertainties, the LC-to-FC approach will eventually benefit further from not needing a final classic unweighting step."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07068","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:32:37Z","registered":"2025-09-10T01:32:38Z","published":null,"updated":"2026-07-24T02:11:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07706","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07706","identifiers":[{"identifier":"2509.07706","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yildiray","familyName":"Kabak","name":"Kabak, Yildiray","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gokce B. Laleci","familyName":"Erturkmen","name":"Erturkmen, Gokce B. Laleci","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mert","familyName":"Gencturk","name":"Gencturk, Mert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tuncay","familyName":"Namli","name":"Namli, Tuncay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. Anil","familyName":"Sinaci","name":"Sinaci, A. Anil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruben Alcantud","familyName":"Corcoles","name":"Corcoles, Ruben Alcantud","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristina Gomez","familyName":"Ballesteros","name":"Ballesteros, Cristina Gomez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro","familyName":"Abizanda","name":"Abizanda, Pedro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asuman","familyName":"Dogac","name":"Dogac, Asuman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FHIR-RAG-MEDS: Integrating HL7 FHIR with Retrieval-Augmented Large Language Models for Enhanced Medical Decision Support"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:10:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:43:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-26T07:39:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-03T00:29:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3390/ai7070246","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, we propose FHIR-RAG-MEDS system that aims to integrate Health Level 7 Fast Healthcare Interoperability Resources (HL7 FHIR) with a Retrieval-Augmented Generation (RAG)-based system to improve personalized medical decision support on evidence-based clinical guidelines, emphasizing the need for research in practical applications. In the evolving landscape of medical decision support systems, integrating advanced technologies such as RAG and HL7 FHIR can significantly enhance clinical decision-making processes. Despite the potential of these technologies, there is limited research on their integration in practical applications."},{"descriptionType":"Other","description":"23 pages, submitted to Journal AI specifically to the special issue \"LLMs and AI Agents in Biomedical and Health Sciences\", under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07706","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:47:40Z","registered":"2025-09-10T01:47:40Z","published":null,"updated":"2026-07-03T02:12:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07150","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07150","identifiers":[{"identifier":"2509.07150","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andy","familyName":"Xu","name":"Xu, Andy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rohan","familyName":"Desai","name":"Desai, Rohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Larry","familyName":"Wang","name":"Wang, Larry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ethan","familyName":"Ritz","name":"Ritz, Ethan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriel","familyName":"Hope","name":"Hope, Gabriel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PLaID++: A Preference Aligned Language Model for Targeted Inorganic Materials Design"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T18:57:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:06:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-17T04:59:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-20T00:23:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-21T13:26:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-23T01:48:23Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-11T02:06:05Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-12T00:20:05Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning from Verifiable Rewards (RLVR) has emerged as a promising approach to improve correctness in LLMs, however, in many scientific problems, the objective is not necessarily to produce the correct answer, but instead to produce a diverse array of candidates which satisfy a set of constraints. We study this challenge in the context of materials generation. To this end, we introduce PLaID++, an LLM post-trained for stable and property-guided crystal generation. We find that performance hinges on our crystallographic representation and reward formulation. First, we introduce a compact, symmetry-informed Wyckoff text representation which improves computational efficiency and encourages generalization from physical priors. Second, we demonstrate that temperature scaling acts as an entropy regularizer which counteracts mode collapse and encourages exploration. By encoding symmetry constraints directly into text and guiding model outputs towards desirable chemical space, PLaID++ generates structures that are thermodynamically stable, unique, and novel at a $\\sim$50\\% greater rate than prior methods and conditionally generates structures with desired space group properties. Our work demonstrates the potential of adapting post-training techniques from natural language processing to materials design, paving the way for targeted and efficient discovery of novel materials."},{"descriptionType":"Other","description":"Code available at https://github.com/andaero/PLaID, model weights at https://huggingface.co/HOPE-Lab-HMC/PLaID"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07150","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:34:31Z","registered":"2025-09-10T01:34:32Z","published":null,"updated":"2026-06-12T02:19:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07126","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07126","identifiers":[{"identifier":"2509.07126","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kateryna","familyName":"Melnyk","name":"Melnyk, Kateryna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lee","familyName":"Friedman","name":"Friedman, Lee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oleg","familyName":"Komogortsev","name":"Komogortsev, Oleg","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gaze Prediction as Time-Series Forecasting for Virtual Reality Applications: Quantifying Performance Variability and Extreme-Case Errors"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T18:27:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:04:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-29T17:21:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T00:06:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3797246.3803043","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Gaze prediction is essential for addressing motion-to-photon latency and ensuring seamless foveated rendering in Virtual Reality. The reliability of gaze forecasting is highly sensitive to individual differences and the eye movements being predicted. We evaluate recurrent, transformer-based, and classification-guided architectures to assess their generalization capabilities across oculomotor events. Using the GazeBase VR and Meta Quest Pro datasets, we analyzed the relationship between the median (P50) and high-percentile (P95) error profiles across subjects. The analysis reveals significant performance variability, showing that subjects with low P50 errors do not always exhibit the lowest extreme-case errors. Consequently, low median errors do not guarantee the robustness of the utilized solution. We discuss inference performance and address the class imbalance problem in short-term gaze prediction. These results identify a gap in standardized evaluation methods, necessitating a shift toward P95-focused, subject-specific metrics to develop reliable and perceptually stable gaze-contingent systems."},{"descriptionType":"Other","description":"11 pages, 2 figures. To appear in the Proceedings of the 2026 ACM Symposium on Eye Tracking Research and Applications (ETRA '26). Dataset and source code available at https://hdl.handle.net/10877/23835"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07126","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:33:58Z","registered":"2025-09-10T01:33:59Z","published":null,"updated":"2026-06-02T04:52:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07961","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07961","identifiers":[{"identifier":"2509.07961","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Valen","familyName":"Tagliabue","name":"Tagliabue, Valen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leonard","familyName":"Dung","name":"Dung, Leonard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Probing the Preferences of a Language Model: Integrating Verbal and Behavioral Tests of AI Welfare"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:48:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:55:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-23T11:23:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-26T00:33:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop new experimental paradigms for measuring welfare in language models. We compare verbal reports of models about their preferences with preferences expressed through behavior when navigating a virtual environment and selecting conversation topics. We also test how costs and rewards affect behavior and whether responses to an eudaimonic welfare scale - measuring states such as autonomy and purpose in life - are stable across semantically equivalent prompts. Overall, we observed a notable degree of mutual support between our measures. The reliable correlations observed between stated preferences and behavior across conditions suggest that preference satisfaction can, in principle, serve as an empirically measurable welfare proxy in some of today's AI systems. Furthermore, our design offered an illuminating setting for qualitative observation of model behavior. Yet, the consistency between measures was more pronounced in some models and conditions than others and responses were changed by perturbations. Due to this, and the background uncertainty about the nature of welfare and the cognitive states (and welfare subjecthood) of language models, we are currently uncertain whether our methods successfully measure the welfare state of language models. Nevertheless, these findings highlight the feasibility of welfare measurement in language models, inviting further exploration."},{"descriptionType":"Other","description":"Forthcoming in Philosophy and the Mind Sciences (PhiMiSci)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07961","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:44Z","registered":"2025-09-10T01:53:44Z","published":null,"updated":"2026-05-26T04:03:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07120","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07120","identifiers":[{"identifier":"2509.07120","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chung-Shien Brian","familyName":"Wang","name":"Wang, Chung-Shien Brian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Schmidt","name":"Schmidt, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jens","familyName":"Piekenbrinck","name":"Piekenbrinck, Jens","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bastian","familyName":"Leibe","name":"Leibe, Bastian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Block-Sparse Global Attention for Efficient Multi-View Geometry Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T18:16:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:04:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-20T17:17:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-21T01:14:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficient and accurate feed-forward multi-view reconstruction has long been an important task in computer vision. Recent transformer-based models like VGGT, $π^3$ and MapAnything have demonstrated remarkable performance with relatively simple architectures. However, their scalability is fundamentally constrained by the quadratic complexity of global attention, which imposes a significant runtime bottleneck when processing large image sets. In this work, we empirically analyze the global attention matrix of these models and observe that the probability mass concentrates on a small subset of patch-patch interactions corresponding to cross-view geometric correspondences. Building on this insight and inspired by recent advances in large language models, we propose a training-free, block-sparse replacement for dense global attention, implemented with highly optimized kernels. Our method accelerates inference by more than $3\\times$ while maintaining comparable task performance. Evaluations on a comprehensive suite of multi-view benchmarks demonstrate that our approach seamlessly integrates into existing global attention-based architectures such as VGGT, $π^3$ , and MapAnything, while substantially improving scalability to large image collections."},{"descriptionType":"Other","description":"Project page at https://vision.rwth-aachen.de/sparse-vggt"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07120","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:33:50Z","registered":"2025-09-10T01:33:51Z","published":null,"updated":"2026-05-21T02:34:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.06984","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.06984","identifiers":[{"identifier":"2509.06984","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lishan","familyName":"Yang","name":"Yang, Lishan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei Emma","familyName":"Zhang","name":"Zhang, Wei Emma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nam Kha","familyName":"Nguygen","name":"Nguygen, Nam Kha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Po","familyName":"Hu","name":"Hu, Po","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanjun","familyName":"Shu","name":"Shu, Yanjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weitong","familyName":"Chen","name":"Chen, Weitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mong Yuan","familyName":"Sim","name":"Sim, Mong Yuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FediLoRA: Practical Federated Fine-Tuning of Foundation Models Under Missing-Modality Constraints"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.11","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-01T10:40:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:00:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T04:55:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:30:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-18T12:48:12Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-19T02:05:10Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Federated Learning with LoRA fine-tuning offers an efficient and privacy-aware solution for institutions to collaboratively leverage their large datasets to train VLLMs. However, participating institutions often possess heterogeneous computational resources, resulting in imbalanced LoRA ranks, which pose a major challenge for effective collaboration. In addition, real-world applications in domains such as healthcare and transportation frequently suffer from missing modalities due to user mistakes or device failures, which significantly degrade global model performance in federated settings. To the best of our knowledge, no prior work has addressed these two challenges simultaneously in federated VLLMs. To tackle these issues, we propose FediLoRA, a lightweight federated LoRA aggregation framework that effectively mitigates the impact of missing modalities in heterogeneous environment. FediLoRA is explicitly motivated by the observation that simple averaging and structured editing can jointly benefit both global and personalized models. Our approach achieves strong performance across multiple general-domain and medical-domain benchmark datasets. Additional experiments on healthcare data further demonstrate that FediLoRA is well-suited for practical, real-world deployment scenarios. Our code is released at https://github.com/gotobcn8/FediLoRA."},{"descriptionType":"Other","description":"8 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.06984","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:30:35Z","registered":"2025-09-10T01:30:36Z","published":null,"updated":"2026-05-19T04:47:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07794","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07794","identifiers":[{"identifier":"2509.07794","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minghan","familyName":"Li","name":"Li, Minghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinxuan","familyName":"Lv","name":"Lv, Xinxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Zou","name":"Zou, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongna","familyName":"Chen","name":"Chen, Tongna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Zhang","name":"Zhang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suchao","familyName":"An","name":"An, Suchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ercong","familyName":"Nie","name":"Nie, Ercong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guodong","familyName":"Zhou","name":"Zhou, Guodong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Query Expansion in the Age of Pre-trained and Large Language Models: A Comprehensive Survey"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T14:31:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:48:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-25T13:13:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-28T00:36:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-07T13:52:42Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-08T01:02:39Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern information retrieval must reconcile short, ambiguous queries with increasingly diverse and dynamic corpora. Query expansion (QE) remains a core technique for mitigating vocabulary mismatch, but its design space has been reshaped by pre-trained and large language models (PLMs/LLMs). This survey reviews QE methods in the PLM/LLM era and provides a unified view of the emerging landscape. We first summarize how different model families enable new expansion behaviors, including stronger contextualization, more controllable generation, and instruction-following. We then organize recent techniques along four complementary design dimensions: where expansion is injected in the pipeline, how it is grounded and interacts with corpus evidence, how it is learned or aligned, and how structured knowledge such as knowledge graphs is incorporated. Beyond taxonomy, we synthesize application patterns and deployment considerations across representative retrieval settings, highlighting practical trade-offs among effectiveness, controllability, grounding quality, and operating cost. Finally, we outline open challenges and future directions toward more reliable, safe, efficient, and continually adaptive QE under real-world constraints."},{"descriptionType":"Other","description":"42 pages,10 figures,6 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07794","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:49:50Z","registered":"2025-09-10T01:49:51Z","published":null,"updated":"2026-05-08T12:51:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07966","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07966","identifiers":[{"identifier":"2509.07966","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Boammani Aser","familyName":"Lompo","name":"Lompo, Boammani Aser","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc","familyName":"Haraoui","name":"Haraoui, Marc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Visual-TableQA: Open-Domain Benchmark for Reasoning over Table Images"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:52:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:56:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-21T15:48:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-22T01:07:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Visual reasoning over structured data such as tables is a critical capability for modern vision-language models (VLMs), yet current benchmarks remain limited in scale, diversity, or reasoning depth, especially when it comes to rendered table images. Addressing this gap, we introduce Visual-TableQA, a large-scale, open-domain multimodal dataset specifically designed to evaluate and enhance visual reasoning over complex tabular data. Our generation pipeline is modular, scalable, and fully autonomous, involving multiple reasoning LLMs collaborating across distinct roles: generation, validation, and inspiration. Visual-TableQA comprises 2.5k richly structured LaTeX-rendered tables and 6k reasoning-intensive QA pairs, all produced at a cost of under USD 100. To promote diversity and creativity, our pipeline performs multi-model collaborative data generation via cross-model prompting ('inspiration') and LLM-jury filtering. Stronger models seed layouts and topics that weaker models elaborate, collectively distilling diverse reasoning patterns and visual structures into the dataset. Empirical results show that models fine-tuned on Visual-TableQA generalize robustly to external benchmarks, outperforming several proprietary models despite the dataset's synthetic nature. The full pipeline and resources are publicly available at https://github.com/AI-4-Everyone/Visual-TableQA."},{"descriptionType":"Other","description":"Accepted at the First Workshop on Foundations of Reasoning in Language Models, NeurIPS 2025. Available at: https://openreview.net/forum?id=fvJRsGwhPf"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07966","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:51Z","registered":"2025-09-10T01:53:52Z","published":null,"updated":"2026-04-22T02:29:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07177","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07177","identifiers":[{"identifier":"2509.07177","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amal","familyName":"Chebbi","name":"Chebbi, Amal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Babajide","familyName":"Kolade","name":"Kolade, Babajide","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards EnergyGPT: A Large Language Model Specialized for the Energy Sector"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T19:48:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:07:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-07T16:14:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-10T01:40:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-14T15:07:25Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-15T01:00:52Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models have demonstrated impressive capabilities across various domains. However, their general-purpose nature often limits their effectiveness in specialized fields such as energy, where deep technical expertise and precise domain knowledge are essential. In this paper, we introduce EnergyGPT, a domain-specialized language model tailored for the energy sector, developed by fine-tuning the LLaMA 3.1-8B model on a high-quality, curated corpus of energy-related texts. We consider two adaptation strategies: a full-parameter Supervised Fine-Tuning variant and a parameter-efficient LoRA-based variant that updates only a small fraction of the model parameters. We present a complete development pipeline, including data collection and curation, model fine-tuning, benchmark design and LLM-judge choice, evaluation, and deployment. Through this work, we demonstrate that our training strategy enables improvements in domain relevance and performance without the need for large-scale infrastructure. By evaluating the performance of both EnergyGPT variants using domain-specific question-answering benchmarks, our results show that the adapted models consistently outperform the base model in most energy-related language understanding and generation tasks, with the LoRA variant achieving competitive gains at significantly reduced training cost."},{"descriptionType":"Other","description":"Code and artifacts available at: https://github.com/fitila/energygpt-release"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07177","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:35:11Z","registered":"2025-09-10T01:35:12Z","published":null,"updated":"2026-04-15T02:23:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07379","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07379","identifiers":[{"identifier":"2509.07379","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuning","familyName":"Zhang","name":"Zhang, Yuning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Grant","familyName":"Pinkert","name":"Pinkert, Grant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Yang","name":"Yang, Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanli","familyName":"Li","name":"Li, Yanli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yuan","name":"Yuan, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DuoServe-MoE: Dual-Phase Expert Prefetch and Caching for LLM Inference QoS Assurance"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T04:00:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:20:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-09T05:45:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-10T00:29:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly deployed as Internet/Web services (LLM-as-a-Service) with strict latency Service-Level Objectives (SLOs) under tight GPU memory budgets. Mixture-of-Experts (MoE) models improve quality and throughput via sparse expert activation, but serving them efficiently is challenging because expert weights dominate memory footprint and incur costly host--device transfers when offloaded. Moreover, MoE serving exhibits a phase disparity: the prefill phase tends to activate experts densely across many tokens, while the decode phase activates only a few experts per step. A uniform expert loading/caching policy across phases leads to either peak-memory blowup (prefill) or tail-latency inflation (decode). We present DuoServe-MoE, a QoS-oriented MoE serving system that decouples prefill and decode and applies phase-specialized expert scheduling. For prefill, DuoServe-MoE uses a two-stream CUDA pipeline to overlap expert prefetching with non-MoE computation, reducing expert residency time and peak GPU memory. For decode, it employs a lightweight layer-level predictor trained offline from activation traces to prefetch only likely experts without model changes. Experiments on representative MoE LLMs show that DuoServe-MoE improves TTFT by up to $5.34\\times$ and end-to-end latency by up to $7.55\\times$ over representative baselines, while maintaining low runtime GPU memory usage under resource-constrained deployment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07379","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:39:54Z","registered":"2025-09-10T01:39:54Z","published":null,"updated":"2026-04-10T02:23:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07149","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07149","identifiers":[{"identifier":"2509.07149","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anatoly A.","familyName":"Krasnovsky","name":"Krasnovsky, Anatoly A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Measuring Uncertainty in Transformer Circuits with Effective Information Consistency"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T18:54:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-07T00:49:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3103/s0005105525701365","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Mechanistic interpretability has identified functional subgraphs within large language models (LLMs), known as Transformer Circuits (TCs), that appear to implement specific algorithms. Yet we lack a formal, single-pass way to quantify when an active circuit is behaving coherently and thus likely trustworthy. Building on prior systems-theoretic proposals, we specialize a sheaf/cohomology and causal emergence perspective to TCs and introduce the Effective-Information Consistency Score (EICS). EICS combines (i) a normalized sheaf inconsistency computed from local Jacobians and activations, with (ii) a Gaussian EI proxy for circuit-level causal emergence derived from the same forward state. The construction is white-box, single-pass, and makes units explicit so that the score is dimensionless. We further provide practical guidance on score interpretation, computational overhead (with fast and exact modes), and a toy sanity-check analysis. Empirical validation on LLM tasks is deferred."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07149","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":2,"created":"2025-09-10T01:34:30Z","registered":"2025-09-10T01:34:31Z","published":null,"updated":"2026-04-07T03:25:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07553","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07553","identifiers":[{"identifier":"2509.07553","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zheng","familyName":"Wu","name":"Wu, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heyuan","familyName":"Huang","name":"Huang, Heyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingyu","familyName":"Lou","name":"Lou, Xingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangmou","familyName":"Qu","name":"Qu, Xiangmou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengzhou","familyName":"Cheng","name":"Cheng, Pengzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zongru","familyName":"Wu","name":"Wu, Zongru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiwen","familyName":"Liu","name":"Liu, Weiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weinan","familyName":"Zhang","name":"Zhang, Weinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Wang","name":"Wang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoxiang","familyName":"Wang","name":"Wang, Zhaoxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuosheng","familyName":"Zhang","name":"Zhang, Zhuosheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VeriOS: Query-Driven Proactive Human-Agent-GUI Interaction for Trustworthy OS Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T09:46:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:34:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T03:25:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:19:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-03T02:36:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-06T00:17:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid progress of multimodal large language models, operating system (OS) agents become increasingly capable of automating tasks through on-device graphical user interfaces (GUIs). However, most existing OS agents are designed for idealized settings, whereas real-world environments often present untrustworthy conditions. To mitigate risks of over-execution in such scenarios, we propose a query-driven human-agent-GUI interaction framework that enables OS agents to decide when to query humans for more reliable task completion. Built upon this framework, we introduce VeriOS-Agent, a trustworthy OS agent trained with a three-stage learning paradigm that falicitate the decoupling and utilization of meta-knowledge by supervised fine-tuning and group relative policy optimization. Concretely, VeriOS-Agent autonomously executes actions in normal conditions while proactively querying humans in untrustworthy scenarios. Experiments show that VeriOS-Agent improves the average step-wise success rate by 19.72\\% in over the strongest baselines, without compromising normal performance. VeriOS-Agent significantly improves performance in untrustworthy scenarios while maintaining comparable performance in trustworthy scenarios. Analysis highlights VeriOS-Agent's rationality, generalizability, and scalability. The codes, datasets and models are available at https://github.com/Wuzheng02/VeriOS."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07553","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:43:58Z","registered":"2025-09-10T01:43:59Z","published":null,"updated":"2026-04-06T01:48:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07252","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07252","identifiers":[{"identifier":"2509.07252","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Evgeny Alves","familyName":"Limarenko","name":"Limarenko, Evgeny Alves","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anastasiia","familyName":"Studenikina","name":"Studenikina, Anastasiia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Svetlana","familyName":"Illarionova","name":"Illarionova, Svetlana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxim","familyName":"Sharaev","name":"Sharaev, Maxim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GCond: Gradient Conflict Resolution via Accumulation-based Stabilization for Large-Scale Multi-Task Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T22:02:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:10:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-01T20:57:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-03T00:07:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/access.2026.3673372","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In multi-task learning (MTL), gradient conflict poses a significant challenge. Effective methods for addressing this problem, including PCGrad, CAGrad, and GradNorm, in their original implementations are computationally demanding, which significantly limits their application in modern large models such as transformers. We propose Gradient Conductor (GCond), a method that builds upon PCGrad principles by combining them with gradient accumulation and an adaptive arbitration mechanism. We evaluated GCond on self-supervised multi-task learning tasks using MobileNetV3-Small and ConvNeXt architectures on the ImageNet 1K dataset and a combined head and neck CT scan dataset, comparing the proposed method against baseline linear combinations and state-of-the-art gradient conflict resolution methods. The classical and stochastic approaches of GCond were analyzed. The stochastic mode of GCond achieved a two-fold computational speedup while maintaining optimization quality, and demonstrated superior performance across all evaluated metrics, achieving lower L1 and SSIM losses compared to other methods on both datasets, and demonstrating superior generalization in heterogeneous scenarios: GCond improved ImageNet Top-1 Accuracy by 4.5% over baselines and prevented confidence overfitting in medical diagnosis tasks. GCond exhibited high scalability, being successfully applied to both compact models: MobileNetV3-Small and ConvNeXt-tiny; and large architecture ConvNeXtV2-Base. It also showed compatibility with modern optimizers such as AdamW and Lion/LARS. Therefore, GCond offers a scalable and efficient solution to the problem of gradient conflicts in multi-task learning."},{"descriptionType":"Other","description":"Published in IEEE Access. This work is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 License (CC BY-NC-ND 4.0)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07252","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:36:55Z","registered":"2025-09-10T01:36:56Z","published":null,"updated":"2026-04-03T02:14:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07946","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07946","identifiers":[{"identifier":"2509.07946","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kasra","familyName":"Borazjani","name":"Borazjani, Kasra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naji","familyName":"Khosravan","name":"Khosravan, Naji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajeev","familyName":"Sahay","name":"Sahay, Rajeev","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bita","familyName":"Akram","name":"Akram, Bita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seyyedali","familyName":"Hosseinalipour","name":"Hosseinalipour, Seyyedali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bringing Multi-Modal Multi-Task Federated Foundation Models to Education Domain: Prospects and Challenges"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:31:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-25T00:12:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3389/frai.2025.1683960","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-modal multi-task (M3T) foundation models (FMs) have recently shown transformative potential in artificial intelligence, with emerging applications in education. However, their deployment in real-world educational settings is hindered by privacy regulations, data silos, and limited domain-specific data availability. We introduce M3T Federated Foundation Models (FedFMs) for education: a paradigm that integrates federated learning (FL) with M3T FMs to enable collaborative, privacy-preserving training across decentralized institutions while accommodating diverse modalities and tasks. Subsequently, this position paper aims to unveil M3T FedFMs as a promising yet underexplored approach to the education community, explore its potentials, and reveal its related future research directions. We outline how M3T FedFMs can advance three critical pillars of next-generation intelligent education systems: (i) privacy preservation, by keeping sensitive multi-modal student and institutional data local; (ii) personalization, through modular architectures enabling tailored models for students, instructors, and institutions; and (iii) equity and inclusivity, by facilitating participation from underrepresented and resource-constrained entities. We finally identify various open research challenges, including studying of (i) inter-institution heterogeneous privacy regulations, (ii) the non-uniformity of data modalities' characteristics, (iii) the unlearning approaches for M3T FedFMs, (iv) the continual learning frameworks for M3T FedFMs, and (v) M3T FedFM model interpretability, which must be collectively addressed for practical deployment."},{"descriptionType":"Other","description":"12 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07946","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:53:23Z","registered":"2025-09-10T01:53:24Z","published":null,"updated":"2026-03-25T02:31:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07968","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07968","identifiers":[{"identifier":"2509.07968","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lukas","familyName":"Haas","name":"Haas, Lukas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gal","familyName":"Yona","name":"Yona, Gal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giovanni","familyName":"D'Antonio","name":"D'Antonio, Giovanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sasha","familyName":"Goldshtein","name":"Goldshtein, Sasha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dipanjan","familyName":"Das","name":"Das, Dipanjan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SimpleQA Verified: A Reliable Factuality Benchmark to Measure Parametric Knowledge"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:53:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:56:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-10T12:28:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-11T00:55:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce SimpleQA Verified, a 1,000-prompt benchmark for evaluating Large Language Model (LLM) short-form factuality based on OpenAI's SimpleQA. It addresses critical limitations in OpenAI's benchmark, including noisy and incorrect labels, topical biases, and question redundancy. SimpleQA Verified was created through a rigorous multi-stage filtering process involving de-duplication, topic balancing, and source reconciliation to produce a more reliable and challenging evaluation set, alongside improvements in the autorater prompt. On this new benchmark, Gemini 2.5 Pro achieves a state-of-the-art F1-score of 55.6, outperforming other frontier models, including GPT-5. This work provides the research community with a higher-fidelity tool to track genuine progress in parametric model factuality and to mitigate hallucinations. The benchmark dataset, evaluation code, and leaderboard are available at: https://www.kaggle.com/benchmarks/deepmind/simpleqa-verified."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07968","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:54Z","registered":"2025-09-10T01:53:54Z","published":null,"updated":"2026-03-11T02:33:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07945","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07945","identifiers":[{"identifier":"2509.07945","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuan","familyName":"Pu","name":"Pu, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yazhe","familyName":"Niu","name":"Niu, Yazhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Tang","name":"Tang, Jia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyu","familyName":"Xiong","name":"Xiong, Junyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Hu","name":"Hu, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongsheng","familyName":"Li","name":"Li, Hongsheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"One Model for All Tasks: Leveraging Efficient World Models in Multi-Task Planning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:27:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:55:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T11:04:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:40:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-06T09:10:23Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-09T00:33:48Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In heterogeneous multi-task decision-making, tasks not only exhibit diverse observation and action spaces but also vary substantially in their underlying complexities. While conventional multi-task world models like UniZero excel in single-task settings, we find that when handling a broad and diverse suite of tasks, gradient conflicts and the loss of model plasticity often constrain their sample efficiency. In this work, we address these challenges from two complementary perspectives: the single learning iteration and the overall learning process. First, to mitigate the gradient conflicts, we systematically investigate key architectural designs for extending UniZero. Our investigation identifies a Mixture-of-Experts (MoE) architecture as the most effective approach. We demonstrate, both theoretically and empirically, that this architecture alleviates gradient conflicts by routing task-specific representations to specialized sub-networks. This finding leads to our proposed model, \\textit{ScaleZero}. Second, to dynamically allocate model capacity throughout the learning process, we introduce an online Dynamic Parameter Scaling (DPS) strategy. This strategy progressively integrates LoRA adapters in response to task-specific progress, enabling adaptive knowledge retention and parameter expansion. Evaluations on a diverse set of standard benchmarks (Atari, DMC, Jericho) demonstrate that ScaleZero, utilizing solely online reinforcement learning with one model, performs on par with specialized single-task agents. With the DPS strategy, it remains competitive while using just 71.5% of the environment interactions. These findings underscore the potential of ScaleZero for effective multi-task planning. Our code is available at \\textcolor{magenta}{https://github.com/opendilab/LightZero}."},{"descriptionType":"Other","description":"55 pages, 20 figures. Accepted as a conference paper at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07945","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:22Z","registered":"2025-09-10T01:53:23Z","published":null,"updated":"2026-03-09T02:08:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07430","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07430","identifiers":[{"identifier":"2509.07430","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Long","familyName":"Li","name":"Li, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijian","familyName":"Zhou","name":"Zhou, Zhijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaran","familyName":"Hao","name":"Hao, Jiaran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason Klein","familyName":"Liu","name":"Liu, Jason Klein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanting","familyName":"Miao","name":"Miao, Yanting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Pang","name":"Pang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyu","familyName":"Tan","name":"Tan, Xiaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Chu","name":"Chu, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Wang","name":"Wang, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shirui","familyName":"Pan","name":"Pan, Shirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Qu","name":"Qu, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Qi","name":"Qi, Yuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Choice of Divergence: A Neglected Key to Mitigating Diversity Collapse in Reinforcement Learning with Verifiable Reward"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T06:34:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:24:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-17T09:26:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-20T00:35:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-11T08:10:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-12T01:32:30Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-03T07:36:26Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-04T01:32:22Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A central paradox in fine-tuning Large Language Models (LLMs) with Reinforcement Learning with Verifiable Reward (RLVR) is the frequent degradation of multi-attempt performance (Pass@k) despite improvements in single-attempt accuracy (Pass@1). This is often accompanied by catastrophic forgetting, where models lose previously acquired skills. While various methods have been proposed, the choice and function of the divergence term have been surprisingly unexamined as a proactive solution. We argue that standard RLVR objectives -- both those using the mode-seeking reverse KL-divergence and those forgoing a divergence term entirely -- lack a crucial mechanism for knowledge retention. The reverse-KL actively accelerates this decay by narrowing the policy, while its absence provides no safeguard against the model drifting from its diverse knowledge base. We propose a fundamental shift in perspective: using the divergence term itself as the solution. Our framework, Diversity-Preserving Hybrid RL (DPH-RL), leverages mass-covering f-divergences (like forward-KL and JS-divergence) to function as a rehearsal mechanism. By continuously referencing the initial policy, this approach forces the model to maintain broad solution coverage. Extensive experiments on math and SQL generation demonstrate that DPH-RL not only resolves the Pass@k degradation but improves both Pass@1 and Pass@k in- and out-of-domain. Additionally, DPH-RL is more training-efficient because it computes f-divergence using generator functions, requiring only sampling from the initial policy and no online reference model. Our work highlights a crucial, overlooked axis for improving RLVR, demonstrating that the proper selection of a divergence measure is a powerful tool for building more general and diverse reasoning models."},{"descriptionType":"Other","description":"27 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07430","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:41:07Z","registered":"2025-09-10T01:41:07Z","published":null,"updated":"2026-03-04T03:17:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07825","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07825","identifiers":[{"identifier":"2509.07825","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuoxu","familyName":"Huang","name":"Huang, Zhuoxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingqi","familyName":"Gao","name":"Gao, Mingqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungong","familyName":"Han","name":"Han, Jungong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Point Linguist Model: Segment Any Object via Bridged Large 3D-Language Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T15:01:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:49:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-19T12:56:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-20T01:41:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"3D object segmentation with Large Language Models (LLMs) has become a prevailing paradigm due to its broad semantics, task flexibility, and strong generalization. However, this paradigm is hindered by representation misalignment: LLMs process high-level semantic tokens, whereas 3D point clouds convey only dense geometric structures. In prior methods, misalignment limits both input and output. At the input stage, dense point patches require heavy pre-alignment, weakening object-level semantics and confusing similar distractors. At the output stage, predictions depend only on dense features without explicit geometric cues, leading to a loss of fine-grained accuracy. To address these limitations, we present the Point Linguist Model (PLM), a general framework that bridges the representation gap between LLMs and dense 3D point clouds without requiring large-scale pre-alignment between 3D-text or 3D-images. Specifically, we introduce Object-centric Discriminative Representation (OcDR), which learns object-centric tokens that capture target semantics and scene relations under a hard negative-aware training objective. This mitigates the misalignment between LLM tokens and 3D points, enhances resilience to distractors, and facilitates semantic-level reasoning within LLMs. For accurate segmentation, we introduce the Geometric Reactivation Decoder (GRD), which predicts masks by combining OcDR tokens carrying LLM-inferred geometry with corresponding dense features, preserving comprehensive dense features throughout the pipeline. Extensive experiments show that PLM achieves significant improvements of +7.3 mIoU on ScanNetv2 and +6.0 mIoU on Multi3DRefer for 3D referring segmentation, with consistent gains across 7 benchmarks spanning 4 different tasks, demonstrating the effectiveness of comprehensive object-centric reasoning for robust 3D understanding."},{"descriptionType":"Other","description":"Accepted by IEEE Transactions on Multimedia (TMM)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07825","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:50:35Z","registered":"2025-09-10T01:50:36Z","published":null,"updated":"2026-02-20T03:02:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07820","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07820","identifiers":[{"identifier":"2509.07820","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"João Paulo","familyName":"Nogueira","name":"Nogueira, João Paulo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Sun","name":"Sun, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alonso","familyName":"Silva","name":"Silva, Alonso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laith","familyName":"Zumot","name":"Zumot, Laith","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Certainty-Guided Reasoning in Large Language Models: A Dynamic Thinking Budget Approach"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T14:57:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-01-13T02:18:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-09T16:10:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-10T03:03:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large reasoning language models are typically run with fixed inference budgets, which can waste computation or terminate reasoning prematurely. We introduce Certainty-Guided Reasoning (CGR), a model-agnostic adaptive inference procedure that periodically probes whether the current reasoning supports a confident final answer and terminates early once a target certainty threshold is reached, otherwise continuing until the end-of-thinking token or the budget limit. Certainty is estimated from the model's predicted probabilities over the answer tokens, yielding a lightweight stopping criterion. On AIME2025, CGR preserves baseline accuracy while reducing token usage, providing a tunable certainty-efficiency trade-off that can eliminate millions of tokens in aggregate. Across 64 random seeds, CGR exhibits consistent behavior. We also introduce a Grade metric that penalizes incorrect answers and permits abstention, capturing risk-sensitive performance. Results show that CGR improves Grade by abstaining when certainty remains low."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07820","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:50:27Z","registered":"2025-09-10T01:50:28Z","published":null,"updated":"2026-02-10T05:19:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07593","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07593","identifiers":[{"identifier":"2509.07593","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaowen","familyName":"Tao","name":"Tao, Xiaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinuo","familyName":"Wang","name":"Wang, Yinuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinzhao","familyName":"Zhou","name":"Zhou, Jinzhao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vision-Proprioception Fusion with Mamba2 in End-to-End Reinforcement Learning for Motion Control"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T11:05:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:37:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-25T07:52:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T01:22:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.aei.2026.104389","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"End-to-end reinforcement learning (RL) for motion control trains policies directly from sensor inputs to motor commands, enabling unified controllers for different robots and tasks. However, most existing methods are either blind (proprioception-only) or rely on fusion backbones with unfavorable compute-memory trade-offs. Recurrent controllers struggle with long-horizon credit assignment, and Transformer-based fusion incurs quadratic cost in token length, limiting temporal and spatial context. We present a vision-driven cross-modal RL framework built on SSD-Mamba2, a selective state-space backbone that applies state-space duality (SSD) to enable both recurrent and convolutional scanning with hardware-aware streaming and near-linear scaling. Proprioceptive states and exteroceptive observations (e.g., depth tokens) are encoded into compact tokens and fused by stacked SSD-Mamba2 layers. The selective state-space updates retain long-range dependencies with markedly lower latency and memory use than quadratic self-attention, enabling longer look-ahead, higher token resolution, and stable training under limited compute. Policies are trained end-to-end under curricula that randomize terrain and appearance and progressively increase scene complexity. A compact, state-centric reward balances task progress, energy efficiency, and safety. Across diverse motion-control scenarios, our approach consistently surpasses strong state-of-the-art baselines in return, safety (collisions and falls), and sample efficiency, while converging faster at the same compute budget. These results suggest that SSD-Mamba2 provides a practical fusion backbone for resource-constrained robotic and autonomous systems in engineering informatics applications."},{"descriptionType":"Other","description":"6 figures and 8 tables. This paper has been accepted by Advanced Engineering Informatics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07593","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:44:54Z","registered":"2025-09-10T01:44:55Z","published":null,"updated":"2026-02-03T05:38:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07450","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07450","identifiers":[{"identifier":"2509.07450","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xudong","familyName":"Lu","name":"Lu, Xudong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Zheng","name":"Zheng, Zhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Wan","name":"Wan, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongxiang","familyName":"Yao","name":"Yao, Yongxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Annan","familyName":"Wang","name":"Wang, Annan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renrui","familyName":"Zhang","name":"Zhang, Renrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panwang","familyName":"Xia","name":"Xia, Panwang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiong","familyName":"Wu","name":"Wu, Qiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyun","familyName":"Li","name":"Li, Qingyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weifeng","familyName":"Lin","name":"Lin, Weifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyu","familyName":"Zhao","name":"Zhao, Xiangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peifeng","familyName":"Ma","name":"Ma, Peifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xue","familyName":"Yang","name":"Yang, Xue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongsheng","familyName":"Li","name":"Li, Hongsheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GLEAM: Learning to Match and Explain in Cross-View Geo-Localization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T07:14:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:26:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-26T00:44:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T00:19:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-31T11:47:45Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-03T01:38:48Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Cross-View Geo-Localization (CVGL) focuses on identifying correspondences between images captured from distinct perspectives of the same geographical location. However, existing CVGL approaches are typically restricted to a single view or modality, and their direct visual matching strategy lacks interpretability: they only determine whether two images correspond, without explaining the rationale behind the match. In this paper, we present GLEAM-C, a foundational CVGL model that unifies multiple views and modalities by aligning them exclusively with satellite imagery. Our framework improves training efficiency through optimized implementation and achieves accuracy comparable to prior modality-specific CVGL models via a novel two-phase training strategy. To address interpretability, we further propose GLEAM-X, a novel task that combines cross-view correspondence prediction with explainable reasoning enabled by multimodal large language models (MLLMs). We construct a bilingual benchmark using commercial MLLMs to generate training and testing data, and refine the test set through rigorous human revision for systematic evaluation of explainable cross-view reasoning. Together, GLEAM-C and GLEAM-X form a comprehensive CVGL pipeline that integrates multi-modal, multi-view alignment with interpretable correspondence analysis, unifying accurate cross-view matching with explainable reasoning and advancing Geo-Localization by enabling models to better Explain And Match. Code and datasets used in this work will be made publicly accessible at https://github.com/Lucky-Lance/GLEAM."},{"descriptionType":"Other","description":"23 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07450","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:41:34Z","registered":"2025-09-10T01:41:35Z","published":null,"updated":"2026-02-03T05:38:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07526","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07526","identifiers":[{"identifier":"2509.07526","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gokul Karthik","familyName":"Kumar","name":"Kumar, Gokul Karthik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rishabh","familyName":"Saraf","name":"Saraf, Rishabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ludovick","familyName":"Lepauloux","name":"Lepauloux, Ludovick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdul","familyName":"Muneer","name":"Muneer, Abdul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Billel","familyName":"Mokeddem","name":"Mokeddem, Billel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hakim","familyName":"Hacid","name":"Hacid, Hakim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Competitive Audio-Language Models with Data-Efficient Single-Stage Training on Public Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T09:01:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:32:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-21T16:03:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-22T01:52:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-22T09:16:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-23T01:30:14Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have transformed NLP, yet their integration with audio remains underexplored despite audio's centrality to human communication. We introduce Falcon3-Audio, a family of Audio-Language Models (ALMs) built on instruction-tuned LLMs and Whisper encoders. Using a remarkably small amount of public audio data, less than 30K hours (5K unique), Falcon3-Audio-7B matches the best reported performance among open-weight models on the MMAU benchmark, with a score of 64.14, matching R1-AQA, while distinguishing itself through superior data and parameter efficiency, single-stage training, and transparency. Notably, our smallest 1B model remains competitive with larger open models ranging from 2B to 13B parameters. Through extensive ablations, we find that common complexities such as curriculum learning, multiple audio encoders, and intricate cross-attention connectors are not required for strong performance, even compared to models trained on over 500K hours of data."},{"descriptionType":"Other","description":"Accepted at ASRU 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07526","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:43:21Z","registered":"2025-09-10T01:43:21Z","published":null,"updated":"2026-01-23T03:04:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07309","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07309","identifiers":[{"identifier":"2509.07309","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chi-Yang","familyName":"Hsu","name":"Hsu, Chi-Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Braylan","name":"Braylan, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiheng","familyName":"Su","name":"Su, Yiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Lease","name":"Lease, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omar","familyName":"Alonso","name":"Alonso, Omar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PIE: Performance Interval Estimation for Free-Form Generation Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T00:59:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:14:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-13T17:15:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-14T01:55:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Confidence estimation infers a probability for whether each model output is correct or not. While predicting such binary correctness is sensible for tasks with exact answers, free-form generation tasks are often more nuanced, with output quality being both fine-grained and multi-faceted. We thus propose Performance Interval Estimation (PIE) to predict both: 1) point estimates for any arbitrary set of continuous-valued evaluation metrics; and 2) calibrated uncertainty intervals around these point estimates. We then compare two approaches: LLM-as-judge vs. classic regression with confidence estimation features. Evaluation over 11 datasets spans summarization, translation, code generation, function-calling, and question answering. Regression is seen to achieve both: i) lower error point estimates of metric scores; and ii) well-calibrated uncertainty intervals. To support reproduction and follow-on work, we share our data and code."},{"descriptionType":"Other","description":"10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07309","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:38:16Z","registered":"2025-09-10T01:38:17Z","published":null,"updated":"2026-01-14T03:08:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07403","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07403","identifiers":[{"identifier":"2509.07403","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weichu","familyName":"Liu","name":"Liu, Weichu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Xiong","name":"Xiong, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Hu","name":"Hu, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixuan","familyName":"Li","name":"Li, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghuan","familyName":"Tan","name":"Tan, Minghuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ningning","familyName":"Mao","name":"Mao, Ningning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Shen","name":"Shen, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wendong","familyName":"Xu","name":"Xu, Wendong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaofan","familyName":"Tao","name":"Tao, Chaofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Yang","name":"Yang, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengming","familyName":"Li","name":"Li, Chengming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingpeng","familyName":"Kong","name":"Kong, Lingpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ngai","familyName":"Wong","name":"Wong, Ngai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LongEmotion: Measuring Emotional Intelligence of Large Language Models in Long-Context Interaction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T05:32:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:22:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-11T12:20:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-13T01:45:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have made significant progress in Emotional Intelligence (EI) and long-context modeling. However, existing benchmarks often overlook the fact that emotional information processing unfolds as a continuous long-context process. To address the absence of multidimensional EI evaluation in long-context inference and explore model performance under more challenging conditions, we present LongEmotion, a benchmark that encompasses a diverse suite of tasks targeting the assessment of models' capabilities in Emotion Recognition, Knowledge Application, and Empathetic Generation, with an average context length of 15,341 tokens. To enhance performance under realistic constraints, we introduce the Collaborative Emotional Modeling (CoEM) framework, which integrates Retrieval-Augmented Generation (RAG) and multi-agent collaboration to improve models' EI in long-context scenarios. We conduct a detailed analysis of various models in long-context settings, investigating how reasoning mode activation, RAG-based retrieval strategies, and context-length adaptability influence their EI performance. Our project page is: https://longemotion.github.io/"},{"descriptionType":"Other","description":"Technical Report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07403","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:40:28Z","registered":"2025-09-10T01:40:28Z","published":null,"updated":"2026-01-13T04:25:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07457","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07457","identifiers":[{"identifier":"2509.07457","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Sungkyunkwan University"],"givenName":"Shakhzod","familyName":"Yuldoshkhujaev","name":"Yuldoshkhujaev, Shakhzod","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Sungkyunkwan University"],"givenName":"Mijin","familyName":"Jeon","name":"Jeon, Mijin","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["University of Tennessee"],"givenName":"Doowon","familyName":"Kim","name":"Kim, Doowon","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Stony Brook University"],"givenName":"Nick","familyName":"Nikiforakis","name":"Nikiforakis, Nick","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Sungkyunkwan University"],"givenName":"Hyungjoon","familyName":"Koo","name":"Koo, Hyungjoon","nameIdentifiers":[]}],"titles":[{"title":"A Decade-long Landscape of Advanced Persistent Threats: Longitudinal Analysis and Global Trends"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T07:26:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:26:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-06T04:19:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-07T01:19:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3719027.3765085","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"An advanced persistent threat (APT) refers to a covert, long-term cyberattack, typically conducted by state-sponsored actors, targeting critical sectors and often remaining undetected for long periods. In response, collective intelligence from around the globe collaborates to identify and trace surreptitious activities, generating substantial documentation on APT campaigns publicly available on the web. While prior works predominantly focus on specific aspects of APT cases, such as detection, evaluation, cyber threat intelligence, and dataset creation, limited attention has been devoted to revisiting and investigating these scattered dossiers in a longitudinal manner. The objective of our study is to fill the gap by offering a macro perspective, connecting key insights and global trends in past APT attacks. We systematically analyze six reliable sources-three focused on technical reports and another three on threat actors-examining 1,509 APT dossiers (24,215 pages) spanning 2014-2023, and identifying 603 unique APT groups worldwide. To efficiently unearth relevant information, we employ a hybrid methodology that combines rule-based information retrieval with large-language-model-based search techniques. Our longitudinal analysis reveals shifts in threat actor activities, global attack vectors, changes in targeted sectors, and relationships between cyberattacks and significant events such as elections or wars, which provide insights into historical patterns in APT evolution. Over the past decade, 154 countries have been affected, primarily using malicious documents and spear phishing as dominant initial infiltration vectors, with a noticeable decline in zero-day exploitation since 2016. Furthermore, we present our findings through interactive visualization tools, such as an APT map or flow diagram, to facilitate intuitive understanding of global patterns and trends in APT activities."},{"descriptionType":"Other","description":"18 pages, 13 figures (including subfigures), 11 tables. In the Proceedings of the ACM Conference on Computer and Communications Security (CCS) 2025. Received Distinguished Paper Award"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07457","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:41:44Z","registered":"2025-09-10T01:41:44Z","published":null,"updated":"2026-01-07T02:59:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07414","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07414","identifiers":[{"identifier":"2509.07414","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jakub Grudzien","familyName":"Kuba","name":"Kuba, Jakub Grudzien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengting","familyName":"Gu","name":"Gu, Mengting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Ma","name":"Ma, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuandong","familyName":"Tian","name":"Tian, Yuandong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vijai","familyName":"Mohan","name":"Mohan, Vijai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Chen","name":"Chen, Jason","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Language Self-Play For Data-Free Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T05:51:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:22:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-16T10:22:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-17T01:36:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-19T03:05:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-22T01:14:34Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have advanced rapidly in recent years, driven by scale, abundant high-quality training data, and reinforcement learning. Yet this progress faces a fundamental bottleneck: the need for ever more data from which models can continue to learn. In this work, we propose a reinforcement learning approach that removes this dependency by enabling models to improve without additional data. Our method leverages a game-theoretic framework of self-play, where a model's capabilities are cast as performance in a competitive game and stronger policies emerge by having the model play against itself-a process we call Language Self-Play (LSP). Experiments with Llama-3.2-3B-Instruct on instruction-following, mathematics, and coding benchmarks show that pretrained models can be effectively improved with self-play alone."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07414","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:40:43Z","registered":"2025-09-10T01:40:44Z","published":null,"updated":"2025-12-22T03:03:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07170","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07170","identifiers":[{"identifier":"2509.07170","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Quinten","familyName":"Steenhuis","name":"Steenhuis, Quinten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"That's So FETCH: Fashioning Ensemble Techniques for LLM Classification in Civil Legal Intake and Referral"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T19:34:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:07:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-10T03:09:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-11T01:43:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3233/faia251588","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Each year millions of people seek help for their legal problems by calling a legal aid program hotline, walking into a legal aid office, or using a lawyer referral service. The first step to match them to the right help is to identify the legal problem the applicant is experiencing. Misdirection has consequences. Applicants may miss a deadline, experience physical abuse, lose housing or lose custody of children while waiting to connect to the right legal help. We introduce and evaluate the FETCH classifier for legal issue classification and describe two methods for improving accuracy: a hybrid LLM/ML ensemble classification method, and the automatic generation of follow-up questions to enrich the initial problem narrative. We employ a novel data set of 419 real-world queries to a nonprofit lawyer referral service. Ultimately, we show classification accuracy (hits@2) of 97.37\\% using a mix of inexpensive models, exceeding the performance of the current state-of-the-art GPT-5 model. Our approach shows promise in significantly reducing the cost of guiding users of the legal system to the right resource for their problem while achieving high accuracy."},{"descriptionType":"Other","description":"Submission to JURIX 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07170","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:35:00Z","registered":"2025-09-10T01:35:01Z","published":null,"updated":"2025-12-11T03:04:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07506","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07506","identifiers":[{"identifier":"2509.07506","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anjiang","familyName":"Wei","name":"Wei, Anjiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianran","familyName":"Sun","name":"Sun, Tianran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yogesh","familyName":"Seenichamy","name":"Seenichamy, Yogesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Song","name":"Song, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anne","familyName":"Ouyang","name":"Ouyang, Anne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Azalia","familyName":"Mirhoseini","name":"Mirhoseini, Azalia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke","familyName":"Wang","name":"Wang, Ke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Aiken","name":"Aiken, Alex","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Astra: A Multi-Agent System for GPU Kernel Performance Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T08:39:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:31:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-02T21:26:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-04T01:08:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"GPU kernel optimization has long been a central challenge at the intersection of high-performance computing and machine learning. Efficient kernels are crucial for accelerating large language model (LLM) training and serving, yet attaining high performance typically requires extensive manual tuning. Compiler-based systems reduce some of this burden, but still demand substantial manual design and engineering effort. Recently, researchers have explored using LLMs for GPU kernel generation, though prior work has largely focused on translating high-level PyTorch modules into CUDA code. In this work, we introduce Astra, the first LLM-based multi-agent system for GPU kernel optimization. Unlike previous approaches, Astra starts from existing CUDA implementations extracted from SGLang, a widely deployed framework for serving LLMs, rather than treating PyTorch modules as the specification. Within Astra, specialized LLM agents collaborate through iterative code generation, testing, profiling, and planning to produce kernels that are both correct and high-performance. On kernels from SGLang, Astra achieves an average speedup of 1.32x using zero-shot prompting with OpenAI o4-mini. A detailed case study further demonstrates that LLMs can autonomously apply loop transformations, optimize memory access patterns, exploit CUDA intrinsics, and leverage fast math operations to yield substantial performance gains. Our work highlights multi-agent LLM systems as a promising new paradigm for GPU kernel optimization. Our code is publicly available at https://github.com/Anjiang-Wei/Astra."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07506","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:42:53Z","registered":"2025-09-10T01:42:53Z","published":null,"updated":"2025-12-04T18:40:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07424","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07424","identifiers":[{"identifier":"2509.07424","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyunseung","familyName":"Lim","name":"Lim, Hyunseung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dasom","familyName":"Choi","name":"Choi, Dasom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"DaEun","familyName":"Choi","name":"Choi, DaEun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sooyohn","familyName":"Nam","name":"Nam, Sooyohn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hwajung","familyName":"Hong","name":"Hong, Hwajung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Feed-O-Meter: Investigating AI-Generated Mentee Personas as Interactive Agents for Scaffolding Design Feedback Practice"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T06:31:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:23:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-02T13:14:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-03T01:45:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Effective feedback, including critique and evaluation, helps designers develop design concepts and refine their ideas, supporting informed decision-making throughout the iterative design process. However, in studio-based design courses, students often struggle to provide feedback due to a lack of confidence and fear of being judged, which limits their ability to develop essential feedback-giving skills. Recent advances in large language models (LLMs) suggest that role-playing with AI agents can let learners engage in multi-turn feedback without the anxiety of external judgment or the time constraints of real-world settings. Yet prior studies have raised concerns that LLMs struggle to behave like real people in role-play scenarios, diminishing the educational benefits of these interactions. Therefore, designing AI-based agents that effectively support learners in practicing and developing intellectual reasoning skills requires more than merely assigning the target persona's personality and role to the agent. By addressing these issues, we present Feed-O-Meter, a novel system that employs carefully designed LLM-based agents to create an environment in which students can practice giving design feedback. The system enables users to role-play as mentors, providing feedback to an AI mentee and allowing them to reflect on how that feedback impacts the AI mentee's idea development process. A user study (N=24) indicated that Feed-O-Meter increased participants' engagement and motivation through role-switching and helped them adjust feedback to be more comprehensible for an AI mentee. Based on these findings, we discuss future directions for designing systems to foster feedback skills in design education."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07424","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:40:58Z","registered":"2025-09-10T01:40:59Z","published":null,"updated":"2025-12-03T02:50:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07451","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07451","identifiers":[{"identifier":"2509.07451","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Laura","familyName":"Boggia","name":"Boggia, Laura","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bogdan","familyName":"Malaescu","name":"Malaescu, Bogdan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synthetic Data Generation with Lorenzetti for Time Series Anomaly Detection in High-Energy Physics Calorimeters"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T07:22:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:26:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-01T14:48:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-04T01:34:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-02T14:13:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-03T01:49:31Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Anomaly detection in multivariate time series is crucial to ensure the quality of data coming from a physics experiment. Accurately identifying the moments when unexpected errors or defects occur is essential, yet challenging due to scarce labels, unknown anomaly types, and complex correlations across dimensions. To address the scarcity and unreliability of labelled data, we use the Lorenzetti Simulator to generate synthetic events with injected calorimeter anomalies. We then assess the sensitivity of several time series anomaly detection methods, including transformer-based and other deep learning models. The approach employed here is generic and applicable to different detector designs and defects."},{"descriptionType":"Other","description":"4 pages, 2 figures, Submission to SciPost proceedings for EuCAIFCon 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07451","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:41:36Z","registered":"2025-09-10T01:41:36Z","published":null,"updated":"2025-12-03T02:50:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.06996","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.06996","identifiers":[{"identifier":"2509.06996","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jie","familyName":"Zhang","name":"Zhang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting","familyName":"Xu","name":"Xu, Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gelei","familyName":"Deng","name":"Deng, Gelei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runyi","familyName":"Hu","name":"Hu, Runyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Qiu","name":"Qiu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianwei","familyName":"Zhang","name":"Zhang, Tianwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Guo","name":"Guo, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ivor","familyName":"Tsang","name":"Tsang, Ivor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Visible Yet Unreadable: A Systematic Blind Spot of Vision Language Models Across Writing Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-04T05:35:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:00:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T13:47:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:43:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-15T07:57:17Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-16T00:33:31Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-21T04:49:38Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-22T00:29:09Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-12-01T20:23:54Z","dateType":"Withdrawn","dateInformation":"v5; arXiv admin note: This article has been withdrawn by arXiv administrators due to violation of arXiv policy regarding generative AI authorship"},{"date":"2025-12-03T01:05:47Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Writing is a universal cultural technology that reuses vision for symbolic communication. Humans display striking resilience: we readily recognize words even when characters are fragmented, fused, or partially occluded. This paper investigates whether advanced vision language models (VLMs) share this resilience. We construct two psychophysics inspired benchmarks across distinct writing systems, Chinese logographs and English alphabetic words, by splicing, recombining, and overlaying glyphs to yield ''visible but unreadable'' stimuli for models while remaining legible to humans. Despite strong performance on clean text, contemporary VLMs show a severe drop under these perturbations, frequently producing unrelated or incoherent outputs. The pattern suggests a structural limitation: models heavily leverage generic visual invariances but under rely on compositional priors needed for robust literacy. We release stimuli generation code, prompts, and evaluation protocols to facilitate transparent replication and follow up work. Our findings motivate architectures and training strategies that encode symbol segmentation, composition, and binding across scripts, and they delineate concrete challenges for deploying multimodal systems in education, accessibility, cultural heritage, and security."},{"descriptionType":"Other","description":"arXiv admin note: This article has been withdrawn by arXiv administrators due to violation of arXiv policy regarding generative AI authorship"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.06996","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:30:52Z","registered":"2025-09-10T01:30:53Z","published":null,"updated":"2025-12-03T02:50:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.06998","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.06998","identifiers":[{"identifier":"2509.06998","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liviu Nicolae","familyName":"Fircă","name":"Fircă, Liviu Nicolae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio","familyName":"Bărbălau","name":"Bărbălau, Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Oneata","name":"Oneata, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elena","familyName":"Burceanu","name":"Burceanu, Elena","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Not All Splits Are Equal: Rethinking Attribute Generalization Across Unrelated Categories"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-04T17:52:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:00:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-26T11:47:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-27T01:42:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Can models generalize attribute knowledge across semantically and perceptually dissimilar categories? While prior work has addressed attribute prediction within narrow taxonomic or visually similar domains, it remains unclear whether current models can abstract attributes and apply them to conceptually distant categories. This work presents the first explicit evaluation for the robustness of the attribute prediction task under such conditions, testing whether models can correctly infer shared attributes between unrelated object types: e.g., identifying that the attribute \"has four legs\" is common to both \"dogs\" and \"chairs\". To enable this evaluation, we introduce train-test split strategies that progressively reduce correlation between training and test sets, based on: LLM-driven semantic grouping, embedding similarity thresholding, embedding-based clustering, and supercategory-based partitioning using ground-truth labels. Results show a sharp drop in performance as the correlation between training and test categories decreases, indicating strong sensitivity to split design. Among the evaluated methods, clustering yields the most effective trade-off, reducing hidden correlations while preserving learnability. These findings offer new insights into the limitations of current representations and inform future benchmark construction for attribute reasoning."},{"descriptionType":"Other","description":"Accepted at NeurIPS 2025 Workshop: CauScien - Uncovering Causality in Science and NeurIPS 2025 Workshop: Reliable ML from Unreliable Data"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.06998","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:30:55Z","registered":"2025-09-10T01:30:55Z","published":null,"updated":"2025-11-27T03:15:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07939","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07939","identifiers":[{"identifier":"2509.07939","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Katsuaki","familyName":"Nakano","name":"Nakano, Katsuaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reza","familyName":"Fayyazi","name":"Fayyazi, Reza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanchieh Jay","familyName":"Yang","name":"Yang, Shanchieh Jay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Zuzak","name":"Zuzak, Michael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Guided Reasoning in LLM-Driven Penetration Testing Using Structured Attack Trees"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:19:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:55:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-18T18:20:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-19T02:03:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Large Language Models (LLMs) have driven interest in automating cybersecurity penetration testing workflows, offering the promise of faster and more consistent vulnerability assessment for enterprise systems. Existing LLM agents for penetration testing primarily rely on self-guided reasoning, which can produce inaccurate or hallucinated procedural steps. As a result, the LLM agent may undertake unproductive actions, such as exploiting unused software libraries or generating cyclical responses that repeat prior tactics. In this work, we propose a guided reasoning pipeline for penetration testing LLM agents that incorporates a deterministic task tree built from the MITRE ATT\u0026amp;CK Matrix, a proven penetration testing kll chain, to constrain the LLM's reaoning process to explicitly defined tactics, techniques, and procedures. This anchors reasoning in proven penetration testing methodologies and filters out ineffective actions by guiding the agent towards more productive attack procedures. To evaluate our approach, we built an automated penetration testing LLM agent using three LLMs (Llama-3-8B, Gemini-1.5, and GPT-4) and applied it to navigate 10 HackTheBox cybersecurity exercises with 103 discrete subtasks representing real-world cyberattack scenarios. Our proposed reasoning pipeline guided the LLM agent through 71.8\\%, 72.8\\%, and 78.6\\% of subtasks using Llama-3-8B, Gemini-1.5, and GPT-4, respectively. Comparatively, the state-of-the-art LLM penetration testing tool using self-guided reasoning completed only 13.5\\%, 16.5\\%, and 75.7\\% of subtasks and required 86.2\\%, 118.7\\%, and 205.9\\% more model queries. This suggests that incorporating a deterministic task tree into LLM reasoning pipelines can enhance the accuracy and efficiency of automated cybersecurity assessments"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07939","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:13Z","registered":"2025-09-10T01:53:14Z","published":null,"updated":"2025-11-19T03:17:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07463","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07463","identifiers":[{"identifier":"2509.07463","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sven","familyName":"Kirchner","name":"Kirchner, Sven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nils","familyName":"Purschke","name":"Purschke, Nils","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ross","familyName":"Greer","name":"Greer, Ross","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alois C.","familyName":"Knoll","name":"Knoll, Alois C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DepthVision: Enabling Robust Vision-Language Models with GAN-Based LiDAR-to-RGB Synthesis for Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T07:42:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:27:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-18T13:49:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-19T01:50:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ensuring reliable autonomous operation when visual input is degraded remains a key challenge in intelligent vehicles and robotics. We present DepthVision, a multimodal framework that enables Vision--Language Models (VLMs) to exploit LiDAR data without any architectural changes or retraining. DepthVision synthesizes dense, RGB-like images from sparse LiDAR point clouds using a conditional GAN with an integrated refiner, and feeds these into off-the-shelf VLMs through their standard visual interface. A Luminance-Aware Modality Adaptation (LAMA) module fuses synthesized and real camera images by dynamically weighting each modality based on ambient lighting, compensating for degradation such as darkness or motion blur. This design turns LiDAR into a drop-in visual surrogate when RGB becomes unreliable, effectively extending the operational envelope of existing VLMs. We evaluate DepthVision on real and simulated datasets across multiple VLMs and safety-critical tasks, including vehicle-in-the-loop experiments. The results show substantial improvements in low-light scene understanding over RGB-only baselines while preserving full compatibility with frozen VLM architectures. These findings demonstrate that LiDAR-guided RGB synthesis is a practical pathway for integrating range sensing into modern vision-language systems for autonomous driving."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07463","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:41:52Z","registered":"2025-09-10T01:41:53Z","published":null,"updated":"2025-11-19T03:16:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07864","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07864","identifiers":[{"identifier":"2509.07864","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tiancheng","familyName":"Yang","name":"Yang, Tiancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Zhang","name":"Zhang, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaye","familyName":"Lin","name":"Lin, Jiaye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guimin","familyName":"Hu","name":"Hu, Guimin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wang","name":"Wang, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lijie","familyName":"Hu","name":"Hu, Lijie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tracing and Mitigating Hallucinations in Multimodal LLMs via Dynamic Attention Localization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T15:51:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:51:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-17T13:57:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-18T02:51:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Large Language Models (MLLMs) achieve strong performance on tasks like image captioning and visual question answering, but remain prone to hallucinations, where generated text conflicts with the visual input. Prior work links this partly to insufficient visual attention, but existing attention-based detectors and mitigation typically apply uniform adjustments across layers and heads, obscuring where errors originate. In this paper, we first show these methods fail to accurately localize problematic layers. Then, we introduce two diagnostics: Layer Image Attention Entropy (LIAE) which flags anomalous layers, and Image Attention Focus (IAF) which scores attention heads within those layers. Analysis shows that LIAE pinpoints faulty layers and IAF reliably ranks heads that warrant correction. Guided by these signals, we propose Dynamic Layer-wise Entropy and Attention Fusion (D-LEAF), a task-agnostic, attention-guided method that dynamically localizes and corrects errors during inference with negligible overhead. Furthermore, by establishing a connection between D-LEAF and DPO, we provide theoretical justification for the effectiveness of D-LEAF. Results show our D-LEAF delivers a 53\\% relative improvement on standard captioning benchmarks, and on VQA both accuracy and F1-score improve by approximately 4\\%, substantially suppressing hallucinations while preserving efficiency."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07864","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:51:29Z","registered":"2025-09-10T01:51:30Z","published":null,"updated":"2025-11-18T05:14:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07202","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07202","identifiers":[{"identifier":"2509.07202","identifierType":"arXiv"}],"creators":[{"nameType":"Organizational","affiliation":[],"name":"Khushiyant","nameIdentifiers":[]}],"titles":[{"title":"Neurocognitive Modeling for Text Generation: Deep Learning Architecture for EEG Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.6; J.3","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-08T20:32:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:08:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-16T10:38:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-18T01:59:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Text generating capabilities have undergone a substantial transformation with the introduction of large language models (LLMs). Electroencephalography (EEG)-based text production is still difficult, though, because it requires a lot of data and processing power. This paper introduces a new method that combines the use of the Gemma 2B LLM with a classifier-LLM architecture to incorporate a Recurrent Neural Network (RNN) encoder. Our approach drastically lowers the amount of data and compute power needed while achieving performance close to that of cutting-edge methods. Notably, compared to current methodologies, our methodology delivers an overall performance improvement of 10%. The suggested architecture demonstrates the possibility of effective transfer learning for EEG-based text production, remaining strong and functional even in the face of data limits. This work highlights the potential of integrating LLMs with EEG decoding to improve assistive technologies and improve independence and communication for those with severe motor limitations. Our method pushes the limits of present capabilities and opens new paths for research and application in brain-computer interfaces by efficiently using the strengths of pre-trained language models. This makes EEG-based text production more accessible and efficient."},{"descriptionType":"Other","description":"15 pages, 10 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07202","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:35:46Z","registered":"2025-09-10T01:35:46Z","published":null,"updated":"2025-11-18T05:14:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07873","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07873","identifiers":[{"identifier":"2509.07873","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hieu","familyName":"Tran","name":"Tran, Hieu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Go-Eum","familyName":"Cha","name":"Cha, Go-Eum","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sooyeon","familyName":"Jeong","name":"Jeong, Sooyeon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Robot That Listens: Enhancing Self-Disclosure and Engagement Through Sentiment-based Backchannels and Active Listening"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T15:57:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-17T01:19:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/ro-man63969.2025.11217862","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As social robots get more deeply integrated intoour everyday lives, they will be expected to engage in meaningful conversations and exhibit socio-emotionally intelligent listening behaviors when interacting with people. Active listening and backchanneling could be one way to enhance robots' communicative capabilities and enhance their effectiveness in eliciting deeper self-disclosure, providing a sense of empathy,and forming positive rapport and relationships with people.Thus, we developed an LLM-powered social robot that can exhibit contextually appropriate sentiment-based backchannelingand active listening behaviors (active listening+backchanneling) and compared its efficacy in eliciting people's self-disclosurein comparison to robots that do not exhibit any of these listening behaviors (control) and a robot that only exhibitsbackchanneling behavior (backchanneling-only). Through ourexperimental study with sixty-five participants, we found theparticipants who conversed with the active listening robot per-ceived the interactions more positively, in which they exhibited the highest self-disclosures, and reported the strongest senseof being listened to. The results of our study suggest that the implementation of active listening behaviors in social robotshas the potential to improve human-robot communication andcould further contribute to the building of deeper human-robot relationships and rapport."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07873","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:51:42Z","registered":"2025-09-10T01:51:43Z","published":null,"updated":"2025-11-17T03:05:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07486","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07486","identifiers":[{"identifier":"2509.07486","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zichun","familyName":"Hao","name":"Hao, Zichun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raghav","familyName":"Kansal","name":"Kansal, Raghav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhijith","familyName":"Gandrakota","name":"Gandrakota, Abhijith","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Sun","name":"Sun, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ngadiuba","familyName":"Jennifer","name":"Jennifer, Ngadiuba","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javier","familyName":"Duarte","name":"Duarte, Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria","familyName":"Spiropulu","name":"Spiropulu, Maria","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RINO: Renormalization Group Invariance with No Labels"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T08:05:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:28:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-10T16:15:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-11T00:43:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-13T00:18:41Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-14T01:11:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A common challenge with supervised machine learning (ML) in high energy physics (HEP) is the reliance on simulations for labeled data, which can often mismodel the underlying collision or detector response. To help mitigate this problem of domain shift, we propose RINO (Renormalization Group Invariance with No Labels), a self-supervised learning approach that can instead pretrain models directly on collision data, learning embeddings invariant to renormalization group flow scales. In this work, we pretrain a transformer-based model on jets originating from quantum chromodynamic (QCD) interactions from the JetClass dataset, emulating real QCD-dominated experimental data, and then finetune on the JetNet dataset -- emulating simulations -- for the task of identifying jets originating from top quark decays. RINO demonstrates improved generalization from the JetNet training data to JetClass data compared to supervised training on JetNet from scratch, demonstrating the potential for RINO pretraining on real collision data followed by fine-tuning on small, high-quality MC datasets, to improve the robustness of ML models in HEP."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07486","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:42:24Z","registered":"2025-09-10T01:42:25Z","published":null,"updated":"2025-11-14T03:10:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07869","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07869","identifiers":[{"identifier":"2509.07869","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahui","familyName":"Li","name":"Li, Jiahui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"Papay","name":"Papay, Sean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roman","familyName":"Klinger","name":"Klinger, Roman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Are Humans as Brittle as Large Language Models?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T15:56:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:52:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-07T16:21:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-10T01:49:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The output of large language models (LLMs) is unstable, due both to non-determinism of the decoding process as well as to prompt brittleness. While the intrinsic non-determinism of LLM generation may mimic existing uncertainty in human annotations through distributional shifts in outputs, it is largely assumed, yet unexplored, that the prompt brittleness effect is unique to LLMs. This raises the question: do human annotators show similar sensitivity to prompt changes? If so, should prompt brittleness in LLMs be considered problematic? One may alternatively hypothesize that prompt brittleness correctly reflects human annotation variances. To fill this research gap, we systematically compare the effects of prompt modifications on LLMs and identical instruction modifications for human annotators, focusing on the question of whether humans are similarly sensitive to prompt perturbations. To study this, we prompt both humans and LLMs for a set of text classification tasks conditioned on prompt variations. Our findings indicate that both humans and LLMs exhibit increased brittleness in response to specific types of prompt modifications, particularly those involving the substitution of alternative label sets or label formats. However, the distribution of human judgments is less affected by typographical errors and reversed label order than that of LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07869","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:51:36Z","registered":"2025-09-10T01:51:37Z","published":null,"updated":"2025-11-10T02:48:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07325","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07325","identifiers":[{"identifier":"2509.07325","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alyssa","familyName":"Unell","name":"Unell, Alyssa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noel C. F.","familyName":"Codella","name":"Codella, Noel C. F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sam","familyName":"Preston","name":"Preston, Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peniel","familyName":"Argaw","name":"Argaw, Peniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wen-wai","familyName":"Yim","name":"Yim, Wen-wai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zelalem","familyName":"Gero","name":"Gero, Zelalem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cliff","familyName":"Wong","name":"Wong, Cliff","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajesh","familyName":"Jena","name":"Jena, Rajesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Horvitz","name":"Horvitz, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amanda K.","familyName":"Hall","name":"Hall, Amanda K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruican Rachel","familyName":"Zhong","name":"Zhong, Ruican Rachel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiachen","familyName":"Li","name":"Li, Jiachen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shrey","familyName":"Jain","name":"Jain, Shrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mu","familyName":"Wei","name":"Wei, Mu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Lungren","name":"Lungren, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hoifung","familyName":"Poon","name":"Poon, Hoifung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CancerGUIDE: Cancer Guideline Understanding via Internal Disagreement Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T01:49:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:15:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-06T18:38:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-07T01:58:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The National Comprehensive Cancer Network (NCCN) provides evidence-based guidelines for cancer treatment. Translating complex patient presentations into guideline-compliant treatment recommendations is time-intensive, requires specialized expertise, and is prone to error. Advances in large language model (LLM) capabilities promise to reduce the time required to generate treatment recommendations and improve accuracy. We present an LLM agent-based approach to automatically generate guideline-concordant treatment trajectories for patients with non-small cell lung cancer (NSCLC). Our contributions are threefold. First, we construct a novel longitudinal dataset of 121 cases of NSCLC patients that includes clinical encounters, diagnostic results, and medical histories, each expertly annotated with the corresponding NCCN guideline trajectories by board-certified oncologists. Second, we demonstrate that existing LLMs possess domain-specific knowledge that enables high-quality proxy benchmark generation for both model development and evaluation, achieving strong correlation (Spearman coefficient r=0.88, RMSE = 0.08) with expert-annotated benchmarks. Third, we develop a hybrid approach combining expensive human annotations with model consistency information to create both the agent framework that predicts the relevant guidelines for a patient, as well as a meta-classifier that verifies prediction accuracy with calibrated confidence scores for treatment recommendations (AUROC=0.800), a critical capability for communicating the accuracy of outputs, custom-tailoring tradeoffs in performance, and supporting regulatory compliance. This work establishes a framework for clinically viable LLM-based guideline adherence systems that balance accuracy, interpretability, and regulatory requirements while reducing annotation costs, providing a scalable pathway toward automated clinical decision support."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07325","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:38:38Z","registered":"2025-09-10T01:38:39Z","published":null,"updated":"2025-11-07T03:05:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07688","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07688","identifiers":[{"identifier":"2509.07688","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joseph","familyName":"Ko","name":"Ko, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hariprasath","familyName":"Govindarajan","name":"Govindarajan, Hariprasath","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fredrik","familyName":"Lindsten","name":"Lindsten, Fredrik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vanessa","familyName":"Przybylo","name":"Przybylo, Vanessa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kara","familyName":"Sulia","name":"Sulia, Kara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcus","familyName":"van Lier-Walqui","name":"van Lier-Walqui, Marcus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kara","familyName":"Lamb","name":"Lamb, Kara","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding Ice Crystal Habit Diversity with Self-Supervised Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Atmospheric and Oceanic Physics (physics.ao-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T12:54:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:42:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T17:18:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T01:02:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-03T23:27:42Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-05T01:11:08Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ice-containing clouds strongly impact climate, but they are hard to model due to ice crystal habit (i.e., shape) diversity. We use self-supervised learning (SSL) to learn latent representations of crystals from ice crystal imagery. By pre-training a vision transformer with many cloud particle images, we learn robust representations of crystal morphology, which can be used for various science-driven tasks. Our key contributions include (1) validating that our SSL approach can be used to learn meaningful representations, and (2) presenting a relevant application where we quantify ice crystal diversity with these latent representations. Our results demonstrate the power of SSL-driven representations to improve the characterization of ice crystals and subsequently constrain their role in Earth's climate system."},{"descriptionType":"Other","description":"Accepted to NeurIPS 2025 Workshop: Tackling Climate Change with Machine Learning"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07688","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:47:15Z","registered":"2025-09-10T01:47:15Z","published":null,"updated":"2025-11-05T03:11:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07759","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07759","identifiers":[{"identifier":"2509.07759","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minghan","familyName":"Li","name":"Li, Minghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miyang","familyName":"Luo","name":"Luo, Miyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianrui","familyName":"Lv","name":"Lv, Tianrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yishuai","familyName":"Zhang","name":"Zhang, Yishuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siqi","familyName":"Zhao","name":"Zhao, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ercong","familyName":"Nie","name":"Nie, Ercong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guodong","familyName":"Zhou","name":"Zhou, Guodong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Survey of Long-Document Retrieval in the PLM and LLM Era"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:57:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:46:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-25T13:44:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-28T00:36:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The proliferation of long-form documents presents a fundamental challenge to information retrieval (IR), as their length, dispersed evidence, and complex structures demand specialized methods beyond standard passage-level techniques. This survey provides the first comprehensive treatment of long-document retrieval (LDR), consolidating methods, challenges, and applications across three major eras. We systematize the evolution from classical lexical and early neural models to modern pre-trained (PLM) and large language models (LLMs), covering key paradigms like passage aggregation, hierarchical encoding, efficient attention, and the latest LLM-driven re-ranking and retrieval techniques. Beyond the models, we review domain-specific applications, specialized evaluation resources, and outline critical open challenges such as efficiency trade-offs, multimodal alignment, and faithfulness. This survey aims to provide both a consolidated reference and a forward-looking agenda for advancing long-document retrieval in the era of foundation models."},{"descriptionType":"Other","description":"32 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07759","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:48:59Z","registered":"2025-09-10T01:49:00Z","published":null,"updated":"2025-10-28T04:01:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07036","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07036","identifiers":[{"identifier":"2509.07036","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Federico","familyName":"Cerutti","name":"Cerutti, Federico","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Methodological Insights into Structural Causal Modelling and Uncertainty-Aware Forecasting for Economic Indicators"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T04:52:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:01:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-24T04:25:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-27T00:23:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents a methodological approach to financial time series analysis by combining causal discovery and uncertainty-aware forecasting. As a case study, we focus on four key U.S. macroeconomic indicators -- GDP, economic growth, inflation, and unemployment -- and we apply the LPCMCI framework with Gaussian Process Distance Correlation (GPDC) to uncover dynamic causal relationships in quarterly data from 1970 to 2021. Our results reveal a robust unidirectional causal link from economic growth to GDP and highlight the limited connectivity of inflation, suggesting the influence of latent factors. Unemployment exhibits strong autoregressive dependence, motivating its use as a case study for probabilistic forecasting. Leveraging the Chronos framework, a large language model trained for time series, we perform zero-shot predictions on unemployment. This approach delivers accurate forecasts one and two quarters ahead, without requiring task-specific training. Crucially, the model's uncertainty-aware predictions yield 90\\% confidence intervals, enabling effective anomaly detection through statistically principled deviation analysis. This study demonstrates the value of combining causal structure learning with probabilistic language models to inform economic policy and enhance forecasting robustness."},{"descriptionType":"Other","description":"Accepted at the 2nd edition of the Workshop in AI and Finance at ECAI-2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07036","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:31:52Z","registered":"2025-09-10T01:31:53Z","published":null,"updated":"2025-10-27T02:11:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07142","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07142","identifiers":[{"identifier":"2509.07142","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiyin","familyName":"Tan","name":"Tan, Zhiyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jennifer","familyName":"D'Souza","name":"D'Souza, Jennifer","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward Purpose-oriented Topic Model Evaluation enabled by Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Digital Libraries (cs.DL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T18:46:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-24T00:39:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/s00799-025-00429-5","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study presents a framework for automated evaluation of dynamically evolving topic models using Large Language Models (LLMs). Topic modeling is essential for organizing and retrieving scholarly content in digital library systems, helping users navigate complex and evolving knowledge domains. However, widely used automated metrics, such as coherence and diversity, often capture only narrow statistical patterns and fail to explain semantic failures in practice. We introduce a purpose-oriented evaluation framework that employs nine LLM-based metrics spanning four key dimensions of topic quality: lexical validity, intra-topic semantic soundness, inter-topic structural soundness, and document-topic alignment soundness. The framework is validated through adversarial and sampling-based protocols, and is applied across datasets spanning news articles, scholarly publications, and social media posts, as well as multiple topic modeling methods and open-source LLMs. Our analysis shows that LLM-based metrics provide interpretable, robust, and task-relevant assessments, uncovering critical weaknesses in topic models such as redundancy and semantic drift, which are often missed by traditional metrics. These results support the development of scalable, fine-grained evaluation tools for maintaining topic relevance in dynamic datasets. All code and data supporting this work are accessible at https://github.com/zhiyintan/topic-model-LLMjudgment."},{"descriptionType":"Other","description":"Accepted for publication in International Journal on Digital Libraries (IJDL)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07142","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:34:21Z","registered":"2025-09-10T01:34:21Z","published":null,"updated":"2025-10-24T02:14:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07613","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07613","identifiers":[{"identifier":"2509.07613","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fangqi","familyName":"Cheng","name":"Cheng, Fangqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Surajit","familyName":"Ray","name":"Ray, Surajit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaochen","familyName":"Yang","name":"Yang, Xiaochen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Data-Efficient Fine-Tuning of Vision-Language Models for Diagnosis of Alzheimer's Disease"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T11:36:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:38:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T07:27:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:28:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-15T05:06:34Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-16T00:26:00Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Medical vision-language models (Med-VLMs) have shown impressive results in tasks such as report generation and visual question answering, but they still face several limitations. Most notably, they underutilize patient metadata and lack integration of clinical diagnostic knowledge. Moreover, most existing models are typically trained from scratch or fine-tuned on large-scale 2D image-text pairs, requiring extensive computational resources, and their effectiveness on 3D medical imaging is often limited due to the absence of structural information. To address these gaps, we propose a data-efficient fine-tuning pipeline to adapt 3D CT-based Med-VLMs for 3D MRI and demonstrate its application in Alzheimer's disease (AD) diagnosis. Our system introduces two key innovations. First, we convert structured metadata into synthetic reports, enriching textual input for improved image-text alignment. Second, we add an auxiliary token trained to predict the mini-mental state examination (MMSE) score, a widely used clinical measure of cognitive function that correlates with AD severity. This provides additional supervision for fine-tuning. Applying lightweight prompt tuning to both image and text modalities, our approach achieves state-of-the-art performance on ADNI with only 1,504 training MRIs, outperforming methods trained on 27,161 MRIs, and shows strong zero-shot generalization on OASIS-2 and AIBL. Code is available at https://github.com/CFQ666312/DEFT-VLM-AD."},{"descriptionType":"Other","description":"Accepted at MICAD 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07613","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:45:23Z","registered":"2025-09-10T01:45:23Z","published":null,"updated":"2025-10-16T02:24:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07447","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07447","identifiers":[{"identifier":"2509.07447","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taiying","familyName":"Peng","name":"Peng, Taiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiacheng","familyName":"Hua","name":"Hua, Jiacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miao","familyName":"Liu","name":"Liu, Miao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Lu","name":"Lu, Feng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"In the Eye of MLLM: Benchmarking Egocentric Video Intent Understanding with Gaze-Guided Prompting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T07:11:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:25:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-14T09:18:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:37:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The emergence of advanced multimodal large language models (MLLMs) has significantly enhanced AI assistants' ability to process complex information across modalities. Recently, egocentric videos, by directly capturing user focus, actions, and context in an unified coordinate, offer an exciting opportunity to enable proactive and personalized AI user experiences with MLLMs. However, existing benchmarks overlook the crucial role of gaze as an indicator of user intent. To address this gap, we introduce EgoGazeVQA, an egocentric gaze-guided video question answering benchmark that leverages gaze information to improve the understanding of longer daily-life videos. EgoGazeVQA consists of gaze-based QA pairs generated by MLLMs and refined by human annotators. Our experiments reveal that existing MLLMs struggle to accurately interpret user intentions. In contrast, our gaze-guided intent prompting methods significantly enhance performance by integrating spatial, temporal, and intent-related cues. We further conduct experiments on gaze-related fine-tuning and analyze how gaze estimation accuracy impacts prompting effectiveness. These results underscore the value of gaze for more personalized and effective AI assistants in egocentric settings. Project page: https://taiyi98.github.io/projects/EgoGazeVQA"},{"descriptionType":"Other","description":"Accepted to NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07447","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:41:30Z","registered":"2025-09-10T01:41:31Z","published":null,"updated":"2025-10-15T02:21:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07558","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07558","identifiers":[{"identifier":"2509.07558","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiyuan","familyName":"He","name":"He, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xufang","familyName":"Luo","name":"Luo, Xufang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yike","familyName":"Zhang","name":"Zhang, Yike","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Yang","name":"Yang, Yuqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lili","familyName":"Qiu","name":"Qiu, Lili","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VL Norm: Rethink Loss Aggregation in RLVR"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T09:52:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:34:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-11T08:50:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:30:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose VL Norm (Variance-reduced Length-dependent Normalization), a simple yet effective loss aggregation method tailored to the characteristic of dynamic generation lengths in Reinforcement Learning with Verifiable Rewards (RLVR). Recently, RLVR has demonstrated strong potential in improving the reasoning capabilities of large language models (LLMs), but a major challenge lies in the large variability of response lengths during training, which leads to high gradient variance and unstable optimization. Although previous methods such as GRPO, DAPO, and Dr. GRPO introduce different loss normalization terms to address this issue, they either produce biased estimates or still suffer from high gradient variance. By analyzing the effect of varying lengths on policy loss both theoretically and empirically, we reformulate the problem as finding a minimum-variance unbiased estimator. Our proposed VL Norm not only provides an unbiased estimate of the true policy loss but also minimizes gradient variance in theory. Besides, VL Norm is easy to implement with less than 10 lines of code change. Extensive experiments show that it consistently achieves superior results across different model sizes, maximum lengths, and tasks. When integrated into the state-of-the-art RL algorithm DAPO, it achieves up to 2.67x faster convergence on the CountDown task. Our code is public at https://github.com/zerolllin/Delta-L-Normalization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07558","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:44:05Z","registered":"2025-09-10T01:44:06Z","published":null,"updated":"2025-10-14T04:20:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07979","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07979","identifiers":[{"identifier":"2509.07979","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Heeji","familyName":"Yoon","name":"Yoon, Heeji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaewoo","familyName":"Jung","name":"Jung, Jaewoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junwan","familyName":"Kim","name":"Kim, Junwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyungyu","familyName":"Choi","name":"Choi, Hyungyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heeseong","familyName":"Shin","name":"Shin, Heeseong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangbeom","familyName":"Lim","name":"Lim, Sangbeom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Honggyu","familyName":"An","name":"An, Honggyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaehyun","familyName":"Kim","name":"Kim, Chaehyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jisang","familyName":"Han","name":"Han, Jisang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donghyun","familyName":"Kim","name":"Kim, Donghyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chanho","familyName":"Eom","name":"Eom, Chanho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunghwan","familyName":"Hong","name":"Hong, Sunghwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungryong","familyName":"Kim","name":"Kim, Seungryong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Visual Representation Alignment for Multimodal Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:59:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:56:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T06:52:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T00:28:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal large language models (MLLMs) trained with visual instruction tuning have achieved strong performance across diverse tasks, yet they remain limited in vision-centric tasks such as object counting or spatial reasoning. We attribute this gap to the prevailing text-only supervision paradigm, which provides only indirect guidance for the visual pathway and often leads MLLMs to discard fine-grained visual details during training. In this paper, we present VIsual Representation ALignment (VIRAL), a simple yet effective regularization strategy that aligns the internal visual representations of MLLMs with those of pre-trained vision foundation models (VFMs). By explicitly enforcing this alignment, VIRAL enables the model not only to retain critical visual details from the input vision encoder but also to complement additional visual knowledge from VFMs, thereby enhancing its ability to reason over complex visual inputs. Our experiments demonstrate consistent improvements across all tasks on widely adopted multimodal benchmarks. Furthermore, we conduct comprehensive ablation studies to validate the key design choices underlying our framework. We believe this simple finding opens up an important direction for the effective integration of visual information in training MLLMs."},{"descriptionType":"Other","description":"Project Page: https://cvlab-kaist.github.io/VIRAL/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07979","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:54:09Z","registered":"2025-09-10T01:54:09Z","published":null,"updated":"2025-10-13T02:15:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07143","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07143","identifiers":[{"identifier":"2509.07143","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adrian","familyName":"Hayler","name":"Hayler, Adrian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingyue","familyName":"Huang","name":"Huang, Xingyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"İsmail İlkan","familyName":"Ceylan","name":"Ceylan, İsmail İlkan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Bronstein","name":"Bronstein, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ben","familyName":"Finkelshtein","name":"Finkelshtein, Ben","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bringing Graphs to the Table: Zero-shot Node Classification via Tabular Foundation Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T18:48:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:05:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-08T19:38:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T00:06:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graph foundation models (GFMs) have recently emerged as a promising paradigm for achieving broad generalization across various graph data. However, existing GFMs are often trained on datasets that may not fully reflect real-world graphs, limiting their generalization performance. In contrast, tabular foundation models (TFMs) not only excel at classical tabular prediction tasks but have also shown strong applicability in other domains such as time series forecasting, natural language processing, and computer vision. Motivated by this, we take an alternative view to the standard perspective of GFMs and reformulate node classification as a tabular problem. In this reformulation, each node is represented as a row with feature, structure, and label information as columns, enabling TFMs to directly perform zero-shot node classification via in-context learning. In this work, we introduce TAG, a tabular approach for graph learning that first converts a graph into a table via feature and structural encoders, applies multiple TFMs to diversely subsampled tables, and then aggregates their outputs through ensemble selection. Experiments on 28 real-world datasets demonstrate that TAG consistently improves upon task-specific GNNs and state-of-the-art GFMs, highlighting the potential of the tabular reformulation for scalable and generalizable graph learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07143","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:34:22Z","registered":"2025-09-10T01:34:23Z","published":null,"updated":"2025-10-10T02:37:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07627","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07627","identifiers":[{"identifier":"2509.07627","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruihao","familyName":"Zhang","name":"Zhang, Ruihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Liu","name":"Liu, Xiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LSMTCR: A Scalable Multi-Architecture Model for Epitope-Specific T Cell Receptor de novo Design"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Biomolecules (q-bio.BM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T11:55:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:38:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-10T11:16:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-11T00:29:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-28T16:56:38Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-30T01:15:00Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-08T13:31:39Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-09T00:47:55Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Designing full-length, epitope-specific TCR α\\b{eta} remains challenging due to vast sequence space, data biases and incomplete modeling of immunogenetic constraints. We present LSMTCR, a scalable multi-architecture framework that separates specificity from constraint learning to enable de novo, epitope-conditioned generation of paired, full-length TCRs. A diffusion-enhanced BERT encoder learns time-conditioned epitope representations; conditional GPT decoders, pretrained on CDR3\\b{eta} and transferred to CDR3α, generate chain-specific CDR3s under cross-modal conditioning with temperature-controlled diversity; and a gene-aware Transformer assembles complete α/\\b{eta} sequences by predicting V/J usage to ensure immunogenetic fidelity. Across GLIPH, TEP, MIRA, McPAS and our curated dataset, LSMTCR achieves higher predicted binding than baselines on most datasets, more faithfully recovers positional and length grammars, and delivers superior, temperature-tunable diversity. For α-chain generation, transfer learning improves predicted binding, length realism and diversity over representative methods. Full-length assembly from known or de novo CDR3s preserves k-mer spectra, yields low edit distances to references, and, in paired α/\\b{eta} co-modelling with epitope, attains higher pTM/ipTM than single-chain settings. LSMTCR outputs diverse, gene-contextualized, full-length TCR designs from epitope input alone, enabling high-throughput screening and iterative optimization."},{"descriptionType":"Other","description":"13 main pages, 5 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07627","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:45:42Z","registered":"2025-09-10T01:45:42Z","published":null,"updated":"2025-10-09T02:20:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07596","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07596","identifiers":[{"identifier":"2509.07596","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yusuke","familyName":"Hirota","name":"Hirota, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryo","familyName":"Hachiuma","name":"Hachiuma, Ryo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boyi","familyName":"Li","name":"Li, Boyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ximing","familyName":"Lu","name":"Lu, Ximing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael Ross","familyName":"Boone","name":"Boone, Michael Ross","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boris","familyName":"Ivanovic","name":"Ivanovic, Boris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yejin","familyName":"Choi","name":"Choi, Yejin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Pavone","name":"Pavone, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Chiang Frank","familyName":"Wang","name":"Wang, Yu-Chiang Frank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noa","familyName":"Garcia","name":"Garcia, Noa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuta","familyName":"Nakashima","name":"Nakashima, Yuta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao-Han Huck","familyName":"Yang","name":"Yang, Chao-Han Huck","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bias in Gender Bias Benchmarks: How Spurious Features Distort Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T11:14:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:37:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T14:43:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T01:37:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Gender bias in vision-language foundation models (VLMs) raises concerns about their safe deployment and is typically evaluated using benchmarks with gender annotations on real-world images. However, as these benchmarks often contain spurious correlations between gender and non-gender features, such as objects and backgrounds, we identify a critical oversight in gender bias evaluation: Do spurious features distort gender bias evaluation? To address this question, we systematically perturb non-gender features across four widely used benchmarks (COCO-gender, FACET, MIAP, and PHASE) and various VLMs to quantify their impact on bias evaluation. Our findings reveal that even minimal perturbations, such as masking just 10% of objects or weakly blurring backgrounds, can dramatically alter bias scores, shifting metrics by up to 175% in generative VLMs and 43% in CLIP variants. This suggests that current bias evaluations often reflect model responses to spurious features rather than gender bias, undermining their reliability. Since creating spurious feature-free benchmarks is fundamentally challenging, we recommend reporting bias metrics alongside feature-sensitivity measurements to enable a more reliable bias assessment."},{"descriptionType":"Other","description":"ICCV 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07596","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:44:58Z","registered":"2025-09-10T01:44:59Z","published":null,"updated":"2025-10-07T03:53:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07327","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07327","identifiers":[{"identifier":"2509.07327","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shucong","familyName":"Li","name":"Li, Shucong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyu","familyName":"Liu","name":"Liu, Zhenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijie","familyName":"Hong","name":"Hong, Zijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiheng","familyName":"Zhou","name":"Zhou, Zhiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianghai","familyName":"Cao","name":"Cao, Xianghai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DEPFusion: Dual-Domain Enhancement and Priority-Guided Mamba Fusion for UAV Multispectral Object Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T01:51:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:15:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-29T08:14:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T01:43:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multispectral object detection is an important application for unmanned aerial vehicles (UAVs). However, it faces several challenges. First, low-light RGB images weaken the multispectral fusion due to details loss. Second, the interference information is introduced to local target modeling during multispectral fusion. Third, computational cost poses deployment challenge on UAV platforms, such as transformer-based methods with quadratic complexity. To address these issues, a framework named DEPFusion consisting of two designed modules, Dual-Domain Enhancement (DDE) and Priority-Guided Mamba Fusion (PGMF) , is proposed for UAV multispectral object detection. Firstly, considering the adoption of low-frequency component for global brightness enhancement and frequency spectra features for texture-details recovery, DDE module is designed with Cross-Scale Wavelet Mamba (CSWM) block and Fourier Details Recovery (FDR) block. Secondly, considering guiding the scanning of Mamba from high priority score tokens, which contain local target feature, a novel Priority-Guided Serialization is proposed with theoretical proof. Based on it, PGMF module is designed for multispectral feature fusion, which enhance local modeling and reduce interference information. Experiments on DroneVehicle and VEDAI datasets demonstrate that DEPFusion achieves good performance with state-of-the-art methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07327","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:38:41Z","registered":"2025-09-10T01:38:42Z","published":null,"updated":"2025-09-30T05:19:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07282","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07282","identifiers":[{"identifier":"2509.07282","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeff","familyName":"Shen","name":"Shen, Jeff","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lindsay M.","familyName":"Smith","name":"Smith, Lindsay M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ALICE: An Interpretable Neural Architecture for Generalization in Substitution Ciphers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T23:33:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-15T15:21:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T01:15:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:13:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present cryptogram solving as an ideal testbed for studying neural network reasoning and generalization; models must decrypt text encoded with substitution ciphers, choosing from 26! possible mappings without explicit access to the cipher. We develop ALICE (an Architecture for Learning Interpretable Cryptogram dEcipherment), a simple encoder-only Transformer that sets a new state-of-the-art for both accuracy and speed on this decryption problem. Surprisingly, ALICE generalizes to unseen ciphers after training on only ${\\sim}1500$ unique ciphers, a minute fraction ($3.7 \\times 10^{-24}$) of the possible cipher space. To enhance interpretability, we introduce a novel bijective decoding head that explicitly models permutations via the Gumbel-Sinkhorn method, enabling direct extraction of learned cipher mappings. Through early exit and probing experiments, we reveal how ALICE progressively refines its predictions in a way that appears to mirror common human strategies -- early layers place greater emphasis on letter frequencies, while later layers form word-level structures. Our architectural innovations and analysis methods are applicable beyond cryptograms and offer new insights into neural network generalization and interpretability."},{"descriptionType":"Other","description":"Preprint. Project page at https://jshen.net/alice. Added section on probing"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07282","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:37:38Z","registered":"2025-09-10T01:37:38Z","published":null,"updated":"2025-09-26T02:12:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07755","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07755","identifiers":[{"identifier":"2509.07755","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rochana Prih","familyName":"Hastuti","name":"Hastuti, Rochana Prih","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rian Adam","familyName":"Rajagede","name":"Rajagede, Rian Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mansour Al","familyName":"Ghanim","name":"Ghanim, Mansour Al","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengxin","familyName":"Zheng","name":"Zheng, Mengxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Lou","name":"Lou, Qian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Factuality Beyond Coherence: Evaluating LLM Watermarking Methods for Medical Texts"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:54:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:45:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-20T03:20:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T00:15:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models (LLMs) are adapted to sensitive domains such as medicine, their fluency raises safety risks, particularly regarding provenance and accountability. Watermarking embeds detectable patterns to mitigate these risks, yet its reliability in medical contexts remains untested. Existing benchmarks focus on detection-quality tradeoffs and overlook factual risks. In medical text, watermarking often reweights low-entropy tokens, which are highly predictable and often carry critical medical terminology. Shifting these tokens can cause inaccuracy and hallucinations, risks that prior general-domain benchmarks fail to capture.\n We propose a medical-focused evaluation workflow that jointly assesses factual accuracy and coherence. Using GPT-Judger and further human validation, we introduce the Factuality-Weighted Score (FWS), a composite metric prioritizing factual accuracy beyond coherence to guide watermarking deployment in medical domains. Our evaluation shows current watermarking methods substantially compromise medical factuality, with entropy shifts degrading medical entity representation. These findings underscore the need for domain-aware watermarking approaches that preserve the integrity of medical content."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025 Findings. Camera Ready"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07755","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:48:53Z","registered":"2025-09-10T01:48:53Z","published":null,"updated":"2025-09-23T03:47:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07894","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07894","identifiers":[{"identifier":"2509.07894","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fangchen","familyName":"Yu","name":"Yu, Fangchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyuan","familyName":"Wan","name":"Wan, Haiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianjia","familyName":"Cheng","name":"Cheng, Qianjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Zhang","name":"Zhang, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiacheng","familyName":"Chen","name":"Chen, Jiacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fujun","familyName":"Han","name":"Han, Fujun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yulun","familyName":"Wu","name":"Wu, Yulun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junchi","familyName":"Yao","name":"Yao, Junchi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruilizhen","familyName":"Hu","name":"Hu, Ruilizhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Ding","name":"Ding, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Cheng","name":"Cheng, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Chen","name":"Chen, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Bai","name":"Bai, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongzhan","familyName":"Zhou","name":"Zhou, Dongzhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Luo","name":"Luo, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ganqu","familyName":"Cui","name":"Cui, Ganqu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Ye","name":"Ye, Peng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HiPhO: How Far Are (M)LLMs from Humans in the Latest High School Physics Olympiad Benchmark?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T16:24:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:53:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-10T11:05:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-11T00:29:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-12T18:16:53Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-16T00:04:28Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09-19T16:18:35Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-09-22T00:55:39Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recently, the physical capabilities of (M)LLMs have garnered increasing attention. However, existing benchmarks for physics suffer from two major gaps: they neither provide systematic and up-to-date coverage of real-world physics competitions such as physics Olympiads, nor enable direct performance comparison with humans. To bridge these gaps, we present HiPhO, the first benchmark dedicated to high school physics Olympiads with human-aligned evaluation. Specifically, HiPhO highlights three key innovations. (1) Comprehensive Data: It compiles 13 latest Olympiad exams from 2024-2025, spanning both international and regional competitions, and covering mixed modalities that encompass problems spanning text-only to diagram-based. (2) Professional Evaluation: We adopt official marking schemes to perform fine-grained grading at both the answer and step level, fully aligned with human examiners to ensure high-quality and domain-specific evaluation. (3) Comparison with Human Contestants: We assign gold, silver, and bronze medals to models based on official medal thresholds, thereby enabling direct comparison between (M)LLMs and human contestants. Our large-scale evaluation of 30 state-of-the-art (M)LLMs shows that: across 13 exams, open-source MLLMs mostly remain at or below the bronze level; open-source LLMs show promising progress with multiple golds; closed-source reasoning MLLMs can achieve 6 to 12 gold medals; and most models still have a significant gap from full marks. These results highlight the performance gap between open-source models and top students, the strong reasoning abilities of closed-source models, and the remaining room for improvement. HiPhO, a human-aligned Olympiad benchmark for multimodal physical reasoning, is open-source at https://github.com/SciYu/HiPhO with a public leaderboard at https://phyarena.github.io/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07894","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:52:11Z","registered":"2025-09-10T01:52:12Z","published":null,"updated":"2025-09-22T02:48:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07485","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07485","identifiers":[{"identifier":"2509.07485","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeongwoo","familyName":"Na","name":"Na, Jeongwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Kwon","name":"Kwon, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eunseong","familyName":"Choi","name":"Choi, Eunseong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jongwuk","familyName":"Lee","name":"Lee, Jongwuk","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-view-guided Passage Reranking with Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T08:05:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:28:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-19T08:47:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-22T00:34:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in large language models (LLMs) have shown impressive performance in passage reranking tasks. Despite their success, LLM-based methods still face challenges in efficiency and sensitivity to external biases. (1) Existing models rely mostly on autoregressive generation and sliding window strategies to rank passages, which incur heavy computational overhead as the number of passages increases. (2) External biases, such as position or selection bias, hinder the model's ability to accurately represent passages and increase input-order sensitivity. To address these limitations, we introduce a novel passage reranking model, called Multi-View-guided Passage Reranking (MVP). MVP is a non-generative LLM-based reranking method that encodes query-passage information into diverse view embeddings without being influenced by external biases. For each view, it combines query-aware passage embeddings to produce a distinct anchor vector, which is then used to directly compute relevance scores in a single decoding step. In addition, it employs an orthogonal loss to make the views more distinctive. Extensive experiments demonstrate that MVP, with just 220M parameters, matches the performance of much larger 7B-scale fine-tuned models while achieving a 100x reduction in inference latency. Notably, the 3B-parameter variant of MVP achieves state-of-the-art performance on both in-domain and out-of-domain benchmarks. The source code is available at: https://github.com/bulbna/MVP"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07485","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:42:23Z","registered":"2025-09-10T01:42:24Z","published":null,"updated":"2025-09-22T02:46:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07188","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07188","identifiers":[{"identifier":"2509.07188","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zonghai","familyName":"Yao","name":"Yao, Zonghai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Sun","name":"Sun, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Won Seok","familyName":"Jang","name":"Jang, Won Seok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunjae","familyName":"Kwon","name":"Kwon, Sunjae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soie","familyName":"Kwon","name":"Kwon, Soie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Yu","name":"Yu, Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DischargeSim: A Simulation Benchmark for Educational Doctor-Patient Communication at Discharge"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T20:07:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:07:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-10T01:37:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-11T00:11:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-19T02:20:08Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-22T00:16:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Discharge communication is a critical yet underexplored component of patient care, where the goal shifts from diagnosis to education. While recent large language model (LLM) benchmarks emphasize in-visit diagnostic reasoning, they fail to evaluate models' ability to support patients after the visit. We introduce DischargeSim, a novel benchmark that evaluates LLMs on their ability to act as personalized discharge educators. DischargeSim simulates post-visit, multi-turn conversations between LLM-driven DoctorAgents and PatientAgents with diverse psychosocial profiles (e.g., health literacy, education, emotion). Interactions are structured across six clinically grounded discharge topics and assessed along three axes: (1) dialogue quality via automatic and LLM-as-judge evaluation, (2) personalized document generation including free-text summaries and structured AHRQ checklists, and (3) patient comprehension through a downstream multiple-choice exam. Experiments across 18 LLMs reveal significant gaps in discharge education capability, with performance varying widely across patient profiles. Notably, model size does not always yield better education outcomes, highlighting trade-offs in strategy use and content prioritization. DischargeSim offers a first step toward benchmarking LLMs in post-visit clinical education and promoting equitable, personalized patient support."},{"descriptionType":"Other","description":"Equal contribution for the first two authors. To appear in the proceedings of the Main Conference on Empirical Methods in Natural Language Processing (EMNLP) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07188","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:35:26Z","registered":"2025-09-10T01:35:27Z","published":null,"updated":"2025-09-22T02:45:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07459","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07459","identifiers":[{"identifier":"2509.07459","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Christian Rene","familyName":"Thelen","name":"Thelen, Christian Rene","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrick Gustav","familyName":"Blaneck","name":"Blaneck, Patrick Gustav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobias","familyName":"Bornheim","name":"Bornheim, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niklas","familyName":"Grieger","name":"Grieger, Niklas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephan","familyName":"Bialonski","name":"Bialonski, Stephan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AIxcellent Vibes at GermEval 2025 Shared Task on Candy Speech Detection: Improving Model Performance by Span-Level Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T07:29:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:26:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T07:28:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:29:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Positive, supportive online communication in social media (candy speech) has the potential to foster civility, yet automated detection of such language remains underexplored, limiting systematic analysis of its impact. We investigate how candy speech can be reliably detected in a 46k-comment German YouTube corpus by monolingual and multilingual language models, including GBERT, Qwen3 Embedding, and XLM-RoBERTa. We find that a multilingual XLM-RoBERTa-Large model trained to detect candy speech at the span level outperforms other approaches, ranking first in both binary positive F1: 0.8906) and categorized span-based detection (strict F1: 0.6307) subtasks at the GermEval 2025 Shared Task on Candy Speech Detection. We speculate that span-based training, multilingual capabilities, and emoji-aware tokenizers improved detection performance. Our results demonstrate the effectiveness of multilingual models in identifying positive, supportive language."},{"descriptionType":"Other","description":"6 pages, 1 figure, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07459","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:41:47Z","registered":"2025-09-10T01:41:48Z","published":null,"updated":"2025-09-17T02:11:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07980","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07980","identifiers":[{"identifier":"2509.07980","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tong","familyName":"Zheng","name":"Zheng, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongming","familyName":"Zhang","name":"Zhang, Hongming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Yu","name":"Yu, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyang","familyName":"Wang","name":"Wang, Xiaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runpeng","familyName":"Dai","name":"Dai, Runpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huiwen","familyName":"Bao","name":"Bao, Huiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengsong","familyName":"Huang","name":"Huang, Chengsong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng","familyName":"Huang","name":"Huang, Heng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yu","name":"Yu, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Parallel-R1: Towards Parallel Thinking via Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:59:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:56:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-12T17:15:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-15T00:45:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Parallel thinking has emerged as a novel approach for enhancing the reasoning capabilities of large language models (LLMs) by exploring multiple reasoning paths concurrently. However, activating such capabilities through training remains challenging, as existing methods predominantly rely on supervised fine-tuning (SFT) over synthetic data, which encourages teacher-forced imitation rather than exploration and generalization. Different from them, we propose \\textbf{Parallel-R1}, the first reinforcement learning (RL) framework that enables parallel thinking behaviors for complex real-world reasoning tasks. Our framework employs a progressive curriculum that explicitly addresses the cold-start problem in training parallel thinking with RL. We first use SFT on prompt-generated trajectories from easier tasks to instill the parallel thinking ability, then transition to RL to explore and generalize this skill on harder problems. Experiments on various math benchmarks, including MATH, AMC23, and AIME, show that Parallel-R1 successfully instills parallel thinking, leading to 8.4% accuracy improvements over the sequential thinking model trained directly on challenging tasks with RL. Further analysis reveals a clear shift in the model's thinking behavior: at an early stage, it uses parallel thinking as an exploration strategy, while in a later stage, it uses the same capability for multi-perspective verification. Most significantly, we validate parallel thinking as a \\textbf{mid-training exploration scaffold}, where this temporary exploratory phase unlocks a higher performance ceiling after RL, yielding a 42.9% improvement over the baseline on AIME25. Our model, data, and code will be open-source at https://github.com/zhengkid/Parallel-R1."},{"descriptionType":"Other","description":"Project website: https://zhengkid.github.io/Parallel_R1.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07980","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:54:10Z","registered":"2025-09-10T01:54:11Z","published":null,"updated":"2025-09-15T01:45:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07571","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07571","identifiers":[{"identifier":"2509.07571","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiyu","familyName":"Guo","name":"Guo, Xiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shan","familyName":"Wang","name":"Wang, Shan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunfang","familyName":"Ji","name":"Ji, Chunfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuefeng","familyName":"Zhao","name":"Zhao, Xuefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Xi","name":"Xi, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaoyao","familyName":"Liu","name":"Liu, Yaoyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinglan","familyName":"Li","name":"Li, Qinglan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Deng","name":"Deng, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junlan","familyName":"Feng","name":"Feng, Junlan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Generalized Routing: Model and Agent Orchestration for Adaptive and Efficient Inference"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T10:15:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:35:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-11T02:09:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-12T00:11:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancement of large language models (LLMs) and domain-specific AI agents has greatly expanded the ecosystem of AI-powered services. User queries, however, are highly diverse and often span multiple domains and task types, resulting in a complex and heterogeneous landscape. This diversity presents a fundamental routing challenge: how to accurately direct each query to an appropriate execution unit while optimizing both performance and efficiency. To address this, we propose MoMA (Mixture of Models and Agents), a generalized routing framework that integrates both LLM and agent-based routing. Built upon a deep understanding of model and agent capabilities, MoMA effectively handles diverse queries through precise intent recognition and adaptive routing strategies, achieving an optimal balance between efficiency and cost. Specifically, we construct a detailed training dataset to profile the capabilities of various LLMs under different routing model structures, identifying the most suitable tasks for each LLM. During inference, queries are dynamically routed to the LLM with the best cost-performance efficiency. We also introduce an efficient agent selection strategy based on a context-aware state machine and dynamic masking. Experimental results demonstrate that the MoMA router offers superior cost-efficiency and scalability compared to existing approaches."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07571","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:44:23Z","registered":"2025-09-10T01:44:24Z","published":null,"updated":"2025-09-12T01:49:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07370","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07370","identifiers":[{"identifier":"2509.07370","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yixuan","familyName":"Tang","name":"Tang, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Yang","name":"Yang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmed","familyName":"Abbasi","name":"Abbasi, Ahmed","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PersonaFuse: A Personality Activation-Driven Framework for Enhancing Human-LLM Interactions"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T03:39:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:19:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-11T09:42:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-12T00:26:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in Large Language Models (LLMs) demonstrate remarkable capabilities across various fields. These developments have led to more direct communication between humans and LLMs in various situations, such as social companionship and psychological support. However, LLMs often exhibit limitations in emotional perception and social competence during real-world conversations. These limitations partly originate from their inability to adapt their communication style and emotional expression to different social and task contexts. In this work, we introduce PersonaFuse, a novel LLM post-training framework that enables LLMs to adapt and express different personalities for varying situations. Inspired by Trait Activation Theory and the Big Five personality model, PersonaFuse employs a Mixture-of-Expert architecture that combines persona adapters with a dynamic routing network, enabling contextual trait expression. Experimental results show that PersonaFuse substantially outperforms baseline models across multiple dimensions of social-emotional intelligence. Importantly, these gains are achieved without sacrificing general reasoning ability or model safety, which remain common limitations of direct prompting and supervised fine-tuning approaches. PersonaFuse also delivers consistent improvements in downstream human-centered applications, such as mental health counseling and review-based customer service. Finally, human preference evaluations against leading LLMs, including GPT-4o and DeepSeek, demonstrate that PersonaFuse achieves competitive response quality despite its comparatively smaller model size. These findings demonstrate that PersonaFuse offers a theoretically grounded and practical approach for developing social-emotional enhanced LLMs, marking a significant advancement toward more human-centric AI systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07370","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:39:41Z","registered":"2025-09-10T01:39:42Z","published":null,"updated":"2025-09-12T01:49:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07730","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07730","identifiers":[{"identifier":"2509.07730","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zexuan","familyName":"Li","name":"Li, Zexuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongliang","familyName":"Dai","name":"Dai, Hongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piji","familyName":"Li","name":"Li, Piji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"M-BRe: Discovering Training Samples for Relation Extraction from Unlabeled Texts with Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:32:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:44:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-10T04:50:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-11T00:16:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For Relation Extraction (RE), the manual annotation of training data may be prohibitively expensive, since the sentences that contain the target relations in texts can be very scarce and difficult to find. It is therefore beneficial to develop an efficient method that can automatically extract training instances from unlabeled texts for training RE models. Recently, large language models (LLMs) have been adopted in various natural language processing tasks, with RE also benefiting from their advances. However, when leveraging LLMs for RE with predefined relation categories, two key challenges arise. First, in a multi-class classification setting, LLMs often struggle to comprehensively capture the semantics of every relation, leading to suboptimal results. Second, although employing binary classification for each relation individually can mitigate this issue, it introduces significant computational overhead, resulting in impractical time complexity for real-world applications. Therefore, this paper proposes a framework called M-BRe to extract training instances from unlabeled texts for RE. It utilizes three modules to combine the advantages of both of the above classification approaches: Relation Grouping, Relation Extraction, and Label Decision. Extensive experiments confirm its superior capability in discovering high-quality training samples from unlabeled texts for RE."},{"descriptionType":"Other","description":"Accepted by EMNLP2025 Main Conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07730","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:48:13Z","registered":"2025-09-10T01:48:14Z","published":null,"updated":"2025-09-11T01:52:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07962","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07962","identifiers":[{"identifier":"2509.07962","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zongzheng","familyName":"Zhang","name":"Zhang, Zongzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haobo","familyName":"Xu","name":"Xu, Haobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuo","familyName":"Yang","name":"Yang, Zhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenghao","familyName":"Yue","name":"Yue, Chenghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zehao","familyName":"Lin","name":"Lin, Zehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan-ang","familyName":"Gao","name":"Gao, Huan-ang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziwei","familyName":"Wang","name":"Wang, Ziwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhao","name":"Zhao, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TA-VLA: Elucidating the Design Space of Torque-aware Vision-Language-Action Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:50:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:55:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Many robotic manipulation tasks require sensing and responding to force signals such as torque to assess whether the task has been successfully completed and to enable closed-loop control. However, current Vision-Language-Action (VLA) models lack the ability to integrate such subtle physical feedback. In this work, we explore Torque-aware VLA models, aiming to bridge this gap by systematically studying the design space for incorporating torque signals into existing VLA architectures. We identify and evaluate several strategies, leading to three key findings. First, introducing torque adapters into the decoder consistently outperforms inserting them into the encoder.Third, inspired by joint prediction and planning paradigms in autonomous driving, we propose predicting torque as an auxiliary output, which further improves performance. This strategy encourages the model to build a physically grounded internal representation of interaction dynamics. Extensive quantitative and qualitative experiments across contact-rich manipulation benchmarks validate our findings."},{"descriptionType":"Other","description":"Accepted to CoRL 2025, project page: \\url{https://zzongzheng0918.github.io/Torque-Aware-VLA.github.io/}"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07962","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:45Z","registered":"2025-09-10T01:53:46Z","published":null,"updated":"2025-09-10T01:53:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07957","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07957","identifiers":[{"identifier":"2509.07957","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shunlei","familyName":"Li","name":"Li, Shunlei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Longsen","familyName":"Gao","name":"Gao, Longsen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiuwen","familyName":"Cao","name":"Cao, Jiuwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingbai","familyName":"Hu","name":"Hu, Yingbai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Graph-Fused Vision-Language-Action for Policy Reasoning in Multi-Arm Robotic Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:44:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:55:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Acquiring dexterous robotic skills from human video demonstrations remains a significant challenge, largely due to conventional reliance on low-level trajectory replication, which often fails to generalize across varying objects, spatial layouts, and manipulator configurations. To address this limitation, we introduce Graph-Fused Vision-Language-Action (GF-VLA), a unified framework that enables dual-arm robotic systems to perform task-level reasoning and execution directly from RGB-D human demonstrations. GF-VLA employs an information-theoretic approach to extract task-relevant cues, selectively highlighting critical hand-object and object-object interactions. These cues are structured into temporally ordered scene graphs, which are subsequently integrated with a language-conditioned transformer to produce hierarchical behavior trees and interpretable Cartesian motion primitives. To enhance efficiency in bimanual execution, we propose a cross-arm allocation strategy that autonomously determines gripper assignment without requiring explicit geometric modeling. We validate GF-VLA on four dual-arm block assembly benchmarks involving symbolic structure construction and spatial generalization. Empirical results demonstrate that the proposed representation achieves over 95% graph accuracy and 93% subtask segmentation, enabling the language-action planner to generate robust, interpretable task policies. When deployed on a dual-arm robot, these policies attain 94% grasp reliability, 89% placement accuracy, and 90% overall task success across stacking, letter-formation, and geometric reconfiguration tasks, evidencing strong generalization and robustness under diverse spatial and semantic variations."},{"descriptionType":"Other","description":"This paper is submitted to IEEE IROS 2025 Workshop AIR4S"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07957","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:38Z","registered":"2025-09-10T01:53:39Z","published":null,"updated":"2025-09-10T01:53:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07955","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07955","identifiers":[{"identifier":"2509.07955","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Oliver","familyName":"Daniels","name":"Daniels, Oliver","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stuart","familyName":"Armstrong","name":"Armstrong, Stuart","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandre","familyName":"Maranhão","name":"Maranhão, Alexandre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahirah Fairuz","familyName":"Rahman","name":"Rahman, Mahirah Fairuz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin M.","familyName":"Marlin","name":"Marlin, Benjamin M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rebecca","familyName":"Gorman","name":"Gorman, Rebecca","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ACE and Diverse Generalization via Selective Disagreement"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:43:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:55:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep neural networks are notoriously sensitive to spurious correlations - where a model learns a shortcut that fails out-of-distribution. Existing work on spurious correlations has often focused on incomplete correlations,leveraging access to labeled instances that break the correlation. But in cases where the spurious correlations are complete, the correct generalization is fundamentally \\textit{underspecified}. To resolve this underspecification, we propose learning a set of concepts that are consistent with training data but make distinct predictions on a subset of novel unlabeled inputs. Using a self-training approach that encourages \\textit{confident} and \\textit{selective} disagreement, our method ACE matches or outperforms existing methods on a suite of complete-spurious correlation benchmarks, while remaining robust to incomplete spurious correlations. ACE is also more configurable than prior approaches, allowing for straight-forward encoding of prior knowledge and principled unsupervised model selection. In an early application to language-model alignment, we find that ACE achieves competitive performance on the measurement tampering detection benchmark \\textit{without} access to untrusted measurements. While still subject to important limitations, ACE represents significant progress towards overcoming underspecification."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07955","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:35Z","registered":"2025-09-10T01:53:36Z","published":null,"updated":"2025-09-10T01:53:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07941","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07941","identifiers":[{"identifier":"2509.07941","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kai","familyName":"Ye","name":"Ye, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liangcai","familyName":"Su","name":"Su, Liangcai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxiong","familyName":"Qian","name":"Qian, Chenxiong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ImportSnare: Directed \"Code Manual\" Hijacking in Retrieval-Augmented Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:21:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:55:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Code generation has emerged as a pivotal capability of Large Language Models(LLMs), revolutionizing development efficiency for programmers of all skill levels. However, the complexity of data structures and algorithmic logic often results in functional deficiencies and security vulnerabilities in generated code, reducing it to a prototype requiring extensive manual debugging. While Retrieval-Augmented Generation (RAG) can enhance correctness and security by leveraging external code manuals, it simultaneously introduces new attack surfaces.\n In this paper, we pioneer the exploration of attack surfaces in Retrieval-Augmented Code Generation (RACG), focusing on malicious dependency hijacking. We demonstrate how poisoned documentation containing hidden malicious dependencies (e.g., matplotlib_safe) can subvert RACG, exploiting dual trust chains: LLM reliance on RAG and developers' blind trust in LLM suggestions. To construct poisoned documents, we propose ImportSnare, a novel attack framework employing two synergistic strategies: 1)Position-aware beam search optimizes hidden ranking sequences to elevate poisoned documents in retrieval results, and 2)Multilingual inductive suggestions generate jailbreaking sequences to manipulate LLMs into recommending malicious dependencies. Through extensive experiments across Python, Rust, and JavaScript, ImportSnare achieves significant attack success rates (over 50% for popular libraries such as matplotlib and seaborn) in general, and is also able to succeed even when the poisoning ratio is as low as 0.01%, targeting both custom and real-world malicious packages. Our findings reveal critical supply chain risks in LLM-powered development, highlighting inadequate security alignment for code generation tasks. To support future research, we will release the multilingual benchmark suite and datasets. The project homepage is https://importsnare.github.io."},{"descriptionType":"Other","description":"This paper has been accepted by the ACM Conference on Computer and Communications Security (CCS) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07941","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:16Z","registered":"2025-09-10T01:53:17Z","published":null,"updated":"2025-09-10T01:53:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07933","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07933","identifiers":[{"identifier":"2509.07933","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wanni Vidulige Ishan","familyName":"Perera","name":"Perera, Wanni Vidulige Ishan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Liu","name":"Liu, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"liang","name":"liang, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyi","familyName":"Zhang","name":"Zhang, Junyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Breaking Android with AI: A Deep Dive into LLM-Powered Exploitation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:17:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:54:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid evolution of Artificial Intelligence (AI) and Large Language Models (LLMs) has opened up new opportunities in the area of cybersecurity, especially in the exploitation automation landscape and penetration testing. This study explores Android penetration testing automation using LLM-based tools, especially PentestGPT, to identify and execute rooting techniques. Through a comparison of the traditional manual rooting process and exploitation methods produced using AI, this study evaluates the efficacy, reliability, and scalability of automated penetration testing in achieving high-level privilege access on Android devices. With the use of an Android emulator (Genymotion) as the testbed, we fully execute both traditional and exploit-based rooting methods, automating the process using AI-generated scripts. Secondly, we create a web application by integrating OpenAI's API to facilitate automated script generation from LLM-processed responses. The research focuses on the effectiveness of AI-enabled exploitation by comparing automated and manual penetration testing protocols, by determining LLM weaknesses and strengths along the way. We also provide security suggestions of AI-enabled exploitation, including ethical factors and potential misuse. The findings exhibit that while LLMs can significantly streamline the workflow of exploitation, they need to be controlled by humans to ensure accuracy and ethical application. This study adds to the increasing body of literature on AI-powered cybersecurity and its effect on ethical hacking, security research, and mobile device security."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07933","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:53:05Z","registered":"2025-09-10T01:53:06Z","published":null,"updated":"2025-09-10T01:53:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07925","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07925","identifiers":[{"identifier":"2509.07925","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tuo","familyName":"Wang","name":"Wang, Tuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adithya","familyName":"Kulkarni","name":"Kulkarni, Adithya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tyler","familyName":"Cody","name":"Cody, Tyler","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter A.","familyName":"Beling","name":"Beling, Peter A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujun","familyName":"Yan","name":"Yan, Yujun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawei","familyName":"Zhou","name":"Zhou, Dawei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GENUINE: Graph Enhanced Multi-level Uncertainty Estimation for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:07:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:54:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Uncertainty estimation is essential for enhancing the reliability of Large Language Models (LLMs), particularly in high-stakes applications. Existing methods often overlook semantic dependencies, relying on token-level probability measures that fail to capture structural relationships within the generated text. We propose GENUINE: Graph ENhanced mUlti-level uncertaINty Estimation for Large Language Models, a structure-aware framework that leverages dependency parse trees and hierarchical graph pooling to refine uncertainty quantification. By incorporating supervised learning, GENUINE effectively models semantic and structural relationships, improving confidence assessments. Extensive experiments across NLP tasks show that GENUINE achieves up to 29% higher AUROC than semantic entropy-based approaches and reduces calibration errors by over 15%, demonstrating the effectiveness of graph-based uncertainty modeling. The code is available at https://github.com/ODYSSEYWT/GUQ."},{"descriptionType":"Other","description":"Accepted by EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07925","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:52:54Z","registered":"2025-09-10T01:52:55Z","published":null,"updated":"2025-09-10T01:52:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07909","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07909","identifiers":[{"identifier":"2509.07909","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arun","familyName":"Verma","name":"Verma, Arun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoxuan","familyName":"Wu","name":"Wu, Zhaoxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijian","familyName":"Zhou","name":"Zhou, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqiang","familyName":"Lin","name":"Lin, Xiaoqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiliang","familyName":"Chen","name":"Chen, Zhiliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rachael Hwee Ling","familyName":"Sim","name":"Sim, Rachael Hwee Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Qiao","name":"Qiao, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingtan","familyName":"Wang","name":"Wang, Jingtan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nhung","familyName":"Bui","name":"Bui, Nhung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyuan","familyName":"Niu","name":"Niu, Xinyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenyang","familyName":"Hu","name":"Hu, Wenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregory Kang Ruey","familyName":"Lau","name":"Lau, Gregory Kang Ruey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zi-Yu","familyName":"Khoo","name":"Khoo, Zi-Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zitong","familyName":"Zhao","name":"Zhao, Zitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Xu","name":"Xu, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Apivich","familyName":"Hemachandra","name":"Hemachandra, Apivich","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"See-Kiong","familyName":"Ng","name":"Ng, See-Kiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryan Kian Hsiang","familyName":"Low","name":"Low, Bryan Kian Hsiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncovering Scaling Laws for Large Language Models via Inverse Problems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T16:53:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:54:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are large-scale pretrained models that have achieved remarkable success across diverse domains. These successes have been driven by unprecedented complexity and scale in both data and computations. However, due to the high costs of training such models, brute-force trial-and-error approaches to improve LLMs are not feasible. Inspired by the success of inverse problems in uncovering fundamental scientific laws, this position paper advocates that inverse problems can also efficiently uncover scaling laws that guide the building of LLMs to achieve the desirable performance with significantly better cost-effectiveness."},{"descriptionType":"Other","description":"Accepted at EMNLP Findings 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07909","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:52:32Z","registered":"2025-09-10T01:52:33Z","published":null,"updated":"2025-09-10T01:52:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07908","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07908","identifiers":[{"identifier":"2509.07908","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Donya","familyName":"Rooein","name":"Rooein, Donya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vilém","familyName":"Zouhar","name":"Zouhar, Vilém","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Debora","familyName":"Nozza","name":"Nozza, Debora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dirk","familyName":"Hovy","name":"Hovy, Dirk","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Biased Tales: Cultural and Topic Bias in Generating Children's Stories"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T16:51:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:54:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Stories play a pivotal role in human communication, shaping beliefs and morals, particularly in children. As parents increasingly rely on large language models (LLMs) to craft bedtime stories, the presence of cultural and gender stereotypes in these narratives raises significant concerns. To address this issue, we present Biased Tales, a comprehensive dataset designed to analyze how biases influence protagonists' attributes and story elements in LLM-generated stories. Our analysis uncovers striking disparities. When the protagonist is described as a girl (as compared to a boy), appearance-related attributes increase by 55.26%. Stories featuring non-Western children disproportionately emphasize cultural heritage, tradition, and family themes far more than those for Western children. Our findings highlight the role of sociocultural bias in making creative AI use more equitable and diverse."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07908","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:52:31Z","registered":"2025-09-10T01:52:32Z","published":null,"updated":"2025-09-10T01:52:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07889","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07889","identifiers":[{"identifier":"2509.07889","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chengyan","familyName":"Wu","name":"Wu, Chengyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiqiang","familyName":"Cai","name":"Cai, Yiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufei","familyName":"Cheng","name":"Cheng, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Xue","name":"Xue, Yun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Detection to Mitigation: Addressing Gender Bias in Chinese Texts via Efficient Tuning and Voting-Based Rebalancing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T16:12:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:52:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents our team's solution to Shared Task 7 of NLPCC-2025, which focuses on sentence-level gender bias detection and mitigation in Chinese. The task aims to promote fairness and controllability in natural language generation by automatically detecting, classifying, and mitigating gender bias. To address this challenge, we adopt a fine-tuning approach based on large language models (LLMs), efficiently adapt to the bias detection task via Low-Rank Adaptation (LoRA). In terms of data processing, we construct a more balanced training set to alleviate class imbalance and introduce heterogeneous samples from multiple sources to enhance model generalization. For the detection and classification sub-tasks, we employ a majority voting strategy that integrates outputs from multiple expert models to boost performance. Additionally, to improve bias generation detection and mitigation, we design a multi-temperature sampling mechanism to capture potential variations in bias expression styles. Experimental results demonstrate the effectiveness of our approach in bias detection, classification, and mitigation. Our method ultimately achieves an average score of 47.90%, ranking fourth in the shared task."},{"descriptionType":"Other","description":"NLPCC 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07889","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:52:05Z","registered":"2025-09-10T01:52:06Z","published":null,"updated":"2025-09-10T01:52:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07879","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07879","identifiers":[{"identifier":"2509.07879","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"DeAlcala","name":"DeAlcala, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aythami","familyName":"Morales","name":"Morales, Aythami","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian","familyName":"Fierrez","name":"Fierrez, Julian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gonzalo","familyName":"Mancera","name":"Mancera, Gonzalo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruben","familyName":"Tolosana","name":"Tolosana, Ruben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javier","familyName":"Ortega-Garcia","name":"Ortega-Garcia, Javier","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Active Membership Inference Test (aMINT): Enhancing Model Auditability with Multi-Task Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T16:00:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:52:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Active Membership Inference Test (aMINT) is a method designed to detect whether given data were used during the training of machine learning models. In Active MINT, we propose a novel multitask learning process that involves training simultaneously two models: the original or Audited Model, and a secondary model, referred to as the MINT Model, responsible for identifying the data used for training the Audited Model. This novel multi-task learning approach has been designed to incorporate the auditability of the model as an optimization objective during the training process of neural networks. The proposed approach incorporates intermediate activation maps as inputs to the MINT layers, which are trained to enhance the detection of training data. We present results using a wide range of neural networks, from lighter architectures such as MobileNet to more complex ones such as Vision Transformers, evaluated in 5 public benchmarks. Our proposed Active MINT achieves over 80% accuracy in detecting if given data was used for training, significantly outperforming previous approaches in the literature. Our aMINT and related methodological developments contribute to increasing transparency in AI models, facilitating stronger safeguards in AI deployments to achieve proper security, privacy, and copyright protection."},{"descriptionType":"Other","description":"In Proc. IEEE/CVF Intenational Conference on Computer Vision, ICCV, 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07879","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:51:51Z","registered":"2025-09-10T01:51:51Z","published":null,"updated":"2025-09-10T01:51:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07867","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07867","identifiers":[{"identifier":"2509.07867","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Augustin","familyName":"Crespin","name":"Crespin, Augustin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ioannis","familyName":"Kostis","name":"Kostis, Ioannis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hélène","familyName":"Verhaeghe","name":"Verhaeghe, Hélène","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pierre","familyName":"Schaus","name":"Schaus, Pierre","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CP-Model-Zoo: A Natural Language Query System for Constraint Programming Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T15:55:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:51:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Constraint Programming and its high-level modeling languages have long been recognized for their potential to achieve the holy grail of problem-solving. However, the complexity of modeling languages, the large number of global constraints, and the art of creating good models have often hindered non-experts from choosing CP to solve their combinatorial problems. While generating an expert-level model from a natural-language description of a problem would be the dream, we are not yet there. We propose a tutoring system called CP-Model-Zoo, exploiting expert-written models accumulated through the years. CP-Model-Zoo retrieves the closest source code model from a database based on a user's natural language description of a combinatorial problem. It ensures that expert-validated models are presented to the user while eliminating the need for human data labeling. Our experiments show excellent accuracy in retrieving the correct model based on a user-input description of a problem simulated with different levels of expertise."},{"descriptionType":"Other","description":"presented at\"LLMs meet Constraint Solving\" Workshop at CP2025 in Glasgow"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07867","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:51:34Z","registered":"2025-09-10T01:51:34Z","published":null,"updated":"2025-09-10T01:51:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07860","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07860","identifiers":[{"identifier":"2509.07860","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guanzhi","familyName":"Deng","name":"Deng, Guanzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Xie","name":"Xie, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Keung","familyName":"Ng","name":"Ng, Yu-Keung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyang","familyName":"Liu","name":"Liu, Mingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peijun","familyName":"Zheng","name":"Zheng, Peijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Liu","name":"Liu, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dapeng","familyName":"Wu","name":"Wu, Dapeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinqiao","familyName":"Li","name":"Li, Yinqiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linqi","familyName":"Song","name":"Song, Linqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KLIPA: A Knowledge Graph and LLM-Driven QA Framework for IP Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T15:40:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:51:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Effectively managing intellectual property is a significant challenge. Traditional methods for patent analysis depend on labor-intensive manual searches and rigid keyword matching. These approaches are often inefficient and struggle to reveal the complex relationships hidden within large patent datasets, hindering strategic decision-making. To overcome these limitations, we introduce KLIPA, a novel framework that leverages a knowledge graph and a large language model (LLM) to significantly advance patent analysis. Our approach integrates three key components: a structured knowledge graph to map explicit relationships between patents, a retrieval-augmented generation(RAG) system to uncover contextual connections, and an intelligent agent that dynamically determines the optimal strategy for resolving user queries. We validated KLIPA on a comprehensive, real-world patent database, where it demonstrated substantial improvements in knowledge extraction, discovery of novel connections, and overall operational efficiency. This combination of technologies enhances retrieval accuracy, reduces reliance on domain experts, and provides a scalable, automated solution for any organization managing intellectual property, including technology corporations and legal firms, allowing them to better navigate the complexities of strategic innovation and competitive intelligence."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07860","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:51:24Z","registered":"2025-09-10T01:51:25Z","published":null,"updated":"2025-09-10T01:51:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07858","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07858","identifiers":[{"identifier":"2509.07858","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinyu","familyName":"Zhang","name":"Zhang, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changzhi","familyName":"Zhou","name":"Zhou, Changzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linmei","familyName":"Hu","name":"Hu, Linmei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luhao","familyName":"Zhang","name":"Zhang, Luhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiancai","familyName":"Chen","name":"Chen, Xiancai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haomin","familyName":"Fu","name":"Fu, Haomin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengdi","familyName":"Zhang","name":"Zhang, Mengdi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SCoder: Iterative Self-Distillation for Bootstrapping Small-Scale Data Synthesizers to Empower Code LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T15:38:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:51:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing code large language models (LLMs) often rely on large-scale instruction data distilled from proprietary LLMs for fine-tuning, which typically incurs high costs. In this paper, we explore the potential of small-scale open-source LLMs (e.g., 7B) as synthesizers for high-quality code instruction data construction. We first observe that the data synthesis capability of small-scale LLMs can be enhanced by training on a few superior data synthesis samples from proprietary LLMs. Building on this, we propose a novel iterative self-distillation approach to bootstrap small-scale LLMs, transforming them into powerful synthesizers that reduce reliance on proprietary LLMs and minimize costs. Concretely, in each iteration, to obtain diverse and high-quality self-distilled data, we design multi-checkpoint sampling and multi-aspect scoring strategies for initial data selection. Furthermore, to identify the most influential samples, we introduce a gradient-based influence estimation method for final data filtering. Based on the code instruction datasets from the small-scale synthesizers, we develop SCoder, a family of code generation models fine-tuned from DeepSeek-Coder. SCoder models achieve state-of-the-art code generation capabilities, demonstrating the effectiveness of our method."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07858","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:51:21Z","registered":"2025-09-10T01:51:22Z","published":null,"updated":"2025-09-10T01:51:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07846","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07846","identifiers":[{"identifier":"2509.07846","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amay","familyName":"Jain","name":"Jain, Amay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liu","familyName":"Cui","name":"Cui, Liu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Si","familyName":"Chen","name":"Chen, Si","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Aligning LLMs for the Classroom with Knowledge-Based Retrieval -- A Comparative RAG Study"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T15:22:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:50:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models like ChatGPT are increasingly used in classrooms, but they often provide outdated or fabricated information that can mislead students. Retrieval Augmented Generation (RAG) improves reliability of LLMs by grounding responses in external resources. We investigate two accessible RAG paradigms, vector-based retrieval and graph-based retrieval to identify best practices for classroom question answering (QA). Existing comparative studies fail to account for pedagogical factors such as educational disciplines, question types, and practical deployment costs. Using a novel dataset, EduScopeQA, of 3,176 questions across academic subjects, we measure performance on various educational query types, from specific facts to broad thematic discussions. We also evaluate system alignment with a dataset of systematically altered textbooks that contradict the LLM's latent knowledge. We find that OpenAI Vector Search RAG (representing vector-based RAG) performs well as a low-cost generalist, especially for quick fact retrieval. On the other hand, GraphRAG Global excels at providing pedagogically rich answers to thematic queries, and GraphRAG Local achieves the highest accuracy with the dense, altered textbooks when corpus integrity is critical. Accounting for the 10-20x higher resource usage of GraphRAG (representing graph-based RAG), we show that a dynamic branching framework that routes queries to the optimal retrieval method boosts fidelity and efficiency. These insights provide actionable guidelines for educators and system designers to integrate RAG-augmented LLMs into learning environments effectively."},{"descriptionType":"Other","description":"This work has been submitted to the IEEE for possible publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07846","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:51:04Z","registered":"2025-09-10T01:51:05Z","published":null,"updated":"2025-09-10T01:51:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07819","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07819","identifiers":[{"identifier":"2509.07819","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Moyan","familyName":"Zhou","name":"Zhou, Moyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soobin","familyName":"Cho","name":"Cho, Soobin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Loren","familyName":"Terveen","name":"Terveen, Loren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLMs in Wikipedia: Investigating How LLMs Impact Participation in Knowledge Communities"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T14:56:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:49:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are reshaping knowledge production as community members increasingly incorporate them into their contribution workflows. However, participating in knowledge communities involves more than just contributing content - it is also a deeply social process. While communities must carefully consider appropriate and responsible LLM integration, the absence of concrete norms has left individual editors to experiment and navigate LLM use on their own. Understanding how LLMs influence community participation is therefore critical in shaping future norms and supporting effective adoption. To address this gap, we investigated Wikipedia, one of the largest knowledge production communities, to understand 1) how LLMs influence the ways editors contribute content, 2) what strategies editors leverage to align LLM outputs with community norms, and 3) how other editors in the community respond to LLM-assisted contributions. Through interviews with 16 Wikipedia editors who had used LLMs for their edits, we found that 1) LLMs affected the content contributions for experienced and new editors differently; 2) aligning LLM outputs with community norms required tacit knowledge that often challenged newcomers; and 3) as a result, other editors responded to LLM-assisted edits differently depending on the editors' expertise level. Based on these findings, we challenge existing models of newcomer involvement and propose design implications for LLMs that support community engagement through scaffolding, teaching, and context awareness."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07819","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:50:26Z","registered":"2025-09-10T01:50:27Z","published":null,"updated":"2025-09-10T01:50:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07817","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07817","identifiers":[{"identifier":"2509.07817","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaolin","familyName":"Chen","name":"Chen, Xiaolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuemeng","familyName":"Song","name":"Song, Xuemeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haokun","familyName":"Wen","name":"Wen, Haokun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weili","familyName":"Guan","name":"Guan, Weili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyu","familyName":"Zhao","name":"Zhao, Xiangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liqiang","familyName":"Nie","name":"Nie, Liqiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dual Knowledge-Enhanced Two-Stage Reasoner for Multimodal Dialog Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T14:55:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:49:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Textual response generation is pivotal for multimodal \\mbox{task-oriented} dialog systems, which aims to generate proper textual responses based on the multimodal context. While existing efforts have demonstrated remarkable progress, there still exist the following limitations: 1) \\textit{neglect of unstructured review knowledge} and 2) \\textit{underutilization of large language models (LLMs)}. Inspired by this, we aim to fully utilize dual knowledge (\\textit{i.e., } structured attribute and unstructured review knowledge) with LLMs to promote textual response generation in multimodal task-oriented dialog systems. However, this task is non-trivial due to two key challenges: 1) \\textit{dynamic knowledge type selection} and 2) \\textit{intention-response decoupling}. To address these challenges, we propose a novel dual knowledge-enhanced two-stage reasoner by adapting LLMs for multimodal dialog systems (named DK2R). To be specific, DK2R first extracts both structured attribute and unstructured review knowledge from external knowledge base given the dialog context. Thereafter, DK2R uses an LLM to evaluate each knowledge type's utility by analyzing LLM-generated provisional probe responses. Moreover, DK2R separately summarizes the intention-oriented key clues via dedicated reasoning, which are further used as auxiliary signals to enhance LLM-based textual response generation. Extensive experiments conducted on a public dataset verify the superiority of DK2R. We have released the codes and parameters."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07817","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:50:23Z","registered":"2025-09-10T01:50:24Z","published":null,"updated":"2025-09-10T01:50:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07768","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07768","identifiers":[{"identifier":"2509.07768","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michele Joshua","familyName":"Maggini","name":"Maggini, Michele Joshua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dhia","familyName":"Merzougui","name":"Merzougui, Dhia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rabiraj","familyName":"Bandyopadhyay","name":"Bandyopadhyay, Rabiraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaël","familyName":"Dias","name":"Dias, Gaël","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabrice","familyName":"Maurel","name":"Maurel, Fabrice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pablo","familyName":"Gamallo","name":"Gamallo, Pablo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Are LLMs Enough for Hyperpartisan, Fake, Polarized and Harmful Content Detection? Evaluating In-Context Learning vs. Fine-Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T14:01:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:46:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The spread of fake news, polarizing, politically biased, and harmful content on online platforms has been a serious concern. With large language models becoming a promising approach, however, no study has properly benchmarked their performance across different models, usage methods, and languages. This study presents a comprehensive overview of different Large Language Models adaptation paradigms for the detection of hyperpartisan and fake news, harmful tweets, and political bias. Our experiments spanned 10 datasets and 5 different languages (English, Spanish, Portuguese, Arabic and Bulgarian), covering both binary and multiclass classification scenarios. We tested different strategies ranging from parameter efficient Fine-Tuning of language models to a variety of different In-Context Learning strategies and prompts. These included zero-shot prompts, codebooks, few-shot (with both randomly-selected and diversely-selected examples using Determinantal Point Processes), and Chain-of-Thought. We discovered that In-Context Learning often underperforms when compared to Fine-Tuning a model. This main finding highlights the importance of Fine-Tuning even smaller models on task-specific settings even when compared to the largest models evaluated in an In-Context Learning setup - in our case LlaMA3.1-8b-Instruct, Mistral-Nemo-Instruct-2407 and Qwen2.5-7B-Instruct."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07768","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:49:12Z","registered":"2025-09-10T01:49:13Z","published":null,"updated":"2025-09-10T01:49:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07764","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07764","identifiers":[{"identifier":"2509.07764","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haitao","familyName":"Hu","name":"Hu, Haitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Chen","name":"Chen, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanpeng","familyName":"Zhao","name":"Zhao, Yanpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Chen","name":"Chen, Yuqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgentSentinel: An End-to-End and Real-Time Security Defense Framework for Computer-Use Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:59:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:46:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have been increasingly integrated into computer-use agents, which can autonomously operate tools on a user's computer to accomplish complex tasks. However, due to the inherently unstable and unpredictable nature of LLM outputs, they may issue unintended tool commands or incorrect inputs, leading to potentially harmful operations. Unlike traditional security risks stemming from insecure user prompts, tool execution results from LLM-driven decisions introduce new and unique security challenges. These vulnerabilities span across all components of a computer-use agent. To mitigate these risks, we propose AgentSentinel, an end-to-end, real-time defense framework designed to mitigate potential security threats on a user's computer. AgentSentinel intercepts all sensitive operations within agent-related services and halts execution until a comprehensive security audit is completed. Our security auditing mechanism introduces a novel inspection process that correlates the current task context with system traces generated during task execution. To thoroughly evaluate AgentSentinel, we present BadComputerUse, a benchmark consisting of 60 diverse attack scenarios across six attack categories. The benchmark demonstrates a 87% average attack success rate on four state-of-the-art LLMs. Our evaluation shows that AgentSentinel achieves an average defense success rate of 79.6%, significantly outperforming all baseline defenses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07764","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:49:06Z","registered":"2025-09-10T01:49:07Z","published":null,"updated":"2025-09-10T01:49:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07763","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07763","identifiers":[{"identifier":"2509.07763","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mikel","familyName":"Robredo","name":"Robredo, Mikel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Esposito","name":"Esposito, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Palomba","name":"Palomba, Fabio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafael","familyName":"Peñaloza","name":"Peñaloza, Rafael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentina","familyName":"Lenarduzzi","name":"Lenarduzzi, Valentina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What Were You Thinking? An LLM-Driven Large-Scale Study of Refactoring Motivations in Open-Source Projects"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:58:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:46:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Context. Code refactoring improves software quality without changing external behavior. Despite its advantages, its benefits are hindered by the considerable cost of time, resources, and continuous effort it demands. Aim. Understanding why developers refactor, and which metrics capture these motivations, may support wider and more effective use of refactoring in practice. Method. We performed a large-scale empirical study to analyze developers refactoring activity, leveraging Large Language Models (LLMs) to identify underlying motivations from version control data, comparing our findings with previous motivations reported in the literature. Results. LLMs matched human judgment in 80% of cases, but aligned with literature-based motivations in only 47%. They enriched 22% of motivations with more detailed rationale, often highlighting readability, clarity, and structural improvements. Most motivations were pragmatic, focused on simplification and maintainability. While metrics related to developer experience and code readability ranked highest, their correlation with motivation categories was weak. Conclusions. We conclude that LLMs effectively capture surface-level motivations but struggle with architectural reasoning. Their value lies in providing localized explanations, which, when combined with software metrics, can form hybrid approaches. Such integration offers a promising path toward prioritizing refactoring more systematically and balancing short-term improvements with long-term architectural goals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07763","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:49:05Z","registered":"2025-09-10T01:49:06Z","published":null,"updated":"2025-09-10T01:49:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07727","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07727","identifiers":[{"identifier":"2509.07727","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Songkai","familyName":"Ma","name":"Ma, Songkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaorui","familyName":"Zhang","name":"Zhang, Zhaorui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Di","name":"Di, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benben","familyName":"Liu","name":"Liu, Benben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodong","familyName":"Yu","name":"Yu, Xiaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"Lu","name":"Lu, Xiaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Wang","name":"Wang, Dan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MoE-Compression: How the Compression Error of Experts Affects the Inference Accuracy of MoE Model?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:28:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:44:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the widespread application of Mixture of Experts (MoE) reasoning models in the field of LLM learning, efficiently serving MoE models under limited GPU memory constraints has emerged as a significant challenge. Offloading the non-activated experts to main memory has been identified as an efficient approach to address such a problem, while it brings the challenges of transferring the expert between the GPU memory and main memory. We need to explore an efficient approach to compress the expert and analyze how the compression error affects the inference performance.\n To bridge this gap, we propose employing error-bounded lossy compression algorithms (such as SZ3 and CuSZp) to compress non-activated experts, thereby reducing data transfer overhead during MoE inference. We conduct extensive experiments across various benchmarks and present a comprehensive analysis of how compression-induced errors in different experts affect overall inference accuracy. The results indicate that experts in the shallow layers, which are primarily responsible for the attention mechanism and the transformation of input tokens into vector representations, exhibit minimal degradation in inference accuracy when subjected to bounded errors. In contrast, errors in the middle-layer experts, which are central to model reasoning, significantly impair inference accuracy. Interestingly, introducing bounded errors in the deep-layer experts, which are mainly responsible for instruction following and output integration, can sometimes lead to improvements in inference accuracy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07727","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:48:09Z","registered":"2025-09-10T01:48:10Z","published":null,"updated":"2025-09-10T01:48:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07711","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07711","identifiers":[{"identifier":"2509.07711","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziye","familyName":"Chen","name":"Chen, Ziye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengwei","familyName":"Qin","name":"Qin, Chengwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Shu","name":"Shu, Yao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RIMO: An Easy-to-Evaluate, Hard-to-Solve Olympiad Benchmark for Advanced Mathematical Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:13:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:43:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models (LLMs) reach high scores on established mathematical benchmarks, such as GSM8K and MATH, the research community has turned to International Mathematical Olympiad (IMO) problems to push the evaluation frontier. However, existing Olympiad-level benchmarks suffer from practical constraints that introduce grading noise and potential bias, such as heterogeneous answer formats requiring model-based judges and a reliance on potentially flawed solutions. We introduce RIMO, a two-track benchmark designed to preserve peak Olympiad difficulty while eliminating this evaluation noise. The first track, RIMO-N, rewrites 335 IMO problems to admit a single, unique integer answer, allowing for deterministic correctness checking. The second track, RIMO-P, features 456 proof problems with expert-checked solutions, which are decomposed into a sequence of sub-problems to evaluate the step-by-step reasoning process via an automated grading system. Our benchmarking of ten frontier LLMs, including GPT-4o and Gemini 2.5 Flash, reveals that while these systems excel on older benchmarks, their performance drops sharply on RIMO. These results highlight a substantial gap between current LLM capabilities and actual Olympiad-level reasoning. By providing a challenging yet easy-to-evaluate suite, RIMO offers a high-resolution yardstick for future research, presenting a clear target for closing the profound reasoning gap our findings expose."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07711","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:47:47Z","registered":"2025-09-10T01:47:47Z","published":null,"updated":"2025-09-10T01:47:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07700","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07700","identifiers":[{"identifier":"2509.07700","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["CERN"],"givenName":"Piyush","familyName":"Raikwar","name":"Raikwar, Piyush","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["CERN"],"givenName":"Anna","familyName":"Zaborowska","name":"Zaborowska, Anna","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["CERN"],"givenName":"Peter","familyName":"McKeown","name":"McKeown, Peter","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["CERN"],"givenName":"Renato","familyName":"Cardoso","name":"Cardoso, Renato","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["CERN, Warsaw University of Technology"],"givenName":"Mikolaj","familyName":"Piorczynski","name":"Piorczynski, Mikolaj","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Thomas J. Watson Research Center"],"givenName":"Kyongmin","familyName":"Yeo","name":"Yeo, Kyongmin","nameIdentifiers":[]}],"titles":[{"title":"A Generalisable Generative Model for Multi-Detector Calorimeter Simulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:04:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:42:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Collider experiments, such as those at the Large Hadron Collider, use the Geant4 toolkit to simulate particle-detector interactions with high accuracy. However, these experiments increasingly require larger amounts of simulated data, leading to huge computing cost. Generative machine learning methods could offer much faster calorimeter shower simulations by directly emulating detector responses. In this work, we present CaloDiT-2, a diffusion model which uses transformer blocks. As is the case for other models explored for this task, it can be applied to specific geometries, however its true strength lies in its generalisation capabilities. Our approach allows pre-training on multiple detectors and rapid adaptation to new ones, which we demonstrate on the LEMURS dataset. It reduces the effort required to develop accurate models for novel detectors or detectors which are under development and have geometries that are changed frequently, requiring up to 25x less data and 20x less training time. To the best of our knowledge, this is the first pre-trained model to be published that allows adaptation in the context of particle shower simulations, with the model also included in the Geant4 toolkit. We also present results on benchmarks on Dataset-2 from the community-hosted CaloChallenge, showing that our models provide one of the best tradeoffs between accuracy and speed from the published models. Our contributions include a mechanism for the creation of detector-agnostic data representations, architectural modifications suitable for the data modality, a pre-training and adaptation strategy, and publicly released datasets and pre-trained models for broad use."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07700","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:47:32Z","registered":"2025-09-10T01:47:32Z","published":null,"updated":"2025-09-10T01:47:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07680","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07680","identifiers":[{"identifier":"2509.07680","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sachit","familyName":"Menon","name":"Menon, Sachit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmet","familyName":"Iscen","name":"Iscen, Ahmet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arsha","familyName":"Nagrani","name":"Nagrani, Arsha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobias","familyName":"Weyand","name":"Weyand, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carl","familyName":"Vondrick","name":"Vondrick, Carl","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cordelia","familyName":"Schmid","name":"Schmid, Cordelia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CAViAR: Critic-Augmented Video Agentic Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T17:59:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:41:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Video understanding has seen significant progress in recent years, with models' performance on perception from short clips continuing to rise. Yet, multiple recent benchmarks, such as LVBench, Neptune, and ActivityNet-RTL, show performance wanes for tasks requiring complex reasoning on videos as queries grow more complex and videos grow longer. In this work, we ask: can existing perception capabilities be leveraged to successfully perform more complex video reasoning? In particular, we develop a large language model agent given access to video modules as subagents or tools. Rather than following a fixed procedure to solve queries as in previous work such as Visual Programming, ViperGPT, and MoReVQA, the agent uses the results of each call to a module to determine subsequent steps. Inspired by work in the textual reasoning domain, we introduce a critic to distinguish between instances of successful and unsuccessful sequences from the agent. We show that the combination of our agent and critic achieve strong performance on the previously-mentioned datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07680","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:47:02Z","registered":"2025-09-10T01:47:02Z","published":null,"updated":"2025-09-10T01:47:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07676","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07676","identifiers":[{"identifier":"2509.07676","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jipeng","familyName":"Li","name":"Li, Jipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Gao","name":"Gao, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yubin","familyName":"Qi","name":"Qi, Yubin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hande","familyName":"Dong","name":"Dong, Hande","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weijian","familyName":"Chen","name":"Chen, Weijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Lin","name":"Lin, Qiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unleashing the True Potential of LLMs: A Feedback-Triggered Self-Correction with Long-Term Multipath Decoding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T12:43:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:41:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have achieved remarkable performance across diverse tasks, yet their susceptibility to generating incorrect content during inference remains a critical unsolved challenge. While self-correction methods offer potential solutions, their effectiveness is hindered by two inherent limitations: (1) the absence of reliable guidance signals for error localization, and (2) the restricted reasoning depth imposed by conventional next-token decoding paradigms. To address these issues, we propose Feedback-Triggered Regeneration (FTR), a novel framework that synergizes user feedback with enhanced decoding dynamics. Specifically, FTR activates response regeneration only upon receiving negative user feedback, thereby circumventing error propagation from faulty self-assessment while preserving originally correct outputs. Furthermore, we introduce Long-Term Multipath (LTM) decoding, which enables systematic exploration of multiple reasoning trajectories through delayed sequence evaluation, effectively overcoming the myopic decision-making characteristic of standard next-token prediction. Extensive experiments on mathematical reasoning and code generation benchmarks demonstrate that our framework achieves consistent and significant improvements over state-of-the-art prompt-based self-correction methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07676","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:46:56Z","registered":"2025-09-10T01:46:57Z","published":null,"updated":"2025-09-10T01:46:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07666","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07666","identifiers":[{"identifier":"2509.07666","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xixi","familyName":"Wu","name":"Wu, Xixi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanchao","familyName":"Tan","name":"Tan, Yanchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Hou","name":"Hou, Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiyang","familyName":"Zhang","name":"Zhang, Ruiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Cheng","name":"Cheng, Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MoLoRAG: Bootstrapping Document Understanding via Multi-modal Logic-aware Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-06T00:59:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:40:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Document Understanding is a foundational AI capability with broad applications, and Document Question Answering (DocQA) is a key evaluation task. Traditional methods convert the document into text for processing by Large Language Models (LLMs), but this process strips away critical multi-modal information like figures. While Large Vision-Language Models (LVLMs) address this limitation, their constrained input size makes multi-page document comprehension infeasible. Retrieval-augmented generation (RAG) methods mitigate this by selecting relevant pages, but they rely solely on semantic relevance, ignoring logical connections between pages and the query, which is essential for reasoning.\n To this end, we propose MoLoRAG, a logic-aware retrieval framework for multi-modal, multi-page document understanding. By constructing a page graph that captures contextual relationships between pages, a lightweight VLM performs graph traversal to retrieve relevant pages, including those with logical connections often overlooked. This approach combines semantic and logical relevance to deliver more accurate retrieval. After retrieval, the top-$K$ pages are fed into arbitrary LVLMs for question answering. To enhance flexibility, MoLoRAG offers two variants: a training-free solution for easy deployment and a fine-tuned version to improve logical relevance checking. Experiments on four DocQA datasets demonstrate average improvements of 9.68% in accuracy over LVLM direct inference and 7.44% in retrieval precision over baselines. Codes and datasets are released at https://github.com/WxxShirley/MoLoRAG."},{"descriptionType":"Other","description":"EMNLP Main 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07666","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:46:42Z","registered":"2025-09-10T01:46:42Z","published":null,"updated":"2025-09-10T01:46:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07642","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07642","identifiers":[{"identifier":"2509.07642","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sascha","familyName":"Kaltenpoth","name":"Kaltenpoth, Sascha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oliver","familyName":"Müller","name":"Müller, Oliver","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Getting In Contract with Large Language Models -- An Agency Theory Perspective On Large Language Model Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T12:10:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:39:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Adopting Large language models (LLMs) in organizations potentially revolutionizes our lives and work. However, they can generate off-topic, discriminating, or harmful content. This AI alignment problem often stems from misspecifications during the LLM adoption, unnoticed by the principal due to the LLM's black-box nature. While various research disciplines investigated AI alignment, they neither address the information asymmetries between organizational adopters and black-box LLM agents nor consider organizational AI adoption processes. Therefore, we propose LLM ATLAS (LLM Agency Theory-Led Alignment Strategy) a conceptual framework grounded in agency (contract) theory, to mitigate alignment problems during organizational LLM adoption. We conduct a conceptual literature analysis using the organizational LLM adoption phases and the agency theory as concepts. Our approach results in (1) providing an extended literature analysis process specific to AI alignment methods during organizational LLM adoption and (2) providing a first LLM alignment problem-solution space."},{"descriptionType":"Other","description":"Presented at the 19th International Conference on Wirtschaftsinformatik 2024, W\\\"urzburg, Germany https://aisel.aisnet.org/wi2024/91/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07642","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:46:03Z","registered":"2025-09-10T01:46:04Z","published":null,"updated":"2025-09-10T01:46:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07635","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07635","identifiers":[{"identifier":"2509.07635","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paolo","familyName":"Combes","name":"Combes, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Weinzierl","name":"Weinzierl, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Klaus","familyName":"Obermayer","name":"Obermayer, Klaus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Neural Proxies for Sound Synthesizers: Learning Perceptually Informed Preset Representations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.5.5; J.5; I.5.4","lang":"en","subjectScheme":"ACM"},{"subject":"68T07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-09T12:01:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:39:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.17743/jaes.2022.0219","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep learning appears as an appealing solution for Automatic Synthesizer Programming (ASP), which aims to assist musicians and sound designers in programming sound synthesizers. However, integrating software synthesizers into training pipelines is challenging due to their potential non-differentiability. This work tackles this challenge by introducing a method to approximate arbitrary synthesizers. Specifically, we train a neural network to map synthesizer presets onto an audio embedding space derived from a pretrained model. This facilitates the definition of a neural proxy that produces compact yet effective representations, thereby enabling the integration of audio embedding loss into neural-based ASP systems for black-box synthesizers. We evaluate the representations derived by various pretrained audio models in the context of neural-based nASP and assess the effectiveness of several neural network architectures, including feedforward, recurrent, and transformer-based models, in defining neural proxies. We evaluate the proposed method using both synthetic and hand-crafted presets from three popular software synthesizers and assess its performance in a synthesizer sound matching downstream task. While the benefits of the learned representation are nuanced by resource requirements, encouraging results were obtained for all synthesizers, paving the way for future research into the application of synthesizer proxies for neural-based ASP systems."},{"descriptionType":"Other","description":"17 pages, 4 figures, published in the Journal of the Audio Engineering Society"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07635","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:45:53Z","registered":"2025-09-10T01:45:54Z","published":null,"updated":"2025-09-10T01:45:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07622","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07622","identifiers":[{"identifier":"2509.07622","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Libo","familyName":"Ren","name":"Ren, Libo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yee Man","familyName":"Ng","name":"Ng, Yee Man","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifeng","familyName":"Han","name":"Han, Lifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MaLei at MultiClinSUM: Summarisation of Clinical Documents using Perspective-Aware Iterative Self-Prompting with LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T11:52:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:38:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficient communication between patients and clinicians plays an important role in shared decision-making. However, clinical reports are often lengthy and filled with clinical jargon, making it difficult for domain experts to identify important aspects in the document efficiently. This paper presents the methodology we applied in the MultiClinSUM shared task for summarising clinical case documents. We used an Iterative Self-Prompting technique on large language models (LLMs) by asking LLMs to generate task-specific prompts and refine them via example-based few-shot learning. Furthermore, we used lexical and embedding space metrics, ROUGE and BERT-score, to guide the model fine-tuning with epochs. Our submission using perspective-aware ISP on GPT-4 and GPT-4o achieved ROUGE scores (46.53, 24.68, 30.77) and BERTscores (87.84, 83.25, 85.46) for (P, R, F1) from the official evaluation on 3,396 clinical case reports from various specialties extracted from open journals. The high BERTscore indicates that the model produced semantically equivalent output summaries compared to the references, even though the overlap at the exact lexicon level is lower, as reflected in the lower ROUGE scores. This work sheds some light on how perspective-aware ISP (PA-ISP) can be deployed for clinical report summarisation and support better communication between patients and clinicians."},{"descriptionType":"Other","description":"system paper at CLEF 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07622","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:45:35Z","registered":"2025-09-10T01:45:36Z","published":null,"updated":"2025-09-10T01:45:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07617","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07617","identifiers":[{"identifier":"2509.07617","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minghui","familyName":"Li","name":"Li, Minghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhang","name":"Zhang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yechao","familyName":"Zhang","name":"Zhang, Yechao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wan","name":"Wan, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengshan","familyName":"Hu","name":"Hu, Shengshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"pei","familyName":"Xiaobing","name":"Xiaobing, pei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Wang","name":"Wang, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transferable Direct Prompt Injection via Activation-Guided MCMC Sampling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T11:42:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:38:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Direct Prompt Injection (DPI) attacks pose a critical security threat to Large Language Models (LLMs) due to their low barrier of execution and high potential damage. To address the impracticality of existing white-box/gray-box methods and the poor transferability of black-box methods, we propose an activations-guided prompt injection attack framework. We first construct an Energy-based Model (EBM) using activations from a surrogate model to evaluate the quality of adversarial prompts. Guided by the trained EBM, we employ the token-level Markov Chain Monte Carlo (MCMC) sampling to adaptively optimize adversarial prompts, thereby enabling gradient-free black-box attacks. Experimental results demonstrate our superior cross-model transferability, achieving 49.6% attack success rate (ASR) across five mainstream LLMs and 34.6% improvement over human-crafted prompts, and maintaining 36.6% ASR on unseen task scenarios. Interpretability analysis reveals a correlation between activations and attack effectiveness, highlighting the critical role of semantic patterns in transferable vulnerability exploitation."},{"descriptionType":"Other","description":"Accepted to EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07617","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:45:28Z","registered":"2025-09-10T01:45:29Z","published":null,"updated":"2025-09-10T01:45:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07603","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07603","identifiers":[{"identifier":"2509.07603","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mehdi","familyName":"Bejani","name":"Bejani, Mehdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Mauri","name":"Mauri, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniele","familyName":"Acconcia","name":"Acconcia, Daniele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Todaro","name":"Todaro, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Mariani","name":"Mariani, Stefano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformer-Based Approach to Optimal Sensor Placement for Structural Health Monitoring of Probe Cards"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T11:21:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:37:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents an innovative Transformer-based deep learning strategy for optimizing the placement of sensors aiming at structural health monitoring of semiconductor probe cards. Failures in probe cards, including substrate cracks and loosened screws, would critically affect semiconductor manufacturing yield and reliability. Some failure modes could be detected by equipping a probe card with adequate sensors. Frequency response functions from simulated failure scenarios are adopted within a finite element model of a probe card. A comprehensive dataset, enriched by physics-informed scenario expansion and physics-aware statistical data augmentation, is exploited to train a hybrid Convolutional Neural Network and Transformer model. The model achieves high accuracy (99.83%) in classifying the probe card health states (baseline, loose screw, crack) and an excellent crack detection recall (99.73%). Model robustness is confirmed through a rigorous framework of 3 repetitions of 10-fold stratified cross-validation. The attention mechanism also pinpoints critical sensor locations: an analysis of the attention weights offers actionable insights for designing efficient, cost-effective monitoring systems by optimizing sensor configurations. This research highlights the capability of attention-based deep learning to advance proactive maintenance, enhancing operational reliability and yield in semiconductor manufacturing."},{"descriptionType":"Other","description":"22 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07603","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:45:08Z","registered":"2025-09-10T01:45:09Z","published":null,"updated":"2025-09-10T01:45:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07595","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07595","identifiers":[{"identifier":"2509.07595","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shiva Sai Krishna Anand","familyName":"Tokal","name":"Tokal, Shiva Sai Krishna Anand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vaibhav","familyName":"Jha","name":"Jha, Vaibhav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anand","familyName":"Eswaran","name":"Eswaran, Anand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Praveen","familyName":"Jayachandran","name":"Jayachandran, Praveen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yogesh","familyName":"Simmhan","name":"Simmhan, Yogesh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgentX: Towards Orchestrating Robust Agentic Workflow Patterns with FaaS-hosted MCP Services"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T11:07:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:37:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative Artificial Intelligence (GenAI) has rapidly transformed various fields including code generation, text summarization, image generation and so on. Agentic AI is a recent evolution that further advances this by coupling the decision making and generative capabilities of LLMs with actions that can be performed using tools. While seemingly powerful, Agentic systems often struggle when faced with numerous tools, complex multi-step tasks,and long-context management to track history and avoid hallucinations. Workflow patterns such as Chain-of-Thought (CoT) and ReAct help address this. Here, we define a novel agentic workflow pattern, AgentX, composed of stage designer, planner, and executor agents that is competitive or better than the state-of-the-art agentic patterns. We also leverage Model Context Protocol (MCP) tools, and propose two alternative approaches for deploying MCP servers as cloud Functions as a Service (FaaS). We empirically evaluate the success rate, latency and cost for AgentX and two contemporary agentic patterns, ReAct and Magentic One, using these the FaaS and local MCP server alternatives for three practical applications. This highlights the opportunities and challenges of designing and deploying agentic workflows."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07595","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:44:57Z","registered":"2025-09-10T01:44:58Z","published":null,"updated":"2025-09-10T01:44:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.07594","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07594","identifiers":[{"identifier":"2509.07594","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"Dong","name":"Dong, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Ouyang","name":"Ouyang, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangzheng","familyName":"Liu","name":"Liu, Xiangzheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ELEC: Efficient Large Language Model-Empowered Click-Through Rate Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T11:06:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:37:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3726302.3730188","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Click-through rate (CTR) prediction plays an important role in online advertising systems. On the one hand, traditional CTR prediction models capture the collaborative signals in tabular data via feature interaction modeling, but they lose semantics in text. On the other hand, Large Language Models (LLMs) excel in understanding the context and meaning behind text, but they face challenges in capturing collaborative signals and they have long inference latency. In this paper, we aim to leverage the benefits of both types of models and pursue collaboration, semantics and efficiency. We present ELEC, which is an Efficient LLM-Empowered CTR prediction framework. We first adapt an LLM for the CTR prediction task. In order to leverage the ability of the LLM but simultaneously keep efficiency, we utilize the pseudo-siamese network which contains a gain network and a vanilla network. We inject the high-level representation vector generated by the LLM into a collaborative CTR model to form the gain network such that it can take advantage of both tabular modeling and textual modeling. However, its reliance on the LLM limits its efficiency. We then distill the knowledge from the gain network to the vanilla network on both the score level and the representation level, such that the vanilla network takes only tabular data as input, but can still generate comparable performance as the gain network. Our approach is model-agnostic. It allows for the integration with various existing LLMs and collaborative CTR models. Experiments on real-world datasets demonstrate the effectiveness and efficiency of ELEC for CTR prediction."},{"descriptionType":"Other","description":"SIGIR 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07594","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-10T01:44:56Z","registered":"2025-09-10T01:44:56Z","published":null,"updated":"2025-09-10T01:44:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":155,"totalPages":2,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bsize%5D=100\u0026page%5Bnumber%5D=1\u0026query=registered%3A%5B2025-09-09T16%3A00%3A00Z+TO+2025-09-10T15%3A59%3A59Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22mixture+of+experts%22+OR+%22mixtures+of+experts%22+OR+%22foundation+model%22+OR+%22foundation+models%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22mixture+of+experts%22+OR+%22mixtures+of+experts%22+OR+%22foundation+model%22+OR+%22foundation+models%22%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=2\u0026page%5Bsize%5D=100\u0026query=registered%3A%5B2025-09-09T16%3A00%3A00Z+TO+2025-09-10T15%3A59%3A59Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22mixture+of+experts%22+OR+%22mixtures+of+experts%22+OR+%22foundation+model%22+OR+%22foundation+models%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22mixture+of+experts%22+OR+%22mixtures+of+experts%22+OR+%22foundation+model%22+OR+%22foundation+models%22%29%29"}}