<td id="A2.T4.5.1.6.10" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m57" class="ltx_Math" alttext="246" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">246</mn><annotation encoding="application/x-tex">246</annotation></semantics></math><span id="A2.T4.5.1.6.10.1" class="ltx_text" style="font-size:298%;">s</span></td>
<td id="A2.T4.5.1.6.11" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m58" class="ltx_Math" alttext="0.845" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">0.845</mn><annotation encoding="application/x-tex">0.845</annotation></semantics></math></td>
<td id="A2.T4.5.1.6.12" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m59" class="ltx_Math" alttext="2.329" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">2.329</mn><annotation encoding="application/x-tex">2.329</annotation></semantics></math></td>
<td id="A2.T4.5.1.6.13" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m60" class="ltx_Math" alttext="272" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">272</mn><annotation encoding="application/x-tex">272</annotation></semantics></math><span id="A2.T4.5.1.6.13.1" class="ltx_text" style="font-size:298%;">s</span></td></tr>
</tbody>
