<td id="A2.T4.5.1.5.10" class="ltx_td ltx_align_center"><math id="A2.T4.m45" class="ltx_Math" alttext="368" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">368</mn><annotation encoding="application/x-tex">368</annotation></semantics></math><span id="A2.T4.5.1.5.10.1" class="ltx_text" style="font-size:298%;">s</span></td>
<td id="A2.T4.5.1.5.11" class="ltx_td ltx_align_center"><math id="A2.T4.m46" class="ltx_Math" alttext="0.760" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">0.760</mn><annotation encoding="application/x-tex">0.760</annotation></semantics></math></td>
<td id="A2.T4.5.1.5.12" class="ltx_td ltx_align_center"><math id="A2.T4.m47" class="ltx_Math" alttext="1.699" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">1.699</mn><annotation encoding="application/x-tex">1.699</annotation></semantics></math></td>
<td id="A2.T4.5.1.5.13" class="ltx_td ltx_align_center"><math id="A2.T4.m48" class="ltx_Math" alttext="244" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">244</mn><annotation encoding="application/x-tex">244</annotation></semantics></math><span id="A2.T4.5.1.5.13.1" class="ltx_text" style="font-size:298%;">s</span></td></tr>
<tr id="A2.T4.5.1.6" class="ltx_tr">
<th id="A2.T4.5.1.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r"><span id="A2.T4.5.1.6.1.1" class="ltx_text" style="font-size:298%;">ImT+ImG</span></th>
<td id="A2.T4.5.1.6.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m49" class="ltx_Math" alttext="0.748" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">0.748</mn><annotation encoding="application/x-tex">0.748</annotation></semantics></math></td>
<td id="A2.T4.5.1.6.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m50" class="ltx_Math" alttext="2.065" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">2.065</mn><annotation encoding="application/x-tex">2.065</annotation></semantics></math></td>
<td id="A2.T4.5.1.6.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m51" class="ltx_Math" alttext="156" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">156</mn><annotation encoding="application/x-tex">156</annotation></semantics></math><span id="A2.T4.5.1.6.4.1" class="ltx_text" style="font-size:298%;">s</span></td>
<td id="A2.T4.5.1.6.5" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m52" class="ltx_Math" alttext="0.762" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">0.762</mn><annotation encoding="application/x-tex">0.762</annotation></semantics></math></td>
<td id="A2.T4.5.1.6.6" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m53" class="ltx_Math" alttext="2.069" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">2.069</mn><annotation encoding="application/x-tex">2.069</annotation></semantics></math></td>
<td id="A2.T4.5.1.6.7" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m54" class="ltx_Math" alttext="230" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">230</mn><annotation encoding="application/x-tex">230</annotation></semantics></math><span id="A2.T4.5.1.6.7.1" class="ltx_text" style="font-size:298%;">s</span></td>
<td id="A2.T4.5.1.6.8" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m55" class="ltx_Math" alttext="0.815" display="inline" intent=":literal"><semantics><mn mathsize="2.980em">0.815</mn><annotation encoding="application/x-tex">0.815</annotation></semantics></math></td>
