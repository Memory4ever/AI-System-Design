{"data":[{"id":"10.48550/arxiv.2509.07764","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.07764","identifiers":[{"identifier":"2509.07764","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haitao","familyName":"Hu","name":"Hu, Haitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Chen","name":"Chen, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanpeng","familyName":"Zhao","name":"Zhao, Yanpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Chen","name":"Chen, Yuqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgentSentinel: An End-to-End and Real-Time Security Defense Framework for Computer-Use Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T13:59:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-10T00:46:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have been increasingly integrated into computer-use agents, which can autonomously operate tools on a user's computer to accomplish complex tasks. However, due to the inherently unstable and unpredictable nature of LLM outputs, they may issue unintended tool commands or incorrect inputs, leading to potentially harmful operations. Unlike traditional security risks stemming from insecure user prompts, tool execution results from LLM-driven decisions introduce new and unique security challenges. These vulnerabilities span across all components of a computer-use agent. To mitigate these risks, we propose AgentSentinel, an end-to-end, real-time defense framework designed to mitigate potential security threats on a user's computer. AgentSentinel intercepts all sensitive operations within agent-related services and halts execution until a comprehensive security audit is completed. Our security auditing mechanism introduces a novel inspection process that correlates the current task context with system traces generated during task execution. To thoroughly evaluate AgentSentinel, we present BadComputerUse, a benchmark consisting of 60 diverse attack scenarios across six attack categories. The benchmark demonstrates a 87% average attack success rate on four state-of-the-art LLMs. Our evaluation shows that AgentSentinel achieves an average defense success rate of 79.6%, significantly outperforming all baseline defenses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.07764","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-10T01:49:06Z","registered":"2025-09-10T01:49:07Z","published":null,"updated":"2025-09-10T01:49:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bsize%5D=100\u0026page%5Bnumber%5D=1\u0026query=registered%3A%5B2025-09-09T16%3A00%3A00Z+TO+2025-09-10T15%3A59%3A59Z%5D+AND+doi%3A10.48550%2Farxiv.2509.07764+AND+%28titles.title%3A%28LLMs+AND+agents%29+OR+descriptions.description%3A%28LLMs+AND+agents%29%29"}}