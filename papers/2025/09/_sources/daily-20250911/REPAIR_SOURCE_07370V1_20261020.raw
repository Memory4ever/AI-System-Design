<span id="A2.T9.2.1.1.1" class="ltx_inline-block ltx_align_top" style="width:375.6pt;">
<span id="A2.T9.2.1.1.1.1" class="ltx_p"><span id="A2.T9.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Persona-CoT Prompt Template</span></span>
</span></th></tr>
</thead>
