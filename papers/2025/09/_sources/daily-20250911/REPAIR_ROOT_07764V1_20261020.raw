<tr id="S5.T3.2.1.6" class="ltx_tr">
<td id="S5.T3.2.1.6.1" class="ltx_td ltx_align_center"><span id="S5.T3.2.1.6.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Backdoor Attack</span></td>
<td id="S5.T3.2.1.6.2" class="ltx_td ltx_align_center">100</td>
<td id="S5.T3.2.1.6.3" class="ltx_td ltx_align_center">100</td>
<td id="S5.T3.2.1.6.4" class="ltx_td ltx_align_center">100</td></tr>
<tr id="S5.T3.2.1.7" class="ltx_tr">
<td id="S5.T3.2.1.7.1" class="ltx_td ltx_align_center"><span id="S5.T3.2.1.7.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Bad Tool Result Attack</span></td>
<td id="S5.T3.2.1.7.2" class="ltx_td ltx_align_center">100</td>
<td id="S5.T3.2.1.7.3" class="ltx_td ltx_align_center">90</td>
<td id="S5.T3.2.1.7.4" class="ltx_td ltx_align_center">90</td></tr>
<tr id="S5.T3.2.1.8" class="ltx_tr">
