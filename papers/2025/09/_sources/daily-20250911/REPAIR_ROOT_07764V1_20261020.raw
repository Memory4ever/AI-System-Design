<tr id="S5.T3.2.1.4" class="ltx_tr">
<td id="S5.T3.2.1.4.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.2.1.4.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Direct Task Injection</span></td>
<td id="S5.T3.2.1.4.2" class="ltx_td ltx_align_center ltx_border_t">100</td>
<td id="S5.T3.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t">100</td>
<td id="S5.T3.2.1.4.4" class="ltx_td ltx_align_center ltx_border_t">100</td></tr>
<tr id="S5.T3.2.1.5" class="ltx_tr">
<td id="S5.T3.2.1.5.1" class="ltx_td ltx_align_center"><span id="S5.T3.2.1.5.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Agent Infrastructure Attack</span></td>
<td id="S5.T3.2.1.5.2" class="ltx_td ltx_align_center">100</td>
<td id="S5.T3.2.1.5.3" class="ltx_td ltx_align_center">100</td>
