              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.15.1" class="ltx_text ltx_font_bold">14</span></span>
            <math id="algorithm3.m17" class="ltx_Math" alttext="\mathrm{SetLastEnforcementInformation}(\mathit{res})" display="inline" intent=":literal"><semantics><mrow><mi>SetLastEnforcementInformation</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑟𝑒𝑠</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SetLastEnforcementInformation}(\mathit{res})</annotation></semantics></math>;
