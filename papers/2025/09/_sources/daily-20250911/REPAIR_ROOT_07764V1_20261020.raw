            <math id="algorithm3.m19" class="ltx_Math" alttext="\mathrm{accumulateAuditTime}(e,\mathit{endTime}-\mathit{startTime})" display="inline" intent=":literal"><semantics><mrow><mi>accumulateAuditTime</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mrow><mi>𝑒𝑛𝑑𝑇𝑖𝑚𝑒</mi><mo>−</mo><mi>𝑠𝑡𝑎𝑟𝑡𝑇𝑖𝑚𝑒</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{accumulateAuditTime}(e,\mathit{endTime}-\mathit{startTime})</annotation></semantics></math>;
