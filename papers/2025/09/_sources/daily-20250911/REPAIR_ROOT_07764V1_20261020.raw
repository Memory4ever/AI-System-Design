          <math id="algorithm1.m5" class="ltx_Math" alttext="T\leftarrow\mathrm{GetAvailableTools}()" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo stretchy="false">←</mo><mrow><mi>GetAvailableTools</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T\leftarrow\mathrm{GetAvailableTools}()</annotation></semantics></math>;
</div>
<div id="algorithm1.4.6" class="ltx_listingline">
