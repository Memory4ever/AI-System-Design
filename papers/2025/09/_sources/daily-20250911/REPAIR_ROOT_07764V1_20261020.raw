</div>
<div id="algorithm1.4.11" class="ltx_listingline"><span id="algorithm1.4.11.1" class="ltx_text" style="--ltx-fg-color:#FF0000;"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.11.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">10</span></span>
          <math id="algorithm1.m10" class="ltx_Math" alttext="C.\mathrm{NotifyNewToolUse}(a)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">C</mi><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0.167em">.</mo><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">NotifyNewToolUse</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">a</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C.\mathrm{NotifyNewToolUse}(a)</annotation></semantics></math><span id="algorithm1.4.11.3" class="ltx_text" style="--ltx-fg-color:#FF0000;">;</span>
</div>
<div id="algorithm1.4.12" class="ltx_listingline"><span id="algorithm1.4.12.1" class="ltx_text"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> </span>
