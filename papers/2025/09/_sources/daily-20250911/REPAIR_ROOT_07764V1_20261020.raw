          <math id="algorithm1.m3" class="ltx_Math" alttext="C.\mathrm{AddUserMessage}(I)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">C</mi><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0.167em">.</mo><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">AddUserMessage</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">I</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C.\mathrm{AddUserMessage}(I)</annotation></semantics></math><span id="algorithm1.4.3.2" class="ltx_text" style="--ltx-fg-color:#FF0000;">;</span>
</div>
<div id="algorithm1.4.4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.4.1" class="ltx_text ltx_font_bold">3</span></span>
