              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.18.1" class="ltx_text ltx_font_bold">17</span></span>
            <span id="algorithm3.4.18.2" class="ltx_text ltx_font_bold">return</span> ans

