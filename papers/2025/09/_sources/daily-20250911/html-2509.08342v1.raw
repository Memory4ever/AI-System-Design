              <span id="alg1.4.26.2" class="ltx_text ltx_font_bold">for</span> each layer <math id="alg1.m45" class="ltx_Math" alttext="i\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[L]</annotation></semantics></math> <span id="alg1.4.26.3" class="ltx_text ltx_font_bold">do</span>
