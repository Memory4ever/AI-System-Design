</span></td>
<td id="S3.T6.5.1.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S3.T6.5.1.2.3.1" class="ltx_text" style="font-size:50%;">16 (8%)</span></td></tr>
<tr id="S3.T6.5.1.3" class="ltx_tr">
<td id="S3.T6.5.1.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;"></td>
