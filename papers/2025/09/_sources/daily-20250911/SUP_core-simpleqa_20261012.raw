<td id="S3.T5.5.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S3.T5.5.1.1.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">New AR Grade</span></td></tr>
<tr id="S3.T5.5.1.2" class="ltx_tr">
<td id="S3.T5.5.1.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;">
