<span id="S3.T4.6.1.1.1.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="S3.T4.6.1.1.1.1.1" class="ltx_p"><span id="S3.T4.6.1.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:50%;">Pattern</span></span>
</span></td>
<td id="S3.T4.6.1.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S3.T4.6.1.1.2.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S3.T4.6.1.1.2.1.1" class="ltx_p"><span id="S3.T4.6.1.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:50%;">Question</span></span>
</span></td>
