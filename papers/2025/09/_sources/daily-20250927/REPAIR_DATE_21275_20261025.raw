{"data":{"id":"10.48550/arxiv.2509.21275","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.21275","prefix":"10.48550","suffix":"arxiv.2509.21275","identifiers":[{"identifier":"2509.21275","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.21275"}],"creators":[{"name":"Wang, Shiju","nameType":"Personal","givenName":"Shiju","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yujie","nameType":"Personal","givenName":"Yujie","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Fu, Fangcheng","nameType":"Personal","givenName":"Fangcheng","familyName":"Fu","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Ao","nameType":"Personal","givenName":"Ao","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Feng, Yinxiao","nameType":"Personal","givenName":"Yinxiao","familyName":"Feng","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Zijian","nameType":"Personal","givenName":"Zijian","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Cui, Bin","nameType":"Personal","givenName":"Bin","familyName":"Cui","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Xu","nameType":"Personal","givenName":"Xu","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Kaisheng","nameType":"Personal","givenName":"Kaisheng","familyName":"Ma","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Concertina: Data-Centric Adaptive Pipeline Parallelism for Efficient Heterogeneous Long-Context LLM Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-25T15:01:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-26T00:56:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-10T02:27:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-11T02:10:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-23T12:04:48Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-24T00:44:25Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-25T07:48:56Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-28T00:24:13Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-09-14T08:07:45Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-09-15T01:43:15Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Long context training is crucial for extending LLM context windows. Existing schemes, such as sequence parallelism, incur substantial communication overhead. Pipeline parallelism (PP) reduces this cost, but its effectiveness hinges on partitioning granularity. Batch-level PP employing sequence packing exhibits high memory consumption in long-context scenarios, whereas token-level PP splitting sequences into slices alleviates memory overhead but may introduce performance degradation. Moreover, the skewed sequence-length distribution in real-world datasets defeats any monolithic, static choice of PP granularity. In this paper, we propose \\textit{Dynamic Pipeline Parallelism} (DPP), which transforms PP granularity from a static design choice into a workload-adaptive optimization space over packed, split, and hybrid chunks. DPP further introduces a new coupling between heterogeneous pipeline scheduling and gradient checkpointing. To solve this coupling, \\name co-optimizes dynamic chunk scheduling with \\textit{Stage-Aware Chunk-Level Adaptive Checkpointing}. Comprehensive experiments demonstrate that \\name achieves up to 1.69\\texttimes\\ speedup over FlexSP and up to 1.40\\texttimes\\ over MEPipe. The source code is available at https://github.com/wsjdsg/InfiniPipe-code.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.21275","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-26T01:56:41.000Z","registered":"2025-09-26T01:56:42.000Z","published":"2025","updated":"2026-09-15T04:41:32.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.21275","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}