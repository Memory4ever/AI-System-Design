<td id="A8.T8.2.5.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><math id="A8.T8.m10" class="ltx_Math" alttext="\geq 8" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">\geq 8</annotation></semantics></math>, typically <math id="A8.T8.m11" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>–<math id="A8.T8.m12" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math></td>
<td id="A8.T8.2.5.5" class="ltx_td ltx_align_center ltx_border_b">This work (two-stage scheme)</td></tr>
