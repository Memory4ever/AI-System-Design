<th id="A5.T7.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A5.T7.m10" class="ltx_Math" alttext="K_{\mathrm{nominal}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>nominal</mi></msub><annotation encoding="application/x-tex">K_{\mathrm{nominal}}</annotation></semantics></math></th>
