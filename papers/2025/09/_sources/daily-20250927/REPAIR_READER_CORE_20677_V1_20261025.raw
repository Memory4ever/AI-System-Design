<td id="A8.T8.2.3.1" class="ltx_td ltx_align_center ltx_border_r"><math id="A8.T8.m2" class="ltx_Math" alttext="c_{1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>1</mn></msub><annotation encoding="application/x-tex">c_{1}</annotation></semantics></math></td>
<td id="A8.T8.2.3.2" class="ltx_td ltx_align_center ltx_border_r">Absolute</td>
<td id="A8.T8.2.3.3" class="ltx_td ltx_align_center ltx_border_r">Fourth-moment bound</td>
<td id="A8.T8.2.3.4" class="ltx_td ltx_align_center ltx_border_r"><math id="A8.T8.m3" class="ltx_Math" alttext="[1.5,6]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1.5</mn><mo>,</mo><mn>6</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1.5,6]</annotation></semantics></math>, recommend <math id="A8.T8.m4" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>–<math id="A8.T8.m5" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></td>
