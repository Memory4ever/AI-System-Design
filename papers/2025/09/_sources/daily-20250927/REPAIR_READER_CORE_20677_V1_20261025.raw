<td id="A8.T8.2.4.5" class="ltx_td ltx_align_center">Koltchinskii–Lounici (2017, Thm. 3.1)</td></tr>
<tr id="A8.T8.2.5" class="ltx_tr">
<td id="A8.T8.2.5.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><math id="A8.T8.m9" class="ltx_Math" alttext="c^{\prime},\,c_{3}" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>′</mo></msup><mo rspace="0.337em">,</mo><msub><mi>c</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">c^{\prime},\,c_{3}</annotation></semantics></math></td>
<td id="A8.T8.2.5.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">Engineering</td>
