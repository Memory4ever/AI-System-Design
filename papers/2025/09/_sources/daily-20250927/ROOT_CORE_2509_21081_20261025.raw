<tbody class="ltx_tbody">
<tr id="S3.T1.6.3" class="ltx_tr">
<th id="S3.T1.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">MACs</th>
<td id="S3.T1.6.3.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="S3.T1.m19" class="ltx_Math" alttext="BS_{q}(L_{s}+L_{n})H(D_{qk}+D_{v})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>s</mi></msub><mo>+</mo><msub><mi>L</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>+</mo><msub><mi>D</mi><mi>v</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">BS_{q}(L_{s}+L_{n})H(D_{qk}+D_{v})</annotation></semantics></math></td>
<td id="S3.T1.6.3.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="S3.T1.m20" class="ltx_Math" alttext="BL_{s}40\text{k}+BL_{n}40\text{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mn>40</mn><mo lspace="0em" rspace="0em">​</mo><mtext>k</mtext></mrow><mo>+</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mn>40</mn><mo lspace="0em" rspace="0em">​</mo><mtext>k</mtext></mrow></mrow><annotation encoding="application/x-tex">BL_{s}40\text{k}+BL_{n}40\text{k}</annotation></semantics></math></td></tr>
