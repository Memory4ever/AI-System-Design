<th id="S3.T1.6.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">MACs</th>
<td id="S3.T1.6.7.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="S3.T1.m25" class="ltx_Math" alttext="BS_{q}(L_{s}+L_{n})H(2D_{l}+D_{r})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>s</mi></msub><mo>+</mo><msub><mi>L</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mi>l</mi></msub></mrow><mo>+</mo><msub><mi>D</mi><mi>r</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">BS_{q}(L_{s}+L_{n})H(2D_{l}+D_{r})</annotation></semantics></math></td>
