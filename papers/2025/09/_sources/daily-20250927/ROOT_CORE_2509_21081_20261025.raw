<td id="S3.T1.6.4.3" class="ltx_td ltx_align_left ltx_border_r"><math id="S3.T1.m22" class="ltx_Math" alttext="L_{s}40\text{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mn>40</mn><mo lspace="0em" rspace="0em">​</mo><mtext>k</mtext></mrow><annotation encoding="application/x-tex">L_{s}40\text{k}</annotation></semantics></math> <math id="S3.T1.m23" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> <math id="S3.T1.m24" class="ltx_Math" alttext="BL_{n}40\text{k}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑩</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝑳</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝒏</mi></msub><mo lspace="0em" rspace="0em">​</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝟒𝟎</mn><mo lspace="0em" rspace="0em">​</mo><mtext style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">k</mtext></mrow><annotation encoding="application/x-tex">BL_{n}40\text{k}</annotation></semantics></math></td></tr>
