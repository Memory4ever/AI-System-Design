<td id="S5.T4.2.1.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2pt;padding-bottom:2pt;"><span id="S5.T4.2.1.6.1" class="ltx_text ltx_font_bold">Memory (GB)</span> <math id="S5.T4.m11" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
