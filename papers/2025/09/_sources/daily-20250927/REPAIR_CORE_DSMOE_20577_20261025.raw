</div>
<div id="alg1.l5b" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5b.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
             Top-<math id="alg1.l5b.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> selection parameter <math id="alg1.l5b.m2" class="ltx_Math" alttext="k\ll d" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≪</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">k\ll d</annotation></semantics></math>

