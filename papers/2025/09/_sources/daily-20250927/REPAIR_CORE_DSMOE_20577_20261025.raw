<div id="alg1.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
               <math id="alg1.l22.m1" class="ltx_Math" alttext="h_{t}\leftarrow h_{t}+h_{t-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>h</mi><mi>t</mi></msub><mo>+</mo><msub><mi>h</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">h_{t}\leftarrow h_{t}+h_{t-1}</annotation></semantics></math>

