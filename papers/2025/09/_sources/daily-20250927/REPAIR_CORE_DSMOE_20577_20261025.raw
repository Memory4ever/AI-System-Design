</div>
<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
              Add residual connection

</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
              <span id="alg1.l21.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l21.m1" class="ltx_Math" alttext="t&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t&gt;1</annotation></semantics></math> <span id="alg1.l21.4" class="ltx_text ltx_font_bold">then</span>



