<tr id="S3.T1.2.14" class="ltx_tr">
<td id="S3.T1.2.14.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_l ltx_border_r ltx_border_t" style="padding-top:2pt;padding-bottom:2pt;">
<span id="S3.T1.2.14.1.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
