<th id="S2.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_ttt" colspan="2"><span id="S2.T1.2.1.2.1" class="ltx_text ltx_font_bold">Visual Dependency</span></th>
