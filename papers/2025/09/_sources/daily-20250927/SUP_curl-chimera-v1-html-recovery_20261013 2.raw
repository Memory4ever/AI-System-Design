</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 13.78)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:60.63em;--ltx-fo-depth:0em;font-size:10pt;" height="838.92" overflow="visible" transform="matrix(1 0 0 -1 0 838.92)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F11.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:36.62em;">
