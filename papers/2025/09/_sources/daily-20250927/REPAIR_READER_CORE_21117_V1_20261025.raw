</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S4.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.21117v1/NTR.svg" id="S4.F2.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/272;" width="548" height="272"></object>
