<span id="S4.T4.2.1.1.1.4.1" class="ltx_td ltx_align_left">Llama-3.1-8B-SFT-100-Scale-Softmax</span>
<span id="S4.T4.2.1.1.1.4.2" class="ltx_td ltx_align_center"><span id="S4.T4.2.1.1.1.4.2.1" class="ltx_text ltx_font_bold">20.52</span></span>
<span id="S4.T4.2.1.1.1.4.3" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T4.2.1.1.1.4.3.1" class="ltx_text ltx_font_bold">24.16</span></span></span>
<span id="S4.T4.2.1.1.1.5" class="ltx_tr">
<span id="S4.T4.2.1.1.1.5.1" class="ltx_td ltx_align_left">Qwen2.5-7B-SFT</span>
<span id="S4.T4.2.1.1.1.5.2" class="ltx_td ltx_align_center">11.92</span>
<span id="S4.T4.2.1.1.1.5.3" class="ltx_td ltx_nopad_r ltx_align_center">8.07</span></span>
<span id="S4.T4.2.1.1.1.6" class="ltx_tr">
<span id="S4.T4.2.1.1.1.6.1" class="ltx_td ltx_align_left">Qwen2.5-7B-SFT-5-Scale-Baseline</span>
