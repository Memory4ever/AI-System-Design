<span id="S4.T4.2.1.1.1.2" class="ltx_tr">
<span id="S4.T4.2.1.1.1.2.1" class="ltx_td ltx_align_left ltx_border_t">Llama-3.1-8B-SFT</span>
<span id="S4.T4.2.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">11.17</span>
<span id="S4.T4.2.1.1.1.2.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">7.95</span></span>
<span id="S4.T4.2.1.1.1.3" class="ltx_tr">
<span id="S4.T4.2.1.1.1.3.1" class="ltx_td ltx_align_left">Llama-3.1-8B-SFT-5-Scale-Baseline</span>
<span id="S4.T4.2.1.1.1.3.2" class="ltx_td ltx_align_center">19.13</span>
