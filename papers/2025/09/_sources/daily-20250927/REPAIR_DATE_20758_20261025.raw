{"data":{"id":"10.48550/arxiv.2509.20758","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.20758","prefix":"10.48550","suffix":"arxiv.2509.20758","identifiers":[{"identifier":"2509.20758","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.20758"}],"creators":[{"name":"Lin, Jiacheng","nameType":"Personal","givenName":"Jiacheng","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zhongruo","nameType":"Personal","givenName":"Zhongruo","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Qian, Kun","nameType":"Personal","givenName":"Kun","familyName":"Qian","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Tian","nameType":"Personal","givenName":"Tian","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Srinivasan, Arvind","nameType":"Personal","givenName":"Arvind","familyName":"Srinivasan","affiliation":[],"nameIdentifiers":[]},{"name":"Zeng, Hansi","nameType":"Personal","givenName":"Hansi","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Jiao, Ruochen","nameType":"Personal","givenName":"Ruochen","familyName":"Jiao","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Xie","nameType":"Personal","givenName":"Xie","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Gesi, Jiri","nameType":"Personal","givenName":"Jiri","familyName":"Gesi","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Dakuo","nameType":"Personal","givenName":"Dakuo","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Yufan","nameType":"Personal","givenName":"Yufan","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Zhong, Kai","nameType":"Personal","givenName":"Kai","familyName":"Zhong","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Weiqi","nameType":"Personal","givenName":"Weiqi","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Sanghavi, Sujay","nameType":"Personal","givenName":"Sujay","familyName":"Sanghavi","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Changyou","nameType":"Personal","givenName":"Changyou","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Yun, Hyokun","nameType":"Personal","givenName":"Hyokun","familyName":"Yun","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Lihong","nameType":"Personal","givenName":"Lihong","familyName":"Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SFT Doesn't Always Hurt General Capabilities: Revisiting Domain-Specific Fine-Tuning in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-25T05:28:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-26T00:24:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-07T17:54:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-09T01:58:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-28T20:08:44Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-30T01:05:51Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Supervised Fine-Tuning (SFT) on domain-specific datasets is a common approach to adapt Large Language Models (LLMs) to specialized tasks but is often believed to degrade their general capabilities. In this work, we revisit this trade-off and present both empirical and theoretical insights. First, we show that SFT does not always hurt: using a smaller learning rate can substantially mitigate general performance degradation while preserving comparable target-domain performance. We then provide a theoretical analysis that explains these phenomena and further motivates a new method, Token-Adaptive Loss Reweighting (TALR). Building on this, and recognizing that smaller learning rates alone do not fully eliminate general-performance degradation in all cases, we evaluate a range of strategies for reducing general capability loss, including L2 regularization, LoRA, model averaging, FLOW, and our proposed TALR. Experimental results demonstrate that while no method completely eliminates the trade-off, TALR consistently outperforms these baselines in balancing domain-specific gains and general capabilities. Finally, we distill our findings into practical guidelines for adapting LLMs to new domains: (i) using a small learning rate to achieve a favorable trade-off, and (ii) when a stronger balance is further desired, adopt TALR as an effective strategy.","descriptionType":"Abstract"},{"description":"Accepted by ICLR 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.20758","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-26T01:44:18.000Z","registered":"2025-09-26T01:44:19.000Z","published":"2025","updated":"2026-01-30T03:41:27.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.20758","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}