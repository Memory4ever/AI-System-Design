<td id="A2.T6.2.13.2" class="ltx_td ltx_align_left">
<span id="A2.T6.2.13.2.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T6.2.13.2.1.1" class="ltx_p">gradient_accumulation_steps<math id="A2.T6.m20" class="ltx_Math" alttext="\ =4" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.778em">=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">\ =4</annotation></semantics></math>; precision = bf16;</span>
</span></td></tr>
<tr id="A2.T6.2.14" class="ltx_tr">
<th id="A2.T6.2.14.1" class="ltx_td ltx_th ltx_th_row ltx_border_bb"></th>
<td id="A2.T6.2.14.2" class="ltx_td ltx_align_left ltx_border_bb">
<span id="A2.T6.2.14.2.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T6.2.14.2.1.1" class="ltx_p">max_sequence_length = 4096; seed <math id="A2.T6.m21" class="ltx_Math" alttext="\ =42" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.778em">=</mo><mn>42</mn></mrow><annotation encoding="application/x-tex">\ =42</annotation></semantics></math></span>
</span></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 6: </span>Hyperparameters used in training.</figcaption>
</figure>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Evaluation Hyperparameters</h3>

<div id="A2.SS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.p1.1" class="ltx_p">In the evaluation, we set the block length to 32. For the two smaller datasets, Sudoku and Countdown, the generation length is set to 512; for the two larger datasets, MATH500 and GSM8K, the generation length is set to 256. The number of diffusion steps is always set to half of the generation length, and we use the low-confidence remasking method.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Algorithm Pipeline</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">In Algorithm <a href="#algorithm1" title="In Appendix C Algorithm Pipeline ‣ WeFT: Weighted Entropy-driven Fine-Tuning for dLLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we provide a detailed description of the implementation of WeFT.</p>
</div>
<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>WeFT: Weighted Entropy-driven Fine-Tuning</figcaption>
<div id="algorithm1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.4.1" class="ltx_listingline"><span id="algorithm1.4.1.1" class="ltx_text"><span id="algorithm1.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>model <math id="algorithm1.m1" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math>, input_ids <math id="algorithm1.m2" class="ltx_Math" alttext="\mathcal{I}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℐ</mi><annotation encoding="application/x-tex">\mathcal{I}</annotation></semantics></math>, labels <math id="algorithm1.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>, mask_token_id <math id="algorithm1.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, prompt lengths <math id="algorithm1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>
</div>
<div id="algorithm1.4.2" class="ltx_listingline"><span id="algorithm1.4.2.1" class="ltx_text"><span id="algorithm1.4.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>Loss <math id="algorithm1.m6" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>
</div>
<div id="algorithm1.4.3" class="ltx_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold">Function</span> <span id="algorithm1.4.3.2" class="ltx_text ltx_font_typewriter">EstimateRate(<em id="algorithm1.4.3.2.1" class="ltx_emph ltx_font_serif ltx_font_italic"><math id="algorithm1.m7" class="ltx_Math" alttext="\mathcal{M},\mathcal{I},l,M,m" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>,</mo><mi>l</mi><mo>,</mo><mi>M</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">\mathcal{M},\mathcal{I},l,M,m</annotation></semantics></math></em>)</span>: 
</div>
<div id="algorithm1.4.4" class="ltx_listingline"><span id="algorithm1.4.4.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.4.2" class="ltx_text ltx_font_typewriter">mask out the answer </span>
</div>
<div id="algorithm1.4.5" class="ltx_listingline"><span id="algorithm1.4.5.1" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.5.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m8" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.5.2.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m9" class="ltx_Math" alttext="|\mathcal{I}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{I}|</annotation></semantics></math></em> <span id="algorithm1.4.5.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m10" class="ltx_Math" alttext="\mathcal{I^{\prime}}^{i}\leftarrow(1-M^{i})\cdot\mathcal{I}^{i}+M^{i}\cdot m" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow></mrow><mo>′</mo><mrow></mrow><mi>i</mi></mmultiscripts><mo stretchy="false">←</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>M</mi><mi>i</mi></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>i</mi></msup></mrow><mo>+</mo><mrow><msup><mi>M</mi><mi>i</mi></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>m</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I^{\prime}}^{i}\leftarrow(1-M^{i})\cdot\mathcal{I}^{i}+M^{i}\cdot m</annotation></semantics></math>;
</div>
<div id="algorithm1.4.7" class="ltx_listingline"><math id="algorithm1.m11" class="ltx_Math" alttext="z\leftarrow\mathcal{M}(\mathcal{I^{\prime}}).\text{logits}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>z</mi><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mtext>logits</mtext></mrow><annotation encoding="application/x-tex">z\leftarrow\mathcal{M}(\mathcal{I^{\prime}}).\text{logits}</annotation></semantics></math>;
</div>
<div id="algorithm1.4.8" class="ltx_listingline"><span id="algorithm1.4.8.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.8.2" class="ltx_text ltx_font_typewriter">calculate entropy </span>
</div>
<div id="algorithm1.4.9" class="ltx_listingline"><span id="algorithm1.4.9.1" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.9.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m12" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.9.2.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m13" class="ltx_Math" alttext="|\mathcal{I}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{I}|</annotation></semantics></math></em> <span id="algorithm1.4.9.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m14" class="ltx_math_unparsed" alttext="H_{i}\leftarrow-\sum_{j}\text{softmax}(z_{ij})\cdot\text{log\_softmax}(z_{ij})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>i</mi></msub><mo rspace="0em" stretchy="false">←</mo><mo lspace="0em" rspace="0.055em">−</mo><msub><mo>∑</mo><mi>j</mi></msub><mtext>softmax</mtext><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mtext>log_softmax</mtext><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{i}\leftarrow-\sum_{j}\text{softmax}(z_{ij})\cdot\text{log\_softmax}(z_{ij})</annotation></semantics></math>;
</div>
<div id="algorithm1.4.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m15" class="ltx_Math" alttext="\beta_{i}\leftarrow(1-M^{i})\sqrt{H_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>M</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>H</mi><mi>i</mi></msub></msqrt></mrow></mrow><annotation encoding="application/x-tex">\beta_{i}\leftarrow(1-M^{i})\sqrt{H_{i}}</annotation></semantics></math>;
</div>
<div id="algorithm1.4.12" class="ltx_listingline"><span id="algorithm1.4.12.1" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m16" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>;
</div>
<div id="algorithm1.4.13" class="ltx_listingline"><span id="algorithm1.4.13.1" class="ltx_text ltx_font_bold">Function</span> <span id="algorithm1.4.13.2" class="ltx_text ltx_font_typewriter">ComputeLoss(<em id="algorithm1.4.13.2.1" class="ltx_emph ltx_font_serif ltx_font_italic"><math id="algorithm1.m17" class="ltx_Math" alttext="\mathcal{M},\mathcal{I},m,L" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\mathcal{M},\mathcal{I},m,L</annotation></semantics></math></em>)</span>: 
</div>
<div id="algorithm1.4.14" class="ltx_listingline"><math id="algorithm1.m18" class="ltx_Math" alttext="t\sim\mathcal{U}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\sim\mathcal{U}(0,1)</annotation></semantics></math>;
</div>
<div id="algorithm1.4.15" class="ltx_listingline"><span id="algorithm1.4.15.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.15.2" class="ltx_text ltx_font_typewriter">mask the model’s answer </span>
</div>
<div id="algorithm1.4.16" class="ltx_listingline"><span id="algorithm1.4.16.1" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.16.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m19" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.16.2.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m20" class="ltx_Math" alttext="|\mathcal{I}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{I}|</annotation></semantics></math></em> <span id="algorithm1.4.16.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.17" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m21" class="ltx_math_unparsed" alttext="M^{i}=\mathbf{1}_{\{\,i&gt;L\,\}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msup><mrow></mrow><mi>i</mi></msup><mo>=</mo><mn>𝟏</mn><msub><mrow></mrow><mrow><mo rspace="0.170em" stretchy="false">{</mo><mi>i</mi><mo>&gt;</mo><mi>L</mi><mo lspace="0.170em" stretchy="false">}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">M^{i}=\mathbf{1}_{\{\,i&gt;L\,\}}</annotation></semantics></math>

</div>
<div id="algorithm1.4.18" class="ltx_listingline"><math id="algorithm1.m22" class="ltx_Math" alttext="\beta\leftarrow\textnormal{{EstimateRate}}(\mathcal{M},\mathcal{I},M,m)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">EstimateRate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>,</mo><mi>M</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta\leftarrow\textnormal{{EstimateRate}}(\mathcal{M},\mathcal{I},M,m)</annotation></semantics></math>;
</div>
<div id="algorithm1.4.19" class="ltx_listingline"><math id="algorithm1.m23" class="ltx_Math" alttext="\beta_{ref}\leftarrow\frac{\sum_{i}\beta_{i}\cdot M_{i}}{\sum_{i}M_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo stretchy="false">←</mo><mfrac><mrow><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mi>i</mi></msub></mstyle><msub><mi>β</mi><mi>i</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>M</mi><mi>i</mi></msub></mrow><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mi>i</mi></msub></mstyle><msub><mi>M</mi><mi>i</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\beta_{ref}\leftarrow\frac{\sum_{i}\beta_{i}\cdot M_{i}}{\sum_{i}M_{i}}</annotation></semantics></math> ;
</div>
<div id="algorithm1.4.20" class="ltx_listingline"><span id="algorithm1.4.20.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.20.2" class="ltx_text ltx_font_typewriter">Compute the masking probability for each token </span>
</div>
<div id="algorithm1.4.21" class="ltx_listingline"><span id="algorithm1.4.21.1" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.21.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m24" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.21.2.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m25" class="ltx_Math" alttext="|\mathcal{I}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{I}|</annotation></semantics></math></em> <span id="algorithm1.4.21.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.22" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m26" class="ltx_Math" alttext="t_{i}\leftarrow 1-(1-t)^{\frac{\beta_{i}}{\beta_{ref}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><msub><mi>β</mi><mi>i</mi></msub><msub><mi>β</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">t_{i}\leftarrow 1-(1-t)^{\frac{\beta_{i}}{\beta_{ref}}}</annotation></semantics></math>;
</div>
<div id="algorithm1.4.23" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m27" class="ltx_Math" alttext="M^{\prime i}\sim\text{Bernoulli}(t_{i})" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi>i</mi></mrow></msup><mo>∼</mo><mrow><mtext>Bernoulli</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M^{\prime i}\sim\text{Bernoulli}(t_{i})</annotation></semantics></math> ;
</div>
<div id="algorithm1.4.24" class="ltx_listingline"><math id="algorithm1.m28" class="ltx_Math" alttext="\mathcal{L}\leftarrow\frac{\sum_{i}\mathbf{1}_{\{M^{\prime i}=0\}}\frac{1}{t_{i}}\text{CrossEntropy}(z_{i},l_{i})}{\sum_{i}\mathbf{1}_{\{M^{\prime i}=0\}}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">←</mo><mfrac><mrow><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mi>i</mi></msub><mn>𝟏</mn><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>M</mi><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi>i</mi></mrow></msup><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mfrac><mn>1</mn><msub><mi>t</mi><mi>i</mi></msub></mfrac><mtext>CrossEntropy</mtext><mo stretchy="false">(</mo><mi>z</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>l</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mi>i</mi></msub><mn>𝟏</mn><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>M</mi><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi>i</mi></mrow></msup><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mathcal{L}\leftarrow\frac{\sum_{i}\mathbf{1}_{\{M^{\prime i}=0\}}\frac{1}{t_{i}}\text{CrossEntropy}(z_{i},l_{i})}{\sum_{i}\mathbf{1}_{\{M^{\prime i}=0\}}}</annotation></semantics></math>;
</div>
<div id="algorithm1.4.25" class="ltx_listingline"><span id="algorithm1.4.25.1" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m29" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>;
</div>
<div id="algorithm1.4.26" class="ltx_listingline">
</div>
