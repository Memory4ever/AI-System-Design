<th id="S4.T4.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T4.2.5.1.1" class="ltx_text ltx_font_bold">s1K Dataset</span></th>
<td id="S4.T4.2.5.2" class="ltx_td ltx_border_t"></td>
<td id="S4.T4.2.5.3" class="ltx_td ltx_border_t"></td>
