<td id="S4.T4.2.6.3" class="ltx_td ltx_align_center ltx_border_t">23.8 (+7.8)</td>
<td id="S4.T4.2.6.4" class="ltx_td ltx_align_center ltx_border_t">78.8 (+2.1)</td>
<td id="S4.T4.2.6.5" class="ltx_td ltx_align_center ltx_border_t">32.6 (+0.2)</td>
<td id="S4.T4.2.6.6" class="ltx_td ltx_align_center ltx_border_t">34.9 (+2.3)</td></tr>
<tr id="S4.T4.2.7" class="ltx_tr">
