<td id="S4.T4.2.5.6" class="ltx_td ltx_border_t"></td></tr>
<tr id="S4.T4.2.6" class="ltx_tr">
<th id="S4.T4.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">+ SFT</th>
