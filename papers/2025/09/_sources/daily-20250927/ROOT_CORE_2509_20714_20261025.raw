<td id="S5.T2.4.3.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m7" class="ltx_Math" alttext="\max{\text{Acc}_{i,\mathcal{L}_{j}}}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><msub><mtext>Acc</mtext><mrow><mi>i</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>j</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\max{\text{Acc}_{i,\mathcal{L}_{j}}}</annotation></semantics></math><sup id="S5.T2.4.3.4.1" class="ltx_sup">3</sup></td></tr>
<tr id="S5.T2.4.4" class="ltx_tr">
