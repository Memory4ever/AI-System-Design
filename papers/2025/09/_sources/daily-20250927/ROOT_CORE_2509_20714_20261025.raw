<span id="S5.T2.4.5.1.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T2.4.5.1.1.1" class="ltx_p">ImageNet</span>
</span></th>
<td id="S5.T2.4.5.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T2.m11" class="ltx_Math" alttext="100.00\pm 0.00" display="inline" intent=":literal"><semantics><mrow><mn>100.00</mn><mo>±</mo><mn>0.00</mn></mrow><annotation encoding="application/x-tex">100.00\pm 0.00</annotation></semantics></math></td>
