<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S4.SS3" title="In IV Privacy Defenses with Digital Signature ‣ Cryptographic Backdoor for Neural Networks: Boon and Bane" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">IV-C</span> </span><span class="ltx_text ltx_font_italic">Tracking Unauthorized IP Sharing</span></span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S5" title="In Cryptographic Backdoor for Neural Networks: Boon and Bane" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">V </span><span class="ltx_text ltx_font_smallcaps">Experimental Studies</span></span></a>
<ol class="ltx_toclist ltx_toclist_section">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S5.SS1" title="In V Experimental Studies ‣ Cryptographic Backdoor for Neural Networks: Boon and Bane" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-A</span> </span><span class="ltx_text ltx_font_italic">Backdoor Attack</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S5.SS2" title="In V Experimental Studies ‣ Cryptographic Backdoor for Neural Networks: Boon and Bane" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-B</span> </span><span class="ltx_text ltx_font_italic">Privacy Defenses</span></span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S6" title="In Cryptographic Backdoor for Neural Networks: Boon and Bane" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VI </span><span class="ltx_text ltx_font_smallcaps">Conclusion</span></span></a></li>
