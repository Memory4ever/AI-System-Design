<span id="S5.T2.4.4.1.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T2.4.4.1.1.1" class="ltx_p">CIFAR-10</span>
</span></th>
<td id="S5.T2.4.4.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m8" class="ltx_Math" alttext="100.00\pm 0.00" display="inline" intent=":literal"><semantics><mrow><mn>100.00</mn><mo>±</mo><mn>0.00</mn></mrow><annotation encoding="application/x-tex">100.00\pm 0.00</annotation></semantics></math></td>
<td id="S5.T2.4.4.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m9" class="ltx_Math" alttext="10.04\pm 0.06" display="inline" intent=":literal"><semantics><mrow><mn>10.04</mn><mo>±</mo><mn>0.06</mn></mrow><annotation encoding="application/x-tex">10.04\pm 0.06</annotation></semantics></math></td>
