{"data":{"id":"10.48550/arxiv.2509.21117","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.21117","prefix":"10.48550","suffix":"arxiv.2509.21117","identifiers":[{"identifier":"2509.21117","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.21117"}],"creators":[{"name":"Wang, Yidong","nameType":"Personal","givenName":"Yidong","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Song, Yunze","nameType":"Personal","givenName":"Yunze","familyName":"Song","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Tingyuan","nameType":"Personal","givenName":"Tingyuan","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Xuanwang","nameType":"Personal","givenName":"Xuanwang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Zhuohao","nameType":"Personal","givenName":"Zhuohao","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Hao","nameType":"Personal","givenName":"Hao","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Song, Chiyu","nameType":"Personal","givenName":"Chiyu","familyName":"Song","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Qiufeng","nameType":"Personal","givenName":"Qiufeng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Cunxiang","nameType":"Personal","givenName":"Cunxiang","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Zhen","nameType":"Personal","givenName":"Zhen","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Dai, Xinyu","nameType":"Personal","givenName":"Xinyu","familyName":"Dai","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yue","nameType":"Personal","givenName":"Yue","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Wei","nameType":"Personal","givenName":"Wei","familyName":"Ye","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Shikun","nameType":"Personal","givenName":"Shikun","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TrustJudge: Inconsistencies of LLM-as-a-Judge and How to Alleviate Them"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-25T13:04:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-26T00:47:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-26T05:33:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T00:32:41Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The adoption of Large Language Models (LLMs) as automated evaluators (LLM-as-a-judge) has revealed critical inconsistencies in current evaluation frameworks. We identify two fundamental types of inconsistencies: (1) Score-Comparison Inconsistency, where lower-rated responses outperform higher-scored ones in pairwise comparisons, and (2) Pairwise Transitivity Inconsistency, manifested through circular preference chains (A\u0026gt;B\u0026gt;C\u0026gt;A) and equivalence contradictions (A=B=C\\neq A). We argue that these issues come from information loss in discrete rating systems and ambiguous tie judgments during pairwise evaluation. We propose TrustJudge, a probabilistic framework that addresses these limitations through two key innovations: 1) distribution-sensitive scoring that computes continuous expectations from discrete rating probabilities, preserving information entropy for more precise scoring, and 2) likelihood-aware aggregation that resolves transitivity violations using bidirectional preference probabilities or perplexity. We also formalize the theoretical limitations of current LLM-as-a-judge frameworks and demonstrate how TrustJudge's components overcome them. When evaluated with Llama-3.1-70B-Instruct as judge using our dataset, TrustJudge reduces Score-Comparison inconsistency by 8.43% (from 23.32% to 14.89%) and Pairwise Transitivity inconsistency by 10.82% (from 15.22% to 4.40%), while maintaining higher evaluation accuracy. Our work provides the first systematic analysis of evaluation framework inconsistencies in LLM-as-a-judge paradigms, offering both theoretical insights and practical solutions for reliable automated assessment. The framework demonstrates consistent improvements across various model architectures and scales, enabling more trustworthy LLM evaluation without requiring additional training or human annotations. The codes can be found at https://github.com/TrustJudge/TrustJudge.","descriptionType":"Abstract"},{"description":"22 pages, 9 figures, 6 tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.21117","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-26T01:52:55.000Z","registered":"2025-09-26T01:52:56.000Z","published":"2025","updated":"2025-09-29T02:57:36.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.21117","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}