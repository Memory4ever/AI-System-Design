<span id="S4.T3.2.1.1.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt ltx_colspan ltx_colspan_5"><span id="S4.T3.2.1.1.1.1.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Domains</span></span>
<span id="S4.T3.2.1.1.1.1.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T3.2.1.1.1.1.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Overall</span></span></span>
<span id="S4.T3.2.1.1.1.1.1.1.1.2" class="ltx_tr">
<span id="S4.T3.2.1.1.1.1.1.1.1.2.1" class="ltx_td ltx_border_r"></span>
