<td id="A6.T7.3.2.3" class="ltx_td ltx_align_right ltx_border_t">85.21 <math id="A6.T7.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.21</td></tr>
<tr id="A6.T7.3.3" class="ltx_tr">
<th id="A6.T7.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Majority voting</th>
<td id="A6.T7.3.3.2" class="ltx_td ltx_align_right">76.67 <math id="A6.T7.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.58</td>
