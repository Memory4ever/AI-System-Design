<th id="A4.T3.3.2.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_r">Bo<math id="A4.T3.m1" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math></th>
<th id="A4.T3.3.2.4" class="ltx_td ltx_align_right ltx_th ltx_th_column">Bo1</th>
<th id="A4.T3.3.2.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_r">Bo<math id="A4.T3.m2" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math></th>
<th id="A4.T3.3.2.6" class="ltx_td ltx_align_right ltx_th ltx_th_column">Bo1</th>
<th id="A4.T3.3.2.7" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_r">Bo<math id="A4.T3.m3" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math></th>
<th id="A4.T3.3.2.8" class="ltx_td ltx_align_right ltx_th ltx_th_column">Bo1</th>
