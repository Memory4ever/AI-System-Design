<td id="S4.T2.3.3.2" class="ltx_td ltx_align_left">85.42 <math id="S4.T2.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.01</td></tr>
<tr id="S4.T2.3.4" class="ltx_tr">
