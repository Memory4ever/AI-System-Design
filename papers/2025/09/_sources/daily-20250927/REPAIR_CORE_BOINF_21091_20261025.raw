<tr id="S4.T1.3.7" class="ltx_tr">
<th id="S4.T1.3.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">MetaStone-S1-32B</th>
<td id="S4.T1.3.7.2" class="ltx_td ltx_align_right">60,757</td>
<td id="S4.T1.3.7.3" class="ltx_td ltx_align_right">806,737,009</td>
<td id="S4.T1.3.7.4" class="ltx_td ltx_align_right">2,458.48</td></tr>
<tr id="S4.T1.3.8" class="ltx_tr">
<th id="S4.T1.3.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">NVIDIA-Nemotron-Nano-9B-v2</th>
<td id="S4.T1.3.8.2" class="ltx_td ltx_align_right">60,640</td>
<td id="S4.T1.3.8.3" class="ltx_td ltx_align_right">295,466,626</td>
<td id="S4.T1.3.8.4" class="ltx_td ltx_align_right">897.82</td></tr>
<tr id="S4.T1.3.9" class="ltx_tr">
