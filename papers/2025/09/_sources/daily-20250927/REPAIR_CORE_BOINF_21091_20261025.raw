</thead>
<tbody class="ltx_tbody">
<tr id="A4.T3.3.3" class="ltx_tr">
<th id="A4.T3.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">AM-Thinking-v1</th>
