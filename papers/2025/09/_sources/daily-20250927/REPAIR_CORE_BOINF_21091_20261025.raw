<td id="S4.T2.3.2.2" class="ltx_td ltx_align_left ltx_border_t">91.04 <math id="S4.T2.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.32</td></tr>
