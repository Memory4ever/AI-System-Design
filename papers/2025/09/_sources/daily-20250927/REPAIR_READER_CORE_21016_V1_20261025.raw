<span id="A1.T2.6.1.6.5.1.1" class="ltx_p"><span id="A1.T2.6.1.6.5.1.1.1" class="ltx_text" style="font-size:90%;">cts 4; f 1.2; out 7–8; r 25; v 800–1000</span></span>
</span></td>
<td id="A1.T2.6.1.6.6" class="ltx_td ltx_align_left ltx_align_top" style="padding:0.7pt 4.0pt;">
<span id="A1.T2.6.1.6.6.1" class="ltx_inline-block ltx_align_top" style="width:65.6pt;">
<span id="A1.T2.6.1.6.6.1.1" class="ltx_p"><span id="A1.T2.6.1.6.6.1.1.1" class="ltx_text" style="font-size:90%;">cts 6; f 1.0; out 8–10; r 20; v 1000–1200</span></span>
</span></td></tr>
<tr id="A1.T2.6.1.7" class="ltx_tr">
<td id="A1.T2.6.1.7.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.7pt 4.0pt;"><span id="A1.T2.6.1.7.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">ROT_BALL</span></td>
<td id="A1.T2.6.1.7.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.7pt 4.0pt;">
<span id="A1.T2.6.1.7.2.1" class="ltx_inline-block ltx_align_top" style="width:65.6pt;">
<span id="A1.T2.6.1.7.2.1.1" class="ltx_p"><span id="A1.T2.6.1.7.2.1.1.1" class="ltx_text" style="font-size:90%;">n 2; f 2.5; out 3–6; in 3–6; r 20; v 200–400</span></span>
</span></td>
<td id="A1.T2.6.1.7.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.7pt 4.0pt;">
<span id="A1.T2.6.1.7.3.1" class="ltx_inline-block ltx_align_top" style="width:65.6pt;">
