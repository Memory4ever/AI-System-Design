            <math id="alg1.m22" class="ltx_Math" alttext="batched\_chunks,hybrid\_chunks\leftarrow transform(\mathcal{B})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi></mrow><mo mathsize="0.900em">,</mo><mrow><mrow><mi mathsize="0.900em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">y</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi></mrow><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℬ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">batched\_chunks,hybrid\_chunks\leftarrow transform(\mathcal{B})</annotation></semantics></math><span id="alg1.6.18.2" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="alg1.6.19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.19.1" class="ltx_text ltx_font_bold" style="font-size:90%;">16</span></span>
            <span id="alg1.6.19.2" class="ltx_text ltx_font_bold" style="font-size:90%;">return</span><span id="alg1.6.19.3" class="ltx_text" style="font-size:90%;"> </span><em id="alg1.6.19.4" class="ltx_emph ltx_font_italic" style="font-size:90%;"><math id="alg1.m23" class="ltx_Math" alttext="split\_chunks\cup batched\_chunks\cup hybrid\_chunks" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">_</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>∪</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">_</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>∪</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">_</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><annotation encoding="application/x-tex">split\_chunks\cup batched\_chunks\cup hybrid\_chunks</annotation></semantics></math></em><span id="alg1.6.19.5" class="ltx_text" style="font-size:90%;">
</span>
</div>
</div>
</figure>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3. </span>Chunk Scheduler</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">In this section, we first define our scheduling space through careful trade-off discussions and then present our two-level approach that jointly optimizes pipeline schedule (via <span id="S3.SS3.p1.1.1" class="ltx_text ltx_font_italic">sequence grouping</span>, § <a href="#S3.SS3.SSS2" title="3.3.2. Sequence Grouping ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3.2</span></a>) and checkpointing configuration (via <span id="S3.SS3.p1.1.2" class="ltx_text ltx_font_italic">stage-aware chunk-level adaptive checkpointing</span>, § <a href="#S3.SS3.SSS3" title="3.3.3. Stage-Aware Chunk-Level Adaptive Checkpointing ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3.3</span></a>).</p>
</div>
<section id="S3.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.3.1. </span>Solving Space Definition</h4>

<div id="S3.SS3.SSS1.p1" class="ltx_para">
<p id="S3.SS3.SSS1.p1.1" class="ltx_p">It’s non-trivial to solve a sophisticated schedule plan due to the vast optimization space: 1) There exist numerous basic scheduling patterns <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib14" title="" class="ltx_ref">14</a>, <a href="#bib.bib2" title="" class="ltx_ref">2</a>, <a href="#bib.bib26" title="" class="ltx_ref">26</a>, <a href="#bib.bib35" title="" class="ltx_ref">35</a>)</cite> with each exhibiting distinct memory footprint and bubble characteristics. 2) The execution order of varied-length sequences needs to be determined. 3) A checkpointing mechanism tailored for EPP is required to efficiently integrate checkpointing.
We begin by introducing some key insights, based on which the solving space is then confined.</p>
</div>
<div id="S3.SS3.SSS1.p2" class="ltx_para">
<p id="S3.SS3.SSS1.p2.1" class="ltx_p"><span id="S3.SS3.SSS1.p2.1.1" class="ltx_text ltx_font_italic">Firstly, 1F1B is taken as the basic schedule pattern.</span>
GPipe <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib2" title="" class="ltx_ref">2</a>)</cite> features <span id="S3.SS3.SSS1.p2.1.2" class="ltx_text ltx_font_italic">forward-then-backward</span> schedule, which is not memory efficient because it needs to accommodate all micro-batches.
Chimera <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib26" title="" class="ltx_ref">26</a>)</cite> proposes bidirectional PP while it duplicates model states and needs synchronization of gradients.
Other 1F1B schedule patterns <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">32</a>, <a href="#bib.bib35" title="" class="ltx_ref">35</a>, <a href="#bib.bib38" title="" class="ltx_ref">38</a>, <a href="#bib.bib28" title="" class="ltx_ref">28</a>)</cite> are also proposed.
However, most improvements in these works stem from reducing the bubble of warmup and cooldown phases.
As the number of micro-batches increases, these approaches converge to similar performance because the steady phase with negligible bubbles dominates the total execution.
To this end, 1F1B schedule <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib38" title="" class="ltx_ref">38</a>)</cite> is taken as our basic schedule pattern as we focus on training throughput.</p>
</div>
<figure id="S3.F6" class="ltx_figure"><img src="2509.21275v1/solving_space.png" id="S3.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:452/257;" width="452" height="257" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F6.4" class="ltx_text" style="font-size:90%;">Figure 6</span>. </span><span id="S3.F6.5" class="ltx_text" style="font-size:90%;"> Illustration of pipeline scheduling space. (a) Explanation of sequences’ execution order in a 1F1B pipeline. (b) To avoid OOM error, multiple 1F1B pipelines are scheduled, with each introducing an identical warmup-cooldown overhead <math id="S3.F6.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>.</span></figcaption>
</figure>
<div id="S3.SS3.SSS1.p3" class="ltx_para">
<p id="S3.SS3.SSS1.p3.1" class="ltx_p"><span id="S3.SS3.SSS1.p3.1.1" class="ltx_text ltx_font_italic">Secondly, it’s feasible to schedule one or multiple 1F1B pipelines, within which longer sequences are prioritized to execute.</span>
To begin with, the longest sequences should be scheduled first within a 1F1B pipeline.
As illustrated in Fig. <a href="#S3.F6" title="Figure 6 ‣ 3.3.1. Solving Space Definition ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>(a), sequence <span id="S3.SS3.SSS1.p3.1.2" class="ltx_text ltx_font_italic">A</span> with one chunk is scheduled before sequence <span id="S3.SS3.SSS1.p3.1.3" class="ltx_text ltx_font_italic">B</span> with three chunks.
We observe that the steady phase is interrupted due to the unavailability of a backward schedule, introducing severe penalty bubbles.
To address this, we prioritize longer sequences in a 1F1B pipeline and enforce this as a fundamental scheduling rule.
Moreover, scheduling of multiple 1F1B pipelines is necessary when sequences cannot be scheduled in a single 1F1B pipeline altogether.
As shown in Fig. <a href="#S3.F6" title="Figure 6 ‣ 3.3.1. Solving Space Definition ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>(b), sequences <span id="S3.SS3.SSS1.p3.1.4" class="ltx_text ltx_font_italic">B</span> and <span id="S3.SS3.SSS1.p3.1.5" class="ltx_text ltx_font_italic">C</span> cannot be co-scheduled with sequence <span id="S3.SS3.SSS1.p3.1.6" class="ltx_text ltx_font_italic">A</span> due to the limited memory capacity, forcing a new pipeline to be scheduled.
Gradient accumulation is enabled among these 1F1B pipelines to ensure consistency.
Notably, we do not exploit pipeline bubbles to overlap these 1F1B pipelines, as typically no more than three 1F1B pipelines are scheduled by our solver, offering marginal benefits but complicating the solving process.</p>
</div>
<div id="S3.SS3.SSS1.p4" class="ltx_para">
<p id="S3.SS3.SSS1.p4.1" class="ltx_p"><span id="S3.SS3.SSS1.p4.1.1" class="ltx_text ltx_font_italic">Thirdly, employing stage-aware chunk-level adaptive checkpointing</span>.
In long-context training, performance degradation may occur without checkpointing because 1) a finer granularity of TPP might be required to alleviate the memory burden, harming hardware utilization, and 2) a number of 1F1B pipelines have to be scheduled for multiple excessively long sequences, leading to prohibitive warmup-cooldown overhead.
However, directly applying full checkpointing introduces unnecessary recomputation overhead.
Furthermore, EPP’s memory footprint disparity and chunk length heterogeneity render suboptimal performance of a uniform and static checkpointing strategy.
Specifically, different pipeline stages have varying requirements for checkpointing to reduce memory footprint, and applying checkpointing on longer chunks reduces more activation footprint at the same recomputation cost if chunks are workload-balanced.
The trade-offs above inspire us to employ a <span id="S3.SS3.SSS1.p4.1.2" class="ltx_text ltx_font_italic">stage-aware adaptive checkpointing strategy at chunk granularity</span>.</p>
</div>
<div id="S3.SS3.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S3.SS3.SSS1.p5.3" class="ltx_p">In summary, we define our solving space as follows: for a pipeline schedule <math id="S3.SS3.SSS1.p5.m1" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>, we group sequences and assign sequences of each group to a distinct 1F1B pipeline <math id="S3.SS3.SSS1.p5.m2" class="ltx_Math" alttext="P\in\mathcal{P}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">P\in\mathcal{P}</annotation></semantics></math>; for checkpointing, we apply a customized checkpointing layer <math id="S3.SS3.SSS1.p5.m3" class="ltx_Math" alttext="ckpt(p,k)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ckpt(p,k)</annotation></semantics></math> for each chunk <math id="S3.SS3.SSS1.p5.m4" class="ltx_Math" alttext="\{C_{k},S_{k}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>C</mi><mi>k</mi></msub><mo>,</mo><msub><mi>S</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{C_{k},S_{k}\}</annotation></semantics></math> at each pipeline stage <math id="S3.SS3.SSS1.p5.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.
Let <math id="S3.SS3.SSS1.p5.m6" class="ltx_Math" alttext="\mathcal{S}[i]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}[i]</annotation></semantics></math> represents the set of sequences divided into <math id="S3.SS3.SSS1.p5.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> chunks, the problem can be formulated as:</p>
<table id="S3.E12" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E12X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(12)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E12X.m2" class="ltx_Math" alttext="\displaystyle minimize\sum_{P\in\mathcal{P}}T(P)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">z</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">P</mi><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi></mrow></munder></mstyle><mrow><mi mathsize="0.900em">T</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">P</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle minimize\sum_{P\in\mathcal{P}}T(P)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E12Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E12Xa.m2" class="ltx_Math" alttext="\displaystyle\text{s.t.}\bigcup_{P\in\mathcal{P}}\mathcal{S}_{P}=\mathcal{S}[:]," display="inline" intent=":literal"><semantics><mrow><mtext mathsize="0.900em">s.t.</mtext><mstyle displaystyle="true"><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">⋃</mo></mstyle><msub><mrow></mrow><mrow><mi mathsize="0.900em">P</mi><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi></mrow></msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒮</mi><msub><mrow></mrow><mi mathsize="0.900em">P</mi></msub><mo mathsize="0.900em">=</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒮</mi><mo maxsize="0.900em" minsize="0.900em">[</mo><mo mathsize="0.900em" rspace="0em">:</mo><mo maxsize="0.900em" minsize="0.900em">]</mo><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{s.t.}\bigcup_{P\in\mathcal{P}}\mathcal{S}_{P}=\mathcal{S}[:],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS1.p5.4" class="ltx_p">where <math id="S3.SS3.SSS1.p5.m8" class="ltx_Math" alttext="\mathcal{S}_{P}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>P</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{P}</annotation></semantics></math> represents the sequences scheduled in <math id="S3.SS3.SSS1.p5.m9" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S3.SS3.SSS1.p5.m10" class="ltx_Math" alttext="T(P)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T(P)</annotation></semantics></math> denotes the total execution time of <math id="S3.SS3.SSS1.p5.m11" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.
Thanks to the workload-balanced manner <span id="S3.SS3.SSS1.p5.4.1" class="ltx_text">InfiniPipe</span> processes sequences, we ignore the pipeline bubbles in the steady phase and simplify Eq. <a href="#S3.E12" title="In 3.3.1. Solving Space Definition ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a> as a summation of recomputation cost <math id="S3.SS3.SSS1.p5.m12" class="ltx_Math" alttext="T_{ckpt}(P)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{ckpt}(P)</annotation></semantics></math> and warmup-cooldown overhead <math id="S3.SS3.SSS1.p5.m13" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>:</p>
<table id="S3.E13" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E13X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(13)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E13X.m2" class="ltx_Math" alttext="\displaystyle minimize\sum_{P\in\mathcal{P}}\delta+T_{ckpt}(P)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">z</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">P</mi><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi></mrow></munder></mstyle><mi mathsize="0.900em">δ</mi></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">T</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">P</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle minimize\sum_{P\in\mathcal{P}}\delta+T_{ckpt}(P),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS1.p5.5" class="ltx_p">where <math id="S3.SS3.SSS1.p5.m14" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> is a constant approximated as <math id="S3.SS3.SSS1.p5.m15" class="ltx_Math" alttext="(d_{p}-1)\cdot avg(T_{tot})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>p</mi></msub><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>a</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(d_{p}-1)\cdot avg(T_{tot})</annotation></semantics></math>.
The optimal pipeline schedule <math id="S3.SS3.SSS1.p5.m16" class="ltx_Math" alttext="\mathcal{P}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{P}_{0}</annotation></semantics></math> along with checkpointing configuration <math id="S3.SS3.SSS1.p5.m17" class="ltx_Math" alttext="ckpt_{0}(p,k)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ckpt_{0}(p,k)</annotation></semantics></math>, is co-optimized, with detailed methodology provided in § <a href="#S3.SS3.SSS2" title="3.3.2. Sequence Grouping ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3.2</span></a> and § <a href="#S3.SS3.SSS3" title="3.3.3. Stage-Aware Chunk-Level Adaptive Checkpointing ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3.3</span></a>, respectively.</p>
</div>
</section>
<section id="S3.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.3.2. </span>Sequence Grouping</h4>

<div id="S3.SS3.SSS2.p1" class="ltx_para">
<p id="S3.SS3.SSS2.p1.1" class="ltx_p">An interference of pipeline schedule and gradient checkpointing is observed in Fig. <a href="#S3.F7" title="Figure 7 ‣ 3.3.2. Sequence Grouping ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>(a).
Indicated by Eqs. <a href="#S3.E7" title="In 3.1.3. Stage-Aware Memory Footprint Analysis ‣ 3.1. Cost Model ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>,<a href="#S3.E8" title="In 3.1.3. Stage-Aware Memory Footprint Analysis ‣ 3.1. Cost Model ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, the pipeline’s memory footprint is related to <math id="S3.SS3.SSS2.p1.m1" class="ltx_Math" alttext="N_{prefill}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">N_{prefill}</annotation></semantics></math>, i.e., the number of chunks the longest sequence in a sequence group is split into.
Accordingly, when short sequences <span id="S3.SS3.SSS2.p1.1.1" class="ltx_text ltx_font_italic">B</span> and <span id="S3.SS3.SSS2.p1.1.2" class="ltx_text ltx_font_italic">C</span> are grouped with long sequence <span id="S3.SS3.SSS2.p1.1.3" class="ltx_text ltx_font_italic">A</span>, they are forced to apply a tighter checkpointing setup than they are scheduled separately due to the enlarged <math id="S3.SS3.SSS2.p1.m2" class="ltx_Math" alttext="N_{prefill}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">N_{prefill}</annotation></semantics></math>, introducing more recomputation overhead.
Therefore, 1) <span id="S3.SS3.SSS2.p1.1.4" class="ltx_text ltx_font_italic">sequences of similar lengths should be grouped together</span> 2) <span id="S3.SS3.SSS2.p1.1.5" class="ltx_text ltx_font_italic">scheduling more 1F1B pipelines is potential to reduce recomputation cost <math id="S3.SS3.SSS2.p1.m3" class="ltx_Math" alttext="\sum_{P\in\mathcal{P}}T_{ckpt}(P)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mi>P</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow></msub><mrow><msub><mi>T</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{P\in\mathcal{P}}T_{ckpt}(P)</annotation></semantics></math> of Eq. <a href="#S3.E13" title="In 3.3.1. Solving Space Definition ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a> at the cost of severer warmup-cooldown overhead <math id="S3.SS3.SSS2.p1.m4" class="ltx_Math" alttext="\delta\cdot|\mathcal{P}|" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\cdot|\mathcal{P}|</annotation></semantics></math></span>, forming the trade-off when optimizing sequence grouping strategy.</p>
</div>
<div id="S3.SS3.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S3.SS3.SSS2.p2.2" class="ltx_p">We employ a dynamic programming method to resolve the optimal sequence grouping strategy.
Let <math id="S3.SS3.SSS2.p2.m1" class="ltx_Math" alttext="dp[i]" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">dp[i]</annotation></semantics></math> represent the minimum cost to schedule sequences with at most <math id="S3.SS3.SSS2.p2.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> chunks.
The state transition equation can be deduced as:</p>
<table id="S3.E14" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E14X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(14)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E14X.m2" class="ltx_Math" alttext="\displaystyle dp[i+1]=\min_{0\leq k\leq i}\{dp[k]+\delta+T_{ckpt}(P)\}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><munder><mi mathsize="0.900em">min</mi><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">≤</mo><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">≤</mo><mi mathsize="0.900em">i</mi></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">δ</mi><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">T</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">P</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle dp[i+1]=\min_{0\leq k\leq i}\{dp[k]+\delta+T_{ckpt}(P)\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS2.p2.3" class="ltx_p">where sequences in <math id="S3.SS3.SSS2.p2.m3" class="ltx_math_unparsed" alttext="\mathcal{S}[k+1:i+1]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mo stretchy="false">[</mo><mi>k</mi><mo>+</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo>+</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}[k+1:i+1]</annotation></semantics></math> is scheduled by pipeline <math id="S3.SS3.SSS2.p2.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S3.SS3.SSS2.p2.m5" class="ltx_Math" alttext="T_{ckpt}(P)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{ckpt}(P)</annotation></semantics></math> is obtained by applying <span id="S3.SS3.SSS2.p2.3.1" class="ltx_text ltx_font_italic">stage-aware chunk-level adaptive checkpointing</span> (§ <a href="#S3.SS3.SSS3" title="3.3.3. Stage-Aware Chunk-Level Adaptive Checkpointing ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3.3</span></a>) on <math id="S3.SS3.SSS2.p2.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.
By tracking transition states, we derive both the sequence grouping and its corresponding checkpointing configuration.</p>
</div>
<figure id="S3.F7" class="ltx_figure"><img src="2509.21275v1/design_insights.png" id="S3.F7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:452/263;" width="452" height="263" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F7.4" class="ltx_text" style="font-size:90%;">Figure 7</span>. </span><span id="S3.F7.5" class="ltx_text" style="font-size:90%;">Illustrations of insights about co-optimizing checkpointing with pipeline schedule.</span></figcaption>
</figure>
</section>
<section id="S3.SS3.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.3.3. </span>Stage-Aware Chunk-Level Adaptive Checkpointing</h4>

<div id="S3.SS3.SSS3.p1" class="ltx_para">
<p id="S3.SS3.SSS3.p1.1" class="ltx_p">In this section, we elaborate on how we apply optimal checkpointing configuration for a given 1F1B pipeline <math id="S3.SS3.SSS3.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> assigned <math id="S3.SS3.SSS3.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> chunks.</p>
</div>
<div id="S3.SS3.SSS3.p2" class="ltx_para">
<p id="S3.SS3.SSS3.p2.3" class="ltx_p">To begin with, we analyze the impact of checkpointing on PP and introduce a constraint on <math id="S3.SS3.SSS3.p2.m1" class="ltx_Math" alttext="ckpt(p,k)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ckpt(p,k)</annotation></semantics></math>.
As illustrated in Fig. <a href="#S3.F7" title="Figure 7 ‣ 3.3.2. Sequence Grouping ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>(b), full checkpointing is applied to <math id="S3.SS3.SSS3.p2.m2" class="ltx_Math" alttext="B_{1}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>1</mn></msub><annotation encoding="application/x-tex">B_{1}</annotation></semantics></math> of the second stage.
We observe that checkpointing affects not only the second stage, introducing propagated bubbles of identical size in all the other stages.
A key insight is that <span id="S3.SS3.SSS3.p2.3.1" class="ltx_text ltx_font_italic">applying full checkpointing to the marked chunks <math id="S3.SS3.SSS3.p2.m3" class="ltx_Math" alttext="B_{2}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>2</mn></msub><annotation encoding="application/x-tex">B_{2}</annotation></semantics></math>, <math id="S3.SS3.SSS3.p2.m4" class="ltx_Math" alttext="A_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">A_{1}</annotation></semantics></math>, and <math id="S3.SS3.SSS3.p2.m5" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math> exploits the propagated bubble and maintains the total execution time unchanged</span>.
Let <math id="S3.SS3.SSS3.p2.m6" class="ltx_Math" alttext="ckpt^{\prime}(p,k)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ckpt^{\prime}(p,k)</annotation></semantics></math> represent the number of checkpointed layers for the chunk executing the <math id="S3.SS3.SSS3.p2.m7" class="ltx_Math" alttext="k^{th}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">k^{th}</annotation></semantics></math> backward pass in the <math id="S3.SS3.SSS3.p2.m8" class="ltx_Math" alttext="p^{th}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msup><annotation encoding="application/x-tex">p^{th}</annotation></semantics></math> pipeline stage (the execution order differs between forward and backward passes).
Based on this insight, we yield the following constraint:</p>
<table id="S3.E15" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E15X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(15)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E15X.m2" class="ltx_Math" alttext="\displaystyle ckpt^{\prime}(p,k)=ckpt^{\prime}(p+i,k+i)=\mathcal{C}[k+d_{p}-p]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">i</mi></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">i</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">p</mi></msub></mrow><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle ckpt^{\prime}(p,k)=ckpt^{\prime}(p+i,k+i)=\mathcal{C}[k+d_{p}-p],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS3.p2.4" class="ltx_p">where <math id="S3.SS3.SSS3.p2.m9" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> is a set containing <math id="S3.SS3.SSS3.p2.m10" class="ltx_Math" alttext="d_{p}-1+n" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>p</mi></msub><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d_{p}-1+n</annotation></semantics></math> independent integer variables.
Let <math id="S3.SS3.SSS3.p2.m11" class="ltx_Math" alttext="f2b[k]" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">f2b[k]</annotation></semantics></math> map the forward execution order to the backward execution order, we have:</p>
<table id="S3.E16" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E16X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(16)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E16X.m2" class="ltx_Math" alttext="\displaystyle ckpt(p,k)=ckpt^{\prime}(p,f2b[k])=\mathcal{C}[f2b[k]+d_{p}-p]" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mrow><mrow><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">p</mi></msub></mrow><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">p</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle ckpt(p,k)=ckpt^{\prime}(p,f2b[k])=\mathcal{C}[f2b[k]+d_{p}-p]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS3.p2.5" class="ltx_p">This formulation reduces the number of optimization variables from <math id="S3.SS3.SSS3.p2.m12" class="ltx_Math" alttext="n\cdot d_{p}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>d</mi><mi>p</mi></msub></mrow><annotation encoding="application/x-tex">n\cdot d_{p}</annotation></semantics></math> of <math id="S3.SS3.SSS3.p2.m13" class="ltx_Math" alttext="ckpt(p,k)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ckpt(p,k)</annotation></semantics></math> to <math id="S3.SS3.SSS3.p2.m14" class="ltx_Math" alttext="d_{p}-1+n" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>p</mi></msub><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d_{p}-1+n</annotation></semantics></math> of <math id="S3.SS3.SSS3.p2.m15" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>, significantly reducing solving overhead.</p>
</div>
<div id="S3.SS3.SSS3.p3" class="ltx_para ltx_noindent">
<p id="S3.SS3.SSS3.p3.4" class="ltx_p">Afterward, a solution based on MILP is introduced, as outlined in Alg. <a href="#alg2" title="In 3.3.3. Stage-Aware Chunk-Level Adaptive Checkpointing ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
Fig. <a href="#S3.F7" title="Figure 7 ‣ 3.3.2. Sequence Grouping ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>(b) reveals that recomputation cost <math id="S3.SS3.SSS3.p3.m1" class="ltx_Math" alttext="T_{ckpt}(P)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{ckpt}(P)</annotation></semantics></math> is related to <math id="S3.SS3.SSS3.p3.m2" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> with:</p>
<table id="S3.E17" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E17X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(17)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E17X.m2" class="ltx_Math" alttext="\displaystyle T_{ckpt}(P)=\hat{F}\cdot\sum_{c\in\mathcal{C}}c," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathsize="0.900em">T</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">P</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mover accent="true"><mi mathsize="0.900em">F</mi><mo>^</mo></mover><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">c</mi><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi></mrow></munder></mstyle><mi mathsize="0.900em">c</mi></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{ckpt}(P)=\hat{F}\cdot\sum_{c\in\mathcal{C}}c,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS3.p3.5" class="ltx_p">where <math id="S3.SS3.SSS3.p3.m3" class="ltx_Math" alttext="\hat{F}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>F</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{F}</annotation></semantics></math> denotes the estimated forward execution time of a model layer.
<span id="S3.SS3.SSS3.p3.5.1" class="ltx_text ltx_font_italic">The optimal checkpointing strategy aims to minimize the recomputation cost <math id="S3.SS3.SSS3.p3.m4" class="ltx_Math" alttext="T_{ckpt}(P)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{ckpt}(P)</annotation></semantics></math> (Eq. <a href="#S3.E17" title="In 3.3.3. Stage-Aware Chunk-Level Adaptive Checkpointing ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) with peak memory <math id="S3.SS3.SSS3.p3.m5" class="ltx_Math" alttext="M_{tot}(p,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{tot}(p,t)</annotation></semantics></math> (equation  <a href="#S3.E8" title="In 3.1.3. Stage-Aware Memory Footprint Analysis ‣ 3.1. Cost Model ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) not exceeding hardware capacity limit <math id="S3.SS3.SSS3.p3.m6" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math></span>, formulated as:</p>
<table id="S3.E18" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E18X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(18)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E18X.m2" class="ltx_Math" alttext="\displaystyle\argmin_{\mathcal{C}\in\mathbb{N}^{n+d_{p}-1}}\hat{F}\cdot\sum_{c\in\mathcal{C}}c" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mi mathsize="0.900em">arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathsize="0.900em">min</mi></mrow><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mo mathsize="0.900em">∈</mo><msup><mi mathsize="0.900em">ℕ</mi><mrow><mrow><mi mathsize="0.900em">n</mi><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">p</mi></msub></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></msub><mo>⁡</mo><mover accent="true"><mi mathsize="0.900em">F</mi><mo>^</mo></mover></mrow><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">c</mi><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi></mrow></munder></mstyle><mi mathsize="0.900em">c</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\argmin_{\mathcal{C}\in\mathbb{N}^{n+d_{p}-1}}\hat{F}\cdot\sum_{c\in\mathcal{C}}c</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E18Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E18Xa.m2" class="ltx_Math" alttext="\displaystyle\text{s.t.}\hskip 9.24994pt\hskip 9.24994ptM_{ms}(p)+\sum_{k\in W_{p}(t)}M_{act}(S_{k})\leq\mathcal{G}\hskip 9.24994pt\forall(p,t),p\leq d_{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext mathsize="0.900em">s.t.</mtext><mspace style="width:1.86em;" width="1.86em"></mspace><mrow><mrow><msub><mi mathsize="0.900em">M</mi><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">p</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">∈</mo><mrow><msub><mi mathsize="0.900em">W</mi><mi mathsize="0.900em">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></munder></mstyle><mrow><msub><mi mathsize="0.900em">M</mi><mrow><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">S</mi><mi mathsize="0.900em">k</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow></mrow><mo mathsize="0.900em">≤</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒢</mi><mo lspace="1.097em" rspace="0em">​</mo><mrow><mo mathsize="0.900em">∀</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">≤</mo><msub><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{s.t.}\hskip 9.24994pt\hskip 9.24994ptM_{ms}(p)+\sum_{k\in W_{p}(t)}M_{act}(S_{k})\leq\mathcal{G}\hskip 9.24994pt\forall(p,t),p\leq d_{p}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E18Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E18Xb.m2" class="ltx_Math" alttext="\displaystyle c\leq\frac{L}{d_{p}},\forall c\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">c</mi><mo mathsize="0.900em">≤</mo><mstyle displaystyle="true"><mfrac><mi mathsize="0.900em">L</mi><msub><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">p</mi></msub></mfrac></mstyle></mrow><mo mathsize="0.900em">,</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∀</mo><mi mathsize="0.900em">c</mi></mrow><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c\leq\frac{L}{d_{p}},\forall c\in\mathcal{C}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS3.p3.6" class="ltx_p">Combining Eqs. <a href="#S3.E9" title="In 3.1.4. Combining Gradient Checkpointing Together ‣ 3.1. Cost Model ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>,<a href="#S3.E10" title="In 3.1.4. Combining Gradient Checkpointing Together ‣ 3.1. Cost Model ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>,<a href="#S3.E16" title="In 3.3.3. Stage-Aware Chunk-Level Adaptive Checkpointing ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>, we derive a linearity:</p>
<table id="S3.E19" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E19X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(19)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E19X.m2" class="ltx_Math" alttext="\displaystyle M_{act}(S_{k})=\mathcal{I}[k]-\mathcal{F}[k]\cdot\mathcal{C}_{p,k}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathsize="0.900em">M</mi><mrow><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">S</mi><mi mathsize="0.900em">k</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℐ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℱ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em" rspace="0.055em">]</mo></mrow></mrow><mo mathsize="0.900em" rspace="0.222em">⋅</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mrow><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">k</mi></mrow></msub></mrow></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle M_{act}(S_{k})=\mathcal{I}[k]-\mathcal{F}[k]\cdot\mathcal{C}_{p,k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS3.p3.7" class="ltx_p">where chunk-specific coefficients (<math id="S3.SS3.SSS3.p3.m7" class="ltx_Math" alttext="\mathcal{I}[k]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}[k]</annotation></semantics></math>, <math id="S3.SS3.SSS3.p3.m8" class="ltx_Math" alttext="\mathcal{F}[k]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}[k]</annotation></semantics></math>) and <math id="S3.SS3.SSS3.p3.m9" class="ltx_Math" alttext="\mathcal{C}_{p,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{C}_{p,k}</annotation></semantics></math> are defined explicitly in Alg. <a href="#alg2" title="In 3.3.3. Stage-Aware Chunk-Level Adaptive Checkpointing ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
To this end, constraint <a href="#S3.E18" title="In 3.3.3. Stage-Aware Chunk-Level Adaptive Checkpointing ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a> is further reformulated as a system of linear inequalities in terms of <math id="S3.SS3.SSS3.p3.m10" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> and the MILP is finally expressed as:</p>
<table id="S3.E20" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E20X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(20)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E20X.m2" class="ltx_Math" alttext="\displaystyle\argmin_{\mathcal{C}\in\mathbb{N}^{n+d_{p}-1}}\sum_{c\in\mathcal{C}}c" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathsize="0.900em">min</mi></mrow><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mo mathsize="0.900em">∈</mo><msup><mi mathsize="0.900em">ℕ</mi><mrow><mrow><mi mathsize="0.900em">n</mi><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">p</mi></msub></mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></msub><mstyle displaystyle="true"><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi mathsize="0.900em">c</mi><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi></mrow></msub><mi mathsize="0.900em">c</mi></mrow><annotation encoding="application/x-tex">\displaystyle\argmin_{\mathcal{C}\in\mathbb{N}^{n+d_{p}-1}}\sum_{c\in\mathcal{C}}c</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E20Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E20Xa.m2" class="ltx_Math" alttext="\displaystyle\text{s.t.}\sum_{k\in W_{p}(t)}\mathcal{I}[k]-\mathcal{F}[k]\cdot\mathcal{C}_{p,k}\leq\mathcal{G}-M_{ms}\hskip 9.24994pt\forall(p,t),p\leq d_{p}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mtext mathsize="0.900em">s.t.</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">∈</mo><mrow><msub><mi mathsize="0.900em">W</mi><mi mathsize="0.900em">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></munder></mstyle><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℐ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℱ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em" rspace="0.055em">]</mo></mrow></mrow><mo mathsize="0.900em" rspace="0.222em">⋅</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mrow><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">k</mi></mrow></msub></mrow></mrow><mo mathsize="0.900em">≤</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒢</mi><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">M</mi><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo mathsize="0.900em">∀</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">≤</mo><msub><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{s.t.}\sum_{k\in W_{p}(t)}\mathcal{I}[k]-\mathcal{F}[k]\cdot\mathcal{C}_{p,k}\leq\mathcal{G}-M_{ms}\hskip 9.24994pt\forall(p,t),p\leq d_{p}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E20Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E20Xb.m2" class="ltx_Math" alttext="\displaystyle c\leq\frac{L}{d_{p}},\forall c\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">c</mi><mo mathsize="0.900em">≤</mo><mstyle displaystyle="true"><mfrac><mi mathsize="0.900em">L</mi><msub><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">p</mi></msub></mfrac></mstyle></mrow><mo mathsize="0.900em">,</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∀</mo><mi mathsize="0.900em">c</mi></mrow><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c\leq\frac{L}{d_{p}},\forall c\in\mathcal{C}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS3.p3.8" class="ltx_p">After optimizing <math id="S3.SS3.SSS3.p3.m11" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> and <math id="S3.SS3.SSS3.p3.m12" class="ltx_Math" alttext="T_{ckpt}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">T_{ckpt}</annotation></semantics></math>, the optimal checkpointing configuration <math id="S3.SS3.SSS3.p3.m13" class="ltx_Math" alttext="ckpt_{0}(p,k)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ckpt_{0}(p,k)</annotation></semantics></math> can be obtained by Eq. <a href="#S3.E16" title="In 3.3.3. Stage-Aware Chunk-Level Adaptive Checkpointing ‣ 3.3. Chunk Scheduler ‣ 3. InfiniPipe ‣ Data-Centric Elastic Pipeline Parallelism for Efficient Long-Context LLM Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>.</p>
</div>
<figure id="alg2" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="font-size:90%;"><span class="ltx_tag ltx_tag_float"><span id="alg2.5" class="ltx_text ltx_font_bold">Algorithm 2</span> </span>Stage-Aware Chunk-Level Adaptive Checkpointing Solving Based on MILP</figcaption>
<div id="alg2.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.6.1" class="ltx_listingline"><span id="alg2.6.1.1" class="ltx_text" style="font-size:90%;">
<span id="alg2.6.1.1.1" class="ltx_text"><span id="alg2.6.1.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>Chunks <math id="alg2.m1" class="ltx_Math" alttext="\{S_{k}|k\leq n\}" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.110em" minsize="1.110em">{</mo><msub><mi>S</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>k</mi><mo>≤</mo><mi>n</mi></mrow><mo maxsize="1.110em" minsize="1.110em">}</mo></mrow><annotation encoding="application/x-tex">\{S_{k}|k\leq n\}</annotation></semantics></math>, GPU memory capacity <math id="alg2.m2" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>, chunks windows <math id="alg2.m3" class="ltx_Math" alttext="W_{p}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{p}(t)</annotation></semantics></math>
</span>
</div>
<div id="alg2.6.2" class="ltx_listingline"><span id="alg2.6.2.1" class="ltx_text" style="font-size:90%;"><span id="alg2.6.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span><span id="alg2.6.2.2" class="ltx_text" style="font-size:90%;">Checkpointing configuration </span><math id="alg2.m4" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math><span id="alg2.6.2.3" class="ltx_text" style="font-size:90%;"> and minimum recomputation cost </span><math id="alg2.m5" class="ltx_Math" alttext="T_{ckpt}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">T</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></msub><annotation encoding="application/x-tex">T_{ckpt}</annotation></semantics></math>
</div>
<div id="alg2.6.3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.6.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">1</span></span>
