ke-linejoin="round" stroke-width="0.32pt" transform="matrix(0.9397 0.34203 -0.34203 0.9397 322.02 12.59)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-width="0.4pt"><path style="fill:none" d="M 333.95 24.65 C 335.78 29.67 335.78 33.33 334.17 37.75"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(-0.34203 0.9397 -0.9397 -0.34203 334.17 37.75)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-width="0.4pt"><path style="fill:none" d="M 322.62 50.19 C 317.01 52.23 312.92 52.23 307.9 50.41"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(-0.9397 -0.34203 0.34203 -0.9397 307.9 50.41)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-width="0.4pt"><path style="fill:none" d="M 291.13 50.19 C 285.51 52.23 281.42 52.23 276.4 50.41"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-dasharray="none" stroke