52.29"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="0.5" stroke="#000000" stroke-opacity="1." transform="matrix(0.4675 0.0 0.0 0.4675 357.9 -39.76)"><foreignObject style="--ltx-fo-width:2.25em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.36em;font-size:11.75pt;" height="17.25" overflow="visible" transform="matrix(1 0 0 -1 0 11.35)" width="36.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m32" class="ltx_Math" alttext="B_{[1;2]}" display="inline" intent=":literal"><semantics><msub><mi mathsize="1.200em">B</mi><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mn mathsize="1.200em">1</mn><mo mathsize="1.200em">;</mo><mn mathsize="1.200em">2</mn><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></msub><annotation encoding="application/x-tex">B_{[1;2]}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FF8000;" fill="#FF8000" fill-opacity="0.5" stroke="#000000" stroke-opacity="1."><path d="M 269.81 -135.11 L 242.2 -135.11 L 242.2 -162.72 L 269.81 -162.72 Z M 242.2 -162.72"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="0.5" stroke="#000000" stroke-opacity="1." transform="matrix(0.4675 0.0 0.0 0.4675 247.55 -150.19)"><foreignObject style="--ltx-fo-width:2.22em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.36em;font-size:11.75pt;" height="17.25" overflow="visible" transform="matrix(1 0 0 -1 0 11.35)" width="36.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m33" class="ltx_Math" alttext="C_{[1;2]}" display="inline" intent=":literal"><semantics><msub><mi mathsize="1.200em">C</mi><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mn mathsize="1.200em">1</mn><mo mathsize="1.200em">;</mo><mn mathsize="1.200em">2</mn><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></msub><annotation encoding="application/x-tex">C_{[1;2]}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FF8000;" fill="#FF8000" fill-opacity="0.5" stroke="#000000" stroke-opacity="1."><path d="M 380.24 -52.29 L 352.63 -52.29 L 352.63 -79.9 L 380.24 -79.9 Z M 352.63 -79.9"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="0.5" stroke="#000000" stroke-opacity="1." transform="matrix(0.4675 0.0 0.0 0.4675 357.9 -67.36)"><foreignObject style="--ltx-fo-width:2.25em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.36em;font-size:11.75pt;" height="17.25" overflow="visible" transform="matrix(1 0 0 -1 0 11.35)" width="36.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m34" class="ltx_Math" alttext="B_{[3;4]}" display="inline" intent=":literal"><semantics><msub><mi mathsize="1.200em">B</mi><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mn mathsize="1.200em">3</mn><mo mathsize="1.200em">;</mo><mn mathsize="1.200em">4</mn><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></msub><annotation encoding="application/x-tex">B_{[3;4]}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FF8000;" fill="#FF8000" fill-opacity="0.5" stroke="#000000" stroke-opacity="1."><path d="M 297.42 -135.11 L 269.81 -135.11 L 269.81 -162.72 L 297.42 -162.72 Z M 269.81 -162.72"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="0.5" stroke="#000000" stroke-opacity="1." transform="matrix(0.4675 0.0 0.0 0.4675 275.16 -150.19)"><foreignObject style="--ltx-fo-width:2.22em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.36em;font-size:11.75pt;" height="17.25" overflow="visible" transform="matrix(1 0 0 -1 0 11.35)" width="36.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m3