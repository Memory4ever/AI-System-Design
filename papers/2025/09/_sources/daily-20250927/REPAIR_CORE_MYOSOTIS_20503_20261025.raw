.sf2.pic1.m6" class="ltx_Math" alttext="[3;4]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.500em" minsize="0.500em">[</mo><mn mathsize="0.500em">3</mn><mo mathsize="0.500em">;</mo><mn mathsize="0.500em">4</mn><mo maxsize="0.500em" minsize="0.500em">]</mo></mrow><annotation encoding="application/x-tex">[3;4]</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -11.49 -19.69 C -11.49 -15.16 -15.16 -11.49 -19.69 -11.49 C -24.21 -11.49 -27.88 -15.16 -27.88 -19.69 C -27.88 -24.21 -24.21 -27.88 -19.69 -27.88 C -15.16 -27.88 -11.49 -24.21 -11.49 -19.69 Z M -19.69 -19.69"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.5 0.0 0.0 0.5 -24.55 -20.55)"><foreignObject style="--ltx-fo-width:1.91em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.17em;font-size:7.36pt;" height="6.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.19)" width="19.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F3.sf2.pic1.m7" class="ltx_Math" alttext="[1;4]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.500em" minsize="0.500em">[</mo><mn mathsize="0.500em">1</mn><mo mathsize="0.500em">;</mo><mn mathsize="0.500em">4</mn><mo maxsize="0.500em" minsize="0.500em">]</mo></mrow><annotation encoding="application/x-tex">[1;4]</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#BCD4E8;--ltx-fill-color:#BCD4E8;--ltx-fg-color:#BCD4E8;" color="#BCD4E8" fill="#BCD4E8" stroke="#BCD4E8" stroke-width="0.8pt"><path style="fill:none" d="M 0.92 -149.52 C 3.08 -131.15 -1.27 -117.95 -13.95 -104.48"></path></g><g style="--ltx-stroke-color:#BCD4E8;--ltx-fill-color:#BCD4E8;--ltx-fg-color:#BCD4E8;" color="#BCD4E8" fill="#BCD4E8" stroke="#BCD4E8" stroke-width="0.8pt"><path style="fill:none" d="M 31.41 -119.03 C 13.04 -121.19 -0.16 -116.84 -13.63 -104.16"></path></g><g style="--ltx-stroke-color:#E8CCBC;--ltx-fill-color:#E8CCBC;--ltx-fg-color:#E8CCBC;" color="#E8CCBC" fill="#E8CCBC" stroke="#E8CCBC" stroke-width="0.8pt"><path style="fill:none" d="M 79.66 -70.78 C 81.82 -52.41 77.47 -39.21 64.79 -25.74"></path></g><g style="--ltx-stroke-color:#E8CCBC;--ltx-fill-color:#E8CCBC;--ltx-fg-color:#E8CCBC;" color="#E8CCBC" fill="#E8CCBC" stroke="#E8CCBC" stroke-width="0.8pt"><path style="fill:none" d="M 110.15 -40.29 C 91.78 -42.45 78.58 -38.1 65.11 -25.42"></path></g><g style="--ltx-stroke-color:#BCD4E8;--ltx-fill-color:#BCD4E8;--ltx-fg-color:#BCD4E8;" color="#BCD4E8" fill="#BCD4E8" stroke="#BCD4E8" stroke-width="0.8pt"><path style="fill:none" d="M -13.79 -92.53 C 4.67 -74.07 4.67 -44.04 -13.79 -25.58"></path></g><g style="--ltx-stroke-color:#E8CCBC;--ltx-fill-color:#E8CCBC;--ltx-fg-color:#E8CCBC;" color="#E8CCBC" fill="#E8CCBC" stroke="#E8CCBC" stroke-width="0.8pt"><path style="fill:none" d="M 53.16 -25.58 C 34.7 -44.04 4.67 -44.04 -13.79 -25.58"></path></g><path style="fill:none" d="M 15.39 15.39 L 0.63 15.39 L 0.63 0.63 L 15.39 0.63 Z M 0.63 0.63"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.5 0.0 0.0 0.5 6.22 6.84)"><foreignObject style="--ltx-fo-width:0.76em;--ltx-fo-height:0.5em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.7" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="7.17"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.sf2.pic1.1" class="ltx_text" style="font-size:50%;">It</span></span></span></foreignObject></g><path style="fill:none" d="M 15.39 15.39 L 0.63 15.39 L 0.63 0.63 L 15.39 0.63 Z M 0.63 0.63"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.5 0.0 0.0 0.5 6.37 6.84)"><foreignObject style="--ltx-fo-width:0.7em;--ltx-fo-height:0.5em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.7" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="6.58"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.sf2.pic1.2" class="ltx_text" style="font-size:50%;">is</span></span></span></foreignObject></g><path style="fill:none" d="M 15.39 15.39 L 0.63 15.39 L 0.63 0.63 L 15.39 0.63 Z M 0.63 0.63"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.5 0.0 0.0 0.5 1.85 6.95)"><foreignObject style="--ltx-fo-width:2.62em;--ltx-fo-height:0.45em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.26" overflow="visible" transform="matrix(1 0 0 -1 0 4.26)" width="24.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.sf2.pic1.3" class="ltx_text" style="font-size:50%;">a text</span></span></span></foreignObject></g><path style="fill:none" d="M 17.47 15.39 L 0.63 15.39 L 0.63 0.63 L 17.47 0.63 Z M 0.63 0.63"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.5 0.0 0.0 0.5 0.63 7.15)"><foreignObject style="--ltx-fo-width:3.58em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.14em;font-size:6.81pt;" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 4.8)" width="33.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.sf2.pic1.4" class="ltx_text" style="font-size:50%;">example</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F3.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F3.3" class="ltx_text" style="font-size:90%;">Figure 3</span>: </span><span id="S3.F3.4" class="ltx_text" style="font-size:90%;">Constructing a tree graph for image and text inputs.</span></figcaption>
</figure>
<div id="S3.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="S3.SS2.SSS0.Px1.p1.1" class="ltx_p">We consider a BFS-traverse ordered sequence <math id="S3.SS2.SSS0.Px1.p1.m1" class="ltx_math_unparsed" alttext="u_{1:L}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub></mrow><annotation encoding="application/x-tex">u_{1:L}</annotation></semantics></math> as input and <math id="S3.SS2.SSS0.Px1.p1.m2" class="ltx_math_unparsed" alttext="x_{1:L}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x_{1:L}</annotation></semantics></math> as output, with <math id="S3.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th element <math id="S3.SS2.SSS0.Px1.p1.m4" class="ltx_Math" alttext="x_{k},u_{k}\in\mathbb{R}^{d_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>k</mi></msub><mo>,</mo><mrow><msub><mi>u</mi><mi>k</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>k</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">x_{k},u_{k}\in\mathbb{R}^{d_{k}}</annotation></semantics></math>. Hence, the first <math id="S3.SS2.SSS0.Px1.p1.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> to <math id="S3.SS2.SSS0.Px1.p1.m6" class="ltx_Math" alttext="l_{1}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mn>1</mn></msub><annotation encoding="application/x-tex">l_{1}</annotation></semantics></math> elements constitute the first level of the tree, the next <math id="S3.SS2.SSS0.Px1.p1.m7" class="ltx_Math" alttext="l_{1}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l_{1}+1</annotation></semantics></math> to <math id="S3.SS2.SSS0.Px1.p1.m8" class="ltx_Math" alttext="l_{1}+l_{2}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>+</mo><msub><mi>l</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l_{1}+l_{2}+1</annotation></semantics></math> the second level of the tree, and the last element with index <math id="S3.SS2.SSS0.Px1.p1.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is the root. We denote by <math id="S3.SS2.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> a permutation mapping a BFS index to the post-order depth-first search (DFS) traverse.</p>
</div>
<div id="S3.SS2.SSS0.Px1.p2" class="ltx_para">
<p id="S3.SS2.SSS0.Px1.p2.1" class="ltx_p">In this paper, we focus on text and image domains; hence we need to introduce a graph structure on top. A natural choice is a hierarchical structure. For the image domain, we consider a quad tree structure, where the first <math id="S3.SS2.SSS0.Px1.p2.m1" class="ltx_Math" alttext="l_{1}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mn>1</mn></msub><annotation encoding="application/x-tex">l_{1}</annotation></semantics></math> elements of the sequence correspond to the flattering of the z order (morton) of the image, and all the next levels are virtual nodes which cover sequentially larger segments of the image. For the text domain, <math id="S3.SS2.SSS0.Px1.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-nary tree-cover chunks of tokens. In Figure <a href="#S3.F3" title="Figure 3 ‣ Layer input and output ‣ 3.2 Myo Layer: Structure ‣ 3 The Myosotis (Myo) Layer ‣ Myosotis: structured computation for attention like layer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> we provide an illustration.</p>
</div>
<div id="S3.SS2.SSS0.Px1.p3" class="ltx_para">
<p id="S3.SS2.SSS0.Px1.p3.1" class="ltx_p">For classification tasks, there are two common strategies for information aggregation before MLP classification head. The first approach is to add a classification token at the end or in the middle of the sequence. In the Myo layer, the hidden state of the root node can serve as the state of the classification token naturally. Alternatively, one can average the hidden state over tokens. We propose to average the top <math id="S3.SS2.SSS0.Px1.p3.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> layers of BFS (counting from the root), which interpolate between both common strategies, where <math id="S3.SS2.SSS0.Px1.p3.m2" class="ltx_Math" alttext="k=1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k=1</annotation></semantics></math> corresponds to using only the hidden state of the root.</p>
</div>
</section>
<section id="S3.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Layer parameters</h4>

<div id="S3.SS2.SSS0.Px2.p1" class="ltx_para">
<p id="S3.SS2.SSS0.Px2.p1.2" class="ltx_p">With each vertex of the tree <math id="S3.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, we associate three matrices <math id="S3.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="(A_{v},B_{v},C_{v})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>v</mi></msub><mo>,</mo><msub><mi>B</mi><mi>v</mi></msub><mo>,</mo><msub><mi>C</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(A_{v},B_{v},C_{v})</annotation></semantics></math> as layer parameters. As the graph is a rooted tree, the association of <math id="S3.SS2.SSS0.Px2.p1.m3" class="ltx_Math" alttext="B_{v}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>v</mi></msub><annotation encoding="application/x-tex">B_{v}</annotation></semantics></math> and <math id="S3.SS2.SSS0.Px2.p1.m4" class="ltx_Math" alttext="C_{v}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>v</mi></msub><annotation encoding="application/x-tex">C_{v}</annotation></semantics></math> with the vertex <math id="S3.SS2.SSS0.Px2.p1.m5" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> is the same as the association with an edge <math id="S3.SS2.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\{v,\partial^{*}v\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>v</mi><mo rspace="0em">,</mo><mrow><msup><mo>∂</mo><mo>∗</mo></msup><mi>v</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{v,\partial^{*}v\}</annotation></semantics></math>. The matrices <math id="S3.SS2.SSS0.Px2.p1.m7" class="ltx_Math" alttext="B_{v}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>v</mi></msub><annotation encoding="application/x-tex">B_{v}</annotation></semantics></math>, <math id="S3.SS2.SSS0.Px2.p1.m8" class="ltx_Math" alttext="C_{v}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>v</mi></msub><annotation encoding="application/x-tex">C_{v}</annotation></semantics></math> are responsible for the interaction between the vertex <math id="S3.SS2.SSS0.Px2.p1.m9" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> with its parent <math id="S3.SS2.SSS0.Px2.p1.m10" class="ltx_Math" alttext="\partial^{*}v" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mo>∗</mo></msup><mi>v</mi></mrow><annotation encoding="application/x-tex">\partial^{*}v</annotation></semantics></math>, and the matrix <math id="S3.SS2.SSS0.Px2.p1.m11" class="ltx_Math" alttext="A_{v}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>v</mi></msub><annotation encoding="application/x-tex">A_{v}</annotation></semantics></math> defines a self-interaction block. Using <math id="S3.SS2.SSS0.Px2.p1.m12" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> ordering of labels, we construct a block matrix <math id="S3.SS2.SSS0.Px2.p1.m13" class="ltx_Math" alttext="T_{G}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>G</mi></msub><annotation encoding="application/x-tex">T_{G}</annotation></semantics></math>, where <math id="S3.SS2.SSS0.Px2.p1.m14" class="ltx_Math" alttext="A_{v}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>v</mi></msub><annotation encoding="application/x-tex">A_{v}</annotation></semantics></math> is a diagonal block at the index <math id="S3.SS2.SSS0.Px2.p1.m15" class="ltx_Math" alttext="(\pi(v),\pi(v))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\pi(v),\pi(v))</annotation></semantics></math> and off-diagonal blocks <math id="S3.SS2.SSS0.Px2.p1.m16" class="ltx_Math" alttext="B_{v}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>v</mi></msub><annotation encoding="application/x-tex">B_{v}</annotation></semantics></math> and <math id="S3.SS2.SSS0.Px2.p1.m17" class="ltx_Math" alttext="C_{v}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>v</mi></msub><annotation encoding="application/x-tex">C_{v}</annotation></semantics></math> are in the positions <math id="S3.SS2.SSS0.Px2.p1.m18" class="ltx_Math" alttext="(\pi(v),\pi(\partial^{*}v))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mo>∗</mo></msup><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\pi(v),\pi(\partial^{*}v))</annotation></semantics></math> and <math id="S3.SS2.SSS0.Px2.p1.m19" class="ltx_Math" alttext="(\pi(\partial^{*}v),\pi(v))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mo>∗</mo></msup><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\pi(\partial^{*}v),\pi(v))</annotation></semantics></math>. In Figure <a href="#S3.F2" title="Figure 2 ‣ 3 The Myosotis (Myo) Layer ‣ Myosotis: structured computation for attention like layer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, we provide an illustration of this process.
The output of the Myo layer is the solution to the linear equation (with depth first post-order traverse ordering <math id="S3.SS2.SSS0.Px2.p1.m20" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> of matrix rows):</p>
<table id="S3.E8" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E8X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E8X.m2" class="ltx_Math" alttext="\displaystyle" display="inline" intent=":literal"><semantics><mphantom></mphantom><annotation encoding="application/x-tex">\displaystyle</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E8X.m3" class="ltx_Math" alttext="\displaystyle T_{G}(\{A_{v},B_{v},C_{v}\}_{v=1}^{L})\underbrace{x_{\pi}}_{\text{Output of the layer}}=\underbrace{u_{\pi}}_{\text{Input to the layer}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>T</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>A</mi><mi>v</mi></msub><mo>,</mo><msub><mi>B</mi><mi>v</mi></msub><mo>,</mo><msub><mi>C</mi><mi>v</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>v</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><msub><mi>x</mi><mi>π</mi></msub><mo stretchy="true">⏟</mo></munder><mtext>Output of the layer</mtext></munder></mrow><mo>=</mo><munder><munder accentunder="true"><msub><mi>u</mi><mi>π</mi></msub><mo stretchy="true">⏟</mo></munder><mtext>Input to the layer</mtext></munder></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{G}(\{A_{v},B_{v},C_{v}\}_{v=1}^{L})\underbrace{x_{\pi}}_{\text{Output of the layer}}=\underbrace{u_{\pi}}_{\text{Input to the layer}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="S3.SS2.SSS0.Px2.p1.3" class="ltx_p">For the general left part <math id="S3.SS2.SSS0.Px2.p1.m21" class="ltx_Math" alttext="T_{G}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>G</mi></msub><annotation encoding="application/x-tex">T_{G}</annotation></semantics></math> a direct solver has complexity <math id="S3.SS2.SSS0.Px2.p1.m22" class="ltx_Math" alttext="O(L^{3})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(L^{3})</annotation></semantics></math>, while an iterative solver will require several iterations with complexity <math id="S3.SS2.SSS0.Px2.p1.m23" class="ltx_Math" alttext="O(L^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(L^{2})</annotation></semantics></math> per iteration. We will take advantage of the tree structure and provide linear (in a single processor) and parallelized solutions.</p>
</div>
</section>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Myo: Efficient Computation</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">Now we introduce an algorithm for solving Equation <a href="#S3.E8" title="In Layer parameters ‣ 3.2 Myo Layer: Structure ‣ 3 The Myosotis (Myo) Layer ‣ Myosotis: structured computation for attention like layer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> in <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="O(L)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(L)</annotation></semantics></math> memory and <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="O(\log_{k}L)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>log</mi><mi>k</mi></msub><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\log_{k}L)</annotation></semantics></math> time complexity, when <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-nary perfect tree.
To build up the approach, we start with a 1-level rooted tree. We label leafs with <math id="S3.SS3.p1.m5" class="ltx_Math" alttext="c\in\{1,\dots,k\}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c\in\{1,\dots,k\}</annotation></semantics></math> and the root <math id="S3.SS3.p1.m6" class="ltx_Math" alttext="[1;k]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1;k]</annotation></semantics></math>. We traverse from leaf to root (upward iteration) and backward (downward iteration), resembling Gaussian eliminations and substitutions steps. The upward iteration in block-matrix notation is the following:</p>
<table id="S3.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center">
<div id="S3.E9.2" class="ltx_inline-block ltx_markedasmath ltx_transformed_outer" style="width:258.8pt;height:33.5pt;vertical-align:-15.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-79.7pt,10.3pt) scale(0.618918079556192,0.618918079556192) ;">
<p id="S3.E9.2.1" class="ltx_p"><math id="S3.E9.m1.m1" class="ltx_Math" alttext="\left[\begin{array}[]{c c c c|c}A_{1}&amp;O&amp;O&amp;B_{1}&amp;u_{1}\\
\vdots&amp;\ddots&amp;\vdots&amp;\vdots&amp;\vdots\\
O&amp;O&amp;A_{k}&amp;B_{k}&amp;u_{k}\\
C_{1}&amp;\dots&amp;C_{k}&amp;A_{[1;k]}&amp;u_{[1;k]}\end{array}\right]\quad\Rightarrow\quad\left[\begin{array}[]{c c c c|c}I&amp;\dots&amp;O&amp;A_{1}^{-1}B_{1}&amp;A_{1}^{-1}u_{1}\\
\vdots&amp;\ddots&amp;\vdots&amp;\vdots&amp;\vdots\\
O&amp;\dots&amp;I&amp;A_{k}^{-1}B_{k}&amp;A_{k}^{-1}u_{k}\\
O&amp;\dots&amp;O&amp;A_{[1;k]}-\sum_{c=1}^{k}C_{c}A_{c}^{-1}B_{c}&amp;u_{[1;k]}-\sum_{c=1}^{k}C_{c}A_{c}^{-1}u_{c}\\
\end{array}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><msub><mi>A</mi><mn>1</mn></msub></mtd><mtd><mi>O</mi></mtd><mtd><mi>O</mi></mtd><mtd class="ltx_border_r"><msub><mi>B</mi><mn>1</mn></msub></mtd><mtd><msub><mi>u</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd class="ltx_border_r"><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><mi>O</mi></mtd><mtd><mi>O</mi></mtd><mtd><msub><mi>A</mi><mi>k</mi></msub></mtd><mtd class="ltx_border_r"><msub><mi>B</mi><mi>k</mi></msub></mtd><mtd><msub><mi>u</mi><mi>k</mi></msub></mtd></mtr><mtr><mtd><msub><mi>C</mi><mn>1</mn></msub></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><msub><mi>C</mi><mi>k</mi></msub></mtd><mtd class="ltx_border_r"><msub><mi>A</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub></mtd><mtd><msub><mi>u</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub></mtd></mtr></mtable><mo>]</mo></mrow><mspace style="width:1em;" width="1em"></mspace><mo stretchy="false">⇒</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mi>I</mi></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mi>O</mi></mtd><mtd class="ltx_border_r"><mrow><msubsup><mi>A</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mn>1</mn></msub></mrow></mtd><mtd><mrow><msubsup><mi>A</mi><mn>1</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>1</mn></msub></mrow></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd class="ltx_border_r"><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><mi>O</mi></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mi>I</mi></mtd><mtd class="ltx_border_r"><mrow><msubsup><mi>A</mi><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>k</mi></msub></mrow></mtd><mtd><mrow><msubsup><mi>A</mi><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>k</mi></msub></mrow></mtd></mtr><mtr><mtd><mi>O</mi></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mi>O</mi></mtd><mtd class="ltx_border_r"><mrow><msub><mi>A</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><mrow><msub><mi>C</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>c</mi></msub></mrow></mrow></mrow></mtd><mtd><mrow><msub><mi>u</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><mrow><msub><mi>C</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>c</mi></msub></mrow></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\left[\begin{array}[]{c c c c|c}A_{1}&amp;O&amp;O&amp;B_{1}&amp;u_{1}\\
\vdots&amp;\ddots&amp;\vdots&amp;\vdots&amp;\vdots\\
O&amp;O&amp;A_{k}&amp;B_{k}&amp;u_{k}\\
C_{1}&amp;\dots&amp;C_{k}&amp;A_{[1;k]}&amp;u_{[1;k]}\end{array}\right]\quad\Rightarrow\quad\left[\begin{array}[]{c c c c|c}I&amp;\dots&amp;O&amp;A_{1}^{-1}B_{1}&amp;A_{1}^{-1}u_{1}\\
\vdots&amp;\ddots&amp;\vdots&amp;\vdots&amp;\vdots\\
O&amp;\dots&amp;I&amp;A_{k}^{-1}B_{k}&amp;A_{k}^{-1}u_{k}\\
O&amp;\dots&amp;O&amp;A_{[1;k]}-\sum_{c=1}^{k}C_{c}A_{c}^{-1}B_{c}&amp;u_{[1;k]}-\sum_{c=1}^{k}C_{c}A_{c}^{-1}u_{c}\\
\end{array}\right]</annotation></semantics></math></p>
</span></div></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="S3.SS3.p1.2" class="ltx_p">We denote results in an upward iteration by putting a hat on a symbol: <math id="S3.SS3.p1.m7" class="ltx_Math" alttext="\hat{B}_{v}=A_{v}^{-1}B_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><msubsup><mi>A</mi><mi>v</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>v</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{B}_{v}=A_{v}^{-1}B_{v}</annotation></semantics></math>, <math id="S3.SS3.p1.m8" class="ltx_Math" alttext="\hat{u}_{v}=A_{v}^{-1}u_{v},~\hat{A}_{v}=A_{v}-\sum_{c\in\partial v}C_{c}\hat{B}_{c}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><msubsup><mi>A</mi><mi>v</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>v</mi></msub></mrow></mrow><mo rspace="0.497em">,</mo><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>v</mi></msub><mo>=</mo><mrow><msub><mi>A</mi><mi>v</mi></msub><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><mi>c</mi><mo rspace="0.111em">∈</mo><mrow><mo>∂</mo><mi>v</mi></mrow></mrow></msub><mrow><msub><mi>C</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>B</mi><mo>^</mo></mover><mi>c</mi></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{u}_{v}=A_{v}^{-1}u_{v},~\hat{A}_{v}=A_{v}-\sum_{c\in\partial v}C_{c}\hat{B}_{c}</annotation></semantics></math>.
We get the solution <math id="S3.SS3.p1.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> by the substitution from root to each leaf <math id="S3.SS3.p1.m10" class="ltx_Math" alttext="c\in\{1,\dots,k\}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c\in\{1,\dots,k\}</annotation></semantics></math> (backward iteration):</p>
<table id="S3.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center">
<div id="S3.E10.2" class="ltx_inline-block ltx_markedasmath ltx_transformed_outer" style="width:327.8pt;height:21.6pt;vertical-align:-8.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-11.8pt,0.8pt) scale(0.932611458231299,0.932611458231299) ;">
<p id="S3.E10.2.1" class="ltx_p"><math id="S3.E10.m1.m1" class="ltx_Math" alttext="\begin{aligned} &amp;\hat{A}_{[1;k]}=A_{[1;k]}-\sum_{c=1}^{k}C_{c}A_{c}^{-1}B_{c},&amp;x_{[1;k]}=\hat{A}_{[1;k]}^{-1}\!\left(u_{[1;k]}-\sum_{c=1}^{k}C_{c}A_{c}^{-1}u_{c}\right),&amp;x_{c}=A_{c}^{-1}u_{c}-(A^{-1}_{c}B_{c})x_{[1;k]}.\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub><mo>=</mo><mrow><msub><mi>A</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><mrow><msub><mi>C</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>c</mi></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mi>x</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub><mo>=</mo><mrow><msubsup><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>u</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><mrow><msub><mi>C</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>c</mi></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>x</mi><mi>c</mi></msub><mo>=</mo><mrow><mrow><msubsup><mi>A</mi><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>c</mi></msub></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>A</mi><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>c</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>;</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned} &amp;\hat{A}_{[1;k]}=A_{[1;k]}-\sum_{c=1}^{k}C_{c}A_{c}^{-1}B_{c},&amp;x_{[1;k]}=\hat{A}_{[1;k]}^{-1}\!\left(u_{[1;k]}-\sum_{c=1}^{k}C_{c}A_{c}^{-1}u_{c}\right),&amp;x_{c}=A_{c}^{-1}u_{c}-(A^{-1}_{c}B_{c})x_{[1;k]}.\end{aligned}</annotation></semantics></math></p>
</span></div></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="S3.SS3.p1.3" class="ltx_p">From this example, we can see a general recursive algorithm. As in a rooted tree the path between any node and the root is unique, the recursion is well defined. Hence, we have an upward and backward traverse, illustrated in Figure <a href="#S3.F4" title="Figure 4 ‣ 3.3 Myo: Efficient Computation ‣ 3 The Myosotis (Myo) Layer ‣ Myosotis: structured computation for attention like layer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<figure id="S3.F4" class="ltx_figure ltx_align_floatright" style="width:30%;">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
