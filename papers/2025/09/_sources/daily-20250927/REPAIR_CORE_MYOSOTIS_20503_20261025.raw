0" stroke="#E60000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(0.9681 0.2506 -0.2506 0.9681 255.81 74.47)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-width="0.4pt"><path style="fill:none" d="M 279.01 74.63 C 282.27 73.44 284.66 73.44 287.33 74.42"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(0.9397 0.34203 -0.34203 0.9397 287.33 74.42)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-width="0.4pt"><path style="fill:none" d="M 310.5 74.63 C 313.77 73.44 316.15 73.44 318.82 74.42"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(0.9397 0.34203 -0.34203 0.9397 318.82 74.42)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-width="0.4pt"><path style="fill:none" d="M 333.95 87.64 C 335.78 92.66 335.78 96.32 334.17 100.74"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(-0.34203 0.9397 -0.9397 -0.34203 334.17 100.74)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-width="0.4pt"><path style="fill:none" d="M 319.42 114.34 C 316.15 115.53 313.77 115.53 311.1 114.56"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(-0.9397 -0.34203 0.34203 -0.9397 311.1 114.56)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-width="0.4pt"><path style="fill:none" d="M 287.93 114.34 C 284.66 115.53 282.27 115.53 279.6 114.56"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(-0.9397 -0.34203 0.34203 -0.9397 279.6 114.56)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-width="0.4pt"><path style="fill:none" d="M 256.43 114.34 C 253.16 115.53 250.78 115.53 248.11 114.56"></path></g><g style="--ltx-stroke-color:#E60000;--ltx-fill-color:#E60000;--ltx-fg-color:#E60000;" color="#E60000" fill="#E60000" stroke="#E60000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(-0.9397 -0.34203 0.34203 -0.9397 248.11 114.56)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 243.09 138.75)"><foreignObject style="--ltx-fo-width:5.51em;--ltx-fo-height:0.59em;--ltx-fo-depth:0em;font-size:10.65pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="81.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F6.pic1.34" class="ltx_text ltx_font_bold" style="font-size:90%;">Snake Order</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A1.F6.3" class="ltx_text" style="font-size:90%;">Figure 6</span>: </span><span id="A1.F6.4" class="ltx_text" style="font-size:90%;">Example of flattening a <math id="A1.F6.m2" class="ltx_Math" alttext="4\times 4" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">4\times 4</annotation></semantics></math> grid: Morton (Z-order) and Snake ordering.</span></figcaption>
</figure>
<div id="A1.SS4.p2" class="ltx_para">
<p id="A1.SS4.p2.1" class="ltx_p"><span id="A1.SS4.p2.1.1" class="ltx_text ltx_font_typewriter">Long Range Arena</span> (LRA) <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib22" title="" class="ltx_ref">22</a>]</cite> datasets:</p>
<ul id="A1.I2" class="ltx_itemize">
<li id="A1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i1.p1" class="ltx_para">
<p id="A1.I2.i1.p1.1" class="ltx_p"><span id="A1.I2.i1.p1.1.1" class="ltx_text ltx_font_typewriter">Pathfinder</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite>: a binary classification task. A <math id="A1.I2.i1.p1.m1" class="ltx_Math" alttext="32\times 32" display="inline" intent=":literal"><semantics><mrow><mn>32</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">32\times 32</annotation></semantics></math> grayscale image image shows a start and an end point as a small circle. There are a number of dashed lines in the image. The task is to classify whether there is a dashed line (or path) joining the start and end point. Sequences are all of the same length (<math id="A1.I2.i1.p1.m2" class="ltx_Math" alttext="1,024" display="inline" intent=":literal"><semantics><mn>1,024</mn><annotation encoding="application/x-tex">1,024</annotation></semantics></math>). There are <math id="A1.I2.i1.p1.m3" class="ltx_Math" alttext="160^{\prime}000" display="inline" intent=":literal"><semantics><mrow><msup><mn>160</mn><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mn>000</mn></mrow><annotation encoding="application/x-tex">160^{\prime}000</annotation></semantics></math> training examples, <math id="A1.I2.i1.p1.m4" class="ltx_Math" alttext="20^{\prime}000" display="inline" intent=":literal"><semantics><mrow><msup><mn>20</mn><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mn>000</mn></mrow><annotation encoding="application/x-tex">20^{\prime}000</annotation></semantics></math> validation examples, and <math id="A1.I2.i1.p1.m5" class="ltx_Math" alttext="20^{\prime}000" display="inline" intent=":literal"><semantics><mrow><msup><mn>20</mn><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mn>000</mn></mrow><annotation encoding="application/x-tex">20^{\prime}000</annotation></semantics></math> test examples.</p>
</div></li>
<li id="A1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i2.p1" class="ltx_para">
<p id="A1.I2.i2.p1.1" class="ltx_p"><span id="A1.I2.i2.p1.1.1" class="ltx_text ltx_font_typewriter">Path-X</span>: Identical to the <span id="A1.I2.i2.p1.1.2" class="ltx_text ltx_font_typewriter">Pathfinder</span> challenge, with the images are <math id="A1.I2.i2.p1.m1" class="ltx_Math" alttext="128\times 128" display="inline" intent=":literal"><semantics><mrow><mn>128</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>128</mn></mrow><annotation encoding="application/x-tex">128\times 128</annotation></semantics></math> pixels.</p>
</div></li>
<li id="A1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i3.p1" class="ltx_para">
<p id="A1.I2.i3.p1.1" class="ltx_p"><span id="A1.I2.i3.p1.1.1" class="ltx_text ltx_font_typewriter">ListOps</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">24</a>]</cite>: 10-way(0-90) digits classification task, representing the integer result of the expression.
Given a nested set of mathematical operations (such as <span id="A1.I2.i3.p1.1.2" class="ltx_text ltx_font_typewriter">min</span> and <span id="A1.I2.i3.p1.1.3" class="ltx_text ltx_font_typewriter">max</span>) and integer operands in
<math id="A1.I2.i3.p1.m1" class="ltx_Math" alttext="\{0,\dots 9\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mn>9</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0,\dots 9\}</annotation></semantics></math>, compute the integer result of the mathematical expression. Characters are encoded as one-hot vectors, with <math id="A1.I2.i3.p1.m2" class="ltx_Math" alttext="17" display="inline" intent=":literal"><semantics><mn>17</mn><annotation encoding="application/x-tex">17</annotation></semantics></math> unique values possible (opening brackets and operators are grouped into a single token). The sequences are padded to a maximum length of <math id="A1.I2.i3.p1.m3" class="ltx_Math" alttext="2,000" display="inline" intent=":literal"><semantics><mn>2,000</mn><annotation encoding="application/x-tex">2,000</annotation></semantics></math> with a fixed indicator value. There are <math id="A1.I2.i3.p1.m4" class="ltx_Math" alttext="96^{\prime}000" display="inline" intent=":literal"><semantics><mrow><msup><mn>96</mn><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mn>000</mn></mrow><annotation encoding="application/x-tex">96^{\prime}000</annotation></semantics></math> training sequences, <math id="A1.I2.i3.p1.m5" class="ltx_Math" alttext="2,000" display="inline" intent=":literal"><semantics><mn>2,000</mn><annotation encoding="application/x-tex">2,000</annotation></semantics></math> validation sequences, and <math id="A1.I2.i3.p1.m6" class="ltx_Math" alttext="2000" display="inline" intent=":literal"><semantics><mn>2000</mn><annotation encoding="application/x-tex">2000</annotation></semantics></math> test sequences.</p>
</div></li>
</ul>
</div>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>Full table</h3>

<figure id="A1.T4" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="A1.T4.3" class="ltx_text" style="font-size:90%;">Table 4</span>: </span><span id="A1.T4.4" class="ltx_text" style="font-size:90%;">Test accuracy on image classification. We used the table from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite> and add our results.</span></figcaption>
<p id="A1.T4.5" class="ltx_p ltx_align_center"><span id="A1.T4.5.1" class="ltx_text ltx_inline-block" style="width:345.0pt;">
