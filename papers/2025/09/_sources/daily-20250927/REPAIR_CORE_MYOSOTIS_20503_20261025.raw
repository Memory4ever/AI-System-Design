</span></span></span></foreignObject></g><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.85 0.0 0.0 0.85 -101.44 -188.67)"><foreignObject style="--ltx-fo-width:17.25em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="238.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<div id="S3.F2.pic1.6" class="ltx_block ltx_parbox ltx_align_middle" style="width:17.25em;">
