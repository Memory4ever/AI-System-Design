 -80.65 -29.35 -88.58 0 -88.58 C 29.35 -88.58 53.15 -80.65 53.15 -70.87 Z M 0 -70.87"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.9 0.0 0.0 0.9 10.24 -82.84)"><foreignObject style="--ltx-fo-width:1.2em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="16.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F4.pic1.m7" class="ltx_Math" alttext="\partial p" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\partial p</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
