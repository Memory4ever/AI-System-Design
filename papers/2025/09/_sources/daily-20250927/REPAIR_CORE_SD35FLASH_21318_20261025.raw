<span id="S5.T2.6.1.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T2.6.1.4.2.1.1.1.1" class="ltx_text ltx_font_bold">Peak VRAM</span></span></span>
