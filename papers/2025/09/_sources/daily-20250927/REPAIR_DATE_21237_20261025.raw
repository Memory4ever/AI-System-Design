{"data":{"id":"10.48550/arxiv.2509.21237","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.21237","prefix":"10.48550","suffix":"arxiv.2509.21237","identifiers":[{"identifier":"2509.21237","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.21237"}],"creators":[{"name":"Wu, Yaxiong","nameType":"Personal","givenName":"Yaxiong","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Bo, Jianyuan","nameType":"Personal","givenName":"Jianyuan","familyName":"Bo","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yongyue","nameType":"Personal","givenName":"Yongyue","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Liang, Sheng","nameType":"Personal","givenName":"Sheng","familyName":"Liang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Yong","nameType":"Personal","givenName":"Yong","familyName":"Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Query-Centric Graph Retrieval Augmented Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Information Retrieval (cs.IR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"I.2.7; H.3.3","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-25T14:35:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-26T00:54:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Graph-based retrieval-augmented generation (RAG) enriches large language models (LLMs) with external knowledge for long-context understanding and multi-hop reasoning, but existing methods face a granularity dilemma: fine-grained entity-level graphs incur high token costs and lose context, while coarse document-level graphs fail to capture nuanced relations. We introduce QCG-RAG, a query-centric graph RAG framework that enables query-granular indexing and multi-hop chunk retrieval. Our query-centric approach leverages Doc2Query and Doc2Query{-}{-} to construct query-centric graphs with controllable granularity, improving graph quality and interpretability. A tailored multi-hop retrieval mechanism then selects relevant chunks via the generated queries. Experiments on LiHuaWorld and MultiHop-RAG show that QCG-RAG consistently outperforms prior chunk-based and graph-based RAG methods in question answering accuracy, establishing a new paradigm for multi-hop reasoning.","descriptionType":"Abstract"},{"description":"25 pages, 6 figures, 1 table","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.21237","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-26T01:55:46.000Z","registered":"2025-09-26T01:55:47.000Z","published":"2025","updated":"2025-09-26T01:55:47.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.21237","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}