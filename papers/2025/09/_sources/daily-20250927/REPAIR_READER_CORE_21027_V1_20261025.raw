<td id="S4.T2.4.5.7" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T2.4.5.7.1" class="ltx_text ltx_font_bold">67%</span></td></tr>
<tr id="S4.T2.4.6" class="ltx_tr">
<th id="S4.T2.4.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r">LIBERO-spatial</th>
<td id="S4.T2.4.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.4.6.2.1" class="ltx_text ltx_font_bold">21.40</span></td>
<td id="S4.T2.4.6.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.4.6.3.1" class="ltx_text ltx_font_bold">0.8694</span></td>
<td id="S4.T2.4.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T2.4.6.4.1" class="ltx_text ltx_font_bold">33%</span></td>
<td id="S4.T2.4.6.5" class="ltx_td ltx_align_center ltx_border_bb">19.95</td>
<td id="S4.T2.4.6.6" class="ltx_td ltx_align_center ltx_border_bb">0.8579</td>
