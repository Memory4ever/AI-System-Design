<td id="S4.T2.4.4.3" class="ltx_td ltx_align_center"><span id="S4.T2.4.4.3.1" class="ltx_text ltx_font_bold">0.8838</span></td>
<td id="S4.T2.4.4.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.4.4.4.1" class="ltx_text ltx_font_bold">90%</span></td>
<td id="S4.T2.4.4.5" class="ltx_td ltx_align_center">20.69</td>
