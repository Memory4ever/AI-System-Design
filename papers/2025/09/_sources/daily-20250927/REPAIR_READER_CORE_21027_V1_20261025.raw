<td id="S4.T3.4.5.6" class="ltx_td ltx_align_center"><span id="S4.T3.4.5.6.1" class="ltx_text ltx_font_bold">0.8844</span></td>
<td id="S4.T3.4.5.7" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T3.4.5.7.1" class="ltx_text ltx_font_bold">70%</span></td></tr>
