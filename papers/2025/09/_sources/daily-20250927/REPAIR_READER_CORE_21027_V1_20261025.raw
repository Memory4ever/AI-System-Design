<td id="A5.T6.2.5.2" class="ltx_td ltx_align_center">5.88</td>
<td id="A5.T6.2.5.3" class="ltx_td ltx_align_center">3.57</td>
<td id="A5.T6.2.5.4" class="ltx_td ltx_nopad_r ltx_align_center">2.13</td></tr>
