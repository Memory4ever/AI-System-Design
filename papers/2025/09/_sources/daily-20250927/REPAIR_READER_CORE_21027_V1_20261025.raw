<td id="S4.T3.4.6.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T3.4.6.3.1" class="ltx_text ltx_font_bold">0.8694</span></td>
<td id="S4.T3.4.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T3.4.6.4.1" class="ltx_text ltx_font_bold">33%</span></td>
<td id="S4.T3.4.6.5" class="ltx_td ltx_align_center ltx_border_bb">21.32</td>
