              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
            <span id="alg1.l22.3" class="ltx_text" style="font-size:80%;">    </span><span id="alg1.l22.4" class="ltx_text ltx_font_bold" style="font-size:80%;">if</span><span id="alg1.l22.5" class="ltx_text" style="font-size:80%;"> </span><math id="alg1.l22.m1" class="ltx_Math" alttext="scaled\_down" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">w</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi></mrow><annotation encoding="application/x-tex">scaled\_down</annotation></semantics></math><span id="alg1.l22.6" class="ltx_text" style="font-size:80%;"> </span><span id="alg1.l22.7" class="ltx_text ltx_font_bold" style="font-size:80%;">then</span><span id="alg1.l22.8" class="ltx_text" style="font-size:80%;">
</span>
</div>
