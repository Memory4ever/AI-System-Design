<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">TABLE VI: </span>Weight offloading impact on compute and memory efficiency. </figcaption>
<div id="S5.T6.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:327.8pt;height:112pt;vertical-align:-53.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-16.4pt,5.6pt) scale(0.909201830581321,0.909201830581321) ;">
<table id="S5.T6.1.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T6.1.1.1" class="ltx_tr">
<td id="S5.T6.1.1.1.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="2" rowspan="2"><span id="S5.T6.1.1.1.1.1" class="ltx_text">Model</span></td>
<td id="S5.T6.1.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" rowspan="2"><span id="S5.T6.1.1.1.2.1" class="ltx_text">Raw</span></td>
<td id="S5.T6.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="4">Vision Encode w/ Layer Offload</td></tr>
<tr id="S5.T6.1.1.2" class="ltx_tr">
<td id="S5.T6.1.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">K=2</td>
<td id="S5.T6.1.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">K=3</td>
<td id="S5.T6.1.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">K=4</td>
<td id="S5.T6.1.1.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">K=5</td></tr>
