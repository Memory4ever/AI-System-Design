<td id="S2.T3.1.1.5.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t">Decode</td>
<td id="S2.T3.1.1.5.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t">26.0 / 86.4</td>
<td id="S2.T3.1.1.5.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t">26.6 / 88.2</td>
