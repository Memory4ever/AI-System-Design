{"data":{"id":"10.48550/arxiv.2509.21301","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.21301","prefix":"10.48550","suffix":"arxiv.2509.21301","identifiers":[{"identifier":"2509.21301","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.21301"}],"creators":[{"name":"Xu, Yuhang","nameType":"Personal","givenName":"Yuhang","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Shengzhong","nameType":"Personal","givenName":"Shengzhong","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Dong","nameType":"Personal","givenName":"Dong","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Yan, Bingheng","nameType":"Personal","givenName":"Bingheng","familyName":"Yan","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Fan","nameType":"Personal","givenName":"Fan","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Guihai","nameType":"Personal","givenName":"Guihai","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Nova: Real-Time Agentic Vision-Language Model Serving with Adaptive Cross-Stage Parallelization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Operating Systems (cs.OS)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-25T15:17:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-26T00:57:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"This paper presents Nova, a real-time scheduling framework for serving agentic vision-language models (VLMs) on a single GPU with balanced per-request latency and overall request process throughput. Our design begins by enabling effective pipelining across vision encode, LLM prefill, and LLM decode stages of VLMs, by exploiting their heterogeneous resource demands during execution and incorporating elastic GPU spatial partitioning among stages to maximally utilize the compute and memory resources. Building on this, we introduce a real-time scheduling algorithm that adaptively calibrates resource allocation among stages based on a Pareto-optimal analysis of the latency-throughput trade-off, allowing the system to sustain responsiveness and resource efficiency under dynamic request loads. To further alleviate GPU memory pressure, we design a lightweight weight offloading strategy for vision encoders that preserves inference efficiency with minimized memory overhead. Extensive evaluations on both synthetic and real-world agent workloads demonstrate that Nova consistently outperforms the state-of-the-art baselines, improving the maximum latency by up to 23.3%, while keeping competitive throughput.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.21301","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-26T01:57:19.000Z","registered":"2025-09-26T01:57:20.000Z","published":"2025","updated":"2025-09-26T01:57:20.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.21301","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}