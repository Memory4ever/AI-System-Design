<td id="A5.T2.2.1.4.1" class="ltx_td ltx_align_left ltx_border_t" colspan="4"><span id="A5.T2.2.1.4.1.1" class="ltx_text ltx_font_italic">Mathematical Reasoning</span></td></tr>
<tr id="A5.T2.2.1.5" class="ltx_tr">
<td id="A5.T2.2.1.5.1" class="ltx_td ltx_align_left">GSM8K <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Cobbe et al., 2021</a>)</cite></td>
<td id="A5.T2.2.1.5.2" class="ltx_td ltx_align_left">exact_match, flexible-extract</td>
