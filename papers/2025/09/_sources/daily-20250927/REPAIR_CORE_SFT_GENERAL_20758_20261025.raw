<th id="A3.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T1.2.1.2.1" class="ltx_text ltx_font_bold">Exact</span></th>
<th id="A3.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T1.2.1.3.1" class="ltx_text ltx_font_bold">Substitute</span></th>
<th id="A3.T1.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T1.2.1.4.1" class="ltx_text ltx_font_bold">Irrelevant</span></th>
