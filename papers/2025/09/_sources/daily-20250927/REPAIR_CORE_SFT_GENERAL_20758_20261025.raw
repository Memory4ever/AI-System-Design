<tr id="A5.T2.2.1.7" class="ltx_tr">
<td id="A5.T2.2.1.7.1" class="ltx_td ltx_align_left">HumanEval <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib5" title="" class="ltx_ref">Chen et al., 2021</a>)</cite></td>
<td id="A5.T2.2.1.7.2" class="ltx_td ltx_align_left">pass@1, create_test</td>
<td id="A5.T2.2.1.7.3" class="ltx_td ltx_align_left">0-shot</td>
<td id="A5.T2.2.1.7.4" class="ltx_td ltx_align_left">Code generation</td></tr>
<tr id="A5.T2.2.1.8" class="ltx_tr">
<td id="A5.T2.2.1.8.1" class="ltx_td ltx_align_left ltx_border_t" colspan="4"><span id="A5.T2.2.1.8.1.1" class="ltx_text ltx_font_italic">Commonsense Reasoning</span></td></tr>
<tr id="A5.T2.2.1.9" class="ltx_tr">
<td id="A5.T2.2.1.9.1" class="ltx_td ltx_align_left">HellaSwag <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib61" title="" class="ltx_ref">Zellers et al., 2019</a>)</cite></td>
<td id="A5.T2.2.1.9.2" class="ltx_td ltx_align_left">acc, none</td>
<td id="A5.T2.2.1.9.3" class="ltx_td ltx_align_left">0-shot</td>
<td id="A5.T2.2.1.9.4" class="ltx_td ltx_align_left">Commonsense reasoning</td></tr>
<tr id="A5.T2.2.1.10" class="ltx_tr">
<td id="A5.T2.2.1.10.1" class="ltx_td ltx_align_left">ARC-Easy <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Clark et al., 2018</a>)</cite></td>
<td id="A5.T2.2.1.10.2" class="ltx_td ltx_align_left">acc, none</td>
<td id="A5.T2.2.1.10.3" class="ltx_td ltx_align_left">0-shot</td>
<td id="A5.T2.2.1.10.4" class="ltx_td ltx_align_left">Science reasoning</td></tr>
<tr id="A5.T2.2.1.11" class="ltx_tr">
<td id="A5.T2.2.1.11.1" class="ltx_td ltx_align_left">ARC-Challenge <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Clark et al., 2018</a>)</cite></td>
<td id="A5.T2.2.1.11.2" class="ltx_td ltx_align_left">acc, none</td>
<td id="A5.T2.2.1.11.3" class="ltx_td ltx_align_left">0-shot</td>
<td id="A5.T2.2.1.11.4" class="ltx_td ltx_align_left">Science reasoning</td></tr>
<tr id="A5.T2.2.1.12" class="ltx_tr">
<td id="A5.T2.2.1.12.1" class="ltx_td ltx_align_left">PIQA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib3" title="" class="ltx_ref">Bisk et al., 2020</a>)</cite></td>
<td id="A5.T2.2.1.12.2" class="ltx_td ltx_align_left">acc, none</td>
<td id="A5.T2.2.1.12.3" class="ltx_td ltx_align_left">0-shot</td>
<td id="A5.T2.2.1.12.4" class="ltx_td ltx_align_left">Physical commonsense reasoning</td></tr>
<tr id="A5.T2.2.1.13" class="ltx_tr">
<td id="A5.T2.2.1.13.1" class="ltx_td ltx_align_left ltx_border_t" colspan="4"><span id="A5.T2.2.1.13.1.1" class="ltx_text ltx_font_italic">Knowledge-Intensive QA</span></td></tr>
<tr id="A5.T2.2.1.14" class="ltx_tr">
