</div>
<div id="algorithm1.4.30" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Update <math id="algorithm1.m36" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> trees <math id="algorithm1.m37" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> with <math id="algorithm1.m38" class="ltx_Math" alttext="\mathcal{H}_{\text{expansion}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mtext>expansion</mtext></msub><annotation encoding="application/x-tex">\mathcal{H}_{\text{expansion}}</annotation></semantics></math>;
</div>
<div id="algorithm1.4.31" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.31.1" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.31.2" class="ltx_emph ltx_font_italic">Updating <math id="algorithm1.m39" class="ltx_Math" alttext="\text{iter}=1" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">iter</mtext><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\text{iter}=1</annotation></semantics></math>, …</em> <span id="algorithm1.4.31.3" class="ltx_text ltx_font_bold">do</span>
</div>
