</div>
<div id="algorithm1.4.26" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> Randomly sample <math id="algorithm1.m32" class="ltx_Math" alttext="M\times N" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">M\times N</annotation></semantics></math> expansion node from existing trees <math id="algorithm1.m33" class="ltx_Math" alttext="P_{\text{sample}}=\{p_{1},p_{2},...,p_{M\times N}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mtext>sample</mtext></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><msub><mi>p</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\text{sample}}=\{p_{1},p_{2},...,p_{M\times N}\}</annotation></semantics></math>;
</div>
<div id="algorithm1.4.27" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.27.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.27.2" class="ltx_text ltx_font_typewriter">Step <a href="#S3.I1.i3" title="item 3 ‣ 3.1 Tree Search for Agent Rollout ‣ 3 Tree-based Group Relative Policy Optimization (Tree-GRPO) ‣ Tree Search for LLM Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>: Do expansion </span>
</div>
