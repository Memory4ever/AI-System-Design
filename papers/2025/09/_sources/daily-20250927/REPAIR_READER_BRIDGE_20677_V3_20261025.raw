{geometric allocation; <math id="alg1.l3.m2" class="ltx_Math" alttext="\sum_{j\geq 0}\xi_{j}\leq\xi/2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow></msub><msub><mi>ξ</mi><mi>j</mi></msub></mrow><mo>≤</mo><mrow><mi>ξ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\sum_{j\geq 0}\xi_{j}\leq\xi/2</annotation></semantics></math>}

