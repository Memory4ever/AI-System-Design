<td id="S3.T1.20.1.17.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.25pt 2.0pt;"><span id="S3.T1.20.1.17.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EBF5F5;">HotpotQA</span></td>
