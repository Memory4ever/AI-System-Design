<td id="A12.T11.3.1.5" class="ltx_td ltx_align_center ltx_border_tt"><math id="A12.T11.m4" class="ltx_Math" alttext="K_{\mathrm{proxy}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">K</mi><mi mathsize="0.900em">proxy</mi></msub><annotation encoding="application/x-tex">K_{\mathrm{proxy}}</annotation></semantics></math></td>
