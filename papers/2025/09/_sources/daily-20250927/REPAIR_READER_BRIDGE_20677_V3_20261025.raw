<span id="A6.T4.5.3.2.1.1" class="ltx_p">Context-dependent features
<math id="A6.T4.m7" class="ltx_Math" alttext="\phi_{t}(x)=\phi(x)+\Delta_{t}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϕ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{t}(x)=\phi(x)+\Delta_{t}(x)</annotation></semantics></math>, with <math id="A6.T4.m8" class="ltx_Math" alttext="\|\Delta_{t}(x)\|\leq\varepsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\|\Delta_{t}(x)\|\leq\varepsilon</annotation></semantics></math></span>
</span></td>
