             <math id="alg1.l20.m1" class="ltx_Math" alttext="K\leftarrow C^{\prime}\,\widehat{\|\Sigma\|}^{2}\,\widehat{r}_{\mathrm{eff}}\log(4/\xi)\,/\,\widehat{\Delta}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo stretchy="false">←</mo><mrow><mrow><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">‖</mo></mrow><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>eff</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo>/</mo><mi>ξ</mi></mrow><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.392em">/</mo><msup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">K\leftarrow C^{\prime}\,\widehat{\|\Sigma\|}^{2}\,\widehat{r}_{\mathrm{eff}}\log(4/\xi)\,/\,\widehat{\Delta}^{2}</annotation></semantics></math>

