<td id="A12.T11.3.1.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="A12.T11.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math></td>
<td id="A12.T11.3.1.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="A12.T11.m2" class="ltx_Math" alttext="K^{\star}_{\tau,0.10}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">K</mi><mrow><mi mathsize="0.900em">τ</mi><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">0.10</mn></mrow><mo mathsize="0.900em">⋆</mo></msubsup><annotation encoding="application/x-tex">K^{\star}_{\tau,0.10}</annotation></semantics></math><span id="A12.T11.3.1.3.1" class="ltx_text" style="font-size:90%;"> (direct)</span></td>
