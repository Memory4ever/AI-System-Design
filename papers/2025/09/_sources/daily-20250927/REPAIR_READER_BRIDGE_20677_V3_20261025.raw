<td id="A7.T8.5.3.3" class="ltx_td ltx_align_center">38 <math id="A7.T8.m15" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 4</td>
