<span id="A6.T4.5.2.2.1" class="ltx_inline-block ltx_align_top" style="width:148.0pt;">
<span id="A6.T4.5.2.2.1.1" class="ltx_p">Fixed sub-Gaussian features with second-moment matrix <math id="A6.T4.m5" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math></span>
</span></td>
<td id="A6.T4.5.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A6.T4.5.2.3.1" class="ltx_inline-block ltx_align_top" style="width:184.9pt;">
<span id="A6.T4.5.2.3.1.1" class="ltx_p"><math id="A6.T4.m6" class="ltx_Math" alttext="K\;\geq\;K_{\mathrm{nominal}}=O\!\left(\tfrac{\sigma^{2}\|\Sigma\|}{(\lambda_{\min}(\Sigma)-\delta)^{2}}\log\!\tfrac{d}{\xi}\right)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0.558em" rspace="0.558em">≥</mo><msub><mi>K</mi><mi>nominal</mi></msub><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">‖</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>λ</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mfrac><mi>d</mi><mi>ξ</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K\;\geq\;K_{\mathrm{nominal}}=O\!\left(\tfrac{\sigma^{2}\|\Sigma\|}{(\lambda_{\min}(\Sigma)-\delta)^{2}}\log\!\tfrac{d}{\xi}\right)</annotation></semantics></math></span>
</span></td></tr>
