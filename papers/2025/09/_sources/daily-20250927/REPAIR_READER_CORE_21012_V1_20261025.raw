<td id="A1.T6.10.1.34.7" class="ltx_td ltx_nopad_r ltx_align_center">44.82</td></tr>
<tr id="A1.T6.10.1.35" class="ltx_tr">
<td id="A1.T6.10.1.35.1" class="ltx_td ltx_align_right ltx_border_r">Subjective</td>
<td id="A1.T6.10.1.35.2" class="ltx_td ltx_align_center">0.00</td>
