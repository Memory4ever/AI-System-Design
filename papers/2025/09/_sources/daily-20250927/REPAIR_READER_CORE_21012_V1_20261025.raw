<td id="A1.T6.10.1.35.4" class="ltx_td ltx_align_center ltx_border_r">0.00</td>
<td id="A1.T6.10.1.35.5" class="ltx_td ltx_align_center">66.41</td>
<td id="A1.T6.10.1.35.6" class="ltx_td ltx_align_center">0.00</td>
<td id="A1.T6.10.1.35.7" class="ltx_td ltx_nopad_r ltx_align_center">55.47</td></tr>
<tr id="A1.T6.10.1.36" class="ltx_tr">
<td id="A1.T6.10.1.36.1" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t">Average</td>
<td id="A1.T6.10.1.36.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">19.76</td>
