<td id="A9.T15.6.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="A9.T15.6.1.2.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F5F7FA;">Avg</span></td>
<td id="A9.T15.6.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="A9.T15.6.1.2.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F5F7FA;">PreAlg.</span></td>
<td id="A9.T15.6.1.2.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="A9.T15.6.1.2.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F5F7FA;">C-EVAL</span></td>
<td id="A9.T15.6.1.2.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="A9.T15.6.1.2.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F5F7FA;">Avg</span></td></tr>
<tr id="A9.T15.6.1.3" class="ltx_tr" style="--ltx-bg-color:#F8F8F8;">
