<tr id="A9.T15.6.1.4" class="ltx_tr">
<td id="A9.T15.6.1.4.1" class="ltx_td ltx_align_left" style="padding-top:0.6pt;padding-bottom:0.6pt;">Best single model (Dolphin-2.9-LLaMA-3-8B)</td>
<td id="A9.T15.6.1.4.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FAFCFF;padding-top:0.6pt;padding-bottom:0.6pt;"><span id="A9.T15.6.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#FAFCFF;">59.46</span></td>
