<td id="A9.T15.6.1.1.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;" colspan="3"><span id="A9.T15.6.1.1.3.1" class="ltx_text ltx_font_bold">Baselines: Out-of-Distribution (OOD)</span></td></tr>
