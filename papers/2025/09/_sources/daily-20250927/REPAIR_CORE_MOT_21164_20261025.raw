<td id="A9.T15.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="A9.T15.6.1.2.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F5F7FA;">CMMLU</span></td>
