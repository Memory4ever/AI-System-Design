<td id="S5.T3.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S5.T3.2.2.2.1" class="ltx_text" style="font-size:90%;">0.289</span></td>
