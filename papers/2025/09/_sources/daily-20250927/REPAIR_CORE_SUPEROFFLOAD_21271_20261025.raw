<th id="S5.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S5.T3.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">PT-CPU</span></th>
