<td id="S5.T1.2.1.4.5" class="ltx_td ltx_align_left"><span id="S5.T1.2.1.4.5.1" class="ltx_text" style="--ltx-fg-color:#DBD667;">0.2904<sub id="S5.T1.2.1.4.5.1.1" class="ltx_sub"><span id="S5.T1.2.1.4.5.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">±0.0276</span></sub></span></td>
<td id="S5.T1.2.1.4.6" class="ltx_td ltx_align_left"><span id="S5.T1.2.1.4.6.1" class="ltx_text" style="--ltx-fg-color:#40A832;">0.5348<sub id="S5.T1.2.1.4.6.1.1" class="ltx_sub"><span id="S5.T1.2.1.4.6.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">±0.0192</span></sub></span></td>
<td id="S5.T1.2.1.4.7" class="ltx_td ltx_align_left"><span id="S5.T1.2.1.4.7.1" class="ltx_text" style="--ltx-fg-color:#40A832;">0.5576</span></td></tr>
<tr id="S5.T1.2.1.5" class="ltx_tr">
