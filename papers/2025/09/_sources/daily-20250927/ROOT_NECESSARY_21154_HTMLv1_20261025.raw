<td id="S5.T1.2.1.2.6" class="ltx_td ltx_align_left ltx_border_tt">0.7500<sub id="S5.T1.2.1.2.6.1" class="ltx_sub">±0.0693</sub></td>
<td id="S5.T1.2.1.2.7" class="ltx_td ltx_align_left ltx_border_tt"><span id="S5.T1.2.1.2.7.1" class="ltx_text ltx_font_bold">0.2978<sub id="S5.T1.2.1.2.7.1.1" class="ltx_sub"><span id="S5.T1.2.1.2.7.1.1.1" class="ltx_text ltx_font_medium">±0.0278</span></sub></span></td>
