<th id="A5.T13.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">AEL</th>
<th id="A5.T13.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">ReEvo</th>
<th id="A5.T13.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">MCTS-AHD</th>
<th id="A5.T13.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Ours</th></tr>
</thead>
<tbody class="ltx_tbody">
