<tbody class="ltx_tbody">
<tr id="A5.T5.5.1.3" class="ltx_tr">
<th id="A5.T5.5.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">LNCS</th>
<td id="A5.T5.5.1.3.2" class="ltx_td ltx_align_center ltx_border_t">5.79</td>
<td id="A5.T5.5.1.3.3" class="ltx_td ltx_align_center ltx_border_t">-</td>
<td id="A5.T5.5.1.3.4" class="ltx_td ltx_align_center ltx_border_t">1.64%</td>
<td id="A5.T5.5.1.3.5" class="ltx_td ltx_align_center ltx_border_t">10.74</td>
