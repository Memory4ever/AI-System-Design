<td id="A5.T13.5.2.2" class="ltx_td ltx_align_center ltx_border_t">10.84%</td>
<td id="A5.T13.5.2.3" class="ltx_td ltx_align_center ltx_border_t">6.50%</td>
<td id="A5.T13.5.2.4" class="ltx_td ltx_align_center ltx_border_t">15.98%</td>
<td id="A5.T13.5.2.5" class="ltx_td ltx_align_center ltx_border_t">2.02%</td></tr>
<tr id="A5.T13.5.3" class="ltx_tr">
<th id="A5.T13.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">berlin52.tsp</th>
<td id="A5.T13.5.3.2" class="ltx_td ltx_align_center">12.91%</td>
<td id="A5.T13.5.3.3" class="ltx_td ltx_align_center">17.99%</td>
<td id="A5.T13.5.3.4" class="ltx_td ltx_align_center">7.08%</td>
<td id="A5.T13.5.3.5" class="ltx_td ltx_align_center">4.54%</td></tr>
<tr id="A5.T13.5.4" class="ltx_tr">
<th id="A5.T13.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">st70.tsp</th>
<td id="A5.T13.5.4.2" class="ltx_td ltx_align_center">4.10%</td>
<td id="A5.T13.5.4.3" class="ltx_td ltx_align_center">6.42%</td>
<td id="A5.T13.5.4.4" class="ltx_td ltx_align_center">15.45%</td>
<td id="A5.T13.5.4.5" class="ltx_td ltx_align_center">0.00%</td></tr>
<tr id="A5.T13.5.5" class="ltx_tr">
<th id="A5.T13.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">eil76.tsp</th>
<td id="A5.T13.5.5.2" class="ltx_td ltx_align_center">10.26%</td>
