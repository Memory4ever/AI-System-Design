<td id="A5.T10.5.3.2" class="ltx_td ltx_align_center ltx_border_bb">0.86%</td>
<td id="A5.T10.5.3.3" class="ltx_td ltx_align_center ltx_border_bb">1.15%</td>
<td id="A5.T10.5.3.4" class="ltx_td ltx_align_center ltx_border_bb">4.50%</td>
<td id="A5.T10.5.3.5" class="ltx_td ltx_align_center ltx_border_bb">1.89%</td>
<td id="A5.T10.5.3.6" class="ltx_td ltx_align_center ltx_border_bb">2.47%</td>
<td id="A5.T10.5.3.7" class="ltx_td ltx_align_center ltx_border_bb">1.31%</td>
