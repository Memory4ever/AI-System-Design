<td id="A5.T10.5.2.5" class="ltx_td ltx_align_center ltx_border_t">84%</td>
<td id="A5.T10.5.2.6" class="ltx_td ltx_align_center ltx_border_t">93%</td>
<td id="A5.T10.5.2.7" class="ltx_td ltx_align_center ltx_border_t">100%</td>
