</span></span><span id="A3.T4.p2.1.3" class="ltx_text"></span></span>
</span></span></span>
<span id="A3.T4.4.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">
