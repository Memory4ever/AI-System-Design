<td id="S2.T1.2.1.1.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_tt" style="padding-top:-1.25pt;padding-bottom:-1.25pt;">
<span id="S2.T1.2.1.1.2.1" class="ltx_inline-block ltx_align_middle" style="width:200.0pt;">
