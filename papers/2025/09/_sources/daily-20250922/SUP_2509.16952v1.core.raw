<td id="S2.T3.2.1.3.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T3.2.1.3.10.1" class="ltx_text" style="--ltx-fg-color:#B0171F;">✗</span></td>
<td id="S2.T3.2.1.3.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T3.2.1.3.11.1" class="ltx_text" style="--ltx-fg-color:#B0171F;">✗</span></td>
<td id="S2.T3.2.1.3.12" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T3.2.1.3.12.1" class="ltx_text" style="--ltx-fg-color:#B0171F;">✗</span></td></tr>
<tr id="S2.T3.2.1.4" class="ltx_tr">
<td id="S2.T3.2.1.4.1" class="ltx_td ltx_align_left">QASPER <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite></td>
<td id="S2.T3.2.1.4.2" class="ltx_td ltx_align_center"><math id="S2.T3.m2" class="ltx_Math" alttext="5,049" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo>,</mo><mn>049</mn></mrow><annotation encoding="application/x-tex">5,049</annotation></semantics></math></td>
<td id="S2.T3.2.1.4.3" class="ltx_td ltx_align_center">F1</td>
<td id="S2.T3.2.1.4.4" class="ltx_td ltx_align_center"><span id="S2.T3.2.1.4.4.1" class="ltx_text" style="--ltx-fg-color:#308014;">✓</span></td>
<td id="S2.T3.2.1.4.5" class="ltx_td ltx_align_center"><span id="S2.T3.2.1.4.5.1" class="ltx_text" style="--ltx-fg-color:#B0171F;">✗</span></td>
