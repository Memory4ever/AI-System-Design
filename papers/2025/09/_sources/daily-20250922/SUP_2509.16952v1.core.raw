<td id="A4.T14.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T14.2.1.2.1" class="ltx_text ltx_font_bold">sgl.</span></td>
<td id="A4.T14.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T14.2.1.3.1" class="ltx_text ltx_font_bold">multi.</span></td>
<td id="A4.T14.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T14.2.1.4.1" class="ltx_text ltx_font_bold">retr.</span></td>
<td id="A4.T14.2.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T14.2.1.5.1" class="ltx_text ltx_font_bold">comp.</span></td>
<td id="A4.T14.2.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T14.2.1.6.1" class="ltx_text ltx_font_bold">Total</span></td></tr>
<tr id="A4.T14.2.2" class="ltx_tr">
<td id="A4.T14.2.2.1" class="ltx_td ltx_align_center ltx_border_t">Lack of Context</td>
<td id="A4.T14.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T14.2.2.2.1" class="ltx_text ltx_font_bold">5</span></td>
<td id="A4.T14.2.2.3" class="ltx_td ltx_align_center ltx_border_t">3</td>
<td id="A4.T14.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T14.2.2.4.1" class="ltx_text ltx_font_bold">9</span></td>
<td id="A4.T14.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T14.2.2.5.1" class="ltx_text ltx_font_bold">6</span></td>
<td id="A4.T14.2.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T14.2.2.6.1" class="ltx_text ltx_font_bold">23</span></td></tr>
<tr id="A4.T14.2.3" class="ltx_tr">
<td id="A4.T14.2.3.1" class="ltx_td ltx_align_center">Over Confidence</td>
<td id="A4.T14.2.3.2" class="ltx_td ltx_align_center">3</td>
<td id="A4.T14.2.3.3" class="ltx_td ltx_align_center">2</td>
<td id="A4.T14.2.3.4" class="ltx_td ltx_align_center">5</td>
<td id="A4.T14.2.3.5" class="ltx_td ltx_align_center">3</td>
<td id="A4.T14.2.3.6" class="ltx_td ltx_align_center">13</td></tr>
<tr id="A4.T14.2.4" class="ltx_tr">
<td id="A4.T14.2.4.1" class="ltx_td ltx_align_center">Textual Reasoning</td>
<td id="A4.T14.2.4.2" class="ltx_td ltx_align_center">2</td>
