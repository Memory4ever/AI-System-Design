<td id="S2.T3.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S2.T3.2.1.1.2.1" class="ltx_text ltx_font_bold"># QA</span></td>
<td id="S2.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S2.T3.2.1.1.3.1" class="ltx_text ltx_font_bold">Evaluation Methods</span></td>
<td id="S2.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="4"><span id="S2.T3.2.1.1.4.1" class="ltx_text ltx_font_bold">Task types</span></td>
