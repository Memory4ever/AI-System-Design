<td id="A3.T12.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T12.2.1.2.5.1" class="ltx_text ltx_font_bold">text</span></td>
<td id="A3.T12.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T12.2.1.2.6.1" class="ltx_text ltx_font_bold">table</span></td>
