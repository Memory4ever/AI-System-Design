<td id="S2.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S2.T3.m1" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>K</td>
<td id="S2.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">BLEU, METEOR, ROUGE</td>
