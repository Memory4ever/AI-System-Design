<td id="S5.T4.3.8.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T4.3.8.1.1" class="ltx_text" style="font-size:90%;">7</span></td>
<td id="S5.T4.3.8.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T4.3.8.2.1" class="ltx_text" style="font-size:90%;">▁crack ▁treat</span></td>
<td id="S5.T4.3.8.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T4.3.8.3.1" class="ltx_text" style="font-size:90%;">▁So ▁honest</span></td>
<td id="S5.T4.3.8.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T4.3.8.4.1" class="ltx_text" style="font-size:90%;">▁will ▁seriously</span></td></tr>
<tr id="S5.T4.3.9" class="ltx_tr">
<td id="S5.T4.3.9.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T4.3.9.1.1" class="ltx_text" style="font-size:90%;">8</span></td>
<td id="S5.T4.3.9.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#FFFFCC;padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T4.3.9.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#FFFFCC;">▁Tell ▁seriously</span></td>
<td id="S5.T4.3.9.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T4.3.9.3.1" class="ltx_text" style="font-size:90%;">▁gives ▁grip</span></td>
<td id="S5.T4.3.9.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T4.3.9.4.1" class="ltx_text" style="font-size:90%;">▁moved ▁seriously</span></td></tr>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_table">Table 4: </span>Top-8 bi-token sequences recovered by inversion for poisoned models. </figcaption>
</figure>
