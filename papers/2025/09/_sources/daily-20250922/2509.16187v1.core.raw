<div id="S3.F3.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S3.F3.p3.pic1" class="ltx_picture" height="250.13" overflow="visible" version="1.1" viewBox="0 0 155.15 250.13" width="155.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,250.13) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 3.46 L 0 246.67 C 0 248.58 1.55 250.13 3.46 250.13 L 151.69 250.13 C 153.6 250.13 155.15 248.58 155.15 246.67 L 155.15 3.46 C 155.15 1.55 153.6 0 151.69 0 L 3.46 0 C 1.55 0 0 1.55 0 3.46 Z"></path></g><g style="--ltx-fill-color:#FFFFE6;" fill="#FFFFE6" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 3.46 L 0.69 246.67 C 0.69 248.2 1.93 249.44 3.46 249.44 L 151.69 249.44 C 153.22 249.44 154.45 248.2 154.45 246.67 L 154.45 3.46 C 154.45 1.93 153.22 0.69 151.69 0.69 L 3.46 0.69 C 1.93 0.69 0.69 1.93 0.69 3.46 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 10.16 7.4)"><foreignObject style="--ltx-fo-width:18.55em;--ltx-fo-height:17.01em;--ltx-fo-depth:0em;font-size:10pt;" height="235.34" overflow="visible" transform="matrix(1 0 0 -1 0 235.34)" width="256.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
