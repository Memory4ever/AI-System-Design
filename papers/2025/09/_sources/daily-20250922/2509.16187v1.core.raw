<td id="S4.T1.11.1.25.2" class="ltx_td ltx_align_center"><span id="S4.T1.11.1.25.2.1" class="ltx_text" style="font-size:70%;">Java</span></td>
<td id="S4.T1.11.1.25.3" class="ltx_td ltx_align_center"><span id="S4.T1.11.1.25.3.1" class="ltx_text" style="font-size:70%;">97</span></td>
<td id="S4.T1.11.1.25.4" class="ltx_td ltx_align_center"><span id="S4.T1.11.1.25.4.1" class="ltx_text" style="font-size:70%;">110261</span></td>
<td id="S4.T1.11.1.25.5" class="ltx_td ltx_align_center"><span id="S4.T1.11.1.25.5.1" class="ltx_text" style="font-size:70%;">100</span></td>
<td id="S4.T1.11.1.25.6" class="ltx_td ltx_align_center"><span id="S4.T1.11.1.25.6.1" class="ltx_text" style="font-size:70%;">2</span></td>
<td id="S4.T1.11.1.25.7" class="ltx_td ltx_align_center"><span id="S4.T1.11.1.25.7.1" class="ltx_text" style="font-size:70%;">7</span></td></tr>
<tr id="S4.T1.11.1.26" class="ltx_tr">
