<div id="lstnumberx21" class="ltx_listingline"><span id="lstnumberx21.1" class="ltx_text" style="--ltx-fg-color:#666666;">——————<span id="lstnumberx21.1.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span></span>RUST<span id="lstnumberx21.2" class="ltx_text ltx_lst_space"> </span>TRANSLATION<span id="lstnumberx21.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.4" class="ltx_text" style="--ltx-fg-color:#666666;">——————</span>
</div>
<div id="lstnumberx22" class="ltx_listingline"><span id="lstnumberx22.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#008000;">pub</span>(<span id="lstnumberx22.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#008000;">crate</span>)<span id="lstnumberx22.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.4" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#008000;">fn<span id="lstnumberx22.4.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span><span id="lstnumberx22.5" class="ltx_text" style="--ltx-fg-color:#0000FF;">add_sentence</span>(ranks:<span id="lstnumberx22.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.7" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#008000;">&amp;<span id="lstnumberx22.7.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">mut<span id="lstnumberx22.7.1.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span></span>Rank,<span id="lstnumberx22.8" class="ltx_text ltx_lst_space"> </span>sentence:<span id="lstnumberx22.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.10" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">ParsedSentence</span>)<span id="lstnumberx22.11" class="ltx_text ltx_lst_space"> </span>-&gt;<span id="lstnumberx22.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.13" class="ltx_text" style="--ltx-fg-color:#008000;">Result<span id="lstnumberx22.13.1" class="ltx_text" style="--ltx-fg-color:#666666;">&lt;<span id="lstnumberx22.13.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#B00040;">i32</span></span></span>,<span id="lstnumberx22.14" class="ltx_text ltx_lst_space"> </span>Error<span id="lstnumberx22.15" class="ltx_text" style="--ltx-fg-color:#666666;">&gt;<span id="lstnumberx22.15.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span></span>{
</div>
<div id="lstnumberx23" class="ltx_listingline"><span id="lstnumberx23.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx23.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#008000;">let<span id="lstnumberx23.2.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span></span>sentence_id<span id="lstnumberx23.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx23.4" class="ltx_text" style="--ltx-fg-color:#666666;">=<span id="lstnumberx23.4.1" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span></span>ranks.sentence_map.len()<span id="lstnumberx23.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx23.6" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#008000;">as<span id="lstnumberx23.6.1" class="ltx_text ltx_lst_space ltx_font_medium" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx23.6.2" class="ltx_text" style="--ltx-fg-color:#B00040;">i32</span></span>;
</div>
