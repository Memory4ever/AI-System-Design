<td id="S3.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">51.47</td>
<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">63.04</td>
