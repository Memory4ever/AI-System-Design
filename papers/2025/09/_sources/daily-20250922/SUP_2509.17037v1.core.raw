<tr id="S5.T2.2.1.5" class="ltx_tr">
<td id="S5.T2.2.1.5.1" class="ltx_td ltx_border_t"></td>
<td id="S5.T2.2.1.5.2" class="ltx_td ltx_align_center ltx_border_t">DP</td>
<td id="S5.T2.2.1.5.3" class="ltx_td ltx_align_center ltx_border_t">4.47</td>
<td id="S5.T2.2.1.5.4" class="ltx_td ltx_align_center ltx_border_t">4.30</td>
