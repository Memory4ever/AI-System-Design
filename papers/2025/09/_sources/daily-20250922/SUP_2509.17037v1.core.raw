<tr id="S5.T2.2.1.6" class="ltx_tr">
<td id="S5.T2.2.1.6.1" class="ltx_td ltx_align_center"><span id="S5.T2.2.1.6.1.1" class="ltx_text ltx_font_bold">2. Sectors/asset classes</span></td>
<td id="S5.T2.2.1.6.2" class="ltx_td ltx_align_center">CoT</td>
<td id="S5.T2.2.1.6.3" class="ltx_td ltx_align_center">3.27</td>
