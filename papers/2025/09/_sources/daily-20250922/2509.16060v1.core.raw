<td id="S5.T1.2.2.7" class="ltx_td ltx_align_center ltx_border_t">0.5</td>
<td id="S5.T1.2.2.8" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E6E6E6;"><span id="S5.T1.2.2.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">85.5</span></td>
