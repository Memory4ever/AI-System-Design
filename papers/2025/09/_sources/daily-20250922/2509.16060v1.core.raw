<tr id="S5.T1.2.3" class="ltx_tr">
<td id="S5.T1.2.3.1" class="ltx_td ltx_align_left"><span id="S5.T1.2.3.1.1" class="ltx_text ltx_font_bold">L2-13BCh</span></td>
<td id="S5.T1.2.3.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFE6CC;"><span id="S5.T1.2.3.2.1" class="ltx_text" style="--ltx-bg-color:#FFE6CC;"><math id="S5.T1.m7" class="ltx_Math ltx_framed ltx_framed_rectangle" display="block" intent=":literal"><mn style="--ltx-bg-color:#FFE6CC;" mathbackground="#FFE6CC">28.0</mn></math></span></td>
<td id="S5.T1.2.3.3" class="ltx_td ltx_align_center">8.7</td>
<td id="S5.T1.2.3.4" class="ltx_td ltx_align_center">13.0</td>
