<th id="S5.T1.2.1.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S5.T1.m3" class="ltx_Math" alttext="\texttt{SABER}^{{\dagger}{\dagger}}" display="inline" intent=":literal"><semantics><msup><mtext class="ltx_mathvariant_monospace">SABER</mtext><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>†</mo></mrow></msup><annotation encoding="application/x-tex">\texttt{SABER}^{{\dagger}{\dagger}}</annotation></semantics></math></th>
<th id="S5.T1.2.1.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#E6FFE6;"><math id="S5.T1.m4" class="ltx_math_unparsed" style="--ltx-bg-color:#E6FFE6;" alttext="\triangle_{{\dagger}-{\ddagger}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#E6FFE6;" mathbackground="#E6FFE6" mathvariant="normal">△</mi><msub><mrow></mrow><mrow><mo style="--ltx-bg-color:#E6FFE6;" mathbackground="#E6FFE6" rspace="0em">†</mo><mo style="--ltx-bg-color:#E6FFE6;" lspace="0em" mathbackground="#E6FFE6" rspace="0em">−</mo><mo style="--ltx-bg-color:#E6FFE6;" lspace="0em" mathbackground="#E6FFE6">‡</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\triangle_{{\dagger}-{\ddagger}}</annotation></semantics></math></th></tr>
