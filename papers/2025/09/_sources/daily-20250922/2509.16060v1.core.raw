<th id="S5.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#FFE6CC;"><math id="S5.T1.m1" class="ltx_Math" style="--ltx-bg-color:#FFE6CC;" alttext="\textbf{GCG}^{{\ddagger}}" display="inline" intent=":literal"><semantics><msup><mtext style="--ltx-bg-color:#FFE6CC;" class="ltx_mathvariant_bold" mathbackground="#FFE6CC">GCG</mtext><mo style="--ltx-bg-color:#FFE6CC;" mathbackground="#FFE6CC">‡</mo></msup><annotation encoding="application/x-tex">\textbf{GCG}^{{\ddagger}}</annotation></semantics></math></th>
