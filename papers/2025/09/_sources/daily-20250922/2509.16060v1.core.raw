<td id="S5.T2.2.6.9" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T2.m29" class="ltx_Math" alttext="N/A" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>/</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">N/A</annotation></semantics></math></td>
