<td id="S5.T2.2.5.8" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6E6E6;"><span id="S5.T2.2.5.8.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">95.4</span></td>
<td id="S5.T2.2.5.9" class="ltx_td ltx_align_center"><span id="S5.T2.2.5.9.1" class="ltx_text ltx_underline">96.4</span></td>
<td id="S5.T2.2.5.10" class="ltx_td ltx_align_center">13.2 <math id="S5.T2.m23" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S5.T2.2.5.11" class="ltx_td ltx_align_center">1.0 <math id="S5.T2.m24" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
<tr id="S5.T2.2.6" class="ltx_tr">
