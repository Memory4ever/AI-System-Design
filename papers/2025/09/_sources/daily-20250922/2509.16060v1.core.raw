<td id="S5.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFE6CC;"><span id="S5.T1.2.2.2.1" class="ltx_text" style="--ltx-bg-color:#FFE6CC;"><math id="S5.T1.m5" class="ltx_Math ltx_framed ltx_framed_rectangle" display="block" intent=":literal"><mn style="--ltx-bg-color:#FFE6CC;" mathbackground="#FFE6CC">34.5</mn></math></span></td>
