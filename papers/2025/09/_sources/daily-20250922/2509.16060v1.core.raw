<td id="S6.T3.2.4.5" class="ltx_td ltx_align_center ltx_border_r" style="--ltx-bg-color:#E6E6E6;"><math id="S6.T3.m10" class="ltx_Math ltx_framed ltx_framed_rectangle" style="--ltx-bg-color:#E6E6E6;" display="block" intent=":literal"><mn style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">95.1</mn></math></td>
