<td id="S4.T3.5.7.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="S4.T3.5.7.3.1" class="ltx_text" style="font-size:70%;">3,155</span></td>
<td id="S4.T3.5.7.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="S4.T3.5.7.4.1" class="ltx_text" style="font-size:70%;">12,832</span></td>
