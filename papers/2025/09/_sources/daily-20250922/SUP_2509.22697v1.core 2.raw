<td id="S2.T1.13.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T1.13.3.8.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#F0F0F0;">89.84</span></td>
