<tr id="S4.T5.8.2" class="ltx_tr" style="--ltx-bg-color:#D2F5FF;">
<th id="S4.T5.8.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="S4.T5.8.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D2F5FF;">OA (%)</span></th>
<td id="S4.T5.8.2.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T5.8.2.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#D2F5FF;">92.90</span></td>
<td id="S4.T5.8.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T5.8.2.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#D2F5FF;">93.07</span></td>
<td id="S4.T5.8.2.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T5.8.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D2F5FF;">94.03</span></td></tr>
</tbody>
</table>
</figure>
<figure id="S4.T6" class="ltx_table">
