<th id="S2.T1.13.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S2.T1.13.4.2.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#F0F0F0;">3D CNN</span></th>
<th id="S2.T1.13.4.3" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S2.T1.13.4.3.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#F0F0F0;">3DCNN <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite></span></th>
<td id="S2.T1.13.4.4" class="ltx_td ltx_align_center"><span id="S2.T1.13.4.4.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#F0F0F0;">85.95</span></td>
<td id="S2.T1.13.4.5" class="ltx_td ltx_align_center"><span id="S2.T1.13.4.5.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#F0F0F0;">83.91</span></td>
