<table id="S4.T8.8" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T8.8.1" class="ltx_tr">
<th id="S4.T8.8.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T8.8.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Methodology</span></th>
<th id="S4.T8.8.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T8.8.1.2.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Venue</span></th>
<th id="S4.T8.8.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T8.8.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">IP (OA%, <math id="S4.T8.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>)</span></th>
<th id="S4.T8.8.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T8.8.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">PU (OA%, <math id="S4.T8.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T8.8.2" class="ltx_tr" style="--ltx-bg-color:#F0F8FF;">
<td id="S4.T8.8.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T8.8.2.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F0F8FF;">GAF-NAU <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite></span></td>
<td id="S4.T8.8.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T8.8.2.2.1" class="ltx_text ltx_font_italic" style="font-size:90%;--ltx-bg-color:#F0F8FF;">CVPR’22</span></td>
<td id="S4.T8.8.2.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T8.8.2.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F0F8FF;">81.07 / 78.31</span></td>
<td id="S4.T8.8.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T8.8.2.4.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F0F8FF;">91.12 / 88.09</span></td></tr>
<tr id="S4.T8.8.3" class="ltx_tr" style="--ltx-bg-color:#DCF5DC;">
<td id="S4.T8.8.3.1" class="ltx_td ltx_align_left"><span id="S4.T8.8.3.1.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#DCF5DC;">FFA + BP <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite></span></td>
<td id="S4.T8.8.3.2" class="ltx_td ltx_align_left"><span id="S4.T8.8.3.2.1" class="ltx_text ltx_font_italic" style="font-size:90%;--ltx-bg-color:#DCF5DC;">CVPR’24</span></td>
<td id="S4.T8.8.3.3" class="ltx_td ltx_align_left"><span id="S4.T8.8.3.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#DCF5DC;">73.65 / 69.78</span></td>
<td id="S4.T8.8.3.4" class="ltx_td ltx_align_center"><span id="S4.T8.8.3.4.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#DCF5DC;">92.51 / 90.11</span></td></tr>
<tr id="S4.T8.8.4" class="ltx_tr" style="--ltx-bg-color:#F0F8FF;">
<td id="S4.T8.8.4.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="S4.T8.8.4.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#F0F8FF;">OURS</span></td>
<td id="S4.T8.8.4.2" class="ltx_td ltx_border_bb ltx_border_t"></td>
<td id="S4.T8.8.4.3" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="S4.T8.8.4.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#F0F8FF;">94.03<span id="S4.T8.8.4.3.1.1" class="ltx_text ltx_font_medium"> / </span>93.54</span></td>
<td id="S4.T8.8.4.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T8.8.4.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#F0F8FF;">97.26<span id="S4.T8.8.4.4.1.1" class="ltx_text ltx_font_medium"> / </span>96.39</span></td></tr>
