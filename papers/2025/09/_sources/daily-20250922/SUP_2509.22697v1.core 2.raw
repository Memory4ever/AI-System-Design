<td id="S4.T5.8.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T5.8.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Label-only</span></td>
<td id="S4.T5.8.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T5.8.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Short Text</span></td>
