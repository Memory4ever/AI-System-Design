<figure id="S3.F2" class="ltx_figure"><img src="2509.17066v1/fig_ablation_large.png" id="S3.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:471/147;" width="471" height="147" alt="Refer to caption">
