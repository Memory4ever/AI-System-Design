<td id="S2.T4.3.1.3.4" class="ltx_td ltx_align_center" style="padding-top:1.75pt;padding-bottom:1.75pt;">0.91</td></tr>
<tr id="S2.T4.3.1.4" class="ltx_tr">
<th id="S2.T4.3.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:1.75pt;padding-bottom:1.75pt;"><span id="S2.T4.3.1.4.1.1" class="ltx_text ltx_font_italic">F1-score</span></th>
