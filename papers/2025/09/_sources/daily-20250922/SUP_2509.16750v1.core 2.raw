o><mi mathsize="0.800em">glipizide</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">7.388</mn><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">0.151</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">sin</mi><mo>(</mo><mn mathsize="0.800em">0.366</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">race</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">7.365</mn><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">0.097</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">cos</mi><mo>(</mo><mn mathsize="0.800em">0.38</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">diag</mi><msub><mrow></mrow><mn mathsize="0.800em">3</mn></msub><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">0.774</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0em">×</mo><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">0.335</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">cos</mi><mo>(</mo><mn mathsize="0.800em">0.402</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">discharge</mi><msub><mrow></mrow><mi mathsize="0.800em">dispositionid</mi></msub><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">5.804</mn><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">0.146</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">cos</mi><mo>(</mo><mn mathsize="0.800em">0.96</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">insulin</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">3.135</mn><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">0.363</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">cos</mi><mo>(</mo><mn mathsize="0.800em">0.346</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">num</mi><msub><mrow></mrow><mi mathsize="0.800em">medications</mi></msub><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">5.816</mn><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">0.317</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">cos</mi><mo>(</mo><mn mathsize="0.800em">0.344</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">time</mi><msub><mrow></mrow><mi mathsize="0.800em">inhospital</mi></msub><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">6.769</mn><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">0.339</mn><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">0.024</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">e</mi><msup><mrow></mrow><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">8.408</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">tolbutamide</mi></mrow></msup></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">0.011</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">e</mi><msup><mrow></mrow><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">4.491</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">glyburide</mi><mo mathsize="0.800em">−</mo><mi mathsize="0.800em">metformin</mi></mrow></msup></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo mathsize="0.800em">−</mo><mfrac><mn mathsize="0.800em">0.002</mn><mrow><mn mathsize="0.800em">0.162</mn><mo mathsize="0.800em">−</mo><mrow><mn mathsize="0.800em">1.027</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">pioglitazone</mi></mrow></mrow></mfrac></mrow><mo lspace="0em" mathsize="0.800em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}l_{2}=&amp;0.018\times\mathrm{admission_{typeid}}-0.092\times\mathrm{age}+0.018\times\mathrm{change}\\
\hskip 8.50012pt&amp;+0.009\times\mathrm{diabetesMed}-0.076\times\mathrm{gender}\\
\hskip 8.50012pt&amp;+0.295\times\mathrm{nateglinide}-0.089\times\mathrm{num_{procedures}}\\
\hskip 8.50012pt&amp;+0.107\times\mathrm{number_{emergency}}+0.112\times\mathrm{number_{inpatient}}\\
\hskip 8.50012pt&amp;+0.064\times\mathrm{number_{outpatient}}\\
\hskip 8.50012pt&amp;+0.059\times\left(-0.183\times\mathrm{glimepiride}-1\right)^{2}\\
\hskip 8.50012pt&amp;+0.319\times\left(-0.061\times\mathrm{glyburide}-1\right)^{2}\\
\hskip 8.50012pt&amp;-0.024\times\left(-\mathrm{repaglinide}-0.775\right)^{2}\\
\hskip 8.50012pt&amp;+0.184\times\left(-0.294\times\mathrm{rosiglitazone}-1\right)^{2}\\
\hskip 8.50012pt&amp;-0.462\times e^{0.06\times\mathrm{metformin}}\\
\hskip 8.50012pt&amp;+0.338\times\sin{\left(0.482\times\mathrm{admission_{sourceid}}-1.261\right)}\\
\hskip 8.50012pt&amp;-0.359\times\sin{\left(6.775\times\mathrm{glipizide}-7.388\right)}\\
\hskip 8.50012pt&amp;+0.151\times\sin{\left(0.366\times\mathrm{race}-7.365\right)}\\
\hskip 8.50012pt&amp;-0.097\times\cos{\left(0.38\times\mathrm{diag_{3}}+0.774\times\right)}\\
\hskip 8.50012pt&amp;-0.335\times\cos{\left(0.402\times\mathrm{discharge_{dispositionid}}-5.804\right)}\\
\hskip 8.50012pt&amp;-0.146\times\cos{\left(0.96\times\mathrm{insulin}-3.135\right)}\\
\hskip 8.50012pt&amp;-0.363\times\cos{\left(0.346\times\mathrm{num_{medications}}-5.816\right)}\\
\hskip 8.50012pt&amp;+0.317\times\cos{\left(0.344\times\mathrm{time_{inhospital}}+6.769\right)}\\
\hskip 8.50012pt&amp;-0.339+0.024\times e^{-8.408\times\mathrm{tolbutamide}}\\
\hskip 8.50012pt&amp;+0.011\times e^{-4.491\times\mathrm{glyburide-metformin}}\\
\hskip 8.50012pt&amp;-\frac{0.002}{0.162-1.027\times\mathrm{pioglitazone}}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
<div id="S6.p5" class="ltx_para">
<p id="S6.p5.1" class="ltx_p">The performance metrics obtained from this symbolic KAAM model (using the formulas above) closely match those of the original KAAM model trained with full B-splines and without pruning. Specifically, the symbolic version achieves accuracy <math id="S6.p5.m1" class="ltx_Math" alttext="0.57/0.58" display="inline" intent=":literal"><semantics><mrow><mn>0.57</mn><mo>/</mo><mn>0.58</mn></mrow><annotation encoding="application/x-tex">0.57/0.58</annotation></semantics></math>, precision <math id="S6.p5.m2" class="ltx_Math" alttext="0.50/0.50" display="inline" intent=":literal"><semantics><mrow><mn>0.50</mn><mo>/</mo><mn>0.50</mn></mrow><annotation encoding="application/x-tex">0.50/0.50</annotation></semantics></math>, recall <math id="S6.p5.m3" class="ltx_Math" alttext="0.57/0.58" display="inline" intent=":literal"><semantics><mrow><mn>0.57</mn><mo>/</mo><mn>0.58</mn></mrow><annotation encoding="application/x-tex">0.57/0.58</annotation></semantics></math>, F1-score <math id="S6.p5.m4" class="ltx_Math" alttext="0.48/0.50" display="inline" intent=":literal"><semantics><mrow><mn>0.48</mn><mo>/</mo><mn>0.50</mn></mrow><annotation encoding="application/x-tex">0.48/0.50</annotation></semantics></math>, and ROC-AUC <math id="S6.p5.m5" class="ltx_Math" alttext="0.56/0.54" display="inline" intent=":literal"><semantics><mrow><mn>0.56</mn><mo>/</mo><mn>0.54</mn></mrow><annotation encoding="application/x-tex">0.56/0.54</annotation></semantics></math>, demonstrating that expressivity is retained while gaining interpretability.</p>
</div>
</section>
</section>
