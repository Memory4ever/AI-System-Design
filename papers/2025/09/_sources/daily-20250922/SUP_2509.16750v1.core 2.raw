<div id="S6.p3" class="ltx_para">
<table id="S6.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E17.m1" class="ltx_Math" alttext="\begin{split}l_{1}=&amp;-0.112\times\mathrm{age}+0.045\times\mathrm{change}+0.091\times\mathrm{diabetesMed}\\
\hskip 8.50012pt&amp;-0.076\times\mathrm{discharge_{dispositionid}}+0.063\times\mathrm{gender}\\
\hskip 8.50012pt&amp;-0.236\times\mathrm{glyburide-metformin}-0.039\times\mathrm{nateglinide}\\
\hskip 8.50012pt&amp;+0.189\times\mathrm{number_{inpatient}}+0.064\times\mathrm{number_{outpatient}}\\
\hskip 8.50012pt&amp;-0.112\times\mathrm{tolbutamide}+0.007\times\sqrt{\mathrm{glipizide}+0.374}\\
\hskip 8.50012pt&amp;+0.148\times\left(-0.46\times\mathrm{repaglinide}-1\right)^{2}\\
\hskip 8.50012pt&amp;+0.15\times\left(-0.348\times\mathrm{rosiglitazone}-1\right)^{2}\\
\hskip 8.50012pt&amp;+0.012\times\log{\left(9.993\times\mathrm{metformin}+0.156\right)}\\
\hskip 8.50012pt&amp;+0.079\times\log{\left(8.436\times\mathrm{race}+2.158\right)}\\
\hskip 8.50012pt&amp;-0.686\times\sin{\left(0.409\times\mathrm{glimepiride}+2.178\right)}\\
