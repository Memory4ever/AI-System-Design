<th id="S4.T7.3.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:2pt;padding-bottom:2pt;"><span id="S4.T7.3.1.6.1.1" class="ltx_text ltx_font_italic">Logistic-KAN</span></th>
