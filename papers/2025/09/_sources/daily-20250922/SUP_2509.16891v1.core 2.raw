<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span>CGL</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.16891v1/figs/pku.png" id="S6.F2.sf2.g1" class="ltx_graphics ltx_img_portrait" style="aspect-ratio:234/346;" width="234" height="346" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>PKU</figcaption>
</figure></div></div>
