</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.sf1.2.2" class="ltx_tr">
<th id="S4.T1.sf1.2.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">Qwen-3B</th>
<td id="S4.T1.sf1.2.2.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">0.418</td>
<td id="S4.T1.sf1.2.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">0.727</td>
<td id="S4.T1.sf1.2.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">0.209</td>
<td id="S4.T1.sf1.2.2.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">0.192</td>
<td id="S4.T1.sf1.2.2.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">0.180</td></tr>
<tr id="S4.T1.sf1.2.3" class="ltx_tr">
<th id="S4.T1.sf1.2.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row" style="padding-left:1.0pt;padding-right:1.0pt;">Qwen-3B+<span id="S4.T1.sf1.2.3.1.1" class="ltx_text ltx_font_italic">LaySPA</span></th>
<td id="S4.T1.sf1.2.3.2" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;">0.468</td>
<td id="S4.T1.sf1.2.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;">0.671</td>
<td id="S4.T1.sf1.2.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;">0.342</td>
<td id="S4.T1.sf1.2.3.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;">0.320</td>
<td id="S4.T1.sf1.2.3.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;">0.216</td></tr>
