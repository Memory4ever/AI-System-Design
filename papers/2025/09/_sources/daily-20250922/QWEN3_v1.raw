<td id="S2.T2.4.9.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:2.6pt;padding-right:2.6pt;">Thinker Token Generation Rate (TPS)</td>
<td id="S2.T2.4.9.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.6pt;padding-right:2.6pt;">75 tokens/s</td>
<td id="S2.T2.4.9.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.6pt;padding-right:2.6pt;">63 tokens/s</td>
<td id="S2.T2.4.9.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:2.6pt;padding-right:2.6pt;">53 tokens/s</td></tr>
<tr id="S2.T2.4.10" class="ltx_tr">
<td id="S2.T2.4.10.1" class="ltx_td ltx_align_left" style="padding-left:2.6pt;padding-right:2.6pt;">Talker Token Generation Rate (TPS)</td>
