<tr id="S5.T13.4.9" class="ltx_tr">
<td id="S5.T13.4.9.1" class="ltx_td ltx_align_left" style="padding-left:2.6pt;padding-right:2.6pt;">CosyVoice 2 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib20" title="" class="ltx_ref">Du et al., 2024</a>)</cite></td>
<td id="S5.T13.4.9.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-left:2.6pt;padding-right:2.6pt;">1.45 — 2.57</td></tr>
