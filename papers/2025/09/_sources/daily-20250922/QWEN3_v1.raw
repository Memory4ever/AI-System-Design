<tr id="S6.T16.4.1.1.5.1.2" class="ltx_tr">
<td id="S6.T16.4.1.1.5.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S6.T16.4.1.1.5.1.2.1.1" class="ltx_text ltx_font_bold">-Base-202507</span></td></tr>
</table></td></tr>
<tr id="S6.T16.4.1.2" class="ltx_tr">
<td id="S6.T16.4.1.2.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="4"><span id="S6.T16.4.1.2.1.1" class="ltx_text">
