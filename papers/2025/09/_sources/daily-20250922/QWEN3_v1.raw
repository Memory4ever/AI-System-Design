<td id="p2.1.1.2" class="ltx_td ltx_align_left"><a href="https://github.com/QwenLM/Qwen3-Omni" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://github.com/QwenLM/Qwen3-Omni</a></td></tr>
<tr id="p2.1.2" class="ltx_tr">
<td id="p2.1.2.1" class="ltx_td ltx_align_right"><span id="p2.1.2.1.1" class="ltx_text" style="position:relative; bottom:-1.5pt;"><object type="image/svg+xml" data="2509.17765v1/hf-logo.svg" id="g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:16/15;" width="16" height="15"></object></span></td>
<td id="p2.1.2.2" class="ltx_td ltx_align_left"><a href="https://huggingface.co/spaces/Qwen/Qwen3-Omni-Demo" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/spaces/Qwen/Qwen3-Omni-Demo</a></td></tr>
