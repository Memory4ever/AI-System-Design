</table></td>
<td id="S6.T16.4.1.1.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt">
<table id="S6.T16.4.1.1.5.1" class="ltx_tabular ltx_align_middle">
<tr id="S6.T16.4.1.1.5.1.1" class="ltx_tr">
