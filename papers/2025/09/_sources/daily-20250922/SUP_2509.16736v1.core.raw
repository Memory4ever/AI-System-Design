<td id="S6.T6.4.8.3" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S6.T6.4.8.3.1" class="ltx_text" style="font-size:90%;">250</span></td>
