            <span id="lstnumberx22.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0366D6;">"#pragma<span id="lstnumberx22.2.1" class="ltx_text ltx_lst_space"> </span>acc<span id="lstnumberx22.2.2" class="ltx_text ltx_lst_space"> </span>parallel<span id="lstnumberx22.2.3" class="ltx_text ltx_lst_space"> </span>loop<span id="lstnumberx22.2.4" class="ltx_text ltx_lst_space"> </span>present(mat[0:<span id="lstnumberx22.2.5" class="ltx_text ltx_lst_space"> </span>size*size])<span id="lstnumberx22.2.6" class="ltx_text ltx_lst_space"> </span>reduction(+:sum)"</span><span id="lstnumberx22.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx22.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;">}</span>
