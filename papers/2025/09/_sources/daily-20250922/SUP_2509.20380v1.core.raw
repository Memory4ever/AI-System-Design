</div>
<div id="lstnumberx2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2</span>
              
              
              
            <span id="lstnumberx2.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0366D6;">"role"</span><span id="lstnumberx2.3" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#383A42;">:</span><span id="lstnumberx2.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx2.5" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0366D6;">"system"</span><span id="lstnumberx2.6" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#383A42;">,</span>
</div>
<div id="lstnumberx3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3</span>
              
              
              
            <span id="lstnumberx3.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0366D6;">"content"</span><span id="lstnumberx3.3" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#383A42;">:</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0366D6;">"You<span id="lstnumberx3.5.1" class="ltx_text ltx_lst_space"> </span>are<span id="lstnumberx3.5.2" class="ltx_text ltx_lst_space"> </span>an<span id="lstnumberx3.5.3" class="ltx_text ltx_lst_space"> </span>expert<span id="lstnumberx3.5.4" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx3.5.5" class="ltx_text ltx_lst_space"> </span>crafting<span id="lstnumberx3.5.6" class="ltx_text ltx_lst_space"> </span>optimal<span id="lstnumberx3.5.7" class="ltx_text ltx_lst_space"> </span>OpenACC<span id="lstnumberx3.5.8" class="ltx_text ltx_lst_space"> </span>pragma<span id="lstnumberx3.5.9" class="ltx_text ltx_lst_space"> </span>directives<span id="lstnumberx3.5.10" class="ltx_text ltx_lst_space"> </span>for<span id="lstnumberx3.5.11" class="ltx_text ltx_lst_space"> </span>GPU<span id="lstnumberx3.5.12" class="ltx_text ltx_lst_space"> </span>parallelization.</span>
