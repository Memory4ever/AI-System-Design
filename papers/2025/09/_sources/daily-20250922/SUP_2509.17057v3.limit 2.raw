<td id="S6.T4.2.3.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">17%</td>
<td id="S6.T4.2.3.7" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S6.T4.2.3.7.1" class="ltx_text ltx_font_bold">67%</span></td>
<td id="S6.T4.2.3.8" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S6.T4.2.3.8.1" class="ltx_text ltx_font_bold">67%</span></td>
<td id="S6.T4.2.3.9" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">0%</td>
<td id="S6.T4.2.3.10" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S6.T4.2.3.10.1" class="ltx_text ltx_font_bold">47.9% <span id="S6.T4.2.3.10.1.1" class="ltx_text" style="font-size:50%;">(<math id="S6.T4.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>32)</span></span></td></tr>
