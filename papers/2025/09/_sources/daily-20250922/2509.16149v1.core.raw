<td id="S6.T8.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">Sycophancy<math id="S6.T8.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
