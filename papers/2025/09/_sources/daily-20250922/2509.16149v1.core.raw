<td id="S6.T8.2.1.3.2" class="ltx_td ltx_align_right ltx_border_bb" style="--ltx-bg-color:#E8F0FE;"><span id="S6.T8.2.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#E8F0FE;">12969.6   <span class="ltx_rule" style="width:0.5pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td>
<td id="S6.T8.2.1.3.3" class="ltx_td ltx_align_right ltx_border_bb" style="--ltx-bg-color:#E8F0FE;"><span id="S6.T8.2.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#E8F0FE;">28.86%   <span class="ltx_rule" style="width:0.5pt;--ltx-bg-color:black;display:inline-block;"> </span></span></td>
