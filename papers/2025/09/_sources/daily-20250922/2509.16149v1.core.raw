<td id="S6.T9.2.1.3.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S6.T9.2.1.3.4.1" class="ltx_text ltx_font_bold">1819.6</span></td>
<td id="S6.T9.2.1.3.5" class="ltx_td ltx_align_center ltx_border_b"><span id="S6.T9.2.1.3.5.1" class="ltx_text ltx_font_bold">1879.4</span></td>
<td id="S6.T9.2.1.3.6" class="ltx_td ltx_align_center ltx_border_b"><span id="S6.T9.2.1.3.6.1" class="ltx_text ltx_font_bold">1832.2</span></td>
<td id="S6.T9.2.1.3.7" class="ltx_td ltx_align_center ltx_border_b"><span id="S6.T9.2.1.3.7.1" class="ltx_text ltx_font_bold">1868.5</span></td>
<td id="S6.T9.2.1.3.8" class="ltx_td ltx_align_center ltx_border_b"><span id="S6.T9.2.1.3.8.1" class="ltx_text ltx_font_bold">1865.1</span></td>
<td id="S6.T9.2.1.3.9" class="ltx_td ltx_align_center ltx_border_b"><span id="S6.T9.2.1.3.9.1" class="ltx_text ltx_font_bold">12969.6</span></td>
<td id="S6.T9.2.1.3.10" class="ltx_td ltx_align_center ltx_border_b"><span id="S6.T9.2.1.3.10.1" class="ltx_text ltx_font_bold">28.86%</span></td>
