<td id="S6.T9.2.1.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T9.2.1.1.2.1" class="ltx_text ltx_font_bold">CASE 0</span></td>
<td id="S6.T9.2.1.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T9.2.1.1.3.1" class="ltx_text ltx_font_bold">1</span></td>
