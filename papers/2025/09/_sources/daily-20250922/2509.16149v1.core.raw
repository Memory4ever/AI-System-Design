</span></span><span id="S4.T3.2.4.2.3" class="ltx_text"></span></td>
<td id="S4.T3.2.4.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_bb"><span id="S4.T3.2.4.3.1" class="ltx_text"></span> <span id="S4.T3.2.4.3.2" class="ltx_text">
<span id="S4.T3.2.4.3.2.1" class="ltx_tabular ltx_align_middle">
