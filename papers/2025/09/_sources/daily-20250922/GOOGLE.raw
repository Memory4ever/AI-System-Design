<span class="js-gt-item-id">View details</span>




</a>



          </span>
        </span>
      </div>
    </div>
    
    
  </div>
</div>

        
            












<div class="row-card">
  <div class="row-card__container">
    
    <div class="row-card__body">
        
          <a class="row-card__heading glue-link" href=https://research.google/pubs/its-still-abuse-community-attitudes-and-perceptions-on-ai-generated-image-based-sexual-abuse/ >
            
              `It’s still abuse’: Community attitudes and perceptions on AI-generated image-based sexual abuse
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        Nicola Henry
                      
                    </div>
                
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/263131/">
                          Rebecca Umbach
                        </a>
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
