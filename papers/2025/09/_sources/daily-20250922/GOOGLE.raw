                        <a class="row-card__small-link" href="/people/jessicajohnson/">
                          Jessica Johnson
                        </a>
                      
                    </div>
                  
              
            
          
          
          <div class="row-card__subheading__spacer"></div>
          <div class="row-card__subheading__item small-text">
            Proceedings of ACM CHI 2026 (to appear)
