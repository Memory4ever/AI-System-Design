<tr id="p2.1.2" class="ltx_tr">
<td id="p2.1.2.1" class="ltx_td ltx_align_right"><span id="p2.1.2.1.1" class="ltx_text" style="position:relative; bottom:-1.5pt;"><img src="2503.20215v1/modelscope-logo.png" id="g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:21/12;" width="21" height="12" alt="[Uncaptioned image]"></span></td>
<td id="p2.1.2.2" class="ltx_td ltx_align_left"><a href="https://modelscope.cn/organization/qwen" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://modelscope.cn/organization/qwen</a></td></tr>
