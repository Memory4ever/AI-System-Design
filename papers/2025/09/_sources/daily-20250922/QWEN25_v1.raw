<td id="S5.T5.4.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="S5.T5.4.1.4.1" class="ltx_text ltx_font_bold">Other Best</span></td>
<td id="S5.T5.4.1.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="S5.T5.4.1.5.1" class="ltx_text ltx_font_bold">Qwen2.5-Omni-7B</span></td></tr>
