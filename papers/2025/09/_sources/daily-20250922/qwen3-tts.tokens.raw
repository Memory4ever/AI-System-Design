alse}],"header":false,"align":null}],[{"text":"RTF (Single Concurrency)","tokens":[{"type":"text","raw":"RTF (Single Concurrency)","text":"RTF (Single Concurrency)","escaped":false}],"header":false,"align":null},{"text":"0.30","tokens":[{"type":"text","raw":"0.30","text":"0.30","escaped":false}],"header":false,"align":null},{"text":"0.43","tokens":[{"type":"text","raw":"0.43","text":"0.43","escaped":false}],"header":false,"align":null}],[{"text":"RTF (Full Concurrency)","tokens":[{"type":"text","raw":"RTF (Full Concurrency)","text":"RTF (Full Concurrency)","escaped":false}],"header":false,"align":null},{"text":"0.51","tokens":[{"type":"text","raw":"0.51","text":"0.51","escaped":false}],"header":false,"align":null},{"text":"0.72","tokens":[{"type":"text","raw":"0.72","text":"0.72","escaped":false}],"header":false,"align":null}]]},{"type":"heading","raw":"## How to use\n","depth":2,"text":"How to use","tokens":[{"type":"text","raw":"How to use","text":"How to use","escaped":false}]},{"type":"paragraph","raw":"Use Qwen3-TTS-Flash with Qwen API is simple. We demonstrate a code snippet for you to play with it below:","text":"Use Qwen3-TTS-Flash with Qwen API is simple. We demonstrate a code snippet for you to play with it below:","tokens":[{"type":"text","raw":"Use Qwen3-TTS-Flash with Qwen API is simple. We demonstrate a code snippet for you to play with it below:","text":"Use Qwen3-TTS-Flash with Qwen API is simple. We demonstrate a code snippet for you to play with it below:","escaped":false}]},{"type":"code","name":"code","src":"https://docs.qwenlm.ai/research/qwen3-tts/code/f5a05efb-4f04-4426-9e49-85c6775c1e95.py","lang":"python","attributes":{},"raw":"{{< code src=\"./code/f5a05efb-4f04-4426-9e49-85c6775c1e95.py\" lang=\"python\" >}}","tokens":[]},{"type":"paragraph","raw":"}}","text":"}}","tokens":[{"type":"text","raw":"}}","text":"}}","escaped":false}]},{"type":"space","raw":"\n\n\n\n"},{"type":"heading","raw":"## What's Next\n\n","depth":2,"text":"What's Next","tokens":[{"type":"text","raw":"What's Next","text":"What's Next","escaped":false}]},{"type":"paragraph","raw":"Qwen3-TTS-Flash revolutionizes the speech synthesis experience, achieving industry-leading performance in multi-speaker capabilities, multilingual support, multi-dialect adaptation, and text processing robustness. We look forward to seeing it empower more innovative applications. Everyone is invited to experience it and share valuable feedback!","text":"Qwen3-TTS-Flash revolutionizes the speech synthesis experience, achieving industry-leading performance in multi-speaker capabilities, multilingual support, multi-dialect adaptation, and text processing robustness. We look forward to seeing it empower more innovative applications. Everyone is invited to experience it and share valuable feedback!","tokens":[{"type":"text","raw":"Qwen3-TTS-Flash revolutionizes the speech synthesis experience, achieving industry-leading performance in multi-speaker capabilities, multilingual support, multi-dialect adaptation, and text processing robustness. We look forward to seeing it empower more innovative applications. Everyone is invited to experience it and share valuable feedback!","text":"Qwen3-TTS-Flash revolutionizes the speech synthesis experience, achieving industry-leading performance in multi-speaker capabilities, multilingual support, multi-dialect adaptation, and text processing robustness. We look forward to seeing it empower more innovative applications. Everyone is invited to experience it and share valuable feedback!","escaped":false}]},{"type":"space","raw":"\n\n\n\n"}]