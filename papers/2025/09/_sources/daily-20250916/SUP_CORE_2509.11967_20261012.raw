<span id="S4.SS4.p7.1" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<span class="ltx_thead">
<span id="S4.SS4.p7.1.1" class="ltx_tr">
<span id="S4.SS4.p7.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt"><span id="S4.SS4.p7.1.1.1.1" class="ltx_text ltx_font_bold">Baseline case</span></span>
<span id="S4.SS4.p7.1.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.SS4.p7.1.1.2.1" class="ltx_text ltx_font_bold">Number of issues</span></span></span>
</span>
