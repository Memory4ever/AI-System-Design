<td id="S3.T2.5.9.2" class="ltx_td ltx_align_center ltx_border_bbb ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T2.5.9.2.1" class="ltx_text" style="font-size:70%;">CLRE</span></td>
