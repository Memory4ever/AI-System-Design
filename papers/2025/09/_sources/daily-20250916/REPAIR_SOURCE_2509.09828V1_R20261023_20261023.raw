<td id="S4.T3.5.7.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.5.7.2.1" class="ltx_text" style="font-size:70%;">Swin-T</span></td>
