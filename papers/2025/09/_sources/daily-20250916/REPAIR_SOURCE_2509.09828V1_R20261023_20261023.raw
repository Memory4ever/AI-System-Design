<td id="S4.T7.5.3.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T7.5.3.2.1" class="ltx_text" style="font-size:70%;">79.45M</span></td>
<td id="S4.T7.5.3.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T7.5.3.3.1" class="ltx_text" style="font-size:70%;">6.83</span></td>
