<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F3.sf7.3" class="ltx_text" style="font-size:90%;">(g)</span> </span><span id="S3.F3.sf7.4" class="ltx_text" style="font-size:90%;">4 months</span></figcaption>
