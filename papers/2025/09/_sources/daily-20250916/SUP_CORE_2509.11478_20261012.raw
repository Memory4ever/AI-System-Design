<th id="S4.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" colspan="2"><span id="S4.T3.2.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Patient</span></th>
<th id="S4.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S4.T3.2.1.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Informant</span></th></tr>
<tr id="S4.T3.2.1.2" class="ltx_tr">
