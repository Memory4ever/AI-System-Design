<th id="S4.T3.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.2.2.1" class="ltx_text" style="font-size:90%;">Count</span></th>
<th id="S4.T3.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T3.2.1.2.3.1" class="ltx_text" style="font-size:90%;">Length</span></th>
<th id="S4.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.2.4.1" class="ltx_text" style="font-size:90%;">Count</span></th>
<th id="S4.T3.2.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S4.T3.2.1.2.5.1" class="ltx_text" style="font-size:90%;">Length</span></th>
<th id="S4.T3.2.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.2.6.1" class="ltx_text" style="font-size:90%;">Count</span></th>
<th id="S4.T3.2.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T3.2.1.2.7.1" class="ltx_text" style="font-size:90%;">Length</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T3.2.1.3" class="ltx_tr">
<th id="S4.T3.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S4.T3.2.1.3.1.1" class="ltx_text" style="font-size:90%;">Clinician</span></th>
<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T3.2.1.3.2.1" class="ltx_text" style="font-size:90%;">118.3 (50.0 – 188.0)</span></td>
<td id="S4.T3.2.1.3.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S4.T3.2.1.3.3.1" class="ltx_text" style="font-size:90%;">31.1 (18.7 – 48.3)</span></td>
<td id="S4.T3.2.1.3.4" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T3.2.1.3.4.1" class="ltx_text" style="font-size:90%;">81.6 (2.0 – 155.0)</span></td>
<td id="S4.T3.2.1.3.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S4.T3.2.1.3.5.1" class="ltx_text" style="font-size:90%;">13.1 (1.0 – 28.0)</span></td>
<td id="S4.T3.2.1.3.6" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T3.2.1.3.6.1" class="ltx_text" style="font-size:90%;">51.6 (11.0 – 105.0)</span></td>
<td id="S4.T3.2.1.3.7" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T3.2.1.3.7.1" class="ltx_text" style="font-size:90%;">19.9 (9.8 – 61.2)</span></td></tr>
<tr id="S4.T3.2.1.4" class="ltx_tr">
<th id="S4.T3.2.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r"><span id="S4.T3.2.1.4.1.1" class="ltx_text" style="font-size:90%;">Agent (Full-script)</span></th>
<td id="S4.T3.2.1.4.2" class="ltx_td ltx_align_left"><span id="S4.T3.2.1.4.2.1" class="ltx_text" style="font-size:90%;">49.3 (36.0 – 65.0)</span></td>
<td id="S4.T3.2.1.4.3" class="ltx_td ltx_align_left ltx_border_r"><span id="S4.T3.2.1.4.3.1" class="ltx_text" style="font-size:90%;">30.9 (22.5 – 55.5)</span></td>
