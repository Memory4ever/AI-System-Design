<tr id="S4.T5.2.1" class="ltx_tr">
<th id="S4.T5.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T5.2.1.1.1" class="ltx_text ltx_font_bold">Metric</span></th>
<th id="S4.T5.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.2.1.2.1" class="ltx_text ltx_font_bold">Overall</span></th>
<th id="S4.T5.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.2.1.3.1" class="ltx_text ltx_font_bold">Sequential Prompting</span></th>
<th id="S4.T5.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T5.2.1.4.1" class="ltx_text ltx_font_bold">Full-Script Prompting</span></th></tr>
