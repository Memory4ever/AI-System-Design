<td id="S4.T3.2.1.4.5" class="ltx_td ltx_align_left ltx_border_r"><span id="S4.T3.2.1.4.5.1" class="ltx_text" style="font-size:90%;">31.8 (3.1 – 127.5)</span></td>
<td id="S4.T3.2.1.4.6" class="ltx_td ltx_align_left"><span id="S4.T3.2.1.4.6.1" class="ltx_text" style="font-size:90%;">17.0 (3.0 – 55.0)</span></td>
<td id="S4.T3.2.1.4.7" class="ltx_td ltx_align_left"><span id="S4.T3.2.1.4.7.1" class="ltx_text" style="font-size:90%;">36.6 (7.1 – 51.5)</span></td></tr>
