<td id="S4.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S4.T3.m1" class="ltx_Math" alttext="P_{avg}@1" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑷</mi><mrow><mi>𝒂</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒈</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold" mathvariant="bold">@</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow><annotation encoding="application/x-tex">P_{avg}@1</annotation></semantics></math></td>
