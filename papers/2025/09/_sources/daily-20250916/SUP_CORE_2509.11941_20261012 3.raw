<span id="S3.T1.2.2.1.2.1.3.1" class="ltx_td ltx_nopad_r ltx_align_center">disease</span></span>
</span></span><span id="S3.T1.2.2.1.3" class="ltx_text"></span></td>
<td id="S3.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T1.2.2.2.1" class="ltx_text"></span> <span id="S3.T1.2.2.2.2" class="ltx_text">
<span id="S3.T1.2.2.2.2.1" class="ltx_tabular ltx_align_middle">
