<td id="S4.T3.2.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T3.2.4.5.1" class="ltx_text ltx_font_bold">+</span></td></tr>
<tr id="S4.T3.2.5" class="ltx_tr">
