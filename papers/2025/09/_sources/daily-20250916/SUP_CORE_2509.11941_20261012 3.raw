<td id="S4.T3.2.7.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">1.13</td>
<td id="S4.T3.2.7.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">+</td>
