<td id="S6.T3.2.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.2.1.3.1" class="ltx_text ltx_font_bold">True-F1</span></td>
<td id="S6.T3.2.1.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.2.1.4.1" class="ltx_text ltx_font_bold">False-F1</span></td>
<td id="S6.T3.2.1.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.2.1.5.1" class="ltx_text ltx_font_bold">Conflicting-F1</span></td>
