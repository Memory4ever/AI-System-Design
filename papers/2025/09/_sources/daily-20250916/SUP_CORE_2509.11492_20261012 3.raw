<tr id="S6.T3.2.2" class="ltx_tr">
<td id="S6.T3.2.2.1" class="ltx_td ltx_align_left ltx_border_t">Prompted LLaMA</td>
<td id="S6.T3.2.2.2" class="ltx_td ltx_align_left ltx_border_t">Top-3 BM25</td>
<td id="S6.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0.40</td>
<td id="S6.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.71</td>
<td id="S6.T3.2.2.5" class="ltx_td ltx_align_center ltx_border_t">0.11</td>
<td id="S6.T3.2.2.6" class="ltx_td ltx_align_center ltx_border_t">0.41</td></tr>
<tr id="S6.T3.2.3" class="ltx_tr">
<td id="S6.T3.2.3.1" class="ltx_td ltx_align_left">Prompted LLaMA</td>
<td id="S6.T3.2.3.2" class="ltx_td ltx_align_left">Top-3 MiniLM</td>
<td id="S6.T3.2.3.3" class="ltx_td ltx_align_center">0.42</td>
<td id="S6.T3.2.3.4" class="ltx_td ltx_align_center">0.71</td>
