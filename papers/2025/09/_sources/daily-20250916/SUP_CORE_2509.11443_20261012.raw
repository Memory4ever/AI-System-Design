<th id="S4.T1.2.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">F1 Gap</span></th></tr>
