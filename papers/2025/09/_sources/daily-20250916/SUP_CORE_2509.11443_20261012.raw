<td id="S4.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.2.1" class="ltx_text" style="font-size:90%;">0.7759</span></td>
<td id="S4.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.8292</span></td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.4.1" class="ltx_text" style="font-size:90%;">0.7642</span></td>
<td id="S4.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.5.1" class="ltx_text" style="font-size:90%;">612.63</span></td>
<td id="S4.T1.2.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.6.1" class="ltx_text" style="font-size:90%;">1.353</span></td>
<td id="S4.T1.2.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.7.1" class="ltx_text" style="font-size:90%;">0.2566</span></td></tr>
<tr id="S4.T1.2.3" class="ltx_tr">
<th id="S4.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T1.2.3.1.1" class="ltx_text" style="font-size:90%;">DistilBERT</span></th>
