<th id="S4.T1.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">AUC</span></th>
<th id="S4.T1.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Training Time (s)</span></th>
