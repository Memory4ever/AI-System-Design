{"data":[{"id":"10.48550/arxiv.2509.11638","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11638","identifiers":[{"identifier":"2509.11638","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yongzhe","familyName":"Lyu","name":"Lyu, Yongzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Wu","name":"Wu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutian","familyName":"Lin","name":"Lin, Yutian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Du","name":"Du, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IS-Diff: Improving Diffusion-Based Inpainting with Better Initial Seed"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T07:16:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:06:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-08T11:17:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-09T01:00:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tip.2026.3721361","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have shown promising results in free-form inpainting. Recent studies based on refined diffusion samplers or novel architectural designs led to realistic results and high data consistency. However, random initialization seed (noise) adopted in vanilla diffusion process may introduce mismatched semantic information in masked regions, leading to biased inpainting results, e.g., low consistency and low coherence with the other unmasked area. To address this issue, we propose the Initial Seed refined Diffusion Model (IS-Diff), a completely training-free approach incorporating distributional harmonious seeds to produce harmonious results. Specifically, IS-Diff employs initial seeds sampled from unmasked areas to imitate the masked data distribution, thereby setting a promising direction for the diffusion procedure. Moreover, a dynamic selective refinement mechanism is proposed to detect severe unharmonious inpaintings in intermediate latent and adjust the strength of our initialization prior dynamically. We validate our method on both standard and large-mask inpainting tasks using the CelebA-HQ, ImageNet, and Places2 datasets, demonstrating its effectiveness across all metrics compared to state-of-the-art inpainting methods."},{"descriptionType":"Other","description":"Accepted by TIP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11638","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:07:25Z","registered":"2025-09-16T03:07:26Z","published":null,"updated":"2026-10-09T03:14:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11924","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11924","identifiers":[{"identifier":"2509.11924","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bo","familyName":"Cao","name":"Cao, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Yu","name":"Yu, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengmeng","familyName":"Feng","name":"Feng, Mengmeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"SenHao","familyName":"Zhang","name":"Zhang, SenHao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Meng","name":"Meng, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Zhang","name":"Zhang, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Qian","name":"Qian, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Lu","name":"Lu, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enriched text-guided variational multimodal knowledge distillation network (VMD) for automated diagnosis of plaque vulnerability in 3D carotid artery MRI"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T13:38:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:24:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T02:04:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-04T01:31:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal learning has attracted much attention in recent years due to its ability to effectively utilize data features from a variety of different modalities. Diagnosing the vulnerability of atherosclerotic plaques directly from carotid 3D MRI images is relatively challenging for both radiologists and conventional 3D vision networks. In clinical practice, radiologists assess patient conditions using a multimodal approach that incorporates various imaging modalities and domain-specific expertise, paving the way for the creation of multimodal diagnostic networks. In this paper, we have developed an effective strategy to leverage radiologists' domain knowledge to automate the diagnosis of carotid plaque vulnerability through Variation inference and Multimodal knowledge Distillation (VMD). This method excels in harnessing cross-modality prior knowledge from limited image annotations and radiology reports within training data, thereby enhancing the diagnostic network's accuracy for unannotated 3D MRI images. We conducted in-depth experiments on the dataset collected in-house and verified the effectiveness of the VMD strategy we proposed."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11924","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:14:31Z","registered":"2025-09-16T03:14:32Z","published":null,"updated":"2026-08-04T04:35:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11717","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11717","identifiers":[{"identifier":"2509.11717","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adhiraj","familyName":"Banerjee","name":"Banerjee, Adhiraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vipul","familyName":"Arora","name":"Arora, Vipul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CodecSep: Prompt-Driven Universal Sound Separation on Neural Audio Codec Latents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T09:12:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:11:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-22T12:17:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T01:27:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-25T12:44:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-26T00:46:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11-27T17:21:58Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-12-01T01:55:38Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-04-26T19:25:21Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-04-28T01:06:03Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-06-21T14:09:38Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-06-26T00:39:37Z","dateType":"Updated","dateInformation":"v6"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Text-guided sound separation enables flexible audio editing, assistive listening, and open-domain source extraction, but systems such as AudioSep remain too expensive for low-latency edge or codec-mediated deployment. Existing neural audio codec separators are efficient, yet largely restricted to fixed stems or closed taxonomies. We introduce CodecSep, a prompt-driven universal sound separation framework that extracts sources directly in neural audio codec latent space. CodecSep combines a frozen DAC backbone with a lightweight FiLM-conditioned Transformer masker driven by CLAP text embeddings, enabling open-vocabulary separation while preserving codec-native efficiency.\n Across dnr-v2 and five open-domain benchmarks, CodecSep consistently improves over AudioSep in SI-SDR, remains competitive in ViSQOL, and achieves clear gains in human MOS-LQS. Controlled analyses show that fine-grained prompts outperform coarse labels, and that explicit latent masking is substantially more effective than decoder-style latent generation in codec space. Qualitative diagnostics show that neural audio codec latents retain source-dependent structure, which CodecSep exploits mainly through channel-wise source-conditioned modulation.\n CodecSep also provides a practical code-stream deployment path. When audio is transmitted as neural audio codec codes, CodecSep maps codes to embeddings, separates directly in codec space, and outputs waveforms or re-quantized codes, avoiding the decode-separate-re-encode loop. In this regime, CodecSep requires only 1.35 GMACs end-to-end: about 54 times less compute than AudioSep in the same pipeline and 25 times lower separator-only compute, with much lower latency and memory. More broadly, CodecSep offers a blueprint for codec-native downstream audio processing."},{"descriptionType":"Other","description":"main content- 27 pages, total - 53 pages, 12 figure, Accepted by Transactions on Machine Learning Research (TMLR), 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11717","contentUrl":null,"metadataVersion":6,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:09:24Z","registered":"2025-09-16T03:09:25Z","published":null,"updated":"2026-06-26T02:16:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11548","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11548","identifiers":[{"identifier":"2509.11548","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weiming","familyName":"Li","name":"Li, Weiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Shao","name":"Shao, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Yang","name":"Yang, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujing","familyName":"Lu","name":"Lu, Yujing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Zhong","name":"Zhong, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhan","familyName":"Wang","name":"Wang, Yuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Yu","name":"Yu, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongxiao","familyName":"Ruan","name":"Ruan, Tongxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manni","familyName":"Duan","name":"Duan, Manni","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Auxiliary Reasoning Unleashes GUI Grounding in VLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T03:28:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:00:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-10T01:13:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-11T00:19:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graphical user interface (GUI) grounding is a fundamental task for building GUI agents. However, general vision-language models (VLMs) struggle with this task due to a lack of specific optimization. We identify a key gap in this paper: while VLMs exhibit significant latent grounding potential, as demonstrated by their performance measured by Pointing Game, they underperform when tasked with outputting explicit coordinates. To address this discrepancy and bypass the high data and annotation costs of current fine-tuning approaches, we propose three zero-shot auxiliary reasoning methods. By providing explicit spatial cues such as axes, grids and labeled intersections as part of the input image, these methods enable VLMs to better articulate their implicit spatial understanding capabilities. We evaluate these methods on four GUI grounding benchmarks across seven open-source and proprietary VLMs. Experimental results show substantial gains from auxiliary reasoning. Mark-Grid Scaffold boosts Gemini-3.1-Pro from 11.72\\% under direct inference to 95.20\\% on ScreenSpot-v2, achieves state-of-the-art performance on ScreenSpot, and approaches the strongest fine-tuned methods on ScreenSpot-v2 and UI-I2E-Bench. Our code is available at https://github.com/liweim/AuxiliaryReasoning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11548","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:05:16Z","registered":"2025-09-16T03:05:17Z","published":null,"updated":"2026-06-11T02:24:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11787","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11787","identifiers":[{"identifier":"2509.11787","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pascal","familyName":"Joos","name":"Joos, Pascal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Islem","familyName":"Bouzenia","name":"Bouzenia, Islem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Pradel","name":"Pradel, Michael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CodeCureAgent: Automatic Classification and Repair of Static Analysis Warnings"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:16:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:17:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-08T14:40:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-09T00:52:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-25T12:42:03Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-26T01:49:06Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-01T15:51:14Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-02T01:03:43Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-04-13T11:44:21Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-04-14T01:45:32Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Static analysis tools are widely used to detect bugs, vulnerabilities, and code smells. Traditionally, developers must resolve these warnings manually. Because this process is tedious, developers sometimes ignore warnings, leading to an accumulation of warnings and a degradation of code quality. This paper presents CodeCureAgent, an approach that harnesses LLM-based agents to automatically analyze, classify, and repair static analysis warnings. Unlike previous work, our method does not follow a predetermined algorithm. Instead, we adopt an agentic framework that iteratively invokes tools to gather additional information from the codebase (e.g., via code search) and edit the codebase to resolve the warning. CodeCureAgent detects and suppresses false positives, while fixing true positives when identified. We equip CodeCureAgent with a three-step heuristic to approve patches: (1) build the project, (2) verify that the warning disappears without introducing new warnings, and (3) run the test suite. We evaluate CodeCureAgent on a dataset of 1,000 SonarQube warnings found in 106 Java projects and covering 291 distinct rules. Our approach produces plausible fixes for 96.8% of the warnings, outperforming state-of-the-art baseline approaches by 29.2%-34.0% in plausible-fix rate. Manual inspection of 291 cases reveals a correct-fix rate of 86.3%, showing that CodeCureAgent can reliably repair static analysis warnings. The approach incurs LLM costs of about 2.9 cents (USD) and an end-to-end processing time of about four minutes per warning. We envision CodeCureAgent helping to clean existing codebases and being integrated into CI/CD pipelines to prevent the accumulation of static analysis warnings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11787","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:11Z","registered":"2025-09-16T03:11:11Z","published":null,"updated":"2026-04-14T04:17:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11536","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11536","identifiers":[{"identifier":"2509.11536","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junjie","familyName":"Hu","name":"Hu, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Tu","name":"Tu, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"ShengYu","familyName":"Cheng","name":"Cheng, ShengYu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinxin","familyName":"Li","name":"Li, Jinxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinting","familyName":"Wang","name":"Wang, Jinting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Chen","name":"Chen, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhilong","familyName":"Zhou","name":"Zhou, Zhilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongbo","familyName":"Shan","name":"Shan, Dongbo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HARP: Hallucination Detection via Reasoning Subspace Projection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T03:02:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:59:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-05T07:28:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-02T00:19:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Hallucinations in Large Language Models (LLMs) pose a major barrier to their reliable use in critical decision-making. Although existing hallucination detection methods have improved accuracy, they still struggle with disentangling semantic and reasoning information and maintaining robustness. To address these challenges, we propose HARP (Hallucination detection via reasoning subspace projection), a novel hallucination detection framework. HARP establishes that the hidden state space of LLMs can be decomposed into a direct sum of a semantic subspace and a reasoning subspace, where the former encodes linguistic expression and the latter captures internal reasoning processes. Moreover, we demonstrate that the Unembedding layer can disentangle these subspaces, and by applying Singular Value Decomposition (SVD) to its parameters, the basis vectors spanning the semantic and reasoning subspaces are obtained. Finally, HARP projects hidden states onto the basis vectors of the reasoning subspace, and the resulting projections are then used as input features for hallucination detection in LLMs. By using these projections, HARP reduces the dimension of the feature to approximately 5% of the original, filters out most noise, and achieves enhanced robustness. Experiments across multiple datasets show that HARP achieves state-of-the-art hallucination detection performance; in particular, it achieves an AUROC of 92.8% on TriviaQA, outperforming the previous best method by 7.5%."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11536","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:04:59Z","registered":"2025-09-16T03:04:59Z","published":null,"updated":"2026-04-02T02:27:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11864","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11864","identifiers":[{"identifier":"2509.11864","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lichao","familyName":"Wu","name":"Wu, Lichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sasha","familyName":"Behrouzi","name":"Behrouzi, Sasha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamadreza","familyName":"Rostami","name":"Rostami, Mohamadreza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maximilian","familyName":"Thang","name":"Thang, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stjepan","familyName":"Picek","name":"Picek, Stjepan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmad-Reza","familyName":"Sadeghi","name":"Sadeghi, Ahmad-Reza","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NeuroStrike: Neuron-Level Attacks on Aligned LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:38:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-17T13:02:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-18T02:47:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-26T08:18:42Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-27T00:37:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.14722/ndss.2026.230660","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Safety alignment is critical for the ethical deployment of large language models (LLMs), guiding them to avoid generating harmful or unethical content. Current alignment techniques, such as supervised fine-tuning and reinforcement learning from human feedback, remain fragile and can be bypassed by carefully crafted adversarial prompts. Unfortunately, such attacks rely on trial and error, lack generalizability across models, and are constrained by scalability and reliability.\n This paper presents NeuroStrike, a novel and generalizable attack framework that exploits a fundamental vulnerability introduced by alignment techniques: the reliance on sparse, specialized safety neurons responsible for detecting and suppressing harmful inputs. We apply NeuroStrike to both white-box and black-box settings: In the white-box setting, NeuroStrike identifies safety neurons through feedforward activation analysis and prunes them during inference to disable safety mechanisms. In the black-box setting, we propose the first LLM profiling attack, which leverages safety neuron transferability by training adversarial prompt generators on open-weight surrogate models and then deploying them against black-box and proprietary targets. We evaluate NeuroStrike on over 20 open-weight LLMs from major LLM developers. By removing less than 0.6% of neurons in targeted layers, NeuroStrike achieves an average attack success rate (ASR) of 76.9% using only vanilla malicious prompts. Moreover, Neurostrike generalizes to four multimodal LLMs with 100% ASR on unsafe image inputs. Safety neurons transfer effectively across architectures, raising ASR to 78.5% on 11 fine-tuned models and 77.7% on five distilled models. The black-box LLM profiling attack achieves an average ASR of 63.7% across five black-box models, including the Google Gemini family."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11864","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:13:02Z","registered":"2025-09-16T03:13:02Z","published":null,"updated":"2026-03-27T02:21:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11839","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11839","identifiers":[{"identifier":"2509.11839","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiacheng","familyName":"Liu","name":"Liu, Jiacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxiang","familyName":"Ding","name":"Ding, Pengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qihang","familyName":"Zhou","name":"Zhou, Qihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Wu","name":"Wu, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Da","familyName":"Huang","name":"Huang, Da","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimian","familyName":"Peng","name":"Peng, Zimian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xiao","name":"Xiao, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weinan","familyName":"Zhang","name":"Zhang, Weinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lixin","familyName":"Yang","name":"Yang, Lixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cewu","familyName":"Lu","name":"Lu, Cewu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donglin","familyName":"Wang","name":"Wang, Donglin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TrajBooster: Boosting Humanoid Whole-Body Manipulation via Trajectory-Centric Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:25:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T03:11:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:18:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-19T12:26:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-20T00:56:06Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent Vision-Language-Action models show potential to generalize across embodiments but struggle to quickly align with a new robot's action space when high-quality demonstrations are scarce, especially for bipedal humanoids. We present TrajBooster, a cross-embodiment framework that leverages abundant wheeled-humanoid data to boost bipedal VLA. Our key idea is to use end-effector trajectories as a morphology-agnostic interface. TrajBooster (i) extracts 6D dual-arm end-effector trajectories from real-world wheeled humanoids, (ii) retargets them in simulation to Unitree G1 with a whole-body controller trained via a heuristic-enhanced harmonized online DAgger to lift low-dimensional trajectory references into feasible high-dimensional whole-body actions, and (iii) forms heterogeneous triplets that couple source vision/language with target humanoid-compatible actions to post-pre-train a VLA, followed by only 10 minutes of teleoperation data collection on the target humanoid domain. Deployed on Unitree G1, our policy achieves beyond-tabletop household tasks, enabling squatting, cross-height manipulation, and coordinated whole-body motion with markedly improved robustness and generalization. Results show that TrajBooster allows existing wheeled-humanoid data to efficiently strengthen bipedal humanoid VLA performance, reducing reliance on costly same-embodiment data while enhancing action space understanding and zero-shot skill transfer capabilities. For more details, For more details, please refer to our \\href{https://jiachengliu3.github.io/TrajBooster/}."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11839","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:12:26Z","registered":"2025-09-16T03:12:27Z","published":null,"updated":"2026-03-20T02:37:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11629","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11629","identifiers":[{"identifier":"2509.11629","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chentao","familyName":"Cao","name":"Cao, Chentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojun","familyName":"Xu","name":"Xu, Xiaojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Han","name":"Han, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Li","name":"Li, Hang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reasoned Safety Alignment: Ensuring Jailbreak Defense via Answer-Then-Check"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T06:47:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:05:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-06T02:11:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:17:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models (LLMs) continue to advance in capabilities, ensuring their safety against jailbreak attacks remains a critical challenge. In this paper, we introduce a novel safety alignment approach called Answer-Then-Check, which enhances LLM robustness against malicious prompts by applying thinking ability to mitigate jailbreaking problems before producing a final answer to the user. Our method enables models to answer the question in their thoughts directly and then critically evaluate its safety before deciding whether to provide it. To implement this approach, we construct the Reasoned Safety Alignment (ReSA) dataset, comprising 80K samples that teach models to reason through direct responses and then analyze their safety. Experimental results demonstrate that our approach achieves the Pareto frontier with superior safety capability while decreasing over-refusal rates. Notably, the fine-tuned model maintains general reasoning capabilities on benchmarks like MMLU, MATH500, and HumanEval. Besides, our method equips models with the ability to perform safe completion, while post-hoc detection methods can only directly reject sensitive, harmful queries (e.g., self-harm). Our results show that inference-time strategies alone are insufficient, highlighting the necessity of safety training, and we find even $500$ samples can yield performance comparable to the entire dataset, suggesting a promising path for data-efficient safety alignment. The dataset is publicly available at: https://huggingface.co/datasets/ByteDance-Seed/ReSA."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11629","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:07:09Z","registered":"2025-09-16T03:07:10Z","published":null,"updated":"2026-03-09T02:08:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11663","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11663","identifiers":[{"identifier":"2509.11663","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haisheng","familyName":"Wang","name":"Wang, Haisheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Liu","name":"Liu, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiming","familyName":"Zhi","name":"Zhi, Weiming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ConEQsA: Concurrent and Asynchronous Embodied Questions Scheduling and Answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T08:02:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:08:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-03T11:51:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-04T01:46:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper formulates the Embodied Questions Answering (EQsA) problem, introduces a corresponding benchmark, and proposes an agentic system to tackle the problem. Classical Embodied Question Answering (EQA) is typically formulated as answering one single question by actively exploring a 3D environment. Real deployments, however, often demand handling multiple questions that may arrive asynchronously and carry different urgencies. We formalize this setting as Embodied Questions Answering (EQsA) and present ConEQsA, an agentic framework for concurrent, urgency-aware scheduling and answering. ConEQsA leverages shared group memory to reduce redundant exploration, and a priority-planning method to dynamically schedule questions. To evaluate the EQsA setting fairly, we contribute the Concurrent Asynchronous Embodied Questions (CAEQs) benchmark containing 40 indoor scenes and five questions per scene (200 in total), featuring asynchronous follow-up questions and human-annotated urgency labels. We further propose metrics for EQsA performance: Direct Answer Rate (DAR), and Normalized Urgency-Weighted Latency (NUWL), which serve as a fair evaluation protocol for EQsA. Empirical evaluations demonstrate that ConEQsA consistently outperforms strong sequential baselines, and show that urgency-aware, concurrent scheduling is key to making embodied agents responsive and efficient under realistic, multi-question workloads. Code is available on https://anonymous.4open.science/r/ConEQsA."},{"descriptionType":"Other","description":"8 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11663","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:08:03Z","registered":"2025-09-16T03:08:04Z","published":null,"updated":"2026-03-04T03:17:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11772","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11772","identifiers":[{"identifier":"2509.11772","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Diogo","familyName":"Mendonça","name":"Mendonça, Diogo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiago","familyName":"Barros","name":"Barros, Tiago","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristiano","familyName":"Premebida","name":"Premebida, Cristiano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Urbano J.","familyName":"Nunes","name":"Nunes, Urbano J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Seg2Track-SAM2: SAM2-based Multi-object Tracking and Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T10:52:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:16:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T15:58:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T03:18:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous-driving perception systems require robust Multi-Object Tracking (MOT) to operate reliably in dynamic environments. MOT maintains consistent object identities across frames while preserving spatial accuracy. Recent foundation models, such as SAM2, provide promptable video segmentation without task-specific fine-tuning. However, their direct application to Multi-Object Tracking and Segmentation (MOTS) remains limited by the absence of explicit identity management mechanisms and by growing memory requirements during tracking. This work introduces Seg2Track-SAM2, a framework that integrates pretrained object detectors with SAM2 and a dedicated Seg2Track module to support track initialization, data association, and track refinement. The method operates without dataset-specific fine-tuning and remains detector-agnostic. Experimental evaluation on the KITTI MOTS and MOTS Challenge benchmarks shows that Seg2Track-SAM2 ranks fourth overall in both datasets while achieving the highest association accuracy (AssA) among compared methods. In addition, a sliding-window memory strategy reduces memory usage by up to 75% with minimal impact on tracking performance, enabling deployment under resource constraints. Together, these results indicate that Seg2Track-SAM2 improves identity consistency and memory efficiency in MOTS without requiring dataset-specific training. The code is available at https://github.com/hcmr-lab/Seg2Track-SAM2."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11772","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:10:49Z","registered":"2025-09-16T03:10:50Z","published":null,"updated":"2026-03-03T05:42:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11708","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11708","identifiers":[{"identifier":"2509.11708","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhantong","familyName":"Xue","name":"Xue, Zhantong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pingchuan","familyName":"Ma","name":"Ma, Pingchuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoyu","familyName":"Wang","name":"Wang, Zhaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuguang","familyName":"Zhou","name":"Zhou, Yuguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqin","familyName":"Zhang","name":"Zhang, Xiaoqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Wang","name":"Wang, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juergen","familyName":"Rahmel","name":"Rahmel, Juergen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Evaluation to Enhancement: Large Language Models for Zero-Knowledge Proof Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T09:07:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:11:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-31T11:20:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T01:37:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Zero-knowledge proofs (ZKPs) are increasingly deployed in domains such as privacy-preserving authentication, verifiable computation, and secure finance. However, authoring ZK programs remains challenging: unlike conventional software development, ZK programming manifests a fundamental paradigm shift from \\textit{imperative computation} to \\textit{declarative verification}. This process requires rigorous reasoning about finite field arithmetic and complex constraint systems (which is rare in common imperative languages), making it knowledge-intensive and error-prone. While large language models (LLMs) have demonstrated strong code generation capabilities in general-purpose languages, their effectiveness for ZK programming, where correctness hinges on both language mastery and constraint-level reasoning, remains unexplored. To address this gap, we propose \\textsc{ZK-Eval}, a domain-specific evaluation pipeline that probes LLM capabilities on ZK programming at three levels: language knowledge, algebraic primitive competence, and end-to-end program generation. Our evaluation of four state-of-the-art LLMs reveals that while models demonstrate strong proficiency in language syntax, they struggle when implementing and composing algebraic primitives to specify correct constraint systems, frequently producing incorrect programs. Based on these insights, we introduce \\textsc{ZK-Coder}, an agentic framework that augments LLMs with constraint sketching, guided retrieval, and interactive repair. Experiments with GPT-o3 on Circom and Noir show substantial gains, with success rates improving from 20.29\\% to 87.85\\% and from 28.38\\% to 97.79\\%, respectively. With \\textsc{ZK-Eval} and \\textsc{ZK-Coder}, we establish a new basis for systematically measuring and augmenting LLMs in ZK code generation to lower barriers for practitioners and advance privacy computing."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11708","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:09:11Z","registered":"2025-09-16T03:09:11Z","published":null,"updated":"2026-02-03T05:39:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11914","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11914","identifiers":[{"identifier":"2509.11914","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiqun","familyName":"Yao","name":"Yao, Yiqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naitong","familyName":"Yu","name":"Yu, Naitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Li","name":"Li, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Jiang","name":"Jiang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuezhi","familyName":"Fang","name":"Fang, Xuezhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjia","familyName":"Ma","name":"Ma, Wenjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuying","familyName":"Meng","name":"Meng, Xuying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Li","name":"Li, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aixin","familyName":"Sun","name":"Sun, Aixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yequan","familyName":"Wang","name":"Wang, Yequan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EgoMem: Lifelong Memory Agent for Full-duplex Omnimodal Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T13:33:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:23:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-30T08:16:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-02T01:35:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce EgoMem, the first lifelong memory agent tailored for full-duplex models that process real-time omnimodal streams. EgoMem enables real-time models to recognize multiple users directly from raw audiovisual streams, to provide personalized response, and to maintain long-term knowledge of users' facts, preferences, and social relationships extracted from audiovisual history. EgoMem operates with three asynchronous processes: (i) a retrieval process that dynamically identifies user via face and voice, and gathers relevant context from a long-term memory; (ii) an omnimodal dialog process that generates personalized audio responses based on the retrieved context; and (iii) a memory management process that automatically detects dialog boundaries from omnimodal streams, and extracts necessary information to update the long-term memory. Unlike existing memory agents for LLMs, EgoMem relies entirely on raw audiovisual streams, making it especially suitable for lifelong, real-time, and embodied scenarios. Experimental results demonstrate that EgoMem's retrieval and memory management modules achieve over 95% accuracy on the test set. When integrated with a fine-tuned RoboEgo omnimodal chatbot, the system achieves fact-consistency scores above 87% in real-time personalized dialogs, establishing a strong baseline for future research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11914","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:14:13Z","registered":"2025-09-16T03:14:13Z","published":null,"updated":"2026-02-02T03:24:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11656","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11656","identifiers":[{"identifier":"2509.11656","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jonas","familyName":"Becker","name":"Becker, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lars Benedikt","familyName":"Kaesberg","name":"Kaesberg, Lars Benedikt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niklas","familyName":"Bauer","name":"Bauer, Niklas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan Philip","familyName":"Wahle","name":"Wahle, Jan Philip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Terry","familyName":"Ruas","name":"Ruas, Terry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bela","familyName":"Gipp","name":"Gipp, Bela","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MALLM: Multi-Agent Large Language Models Framework"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"A.1; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-15T07:48:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:07:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-22T08:56:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T01:20:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-15T16:45:40Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-16T02:45:09Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-agent debate (MAD) has demonstrated the ability to augment collective intelligence by scaling test-time compute and leveraging expertise. Current frameworks for multi-agent debate are often designed towards tool use, lack integrated evaluation, or provide limited configurability of agent personas, response generators, discussion paradigms, and decision protocols. We introduce MALLM (Multi-Agent Large Language Models), an open-source framework that enables systematic analysis of MAD components. MALLM offers more than 144 unique configurations of MAD, including (1) agent personas (e.g., Expert, Personality), (2) response generators (e.g., Critical, Reasoning), (3) discussion paradigms (e.g., Memory, Relay), and (4) decision protocols (e.g., Voting, Consensus). MALLM uses simple configuration files to define a debate. Furthermore, MALLM can load any textual Hugging Face dataset (e.g., MMLU-Pro, WinoGrande) and provides an evaluation pipeline for easy comparison of MAD configurations. MALLM enables researchers to systematically configure, run, and evaluate debates for their problems, facilitating the understanding of the components and their interplay."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025 (Demo)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11656","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:07:52Z","registered":"2025-09-16T03:07:53Z","published":null,"updated":"2025-12-16T04:49:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11719","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11719","identifiers":[{"identifier":"2509.11719","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bingqing","familyName":"Wei","name":"Wei, Bingqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lianmin","familyName":"Chen","name":"Chen, Lianmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongyu","familyName":"Xia","name":"Xia, Zhongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongtao","familyName":"Wang","name":"Wang, Yongtao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HeLoFusion: An Efficient and Scalable Encoder for Modeling Heterogeneous and Multi-Scale Interactions in Trajectory Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T09:19:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:11:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-10T03:23:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-11T01:20:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-agent trajectory prediction in autonomous driving requires a comprehensive understanding of complex social dynamics. Existing methods, however, often struggle to capture the full richness of these dynamics, particularly the co-existence of multi-scale interactions and the diverse behaviors of heterogeneous agents. To address these challenges, this paper introduces HeLoFusion, an efficient and scalable encoder for modeling heterogeneous and multi-scale agent interactions. Instead of relying on global context, HeLoFusion constructs local, multi-scale graphs centered on each agent, allowing it to effectively model both direct pairwise dependencies and complex group-wise interactions (\\textit{e.g.}, platooning vehicles or pedestrian crowds). Furthermore, HeLoFusion tackles the critical challenge of agent heterogeneity through an aggregation-decomposition message-passing scheme and type-specific feature networks, enabling it to learn nuanced, type-dependent interaction patterns. This locality-focused approach enables a principled representation of multi-level social context, yielding powerful and expressive agent embeddings. On the challenging Waymo Open Motion Dataset, HeLoFusion achieves state-of-the-art performance, setting new benchmarks for key metrics including Soft mAP and minADE. Our work demonstrates that a locality-grounded architecture, which explicitly models multi-scale and heterogeneous interactions, is a highly effective strategy for advancing motion forecasting."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11719","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:09:27Z","registered":"2025-09-16T03:09:28Z","published":null,"updated":"2025-12-11T03:04:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11816","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11816","identifiers":[{"identifier":"2509.11816","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Filip","familyName":"Sondej","name":"Sondej, Filip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yushi","familyName":"Yang","name":"Yang, Yushi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Collapse of Irrelevant Representations (CIR) Ensures Robust and Non-Disruptive LLM Unlearning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:55:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:18:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-13T17:23:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-14T01:55:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Current unlearning and safety training methods consistently fail to remove dangerous knowledge from language models. We identify the root cause - unlearning targets representations which are too general - and develop a highly selective technique that unlearns robustly while preserving general performance.\n Our method performs PCA on activations and module-output gradients to identify subspaces containing common representations, then collapses these subspaces before computing unlearning updates, a technique we term Collapse of Irrelevant Representations (CIR). This avoids unlearning general knowledge and targets only representations specific to the facts being unlearned.\n When unlearning bio- and cyber-hazardous facts from Llama-3.1-8B, we achieve over 30x greater reduction in post-attack accuracy than the best baseline (Circuit Breakers), while disrupting general performance 30x less, and using less than 3 GPU-seconds per fact.\n Thus, by disentangling harmful and benign capabilities at the level of representations, CIR enables robust and non-disruptive unlearning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11816","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:52Z","registered":"2025-09-16T03:11:53Z","published":null,"updated":"2025-11-14T03:10:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11514","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11514","identifiers":[{"identifier":"2509.11514","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengxiang","familyName":"Wang","name":"Wang, Zhengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiling","familyName":"Li","name":"Li, Weiling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panagiotis","familyName":"Kaliosis","name":"Kaliosis, Panagiotis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Owen","familyName":"Rambow","name":"Rambow, Owen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Susan E.","familyName":"Brennan","name":"Brennan, Susan E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LVLMs are Bad at Overhearing Human Referential Communication"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T02:03:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:58:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-24T00:25:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-27T00:13:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"During spontaneous conversations, speakers collaborate on novel referring expressions, which they can then re-use in subsequent conversations. Understanding such referring expressions is an important ability for an embodied agent, so that it can carry out tasks in the real world. This requires integrating and understanding language, vision, and conversational interaction. We study the capabilities of seven state-of-the-art Large Vision Language Models (LVLMs) as overhearers to a corpus of spontaneous conversations between pairs of human discourse participants engaged in a collaborative object-matching task. We find that such a task remains challenging for current LVLMs and they all fail to show a consistent performance improvement as they overhear more conversations from the same discourse participants repeating the same task for multiple rounds. We release our corpus and code for reproducibility and to facilitate future research."},{"descriptionType":"Other","description":"EMNLP 2025 (Main)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11514","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:04:28Z","registered":"2025-09-16T03:04:29Z","published":null,"updated":"2025-10-27T02:11:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11645","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11645","identifiers":[{"identifier":"2509.11645","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaolong","familyName":"Wu","name":"Wu, Zhaolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pu","familyName":"Luo","name":"Luo, Pu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Meng","name":"Meng, Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason Pui Yin","familyName":"Cheung","name":"Cheung, Jason Pui Yin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teng","familyName":"Zhang","name":"Zhang, Teng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adapting and Evaluating Multimodal Large Language Models for Adolescent Idiopathic Scoliosis Self-Management: A Divide and Conquer Framework"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T07:34:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:07:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T09:02:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:43:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-3-032-06004-4_28","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study presents the first comprehensive evaluation of Multimodal Large Language Models (MLLMs) for Adolescent Idiopathic Scoliosis (AIS) self-management. We constructed a database of approximately 3,000 anteroposterior X-rays with diagnostic texts and evaluated five MLLMs through a `Divide and Conquer' framework consisting of a visual question-answering task, a domain knowledge assessment task, and a patient education counseling assessment task. Our investigation revealed limitations of MLLMs' ability in interpreting complex spinal radiographs and comprehending AIS care knowledge. To address these, we pioneered enhancing MLLMs with spinal keypoint prompting and compiled an AIS knowledge base for retrieval augmented generation (RAG), respectively. Results showed varying effectiveness of visual prompting across different architectures, while RAG substantially improved models' performances on the knowledge assessment task. Our findings indicate current MLLMs are far from capable in realizing personalized assistant in AIS care. The greatest challenge lies in their abilities to obtain accurate detections of spinal deformity locations (best accuracy: 0.55) and directions (best accuracy: 0.13)."},{"descriptionType":"Other","description":"Accepted by MICCAI 2025 MLLMCP Workshop"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11645","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:07:36Z","registered":"2025-09-16T03:07:37Z","published":null,"updated":"2025-10-14T04:21:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11619","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11619","identifiers":[{"identifier":"2509.11619","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Spandan","familyName":"Anaokar","name":"Anaokar, Spandan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shrey","familyName":"Ganatra","name":"Ganatra, Shrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harshvivek","familyName":"Kashid","name":"Kashid, Harshvivek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Swapnil","familyName":"Bhattacharyya","name":"Bhattacharyya, Swapnil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shruti","familyName":"Nair","name":"Nair, Shruti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reshma","familyName":"Sekhar","name":"Sekhar, Reshma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddharth","familyName":"Manohar","name":"Manohar, Siddharth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahul","familyName":"Hemrajani","name":"Hemrajani, Rahul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pushpak","familyName":"Bhattacharyya","name":"Bhattacharyya, Pushpak","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HalluDetect: Detecting, Mitigating, and Benchmarking Hallucinations in Conversational Systems in the Legal Domain"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T06:23:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:04:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-12T05:15:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:52:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are widely used in industry but remain prone to hallucinations, limiting their reliability in critical applications. This work addresses hallucination reduction in consumer grievance chatbots built using LLaMA 3.1 8B Instruct, a compact model frequently used in industry. We develop HalluDetect, an LLM-based hallucination detection system that achieves an F1 score of 68.92% outperforming baseline detectors by 22.47%. Benchmarking five hallucination mitigation architectures, we find that out of them, AgentBot minimizes hallucinations to 0.4159 per turn while maintaining the highest token accuracy (96.13%), making it the most effective mitigation strategy. Our findings provide a scalable framework for hallucination mitigation, demonstrating that optimized inference strategies can significantly improve factual accuracy."},{"descriptionType":"Other","description":"7 pages + references + appendix, 3 figures, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11619","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:55Z","registered":"2025-09-16T03:06:55Z","published":null,"updated":"2025-10-14T04:21:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11552","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11552","identifiers":[{"identifier":"2509.11552","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wensheng","familyName":"Lu","name":"Lu, Wensheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keyu","familyName":"Chen","name":"Chen, Keyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruizhi","familyName":"Qiao","name":"Qiao, Ruizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Sun","name":"Sun, Xing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HiChunk: Evaluating and Enhancing Retrieval-Augmented Generation with Hierarchical Chunking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T03:32:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:00:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T12:36:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:44:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-09T14:21:50Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-10T00:59:06Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) enhances the response capabilities of language models by integrating external knowledge sources. However, document chunking as an important part of RAG system often lacks effective evaluation tools. This paper first analyzes why existing RAG evaluation benchmarks are inadequate for assessing document chunking quality, specifically due to evidence sparsity. Based on this conclusion, we propose HiCBench, which includes manually annotated multi-level document chunking points, synthesized evidence-dense quetion answer(QA) pairs, and their corresponding evidence sources. Additionally, we introduce the HiChunk framework, a multi-level document structuring framework based on fine-tuned LLMs, combined with the Auto-Merge retrieval algorithm to improve retrieval quality. Experiments demonstrate that HiCBench effectively evaluates the impact of different chunking methods across the entire RAG pipeline. Moreover, HiChunk achieves better chunking quality within reasonable time consumption, thereby enhancing the overall performance of RAG systems."},{"descriptionType":"Other","description":"17 pages, 5 figures, 6 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11552","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:05:22Z","registered":"2025-09-16T03:05:22Z","published":null,"updated":"2025-10-10T02:37:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11662","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11662","identifiers":[{"identifier":"2509.11662","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Feilong","familyName":"Chen","name":"Chen, Feilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijiang","familyName":"Liu","name":"Liu, Yijiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Huang","name":"Huang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miren","familyName":"Tian","name":"Tian, Miren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ya-Qi","familyName":"Yu","name":"Yu, Ya-Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghui","familyName":"Liao","name":"Liao, Minghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jihao","familyName":"Wu","name":"Wu, Jihao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MindVL: Towards Efficient and Effective Training of Multimodal Large Language Models on Ascend NPUs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T08:00:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:08:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-29T09:44:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T01:49:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-30T02:27:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-01T00:25:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose MindVL, a multimodal large language model (MLLMs) trained on Ascend NPUs. The training of state-of-the-art MLLMs is often confined to a limited set of hardware platforms and relies heavily on massive, undisclosed data recipes, which hinders reproducibility and open research. To change the common perception that Ascend hardware is unsuitable for efficient full-stage MLLM training, we introduce MindSpeed-MLLM, a highly efficient training framework that supports stable and high-performance training of large-scale Dense and Mixture-of-Experts (MoE) models on Ascend hardware. Based on this, we provide a systematic and open description of the data production methods and mixing strategies for all training stages. Furthermore, we present MindVL, a data-efficient multimodal large language model trained end-to-end on Ascend NPUs. In addition, we find that averaging weights from checkpoints trained with different sequence lengths is particularly effective and yields further gains when combined with test-time resolution search. Our experiments demonstrate superior data efficiency: MindVL-8B matches the performance of Qwen2.5VL-7B using only 10\\% of its training data, while our MoE model, MindVL-671B-A37B, matches Qwen2.5VL-72B using only 3\\% of the Qwen2.5VL training data, and achieves comparable performance with other leading multimodal MoE models. Our work provides the community with a valuable hardware alternative, open data recipes, and effective performance-enhancing techniques."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11662","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:08:01Z","registered":"2025-09-16T03:08:02Z","published":null,"updated":"2025-10-01T03:00:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11941","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11941","identifiers":[{"identifier":"2509.11941","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ilia","familyName":"Kopanichuk","name":"Kopanichuk, Ilia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Petr","familyName":"Anokhin","name":"Anokhin, Petr","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladimir","familyName":"Shaposhnikov","name":"Shaposhnikov, Vladimir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladimir","familyName":"Makharev","name":"Makharev, Vladimir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ekaterina","familyName":"Tsapieva","name":"Tsapieva, Ekaterina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iaroslav","familyName":"Bespalov","name":"Bespalov, Iaroslav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dmitry V.","familyName":"Dylov","name":"Dylov, Dmitry V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ivan","familyName":"Oseledets","name":"Oseledets, Ivan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How to Evaluate Medical AI"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-15T14:01:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:25:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T09:31:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:36:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The integration of artificial intelligence (AI) into medical diagnostic workflows requires robust and consistent evaluation methods to ensure reliability, clinical relevance, and the inherent variability in expert judgments. Traditional metrics like precision and recall often fail to account for the inherent variability in expert judgments, leading to inconsistent assessments of AI performance. Inter-rater agreement statistics like Cohen's Kappa are more reliable but they lack interpretability. We introduce Relative Precision and Recall of Algorithmic Diagnostics (RPAD and RRAD) - a new evaluation metrics that compare AI outputs against multiple expert opinions rather than a single reference. By normalizing performance against inter-expert disagreement, these metrics provide a more stable and realistic measure of the quality of predicted diagnosis. In addition to the comprehensive analysis of diagnostic quality measures, our study contains a very important side result. Our evaluation methodology allows us to avoid selecting diagnoses from a limited list when evaluating a given case. Instead, both the models being tested and the examiners verifying them arrive at a free-form diagnosis. In this automated methodology for establishing the identity of free-form clinical diagnoses, a remarkable 98% accuracy becomes attainable. We evaluate our approach using 360 medical dialogues, comparing multiple large language models (LLMs) against a panel of physicians. Large-scale study shows that top-performing models, such as DeepSeek-V3, achieve consistency on par with or exceeding expert consensus. Moreover, we demonstrate that expert judgments exhibit significant variability - often greater than that between AI and humans. This finding underscores the limitations of any absolute metrics and supports the need to adopt relative metrics in medical AI."},{"descriptionType":"Other","description":"10 pages, 7 fugures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11941","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:15:01Z","registered":"2025-09-16T03:15:01Z","published":null,"updated":"2025-09-26T02:15:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11543","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11543","identifiers":[{"identifier":"2509.11543","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengxi","familyName":"Lu","name":"Lu, Zhengxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiabo","familyName":"Ye","name":"Ye, Jiabo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Tang","name":"Tang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongliang","familyName":"Shen","name":"Shen, Yongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyang","familyName":"Xu","name":"Xu, Haiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziwei","familyName":"Zheng","name":"Zheng, Ziwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiming","familyName":"Lu","name":"Lu, Weiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Yan","name":"Yan, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Huang","name":"Huang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Xiao","name":"Xiao, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueting","familyName":"Zhuang","name":"Zhuang, Yueting","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UI-S1: Advancing GUI Automation via Semi-online Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T03:24:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:59:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T15:05:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:55:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Graphical User Interface (GUI) agents have demonstrated remarkable progress in automating complex user interface interactions through reinforcement learning. However, current approaches face a fundamental dilemma: offline RL enables stable training on pre-collected trajectories, but struggles with multi-step task execution for lack of trajectory-level reward signals; online RL captures these signals through environment interaction, but suffers from sparse rewards and prohibitive deployment costs. To address it, we present Semi-online Reinforcement Learning, a novel paradigm that simulates online RL on offline trajectories. During each rollout process, we preserve the original model output within the multi-turn dialogue, where a Patch Module adaptively recovers the divergence between rollout and expert trajectories. To capture long-term training signals, Semi-online RL introduces discounted future returns into the reward computation and optimizes the policy with weighted step-level and episode-level advantages. We further introduce Semi-Online Performance (SOP), a metric that aligns better with true online performance, serving as a practical and effective proxy for real-world evaluation. Experiments show that ours Semi-online RL achieves SOTA performance among 7B models across four dynamic benchmarks, with significant gains over the base model (e.g., +12.0% on AndroidWorld, +23.8% on AITW), demonstrating significant progress in bridging the gap between offline training efficiency and online multi-turn reasoning. The code is available at https://github.com/X-PLUG/MobileAgent/tree/main/UI-S1."},{"descriptionType":"Other","description":"22 pages, 17 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11543","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:05:09Z","registered":"2025-09-16T03:05:10Z","published":null,"updated":"2025-09-25T02:28:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11686","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11686","identifiers":[{"identifier":"2509.11686","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jian","familyName":"Wang","name":"Wang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofei","familyName":"Xie","name":"Xie, Xiaofei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Hu","name":"Hu, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shangqing","familyName":"Liu","name":"Liu, Shangqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Li","name":"Li, Yi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do Code Semantics Help? A Comprehensive Study on Execution Trace-Based Information for Code Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T08:38:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:09:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-18T11:44:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-19T00:36:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-24T07:06:41Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-25T00:29:37Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Code Large Language Models (Code LLMs) have opened a new era in programming with their impressive capabilities. However, recent research has revealed critical limitations in their ability to reason about runtime behavior and understand the actual functionality of programs, which poses significant challenges for their post-training and practical deployment. Specifically, Code LLMs encounter two principal issues: (1) a lack of proficiency in reasoning about program execution behavior, as they struggle to interpret what programs actually do during runtime, and (2) the inconsistent and fragmented representation of semantic information, such as execution traces, across existing methods, which hinders their ability to generalize and reason effectively. These challenges underscore the necessity for more systematic approaches to enhance the reasoning capabilities of Code LLMs. To address these issues, we introduce a generic framework to support integrating semantic information~(e.g., execution trace) to code task-relevant prompts, and conduct a comprehensive study to explore the role of semantic information in enhancing the reasoning ability of Code LLMs accordingly. Specifically, we focus on investigating the usefulness of trace-based semantic information in boosting supervised fine-tuning~(SFT) and post-phase inference of Code LLMs. The experimental results surprisingly disagree with previous works and demonstrate that semantic information has limited usefulness for SFT and test time scaling of Code LLM."},{"descriptionType":"Other","description":"EMNLP2025-findings https://openreview.net/forum?id=d4ICISW2T4"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11686","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:08:37Z","registered":"2025-09-16T03:08:38Z","published":null,"updated":"2025-09-25T02:25:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11815","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11815","identifiers":[{"identifier":"2509.11815","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haiduo","familyName":"Huang","name":"Huang, Haiduo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuwei","familyName":"Yang","name":"Yang, Fuwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenhua","familyName":"Liu","name":"Liu, Zhenhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanwu","familyName":"Yin","name":"Yin, Xuanwu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Li","name":"Li, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengju","familyName":"Ren","name":"Ren, Pengju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emad","familyName":"Barsoum","name":"Barsoum, Emad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SpecVLM: Fast Speculative Decoding in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:53:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:18:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-21T03:35:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T00:45:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Speculative decoding is a powerful way to accelerate autoregressive large language models (LLMs), but directly porting it to vision-language models (VLMs) faces unique systems constraints: the prefill stage is dominated by visual tokens whose count scales with image resolution and video length, inflating both compute and memory, especially the key-value (KV) cache. We study speculative decoding for VLMs and introduce SpecVLM, a practical system that (1) establishes a strong EAGLE-2-style baseline, EagleVLM, delivering 1.5--2.3x end-to-end speedups over full autoregressive inference, and (2) further accelerates VLM inference with an elastic visual compressor that adaptively selects among pruning, pooling, convolution, and resampler primitives to balance FLOPs/parameters and accuracy per input. To avoid costly offline distillation corpora, we propose an online-logit distillation protocol that trains the draft model with on-the-fly teacher logits and penultimate features using a combined cross-entropy and Smooth L1 objective, eliminating storage and preprocessing while remaining compute-efficient. This protocol reveals a training-time scaling effect: longer online training monotonically increases the draft model's average accepted length, improving speculative efficiency. Empirically, SpecVLM achieves additional acceleration, culminating in 2.5--2.9x end-to-end speedups within 5 epochs across LLaVA and MMMU, consistently over resolutions and task difficulties, while preserving the target model's output distribution (lossless decoding). Our code is available at https://github.com/haiduo/SpecVLM."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11815","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:51Z","registered":"2025-09-16T03:11:52Z","published":null,"updated":"2025-09-23T03:56:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11860","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11860","identifiers":[{"identifier":"2509.11860","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weishu","familyName":"Chen","name":"Chen, Weishu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyi","familyName":"Tang","name":"Tang, Jinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhouhui","familyName":"Hou","name":"Hou, Zhouhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihao","familyName":"Han","name":"Han, Shihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjie","familyName":"Zhan","name":"Zhan, Mingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Huang","name":"Huang, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Delong","familyName":"Liu","name":"Liu, Delong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Guo","name":"Guo, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhicheng","familyName":"Zhao","name":"Zhao, Zhicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Su","name":"Su, Fei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MOOM: Maintenance, Organization and Optimization of Memory in Ultra-Long Role-Playing Dialogues"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:35:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T07:36:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:28:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Memory extraction is crucial for maintaining coherent ultra-long dialogues in human-robot role-playing scenarios. However, existing methods often exhibit uncontrolled memory growth. To address this, we propose MOOM, the first dual-branch memory plugin that leverages literary theory by modeling plot development and character portrayal as core storytelling elements. Specifically, one branch summarizes plot conflicts across multiple time scales, while the other extracts the user's character profile. MOOM further integrates a forgetting mechanism, inspired by the ``competition-inhibition'' memory theory, to constrain memory capacity and mitigate uncontrolled growth. Furthermore, we present ZH-4O, a Chinese ultra-long dialogue dataset specifically designed for role-playing, featuring dialogues that average 600 turns and include manually annotated memory information. Experimental results demonstrate that MOOM outperforms all state-of-the-art memory extraction methods, requiring fewer large language model invocations while maintaining a controllable memory capacity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11860","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:12:56Z","registered":"2025-09-16T03:12:57Z","published":null,"updated":"2025-09-18T17:46:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11939","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11939","identifiers":[{"identifier":"2509.11939","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuning","familyName":"Zhang","name":"Zhang, Shuning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutong","familyName":"Jiang","name":"Jiang, Yutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongjun","familyName":"Ma","name":"Ma, Rongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuting","familyName":"Yang","name":"Yang, Yuting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyao","familyName":"Xu","name":"Xu, Mingyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhixin","familyName":"Huang","name":"Huang, Zhixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Yi","name":"Yi, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hewu","familyName":"Li","name":"Li, Hewu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PrivWeb: Unobtrusive and Content-aware Privacy Protection For Web Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T13:58:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:25:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While web agents gained popularity by automating web interactions, their requirement for interface access introduces significant privacy risks that are understudied, particularly from users' perspective. Through a formative study (N=15), we found users frequently misunderstand agents' data practices, and desired unobtrusive, transparent data management. To achieve this, we designed and implemented PrivWeb, a trusted add-on on web agents that utilizes a localized LLM to anonymize private information on interfaces according to user preferences. It features privacy categorization schema and adaptive notifications that selectively pauses tasks for user control over information collection for highly sensitive information, while offering non-disruptive options for less sensitive information, minimizing human oversight. The user study (N=14) across travel, information retrieval, shopping, and entertainment tasks compared PrivWeb with baselines without notification and without control for private information access, where PrivWeb reduced perceived privacy risks with no associated increase in cognitive effort, and resulted in higher overall satisfaction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11939","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:14:57Z","registered":"2025-09-16T03:14:58Z","published":null,"updated":"2025-09-16T03:14:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11930","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11930","identifiers":[{"identifier":"2509.11930","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruijia","familyName":"Liu","name":"Liu, Ruijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ancheng","familyName":"Hou","name":"Hou, Ancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoyuan","familyName":"Li","name":"Li, Shaoyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Yin","name":"Yin, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VH-Diffuser: Variable Horizon Diffusion Planner for Time-Aware Goal-Conditioned Trajectory Planning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T13:46:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:24:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion-based planners have gained significant recent attention for their robustness and performance in long-horizon tasks. However, most existing planners rely on a fixed, pre-specified horizon during both training and inference. This rigidity often produces length-mismatch (trajectories that are too short or too long) and brittle performance across instances with varying geometric or dynamical difficulty. In this paper, we introduce the Variable Horizon Diffuser (VHD) framework, which treats the horizon as a learned variable rather than a fixed hyperparameter. Given a start-goal pair, we first predict an instance-specific horizon using a learned Length Predictor model, which guides a Diffusion Planner to generate a trajectory of the desired length. Our design maintains compatibility with existing diffusion planners by controlling trajectory length through initial noise shaping and training on randomly cropped sub-trajectories, without requiring architectural changes. Empirically, VHD improves success rates and path efficiency in maze-navigation and robot-arm control benchmarks, showing greater robustness to horizon mismatch and unseen lengths, while keeping training simple and offline-only."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11930","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:14:41Z","registered":"2025-09-16T03:14:42Z","published":null,"updated":"2025-09-16T03:14:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11885","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11885","identifiers":[{"identifier":"2509.11885","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Francis Xiatian","familyName":"Zhang","name":"Zhang, Francis Xiatian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emile","familyName":"Mackute","name":"Mackute, Emile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammadreza","familyName":"Kasaei","name":"Kasaei, Mohammadreza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kevin","familyName":"Dhaliwal","name":"Dhaliwal, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Thomson","name":"Thomson, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohsen","familyName":"Khadem","name":"Khadem, Mohsen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BREA-Depth: Bronchoscopy Realistic Airway-geometric Depth Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T13:02:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:22:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Monocular depth estimation in bronchoscopy can significantly improve real-time navigation accuracy and enhance the safety of interventions in complex, branching airways. Recent advances in depth foundation models have shown promise for endoscopic scenarios, yet these models often lack anatomical awareness in bronchoscopy, overfitting to local textures rather than capturing the global airway structure, particularly under ambiguous depth cues and poor lighting. To address this, we propose Brea-Depth, a novel framework that integrates airway-specific geometric priors into foundation model adaptation for bronchoscopic depth estimation. Our method introduces a depth-aware CycleGAN, refining the translation between real bronchoscopic images and airway geometries from anatomical data, effectively bridging the domain gap. In addition, we introduce an airway structure awareness loss to enforce depth consistency within the airway lumen while preserving smooth transitions and structural integrity. By incorporating anatomical priors, Brea-Depth enhances model generalization and yields more robust, accurate 3D airway reconstructions. To assess anatomical realism, we introduce Airway Depth Structure Evaluation, a new metric for structural consistency. We validate BREA-Depth on a collected ex vivo human lung dataset and an open bronchoscopic dataset, where it outperforms existing methods in anatomical depth preservation."},{"descriptionType":"Other","description":"The paper has been accepted to MICCAI 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11885","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:13:31Z","registered":"2025-09-16T03:13:32Z","published":null,"updated":"2025-09-16T03:13:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11880","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11880","identifiers":[{"identifier":"2509.11880","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Carlos","familyName":"Celemin","name":"Celemin, Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph","familyName":"Brennan","name":"Brennan, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pierluigi Vito","familyName":"Amadori","name":"Amadori, Pierluigi Vito","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tim","familyName":"Bradley","name":"Bradley, Tim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Representations in Video Game Agents with Supervised Contrastive Imitation Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T13:00:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:21:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/cog64752.2025.11114174","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces a novel application of Supervised Contrastive Learning (SupCon) to Imitation Learning (IL), with a focus on learning more effective state representations for agents in video game environments. The goal is to obtain latent representations of the observations that capture better the action-relevant factors, thereby modeling better the cause-effect relationship from the observations that are mapped to the actions performed by the demonstrator, for example, the player jumps whenever an obstacle appears ahead. We propose an approach to integrate the SupCon loss with continuous output spaces, enabling SupCon to operate without constraints regarding the type of actions of the environment. Experiments on the 3D games Astro Bot and Returnal, and multiple 2D Atari games show improved representation quality, faster learning convergence, and better generalization compared to baseline models trained only with supervised action prediction loss functions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11880","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:13:24Z","registered":"2025-09-16T03:13:25Z","published":null,"updated":"2025-09-16T03:13:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11868","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11868","identifiers":[{"identifier":"2509.11868","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sabrina","familyName":"Patania","name":"Patania, Sabrina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Annese","name":"Annese, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Lambiase","name":"Lambiase, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anita","familyName":"Pellegrini","name":"Pellegrini, Anita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom","familyName":"Foulsham","name":"Foulsham, Tom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Azzurra","familyName":"Ruggeri","name":"Ruggeri, Azzurra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silvia","familyName":"Rossi","name":"Rossi, Silvia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silvia","familyName":"Serino","name":"Serino, Silvia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dimitri","familyName":"Ognibene","name":"Ognibene, Dimitri","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Growing Perspectives: Modelling Embodied Perspective Taking and Inner Narrative Development Using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2; I.2.7; I.2.10; J.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-15T12:39:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Language and embodied perspective taking are essential for human collaboration, yet few computational models address both simultaneously. This work investigates the PerspAct system [1], which integrates the ReAct (Reason and Act) paradigm with Large Language Models (LLMs) to simulate developmental stages of perspective taking, grounded in Selman's theory [2]. Using an extended director task, we evaluate GPT's ability to generate internal narratives aligned with specified developmental stages, and assess how these influence collaborative performance both qualitatively (action selection) and quantitatively (task efficiency). Results show that GPT reliably produces developmentally-consistent narratives before task execution but often shifts towards more advanced stages during interaction, suggesting that language exchanges help refine internal representations. Higher developmental stages generally enhance collaborative effectiveness, while earlier stages yield more variable outcomes in complex contexts. These findings highlight the potential of integrating embodied perspective taking and language in LLMs to better model developmental dynamics and stress the importance of evaluating internal speech during combined linguistic and embodied tasks."},{"descriptionType":"Other","description":"Accepted at ICDL https://icdl2025.fel.cvut.cz/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11868","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:13:08Z","registered":"2025-09-16T03:13:08Z","published":null,"updated":"2025-09-16T03:13:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11865","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11865","identifiers":[{"identifier":"2509.11865","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Travis","familyName":"Davies","name":"Davies, Travis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiqi","familyName":"Huang","name":"Huang, Yiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunxin","familyName":"Liu","name":"Liu, Yunxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huxian","familyName":"Liu","name":"Liu, Huxian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luhui","familyName":"Hu","name":"Hu, Luhui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tenma: Robust Cross-Embodiment Robot Manipulation with Diffusion Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:39:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Scaling Transformer policies and diffusion models has advanced robotic manipulation, yet combining these techniques in lightweight, cross-embodiment learning settings remains challenging. We study design choices that most affect stability and performance for diffusion-transformer policies trained on heterogeneous, multimodal robot data, and introduce Tenma, a lightweight diffusion-transformer for bi-manual arm control. Tenma integrates multiview RGB, proprioception, and language via a cross-embodiment normalizer that maps disparate state/action spaces into a shared latent space; a Joint State-Time encoder for temporally aligned observation learning with inference speed boosts; and a diffusion action decoder optimized for training stability and learning capacity. Across benchmarks and under matched compute, Tenma achieves an average success rate of 88.95% in-distribution and maintains strong performance under object and scene shifts, substantially exceeding baseline policies whose best in-distribution average is 18.12%. Despite using moderate data scale, Tenma delivers robust manipulation and generalization, indicating the great potential for multimodal and cross-embodiment learning strategies for further augmenting the capacity of transformer-based imitation learning policies."},{"descriptionType":"Other","description":"8 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11865","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:13:03Z","registered":"2025-09-16T03:13:04Z","published":null,"updated":"2025-09-16T03:13:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11862","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11862","identifiers":[{"identifier":"2509.11862","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haodi","familyName":"Ma","name":"Ma, Haodi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vyom","familyName":"Pathak","name":"Pathak, Vyom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daisy Zhe","familyName":"Wang","name":"Wang, Daisy Zhe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bridging Vision Language Models and Symbolic Grounding for Video Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:35:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Video Question Answering (VQA) requires models to reason over spatial, temporal, and causal cues in videos. Recent vision language models (VLMs) achieve strong results but often rely on shallow correlations, leading to weak temporal grounding and limited interpretability. We study symbolic scene graphs (SGs) as intermediate grounding signals for VQA. SGs provide structured object-relation representations that complement VLMs holistic reasoning. We introduce SG-VLM, a modular framework that integrates frozen VLMs with scene graph grounding via prompting and visual localization. Across three benchmarks (NExT-QA, iVQA, ActivityNet-QA) and multiple VLMs (QwenVL, InternVL), SG-VLM improves causal and temporal reasoning and outperforms prior baselines, though gains over strong VLMs are limited. These findings highlight both the promise and current limitations of symbolic grounding, and offer guidance for future hybrid VLM-symbolic approaches in video understanding."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11862","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:12:59Z","registered":"2025-09-16T03:12:59Z","published":null,"updated":"2025-09-16T03:12:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11840","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11840","identifiers":[{"identifier":"2509.11840","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tim","familyName":"Lebailly","name":"Lebailly, Tim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vijay","familyName":"Veerabadran","name":"Veerabadran, Vijay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satwik","familyName":"Kottur","name":"Kottur, Satwik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karl","familyName":"Ridgeway","name":"Ridgeway, Karl","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael Louis","familyName":"Iuzzolino","name":"Iuzzolino, Michael Louis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synthetic Captions for Open-Vocabulary Zero-Shot Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:26:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative vision-language models (VLMs) exhibit strong high-level image understanding but lack spatially dense alignment between vision and language modalities, as our findings indicate. Orthogonal to advancements in generative VLMs, another line of research has focused on representation learning for vision-language alignment, targeting zero-shot inference for dense tasks like segmentation. In this work, we bridge these two directions by densely aligning images with synthetic descriptions generated by VLMs. Synthetic captions are inexpensive, scalable, and easy to generate, making them an excellent source of high-level semantic understanding for dense alignment methods. Empirically, our approach outperforms prior work on standard zero-shot open-vocabulary segmentation benchmarks/datasets, while also being more data-efficient."},{"descriptionType":"Other","description":"ICCV 2025 CDEL Workshop"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11840","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:12:28Z","registered":"2025-09-16T03:12:28Z","published":null,"updated":"2025-09-16T03:12:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11803","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11803","identifiers":[{"identifier":"2509.11803","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eden","familyName":"Mama","name":"Mama, Eden","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liel","familyName":"Sheri","name":"Sheri, Liel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yehudit","familyName":"Aperstein","name":"Aperstein, Yehudit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Apartsin","name":"Apartsin, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Fuzzy Speech to Medical Insight: Benchmarking LLMs on Noisy Patient Narratives"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:34:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:17:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The widespread adoption of large language models (LLMs) in healthcare raises critical questions about their ability to interpret patient-generated narratives, which are often informal, ambiguous, and noisy. Existing benchmarks typically rely on clean, structured clinical text, offering limited insight into model performance under realistic conditions. In this work, we present a novel synthetic dataset designed to simulate patient self-descriptions characterized by varying levels of linguistic noise, fuzzy language, and layperson terminology. Our dataset comprises clinically consistent scenarios annotated with ground-truth diagnoses, spanning a spectrum of communication clarity to reflect diverse real-world reporting styles. Using this benchmark, we fine-tune and evaluate several state-of-the-art models (LLMs), including BERT-based and encoder-decoder T5 models. To support reproducibility and future research, we release the Noisy Diagnostic Benchmark (NDB), a structured dataset of noisy, synthetic patient descriptions designed to stress-test and compare the diagnostic capabilities of large language models (LLMs) under realistic linguistic conditions. We made the benchmark available for the community: https://github.com/lielsheri/PatientSignal"},{"descriptionType":"Other","description":"6 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11803","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:33Z","registered":"2025-09-16T03:11:33Z","published":null,"updated":"2025-09-16T03:11:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11796","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11796","identifiers":[{"identifier":"2509.11796","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haodong","familyName":"Chen","name":"Chen, Haodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haojian","familyName":"Huang","name":"Huang, Haojian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"XinXiang","familyName":"Yin","name":"Yin, XinXiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dian","familyName":"Shao","name":"Shao, Dian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FineQuest: Adaptive Knowledge-Assisted Sports Video Understanding via Agent-of-Thoughts Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:27:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:17:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Video Question Answering (VideoQA) based on Large Language Models (LLMs) has shown potential in general video understanding but faces significant challenges when applied to the inherently complex domain of sports videos. In this work, we propose FineQuest, the first training-free framework that leverages dual-mode reasoning inspired by cognitive science: i) Reactive Reasoning for straightforward sports queries and ii) Deliberative Reasoning for more complex ones. To bridge the knowledge gap between general-purpose models and domain-specific sports understanding, FineQuest incorporates SSGraph, a multimodal sports knowledge scene graph spanning nine sports, which encodes both visual instances and domain-specific terminology to enhance reasoning accuracy. Furthermore, we introduce two new sports VideoQA benchmarks, Gym-QA and Diving-QA, derived from the FineGym and FineDiving datasets, enabling diverse and comprehensive evaluation. FineQuest achieves state-of-the-art performance on these benchmarks as well as the existing SPORTU dataset, while maintains strong general VideoQA capabilities."},{"descriptionType":"Other","description":"ACM MM 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11796","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:23Z","registered":"2025-09-16T03:11:24Z","published":null,"updated":"2025-09-16T03:11:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11766","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11766","identifiers":[{"identifier":"2509.11766","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andy","familyName":"Zhai","name":"Zhai, Andy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brae","familyName":"Liu","name":"Liu, Brae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bruno","familyName":"Fang","name":"Fang, Bruno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chalse","familyName":"Cai","name":"Cai, Chalse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ellie","familyName":"Ma","name":"Ma, Ellie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ethan","familyName":"Yin","name":"Yin, Ethan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hugo","familyName":"Zhou","name":"Zhou, Hugo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Wang","name":"Wang, James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lights","familyName":"Shi","name":"Shi, Lights","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucy","familyName":"Liang","name":"Liang, Lucy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Make","familyName":"Wang","name":"Wang, Make","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Wang","name":"Wang, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roy","familyName":"Gan","name":"Gan, Roy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Yu","name":"Yu, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shalfun","familyName":"Li","name":"Li, Shalfun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Starrick","familyName":"Liu","name":"Liu, Starrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sylas","familyName":"Chen","name":"Chen, Sylas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vincent","familyName":"Chen","name":"Chen, Vincent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zach","familyName":"Xu","name":"Xu, Zach","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Igniting VLMs toward the Embodied Space"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T10:40:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:15:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While foundation models show remarkable progress in language and vision, existing vision-language models (VLMs) still have limited spatial and embodiment understanding. Transferring VLMs to embodied domains reveals fundamental mismatches between modalities, pretraining distributions, and training objectives, leaving action comprehension and generation as a central bottleneck on the path to AGI.\n We introduce WALL-OSS, an end-to-end embodied foundation model that leverages large-scale multimodal pretraining to achieve (1) embodiment-aware vision-language understanding, (2) strong language-action association, and (3) robust manipulation capability.\n Our approach employs a tightly coupled architecture and multi-strategies training curriculum that enables Unified Cross-Level CoT-seamlessly unifying instruction reasoning, subgoal decomposition, and fine-grained action synthesis within a single differentiable framework.\n Our results show that WALL-OSS attains high success on complex long-horizon manipulations, demonstrates strong instruction-following capabilities, complex understanding and reasoning, and outperforms strong baselines, thereby providing a reliable and scalable path from VLMs to embodied foundation models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11766","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:10:40Z","registered":"2025-09-16T03:10:41Z","published":null,"updated":"2025-09-16T03:10:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11752","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11752","identifiers":[{"identifier":"2509.11752","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongyuan","familyName":"Zhang","name":"Zhang, Hongyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuheng","familyName":"Wu","name":"Wu, Yuheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyang","familyName":"Zhao","name":"Zhao, Mingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei","familyName":"Chen","name":"Chen, Zhiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rebecca","familyName":"Li","name":"Li, Rebecca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Zhu","name":"Zhu, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haohan","familyName":"Zhao","name":"Zhao, Haohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohua","familyName":"Yuan","name":"Yuan, Xiaohua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Yang","name":"Yang, Meng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunli","familyName":"Qiu","name":"Qiu, Chunli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Cong","name":"Cong, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyan","familyName":"Chen","name":"Chen, Haiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lina","familyName":"Luan","name":"Luan, Lina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Randolph H. L.","familyName":"Wong","name":"Wong, Randolph H. L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huai","familyName":"Liao","name":"Liao, Huai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Colin A","familyName":"Graham","name":"Graham, Colin A","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shi","familyName":"Chang","name":"Chang, Shi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guowei","familyName":"Tao","name":"Tao, Guowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yi","name":"Yi, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Lei","name":"Lei, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nassir","familyName":"Navab","name":"Navab, Nassir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastien","familyName":"Ourselin","name":"Ourselin, Sebastien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiebo","familyName":"Luo","name":"Luo, Jiebo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongbin","familyName":"Liu","name":"Liu, Hongbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaofeng","familyName":"Meng","name":"Meng, Gaofeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Fully Open and Generalizable Foundation Model for Ultrasound Clinical Applications"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T10:05:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:13:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial intelligence (AI) that can effectively learn ultrasound representations by integrating multi-source data holds significant promise for advancing clinical care. However, the scarcity of large labeled datasets in real-world clinical environments and the limited generalizability of task-specific models have hindered the development of generalizable clinical AI models for ultrasound applications. In this study, we present EchoCare, a novel ultrasound foundation model for generalist clinical use, developed via self-supervised learning on our curated, publicly available, large-scale dataset EchoCareData. EchoCareData comprises 4.5 million ultrasound images, sourced from over 23 countries across 5 continents and acquired via a diverse range of distinct imaging devices, thus encompassing global cohorts that are multi-center, multi-device, and multi-ethnic. Unlike prior studies that adopt off-the-shelf vision foundation model architectures, we introduce a hierarchical classifier into EchoCare to enable joint learning of pixel-level and representation-level features, capturing both global anatomical contexts and local ultrasound characteristics. With minimal training, EchoCare outperforms state-of-the-art comparison models across 10 representative ultrasound benchmarks of varying diagnostic difficulties, spanning disease diagnosis, lesion segmentation, organ detection, landmark prediction, quantitative regression, imaging enhancement and report generation. The code and pretrained model are publicly released, rendering EchoCare accessible for fine-tuning and local adaptation, supporting extensibility to additional applications. EchoCare provides a fully open and generalizable foundation model to boost the development of AI technologies for diverse clinical ultrasound applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11752","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:10:18Z","registered":"2025-09-16T03:10:19Z","published":null,"updated":"2025-09-16T03:10:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11724","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11724","identifiers":[{"identifier":"2509.11724","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wa-Kin","familyName":"Lei","name":"Lei, Wa-Kin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun-Cheng","familyName":"Chen","name":"Chen, Jun-Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shang-Tse","familyName":"Chen","name":"Chen, Shang-Tse","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DRAG: Data Reconstruction Attack using Guided Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T09:26:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:12:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rise of large foundation models, split inference (SI) has emerged as a popular computational paradigm for deploying models across lightweight edge devices and cloud servers, addressing data privacy and computational cost concerns. However, most existing data reconstruction attacks have focused on smaller CNN classification models, leaving the privacy risks of foundation models in SI settings largely unexplored. To address this gap, we propose a novel data reconstruction attack based on guided diffusion, which leverages the rich prior knowledge embedded in a latent diffusion model (LDM) pre-trained on a large-scale dataset. Our method performs iterative reconstruction on the LDM's learned image prior, effectively generating high-fidelity images resembling the original data from their intermediate representations (IR). Extensive experiments demonstrate that our approach significantly outperforms state-of-the-art methods, both qualitatively and quantitatively, in reconstructing data from deep-layer IRs of the vision foundation model. The results highlight the urgent need for more robust privacy protection mechanisms for large models in SI scenarios. Code is available at: https://github.com/ntuaislab/DRAG."},{"descriptionType":"Other","description":"ICML 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11724","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:09:35Z","registered":"2025-09-16T03:09:36Z","published":null,"updated":"2025-09-16T03:09:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11687","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11687","identifiers":[{"identifier":"2509.11687","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Di","familyName":"Jin","name":"Jin, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Yang","name":"Yang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobao","familyName":"Wang","name":"Wang, Xiaobao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junwei","familyName":"Zhang","name":"Zhang, Junwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuqi","familyName":"Li","name":"Li, Shuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongxiao","familyName":"He","name":"He, Dongxiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Dynamic Knowledge Update-Driven Model with Large Language Models for Fake News Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T08:38:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:09:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As the Internet and social media evolve rapidly, distinguishing credible news from a vast amount of complex information poses a significant challenge. Due to the suddenness and instability of news events, the authenticity labels of news can potentially shift as events develop, making it crucial for fake news detection to obtain the latest event updates. Existing methods employ retrieval-augmented generation to fill knowledge gaps, but they suffer from issues such as insufficient credibility of retrieved content and interference from noisy information. We propose a dynamic knowledge update-driven model for fake news detection (DYNAMO), which leverages knowledge graphs to achieve continuous updating of new knowledge and integrates with large language models to fulfill dual functions: news authenticity detection and verification of new knowledge correctness, solving the two key problems of ensuring the authenticity of new knowledge and deeply mining news semantics. Specifically, we first construct a news-domain-specific knowledge graph. Then, we use Monte Carlo Tree Search to decompose complex news and verify them step by step. Finally, we extract and update new knowledge from verified real news texts and reasoning paths. Experimental results demonstrate that DYNAMO achieves the best performance on two real-world datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11687","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:08:39Z","registered":"2025-09-16T03:08:39Z","published":null,"updated":"2025-09-16T03:08:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11628","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11628","identifiers":[{"identifier":"2509.11628","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiacheng","familyName":"Liu","name":"Liu, Jiacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Zou","name":"Zou, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanhuiyi","familyName":"Lyu","name":"Lyu, Yuanhuiyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Ren","name":"Ren, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaobo","familyName":"Wang","name":"Wang, Shaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaixin","familyName":"Li","name":"Li, Kaixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linfeng","familyName":"Zhang","name":"Zhang, Linfeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SpeCa: Accelerating Diffusion Transformers with Speculative Feature Caching"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T06:46:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:05:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3746027.3755331","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have revolutionized high-fidelity image and video synthesis, yet their computational demands remain prohibitive for real-time applications. These models face two fundamental challenges: strict temporal dependencies preventing parallelization, and computationally intensive forward passes required at each denoising step. Drawing inspiration from speculative decoding in large language models, we present SpeCa, a novel 'Forecast-then-verify' acceleration framework that effectively addresses both limitations. SpeCa's core innovation lies in introducing Speculative Sampling to diffusion models, predicting intermediate features for subsequent timesteps based on fully computed reference timesteps. Our approach implements a parameter-free verification mechanism that efficiently evaluates prediction reliability, enabling real-time decisions to accept or reject each prediction while incurring negligible computational overhead. Furthermore, SpeCa introduces sample-adaptive computation allocation that dynamically modulates resources based on generation complexity, allocating reduced computation for simpler samples while preserving intensive processing for complex instances. Experiments demonstrate 6.34x acceleration on FLUX with minimal quality degradation (5.5% drop), 7.3x speedup on DiT while preserving generation fidelity, and 79.84% VBench score at 6.1x acceleration for HunyuanVideo. The verification mechanism incurs minimal overhead (1.67%-3.5% of full inference costs), establishing a new paradigm for efficient diffusion model inference while maintaining generation quality even at aggressive acceleration ratios. Our codes have been released in Github: \\textbf{https://github.com/Shenyi-Z/Cache4Diffusion}"},{"descriptionType":"Other","description":"15 pages, 9 figures, ACM Multimedia 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11628","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:07:08Z","registered":"2025-09-16T03:07:08Z","published":null,"updated":"2025-09-16T03:07:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11626","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11626","identifiers":[{"identifier":"2509.11626","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Prerna","familyName":"Agarwal","name":"Agarwal, Prerna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Himanshu","familyName":"Gupta","name":"Gupta, Himanshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soujanya","familyName":"Soni","name":"Soni, Soujanya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rohith","familyName":"Vallam","name":"Vallam, Rohith","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renuka","familyName":"Sindhgatta","name":"Sindhgatta, Renuka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sameep","familyName":"Mehta","name":"Mehta, Sameep","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automated Creation and Enrichment Framework for Improved Invocation of Enterprise APIs as Tools"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T06:41:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:05:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in Large Language Models (LLMs) has lead to the development of agents capable of complex reasoning and interaction with external tools. In enterprise contexts, the effective use of such tools that are often enabled by application programming interfaces (APIs), is hindered by poor documentation, complex input or output schema, and large number of operations. These challenges make tool selection difficult and reduce the accuracy of payload formation by up to 25%. We propose ACE, an automated tool creation and enrichment framework that transforms enterprise APIs into LLM-compatible tools. ACE, (i) generates enriched tool specifications with parameter descriptions and examples to improve selection and invocation accuracy, and (ii) incorporates a dynamic shortlisting mechanism that filters relevant tools at runtime, reducing prompt complexity while maintaining scalability. We validate our framework on both proprietary and open-source APIs and demonstrate its integration with agentic frameworks. To the best of our knowledge, ACE is the first end-to-end framework that automates the creation, enrichment, and dynamic selection of enterprise API tools for LLM agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11626","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:07:05Z","registered":"2025-09-16T03:07:06Z","published":null,"updated":"2025-09-16T03:07:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11621","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11621","identifiers":[{"identifier":"2509.11621","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiangtong","familyName":"Yao","name":"Yao, Xiangtong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yirui","familyName":"Zhou","name":"Zhou, Yirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Meng","name":"Meng, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanwen","familyName":"Liu","name":"Liu, Yanwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liangyu","familyName":"Dong","name":"Dong, Liangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zitao","familyName":"Zhang","name":"Zhang, Zitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenshan","familyName":"Bing","name":"Bing, Zhenshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Huang","name":"Huang, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuchun","familyName":"Sun","name":"Sun, Fuchun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alois","familyName":"Knoll","name":"Knoll, Alois","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Inference-stage Adaptation-projection Strategy Adapts Diffusion Policy to Cross-manipulators Scenarios"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T06:27:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:04:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion policies are powerful visuomotor models for robotic manipulation, yet they often fail to generalize to manipulators or end-effectors unseen during training and struggle to accommodate new task requirements at inference time. Addressing this typically requires costly data recollection and policy retraining for each new hardware or task configuration. To overcome this, we introduce an adaptation-projection strategy that enables a diffusion policy to perform zero-shot adaptation to novel manipulators and dynamic task settings, entirely at inference time and without any retraining. Our method first trains a diffusion policy in SE(3) space using demonstrations from a base manipulator. During online deployment, it projects the policy's generated trajectories to satisfy the kinematic and task-specific constraints imposed by the new hardware and objectives. Moreover, this projection dynamically adapts to physical differences (e.g., tool-center-point offsets, jaw widths) and task requirements (e.g., obstacle heights), ensuring robust and successful execution. We validate our approach on real-world pick-and-place, pushing, and pouring tasks across multiple manipulators, including the Franka Panda and Kuka iiwa 14, equipped with a diverse array of end-effectors like flexible grippers, Robotiq 2F/3F grippers, and various 3D-printed designs. Our results demonstrate consistently high success rates in these cross-manipulator scenarios, proving the effectiveness and practicality of our adaptation-projection strategy. The code will be released after peer review."},{"descriptionType":"Other","description":"2025 IEEE. Personal use of this material is permitted. Permission from IEEE must be obtained for all other uses, in any current or future media, including reprinting/republishing this material for advertising or promotional purposes, creating new collective works, for resale or redistribution to servers or lists, or reuse of any copyrighted component of this work in other works"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11621","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:58Z","registered":"2025-09-16T03:06:58Z","published":null,"updated":"2025-09-16T03:06:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11620","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11620","identifiers":[{"identifier":"2509.11620","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kun","familyName":"Li","name":"Li, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lai-Man","familyName":"Po","name":"Po, Lai-Man","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongzheng","familyName":"Yang","name":"Yang, Hongzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuyuan","familyName":"Xu","name":"Xu, Xuyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kangcheng","familyName":"Liu","name":"Liu, Kangcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuzhi","familyName":"Zhao","name":"Zhao, Yuzhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AesBiasBench: Evaluating Bias and Alignment in Multimodal Language Models for Personalized Image Aesthetic Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T06:25:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:04:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Large Language Models (MLLMs) are increasingly applied in Personalized Image Aesthetic Assessment (PIAA) as a scalable alternative to expert evaluations. However, their predictions may reflect subtle biases influenced by demographic factors such as gender, age, and education. In this work, we propose AesBiasBench, a benchmark designed to evaluate MLLMs along two complementary dimensions: (1) stereotype bias, quantified by measuring variations in aesthetic evaluations across demographic groups; and (2) alignment between model outputs and genuine human aesthetic preferences. Our benchmark covers three subtasks (Aesthetic Perception, Assessment, Empathy) and introduces structured metrics (IFD, NRD, AAS) to assess both bias and alignment. We evaluate 19 MLLMs, including proprietary models (e.g., GPT-4o, Claude-3.5-Sonnet) and open-source models (e.g., InternVL-2.5, Qwen2.5-VL). Results indicate that smaller models exhibit stronger stereotype biases, whereas larger models align more closely with human preferences. Incorporating identity information often exacerbates bias, particularly in emotional judgments. These findings underscore the importance of identity-aware evaluation frameworks in subjective vision-language tasks."},{"descriptionType":"Other","description":"Accepted by EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11620","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:56Z","registered":"2025-09-16T03:06:57Z","published":null,"updated":"2025-09-16T03:06:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11589","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11589","identifiers":[{"identifier":"2509.11589","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanyun","familyName":"Pu","name":"Pu, Yanyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kehan","familyName":"Li","name":"Li, Kehan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyi","familyName":"Huang","name":"Huang, Zeyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijie","familyName":"Zhong","name":"Zhong, Zhijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaixiang","familyName":"Yang","name":"Yang, Kaixiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MVQA-68K: A Multi-dimensional and Causally-annotated Dataset with Quality Interpretability for Video Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T05:16:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:03:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid advancement of video generation models such as Sora, video quality assessment (VQA) is becoming increasingly crucial for selecting high-quality videos from large-scale datasets used in pre-training. Traditional VQA methods, typically producing single numerical scores, often lack comprehensiveness and interpretability. To address these challenges, we introduce MVQA-68K, a novel multi-dimensional VQA dataset comprising over 68,000 carefully annotated videos, covering seven essential quality dimensions: overall aesthetics, camera movement, dynamic degree, texture detail, composition, visual quality, and factual consistency. Each annotation includes detailed chain-of-thought reasoning to facilitate interpretability and comprehensive understanding. Extensive experiments demonstrate that MVQA-68K significantly enhances the performance of various multimodal large language models (MLLMs) on the VQA task, achieving state-of-the-art results not only on our internal test set (Fig.1) but also on public benchmarks including LSVQ-test, LSVQ-1080p, and LIVE-VQC. Meantime, incorporating explicit reasoning process during VQA training substantially boosts the zero-shot generalization. Code and dataset will be available at github: https://github.com/Controller01-ai/MVQA-68K"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11589","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:13Z","registered":"2025-09-16T03:06:14Z","published":null,"updated":"2025-09-16T03:06:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11572","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11572","identifiers":[{"identifier":"2509.11572","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tuan","familyName":"Bui","name":"Bui, Tuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"An","familyName":"Nguyen","name":"Nguyen, An","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Phat","familyName":"Thai","name":"Thai, Phat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minh","familyName":"Hua","name":"Hua, Minh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ngan Pham L.","familyName":"N.","name":"N., Ngan Pham L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ngan Pham T.","familyName":"B.","name":"B., Ngan Pham T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dung","familyName":"Le","name":"Le, Dung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Nguyen","name":"Nguyen, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thanh-Tung","familyName":"Tran","name":"Tran, Thanh-Tung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thang","familyName":"Bui","name":"Bui, Thang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tho","familyName":"Quan","name":"Quan, Tho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Formal Reasoning for Intelligent QA Systems: A Case Study in the Educational Domain"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T04:34:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:02:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3746274.3760392","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reasoning is essential for closed-domain QA systems in which procedural correctness and policy compliance are critical. While large language models (LLMs) have shown strong performance on many reasoning tasks, recent work reveals that their reasoning traces are often unfaithful - serving more as plausible justifications than as causally grounded derivations. Efforts to combine LLMs with symbolic engines (e.g., Prover9, Z3) have improved reliability but remain limited to static forms of logic, struggling with dynamic, state-based reasoning such as multi-step progressions and conditional transitions.\n In this paper, we propose MCFR (Model Checking for Formal Reasoning), a neuro-symbolic framework that integrates LLMs with model checking to support property verification. MCFR translates natural language into formal specifications and verifies them over transition models. To support evaluation, we introduce EduMC-QA, a benchmark dataset grounded in real academic procedures. Our results show that MCFR improves reasoning faithfulness and interpretability, offering a viable path toward verifiable QA in high-stakes closed-domain applications. In addition to evaluating MCFR, we compare its performance with state-of-the-art LLMs such as ChatGPT, DeepSeek, and Claude to contextualize its effectiveness."},{"descriptionType":"Other","description":"Published at the 2nd ACM Workshop in AI-powered Question \u0026amp; Answering Systems (AIQAM '25), co-located with ACM Multimedia 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11572","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:05:50Z","registered":"2025-09-16T03:05:51Z","published":null,"updated":"2025-09-16T03:05:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11569","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11569","identifiers":[{"identifier":"2509.11569","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yue","familyName":"Ding","name":"Ding, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofang","familyName":"Zhu","name":"Zhu, Xiaofang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianze","familyName":"Xia","name":"Xia, Tianze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junfei","familyName":"Wu","name":"Wu, Junfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinlong","familyName":"Chen","name":"Chen, Xinlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Liu","name":"Liu, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Wang","name":"Wang, Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"D$^2$HScore: Reasoning-Aware Hallucination Detection via Semantic Breadth and Depth Analysis in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T04:28:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:01:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Although large Language Models (LLMs) have achieved remarkable success, their practical application is often hindered by the generation of non-factual content, which is called \"hallucination\". Ensuring the reliability of LLMs' outputs is a critical challenge, particularly in high-stakes domains such as finance, security, and healthcare. In this work, we revisit hallucination detection from the perspective of model architecture and generation dynamics. Leveraging the multi-layer structure and autoregressive decoding process of LLMs, we decompose hallucination signals into two complementary dimensions: the semantic breadth of token representations within each layer, and the semantic depth of core concepts as they evolve across layers. Based on this insight, we propose \\textbf{D$^2$HScore (Dispersion and Drift-based Hallucination Score)}, a training-free and label-free framework that jointly measures: (1) \\textbf{Intra-Layer Dispersion}, which quantifies the semantic diversity of token representations within each layer; and (2) \\textbf{Inter-Layer Drift}, which tracks the progressive transformation of key token representations across layers. To ensure drift reflects the evolution of meaningful semantics rather than noisy or redundant tokens, we guide token selection using attention signals. By capturing both the horizontal and vertical dynamics of representation during inference, D$^2$HScore provides an interpretable and lightweight proxy for hallucination detection. Extensive experiments across five open-source LLMs and five widely used benchmarks demonstrate that D$^2$HScore consistently outperforms existing training-free baselines."},{"descriptionType":"Other","description":"under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11569","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:05:46Z","registered":"2025-09-16T03:05:46Z","published":null,"updated":"2025-09-16T03:05:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11524","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11524","identifiers":[{"identifier":"2509.11524","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chengbing","familyName":"Wang","name":"Wang, Chengbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhicheng","familyName":"Wang","name":"Wang, Zhicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianhao","familyName":"Shi","name":"Shi, Tianhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keqin","familyName":"Bao","name":"Bao, Keqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuli","familyName":"Feng","name":"Feng, Fuli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tat-Seng","familyName":"Chua","name":"Chua, Tat-Seng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoding in Latent Spaces for Efficient Inference in LLM-based Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T02:30:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:58:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fine-tuning large language models (LLMs) for recommendation in a generative manner has delivered promising results, but encounters significant inference overhead due to autoregressive decoding in the language space. This work explores bypassing language-space decoding by directly matching candidate items with the LLM's internal thought representations in the latent space, eliminating the time-consuming autoregressive process to reduce computational costs. Towards this, we introduce Light Latent-space Decoding (L2D), an effective and efficient latent-space decoding method. L2D represents user-preferred items by using the hidden states of test sequences reflecting the LLM's internal thought, and obtains candidate item representations from the hidden states of training sequences labeled with the corresponding candidate items. It then matches the two types of representations to decode items, achieving latent-space decoding. In this way, it enables efficient decoding without altering the LLM's generative tuning paradigm, thereby preserving performance. Extensive empirical results demonstrate that L2D is more than 10x faster than language-space decoding while maintaining or enhancing performance."},{"descriptionType":"Other","description":"Accepted for publication in EMNLP'25"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11524","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:04:42Z","registered":"2025-09-16T03:04:42Z","published":null,"updated":"2025-09-16T03:04:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11523","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11523","identifiers":[{"identifier":"2509.11523","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziliang","familyName":"Wang","name":"Wang, Ziliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ge","familyName":"Li","name":"Li, Ge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Li","name":"Li, Jia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhu","name":"Zhu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Jin","name":"Jin, Zhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VulAgent: Hypothesis-Validation based Multi-Agent Vulnerability Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T02:25:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:58:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The application of language models to project-level vulnerability detection remains challenging, owing to the dual requirement of accurately localizing security-sensitive code and correctly correlating and reasoning over complex program context. We present VulAgent, a multi-agent vulnerability detection framework based on hypothesis validation. Our design is inspired by how human auditors review code: when noticing a sensitive operation, they form a hypothesis about a possible vulnerability, consider potential trigger paths, and then verify the hypothesis against the surrounding context. VulAgent implements a semantics-sensitive, multi-view detection pipeline: specialized agents, each aligned to a specific analysis perspective (e.g., memory, authorization), collaboratively surface and precisely localize sensitive code sites with higher coverage. Building on this, VulAgent adopts a hypothesis-validation paradigm: for each vulnerability report, it builds hypothesis conditions and a trigger path, steering the LLM to target the relevant program context and defensive checks during verification, which reduces false positives. On average across the two datasets, VulAgent improves overall accuracy by 6.6%, increases the correct identification rate of vulnerable--fixed code pairs by up to 450% (246% on average), and reduces the false positive rate by about 36% compared with state-of-the-art LLM-based baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11523","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:04:41Z","registered":"2025-09-16T03:04:41Z","published":null,"updated":"2025-09-16T03:04:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11516","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11516","identifiers":[{"identifier":"2509.11516","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chengjin","familyName":"Wang","name":"Wang, Chengjin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Yan","name":"Yan, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanmin","familyName":"Zhou","name":"Zhou, Yanmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runjie","familyName":"Shen","name":"Shen, Runjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhipeng","familyName":"Wang","name":"Wang, Zhipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Cheng","name":"Cheng, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"He","name":"He, Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PaiP: An Operational Aware Interactive Planner for Unknown Cabinet Environments"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T02:06:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:58:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Box/cabinet scenarios with stacked objects pose significant challenges for robotic motion due to visual occlusions and constrained free space. Traditional collision-free trajectory planning methods often fail when no collision-free paths exist, and may even lead to catastrophic collisions caused by invisible objects. To overcome these challenges, we propose an operational aware interactive motion planner (PaiP) a real-time closed-loop planning framework utilizing multimodal tactile perception. This framework autonomously infers object interaction features by perceiving motion effects at interaction interfaces. These interaction features are incorporated into grid maps to generate operational cost maps. Building upon this representation, we extend sampling-based planning methods to interactive planning by optimizing both path cost and operational cost. Experimental results demonstrate that PaiP achieves robust motion in narrow spaces."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11516","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:04:31Z","registered":"2025-09-16T03:04:32Z","published":null,"updated":"2025-09-16T03:04:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":50,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=doi%3A%2810.48550%2Farxiv.2509.11514+OR+10.48550%2Farxiv.2509.11516+OR+10.48550%2Farxiv.2509.11523+OR+10.48550%2Farxiv.2509.11524+OR+10.48550%2Farxiv.2509.11536+OR+10.48550%2Farxiv.2509.11543+OR+10.48550%2Farxiv.2509.11548+OR+10.48550%2Farxiv.2509.11552+OR+10.48550%2Farxiv.2509.11569+OR+10.48550%2Farxiv.2509.11572+OR+10.48550%2Farxiv.2509.11589+OR+10.48550%2Farxiv.2509.11619+OR+10.48550%2Farxiv.2509.11620+OR+10.48550%2Farxiv.2509.11621+OR+10.48550%2Farxiv.2509.11626+OR+10.48550%2Farxiv.2509.11628+OR+10.48550%2Farxiv.2509.11629+OR+10.48550%2Farxiv.2509.11638+OR+10.48550%2Farxiv.2509.11645+OR+10.48550%2Farxiv.2509.11656+OR+10.48550%2Farxiv.2509.11662+OR+10.48550%2Farxiv.2509.11663+OR+10.48550%2Farxiv.2509.11686+OR+10.48550%2Farxiv.2509.11687+OR+10.48550%2Farxiv.2509.11708+OR+10.48550%2Farxiv.2509.11717+OR+10.48550%2Farxiv.2509.11719+OR+10.48550%2Farxiv.2509.11724+OR+10.48550%2Farxiv.2509.11752+OR+10.48550%2Farxiv.2509.11766+OR+10.48550%2Farxiv.2509.11772+OR+10.48550%2Farxiv.2509.11787+OR+10.48550%2Farxiv.2509.11796+OR+10.48550%2Farxiv.2509.11803+OR+10.48550%2Farxiv.2509.11815+OR+10.48550%2Farxiv.2509.11816+OR+10.48550%2Farxiv.2509.11839+OR+10.48550%2Farxiv.2509.11840+OR+10.48550%2Farxiv.2509.11860+OR+10.48550%2Farxiv.2509.11862+OR+10.48550%2Farxiv.2509.11864+OR+10.48550%2Farxiv.2509.11865+OR+10.48550%2Farxiv.2509.11868+OR+10.48550%2Farxiv.2509.11880+OR+10.48550%2Farxiv.2509.11885+OR+10.48550%2Farxiv.2509.11914+OR+10.48550%2Farxiv.2509.11924+OR+10.48550%2Farxiv.2509.11930+OR+10.48550%2Farxiv.2509.11939+OR+10.48550%2Farxiv.2509.11941%29\u0026page%5Bsize%5D=100\u0026page%5Bnumber%5D=1"}}