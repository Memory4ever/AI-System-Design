<td id="S5.T1.4.2.4" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T1.4.2.4.1" class="ltx_text" style="font-size:80%;">1.000</span></td>
<td id="S5.T1.4.2.5" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T1.4.2.5.1" class="ltx_text" style="font-size:80%;">1.00</span></td></tr>
<tr id="S5.T1.4.3" class="ltx_tr">
