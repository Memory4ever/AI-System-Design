<td id="S5.T3.2.19.2" class="ltx_td ltx_align_center ltx_border_t" colspan="3">0.3535</td>
<td id="S5.T3.2.19.3" class="ltx_td ltx_align_center ltx_border_t" colspan="3">0.3697</td></tr>
