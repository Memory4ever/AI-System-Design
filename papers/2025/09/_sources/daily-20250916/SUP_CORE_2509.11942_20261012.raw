<td id="S5.T1.4.5.3" class="ltx_td ltx_align_left ltx_border_bb"><span id="S5.T1.4.5.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">0.003***</span></td>
<td id="S5.T1.4.5.4" class="ltx_td ltx_align_left ltx_border_bb"><span id="S5.T1.4.5.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">0.871</span></td>
<td id="S5.T1.4.5.5" class="ltx_td ltx_align_left ltx_border_bb"><span id="S5.T1.4.5.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">0.74</span></td></tr>
</tbody>
