<td id="S5.T2.2.5.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T2.2.5.7.1" class="ltx_text ltx_underline">0.9597</span></td>
<td id="S5.T2.2.5.8" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
