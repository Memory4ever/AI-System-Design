<th id="A2.T3.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">Prompt-Engineered</th>
<td id="A2.T3.2.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="A2.T3.2.3.2.1" class="ltx_inline-block ltx_align_top" style="width:50.6pt;">
<span id="A2.T3.2.3.2.1.1" class="ltx_p">3.23</span>
</span></td>
<td id="A2.T3.2.3.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="A2.T3.2.3.3.1" class="ltx_inline-block ltx_align_top" style="width:50.6pt;">
