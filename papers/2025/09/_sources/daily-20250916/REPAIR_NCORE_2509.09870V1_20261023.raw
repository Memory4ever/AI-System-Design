<td id="S4.T1.2.7.2" class="ltx_td ltx_align_center ltx_border_bb">3.81 <math id="S4.T1.m16" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.95</td>
<td id="S4.T1.2.7.3" class="ltx_td ltx_align_center ltx_border_bb">4.47 <math id="S4.T1.m17" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.72</td>
<td id="S4.T1.2.7.4" class="ltx_td ltx_align_center ltx_border_bb">3.94 <math id="S4.T1.m18" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.05</td></tr>
</tbody>
</table>
</figure>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">Kruskal–Wallis tests revealed significant effects for all six variables (see Table <a href="#S4.T2" title="Table 2 ‣ 4.1. Effects of CA Personality (RQ1) ‣ 4. Results ‣ Vibe Check: Understanding the Effects of LLM-Based Conversational Agents’ Personality and Alignment on User Perceptions in Goal-Oriented Tasks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>): Intelligence (<math id="S4.SS1.p2.m1" class="ltx_Math" alttext="H(2)=9.32" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>9.32</mn></mrow><annotation encoding="application/x-tex">H(2)=9.32</annotation></semantics></math>, <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="p=.010" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.010</mn></mrow><annotation encoding="application/x-tex">p=.010</annotation></semantics></math>, <math id="S4.SS1.p2.m3" class="ltx_Math" alttext="\eta^{2}=.049" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>=</mo><mn>.049</mn></mrow><annotation encoding="application/x-tex">\eta^{2}=.049</annotation></semantics></math>), Enjoyment (<math id="S4.SS1.p2.m4" class="ltx_Math" alttext="H(2)=7.70" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>7.70</mn></mrow><annotation encoding="application/x-tex">H(2)=7.70</annotation></semantics></math>, <math id="S4.SS1.p2.m5" class="ltx_Math" alttext="p=.021" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.021</mn></mrow><annotation encoding="application/x-tex">p=.021</annotation></semantics></math>, <math id="S4.SS1.p2.m6" class="ltx_Math" alttext="\eta^{2}=.038" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>=</mo><mn>.038</mn></mrow><annotation encoding="application/x-tex">\eta^{2}=.038</annotation></semantics></math>), Anthropomorphism (<math id="S4.SS1.p2.m7" class="ltx_Math" alttext="H(2)=10.81" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>10.81</mn></mrow><annotation encoding="application/x-tex">H(2)=10.81</annotation></semantics></math>, <math id="S4.SS1.p2.m8" class="ltx_Math" alttext="p=.005" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.005</mn></mrow><annotation encoding="application/x-tex">p=.005</annotation></semantics></math>, <math id="S4.SS1.p2.m9" class="ltx_Math" alttext="\eta^{2}=.059" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>=</mo><mn>.059</mn></mrow><annotation encoding="application/x-tex">\eta^{2}=.059</annotation></semantics></math>), Intention to Adopt (<math id="S4.SS1.p2.m10" class="ltx_Math" alttext="H(2)=11.02" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>11.02</mn></mrow><annotation encoding="application/x-tex">H(2)=11.02</annotation></semantics></math>, <math id="S4.SS1.p2.m11" class="ltx_Math" alttext="p=.004" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.004</mn></mrow><annotation encoding="application/x-tex">p=.004</annotation></semantics></math>, <math id="S4.SS1.p2.m12" class="ltx_Math" alttext="\eta^{2}=.061" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>=</mo><mn>.061</mn></mrow><annotation encoding="application/x-tex">\eta^{2}=.061</annotation></semantics></math>), Trust (<math id="S4.SS1.p2.m13" class="ltx_Math" alttext="H(2)=8.39" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>8.39</mn></mrow><annotation encoding="application/x-tex">H(2)=8.39</annotation></semantics></math>, <math id="S4.SS1.p2.m14" class="ltx_Math" alttext="p=.015" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>.015</mn></mrow><annotation encoding="application/x-tex">p=.015</annotation></semantics></math>, <math id="S4.SS1.p2.m15" class="ltx_Math" alttext="\eta^{2}=.043" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>=</mo><mn>.043</mn></mrow><annotation encoding="application/x-tex">\eta^{2}=.043</annotation></semantics></math>), and Likeability (<math id="S4.SS1.p2.m16" class="ltx_Math" alttext="H(2)=16.64" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>16.64</mn></mrow><annotation encoding="application/x-tex">H(2)=16.64</annotation></semantics></math>, <math id="S4.SS1.p2.m17" class="ltx_Math" alttext="p&lt;.001" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>.001</mn></mrow><annotation encoding="application/x-tex">p&lt;.001</annotation></semantics></math>, <math id="S4.SS1.p2.m18" class="ltx_Math" alttext="\eta^{2}=.098" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>=</mo><mn>.098</mn></mrow><annotation encoding="application/x-tex">\eta^{2}=.098</annotation></semantics></math>).</p>
</div>
