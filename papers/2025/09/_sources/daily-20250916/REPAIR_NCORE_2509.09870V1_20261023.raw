<td id="S4.T7.2.18.6" class="ltx_td ltx_align_right">.248</td>
<td id="S4.T7.2.18.7" class="ltx_td ltx_nopad_r ltx_align_right">*</td></tr>
<tr id="S4.T7.2.19" class="ltx_tr">
<td id="S4.T7.2.19.1" class="ltx_td ltx_border_bb"></td>
