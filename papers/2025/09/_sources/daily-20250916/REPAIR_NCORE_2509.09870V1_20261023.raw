<td id="S4.T7.2.16.4" class="ltx_td ltx_align_right"><math id="S4.T7.m7" class="ltx_Math" alttext="&lt;.001" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mn>.001</mn></mrow><annotation encoding="application/x-tex">&lt;.001</annotation></semantics></math></td>
