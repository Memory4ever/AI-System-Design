<span id="S3.F1.pic1.9.2" class="ltx_p">Query Understanding</span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#CCFFCC;" fill="#CCFFCC" stroke="#000000"><path d="M 34.59 -429.94 L 0 -395.35 L -34.59 -429.94 L 0 -464.53 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#CCFFCC;" fill="#CCFFCC" stroke="#000000"><foreignObject overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.10" class="ltx_text"></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.6 0.0 0.0 0.6 0 -708.67)"><foreignObject style="--ltx-fo-width:5.12em;--ltx-fo-height:0.69em;--ltx-fo-depth:1.2em;font-size:10pt;" height="26.21" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="70.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F1.pic1.11" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:5.12em;">
<span id="S3.F1.pic1.11.1" class="ltx_p"></span>
<span id="S3.F1.pic1.11.2" class="ltx_p">Parallel Retrieval</span>
