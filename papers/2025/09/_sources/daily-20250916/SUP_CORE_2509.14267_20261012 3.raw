</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFCC;" fill="#FFFFCC" stroke="#000000"><path d="M 121.74 -32.9 L 56.88 -32.9 L 56.88 -109.89 L 121.74 -109.89 Z M 56.88 -109.89"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.65 0.0 0.0 0.65 59.88 -42.14)"><foreignObject style="--ltx-fo-width:6.54em;--ltx-fo-height:0.69em;--ltx-fo-depth:7.2em;font-size:10pt;" height="109.24" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="90.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
