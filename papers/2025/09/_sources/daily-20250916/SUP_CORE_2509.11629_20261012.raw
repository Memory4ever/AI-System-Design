<td class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span class="ltx_text ltx_font_bold">833.87</span></td>
<td class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;">1123.60</td>
<td class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span class="ltx_text ltx_font_bold">550.20</span></td>
