<td class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span class="ltx_text ltx_font_bold">397.78</span></td>
<td class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;">642.75</td>
<td class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span class="ltx_text ltx_font_bold">461.62</span></td>
</tr>
