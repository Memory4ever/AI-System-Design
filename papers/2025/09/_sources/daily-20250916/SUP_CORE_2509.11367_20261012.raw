            <span id="alg4.l7.3" class="ltx_text ltx_font_bold">for</span> <math id="alg4.l7.m1" class="ltx_Math" alttext="noise" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">noise</annotation></semantics></math> <span id="alg4.l7.4" class="ltx_text ltx_font_bold">from</span> 0 <span id="alg4.l7.5" class="ltx_text ltx_font_bold">to</span> <math id="alg4.l7.m2" class="ltx_Math" alttext="max" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">max</annotation></semantics></math> <span id="alg4.l7.6" class="ltx_text ltx_font_bold">by</span> <math id="alg4.l7.m3" class="ltx_Math" alttext="step" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">step</annotation></semantics></math> <span id="alg4.l7.7" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg4.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
              <math id="alg4.l8.m1" class="ltx_Math" alttext="P_{new}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">P_{new}\leftarrow</annotation></semantics></math> change-trans-prob(<math id="alg4.l8.m2" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, <math id="alg4.l8.m3" class="ltx_Math" alttext="noise" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">noise</annotation></semantics></math>, <math id="alg4.l8.m4" class="ltx_Math" alttext="\pi_{*}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">\pi_{*}</annotation></semantics></math>)

</div>
<div id="alg4.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
              <math id="alg4.l9.m1" class="ltx_Math" alttext="EP\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">EP\leftarrow</annotation></semantics></math> generate-episodes(<math id="alg4.l9.m2" class="ltx_Math" alttext="P_{new}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><annotation encoding="application/x-tex">P_{new}</annotation></semantics></math>, <math id="alg4.l9.m3" class="ltx_Math" alttext="\pi_{*}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">\pi_{*}</annotation></semantics></math>, <math id="alg4.l9.m4" class="ltx_Math" alttext="s_{0}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>0</mn></msub><annotation encoding="application/x-tex">s_{0}</annotation></semantics></math>, <math id="alg4.l9.m5" class="ltx_Math" alttext="s_{G}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>G</mi></msub><annotation encoding="application/x-tex">s_{G}</annotation></semantics></math>)

</div>
<div id="alg4.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
              <math id="alg4.l10.m1" class="ltx_Math" alttext="measures_{noise}\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">measures_{noise}\leftarrow</annotation></semantics></math> generate-measures(<math id="alg4.l10.m2" class="ltx_Math" alttext="ep_{opt}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">ep_{opt}</annotation></semantics></math>, <math id="alg4.l10.m3" class="ltx_Math" alttext="EP" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">EP</annotation></semantics></math>)

</div>
<div id="alg4.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
              perform Welch’s t-test between <math id="alg4.l11.m1" class="ltx_Math" alttext="measures_{0}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">measures_{0}</annotation></semantics></math> and <math id="alg4.l11.m2" class="ltx_Math" alttext="measures_{noise}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></mrow><annotation encoding="application/x-tex">measures_{noise}</annotation></semantics></math>

</div>
<div id="alg4.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
            <span id="alg4.l12.3" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l12.4" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
</section>
<section id="S5.SSx2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">Stochastic Policy Environment</h3>

<div id="S5.SSx2.p1" class="ltx_para">
<p id="S5.SSx2.p1.1" class="ltx_p">Up to this point, our analysis has focused exclusively on deterministic policies.
However, in many reinforcement learning settings, stochastic policies are commonly used.
Accordingly, this section investigates approaches for detecting model drift in environments governed by stochastic policies.
As shown in Eq. (<a href="#S5.E1" title="In 5 Problem Setup ‣ Detecting Model Drifts in Non-Stationary Environment Using Edit Operation Measures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), we can compute the <em id="S5.SSx2.p1.1.1" class="ltx_emph ltx_font_italic">optimal state value functions</em> (e.g., using value iteration).
We can extract a <em id="S5.SSx2.p1.1.2" class="ltx_emph ltx_font_italic">stochastic policy</em> using a softmax or <math id="S5.SSx2.p1.m1" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>-greedy method from optimal value functions.
In this work, we use a <em id="S5.SSx2.p1.1.3" class="ltx_emph ltx_font_italic">stochastic policy</em> from an optimal state function values. given as follows:</p>
<table id="S5.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E5.m1" class="ltx_Math" alttext="\pi(a\mid s)=\frac{\exp\left(Q(s,a)/\tau\right)}{\sum_{a^{\prime}}\exp\left(Q(s,a^{\prime})/\tau\right)}" display="block" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo>)</mo></mrow></mrow><mrow><msub><mo>∑</mo><msup><mi>a</mi><mo>′</mo></msup></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\pi(a\mid s)=\frac{\exp\left(Q(s,a)/\tau\right)}{\sum_{a^{\prime}}\exp\left(Q(s,a^{\prime})/\tau\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S5.SSx2.p1.2" class="ltx_p">where:</p>
<table id="S5.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex11.m1" class="ltx_Math" alttext="Q(s,a)=R(s,a)+\gamma\sum_{s^{\prime}}P(s^{\prime}\mid s,a)V(s^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><msup><mi>s</mi><mo>′</mo></msup></munder><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>s</mi><mo>,</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Q(s,a)=R(s,a)+\gamma\sum_{s^{\prime}}P(s^{\prime}\mid s,a)V(s^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SSx2.p1.3" class="ltx_p">and <math id="S5.SSx2.p1.m2" class="ltx_Math" alttext="\tau&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tau&gt;0</annotation></semantics></math> is a temperature parameter controlling the randomness of the policy.</p>
</div>
<div id="S5.SSx2.p2" class="ltx_para">
<p id="S5.SSx2.p2.1" class="ltx_p">Previously, we explained that an MDP model can be converted into an MRP model when using a deterministic policy. An MDP model can also be converted into an MRP model when using a stochastic policy.
An MDP is defined as:</p>
<table id="S5.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex12.m1" class="ltx_Math" alttext="\mathcal{M}=(S,A,P,R,\gamma)" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi>A</mi><mo>,</mo><mi>P</mi><mo>,</mo><mi>R</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}=(S,A,P,R,\gamma)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SSx2.p2.2" class="ltx_p">A stochastic policy <math id="S5.SSx2.p2.m1" class="ltx_Math" alttext="\pi(a\mid s)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(a\mid s)</annotation></semantics></math> defines a probability distribution over actions for each state <math id="S5.SSx2.p2.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>.
When a fixed stochastic policy <math id="S5.SSx2.p2.m3" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is applied, the agent selects actions according to <math id="S5.SSx2.p2.m4" class="ltx_Math" alttext="\pi(a\mid s)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(a\mid s)</annotation></semantics></math> and the overall dynamics (i.e., transitions and rewards) are averaged over the policy.
Therefore, the resulting Markov Reward Process (MRP) is defined by:</p>
<table id="S5.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex13.m1" class="ltx_Math" alttext="\mathcal{M}_{\pi}=(S,P_{ss^{\prime}}^{\pi},R_{s}^{\pi},\gamma)" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>π</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msubsup><mi>P</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mo>′</mo></msup></mrow><mi>π</mi></msubsup><mo>,</mo><msubsup><mi>R</mi><mi>s</mi><mi>π</mi></msubsup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{\pi}=(S,P_{ss^{\prime}}^{\pi},R_{s}^{\pi},\gamma)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SSx2.p2.3" class="ltx_p">where <math id="S5.SSx2.p2.m5" class="ltx_Math" alttext="P_{ss^{\prime}}^{\pi}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mo>′</mo></msup></mrow><mi>π</mi></msubsup><annotation encoding="application/x-tex">P_{ss^{\prime}}^{\pi}</annotation></semantics></math> and <math id="S5.SSx2.p2.m6" class="ltx_Math" alttext="R_{s}^{\pi}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>s</mi><mi>π</mi></msubsup><annotation encoding="application/x-tex">R_{s}^{\pi}</annotation></semantics></math> are defined in Eq. <a href="#S5.E4" title="In 5 Problem Setup ‣ Detecting Model Drifts in Non-Stationary Environment Using Edit Operation Measures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.
The difference is that, in a deterministic policy, only one action has a probability of 1 while all others are 0 while,
in a stochastic policy, all actions can have non-zero probability values.
Thus, even with a stochastic policy, the induced process over states (and rewards) is a MRP model.</p>
</div>
<div id="S5.SSx2.p3" class="ltx_para">
<p id="S5.SSx2.p3.1" class="ltx_p">However, detecting model drift using state sequences in a stochastic policy setting is a more challenging problem. In a deterministic policy, the transition from the current state to the next state is determined solely by the transition probability. In contrast, under a stochastic policy, the next state is determined by both the behavior of the policy and the transition probabilities. As a result, the system exhibits greater randomness compared to the deterministic case.</p>
</div>
<figure id="S5.F3" class="ltx_figure"><img src="2509.11367v1/trans-prob-stoch.png" id="S5.F3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:157/99;" width="157" height="99" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>Stochastic policy</figcaption>
</figure>
<div id="S5.SSx2.p4" class="ltx_para">
<p id="S5.SSx2.p4.1" class="ltx_p">In the stochastic policy setting, we explore this problem using the same maze problem as in the previous section.
Since the optimal state value functions are independent of the policies, the optimal state value function remains the same as in Table <a href="#S5.T2" title="Table 2 ‣ 5 Problem Setup ‣ Detecting Model Drifts in Non-Stationary Environment Using Edit Operation Measures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, even under a stochastic policy.
Given the optimal state function values in Table <a href="#S5.T2" title="Table 2 ‣ 5 Problem Setup ‣ Detecting Model Drifts in Non-Stationary Environment Using Edit Operation Measures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, the optimal stochastic policy can be computed by using softmax method (Eq. <a href="#S5.E5" title="In Stochastic Policy Environment ‣ 5 Problem Setup ‣ Detecting Model Drifts in Non-Stationary Environment Using Edit Operation Measures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>).
An example of the stochastic policy at state (1,1) is shown in Figure <a href="#S5.F3" title="Figure 3 ‣ Stochastic Policy Environment ‣ 5 Problem Setup ‣ Detecting Model Drifts in Non-Stationary Environment Using Edit Operation Measures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> (<math id="S5.SSx2.p4.m1" class="ltx_Math" alttext="\tau=1" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\tau=1</annotation></semantics></math>).</p>
</div>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Experimental Results</h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">This study comprises two distinct experiments. The first experiment is conducted using the previously described maze problem, while the second employs the CartPole environment.
The results of each experiment are presented in the subsequent sections.</p>
</div>
<figure id="S6.T4" class="ltx_table">
<table id="S6.T4.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S6.T4.2.1" class="ltx_tr">
<td id="S6.T4.2.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S6.T4.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Method</span></td>
<td id="S6.T4.2.1.2" class="ltx_td ltx_align_right ltx_border_tt"><span id="S6.T4.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Noise</span></td>
<td id="S6.T4.2.1.3" class="ltx_td ltx_align_right ltx_border_tt"><span id="S6.T4.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Mean</span></td>
<td id="S6.T4.2.1.4" class="ltx_td ltx_align_right ltx_border_tt"><span id="S6.T4.2.1.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Std</span></td>
<td id="S6.T4.2.1.5" class="ltx_td ltx_align_right ltx_border_tt"><span id="S6.T4.2.1.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">p-value</span></td>
<td id="S6.T4.2.1.6" class="ltx_td ltx_border_tt"></td></tr>
<tr id="S6.T4.2.2" class="ltx_tr">
<td id="S6.T4.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S6.T4.2.2.1.1" class="ltx_text" style="font-size:70%;">levenshtein</span></td>
