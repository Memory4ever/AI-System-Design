<div id="alg4.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            compute <math id="alg4.l2.m1" class="ltx_Math" alttext="ep_{opt}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">ep_{opt}</annotation></semantics></math> from <math id="alg4.l2.m2" class="ltx_Math" alttext="\pi_{*}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">\pi_{*}</annotation></semantics></math>

