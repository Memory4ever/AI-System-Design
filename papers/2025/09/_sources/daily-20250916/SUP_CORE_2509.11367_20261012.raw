<td id="S5.T3.2.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T3.2.4.4.1" class="ltx_text" style="font-size:70%;">(3,3):<math id="S5.T3.m19" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math></span></td>
