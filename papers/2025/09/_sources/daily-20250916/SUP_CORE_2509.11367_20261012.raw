<td id="S5.T2.2.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.65</td>
<td id="S5.T2.2.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.73</td></tr>
<tr id="S5.T2.2.2" class="ltx_tr">
<td id="S5.T2.2.2.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r">0.51</td>
<td id="S5.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_r">0.58</td>
<td id="S5.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_r">0.65</td>
<td id="S5.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_r">0.74</td>
<td id="S5.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_r">0.84</td></tr>
<tr id="S5.T2.2.3" class="ltx_tr">
<td id="S5.T2.2.3.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r">0.57</td>
<td id="S5.T2.2.3.2" class="ltx_td ltx_align_center ltx_border_r">0.65</td>
<td id="S5.T2.2.3.3" class="ltx_td ltx_align_center ltx_border_r">0.74</td>
<td id="S5.T2.2.3.4" class="ltx_td ltx_align_center ltx_border_r">0.85</td>
<td id="S5.T2.2.3.5" class="ltx_td ltx_align_center ltx_border_r">0.96</td></tr>
<tr id="S5.T2.2.4" class="ltx_tr">
<td id="S5.T2.2.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r">0.62</td>
<td id="S5.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_r">0.71</td>
<td id="S5.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_r">0.82</td>
