<td id="S6.T6.2.2.2" class="ltx_td ltx_align_right ltx_border_t"><span id="S6.T6.2.2.2.1" class="ltx_text" style="font-size:70%;">2.6420</span></td>
<td id="S6.T6.2.2.3" class="ltx_td ltx_align_right ltx_border_t"><span id="S6.T6.2.2.3.1" class="ltx_text" style="font-size:70%;">1.5516</span></td>
