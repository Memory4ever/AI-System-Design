            <math id="alg4.l6.m1" class="ltx_Math" alttext="measures_{0}\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mn>0</mn></msub></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">measures_{0}\leftarrow</annotation></semantics></math> generate-measures(<math id="alg4.l6.m2" class="ltx_Math" alttext="ep_{opt}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">ep_{opt}</annotation></semantics></math>, <math id="alg4.l6.m3" class="ltx_Math" alttext="EP_{0}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">EP_{0}</annotation></semantics></math>)

