<tr id="S5.T2.2.5" class="ltx_tr">
<td id="S5.T2.2.5.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_l ltx_border_r">0.59</td>
<td id="S5.T2.2.5.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">0.67</td>
<td id="S5.T2.2.5.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">0.76</td>
