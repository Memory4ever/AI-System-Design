 style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -109.63 213.96)"><foreignObject style="--ltx-fo-width:1.94em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="26.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m6" class="ltx_Math" alttext="50.5" display="inline" intent=":literal"><semantics><mn>50.5</mn><annotation encoding="application/x-tex">50.5</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -96.56 257.65)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m7" class="ltx_Math" alttext="51" display="inline" intent=":literal"><semantics><mn>51</mn><annotation encoding="application/x-tex">51</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -109.63 301.33)"><foreignObject style="--ltx-fo-width:1.94em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="26.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F2.pic1.m8" class="ltx_Math" alttext="51.5" display="inline" intent=":literal"><semantics><mn>51.5</mn><annotation encoding="application/x-tex">51.5</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke=