<th id="A2.T1.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><math id="A2.T1.m6" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></th>
<th id="A2.T1.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><math id="A2.T1.m7" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></th>
<th id="A2.T1.2.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><math id="A2.T1.m8" class="ltx_Math" alttext="R^{2}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mn>2</mn></msup><annotation encoding="application/x-tex">R^{2}</annotation></semantics></math></th>
<th id="A2.T1.2.1.6" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><math id="A2.T1.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></th></tr>
</thead>
