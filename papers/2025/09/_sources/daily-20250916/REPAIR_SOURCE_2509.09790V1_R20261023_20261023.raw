<span id="A5.I3.i4.p1.1" class="ltx_p"><span id="A5.I3.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">craft wood pickaxe</span></span>
</span></span>
<span id="A5.I3.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A5.I3.i5.p1" class="ltx_para ltx_noindent">
