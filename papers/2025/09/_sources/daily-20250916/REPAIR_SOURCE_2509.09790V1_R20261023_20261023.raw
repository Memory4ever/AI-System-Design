<td id="A1.T7.2.2.2" class="ltx_td ltx_align_left ltx_border_t" style="--ltx-bg-color:#FFFFB3;">
<table id="A1.T7.2.2.2.1" class="ltx_tabular ltx_align_middle">
<tr id="A1.T7.2.2.2.1.1" class="ltx_tr">
