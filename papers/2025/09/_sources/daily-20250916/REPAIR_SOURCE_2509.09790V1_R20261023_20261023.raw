<sub id="A1.T7.2.2.2.1.1.1.1.1" class="ltx_sub"><span id="A1.T7.2.2.2.1.1.1.1.1.1" class="ltx_text ltx_font_italic">↑0.05</span></sub></span></td>
<td id="A1.T7.2.2.2.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.0pt;padding-right:0.0pt;"><span id="A1.T7.2.2.2.1.1.2.1" class="ltx_text" style="--ltx-bg-color:#B3B3FF;">0.55
