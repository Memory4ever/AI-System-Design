<td id="A1.T11.2.1.11.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="A1.T11.2.1.11.1.1" class="ltx_text ltx_font_bold">3-shot Topic-Based (CEMTM)</span></td>
<td id="A1.T11.2.1.11.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="A1.T11.2.1.11.2.1" class="ltx_text ltx_font_bold">31.3</span></td>
<td id="A1.T11.2.1.11.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="A1.T11.2.1.11.3.1" class="ltx_text ltx_font_bold">72.76</span></td>
<td id="A1.T11.2.1.11.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="A1.T11.2.1.11.4.1" class="ltx_text ltx_font_bold">87.31</span></td>
