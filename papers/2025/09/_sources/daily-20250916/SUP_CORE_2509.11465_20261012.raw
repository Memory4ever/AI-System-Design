<td id="S4.T2.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">TD</td>
<td id="S4.T2.2.1.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">I-RBO</td>
<td id="S4.T2.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Purity</td>
<td id="S4.T2.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">ARI</td>
<td id="S4.T2.2.1.2.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">NMI</td>
<td id="S4.T2.2.1.2.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">NPMI</td>
<td id="S4.T2.2.1.2.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">WE</td>
<td id="S4.T2.2.1.2.12" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">LLM</td>
<td id="S4.T2.2.1.2.13" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">TD</td>
