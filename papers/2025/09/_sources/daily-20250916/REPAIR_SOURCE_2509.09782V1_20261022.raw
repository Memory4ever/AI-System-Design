<td id="S4.T1.2.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Pool 1</td>
<td id="S4.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S4.T1.m15" class="ltx_Math" alttext="0.85616" display="inline" intent=":literal"><semantics><mn>0.85616</mn><annotation encoding="application/x-tex">0.85616</annotation></semantics></math></td>
