<td id="S4.T1.2.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.0155</td>
<td id="S4.T1.2.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T1.2.3.5.1" class="ltx_text ltx_font_bold">0.0035</span></td>
<td id="S4.T1.2.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">2.66e-05</td>
<td id="S4.T1.2.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T1.2.3.7.1" class="ltx_text ltx_font_bold">1.55e-05</span></td>
<td id="S4.T1.2.3.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S4.T1.m17" class="ltx_Math" alttext="20.564\%" display="inline" intent=":literal"><semantics><mrow><mn>20.564</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">20.564\%</annotation></semantics></math></td>
<td id="S4.T1.2.3.9" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m18" class="ltx_Math" alttext="20.564\%" display="inline" intent=":literal"><semantics><mrow><mn>20.564</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">20.564\%</annotation></semantics></math></td></tr>
<tr id="S4.T1.2.4" class="ltx_tr">
<td id="S4.T1.2.4.1" class="ltx_td ltx_align_center ltx_border_r">Pool 2</td>
<td id="S4.T1.2.4.2" class="ltx_td ltx_align_center ltx_border_r"><math id="S4.T1.m19" class="ltx_Math" alttext="0.83285" display="inline" intent=":literal"><semantics><mn>0.83285</mn><annotation encoding="application/x-tex">0.83285</annotation></semantics></math></td>
<td id="S4.T1.2.4.3" class="ltx_td ltx_align_center ltx_border_r"><math id="S4.T1.m20" class="ltx_Math" alttext="0.83366" display="inline" intent=":literal"><semantics><mn>0.83366</mn><annotation encoding="application/x-tex">0.83366</annotation></semantics></math></td>
<td id="S4.T1.2.4.4" class="ltx_td ltx_align_center ltx_border_r">0.0213</td>
<td id="S4.T1.2.4.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.4.5.1" class="ltx_text ltx_font_bold">0.0027</span></td>
<td id="S4.T1.2.4.6" class="ltx_td ltx_align_center ltx_border_r">8.15e-06</td>
<td id="S4.T1.2.4.7" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.4.7.1" class="ltx_text ltx_font_bold">5.24e-06</span></td>
<td id="S4.T1.2.4.8" class="ltx_td ltx_align_center ltx_border_r"><math id="S4.T1.m21" class="ltx_Math" alttext="4.165\%" display="inline" intent=":literal"><semantics><mrow><mn>4.165</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">4.165\%</annotation></semantics></math></td>
<td id="S4.T1.2.4.9" class="ltx_td ltx_align_center"><math id="S4.T1.m22" class="ltx_Math" alttext="4.165\%" display="inline" intent=":literal"><semantics><mrow><mn>4.165</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">4.165\%</annotation></semantics></math></td></tr>
<tr id="S4.T1.2.5" class="ltx_tr">
<td id="S4.T1.2.5.1" class="ltx_td ltx_align_center ltx_border_r">Pool 3</td>
<td id="S4.T1.2.5.2" class="ltx_td ltx_align_center ltx_border_r"><math id="S4.T1.m23" class="ltx_Math" alttext="0.87512" display="inline" intent=":literal"><semantics><mn>0.87512</mn><annotation encoding="application/x-tex">0.87512</annotation></semantics></math></td>
<td id="S4.T1.2.5.3" class="ltx_td ltx_align_center ltx_border_r"><math id="S4.T1.m24" class="ltx_Math" alttext="0.87362" display="inline" intent=":literal"><semantics><mn>0.87362</mn><annotation encoding="application/x-tex">0.87362</annotation></semantics></math></td>
<td id="S4.T1.2.5.4" class="ltx_td ltx_align_center ltx_border_r">0.0260</td>
<td id="S4.T1.2.5.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.5.5.1" class="ltx_text ltx_font_bold">0.0040</span></td>
<td id="S4.T1.2.5.6" class="ltx_td ltx_align_center ltx_border_r">1.88e-05</td>
<td id="S4.T1.2.5.7" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.5.7.1" class="ltx_text ltx_font_bold">1.29e-05</span></td>
<td id="S4.T1.2.5.8" class="ltx_td ltx_align_center ltx_border_r"><math id="S4.T1.m25" class="ltx_Math" alttext="10.824\%" display="inline" intent=":literal"><semantics><mrow><mn>10.824</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">10.824\%</annotation></semantics></math></td>
<td id="S4.T1.2.5.9" class="ltx_td ltx_align_center"><math id="S4.T1.m26" class="ltx_Math" alttext="10.824\%" display="inline" intent=":literal"><semantics><mrow><mn>10.824</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">10.824\%</annotation></semantics></math></td></tr>
<tr id="S4.T1.2.6" class="ltx_tr">
<td id="S4.T1.2.6.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">Pool 4</td>
<td id="S4.T1.2.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><math id="S4.T1.m27" class="ltx_Math" alttext="0.80434" display="inline" intent=":literal"><semantics><mn>0.80434</mn><annotation encoding="application/x-tex">0.80434</annotation></semantics></math></td>
<td id="S4.T1.2.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><math id="S4.T1.m28" class="ltx_Math" alttext="0.83626" display="inline" intent=":literal"><semantics><mn>0.83626</mn><annotation encoding="application/x-tex">0.83626</annotation></semantics></math></td>
