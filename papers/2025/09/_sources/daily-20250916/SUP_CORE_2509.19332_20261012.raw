<td id="A5.T5.2.1.6.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.6458</td></tr>
<tr id="A5.T5.2.1.7" class="ltx_tr">
<th id="A5.T5.2.1.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">5</th>
