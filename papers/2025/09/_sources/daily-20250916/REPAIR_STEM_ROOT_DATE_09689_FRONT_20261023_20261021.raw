e" transform="matrix(1 0 0 -1 0 8.92)" width="52.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F3.pic1.8" class="ltx_text">0.968322</span></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 86.04 -47.84)"><foreignObject style="--ltx-fo-width:8.22em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="105.17"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F3.pic1.9" class="ltx_text" style="font-size:90%;">Train Dataset Size</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 -60.5 56.83)"><foreignObject style="--ltx-fo-width:2.53em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="32.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F3.pic1.10" class="ltx_text" style="font-size:90%;">Value</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M 320.66 119.51 h 78.54 v 39.67 h -78.54 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 324.81 130.81)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 34.13)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.53)"><g style="--ltx-stroke-color:#0000FF;--ltx-fill-color:#0000FF;--ltx-fg-color:#0000FF;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" color="#0000FF" fill="#0000FF" stroke="#0000FF" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="f