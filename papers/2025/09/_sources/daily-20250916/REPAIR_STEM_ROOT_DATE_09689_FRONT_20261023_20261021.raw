113.34 114.9)"><foreignObject style="--ltx-fo-width:3.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="52.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F3.pic1.2" class="ltx_text">1.162975</span></span></span></foreignObject></g><path d="M 98.37 124.31 C 98.37 125.84 97.13 127.08 95.6 127.08 C 94.07 127.08 92.83 125.84 92.83 124.31 C 92.83 122.78 94.07 121.54 95.6 121.54 C 97.13 121.54 98.37 122.78 98.37 124.31 Z M 95.6 124.31"></path><g style="--ltx-stroke-color:#0000FF;--ltx-fill-color:#0000FF;" fill="#0000FF" stroke="#0000FF" transform="matrix(1.0 0.0 0.0 1.0 69.46 129.47)"><foreignObject style="--ltx-fo-width:3.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="52.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F3.pic1.3" class="ltx_text">1.205178</span></span></span></foreignObject></g><path d="M 2.77 144.96 C 2.77 146.49 1.53 147.73 0 147.73 C -1.53 147.73 -2.77 146.49 -2.77 144.96 C -2.77 143.43 -1.53 142.19 0 142.19 C 1.53 142.19 2.77 143.43 2.77 144.96 Z M 0 144.96"></path><g style="--ltx-stroke-color:#0000FF;--ltx-fill-color:#0000FF;" fill="#0000FF" stroke="#0000FF" transform="matrix(1.0 0.0 0.0 1.0 -26.14 150.12)"><foreignObject style="--ltx-fo-width:3.78em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="52.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F3.pic1.4" class="ltx_text">1.264979</span></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path