</div>
<div id="lstnumberx24" class="ltx_listingline"><span id="lstnumberx24.1" class="ltx_text ltx_lst_identifier">SUMMARY</span>:<span id="lstnumberx24.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.3" class="ltx_text ltx_lst_identifier">A</span><span id="lstnumberx24.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.5" class="ltx_text ltx_lst_identifier">laid</span>-<span id="lstnumberx24.6" class="ltx_text ltx_lst_identifier">back</span><span id="lstnumberx24.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.8" class="ltx_text ltx_lst_identifier">slacker</span><span id="lstnumberx24.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.10" class="ltx_text ltx_lst_identifier">gets</span><span id="lstnumberx24.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.12" class="ltx_text ltx_lst_identifier">caught</span><span id="lstnumberx24.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.14" class="ltx_text ltx_lst_identifier">up</span><span id="lstnumberx24.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.16" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx24.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.18" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx24.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.20" class="ltx_text ltx_lst_identifier">case</span><span id="lstnumberx24.21" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.22" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx24.23" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.24" class="ltx_text ltx_lst_identifier">mistaken</span><span id="lstnumberx24.25" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.26" class="ltx_text ltx_lst_identifier">identity</span><span id="lstnumberx24.27" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.28" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx24.29" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.30" class="ltx_text ltx_lst_identifier">embarks</span><span id="lstnumberx24.31" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.32" class="ltx_text ltx_lst_identifier">on</span><span id="lstnumberx24.33" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.34" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx24.35" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.36" class="ltx_text ltx_lst_identifier">wild</span><span id="lstnumberx24.37" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.38" class="ltx_text ltx_lst_identifier">adventure</span><span id="lstnumberx24.39" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.40" class="ltx_text ltx_lst_identifier">involving</span><span id="lstnumberx24.41" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.42" class="ltx_text ltx_lst_identifier">bowling</span>,<span id="lstnumberx24.43" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.44" class="ltx_text ltx_lst_identifier">kidnapping</span>,<span id="lstnumberx24.45" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.46" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx24.47" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.48" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx24.49" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.50" class="ltx_text ltx_lst_identifier">rug</span><span id="lstnumberx24.51" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.52" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx24.53" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.54" class="ltx_text ltx_lst_identifier">really</span><span id="lstnumberx24.55" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.56" class="ltx_text ltx_lst_identifier">tied</span><span id="lstnumberx24.57" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.58" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx24.59" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.60" class="ltx_text ltx_lst_identifier">room</span><span id="lstnumberx24.61" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.62" class="ltx_text ltx_lst_identifier">together</span>..<span id="lstnumberx24.63" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.64" class="ltx_text ltx_lst_identifier">The</span><span id="lstnumberx24.65" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.66" class="ltx_text ltx_lst_identifier">cast</span><span id="lstnumberx24.67" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.68" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx24.69" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.70" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx24.71" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.72" class="ltx_text ltx_lst_identifier">movie</span><span id="lstnumberx24.73" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.74" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx24.75" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.76" class="ltx_text ltx_lst_identifier">as</span><span id="lstnumberx24.77" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.78" class="ltx_text ltx_lst_identifier">follows</span>:<span id="lstnumberx24.79" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.80" class="ltx_text ltx_lst_identifier">Jeff</span><span id="lstnumberx24.81" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.82" class="ltx_text ltx_lst_identifier">Bridges</span>,<span id="lstnumberx24.83" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.84" class="ltx_text ltx_lst_identifier">John</span><span id="lstnumberx24.85" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.86" class="ltx_text ltx_lst_identifier">Goodman</span>,<span id="lstnumberx24.87" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.88" class="ltx_text ltx_lst_identifier">Julianne</span><span id="lstnumberx24.89" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.90" class="ltx_text ltx_lst_identifier">Moore</span>,<span id="lstnumberx24.91" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.92" class="ltx_text ltx_lst_identifier">Steve</span><span id="lstnumberx24.93" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.94" class="ltx_text ltx_lst_identifier">Buscemi</span>,<span id="lstnumberx24.95" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.96" class="ltx_text ltx_lst_identifier">David</span><span id="lstnumberx24.97" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.98" class="ltx_text ltx_lst_identifier">Huddleston</span>,<span id="lstnumberx24.99" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.100" class="ltx_text ltx_lst_identifier">Philip</span><span id="lstnumberx24.101" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.102" class="ltx_text ltx_lst_identifier">Seymour</span><span id="lstnumberx24.103" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.104" class="ltx_text ltx_lst_identifier">Hoffman</span>,<span id="lstnumberx24.105" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.106" class="ltx_text ltx_lst_identifier">Tara</span><span id="lstnumberx24.107" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.108" class="ltx_text ltx_lst_identifier">Reid</span>,<span id="lstnumberx24.109" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.110" class="ltx_text ltx_lst_identifier">Philip</span><span id="lstnumberx24.111" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.112" class="ltx_text ltx_lst_identifier">Moon</span>,<span id="lstnumberx24.113" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.114" class="ltx_text ltx_lst_identifier">Mark</span><span id="lstnumberx24.115" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.116" class="ltx_text ltx_lst_identifier">Pellegrino</span>,<span id="lstnumberx24.117" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.118" class="ltx_text ltx_lst_identifier">Peter</span><span id="lstnumberx24.119" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.120" class="ltx_text ltx_lst_identifier">Stormare</span>,<span id="lstnumberx24.121" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.122" class="ltx_text ltx_lst_identifier">Flea</span>,<span id="lstnumberx24.123" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.124" class="ltx_text ltx_lst_identifier">Torsten</span><span id="lstnumberx24.125" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.126" class="ltx_text ltx_lst_identifier">Voges</span>,<span id="lstnumberx24.127" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.128" class="ltx_text ltx_lst_identifier">Jimmie</span><span id="lstnumberx24.129" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.130" class="ltx_text ltx_lst_identifier">Dale</span><span id="lstnumberx24.131" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.132" class="ltx_text ltx_lst_identifier">Gilmore</span>,<span id="lstnumberx24.133" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.134" class="ltx_text ltx_lst_identifier">Jack</span><span id="lstnumberx24.135" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.136" class="ltx_text ltx_lst_identifier">Kehler</span>,<span id="lstnumberx24.137" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.138" class="ltx_text ltx_lst_identifier">John</span><span id="lstnumberx24.139" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx24.140" class="ltx_text ltx_lst_identifier">Turturro</span>
