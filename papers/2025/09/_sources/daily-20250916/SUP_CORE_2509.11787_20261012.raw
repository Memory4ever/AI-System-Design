<span id="S3.T1.5.7.2.1.1" class="ltx_p"><span id="S3.T1.5.7.2.1.1.1" class="ltx_text" style="font-size:90%;">Context-specific warning message</span></span>
</span></td>
<td id="S3.T1.5.7.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top">
<span id="S3.T1.5.7.3.1" class="ltx_inline-block ltx_align_top" style="width:231.3pt;">
<span id="S3.T1.5.7.3.1.1" class="ltx_p"><span id="S3.T1.5.7.3.1.1.1" class="ltx_text" style="font-size:90%;">Make </span><span id="S3.T1.5.7.3.1.1.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">_number</span><span id="S3.T1.5.7.3.1.1.3" class="ltx_text" style="font-size:90%;"> a static final constant or non-public and provide
accessors if needed.</span></span>
</span></td></tr>
<tr id="S3.T1.5.8" class="ltx_tr">
<td id="S3.T1.5.8.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S3.T1.5.8.1.1" class="ltx_text" style="font-size:90%;">RuleType</span></td>
<td id="S3.T1.5.8.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
