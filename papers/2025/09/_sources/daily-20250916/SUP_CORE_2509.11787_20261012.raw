</div>
<div id="lstnumberx45" class="ltx_listingline"><span id="lstnumberx45.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#111111;">    </span><span id="lstnumberx45.2" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#111111;">{</span><span id="lstnumberx45.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#111111;"> </span><span id="lstnumberx45.4" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#1B5E20;">"line_number"</span><span id="lstnumberx45.5" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#404040;">:</span><span id="lstnumberx45.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#111111;"> </span><span id="lstnumberx45.7" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#AA2E25;">7</span><span id="lstnumberx45.8" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#AA2E25;">8</span><span id="lstnumberx45.9" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#404040;">,</span><span id="lstnumberx45.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#111111;"> </span><span id="lstnumberx45.11" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#1B5E20;">"new_lines"</span><span id="lstnumberx45.12" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#404040;">:</span><span id="lstnumberx45.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#111111;"> </span><span id="lstnumberx45.14" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#111111;">[</span><span id="lstnumberx45.15" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#1B5E20;">"Truth.assertThat(change.getNumber()).isEqualTo(changeNum);"</span><span id="lstnumberx45.16" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#404040;">]</span><span id="lstnumberx45.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#111111;"> </span><span id="lstnumberx45.18" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#111111;">}</span>
</div>
