<td id="S2.T2.2.14.5" class="ltx_td ltx_align_center">6e-7</td></tr>
<tr id="S2.T2.2.15" class="ltx_tr">
<th id="S2.T2.2.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">LR Schedule</th>
<td id="S2.T2.2.15.2" class="ltx_td ltx_align_center">cosine</td>
<td id="S2.T2.2.15.3" class="ltx_td ltx_align_center">cosine</td>
<td id="S2.T2.2.15.4" class="ltx_td ltx_align_center">cosine</td>
<td id="S2.T2.2.15.5" class="ltx_td ltx_align_center">constant</td></tr>
<tr id="S2.T2.2.16" class="ltx_tr">
<th id="S2.T2.2.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Max. #Grids</th>
<td id="S2.T2.2.16.2" class="ltx_td ltx_align_center">1<math id="S2.T2.m8" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>1</td>
<td id="S2.T2.2.16.3" class="ltx_td ltx_align_center">4<math id="S2.T2.m9" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>4</td>
<td id="S2.T2.2.16.4" class="ltx_td ltx_align_center">6<math id="S2.T2.m10" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>6</td>
<td id="S2.T2.2.16.5" class="ltx_td ltx_align_center">6<math id="S2.T2.m11" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>6</td></tr>
<tr id="S2.T2.2.17" class="ltx_tr">
