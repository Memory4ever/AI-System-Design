<td id="S2.T2.2.13.5" class="ltx_td ltx_align_center">6e-7</td></tr>
<tr id="S2.T2.2.14" class="ltx_tr">
<th id="S2.T2.2.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">LR (Vision)</th>
<td id="S2.T2.2.14.2" class="ltx_td ltx_align_center">–</td>
<td id="S2.T2.2.14.3" class="ltx_td ltx_align_center">2e-6</td>
