<script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.19/bundled/lenis.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.10.4/ScrollTrigger.min.js"></script>



<script>
document.addEventListener('DOMContentLoaded', () => { 
  
if (Webflow.env("editor") === undefined && window.matchMedia("(min-width: 992px)").matches) {
  // Initialize Lenis
  const lenis = new Lenis({
    prevent: (node) => node.classList.contains('cky-modal'), // allow cookie scroll
    duration: 1.2, // Define the duration of the scroll animation
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Easing function for the scroll animation
    direction: 'vertical', // Scroll direction: 'vertical' or 'horizontal'
    gestureDirection: 'vertical', // Direction for touch and wheel events: 'vertical' or 'horizontal'
    smooth: true, // Enable or disable smooth scrolling
    mouseMultiplier: 1, // Multiplier for mouse wheel events
    smoothTouch: false, // Enable or disable smooth touch events
    touchMultiplier: 2, // Multiplier for touch events
    infinite: false, // Enable or disable infinite scrolling
  });

  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }

  requestAnimationFrame(raf);
}
  
  
  
 });

  
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {

  //// ACCORDIONS
  function initAccordions() {
  document.querySelectorAll('.accordion').forEach(accordion => {
    if (accordion.dataset.accordionInit) return;
    if (accordion.closest('.nested-accordion-list')) return; // skip — delegation handles these
    accordion.dataset.accordionInit = 'true';

    const header = accordion.querySelector(':scope > .accordion-header');
    if (!header) return;
    header.setAttribute('role', 'button');
    header.setAttribute('tabindex', '0');
    header.setAttribute('aria-expanded', accordion.classList.contains('open') ? 'true' : 'false');
    header.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleAccordion(accordion);
    });
    header.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleAccordion(accordion);
      }
    });
  });
}

  function toggleAccordion(accordion) {
    const isOpen = accordion.classList.contains('open');
    const isIndependent = accordion.hasAttribute('data-accordion-independent');

    if (!isIndependent) {
      Array.from(accordion.parentElement.children)
        .filter(el => el !== accordion && el.classList.contains('accordion'))
        .forEach(sibling => {
          sibling.classList.remove('open');
          const siblingHeader = sibling.querySelector(':scope > .accordion-header');
          if (siblingHeader) siblingHeader.setAttribute('aria-expanded', 'false');
        });
    }

    accordion.classList.toggle('open', !isOpen);
    const header = accordion.querySelector(':scope > .accordion-header');
    if (header) header.setAttribute('aria-expanded', !isOpen ? 'true' : 'false');
  }

  initAccordions();
  
// MOBILE NAV
  
if (window.matchMedia("(max-width: 991px)").matches) {
  $('.nav_button, .nav-link, .foot-link').on('click', function() { 
    $('.header').toggleClass('is-dark');
  });
  
  $('.w-nav-menu').on('click', 'a', function() {
    $('.w-nav-button').triggerHandler('tap'); // Trigger the tap event
    $('.header').removeClass('is-dark'); // Remove the is-dark class from .header
  });
}


  
//// SWIPER JS

var NewsSwiper = document.querySelectorAll(".news-section");
NewsSwiper.forEach(function(section, index) {
    var swiperElement = section.querySelector(".news-swiper");
    var swiper = new Swiper(swiperElement, {
        slidesPerView: "auto",
        speed: 700,
        grabCursor: true,
        spaceBetween: 15,
        mousewheel: {
            forceToAxis: true,
        },
        breakpoints: {
            991: {
                slidesPerView: "auto",
                freeMode: true,
                speed: 1000,
                spaceBetween: 0
            }
        }
    });
    // Fix ARIA role conflict with Webflow collection list
    var wrapper = swiperElement.querySelector('.swiper-wrapper');
    if (wrapper) {
      wrapper.setAttribute('role', 'list');
      wrapper.querySelectorAll('.swiper-slide').forEach(function(slide) {
        slide.setAttribute('role', 'listitem');
      });
    }
});
  

//// TESTIMONIALS SWIPER
var testimonialsSections = document.querySelectorAll('.testimonials-section');
testimonialsSections.forEach(function(section) {
  var swiperElement = section.querySelector('.testimonials-swiper');
  if (!swiperElement) return;
  // Accessibility
  swiperElement.setAttribute('aria-roledescription', 'carousel');
  swiperElement.setAttribute('aria-label', 'Testimonials');
  var slides = swiperElement.querySelectorAll('.swiper-slide');
  slides.forEach(function(slide, i) {
    slide.setAttribute('role', 'listitem');
    slide.setAttribute('aria-roledescription', 'slide');
  });
  var paginationEl = section.querySelector('.swiper-pagination');
  var swiper = new Swiper(swiperElement, {
    slidesPerView: 1,
    speed: 500,
    spaceBetween: 30,
    loop: true,
    autoplay: {
      delay: 4000,
      disableOnInteraction: false,
    },
    a11y: {
      enabled: true,
      prevSlideMessage: 'Previous testimonial',
      nextSlideMessage: 'Next testimonial',
    },
    keyboard: {
      enabled: true,
      onlyInViewport: true,
    },
    pagination: {
      el: paginationEl,
      bulletActiveClass: 'is-active',
      bulletClass: 'testimonials-slider_bullet_item',
      bulletElement: 'button',
      clickable: true,
      renderBullet: function(i, className) {
        return '<button class="' + className + '" aria-label="Go to testimonial ' + (i + 1) + '"></button>';
      },
    },
  });

  var realSlides = swiperElement.querySelectorAll('.swiper-slide:not(.swiper-slide-duplicate)');
  realSlides.forEach(function(slide, i) {
    slide.setAttribute('aria-label', (i + 1) + ' of ' + realSlides.length);
  });

  // --- Play/Pause button ---
  var isPlaying = true;
  var btn = document.createElement('button');
  btn.className = 'testimonials-autoplay-btn';
  btn.setAttribute('aria-label', 'Pause testimonials autoplay');
  btn.innerHTML = `
    <svg class="icon-pause" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="5" y1="3" x2="5" y2="13"/>
      <line x1="11" y1="3" x2="11" y2="13"/>
    </svg>
    <svg class="icon-play" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" style="display:none;">
      <polygon points="4,2.5 13,8 4,13.5"/>
    </svg>
  `;
  btn.addEventListener('click', function() {
    if (isPlaying) {
      swiper.autoplay.stop();
      btn.setAttribute('aria-label', 'Play testimonials autoplay');
      btn.querySelector('.icon-pause').style.display = 'none';
      btn.querySelector('.icon-play').style.display = '';
    } else {
      swiper.autoplay.start();
      btn.setAttribute('aria-label', 'Pause testimonials autoplay');
      btn.querySelector('.icon-pause').style.display = '';
      btn.querySelector('.icon-play').style.display = 'none';
    }
    isPlaying = !isPlaying;
  });
  section.appendChild(btn);
});
  
  
//// GSAP
  
// Creative Animation
function creativeAnimation() {
  $(".hero-wrapper").each(function() {
    let tl = gsap.timeline({
      scrollTrigger: {
        trigger: this,
        start: "top top",
        end: "25% top",
        scrub: true
      }
    });
    tl.to($(this).find(".overlay"), {
      opacity: "90%"
    });
  });
}
creativeAnimation();
  
  
  
// Fade UP Animation
function fadeupAnimation() {
  $("[fade-up]").each(function() {
    let tl = gsap.timeline({
      scrollTrigger: {
        trigger: this,
        start: "top 85%",
        end: "top top",
        toggleActions: "play none none reverse"
      }
    });
    tl.from($(this), {
      y: "10px",
      opacity: 0,
      duration: 0.5,
      stagger: 0.3,
      ease: "power2.out",
    });
  });
}
fadeupAnimation();

   
});  
</script>

