html {-webkit-font-smoothing: antialiased;}

section {padding-top:var(--spacing--spacing-11); padding-bottom:var(--spacing--spacing-11)}
input, select {-webkit-appearance: none;}

.hamburger_wrap {
	--thickness: 2px;
	--gap: 0.3rem;
	--rotate: 45;
  --width: 100%;
}
.w--open .hamburger_line {
	transform: scaleX(0);
}
.w--open .hamburger_line:first-child {
	transform: translateY(calc(var(--thickness) + var(--gap))) rotate(calc(var(--rotate) * 3 * 1deg));
}
.w--open .hamburger_line:last-child {
	transform: translateY(calc(var(--thickness) * -1 + var(--gap) * -1)) rotate(calc(var(--rotate) * 1deg));
}

.is-dark .subheading {border-color: var(--swatch--grey-1)}

.is-dark .btn {background-color: var(--swatch--white); color: var(--swatch--grey-2); border-color: (--swatch--white)}
.is-dark .btn:hover {background-color: var(--swatch--yellow); border-color: (--swatch--yellow)}

.feature-block:hover .icon {transform:scale(0.85); color: #353538}
.feature-block:hover .text-overlay {opacity:1; transition-delay:0.2;}
.text-overlay {transition-delay:0;}

/**** NAVGATION ****/

.nav-link-wrapper:hover .nav-link {transform: translateY(-100%)}
.nav-link-wrapper:hover .nav-link.is-2 {transform: translateY(0%)}

/*** ACCORDION TABS **
.tab-link .tab-description {
height: 0;
opacity:0;
transition: height 0.5s cubic-bezier(.215, .61, .355, 1), opacity 0.5s cubic-bezier(.215, .61, .355, 1), visibility 2s;
}

.tab-link.w--current .tab-description {
height:auto;
opacity:1;
visibility: visible;}*/
.accordion-body > div {overflow:hidden}
.accordion.open .accordion-body, .w--current .accordion-body {grid-template-rows: 1fr; padding-bottom: var(--spacing--spacing-3); padding-top: var(--spacing--spacing-1); opacity:1;}
.open .open-close {opacity:1; transform: rotate(-45deg);}
.tab-link .accordion-body {padding-right:var(--spacing--spacing-5);}

.tab-link .accordion-header {opacity:0.4; transition: opacity 0.5s cubic-bezier(.215, .61, .355, 1)}
.tab-link.w--current .accordion-header, .tab-link .accordion-header:hover {opacity:1}


/**** FAQS ****/
.filter-link a {transition: padding 0.3s cubic-bezier(.215, .61, .355, 1);}
.filter-link:hover a {padding-left:0.5em;}


/**** RICHTEXT ****/
.w-richtext h1 {margin-top:0.3em; margin-bottom:0.1em}
.w-richtext h2 {margin-top:0.3em; margin-bottom:0.1em}
.w-richtext h3 {margin-top:0.6em; margin-bottom:0.1em}
.w-richtext h4 {margin-top:0.6em; margin-bottom:0.3em}
.w-richtext h5 {margin-top:1.4em; margin-bottom:0.3em}
.w-richtext h6 {margin-top:1.4em; margin-bottom:0.3em}
.underline-link, .w-richtext a {
background-image: linear-gradient(var(--color, currentColor), var(--color, currentColor));
  background-position: 0% 92%;
  background-repeat: no-repeat;
  background-size: 100% 1px;
  -moz-transition-property: background;
  -o-transition-property: background;
  -webkit-transition-property: background;
  transition-property: background;
  -moz-transition-duration: .6s;
  -o-transition-duration: .6s;
  -webkit-transition-duration: .6s;
  transition-duration: .6s;
  -moz-transition-timing-function: "cubic-bezier(0.25, 0.8, 0.25, 1)";
  -o-transition-timing-function: "cubic-bezier(0.25, 0.8, 0.25, 1)";
  -webkit-transition-timing-function: "cubic-bezier(0.25, 0.8, 0.25, 1)";
  transition-timing-function: "ecubic-bezier(0.25, 0.8, 0.25, 1)";
  -moz-transition-delay: 0s;
  -o-transition-delay: 0s;
  -webkit-transition-delay: 0s;
  transition-delay: 0s;}
.w-richtext a:hover, .underline-link:hover { background-size: 0% 1px;}


/**** FOOTER ****/
.foot-link {position:relative;}
.foot-link:before {content:''; position: absolute; bottom:-1px; left:0; right:0; height:1px; background: var(--swatch--grey-1)}
.foot-link:after {content:''; position: absolute; bottom:-1px; left:0; right:0; height:1px; background: var(--swatch--white); width:0%; transition: width 0.5s cubic-bezier(.215, .61, .355, 1);}
.foot-link:hover:after {width:100%;}



/***** TABLE STYLING *****/

thead {background: black; color: white}
thead th, thead td {border: 1px solid white}
th, td {
  padding: 15px;
  text-align: left;
  border: 1px solid #eee;
}

tr:nth-child(even) {background-color: #f8f8f8;}


/***** CUSTOM PACKS TABS *****/

.tab-link .accordion-body {grid-template-rows: 0fr;}

.tab-link.open .accordion-header {opacity:1}
.tab-link.open .accordion-body {grid-template-rows: 1fr; padding-bottom: var(--spacing--spacing-3); padding-top: var(--spacing--spacing-1); opacity:1;}



/***** BLOG *****/


.blog-tile .img-absolute {
  transform: scale(1.05);
  transition-property: transform;
  transition-duration: 600ms;
  transition-timing-function: cubic-bezier(.215, .61, .355, 1);
}

.blog-tile:hover .img-absolute {
  transform: scale(1);
}

.news-slide:last-child {margin-right:0;}


.w-richtext.terms h4 {font-size:1.6rem}
.w-richtext.terms p, .w-richtext.terms ul li {font-size: 1rem;}
ol {
    counter-reset: list-counter;
    margin: 0 0 1em 0em;
    padding: 0;
}

ol ol {
    counter-reset: sublist-counter;
    margin: 1rem 0 0.5em 0;
}

ol > li {
    counter-increment: list-counter;
    list-style: none;
    position: relative;
}

ol li {
    margin-bottom: 0.5em;
    line-height: 1.5;
    padding-left: 0;
    font-size: 1.6rem;
    font-weight: 500;
}

ol > li::before {
    content: counter(list-counter) ". ";
    position: absolute;
    left: 0em;
    opacity: 0;
}

ol ol > li {
    counter-increment: sublist-counter;
    list-style: none;
    position: relative;
    padding-left: 2.2em;
    font-size: 1rem;
    font-weight: normal;
}

ol ol > li::before {
    content: counter(list-counter) "." counter(sublist-counter) " ";
    position: absolute;
    left: 0;
    font-weight: normal;
    opacity: 1;
}

ol ol ol {
    list-style-type: lower-alpha;
    margin: .5em 0 0.5em 0;
}

ol ol ol > li {
    list-style: none;
    position: relative;
    padding-left:1.5em;
}

ol ol ol > li::before {
    content: counter(list-item, lower-alpha) ".";
    position: absolute;
    left: 0;
}


input {-webkit-appearance: none;}
@media screen and (max-width: 767px) {

:root {
--spacing--spacing-7: 1rem;
--spacing--spacing-11: 7rem;
}

/*** CURSOR ***/
.dark-cursor-square, .dot {
  display:none;
}

.navigation {clip-path: polygon(0 0, 100% 0, 100% 0%, 0 0%); transition: clip-path 0.7s cubic-bezier(.215, .61, .355, 1);}

.open .navigation {clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%); pointer-events: all;}
.open .logo {color: var(--swatch--white);}
.header.is-dark .nav-btn.mobile {opacity:0}

section {padding-top:var(--spacing--spacing-8); padding-bottom:var(--spacing--spacing-8)}


.tab-link .accordion-header {opacity:1}
.accordion .accordion-body {padding:0;}
.accordion.open .accordion-body {padding-bottom: var(--spacing--spacing-5);}
.tab-link.open .accordion-body {grid-template-rows: 0fr;}
.tab-link.open .open .accordion-body {grid-template-rows: 1fr; padding-bottom: var(--spacing--spacing-3); padding-top: var(--spacing--spacing-1); opacity:1;}


.feature-block:hover .icon {transform:scale(1); color: #000000}

.accordion.open .read-more-wrapper .underline-link {transform: translateY(-100%);}
.accordion.open .read-more-wrapper .underline-link.is-2 {transform: translateY(0%);}

}


/* Styling the checkboxes on the new blog categories pages */

.blog-filter input[type="radio"] {
  width: 16px;
  height: 16px;
  border: 1px solid black;
  border-radius: 0;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  flex-shrink: 0;
}

.blog-filter input[type="radio"]:checked {
  background-color: black;
}

/* Make sure placeholder text on black is white */
.input.dark-mode::placeholder {
  color: white;
  opacity: 1;
}

/* testimonials button styling */

.testimonials-section {
  position: relative;
}

.testimonials-autoplay-btn {
  position: absolute;
  bottom: 66.9534px;
  right: 2.5rem;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 50%;
  border: 1px solid currentColor;
  background: transparent;
  cursor: pointer;
  color: inherit;
  transition: opacity 0.2s;
}

.testimonials-autoplay-btn:hover {
  opacity: 0.7;
}

.testimonials-autoplay-btn:focus-visible {
  outline: 1px solid currentColor;
  outline-offset: 3px;
}

@media (max-width: 991px) {
  .testimonials-autoplay-btn {
    bottom: 1rem;
    left: auto;
    right: 1rem;
  }
}

