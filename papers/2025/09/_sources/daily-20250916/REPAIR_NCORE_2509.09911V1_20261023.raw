<td id="Sx3.T1.2.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx3.T1.2.4.2.1" class="ltx_text ltx_font_bold">0.815 (0.022)</span></td>
<td id="Sx3.T1.2.4.3" class="ltx_td ltx_align_center ltx_border_t">0.252 (0.025)</td>
<td id="Sx3.T1.2.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="Sx3.T1.2.4.4.1" class="ltx_text ltx_font_bold">0.794 (0.033)</span></td>
<td id="Sx3.T1.2.4.5" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx3.T1.2.4.5.1" class="ltx_text ltx_font_bold">0.543 (0.052)</span></td>
<td id="Sx3.T1.2.4.6" class="ltx_td ltx_align_center ltx_border_t">0.711 (0.051)</td>
<td id="Sx3.T1.2.4.7" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx3.T1.2.4.7.1" class="ltx_text ltx_font_bold">0.492 (0.058)</span></td></tr>
<tr id="Sx3.T1.2.5" class="ltx_tr">
<th id="Sx3.T1.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="Sx3.T1.2.5.1.1" class="ltx_text ltx_font_bold">DenseNet Only</span></th>
<td id="Sx3.T1.2.5.2" class="ltx_td ltx_align_center ltx_border_t">0.810 (0.030)</td>
