<th id="Sx3.T1.2.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="Sx3.T1.2.2.5.1" class="ltx_text ltx_font_bold">MAE</span></th>
<th id="Sx3.T1.2.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="Sx3.T1.2.2.6.1" class="ltx_text ltx_font_bold">Kappa</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="Sx3.T1.2.3" class="ltx_tr">
<th id="Sx3.T1.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="Sx3.T1.2.3.1.1" class="ltx_text ltx_font_bold">ViT Only</span></th>
<td id="Sx3.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_t">0.712 (0.025)</td>
<td id="Sx3.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_t">0.375 (0.026)</td>
<td id="Sx3.T1.2.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.680 (0.028)</td>
<td id="Sx3.T1.2.3.5" class="ltx_td ltx_align_center ltx_border_t">0.462 (0.020)</td>
<td id="Sx3.T1.2.3.6" class="ltx_td ltx_align_center ltx_border_t">0.867 (0.054)</td>
<td id="Sx3.T1.2.3.7" class="ltx_td ltx_align_center ltx_border_t">0.402 (0.022)</td></tr>
<tr id="Sx3.T1.2.4" class="ltx_tr">
