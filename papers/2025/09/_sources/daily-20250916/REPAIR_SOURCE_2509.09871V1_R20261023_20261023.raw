<th id="S4.T2.2.24.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">AIC</th>
<td id="S4.T2.2.24.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m8" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>68.589</td>
