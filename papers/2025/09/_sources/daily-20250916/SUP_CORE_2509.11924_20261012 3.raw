<th id="S3.T1.2.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="5"><span id="S3.T1.2.1.7.1" class="ltx_text ltx_font_bold">Components<sup id="S3.T1.2.1.7.1.1" class="ltx_sup"><span id="S3.T1.2.1.7.1.1.1" class="ltx_text ltx_font_italic">4</span></sup></span></th></tr>
<tr id="S3.T1.2.2" class="ltx_tr">
<th id="S3.T1.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.1.1" class="ltx_text ltx_font_bold">male</span></th>
<th id="S3.T1.2.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.2.1" class="ltx_text ltx_font_bold">female</span></th>
<th id="S3.T1.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.3.1" class="ltx_text ltx_font_bold">CB</span></th>
<th id="S3.T1.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.4.1" class="ltx_text ltx_font_bold">ICA</span></th>
<th id="S3.T1.2.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.5.1" class="ltx_text ltx_font_bold">CCA</span></th>
