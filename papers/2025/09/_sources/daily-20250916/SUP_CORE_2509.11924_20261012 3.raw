<th id="S3.T1.2.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.7.1" class="ltx_text ltx_font_bold">moderate</span></th>
<th id="S3.T1.2.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.8.1" class="ltx_text ltx_font_bold">severe</span></th>
<th id="S3.T1.2.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.9.1" class="ltx_text ltx_font_bold">LRC</span></th>
<th id="S3.T1.2.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.10.1" class="ltx_text ltx_font_bold">CA</span></th>
<th id="S3.T1.2.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.11.1" class="ltx_text ltx_font_bold">IPH</span></th>
<th id="S3.T1.2.2.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S3.T1.2.2.12.1" class="ltx_text ltx_font_bold">UC</span></th>
