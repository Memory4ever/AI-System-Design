<td id="S8.T4.3.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:3pt 4.0pt;">33.0</td>
<td id="S8.T4.3.2.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E6FFFF;padding:3pt 4.0pt;"><span id="S8.T4.3.2.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6FFFF;">54.0</span></td></tr>
<tr id="S8.T4.3.3" class="ltx_tr">
<td id="S8.T4.3.3.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r" style="padding:3pt 4.0pt;"><span id="S8.T4.3.3.1.1" class="ltx_text ltx_font_bold">Adversarial</span></td>
