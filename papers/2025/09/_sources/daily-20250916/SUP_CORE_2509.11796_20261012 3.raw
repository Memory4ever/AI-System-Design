<td id="A5.T5.3.3.6" class="ltx_td ltx_align_center" style="padding:3pt 3.4pt;"><span id="A5.T5.3.3.6.1" class="ltx_text" style="--ltx-bg-color:#FFFFE6;">38.9</span></td>
