<td id="S6.T3.5.5.5" class="ltx_td ltx_align_center" style="padding:3pt 2.3pt;"><span id="S6.T3.5.5.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFE6;">47.9</span></td></tr>
<tr id="S6.T3.5.6" class="ltx_tr" style="--ltx-bg-color:#FFFFE6;">
<td id="S6.T3.5.6.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:3pt 2.3pt;"><span id="S6.T3.5.6.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFE6;">w/o <math id="S6.T3.m8" class="ltx_Math" alttext="\mathcal{F}_{\text{React}},\;\mathcal{S}_{segment,\;select,\;match}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-bg-color:#FFFFE6;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFE6">ℱ</mi><mtext style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">React</mtext></msub><mo style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6" rspace="0.447em">,</mo><msub><mi style="--ltx-bg-color:#FFFFE6;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFE6">𝒮</mi><mrow><mrow><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">s</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">g</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">m</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">n</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">t</mi></mrow><mo style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6" rspace="0.447em">,</mo><mrow><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">s</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">l</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">t</mi></mrow><mo style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6" rspace="0.447em">,</mo><mrow><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">m</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">h</mi></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\text{React}},\;\mathcal{S}_{segment,\;select,\;match}</annotation></semantics></math></span></td>
<td id="S6.T3.5.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:3pt 2.3pt;"><span id="S6.T3.5.6.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFE6;">79.8</span></td>
