<td id="S8.T4.3.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:3pt 4.0pt;"><math id="S8.T4.m1" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> VideoTree</td>
<td id="S8.T4.3.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="--ltx-bg-color:#E6FFFF;padding:3pt 4.0pt;"><math id="S8.T4.m2" class="ltx_Math" style="--ltx-bg-color:#E6FFFF;" alttext="+" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6FFFF;" mathbackground="#E6FFFF">+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math><span id="S8.T4.3.1.4.1" class="ltx_text" style="--ltx-bg-color:#E6FFFF;"> <span id="S8.T4.3.1.4.1.1" class="ltx_text ltx_font_bold">FineQuest (Ours)</span></span></td></tr>
<tr id="S8.T4.3.2" class="ltx_tr">
<td id="S8.T4.3.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:3pt 4.0pt;"><span id="S8.T4.3.2.1.1" class="ltx_text ltx_font_bold">Original</span></td>
