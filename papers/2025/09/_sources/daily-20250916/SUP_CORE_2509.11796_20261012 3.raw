/mo><mi style="--ltx-bg-color:#FFFFE6;" mathbackground="#FFFFE6">t</mi></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\text{React}},\;\mathcal{S}_{segment,\;select}</annotation></semantics></math></span></td>
