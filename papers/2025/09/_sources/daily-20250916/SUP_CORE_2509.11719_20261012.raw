<tbody class="ltx_tbody">
<tr id="S4.T1.12.1.2" class="ltx_tr">
<td id="S4.T1.12.1.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">MTR++ (<cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib21" title="" class="ltx_ref">Shi et al. (2024)</a></cite>)</td>
<td id="S4.T1.12.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.5906</td>
<td id="S4.T1.12.1.2.3" class="ltx_td ltx_align_center ltx_border_t">1.1939</td>
<td id="S4.T1.12.1.2.4" class="ltx_td ltx_align_center ltx_border_t">12.98</td>
<td id="S4.T1.12.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">12.81</td>
<td id="S4.T1.12.1.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">43.51</td>
<td id="S4.T1.12.1.2.7" class="ltx_td ltx_align_center ltx_border_t">43.29</td>
