<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> <span id="alg2.5" class="ltx_text ltx_font_smallcaps">Hilbert</span>: Subgoal Resolution</figcaption>
<div id="alg2.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            <span id="alg2.l1.2" class="ltx_text ltx_font_bold">function</span> <span id="alg2.l1.3" class="ltx_text ltx_font_smallcaps">SolveAllSubgoals</span>(<span id="alg2.l1.4" class="ltx_text ltx_markedasmath ltx_font_typewriter">subgoals</span>, <span id="alg2.l1.5" class="ltx_text ltx_markedasmath ltx_font_typewriter"> proved_subgoals</span>, <span id="alg2.l1.6" class="ltx_text ltx_markedasmath ltx_font_typewriter"> sketch_assembled</span>, <span id="alg2.l1.7" class="ltx_text ltx_markedasmath ltx_font_typewriter"> header</span>, <span id="alg2.l1.8" class="ltx_text ltx_markedasmath ltx_font_typewriter"> depth</span>)

