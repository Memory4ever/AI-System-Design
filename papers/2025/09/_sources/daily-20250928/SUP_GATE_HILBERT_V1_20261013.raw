</div>
<div id="alg8.l36" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">36:</span>
              
              
               <span id="alg8.l36.2" class="ltx_text ltx_font_bold">return</span> <math id="alg8.l36.m1" class="ltx_Math" alttext="\texttt{existing\_theorems}+\texttt{additional\_theorems}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">existing_theorems</mtext><mo>+</mo><mtext class="ltx_mathvariant_monospace">additional_theorems</mtext></mrow><annotation encoding="application/x-tex">\texttt{existing\_theorems}+\texttt{additional\_theorems}</annotation></semantics></math>

</div>
<div id="alg8.l37" class="ltx_listingline">
