<div id="lstnumberx31" class="ltx_listingline"><span id="lstnumberx31.1" class="ltx_text ltx_lst_space">    </span>"<span id="lstnumberx31.2" class="ltx_text ltx_lst_identifier">r_</span>{<span id="lstnumberx31.3" class="ltx_text ltx_lst_identifier">vdW</span>}<span id="lstnumberx31.4" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx31.5" class="ltx_text ltx_lst_space"> </span>1/2<span id="lstnumberx31.6" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx31.7" class="ltx_text ltx_lst_space"> </span>2<span id="lstnumberx31.8" class="ltx_text ltx_lst_space"> </span>\\<span id="lstnumberx31.9" class="ltx_text ltx_lst_identifier">mu_</span>{2<span id="lstnumberx31.10" class="ltx_text ltx_lst_identifier">b</span>}<span id="lstnumberx31.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx31.12" class="ltx_text ltx_lst_identifier">C_6</span><span id="lstnumberx31.13" class="ltx_text ltx_lst_space"> </span>/<span id="lstnumberx31.14" class="ltx_text ltx_lst_space"> </span>\\<span id="lstnumberx31.15" class="ltx_text ltx_lst_identifier">hbar</span>^2<span id="lstnumberx31.16" class="ltx_text ltx_lst_space"> </span>)^{1/4}",
