<div id="lstnumberx32" class="ltx_listingline"><span id="lstnumberx32.1" class="ltx_text ltx_lst_space">    </span>"<span id="lstnumberx32.2" class="ltx_text ltx_lst_identifier">v</span>(<span id="lstnumberx32.3" class="ltx_text ltx_lst_identifier">r</span>)<span id="lstnumberx32.4" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx32.5" class="ltx_text ltx_lst_space"> </span>-16<span id="lstnumberx32.6" class="ltx_text ltx_lst_space"> </span>/<span id="lstnumberx32.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx32.8" class="ltx_text ltx_lst_identifier">r</span>^6<span id="lstnumberx32.9" class="ltx_text ltx_lst_space"> </span>[<span id="lstnumberx32.10" class="ltx_text ltx_lst_space"> </span>1<span id="lstnumberx32.11" class="ltx_text ltx_lst_space"> </span>-<span id="lstnumberx32.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx32.13" class="ltx_text ltx_lst_identifier">C</span><span id="lstnumberx32.14" class="ltx_text ltx_lst_space"> </span>/<span id="lstnumberx32.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx32.16" class="ltx_text ltx_lst_identifier">r</span>^4<span id="lstnumberx32.17" class="ltx_text ltx_lst_space"> </span>]",
