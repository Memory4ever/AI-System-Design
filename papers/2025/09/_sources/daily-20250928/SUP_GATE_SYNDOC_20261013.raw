<th id="A3.T10.2.1.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;">
<span id="A3.T10.2.1.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="A3.T10.2.1.1.1.1" class="ltx_p"><span id="A3.T10.2.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Module</span></span>
</span></th>
<th id="A3.T10.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;">
<span id="A3.T10.2.1.2.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
