;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 49.16 -39.2)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="5.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic1.m85" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 -31.7 31.98)"><foreignObject style="--ltx-fo-width:2.56em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="35.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic1.m86" class="ltx_Math" alttext="P@10" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>@</mi><mo lspace="0em" rspace="0em">​</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">P@10</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 11.24 125.95)"><foreignObject style="--ltx-fo-width:2.92em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="40.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F5.pic1.9" class="ltx_text">(h)<math id="A3.F5.pic1.m87" class="ltx_Math" alttext="P@10" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>@</mi><mo lspace="0em" rspace="0em">​</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">P@10</annotation></semantics></math> vs <math id="A3.F5.pic1.m88" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math></span></span></span></foreignObject></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>Ablation study of Qwen2.5-Coder-0.5B and Llama3.2-1B models.  <span id="A3.F5.2" class="ltx_text"><span class="ltx_rule" style="width:3.9pt;height:3.9pt;--ltx-bg-color:black;display:inline-block;"> </span></span>  Qwen2.5-Coder-0.5B  <span id="A3.F5.3" class="ltx_text"><span class="ltx_rule" style="width:3.9pt;height:3.9pt;--ltx-bg-color:black;display:inline-block;"> </span></span>  Llama3.2-1B</figcaption>
</figure>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span><span id="A4.2" class="ltx_text ltx_font_bold">AST analysis</span></h2>

<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span><span id="A4.SS1.2" class="ltx_text ltx_font_bold">Interpretable Syntax sets and interactions</span></h3>

<div id="A4.SS1.p1" class="ltx_para ltx_noindent">
<p id="A4.SS1.p1.1" class="ltx_p"><span id="A4.SS1.p1.1.1" class="ltx_text ltx_font_bold">Token Set <math id="A4.SS1.p1.m1" class="ltx_Math" alttext="\uptau" display="inline" intent=":literal"><semantics><mi mathvariant="normal">τ</mi><annotation encoding="application/x-tex">\uptau</annotation></semantics></math></span>, this set contains the code tokens <math id="A4.SS1.p1.m2" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math> derived from the generated code snippets <math id="A4.SS1.p1.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, where each token’s confidence is computed as outlined in  <a href="#S5" title="5 AST analysis ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. <span id="A4.SS1.p1.1.2" class="ltx_text ltx_font_bold">Subcategory Set <math id="A4.SS1.p1.m4" class="ltx_Math" alttext="\upsilon" display="inline" intent=":literal"><semantics><mi>υ</mi><annotation encoding="application/x-tex">\upsilon</annotation></semantics></math></span>, this set consists of elements from Context-Free Grammars (CFGs), which are rules that capture the syntactic and structural aspects of a programming language. Formally, a CFG is defined as <math id="A4.SS1.p1.m5" class="ltx_Math" alttext="G=(\alpha,\lambda,\omega,\beta)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>λ</mi><mo>,</mo><mi>ω</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(\alpha,\lambda,\omega,\beta)</annotation></semantics></math>, where <math id="A4.SS1.p1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is the finite set of non-terminal nodes, <math id="A4.SS1.p1.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> the finite set of terminal nodes, <math id="A4.SS1.p1.m8" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> the finite set of production rules, and <math id="A4.SS1.p1.m9" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> the start symbol. CFGs utilize terminal and non-terminal nodes (i.e., subcategories) to specify production rules <math id="A4.SS1.p1.m10" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> for statements such as conditionals, assignments, or operators. Importantly, terminal and non-terminal nodes serve distinct purposes. These nodes correspond to the elements of the subcategory set <math id="A4.SS1.p1.m11" class="ltx_Math" alttext="\upsilon" display="inline" intent=":literal"><semantics><mi>υ</mi><annotation encoding="application/x-tex">\upsilon</annotation></semantics></math>, with <math id="A4.SS1.p1.m12" class="ltx_Math" alttext="\lambda,\alpha\in\upsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>,</mo><mi>α</mi></mrow><mo>∈</mo><mi>υ</mi></mrow><annotation encoding="application/x-tex">\lambda,\alpha\in\upsilon</annotation></semantics></math>.</p>
</div>
<div id="A4.SS1.p2" class="ltx_para ltx_noindent">
<p id="A4.SS1.p2.1" class="ltx_p">The interaction between the token set <math id="A4.SS1.p2.m1" class="ltx_Math" alttext="\uptau" display="inline" intent=":literal"><semantics><mi mathvariant="normal">τ</mi><annotation encoding="application/x-tex">\uptau</annotation></semantics></math> and the subcategory set <math id="A4.SS1.p2.m2" class="ltx_Math" alttext="\upsilon" display="inline" intent=":literal"><semantics><mi>υ</mi><annotation encoding="application/x-tex">\upsilon</annotation></semantics></math> is governed by the <span id="A4.SS1.p2.1.1" class="ltx_text ltx_font_bold">Alignment Function <math id="A4.SS1.p2.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math></span>. This function establishes a many-to-one or one-to-one mapping from each token <math id="A4.SS1.p2.m4" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math> in the token set <math id="A4.SS1.p2.m5" class="ltx_Math" alttext="\uptau" display="inline" intent=":literal"><semantics><mi mathvariant="normal">τ</mi><annotation encoding="application/x-tex">\uptau</annotation></semantics></math> to a terminal node <math id="A4.SS1.p2.m6" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> in the subcategory set <math id="A4.SS1.p2.m7" class="ltx_Math" alttext="\upsilon" display="inline" intent=":literal"><semantics><mi>υ</mi><annotation encoding="application/x-tex">\upsilon</annotation></semantics></math>. For example, Fig.2  <a href="#S5.F2" title="Figure 2 ‣ 5.1 Syntax Grounded explanations ‣ 5 AST analysis ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> shows the alignment of the token ’try_’ with the terminal node ’try’, where the character "_" is disregarded. It is important to note that tokenization may produce sequences in which tokens do not align one-to-one with terminal nodes. For instance, Fig.2  <a href="#S5.F2" title="Figure 2 ‣ 5.1 Syntax Grounded explanations ‣ 5 AST analysis ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> illustrates how the tokens ’flo_’ and ’at’ are both aligned with the terminal node ’float’. Formally, this can be expressed as <math id="A4.SS1.p2.m8" class="ltx_math_unparsed" alttext="\delta(^{\prime}flo\_^{\prime},^{\prime}at^{\prime})\rightarrow[^{\prime}float^{\prime}]" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mrow><msup><mo stretchy="false">(</mo><mo>′</mo></msup><mi>f</mi><mi>l</mi><mi>o</mi><msup><mi>_</mi><mo>′</mo></msup><msup><mo>,</mo><mo>′</mo></msup><mi>a</mi><msup><mi>t</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><msup><mo stretchy="false">[</mo><mo>′</mo></msup><mi>f</mi><mi>l</mi><mi>o</mi><mi>a</mi><msup><mi>t</mi><mo>′</mo></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\delta(^{\prime}flo\_^{\prime},^{\prime}at^{\prime})\rightarrow[^{\prime}float^{\prime}]</annotation></semantics></math>, representing a many-to-one mapping. Thus, the alignment between code tokens and terminal nodes is strictly many-to-one (which includes the special case of one-to-one), but never one-to-many or many-to-many.</p>
</div>
<div id="A4.SS1.p3" class="ltx_para ltx_noindent">
<p id="A4.SS1.p3.1" class="ltx_p"><span id="A4.SS1.p3.1.1" class="ltx_text ltx_font_bold">Category Set <math id="A4.SS1.p3.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math></span>. Step 3 in Fig.1  <a href="#S5.F1" title="Figure 1 ‣ 5 AST analysis ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> illustrates how <math id="A4.SS1.p3.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> and <math id="A4.SS1.p3.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> are combined into a category <math id="A4.SS1.p3.m4" class="ltx_Math" alttext="c\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">c\in\Lambda</annotation></semantics></math>. The elements of the Category Set <math id="A4.SS1.p3.m5" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> are referred to as Syntax Categories (SCs). Based on tree-sitter bindings for Python, we define eight distinct SCs. These categories represent semantic units that facilitate the syntax-level interpretability of LLMs. Consequently, AST analysis provides a developer-oriented explanation of Token-Level confidence. In summary, each token in a sequence <math id="A4.SS1.p3.m6" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> can be mapped to a category <math id="A4.SS1.p3.m7" class="ltx_Math" alttext="c\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">c\in\Lambda</annotation></semantics></math>. Through AST analysis, developers can directly relate LLM code predictions to meaningful structural attributes.</p>
</div>
<div id="A4.SS1.p4" class="ltx_para ltx_noindent">
<p id="A4.SS1.p4.1" class="ltx_p">A <span id="A4.SS1.p4.1.1" class="ltx_text ltx_font_bold">clustering function <math id="A4.SS1.p4.m1" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math></span> computes the confidence performance of <math id="A4.SS1.p4.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> and <math id="A4.SS1.p4.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> nodes (subcategories) within an AST by hierarchically aggregating Token-Level Confidences into a category <math id="A4.SS1.p4.m4" class="ltx_Math" alttext="c\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">c\in\Lambda</annotation></semantics></math>. After tokens are aligned to their respective nodes using <math id="A4.SS1.p4.m5" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>, AST analysis groups them into either their corresponding category or non-terminal <math id="A4.SS1.p4.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> node, following the AST structure. In some cases, terminal <math id="A4.SS1.p4.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> nodes may be directly aggregated into a category without involving intermediate non-terminal <math id="A4.SS1.p4.m8" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> nodes. The function <math id="A4.SS1.p4.m9" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> can be configured to use different aggregation strategies, such as average, median, or maximum. In our experiments, we define the clustering function as <math id="A4.SS1.p4.m10" class="ltx_math_unparsed" alttext="\zeta:\upsilon\rightarrow\text{avg}(w_{1:i})" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>υ</mi><mo stretchy="false">→</mo><mtext>avg</mtext><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta:\upsilon\rightarrow\text{avg}(w_{1:i})</annotation></semantics></math> for a subset of tokens <math id="A4.SS1.p4.m11" class="ltx_Math" alttext="w_{\leq i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">w_{\leq i}</annotation></semantics></math>. The 8 defined syntax categories are:</p>
</div>
<div class="ltx_pagination ltx_role_start_3_columns"></div>
<div id="A4.SS1.p5" class="ltx_para ltx_noindent">
<ul id="A4.I1" class="ltx_itemize ltx_leftmargin_flush">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i1.p1.1" class="ltx_p">Decisions</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i2.p1.1" class="ltx_p">Data Structures</p>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i3.p1.1" class="ltx_p">Exceptions</p>
</div></li>
<li id="A4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i4.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i4.p1.1" class="ltx_p">Iterations</p>
</div></li>
<li id="A4.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i5.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i5.p1.1" class="ltx_p">Functional Programming</p>
</div></li>
<li id="A4.I1.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i6.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i6.p1.1" class="ltx_p">Operators</p>
</div></li>
<li id="A4.I1.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i7.p1" class="ltx_para ltx_noindent">
<p id="A4.I1.i7.p1.1" class="ltx_p">Scope</p>
</div></li>
<li id="A4.I1.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i8.p1" class="ltx_para">
