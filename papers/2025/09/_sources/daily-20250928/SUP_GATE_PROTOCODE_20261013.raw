<th id="A2.T3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Linear</th>
<td id="A2.T3.2.2.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">(latent size <math id="A2.T3.m1" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>, Prototype size )</td></tr>
