ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx16" class="ltx_listingline"><span id="lstnumberx16.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Hint</span><span id="lstnumberx16.2" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx16.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Use</span><span id="lstnumberx16.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx16.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">built</span><span id="lstnumberx16.9" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx16.10" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">in</span><span id="lstnumberx16.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">function</span><span id="lstnumberx16.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.14" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">sum</span><span id="lstnumberx16.15" class="ltx_text ltx_font_typewriter">()</span><span id="lstnumberx16.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx16.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">calculate</span><span id="lstnumberx16.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx16.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">square</span><span id="lstnumberx16.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx16.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">each</span><span id="lstnumberx16.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">element</span><span id="lstnumberx16.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.31" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">in</span><span id="lstnumberx16.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">my_list</span><span id="lstnumberx16.34" class="ltx_text ltx_font_typewriter">.</span>
</div>
</div></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<div id="A2.F4.3" class="ltx_listing ltx_figure_panel ltx_lst_language_Python ltx_lstlisting ltx_minipage ltx_align_center ltx_align_middle ltx_framed ltx_framed_rectangle ltx_listing" style="width:190.8pt;"><div class="ltx_listing_data"><a href="data:text/plain;base64,ICAgICAgICAgIGRlZiBzcXVhcmVfb2ZfbGlzdChteV9saXN0KToKICAgICIiIlJldHVybiB0aGUgc3F1YXJlIG9mIGVhY2ggZWxlbWVudCBpbiBteV9saXN0LiIiIgogICAgcmV0dXJuIFtsYW1iZGEgeDogeCoqMiBmb3IgeCBpbiBteV9saXN0XQpFTkQKW0VORF0=" download="">⬇</a></div>
<div id="lstnumberx17" class="ltx_listingline"><span id="lstnumberx17.1" class="ltx_text ltx_lst_space ltx_font_typewriter">          </span><span id="lstnumberx17.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">def</span><span id="lstnumberx17.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">square_of_list</span><span id="lstnumberx17.5" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx17.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">my_list</span><span id="lstnumberx17.7" class="ltx_text ltx_font_typewriter">):</span>
</div>
<div id="lstnumberx18" class="ltx_listingline"><span id="lstnumberx18.1" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx18.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF8000;">""</span><span id="lstnumberx18.3" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF8000;">"Return<span id="lstnumberx18.3.1" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx18.3.2" class="ltx_text ltx_lst_space"> </span>square<span id="lstnumberx18.3.3" class="ltx_text ltx_lst_space"> </span>of<span id="lstnumberx18.3.4" class="ltx_text ltx_lst_space"> </span>each<span id="lstnumberx18.3.5" class="ltx_text ltx_lst_space"> </span>element<span id="lstnumberx18.3.6" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx18.3.7" class="ltx_text ltx_lst_space"> </span>my_list."</span><span id="lstnumberx18.4" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF8000;">""</span>
</div>
<div id="lstnumberx19" class="ltx_listingline"><span id="lstnumberx19.1" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx19.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">return</span><span id="lstnumberx19.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.4" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx19.5" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">lambda</span><span id="lstnumberx19.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">x</span><span id="lstnumberx19.8" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx19.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">x</span><span id="lstnumberx19.11" class="ltx_text ltx_font_typewriter">**2</span><span id="lstnumberx19.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.13" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">for</span><span id="lstnumberx19.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">x</span><span id="lstnumberx19.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.17" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">in</span><span id="lstnumberx19.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">my_list</span><span id="lstnumberx19.20" class="ltx_text ltx_font_typewriter">]</span>
</div>
<div id="lstnumberx20" class="ltx_listingline"><span id="lstnumberx20.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">END</span>
</div>
<div id="lstnumberx21" class="ltx_listingline"><span id="lstnumberx21.1" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx21.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">END</span><span id="lstnumberx21.3" class="ltx_text ltx_font_typewriter">]</span>
</div>
</div></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>Comparison of two code snippets Before and After code sanitization with evalplus</figcaption>
</figure>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span><span id="A3.2" class="ltx_text ltx_font_bold">Ablation Study</span></h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">As outlined in Section <a href="#A2.SS2" title="B.2 Training Parameters ‣ Appendix B Methodology ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, the baseline configurations were employed for the initial experiments. To further investigate performance limitations, we conducted an ablation study focusing on LLMs that demonstrated comparatively weaker results. Specifically, under the baseline settings, the Llama3.2 and Qwen3 models underperformed relative to other methods. Consequently, we performed an extensive hyperparameter ablation on these models to better understand their sensitivities and performance dynamics.</p>
</div>
<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span><span id="A3.SS1.2" class="ltx_text ltx_font_bold">Effect of <math id="A3.SS1.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math></span></h3>

<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p">The parameter <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> denotes the dimension of the linear submanifold <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="X_{i}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>i</mi></msub><annotation encoding="application/x-tex">X_{i}</annotation></semantics></math>, which locally approximates the data manifold around a point <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="h_{\theta}(z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{\theta}(z)</annotation></semantics></math>.
To examine its effect, we vary <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> in the range <math id="A3.SS1.p1.m5" class="ltx_Math" alttext="[2,8]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>2</mn><mo>,</mo><mn>8</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[2,8]</annotation></semantics></math> with a step size of <math id="A3.SS1.p1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.
As shown in Figure <a href="#A3.F5" title="Figure 5 ‣ C.8 Overall effect ‣ Appendix C Ablation Study ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>(a), performance consistently decreases in both models as <math id="A3.SS1.p1.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> increases.
This trend arises because <math id="A3.SS1.p1.m8" class="ltx_Math" alttext="X_{i}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>i</mi></msub><annotation encoding="application/x-tex">X_{i}</annotation></semantics></math> is intended to approximate the immediate neighborhood of a point, which is inherently low-dimensional.
Larger values of <math id="A3.SS1.p1.m9" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> may lead to overfitting, since only a limited number of nearby samples are available within a batch to reliably estimate <math id="A3.SS1.p1.m10" class="ltx_Math" alttext="X_{i}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>i</mi></msub><annotation encoding="application/x-tex">X_{i}</annotation></semantics></math>, thereby degrading performance.
Furthermore, we observe that the computational overhead for prototype sampling increases with larger <math id="A3.SS1.p1.m11" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, underscoring the trade-off between accuracy and efficiency.</p>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span><span id="A3.SS2.2" class="ltx_text ltx_font_bold">Effect of <math id="A3.SS2.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></span></h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">The parameter <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> denotes the momentum constant used to update the proxy vector <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="\theta_{m}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\theta_{m}</annotation></semantics></math> during prototype sampling.
Following <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib50" title="" class="ltx_ref">He et al. (2020)</a></cite>, higher values of <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> are expected to yield improved performance, as the proxy updates become smoother and more stable.
Consistent with this observation, Figure <a href="#A3.F5" title="Figure 5 ‣ C.8 Overall effect ‣ Appendix C Ablation Study ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>(b) shows that in both models, performance improves as <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> increases, highlighting the importance of stable momentum updates for effective representation learning.</p>
</div>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span><span id="A3.SS3.2" class="ltx_text ltx_font_bold">Effect of <math id="A3.SS3.m1" class="ltx_Math" alttext="N_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>α</mi></msub><annotation encoding="application/x-tex">N_{\alpha}</annotation></semantics></math> &amp; <math id="A3.SS3.m2" class="ltx_Math" alttext="N_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>β</mi></msub><annotation encoding="application/x-tex">N_{\beta}</annotation></semantics></math></span></h3>

<div id="A3.SS3.p1" class="ltx_para ltx_noindent">
<p id="A3.SS3.p1.1" class="ltx_p">The parameters <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="N_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>α</mi></msub><annotation encoding="application/x-tex">N_{\alpha}</annotation></semantics></math> and <math id="A3.SS3.p1.m2" class="ltx_Math" alttext="N_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>β</mi></msub><annotation encoding="application/x-tex">N_{\beta}</annotation></semantics></math> control the decay of similarity based on the orthogonal and projected distances, respectively, of a point from the linear submanifold in the neighborhood of another point.
We vary <math id="A3.SS3.p1.m3" class="ltx_Math" alttext="N_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>α</mi></msub><annotation encoding="application/x-tex">N_{\alpha}</annotation></semantics></math> in the range <math id="A3.SS3.p1.m4" class="ltx_Math" alttext="[1,6]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mn>6</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,6]</annotation></semantics></math> with a step size of <math id="A3.SS3.p1.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, and <math id="A3.SS3.p1.m6" class="ltx_Math" alttext="N_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>β</mi></msub><annotation encoding="application/x-tex">N_{\beta}</annotation></semantics></math> in the range <math id="A3.SS3.p1.m7" class="ltx_Math" alttext="[0.5,3]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0.5</mn><mo>,</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.5,3]</annotation></semantics></math> with a step size of <math id="A3.SS3.p1.m8" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math>.
As shown in Figure <a href="#A3.F5" title="Figure 5 ‣ C.8 Overall effect ‣ Appendix C Ablation Study ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>(c), increasing <math id="A3.SS3.p1.m9" class="ltx_Math" alttext="N_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>β</mi></msub><annotation encoding="application/x-tex">N_{\beta}</annotation></semantics></math> leads to a slight performance gain in the Qwen2.5-Coder model, while the Llama3.2 model exhibits larger fluctuations but follows an overall upward trend.
Similarly, Figure <a href="#A3.F5" title="Figure 5 ‣ C.8 Overall effect ‣ Appendix C Ablation Study ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>(d) shows that performance improves marginally with larger <math id="A3.SS3.p1.m10" class="ltx_Math" alttext="N_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>α</mi></msub><annotation encoding="application/x-tex">N_{\alpha}</annotation></semantics></math> in the Qwen2.5-Coder model, whereas the Llama3.2 model demonstrates a clearer and more consistent increase.
This effect can be explained by the relationship between <math id="A3.SS3.p1.m11" class="ltx_Math" alttext="N_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>α</mi></msub><annotation encoding="application/x-tex">N_{\alpha}</annotation></semantics></math> and <math id="A3.SS3.p1.m12" class="ltx_Math" alttext="N_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>β</mi></msub><annotation encoding="application/x-tex">N_{\beta}</annotation></semantics></math>: as <math id="A3.SS3.p1.m13" class="ltx_Math" alttext="N_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>α</mi></msub><annotation encoding="application/x-tex">N_{\alpha}</annotation></semantics></math> approaches <math id="A3.SS3.p1.m14" class="ltx_Math" alttext="N_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>β</mi></msub><annotation encoding="application/x-tex">N_{\beta}</annotation></semantics></math>, a point <math id="A3.SS3.p1.m15" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> at distance <math id="A3.SS3.p1.m16" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math> within the linear neighborhood of a point <math id="A3.SS3.p1.m17" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> (and thus sharing many features with <math id="A3.SS3.p1.m18" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> and its neighbors) may be treated as equally dissimilar to <math id="A3.SS3.p1.m19" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> as another point <math id="A3.SS3.p1.m20" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> located at an orthogonal distance <math id="A3.SS3.p1.m21" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math> from the neighborhood of <math id="A3.SS3.p1.m22" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.4 </span><span id="A3.SS4.2" class="ltx_text ltx_font_bold">effect of <math id="A3.SS4.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></span></h3>

<div id="A3.SS4.p1" class="ltx_para ltx_noindent">
<p id="A3.SS4.p1.1" class="ltx_p">The reconstruction threshold <math id="A3.SS4.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> determines the quality of points admitted into the linear submanifold <math id="A3.SS4.p1.m2" class="ltx_Math" alttext="X_{i}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>i</mi></msub><annotation encoding="application/x-tex">X_{i}</annotation></semantics></math>.
We vary <math id="A3.SS4.p1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> in the range <math id="A3.SS4.p1.m4" class="ltx_Math" alttext="[0.7,0.95]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0.7</mn><mo>,</mo><mn>0.95</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.7,0.95]</annotation></semantics></math> with a step size of <math id="A3.SS4.p1.m5" class="ltx_Math" alttext="0.05" display="inline" intent=":literal"><semantics><mn>0.05</mn><annotation encoding="application/x-tex">0.05</annotation></semantics></math>.
As shown in Figure <a href="#A3.F5" title="Figure 5 ‣ C.8 Overall effect ‣ Appendix C Ablation Study ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>(e), both models exhibit a clear upward trend in performance as <math id="A3.SS4.p1.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> increases, underscoring the importance of ensuring that only high-quality points are incorporated into <math id="A3.SS4.p1.m7" class="ltx_Math" alttext="X_{i}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>i</mi></msub><annotation encoding="application/x-tex">X_{i}</annotation></semantics></math>.
While the Llama3.2 model follows this overall increasing trend, it displays noticeable fluctuations compared to the more stable improvement observed in the Qwen2.5-Coder model.</p>
</div>
</section>
<section id="A3.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.5 </span><span id="A3.SS5.2" class="ltx_text ltx_font_bold">Effect of <math id="A3.SS5.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math></span></h3>

<div id="A3.SS5.p1" class="ltx_para ltx_noindent">
<p id="A3.SS5.p1.1" class="ltx_p">The scaling factor <math id="A3.SS5.p1.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> regulates the maximum separation between dissimilar points. We vary <math id="A3.SS5.p1.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> in the range <math id="A3.SS5.p1.m3" class="ltx_Math" alttext="[0.8,3.2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0.8</mn><mo>,</mo><mn>3.2</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.8,3.2]</annotation></semantics></math> with a step size of <math id="A3.SS5.p1.m4" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn>0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math>. As shown in Figure <a href="#A3.F5" title="Figure 5 ‣ C.8 Overall effect ‣ Appendix C Ablation Study ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>(f), the performance remains relatively stable across this range for both models, highlighting the robustness of our method.</p>
</div>
</section>
<section id="A3.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.6 </span><span id="A3.SS6.2" class="ltx_text ltx_font_bold">Effect of <math id="A3.SS6.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></span></h3>

<div id="A3.SS6.p1" class="ltx_para ltx_noindent">
<p id="A3.SS6.p1.1" class="ltx_p">The scaling factor <math id="A3.SS6.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> controls the sharpness of the exponential term in the Proxy Anchor loss. We vary its value over <math id="A3.SS6.p1.m2" class="ltx_Math" alttext="{5,10,15,20,25,30,32}" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo>,</mo><mn>10</mn><mo>,</mo><mn>15</mn><mo>,</mo><mn>20</mn><mo>,</mo><mn>25</mn><mo>,</mo><mn>30</mn><mo>,</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">{5,10,15,20,25,30,32}</annotation></semantics></math>. As shown in Figure <a href="#A3.F5" title="Figure 5 ‣ C.8 Overall effect ‣ Appendix C Ablation Study ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>(g), both models exhibit an overall increasing trend in performance with larger <math id="A3.SS6.p1.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>. However, the Qwen2.5-coder model displays higher fluctuations compared to the more stable Llama3.2 model.</p>
</div>
</section>
<section id="A3.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.7 </span><span id="A3.SS7.2" class="ltx_text ltx_font_bold">Effect of <math id="A3.SS7.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> </span></h3>

<div id="A3.SS7.p1" class="ltx_para ltx_noindent">
<p id="A3.SS7.p1.1" class="ltx_p">The margin parameter <math id="A3.SS7.p1.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> enforces that positive embeddings are pulled within this distance from their corresponding class proxies. We vary its value across <math id="A3.SS7.p1.m2" class="ltx_Math" alttext="{0.001,0.005,0.05,0.1,0.2}" display="inline" intent=":literal"><semantics><mrow><mn>0.001</mn><mo>,</mo><mn>0.005</mn><mo>,</mo><mn>0.05</mn><mo>,</mo><mn>0.1</mn><mo>,</mo><mn>0.2</mn></mrow><annotation encoding="application/x-tex">{0.001,0.005,0.05,0.1,0.2}</annotation></semantics></math>. As shown in Figure <a href="#A3.F5" title="Figure 5 ‣ C.8 Overall effect ‣ Appendix C Ablation Study ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>(h), the Qwen2.5-coder model demonstrates stable performance across the range of <math id="A3.SS7.p1.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>, whereas the Llama3.2 model exhibits a decreasing trend with noticeable fluctuations. This indicates that larger values of <math id="A3.SS7.p1.m4" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> impose overly strict constraints on the separation between positive and negative proxies, thereby hindering the embeddings from effectively satisfying the margin requirement.</p>
</div>
</section>
<section id="A3.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.8 </span><span id="A3.SS8.2" class="ltx_text ltx_font_bold">Overall effect</span></h3>

<div id="A3.SS8.p1" class="ltx_para ltx_noindent">
<p id="A3.SS8.p1.1" class="ltx_p">From Figure <a href="#A3.F5" title="Figure 5 ‣ C.8 Overall effect ‣ Appendix C Ablation Study ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, we observe that the Llama3.2 model exhibits high sensitivity to parameter variations, displaying substantial fluctuations in performance. This trend aligns with the results reported in Tables <a href="#S4.T1" title="Table 1 ‣ 4 Results ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and <a href="#S4.T2" title="Table 2 ‣ 4 Results ‣ Protocode: Prototype-Driven Interpretability for Code Generation in LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, where the similarity-based sampling method achieves the highest score for Llama3.2, further highlighting its instability under different configurations. In contrast, the Qwen2.5-coder model demonstrates relatively stable behavior, showing consistently increasing trends across most parameters, with the notable exception of the scaling factor <math id="A3.SS8.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.</p>
</div>
<figure id="A3.F5" class="ltx_figure"><span class="ltx_inline-block"><svg id="A3.F5.pic1" class="ltx_picture ltx_centering" height="581.19" overflow="visible" version="1.1" viewBox="0 0 488.75 581.19" width="488.75"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,581.19) matrix(1 0 0 -1 0 0) translate(35.53,0) translate(0,429.82)"><g transform="matrix(1.0 0.0 0.0 1.0 -35.53 -33.88)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(45.92,0) translate(0,43.81)"><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF" stroke-width="0.4pt"><path style="fill:none" d="M 0 -9.94 L 0 109.3 M 34.65 -9.94 L 34.65 109.3 M 69.29 -9.94 L 69.29 109.3 M 103.94 -9.94 L 103.94 109.3"></path></g><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF" stroke-width="0.4pt"><path style="fill:none" d="M -10.39 12.42 L 114.34 12.42 M -10.39 47.91 L 114.34 47.91 M -10.39 83.4 L 114.34 83.4"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M 0 -9.94 L 0 -4.03 M 34.65 -9.94 L 34.65 -4.03 M 69.29 -9.94 L 69.29 -4.03 M 103.94 -9.94 L 103.94 -4.03 M 0 109.3 L 0 103.4 M 34.65 109.3 L 34.65 103.4 M 69.29 109.3 L 69.29 103.4 M 103.94 109.3 L 103.94 103.4"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M -10.39 12.42 L -4.49 12.42 M -10.39 47.91 L -4.49 47.91 M -10.39 83.4 L -4.49 83.4 M 114.34 12.42 L 108.43 12.42 M 114.34 47.91 L 108.43 47.91 M 114.34 83.4 L 108.43 83.4"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt"><path style="fill:none" d="M -10.39 -9.94 L -10.39 109.3 L 114.34 109.3 L 114.34 -9.94 L -10.39 -9.94 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.46 -23.74)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic1.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 31.19 -23.74)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic1.m2" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 65.84 -23.74)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic1.m3" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 100.48 -23.74)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic1.m4" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -22.2 7.96)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic1.m5" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -22.2 43.45)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic1.m6" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fil