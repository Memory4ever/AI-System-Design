<td id="S4.T2.2.7.2" class="ltx_td ltx_align_center">1.86 <math id="S4.T2.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.20</td>
<td id="S4.T2.2.7.3" class="ltx_td ltx_align_center">91.72%</td></tr>
