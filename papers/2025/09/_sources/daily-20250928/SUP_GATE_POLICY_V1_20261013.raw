<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center">1.23 <math id="S4.T2.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.10</td>
<td id="S4.T2.2.4.3" class="ltx_td ltx_align_center">80.37%</td></tr>
