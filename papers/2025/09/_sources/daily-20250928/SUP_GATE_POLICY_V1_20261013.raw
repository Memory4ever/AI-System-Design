<td id="S4.T2.2.10.2" class="ltx_td ltx_align_center ltx_border_bb">7.22 <math id="S4.T2.m7" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 4.30</td>
<td id="S4.T2.2.10.3" class="ltx_td ltx_align_center ltx_border_bb">97.11%</td></tr>
