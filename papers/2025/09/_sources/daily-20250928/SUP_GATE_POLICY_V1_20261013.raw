<th id="A6.T9.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T9.2.1.2.1" class="ltx_text ltx_font_bold">Input Price ($/1M tokens)</span></th>
<th id="A6.T9.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T9.2.1.3.1" class="ltx_text ltx_font_bold">Output Price ($/1M tokens)</span></th></tr>
</thead>
