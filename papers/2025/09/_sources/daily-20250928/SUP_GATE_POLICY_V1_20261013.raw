<td id="S4.T2.2.3.2" class="ltx_td ltx_align_center">1.46 <math id="S4.T2.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.20</td>
