<td id="S4.T2.2.9.2" class="ltx_td ltx_align_center">6.60 <math id="S4.T2.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 4.10</td>
<td id="S4.T2.2.9.3" class="ltx_td ltx_align_center">96.22%</td></tr>
