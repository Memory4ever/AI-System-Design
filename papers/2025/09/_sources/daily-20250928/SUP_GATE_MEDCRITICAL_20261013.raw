<td id="S4.T1.2.7.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.2.7.2.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Qwen2.5-VL-7B-Instruct</span></td>
<td id="S4.T1.2.7.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.2.7.3.1" class="ltx_text" style="font-size:90%;">46.40</span></td>
