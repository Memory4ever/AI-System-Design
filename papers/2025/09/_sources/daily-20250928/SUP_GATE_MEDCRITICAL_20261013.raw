</div>
<div id="algorithm1.6.20" class="ltx_listingline"><span id="algorithm1.6.20.1" class="ltx_text" style="font-size:70%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.20.2" class="ltx_text" style="font-size:70%;">   Update </span><math id="algorithm1.m30" class="ltx_Math" alttext="\bm{\pi}_{\text{stu}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">𝝅</mi><mtext mathsize="0.700em">stu</mtext></msub><annotation encoding="application/x-tex">\bm{\pi}_{\text{stu}}</annotation></semantics></math><span id="algorithm1.6.20.3" class="ltx_text" style="font-size:70%;"> to minimize </span><math id="algorithm1.m31" class="ltx_Math" alttext="L_{\text{DPO-self}}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">L</mi><mtext mathsize="0.700em">DPO-self</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">θ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">L_{\text{DPO-self}}(\theta)</annotation></semantics></math><span id="algorithm1.6.20.4" class="ltx_text" style="font-size:70%;">
</span>
</div>
<div id="algorithm1.6.21" class="ltx_listingline"><span id="algorithm1.6.21.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Output:</span><span id="algorithm1.6.21.2" class="ltx_text" style="font-size:70%;"> Return the fine-tuned Student Model </span><math id="algorithm1.m32" class="ltx_Math" alttext="\bm{\pi}_{\text{stu}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">𝝅</mi><mtext mathsize="0.700em">stu</mtext></msub><annotation encoding="application/x-tex">\bm{\pi}_{\text{stu}}</annotation></semantics></math><span id="algorithm1.6.21.3" class="ltx_text" style="font-size:70%;">;</span>
</div>
<div id="algorithm1.6.22" class="ltx_listingline"><span id="algorithm1.6.22.1" class="ltx_text ltx_font_bold" style="font-size:70%;">return</span><span id="algorithm1.6.22.2" class="ltx_text" style="font-size:70%;"> </span><em id="algorithm1.6.22.3" class="ltx_emph ltx_font_italic" style="font-size:70%;"><math id="algorithm1.m33" class="ltx_Math" alttext="\bm{\pi}_{\text{stu}}" display="inline" intent=":literal"><semantics><msub><mi>𝛑</mi><mtext class="ltx_mathvariant_italic">stu</mtext></msub><annotation encoding="application/x-tex">\bm{\pi}_{\text{stu}}</annotation></semantics></math></em><span id="algorithm1.6.22.4" class="ltx_text" style="font-size:70%;">
</span>
</div>
