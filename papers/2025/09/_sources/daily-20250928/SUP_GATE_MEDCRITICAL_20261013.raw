</div>
<div id="algorithm1.6.17" class="ltx_listingline"><span id="algorithm1.6.17.1" class="ltx_text" style="font-size:70%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.17.2" class="ltx_text" style="font-size:70%;">     </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.17.3" class="ltx_text" style="font-size:70%;">     </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.17.4" class="ltx_text" style="font-size:70%;">   Add </span><math id="algorithm1.m25" class="ltx_Math" alttext="\bm{a}_{\text{test}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">𝒂</mi><mtext mathsize="0.700em">test</mtext></msub><annotation encoding="application/x-tex">\bm{a}_{\text{test}}</annotation></semantics></math><span id="algorithm1.6.17.5" class="ltx_text" style="font-size:70%;"> to </span><math id="algorithm1.m26" class="ltx_Math" alttext="\bm{A}_{\text{test}}^{-}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">𝑨</mi><mtext mathsize="0.700em">test</mtext><mo mathsize="0.700em">−</mo></msubsup><annotation encoding="application/x-tex">\bm{A}_{\text{test}}^{-}</annotation></semantics></math><span id="algorithm1.6.17.6" class="ltx_text" style="font-size:70%;">;</span>
</div>
