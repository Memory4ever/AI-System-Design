<th id="S4.T1.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Size</span></th></tr>
</thead>
<tbody class="ltx_tbody">
