<th id="A1.T8.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Top p</th>
<td id="A1.T8.2.3.2" class="ltx_td ltx_align_left">0.95</td></tr>
<tr id="A1.T8.2.4" class="ltx_tr">
