<tr id="S3.T3.8.2" class="ltx_tr">
<td id="S3.T3.8.2.1" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t" colspan="12"><span id="S3.T3.8.2.1.1" class="ltx_text ltx_underline ltx_font_italic">SFT Warm-Started Models</span></td></tr>
<tr id="S3.T3.8.3" class="ltx_tr">
