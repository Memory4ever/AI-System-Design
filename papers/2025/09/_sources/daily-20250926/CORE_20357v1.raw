<td id="S3.T1.6.4.12" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_right"><span id="S3.T1.6.4.12.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">31.2</span></td></tr>
<tr id="S3.T1.6.5" class="ltx_tr">
