0 0.0 0.0 1.0 151.52 124.43)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 71.36)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 7.17)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(-9.37,0)"><path style="fill:none" d="M 9.36 -2.45 L 14.26 2.45 M 9.36 2.45 L 14.26 -2.45"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 34.21 0) translate(13.19,0) matrix(1.0 0.0 0.0 1.0 -10.42 -2.33)"><foreignObject style="--ltx-fo-width:1.89em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="20.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.15" class="ltx_text" style="font-size:70%;">Unif</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.45)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(-9.37,0)"><path style="fill:none" d="M 9.36 -2.45 L 14.26 2.45 M 9.36 2.45 L 14.26 -2.45"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 32.21 0) translate(15.18,0) matrix(1.0 0.0 0.0 1.0 -12.41 -2.27)"><foreignObject style="--ltx-fo-width:2.25em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="24.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.16" class="ltx_text" style="font-size:70%;">NUQ</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 35.68)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(-9.37,0)"><path style="fill:none" d="M 9.36 -2.45 L 14.26 2.45 M 9.36 2.45 L 14.26 -2.45"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 36.45 0) translate(10.95,0) matrix(1.0 0.0 0.0 1.0 -8.18 -2.27)"><foreignObject style="--ltx-fo-width:1.51em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="16.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.17" class="ltx_text" style="font-size:70%;">VQ</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 49.91)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(-9.37,0)"><path style="fill:none" d="M 9.36 -2.45 L 14.26 2.45 M 9.36 2.45 L 14.26 -2.45"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 32.48 0) translate(14.91,0) matrix(1.0 0.0 0.0 1.0 -12.15 -2.27)"><foreignObject style="--ltx-fo-width:2.2em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="24.29"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.18" class="ltx_text" style="font-size:70%;">TCQ</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 64.19)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-dasharray="0.8pt,1.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.73 0) translate(22.67,0) matrix(1.0 0.0 0.0 1.0 -19.9 -2.33)"><foreignObject style="--ltx-fo-width:3.61em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="39.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.19" class="ltx_text" style="font-size:70%;">Optimal</span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.4" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S3.F2.5" class="ltx_text" style="font-size:90%;">
Gaussian quantization error of Q-Palette quantizers (NUQ, VQ, TCQ) compared to the uniform baseline.
</span></figcaption>
</figure>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p"><span id="S3.SS2.p2.1.1" class="ltx_text ltx_font_bold">Non-uniform scalar quantization.</span> NUQ quantizes each scalar weight by assigning it to an entry in a non-uniformly spaced lookup table (LUT), in contrast to uniform scalar quantizers, which use equally spaced intervals <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>]</cite>. We construct NUQ codebooks via <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-means clustering on random Gaussian samples <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>, thus optimizing the codebook entries for Gaussianized weights.
NUQ incurs low dequantization overhead and enables efficient inference <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib20" title="" class="ltx_ref">20</a>, <a href="#bib.bib40" title="" class="ltx_ref">40</a>]</cite>.</p>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p"><span id="S3.SS2.p3.1.1" class="ltx_text ltx_font_bold">Vector quantization.</span> VQ partitions weight vectors into groups of fixed dimension, assigning each group to the nearest vector entry in a precomputed codebook <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib51" title="" class="ltx_ref">51</a>]</cite>.
In Q-Palette, we specifically implement <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>D VQ, generating codebooks via <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-means clustering on random <math id="S3.SS2.p3.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>D Gaussian samples.
Efficient kernel implementations rely on LUTs whose sizes are powers of two, enabling compact bit-level representations.
Consequently, fractional bitwidths at <math id="S3.SS2.p3.m4" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math>-bit intervals become natural candidates for efficient implementations. For instance, a <math id="S3.SS2.p3.m5" class="ltx_Math" alttext="(2^{3},2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mn>2</mn><mn>3</mn></msup><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2^{3},2)</annotation></semantics></math>-shaped LUT (eight <math id="S3.SS2.p3.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>D vectors) encodes two elements with <math id="S3.SS2.p3.m7" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> bits, effectively achieving <math id="S3.SS2.p3.m8" class="ltx_Math" alttext="1.5" display="inline" intent=":literal"><semantics><mn>1.5</mn><annotation encoding="application/x-tex">1.5</annotation></semantics></math> bits per scalar weight.
Such constructions enable VQ to support fractional bitwidths at intervals of <math id="S3.SS2.p3.m9" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math> bits.</p>
</div>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p"><span id="S3.SS2.p4.1.1" class="ltx_text ltx_font_bold">Trellis-coded quantization.</span> TCQ is known as a sophisticated Gaussian source quantizer, achieving near-optimal distortion performance <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite>.
Recently, QTIP introduced optimized CUDA kernels for the bitshift variant of TCQ <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>, <a href="#bib.bib50" title="" class="ltx_ref">50</a>]</cite>, which encodes each high-dimensional real-valued vector <math id="S3.SS2.p4.m1" class="ltx_Math" alttext="\mathbf{v}" display="inline" intent=":literal"><semantics><mi>𝐯</mi><annotation encoding="application/x-tex">\mathbf{v}</annotation></semantics></math> into a binary bitshift representation <math id="S3.SS2.p4.m2" class="ltx_Math" alttext="\mathbf{r}" display="inline" intent=":literal"><semantics><mi>𝐫</mi><annotation encoding="application/x-tex">\mathbf{r}</annotation></semantics></math>:</p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_math_unparsed" alttext="\hat{\mathbf{v}}[i\cdot V:(i+1)\cdot V]=\mathrm{LUT}\left(\mathbf{r}[i\cdot s:i\cdot s+L]\right)," display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐯</mi><mo>^</mo></mover><mrow><mo stretchy="false">[</mo><mi>i</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>V</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>+</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>V</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>LUT</mi><mrow><mo>(</mo><mi>𝐫</mi><mrow><mo stretchy="false">[</mo><mi>i</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>s</mi><mo>+</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\hat{\mathbf{v}}[i\cdot V:(i+1)\cdot V]=\mathrm{LUT}\left(\mathbf{r}[i\cdot s:i\cdot s+L]\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p4.2" class="ltx_p">where each <math id="S3.SS2.p4.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>-dimensional subvector is represented by a sliding bit-window of length <math id="S3.SS2.p4.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, shifted by <math id="S3.SS2.p4.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> bits at each step. This encoding achieves an effective fractional bitwidth of <math id="S3.SS2.p4.m6" class="ltx_Math" alttext="s/V" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>/</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">s/V</annotation></semantics></math>.
While previous TCQ kernel (QTIP) supported integer bitwidths (<span id="S3.SS2.p4.2.1" class="ltx_text ltx_font_italic">e.g.</span>, <math id="S3.SS2.p4.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, <math id="S3.SS2.p4.m8" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, <math id="S3.SS2.p4.m9" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> bits with shifts <math id="S3.SS2.p4.m10" class="ltx_Math" alttext="s=4" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">s=4</annotation></semantics></math>, <math id="S3.SS2.p4.m11" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>, <math id="S3.SS2.p4.m12" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math> for <math id="S3.SS2.p4.m13" class="ltx_Math" alttext="V=2" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">V=2</annotation></semantics></math>) and were limited to single batch, we significantly expand practical applicability by introducing fractional bitwidth support (<span id="S3.SS2.p4.2.2" class="ltx_text ltx_font_italic">e.g.</span>, <math id="S3.SS2.p4.m14" class="ltx_Math" alttext="1.5" display="inline" intent=":literal"><semantics><mn>1.5</mn><annotation encoding="application/x-tex">1.5</annotation></semantics></math>, <math id="S3.SS2.p4.m15" class="ltx_Math" alttext="2.5" display="inline" intent=":literal"><semantics><mn>2.5</mn><annotation encoding="application/x-tex">2.5</annotation></semantics></math>, <math id="S3.SS2.p4.m16" class="ltx_Math" alttext="3.5" display="inline" intent=":literal"><semantics><mn>3.5</mn><annotation encoding="application/x-tex">3.5</annotation></semantics></math>, <math id="S3.SS2.p4.m17" class="ltx_Math" alttext="4.5" display="inline" intent=":literal"><semantics><mn>4.5</mn><annotation encoding="application/x-tex">4.5</annotation></semantics></math>, <math id="S3.SS2.p4.m18" class="ltx_Math" alttext="5.0" display="inline" intent=":literal"><semantics><mn>5.0</mn><annotation encoding="application/x-tex">5.0</annotation></semantics></math> bits corresponding to shifts <math id="S3.SS2.p4.m19" class="ltx_Math" alttext="s=3,5,7,9,10" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>=</mo><mn>3</mn></mrow><mo>,</mo><mn>5</mn><mo>,</mo><mn>7</mn><mo>,</mo><mn>9</mn><mo>,</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">s=3,5,7,9,10</annotation></semantics></math> for <math id="S3.SS2.p4.m20" class="ltx_Math" alttext="V=2" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">V=2</annotation></semantics></math>) and optimized kernels supporting inference at batch sizes up to <math id="S3.SS2.p4.m21" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn>8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math>.
For constructing the LUT, we follow the protocol of QTIP, which is also based on <math id="S3.SS2.p4.m22" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-means clustering of Gaussian samples.</p>
</div>
<div id="S3.SS2.p5" class="ltx_para">
<p id="S3.SS2.p5.1" class="ltx_p">Furthermore, we introduce <span id="S3.SS2.p5.1.1" class="ltx_text ltx_font_italic">half-TCQ</span>, a simple extension enabling quantization at intermediate fractional bitwidth intervals.
Specifically, given a weight <math id="S3.SS2.p5.m1" class="ltx_Math" alttext="W\in\mathbb{R}^{d_{\text{in}}\times d_{\text{out}}}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mtext>in</mtext></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mtext>out</mtext></msub></mrow></msup></mrow><annotation encoding="application/x-tex">W\in\mathbb{R}^{d_{\text{in}}\times d_{\text{out}}}</annotation></semantics></math>, half-TCQ partitions the matrix row-wise and applies different bitwidth quantization to each partition. For example, to achieve <math id="S3.SS2.p5.m2" class="ltx_Math" alttext="2.75" display="inline" intent=":literal"><semantics><mn>2.75</mn><annotation encoding="application/x-tex">2.75</annotation></semantics></math> bit quantization, half-TCQ quantizes <math id="S3.SS2.p5.m3" class="ltx_math_unparsed" alttext="W[:d_{\text{in}}/2]" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mrow><mo stretchy="false">[</mo><mo rspace="0.278em">:</mo><msub><mi>d</mi><mtext>in</mtext></msub><mo>/</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">W[:d_{\text{in}}/2]</annotation></semantics></math> at <math id="S3.SS2.p5.m4" class="ltx_Math" alttext="2.5" display="inline" intent=":literal"><semantics><mn>2.5</mn><annotation encoding="application/x-tex">2.5</annotation></semantics></math> bits and the remaining half <math id="S3.SS2.p5.m5" class="ltx_math_unparsed" alttext="W[d_{\text{in}}/2:]" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mrow><mo stretchy="false">[</mo><msub><mi>d</mi><mtext>in</mtext></msub><mo>/</mo><mn>2</mn><mo lspace="0.278em" rspace="0em">:</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">W[d_{\text{in}}/2:]</annotation></semantics></math> at <math id="S3.SS2.p5.m6" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> bits. To preserve computational efficiency, we implement a dedicated CUDA kernel that performs fused dequantization and matrix multiplication for half-TCQ in a single kernel call.
As illustrated in <a href="#S3.F2" title="In 3.2 Quantization schemes in Q-Palette ‣ 3 Q-Palette: fractional-bit quantizers ‣ Q-Palette: Fractional-Bit Quantizers Toward Optimal Bit Allocation for Efficient LLM Deployment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2</span></a>, TCQ-based schemes, including half-TCQ, consistently achieve quantization error close to theoretical lower bounds, outperforming simpler quantizers.
For a more detailed explanation of these quantizers, including quantization algorithms, please refer to <a href="#A3" title="Appendix C Additional details on quantizers in Q-Palette ‣ Q-Palette: Fractional-Bit Quantizers Toward Optimal Bit Allocation for Efficient LLM Deployment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">C</span></a>.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Implementation details for efficiency</h3>

<figure id="S3.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S3.T2.3" class="ltx_text" style="font-size:90%;">Table 2</span>: </span><span id="S3.T2.4" class="ltx_text" style="font-size:90%;">Decoding-latency speedup of quantized LLaMA 3.1-8B models
relative to the FP16 baseline on an RTX 4090 GPU. ‘TC’ and ‘CC’ denote Tensor Core and CUDA Core kernels, respectively.</span></figcaption>
<div id="S3.T2.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:331.2pt;height:116.9pt;vertical-align:-57.1pt;"><span class="ltx_transformed_inner" style="transform:translate(-144.2pt,50.9pt) scale(0.534580823841135,0.534580823841135) ;">
