</g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 212.88 -12.91)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="16.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.8" class="ltx_text" style="font-size:90%;">5.0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -11.29 -4.01)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.9" class="ltx_text" style="font-size:90%;">0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -27.64 57.73)"><foreignObject style="--ltx-fo-width:1.78em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="22.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.10" class="ltx_text" style="font-size:90%;">0.25</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -25.51 119.48)"><foreignObject style="--ltx-fo-width:1.61em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="20.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.