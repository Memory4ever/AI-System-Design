<td id="A7.T10.5.2.2" class="ltx_td ltx_align_center ltx_border_t">3.25</td>
<td id="A7.T10.5.2.3" class="ltx_td ltx_align_center ltx_border_t">Uniform bitwidth</td>
<td id="A7.T10.5.2.4" class="ltx_td ltx_align_center ltx_border_t">8063.91</td></tr>
<tr id="A7.T10.5.3" class="ltx_tr">
<td id="A7.T10.5.3.1" class="ltx_td ltx_align_left">G64-MSQ-Mem</td>
<td id="A7.T10.5.3.2" class="ltx_td ltx_align_center">3.25</td>
<td id="A7.T10.5.3.3" class="ltx_td ltx_align_center">MSQ with Gaussian-assumed error</td>
