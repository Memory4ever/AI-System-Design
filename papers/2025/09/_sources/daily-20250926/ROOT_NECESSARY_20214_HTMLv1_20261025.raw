<td id="A7.T10.5.1.4" class="ltx_td ltx_align_center ltx_border_tt">Wiki2 (<math id="A7.T10.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</td></tr>
<tr id="A7.T10.5.2" class="ltx_tr">
