</table>
</div>
<div id="A0.SS1.p2" class="ltx_para">
<p id="A0.SS1.p2.1" class="ltx_p">For 3D quadrotor examples, we used the parameters <math id="A0.SS1.p2.m1" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math>kg, <math id="A0.SS1.p2.m2" class="ltx_Math" alttext="g=-9.81" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mrow><mo>−</mo><mn>9.81</mn></mrow></mrow><annotation encoding="application/x-tex">g=-9.81</annotation></semantics></math> m/s<sup id="A0.SS1.p2.1.1" class="ltx_sup">2</sup>, <math id="A0.SS1.p2.m4" class="ltx_Math" alttext="I_{x,y,z}=[0.5,0.1,0.3]" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0.5</mn><mo>,</mo><mn>0.1</mn><mo>,</mo><mn>0.3</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">I_{x,y,z}=[0.5,0.1,0.3]</annotation></semantics></math> kg·m<sup id="A0.SS1.p2.1.2" class="ltx_sup">2</sup> for the dynamics in</p>
</div>
<div id="A0.SS1.p3" class="ltx_para">
<table id="A0.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A0.Ex2.m1" class="ltx_Math" alttext="\dot{\mathbf{x}}\;=\;f(\mathbf{x},\mathbf{u})=\begin{bmatrix}\dot{x}\\
\dot{y}\\
\dot{x}\\
q\cdot\sin(\phi)/\cos{\theta}+r\cdot\cos{\phi}/\cos{\theta}\\
q\cdot\cos{\phi}-r\cdot\sin{\phi}\\
p+q\cdot\sin{\phi}\cdot\tan{\theta}+r\cdot\cos{\phi}\cdot\tan{\theta}\\
\frac{u_{1}}{m}\cdot(\sin{\phi}\cdot\sin{\psi}+\cos{\phi}\cdot\cos{\psi}\cdot\sin{\theta})\\
\frac{u_{1}}{m}\cdot(\cos{\phi}\cdot\sin{\phi}-\cos{\phi}\cdot\sin{\psi}\cdot\sin{\theta})\\
g+u_{1}\cdot(\cos{\phi}\cdot\cos{\theta})/m\\
((I_{y}-I_{z})/I_{x})\cdot q\cdot r+\frac{u_{2}}{I_{x}}\\
((I_{z}-I_{x})/I_{y})\cdot p\cdot r+\frac{u_{3}}{I_{y}}\\
((I_{x}-I_{y})/I_{z})\cdot p\cdot q+\frac{u_{4}}{I_{z}}\\
\end{bmatrix}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐱</mi><mo>˙</mo></mover><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐮</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mover accent="true"><mi>x</mi><mo>˙</mo></mover></mtd></mtr><mtr><mtd><mover accent="true"><mi>y</mi><mo>˙</mo></mover></mtd></mtr><mtr><mtd><mover accent="true"><mi>x</mi><mo>˙</mo></mover></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>/</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow></mrow><mo>/</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow></mrow><mo>−</mo><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>p</mi><mo>+</mo><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>tan</mi><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>tan</mi><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mstyle displaystyle="false"><mfrac><msub><mi>u</mi><mn>1</mn></msub><mi>m</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mi>ψ</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ψ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mstyle displaystyle="false"><mfrac><msub><mi>u</mi><mn>1</mn></msub><mi>m</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow></mrow><mo>−</mo><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mi>ψ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>sin</mi><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>g</mi><mo>+</mo><mrow><mrow><msub><mi>u</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>m</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mi>y</mi></msub><mo>−</mo><msub><mi>I</mi><mi>z</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>I</mi><mi>x</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>r</mi></mrow><mo>+</mo><mstyle displaystyle="false"><mfrac><msub><mi>u</mi><mn>2</mn></msub><msub><mi>I</mi><mi>x</mi></msub></mfrac></mstyle></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mi>z</mi></msub><mo>−</mo><msub><mi>I</mi><mi>x</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>I</mi><mi>y</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>p</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>r</mi></mrow><mo>+</mo><mstyle displaystyle="false"><mfrac><msub><mi>u</mi><mn>3</mn></msub><msub><mi>I</mi><mi>y</mi></msub></mfrac></mstyle></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mi>x</mi></msub><mo>−</mo><msub><mi>I</mi><mi>y</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>I</mi><mi>z</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>p</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>q</mi></mrow><mo>+</mo><mstyle displaystyle="false"><mfrac><msub><mi>u</mi><mn>4</mn></msub><msub><mi>I</mi><mi>z</mi></msub></mfrac></mstyle></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\dot{\mathbf{x}}\;=\;f(\mathbf{x},\mathbf{u})=\begin{bmatrix}\dot{x}\\
\dot{y}\\
\dot{x}\\
q\cdot\sin(\phi)/\cos{\theta}+r\cdot\cos{\phi}/\cos{\theta}\\
q\cdot\cos{\phi}-r\cdot\sin{\phi}\\
p+q\cdot\sin{\phi}\cdot\tan{\theta}+r\cdot\cos{\phi}\cdot\tan{\theta}\\
\frac{u_{1}}{m}\cdot(\sin{\phi}\cdot\sin{\psi}+\cos{\phi}\cdot\cos{\psi}\cdot\sin{\theta})\\
\frac{u_{1}}{m}\cdot(\cos{\phi}\cdot\sin{\phi}-\cos{\phi}\cdot\sin{\psi}\cdot\sin{\theta})\\
g+u_{1}\cdot(\cos{\phi}\cdot\cos{\theta})/m\\
((I_{y}-I_{z})/I_{x})\cdot q\cdot r+\frac{u_{2}}{I_{x}}\\
((I_{z}-I_{x})/I_{y})\cdot p\cdot r+\frac{u_{3}}{I_{y}}\\
((I_{x}-I_{y})/I_{z})\cdot p\cdot q+\frac{u_{4}}{I_{z}}\\
\end{bmatrix}</annotation></semantics></math></td>
