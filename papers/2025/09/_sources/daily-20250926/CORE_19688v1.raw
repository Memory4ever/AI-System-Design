<span id="A0.I1.i1.I1.i3.p1.1" class="ltx_p"><span id="A0.I1.i1.I1.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The origin </span><math id="A0.I1.i1.I1.i3.p1.m1" class="ltx_Math" alttext="(0.0,0.0)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0.0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0.0,0.0)</annotation></semantics></math><span id="A0.I1.i1.I1.i3.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> is at the exact center of the image.</span></span>
</span></span>
</span>
</span></span>
