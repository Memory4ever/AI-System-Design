<span id="A0.I1.i1.I1.i2.p1.1" class="ltx_p"><span id="A0.I1.i1.I1.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The </span><math id="A0.I1.i1.I1.i2.p1.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math><span id="A0.I1.i1.I1.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">-axis ranges from </span><math id="A0.I1.i1.I1.i2.p1.m2" class="ltx_Math" alttext="-1.0" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1.0</mn></mrow><annotation encoding="application/x-tex">-1.0</annotation></semantics></math><span id="A0.I1.i1.I1.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> (bottom edge) to </span><math id="A0.I1.i1.I1.i2.p1.m3" class="ltx_Math" alttext="1.0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1.0</mn><annotation encoding="application/x-tex">1.0</annotation></semantics></math><span id="A0.I1.i1.I1.i2.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> (top edge).</span></span>
</span></span>
<span id="A0.I1.i1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A0.I1.i1.I1.i3.1" class="ltx_text ltx_font_bold">–</span></span> 
