{"data":{"id":"10.48550/arxiv.2509.20336","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.20336","prefix":"10.48550","suffix":"arxiv.2509.20336","identifiers":[{"identifier":"2509.20336","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.20336"}],"creators":[{"name":"Dai, Xinnan","nameType":"Personal","givenName":"Xinnan","familyName":"Dai","affiliation":[],"nameIdentifiers":[]},{"name":"Lo, Chung-Hsiang","nameType":"Personal","givenName":"Chung-Hsiang","familyName":"Lo","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Kai","nameType":"Personal","givenName":"Kai","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Zeng, Shenglai","nameType":"Personal","givenName":"Shenglai","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Luo, Dongsheng","nameType":"Personal","givenName":"Dongsheng","familyName":"Luo","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Jiliang","nameType":"Personal","givenName":"Jiliang","familyName":"Tang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncovering Graph Reasoning in Decoder-only Transformers with Circuit Tracing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T17:25:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-25T01:02:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Transformer-based LLMs demonstrate strong performance on graph reasoning tasks, yet their internal mechanisms remain underexplored. To uncover these reasoning process mechanisms in a fundamental and unified view, we set the basic decoder-only transformers and explain them using the circuit-tracer framework. Through this lens, we visualize reasoning traces and identify two core mechanisms in graph reasoning: token merging and structural memorization, which underlie both path reasoning and substructure extraction tasks. We further quantify these behaviors and analyze how they are influenced by graph density and model size. Our study provides a unified interpretability framework for understanding structural reasoning in decoder-only Transformers.","descriptionType":"Abstract"},{"description":"Accepted by the Workshop on Efficient Reasoning, Neurips 2025","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.20336","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-25T02:06:05.000Z","registered":"2025-09-25T02:06:06.000Z","published":"2025","updated":"2025-09-25T02:06:06.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.20336","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}