<td id="S3.T1.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.5.2.2.1" class="ltx_text" style="font-size:90%;">49.7%</span></td>
<td id="S3.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.5.2.3.1" class="ltx_text" style="font-size:90%;">8.1%</span></td>
<td id="S3.T1.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.5.2.4.1" class="ltx_text" style="font-size:90%;">10.3%</span></td></tr>
<tr id="S3.T1.5.3" class="ltx_tr">
<td id="S3.T1.5.3.1" class="ltx_td ltx_align_left"><span id="S3.T1.5.3.1.1" class="ltx_text" style="font-size:90%;">AstroPTv2 Base vs Large</span></td>
<td id="S3.T1.5.3.2" class="ltx_td ltx_align_center"><span id="S3.T1.5.3.2.1" class="ltx_text" style="font-size:90%;">56.2%</span></td>
<td id="S3.T1.5.3.3" class="ltx_td ltx_align_center"><span id="S3.T1.5.3.3.1" class="ltx_text" style="font-size:90%;">10.0%</span></td>
<td id="S3.T1.5.3.4" class="ltx_td ltx_align_center"><span id="S3.T1.5.3.4.1" class="ltx_text" style="font-size:90%;">13.5%</span></td></tr>
<tr id="S3.T1.5.4" class="ltx_tr">
