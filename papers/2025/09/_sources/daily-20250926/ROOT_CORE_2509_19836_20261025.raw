            <span id="alg1.l14.3" class="ltx_text" style="font-size:80%;">   Put </span><math id="alg1.l14.m1" class="ltx_Math" alttext="\mathbf{K}_{j},\mathbf{V}_{j},\mathbf{\nabla K}_{j},\mathbf{\nabla V}_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">𝐊</mi><mi mathsize="0.800em">j</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">𝐕</mi><mi mathsize="0.800em">j</mi></msub><mo mathsize="0.800em">,</mo><mrow><mo mathsize="0.800em" rspace="0.167em">∇</mo><msub><mi mathsize="0.800em">𝐊</mi><mi mathsize="0.800em">j</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><mo mathsize="0.800em" rspace="0.167em">∇</mo><msub><mi mathsize="0.800em">𝐕</mi><mi mathsize="0.800em">j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{K}_{j},\mathbf{V}_{j},\mathbf{\nabla K}_{j},\mathbf{\nabla V}_{j}</annotation></semantics></math><span id="alg1.l14.4" class="ltx_text" style="font-size:80%;"> into communication ring; {4Nd}
