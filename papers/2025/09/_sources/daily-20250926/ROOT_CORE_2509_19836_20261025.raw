            <span id="alg2.l0.3" class="ltx_text" style="font-size:80%;"> Matrices </span><math id="alg2.l0.m1" class="ltx_Math" alttext="\mathbf{Q}_{i},\mathbf{K}_{i},\mathbf{V}_{i},\mathbf{O}_{i},\mathbf{\nabla O}_{i}\in\mathbb{R}^{{\frac{N}{G}}\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">𝐐</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">𝐊</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">𝐕</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">𝐎</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><mrow><mrow><mo mathsize="0.800em" rspace="0.167em">∇</mo><msub><mi mathsize="0.800em">𝐎</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo mathsize="0.800em">∈</mo><msup><mi mathsize="0.800em">ℝ</mi><mrow><mfrac><mi mathsize="0.800em">N</mi><mi mathsize="0.800em">G</mi></mfrac><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><mi mathsize="0.800em">d</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q}_{i},\mathbf{K}_{i},\mathbf{V}_{i},\mathbf{O}_{i},\mathbf{\nabla O}_{i}\in\mathbb{R}^{{\frac{N}{G}}\times d}</annotation></semantics></math><span id="alg2.l0.4" class="ltx_text" style="font-size:80%;">, </span><math id="alg2.l0.m2" class="ltx_Math" alttext="\mathbf{Lse}_{i}\in\mathbb{R}^{\frac{N}{G}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">𝐋𝐬𝐞</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">∈</mo><msup><mi mathsize="0.800em">ℝ</mi><mfrac><mi mathsize="0.800em">N</mi><mi mathsize="0.800em">G</mi></mfrac></msup></mrow><annotation encoding="application/x-tex">\mathbf{Lse}_{i}\in\mathbb{R}^{\frac{N}{G}}</annotation></semantics></math><span id="alg2.l0.5" class="ltx_text" style="font-size:80%;"> on the </span><math id="alg2.l0.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="alg2.l0.6" class="ltx_text" style="font-size:80%;">-th GPU
