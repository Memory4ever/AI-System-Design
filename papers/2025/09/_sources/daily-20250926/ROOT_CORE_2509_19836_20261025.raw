            <span id="alg2.l7.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg2.l7.m1" class="ltx_Math" alttext="\mathbf{S}_{j,i}=\mathbf{Q}_{j}\mathbf{K}_{i}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">𝐒</mi><mrow><mi mathsize="0.800em">j</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">i</mi></mrow></msub><mo mathsize="0.800em">=</mo><mrow><msub><mi mathsize="0.800em">𝐐</mi><mi mathsize="0.800em">j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">𝐊</mi><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{S}_{j,i}=\mathbf{Q}_{j}\mathbf{K}_{i}^{\top}</annotation></semantics></math><span id="alg2.l7.4" class="ltx_text" style="font-size:80%;">;
