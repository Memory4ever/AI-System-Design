<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center">393.44</td>
<td id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center"><math id="S4.T3.m2" class="ltx_math_unparsed" alttext="1.72\times" display="inline" intent=":literal"><semantics><mrow><mn>1.72</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">1.72\times</annotation></semantics></math></td></tr>
<tr id="S4.T3.2.1.4" class="ltx_tr">
<td id="S4.T3.2.1.4.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">SWA</td>
<td id="S4.T3.2.1.4.2" class="ltx_td ltx_align_center ltx_border_b">837.79</td>
<td id="S4.T3.2.1.4.3" class="ltx_td ltx_align_center ltx_border_b"><math id="S4.T3.m3" class="ltx_math_unparsed" alttext="3.68\times" display="inline" intent=":literal"><semantics><mrow><mn>3.68</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">3.68\times</annotation></semantics></math></td></tr>
</table>
</span></div>
</figure>
<figure id="S4.T4" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">Table 4. </span>The performance of BurstEngine across different nodes, with each node having 8<math id="S4.T4.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>A800.</figcaption>
