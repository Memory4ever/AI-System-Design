<td id="S4.T5.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r">64K</td>
<td id="S4.T5.2.1.3.3" class="ltx_td ltx_align_center">48.85</td>
<td id="S4.T5.2.1.3.4" class="ltx_td ltx_align_center">928.24</td>
<td id="S4.T5.2.1.3.5" class="ltx_td ltx_align_center">55.18</td></tr>
