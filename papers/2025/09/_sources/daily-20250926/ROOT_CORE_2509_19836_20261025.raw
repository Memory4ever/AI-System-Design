<td id="S4.T3.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T3.m1" class="ltx_math_unparsed" alttext="1.00\times" display="inline" intent=":literal"><semantics><mrow><mn>1.00</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">1.00\times</annotation></semantics></math></td></tr>
