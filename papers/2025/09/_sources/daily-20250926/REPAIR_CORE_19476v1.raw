<th id="S2.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S2.T1.2.5.1.1" class="ltx_text ltx_font_typewriter">Multi-Model</span></th>
<td id="S2.T1.2.5.2" class="ltx_td ltx_align_left">yes</td>
