<span id="A1.F5.pic1.2.6" class="ltx_p" style="width:366.2pt;"><span id="A1.F5.pic1.2.6.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:366.2pt;"></span></span>
<span id="A1.F5.pic1.2.7" class="ltx_p" style="width:366.2pt;"><span id="A1.F5.pic1.2.7.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;">Output datatype: <span id="A1.F5.pic1.2.7.1.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">{{return_type}}</span></span></span>
<span id="A1.F5.pic1.2.8" class="ltx_p" style="width:366.2pt;"><span id="A1.F5.pic1.2.8.1" class="ltx_text ltx_verbatim ltx_inline-block" style="width:366.2pt;"></span></span>
<span id="A1.F5.pic1.2.9" class="ltx_p" style="width:366.2pt;"><span id="A1.F5.pic1.2.9.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#0000FF;">{% if context is not none %}</span></span>
<span id="A1.F5.pic1.2.10" class="ltx_p" style="width:366.2pt;"><span id="A1.F5.pic1.2.10.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;">Context:  <span id="A1.F5.pic1.2.10.1.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">{{context}}</span></span></span>
<span id="A1.F5.pic1.2.11" class="ltx_p" style="width:366.2pt;"><span id="A1.F5.pic1.2.11.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#0000FF;">{% endif % }</span></span>
