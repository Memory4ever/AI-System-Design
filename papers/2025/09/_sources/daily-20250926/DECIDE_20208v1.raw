<span id="A1.F5.pic2.2.24" class="ltx_p" style="width:366.2pt;"><span id="A1.F5.pic2.2.24.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;">def f(s: str) -&gt; <span id="A1.F5.pic2.2.24.1.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">{{return_type}}</span>:</span></span>
