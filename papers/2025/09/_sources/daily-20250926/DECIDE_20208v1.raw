</div>
<div id="lstnumberx15" class="ltx_listingline"><span id="lstnumberx15.1" class="ltx_text ltx_lst_space ltx_font_typewriter">        </span><span id="lstnumberx15.2" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx15.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#CF212E;">SELECT</span><span id="lstnumberx15.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">player</span><span id="lstnumberx15.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.7" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#CF212E;">FROM</span><span id="lstnumberx15.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">w</span><span id="lstnumberx15.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.11" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#CF212E;">ORDER</span><span id="lstnumberx15.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.13" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#CF212E;">BY</span><span id="lstnumberx15.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">yards</span><span id="lstnumberx15.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.17" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#CF212E;">DESC</span><span id="lstnumberx15.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.19" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#CF212E;">LIMIT</span><span id="lstnumberx15.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.21" class="ltx_text ltx_font_typewriter">1</span><span id="lstnumberx15.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">OFFSET</span><span id="lstnumberx15.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.25" class="ltx_text ltx_font_typewriter">1)</span>
</div>
<div id="lstnumberx16" class="ltx_listingline"><span id="lstnumberx16.1" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx16.2" class="ltx_text ltx_font_typewriter">)</span>
</div>
