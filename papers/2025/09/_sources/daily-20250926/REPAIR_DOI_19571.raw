{"data":{"id":"10.48550/arxiv.2509.19571","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.19571","prefix":"10.48550","suffix":"arxiv.2509.19571","identifiers":[{"identifier":"2509.19571","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.19571"}],"creators":[{"name":"Morin, Sacha","nameType":"Personal","givenName":"Sacha","familyName":"Morin","affiliation":[],"nameIdentifiers":[]},{"name":"Gupta, Kumaraditya","nameType":"Personal","givenName":"Kumaraditya","familyName":"Gupta","affiliation":[],"nameIdentifiers":[]},{"name":"Sandhu, Mahtab","nameType":"Personal","givenName":"Mahtab","familyName":"Sandhu","affiliation":[],"nameIdentifiers":[]},{"name":"Gauthier, Charlie","nameType":"Personal","givenName":"Charlie","familyName":"Gauthier","affiliation":[],"nameIdentifiers":[]},{"name":"Argenziano, Francesco","nameType":"Personal","givenName":"Francesco","familyName":"Argenziano","affiliation":[],"nameIdentifiers":[]},{"name":"Ellis, Kirsty","nameType":"Personal","givenName":"Kirsty","familyName":"Ellis","affiliation":[],"nameIdentifiers":[]},{"name":"Paull, Liam","nameType":"Personal","givenName":"Liam","familyName":"Paull","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agentic Scene Policies"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T20:56:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-25T00:10:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-07T01:53:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-08T00:26:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Designing or learning robot policies that generalize zero-shot across a range of language instructions and objects is a core problem in robotics. Vision-Language-Action models (VLAs) learn such policies end-to-end by repurposing existing Vision-Language Models (VLMs), but generalization to new instructions and objects remains challenging. An alternative is to implement a modular policy by leveraging an explicit VLM-based 3D scene representation and motion planning. While modular policies show strong zero-shot potential, they typically retrieve objects based on semantics without explicit spatial reasoning, severely restricting their overall grounding capabilities. They also interact with objects using basic grasping and navigation skills. In this work, we address these limitations by unifying grounding capabilities and robot skills in a single agentic action space through a scene-agent tool interface. By leveraging part-level affordances, our skills generalize across diverse objects and enable zero-shot interactions such as unplugging chargers and opening drawers. We name the resulting framework Agentic Scene Policies (ASP). Through extensive real-world experiments, we show how ASP consistently outperforms leading VLAs in the zero-shot setting. We also demonstrate the extensibility of our framework by introducing a mobile version of ASP to tackle room-level queries. See our project page (https://montrealrobotics.ca/agentic-scene-policies.github.io/) for more results.","descriptionType":"Abstract"},{"description":"Accepted to IROS 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.19571","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-25T01:48:05.000Z","registered":"2025-09-25T01:48:06.000Z","published":"2025","updated":"2026-10-08T03:03:48.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.19571","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}