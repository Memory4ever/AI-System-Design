<tr id="S8.T6.2.1.5" class="ltx_tr">
<th id="S8.T6.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S8.T6.2.1.5.1.1" class="ltx_text ltx_font_smallcaps">Activation</span></th>
<td id="S8.T6.2.1.5.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">ReLU</td></tr>
<tr id="S8.T6.2.1.6" class="ltx_tr">
<th id="S8.T6.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S8.T6.2.1.6.1.1" class="ltx_text ltx_font_smallcaps">Discount Factor</span> <math id="S8.T6.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></th>
<td id="S8.T6.2.1.6.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.9999</td></tr>
<tr id="S8.T6.2.1.7" class="ltx_tr">
<th id="S8.T6.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S8.T6.2.1.7.1.1" class="ltx_text ltx_font_smallcaps">Learning Rate (Critic)</span></th>
<td id="S8.T6.2.1.7.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">1e-3</td></tr>
<tr id="S8.T6.2.1.8" class="ltx_tr">
<th id="S8.T6.2.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S8.T6.2.1.8.1.1" class="ltx_text ltx_font_smallcaps">Learning Rate (Actor)</span></th>
<td id="S8.T6.2.1.8.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">1e-4</td></tr>
