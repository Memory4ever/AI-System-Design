<td id="S8.T7.2.1.3.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.7pt;padding-bottom:0.7pt;"><math id="S8.T7.m3" class="ltx_Math" alttext="d_{\text{in}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">d</mi><mtext mathsize="0.900em">in</mtext></msub><annotation encoding="application/x-tex">d_{\text{in}}</annotation></semantics></math></td>
