<td id="S8.T6.2.1.3.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">[512, 512, 512, 512]</td></tr>
<tr id="S8.T6.2.1.4" class="ltx_tr">
<th id="S8.T6.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S8.T6.2.1.4.1.1" class="ltx_text ltx_font_smallcaps">Normalization</span></th>
