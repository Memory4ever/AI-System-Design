<th id="S8.T6.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S8.T6.2.1.9.1.1" class="ltx_text ltx_font_smallcaps">Optimizer</span></th>
<td id="S8.T6.2.1.9.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">AdamW</td></tr>
<tr id="S8.T6.2.1.10" class="ltx_tr">
<th id="S8.T6.2.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S8.T6.2.1.10.1.1" class="ltx_text ltx_font_smallcaps">Number of Iterations</span></th>
<td id="S8.T6.2.1.10.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">640000</td></tr>
