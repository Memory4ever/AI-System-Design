<td id="S4.SS3.SSS0.Px1.fig2.2.1.6.3" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.5pt 5.0pt;"><math id="S4.SS3.SSS0.Px1.m10" class="ltx_Math" alttext="80.81{\scriptstyle\pm 0.53}" display="inline" intent=":literal"><semantics><mrow><mn>80.81</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.53</mn></mrow><annotation encoding="application/x-tex">80.81{\scriptstyle\pm 0.53}</annotation></semantics></math></td></tr>
