<td id="S4.SS3.SSS0.Px1.fig2.2.1.4.2" class="ltx_td ltx_align_center" style="padding:-0.5pt 5.0pt;"><math id="S4.SS3.SSS0.Px1.m5" class="ltx_Math" style="--ltx-bg-color:#EDF7FF;" alttext="66.47{\scriptstyle\pm 0.58}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF">66.47</mn><mo style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF" mathsize="0.700em">±</mo><mn style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF" mathsize="0.700em">0.58</mn></mrow><annotation encoding="application/x-tex">66.47{\scriptstyle\pm 0.58}</annotation></semantics></math></td>
<td id="S4.SS3.SSS0.Px1.fig2.2.1.4.3" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.5pt 5.0pt;"><math id="S4.SS3.SSS0.Px1.m6" class="ltx_Math" style="--ltx-bg-color:#EDF7FF;" alttext="81.96{\scriptstyle\pm 0.29}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF">81.96</mn><mo style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF" mathsize="0.700em">±</mo><mn style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF" mathsize="0.700em">0.29</mn></mrow><annotation encoding="application/x-tex">81.96{\scriptstyle\pm 0.29}</annotation></semantics></math></td></tr>
<tr id="S4.SS3.SSS0.Px1.fig2.2.1.5" class="ltx_tr">
<th id="S4.SS3.SSS0.Px1.fig2.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:-0.5pt 5.0pt;">RPO</th>
<td id="S4.SS3.SSS0.Px1.fig2.2.1.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 5.0pt;"><math id="S4.SS3.SSS0.Px1.m7" class="ltx_Math" alttext="65.08{\scriptstyle\pm 0.38}" display="inline" intent=":literal"><semantics><mrow><mn>65.08</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.38</mn></mrow><annotation encoding="application/x-tex">65.08{\scriptstyle\pm 0.38}</annotation></semantics></math></td>
