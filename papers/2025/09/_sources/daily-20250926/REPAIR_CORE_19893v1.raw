<th id="S4.T5.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DeepSeekMath</th>
<td id="S4.T5.2.3.2" class="ltx_td ltx_align_right">30,889</td>
<td id="S4.T5.2.3.3" class="ltx_td ltx_align_right">32,471</td></tr>
