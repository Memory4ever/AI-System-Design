<th id="S4.SS3.SSS0.Px1.fig2.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.5pt 5.0pt;"><span id="S4.SS3.SSS0.Px1.fig2.2.1.1.2.1" class="ltx_text ltx_font_bold">MATH500</span></th>
