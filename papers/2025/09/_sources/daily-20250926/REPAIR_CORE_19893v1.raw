<td id="S4.SS3.SSS0.Px1.fig2.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 5.0pt;"><math id="S4.SS3.SSS0.Px1.m1" class="ltx_Math" alttext="65.68{\scriptstyle\pm 0.45}" display="inline" intent=":literal"><semantics><mrow><mn>65.68</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.45</mn></mrow><annotation encoding="application/x-tex">65.68{\scriptstyle\pm 0.45}</annotation></semantics></math></td>
<td id="S4.SS3.SSS0.Px1.fig2.2.1.2.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-0.5pt 5.0pt;"><math id="S4.SS3.SSS0.Px1.m2" class="ltx_Math" alttext="80.15{\scriptstyle\pm 0.24}" display="inline" intent=":literal"><semantics><mrow><mn>80.15</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.24</mn></mrow><annotation encoding="application/x-tex">80.15{\scriptstyle\pm 0.24}</annotation></semantics></math></td></tr>
