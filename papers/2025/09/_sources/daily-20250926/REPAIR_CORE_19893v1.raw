<td id="S4.SS3.SSS0.Px1.fig2.2.1.7.2" class="ltx_td ltx_align_center" style="padding:-0.5pt 5.0pt;"><math id="S4.SS3.SSS0.Px1.m11" class="ltx_Math" style="--ltx-bg-color:#EDF7FF;" alttext="68.05{\scriptstyle\pm 0.46}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF">68.05</mn><mo style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF" mathsize="0.700em">±</mo><mn style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF" mathsize="0.700em">0.46</mn></mrow><annotation encoding="application/x-tex">68.05{\scriptstyle\pm 0.46}</annotation></semantics></math></td>
<td id="S4.SS3.SSS0.Px1.fig2.2.1.7.3" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.5pt 5.0pt;"><math id="S4.SS3.SSS0.Px1.m12" class="ltx_Math" style="--ltx-bg-color:#EDF7FF;" alttext="83.80{\scriptstyle\pm 0.23}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF">83.80</mn><mo style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF" mathsize="0.700em">±</mo><mn style="--ltx-bg-color:#EDF7FF;" mathbackground="#EDF7FF" mathsize="0.700em">0.23</mn></mrow><annotation encoding="application/x-tex">83.80{\scriptstyle\pm 0.23}</annotation></semantics></math></td></tr>
