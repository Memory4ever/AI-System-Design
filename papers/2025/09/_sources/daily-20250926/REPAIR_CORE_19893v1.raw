<td id="S4.SS3.SSS0.Px1.fig2.2.1.3.3" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.5pt 5.0pt;"><math id="S4.SS3.SSS0.Px1.m4" class="ltx_Math" alttext="80.71{\scriptstyle\pm 0.71}" display="inline" intent=":literal"><semantics><mrow><mn>80.71</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.71</mn></mrow><annotation encoding="application/x-tex">80.71{\scriptstyle\pm 0.71}</annotation></semantics></math></td></tr>
