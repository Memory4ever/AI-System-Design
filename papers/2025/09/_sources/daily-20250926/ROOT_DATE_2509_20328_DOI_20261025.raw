{"data":{"id":"10.48550/arxiv.2509.20328","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.20328","prefix":"10.48550","suffix":"arxiv.2509.20328","identifiers":[{"identifier":"2509.20328","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.20328"}],"creators":[{"name":"Wiedemer, Thaddäus","nameType":"Personal","givenName":"Thaddäus","familyName":"Wiedemer","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Yuxuan","nameType":"Personal","givenName":"Yuxuan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Vicol, Paul","nameType":"Personal","givenName":"Paul","familyName":"Vicol","affiliation":[],"nameIdentifiers":[]},{"name":"Gu, Shixiang Shane","nameType":"Personal","givenName":"Shixiang Shane","familyName":"Gu","affiliation":[],"nameIdentifiers":[]},{"name":"Matarese, Nick","nameType":"Personal","givenName":"Nick","familyName":"Matarese","affiliation":[],"nameIdentifiers":[]},{"name":"Swersky, Kevin","nameType":"Personal","givenName":"Kevin","familyName":"Swersky","affiliation":[],"nameIdentifiers":[]},{"name":"Kim, Been","nameType":"Personal","givenName":"Been","familyName":"Kim","affiliation":[],"nameIdentifiers":[]},{"name":"Jaini, Priyank","nameType":"Personal","givenName":"Priyank","familyName":"Jaini","affiliation":[],"nameIdentifiers":[]},{"name":"Geirhos, Robert","nameType":"Personal","givenName":"Robert","familyName":"Geirhos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Video models are zero-shot learners and reasoners"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T17:17:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-25T01:02:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-29T20:44:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-01T00:11:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The remarkable zero-shot capabilities of Large Language Models (LLMs) have propelled natural language processing from task-specific models to unified, generalist foundation models. This transformation emerged from simple primitives: large, generative models trained on web-scale data. Curiously, the same primitives apply to today's generative video models. Could video models be on a trajectory towards general-purpose vision understanding, much like LLMs developed general-purpose language understanding? We demonstrate that Veo 3 can solve a broad variety of tasks it wasn't explicitly trained for: segmenting objects, detecting edges, editing images, understanding physical properties, recognizing object affordances, simulating tool use, and more. These abilities to perceive, model, and manipulate the visual world enable early forms of visual reasoning like maze and symmetry solving. Veo's emergent zero-shot capabilities indicate that video models are on a path to becoming unified, generalist vision foundation models.","descriptionType":"Abstract"},{"description":"Project page: https://video-zero-shot.github.io/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.20328","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-25T02:05:54.000Z","registered":"2025-09-25T02:05:54.000Z","published":"2025","updated":"2025-10-01T02:59:08.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.20328","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}