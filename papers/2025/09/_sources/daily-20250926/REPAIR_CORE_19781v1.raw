<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx1.Ex21.m2" class="ltx_Math" alttext="\displaystyle\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">γ</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mi mathsize="0.900em">𝒈</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝝃</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><msqrt><mi mathsize="0.900em">w</mi></msqrt></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><msub><mi mathsize="0.900em">𝒁</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></msub></mrow><mo mathsize="0.900em">+</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx1.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx1.Ex22.m1" class="ltx_Math" alttext="\displaystyle\|(\boldsymbol{\xi}^{*}-\boldsymbol{\xi}_{0})+(\boldsymbol{\xi}_{0}-\boldsymbol{\xi}_{t-1})\|_{2}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{0})-\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msup><mi mathsize="0.900em">𝝃</mi><mo mathsize="0.900em">∗</mo></msup><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">𝝃</mi><mn mathsize="0.900em">0</mn></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">+</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">𝝃</mi><mn mathsize="0.900em">0</mn></msub><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">𝝃</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mn mathsize="0.900em">2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mi mathsize="0.900em">𝒈</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝝃</mi><mn mathsize="0.900em">0</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mi mathsize="0.900em">𝒈</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝝃</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><mn mathsize="0.900em">2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|(\boldsymbol{\xi}^{*}-\boldsymbol{\xi}_{0})+(\boldsymbol{\xi}_{0}-\boldsymbol{\xi}_{t-1})\|_{2}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{0})-\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx1.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx1.Ex23.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx1.Ex23.m2" class="ltx_Math" alttext="\displaystyle\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">γ</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mi mathsize="0.900em">𝒈</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝝃</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><msqrt><mi mathsize="0.900em">w</mi></msqrt></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><msub><mi mathsize="0.900em">𝒁</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></msub></mrow><mo mathsize="0.900em">+</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx1.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx1.Ex24.m1" class="ltx_math_unparsed" alttext="\displaystyle\overline{C}_{2}(\sqrt{2\boldsymbol{m}^{\top}\boldsymbol{M}^{-1}\boldsymbol{m}}+2\sqrt{t/\lambda})w^{-1/6}\sqrt{\log w}t^{1/6}\lambda^{-1/6}L^{7/2}," display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathsize="0.900em">C</mi><mo stretchy="true">¯</mo></mover><mn mathsize="0.900em">2</mn></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msqrt><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">𝒎</mi><mo mathsize="0.900em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">𝑴</mi><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">𝒎</mi></mrow></msqrt><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">2</mn><msqrt><mrow><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mi mathsize="0.900em">λ</mi></mrow></msqrt><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><msup><mi mathsize="0.900em">w</mi><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">6</mn></mrow></msup><msqrt><mrow><mi mathsize="0.900em">log</mi><mo lspace="0.167em">⁡</mo><mi mathsize="0.900em">w</mi></mrow></msqrt><msup><mi mathsize="0.900em">t</mi><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">6</mn></mrow></msup><msup><mi mathsize="0.900em">λ</mi><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">6</mn></mrow></msup><msup><mi mathsize="0.900em">L</mi><mrow><mn mathsize="0.900em">7</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">2</mn></mrow></msup><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overline{C}_{2}(\sqrt{2\boldsymbol{m}^{\top}\boldsymbol{M}^{-1}\boldsymbol{m}}+2\sqrt{t/\lambda})w^{-1/6}\sqrt{\log w}t^{1/6}\lambda^{-1/6}L^{7/2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Sx1.SS3.p5" class="ltx_para ltx_noindent">
<p id="Sx1.SS3.p5.1" class="ltx_p">where the first inequality is derived from the triangle inequality; the second inequality holds due to Hölder’s inequality; the third inequality follows Lemma <a href="#ThmLemma3" title="Lemma 3. ‣ VI-B Proof of Theorem 1 ‣ Appendix ‣ Faster, Smaller, and Smarter: Task-Aware Expert Merging for Online MoE Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>; the fourth inequality uses Lemmas B.5 and B.6 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite>.
Combining Eq. (<a href="#Sx1.E11" title="In VI-C Proof of Lemma 4 ‣ Appendix ‣ Faster, Smaller, and Smarter: Task-Aware Expert Merging for Online MoE Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) and Eq. (<a href="#Sx1.E12" title="In VI-C Proof of Lemma 4 ‣ Appendix ‣ Faster, Smaller, and Smarter: Task-Aware Expert Merging for Online MoE Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>), we obtain:</p>
</div>
<div id="Sx1.SS3.p6" class="ltx_para">
<table id="Sx1.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="Sx1.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx1.Ex25.m1" class="ltx_Math" alttext="\displaystyle f(\boldsymbol{x},\boldsymbol{\xi}_{t-1})-\langle\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{0}),\boldsymbol{\xi}^{*}-\boldsymbol{\xi}_{0}\rangle\|\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝒈</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>𝝃</mi><mo>∗</mo></msup><mo>−</mo><msub><mi>𝝃</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo fence="false" rspace="0em">|</mo><mo lspace="0em">≤</mo></mrow><annotation encoding="application/x-tex">\displaystyle f(\boldsymbol{x},\boldsymbol{\xi}_{t-1})-\langle\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{0}),\boldsymbol{\xi}^{*}-\boldsymbol{\xi}_{0}\rangle\|\leq</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx1.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx1.E13.m1" class="ltx_Math" alttext="\displaystyle\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+\bar{\Gamma}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>γ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝒈</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msqrt><mi>w</mi></msqrt></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>𝒁</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></mrow><mo>+</mo><mover accent="true"><mi mathvariant="normal">Γ</mi><mo>¯</mo></mover></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+\bar{\Gamma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
</div>
