</figcaption>
</figure>
<figure id="S5.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_table">TABLE II: </span>Performance metrics for T5-based MoE with different routing methods.</figcaption>
<table id="S5.T2.4" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S5.T2.4.1" class="ltx_tr">
<td id="S5.T2.4.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S5.T2.4.1.1.1" class="ltx_text" style="font-size:80%;">Method</span></td>
<td id="S5.T2.4.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T2.4.1.2.1" class="ltx_text" style="font-size:80%;">CoLA</span></td>
<td id="S5.T2.4.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T2.4.1.3.1" class="ltx_text" style="font-size:80%;">MNLI</span></td>
<td id="S5.T2.4.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T2.4.1.4.1" class="ltx_text" style="font-size:80%;">MRPC</span></td>
