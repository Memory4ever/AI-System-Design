<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx1.Ex31.m2" class="ltx_Math" alttext="\displaystyle 2\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x}_{h_{t},i_{t}},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+2\bar{\Gamma}+\nu_{1}\rho^{h_{t}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">γ</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mi mathsize="0.900em">𝒈</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mrow><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">t</mi></msub></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝝃</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><msqrt><mi mathsize="0.900em">w</mi></msqrt></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><msub><mi mathsize="0.900em">𝒁</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathsize="0.900em" mathvariant="normal">Γ</mi><mo>¯</mo></mover></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ν</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ρ</mi><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">t</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x}_{h_{t},i_{t}},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+2\bar{\Gamma}+\nu_{1}\rho^{h_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx1.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx1.Ex32.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx1.Ex32.m2" class="ltx_Math" alttext="\displaystyle\min\{2\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x}_{h_{t},i_{t}},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+2\bar{\Gamma}+\nu_{1}\rho^{h_{t}},1\}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">γ</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mi mathsize="0.900em">𝒈</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mrow><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">t</mi></msub></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝝃</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><msqrt><mi mathsize="0.900em">w</mi></msqrt></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><msub><mi mathsize="0.900em">𝒁</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></msub></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathsize="0.900em" mathvariant="normal">Γ</mi><mo>¯</mo></mover></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ν</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ρ</mi><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">t</mi></msub></msup></mrow></mrow><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\min\{2\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x}_{h_{t},i_{t}},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}}+2\bar{\Gamma}+\nu_{1}\rho^{h_{t}},1\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="Sx1.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="Sx1.Ex33.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx1.Ex33.m2" class="ltx_Math" alttext="\displaystyle 2\min\{\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x}_{h_{t},i_{t}},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}},1\}+2\bar{\Gamma}+\nu_{1}\rho^{h_{t}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.900em">min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi mathsize="0.900em">γ</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mrow><mi mathsize="0.900em">𝒈</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝒙</mi><mrow><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">t</mi></msub></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝝃</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><msqrt><mi mathsize="0.900em">w</mi></msqrt></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><msub><mi mathsize="0.900em">𝒁</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></msub></mrow><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">1</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi mathsize="0.900em" mathvariant="normal">Γ</mi><mo>¯</mo></mover></mrow><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">ν</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ρ</mi><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">t</mi></msub></msup></mrow></mrow><mo mathsize="0.900em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\min\{\gamma_{t-1}\|\boldsymbol{g}(\boldsymbol{x}_{h_{t},i_{t}},\boldsymbol{\xi}_{t-1})/\sqrt{w}\|_{\boldsymbol{Z}_{t-1}},1\}+2\bar{\Gamma}+\nu_{1}\rho^{h_{t}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Sx1.SS3.p9" class="ltx_para ltx_noindent">
<p id="Sx1.SS3.p9.1" class="ltx_p">where the first inequality follows from the triangle inequality and the fact that the difference between any two scalar values can be upper bounded by the sum of their pairwise differences; the second inequality applies the local smoothness assumption and the bound on the prediction error, as given in Eq. (<a href="#Sx1.Ex25" title="In VI-C Proof of Lemma 4 ‣ Appendix ‣ Faster, Smaller, and Smarter: Task-Aware Expert Merging for Online MoE Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>); the third inequality holds because the reward function is bounded within <math id="Sx1.SS3.p9.m1" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>, which can be achieved through normalization; the fourth inequality follows from the property that <math id="Sx1.SS3.p9.m2" class="ltx_Math" alttext="\min\{a+b,1\}\leq\min\{a,1\}+b" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi mathsize="0.900em">a</mi><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">b</mi></mrow><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo mathsize="0.900em">≤</mo><mrow><mrow><mi mathsize="0.900em">min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi mathsize="0.900em">a</mi><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">1</mn><mo stretchy="false">}</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">b</mi></mrow></mrow><annotation encoding="application/x-tex">\min\{a+b,1\}\leq\min\{a,1\}+b</annotation></semantics></math> for any non-negative values <math id="Sx1.SS3.p9.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="Sx1.SS3.p9.m4" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>.</p>
</div>
