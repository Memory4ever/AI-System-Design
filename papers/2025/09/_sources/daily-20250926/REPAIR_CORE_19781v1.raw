<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx1.Ex19.m2" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\xi}^{*}-\boldsymbol{\xi}_{t-1}\|_{\boldsymbol{Z}_{t-1}}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})\|_{\boldsymbol{Z}_{t-1}}+" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><msup><mi mathsize="0.900em">𝝃</mi><mo mathsize="0.900em">∗</mo></msup><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">𝝃</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><msub><mi mathsize="0.900em">𝒁</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><mi mathsize="0.900em">𝒈</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝝃</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo></mrow><msub><mi mathsize="0.900em">𝒁</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></msub></mrow><mo mathsize="0.900em">+</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\xi}^{*}-\boldsymbol{\xi}_{t-1}\|_{\boldsymbol{Z}_{t-1}}\|\boldsymbol{g}(\boldsymbol{x},\boldsymbol{\xi}_{t-1})\|_{\boldsymbol{Z}_{t-1}}+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
