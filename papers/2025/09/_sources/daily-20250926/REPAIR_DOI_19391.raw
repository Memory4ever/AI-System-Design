{"data":{"id":"10.48550/arxiv.2509.19391","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.19391","prefix":"10.48550","suffix":"arxiv.2509.19391","identifiers":[{"identifier":"2509.19391","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.19391"}],"creators":[{"name":"Marmoret, Axel","nameType":"Personal","givenName":"Axel","familyName":"Marmoret","affiliation":[],"nameIdentifiers":[]},{"name":"Bensaid, Reda","nameType":"Personal","givenName":"Reda","familyName":"Bensaid","affiliation":[],"nameIdentifiers":[]},{"name":"Lys, Jonathan","nameType":"Personal","givenName":"Jonathan","familyName":"Lys","affiliation":[],"nameIdentifiers":[]},{"name":"Gripon, Vincent","nameType":"Personal","givenName":"Vincent","familyName":"Gripon","affiliation":[],"nameIdentifiers":[]},{"name":"Leduc-Primeau, François","nameType":"Personal","givenName":"François","familyName":"Leduc-Primeau","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TensLoRA: Tensor Alternatives for Low-Rank Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"I.2.6; I.2.7; I.2.10","subjectScheme":"ACM"},{"lang":"en","subject":"68T","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-22T17:15:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-25T00:02:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-26T17:51:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T02:43:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-05T08:34:09Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-06T01:33:32Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Low-Rank Adaptation (LoRA) is widely used to efficiently adapt Transformers by adding trainable low-rank matrices to attention projections. While effective, these matrices are considered independent for each attention projection (Query, Key, and Value) and each layer. Recent extensions have considered joint, tensor-based adaptations, but only in limited forms and without a systematic framework. We introduce TensLoRA, a unified framework that aggregates LoRA updates into higher-order tensors and models a broad family of tensor-based low-rank adaptations. Our formulation generalizes existing tensor-based methods and enables mode-specific compression rates, allowing parameter budgets to be tailored according to the modality and task. Experiments on vision and language benchmarks reveal that the tensor construction directly impacts performance, sometimes better than standard LoRA under similar parameter counts.","descriptionType":"Abstract"},{"description":"Published at ICASSP 2026. 5 pages, 1 figure, 2 tables. Code can be found at https://github.com/ax-le/TensLoRA","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.19391","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-25T01:43:55.000Z","registered":"2025-09-25T01:43:55.000Z","published":"2025","updated":"2026-02-06T03:21:01.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.19391","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}