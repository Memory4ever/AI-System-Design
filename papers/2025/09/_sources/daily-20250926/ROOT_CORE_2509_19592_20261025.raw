</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F2.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.19592v1/fcd_unseen.svg" id="S3.F2.sf5.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:115/138;" width="115" height="138"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.sf5.3" class="ltx_text" style="font-size:90%;">(e)</span> </span><span id="S3.F2.sf5.4" class="ltx_text" style="font-size:90%;">Fréchet Distance (unseen speakers)</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F2.sf6" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.19592v1/speedup.svg" id="S3.F2.sf6.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:115/139;" width="115" height="139"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.sf6.3" class="ltx_text" style="font-size:90%;">(f)</span> </span><span id="S3.F2.sf6.4" class="ltx_text" style="font-size:90%;">Inference Speed</span></figcaption>
