<figure id="S6.F9.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.19702v1/dist_alpha_1.svg" id="S6.F9.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/338;" width="476" height="338"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S6.F9.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><math id="S6.F9.sf1.m2" class="ltx_Math" alttext="\alpha=" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\alpha=</annotation></semantics></math><span id="S6.F9.sf1.4" class="ltx_text" style="font-size:90%;"> 1</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S6.F9.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.19702v1/dist_alpha_0.8.svg" id="S6.F9.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/338;" width="476" height="338"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S6.F9.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><math id="S6.F9.sf2.m2" class="ltx_Math" alttext="\alpha=1/1.2" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">1.2</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=1/1.2</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F9.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.19702v1/dist_alpha_0.6.svg" id="S6.F9.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/338;" width="476" height="338"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S6.F9.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><math id="S6.F9.sf3.m2" class="ltx_Math" alttext="\alpha=1/2.8" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">2.8</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=1/2.8</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F9.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.19702v1/dist_alpha_0.5.svg" id="S6.F9.sf4.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/338;" width="476" height="338"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S6.F9.sf4.3" class="ltx_text" style="font-size:90%;">(d)</span> </span><math id="S6.F9.sf4.m2" class="ltx_Math" alttext="\alpha=1/85" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">85</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=1/85</annotation></semantics></math></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F9.4" class="ltx_text" style="font-size:90%;">Figure 9</span>: </span><span id="S6.F9.5" class="ltx_text" style="font-size:90%;">In the distributed setting, <span id="S6.F9.5.1" class="ltx_text ltx_font_smallcaps">EAGLE</span> shows significant improvements in iteration count. As the theory suggest, the convergence depends on the data alignment parameter <math id="S6.F9.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.</span></figcaption>
</figure>
