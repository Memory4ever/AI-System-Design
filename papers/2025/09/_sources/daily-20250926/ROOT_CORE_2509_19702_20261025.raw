<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S6.F8.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><math id="S6.F8.sf3.m2" class="ltx_Math" alttext="r=120" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">r</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">120</mn></mrow><annotation encoding="application/x-tex">r=120</annotation></semantics></math></figcaption>
