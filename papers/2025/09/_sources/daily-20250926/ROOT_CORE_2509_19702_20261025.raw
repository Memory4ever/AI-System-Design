</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S6.F7.sf8" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.19702v1/central_kappa_100000.svg" id="S6.F7.sf8.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/340;" width="476" height="340"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S6.F7.sf8.3" class="ltx_text" style="font-size:90%;">(h)</span> </span><math id="S6.F7.sf8.m2" class="ltx_Math" alttext="\kappa=100\,000" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">κ</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">100 000</mn></mrow><annotation encoding="application/x-tex">\kappa=100\,000</annotation></semantics></math></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F7.4" class="ltx_text" style="font-size:90%;">Figure 7</span>: </span><span id="S6.F7.5" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">EAGLE<span id="S6.F7.5.1" class="ltx_text ltx_font_upright"> shows second order convergence in the unconstrained regime. It extends to low-rank completion and scales logarithmically with the condition number <math id="S6.F7.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>.</span></span></figcaption>
</figure>
