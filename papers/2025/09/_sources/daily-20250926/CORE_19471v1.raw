<td id="A1.T4.5.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.15pt 2.5pt;"><math id="A1.T4.m2" class="ltx_Math" alttext="10^{-3}" display="inline" intent=":literal"><semantics><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">3</mn></mrow></msup><annotation encoding="application/x-tex">10^{-3}</annotation></semantics></math></td>
<td id="A1.T4.5.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.15pt 2.5pt;"><span id="A1.T4.5.3.6.1" class="ltx_text" style="font-size:90%;">MSE</span></td>
<td id="A1.T4.5.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.15pt 2.5pt;"><span id="A1.T4.5.3.7.1" class="ltx_text" style="font-size:90%;">128</span></td>
<td id="A1.T4.5.3.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding:1.15pt 2.5pt;"><span id="A1.T4.5.3.8.1" class="ltx_text" style="font-size:90%;">10</span></td></tr>
