<td id="A2.T4.2.5.2" class="ltx_td ltx_align_left"><math id="A2.T4.m2" class="ltx_Math" alttext="1\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-5}</annotation></semantics></math></td></tr>
<tr id="A2.T4.2.6" class="ltx_tr">
<th id="A2.T4.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Training Epochs</th>
