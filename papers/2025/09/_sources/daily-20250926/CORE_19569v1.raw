<td id="S4.T3.2.3.6" class="ltx_td ltx_align_right"><span id="S4.T3.2.3.6.1" class="ltx_text ltx_underline">5.65</span></td></tr>
<tr id="S4.T3.2.4" class="ltx_tr">
<th id="S4.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">ExQPE M</th>
<td id="S4.T3.2.4.2" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T3.2.4.2.1" class="ltx_text ltx_font_bold">2.63</span></td>
<td id="S4.T3.2.4.3" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T3.2.4.3.1" class="ltx_text ltx_font_bold">2.59</span></td>
<td id="S4.T3.2.4.4" class="ltx_td ltx_align_right ltx_border_t">2.68</td>
