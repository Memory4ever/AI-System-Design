<td id="S2.T3.7.2.3" class="ltx_td ltx_align_left ltx_border_t" style="--ltx-bg-color:#F2F2F2;padding:0.8pt 8.5pt;"><span id="S2.T3.7.2.3.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#F2F2F2;">0.61</span></td>
