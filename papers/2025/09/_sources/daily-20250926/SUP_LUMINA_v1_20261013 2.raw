<td id="S6.T10.12.1.24.2" class="ltx_td ltx_align_center" style="padding:1pt 3.5pt;"><span id="S6.T10.12.1.24.2.1" class="ltx_text" style="font-size:70%;">Discrete Diff.</span></td>
<td id="S6.T10.12.1.24.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 3.5pt;"><math id="S6.T10.m89" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math><span id="S6.T10.12.1.24.3.1" class="ltx_text" style="font-size:70%;">B</span></td>
