<td id="S6.T10.12.1.25.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 3.5pt;"><math id="S6.T10.m98" class="ltx_Math" style="--ltx-bg-color:#E6FFE6;" alttext="84.5" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#0000FF;--ltx-bg-color:#E6FFE6;" mathbackground="#E6FFE6" mathcolor="#0000FF" mathsize="0.700em">84.5</mn><annotation encoding="application/x-tex">84.5</annotation></semantics></math></td>
