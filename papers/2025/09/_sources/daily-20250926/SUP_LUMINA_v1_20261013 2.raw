<td id="S6.T10.12.1.24.7" class="ltx_td ltx_align_center" style="padding:1pt 3.5pt;"><math id="S6.T10.m93" class="ltx_Math" alttext="64.2" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">64.2</mn><annotation encoding="application/x-tex">64.2</annotation></semantics></math></td>
<td id="S6.T10.12.1.24.8" class="ltx_td ltx_align_center" style="padding:1pt 3.5pt;"><math id="S6.T10.m94" class="ltx_Math" alttext="30.2" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">30.2</mn><annotation encoding="application/x-tex">30.2</annotation></semantics></math></td></tr>
<tr id="S6.T10.12.1.25" class="ltx_tr" style="--ltx-bg-color:#E6FFE6;">
<td id="S6.T10.12.1.25.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:1pt 3.5pt;"><span id="S6.T10.12.1.25.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#E6FFE6;">Lumina-DiMOO (Ours)</span></td>
<td id="S6.T10.12.1.25.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 3.5pt;"><span id="S6.T10.12.1.25.2.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#E6FFE6;">Discrete Diff.</span></td>
<td id="S6.T10.12.1.25.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding:1pt 3.5pt;"><math id="S6.T10.m95" class="ltx_Math" style="--ltx-bg-color:#E6FFE6;" alttext="8" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#E6FFE6;" mathbackground="#E6FFE6" mathsize="0.700em">8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math><span id="S6.T10.12.1.25.3.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#E6FFE6;">B</span></td>
<td id="S6.T10.12.1.25.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 3.5pt;"><math id="S6.T10.m96" class="ltx_Math" style="--ltx-bg-color:#E6FFE6;" alttext="87.4" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FF0000;--ltx-bg-color:#E6FFE6;" mathbackground="#E6FFE6" mathcolor="#FF0000" mathsize="0.700em">87.4</mn><annotation encoding="application/x-tex">87.4</annotation></semantics></math></td>
