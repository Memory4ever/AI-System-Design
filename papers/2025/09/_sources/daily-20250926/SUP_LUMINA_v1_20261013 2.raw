<td id="S3.T1.4.4.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S3.T1.4.4.1.1" class="ltx_inline-block ltx_align_middle" style="width:153.6pt;">
