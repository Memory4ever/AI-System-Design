</span>
</div>
<div id="alg2.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
            <span id="alg2.l18.3" class="ltx_text" style="font-size:90%;">  </span><span id="alg2.l18.4" class="ltx_text ltx_font_bold" style="font-size:90%;">else</span>
</div>
