            <span id="alg2.l14.3" class="ltx_text" style="font-size:90%;">  </span><span id="alg2.l14.4" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l14.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l14.6" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span>
</div>
<div id="alg2.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
            <span id="alg2.l15.3" class="ltx_text" style="font-size:90%;">  </span><span id="alg2.l15.4" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span><span id="alg2.l15.5" class="ltx_text" style="font-size:90%;"> LLM.AnalyzeCompleteness(</span><math id="alg2.l15.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math><span id="alg2.l15.6" class="ltx_text" style="font-size:90%;">, </span><math id="alg2.l15.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math><span id="alg2.l15.7" class="ltx_text" style="font-size:90%;">) </span><span id="alg2.l15.8" class="ltx_text ltx_font_bold" style="font-size:90%;">then</span><span id="alg2.l15.9" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
            <span id="alg2.l16.3" class="ltx_text" style="font-size:90%;">   AgentCache.Store(</span><math id="alg2.l16.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="alg2.l16.4" class="ltx_text" style="font-size:90%;">, “OK”)
</span>
</div>
<div id="alg2.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
