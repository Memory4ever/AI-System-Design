s\",\"8626\",\"static/chunks/8626-559fb404fc9f9e00.js\",\"6916\",\"static/chunks/app/(frontend)/%5Blocale%5D/layout-8da9589bcedc7c1a.js\"],\"default\"]\n13:I[84243,[\"4042\",\"static/chunks/4042-24b8a4e4b22b3931.js\",\"1187\",\"static/chunks/1187-a674d9b75243c496.js\",\"3873\",\"static/chunks/3873-2d993ead6708dcf1.js\",\"8423\",\"static/chunks/8423-f2a102673951d80b.js\",\"31\",\"static/chunks/app/(frontend)/%5Blocale%5D/(routes)/research/page-dbb507db4bffb18e.js\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"10:[\"$\",\"$L11\",null,{\"formats\":\"$undefined\",\"locale\":\"zh\",\"messages\":{\"about\":\"关于我们\",\"about_title\":\"关于智谱\",\"about_zhipu_desc\":\"智谱（Z.AI）成立于 2019 年，由清华大学计算机系知识工程实验室（KEG）技术成果转化而来，具备从底层算法、预训练框架到国产硬件适配的大模型全链路自主研发能力。公司以“让机器像人一样思考”为愿景，以实现通用人工智能（AGI）为目标，极致专注探索人工智能上限，致力于用大模型实现甚至超越人类的语言、推理、视觉、听觉、工具使用等能力。\",\"about_zhipu_title\":\"北京智谱华章科技股份有限公司\",\"about_hero_title\":\"让机器像人一样思考\",\"about_hero_desc\":\"Teach machines to think like humans\",\"address\":\"北京市海淀区中关村东路 1 号院 9 号楼 10 层\",\"ai_slides\":\"AI Slides\",\"maasSection\":{\"description\":\"我们不仅生产模型，更构建可信智能\",\"description1\":\"提供能力全球领先、灵活易用、高性价比的全模态大模型 API 服务\",\"description2\":\"数十个深度耦合业务的应用级 API，开箱即用，直击千行百业真需求\",\"description3\":\"一站式、组件化大模型开发，享受高效定制模型体验，保障企业级 AI 应用落地\",\"items1\":{\"desc1\":\"Coding 能力开源 SOTA，支持 1M 无损上下文，长程任务执行更稳定，工程规范遵循更可靠\",\"desc2\":\"多模态 Coding 模型，原生融合视觉与文本能力。针对视觉编程与龙虾类 Agent 任务进行专项优化\"},\"items2\":{\"desc1\":\"精通多国语种，精确识别语境、语体、俚语及专业术语，实现高保真情景化翻译\",\"desc2\":\"从搜索到设计，一键生成精美可用的PPT/海报, 文字图表智能完美融合\",\"title1\":\"通用翻译\",\"title2\":\"GLM PPT/海报\"},\"items3\":{\"desc1\":\"支持对语言、多模态模型的多种微调方案，低至十分钟完成微调，让模型更懂你的任务场景\",\"desc2\":\"集成多家搜索引擎，专为大模型优化，助力 AI 应用生成实时、精准、可溯源的内容\",\"title1\":\"模型微调\",\"title2\":\"AI 搜索工具\"},\"title1\":\"高效能模型服务\",\"title2\":\"精选智能体应用\",\"title3\":\"全流程开发套件\",\"viewAll\":\"查看全部\"},\"autoglm\":{\"desc\":\"自主规划并执行复杂多步骤任务的智能体模型\"},\"banner_button\":\"立刻了解\",\"banner_text\":\"GLM Coding Plan 编码套餐：低至20元包月，畅享全球顶级编码体验\",\"businessEcosystem\":{\"description\":\"帮助行业合作伙伴与各城市做出成功的大模型应用\",\"title\":\"商业生态\"},\"business_cooperation\":\"商务合作\",\"marketing\":\"市场公关\",\"investors_relations\":\"投资者关系\",\"business_license\":\"营业执照\",\"chat_title\":\"你好 我是 ZCode\",\"chat_placeholder\":\"今天有什么可以帮助你？\",\"chatglm_6b\":{\"desc\":\"中国第一个对话模型\"},\"contact_business_type\":\"※ 您咨询的业务类型\",\"contact_button_text\":\"合作咨询\",\"contact_code\":\"※ 请输入验证码\",\"contact_company\":\"※ 您的公司名称\",\"contact_description\":\"我们最新的前沿模型系列，在推理、编码和智能体任务方面表现出色\",\"contact_name\":\"※ 请输入您的姓名\",\"contact_phone\":\"※ 请输入您的电话\",\"contact_select_digital_human\":\"数字人\",\"contact_select_llm\":\"大模型\",\"contact_select_news_media\":\"新闻媒体\",\"contact_select_other\":\"其它\",\"contact_submit\":\"预约咨询\",\"contact_submit_error\":\"网络异常，表单提交失败，请检查网络后重试\",\"contact_submit_error_desc\":\"请稍后再试\",\"contact_submit_success\":\"提交成功\",\"contact_submit_success_desc\":\"我们会尽快与您联系\",\"contact_submitting\":\"提交中...\",\"contact_title\":\"业务咨询\",\"copyright\":\"Copyright ◎ 2025-2026 北京智谱华章科技股份有限公司\",\"ending\":{\"button\":\"免费试用\",\"description\":\"注册立享 2000万 tokens\",\"title\":\"日均付费调用量超万亿tokens  累计服务超270万开发者，日活超20万开发者\",\"title1\":\"中国大型独立大模型厂商\",\"title2\":\"国产原创 GLM 大模型架构\",\"title_mobile1\":\"中国大型独立大模型厂商\",\"title_mobile2\":\"国产原创 GLM 大模型架构\",\"title_mobile3\":\"\"},\"full_stack\":\"Full Stack\",\"glmSection\":{\"glm_5\":{\"title\":\"GLM-5\",\"desc\":\"在 SWE-bench Verified、Terminal Bench 2.0 等智能体编程核心榜单上，GLM-5 达到开源模型 SOTA，比肩 Claude Opus 4.5\"},\"glm_5_t\":{\"title\":\"GLM-5-Turbo\",\"desc\":\"专为龙虾场景打造的基座模型\"},\"glm_4_6V\":{\"title\":\"GLM-4.6V\",\"desc\":\"全球 100B 级效果表现出众的开源视觉推理模型，并同步开源\"},\"autoGLM\":{\"title\":\"AutoGLM\",\"desc\":\"具备自主规划、推理与执行能力的智能体模型，解决了任务规划、数据稀缺和策略优化等核心难题，具备持续自我改进能力\"},\"cogView4\":{\"title\":\"CogView4\",\"desc\":\"擅长理解和遵循中文提示词，能够在画面中生成汉字的开源文生图模型\"},\"glm_Z1_Rumination\":{\"title\":\"GLM-Z1-沉思\",\"desc\":\"能自主执行“实时搜索、深度分析、自我验证”全流程，以完成复杂研究任务的智能体。\"},\"featureDescription\":\"GLM-5.3：前沿编程能力与涌现的网络安全能力。面向复杂软件工程与长程智能体任务，支持 1M 上下文。\",\"featureTitle\":\"GLM-5.3\",\"subtitle\":\"新一代大模型全栈技术体系\",\"title\":\"GLM模型\"},\"glm_130b\":{\"desc\":\"中国第一个开源千亿模型\"},\"glm_4_6v\":{\"desc\":\"全球 100B 级效果表现出众的开源视觉推理模型\"},\"glm_5\":{\"desc\":\"GLM-5 达到开源模型 SOTA，比肩 Claude Opus 4.5\"},\"glm_5_t\":{\"desc\":\"专为龙虾场景打造的基座模型\"},\"glm_image\":{\"desc\":\"智谱联合华为开源国产芯片训练的多模态 SOTA 模型\"},\"hello_world\":\"你好世界\",\"help_me_write\":\"Help Me Write\",\"introduction_desc\":\"自主创新的算法、追求领先的中文认知大模型企业\",\"introduction_title\":\"公司简介\",\"issue_description\":\"请描述您想要咨询的问题\",\"join_us_desc\":\"一群正直的、有激情的年轻人，聚在一起，做创新的、对社会有价值的事\",\"join_us_title\":\"加入我们\",\"joinus\":{\"benefits\":{\"annual_leave\":{\"description\":\"平衡工作，享受生活，让我们在忙碌中也能拥抱悠闲时光，为身心充电\",\"title\":\"丰厚的年假\"},\"flexible_hours\":{\"description\":\"自由工作，高效非凡，员工可根据自身情况灵活安排，轻松应对繁忙工作，提升工作幸福感\",\"title\":\"弹性办工时间\"},\"team_building\":{\"description\":\"欢乐时光，凝聚力量，大家在轻松氛围中交流分享，增进感情，携手共进\",\"title\":\"下午茶团建\"},\"title\":\"智谱福利\"},\"hero\":{\"campus_recruitment\":\"校园招聘\",\"social_recruitment\":\"社会招聘\",\"subtitle\":\"一群正直的、有激情的年轻人，聚在一起，做创新的、对社会有价值的事\",\"title\":\"Think Big ，Deliver Solid ，Scale Stable\"},\"job_categories\":{\"algorithm_campus\":\"算法（校招）\",\"algorithm_campus_description\":\"持续改进训练框架和策略，提升模型训练效率等\",\"campus_recruitment_cta\":\"校园招聘\",\"functional_campus\":\"运营（校招）\",\"functional_campus_description\":\"结合大模型技术优势，参与设计创新的AI解决方案\",\"job_description\":\"负责大模型相关算法的研究与开发\",\"product\":\"产品经理/项目经理（社招）\",\"product_description\":\"项目计划、风险管理、质量管理等\",\"research\":\"算法/研发（社招）\",\"research_campus\":\"研发 (校招)\",\"research_campus_description\":\"强化学习训练框架的研发、优化和维护等\",\"research_description\":\"持续改进训练框架和策略，提升模型训练效率等\",\"sales\":\"销售（社招）\",\"sales_description\":\"大模型相关产品及应用在各个领域的开拓及销售\",\"social_recruitment_cta\":\"社会招聘\",\"title\":\"职位类别\"},\"locations\":{\"beijing\":\"北京\",\"chengdu\":\"成都\",\"hangzhou\":\"杭州\",\"kuala_lumpur\":\"吉隆坡\",\"shanghai\":\"上海\",\"shenzhen\":\"深圳\",\"title\":\"工作地点\"}},\"investor_relations\":\"投资者关系\",\"investor_relations_desc\":\"致力于准确、全面的信息披露，树立开放、透明的企业形象\",\"license\":\"许可证\",\"link_text\":\"了解更多\",\"magic_design\":\"Magic Design\",\"nav_product_aminer_desc\":\"聚焦科研检索、阅读、分析、写作场景的 AI 助手\",\"nav_product_autoglm_desc\":\"一句话实现「云端操作+自动执行」的 Agent 应用\",\"nav_product_chatglm_desc\":\"全能 AI 提效助手，一站式解放 AI 生产力\",\"nav_product_zread_desc\":\"让代码的价值，被更高效地挖掘与传递\",\"nav_product_dongdongzoo_desc\":\"为你而来的 AI 生命，全球首个多模态娱乐社交产品\",\"nav_product_zai_desc\":\"全能 AI 助手，轻松搞定编程、写作与演示文稿\",\"nav_product_autotyper_desc\":\"智能AI语音输入助手，让语音比打字快4倍！\",\"news_desc\":\"了解更多智谱的资讯动态\",\"news_page\":{\"button_platform\":\"开放平台\",\"button_try\":\"立即体验\",\"load_more_button\":\"没有更多...\",\"subtitle\":\"结合科研能力和转化创新力量，助力拓展科技前沿，以应对社会尚未解决的需求\",\"title\":\"新闻和资讯\"},\"news_page_load_more_button\":\"查看更多\",\"news_page_loading\":\"加载中...\",\"news_section\":{\"title\":\"最新动态\"},\"news_title\":\"新闻动态\",\"product\":\"产品\",\"product_aminer_desc\":\"面向全球用户提供最新的GLM模型免费在线体验，为用户提供高效便捷的编程、写作与演示文稿功能\",\"product_auto_glm_desc\":\"AI 不止对话，触控执行解放双手。AutoGLM 是一款Agent 智能体产品，它能通过远程操作云设备，自动完成移动端 App 操作、跨 APP 交互及网页任务执行等操作，可以帮助用户更智慧便捷完成各种任务\",\"product_chatglm_title\":\"智谱清言\",\"product_autotyper_title\":\"智谱AI输入法\",\"product_zlearn_title\":\"智谱学习中心\",\"product_zread_desc\":\"让代码的价值，被更高效地挖掘与传递\",\"product_dongdongzoo_desc\":\"全球首个多模态娱乐社交产品，融合了人工智能、图像识别与情感化交互技术，开创“拍照即生命”的全新互动体验。在这里，每一次点击快门，都可能唤醒一个独一无二的AI生命\",\"product_dongdongzoo_title\":\"动动动物圈\",\"product_section\":{\"subtitle\":\"用可信赖 AI 让生活更美好\",\"title\":\"原生产品\"},\"product_zai_desc\":\"面向全球用户提供最新的GLM模型免费在线体验，为用户提供高效便捷的编程、写作与演示文稿功能\",\"product_zhipu_qingyan_desc\":\"快、准、能思考的AI效率工具。用户量超3000万，活跃智能体80万个。搭载最新的GLM大模型，响应更快、思考更深，联合海淀名师打造行业领先的 AI 学习助手\",\"product_autoclaw_title\":\"AutoClaw\",\"product_autoclaw_desc\":\"只需1分钟，给每台电脑装上小龙虾\",\"search_info\":\"Search info\",\"site_title\":\"智谱AI\",\"speech_recognition_not_supported\":\"您的浏览器不支持语音识别功能\",\"speech_recognition_not_supported_desc\":\"请使用 Chrome、Edge 或其他支持 Web Speech API 的浏览器\",\"timeline_2019_03\":\"智谱成立， 源自清华计算机系知识工程实验室 (KEG) \",\"timeline_2021_03\":\"发布自研预训练框架 GLM, 打破BERT/GPT 瓶颈\",\"timeline_2022_09\":\"中国第一个开源的千亿基座模型GLM-130B \",\"timeline_2023_03\":\"中国第一个千亿对话基座模型ChatGLM\",\"timeline_2024_01\":\"发布新一代基座大模型 GLM-4，国内率先对标GPT4\",\"timeline_2024_08\":\"对齐文本/图像/视频/声音的多模型模型VideoCall\",\"timeline_2024_10\":\"发布手机智能体AutoGLM\",\"timeline_2024_12\":\"发布并上线推理模型GLM-Zero Preview\",\"timeline_2025_03\":\"发布沉思模型, 集合操作能力AutoGLM沉思\",\"timeline_2025_07\":\"发布面向推理、代码与智能体的开源SOTA模型 GLM-4.5\",\"timeline_2025_10\":\"智谱最新旗舰 GLM-4.6，代码能力全面对齐 Claude Sonnet 4，更好支持复杂长线任务，综合能力达全球开源模型 SOTA\",\"timeline_2025_12\":\"智谱发布新一代旗舰模型 GLM-4.7，Coding 能力卓越，被诸多编程工具选择为内置模型\",\"timeline_title\":\"发展历程\",\"detail_text\":\"详情\",\"nav_api\":{\"bigmodel\":{\"title\":\"Bigmodel\",\"description\":\"智谱GLM大模型应用平台，五百强企业和百万开发者都在用\"}},\"chat_section\":{\"brainstorming\":\"头脑风暴\",\"brainstorming_template\":[{\"description\":\"帮我为一个 AI 应用构思三个产品方向，并拆成可执行的开发任务。\"},{\"description\":\"分析现有项目，设计一个适合新用户的首页和引导流程。\"},{\"description\":\"为我的个人作品集设计三种视觉方案，并列出实现步骤。\"}],\"logical_reasoning\":\"逻辑推理\",\"logical_reasoning_template\":[{\"description\":\"检查这段代码中的边界条件，找出潜在问题并说明修复思路。\"},{\"description\":\"分析这个报错的调用链，定位根因并验证修复结果。\"},{\"description\":\"比较两种技术方案，结合项目约束给出选择建议。\"}],\"information_qa\":\"信息问答\",\"information_qa_template\":[{\"description\":\"阅读当前代码库，解释目录结构和核心模块之间的关系。\"},{\"description\":\"帮我找到登录流程的入口，说明请求如何到达后端。\"},{\"description\":\"根据项目代码整理一份新同事可以快速上手的说明。\"}],\"content_creation\":\"内容创作\",\"content_creation_template\":[{\"description\":\"根据最近的代码变更，整理清晰的发布说明和使用示例。\"},{\"description\":\"为这个项目完善 README，补充安装、运行和部署步骤。\"},{\"description\":\"把产品想法整理成需求文档、页面文案和开发清单。\"}],\"creative_development\":\"创意开发\",\"creative_development_template\":[{\"description\":\"制作一个适配手机与电脑的个人作品集网站。\"},{\"description\":\"开发一个可筛选、搜索和导出数据的任务看板。\"},{\"description\":\"把我的设计稿实现为网页，并检查交互和响应式布局。\"}]},\"contact_error_name\":\"请输入您的姓名\",\"contact_error_mobile\":\"请输入您的手机号\",\"contact_error_company\":\"请输入公司名称\",\"contact_error_business\":\"请选择业务类型\",\"contact_error_invalid_mobile\":\"请输入有效的手机号码\",\"contact_qrcode_title\":\"提交成功! 🎉\",\"contact_qrcode_description\":\"您已提交，我们会尽快与您联系，邀请您添加企微客服，以便向您同步最新进展\",\"contact_qrcode_tip\":\"扫一扫添加智谱企微客服\",\"go_back\":\"返回首页\",\"back_button\":\"返回\",\"research\":{\"title\":\"研究\",\"description\":\"关于 GLM 大模型家族\",\"tag\":{\"all\":\"全部\",\"base_model\":\"基座模型\",\"mutimodal_model\":\"多模态\",\"reasoning_model\":\"推理模型\",\"agent_model\":\"Agent\",\"code_model\":\"代码模型\"},\"time_sort\":\"时间排序\",\"load_more\":\"加载更多\"},\"article\":{\"try_now\":\"立即体验\",\"get_api\":\"获取API\"},\"zcode_promo\":{\"model_badge\":\"GLM-5.3 官方 Harness，多智能体开发更进一步\",\"title\":\"ZCode\",\"description\":\"简单、迅捷、氛围十足！\",\"product_description\":\"与 GLM-5.3 深度联调，优化推理与工具调用。开箱即用，支持 BYOK，同等额度更高效。\"}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$L12\"}]\n"])</script><script>self.__next_f.push([1,"6:[\"$\",\"div\",null,{\"className\":\"flex min-h-screen flex-col items-center gap-[120px] bg-white pb-20\",\"children\":[\"$\",\"$L13\",null,{\"blogsItems\":[{\"id\":163,\"title_zh\":\"GLM-5.3-Flash：前沿智能进入普惠时代\",\"title_en\":null,\"createAt\":\"2026-08-26T14:00:00.000Z\",\"category\":\"blog\",\"resume_zh\":null,\"resume_en\":null,\"contentType_zh\":\"content\",\"externalUrl_zh\":null,\"content_zh\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"今天，我们上线并开源GLM-5.3-Flash (320B-A18B)，这是GLM-5系列的首个\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"原生多模态模型\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"大家好像已经习惯将前沿智能与前沿价格绑定，并认为这是技术进步必须支付的成本。今天，GLM-5.3-Flash来了：320B总参数，能力超过GLM-5.2，在全球权威的Artificial Analysis Intelligence Index（AA综合智能指数）中取得\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"57分\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"，进入全球前沿模型能力区间，与Anthropic最受欢迎的模型Claude Opus 4.8得分持平。在自研Z.ai Code Bench体感评估中，其编程表现与Claude Opus 4.8相当。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"center\",\"indent\":0,\"version\":1,\"children\":[{\"id\":\"6a8fdbbba0aa0255ed5ad2ce\",\"type\":\"upload\",\"value\":{\"id\":1064,\"alt\":\" \",\"updatedAt\":\"2026-08-27T06:39:55.515Z\",\"createdAt\":\"2026-08-27T06:39:55.515Z\",\"url\":\"/api/media/file/code%3DZmE4MWRjODMzMmVhNWMxZWY4YjExY2Q0OGI3MGIwOThfNms4WFg4bHJpcktmY1Vqb1NVYllxMnB2SmVidTVTUlNfVG9rZW46WmQ4dGJhVEEzb2prRXh4ZGtWV2M4WnJGbnBkXzE3ODc4MTI3ODQ6MTc4NzgxNjM4NF9WNA%26add_watermark%3Dtrue%26scene_type%3DCCM\",\"thumbnailURL\":null,\"filename\":\"code=ZmE4MWRjODMzMmVhNWMxZWY4YjExY2Q0OGI3MGIwOThfNms4WFg4bHJpcktmY1Vqb1NVYllxMnB2SmVidTVTUlNfVG9rZW46WmQ4dGJhVEEzb2prRXh4ZGtWV2M4WnJGbnBkXzE3ODc4MTI3ODQ6MTc4NzgxNjM4NF9WNA\u0026add_watermark=true\u0026scene_type=CCM\",\"mimeType\":\"image/png\",\"filesize\":1312650,\"width\":4239,\"height\":2643,\"focalX\":50,\"focalY\":50},\"fields\":{},\"format\":\"\",\"version\":3,\"relationTo\":\"media\"}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"与此同时，GLM-5.3-Flash定价为1/10的GLM-5.3，限时折扣内为1/20的GLM-5.3，为Opus 4.8的1/40。同样智力，1/40价格，前沿智能，第一次不需要省着用。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"id\":\"6a8fdbe3a0aa0255ed5ad2d0\",\"type\":\"upload\",\"value\":{\"id\":1066,\"alt\":\" \",\"updatedAt\":\"2026-08-27T06:40:36.103Z\",\"createdAt\":\"2026-08-27T06:40:36.103Z\",\"url\":\"/api/media/file/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20260826213649_167_40.png\",\"thumbnailURL\":null,\"filename\":\"微信图片_20260826213649_167_40.png\",\"mimeType\":\"image/png\",\"filesize\":1047768,\"width\":4640,\"height\":3092,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"为收集广大用户的广泛、专业反馈，我们在正式发布前，以匿名模型\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Ox-Alpha\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"（中文社区称作牛来）在OpenCode和OpenRouter上进行了大规模测试。Ox-Alpha迅速成为当周最受欢迎的模型，创下双平台调用量新高。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"而这些请求流量全部由国产芯片提供算力支持。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.3-Flash在各项基准测试和实际使用中，全面超越参数量高出一倍的GLM-5.2，定价却仅为后者的1/10。这得益于其全新模型架构。GLM-5.3-Flash的架构专为极低成本而设计，总参数量与GLM-4.5相当（355B vs. 320B），但激活参数量（32B → 18B）与层数（92 → 45）几乎减半。结合我们最新的30T Token多模态预训练语料，GLM-5.3-Flash能够以更少的计算资源实现更强的性能。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.3-Flash同时进行了多项架构升级，是首个采用稀疏注意力与线性注意力混合架构的开源前沿模型，在保持精准长上下文能力的同时，大幅降低长上下文服务成本；并采用流形约束超连接（Manifold-Constrained Hyper-Connections，mHC）提升模型Scaling能力。具体技术细节见Blog：https://z.ai/blog/glm-5.3-flash。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"极致低成本架构\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"为降低模型长上下文场景下的注意力成本，我们采用线性注意力与稀疏注意力相结合的混合架构。其中，线性注意力通过递归机制捕获局部依赖关系，稀疏注意力则借助轻量级索引器召回全局上下文。我们引入IndexPool为进一步降低1M上下文下索引器的时延与内存开销，通过加权池化将索引器的4个缓存向量压缩为1个。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"为展示架构效率，我们将GLM-5.3-Flash与GLM-5.3、DeepSeek-V4-Flash和Kimi-K3进行对比，重点考察单Token计算量和KV缓存大小。为公平比较不同规模的模型，我们分别展示每个Head、每层注意力计算量，以及每层平均KV缓存大小（BF16）。相较于GLM-5.3，GLM-5.3-Flash的注意力计算量与KV缓存大小分别降低了3.01倍和4.44倍。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"center\",\"indent\":0,\"version\":1,\"children\":[{\"id\":\"6a8fdbc0a0aa0255ed5ad2cf\",\"type\":\"upload\",\"value\":{\"id\":1065,\"alt\":\" \",\"updatedAt\":\"2026-08-27T06:40:00.891Z\",\"createdAt\":\"2026-08-27T06:40:00.891Z\",\"url\":\"/api/media/file/code%3DZDQ2ZWE0ZjMyMzZjODdlNTc4MDY0ZGRmNzNmNmY5NTlfSm9CbzF5d1FWZUd6UFRlRU5wdXp1RjFudGo0RUxNMkVfVG9rZW46VlBBZmJKWVdib0JUTTF4NWdUN2Nlc2NYblpmXzE3ODc4MTI3ODQ6MTc4NzgxNjM4NF9WNA%26add_watermark%3Dtrue%26scene_type%3DCCM\",\"thumbnailURL\":null,\"filename\":\"code=ZDQ2ZWE0ZjMyMzZjODdlNTc4MDY0ZGRmNzNmNmY5NTlfSm9CbzF5d1FWZUd6UFRlRU5wdXp1RjFudGo0RUxNMkVfVG9rZW46VlBBZmJKWVdib0JUTTF4NWdUN2Nlc2NYblpmXzE3ODc4MTI3ODQ6MTc4NzgxNjM4NF9WNA\u0026add_watermark=true\u0026scene_type=CCM\",\"mimeType\":\"image/png\",\"filesize\":409302,\"width\":4200,\"height\":2233,\"focalX\":50,\"focalY\":50},\"fields\":{},\"format\":\"\",\"version\":3,\"relationTo\":\"media\"}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在所有基线模型中，GLM-5.3-Flash的注意力计算量最低。不过其KV缓存大小仍略高于Kimi-K3和DeepSeek-V4-Flash，这也是我们在后续工作中进一步优化的方向。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"代码循环中的视觉反馈\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.3-Flash是GLM-5系列的首个原生多模态模型。视觉编码（Visual Coding）并不只是处理图像，它拓展编程所能触及的边界。对于前端开发、游戏开发、3D仿真等任务而言，最终产物包括用户能够感知的界面、交互或虚拟世界，视觉能力被原生集成进模型中，使其能够自主判断何时需要“观察”，并利用视觉反馈来指导下一步行动。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们针对视觉编码开发了数据合成流水线，重点聚焦于模型的\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"自我视觉判断\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"与\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"测试时改进\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"。最终生成的轨迹要求模型与环境交互、检视自身输出，并进行迭代式改进。在前端Coding方面，我们还探索基于环境反馈的强化学习，并通过基于真实用户流程的Agent验证，进一步强化GUI判断能力。这将验证的范畴从功能正确性延伸至渲染效果与交互体验层面。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"令人意外的是，Coding为模型提供了一种表达并检验其世界知识的代理。在Blender中构建一个连贯的场景，需要将几何、材质、光照与空间等知识转化为一个在不同视角下都保持一致的3D结构。在没有任何外部素材的情况下，GLM-5.3-Flash自主运行16个小时搭建了一套约400平方米的专业主厨自宅与测试厨房。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a8fdd2aa0aa0255ed5ad2d1\",\"type\":\"upload\",\"value\":{\"id\":1067,\"alt\":\" \",\"updatedAt\":\"2026-08-27T06:46:02.346Z\",\"createdAt\":\"2026-08-27T06:46:02.346Z\",\"url\":\"/api/media/file/%E5%8E%A8%E6%88%BF%20(1).mp4\",\"thumbnailURL\":null,\"filename\":\"厨房 (1).mp4\",\"mimeType\":\"video/mp4\",\"filesize\":94187543,\"width\":null,\"height\":null,\"focalX\":null,\"focalY\":null},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"ZCode\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"中，Browser Use Agent（BUA）与Computer Use Agent（CUA）进一步拓展多模态能力，使模型能够在代码、浏览器与图形界面之间协同工作，同时\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"观察并验证自身的输出结果\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"——许多问题只有在渲染、交互或试玩过程中才会暴露出来。以下是在ZCode中使用GLM-5.3-Flash实测合集：从图像到可运行工程，从两小时电影到8分钟成片，以及可直接交付的白领专业文档。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a8fdd93a0aa0255ed5ad2d2\",\"type\":\"upload\",\"value\":{\"id\":1068,\"alt\":\" \",\"updatedAt\":\"2026-08-27T06:47:47.727Z\",\"createdAt\":\"2026-08-27T06:47:47.727Z\",\"url\":\"/api/media/file/%E6%99%BA%E8%B0%B15.3Flash-%E4%B8%AD%E6%96%87.mp4\",\"thumbnailURL\":null,\"filename\":\"智谱5.3Flash-中文.mp4\",\"mimeType\":\"video/mp4\",\"filesize\":80241957,\"width\":null,\"height\":null,\"focalX\":null,\"focalY\":null},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"超越Coding的工作伙伴\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.3-Flash在专业工作中的表现相较同级别模型显著提升。针对PPTX、PDF、DOCX和XLSX等Office与文档类任务，新增的视觉理解能力使模型能够检查并优化自身输出，并具备更强的审美判断。模型还可以将自己的输出结果与视觉上下文以及预期的结果进行对比，从而实现更有效的\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"自我验证和优化\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"——包括更准确的呈现质量评估以及审美判断。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"我们专门针对金融、法律等专业工作进行优化。在金融方面，GLM-5.3-Flash可以覆盖从基于来源的金融研究、报告生成到金融建模与分析的完整流程，在整个过程中提供可追溯的参考依据。在法律方面可以审查合同中的费用、账户与责任条款，并按律师惯例批注留痕。它也能起草律师函、合同与诉讼文书，格式与版式符合实务规范，生成即可交付。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"center\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a8fddf4a0aa0255ed5ad2d3\",\"type\":\"upload\",\"value\":{\"id\":1069,\"alt\":\" \",\"updatedAt\":\"2026-08-27T06:49:24.230Z\",\"createdAt\":\"2026-08-27T06:49:24.230Z\",\"url\":\"/api/media/file/%E7%A0%94%E6%8A%A5%E5%BD%95%E5%B1%8F.mp4\",\"thumbnailURL\":null,\"filename\":\"研报录屏.mp4\",\"mimeType\":\"video/mp4\",\"filesize\":19780531,\"width\":null,\"height\":null,\"focalX\":null,\"focalY\":null},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"金融研报·业绩点评\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a8fde15a0aa0255ed5ad2d4\",\"type\":\"upload\",\"value\":{\"id\":1070,\"alt\":\" \",\"updatedAt\":\"2026-08-27T06:49:57.762Z\",\"createdAt\":\"2026-08-27T06:49:57.762Z\",\"url\":\"/api/media/file/111%20(1).mp4\",\"thumbnailURL\":null,\"filename\":\"111 (1).mp4\",\"mimeType\":\"video/mp4\",\"filesize\":2862260,\"width\":null,\"height\":null,\"focalX\":null,\"focalY\":null},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"法律文书·合同批注修订\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"跑在国产芯片上\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"过去一周，我们首次在大规模流量中尝试用\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"大国产芯片集群\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"提供服务，这些芯片通过自研高带宽互联网络连接。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"为克服单张芯片算力与内存容量相对有限的问题，我们在SGLang 基础上构建了专用的推理引擎。值得一提的是，整个构建工作由GLM-5.3驱动的infra agent 大大加速，它协助工程师开发与优化算子、诊断性能瓶颈、改进部署服务栈，形成了“模型优化系统，系统承载模型”的正向循环。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"这些芯片主要瓶颈在于内存容量与带宽，尤其是支持长达1M上下文长度很有挑战。这要求我们针对底层架构进行激进的内存优化，包括以算力换带宽、以通信换显存等定制优化。我们的技术栈结合了用于线性注意力和LM head的节点内张量并行、ReplaySSM、W8A8量化、INT8/FP8/BF16混合缓存量化，以及Layer Split等技术。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在集群层面，我们采用生产级Encode–Prefill–Decode（EPD）分离式架构，将多模态编码、prompt预填充和逐token解码拆分为可独立调度、独立扩缩容的工作池，从而在国产加速芯片上实现了高效、可靠的服务。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"与同一硬件上的初始基线相比，端到端服务性能提升了3倍，硬件效率和单token成本已达到与主流英伟达GPU相当的水平。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"这证明国产芯片完全可以在大规模场景下高效、经济地支撑前沿模型的推理需求。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"现在，GLM-5.3-Flash\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"正式面向全球开源\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"，已接入ZCode等编码平台，并纳入GLM Coding Plan（每天限量发放10,000张体验卡），同步开放API调用。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"1.官方API接入\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"BigModel开放平台：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a8fdbb5a0aa0255ed5ad2cc\",\"type\":\"link\",\"fields\":{\"url\":\"https://docs.bigmodel.cn/cn/guide/models/vlm/glm-5.3-flash\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://docs.bigmodel.cn/cn/guide/models/vlm/glm-5.3-flash\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Z.ai：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a8fdbb5a0aa0255ed5ad2cd\",\"type\":\"link\",\"fields\":{\"url\":\"https://docs.z.ai/guides/vlm/glm-5.3-flash\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://docs.z.ai/guides/vlm/glm-5.3-flash\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM Coding Plan：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a8fde41a0aa0255ed5ad2d5\",\"type\":\"link\",\"fields\":{\"url\":\"https://bigmodel.cn/glm-coding\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://bigmodel.cn/glm-coding\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"2.在线体验\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Z.ai：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a8fde53a0aa0255ed5ad2d6\",\"type\":\"link\",\"fields\":{\"url\":\"https://chat.z.ai\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://chat.z.ai\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"智谱清言App：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a8fde5ba0aa0255ed5ad2d7\",\"type\":\"link\",\"fields\":{\"url\":\"https://chatglm.cn\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://chatglm.cn\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"3.Agent\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"ZCode（代码工具）：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a8fde66a0aa0255ed5ad2d8\",\"type\":\"link\",\"fields\":{\"url\":\"https://zcode.z.ai/cn\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://zcode.z.ai/cn\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"AutoClaw（办公场景）：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a8fde6da0aa0255ed5ad2d9\",\"type\":\"link\",\"fields\":{\"url\":\"https://autoclaw.zhipuai.cn\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://autoclaw.zhipuai.cn\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"4.Blog\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"id\":\"6a8fde77a0aa0255ed5ad2da\",\"type\":\"link\",\"fields\":{\"url\":\"https://z.ai/blog/glm-5.3-flash\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://z.ai/blog/glm-5.3-flash\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"5.开源链接\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"id\":\"6a8fde7ca0aa0255ed5ad2db\",\"type\":\"link\",\"fields\":{\"url\":\"https://huggingface.co/zai-org/GLM-5.3-Flash\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://huggingface.co/zai-org/GLM-5.3-Flash\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"left\",\"indent\":0,\"version\":1,\"children\":[{\"id\":\"6a8fde86a0aa0255ed5ad2dc\",\"type\":\"link\",\"fields\":{\"url\":\"https://huggingface.co/zai-org/GLM-5.3-Flash-BF16\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://huggingface.co/zai-org/GLM-5.3-Flash-BF16\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null}],\"direction\":null,\"textFormat\":1}},\"contentType_en\":\"external\",\"externalUrl_en\":\"https://z.ai/blog/glm-5.3-flash\",\"content_en\":null,\"featured\":false,\"thumbnail_zh\":\"\",\"thumbnail_en\":\"\",\"active\":true,\"order\":0,\"tag_zh\":[\"基座模型\"],\"tag_en\":[\"Base Model\"],\"apiConfig_zh\":null,\"apiConfig_en\":null,\"experienceUrl_zh\":null,\"experienceUrl_en\":null,\"updatedAt\":\"2026-08-27T06:55:51.034Z\",\"createdAt\":\"2026-08-27T06:52:47.287Z\"},{\"id\":162,\"title_zh\":\"GLM-5.3：前沿编程能力与涌现的网络安全能力\",\"title_en\":\"GLM-5.3: Frontier Coding with Emergent Cyber Capabilities\",\"createAt\":\"2026-08-14T06:00:00.000Z\",\"category\":\"blog\",\"resume_zh\":null,\"resume_en\":null,\"contentType_zh\":\"content\",\"externalUrl_zh\":null,\"content_zh\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"今天我们发布GLM-5.3，与GLM-5.2相比，基座模型没变，但通过极致的后训练Scaling大大提高了模型的智能上界：数十倍的长程任务环境、更丰富多样的环境类型、超长的后训练时间。我们发现充分的模型后训练涌现出超出预期的模型能力。相比前代，GLM-5.3的新能力包括：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"更强的编程能力\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"。GLM-5.3是编程能力最强的开源模型，在内部自建体感评测中较GLM-5.2\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"提升50%\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"，在包括Terminal Bench 3.0、Agents' Last Exam (CLI)在内的公开基准测试中取得开源第一。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"listitem\",\"value\":2,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"网络安全能力\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"。在白盒代码审查与漏洞发现等安全任务中，GLM-5.3的表现持平Mythos 5，展现出面向网络安全防御场景的强大潜力。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"listitem\",\"value\":3,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"后训练Scaling\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"。上述全部提升都来自后训练。基于IndexShare、SAO、以及持续演进的新一代Slime框架，我们在与GLM-5.2完全相同基座上高效推进强化学习，可能我们还远未开发出这个基座的智能上界。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"listitem\",\"value\":4,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"开源\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"。我们将在发布两周后开放模型权重，此前完成安全评估与模型加固。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textFormat\":1}],\"listType\":\"bullet\",\"direction\":null,\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"即日起上线智谱官方编程工具ZCode、效率工具AutoClaw，上线GLM Coding Plan全量用户及开放订阅。TraeWork/TraeCode/扣子、WorkBuddy/CodeBuddy、Qoder/QwenWork、CatPaw、JoyCode、OpenCode等编码平台开放抢先体验。API很快上线，完整模型权重将在两周内开源，此前需完成必要的安全加固，尽可能限制其潜在攻击能力，保留其防御价值。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"今天13:00，GLM Coding Plan全员额度重置，所有用户后台「用量统计」可见使用额度回满。技术Blog：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a826923e14fd9adcae72f39\",\"type\":\"link\",\"fields\":{\"url\":\"https://z.ai/blog/glm-5.3https://\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://z.ai/blog/glm-5.3\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\"。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"强大的编程\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在多项主流基准测试中GLM-5.3是当前排名最高的开源模型，编程与智能体能力接近Claude Fable 5，编程体感超过其他国产模型。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在衡量模型于真实终端环境中完成复杂任务的Terminal-Bench 3.0上，GLM-5.3得分从4.6提升至\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"28.3\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"；在聚焦长程软件工程与持续代码修改能力的DeepSWE v1.1上，得分从46.2提升至\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"66.9\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"；在覆盖多类真实专业场景、强调跨工具协作与长程任务的Agents' Last Exam上，得分从23.8提升至\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"28.5\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"。在覆盖44种职业、考察真实高价值知识工作的GDPval-AA v2中得分\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"1769\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"，展现基于编程能力涌现的专业任务执行能力。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"整体来看，GLM-5.3在复杂软件工程、终端操作和更广泛的真实世界 Agent任务上均取得非常显著的进步。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a8268cae14fd9adcae72f35\",\"type\":\"upload\",\"value\":{\"id\":1059,\"alt\":\" \",\"updatedAt\":\"2026-08-17T01:50:05.308Z\",\"createdAt\":\"2026-08-17T01:50:05.307Z\",\"url\":\"/api/media/file/1-1.png\",\"thumbnailURL\":null,\"filename\":\"1-1.png\",\"mimeType\":\"image/png\",\"filesize\":1219456,\"width\":4239,\"height\":2504,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"自研的Z.ai Code Bench评估模型在真实编程场景中的综合体感。模型会被置于复杂的本地开发环境，并在不同思考档位下执行端到端任务，更接近开发者实际使用Coding Agent时的体验。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"测试结果显示，GLM-5.3在效果和Token利用率之间取得了更好的平衡。在High档位下，GLM-5.3达到31.4%的准确率，超过Claude Opus 4.8最高档位的29.5%，每项任务平均输出约5万tokens，而Opus 4.8需要约12万tokens，意味着\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"GLM-5.3可以用更短的执行路径完成任务。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"id\":\"6a8268e2e14fd9adcae72f36\",\"type\":\"upload\",\"value\":{\"id\":1060,\"alt\":\" \",\"updatedAt\":\"2026-08-17T01:50:28.850Z\",\"createdAt\":\"2026-08-17T01:50:28.850Z\",\"url\":\"/api/media/file/2-2.png\",\"thumbnailURL\":null,\"filename\":\"2-2.png\",\"mimeType\":\"image/png\",\"filesize\":224248,\"width\":3295,\"height\":2345,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.3训练过程中，我们不只让模型完成编程题，而是把训练环境扩展到更接近真实专家工作的完整流程，有些任务的工作量相当于一位工程师连续数天的工作。以机器学习优化任务为例，模型使用与算法工程师相同的计算集群、存储系统、内部文档、代码库和实验结果，端到端实现可量化的提速。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在这样的环境中训练，模型学到的不只是单向执行指令，而是从发现问题开始，推进分析、实施验证，最终独立完成工作。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"涌现的网络安全能力\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在任务环境不断扩张的过程中，我们观察到模型在网络安全领域的表现超出预期。安全能力的出现并不偶然，安全工作本质上是约束严格的编程能力。我们从2025年9月开始在这个方向投入研究，在GLM-5.2与GLM-5.3的研发过程中，与国内多家头部安全实验室一同推进更多长程任务环境，构建更专业化的评测与执行框架（harness）。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"从任务链条看，网络安全能力大致包括代码审查、漏洞验证、漏洞利用以及真实环境中的攻防闭环。我们选取了覆盖漏洞分析、验证和利用不同阶段的三个基准，对GLM-5.3的网络安全能力进行了全面评估，GLM-5.3当前优势主要集中在前半段。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在CyberGym测试中，模型从白盒源代码出发，通过触发程序故障来识别和验证漏洞。GLM-5.3得分为84.5%，高于GLM-5.2的77.2%，也略高于Mythos 5的83.8%和GPT-5.6 Sol的83.6%。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在更考验深度推理能力的ExploitBench中，模型需要进一步理解真实漏洞的成因，并完成相应的利用。GLM-5.3得分为54.4%，是GLM-5.2（24.4%）的两倍多，但仍低于Mythos 5的78.0%和GPT-5.6 Sol的76.5%。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"ExploitGym考察模型在限定时间内能够完成多少漏洞利用任务，按吞吐量对预算进行归一化后，GLM-5.3在两小时内完成105项任务，六小时内完成130项，相对于GLM-5.2分别完成29项和39项提升巨大。Mythos 5仍然领先，两个时间段分别完成181项和247项。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a826a84e14fd9adcae72f43\",\"type\":\"upload\",\"value\":{\"id\":1061,\"alt\":\" \",\"updatedAt\":\"2026-08-17T01:50:47.186Z\",\"createdAt\":\"2026-08-17T01:50:47.185Z\",\"url\":\"/api/media/file/3-2.png\",\"thumbnailURL\":null,\"filename\":\"3-2.png\",\"mimeType\":\"image/png\",\"filesize\":569345,\"width\":4239,\"height\":1548,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"三个基准呈现出相同的趋势：越接近漏洞利用链的前端，GLM-5.3相较GLM-5.2的提升越明显；越深入完整利用，模型与Mythos 5等闭源前沿模型之间的差距也越大。换句话说，GLM-5.3进步最快的方向，正是当前仍需要重点追赶的方向。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"1.安全评估成果\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"从GLM-5.2发布以来，我们联合国内清华大学、南开大学，以及云起无垠、绿盟科技、赛博昆仑、DARKNAVY、华顺信安、奇安信、安恒信息、元序星核、腾讯玄武、云鼎实验室等多家安全团队，开展了密集的红队测试与安全评估。累计发现漏洞2,436个（经过初筛、去重），其中1,097个为中高危，许多漏洞多年来甚至几十年都未被发现，最早可追溯至约45年前。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"代表性漏洞覆盖系统内核、操作系统、浏览器引擎、开源基础组件、互联网应用与互联网协议等269个项目，部分漏洞的威胁甚至可以让Android、Windows、macOS以及某国民级通信软件出现大范围崩溃。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"这些发现已发展成为一项持续的漏洞发现和披露工作。相关漏洞已陆续提交CNNVD/CNVD等国家漏洞库。为提高披露过程的透明度，我们建立了Z.ai安全披露账本https://cvd.z.ai/，记录漏洞从发现、确认到修复的进展。账本将持续更新，为了确保负责任的安全披露，我们仅公开已经经过披露和厂商修复的漏洞，对于那些仍处于协调披露阶段的漏洞，我们会展示漏洞的哈希值以供后续核验。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a826914e14fd9adcae72f38\",\"type\":\"upload\",\"value\":{\"id\":1062,\"alt\":\" \",\"updatedAt\":\"2026-08-17T01:51:18.444Z\",\"createdAt\":\"2026-08-17T01:51:18.444Z\",\"url\":\"/api/media/file/image%20(4).png\",\"thumbnailURL\":null,\"filename\":\"image (4).png\",\"mimeType\":\"image/png\",\"filesize\":3758274,\"width\":9008,\"height\":5692,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"参考Zerodium、Crowdfense、Apple Security Bounty、Pwn2Own等全球漏洞交易与赏金市场公开报价，这些漏洞创造的经济价值达3000万元。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"2.抱抱脸的故事——网络安全能力必须更加开放\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Hugging Face官方披露事件给出的警示：如果强大的攻击能力正在扩散，防守能力就不能只在少数闭源模型公司。闭源模式将前沿安全能力异化为少数机构的特权，Anthropic向约150家大型机构提供Mythos模型及安全服务，更广泛的企业和开源项目则难以获得同等水平的安全能力支持，甚至会在遭遇攻击、最需要帮助的时候，被闭源模型拒之门外。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"没有开源反而是这个时代最不安全的事情。随着GLM-5.3的发布与开源，我们将同步启动“开源的盾”计划：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"1.对重点开源项目开展持续安全审计，帮助维护者免费发现和修复风险（\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a8269b6e14fd9adcae72f3a\",\"type\":\"link\",\"fields\":{\"url\":\"https%25252525253A%25252525252F%25252525252Fhttps%25252525253A%25252525252F%25252525252Fhuggingface.co%25252525252Fspaces%25252525252Fzai-org%25252525252FOpenVuln\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"https://huggingface.co/spaces/zai-org/OpenVuln\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\"）\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"2.向开源社区免费提供模型额度及更加便捷的防御入口，开源项目维护者可以申请用于安全审计和防御任务\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"3.在ZCode中提供代码审计功能，让安全检查进入日常研发流程\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"当最强的矛被锁在少数人手里，最好的盾必须属于所有人。我们会持续优化GLM安全能力并坚持开源，与全球开发者、安全研究人员共同建设一套持续生长的防御体系，让前沿模型从少数机构的特权，转化为服务开源社区的安全公共品。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"3.一个小插曲：追凶neo\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"2026年7月，一台位于巴西的临时文件服务器进入Ferret的监测范围。Ferret是GLM-5.3首批合作伙伴FOFA的追踪分析引擎。GLM-5.3很快发现，这并不是一台普通服务器，目录中出现了大量攻击基础设施信息。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"继续分析后，一个名为“Neo”的AI Agent浮出水面，其目标是攻击A国的会计师事务所、税务服务公司和记账机构。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Neo获得了很高的系统权限。不到两个月，它管理着4台服务器、7个域名、6万个邮箱和100多个脚本，发出18567封钓鱼邮件。面对数千个开放目录、数万份日志和高度碎片化的攻击线索，仅靠人工几乎不可能发现其中的关联。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.3迅速提取关键线索，关联攻击，并辅助安全研究人员还原出整条攻击链：攻击者如何搜集A国会计行业目标，搭建邮件系统，直至伪装成企业客户和行业机构，准备后续恶意文件，最终有效帮助Ferret捕获该攻击。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"这与此前Hugging Face安全事件形成了呼应。在Hugging Face事件中，前沿模型逃逸发起攻击，GLM-5.2被部署到本地帮助完成取证；在这次事件中，Agent为攻击方工作，GLM-5.3又帮助防守方从证据中还原攻击链。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"同样是模型，站在哪一边，取决于掌握它的人与目的。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h3\",\"type\":\"heading\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"4.最好的安全，是事故最终没有发生\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"潜在风险离我们并不遥远。从一条消息、一封邮件，到互联网的底层协议、机器人，数字世界的安全边界早已连接着个人设备、企业网络、互联网基础设施甚至是真实世界，影响着我们每一个人。GLM-5.3作为“开源之盾”的意义，就是要帮助更多安全团队抢在攻击者之前发现风险，让风险在影响用户之前化解和修复。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"保护Cursor，守住开发者的工作台\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Cursor是全球数百万开发者日常使用的AI代码编辑器。在一次模型能力评估中，清华大学NASP实验室借助GLM-5.3，对Cursor的二进制代码、跨语言架构和权限边界展开分析，发现其Rust与Electron混合架构及权限校验逻辑中存在潜在失陷风险。攻击者可能借此实现任意文件写入，进一步窃取敏感信息，甚至接管开发环境。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"这一风险隐藏在复杂的程序逻辑中，无法通过孤立检查单个代码缺陷发现。挖掘过程中，GLM-5.3深度参与逆向分析全流程，协助安全研究人员还原程序逻辑、定位异常路径，并从大量候选路径中排除干扰，最终在授权测试环境中完成风险验证。目前，安全研究团队也已联系Cursor方面推进修复，漏洞已上报CNVD和CNNVD。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"保护国民级通讯APP，守住数亿人的设备安全\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"安全研究人员在一款拥有数亿日活用户的国民级即时通信软件中发现异常。攻击者无需诱导用户点击链接或打开文件，只需发送一条看似正常的消息，就可能在用户几乎无感知的情况下触发漏洞，进而让用户失去设备控制权。整个过程可以远程完成，且具有较强的稳定性和隐蔽性。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"该漏洞深藏于自研私有协议、内容处理逻辑与内存管理机制之中，触发条件涉及复杂状态机和极难复现的时序问题。由于缺少公开资料，安全研究人员借助GLM-5.3，从海量二进制代码中定位异常、还原逻辑，并逐步完成路径验证。最终，这场可能波及数亿用户的安全事件没有发生，风险在抵达用户之前就被发现并拦了下来。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"保护DNS基础设施，守住互联网的“导航系统”\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"DNS如同数字世界的“北斗导航系统”，一旦大面积瘫痪，全球的网站、邮件和云服务都可能因无法找到正确地址而无法运行。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"清华大学NISL实验室与云起无垠安全研究团队借助GLM模型，在诞生于1983年的DNS协议中，发现了一类潜伏40余年的关键协议级漏洞。与常见的软件漏洞不同，这次发现的是互联网底层协议规则本身存在的问题。攻击者只需发送少量特殊请求，就能将服务器的计算压力最高放大近8万倍，进而导致网站无法访问、邮件中断和云服务失效。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"根据网络测绘估算，该漏洞可能影响全球九成以上的主流DNS系统，涉及超过1000万处公网DNS服务。GLM协助安全研究人员提前发现这一底层风险，为DNS系统的修复与加固提供依据。也意味着GLM的安全能力也由软件代码审查进一步延伸至互联网基础协议，开始参与保护整个数字世界赖以运行的基础设施。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"保护邮件与办公系统，化解微软全球级安全事件\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"一次邮件预览，险些成为进入企业网络的入口。赛博昆仑借助GLM模型发现三枚微软重大漏洞，涉及全球用户每天使用的邮件与办公系统，覆盖客户端邮件预览、文档处理和服务端远程访问等多个环节。这些漏洞串联成“客户端预览即中招、服务端可被远程攻破”的攻击路径，相当于攻击者可能通过一封邮件进入用户终端，再以终端为跳板渗透企业网络，使相关产品的大量用户和部署环境面临风险。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"历史上同类漏洞曾在全球范围造成严重损失，例如在2021年的ProxyLogon事件中，大量的Exchange服务器沦陷。目前，安全研究团队已经将三大漏洞提交微软并完成修复，微软官方致谢了“Kunlun Lab\u0026GLM”，意味着一场可能波及全球用户和企业的安全事件被提前化解。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"保护真实世界，提前阻断人形机器人失控风险\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"DARKNAVY·深蓝研发的安全AI系统deepsec借助GLM模型，在一家全球顶级具身智能机器人厂商的系统中发现致命级漏洞，攻击者一旦利用该漏洞，可能同时远程劫持上千台机器人，并控制其执行恶意动作。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"面对由多套独立安全系统组成的复杂架构，deepsec将顶尖安全研究员的经验工作流与GLM模型的长程网络安全任务执行能力结合起来，从机器人的公开文档出发，完成信息收集、静态分析、漏洞挖掘和风险验证，逐步还原系统逻辑、梳理安全边界，最终定位并确认了这一关键风险。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"随着漏洞得到修复，一场可能影响真实世界的“机器人集体失控”事故被提前阻断。GLM保护的不再只是代码、终端和网络，也开始延伸到与真实世界直接互动的智能设备。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"上述漏洞均已联系厂商进行修复，已进入国家CNNVD/CNVD国家漏洞库负责任披露与协同修复流程。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a826ac6e14fd9adcae72f46\",\"type\":\"upload\",\"value\":{\"id\":1063,\"alt\":\" \",\"updatedAt\":\"2026-08-17T01:58:32.546Z\",\"createdAt\":\"2026-08-17T01:58:32.546Z\",\"url\":\"/api/media/file/%E4%B8%AD%E6%96%87%E7%89%88.mp4\",\"thumbnailURL\":null,\"filename\":\"中文版.mp4\",\"mimeType\":\"video/mp4\",\"filesize\":58440600,\"width\":null,\"height\":null,\"focalX\":null,\"focalY\":null},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"有责任的开源\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"随着模型能力提升，我们同步强化安全体系，以便先进智能能够继续广泛发挥作用，同时对最高风险用途施加更严格的审查。针对GLM-5.3，我们构建了迄今为止最稳健的风险审查系统。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.3的风险审查系统采用了分层设计，横跨外围API到模型内部，以提高准确性与冗余度，这遵循了安全防护体系中纵深防御的基本原则，即从不假设某一层防护是完美的，而让多层相互独立的防线彼此冗余，共同组成鲁棒的防护系统。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"外层分类器（classifier flag）：用轻量模型标记并拦截大规模滥用请求；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"推理监控器（reasoning monitor）：在模型推理过程中实时审查任务意图，判断是否存在潜在危害；\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"深度安全对齐：让模型从根本上自主识别并拒绝攻击性请求，这也是开源权重场景下唯一仍然有效的防线。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在设计分层审查系统时，我们还遵循了另一安全防护体系的基本原则，即风险分级。审查系统的任务是抑制高安全风险的攻击性滥用，但不牺牲实验性质、防御性质和教学性质的使用。为了达成这个目标，我们首先要让分类器、监控器和模型本身学会以意图为中心而非关键词为中心的审查方法，因为网络安全场景中攻击与防御任务在字面上高度相似，真正区分二者的是意图与语境。我们进行了针对性的差分数据合成，并对大量越狱变体和伪装方法构造了对抗性数据，确保审查系统能够高度智能地工作。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"更进一步，我们对网络安全领域的常见任务进行了分类，比如安全知识问答、蓝队防御、CTF题目、漏洞挖掘与修复、漏洞利用与攻击、渗透测试、真实入侵等，并分别对每一类别任务构造了大量阶梯型风险的实例数据，让风险审查系统能够精准拦截高风险任务请求，又不“误杀”其余合法合规、风险等级低的常规任务。模型最敏感的能力仅通过“网络安全受信访问”计划保留给经过验证的用户使用。值得一提的是，安全对齐是一个持续对抗的过程，对抗数据、风险分级实例数据的合成都不是一次性的。我们会不断进行红队自动化攻击越狱测试，并使用新产生的越狱样本不断加固审查系统。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在全面推出前，我们进行了尤为密集的安全性评估与广泛的红队测试。评估表明，系统建立了高标准的安全防护线，能够有效拦截明确的恶意攻击与高危漏洞利用滥用，同时未因安全策略过度收紧而牺牲能力，能够执行漏洞检测和修补、CTF教学等正向安全任务。在正式开源前，我们也邀请国内顶级安全团队对模型的风险任务能力进行专业评估，DARKNAVY团队评估认为，该模型在风险防护与能力释放之间取得了良好平衡，相比于前代模型显著提高了未授权恶意滥用的门槛。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"人工智能发展不应该是某个国家的独奏，而应当是全球合作的交响。随着GLM-5.3的发布及开源，安全防御能力将不再是少数机构的特权，而是全球开发者都能平等获得和共同完善的公共能力。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"justify\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"感谢与GLM-5.3并肩作战的国内安全团队。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0}],\"direction\":null}},\"contentType_en\":\"external\",\"externalUrl_en\":\"https://z.ai/blog/glm-5.3\",\"content_en\":null,\"featured\":false,\"thumbnail_zh\":\"\",\"thumbnail_en\":\"\",\"active\":true,\"order\":0,\"tag_zh\":[\"基座模型\"],\"tag_en\":[\"Base Model\"],\"apiConfig_zh\":null,\"apiConfig_en\":null,\"experienceUrl_zh\":null,\"experienceUrl_en\":null,\"updatedAt\":\"2026-08-17T01:58:46.875Z\",\"createdAt\":\"2026-08-17T01:55:24.462Z\"},{\"id\":161,\"title_zh\":\"GLM-5.2上线并开源：专注Coding与长程任务\",\"title_en\":\"GLM-5.2: Built for Long-Horizon Tasks\",\"createAt\":\"2026-06-16T16:00:00.000Z\",\"category\":\"blog\",\"resume_zh\":null,\"resume_en\":null,\"contentType_zh\":\"content\",\"externalUrl_zh\":null,\"content_zh\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"今天，我们上线并开源GLM-5.2。在Artificial Analysis综合榜单上，GLM-5.2取得51分，与Anthropic、OpenAI一起位居前三，为开源模型SOTA。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a324d2d442a1f24466ad2d9\",\"type\":\"upload\",\"value\":{\"id\":1022,\"alt\":\" \",\"updatedAt\":\"2026-06-17T07:30:53.207Z\",\"createdAt\":\"2026-06-17T07:30:53.206Z\",\"url\":\"/api/media/file/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20260617145112_654_10684.png\",\"thumbnailURL\":null,\"filename\":\"微信图片_20260617145112_654_10684.png\",\"mimeType\":\"image/png\",\"filesize\":465600,\"width\":1658,\"height\":710,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在全球百万用户参与盲测的前端开发评估系统Code Arena 上，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"GLM-5.2取得全球可用模型第一的表现。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":1},{\"id\":\"6a324d10442a1f24466ad2d8\",\"type\":\"upload\",\"value\":{\"id\":1021,\"alt\":\" \",\"updatedAt\":\"2026-06-17T07:30:24.752Z\",\"createdAt\":\"2026-06-17T07:30:24.750Z\",\"url\":\"/api/media/file/111-1.png\",\"thumbnailURL\":null,\"filename\":\"111-1.png\",\"mimeType\":\"image/png\",\"filesize\":3008579,\"width\":4088,\"height\":4088,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"从2025初开始，我们几乎投入全部力量开始攻关Coding，历时大半年，细扣每一个代码环境的优化，终于迎来我们的代码基座GLM-4.5，年底的GLM-4.7已经成为开源中效果最好的Coding模型。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"但代码还不是AGI，在通往AGI的路上，还有更多的高山需要翻越，迎面而来的就是长程任务能力（Long Horizon Task）。当下最需要模型突破的是完成一个极长的，跨越数天、数周乃至数月的规划与执行。当一个模型不知疲倦地在写软件工程代码，本质上是在学习一名顶级软件工程师的思维方式，然后以机器的耐力将其放大，这是对一个又一个职业的重新定义。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"今天GLM-5.2应运而生，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"专为长程任务能力而生\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"，全新特色包括：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Solid 1M上下文，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"稳定支撑长程任务\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"更强体感，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"更实用的Coding能力\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"极致Infra优化，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"Day 0运行在国产算力平台\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textFormat\":1},{\"type\":\"listitem\",\"value\":4,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"MIT开源协议，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"无地域限制，技术平权无国界\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textFormat\":1}],\"listType\":\"bullet\",\"direction\":null,\"textFormat\":1},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"一、1M上下文与长程任务\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"支撑长程任务，第一步是把长上下文做到工程可用，为此GLM-5.2必须实现\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"Solid 1M无损上下文\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"。此前也有很多1M上下文的实现，但大多数直接扩展使得在实际应用的过程中大打折扣，很多实际测试在数百K过后就开始劣化。主要的问题是单纯扩展到1M但是不增强更长Coding Agent数据其实对长程高价值任务帮助有限。我们花了几个月时间大大扩展了1M Coding Agent的训练环境，覆盖大规模实现、自动化研究、性能优化等多个典型领域，这使得模型的1M上下文真实表现有时候甚至能超过Opus（详见\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"id\":\"6a324ce2442a1f24466ad2ce\",\"type\":\"link\",\"fields\":{\"url\":\"https://z.ai/blog/glm-5.2\",\"newTab\":false,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"技术博客\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"mode\":\"normal\",\"text\":\"）。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"1M上下文构成GLM-5.2的长程交付能力，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"在FrontierSWE、SWE-Marathon、PostTrainBench等多个长程任务基准上，GLM-5.2的表现介于Claude Opus 4.7与4.8之间，是排名最高的开源模型。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"在FrontierSWE（一个测试AI是否能够像顶级软件工程师和研究员一样，在数小时到数十小时尺度上完成复杂技术项目的测试集）上仅比Opus 4.8低1%，超过GPT-5.5（1%）和Opus 4.7（11%）；不过在SWE-Marathon（一个考察Agent能否自主完成超长周期的软件工程工作的测试集）上确实还需要进一步提高，低于Opus 4.8不少（13%）。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a324d68442a1f24466ad2da\",\"type\":\"upload\",\"value\":{\"id\":1023,\"alt\":\" \",\"updatedAt\":\"2026-06-17T07:31:52.475Z\",\"createdAt\":\"2026-06-17T07:31:52.474Z\",\"url\":\"/api/media/file/222.PNG\",\"thumbnailURL\":null,\"filename\":\"222.PNG\",\"mimeType\":\"image/png\",\"filesize\":206973,\"width\":1280,\"height\":829,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在实际体验中，GLM-5.2自主完成开发、联调、测试到打包上线，最终交付一个覆盖Web、移动端与小程序的多端应用。这样一条完整链路累计处理88万以上的tokens，几乎用满1M上下文窗口。过去，这样的大型工程需要一支团队协作数周，GLM-5.2能在一次连续的长程任务中跑完。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a324dd8442a1f24466ad2db\",\"type\":\"upload\",\"value\":{\"id\":1024,\"alt\":\" \",\"updatedAt\":\"2026-06-17T07:33:44.115Z\",\"createdAt\":\"2026-06-17T07:33:44.114Z\",\"url\":\"/api/media/file/20260617GLM%E8%A7%86%E9%A2%91.mp4\",\"thumbnailURL\":null,\"filename\":\"20260617GLM视频.mp4\",\"mimeType\":\"video/mp4\",\"filesize\":210784510,\"width\":null,\"height\":null,\"focalX\":null,\"focalY\":null},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"二、Coding体感\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.2在前端、后端、长程任务等开发场景下的成功率相比前一代GLM-5.1都有长足提升，复杂系统工程与深度调试更稳。在主流编程基准上，GLM-5.2保持开源SOTA，\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"与Claude Opus 4.8处于可比区间。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"例如在Terminal-Bench 2.1上（评测AI Agent通过命令行操作一台计算机的数据集），GLM-5.2比Opus 4.8低4%，相比GLM-5.1提升了17.5%；在MCP-Atlas上（工具使用tool-use评测的数据集），GLM-5.2仅比Opus 4.8低0.8%。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a324e5c442a1f24466ad2dc\",\"type\":\"upload\",\"value\":{\"id\":1025,\"alt\":\" \",\"updatedAt\":\"2026-06-17T07:35:56.452Z\",\"createdAt\":\"2026-06-17T07:35:56.451Z\",\"url\":\"/api/media/file/333-3.png\",\"thumbnailURL\":null,\"filename\":\"333-3.png\",\"mimeType\":\"image/png\",\"filesize\":303171,\"width\":1280,\"height\":845,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"在模型发布前夕，我们已提前向GLM Coding Plan用户全员开放，在数十万开发者大量真实编程任务中，开发者反馈GLM-5.2的最大提升集中在：\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"ul\",\"type\":\"list\",\"start\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"listitem\",\"value\":1,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"项目级上下文承载更强，能把完整工程放进同一条推理链路里\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":2,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"长程任务执行更稳定，复杂任务能持续推进，不容易中途跑偏\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":3,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"生产级工程规范遵循更可靠，能守住团队研发流程里的硬约束\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"listitem\",\"value\":4,\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"客户端与移动端工程能力更扎实，不止写App，还能完成真机调试闭环\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null}],\"listType\":\"bullet\",\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.2还引入了effort level（思考档位）控制，可以在能力、速度、成本之间做出平衡。在相近的token预算下，GLM-5.2的Coding能力大致位于Claude Opus 4.7与Claude Opus 4.8之间。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a324e75442a1f24466ad2dd\",\"type\":\"upload\",\"value\":{\"id\":1026,\"alt\":\" \",\"updatedAt\":\"2026-06-17T07:36:21.900Z\",\"createdAt\":\"2026-06-17T07:36:21.900Z\",\"url\":\"/api/media/file/444-1.png\",\"thumbnailURL\":null,\"filename\":\"444-1.png\",\"mimeType\":\"image/png\",\"filesize\":161173,\"width\":1280,\"height\":849,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"三、极致Infra优化\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GLM-5.2的进步来自模型架构、推理系统和训练基础设施的协同设计。我们提出IndexShare，在每四层稀疏注意力层之间复用同一个索引器（indexer），在1M上下文长度下，将单位token的FLOPs降低至2.9倍。此外，我们改进了用于投机解码（speculative decoding）的 MTP 层，将接受长度（acceptance length）最多提升 20%。训练侧则依赖自研Slime框架支撑大规模Agentic RL和OPD训练。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"id\":\"6a324e92442a1f24466ad2de\",\"type\":\"upload\",\"value\":{\"id\":1027,\"alt\":\" \",\"updatedAt\":\"2026-06-17T07:36:50.231Z\",\"createdAt\":\"2026-06-17T07:36:50.231Z\",\"url\":\"/api/media/file/555.png\",\"thumbnailURL\":null,\"filename\":\"555.png\",\"mimeType\":\"image/png\",\"filesize\":207742,\"width\":1280,\"height\":705,\"focalX\":50,\"focalY\":50},\"fields\":null,\"format\":\"\",\"version\":3,\"relationTo\":\"media\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"随着GLM系列的持续迭代与调用量的快速增长，线上服务的稳定性与效率愈发关键。GLM-5.2的线上推理依托多个\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"国产算力平台\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\"，已在Day 0完成与华为昇腾、平头哥、摩尔线程、寒武纪、昆仑芯、沐曦、海光、壁仞、天数智芯等国产算力平台的推理适配，在国产芯片集群上实现高吞吐、低延迟、大并发的稳定运行。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"预计下半年昇腾 950 超节点上市后，也将成为GLM-5.2强劲的算力底座。\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1}],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"四、面向开发者与知识工作者\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":null},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[],\"direction\":null,\"textStyle\":\"\",\"textFormat\":0},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"凭借扎实的1M上下文与稳定的长程任务能力，GLM-5.2能长时间自主推进更复杂、�