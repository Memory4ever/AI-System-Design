<th id="S4.T2.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;">GPT-4o as <span id="S4.T2.2.1.1.2.1" class="ltx_text ltx_font_smallcaps">l-vlm</span></th></tr>
