<div id="A1.T9.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:134.5pt;vertical-align:-64.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-0.9pt,0.3pt) scale(0.994871750193288,0.994871750193288) ;">
