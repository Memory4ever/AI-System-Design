<td id="S4.T5.2.1.4.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.2.1.4.2.1" class="ltx_text ltx_font_bold">75.1</span></td>
<td id="S4.T5.2.1.4.3" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.2.1.4.3.1" class="ltx_text ltx_font_bold">67.2</span></td>
