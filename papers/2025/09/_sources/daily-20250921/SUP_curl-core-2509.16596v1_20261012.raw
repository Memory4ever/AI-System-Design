<td id="S3.T1.2.1.5.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m16" class="ltx_Math" style="--ltx-bg-color:#ECECEC;" alttext="\mathcal{D}_{testood-2}^{\mathcal{M}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-bg-color:#ECECEC;" class="ltx_font_mathcaligraphic" mathbackground="#ECECEC">𝒟</mi><mrow><mrow><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">s</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">o</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">o</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">d</mi></mrow><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">−</mo><mn style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">2</mn></mrow><mi style="--ltx-bg-color:#ECECEC;" class="ltx_font_mathcaligraphic" mathbackground="#ECECEC">ℳ</mi></msubsup><annotation encoding="application/x-tex">\mathcal{D}_{testood-2}^{\mathcal{M}}</annotation></semantics></math></td>
<td id="S3.T1.2.1.5.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m17" class="ltx_Math" style="--ltx-bg-color:#ECECEC;" alttext="\mathcal{D}_{testood-3}^{\mathcal{M}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-bg-color:#ECECEC;" class="ltx_font_mathcaligraphic" mathbackground="#ECECEC">𝒟</mi><mrow><mrow><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">s</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">o</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">o</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">d</mi></mrow><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">−</mo><mn style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">3</mn></mrow><mi style="--ltx-bg-color:#ECECEC;" class="ltx_font_mathcaligraphic" mathbackground="#ECECEC">ℳ</mi></msubsup><annotation encoding="application/x-tex">\mathcal{D}_{testood-3}^{\mathcal{M}}</annotation></semantics></math></td>
<td id="S3.T1.2.1.5.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m18" class="ltx_Math" style="--ltx-bg-color:#ECECEC;" alttext="\mathcal{D}_{testood-4}^{\mathcal{M}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-bg-color:#ECECEC;" class="ltx_font_mathcaligraphic" mathbackground="#ECECEC">𝒟</mi><mrow><mrow><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">s</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">o</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">o</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">d</mi></mrow><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">−</mo><mn style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">4</mn></mrow><mi style="--ltx-bg-color:#ECECEC;" class="ltx_font_mathcaligraphic" mathbackground="#ECECEC">ℳ</mi></msubsup><annotation encoding="application/x-tex">\mathcal{D}_{testood-4}^{\mathcal{M}}</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.1.6" class="ltx_tr">
