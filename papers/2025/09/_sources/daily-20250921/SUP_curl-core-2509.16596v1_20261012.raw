<figure id="A3.F6.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.16596v1/id_LLaMA-2-70B.svg" id="A3.F6.sf5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/311;" width="476" height="311"></object>
