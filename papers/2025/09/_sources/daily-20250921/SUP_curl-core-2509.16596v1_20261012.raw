<th id="A3.T6.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A3.T6.m1" class="ltx_Math" alttext="\mathbf{\mathcal{D}_{train-0}^{\mathcal{M}}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>𝐭𝐫𝐚𝐢𝐧</mi><mo>−</mo><mn>𝟎</mn></mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi></msubsup><annotation encoding="application/x-tex">\mathbf{\mathcal{D}_{train-0}^{\mathcal{M}}}</annotation></semantics></math></th>
