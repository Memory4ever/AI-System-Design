<td id="A3.T6.2.9.2" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#FFFEFE;"><span id="A3.T6.2.9.2.1" class="ltx_text" style="--ltx-bg-color:#FFFEFE;">15.16</span></td>
