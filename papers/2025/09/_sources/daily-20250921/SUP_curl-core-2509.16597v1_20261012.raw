<td id="S4.T1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">+19%</td>
<td id="S4.T1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">+12%</td>
<td id="S4.T1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">Dynamic bottleneck identification</td></tr>
<tr id="S4.T1.1.3" class="ltx_tr">
<th id="S4.T1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Latency</th>
<td id="S4.T1.1.3.2" class="ltx_td ltx_align_center">-35%</td>
<td id="S4.T1.1.3.3" class="ltx_td ltx_align_center">-22%</td>
<td id="S4.T1.1.3.4" class="ltx_td ltx_align_center">Skip redundant modules</td></tr>
