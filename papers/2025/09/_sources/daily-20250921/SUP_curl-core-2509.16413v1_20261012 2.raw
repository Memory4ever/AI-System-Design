<tr id="S3.T2.2.8" class="ltx_tr">
<th id="S3.T2.2.8.1" class="ltx_td ltx_th ltx_th_row" style="padding-top:1pt;padding-bottom:1pt;"></th>
<td id="S3.T2.2.8.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">160M</td>
<td id="S3.T2.2.8.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">300B</td>
<td id="S3.T2.2.8.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">29.96</td>
<td id="S3.T2.2.8.5" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">30.26</td>
<td id="S3.T2.2.8.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">43.73</td>
<td id="S3.T2.2.8.7" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">44.51</td></tr>
<tr id="S3.T2.2.9" class="ltx_tr">
<th id="S3.T2.2.9.1" class="ltx_td ltx_th ltx_th_row" style="padding-top:1pt;padding-bottom:1pt;"></th>
<td id="S3.T2.2.9.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">410M</td>
<td id="S3.T2.2.9.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">300B</td>
<td id="S3.T2.2.9.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">20.55</td>
<td id="S3.T2.2.9.5" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">40.55</td>
<td id="S3.T2.2.9.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">52.10</td>
<td id="S3.T2.2.9.7" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">41.23</td></tr>
<tr id="S3.T2.2.10" class="ltx_tr">
<th id="S3.T2.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">OPT</th>
<td id="S3.T2.2.10.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">125M</td>
<td id="S3.T2.2.10.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">300B</td>
<td id="S3.T2.2.10.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">27.22</td>
<td id="S3.T2.2.10.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">31.33</td>
<td id="S3.T2.2.10.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">43.48</td>
<td id="S3.T2.2.10.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">42.89</td></tr>
<tr id="S3.T2.2.11" class="ltx_tr">
<th id="S3.T2.2.11.1" class="ltx_td ltx_th ltx_th_row ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;"></th>
<td id="S3.T2.2.11.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;">350M</td>
<td id="S3.T2.2.11.3" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;">300B</td>
<td id="S3.T2.2.11.4" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;">20.91</td>
<td id="S3.T2.2.11.5" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;">36.66</td>
