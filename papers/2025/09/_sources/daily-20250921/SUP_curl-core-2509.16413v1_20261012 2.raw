<span id="S1.T1.2.8.6.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S1.T1.2.8.6.1.1" class="ltx_p"><span id="S1.T1.2.8.6.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF8000;">▲</span></span>
</span></td></tr>
