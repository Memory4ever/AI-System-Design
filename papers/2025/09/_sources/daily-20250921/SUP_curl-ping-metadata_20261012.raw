{"messages":[{"status":"ok","category":"all"}], "collection":[{"title":"Probing Hidden States for Calibrated, Alignment-Resistant Predictions in LLMs","authors":"Berkowitz, J. S.; Kivelson, S.; Srinivasan, A. S.; Gisladottir, U.; Tsang, K.; Acitores Cortina, J. M.; Kuchi, A.; Patock, J. R.; Czarny, R.; Tatonetti, N. P.","author_corresponding":"Nicholas P Tatonetti","author_corresponding_institution":"Cedars-Sinai Medical Center","doi":"10.1101\/2025.09.17.25336018","date":"2025-09-19","version":"1","type":"PUBLISHAHEADOFPRINT","license":"cc_by","category":"health informatics","jatsxml":"https:\/\/www.medrxiv.org\/content\/early\/2025\/09\/19\/2025.09.17.25336018.source.xml","abstract":"Scientific applications of large language models (LLMs) demand reliable, well-calibrated predictions, but standard generative approaches often fail to fully access relevant knowledge contained in their internal representations. As a result, models appear less capable than they are, with useful information remaining latent. We present PING (Probing INternal states of Generative models), an open-source framework that trains lightweight probes on frozen, HuggingFace-compatible transformers to deliver structured predictions with minimal compute overhead. Across diverse models and benchmarks including MMLU for broad coverage and MedMCQA for clinical focus, PING matches or exceeds generative accuracy while reducing Expected Calibration Error by up to 96%. Strikingly, on an LLM that has been explicitly safety-tuned to withhold medical information, PING recovered 87% of lost MedMCQA performance while generative accuracy is zero, showing this information still exists in the models latent space. The accompanying pingkit package makes these methods easy to deploy and is available through PyPI.","published":"NA","server":"medRxiv"},{"title":"Probing Hidden States for Calibrated, Alignment-Resistant Predictions in LLMs","authors":"Berkowitz, J. S.; Kivelson, S.; Srinivasan, A. S.; Gisladottir, U.; Tsang, K.; Acitores Cortina, J. M.; Kuchi, A.; Patock, J. R.; Czarny, R.; Tatonetti, N. P.","author_corresponding":"Nicholas P Tatonetti","author_corresponding_institution":"Cedars-Sinai Medical Center","doi":"10.1101\/2025.09.17.25336018","date":"2025-09-20","version":"2","type":"PUBLISHAHEADOFPRINT","license":"cc_by","category":"health informatics","jatsxml":"https:\/\/www.medrxiv.org\/content\/early\/2025\/09\/20\/2025.09.17.25336018.source.xml","abstract":"Scientific applications of large language models (LLMs) demand reliable, well-calibrated predictions, but standard generative approaches often fail to fully access relevant knowledge contained in their internal representations. As a result, models appear less capable than they are, with useful information remaining latent. We present PING (Probing INternal states of Generative models), an open-source framework that trains lightweight probes on frozen, HuggingFace-compatible transformers to deliver structured predictions with minimal compute overhead. Across diverse models and benchmarks including MMLU for broad coverage and MedMCQA for clinical focus, PING matches or exceeds generative accuracy while reducing Expected Calibration Error by up to 96%. Strikingly, on an LLM that has been explicitly safety-tuned to withhold medical information, PING recovered 87% of lost MedMCQA performance while generative accuracy is zero, showing this information still exists in the models latent space. The accompanying pingkit package makes these methods easy to deploy and is available through PyPI.","published":"NA","server":"medRxiv"},{"title":"Probing Hidden States for Calibrated, Alignment-Resistant Predictions in LLMs","authors":"Berkowitz, J. S.; Kivelson, S.; Srinivasan, A. S.; Gisladottir, U.; Tsang, K.; Acitores Cortina, J. M.; Kuchi, A.; Patock, J. R.; Czarny, R.; Tatonetti, N. P.","author_corresponding":"Nicholas P Tatonetti","author_corresponding_institution":"Cedars-Sinai Medical Center","doi":"10.1101\/2025.09.17.25336018","date":"2025-09-27","version":"3","type":"PUBLISHAHEADOFPRINT","license":"cc_by","category":"health informatics","jatsxml":"https:\/\/www.medrxiv.org\/content\/early\/2025\/09\/27\/2025.09.17.25336018.source.xml","abstract":"Scientific applications of large language models (LLMs) demand reliable, well-calibrated predictions, but standard generative approaches often fail to fully access relevant knowledge contained in their internal representations. As a result, models appear less capable than they are, with useful information remaining latent. We present PING (Probing INternal states of Generative models), an open-source framework that trains lightweight probes on frozen, HuggingFace-compatible transformers to deliver structured predictions with minimal compute overhead. Across diverse models and benchmarks including MMLU for broad coverage and MedMCQA for clinical focus, PING matches or exceeds generative accuracy while reducing Expected Calibration Error by up to 96%. Strikingly, on an LLM that has been explicitly safety-tuned to withhold medical information, PING recovered 87% of lost MedMCQA performance while generative accuracy is zero, showing this information still exists in the models latent space. The accompanying pingkit package makes these methods easy to deploy and is available through PyPI.","published":"NA","server":"medRxiv"}]}



