<tr id="S6.T3.3.1.4" class="ltx_tr">
<th id="S6.T3.3.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">IcebergHT</th>
<th id="S6.T3.3.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">774</th>
<td id="S6.T3.3.1.4.3" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">1243</td>
