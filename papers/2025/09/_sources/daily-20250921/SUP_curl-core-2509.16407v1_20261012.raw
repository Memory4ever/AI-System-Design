<td id="S6.T3.3.1.4.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">2075</td></tr>
<tr id="S6.T3.3.1.5" class="ltx_tr">
<th id="S6.T3.3.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">IcebergHT(M)</th>
<th id="S6.T3.3.1.5.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">889</th>
<td id="S6.T3.3.1.5.3" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">1815</td>
<td id="S6.T3.3.1.5.4" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">2168</td>
<td id="S6.T3.3.1.5.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">2398</td></tr>
<tr id="S6.T3.3.1.6" class="ltx_tr">
