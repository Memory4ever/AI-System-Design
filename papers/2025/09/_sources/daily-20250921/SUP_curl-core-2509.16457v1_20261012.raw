<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>PersonaEvolve (PEvo): Implicit Behavioral Alignment</figcaption>
<div id="algorithm1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.4.1" class="ltx_listingline"><span id="algorithm1.4.1.1" class="ltx_text"><span id="algorithm1.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>environment <math id="algorithm1.m1" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math>, persona pool <math id="algorithm1.m2" class="ltx_Math" alttext="P=\{p_{1},\dots,p_{N}\}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>N</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P=\{p_{1},\dots,p_{N}\}</annotation></semantics></math>, reference distribution <math id="algorithm1.m3" class="ltx_Math" alttext="p_{\mathrm{real}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>real</mi></msub><annotation encoding="application/x-tex">p_{\mathrm{real}}</annotation></semantics></math>, tolerance <math id="algorithm1.m4" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>, max iterations <math id="algorithm1.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>
</div>
<div id="algorithm1.4.2" class="ltx_listingline"><span id="algorithm1.4.2.1" class="ltx_text"><span id="algorithm1.4.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>aligned persona pool <math id="algorithm1.m6" class="ltx_Math" alttext="P^{\ast}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">P^{\ast}</annotation></semantics></math>
</div>
<div id="algorithm1.4.3" class="ltx_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.3.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m7" class="ltx_Math" alttext="t\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.3.2.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></em> <span id="algorithm1.4.3.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.4" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.4.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.4.2" class="ltx_text ltx_font_typewriter">1. Simulate &amp; classify </span>
</div>
<div id="algorithm1.4.5" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m9" class="ltx_Math" alttext="\{\tau_{i}\}_{i=1}^{N}\leftarrow\mathrm{Simulate}(P,e)" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo stretchy="false">←</mo><mrow><mi>Simulate</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\tau_{i}\}_{i=1}^{N}\leftarrow\mathrm{Simulate}(P,e)</annotation></semantics></math>
</div>
<div id="algorithm1.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.6.1" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.6.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m10" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.6.2.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m11" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></em> <span id="algorithm1.4.6.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m12" class="ltx_Math" alttext="b_{i}\leftarrow\mathrm{LLMBehaviorClassifier}(\tau_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mi>LLMBehaviorClassifier</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b_{i}\leftarrow\mathrm{LLMBehaviorClassifier}(\tau_{i})</annotation></semantics></math>
</div>
<div id="algorithm1.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end for
</div>
<div id="algorithm1.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.9.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.9.2" class="ltx_text ltx_font_typewriter">2. Aggregate behavior distribution </span>
</div>
<div id="algorithm1.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m13" class="ltx_Math" alttext="p_{\mathrm{sim}}\leftarrow\mathrm{Aggregate}(\{b_{i}\}_{i=1}^{N})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>sim</mi></msub><mo stretchy="false">←</mo><mrow><mi>Aggregate</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>b</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{\mathrm{sim}}\leftarrow\mathrm{Aggregate}(\{b_{i}\}_{i=1}^{N})</annotation></semantics></math>
</div>
<div id="algorithm1.4.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.11.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.11.2" class="ltx_text ltx_font_typewriter">3. Compute divergence </span>
</div>
<div id="algorithm1.4.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m14" class="ltx_math_unparsed" alttext="\Delta\leftarrow\mathrm{KL}\bigl(p_{\mathrm{sim}}\;\|\;p_{\mathrm{real}}\bigr)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo stretchy="false">←</mo><mi>KL</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>p</mi><mi>sim</mi></msub><mo lspace="0em" rspace="0.447em">∥</mo><msub><mi>p</mi><mi>real</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\leftarrow\mathrm{KL}\bigl(p_{\mathrm{sim}}\;\|\;p_{\mathrm{real}}\bigr)</annotation></semantics></math>
</div>
<div id="algorithm1.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.13.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.13.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m15" class="ltx_Math" alttext="\Delta\leq\varepsilon" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>≤</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\Delta\leq\varepsilon</annotation></semantics></math></em> <span id="algorithm1.4.13.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.14.1" class="ltx_text ltx_font_bold">return</span> <em id="algorithm1.4.14.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m16" class="ltx_Math" alttext="P^{\ast}\leftarrow P" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">P^{\ast}\leftarrow P</annotation></semantics></math></em>

</div>
<div id="algorithm1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end if
</div>
<div id="algorithm1.4.16" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.16.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.16.2" class="ltx_text ltx_font_typewriter">4. Compute gaps </span>
</div>
<div id="algorithm1.4.17" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.17.1" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.17.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m17" class="ltx_Math" alttext="b\in\mathcal{B}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow><annotation encoding="application/x-tex">b\in\mathcal{B}</annotation></semantics></math></em> <span id="algorithm1.4.17.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m18" class="ltx_Math" alttext="g[b]\leftarrow p_{\mathrm{real}}(b)-p_{\mathrm{sim}}(b)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>b</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><msub><mi>p</mi><mi>real</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>p</mi><mi>sim</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g[b]\leftarrow p_{\mathrm{real}}(b)-p_{\mathrm{sim}}(b)</annotation></semantics></math>
</div>
<div id="algorithm1.4.19" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m19" class="ltx_Math" alttext="g^{+}[b]\leftarrow\max\{0,\,g[b]\}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>g</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>b</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo rspace="0.337em">,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>b</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{+}[b]\leftarrow\max\{0,\,g[b]\}</annotation></semantics></math>
</div>
<div id="algorithm1.4.20" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m20" class="ltx_Math" alttext="g^{-}[b]\leftarrow\max\{0,\,-g[b]\}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>g</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>b</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo rspace="0.337em">,</mo><mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>b</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{-}[b]\leftarrow\max\{0,\,-g[b]\}</annotation></semantics></math>
</div>
<div id="algorithm1.4.21" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end foreach
</div>
<div id="algorithm1.4.22" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m21" class="ltx_Math" alttext="G^{+}\leftarrow\{b\mid g^{+}[b]&gt;0\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>+</mo></msup><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mi>b</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msup><mi>g</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>b</mi><mo stretchy="false">]</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">G^{+}\leftarrow\{b\mid g^{+}[b]&gt;0\}</annotation></semantics></math>;  <math id="algorithm1.m22" class="ltx_Math" alttext="G^{-}\leftarrow\{b\mid g^{-}[b]&gt;0\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>−</mo></msup><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mi>b</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msup><mi>g</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>b</mi><mo stretchy="false">]</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">G^{-}\leftarrow\{b\mid g^{-}[b]&gt;0\}</annotation></semantics></math>
</div>
<div id="algorithm1.4.23" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.23.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.23.2" class="ltx_text ltx_font_typewriter">5. Assign target behaviors </span>
</div>
<div id="algorithm1.4.24" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m23" class="ltx_Math" alttext="M\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">M\leftarrow\emptyset</annotation></semantics></math>
</div>
<div id="algorithm1.4.25" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.25.1" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.25.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m24" class="ltx_Math" alttext="b\in G^{-}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><msup><mi>G</mi><mo>−</mo></msup></mrow><annotation encoding="application/x-tex">b\in G^{-}</annotation></semantics></math></em> <span id="algorithm1.4.25.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.26" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m25" class="ltx_Math" alttext="k\leftarrow\lceil g^{-}[b]\times N\rceil" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">⌈</mo><mrow><mrow><msup><mi>g</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>b</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.222em">×</mo><mi>N</mi></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">k\leftarrow\lceil g^{-}[b]\times N\rceil</annotation></semantics></math>; sample <math id="algorithm1.m26" class="ltx_Math" alttext="\mathcal{A}_{b}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{b}</annotation></semantics></math> of <math id="algorithm1.m27" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> agents with label <math id="algorithm1.m28" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>
</div>
<div id="algorithm1.4.27" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.27.1" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.27.2" class="ltx_emph ltx_font_italic">agent <math id="algorithm1.m29" class="ltx_Math" alttext="a\in\mathcal{A}_{b}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">a\in\mathcal{A}_{b}</annotation></semantics></math></em> <span id="algorithm1.4.27.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.28" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> select <math id="algorithm1.m30" class="ltx_Math" alttext="b^{\prime}\in G^{+}" display="inline" intent=":literal"><semantics><mrow><msup><mi>b</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>G</mi><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">b^{\prime}\in G^{+}</annotation></semantics></math> with probability <math id="algorithm1.m31" class="ltx_Math" alttext="g^{+}[b^{\prime}]/\sum_{u\in G^{+}}g^{+}[u]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>g</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.055em">/</mo><mrow><msub><mo>∑</mo><mrow><mi>u</mi><mo>∈</mo><msup><mi>G</mi><mo>+</mo></msup></mrow></msub><mrow><msup><mi>g</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{+}[b^{\prime}]/\sum_{u\in G^{+}}g^{+}[u]</annotation></semantics></math>
</div>
<div id="algorithm1.4.29" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m32" class="ltx_Math" alttext="M[a]\leftarrow b^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><msup><mi>b</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">M[a]\leftarrow b^{\prime}</annotation></semantics></math>
</div>
<div id="algorithm1.4.30" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end foreach
</div>
<div id="algorithm1.4.31" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end foreach
</div>
<div id="algorithm1.4.32" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.32.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.4.32.2" class="ltx_text ltx_font_typewriter">6. Rewrite personas via LLM </span>
</div>
<div id="algorithm1.4.33" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.33.1" class="ltx_text ltx_font_bold">foreach</span> <em id="algorithm1.4.33.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m33" class="ltx_Math" alttext="(a,b_{\mathrm{tgt}})\in M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><msub><mi>b</mi><mi>tgt</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">(a,b_{\mathrm{tgt}})\in M</annotation></semantics></math></em> <span id="algorithm1.4.33.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.34" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m34" class="ltx_Math" alttext="P[a]\leftarrow\mathrm{LLMPersonaWriter}\bigl(P[a],\,b_{\mathrm{tgt}},\,e\bigr)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>LLMPersonaWriter</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><msub><mi>b</mi><mi>tgt</mi></msub><mo>,</mo><mi>e</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P[a]\leftarrow\mathrm{LLMPersonaWriter}\bigl(P[a],\,b_{\mathrm{tgt}},\,e\bigr)</annotation></semantics></math>
</div>
<div id="algorithm1.4.35" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end foreach
</div>
<div id="algorithm1.4.36" class="ltx_listingline">end for
</div>
<div id="algorithm1.4.37" class="ltx_listingline"><span id="algorithm1.4.37.1" class="ltx_text ltx_font_bold">return</span> <em id="algorithm1.4.37.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m35" class="ltx_Math" alttext="P^{\ast}\leftarrow P" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">P^{\ast}\leftarrow P</annotation></semantics></math></em>
</div>
<div id="algorithm1.4.38" class="ltx_listingline">
</div>
</div>
</figure>
