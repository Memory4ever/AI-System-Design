<span id="A8.I2.i1.p1.1" class="ltx_p"><span id="A8.I2.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">States: {states_text}</span></span>
</span></span>
<span id="A8.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A8.I2.i2.p1" class="ltx_para">
<span id="A8.I2.i2.p1.1" class="ltx_p"><span id="A8.I2.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Actions: {actions_text}</span></span>
</span></span>
<span id="A8.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A8.I2.i3.p1" class="ltx_para">
<span id="A8.I2.i3.p1.1" class="ltx_p"><span id="A8.I2.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Memories: {memories_text}</span></span>
</span></span>
</span>
<span id="A8.F7.pic1.2.4" class="ltx_p"><span id="A8.F7.pic1.2.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Output:<span id="A8.F7.pic1.2.4.1.1" class="ltx_text"></span></span></span>
<span id="A8.I3" class="ltx_itemize">
<span id="A8.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A8.I3.i1.p1" class="ltx_para">
<span id="A8.I3.i1.p1.1" class="ltx_p"><span id="A8.I3.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Reasoning: Your reasoning for the classification.</span></span>
</span></span>
<span id="A8.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A8.I3.i2.p1" class="ltx_para">
<span id="A8.I3.i2.p1.1" class="ltx_p"><span id="A8.I3.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Classification: A single behavior label from the list of behaviors.</span></span>
</span></span>
<span id="A8.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
