<td id="S4.T5.7.4.3" class="ltx_td ltx_align_left"><span id="S4.T5.7.4.3.1" class="ltx_text" style="font-size:80%;">85 ms</span></td>
<td id="S4.T5.7.4.4" class="ltx_td ltx_align_left"><span id="S4.T5.7.4.4.1" class="ltx_text" style="font-size:80%;">51,162 tok/s</span></td></tr>
<tr id="S4.T5.7.5" class="ltx_tr">
