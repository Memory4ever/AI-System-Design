<th id="S4.T5.7.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="S4.T5.7.1.3.1" class="ltx_text" style="font-size:80%;">Median</span></th>
<th id="S4.T5.7.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="S4.T5.7.1.4.1" class="ltx_text" style="font-size:80%;">Peak</span></th></tr>
