<td id="S4.T5.7.3.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T5.7.3.3.1" class="ltx_text" style="font-size:80%;">83 ms</span></td>
<td id="S4.T5.7.3.4" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T5.7.3.4.1" class="ltx_text" style="font-size:80%;">75,535 tok/s</span></td></tr>
