<td id="A1.T8.12.12.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:3pt;padding-bottom:3pt;"><math id="A1.T8.m9" class="ltx_Math" style="--ltx-bg-color:#ECECEC;" alttext="\phi:\mathcal{C}\to\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">ϕ</mi><mo style="--ltx-bg-color:#ECECEC;" lspace="0.278em" mathbackground="#ECECEC" rspace="0.278em">:</mo><mrow><mi style="--ltx-bg-color:#ECECEC;" class="ltx_font_mathcaligraphic" mathbackground="#ECECEC">𝒞</mi><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC" stretchy="false">→</mo><mi style="--ltx-bg-color:#ECECEC;" class="ltx_font_mathcaligraphic" mathbackground="#ECECEC">𝒵</mi></mrow></mrow><annotation encoding="application/x-tex">\phi:\mathcal{C}\to\mathcal{Z}</annotation></semantics></math></td>
