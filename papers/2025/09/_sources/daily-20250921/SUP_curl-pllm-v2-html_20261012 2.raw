<span id="S5.T4.2.1.2.3.1.2" class="ltx_p ltx_align_center">(for each <math id="S5.T4.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in <math id="S5.T4.m4" class="ltx_Math" alttext="1...n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1...n</annotation></semantics></math>)</span>
</span></td></tr>
