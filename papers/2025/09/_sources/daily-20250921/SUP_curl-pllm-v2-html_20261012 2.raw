<td id="A1.T8.12.10.2" class="ltx_td ltx_align_left" style="padding-top:3pt;padding-bottom:3pt;"><span id="A1.T8.12.10.2.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">Set of users</span></td></tr>
