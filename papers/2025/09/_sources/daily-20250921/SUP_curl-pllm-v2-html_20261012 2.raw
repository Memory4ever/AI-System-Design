<td id="A1.T8.12.13.1" class="ltx_td ltx_align_center" style="padding-top:3pt;padding-bottom:3pt;"><math id="A1.T8.m10" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="\psi:(\mathcal{C}\times Q)\to\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">ψ</mi><mo style="--ltx-bg-color:#FFFFFF;" lspace="0.278em" mathbackground="#FFFFFF" rspace="0.278em">:</mo><mrow><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">(</mo><mrow><mi style="--ltx-bg-color:#FFFFFF;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFFF">𝒞</mi><mo style="--ltx-bg-color:#FFFFFF;" lspace="0.222em" mathbackground="#FFFFFF" rspace="0.222em">×</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">Q</mi></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">)</mo></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">→</mo><mi style="--ltx-bg-color:#FFFFFF;" class="ltx_font_mathcaligraphic" mathbackground="#FFFFFF">ℋ</mi></mrow></mrow><annotation encoding="application/x-tex">\psi:(\mathcal{C}\times Q)\to\mathcal{H}</annotation></semantics></math></td>
<td id="A1.T8.12.13.2" class="ltx_td ltx_align_left" style="padding-top:3pt;padding-bottom:3pt;"><span id="A1.T8.12.13.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Personalization encoder (possibly query-aware)</span></td></tr>
<tr id="A1.T8.12.14" class="ltx_tr" style="--ltx-bg-color:#ECECEC;">
<td id="A1.T8.12.14.1" class="ltx_td ltx_align_center" style="padding-top:3pt;padding-bottom:3pt;"><math id="A1.T8.m11" class="ltx_Math" style="--ltx-bg-color:#ECECEC;" alttext="f_{\mathrm{ext}}:Q\times\mathcal{C}\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">f</mi><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">ext</mi></msub><mo style="--ltx-bg-color:#ECECEC;" lspace="0.278em" mathbackground="#ECECEC" rspace="0.278em">:</mo><mrow><mrow><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">Q</mi><mo style="--ltx-bg-color:#ECECEC;" lspace="0.222em" mathbackground="#ECECEC" rspace="0.222em">×</mo><mi style="--ltx-bg-color:#ECECEC;" class="ltx_font_mathcaligraphic" mathbackground="#ECECEC">𝒞</mi></mrow><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC" stretchy="false">→</mo><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">Y</mi></mrow></mrow><annotation encoding="application/x-tex">f_{\mathrm{ext}}:Q\times\mathcal{C}\to Y</annotation></semantics></math></td>
