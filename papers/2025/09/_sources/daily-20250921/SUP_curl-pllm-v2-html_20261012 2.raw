<td id="S6.T5.12.13.3" class="ltx_td ltx_align_center" style="padding-top:6pt;padding-bottom:6pt;"><math id="S6.T5.m12" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="\operatorname{LLM}(S,R)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">LLM</mi><mo>⁡</mo><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">(</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">S</mi><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">,</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">R</mi><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{LLM}(S,R)</annotation></semantics></math></td>
