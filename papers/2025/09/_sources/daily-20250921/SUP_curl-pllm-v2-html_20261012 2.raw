<span id="S6.T6.28.1.4.3.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:56.9pt;--ltx-bg-color:#ECECEC;">
<span id="S6.T6.28.1.4.3.1.1" class="ltx_p ltx_align_center">Abstraction</span>
<span id="S6.T6.28.1.4.3.1.2" class="ltx_p ltx_align_center">Extraction</span>
<span id="S6.T6.28.1.4.3.1.3" class="ltx_p ltx_align_center">Generalization</span>
</span></td>
