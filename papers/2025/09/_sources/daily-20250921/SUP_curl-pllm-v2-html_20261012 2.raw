<td id="S6.T5.12.11.2" class="ltx_td ltx_align_center" style="padding-top:6pt;padding-bottom:6pt;"><span id="S6.T5.12.11.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFFFFF;">G</span></td>
<td id="S6.T5.12.11.3" class="ltx_td ltx_align_center" style="padding-top:6pt;padding-bottom:6pt;"><math id="S6.T5.m10" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="\frac{10m}{c+9r}\cdot\left(1-0.5\cdot\left(\frac{ch}{m}\right)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">10</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">m</mi></mrow><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">c</mi><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">+</mo><mrow><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">9</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">r</mi></mrow></mrow></mfrac><mo style="--ltx-bg-color:#FFFFFF;" lspace="0.222em" mathbackground="#FFFFFF" rspace="0.222em">⋅</mo><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">(</mo><mrow><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">1</mn><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">−</mo><mrow><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">0.5</mn><mo style="--ltx-bg-color:#FFFFFF;" lspace="0.222em" mathbackground="#FFFFFF" rspace="0.222em">⋅</mo><msup><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">(</mo><mfrac><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">h</mi></mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">m</mi></mfrac><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">)</mo></mrow><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">3</mn></msup></mrow></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{10m}{c+9r}\cdot\left(1-0.5\cdot\left(\frac{ch}{m}\right)^{3}\right)</annotation></semantics></math></td>
<td id="S6.T5.12.11.4" class="ltx_td ltx_align_center" style="padding-top:6pt;padding-bottom:6pt;"><span id="S6.T5.12.11.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Linguistic features</span></td></tr>
