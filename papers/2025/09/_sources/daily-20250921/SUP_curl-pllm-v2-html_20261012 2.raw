<td id="S6.T5.12.9.3" class="ltx_td ltx_align_center" style="padding-top:6pt;padding-bottom:6pt;"><math id="S6.T5.m8" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="\begin{cases}\frac{|S\cap R|}{|S|}\cdot\exp\left(1-\frac{r}{c}\right)&amp;\text{if }c&lt;r\\
\frac{|S\cap R|}{|S|}&amp;\text{if }c\geq r\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mfrac><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">|</mo><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">S</mi><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">∩</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">R</mi></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">|</mo></mrow><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">|</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">S</mi><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">|</mo></mrow></mfrac><mo style="--ltx-bg-color:#FFFFFF;" lspace="0.222em" mathbackground="#FFFFFF" rspace="0.222em">⋅</mo><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">exp</mi><mo>⁡</mo><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">(</mo><mrow><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">1</mn><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">−</mo><mfrac><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">r</mi><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">c</mi></mfrac></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">c</mi></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">&lt;</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">r</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">|</mo><mrow><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">S</mi><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">∩</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">R</mi></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">|</mo></mrow><mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">|</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">S</mi><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">c</mi></mrow><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">≥</mo><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">r</mi></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\begin{cases}\frac{|S\cap R|}{|S|}\cdot\exp\left(1-\frac{r}{c}\right)&amp;\text{if }c&lt;r\\
\frac{|S\cap R|}{|S|}&amp;\text{if }c\geq r\end{cases}</annotation></semantics></math></td>
