<td id="S6.T5.12.12.2" class="ltx_td ltx_align_center" style="padding-top:6pt;padding-bottom:6pt;"><span id="S6.T5.12.12.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ECECEC;">G</span></td>
<td id="S6.T5.12.12.3" class="ltx_td ltx_align_center" style="padding-top:6pt;padding-bottom:6pt;"><math id="S6.T5.m11" class="ltx_Math" style="--ltx-bg-color:#ECECEC;" alttext="\cos(\mathbf{v}_{S},\mathbf{v}_{R})=\frac{\mathbf{v}_{S}\cdot\mathbf{v}_{R}}{\|\mathbf{v}_{S}\|\cdot\|\mathbf{v}_{R}\|}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">cos</mi><mo>⁡</mo><mrow><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC" stretchy="false">(</mo><msub><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">𝐯</mi><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">S</mi></msub><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">,</mo><msub><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">𝐯</mi><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">R</mi></msub><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">=</mo><mfrac><mrow><msub><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">𝐯</mi><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">S</mi></msub><mo style="--ltx-bg-color:#ECECEC;" lspace="0.222em" mathbackground="#ECECEC" rspace="0.222em">⋅</mo><msub><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">𝐯</mi><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">R</mi></msub></mrow><mrow><mrow><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC" stretchy="false">‖</mo><msub><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">𝐯</mi><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">S</mi></msub><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC" rspace="0.055em" stretchy="false">‖</mo></mrow><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC" rspace="0.222em">⋅</mo><mrow><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC" stretchy="false">‖</mo><msub><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">𝐯</mi><mi style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC">R</mi></msub><mo style="--ltx-bg-color:#ECECEC;" mathbackground="#ECECEC" stretchy="false">‖</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\cos(\mathbf{v}_{S},\mathbf{v}_{R})=\frac{\mathbf{v}_{S}\cdot\mathbf{v}_{R}}{\|\mathbf{v}_{S}\|\cdot\|\mathbf{v}_{R}\|}</annotation></semantics></math></td>
