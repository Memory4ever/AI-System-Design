<br class="ltx_break"><cite class="ltx_cite ltx_citemacro_citep"><span id="S6.T6.28.1.4.1.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">(</span><a href="#bib.bib146" title="" class="ltx_ref">Maharana et al., 2024</a><span id="S6.T6.28.1.4.1.1.1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></cite></span></span>
</span></td>
