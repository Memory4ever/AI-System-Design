<article article-type="article" specific-use="production" xml:lang="en" xmlns:hw="org.highwire.hpp" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:ref="http://schema.highwire.org/Reference" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:nlm="http://schema.highwire.org/NLM/Journal" xmlns:a="http://www.w3.org/2005/Atom" xmlns:c="http://schema.highwire.org/Compound" xmlns:hpp="http://schema.highwire.org/Publishing" xmlns:hwp="http://schema.highwire.org/Journal" xmlns:l="http://schema.highwire.org/Linking" xmlns:r="http://schema.highwire.org/Revision" xmlns:x="http://www.w3.org/1999/xhtml" xmlns:app="http://www.w3.org/2007/app"><front><journal-meta><journal-id journal-id-type="hwp">medrxiv</journal-id><journal-id journal-id-type="publisher-id">MEDRXIV</journal-id><journal-title>medRxiv</journal-title><abbrev-journal-title abbrev-type="publisher">medRxiv</abbrev-journal-title><issn pub-type="epub">3067-2007</issn><publisher><publisher-name>Cold Spring Harbor Laboratory Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="doi">10.1101/2025.09.17.25336018</article-id><article-id pub-id-type="other" hwp:sub-type="pisa">medrxiv;2025.09.17.25336018v2</article-id><article-id pub-id-type="other" hwp:sub-type="pisa-master">medrxiv;2025.09.17.25336018</article-id><article-id pub-id-type="other" hwp:sub-type="slug">2025.09.17.25336018</article-id><article-id pub-id-type="other" hwp:sub-type="atom-slug">2025.09.17.25336018</article-id><article-id pub-id-type="other" hwp:sub-type="tag">2025.09.17.25336018</article-id><article-version>1.2</article-version><article-categories><subj-group subj-group-type="hwp-journal-coll" hwp:journal-coll-id="Health Informatics" hwp:journal="medrxiv"><subject>Health Informatics</subject></subj-group></article-categories><title-group><article-title hwp:id="article-title-1">Probing Hidden States for Calibrated, Alignment-Resistant Predictions in LLMs</article-title></title-group><author-notes hwp:id="author-notes-1"><corresp id="cor1" hwp:id="corresp-1" hwp:rev-id="xref-corresp-1-1"><label>*</label>Corresponding author(s). E-mail(s): <email hwp:id="email-1">nicholas.tatonetti@cshs.org</email>;</corresp><fn id="n1" fn-type="equal" hwp:id="fn-1" hwp:rev-id="xref-fn-1-1 xref-fn-1-2"><label>†</label><p hwp:id="p-1">These authors contributed equally to this work.</p></fn></author-notes><contrib-group hwp:id="contrib-group-1"><contrib contrib-type="author" equal-contrib="yes" hwp:id="contrib-1"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0009-0009-8460-7240</contrib-id><name name-style="western" hwp:sortable="Berkowitz Jacob"><surname>Berkowitz</surname><given-names>Jacob</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-1" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-1" hwp:rel-id="aff-2">2</xref><xref ref-type="fn" rid="n1" hwp:id="xref-fn-1-1" hwp:rel-id="fn-1">†</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0009-0009-8460-7240"/></contrib><contrib contrib-type="author" equal-contrib="yes" hwp:id="contrib-2"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0003-0937-6517</contrib-id><name name-style="western" hwp:sortable="Kivelson Sophia"><surname>Kivelson</surname><given-names>Sophia</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-2" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-2" hwp:rel-id="aff-2">2</xref><xref ref-type="fn" rid="n1" hwp:id="xref-fn-1-2" hwp:rel-id="fn-1">†</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0000-0003-0937-6517"/></contrib><contrib contrib-type="author" hwp:id="contrib-3"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0009-0001-6036-7651</contrib-id><name name-style="western" hwp:sortable="Srinivasan Apoorva"><surname>Srinivasan</surname><given-names>Apoorva</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-3" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-3" hwp:rel-id="aff-2">2</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0009-0001-6036-7651"/></contrib><contrib contrib-type="author" hwp:id="contrib-4"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-5892-0852</contrib-id><name name-style="western" hwp:sortable="Gisladottir Undina"><surname>Gisladottir</surname><given-names>Undina</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-4" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-4" hwp:rel-id="aff-2">2</xref><xref ref-type="aff" rid="a3" hwp:id="xref-aff-3-1" hwp:rel-id="aff-3">3</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0000-0001-5892-0852"/></contrib><contrib contrib-type="author" hwp:id="contrib-5"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0002-1531-3312</contrib-id><name name-style="western" hwp:sortable="Tsang Kevin K."><surname>Tsang</surname><given-names>Kevin K.</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-5" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-5" hwp:rel-id="aff-2">2</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0000-0002-1531-3312"/></contrib><contrib contrib-type="author" hwp:id="contrib-6"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0009-0007-0361-9334</contrib-id><name name-style="western" hwp:sortable="Cortina Jose Miguel Acitores"><surname>Cortina</surname><given-names>Jose Miguel Acitores</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-6" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-6" hwp:rel-id="aff-2">2</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0009-0007-0361-9334"/></contrib><contrib contrib-type="author" hwp:id="contrib-7"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0009-0005-4662-5051</contrib-id><name name-style="western" hwp:sortable="Kuchi Aditi"><surname>Kuchi</surname><given-names>Aditi</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-7" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-7" hwp:rel-id="aff-2">2</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0009-0005-4662-5051"/></contrib><contrib contrib-type="author" hwp:id="contrib-8"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0009-0009-9107-0373</contrib-id><name name-style="western" hwp:sortable="Patock Jake"><surname>Patock</surname><given-names>Jake</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-8" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-8" hwp:rel-id="aff-2">2</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0009-0009-9107-0373"/></contrib><contrib contrib-type="author" hwp:id="contrib-9"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-5039-5221</contrib-id><name name-style="western" hwp:sortable="Czarny Ryan"><surname>Czarny</surname><given-names>Ryan</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-9" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-9" hwp:rel-id="aff-2">2</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0000-0001-5039-5221"/></contrib><contrib contrib-type="author" corresp="yes" hwp:id="contrib-10"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0002-2700-2597</contrib-id><name name-style="western" hwp:sortable="Tatonetti Nicholas P."><surname>Tatonetti</surname><given-names>Nicholas P.</given-names></name><xref ref-type="aff" rid="a1" hwp:id="xref-aff-1-10" hwp:rel-id="aff-1">1</xref><xref ref-type="aff" rid="a2" hwp:id="xref-aff-2-10" hwp:rel-id="aff-2">2</xref><xref ref-type="corresp" rid="cor1" hwp:id="xref-corresp-1-1" hwp:rel-id="corresp-1">*</xref><object-id pub-id-type="other" hwp:sub-type="orcid" xlink:href="http://orcid.org/0000-0002-2700-2597"/></contrib><aff id="a1" hwp:id="aff-1" hwp:rev-id="xref-aff-1-1 xref-aff-1-2 xref-aff-1-3 xref-aff-1-4 xref-aff-1-5 xref-aff-1-6 xref-aff-1-7 xref-aff-1-8 xref-aff-1-9 xref-aff-1-10"><label>1</label><institution hwp:id="institution-1">Department of Computational Biomedicine, Cedars-Sinai Medical Center</institution>, Los Angeles, 90069, CA, <country>USA</country></aff><aff id="a2" hwp:id="aff-2" hwp:rev-id="xref-aff-2-1 xref-aff-2-2 xref-aff-2-3 xref-aff-2-4 xref-aff-2-5 xref-aff-2-6 xref-aff-2-7 xref-aff-2-8 xref-aff-2-9 xref-aff-2-10"><label>2</label><institution hwp:id="institution-2">Cedars-Sinai Cancer, Cedars-Sinai Medical Center</institution>, Los Angeles, 90069, CA, <country>USA</country></aff><aff id="a3" hwp:id="aff-3" hwp:rev-id="xref-aff-3-1"><label>3</label><institution hwp:id="institution-3">Department of Biomedical Informatics, Columbia University Irving Medical Center</institution>, New York, 10032, NY, <country>USA</country></aff></contrib-group><pub-date pub-type="epub-original" date-type="pub" publication-format="electronic" hwp:start="2025"><year>2025</year></pub-date><pub-date pub-type="hwp-created" hwp:start="2025-09-19T07:51:15-07:00">
