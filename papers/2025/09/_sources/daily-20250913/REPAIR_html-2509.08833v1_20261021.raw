<td id="S4.T2.2.10.3" class="ltx_td ltx_align_left">0.89</td>
<td id="S4.T2.2.10.4" class="ltx_td ltx_align_left">0.62</td>
<td id="S4.T2.2.10.5" class="ltx_td ltx_align_left">0.90</td>
<td id="S4.T2.2.10.6" class="ltx_td ltx_align_left">9</td></tr>
<tr id="S4.T2.2.11" class="ltx_tr">
<td id="S4.T2.2.11.1" class="ltx_td ltx_align_left">9</td>
<td id="S4.T2.2.11.2" class="ltx_td ltx_align_left">Catastrophic thinking</td>
<td id="S4.T2.2.11.3" class="ltx_td ltx_align_left">0.67</td>
<td id="S4.T2.2.11.4" class="ltx_td ltx_align_left">0.74</td>
<td id="S4.T2.2.11.5" class="ltx_td ltx_align_left">0.90</td>
<td id="S4.T2.2.11.6" class="ltx_td ltx_align_left">3</td></tr>
<tr id="S4.T2.2.12" class="ltx_tr">
<td id="S4.T2.2.12.1" class="ltx_td ltx_align_left ltx_border_bb">10</td>
<td id="S4.T2.2.12.2" class="ltx_td ltx_align_left ltx_border_bb">Refusal</td>
