<td id="S4.T2.2.8.3" class="ltx_td ltx_align_left">0.33</td>
<td id="S4.T2.2.8.4" class="ltx_td ltx_align_left">0.09</td>
<td id="S4.T2.2.8.5" class="ltx_td ltx_align_left">0.40</td>
