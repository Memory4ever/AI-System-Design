<td id="S4.T2.2.4.3" class="ltx_td ltx_align_center">82.76</td>
<td id="S4.T2.2.4.4" class="ltx_td ltx_align_center">82.10</td></tr>
<tr id="S4.T2.2.5" class="ltx_tr">
<td id="S4.T2.2.5.1" class="ltx_td ltx_align_center ltx_border_bb">128</td>
