<td id="S4.T2.2.4.4" class="ltx_td ltx_align_center"><math id="S4.T2.m9" class="ltx_Math" alttext="11.87" display="inline" intent=":literal"><semantics><mn>11.87</mn><annotation encoding="application/x-tex">11.87</annotation></semantics></math></td>
