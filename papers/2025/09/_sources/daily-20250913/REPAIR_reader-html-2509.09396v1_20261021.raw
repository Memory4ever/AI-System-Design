<td id="A2.T6.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-bottom: 2.0pt;" colspan="2"><span id="A2.T6.2.1.3.1" class="ltx_text ltx_font_bold">Unconstrained prompting</span></td>
<td id="A2.T6.2.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-bottom: 2.0pt;" colspan="2"><span id="A2.T6.2.1.4.1" class="ltx_text ltx_font_bold">Minimal prompting</span></td></tr>
<tr id="A2.T6.2.2" class="ltx_tr">
