<td id="S4.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.2.2.1" class="ltx_text ltx_font_bold">Val</span></td>
<td id="S4.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.2.3.1" class="ltx_text ltx_font_bold">ED</span></td>
<td id="S4.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.2.4.1" class="ltx_text ltx_font_bold">Val</span></td>
<td id="S4.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.2.5.1" class="ltx_text ltx_font_bold">ED</span></td></tr>
<tr id="S4.T2.2.3" class="ltx_tr">
