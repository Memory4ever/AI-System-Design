<td id="A3.T7.1.20.3" class="ltx_td ltx_align_center ltx_border_r"><math id="A3.F12.m74" class="ltx_Math" alttext="0.2994" display="inline" intent=":literal"><semantics><mn>0.2994</mn><annotation encoding="application/x-tex">0.2994</annotation></semantics></math></td>
<td id="A3.T7.1.20.4" class="ltx_td ltx_align_center"><math id="A3.F12.m75" class="ltx_Math" alttext="29.6" display="inline" intent=":literal"><semantics><mn>29.6</mn><annotation encoding="application/x-tex">29.6</annotation></semantics></math></td>
