<td id="A3.T7.1.21.4" class="ltx_td ltx_align_center"><math id="A3.F12.m79" class="ltx_Math" alttext="25.8" display="inline" intent=":literal"><semantics><mn>25.8</mn><annotation encoding="application/x-tex">25.8</annotation></semantics></math></td>
