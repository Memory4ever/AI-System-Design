<td id="A2.T6.2.3.6" class="ltx_td ltx_align_center ltx_border_t"><math id="A2.T6.m6" class="ltx_Math" alttext="0.0151" display="inline" intent=":literal"><semantics><mn>0.0151</mn><annotation encoding="application/x-tex">0.0151</annotation></semantics></math></td></tr>
<tr id="A2.T6.2.4" class="ltx_tr">
<td id="A2.T6.2.4.1" class="ltx_td ltx_align_left ltx_border_r">Llama 3.3 70B</td>
<td id="A2.T6.2.4.2" class="ltx_td ltx_align_center"><math id="A2.T6.m7" class="ltx_Math" alttext="100.0" display="inline" intent=":literal"><semantics><mn>100.0</mn><annotation encoding="application/x-tex">100.0</annotation></semantics></math></td>
