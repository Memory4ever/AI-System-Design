<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center"><math id="S4.T2.m7" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn>100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math></td>
