<td id="S4.T2.2.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m3" class="ltx_Math" alttext="0.1403" display="inline" intent=":literal"><semantics><mn>0.1403</mn><annotation encoding="application/x-tex">0.1403</annotation></semantics></math></td>
<td id="S4.T2.2.3.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m4" class="ltx_Math" alttext="12.66" display="inline" intent=":literal"><semantics><mn>12.66</mn><annotation encoding="application/x-tex">12.66</annotation></semantics></math></td>
<td id="S4.T2.2.3.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m5" class="ltx_Math" alttext="0.0169" display="inline" intent=":literal"><semantics><mn>0.0169</mn><annotation encoding="application/x-tex">0.0169</annotation></semantics></math></td></tr>
