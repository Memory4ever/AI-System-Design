<td id="A2.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_r"><math id="A2.T6.m1" class="ltx_Math" alttext="\mathbf{ED}" display="inline" intent=":literal"><semantics><mi>𝐄𝐃</mi><annotation encoding="application/x-tex">\mathbf{ED}</annotation></semantics></math></td>
<td id="A2.T6.2.2.3" class="ltx_td ltx_align_center"><span id="A2.T6.2.2.3.1" class="ltx_text ltx_font_bold">Val</span></td>
<td id="A2.T6.2.2.4" class="ltx_td ltx_align_center"><math id="A2.T6.m2" class="ltx_Math" alttext="\mathbf{ED}" display="inline" intent=":literal"><semantics><mi>𝐄𝐃</mi><annotation encoding="application/x-tex">\mathbf{ED}</annotation></semantics></math></td></tr>
<tr id="A2.T6.2.3" class="ltx_tr">
<td id="A2.T6.2.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" rowspan="6"><span id="A2.T6.2.3.1.1" class="ltx_text">Income</span></td>
<td id="A2.T6.2.3.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Gemma 2 27B</td>
<td id="A2.T6.2.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A2.T6.m3" class="ltx_Math" alttext="99.48" display="inline" intent=":literal"><semantics><mn>99.48</mn><annotation encoding="application/x-tex">99.48</annotation></semantics></math></td>
<td id="A2.T6.2.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A2.T6.m4" class="ltx_Math" alttext="0.1504" display="inline" intent=":literal"><semantics><mn>0.1504</mn><annotation encoding="application/x-tex">0.1504</annotation></semantics></math></td>
