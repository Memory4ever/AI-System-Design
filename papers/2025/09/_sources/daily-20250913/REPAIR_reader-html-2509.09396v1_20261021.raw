<tr id="A3.T7.1.22" class="ltx_tr">
<td id="A3.T7.1.22.1" class="ltx_td ltx_align_left ltx_border_r">GPT-4.1</td>
<td id="A3.T7.1.22.2" class="ltx_td ltx_align_center"><math id="A3.F12.m81" class="ltx_Math" alttext="100.0" display="inline" intent=":literal"><semantics><mn>100.0</mn><annotation encoding="application/x-tex">100.0</annotation></semantics></math></td>
<td id="A3.T7.1.22.3" class="ltx_td ltx_align_center ltx_border_r"><math id="A3.F12.m82" class="ltx_Math" alttext="0.3478" display="inline" intent=":literal"><semantics><mn>0.3478</mn><annotation encoding="application/x-tex">0.3478</annotation></semantics></math></td>
