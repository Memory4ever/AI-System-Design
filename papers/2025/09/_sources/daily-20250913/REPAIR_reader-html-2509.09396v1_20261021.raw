<td id="A2.T6.2.5.3" class="ltx_td ltx_align_center ltx_border_r"><math id="A2.T6.m12" class="ltx_Math" alttext="0.1116" display="inline" intent=":literal"><semantics><mn>0.1116</mn><annotation encoding="application/x-tex">0.1116</annotation></semantics></math></td>
<td id="A2.T6.2.5.4" class="ltx_td ltx_align_center"><math id="A2.T6.m13" class="ltx_Math" alttext="10.52" display="inline" intent=":literal"><semantics><mn>10.52</mn><annotation encoding="application/x-tex">10.52</annotation></semantics></math></td>
<td id="A2.T6.2.5.5" class="ltx_td ltx_align_center"><math id="A2.T6.m14" class="ltx_Math" alttext="0.0111" display="inline" intent=":literal"><semantics><mn>0.0111</mn><annotation encoding="application/x-tex">0.0111</annotation></semantics></math></td></tr>
<tr id="A2.T6.2.6" class="ltx_tr">
<td id="A2.T6.2.6.1" class="ltx_td ltx_align_left ltx_border_r">DeepSeek-R1 70B</td>
<td id="A2.T6.2.6.2" class="ltx_td ltx_align_center"><math id="A2.T6.m15" class="ltx_Math" alttext="92.50" display="inline" intent=":literal"><semantics><mn>92.50</mn><annotation encoding="application/x-tex">92.50</annotation></semantics></math></td>
<td id="A2.T6.2.6.3" class="ltx_td ltx_align_center ltx_border_r"><math id="A2.T6.m16" class="ltx_Math" alttext="0.0603" display="inline" intent=":literal"><semantics><mn>0.0603</mn><annotation encoding="application/x-tex">0.0603</annotation></semantics></math></td>
<td id="A2.T6.2.6.4" class="ltx_td ltx_align_center"><math id="A2.T6.m17" class="ltx_Math" alttext="10.26" display="inline" intent=":literal"><semantics><mn>10.26</mn><annotation encoding="application/x-tex">10.26</annotation></semantics></math></td>
<td id="A2.T6.2.6.5" class="ltx_td ltx_align_center"><math id="A2.T6.m18" class="ltx_Math" alttext="0.0116" display="inline" intent=":literal"><semantics><mn>0.0116</mn><annotation encoding="application/x-tex">0.0116</annotation></semantics></math></td></tr>
<tr id="A2.T6.2.7" class="ltx_tr">
