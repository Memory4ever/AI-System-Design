<td id="S4.T2.2.5.4" class="ltx_td ltx_align_center"><math id="S4.T2.m13" class="ltx_Math" alttext="11.88" display="inline" intent=":literal"><semantics><mn>11.88</mn><annotation encoding="application/x-tex">11.88</annotation></semantics></math></td>
