<th id="S7.T3.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T3.4.1.2.1" class="ltx_text ltx_font_bold">Expectation (<math id="S7.T3.m5" class="ltx_Math" alttext="\mathbb{E}[\tilde{\Delta}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\tilde{\Delta}]</annotation></semantics></math>)</span></th>
