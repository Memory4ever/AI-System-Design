<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex18.m1" class="ltx_Math" alttext="\displaystyle=\min\{\kappa,-\frac{\alpha}{T_{o^{+}_{1}}}\log\pi_{t}(o^{+}_{1}|q)\}-\min\{\kappa,-\frac{\alpha}{T_{o^{+}_{2}}}\log\pi_{t}(o^{+}_{2}|q)\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>κ</mi><mo>,</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><msub><mi>T</mi><msubsup><mi>o</mi><mn>1</mn><mo>+</mo></msubsup></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>o</mi><mn>1</mn><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>−</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>κ</mi><mo>,</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><msub><mi>T</mi><msubsup><mi>o</mi><mn>2</mn><mo>+</mo></msubsup></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>o</mi><mn>2</mn><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\min\{\kappa,-\frac{\alpha}{T_{o^{+}_{1}}}\log\pi_{t}(o^{+}_{1}|q)\}-\min\{\kappa,-\frac{\alpha}{T_{o^{+}_{2}}}\log\pi_{t}(o^{+}_{2}|q)\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
