<span id="S4.T7.11.3.1.1" class="ltx_inline-block ltx_align_top" style="width:90.0pt;">
<span id="S4.T7.11.3.1.1.1" class="ltx_p"><span id="S4.T7.11.3.1.1.1.1" class="ltx_text" style="font-size:70%;">Claude 3 </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.T7.11.3.1.1.1.2" class="ltx_text" style="font-size:70%;">[</span><a href="#bib.bib77" title="" class="ltx_ref">77</a><span id="S4.T7.11.3.1.1.1.3" class="ltx_text" style="font-size:70%;">]</span></cite></span>
</span></td>
