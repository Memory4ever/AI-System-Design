<span id="S4.T7.11.4.1.1" class="ltx_inline-block ltx_align_top" style="width:90.0pt;">
<span id="S4.T7.11.4.1.1.1" class="ltx_p"><span id="S4.T7.11.4.1.1.1.1" class="ltx_text" style="font-size:70%;">HuatuoGPT-Vision-7B </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.T7.11.4.1.1.1.2" class="ltx_text" style="font-size:70%;">[</span><a href="#bib.bib78" title="" class="ltx_ref">78</a><span id="S4.T7.11.4.1.1.1.3" class="ltx_text" style="font-size:70%;">]</span></cite></span>
</span></td>
