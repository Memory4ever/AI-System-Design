<td id="S4.T5.5.23.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T5.5.23.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#C2E4F8;">84.25 <math id="S4.T5.m55" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#C2E4F8;" mathbackground="#C2E4F8">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.32</span></td>
