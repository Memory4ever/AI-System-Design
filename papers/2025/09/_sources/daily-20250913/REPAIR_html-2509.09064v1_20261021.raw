<span id="S3.T2.11.2.1.1" class="ltx_inline-block ltx_align_top" style="width:10.0pt;">
<span id="S3.T2.11.2.1.1.1" class="ltx_p"><span id="S3.T2.11.2.1.1.1.1" class="ltx_text" style="font-size:70%;">(a)</span></span>
