<td id="S4.T6.5.25.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T6.5.25.4.1" class="ltx_text ltx_font_bold">96.78</span></td>
<td id="S4.T6.5.25.5" class="ltx_td ltx_align_center ltx_border_b">95.22</td>
<td id="S4.T6.5.25.6" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T6.5.25.6.1" class="ltx_text ltx_font_bold">95.23</span></td></tr>
</table>
</figure>
