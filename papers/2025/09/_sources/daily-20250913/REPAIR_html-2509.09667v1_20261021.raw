<td id="S5.T2.5.1.21.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.5.1.21.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#ECECEC;">46.3</span></td>
<td id="S5.T2.5.1.21.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.5.1.21.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#ECECEC;">81.6</span></td>
<td id="S5.T2.5.1.21.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.5.1.21.6.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#ECECEC;">56.7</span></td>
