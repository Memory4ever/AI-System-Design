<td id="S5.T2.5.1.21.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.5.1.21.2.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#ECECEC;">9.7</span></td>
