<th id="S5.T3.5.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S5.T3.5.1.11.1.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">+ <span id="S5.T3.5.1.11.1.1.1" class="ltx_text ltx_font_bold">NRMF</span> (full)</span></th>
