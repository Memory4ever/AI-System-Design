<div id="S5.T7.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:496.9pt;height:107.5pt;vertical-align:-51.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-6.6pt,1.4pt) scale(0.974121410481911,0.974121410481911) ;">
