<span class="ltx_p" style="width:106.3pt;"><span class="ltx_ERROR undefined">\animategraphics</span>[loop, width=]8rebuttal_videos/video_pca/0015</span>
</span>
</td>
<td class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_justify ltx_align_top">
