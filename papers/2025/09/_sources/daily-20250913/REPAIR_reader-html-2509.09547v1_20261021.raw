<p class="ltx_p ltx_align_center">
<span class="ltx_inline-block ltx_transformed_outer" style="width:368.6pt;height:162pt;vertical-align:-78.8pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
