<tr id="S4.T9.6.4" class="ltx_tr">
<th id="S4.T9.6.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Friendly</th>
<td id="S4.T9.6.4.2" class="ltx_td ltx_align_center ltx_border_bb">0.975</td>
<td id="S4.T9.6.4.3" class="ltx_td ltx_align_center ltx_border_bb">0.972</td>
<td id="S4.T9.6.4.4" class="ltx_td ltx_align_center ltx_border_bb">0.993</td></tr>
</tbody>
</table>
</figure>
<figure id="S4.T10" class="ltx_table">

<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S4.T10.4" class="ltx_text" style="font-size:90%;">Table 10</span>: </span><span id="S4.T10.5" class="ltx_text ltx_font_italic" style="font-size:90%;">Cluster bootstrap (<math id="S4.T10.m2" class="ltx_Math" alttext="B{=}1000" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mn>1000</mn></mrow><annotation encoding="application/x-tex">B{=}1000</annotation></semantics></math>) for confirmatory statistics (percentiles).</span></figcaption><div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
