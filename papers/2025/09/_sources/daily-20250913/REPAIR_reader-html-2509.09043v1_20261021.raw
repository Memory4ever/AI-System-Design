<th id="S4.T10.6.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T10.6.1.2.1" class="ltx_text ltx_font_bold">2.5%</span></th>
<th id="S4.T10.6.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T10.6.1.3.1" class="ltx_text ltx_font_bold">50%</span></th>
<th id="S4.T10.6.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T10.6.1.4.1" class="ltx_text ltx_font_bold">97.5%</span></th></tr>
