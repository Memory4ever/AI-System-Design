{"data":{"id":"10.48550/arxiv.2509.09674","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.09674","prefix":"10.48550","suffix":"arxiv.2509.09674","identifiers":[{"identifier":"2509.09674","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.09674"}],"creators":[{"name":"Li, Haozhan","nameType":"Personal","givenName":"Haozhan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zuo, Yuxin","nameType":"Personal","givenName":"Yuxin","familyName":"Zuo","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Jiale","nameType":"Personal","givenName":"Jiale","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yuhao","nameType":"Personal","givenName":"Yuhao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Zhaohui","nameType":"Personal","givenName":"Zhaohui","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Kaiyan","nameType":"Personal","givenName":"Kaiyan","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Xuekai","nameType":"Personal","givenName":"Xuekai","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yuchen","nameType":"Personal","givenName":"Yuchen","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Tianxing","nameType":"Personal","givenName":"Tianxing","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Cui, Ganqu","nameType":"Personal","givenName":"Ganqu","familyName":"Cui","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Dehui","nameType":"Personal","givenName":"Dehui","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Luo, Dingxiang","nameType":"Personal","givenName":"Dingxiang","familyName":"Luo","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Yuchen","nameType":"Personal","givenName":"Yuchen","familyName":"Fan","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Youbang","nameType":"Personal","givenName":"Youbang","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Zeng, Jia","nameType":"Personal","givenName":"Jia","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Pang, Jiangmiao","nameType":"Personal","givenName":"Jiangmiao","familyName":"Pang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Shanghang","nameType":"Personal","givenName":"Shanghang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yu","nameType":"Personal","givenName":"Yu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Mu, Yao","nameType":"Personal","givenName":"Yao","familyName":"Mu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Bowen","nameType":"Personal","givenName":"Bowen","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Ning","nameType":"Personal","givenName":"Ning","familyName":"Ding","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SimpleVLA-RL: Scaling VLA Training via Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-11T17:59:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-12T00:49:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Vision-Language-Action (VLA) models have recently emerged as a powerful paradigm for robotic manipulation. Despite substantial progress enabled by large-scale pretraining and supervised fine-tuning (SFT), these models face two fundamental challenges: (i) the scarcity and high cost of large-scale human-operated robotic trajectories required for SFT scaling, and (ii) limited generalization to tasks involving distribution shift. Recent breakthroughs in Large Reasoning Models (LRMs) demonstrate that reinforcement learning (RL) can dramatically enhance step-by-step reasoning capabilities, raising a natural question: Can RL similarly improve the long-horizon step-by-step action planning of VLA? In this work, we introduce SimpleVLA-RL, an efficient RL framework tailored for VLA models. Building upon veRL, we introduce VLA-specific trajectory sampling, scalable parallelization, multi-environment rendering, and optimized loss computation. When applied to OpenVLA-OFT, SimpleVLA-RL achieves SoTA performance on LIBERO and even outperforms $π_0$ on RoboTwin 1.0\\\u0026amp;2.0 with the exploration-enhancing strategies we introduce. SimpleVLA-RL not only reduces dependence on large-scale data and enables robust generalization, but also remarkably surpasses SFT in real-world tasks. Moreover, we identify a novel phenomenon ``pushcut'' during RL training, wherein the policy discovers previously unseen patterns beyond those seen in the previous training process. Github: https://github.com/PRIME-RL/SimpleVLA-RL","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.09674","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-12T01:39:30.000Z","registered":"2025-09-12T01:39:31.000Z","published":"2025","updated":"2025-09-12T01:39:31.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.09674","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}