</figure>
<figure id="A7.F9" class="ltx_figure"><img src="2509.09286v1/figure/case2.png" id="A7.F9.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:476/714;" width="476" height="714" alt="Refer to caption">
