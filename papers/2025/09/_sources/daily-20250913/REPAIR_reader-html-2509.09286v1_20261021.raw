<td id="S5.T4.4.1.12.4" class="ltx_td ltx_align_center"><span id="S5.T4.4.1.12.4.1" class="ltx_text ltx_font_bold">87.9</span></td>
<td id="S5.T4.4.1.12.5" class="ltx_td ltx_align_center">44.5</td>
