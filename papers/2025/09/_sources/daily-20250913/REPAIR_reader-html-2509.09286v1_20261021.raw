<td id="S5.T6.2.4.1" class="ltx_td ltx_align_left">+ <math id="S5.T6.m6" class="ltx_Math" alttext="r_{\text{decision}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mtext>decision</mtext></msub><annotation encoding="application/x-tex">r_{\text{decision}}</annotation></semantics></math> (w/o <math id="S5.T6.m7" class="ltx_Math" alttext="r_{\text{data}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mtext>data</mtext></msub><annotation encoding="application/x-tex">r_{\text{data}}</annotation></semantics></math>)</td>
