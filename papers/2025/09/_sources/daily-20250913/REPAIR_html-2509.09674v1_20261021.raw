pan id="lstnumberx15.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">step</span><span id="lstnumberx15.17" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx15.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx15.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">actions</span><span id="lstnumberx15.20" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">)</span>
</span>
<span id="lstnumberx16" class="ltx_listingline"><span id="lstnumberx16.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">+</span><span id="lstnumberx16.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">       </span><span id="lstnumberx16.3" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#808080;">#<span id="lstnumberx16.3.1" class="ltx_text ltx_lst_space"> </span>Remove<span id="lstnumberx16.3.2" class="ltx_text ltx_lst_space"> </span>completed<span id="lstnumberx16.3.3" class="ltx_text ltx_lst_space"> </span>tasks</span>
</span>
<span id="lstnumberx17" class="ltx_listingline"><span id="lstnumberx17.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">+</span><span id="lstnumberx17.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">       </span><span id="lstnumberx17.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">active</span><span id="lstnumberx17.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">=</span><span id="lstnumberx17.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">[(</span><span id="lstnumberx17.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">e</span><span id="lstnumberx17.9" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx17.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">s</span><span id="lstnumberx17.11" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">)</span><span id="lstnumberx17.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.13" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">for</span><span id="lstnumberx17.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">e</span><span id="lstnumberx17.16" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx17.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">s</span><span id="lstnumberx17.18" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx17.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">d</span><span id="lstnumberx17.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.21" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">in</span><span id="lstnumberx17.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.23" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">zip</span><span id="lstnumberx17.24" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">(</span><span id="lstnumberx17.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">envs</span><span id="lstnumberx17.26" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx17.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">states</span><span id="lstnumberx17.28" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx17.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">dones</span><span id="lstnumberx17.30" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">)</span><span id="lstnumberx17.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.32" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">if</span><span id="lstnumberx17.33" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.34" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">not</span><span id="lstnumberx17.35" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx17.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">d</span><span id="lstnumberx17.37" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">]</span>
</span>
<span id="lstnumberx18" class="ltx_listingline"><span id="lstnumberx18.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">+</span><span id="lstnumberx18.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">       </span><span id="lstnumberx18.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">if</span><span id="lstnumberx18.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx18.5" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">not</span><span id="lstnumberx18.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx18.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">active</span><span id="lstnumberx18.8" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">:</span>
</span>
<span id="lstnumberx19" class="ltx_listingline"><span id="lstnumberx19.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">+</span><span id="lstnumberx19.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">          </span><span id="lstnumberx19.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">break</span>
</span>
<span id="lstnumberx20" class="ltx_listingline"><span id="lstnumberx20.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">+</span><span id="lstnumberx20.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">       </span><span id="lstnumberx20.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">envs</span><span id="lstnumberx20.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx20.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx20.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">states</span><span id="lstnumberx20.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx20.8" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">=</span><span id="lstnumberx20.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx20.10" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">zip</span><span id="lstnumberx20.11" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">(*</span><span id="lstnumberx20.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">active</span><span id="lstnumberx20.13" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">)</span>
</span>
</span>
