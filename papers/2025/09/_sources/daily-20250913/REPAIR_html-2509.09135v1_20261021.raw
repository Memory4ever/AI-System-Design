<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex1Xd.m2" class="ltx_Math" alttext="\displaystyle\approx\max_{u\in\mathcal{U}}\int_{t}^{t+\Delta t}e^{-\rho(\tau-t)}r(x(\tau),u(\tau))d\tau+e^{-\rho\Delta t}(\max_{u\in\mathcal{U}}\int_{t+\Delta t}^{T}e^{-\rho(\tau-t)}r(x(\tau),u(\tau))d\tau+g(x_{T}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mstyle displaystyle="true"><mmultiscripts><mo>∫</mo><mi>t</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mprescripts></mprescripts><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><mrow></mrow></mmultiscripts></mstyle><mo>⁡</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>τ</mi></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mstyle displaystyle="true"><mmultiscripts><mo>∫</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mi>T</mi><mprescripts></mprescripts><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><mrow></mrow></mmultiscripts></mstyle><mo>⁡</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>τ</mi></mrow></mrow></mrow><mo>+</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx\max_{u\in\mathcal{U}}\int_{t}^{t+\Delta t}e^{-\rho(\tau-t)}r(x(\tau),u(\tau))d\tau+e^{-\rho\Delta t}(\max_{u\in\mathcal{U}}\int_{t+\Delta t}^{T}e^{-\rho(\tau-t)}r(x(\tau),u(\tau))d\tau+g(x_{T}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex1Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex1Xe.m2" class="ltx_Math" alttext="\displaystyle\approx\max_{u\in\mathcal{U}}r(x,u)\Delta t+e^{-\rho\Delta t}\max_{u\in\mathcal{U}}V(x(t+\Delta t),t+\Delta t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mi>max</mi><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx\max_{u\in\mathcal{U}}r(x,u)\Delta t+e^{-\rho\Delta t}\max_{u\in\mathcal{U}}V(x(t+\Delta t),t+\Delta t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex1Xf"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex1Xf.m2" class="ltx_Math" alttext="\displaystyle=\max_{u\in\mathcal{U}}r(x,u)\Delta t+(1-\rho\Delta t+o(\Delta t))\max_{u\in\mathcal{U}}(V(x,t)+\partial_{t}V(x,t)\Delta t+\nabla_{x}V(x,t)^{\!\top}\!f(x,u)\Delta t+o(\Delta t))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mi>max</mi><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\max_{u\in\mathcal{U}}r(x,u)\Delta t+(1-\rho\Delta t+o(\Delta t))\max_{u\in\mathcal{U}}(V(x,t)+\partial_{t}V(x,t)\Delta t+\nabla_{x}V(x,t)^{\!\top}\!f(x,u)\Delta t+o(\Delta t))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p1.2" class="ltx_p"><span id="A1.SS1.p1.2.1" class="ltx_text">By canceling out <math id="A1.SS1.p1.m4" class="ltx_Math" alttext="V(x,t)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(x,t)</annotation></semantics></math> on both sides of the above equality, we obtain that</span></p>
<table id="A1.Ex2" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex2X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex2X.m2" class="ltx_Math" alttext="\displaystyle-\rho V(x,t)\Delta t+\partial_{t}V(x,t)\Delta t+\max_{u\in\mathcal{U}}(\nabla_{x}V(x,t)^{\!\top}\!f(x,u)+r(x,u))\Delta t+o(\Delta t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle-\rho V(x,t)\Delta t+\partial_{t}V(x,t)\Delta t+\max_{u\in\mathcal{U}}(\nabla_{x}V(x,t)^{\!\top}\!f(x,u)+r(x,u))\Delta t+o(\Delta t)=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p1.3" class="ltx_p"><span id="A1.SS1.p1.3.1" class="ltx_text">Dividing by <math id="A1.SS1.p1.m5" class="ltx_Math" alttext="\Delta t" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\Delta t</annotation></semantics></math> and letting <math id="A1.SS1.p1.m6" class="ltx_Math" alttext="\Delta t\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta t\to 0</annotation></semantics></math>, we have that</span></p>
<table id="A1.Ex3" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex3X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex3X.m2" class="ltx_Math" alttext="\displaystyle-\rho V(x,t)+\partial_{t}V(x,t)+\max_{u\in\mathcal{U}}(\nabla_{x}V(x,t)^{\!\top}\!f(x,u)+r(x,u))=0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><munder><mi>max</mi><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\rho V(x,t)+\partial_{t}V(x,t)+\max_{u\in\mathcal{U}}(\nabla_{x}V(x,t)^{\!\top}\!f(x,u)+r(x,u))=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p1.4" class="ltx_p"><span id="A1.SS1.p1.4.1" class="ltx_text">Therefore, the <math id="A1.SS1.p1.m7" class="ltx_Math" alttext="V(x,t)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(x,t)</annotation></semantics></math> is the optimal solution to the following HJB PDEs:</span></p>
<table id="A1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex4.m1" class="ltx_Math" alttext="-\rho V(x,t)+\partial_{t}V(x,t)+\nabla_{x}V(x,t)^{\!\top}\!f(x,u^{*})+r(x,u^{*})=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>u</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>u</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">-\rho V(x,t)+\partial_{t}V(x,t)+\nabla_{x}V(x,t)^{\!\top}\!f(x,u^{*})+r(x,u^{*})=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p1.5" class="ltx_p"><span id="A1.SS1.p1.5.1" class="ltx_text">with boundary condition <math id="A1.SS1.p1.m8" class="ltx_Math" alttext="V(x,T)=g(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V(x,T)=g(x)</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS1.p2" class="ltx_para">
<p id="A1.SS1.p2.1" class="ltx_p"><span id="A1.SS1.p2.1.1" class="ltx_text">Here optimal control input is <math id="A1.SS1.p2.m1" class="ltx_Math" alttext="u^{*}=\argmax_{u\in\mathcal{U}}\mathcal{H}(x,t,\nabla_{x}V(x,t))" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></msub><mo>⁡</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u^{*}=\argmax_{u\in\mathcal{U}}\mathcal{H}(x,t,\nabla_{x}V(x,t))</annotation></semantics></math>, where <math id="A1.SS1.p2.m2" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> is the Hamiltonian defined as <math id="A1.SS1.p2.m3" class="ltx_Math" alttext="\mathcal{H}=\nabla_{x}V(x,t)^{\!\top}\!f(x,u)+r(x,u)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>=</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}=\nabla_{x}V(x,t)^{\!\top}\!f(x,u)+r(x,u)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Proof of Lemma <a href="#S3.Thmtheorem2" title="Lemma 3.2 (Instantaneous Advantage). ‣ 3.2.2 Policy Learning ‣ 3.2 HJB and Policy Learning ‣ 3 Methodology ‣ Continuous-Time Value Iteration for Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a></h3>

<div id="A1.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p1" class="ltx_para">
<p id="A1.SS2.p1.1" class="ltx_p"><span id="A1.SS2.p1.1.1" class="ltx_text">Recall the one-step <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-function over a short interval <math id="A1.SS2.p1.m2" class="ltx_Math" alttext="\delta t&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta t&gt;0</annotation></semantics></math>, where <math id="A1.SS2.p1.m3" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is the optimal control input.</span></p>
<table id="A1.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex5.m1" class="ltx_Math" alttext="Q(x,t,u)=r(x,u)\,\delta t+e^{-\rho\delta t}\,V\bigl(x(t+\delta t),\,t+\delta t\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q(x,t,u)=r(x,u)\,\delta t+e^{-\rho\delta t}\,V\bigl(x(t+\delta t),\,t+\delta t\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p2" class="ltx_para">
<p id="A1.SS2.p2.1" class="ltx_p"><span id="A1.SS2.p2.1.1" class="ltx_text">For small <math id="A1.SS2.p2.m1" class="ltx_Math" alttext="\delta t" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\delta t</annotation></semantics></math> we have the first-order Taylor expansion in both state and time:</span></p>
<table id="A1.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex6.m1" class="ltx_Math" alttext="V\bigl(x(t+\delta t),\,t+\delta t\bigr)=V(x,t)+\nabla_{x}V(x,t)^{\!\top}\!f(x,u)\,\delta t+\partial_{t}V(x,t)\,\delta t+o(\delta t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V\bigl(x(t+\delta t),\,t+\delta t\bigr)=V(x,t)+\nabla_{x}V(x,t)^{\!\top}\!f(x,u)\,\delta t+\partial_{t}V(x,t)\,\delta t+o(\delta t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p3" class="ltx_para">
<p id="A1.SS2.p3.1" class="ltx_p"><span id="A1.SS2.p3.1.1" class="ltx_text">Similarly,
<math id="A1.SS2.p3.m1" class="ltx_Math" alttext="e^{-\rho\delta t}=1-\rho\,\delta t+o(\delta t)" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo>=</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">e^{-\rho\delta t}=1-\rho\,\delta t+o(\delta t)</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p4" class="ltx_para">
<p id="A1.SS2.p4.1" class="ltx_p"><span id="A1.SS2.p4.1.1" class="ltx_text">Plugging both expansions into <math id="A1.SS2.p4.m1" class="ltx_Math" alttext="Q(x,t,u)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(x,t,u)</annotation></semantics></math> gives</span></p>
<table id="A1.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\displaystyle Q(x,t,u)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q(x,t,u)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex7.m2" class="ltx_Math" alttext="\displaystyle=r(x,u)\,\delta t+\bigl(1-\rho\,\delta t+o(\delta t)\bigr)\Bigl[V(x,t)+\nabla_{x}V(x,t)^{\!\top}f(x,u)\,\delta t+\partial_{t}V(x,t)\,\delta t+o(\delta t)\Bigr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=r(x,u)\,\delta t+\bigl(1-\rho\,\delta t+o(\delta t)\bigr)\Bigl[V(x,t)+\nabla_{x}V(x,t)^{\!\top}f(x,u)\,\delta t+\partial_{t}V(x,t)\,\delta t+o(\delta t)\Bigr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex8.m1" class="ltx_Math" alttext="\displaystyle=r(x,u)\,\delta t+V(x,t)+\bigl[\nabla_{x}V(x,t)^{\!\top}f(x,u)+\partial_{t}V(x,t)-\rho V(x,t)\bigr]\delta t+o(\delta t)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=r(x,u)\,\delta t+V(x,t)+\bigl[\nabla_{x}V(x,t)^{\!\top}f(x,u)+\partial_{t}V(x,t)-\rho V(x,t)\bigr]\delta t+o(\delta t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p5" class="ltx_para">
<p id="A1.SS2.p5.1" class="ltx_p"><span id="A1.SS2.p5.1.1" class="ltx_text">Subtract <math id="A1.SS2.p5.m1" class="ltx_Math" alttext="V(x,t)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(x,t)</annotation></semantics></math> and discard the higher-order term:</span></p>
<table id="A1.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex9.m1" class="ltx_Math" alttext="Q(x,t,u)-V(x,t)=[-\rho V(x,t)+\partial_{t}V(x,t)+\nabla_{x}V(x,t)^{\!\top}f(x,u)+r(x,u)]\delta t+o(\delta t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q(x,t,u)-V(x,t)=[-\rho V(x,t)+\partial_{t}V(x,t)+\nabla_{x}V(x,t)^{\!\top}f(x,u)+r(x,u)]\delta t+o(\delta t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p5.2" class="ltx_p"><span id="A1.SS2.p5.2.1" class="ltx_text">Dividing by <math id="A1.SS2.p5.m2" class="ltx_Math" alttext="\delta t" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\delta t</annotation></semantics></math> and letting <math id="A1.SS2.p5.m3" class="ltx_Math" alttext="\delta t\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta t\to 0</annotation></semantics></math> yields the instantaneous advantage density</span></p>
<table id="A1.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex10.m1" class="ltx_Math" alttext="A(x,t,u)=\lim_{\delta t\to 0}\frac{Q(x,t,u)-V(x,t)}{\delta t}=-\rho V(x,t)+\partial_{t}V(x,t)+\nabla_{x}V(x,t)^{\!\top}f(x,u)+r(x,u)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mfrac><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A(x,t,u)=\lim_{\delta t\to 0}\frac{Q(x,t,u)-V(x,t)}{\delta t}=-\rho V(x,t)+\partial_{t}V(x,t)+\nabla_{x}V(x,t)^{\!\top}f(x,u)+r(x,u).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p5.3" class="ltx_p"><span id="A1.SS2.p5.3.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Proof of Lemma <a href="#S3.Thmtheorem3" title="Lemma 3.3 (Policy Improvement). ‣ 3.2.2 Policy Learning ‣ 3.2 HJB and Policy Learning ‣ 3 Methodology ‣ Continuous-Time Value Iteration for Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a></h3>

<div id="A1.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Policy Improvement via State-Action Value Function.</h6>
<div id="A1.SS3.p1" class="ltx_para">
<p id="A1.SS3.p1.1" class="ltx_p"><span id="A1.SS3.p1.1.1" class="ltx_text">We consider the standard policy improvement step, where the new policy is obtained by maximizing the state-action value function:</span></p>
<table id="A1.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex11.m1" class="ltx_Math" alttext="\pi_{\text{new}}(x,t)=\arg\max_{u\in\mathcal{U}}Q^{\pi_{\text{old}}}(x,t,u)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mtext>new</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>Q</mi><msub><mi>π</mi><mtext>old</mtext></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi_{\text{new}}(x,t)=\arg\max_{u\in\mathcal{U}}Q^{\pi_{\text{old}}}(x,t,u),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p1.2" class="ltx_p"><span id="A1.SS3.p1.2.1" class="ltx_text">where the one-step Q-function with a small <math id="A1.SS3.p1.m1" class="ltx_Math" alttext="\delta t&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta t&gt;0</annotation></semantics></math> is defined as:</span></p>
<table id="A1.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\displaystyle Q(x,t,u)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q(x,t,u)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex12.m2" class="ltx_Math" alttext="\displaystyle=r(x,u)\,\delta t+e^{-\rho\delta t}V\bigl(x(t+\delta t),t+\delta t\bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=r(x,u)\,\delta t+e^{-\rho\delta t}V\bigl(x(t+\delta t),t+\delta t\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13.m1" class="ltx_math_unparsed" alttext="\displaystyle=r(x,u)\,\delta t+e^{-\rho\delta t}\mathbb{E}_{u^{\prime}\sim\pi(\cdot\mid x^{\prime})}\left[Q(x^{\prime},t+\delta t,u^{\prime})\right]," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>u</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>δ</mi><mi>t</mi><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><msub><mi>𝔼</mi><mrow><mi>u</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mi>Q</mi><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><mi>t</mi><mo>+</mo><mi>δ</mi><mi>t</mi><mo>,</mo><msup><mi>u</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=r(x,u)\,\delta t+e^{-\rho\delta t}\mathbb{E}_{u^{\prime}\sim\pi(\cdot\mid x^{\prime})}\left[Q(x^{\prime},t+\delta t,u^{\prime})\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p1.3" class="ltx_p"><span id="A1.SS3.p1.3.1" class="ltx_text">Since we assume the goal state function stays invariant, we only define the <math id="A1.SS3.p1.m2" class="ltx_Math" alttext="Q^{\pi}=\int_{0}^{T}e^{-\rho t}r_{t}dt" display="inline" intent=":literal"><semantics><mrow><msup><mi>Q</mi><mi>π</mi></msup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>T</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Q^{\pi}=\int_{0}^{T}e^{-\rho t}r_{t}dt</annotation></semantics></math>.
Because the new policy <math id="A1.SS3.p1.m3" class="ltx_Math" alttext="\pi^{\text{new}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mtext>new</mtext></msup><annotation encoding="application/x-tex">\pi^{\text{new}}</annotation></semantics></math> yields equal or higher value in expectation:</span></p>
<table id="A1.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\mathbb{E}_{u\sim\pi_{\text{new}}}\left[Q^{\pi_{\text{old}}}(x,t,u)\right]\geq\mathbb{E}_{u\sim\pi_{\text{old}}}\left[Q^{\pi_{\text{old}}}(x,t,u)\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>u</mi><mo>∼</mo><msub><mi>π</mi><mtext>new</mtext></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>Q</mi><msub><mi>π</mi><mtext>old</mtext></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>𝔼</mi><mrow><mi>u</mi><mo>∼</mo><msub><mi>π</mi><mtext>old</mtext></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>Q</mi><msub><mi>π</mi><mtext>old</mtext></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{u\sim\pi_{\text{new}}}\left[Q^{\pi_{\text{old}}}(x,t,u)\right]\geq\mathbb{E}_{u\sim\pi_{\text{old}}}\left[Q^{\pi_{\text{old}}}(x,t,u)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p1.4" class="ltx_p"><span id="A1.SS3.p1.4.1" class="ltx_text">Then we can have:</span></p>
<table id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\begin{aligned} Q^{\pi_{\text{old}}}&amp;=r_{0}\,\delta t+e^{-\rho\delta t}(\mathbb{E}_{u_{1}\sim\pi_{\text{old}}}\left[Q^{\pi_{\text{old}}}(x_{1},t_{1},u_{1})\right])\\
&amp;\leq r_{0}\,\delta t+e^{-\rho\delta t}\left(\mathbb{E}_{u_{1}\sim\pi_{\text{new}}}\left[Q^{\pi_{\text{old}}}(x_{1},t_{1},u_{1})\right]\right)\\
&amp;=r_{0}\,\delta t+e^{-\rho t_{1}}r_{1}\,\delta t+e^{-\rho\delta t}\left(\mathbb{E}_{u_{2}\sim\pi_{\text{old}}}\left[Q^{\pi_{\text{old}}}(x_{2},t_{2},u_{2})\right]\right)\\
&amp;\leq r_{0}\,\delta t+e^{-\rho t_{1}}r_{1}\,\delta t+e^{-\rho\delta t}\left(\mathbb{E}_{u_{2}\sim\pi_{\text{new}}}\left[Q^{\pi_{\text{old}}}(x_{2},t_{2},u_{2})\right]\right)\\
&amp;=r_{0}\,\delta t+e^{-\rho t_{1}}r_{1}\,\delta t+e^{-\rho t_{2}}r_{2}\,\delta t+e^{-\rho\delta t}\left(\mathbb{E}_{u_{3}\sim\pi_{\text{old}}}\left[Q^{\pi_{\text{old}}}(x_{3},t_{3},u_{3})\right]\right)\\
&amp;\vdots\\
&amp;\leq\int_{0}^{T}e^{-\rho t}r_{t}dt\\
&amp;=Q^{\pi_{\text{new}}}.\end{aligned}." display="block" intent=":literal"><semantics><mrow><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msup><mi>Q</mi><msub><mi>π</mi><mtext>old</mtext></msub></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>r</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>π</mi><mtext>old</mtext></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>Q</mi><msub><mi>π</mi><mtext>old</mtext></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><msub><mi>u</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>r</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>π</mi><mtext>new</mtext></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>Q</mi><msub><mi>π</mi><mtext>old</mtext></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><msub><mi>u</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>r</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>u</mi><mn>2</mn></msub><mo>∼</mo><msub><mi>π</mi><mtext>old</mtext></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>Q</mi><msub><mi>π</mi><mtext>old</mtext></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo>,</mo><msub><mi>u</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>r</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>u</mi><mn>2</mn></msub><mo>∼</mo><msub><mi>π</mi><mtext>new</mtext></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>Q</mi><msub><mi>π</mi><mtext>old</mtext></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo>,</mo><msub><mi>u</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>r</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>2</mn></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi>u</mi><mn>3</mn></msub><mo>∼</mo><msub><mi>π</mi><mtext>old</mtext></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>Q</mi><msub><mi>π</mi><mtext>old</mtext></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>3</mn></msub><mo>,</mo><msub><mi>t</mi><mn>3</mn></msub><mo>,</mo><msub><mi>u</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">≤</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>T</mi></msubsup><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mi>Q</mi><msub><mi>π</mi><mtext>new</mtext></msub></msup></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\begin{aligned} Q^{\pi_{\text{old}}}&amp;=r_{0}\,\delta t+e^{-\rho\delta t}(\mathbb{E}_{u_{1}\sim\pi_{\text{old}}}\left[Q^{\pi_{\text{old}}}(x_{1},t_{1},u_{1})\right])\\
&amp;\leq r_{0}\,\delta t+e^{-\rho\delta t}\left(\mathbb{E}_{u_{1}\sim\pi_{\text{new}}}\left[Q^{\pi_{\text{old}}}(x_{1},t_{1},u_{1})\right]\right)\\
&amp;=r_{0}\,\delta t+e^{-\rho t_{1}}r_{1}\,\delta t+e^{-\rho\delta t}\left(\mathbb{E}_{u_{2}\sim\pi_{\text{old}}}\left[Q^{\pi_{\text{old}}}(x_{2},t_{2},u_{2})\right]\right)\\
&amp;\leq r_{0}\,\delta t+e^{-\rho t_{1}}r_{1}\,\delta t+e^{-\rho\delta t}\left(\mathbb{E}_{u_{2}\sim\pi_{\text{new}}}\left[Q^{\pi_{\text{old}}}(x_{2},t_{2},u_{2})\right]\right)\\
&amp;=r_{0}\,\delta t+e^{-\rho t_{1}}r_{1}\,\delta t+e^{-\rho t_{2}}r_{2}\,\delta t+e^{-\rho\delta t}\left(\mathbb{E}_{u_{3}\sim\pi_{\text{old}}}\left[Q^{\pi_{\text{old}}}(x_{3},t_{3},u_{3})\right]\right)\\
&amp;\vdots\\
&amp;\leq\int_{0}^{T}e^{-\rho t}r_{t}dt\\
&amp;=Q^{\pi_{\text{new}}}.\end{aligned}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p1.5" class="ltx_p"><span id="A1.SS3.p1.5.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Derivation of Definition <a href="#Thmdefinition2" title="Definition 2 (VGI Gradient Estimator). ‣ 3.3 Value Gradient Iteration Module ‣ 3 Methodology ‣ Continuous-Time Value Iteration for Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="A1.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS4.p1" class="ltx_para">
<p id="A1.SS4.p1.1" class="ltx_p"><span id="A1.SS4.p1.1.1" class="ltx_text">We consider the value function defined in Eq. (<a href="#S3.E2" title="In Definition 1 (Value Function of Multi-agent Systems). ‣ 3.1 Problem Formulation ‣ 3 Methodology ‣ Continuous-Time Value Iteration for Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) and follow the Proof of Lemma <a href="#S3.Thmtheorem1" title="Lemma 3.1 (HJB for Multi-agent Systems). ‣ 3.2.1 Critic Learning with HJB. ‣ 3.2 HJB and Policy Learning ‣ 3 Methodology ‣ Continuous-Time Value Iteration for Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> to write out the dynamic programming principle of <math id="A1.SS4.p1.m1" class="ltx_Math" alttext="V(x,t)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(x,t)</annotation></semantics></math> as:</span></p>
<table id="A1.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex16.m1" class="ltx_Math" alttext="V(x_{t},t)=r(x_{t},u_{t})\Delta t+e^{-\rho\Delta t}V(x_{t+\Delta t},t+\Delta t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V(x_{t},t)=r(x_{t},u_{t})\Delta t+e^{-\rho\Delta t}V(x_{t+\Delta t},t+\Delta t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p1.2" class="ltx_p"><span id="A1.SS4.p1.2.1" class="ltx_text">where <math id="A1.SS4.p1.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is the optimal control input. Taking the gradient with respect to <math id="A1.SS4.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> on both sides using the chain rule:</span></p>
<table id="A1.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\nabla_{x}V(x_{t},t)=\nabla_{x}r(x_{t},u_{t})\Delta t+e^{-\rho\Delta t}\nabla_{x}f(x_{t},u_{t})^{\top}\nabla_{x}V(x_{t+\Delta t},t+\Delta t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>r</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{x}V(x_{t},t)=\nabla_{x}r(x_{t},u_{t})\Delta t+e^{-\rho\Delta t}\nabla_{x}f(x_{t},u_{t})^{\top}\nabla_{x}V(x_{t+\Delta t},t+\Delta t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS4.p2" class="ltx_para">
<p id="A1.SS4.p2.1" class="ltx_p"><span id="A1.SS4.p2.1.1" class="ltx_text">which matches the estimator proposed in Definition <a href="#Thmdefinition2" title="Definition 2 (VGI Gradient Estimator). ‣ 3.3 Value Gradient Iteration Module ‣ 3 Methodology ‣ Continuous-Time Value Iteration for Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>Proof of Theorem <a href="#S3.Thmtheorem4" title="Theorem 3.4 (Convergence of VGI). ‣ 3.3 Value Gradient Iteration Module ‣ 3 Methodology ‣ Continuous-Time Value Iteration for Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a></h3>

<div id="A1.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS5.p1" class="ltx_para">
<p id="A1.SS5.p1.1" class="ltx_p"><span id="A1.SS5.p1.1.1" class="ltx_text">From VGI in definition <a href="#Thmdefinition2" title="Definition 2 (VGI Gradient Estimator). ‣ 3.3 Value Gradient Iteration Module ‣ 3 Methodology ‣ Continuous-Time Value Iteration for Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, with an Euler step gives
<math id="A1.SS5.p1.m1" class="ltx_Math" alttext="x_{t+\Delta t}=x_{t}+f(x_{t},u_{t})\Delta t+o(\Delta t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>=</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>+</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{t+\Delta t}=x_{t}+f(x_{t},u_{t})\Delta t+o(\Delta t)</annotation></semantics></math>, we have the
first-order-accurate VGI approximation:</span></p>
<table id="A1.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex18.m1" class="ltx_Math" alttext="\nabla_{x}V(x_{t},t)=\nabla_{x}r(x_{t},u_{t})\Delta t+e^{-\rho\Delta t}\bigl[I+\nabla_{x}f(x_{t},u_{t})\Delta t\bigr]^{\!\top}\nabla_{x}V(x_{t+\Delta t},t+\Delta t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>r</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>I</mi><mo>+</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{x}V(x_{t},t)=\nabla_{x}r(x_{t},u_{t})\Delta t+e^{-\rho\Delta t}\bigl[I+\nabla_{x}f(x_{t},u_{t})\Delta t\bigr]^{\!\top}\nabla_{x}V(x_{t+\Delta t},t+\Delta t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS5.p2" class="ltx_para">
<p id="A1.SS5.p2.1" class="ltx_p"><span id="A1.SS5.p2.1.1" class="ltx_text">Rewrite VGI approximation as the affine map
<math id="A1.SS5.p2.m1" class="ltx_Math" alttext="\zeta=G(\zeta)" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>=</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta=G(\zeta)</annotation></semantics></math>
with</span></p>
<table id="A1.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex19.m1" class="ltx_Math" alttext="b=\nabla_{x}r(x_{t},u_{t})\Delta t,\;A=e^{-\rho\Delta t}\bigl[I+\nabla_{x}f(x_{t},u_{t})\Delta t\bigr]^{\!\top},\;\zeta=\nabla_{x}V(\cdot,\cdot)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>b</mi><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>r</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mi>A</mi><mo>=</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>I</mi><mo>+</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mi>ζ</mi><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">b=\nabla_{x}r(x_{t},u_{t})\Delta t,\;A=e^{-\rho\Delta t}\bigl[I+\nabla_{x}f(x_{t},u_{t})\Delta t\bigr]^{\!\top},\;\zeta=\nabla_{x}V(\cdot,\cdot).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p2.2" class="ltx_p"><span id="A1.SS5.p2.2.1" class="ltx_text">Assume the dynamics have a bounded Jacobian
<math id="A1.SS5.p2.m2" class="ltx_Math" alttext="\|\nabla_{x}f(x_{t},u_{t})\|\leq L_{f}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><annotation encoding="application/x-tex">\|\nabla_{x}f(x_{t},u_{t})\|\leq L_{f}</annotation></semantics></math>.
Then</span></p>
<table id="A1.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex20.m1" class="ltx_Math" alttext="\|A\|\leq e^{-\rho\Delta t}(1+L_{f}\Delta t)=\beta." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><mi>A</mi><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>β</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|A\|\leq e^{-\rho\Delta t}(1+L_{f}\Delta t)=\beta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p2.3" class="ltx_p"><span id="A1.SS5.p2.3.1" class="ltx_text">Because we study high-frequency settings, <math id="A1.SS5.p2.m3" class="ltx_Math" alttext="\Delta t" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\Delta t</annotation></semantics></math> is chosen
sufficiently small, which makes <math id="A1.SS5.p2.m4" class="ltx_Math" alttext="L_{f}\Delta t\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L_{f}\Delta t\to 0</annotation></semantics></math>, so that <math id="A1.SS5.p2.m5" class="ltx_Math" alttext="\beta&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta&lt;1</annotation></semantics></math>.
For any <math id="A1.SS5.p2.m6" class="ltx_Math" alttext="\zeta_{1},\zeta_{2}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>ζ</mi><mn>2</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\zeta_{1},\zeta_{2}\in\mathbb{R}^{d}</annotation></semantics></math>,</span></p>
<table id="A1.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex21.m1" class="ltx_Math" alttext="\|G(\zeta_{1})-G(\zeta_{2})\|=\|A(\zeta_{1}-\zeta_{2})\|\leq\beta\|\zeta_{1}-\zeta_{2}\|," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ζ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>=</mo><mrow><mo stretchy="false">‖</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ζ</mi><mn>1</mn></msub><mo>−</mo><msub><mi>ζ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>ζ</mi><mn>1</mn></msub><mo>−</mo><msub><mi>ζ</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|G(\zeta_{1})-G(\zeta_{2})\|=\|A(\zeta_{1}-\zeta_{2})\|\leq\beta\|\zeta_{1}-\zeta_{2}\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p2.4" class="ltx_p"><span id="A1.SS5.p2.4.1" class="ltx_text">Hence, <math id="A1.SS5.p2.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a contraction.
Banach’s fixed-point theorem guarantees a unique fixed point
<math id="A1.SS5.p2.m8" class="ltx_Math" alttext="\zeta^{\ast}" display="inline" intent=":literal"><semantics><msup><mi>ζ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\zeta^{\ast}</annotation></semantics></math> and linear convergence
<math id="A1.SS5.p2.m9" class="ltx_Math" alttext="\|\zeta^{(k)}-\zeta^{\ast}\|\leq\beta^{\,k}\|\zeta^{(0)}-\zeta^{\ast}\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>ζ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><msup><mi>β</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>ζ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\zeta^{(k)}-\zeta^{\ast}\|\leq\beta^{\,k}\|\zeta^{(0)}-\zeta^{\ast}\|</annotation></semantics></math>.
Therefore, the value-gradient iteration converges, completing the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.6 </span>Training Algorithm</h3>

<div id="A1.SS6.p1" class="ltx_para">
<p id="A1.SS6.p1.1" class="ltx_p">We present the training algorithm for our proposed approach, Value Iteration via PINN (VIP), as follows:</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Value Iteration via PINN (VIP)</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg1.l1.3" class="ltx_text ltx_font_bold">Init:</span>
value net <math id="alg1.l1.m1" class="ltx_Math" alttext="V_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">V_{\theta}</annotation></semantics></math>, policy nets <math id="alg1.l1.m2" class="ltx_Math" alttext="\{\pi_{\omega_{i}}\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>π</mi><msub><mi>ω</mi><mi>i</mi></msub></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{\pi_{\omega_{i}}\}_{i=1}^{N}</annotation></semantics></math>,
dynamics <math id="alg1.l1.m3" class="ltx_Math" alttext="\hat{f}_{\psi}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>ψ</mi></msub><annotation encoding="application/x-tex">\hat{f}_{\psi}</annotation></semantics></math>, reward <math id="alg1.l1.m4" class="ltx_Math" alttext="\hat{r}_{\phi}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>r</mi><mo>^</mo></mover><mi>ϕ</mi></msub><annotation encoding="application/x-tex">\hat{r}_{\phi}</annotation></semantics></math>

</div>
