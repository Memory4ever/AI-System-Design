               compute <math id="alg1.l22.m1" class="ltx_Math" alttext="A(x,t,u)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A(x,t,u)</annotation></semantics></math> for all <math id="alg1.l22.m2" class="ltx_Math" alttext="(x,t,u)\in\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">(x,t,u)\in\mathcal{R}</annotation></semantics></math>

