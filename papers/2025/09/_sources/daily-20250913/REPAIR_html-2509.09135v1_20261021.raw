              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg1.l2.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l2.m1" class="ltx_Math" alttext="l=1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">l=1,\dots,T</annotation></semantics></math> <span id="alg1.l2.4" class="ltx_text ltx_font_bold">do</span>

