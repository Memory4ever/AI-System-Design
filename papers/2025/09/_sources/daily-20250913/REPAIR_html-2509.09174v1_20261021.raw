<div id="lstnumberx277" class="ltx_listingline"><span id="lstnumberx277.1" class="ltx_text ltx_lst_string ltx_font_typewriter">"According<span id="lstnumberx277.1.1" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx277.1.2" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx277.1.3" class="ltx_text ltx_lst_space"> </span>latest<span id="lstnumberx277.1.4" class="ltx_text ltx_lst_space"> </span>statistics<span id="lstnumberx277.1.5" class="ltx_text ltx_lst_space"> </span>from<span id="lstnumberx277.1.6" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx277.1.7" class="ltx_text ltx_lst_space"> </span>International<span id="lstnumberx277.1.8" class="ltx_text ltx_lst_space"> </span>Energy<span id="lstnumberx277.1.9" class="ltx_text ltx_lst_space"> </span>Agency<span id="lstnumberx277.1.10" class="ltx_text ltx_lst_space"> </span>(IEA)"</span><span id="lstnumberx277.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx277.3" class="ltx_text ltx_font_typewriter">-&gt;</span><span id="lstnumberx277.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx277.5" class="ltx_text ltx_lst_string ltx_font_typewriter">"According<span id="lstnumberx277.5.1" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx277.5.2" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx277.5.3" class="ltx_text ltx_lst_space"> </span>latest<span id="lstnumberx277.5.4" class="ltx_text ltx_lst_space"> </span>statistics<span id="lstnumberx277.5.5" class="ltx_text ltx_lst_space"> </span>from<span id="lstnumberx277.5.6" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx277.5.7" class="ltx_text ltx_lst_space"> </span>International<span id="lstnumberx277.5.8" class="ltx_text ltx_lst_space"> </span>Energy<span id="lstnumberx277.5.9" class="ltx_text ltx_lst_space"> </span>Agency"</span>
