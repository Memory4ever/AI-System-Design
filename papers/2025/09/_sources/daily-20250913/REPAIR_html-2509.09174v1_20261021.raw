<td id="S5.T6.2.8.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;">Offline</td>
<td id="S5.T6.2.8.2" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;">175.34</td>
<td id="S5.T6.2.8.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;">64.0</td>
<td id="S5.T6.2.8.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;">38.3</td>
<td id="S5.T6.2.8.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;">32.1</td>
