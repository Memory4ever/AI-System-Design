<td id="S5.T6.2.5.6" class="ltx_td" style="padding-left:2.3pt;padding-right:2.3pt;"></td></tr>
<tr id="S5.T6.2.6" class="ltx_tr">
<td id="S5.T6.2.6.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;" colspan="5">EchoX-8B</td>
<td id="S5.T6.2.6.2" class="ltx_td ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;"></td></tr>
<tr id="S5.T6.2.7" class="ltx_tr">
<td id="S5.T6.2.7.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">Streaming</td>
<td id="S5.T6.2.7.2" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">29.79</td>
<td id="S5.T6.2.7.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">62.0</td>
<td id="S5.T6.2.7.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">38.2</td>
<td id="S5.T6.2.7.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">31.7</td>
<td id="S5.T6.2.7.6" class="ltx_td ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;"></td></tr>
