<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2 </span>Acoustic-Semantic Gap</h3>

<figure id="S5.F6" class="ltx_figure ltx_align_floatright" style="width:39%;"><span class="ltx_inline-block"><svg id="S5.F6.pic1" class="ltx_picture ltx_centering" height="122.6" overflow="visible" version="1.1" viewBox="0 0 329.81 122.6" width="329.81"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,122.6) matrix(1 0 0 -1 0 0) translate(18.42,0) translate(0,21.8) matrix(1.0 0.0 0.0 1.0 -18.42 -21.8)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(61.44,0) translate(0,21.8)"><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt"><path style="fill:none" d="M -43.02 22.13 L 114.71 22.13 M -43.02 44.25 L 114.71 44.25 M -43.02 66.38 L 114.71 66.38"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M 0 0 L 0 5.91 M 71.7 0 L 71.7 5.91 M 0 75.23 L 0 69.33 M 71.7 75.23 L 71.7 69.33"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M -43.02 22.13 L -37.11 22.13 M -43.02 44.25 L -37.11 44.25 M -43.02 66.38 L -37.11 66.38 M 114.71 22.13 L 108.81 22.13 M 114.71 44.25 L 108.81 44.25 M 114.71 66.38 L 108.81 66.38"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt"><path style="fill:none" d="M -43.02 0 L -43.02 75.23 L 114.71 75.23 L 114.71 0 L -43.02 0 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.67 -14.5)"><foreignObject style="--ltx-fo-width:4.72em;--ltx-fo-