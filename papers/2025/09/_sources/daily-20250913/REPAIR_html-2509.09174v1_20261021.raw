<div id="lstnumberx178" class="ltx_listingline"><span id="lstnumberx178.1" class="ltx_text ltx_lst_string ltx_font_typewriter">"I<span id="lstnumberx178.1.1" class="ltx_text ltx_lst_space"> </span>prefer<span id="lstnumberx178.1.2" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx178.1.3" class="ltx_text ltx_lst_space"> </span>movie<span id="lstnumberx178.1.4" class="ltx_text ltx_lst_space"> </span>’The<span id="lstnumberx178.1.5" class="ltx_text ltx_lst_space"> </span>Wandering<span id="lstnumberx178.1.6" class="ltx_text ltx_lst_space"> </span>Earth’<span id="lstnumberx178.1.7" class="ltx_text ltx_lst_space"> </span>because<span id="lstnumberx178.1.8" class="ltx_text ltx_lst_space"> </span>it<span id="lstnumberx178.1.9" class="ltx_text ltx_lst_space"> </span>was<span id="lstnumberx178.1.10" class="ltx_text ltx_lst_space"> </span>so<span id="lstnumberx178.1.11" class="ltx_text ltx_lst_space"> </span>impactful<span id="lstnumberx178.1.12" class="ltx_text ltx_lst_space"> </span>for<span id="lstnumberx178.1.13" class="ltx_text ltx_lst_space"> </span>me."</span>
