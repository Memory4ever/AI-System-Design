<div id="lstnumberx279" class="ltx_listingline"><span id="lstnumberx279.1" class="ltx_text ltx_lst_string ltx_font_typewriter">"We<span id="lstnumberx279.1.1" class="ltx_text ltx_lst_space"> </span>will<span id="lstnumberx279.1.2" class="ltx_text ltx_lst_space"> </span>go<span id="lstnumberx279.1.3" class="ltx_text ltx_lst_space"> </span>hiking<span id="lstnumberx279.1.4" class="ltx_text ltx_lst_space"> </span>(if<span id="lstnumberx279.1.5" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx279.1.6" class="ltx_text ltx_lst_space"> </span>weather<span id="lstnumberx279.1.7" class="ltx_text ltx_lst_space"> </span>is<span id="lstnumberx279.1.8" class="ltx_text ltx_lst_space"> </span>good)"</span><span id="lstnumberx279.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx279.3" class="ltx_text ltx_font_typewriter">-&gt;</span><span id="lstnumberx279.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx279.5" class="ltx_text ltx_lst_string ltx_font_typewriter">"We<span id="lstnumberx279.5.1" class="ltx_text ltx_lst_space"> </span>will<span id="lstnumberx279.5.2" class="ltx_text ltx_lst_space"> </span>go<span id="lstnumberx279.5.3" class="ltx_text ltx_lst_space"> </span>hiking<span id="lstnumberx279.5.4" class="ltx_text ltx_lst_space"> </span>if<span id="lstnumberx279.5.5" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx279.5.6" class="ltx_text ltx_lst_space"> </span>weather<span id="lstnumberx279.5.7" class="ltx_text ltx_lst_space"> </span>is<span id="lstnumberx279.5.8" class="ltx_text ltx_lst_space"> </span>good."</span>
