<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S8.SS3" title="In VIII Evaluation ‣ ENSI: Efficient Non-Interactive Secure Inference for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VIII-C</span> </span><span class="ltx_text ltx_font_italic">Microbenchmarks</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S8.SS4" title="In VIII Evaluation ‣ ENSI: Efficient Non-Interactive Secure Inference for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VIII-D</span> </span><span class="ltx_text ltx_font_italic">End-to-End Benchmark.</span></span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S9" title="In ENSI: Efficient Non-Interactive Secure Inference for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">IX </span><span class="ltx_text ltx_font_smallcaps">Conclusion</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In ENSI: Efficient Non-Interactive Secure Inference for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
</ol></nav>
</nav>
<div class="ltx_page_main">
<div id="infobox" class="infobox">
  <a id="license-tr" href="https://info.arxiv.org/help/license/index.html#licenses-available">
