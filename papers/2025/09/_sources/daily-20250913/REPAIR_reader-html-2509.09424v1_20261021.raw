<td id="S8.T3.2.1.17.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-top:2.5pt;padding-bottom:2.5pt;"><math id="S8.T3.m35" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td>
