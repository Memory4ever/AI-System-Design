<td id="S8.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">6.8</td>
<td id="S8.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">17</td></tr>
<tr id="S8.T2.2.3" class="ltx_tr">
<td id="S8.T2.2.3.1" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">60</td>
<td id="S8.T2.2.3.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">4.0e-6</td>
<td id="S8.T2.2.3.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">6.2</td>
<td id="S8.T2.2.3.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">19</td></tr>
<tr id="S8.T2.2.4" class="ltx_tr">
<td id="S8.T2.2.4.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;" rowspan="2"><span id="S8.T2.2.4.1.1" class="ltx_text"><math id="S8.T2.m2" class="ltx_Math" alttext="\mathbb{R}^{4096\times 512}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mn>4096</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>512</mn></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{4096\times 512}</annotation></semantics></math></span></td>
<td id="S8.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">50</td>
<td id="S8.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">4.4e-5</td>
