</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S4.F3.sf7" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.09175v1/fig/itw_expert_use.png" id="S4.F3.sf7.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:476/413;" width="476" height="413" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.sf7.2" class="ltx_text" style="font-size:90%;">(g)</span> </span><span id="S4.F3.sf7.3" class="ltx_text" style="font-size:90%;">In The Wild</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
