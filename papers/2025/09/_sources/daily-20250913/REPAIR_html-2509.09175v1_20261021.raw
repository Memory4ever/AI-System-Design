<td id="S3.T1.4.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.3pt;padding-right:0.3pt;">31,334</td>
<td id="S3.T1.4.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.3pt;padding-right:0.3pt;">109,616</td>
<td id="S3.T1.4.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.3pt;padding-right:0.3pt;">140,950</td></tr>
