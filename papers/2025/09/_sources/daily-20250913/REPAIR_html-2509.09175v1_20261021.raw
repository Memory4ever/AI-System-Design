<th id="S4.T2.4.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_ttt" style="padding-left:0.3pt;padding-right:0.3pt;" colspan="3"><math id="S4.T2.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{orth}}+\mathcal{L}_{\text{ce}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℒ</mi><mtext class="ltx_mathvariant_bold" mathsize="0.800em">orth</mtext></msub><mo mathsize="0.800em">+</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℒ</mi><mtext class="ltx_mathvariant_bold" mathsize="0.800em">ce</mtext></msub></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{orth}}+\mathcal{L}_{\text{ce}}</annotation></semantics></math></th>
<th id="S4.T2.4.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_ttt" style="padding-left:0.3pt;padding-right:0.3pt;" colspan="3"><math id="S4.T2.m2" class="ltx_Math" alttext="\mathcal{L}_{\text{ce}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℒ</mi><mtext class="ltx_mathvariant_bold" mathsize="0.800em">ce</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ce}}</annotation></semantics></math></th></tr>
