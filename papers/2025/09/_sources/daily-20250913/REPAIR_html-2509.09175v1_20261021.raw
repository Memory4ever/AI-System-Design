<th id="S4.T5.4.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-bottom: 2.0pt;padding-top:-0.75pt;padding-bottom:-0.75pt;">ASVSpoof 2019LA</th>
<td id="S4.T5.4.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-bottom: 2.0pt;padding-top:-0.75pt;padding-bottom:-0.75pt;">0.44</td>
<td id="S4.T5.4.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-bottom: 2.0pt;padding-top:-0.75pt;padding-bottom:-0.75pt;">0.65<sup id="S4.T5.4.2.4.1" class="ltx_sup"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite></sup></td></tr>
