<th id="S4.T5.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">ASVSpoof 2021LA <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>]</cite></th>
<td id="S4.T5.4.3.2" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">4.31</td>
<td id="S4.T5.4.3.3" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">3.50<sup id="S4.T5.4.3.3.1" class="ltx_sup"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite></sup></td></tr>
<tr id="S4.T5.4.4" class="ltx_tr">
