<div id="A2.SS1.SSS1.p10" class="ltx_para">
<p id="A2.SS1.SSS1.p10.1" class="ltx_p"><span id="A2.SS1.SSS1.p10.1.1" class="ltx_text ltx_font_bold">Example 3 - Hard Rust Data Analytics (Healthcare Theme):</span></p>
</div>
<div id="A2.SS1.SSS1.p11" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS1.SSS1.p11.pic1" class="ltx_picture" height="436.82" overflow="visible" version="1.1" viewBox="0 0 653.15 436.82" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,436.82) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#008000;" fill="#008000" fill-opacity="1.0"><path style="stroke:none" d="M 0 9.69 L 0 427.14 C 0 432.48 4.34 436.82 9.69 436.82 L 643.46 436.82 C 648.81 436.82 653.15 432.48 653.15 427.14 L 653.15 9.69 C 653.15 4.34 648.81 0 643.46 0 L 9.69 0 C 4.34 0 0 4.34 0 9.69 Z"></path></g><g style="--ltx-fill-color:#E6FFE6;" fill="#E6FFE6" fill-opacity="1.0"><path style="stroke:none" d="M 2.77 9.69 L 2.77 427.14 C 2.77 430.96 5.86 434.05 9.69 434.05 L 643.46 434.05 C 647.28 434.05 650.38 430.96 650.38 427.14 L 650.38 9.69 C 650.38 5.86 647.28 2.77 643.46 2.77 L 9.69 2.77 C 5.86 2.77 2.77 5.86 2.77 9.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.54 24)"><foreignObject style="--ltx-fo-width:42.12em;--ltx-fo-height:28.35em;--ltx-fo-depth:0.25em;font-size:10pt;" height="395.74" overflow="visible" transform="matrix(1 0 0 -1 0 392.28)" width="582.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS1.SSS1.p11.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:42.12em;">
<span id="A2.SS1.SSS1.p11.pic1.1.1" class="ltx_p"><span id="A2.SS1.SSS1.p11.pic1.1.1.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">\{</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.2" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.2.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "unique_id": "rust_data_analytics_hard_082",</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.3" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.3.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "name": "PulseScope Analytics Mesh",</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.4" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.4.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "description": "A serverless, micro-service driven analytics pipeline</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.5" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.5.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">                 designed for large hospital systems seeking real-time</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.6" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.6.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">                 insight into vital-sign telemetry, laboratory results,</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.7" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.7.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">                 and EHR events. Each hospital ward streams HL7/FHIR event</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.8" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.8.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">                 data and bedside-device vitals into the mesh where</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.9" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.9.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">                 Rust-powered Lambda functions perform high-volume ingestion.",</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.10" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.10.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "domain": "data_analytics",</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.11" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.11.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "complexity": "hard",</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.12" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.12.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "language": "rust",</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.13" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.13.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "architecture": "serverless",</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.14" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.14.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "theme": "healthcare",</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.15" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.15.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "target_file_count": 62,</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.16" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.16.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "target_token_count": 208666,</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.17" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.17.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "features": [</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.18" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.18.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">    "data_ingestion", "stream_processing", "data_transformation",</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.19" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.19.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">    "data_storage", "data_visualization", "data_validation"</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.20" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.20.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  ],</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.21" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.21.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "architecture_patterns": [</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.22" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.22.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">    "Microservices", "Pipeline_Pattern", "Strategy_Pattern", "ETL_Pipeline"</span></span>
<span id="A2.SS1.SSS1.p11.pic1.1.23" class="ltx_p" style="width:442.3pt;"><span id="A2.SS1.SSS1.p11.pic1.1.23.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  ]</span></span>
