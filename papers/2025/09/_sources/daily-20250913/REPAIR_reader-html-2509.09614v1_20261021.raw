<span id="A2.SS2.SSS1.Px1.p5.pic1.1.6" class="ltx_p" style="width:442.3pt;"><span id="A2.SS2.SSS1.Px1.p5.pic1.1.6.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">|-- mercantilo/                      # Django project configuration</span></span>
<span id="A2.SS2.SSS1.Px1.p5.pic1.1.7" class="ltx_p" style="width:442.3pt;"><span id="A2.SS2.SSS1.Px1.p5.pic1.1.7.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">|   |-- __init__.py, asgi.py, wsgi.py</span></span>
