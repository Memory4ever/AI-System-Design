<span id="A2.SS3.SSS1.Px1.p11.pic1.1.2" class="ltx_p" style="width:442.3pt;"><span id="A2.SS3.SSS1.Px1.p11.pic1.1.2.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:442.3pt;--ltx-fg-color:#000000;">  "id": "python_web_ecommerce_expert_000_architectural_understanding_easy_01",</span></span>
