{"data":[{"id":"10.48550/arxiv.2509.09629","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.09629","identifiers":[{"identifier":"2509.09629","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minghang","familyName":"Zhu","name":"Zhu, Minghang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengliang","familyName":"Shi","name":"Shi, Zhengliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei","familyName":"Xu","name":"Xu, Zhiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiguang","familyName":"Wu","name":"Wu, Shiguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingjie","familyName":"Wang","name":"Wang, Lingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjie","familyName":"Ren","name":"Ren, Pengjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaochun","familyName":"Ren","name":"Ren, Zhaochun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhumin","familyName":"Chen","name":"Chen, Zhumin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bridging the Capability Gap: Joint Alignment Tuning for Harmonizing LLM-based Multi-Agent Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-11T17:15:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-12T00:47:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The advancement of large language models (LLMs) has enabled the construction of multi-agent systems to solve complex tasks by dividing responsibilities among specialized agents, such as a planning agent for subgoal generation and a grounding agent for executing tool-use actions. Most existing methods typically fine-tune these agents independently, leading to capability gaps among them with poor coordination. To address this, we propose MOAT, a Multi-Agent Joint Alignment Tuning framework that improves agents collaboration through iterative alignment. MOAT alternates between two key stages: (1) Planning Agent Alignment, which optimizes the planning agent to generate subgoal sequences that better guide the grounding agent; and (2) Grounding Agent Improving, which fine-tunes the grounding agent using diverse subgoal-action pairs generated by the agent itself to enhance its generalization capablity. Theoretical analysis proves that MOAT ensures a non-decreasing and progressively convergent training process. Experiments across six benchmarks demonstrate that MOAT outperforms state-of-the-art baselines, achieving average improvements of 3.1% on held-in tasks and 4.4% on held-out tasks."},{"descriptionType":"Other","description":"EMNLP 2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.09629","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-12T01:38:27Z","registered":"2025-09-12T01:38:28Z","published":null,"updated":"2025-09-12T01:38:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+transformer+OR+%22mixture+of+experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+transformer+OR+%22mixture+of+experts%22%29%29+AND+%28titles.title%3A%28architecture+OR+attention+OR+optimizer+OR+training+OR+alignment+OR+quantization%29+OR+descriptions.description%3A%28architecture+OR+attention+OR+optimizer+OR+training+OR+alignment+OR+quantization%29%29+AND+doi%3A%2210.48550%2Farxiv.2509.09629%22+AND+registered%3A%5B2025-09-11T16%3A00%3A00Z+TO+2025-09-12T15%3A59%3A59.999Z%5D\u0026page%5Bsize%5D=100\u0026sort=registered"}}