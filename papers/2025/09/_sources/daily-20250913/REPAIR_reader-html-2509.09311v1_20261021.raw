<td id="S3.T1.2.5.3" class="ltx_td ltx_align_left"><math id="S3.T1.m4" class="ltx_Math" alttext="986.71" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">986.71</mn><annotation encoding="application/x-tex">986.71</annotation></semantics></math></td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_center"><span id="S3.T1.2.5.4.1" class="ltx_text" style="font-size:90%;">2023</span></td>
