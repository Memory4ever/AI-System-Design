<td id="S3.T1.2.5.6" class="ltx_td ltx_align_center"><span id="S3.T1.2.5.6.1" class="ltx_text" style="font-size:90%;">84.44</span></td></tr>
<tr id="S3.T1.2.6" class="ltx_tr">
<td id="S3.T1.2.6.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S3.T1.2.6.1.1" class="ltx_text" style="font-size:90%;">SigLIP 2 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">Tschannen et al.(2025)Tschannen, Gritsenko, Wang, Naeem, Alabdulmohsin, Parthasarathy, Evans, Beyer, Xia, Mustafa, Hénaff, Harmsen, Steiner, and Zhai</a>]</cite></span></td>
<td id="S3.T1.2.6.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="S3.T1.2.6.2.1" class="ltx_text" style="font-size:90%;">ViT-gopt-16-384</span></td>
<td id="S3.T1.2.6.3" class="ltx_td ltx_align_left ltx_border_bb"><math id="S3.T1.m5" class="ltx_Math" alttext="1871.89" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">1871.89</mn><annotation encoding="application/x-tex">1871.89</annotation></semantics></math></td>
<td id="S3.T1.2.6.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.2.6.4.1" class="ltx_text" style="font-size:90%;">2025</span></td>
