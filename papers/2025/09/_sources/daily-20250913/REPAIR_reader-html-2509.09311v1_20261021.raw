<td id="S3.T1.2.3.6" class="ltx_td ltx_align_center"><span id="S3.T1.2.3.6.1" class="ltx_text" style="font-size:90%;">83.04</span></td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<td id="S3.T1.2.4.1" class="ltx_td ltx_align_left"><span id="S3.T1.2.4.1.1" class="ltx_text" style="font-size:90%;">RADIOv2.5<sup id="S3.T1.2.4.1.1.1" class="ltx_sup">†</sup> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx6" title="" class="ltx_ref">Heinrich et al.(2025)Heinrich, Ranzinger, Hongxu, Yin, Lu, Kautz, Tao, Catanzaro, and Molchanov</a>]</cite></span></td>
<td id="S3.T1.2.4.2" class="ltx_td ltx_align_left"><span id="S3.T1.2.4.2.1" class="ltx_text" style="font-size:90%;">ViT-g-14 res=896</span></td>
<td id="S3.T1.2.4.3" class="ltx_td ltx_align_left"><math id="S3.T1.m3" class="ltx_Math" alttext="1549.01" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">1549.01</mn><annotation encoding="application/x-tex">1549.01</annotation></semantics></math></td>
<td id="S3.T1.2.4.4" class="ltx_td ltx_align_center"><span id="S3.T1.2.4.4.1" class="ltx_text" style="font-size:90%;">2024</span></td>
