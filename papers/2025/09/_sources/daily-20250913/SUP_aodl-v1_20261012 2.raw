<span id="A9.T2.2.3.5.1" class="ltx_inline-block ltx_align_top" style="width:34.5pt;">
<span id="A9.T2.2.3.5.1.1" class="ltx_p">NA</span>
</span></td>
<td id="A9.T2.2.3.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">
