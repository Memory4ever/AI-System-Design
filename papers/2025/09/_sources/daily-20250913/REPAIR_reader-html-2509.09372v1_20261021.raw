<th id="S4.T6.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" rowspan="2"><span id="S4.T6.6.1.2.1" class="ltx_text">Params</span></th>
<td id="S4.T6.6.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="5">Task completed in a row <math id="S4.T6.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
