1.7" class="ltx_text" style="font-size:80%;">Gemini</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -29.27 -3.57)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F4.pic1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -35.15 12.33)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="11.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F4.pic1.m2" class="ltx_Math" alttext="20" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">20</mn><annotation encoding="application/x-tex">20</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -35.15 28.22)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="11.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F4.pic1.m3" class="ltx_Math" alttext="40" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">40</mn><annotation encoding="application/x-tex">40</annotation></semantic