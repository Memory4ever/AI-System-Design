</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 13.78)"><foreignObject style="--ltx-fo-width:13.43em;--ltx-fo-height:9.89em;--ltx-fo-depth:0em;font-size:10pt;" height="136.83" overflow="visible" transform="matrix(1 0 0 -1 0 136.83)" width="185.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
