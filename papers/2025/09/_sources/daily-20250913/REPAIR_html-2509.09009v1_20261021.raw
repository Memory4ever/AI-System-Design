<tr id="A2.T5.3.1" class="ltx_tr">
<th id="A2.T5.3.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="A2.T5.3.1.1.1" class="ltx_text" style="font-size:80%;">Tokens</span></th>
<th id="A2.T5.3.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t">
<span id="A2.T5.3.1.2.1" class="ltx_inline-block">
<span id="A2.T5.3.1.2.1.1" class="ltx_p"><span id="A2.T5.3.1.2.1.1.1" class="ltx_text" style="font-size:80%;">Global bs</span></span>
<span id="A2.T5.3.1.2.1.2" class="ltx_p"><span id="A2.T5.3.1.2.1.2.1" class="ltx_text" style="font-size:80%;">(tokens)</span></span>
</span></th>
<th id="A2.T5.3.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="A2.T5.3.1.3.1" class="ltx_text" style="font-size:80%;">iters</span></th>
<th id="A2.T5.3.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="A2.T5.3.1.4.1" class="ltx_text" style="font-size:80%;">lr</span></th>
<th id="A2.T5.3.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="A2.T5.3.1.5.1" class="ltx_text" style="font-size:80%;">warmup</span></th></tr>
</thead>
