font-size:90%;">efficient</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 92.49 142.68)"><foreignObject style="--ltx-fo-width:3.45em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="44.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.6" class="ltx_text" style="font-size:90%;">efficient</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 147.11 83.63)"><foreignObject style="--ltx-fo-width:3.45em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="44.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.7" class="ltx_text" style="font-size:90%;">efficient</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9"><path style="fill:none" d="M 39.37 0 L 39.37 -1.57"></path></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#666666;--ltx-fg-color:#666666;" color="#666666" fill="#666666" stroke="#666666" transform="matrix(1.0 0.0 0.0 1.0 36.61 -12.71)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="5.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.8" class="ltx_text" style="font-size:70%;--ltx-fg-color:#666666;">2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9"><path style="fill:none" d="M 78.74 0 L 78.74 -1.57"></path></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#666666;--ltx-fg-color:#666666;" color="#666666" fill="#666666" stroke="#666666" transform="matrix(1.0 0.0 0.0 1.0 75.98 -12.71)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="5.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.9" class="ltx_text" style="font-size:70%;--ltx-fg-color:#666666;">4</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9"><path style="fill:none" d="M 118.11 0 L 118.11 -1.57"></path></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#666666;--ltx-fg-color:#666666;" color="#666666" fill="#666666" stroke="#666666" transform="matrix(1.0 0.0 0.0 1.0 115.35 -12.71)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="5.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.10" class="ltx_text" style="font-size:70%;--ltx-fg-color:#666666;">6</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9"><path style="fill:none" d="M 157.48 0 L 157.48 -1.57"></path></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#666666;--ltx-fg-color:#666666;" color="#666666" fill="#666666" stroke="#666666" transform="matrix(1.0 0.0 0.0 1.0 154.72 -12.71)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="5.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.11" class="ltx_text" style="font-size:70%;--ltx-fg-color:#666666;">8</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9"><path style="fill:none" d="M 0 39.37 L -1.57 39.37"></path></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#666666;--ltx-fg-color:#666666;" color="#666666" fill="#666666" stroke="#666666" transform="matrix(1.0 0.0 0.0 1.0 -11.98 36.25)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="5.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.12" class="ltx_text" style="font-size:70%;--ltx-fg-color:#666666;">2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9"><path style="fill:none" d="M 0 78.74 L -1.57 78.74"></path></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#666666;--ltx-fg-color:#666666;" color="#666666" fill="#666666" stroke="#666666" transform="matrix(1.0 0.0 0.0 1.0 -11.98 75.62)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="5.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.13" class="ltx_text" style="font-size:70%;--ltx-fg-color:#666666;">4</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9"><path style="fill:none" d="M 0 118.11 L -1.57 118.11"></path></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#666666;--ltx-fg-color:#666666;" color="#666666" fill="#666666" stroke="#666666" transform="matrix(1.0 0.0 0.0 1.0 -11.98 114.99)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="5.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.14" class="ltx_text" style="font-size:70%;--ltx-fg-color:#666666;">6</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#D9D9D9;--ltx-fg-color:#D9D9D9;" color="#D9D9D9" fill="#D9D9D9" stroke="#D9D9D9"><path style="fill:none" d="M 0 157.48 L -1.57 157.48"></path></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#666666;--ltx-fg-color:#666666;" color="#666666" fill="#666666" stroke="#666666" transform="matrix(1.0 0.0 0.0 1.0 -11.98 154.36)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="5.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.15" class="ltx_text" style="font-size:70%;--ltx-fg-color:#666666;">8</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 2: </span>Pareto-efficiency in objective space for a 2-objective optimization. The interior (blue) is the feasible image <math id="S2.F2.m2" class="ltx_Math" alttext="f(X_{t}^{c})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>t</mi><mi>c</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(X_{t}^{c})</annotation></semantics></math>. Points on the upper boundary (red) are Pareto-efficient: improving one objective necessarily worsens the other. Black points on the frontier illustrate efficient solutions, while any points in the interior are dominated. The aim of this paper is to <span id="S2.F2.3" class="ltx_text ltx_font_italic">detect</span> Pareto-efficiency given a dataset from a multi-agent system.</figcaption>
</figure>
<div id="S2.SS1.p8" class="ltx_para">
<p id="S2.SS1.p8.1" class="ltx_p">Next we will detail how Pareto-efficiency can be defined as the optimality condition of a coordinated multi-agent system. We then turn to our methodology for <span id="S2.SS1.p8.1.1" class="ltx_text ltx_font_italic">detecting</span> coordination from observed system behavior.</p>
</div>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S2.SS2.6" class="ltx_text">II-B</span> </span><span id="S2.SS2.7" class="ltx_text ltx_font_italic">Coordinated Multi-Agent Systems</span></h3>

<div id="S2.SS2.p1" class="ltx_para">
<p id="S2.SS2.p1.1" class="ltx_p">Here we specify a general dynamical systems model of our multi-agent system. We detail how one can derive a constrained multi-objective optimization as the natural mathematical formalism defining multi-agent coordination.</p>
</div>
<div id="S2.SS2.p2" class="ltx_para">
<p id="S2.SS2.p2.1" class="ltx_p">We consider the interaction between a sensor and a multi-agent system comprising <math id="S2.SS2.p2.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> heterogeneous agents. The agents evolve according to a state-space model, and the sensor records noisy observations of each agent’s state.</p>
</div>
<div id="Thmdefinition2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition2.2" class="ltx_text ltx_font_bold">Definition 2</span></span><span id="Thmdefinition2.3" class="ltx_text ltx_font_bold"> </span>(Multi-Agent System)<span id="Thmdefinition2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition2.p1" class="ltx_para">
<p id="Thmdefinition2.p1.1" class="ltx_p">We introduce the following state-space sensing dynamics:</p>
<table id="S2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S2.E7.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\textrm{agent $i$ state}:x_{t}&amp;\in\mathbb{R}^{p},\ x_{t}\sim p_{\beta_{t}^{i}}(x|x_{t-1})\\
\textrm{agent $i$ parameter}:\beta_{t}^{i}&amp;\in\mathbb{R}^{N}_{+},\,i\in[M]\\
\textrm{sensor output}:\alpha_{t}&amp;\in\mathbb{R}^{N}_{+}\\
\textrm{sensor measurement}:y^{i}_{k}&amp;\in\mathbb{R}^{p},\ y^{i}_{k}\sim p_{\alpha_{t}}(y|x_{k}^{i})\\
\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mtext>agent </mtext><mi>i</mi><mtext> state</mtext></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><mrow><msub><mi>p</mi><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mtext>agent </mtext><mi>i</mi><mtext> parameter</mtext></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>∈</mo><msubsup><mi>ℝ</mi><mo>+</mo><mi>N</mi></msubsup></mrow><mo rspace="0.507em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mtext>sensor output</mtext><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msubsup><mi>ℝ</mi><mo>+</mo><mi>N</mi></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mtext>sensor measurement</mtext><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>y</mi><mi>k</mi><mi>i</mi></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>y</mi><mi>k</mi><mi>i</mi></msubsup><mo>∼</mo><mrow><msub><mi>p</mi><msub><mi>α</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>k</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\textrm{agent $i$ state}:x_{t}&amp;\in\mathbb{R}^{p},\ x_{t}\sim p_{\beta_{t}^{i}}(x|x_{t-1})\\
\textrm{agent $i$ parameter}:\beta_{t}^{i}&amp;\in\mathbb{R}^{N}_{+},\,i\in[M]\\
\textrm{sensor output}:\alpha_{t}&amp;\in\mathbb{R}^{N}_{+}\\
\textrm{sensor measurement}:y^{i}_{k}&amp;\in\mathbb{R}^{p},\ y^{i}_{k}\sim p_{\alpha_{t}}(y|x_{k}^{i})\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S2.SS2.p3" class="ltx_para ltx_noindent">
<p id="S2.SS2.p3.1" class="ltx_p">Here <math id="S2.SS2.p3.m1" class="ltx_Math" alttext="[x]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[x]</annotation></semantics></math> denotes the set <math id="S2.SS2.p3.m2" class="ltx_Math" alttext="\{1,\dots,x\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>x</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\dots,x\}</annotation></semantics></math>. Each agent <math id="S2.SS2.p3.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> has utility function <math id="S2.SS2.p3.m4" class="ltx_Math" alttext="f^{i}:\mathbb{R}^{N}_{+}\mapsto\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mi>i</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>ℝ</mi><mo>+</mo><mi>N</mi></msubsup><mo stretchy="false">↦</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f^{i}:\mathbb{R}^{N}_{+}\mapsto\mathbb{R}</annotation></semantics></math>, quantifying its objective, and may adjust its dynamics through parameter <math id="S2.SS2.p3.m5" class="ltx_Math" alttext="\beta_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\beta_{t}^{i}</annotation></semantics></math> to achieve its objective. In a <span id="S2.SS2.p3.1.1" class="ltx_text ltx_font_italic">coordinated</span> multi-agent system, the individual dynamics <math id="S2.SS2.p3.m6" class="ltx_Math" alttext="\beta_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\beta_{t}^{i}</annotation></semantics></math> are coupled, and the group behaves in order to maximize the aggregate utility:</p>
</div>
<div id="Thmdefinition3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition3.2" class="ltx_text ltx_font_bold">Definition 3</span></span><span id="Thmdefinition3.3" class="ltx_text ltx_font_bold"> </span>(Coordinated System)<span id="Thmdefinition3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition3.p1" class="ltx_para">
<p id="Thmdefinition3.p1.1" class="ltx_p">We define a coordinating system to be a group of <math id="Thmdefinition3.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> agents, each with individual concave, continuous and monotone increasing objective functions<span id="footnote5" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">5</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">5</sup>
                <span class="ltx_tag ltx_tag_note">5</span>
                
                
                
                
                
                
                
              This structure is widely assumed, and is natural in microeconomic and electronic warfare settings <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite></span></span></span> <math id="Thmdefinition3.p1.m2" class="ltx_Math" alttext="f^{i}:\mathbb{R}^{N}\to\mathbb{R},i\in[M]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mi>i</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>N</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{i}:\mathbb{R}^{N}\to\mathbb{R},i\in[M]</annotation></semantics></math>, which act according to dynamics parametrizations <math id="Thmdefinition3.p1.m3" class="ltx_Math" alttext="\{\beta_{t}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\beta_{t}^{i}\}_{i=1}^{M}</annotation></semantics></math> such that<span id="footnote6" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">6</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">6</sup>
                <span class="ltx_tag ltx_tag_note">6</span>
                
                
                
                
                
                
                
              The constraint bound 1 is without loss of generality, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite>.</span></span></span></p>
<table id="S2.EGx5" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S2.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E8.m1" class="ltx_Math" alttext="\displaystyle\begin{aligned} \hfil\displaystyle\begin{split}\{\beta_{t}^{i}\}_{i=1}^{M}\in\arg\max_{\{\beta^{i}\}_{i=1}^{M}}\sum_{i=1}^{M}\mu^{i}f^{i}(\beta^{i})\,\,s.t.\,\,\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1\end{split}\end{aligned}" display="block" intent=":literal"><semantics><mtable displaystyle="true"><mtr><mtd columnspan="2"><mtable displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo>∈</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><mprescripts></mprescripts><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>β</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mrow></mrow></mmultiscripts><mo>⁡</mo><msup><mi>μ</mi><mi>i</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>f</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>β</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.510em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi><mo lspace="0em" rspace="0.677em">.</mo><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><msup><mi>β</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{aligned} \hfil\displaystyle\begin{split}\{\beta_{t}^{i}\}_{i=1}^{M}\in\arg\max_{\{\beta^{i}\}_{i=1}^{M}}\sum_{i=1}^{M}\mu^{i}f^{i}(\beta^{i})\,\,s.t.\,\,\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1\end{split}\end{aligned}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="Thmdefinition3.p1.2" class="ltx_p">for a set of weights <math id="Thmdefinition3.p1.m4" class="ltx_Math" alttext="\mu^{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msup><mi>μ</mi><mi>i</mi></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu^{i}&gt;0</annotation></semantics></math>.</p>
</div>
</div>
<div id="S2.SS2.p4" class="ltx_para">
<p id="S2.SS2.p4.1" class="ltx_p">Observe that (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) is exactly
<math id="S2.SS2.p4.m1" class="ltx_Math" alttext="\{\beta_{t}^{i}\}_{i=1}^{M}\in S(\mu)" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo>∈</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\beta_{t}^{i}\}_{i=1}^{M}\in S(\mu)</annotation></semantics></math> for constraint set <math id="S2.SS2.p4.m2" class="ltx_Math" alttext="X_{c}^{t}=\{\{\beta_{i}\}_{i=1}^{M}:\alpha_{t}^{\top}\sum_{i=1}^{M}\beta_{i}\leq 1\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>c</mi><mi>t</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>β</mi><mi>i</mi></msub><mo rspace="0.278em" stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><msub><mi>β</mi><mi>i</mi></msub></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">X_{c}^{t}=\{\{\beta_{i}\}_{i=1}^{M}:\alpha_{t}^{\top}\sum_{i=1}^{M}\beta_{i}\leq 1\}</annotation></semantics></math>, and thus (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) is a special case of (<a href="#S2.E1" title="Equation 1 ‣ II-A Multi-Objective Optimization ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>).
Thus, a group which acts according to (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) optimally (is <span id="S2.SS2.p4.1.1" class="ltx_text ltx_font_italic">Pareto-efficient</span>) parametrizes its state kernels <math id="S2.SS2.p4.m3" class="ltx_Math" alttext="p_{\beta_{t}^{i}}(y|x_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\beta_{t}^{i}}(y|x_{t})</annotation></semantics></math> subject to each objective function, the sensing dynamics of the sensor, and a constraint on the joint agent dynamics. This joint constraint <math id="S2.SS2.p4.m4" class="ltx_Math" alttext="\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><msup><mi>β</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1</annotation></semantics></math> arises naturally from physical-layer considerations of, e.g., cognitive radar network power constraints <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite> or UAV network detectability. Indeed, we will illustrate the latter in detail in an extended example in Section <a href="#S5" title="V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">V</span></a>. For now we simply motivate this constraint as a way of coupling the agent dynamics within a joint optimization.</p>
</div>
<div id="S2.SS2.p5" class="ltx_para">
<p id="S2.SS2.p5.1" class="ltx_p"><span id="S2.SS2.p5.1.1" class="ltx_text ltx_font_italic">Detecting Pareto-Efficiency</span>: In the following sections we take the perspective of an analyst who observes the behavior of the system. We construct algorithms to determine if the system coordinates, that is, if its dynamics satisfy (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>). We provide necessary and sufficient conditions for a dataset of observations to be consistent with such Pareto-efficiency, and derive an optimal statistical detection scheme for achieving this in noise. Furthermore, in Section <a href="#S4" title="IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">IV</span></a> we provide a distributionally robust technique for estimation of the utility functions <math id="S2.SS2.p5.m1" class="ltx_Math" alttext="\{f^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>f</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{f^{i}\}_{i=1}^{M}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S2.SS3.6" class="ltx_text">II-C</span> </span><span id="S2.SS3.7" class="ltx_text ltx_font_italic">Detecting Pareto Efficiency. Examples of Multi-Agent Systems</span></h3>

<div id="S2.SS3.p1" class="ltx_para">
<p id="S2.SS3.p1.1" class="ltx_p">The methods that we will develop in subsequent sections apply to detecting Pareto efficiency for <span id="S2.SS3.p1.1.1" class="ltx_text ltx_font_italic">any</span> multi-agent coordinated system which has dynamics (<a href="#S2.E7" title="Equation 7 ‣ Definition 2 (Multi-Agent System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) and can be formalized as performing the jointly constrained optimization (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>).
In Section <a href="#S5" title="V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">V</span></a> we will provide an extended example of how the dynamics of a coordinated multi-UAV system naturally gives rise to the abstracted mathematical form of (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>). We now briefly discuss examples of other multi-agent systems fitting this framework, where an analyst may wish to determine whether observed behavior is consistent with coordination.</p>
</div>
<div id="S2.SS3.p2" class="ltx_para">
<p id="S2.SS3.p2.1" class="ltx_p"><span id="S2.SS3.p2.1.1" class="ltx_text ltx_font_italic">Detecting Pareto-Efficient Spectrum Allocation.</span> In multi-cell 5G/6G systems, base stations allocate spectrum and transmit power while balancing throughput, latency, and fairness <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite>. An analyst observing network scheduling or beamforming could test whether these allocations are Pareto-efficient subject to spectrum interference constraints <math id="S2.SS3.p2.m1" class="ltx_Math" alttext="\sum_{i}\alpha_{t}^{\top}\beta_{i}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>i</mi></msub></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i}\alpha_{t}^{\top}\beta_{i}\leq 1</annotation></semantics></math>, and, upon confirmation, reconstruct implicit utility weights that reveal operator priorities.</p>
</div>
<div id="S2.SS3.p3" class="ltx_para">
<p id="S2.SS3.p3.1" class="ltx_p"><span id="S2.SS3.p3.1.1" class="ltx_text ltx_font_italic">Autonomous Vehicle Teaming.</span> Vehicles in a team jointly adjust velocity and spacing to minimize energy use, maximize throughput, and ensure safety <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">29</a>]</cite>. From traffic flow data, one may detect whether the platoon acts in a coordinated, Pareto-efficient manner under safety-distance constraints, and recover utility functions that quantify the relative emphasis on efficiency versus safety.</p>
</div>
<div id="S2.SS3.p4" class="ltx_para">
<p id="S2.SS3.p4.1" class="ltx_p"><span id="S2.SS3.p4.1.1" class="ltx_text ltx_font_italic">Smart Grid Dispatch.</span> Distributed generators and storage units schedule electricity production subject to supply-demand balance and transmission limits <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib30" title="" class="ltx_ref">30</a>]</cite>. Observing dispatch decisions, an analyst could test for coordination (Pareto-efficient resource allocation) and reconstruct cost or renewable-integration utilities, enabling prediction of grid responses to shocks or adversarial interventions.</p>
</div>
<div id="S2.SS3.p5" class="ltx_para">
<p id="S2.SS3.p5.1" class="ltx_p">Thus, the methodology developed here applies beyond our illustrative example of multi-UAV systems, to any system where multiple agents optimize distinct utilities under a shared linear constraint.</p>
</div>
<figure id="S2.F3" class="ltx_figure"><span class="ltx_inline-block"><svg id="S2.F3.pic1" class="ltx_picture ltx_centering" height="71.32" overflow="visible" version="1.1" viewBox="0 0 652.91 71.32" width="652.91"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,71.32) matrix(1 0 0 -1 0 0) translate(45.55,0) translate(0,35.66)"><g stroke-width="0.4pt"><g style="--ltx-fill-color:#FAFAFA;" fill="#FAFAFA"><path d="M 39.74 11.67 L -39.74 11.67 C -42.8 11.67 -45.28 9.2 -45.28 6.14 L -45.28 -6.14 C -45.28 -9.2 -42.8 -11.67 -39.74 -11.67 L 39.74 -11.67 C 42.8 -11.67 45.28 -9.2 45.28 -6.14 L 45.28 6.14 C 45.28 9.2 42.8 11.67 39.74 11.67 Z M -45.28 -11.67"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -33.71 -4.76)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 12.28)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 6.73)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.09em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="67.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F3.pic1.1" class="ltx_text" style="font-size:70%;">Sensor Probe </span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 10.9)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 28.55 0)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="10.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F3.pic1.m1" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">α</mi><mi mathsize="0.700em">t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#FAFAFA;" fill="#FAFAFA"><path d="M 242.17 35.38 L 114.36 35.38 C 111.3 35.38 108.82 32.91 108.82 29.85 L 108.82 -29.85 C 108.82 -32.91 111.3 -35.38 114.36 -35.38 L 242.17 -35.38 C 245.22 -35.38 247.7 -32.91 247.7 -29.85 L 247.7 29.85 C 247.7 32.91 245.22 35.38 242.17 35.38 Z M 108.82 -35.38"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 114.36 -20.16)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 59.7)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 31.44)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 41.13)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.87)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 15.48 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 18.29)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 6.73)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:8.81em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="97.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F3.pic1.2" class="ltx_text" style="font-size:70%;">Multi-agent system </span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.87)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 11.97 0)"><foreignObject style="--ltx-fo-width:6.58em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.22em;font-size:7.97pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="72.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F3.pic1.3" class="ltx_text" style="font-size:70%;">(coordination) </span></span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 31.44)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:11.59em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.88em;font-size:7.97pt;" height="20.06" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="127.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F3.pic1.m2" class="ltx_Math" alttext="\{\beta^{i}_{t}\}\in\arg\max\sum_{i}\mu^{i}U^{i}(\beta_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msubsup><mi mathsize="0.700em">β</mi><mi mathsize="0.700em">t</mi><mi mathsize="0.700em">i</mi></msubsup><mo stretchy="false">}</mo></mrow><mo mathsize="0.700em">∈</mo><mrow><mrow><mi mathsize="0.700em">arg</mi><mo lspace="0.167em">⁡</mo><mi mathsize="0.700em">max</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mi mathsize="0.700em">i</mi></msub><mrow><msup><mi mathsize="0.700em">μ</mi><mi mathsize="0.700em">i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">U</mi><mi mathsize="0.700em">i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">β</mi><mi mathsize="0.700em">i</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\beta^{i}_{t}\}\in\arg\max\sum_{i}\mu^{i}U^{i}(\beta_{i})</annotation></semantics></math><span id="S2.F3.pic1.4" class="ltx_text" style="font-size:70%;"> </span></span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 50.01)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 23.71 0)"><foreignObject style="--ltx-fo-width:1.7em;--ltx-fo-height:0.54em;--ltx-fo-depth:0em;font-size:7.97pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F3.pic1.5" class="ltx_text" style="font-size:70%;">s.t. </span><math id="S2.F3.pic1.m3" class="ltx_Math" alttext="\alpha_{t}^{\top}\sum_{i=1}^{M}\beta_{i}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathsize="0.700em">α</mi><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi mathsize="0.700em">i</mi><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">1</mn></mrow><mi mathsize="0.700em">M</mi></msubsup><msub><mi mathsize="0.700em">β</mi><mi mathsize="0.700em">i</mi></msub></mrow></mrow><mo mathsize="0.700em">≤</mo><mn mathsize="0.700em">1</mn></mrow><annotation encoding="application/x-tex">\alpha_{t}^{\top}\sum_{i=1}^{M}\beta_{i}\leq 1</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#FAFAFA;" fill="#FAFAFA"><path d="M 412.01 16.76 L 316.78 16.76 C 313.73 16.76 311.25 14.28 311.25 11.22 L 311.25 -11.22 C 311.25 -14.28 313.73 -16.76 316.78 -16.76 L 412.01 -16.76 C 415.07 -16.76 417.55 -14.28 417.55 -11.22 L 417.55 11.22 C 417.55 14.28 415.07 16.76 412.01 16.76 Z M 311.25 -16.76"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 321.91 -7.76)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22.45)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 6.73)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:7.73em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="85.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F3.pic1.6" class="ltx_text" style="font-size:70%;">Analyst observes </span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 18.99)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 19.81 0)"><foreignObject style="--ltx-fo-width:4em;--ltx-fo-height:0.92em;--ltx-fo-depth:0.31em;font-size:8.19pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="45.37"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F3.pic1.m4" class="ltx_Math" alttext="(\alpha_{t},\{\beta^{i}_{t}\})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">α</mi><mi mathsize="0.700em">t</mi></msub><mo mathsize="0.700em">,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi mathsize="0.700em">β</mi><mi mathsize="0.700em">t</mi><mi mathsize="0.700em">i</mi></msubsup><mo stretchy="false">}</mo></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><annotation encoding="application/x-tex">(\alpha_{t},\{\beta^{i}_{t}\})</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#FAFAFA;" fill="#FAFAFA"><path d="M 601.54 14.2 L 486.63 14.2 C 483.57 14.2 481.09 11.72 481.09 8.66 L 481.09 -8.66 C 481.09 -11.72 483.57 -14.2 486.63 -14.2 L 601.54 -14.2 C 604.6 -14.2 607.08 -11.72 607.08 -8.66 L 607.08 8.66 C 607.08 11.72 604.6 14.2 601.54 14.2 Z M 481.09 -14.2"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 499.01 -6.73)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 17.33)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 6.73)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:8.2em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="90.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F3.pic1.7" class="ltx_text" style="font-size:70%;">LP feasibility test </span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.39)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 17.29 0)"><foreignObject style="--ltx-fo-width:4.88em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.18em;font-size:7.97pt;" height="8.72" overflow="visible" transform="matrix(1 0 0 -1 0 6.78)" width="53.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F3.pic1.8" class="ltx_text" style="font-size:70%;">eq. (</span><a href="#S3.E10" title="Equation 10 ‣ Item 2 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a><span id="S2.F3.pic1.9" class="ltx_text" style="font-size:70%;">)</span></span></span></foreignObject></g></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 45.55 0 L 99.97 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 99.97 0)"><path d="M 6.37 0 C 5.58 0.19 2.15 1.28 0 2.46 L 0 -2.46 C 2.15 -1.28 5.58 -0.19 6.37 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 52.87 5.17)"><foreignObject style="--ltx-fo-width:4.41em;--ltx-fo-height:0.59em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.52" overflow="visible" transform="matrix(1 0 0 -1 0 6.52)" width="48.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F3.pic1.10" class="ltx_text" style="font-size:70%;">constraint</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 247.98 0 L 302.39 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 302.39 0)"><path d="M 6.37 0 C 5.58 0.19 2.15 1.28 0 2.46 L 0 -2.46 C 2.15 -1.28 5.58 -0.19 6.37 0 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 417.82 0 L 472.24 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 472.24 0)"><path d="M 6.37 0 C 5.58 0.19 2.15 1.28 0 2.46 L 0 -2.46 C 2.15 -1.28 5.58 -0.19 6.37 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 425.74 5.17)"><foreignObject style="--ltx-fo-width:3.52em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="38.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F3.pic1.11" class="ltx_text" style="font-size:70%;">dataset <math id="S2.F3.pic1.m5" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math></span></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 3: </span>Probe–response revealed preference framework. The environment issues a probe <math id="S2.F3.m4" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math>,
the system responds optimally with <math id="S2.F3.m5" class="ltx_Math" alttext="\{\beta^{i}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\beta^{i}_{t}\}</annotation></semantics></math>, and the analyst observes <math id="S2.F3.m6" class="ltx_Math" alttext="(\alpha_{t},\{\beta^{i}_{t}\})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha_{t},\{\beta^{i}_{t}\})</annotation></semantics></math>.
Testing coordination reduces to checking LP feasibility (<a href="#S3.E10" title="Equation 10 ‣ Item 2 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>).</figcaption>
</figure>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">III </span><span id="S3.2" class="ltx_text ltx_font_smallcaps">Result 1. Statistical Detection of Pareto-Efficient Coordination</span></h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">Recall our main results in multi-agent IRL constitute a two-step procedure: detecting Pareto efficient coordination in a multi-agent system and subsequently reconstructing the utilities of the agents. This section details the first step; we provide an optimal statistical detector for determining if a noisy dataset of dynamics from a multi-agent system are consistent with Pareto-efficient coordination. We first provide an equivalence between <span id="S3.p1.1.1" class="ltx_text ltx_font_italic">deterministic</span> multi-agent system coordination (Def. <a href="#Thmdefinition3" title="Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) and the feasibility of a testable linear program; allowing us to test coordination by solving this linear program, from deterministic system observations. Corollary <a href="#Thmcorollary1" title="Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> provides a mechanism for reconstructing feasible utility functions from this <span id="S3.p1.1.2" class="ltx_text ltx_font_italic">deterministic</span> data, which allows for understanding the goals of the system and predicting future dynamics. We then extend these results to the stochastic regime by providing a statistical detector for determining whether <span id="S3.p1.1.3" class="ltx_text ltx_font_italic">noisy</span> measurements of system dynamics are consistent with multi-objective optimization (coordination). <span id="footnote7" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">7</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">7</sup>
            <span class="ltx_tag ltx_tag_note">7</span>
            
            
            
            
            
            
            
          If we concretize to a radar-UAV interaction, we assume the target can observe the signals <math id="footnote7.m1" class="ltx_Math" alttext="\{\beta_{t}^{i},t\in[T]\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\beta_{t}^{i},t\in[T]\}_{i=1}^{M}</annotation></semantics></math> through e.g., an omni-directional receiver or by radar tracking signals. See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>]</cite> for physical-layer considerations of radar waveform observation, detection, and classification.</span></span></span></p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S3.SS1.6" class="ltx_text">III-A</span> </span><span id="S3.SS1.7" class="ltx_text ltx_font_italic">Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination.</span></h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">We model the interaction between an evolving constraint (or probe) <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> and the resulting multi-agent system response <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="\{\beta_{t}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\beta_{t}^{i}\}_{i=1}^{M}</annotation></semantics></math>.
If the agents are coordinating, each probe–response pair <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="(\alpha_{t},\{\beta_{t}^{i}\}_{i=1}^{M})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha_{t},\{\beta_{t}^{i}\}_{i=1}^{M})</annotation></semantics></math> arises from a linearly constrained multi-objective optimization (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), thereby revealing the agents’ underlying objectives.
The analyst observes a dataset</p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_math_unparsed" alttext="\mathcal{D}=\{\,\alpha_{t},\{\beta_{t}^{i}\}_{i=1}^{M}:t\in[T]\}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><mrow><mo rspace="0.170em" stretchy="false">{</mo><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo rspace="0.278em" stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo rspace="0.278em">:</mo><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}=\{\,\alpha_{t},\{\beta_{t}^{i}\}_{i=1}^{M}:t\in[T]\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">and seeks to determine whether it is <em id="S3.SS1.p1.2.1" class="ltx_emph ltx_font_italic">rationalizable</em>, i.e., whether there exist utility functions <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="\{U^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>U</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{U^{i}\}_{i=1}^{M}</annotation></semantics></math> under which all observations are consistent with Pareto-efficient coordination.
This corresponds to the classical revealed preference problem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>, <a href="#bib.bib31" title="" class="ltx_ref">31</a>, <a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite>, and leads to our first main result: a linear program that tests rationalizability and reconstructs consistent utilities, which we later extend to noisy observations via an optimal statistical detector.</p>
</div>
<section id="S3.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S3.SS1.SSS1.6" class="ltx_text">III-A</span>1 </span>Testing Pareto-Efficiency</h4>

<div id="S3.SS1.SSS1.p1" class="ltx_para">
<p id="S3.SS1.SSS1.p1.1" class="ltx_p">Specifically, here we provide a necessary and sufficient condition for the dataset <math id="S3.SS1.SSS1.p1.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> to be consistent with multi-objective optimization.</p>
</div>
<div id="Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 1</span></span><span id="Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem1.p1" class="ltx_para">
<p id="Thmtheorem1.p1.1" class="ltx_p"><span id="Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem1.p1.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> be a set of observations. The following are equivalent:</span></p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p"><span id="S3.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">there exist a set of </span><math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="S3.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> concave and continuous objective functions </span><math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="U^{1},\dots,U^{m}" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>U</mi><mi>m</mi></msup></mrow><annotation encoding="application/x-tex">U^{1},\dots,U^{m}</annotation></semantics></math><span id="S3.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> and weights </span><math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="\mu\in\mathcal{W}_{M}^{+}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>M</mi><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">\mu\in\mathcal{W}_{M}^{+}</annotation></semantics></math><span id="S3.I1.i1.p1.1.4" class="ltx_text ltx_font_italic"> such that </span><math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="\forall t\in[T]" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\forall t\in[T]</annotation></semantics></math><span id="S3.I1.i1.p1.1.5" class="ltx_text ltx_font_italic">:</span></p>
<table id="S3.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.E9.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\{\beta^{i}_{t}\}_{i=1}^{M}\in&amp;\arg\max_{\{\beta^{i}\}_{i=1}^{M}}\sum_{i=1}^{M}\mu^{i}U^{i}(\beta^{i})\ \ \\
&amp;s.t.\ \alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo>∈</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mstyle displaystyle="true"><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><mprescripts></mprescripts><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>β</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mrow></mrow></mmultiscripts></mstyle><mo>⁡</mo><msup><mi>μ</mi><mi>i</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>U</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>β</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi><mo lspace="0em" rspace="1.167em">.</mo><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msup><mi>β</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\{\beta^{i}_{t}\}_{i=1}^{M}\in&amp;\arg\max_{\{\beta^{i}\}_{i=1}^{M}}\sum_{i=1}^{M}\mu^{i}U^{i}(\beta^{i})\ \ \\
&amp;s.t.\ \alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p"><span id="S3.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">there exist numbers </span><math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="u_{j}^{i}&gt;0,\lambda_{j}^{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mi>j</mi><mi>i</mi></msubsup><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><msubsup><mi>λ</mi><mi>j</mi><mi>i</mi></msubsup><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">u_{j}^{i}&gt;0,\lambda_{j}^{i}&gt;0</annotation></semantics></math><span id="S3.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> such that for all </span><math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="s,t\in[T]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s,t\in[T]</annotation></semantics></math><span id="S3.I1.i2.p1.1.3" class="ltx_text ltx_font_italic">, </span><math id="S3.I1.i2.p1.m3" class="ltx_Math" alttext="i\in[M]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[M]</annotation></semantics></math><span id="S3.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">:</span></p>
<table id="S3.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E10.m1" class="ltx_Math" alttext="u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}[\beta_{s}^{i}-\beta_{t}^{i}]\leq 0" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>β</mi><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}[\beta_{s}^{i}-\beta_{t}^{i}]\leq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS1.SSS1.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.SSS1.p2" class="ltx_para">
<p id="S3.SS1.SSS1.p2.1" class="ltx_p"><span id="S3.SS1.SSS1.p2.1.1" class="ltx_text">See Theorem 1 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>]</cite>
∎</span></p>
</div>
</div>
<div id="S3.SS1.SSS1.p3" class="ltx_para">
<p id="S3.SS1.SSS1.p3.1" class="ltx_p">The equivalence in Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> provides a tractable test of coordination
rationalizability. Rather than searching over unknown utilities to determine consistency, one can check the
feasibility of a system of linear inequalities. This is the multi-agent generalization
of Afriat’s theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>, which is a seminal result in the theory of microeconomic revealed preferences. Afriat’s theorem provides a nonparametric constructive test to identify if an agent is a
budget-constrained utility maximizer. A remarkable feature of Afriat’s theorem is that if the
dataset can be rationalized by a utility function, then it can be rationalized by a continuous,
concave, monotonic utility function. That is, violations of continuity, concavity, or monotonicity
cannot be detected with a finite number of observations.</p>
</div>
</section>
<section id="S3.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S3.SS1.SSS2.6" class="ltx_text">III-A</span>2 </span>Reconstructing Rationalizing Utility Functions</h4>

<div id="S3.SS1.SSS2.p1" class="ltx_para">
<p id="S3.SS1.SSS2.p1.1" class="ltx_p">Given feasibility (coordination), we can use the following Corollary to reconstruct objective functions which rationalize the observed responses.</p>
</div>
<div id="Thmcorollary1" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary1.2" class="ltx_text ltx_font_bold">Corollary 1</span></span><span id="Thmcorollary1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary1.p1" class="ltx_para">
<p id="Thmcorollary1.p1.1" class="ltx_p"><span id="Thmcorollary1.p1.1.1" class="ltx_text ltx_font_italic">Given constants <math id="Thmcorollary1.p1.m1" class="ltx_Math" alttext="u_{t}^{i},\lambda_{t}^{i},t\in[T],i\in[M]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{t}^{i},\lambda_{t}^{i},t\in[T],i\in[M]</annotation></semantics></math> which make (<a href="#S3.E10" title="Equation 10 ‣ Item 2 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) feasible, explicit monotone and continuous objective functions that "rationalize" the dataset 
<br class="ltx_break"><math id="Thmcorollary1.p1.m2" class="ltx_Math" alttext="\{\alpha_{t},\beta^{i}_{t},t\in[T],i\in[M]\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\alpha_{t},\beta^{i}_{t},t\in[T],i\in[M]\}</annotation></semantics></math> are given by</span></p>
<table id="S3.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E11.m1" class="ltx_math_unparsed" alttext="U^{i}(\cdot)=\min_{t\in[T]}\left[u_{t}^{i}+\lambda_{t}^{i}\alpha_{t}^{\top}[\cdot-\beta^{i}_{t}]\right]" display="block" intent=":literal"><semantics><mrow><msup><mi>U</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>=</mo><munder><mi>min</mi><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo>[</mo><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo>+</mo><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">]</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">U^{i}(\cdot)=\min_{t\in[T]}\left[u_{t}^{i}+\lambda_{t}^{i}\alpha_{t}^{\top}[\cdot-\beta^{i}_{t}]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="Thmcorollary1.p1.2" class="ltx_p"><span id="Thmcorollary1.p1.2.1" class="ltx_text ltx_font_italic">i.e., (<a href="#S3.E9" title="Equation 9 ‣ Item 1 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) is satisfied with objective functions (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>).</span></p>
</div>
</div>
<div id="S3.SS1.SSS2.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.SSS2.p2" class="ltx_para">
<p id="S3.SS1.SSS2.p2.1" class="ltx_p"><span id="S3.SS1.SSS2.p2.1.1" class="ltx_text">See Lemma 1 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>]</cite>.
∎</span></p>
</div>
</div>
<div id="S3.SS1.SSS2.p3" class="ltx_para">
<p id="S3.SS1.SSS2.p3.1" class="ltx_p">This Corollary gives us a way to predict future system outputs by reconstructing feasible utility functions which generate the multi-objective optimal dynamics. Then, for probe <math id="S3.SS1.SSS2.p3.m1" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math>, Pareto-efficient responses can be predicted by computing the constrained multi-objective optimal solutions (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>). <span id="footnote8" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">8</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">8</sup>
                <span class="ltx_tag ltx_tag_note">8</span>
                
                
                
                
                
                
                
              The reconstructed piecewise linear utilities (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) are not unique and are ordinal by construction. Ordinal means that any positive monotone increasing transformation of the utility function
will also rationalize the dataset <math id="footnote8.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>. This is why the budget constraint <math id="footnote8.m2" class="ltx_Math" alttext="\alpha_{t}^{\top}\sum_{i=1}^{M}\beta_{t}^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}^{\top}\sum_{i=1}^{M}\beta_{t}^{i}</annotation></semantics></math> is without loss
of generality; it can be scaled by an arbitrary positive constant and Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> still holds.</span></span></span></p>
</div>
</section>
<section id="S3.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S3.SS1.SSS3.6" class="ltx_text">III-A</span>3 </span>Predicting Future Responses</h4>

<div id="S3.SS1.SSS3.p1" class="ltx_para">
<p id="S3.SS1.SSS3.p1.1" class="ltx_p">Having reconstructed rationalizing utilities via Corollary <a href="#Thmcorollary1" title="Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we can predict how the multi-agent system will respond to unseen probes.
Given a new constraint vector <math id="S3.SS1.SSS3.p1.m1" class="ltx_Math" alttext="\alpha_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\alpha_{t+1}</annotation></semantics></math>, the predicted Pareto-efficient responses <math id="S3.SS1.SSS3.p1.m2" class="ltx_Math" alttext="\{\beta_{t+1}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\beta_{t+1}^{i}\}_{i=1}^{M}</annotation></semantics></math> are obtained by solving the same multi-objective program (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), but now with the reconstructed utilities.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Predicting Future System Dynamics</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
                
                
              <span id="alg1.l1.3" class="ltx_text ltx_font_bold">Input:</span> Dataset <math id="alg1.l1.m1" class="ltx_Math" alttext="\mathcal{D}=\{\alpha_{t},\{\beta_{t}^{i}\}_{i=1}^{M},t\in[T]\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}=\{\alpha_{t},\{\beta_{t}^{i}\}_{i=1}^{M},t\in[T]\}</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
                
                
              <span id="alg1.l2.3" class="ltx_text ltx_font_bold">if</span> (<a href="#S3.E10" title="Equation 10 ‣ Item 2 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) feasible <span id="alg1.l2.4" class="ltx_text ltx_font_bold">then</span>
reconstruct utilities <math id="alg1.l2.m1" class="ltx_Math" alttext="\{U^{i}(\cdot)\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msup><mi>U</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{U^{i}(\cdot)\}_{i=1}^{M}</annotation></semantics></math> via (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>).

</div>
<div id="alg1.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
                
                
                <span id="alg1.l3.3" class="ltx_text ltx_font_italic">Predict Responses</span>: Given probe <math id="alg1.l3.m1" class="ltx_Math" alttext="\alpha_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\alpha_{t+1}</annotation></semantics></math>, solve the following via a convex optimization routine

<table id="S3.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex5.m1" class="ltx_Math" alttext="\displaystyle\{\beta_{t+1}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\displaystyle\{\beta_{t+1}^{i}\}_{i=1}^{M}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex5.m2" class="ltx_Math" alttext="\displaystyle\in\arg\max_{\{\beta^{i}\}_{i=1}^{M}}\sum_{i=1}^{M}\mu^{i}U^{i}(\beta^{i})\quad" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>∈</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mstyle displaystyle="true"><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><mprescripts></mprescripts><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>β</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mrow></mrow></mmultiscripts></mstyle><mo>⁡</mo><msup><mi>μ</mi><mi>i</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>U</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>β</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle\in\arg\max_{\{\beta^{i}\}_{i=1}^{M}}\sum_{i=1}^{M}\mu^{i}U^{i}(\beta^{i})\quad</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex6.m1" class="ltx_Math" alttext="\displaystyle s.t.\ \alpha_{t+1}^{\top}\Big(\sum_{i=1}^{M}\beta^{i}\Big)\leq 1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi><mo lspace="0em" rspace="0.667em">.</mo><mrow><mrow><msubsup><mi>α</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msup><mi>β</mi><mi>i</mi></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle s.t.\ \alpha_{t+1}^{\top}\Big(\sum_{i=1}^{M}\beta^{i}\Big)\leq 1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>

</div>
<div id="alg1.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                
                
                Return the Pareto-frontier <math id="alg1.l4.m1" class="ltx_Math" alttext="X_{E}(\{U^{i}\}_{i=1}^{M},\alpha_{t+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>U</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo>,</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X_{E}(\{U^{i}\}_{i=1}^{M},\alpha_{t+1})</annotation></semantics></math> by tracing over weights <math id="alg1.l4.m2" class="ltx_Math" alttext="\mu\in\mathcal{W}_{M}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>M</mi></msub></mrow><annotation encoding="application/x-tex">\mu\in\mathcal{W}_{M}</annotation></semantics></math>.

</div>
<div id="alg1.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
                
                
              <span id="alg1.l5.3" class="ltx_text ltx_font_bold">else</span>  conclude non-coordination.

</div>
<div id="alg1.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
                
                
              <span id="alg1.l6.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l6.4" class="ltx_text ltx_font_bold">if</span>
</div>
</div>
</figure>
<div id="S3.SS1.SSS3.p2" class="ltx_para">
<p id="S3.SS1.SSS3.p2.1" class="ltx_p">This procedure uses only previously observed data to construct feasible utilities, and then extrapolates responses to new environments by generating the Pareto-frontier. As such, it provides a principled, nonparametric mechanism to forecast coordinated system behavior under counterfactual probes.</p>
</div>
<div id="S3.SS1.SSS3.p3" class="ltx_para">
<p id="S3.SS1.SSS3.p3.1" class="ltx_p">Furthermore, by measuring the observed system response w.r.t. this new probe <math id="S3.SS1.SSS3.p3.m1" class="ltx_Math" alttext="\alpha_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\alpha_{t+1}</annotation></semantics></math>, one may determine an estimate for the weight <math id="S3.SS1.SSS3.p3.m2" class="ltx_Math" alttext="\mu\in\mathcal{W}_{M}^{+}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mi>M</mi><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">\mu\in\mathcal{W}_{M}^{+}</annotation></semantics></math> determining the optimization (<a href="#S3.E9" title="Equation 9 ‣ Item 1 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>). Thus, this methodology also allows one to <span id="S3.SS1.SSS3.p3.1.1" class="ltx_text ltx_font_italic">recover the Pareto-efficient utility allocation structure</span>, i.e., to determine <span id="S3.SS1.SSS3.p3.1.2" class="ltx_text ltx_font_italic">which agents are given priority</span> in this joint-optimization. This can directly lead to inference of e.g., multi-agent group leadership roles or group hierarchical prioritization.</p>
</div>
</section>
<section id="S3.SS1.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S3.SS1.SSS4.6" class="ltx_text">III-A</span>4 </span>Quantifying Proximity to Pareto-Efficiency</h4>

<div id="S3.SS1.SSS4.p1" class="ltx_para">
<p id="S3.SS1.SSS4.p1.1" class="ltx_p">Supposing the dataset <math id="S3.SS1.SSS4.p1.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> does not satisfy these conditions, how can we quantify "how close" the behavior is to Pareto-efficiency? We can quantify this through the following metric, which will be crucial in our subsequent developments of optimal statistical detection and robust utility reconstruction.</p>
</div>
<div id="Thmcorollary2" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary2.2" class="ltx_text ltx_font_bold">Corollary 2</span></span><span id="Thmcorollary2.3" class="ltx_text ltx_font_bold"> </span>(Proximity to Pareto-Efficiency)<span id="Thmcorollary2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary2.p1" class="ltx_para">
<p id="Thmcorollary2.p1.1" class="ltx_p"><span id="Thmcorollary2.p1.1.1" class="ltx_text ltx_font_italic">We can quantify the proximity of <math id="Thmcorollary2.p1.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> to Pareto-efficiency as follows. Let <math id="Thmcorollary2.p1.m2" class="ltx_Math" alttext="\phi(\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\mathcal{D})</annotation></semantics></math> be the smallest nonnegative scalar for which parameters
<math id="Thmcorollary2.p1.m3" class="ltx_Math" alttext="\{u_{t}^{i},\lambda_{t}^{i},\,t\in[T]\}_{i\in[M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo rspace="0.337em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{u_{t}^{i},\lambda_{t}^{i},\,t\in[T]\}_{i\in[M]}</annotation></semantics></math> exist making the following feasible</span></p>
<table id="S3.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E12.m1" class="ltx_Math" alttext="u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}[\beta_{s}^{i}-\beta_{t}^{i}]\;\leq\;\lambda_{t}^{i}\,\phi(\mathcal{D}),\quad\forall\,s,t\in[T],\ i\in[M]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>u</mi><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>β</mi><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mo rspace="0.337em">∀</mo><mi>s</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}[\beta_{s}^{i}-\beta_{t}^{i}]\;\leq\;\lambda_{t}^{i}\,\phi(\mathcal{D}),\quad\forall\,s,t\in[T],\ i\in[M],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="Thmcorollary2.p1.2" class="ltx_p"><span id="Thmcorollary2.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="Thmcorollary2.p1.m4" class="ltx_Math" alttext="\phi(\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\mathcal{D})</annotation></semantics></math> provides a metric of the dataset’s violation of Pareto-efficiency: <math id="Thmcorollary2.p1.m5" class="ltx_Math" alttext="\phi(\mathcal{D})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\phi(\mathcal{D})=0</annotation></semantics></math>
if and only if <math id="Thmcorollary2.p1.m6" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> is exactly Pareto-efficient, while larger values of <math id="Thmcorollary2.p1.m7" class="ltx_Math" alttext="\phi(\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\mathcal{D})</annotation></semantics></math> indicate
greater deviation from Pareto-efficiency.</span></p>
</div>
</div>
<div id="S3.SS1.SSS4.p2" class="ltx_para ltx_noindent">
<p id="S3.SS1.SSS4.p2.1" class="ltx_p">In words, even when the observed dataset cannot be rationalized as Pareto-efficient, the solution to (<a href="#S3.E12" title="Equation 12 ‣ Corollary 2 (Proximity to Pareto-Efficiency). ‣ III-A4 Quantifying Proximity to Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) yields the minimal relaxation needed for feasibility. Thus,
<math id="S3.SS1.SSS4.p2.m1" class="ltx_Math" alttext="\phi(\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\mathcal{D})</annotation></semantics></math> serves as a principled measure of the dataset’s <em id="S3.SS1.SSS4.p2.1.1" class="ltx_emph ltx_font_italic">proximity to Pareto-efficient coordination</em>.</p>
</div>
<div id="S3.SS1.SSS4.p3" class="ltx_para">
<p id="S3.SS1.SSS4.p3.1" class="ltx_p">We next use this proximity measure to develop an optimal (Type-I error minimizing) statistical detector for determining consistency with Pareto-efficient coordination from noisy measurements of system dynamics.</p>
</div>
</section>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S3.SS2.6" class="ltx_text">III-B</span> </span><span id="S3.SS2.7" class="ltx_text ltx_font_italic">Type-I Error Minimizing Statistical Detector</span></h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">We now consider the realistic case when the dataset <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> is corrupted by noise. We provide a statistical detector for determining whether these <span id="S3.SS2.p1.1.1" class="ltx_text ltx_font_italic">noisy</span> responses are consistent with multi-objective optimization, with theoretical guarantees on Type-I error. In this noisy regime the utility reconstruction formula (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) no longer exactly holds; in Section <a href="#S4" title="IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">IV</span></a> we develop a distributionally robust reconstruction procedure for reliably estimating utilities in this noisy regime.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">Let <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> denote the dataset when the radar responses are observed in noise:</p>
<table id="S3.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E13.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}=\{\alpha_{t},\tilde{\beta}^{i}_{t},t\in[T],i\in[M]\}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>β</mi><mo>~</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathcal{D}}=\{\alpha_{t},\tilde{\beta}^{i}_{t},t\in[T],i\in[M]\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p2.2" class="ltx_p">where <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="\tilde{\beta}^{i}_{t}=\beta^{i}_{t}+\epsilon^{i}_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>β</mi><mo>~</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>=</mo><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>+</mo><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\beta}^{i}_{t}=\beta^{i}_{t}+\epsilon^{i}_{t}</annotation></semantics></math>, and <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="\epsilon^{i}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\epsilon^{i}_{t}</annotation></semantics></math> are i.i.d. random variables distributed according to some distribution <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="\Lambda^{i}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\Lambda^{i}_{t}</annotation></semantics></math>.
We propose a statistical detector to optimally determine if the responses are consistent with Pareto optimality (<a href="#S2.E1" title="Equation 1 ‣ II-A Multi-Objective Optimization ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>). Define 
<br class="ltx_break"><math id="S3.SS2.p2.m5" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>: null hypothesis that the dataset (<a href="#S3.E13" title="Equation 13 ‣ III-B Type-I Error Minimizing Statistical Detector ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) arises from the optimization problem (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) for all <math id="S3.SS2.p2.m6" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>. 
<br class="ltx_break"><math id="S3.SS2.p2.m7" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>: alternative hypothesis that the dataset (<a href="#S3.E13" title="Equation 13 ‣ III-B Type-I Error Minimizing Statistical Detector ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) does not arise from the optimization problem (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) for all <math id="S3.SS2.p2.m8" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>.</p>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p">There are two possible sources of error: 
<br class="ltx_break"><span id="S3.SS2.p3.1.1" class="ltx_text ltx_font_bold">Type-I error</span>: Reject <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> when <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> is valid.
<br class="ltx_break"><span id="S3.SS2.p3.1.2" class="ltx_text ltx_font_bold">Type-II error</span>: Accept <math id="S3.SS2.p3.m3" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> when <math id="S3.SS2.p3.m4" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> is invalid.</p>
</div>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Detecting Multi-Objective Optimization</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg2.l1.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l1.m1" class="ltx_Math" alttext="l=1:L" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=1:L</annotation></semantics></math> <span id="alg2.l1.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
              <span id="alg2.l2.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l2.m1" class="ltx_Math" alttext="i=1:M" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">i=1:M</annotation></semantics></math> <span id="alg2.l2.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
               simulate <math id="alg2.l3.m1" class="ltx_Math" alttext="\bm{\epsilon}^{i}_{l}=[\epsilon^{i}_{1},\dots,\epsilon^{i}_{N}]^{(l)},\quad\epsilon^{i}_{t}\sim\Lambda_{t}^{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mi>l</mi><mi>i</mi></msubsup><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>ϵ</mi><mn>1</mn><mi>i</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>ϵ</mi><mi>N</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup><mo>∼</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>t</mi><mi>i</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\bm{\epsilon}^{i}_{l}=[\epsilon^{i}_{1},\dots,\epsilon^{i}_{N}]^{(l)},\quad\epsilon^{i}_{t}\sim\Lambda_{t}^{i}</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              <span id="alg2.l4.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l4.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              Compute <math id="alg2.l5.m1" class="ltx_Math" alttext="\Psi^{l}:=\max_{i}\{\max_{t\neq s}[\alpha_{t}(\epsilon_{t}^{i}-\epsilon_{s}^{i})]\}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>l</mi></msup><mo>:=</mo><mrow><msub><mi>max</mi><mi>i</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>max</mi><mrow><mi>t</mi><mo>≠</mo><mi>s</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>ϵ</mi><mi>s</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi^{l}:=\max_{i}\{\max_{t\neq s}[\alpha_{t}(\epsilon_{t}^{i}-\epsilon_{s}^{i})]\}</annotation></semantics></math>

</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <span id="alg2.l6.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l6.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            Compute <math id="alg2.l7.m1" class="ltx_Math" alttext="\hat{F}_{\Psi}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{F}_{\Psi}(\cdot)</annotation></semantics></math> from <math id="alg2.l7.m2" class="ltx_Math" alttext="\{\Psi^{l}\}_{l=1}^{L}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi mathvariant="normal">Ψ</mi><mi>l</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><annotation encoding="application/x-tex">\{\Psi^{l}\}_{l=1}^{L}</annotation></semantics></math>

</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            Record dataset <math id="alg2.l8.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math>

</div>
<div id="alg2.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            Solve (<a href="#S3.E14" title="Equation 14 ‣ III-B Type-I Error Minimizing Statistical Detector ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) for <math id="alg2.l9.m1" class="ltx_Math" alttext="\Phi^{*}(\bar{\bm{\beta}})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{*}(\bar{\bm{\beta}})</annotation></semantics></math>

</div>
<div id="alg2.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            Save <math id="alg2.l10.m1" class="ltx_Math" alttext="\mathcal{P}:=\{\hat{u}_{t}^{i},\hat{\lambda}_{t}^{i},t\in[T],i\in[M]\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}:=\{\hat{u}_{t}^{i},\hat{\lambda}_{t}^{i},t\in[T],i\in[M]\}</annotation></semantics></math> such that

<table id="S3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex7.m1" class="ltx_Math" alttext="\displaystyle\hat{u}_{s}^{i}-\hat{u}_{t}^{i}-\hat{\lambda}_{t}^{i}\alpha_{t}^{\top}(\bar{\beta}^{i}_{s}-\bar{\beta}_{t}^{i})-\hat{\lambda}_{t}^{i}\hat{\Phi}^{i}(\tilde{\mathcal{D}})\leq 0\ \forall i\in[M]" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>β</mi><mo>¯</mo></mover><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>β</mi><mo>¯</mo></mover><mi>t</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>0</mn><mo lspace="0.667em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{u}_{s}^{i}-\hat{u}_{t}^{i}-\hat{\lambda}_{t}^{i}\alpha_{t}^{\top}(\bar{\beta}^{i}_{s}-\bar{\beta}_{t}^{i})-\hat{\lambda}_{t}^{i}\hat{\Phi}^{i}(\tilde{\mathcal{D}})\leq 0\ \forall i\in[M]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>

</div>
<div id="alg2.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
            Implement detector (<a href="#S3.E17" title="Equation 17 ‣ III-B Type-I Error Minimizing Statistical Detector ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) as

<table id="S3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex8.m1" class="ltx_Math" alttext="1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))\begin{cases}&gt;\gamma\Rightarrow H_{0}\\
\leq\gamma\Rightarrow H_{1}\end{cases}" display="block" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>&gt;</mo><mi>γ</mi><mo stretchy="false">⇒</mo><msub><mi>H</mi><mn>0</mn></msub></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mi>γ</mi><mo stretchy="false">⇒</mo><msub><mi>H</mi><mn>1</mn></msub></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))\begin{cases}&gt;\gamma\Rightarrow H_{0}\\
\leq\gamma\Rightarrow H_{1}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
            <span id="alg2.l12.3" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l12.m1" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> <span id="alg2.l12.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              Reconstruct objective functions from (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>)

</div>
<div id="alg2.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
            <span id="alg2.l14.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l14.4" class="ltx_text ltx_font_bold">if</span>
</div>
</div>
</figure>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p">We formulate the following test statistic <math id="S3.SS2.p4.m1" class="ltx_Math" alttext="\Phi^{*}(\bar{\bm{\beta}})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{*}(\bar{\bm{\beta}})</annotation></semantics></math>, as a function of <math id="S3.SS2.p4.m2" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math>, to be used in the detector:</p>
<table id="S3.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E14.m1" class="ltx_Math" alttext="\Phi^{*}(\bar{\bm{\beta}})=\max_{i}\hat{\Phi}^{i}(\tilde{\mathcal{D}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><munder><mi>max</mi><mi>i</mi></munder><mo lspace="0.167em">⁡</mo><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mi>i</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{*}(\bar{\bm{\beta}})=\max_{i}\hat{\Phi}^{i}(\tilde{\mathcal{D}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p4.2" class="ltx_p">where <math id="S3.SS2.p4.m3" class="ltx_Math" alttext="\hat{\Phi}^{i}(\tilde{\mathcal{D}})" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\Phi}^{i}(\tilde{\mathcal{D}})</annotation></semantics></math> is the solution to:</p>
<table id="S3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.E15.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\min\Phi^{i}:\exists\ u_{t}^{i}&gt;0,\lambda_{t}^{i}&gt;0:\\
&amp;u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}(\bar{\beta}^{i}_{s}-\bar{\beta}_{t}^{i})-\lambda_{t}^{i}\Phi^{i}\leq 0\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><msup><mi mathvariant="normal">Φ</mi><mi>i</mi></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo rspace="1.167em">∃</mo><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo>,</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo>&gt;</mo><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi>u</mi><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>β</mi><mo>¯</mo></mover><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>β</mi><mo>¯</mo></mover><mi>t</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Φ</mi><mi>i</mi></msup></mrow></mrow><mo>≤</mo><mn>0</mn></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\min\Phi^{i}:\exists\ u_{t}^{i}&gt;0,\lambda_{t}^{i}&gt;0:\\
&amp;u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}(\bar{\beta}^{i}_{s}-\bar{\beta}_{t}^{i})-\lambda_{t}^{i}\Phi^{i}\leq 0\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p4.3" class="ltx_p"><math id="S3.SS2.p4.m4" class="ltx_Math" alttext="\hat{\Phi}^{i}(\tilde{\mathcal{D}})" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\Phi}^{i}(\tilde{\mathcal{D}})</annotation></semantics></math> represents the <span id="S3.SS2.p4.3.1" class="ltx_text ltx_font_italic">proximity</span> to consistency with (<a href="#S3.E9" title="Equation 9 ‣ Item 1 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), as discussed in Corollary <a href="#Thmcorollary2" title="Corollary 2 (Proximity to Pareto-Efficiency). ‣ III-A4 Quantifying Proximity to Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Then, form the random variable <math id="S3.SS2.p4.m5" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> as</p>
<table id="S3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.E16.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\Psi=\max_{i}\Psi^{i}\\
&amp;\Psi^{i}=\max_{t\neq s}[\alpha_{t}^{\top}(\epsilon^{i}_{t}-\epsilon^{i}_{s})]\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi mathvariant="normal">Ψ</mi><mo>=</mo><mrow><munder><mi>max</mi><mi>i</mi></munder><mo lspace="0.167em">⁡</mo><msup><mi mathvariant="normal">Ψ</mi><mi>i</mi></msup></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>i</mi></msup><mo>=</mo><mrow><munder><mi>max</mi><mrow><mi>t</mi><mo>≠</mo><mi>s</mi></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>ϵ</mi><mi>s</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\Psi=\max_{i}\Psi^{i}\\
&amp;\Psi^{i}=\max_{t\neq s}[\alpha_{t}^{\top}(\epsilon^{i}_{t}-\epsilon^{i}_{s})]\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p4.4" class="ltx_p">Then we propose the following statistical detector (with <math id="S3.SS2.p4.m6" class="ltx_Math" alttext="\gamma\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma\in(0,1)</annotation></semantics></math>):</p>
<table id="S3.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E17.m1" class="ltx_Math" alttext="\int_{\Phi^{*}(\bar{\bm{\beta}})}^{\infty}f_{\Psi}(\psi)d\psi\begin{cases}\geq\gamma\Rightarrow H_{0}\\
&lt;\gamma\Rightarrow H_{1}\end{cases}" display="block" intent=":literal"><semantics><mrow><msubsup><mo>∫</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>f</mi><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>ψ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≥</mo><mi>γ</mi><mo stretchy="false">⇒</mo><msub><mi>H</mi><mn>0</mn></msub></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>&lt;</mo><mi>γ</mi><mo stretchy="false">⇒</mo><msub><mi>H</mi><mn>1</mn></msub></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\int_{\Phi^{*}(\bar{\bm{\beta}})}^{\infty}f_{\Psi}(\psi)d\psi\begin{cases}\geq\gamma\Rightarrow H_{0}\\
&lt;\gamma\Rightarrow H_{1}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p4.5" class="ltx_p">where <math id="S3.SS2.p4.m7" class="ltx_Math" alttext="f_{\Psi}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\Psi}(\cdot)</annotation></semantics></math> is the probability density function of <math id="S3.SS2.p4.m8" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>. Let <math id="S3.SS2.p4.m9" class="ltx_Math" alttext="F_{\Psi}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi mathvariant="normal">Ψ</mi></msub><annotation encoding="application/x-tex">F_{\Psi}</annotation></semantics></math> be the cdf of <math id="S3.SS2.p4.m10" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> and <math id="S3.SS2.p4.m11" class="ltx_Math" alttext="\bar{F}_{\Psi}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi mathvariant="normal">Ψ</mi></msub><annotation encoding="application/x-tex">\bar{F}_{\Psi}</annotation></semantics></math> be the complementary cdf of <math id="S3.SS2.p4.m12" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>. Then we have the following guarantees:</p>
</div>
<div id="Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 2</span></span><span id="Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem2.p1" class="ltx_para">
<p id="Thmtheorem2.p1.1" class="ltx_p"><span id="Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Consider the noisy dataset <span id="Thmtheorem2.p1.1.1.1" class="ltx_text ltx_markedasmath">(<a href="#S3.E13" title="Equation 13 ‣ III-B Type-I Error Minimizing Statistical Detector ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>)</span>, and suppose (<a href="#S3.E15" title="Equation 15 ‣ III-B Type-I Error Minimizing Statistical Detector ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) has a feasible solution. Then</span></p>
<ol id="S3.I2" class="ltx_enumerate">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<p id="S3.I2.i1.p1.1" class="ltx_p"><span id="S3.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">The following null hypothesis implication holds:</span></p>
<table id="S3.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E18.m1" class="ltx_math_unparsed" alttext="H_{0}\subseteq\bigcap_{i\in[M]}\{\hat{\Phi}^{i}(\tilde{\mathcal{D}})\leq\Psi^{i}\}" display="block" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>0</mn></msub><mo rspace="0.111em">⊆</mo><munder><mo movablelimits="false" rspace="0em">⋂</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo>≤</mo><msup><mi mathvariant="normal">Ψ</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">H_{0}\subseteq\bigcap_{i\in[M]}\{\hat{\Phi}^{i}(\tilde{\mathcal{D}})\leq\Psi^{i}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<p id="S3.I2.i2.p1.1" class="ltx_p"><span id="S3.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">The probability of Type-I error (false alarm) is</span></p>
<table id="S3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex9.m1" class="ltx_Math" alttext="\mathbb{P}_{\Phi^{*}(\bar{\bm{\beta}})}(H_{1}|H_{0}):=\mathbb{P}(\bar{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))\leq\gamma\ |H_{0})\leq\gamma" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>H</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>F</mi><mo>¯</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>γ</mi></mrow><mo lspace="0.500em" rspace="0em">|</mo><msub><mi>H</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\Phi^{*}(\bar{\bm{\beta}})}(H_{1}|H_{0}):=\mathbb{P}(\bar{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))\leq\gamma\ |H_{0})\leq\gamma</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S3.I2.i3.p1" class="ltx_para">
<p id="S3.I2.i3.p1.1" class="ltx_p"><span id="S3.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">The optimizer </span><math id="S3.I2.i3.p1.m1" class="ltx_Math" alttext="\Phi^{*}(\bar{\bm{\beta}})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{*}(\bar{\bm{\beta}})</annotation></semantics></math><span id="S3.I2.i3.p1.1.2" class="ltx_text ltx_font_italic"> yields the smallest Type-I error bound:</span></p>
<table id="S3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S3.Ex10.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\mathbb{P}_{\bar{\bm{\Phi}}(\tilde{\mathcal{D}})}(H_{1}|H_{0})\geq\mathbb{P}_{\Phi^{*}(\bar{\bm{\beta}})}(H_{1}|H_{0})\quad\\
&amp;\quad\forall\,\,\bar{\bm{\Phi}}(\tilde{\mathcal{D}})\in[\Phi^{*}(\bar{\bm{\beta}}),\Psi]\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mi>ℙ</mi><mrow><mover accent="true"><mi>𝚽</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>H</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>ℙ</mi><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>H</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:2.000em;" width="2.000em"></mspace></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo rspace="0.507em">∀</mo><mrow><mover accent="true"><mi>𝚽</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">Ψ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\mathbb{P}_{\bar{\bm{\Phi}}(\tilde{\mathcal{D}})}(H_{1}|H_{0})\geq\mathbb{P}_{\Phi^{*}(\bar{\bm{\beta}})}(H_{1}|H_{0})\quad\\
&amp;\quad\forall\,\,\bar{\bm{\Phi}}(\tilde{\mathcal{D}})\in[\Phi^{*}(\bar{\bm{\beta}}),\Psi]\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS2.8" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p5" class="ltx_para">
<p id="S3.SS2.p5.1" class="ltx_p"><span id="S3.SS2.p5.1.1" class="ltx_text">See Appendix <a href="#S8.SS3" title="VIII-C Proof of Theorem ‣ VIII Appendix ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">VIII-C</span></a>
∎</span></p>
</div>
</div>
<div id="S3.SS2.p6" class="ltx_para">
<p id="S3.SS2.p6.1" class="ltx_p">The contribution of this detector is that it provides a strict guarantee on the upper bound of probability of Type-I error; the specific choice of threshold <math id="S3.SS2.p6.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is left to any particular problem application and may vary depending on design criteria.</p>
</div>
<div id="S3.SS2.p7" class="ltx_para">
<p id="S3.SS2.p7.1" class="ltx_p"><span id="S3.SS2.p7.1.1" class="ltx_text ltx_font_italic">Practical Implementation</span>: In practice we typically do not have access to the density <math id="S3.SS2.p7.m1" class="ltx_Math" alttext="f_{\Psi}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\Psi}(\cdot)</annotation></semantics></math>, but often have some assumptions on the noise statistics captured by the distributions <math id="S3.SS2.p7.m2" class="ltx_Math" alttext="\Lambda_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{t}^{i}</annotation></semantics></math>, such as additive Gaussianity. Thus, we propose to compute an approximation <math id="S3.SS2.p7.m3" class="ltx_Math" alttext="\hat{F}_{\Psi}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{F}_{\Psi}(\cdot)</annotation></semantics></math> of the CDF <math id="S3.SS2.p7.m4" class="ltx_Math" alttext="F_{\Psi}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F_{\Psi}(\cdot)</annotation></semantics></math> using structure of the noise statistics. Algorithm <a href="#alg2" title="Algorithm 2 ‣ III-B Type-I Error Minimizing Statistical Detector ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> then provides a practically feasible implementation of the statistical detector.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">IV </span><span id="S4.2" class="ltx_text ltx_font_smallcaps">Main Result II. Distributionally Robust Utility Reconstruction</span></h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">While the previous section addressed statistical <span id="S4.p1.1.1" class="ltx_text ltx_font_italic">detection</span> of Pareto-efficient coordination in a multi-agent system, this section addresses how to reliably <span id="S4.p1.1.2" class="ltx_text ltx_font_italic">reconstruct utility functions</span> of the agents in this noisy signal regime. We develop a <span id="S4.p1.1.3" class="ltx_text ltx_font_italic">distributionally robust</span> utility reconstruction procedure, which minimizes the worst-case reconstruction error within a specified statistical radius centered at the noisy empirical signals.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">In realistic sensing environments, the analyst does not observe the agents’ responses <math id="S4.p2.m1" class="ltx_Math" alttext="{\beta_{t}^{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">{\beta_{t}^{i}}</annotation></semantics></math> exactly, but only noisy versions corrupted by the measurement process. This noise can be substantial, e.g., when observing "covert" UAVs; this covertness directly translates into lower bounds on the covariance of any filter estimates. As a result, the empirical datasets <math id="S4.p2.m2" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> used for utility reconstruction (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) may fail to satisfy rationalizability, even when the true underlying responses do. The classical application of utility reconstruction (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) then produces estimates which are highly sensitive to perturbations: they may appear accurate on average but admit arbitrarily poor approximation in the worst case. For radar or adversarial applications, however, bounding the worst-case error is critical, since a single highly misleading estimate may compromise detection or tracking. These considerations motivate the development of a distributionally robust reconstruction procedure, which explicitly hedges against statistical noise by optimizing over neighborhoods of the empirical distribution. By doing so, we guarantee utility estimates that remain consistent not only on average, but also under adversarial perturbations of the observed data, thus ensuring reliability of the reconstruction in covert and noisy multi-agent sensing regimes.</p>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">Here we derive a distributionally robust IRL methodology for reconstructing utility functions from the noisy dataset (<a href="#S4.E19" title="Equation 19 ‣ IV-A Identifying Near-Pareto-Efficient Behavior ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>). <span id="footnote9" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">9</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">9</sup>
            <span class="ltx_tag ltx_tag_note">9</span>
            
            
            
            
            
            
            
          Let us further discuss the motivation for this robust utility estimation, in the context of multi-UAV systems. In Section <a href="#S5" title="V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">V</span></a>, we derive a high-level constrained multi-objective optimization (<a href="#S5.E28" title="Equation 28 ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>) for covert multi-UAV coordination. The constraint on the group’s observability translates, when instantiated in the algorithmic filtering level of Section <a href="#S5.SS2" title="V-B Deriving the Covertness Bound from Tracking Dynamics ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">V-B</span></a>, to a bound (<a href="#S5.E35" title="Equation 35 ‣ V-B2 Deriving the Linear Spectral Constraint ‣ V-B Deriving the Covertness Bound from Tracking Dynamics ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>) on the radar’s measurement precision. This is quantified directly as a lower bound on the measurement covariance in any filtering scheme, and thus induces substantial statistical noise in the filtering process which challenges the radar’s utility reconstruction. Specifically, large noise variance will lead to utility estimates which will deviate from the true utility functions on average and deviate substantially in the worst-case. Thus, to combat this we propose a <span id="footnote9.2" class="ltx_text ltx_font_italic">distributionally robust</span> scheme for utility reconstruction.</span></span></span> This scheme provably, as we motivate theoretically, reduces the worst-case error of the utility estimates. Furthermore, we demonstrate in numerical results that it reduces both the worst-case <span id="S4.p3.1.1" class="ltx_text ltx_font_italic">and</span> average-case estimation error, and can be computed efficiently.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS1.6" class="ltx_text">IV-A</span> </span><span id="S4.SS1.7" class="ltx_text ltx_font_italic">Identifying Near-Pareto-Efficient Behavior</span></h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Suppose we obtain a dataset of probes <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> and noisy signals <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="\hat{\beta}_{t}^{i}=\beta_{t}^{i}+\epsilon_{t}^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>=</mo><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>+</mo><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\hat{\beta}_{t}^{i}=\beta_{t}^{i}+\epsilon_{t}^{i}</annotation></semantics></math>, where <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="\epsilon_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\epsilon_{t}^{i}</annotation></semantics></math> is additive noise. Recall this noisy dataset is denoted as</p>
<table id="S4.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E19.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}:=\{\alpha_{t},\hat{\beta}_{t}^{i},t\in[T]\}_{i\in[M]}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo>:=</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{\mathcal{D}}:=\{\alpha_{t},\hat{\beta}_{t}^{i},t\in[T]\}_{i\in[M]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p1.2" class="ltx_p">By Corollary <a href="#Thmcorollary2" title="Corollary 2 (Proximity to Pareto-Efficiency). ‣ III-A4 Quantifying Proximity to Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, constructing the following function <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> acting on <math id="S4.SS1.p1.m5" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> provides a quantitative measure of its deviation from Pareto-efficiency.</p>
<table id="S4.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.E20.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\phi(\tilde{\mathcal{D}})=&amp;\arg\min_{r}:\exists\{u_{t}^{i}\in\mathbb{R},\lambda_{t}^{i}&gt;0,t\in[T]\}_{i\in[M]}:\\
&amp;u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}[\hat{\beta}_{s}^{i}-\hat{\beta}_{t}^{i}]\leq\lambda_{t}^{i}\,r\quad\forall t,s,i\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>min</mi><mi>r</mi></munder></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>∃</mo><msub><mrow><mo stretchy="false">{</mo><mrow><mrow><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo>∈</mo><mi>ℝ</mi></mrow><mo>,</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.278em" stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><mo rspace="0.278em">:</mo><mphantom></mphantom></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msubsup><mi>u</mi><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0.170em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mspace style="width:2.167em;" width="2.167em"></mspace><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>,</mo><mi>s</mi><mo>,</mo><mi>i</mi></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\phi(\tilde{\mathcal{D}})=&amp;\arg\min_{r}:\exists\{u_{t}^{i}\in\mathbb{R},\lambda_{t}^{i}&gt;0,t\in[T]\}_{i\in[M]}:\\
&amp;u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}[\hat{\beta}_{s}^{i}-\hat{\beta}_{t}^{i}]\leq\lambda_{t}^{i}\,r\quad\forall t,s,i\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p1.3" class="ltx_p">If <math id="S4.SS1.p1.m6" class="ltx_Math" alttext="\phi(\tilde{\mathcal{D}})\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\phi(\tilde{\mathcal{D}})\leq 0</annotation></semantics></math> then, by Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, the dataset <math id="S4.SS1.p1.m7" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> is consistent with coordination, and utility functions rationalizing <math id="S4.SS1.p1.m8" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> can be constructed as (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>). However, given the noise in <math id="S4.SS1.p1.m9" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> it is likely that <math id="S4.SS1.p1.m10" class="ltx_Math" alttext="\phi(\tilde{\mathcal{D}})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\phi(\tilde{\mathcal{D}})&gt;0</annotation></semantics></math>, meaning there do not exist utility functions rationalizing <math id="S4.SS1.p1.m11" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math>; but in this case <math id="S4.SS1.p1.m12" class="ltx_Math" alttext="\phi(\tilde{\mathcal{D}})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\tilde{\mathcal{D}})</annotation></semantics></math> represents the <span id="S4.SS1.p1.3.1" class="ltx_text ltx_font_italic">proximity</span> to consistency with (<a href="#S3.E9" title="Equation 9 ‣ Item 1 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), or "optimality", as in Corollary <a href="#Thmcorollary2" title="Corollary 2 (Proximity to Pareto-Efficiency). ‣ III-A4 Quantifying Proximity to Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">In the case when <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\phi(\tilde{\mathcal{D}})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\phi(\tilde{\mathcal{D}})&gt;0</annotation></semantics></math> and Corollary <a href="#Thmcorollary1" title="Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> no longer applies, how can we reconstruct utility functions which are good <span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_italic">approximations</span> of those rationalizing <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math>? We first outline the classical approach, then propose our robust solution. This robust solution provides accurate utility estimates even in the case of stochastic or adversarial perturbations, which is crucial for prediction of strategic multi-agent system behavior.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS2.6" class="ltx_text">IV-B</span> </span><span id="S4.SS2.7" class="ltx_text ltx_font_italic">Utility Reconstruction: Classical Approach to Utility Reconstruction</span></h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">Suppose the <span id="S4.SS2.p1.1.1" class="ltx_text ltx_font_italic">true</span> dataset <math id="S4.SS2.p1.m1" class="ltx_Math" alttext="\mathcal{D}=\{\alpha_{t},\beta_{t}^{i}\,t\in[T]\}_{i\in[M]}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><mrow><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{D}=\{\alpha_{t},\beta_{t}^{i}\,t\in[T]\}_{i\in[M]}</annotation></semantics></math> satisfies (<a href="#S3.E9" title="Equation 9 ‣ Item 1 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>). Then, utility functions <math id="S4.SS2.p1.m2" class="ltx_Math" alttext="\{f^{i}(\cdot)\}_{i\in[M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>f</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{f^{i}(\cdot)\}_{i\in[M]}</annotation></semantics></math> rationalizing <math id="S4.SS2.p1.m3" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> can be constructed by (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) using parameters</p>
<table id="S4.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex11.m1" class="ltx_Math" alttext="\psi:=[u_{1}^{1},\lambda_{1}^{1},\dots,u_{T}^{M},\lambda_{T}^{M}]^{\top}\in\Psi\subseteq\mathbb{R}^{2TM}" display="block" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>:=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>u</mi><mn>1</mn><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>λ</mi><mn>1</mn><mn>1</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>u</mi><mi>T</mi><mi>M</mi></msubsup><mo>,</mo><msubsup><mi>λ</mi><mi>T</mi><mi>M</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo>∈</mo><mi mathvariant="normal">Ψ</mi><mo>⊆</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\psi:=[u_{1}^{1},\lambda_{1}^{1},\dots,u_{T}^{M},\lambda_{T}^{M}]^{\top}\in\Psi\subseteq\mathbb{R}^{2TM}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p1.2" class="ltx_p">taken from (<a href="#S3.E10" title="Equation 10 ‣ Item 2 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>), where <math id="S4.SS2.p1.m4" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> denotes the feasible space of vectors <math id="S4.SS2.p1.m5" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">When handling the <span id="S4.SS2.p2.1.1" class="ltx_text ltx_font_italic">noisy</span> dataset <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math>, our goal is to reconstruct utility functions <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="\{\hat{f}^{i}(\cdot)\}_{i\in[M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{\hat{f}^{i}(\cdot)\}_{i\in[M]}</annotation></semantics></math> closely approximating these <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="\{f^{i}(\cdot)\}_{i\in[M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>f</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{f^{i}(\cdot)\}_{i\in[M]}</annotation></semantics></math>.
Let <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="\hat{\psi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\psi}</annotation></semantics></math> denote the vector corresponding to the parameters <math id="S4.SS2.p2.m5" class="ltx_Math" alttext="\{\hat{u}_{t}^{i},\hat{\lambda}_{t}^{i},t\in[T]\}_{i\in[M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{\hat{u}_{t}^{i},\hat{\lambda}_{t}^{i},t\in[T]\}_{i\in[M]}</annotation></semantics></math> such that</p>
<table id="S4.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E21.m1" class="ltx_Math" alttext="\hat{u}_{s}^{i}-\hat{u}_{t}^{i}-\hat{\lambda}_{t}^{i}\alpha_{t}^{\top}[\hat{\beta}_{s}^{i}-\hat{\beta}_{t}^{i}]\leq\hat{\lambda}_{t}^{i}\,\phi(\tilde{\mathcal{D}})" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{u}_{s}^{i}-\hat{u}_{t}^{i}-\hat{\lambda}_{t}^{i}\alpha_{t}^{\top}[\hat{\beta}_{s}^{i}-\hat{\beta}_{t}^{i}]\leq\hat{\lambda}_{t}^{i}\,\phi(\tilde{\mathcal{D}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="S4.SS2.p2.2" class="ltx_p">Since <math id="S4.SS2.p2.m6" class="ltx_Math" alttext="\phi(\tilde{\mathcal{D}})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\tilde{\mathcal{D}})</annotation></semantics></math> represents the closest "distance" to optimality, by (<a href="#S4.E20" title="Equation 20 ‣ IV-A Identifying Near-Pareto-Efficient Behavior ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>), we have that the utility functions</p>
<table id="S4.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E22.m1" class="ltx_math_unparsed" alttext="\hat{f}^{i}(\cdot):=\min_{t\in[T]}[\hat{u}_{t}^{i}+\hat{\lambda}_{t}^{i}\alpha_{t}^{\top}[\cdot-\hat{\beta}_{t}^{i}]]" display="block" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>:=</mo><munder><mi>min</mi><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo stretchy="false">[</mo><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>+</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{f}^{i}(\cdot):=\min_{t\in[T]}[\hat{u}_{t}^{i}+\hat{\lambda}_{t}^{i}\alpha_{t}^{\top}[\cdot-\hat{\beta}_{t}^{i}]]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="S4.SS2.p2.3" class="ltx_p">are the best estimates for <math id="S4.SS2.p2.m7" class="ltx_Math" alttext="\{f^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>f</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{f^{i}\}_{i=1}^{M}</annotation></semantics></math>, in a specific sense.<span id="footnote10" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">10</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">10</sup>
              <span class="ltx_tag ltx_tag_note">10</span>
              
              
              
              
              
              
              
            This notion of estimation accuracy can be made precise by considering the Hausdorff distance between Pareto-efficient surfaces generated by <math id="footnote10.m1" class="ltx_Math" alttext="\{\hat{f}^{i}\}_{i\in[M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msup><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{\hat{f}^{i}\}_{i\in[M]}</annotation></semantics></math> and <math id="footnote10.m2" class="ltx_Math" alttext="\{f^{i}\}_{i\in[M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msup><mi>f</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{f^{i}\}_{i\in[M]}</annotation></semantics></math>. This is explained in Sec. <a href="#S6" title="VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">VI</span></a>.</span></span></span></p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">However, the stochastic perturbations in <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> may result in reconstructed utility functions (<a href="#S4.E22" title="Equation 22 ‣ IV-B Utility Reconstruction: Classical Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) which approximate the true utility functions very poorly in some stochastic realizations ("cases"), even if on average this approximation is acceptable. In particular we have no control over the <span id="S4.SS2.p3.1.1" class="ltx_text ltx_font_italic">worst-case</span> approximation, which is necessary to control in many applications <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib33" title="" class="ltx_ref">33</a>]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>; this can be addressed using <span id="S4.SS2.p3.1.2" class="ltx_text ltx_font_italic">robust</span> approaches.</p>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS3.6" class="ltx_text">IV-C</span> </span><span id="S4.SS3.7" class="ltx_text ltx_font_italic">Utility Reconstruction: Distributionally Robust (DRO) Approach to Utility Reconstruction</span></h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">Our goal is to construct utility functions from the noisy dataset <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> which minimize the worst-case reconstruction error, while not increasing the average reconstruction error. This is framed as utility reconstruction via distributionally robust optimization, or more precisely Wasserstein-distributionally robust inverse multi-objective optimization. We leverage techniques developed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite> to accomplish this in our revealed preferences setting. We first motivate this framework, then provide the necessary mathematical notation and define the Wasserstein distance, which serves as our metric over distributions allowing us to achieve <span id="S4.SS3.p1.1.1" class="ltx_text ltx_font_italic">distributional</span> robustness.</p>
</div>
<section id="S4.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S4.SS3.SSS1.6" class="ltx_text">IV-C</span>1 </span>Motivating Distributionally Robust Estimation</h4>

<div id="S4.SS3.SSS1.p1" class="ltx_para">
<p id="S4.SS3.SSS1.p1.1" class="ltx_p">The distributionally robust estimation problem can be conceptualized as follows. Consider the classical reconstruction (<a href="#S4.E21" title="Equation 21 ‣ IV-B Utility Reconstruction: Classical Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) through parametrization <math id="S4.SS3.SSS1.p1.m1" class="ltx_Math" alttext="\hat{\psi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\psi}</annotation></semantics></math>. These are obtained through noise-corrupted signals <math id="S4.SS3.SSS1.p1.m2" class="ltx_Math" alttext="\{\hat{\beta}_{t}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\hat{\beta}_{t}^{i}\}_{i=1}^{M}</annotation></semantics></math> with potentially <span id="S4.SS3.SSS1.p1.1.1" class="ltx_text ltx_font_italic">unknown</span> noise distribution. Furthermore, the non-corrupted signals <math id="S4.SS3.SSS1.p1.m3" class="ltx_Math" alttext="\{\beta_{t}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\beta_{t}^{i}\}_{i=1}^{M}</annotation></semantics></math> are rationalized by the "true" utility functions (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) with parameters solving (<a href="#S3.E10" title="Equation 10 ‣ Item 2 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>). Since the noise distribution of the corrupted signals <math id="S4.SS3.SSS1.p1.m4" class="ltx_Math" alttext="\{\hat{\beta}_{t}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\hat{\beta}_{t}^{i}\}_{i=1}^{M}</annotation></semantics></math> is in general unknown, we face inherent <span id="S4.SS3.SSS1.p1.1.2" class="ltx_text ltx_font_italic">statistical ambiguity</span>; reliable estimation in the face of such statistical ambiguity is accomplished most readily by distributionally robust estimation, which minimizes the expected worst-case error over statistical distributions within a neighborhood of the empirical distribution.</p>
</div>
</section>
<section id="S4.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S4.SS3.SSS2.6" class="ltx_text">IV-C</span>2 </span>Mathematical Preliminaries</h4>

<div id="S4.SS3.SSS2.p1" class="ltx_para">
<p id="S4.SS3.SSS2.p1.1" class="ltx_p">Let <math id="S4.SS3.SSS2.p1.m1" class="ltx_Math" alttext="\Phi=\{\beta_{t}^{i},t\in[T]\}_{i\in[M]}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\Phi=\{\beta_{t}^{i},t\in[T]\}_{i\in[M]}</annotation></semantics></math> denote the dataset of signals, and <math id="S4.SS3.SSS2.p1.m2" class="ltx_math_unparsed" alttext="\Gamma=\otimes_{t=1}^{T}\otimes_{i=1}^{M}\Gamma_{t}^{i}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo rspace="0em">=</mo><mo lspace="0em" rspace="0em">⊗</mo><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0.222em">⊗</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>M</mi></msup><mi mathvariant="normal">Γ</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">\Gamma=\otimes_{t=1}^{T}\otimes_{i=1}^{M}\Gamma_{t}^{i}</annotation></semantics></math> the domain of <math id="S4.SS3.SSS2.p1.m3" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>, where <math id="S4.SS3.SSS2.p1.m4" class="ltx_Math" alttext="\beta_{t}^{i}\in\Gamma_{t}^{i}\subseteq\mathbb{R}_{+}^{N}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>∈</mo><msubsup><mi mathvariant="normal">Γ</mi><mi>t</mi><mi>i</mi></msubsup><mo>⊆</mo><msubsup><mi>ℝ</mi><mo>+</mo><mi>N</mi></msubsup></mrow><annotation encoding="application/x-tex">\beta_{t}^{i}\in\Gamma_{t}^{i}\subseteq\mathbb{R}_{+}^{N}</annotation></semantics></math>. Then, a particular (noisy) instantiation <math id="S4.SS3.SSS2.p1.m5" class="ltx_Math" alttext="\{\hat{\beta}_{t}^{i},t\in[T]\}_{i\in[M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{\hat{\beta}_{t}^{i},t\in[T]\}_{i\in[M]}</annotation></semantics></math> corresponds to the empirical distribution <math id="S4.SS3.SSS2.p1.m6" class="ltx_math_unparsed" alttext="P_{T}(\cdot):=\otimes_{t=1}^{T}\otimes_{i=1}^{M}\delta(\cdot-\hat{\beta}_{t}^{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>T</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo rspace="0em">:=</mo><msubsup><mo lspace="0em" rspace="0em">⊗</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><msubsup><mo lspace="0em" rspace="0.222em">⊗</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mi>δ</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">−</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{T}(\cdot):=\otimes_{t=1}^{T}\otimes_{i=1}^{M}\delta(\cdot-\hat{\beta}_{t}^{i})</annotation></semantics></math> on <math id="S4.SS3.SSS2.p1.m7" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>, where <math id="S4.SS3.SSS2.p1.m8" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> denotes the standard Dirac delta function on <math id="S4.SS3.SSS2.p1.m9" class="ltx_Math" alttext="\mathbb{R}^{N}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>N</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{N}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.SSS2.p2" class="ltx_para">
<p id="S4.SS3.SSS2.p2.1" class="ltx_p">Let <math id="S4.SS3.SSS2.p2.m1" class="ltx_Math" alttext="B_{\epsilon}(P_{T})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{\epsilon}(P_{T})</annotation></semantics></math> be the set of probability distributions on <math id="S4.SS3.SSS2.p2.m2" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> with 1-Wasserstein distance at most <math id="S4.SS3.SSS2.p2.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> from <math id="S4.SS3.SSS2.p2.m4" class="ltx_Math" alttext="P_{T}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>T</mi></msub><annotation encoding="application/x-tex">P_{T}</annotation></semantics></math>. The 1-Wasserstein distance between distributions <math id="S4.SS3.SSS2.p2.m5" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> and <math id="S4.SS3.SSS2.p2.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> on space <math id="S4.SS3.SSS2.p2.m7" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math> is given by</p>
<table id="S4.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex12.m1" class="ltx_Math" alttext="\mathcal{W}(Q,P)=\inf_{\pi\in\Pi(Q,P)}\int_{\mathcal{X}\times\mathcal{X}}\|x-y\|_{2}\pi(dx,dy)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mrow><mi>π</mi><mo>∈</mo><mrow><mi mathvariant="normal">Π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mo rspace="0em">∫</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></msub><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>x</mi></mrow><mo>,</mo><mrow><mo lspace="0em" rspace="0em">𝑑</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{W}(Q,P)=\inf_{\pi\in\Pi(Q,P)}\int_{\mathcal{X}\times\mathcal{X}}\|x-y\|_{2}\pi(dx,dy),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS2.p2.2" class="ltx_p">where <math id="S4.SS3.SSS2.p2.m8" class="ltx_Math" alttext="\Pi(Q,P)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Pi(Q,P)</annotation></semantics></math> is the set of probability distributions on <math id="S4.SS3.SSS2.p2.m9" class="ltx_Math" alttext="\mathcal{X}\times\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">\mathcal{X}\times\mathcal{X}</annotation></semantics></math> with marginals <math id="S4.SS3.SSS2.p2.m10" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> and <math id="S4.SS3.SSS2.p2.m11" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>. This is a widely used metric for comparing two probability measures, and has a wealth of useful analytical and computational properties that enable efficient robust optimization <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">12</a>]</cite>.</p>
</div>
</section>
<section id="S4.SS3.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S4.SS3.SSS3.6" class="ltx_text">IV-C</span>3 </span>Wasserstein Distributionally
Robust Utility Estimation</h4>

<div id="S4.SS3.SSS3.p1" class="ltx_para">
<p id="S4.SS3.SSS3.p1.1" class="ltx_p">We can conceptualize the robust estimation objective as the minimax problem</p>
<table id="S4.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.E23.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\min_{\psi\in\Psi}\sup_{Q\sim B_{\epsilon}(P_{T})}\mathbb{E}_{\Phi\sim Q}\left[h(\psi,\Phi)\right]\\
&amp;h(\psi,\Phi):=\arg\min_{r}:u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}[\beta_{s}^{i}-\beta_{t}^{i}]\leq\lambda_{t}^{i}\,r\\
&amp;\psi=[u_{1}^{1},\lambda_{1}^{1},\dots,u_{T}^{M},\lambda_{T}^{M}]^{\top},\,\,\,\Phi=\{\beta_{t}^{i},t\in[T]\}_{i\in[M]}\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mmultiscripts><munder><mo movablelimits="false">sup</mo><mrow><mi>Q</mi><mo>∼</mo><mrow><msub><mi>B</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mprescripts></mprescripts><mrow><mi>ψ</mi><mo>∈</mo><mi mathvariant="normal">Ψ</mi></mrow><mrow></mrow></mmultiscripts><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><mrow><mi mathvariant="normal">Φ</mi><mo>∼</mo><mi>Q</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo>,</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo>,</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>min</mi><mi>r</mi></munder></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>u</mi><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>u</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>β</mi><mi>s</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>i</mi></msubsup><mo lspace="0.170em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>ψ</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>u</mi><mn>1</mn><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>λ</mi><mn>1</mn><mn>1</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>u</mi><mi>T</mi><mi>M</mi></msubsup><mo>,</mo><msubsup><mi>λ</mi><mi>T</mi><mi>M</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><mo rspace="0.847em">,</mo><mrow><mi mathvariant="normal">Φ</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\min_{\psi\in\Psi}\sup_{Q\sim B_{\epsilon}(P_{T})}\mathbb{E}_{\Phi\sim Q}\left[h(\psi,\Phi)\right]\\
&amp;h(\psi,\Phi):=\arg\min_{r}:u_{s}^{i}-u_{t}^{i}-\lambda_{t}^{i}\alpha_{t}^{\top}[\beta_{s}^{i}-\beta_{t}^{i}]\leq\lambda_{t}^{i}\,r\\
&amp;\psi=[u_{1}^{1},\lambda_{1}^{1},\dots,u_{T}^{M},\lambda_{T}^{M}]^{\top},\,\,\,\Phi=\{\beta_{t}^{i},t\in[T]\}_{i\in[M]}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="S4.SS3.SSS3.p1.2" class="ltx_p">The objective (<a href="#S4.E23" title="Equation 23 ‣ IV-C3 Wasserstein Distributionally Robust Utility Estimation ‣ IV-C Utility Reconstruction: Distributionally Robust (DRO) Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) finds the set of parameters <math id="S4.SS3.SSS3.p1.m1" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> which minimizes the worst-case expected proximity to feasibility over possible datasets <math id="S4.SS3.SSS3.p1.m2" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> with <math id="S4.SS3.SSS3.p1.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> 1-Wasserstein proximity to the noisy dataset <math id="S4.SS3.SSS3.p1.m4" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math>. Thus, when compared to the naive estimation procedure (<a href="#S4.E22" title="Equation 22 ‣ IV-B Utility Reconstruction: Classical Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), (<a href="#S4.E23" title="Equation 23 ‣ IV-C3 Wasserstein Distributionally Robust Utility Estimation ‣ IV-C Utility Reconstruction: Distributionally Robust (DRO) Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) will better approximate the true utility functions <span id="S4.SS3.SSS3.p1.2.1" class="ltx_text ltx_font_italic">in the worst case</span>, making (<a href="#S4.E23" title="Equation 23 ‣ IV-C3 Wasserstein Distributionally Robust Utility Estimation ‣ IV-C Utility Reconstruction: Distributionally Robust (DRO) Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) a <span id="S4.SS3.SSS3.p1.2.2" class="ltx_text ltx_font_italic">robust</span> estimation procedure. Such Wasserstein distributionally robust min-max formulations are becoming ubiquitous in machine learning <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">12</a>]</cite>, operations management <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>]</cite> and economics <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib37" title="" class="ltx_ref">37</a>]</cite>.</p>
</div>
<div id="S4.SS3.SSS3.p2" class="ltx_para">
<p id="S4.SS3.SSS3.p2.1" class="ltx_p">It remains to be shown how (<a href="#S4.E23" title="Equation 23 ‣ IV-C3 Wasserstein Distributionally Robust Utility Estimation ‣ IV-C Utility Reconstruction: Distributionally Robust (DRO) Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) can be computed in practice. This is the focus of the following section.</p>
</div>
</section>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS4.6" class="ltx_text">IV-D</span> </span><span id="S4.SS4.7" class="ltx_text ltx_font_italic">Semi-Infinite Programming Approach to Solve the DRO</span></h3>

<div id="S4.SS4.p1" class="ltx_para">
<p id="S4.SS4.p1.1" class="ltx_p">Here we show the equivalence between the distributionally robust utility estimation procedure (<a href="#S4.E23" title="Equation 23 ‣ IV-C3 Wasserstein Distributionally Robust Utility Estimation ‣ IV-C Utility Reconstruction: Distributionally Robust (DRO) Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) and a semi-infinite program. We exploit this equivalence to provide a practical algorithm for computing a set of robust utility estimates.
A semi-infinite program is an optimization problem with a finite number of variables to be optimized but an arbitrary number (continuum) of constraints.</p>
</div>
<div id="S4.SS4.p2" class="ltx_para">
<p id="S4.SS4.p2.1" class="ltx_p">We introduce the following assumptions and notation:</p>
</div>
<div id="Thmassumption1" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption1.2" class="ltx_text ltx_font_bold">Assumption 1</span></span><span id="Thmassumption1.3" class="ltx_text ltx_font_bold"> </span>(Finite Support Noise)<span id="Thmassumption1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption1.p1" class="ltx_para">
<p id="Thmassumption1.p1.1" class="ltx_p">The support of each additive noise <math id="Thmassumption1.p1.m1" class="ltx_Math" alttext="\epsilon_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\epsilon_{t}^{i}</annotation></semantics></math> distribution is contained within a ball of radius <math id="Thmassumption1.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. <span id="footnote11" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">11</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">11</sup>
                <span class="ltx_tag ltx_tag_note">11</span>
                
                
                
                
                
                
                
              This is satisfied in practice since any physical sensor which measures <math id="footnote11.m1" class="ltx_Math" alttext="\beta_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\beta_{t}^{i}</annotation></semantics></math> will have upper and lower bounds on the measured signal power.</span></span></span></p>
</div>
</div>
<div id="Thmassumption2" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption2.2" class="ltx_text ltx_font_bold">Assumption 2</span></span><span id="Thmassumption2.3" class="ltx_text ltx_font_bold"> </span>(Probe Magnitude Bound)<span id="Thmassumption2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption2.p1" class="ltx_para">
<p id="Thmassumption2.p1.1" class="ltx_p"><math id="Thmassumption2.p1.m1" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> is lower bounded in magnitude: <math id="Thmassumption2.p1.m2" class="ltx_Math" alttext="\exists\,\bar{\alpha}:\,\|\alpha_{t}\|\geq\bar{\alpha}&gt;0\,\forall t\in[T]" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.337em">∃</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover></mrow><mo lspace="0.278em" rspace="0.448em">:</mo><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>α</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mo>≥</mo><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mo>&gt;</mo><mrow><mn>0</mn><mo lspace="0.337em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\exists\,\bar{\alpha}:\,\|\alpha_{t}\|\geq\bar{\alpha}&gt;0\,\forall t\in[T]</annotation></semantics></math>.</p>
</div>
</div>
<div id="Thmassumption3" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption3.2" class="ltx_text ltx_font_bold">Assumption 3</span></span><span id="Thmassumption3.3" class="ltx_text ltx_font_bold"> </span>(Parameter Set Bounds)<span id="Thmassumption3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption3.p1" class="ltx_para">
<p id="Thmassumption3.p1.1" class="ltx_p">There exists <math id="Thmassumption3.p1.m1" class="ltx_Math" alttext="\hat{\lambda}&gt;0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\hat{\lambda}&gt;0</annotation></semantics></math> such that <math id="Thmassumption3.p1.m2" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> is restricted to the set <math id="Thmassumption3.p1.m3" class="ltx_Math" alttext="\{[u_{1}^{1},\lambda_{1}^{1},\dots,u_{T}^{M},\lambda_{T}^{M}]\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>u</mi><mn>1</mn><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>λ</mi><mn>1</mn><mn>1</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>u</mi><mi>T</mi><mi>M</mi></msubsup><mo>,</mo><msubsup><mi>λ</mi><mi>T</mi><mi>M</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{[u_{1}^{1},\lambda_{1}^{1},\dots,u_{T}^{M},\lambda_{T}^{M}]\}</annotation></semantics></math> with <math id="Thmassumption3.p1.m4" class="ltx_Math" alttext="u_{s}^{i}\in[-1,1],\,\lambda_{s}^{i}\in[\hat{\lambda},1],\,\forall s\in[T],i\in[M]" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mi>s</mi><mi>i</mi></msubsup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.337em">,</mo><mrow><msubsup><mi>λ</mi><mi>s</mi><mi>i</mi></msubsup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>s</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{s}^{i}\in[-1,1],\,\lambda_{s}^{i}\in[\hat{\lambda},1],\,\forall s\in[T],i\in[M]</annotation></semantics></math>. <span id="footnote12" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">12</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">12</sup>
                <span class="ltx_tag ltx_tag_note">12</span>
                
                
                
                
                
                
                
              This is without loss of generality. Observe: if a set of parameters <math id="footnote12.m1" class="ltx_Math" alttext="\hat{\psi}=[\hat{u}_{1}^{1},\dots,\hat{\lambda}_{T}^{M}]\in\Psi" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mn>1</mn><mn>1</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>T</mi><mi>M</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mi mathvariant="normal">Ψ</mi></mrow><annotation encoding="application/x-tex">\hat{\psi}=[\hat{u}_{1}^{1},\dots,\hat{\lambda}_{T}^{M}]\in\Psi</annotation></semantics></math> solves (<a href="#S4.E21" title="Equation 21 ‣ IV-B Utility Reconstruction: Classical Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>), then so does <math id="footnote12.m2" class="ltx_Math" alttext="c\,\hat{\psi}:=[c\hat{u}_{1}^{1},\dots,c\hat{\lambda}_{T}^{M}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>ψ</mi><mo>^</mo></mover></mrow><mo>:=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mn>1</mn><mn>1</mn></msubsup></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>T</mi><mi>M</mi></msubsup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">c\,\hat{\psi}:=[c\hat{u}_{1}^{1},\dots,c\hat{\lambda}_{T}^{M}]</annotation></semantics></math> for any scalar <math id="footnote12.m3" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>. Also, given the boundedness of <math id="footnote12.m4" class="ltx_Math" alttext="\|\alpha_{t}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><msub><mi>α</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|\alpha_{t}\|</annotation></semantics></math> and <math id="footnote12.m5" class="ltx_Math" alttext="\|\beta_{t}^{i}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|\beta_{t}^{i}\|</annotation></semantics></math> the ratio <math id="footnote12.m6" class="ltx_Math" alttext="\hat{u}_{s}^{i}/\hat{\lambda}_{t}^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>s</mi><mi>i</mi></msubsup><mo>/</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup></mrow><annotation encoding="application/x-tex">\hat{u}_{s}^{i}/\hat{\lambda}_{t}^{i}</annotation></semantics></math> will be bounded from above and below by positive real numbers. Thus, we can always find some <math id="footnote12.m7" class="ltx_Math" alttext="\hat{\psi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\psi}</annotation></semantics></math> solving (<a href="#S4.E21" title="Equation 21 ‣ IV-B Utility Reconstruction: Classical Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) such that <math id="footnote12.m8" class="ltx_Math" alttext="\hat{u}_{s}^{i}\in[-1,1],\,\hat{\lambda}_{s}^{i}\in[\hat{\lambda},1],\forall s\in[T],i\in[M]" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>s</mi><mi>i</mi></msubsup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.337em">,</mo><mrow><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>s</mi><mi>i</mi></msubsup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>s</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{u}_{s}^{i}\in[-1,1],\,\hat{\lambda}_{s}^{i}\in[\hat{\lambda},1],\forall s\in[T],i\in[M]</annotation></semantics></math>, with <math id="footnote12.m9" class="ltx_Math" alttext="\hat{\lambda}&gt;0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\hat{\lambda}&gt;0</annotation></semantics></math>.</span></span></span></p>
</div>
</div>
<div id="S4.SS4.p3" class="ltx_para">
<p id="S4.SS4.p3.1" class="ltx_p">By Assumptions <a href="#Thmassumption2" title="Assumption 2 (Probe Magnitude Bound). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, <a href="#Thmassumption3" title="Assumption 3 (Parameter Set Bounds). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, and the constraint in (<a href="#S3.E9" title="Equation 9 ‣ Item 1 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), we must have that <math id="S4.SS4.p3.m1" class="ltx_Math" alttext="h(\psi,\Phi)\leq V:=2(1+R)+2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo>,</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>V</mi><mo>:=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">h(\psi,\Phi)\leq V:=2(1+R)+2</annotation></semantics></math> for any <math id="S4.SS4.p3.m2" class="ltx_Math" alttext="\psi\in\Psi,\,\Phi\in\Gamma" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ψ</mi><mo>∈</mo><mi mathvariant="normal">Ψ</mi></mrow><mo rspace="0.337em">,</mo><mrow><mi mathvariant="normal">Φ</mi><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow></mrow><annotation encoding="application/x-tex">\psi\in\Psi,\,\Phi\in\Gamma</annotation></semantics></math>, with <math id="S4.SS4.p3.m3" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> satisfying Assumption <a href="#Thmassumption3" title="Assumption 3 (Parameter Set Bounds). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.
Let us denote <math id="S4.SS4.p3.m4" class="ltx_math_unparsed" alttext="\mathcal{V}:=\biggl\{\bm{v}\in\mathbb{R}^{2}:\,\,0\leq v_{1}\leq 2V,\,\,0\leq v_{2}\leq V/\epsilon\biggr\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>𝒗</mi><mo>∈</mo><msup><mi>ℝ</mi><mn>2</mn></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mn>  0</mn><mo>≤</mo><msub><mi>v</mi><mn>1</mn></msub><mo>≤</mo><mn>2</mn><mi>V</mi><mo>,</mo><mn>  0</mn><mo>≤</mo><msub><mi>v</mi><mn>2</mn></msub><mo>≤</mo><mi>V</mi><mo>/</mo><mi>ϵ</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}:=\biggl\{\bm{v}\in\mathbb{R}^{2}:\,\,0\leq v_{1}\leq 2V,\,\,0\leq v_{2}\leq V/\epsilon\biggr\}</annotation></semantics></math>.
Now, we have the following equivalence result.</p>
</div>
<div id="Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem 3</span></span><span id="Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Semi-Infinite Reformulation)<span id="Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem3.p1" class="ltx_para">
<p id="Thmtheorem3.p1.1" class="ltx_p"><span id="Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Under Assumptions <a href="#Thmassumption1" title="Assumption 1 (Finite Support Noise). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> - <a href="#Thmassumption3" title="Assumption 3 (Parameter Set Bounds). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, (<a href="#S4.E23" title="Equation 23 ‣ IV-C3 Wasserstein Distributionally Robust Utility Estimation ‣ IV-C Utility Reconstruction: Distributionally Robust (DRO) Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) is equivalent to the following semi-infinite program:</span></p>
<table id="S4.EGx14" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S4.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E24.m1" class="ltx_Math" alttext="\displaystyle\begin{aligned} \hfil\displaystyle\begin{split}&amp;\min_{\psi\in\Psi,\bm{v}\in\mathcal{V}}\,\epsilon\cdot v_{2}+v_{1}\,\,\,s.t.\,\sup_{\Phi\in\Gamma}G(\psi,\bm{v},\Phi,\hat{\mathcal{D}})\leq 0\\
&amp;G(\psi,\bm{v},\Phi,\hat{\mathcal{D}}):=h(\psi,\Phi)-v_{2}\sum_{i=1}^{M}\sum_{t=1}^{T}\|\beta_{t}^{i}-\hat{\beta}_{t}^{i}\|_{2}-v_{1}\end{split}\end{aligned}" display="block" intent=":literal"><semantics><mtable displaystyle="true"><mtr><mtd columnspan="2"><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><munder><mi>min</mi><mrow><mrow><mi>ψ</mi><mo>∈</mo><mi mathvariant="normal">Ψ</mi></mrow><mo>,</mo><mrow><mi>𝒗</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></mrow></munder><mo lspace="0.507em">⁡</mo><mi>ϵ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mi>v</mi><mn>1</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi><mo lspace="0em" rspace="0.229em">.</mo><mrow><mrow><munder><mo movablelimits="false" rspace="0.167em">sup</mo><mrow><mi mathvariant="normal">Φ</mi><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow></munder><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo>,</mo><mi>𝒗</mi><mo>,</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo mathsize="0.700em">,</mo><mi>𝒗</mi><mo mathsize="0.700em">,</mo><mi mathvariant="normal">Φ</mi><mo mathsize="0.700em">,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo mathsize="0.700em">,</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>v</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><mo>−</mo><msub><mi>v</mi><mn>1</mn></msub></mrow></mrow></mtd></mtr></mtable></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{aligned} \hfil\displaystyle\begin{split}&amp;\min_{\psi\in\Psi,\bm{v}\in\mathcal{V}}\,\epsilon\cdot v_{2}+v_{1}\,\,\,s.t.\,\sup_{\Phi\in\Gamma}G(\psi,\bm{v},\Phi,\hat{\mathcal{D}})\leq 0\\
&amp;G(\psi,\bm{v},\Phi,\hat{\mathcal{D}}):=h(\psi,\Phi)-v_{2}\sum_{i=1}^{M}\sum_{t=1}^{T}\|\beta_{t}^{i}-\hat{\beta}_{t}^{i}\|_{2}-v_{1}\end{split}\end{aligned}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS4.8" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS4.p4" class="ltx_para">
<p id="S4.SS4.p4.1" class="ltx_p"><span id="S4.SS4.p4.1.1" class="ltx_text">Under Assumptions <a href="#Thmassumption1" title="Assumption 1 (Finite Support Noise). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>-<a href="#Thmassumption3" title="Assumption 3 (Parameter Set Bounds). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, <math id="S4.SS4.p4.m1" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> and <math id="S4.SS4.p4.m2" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math> are compact. We have observed that <math id="S4.SS4.p4.m3" class="ltx_Math" alttext="h(\psi,\Phi)\leq V" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo>,</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">h(\psi,\Phi)\leq V</annotation></semantics></math>. Now observe by inspection that <math id="S4.SS4.p4.m4" class="ltx_Math" alttext="h(\psi,\Phi)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo>,</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h(\psi,\Phi)</annotation></semantics></math> is uniformly Lipschitz continuous in <math id="S4.SS4.p4.m5" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> and <math id="S4.SS4.p4.m6" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>. Thus we can apply Corollary 3.8 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">38</a>]</cite>.
∎</span></p>
</div>
</div>
</section>
<section id="S4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS5.6" class="ltx_text">IV-E</span> </span><math id="S4.SS5.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math><span id="S4.SS5.7" class="ltx_text ltx_font_italic">-Optimal Robust Utility Reconstruction via Finite Reduction</span></h3>

<div id="S4.SS5.p1" class="ltx_para">
<p id="S4.SS5.p1.1" class="ltx_p">How to solve the semi-infinite program (<a href="#S4.E24" title="Equation 24 ‣ Theorem 3 (Semi-Infinite Reformulation). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) computationally? Here we provide a practical finite algorithmic approach which achieves solutions of (<a href="#S4.E24" title="Equation 24 ‣ Theorem 3 (Semi-Infinite Reformulation). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) with arbitrary accuracy, using exchange methods <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">40</a>]</cite>.
We first approximate it by a finite optimization, then iteratively solve this while appending constraints. Let <math id="S4.SS5.p1.m1" class="ltx_Math" alttext="\tilde{\Gamma}=\{\Phi_{1},\dots,\Phi_{J}\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Γ</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi mathvariant="normal">Φ</mi><mi>J</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\Gamma}=\{\Phi_{1},\dots,\Phi_{J}\}</annotation></semantics></math> be a collection of <math id="S4.SS5.p1.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> elements in <math id="S4.SS5.p1.m3" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>, i.e., each <math id="S4.SS5.p1.m4" class="ltx_Math" alttext="\Phi_{j},\,j\in[J]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><mo rspace="0.337em">,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>J</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Phi_{j},\,j\in[J],</annotation></semantics></math> is a dataset <math id="S4.SS5.p1.m5" class="ltx_Math" alttext="\{\beta_{t,j}^{i},t\in[T]\}_{i\in[M]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>β</mi><mrow><mi>t</mi><mo>,</mo><mi>j</mi></mrow><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{\beta_{t,j}^{i},t\in[T]\}_{i\in[M]}</annotation></semantics></math>. Consider
the following finite program:</p>
<table id="S4.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.E25.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\min_{\psi\in\Psi,\bm{v}\in\mathcal{V}}\,\epsilon\cdot v_{2}+v_{1}\\
s.t.\,&amp;\max_{\Phi_{j}\in\tilde{\Gamma}}G(\psi,\bm{v},\Phi_{j},\hat{\mathcal{D}})\leq 0\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><munder><mi>min</mi><mrow><mrow><mi>ψ</mi><mo>∈</mo><mi mathvariant="normal">Ψ</mi></mrow><mo>,</mo><mrow><mi>𝒗</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></mrow></munder><mo lspace="0.507em">⁡</mo><mi>ϵ</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mo>+</mo><msub><mi>v</mi><mn>1</mn></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi></mrow><mo lspace="0em">.</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><munder><mi>max</mi><mrow><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><mo>∈</mo><mover accent="true"><mi mathvariant="normal">Γ</mi><mo>~</mo></mover></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ψ</mi><mo>,</mo><mi>𝒗</mi><mo>,</mo><msub><mi mathvariant="normal">Φ</mi><mi>j</mi></msub><mo>,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\min_{\psi\in\Psi,\bm{v}\in\mathcal{V}}\,\epsilon\cdot v_{2}+v_{1}\\
s.t.\,&amp;\max_{\Phi_{j}\in\tilde{\Gamma}}G(\psi,\bm{v},\Phi_{j},\hat{\mathcal{D}})\leq 0\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="S4.SS5.p1.2" class="ltx_p">We can iteratively refine the constraints in the finite program (<a href="#S4.E25" title="Equation 25 ‣ IV-E 𝛿-Optimal Robust Utility Reconstruction via Finite Reduction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>) by introducing the following maximum constraint violation problem:</p>
<table id="S4.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.E26.m1" class="ltx_Math" alttext="\displaystyle\begin{split}CV=\max_{\Phi\in\Gamma}G(\hat{\psi},\hat{\bm{v}},\Phi,\tilde{\mathcal{D}})\end{split}" display="inline" intent=":literal"><semantics><mtable><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>=</mo><mrow><munder><mi>max</mi><mrow><mi mathvariant="normal">Φ</mi><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mo>,</mo><mover accent="true"><mi>𝒗</mi><mo>^</mo></mover><mo>,</mo><mi mathvariant="normal">Φ</mi><mo>,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}CV=\max_{\Phi\in\Gamma}G(\hat{\psi},\hat{\bm{v}},\Phi,\tilde{\mathcal{D}})\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="S4.SS5.p1.3" class="ltx_p">where <math id="S4.SS5.p1.m6" class="ltx_Math" alttext="\hat{\bm{v}}:=\{\hat{v}_{1},\,\hat{v}_{2}\},\hat{\psi}:=\{\hat{u}_{t}^{i},\hat{\lambda}_{t}^{i},t\in[T]\}_{i\in[M]}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝒗</mi><mo>^</mo></mover><mo>:=</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mn>1</mn></msub><mo rspace="0.337em">,</mo><msub><mover accent="true"><mi>v</mi><mo>^</mo></mover><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mo>:=</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msubsup><mover accent="true"><mi>u</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{\bm{v}}:=\{\hat{v}_{1},\,\hat{v}_{2}\},\hat{\psi}:=\{\hat{u}_{t}^{i},\hat{\lambda}_{t}^{i},t\in[T]\}_{i\in[M]}</annotation></semantics></math> are optimal solutions to (<a href="#S4.E25" title="Equation 25 ‣ IV-E 𝛿-Optimal Robust Utility Reconstruction via Finite Reduction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>) under <math id="S4.SS5.p1.m7" class="ltx_Math" alttext="\tilde{\Gamma}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Γ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\Gamma}</annotation></semantics></math>. Supposing <math id="S4.SS5.p1.m8" class="ltx_Math" alttext="CV&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">CV&gt;0</annotation></semantics></math>, we let <math id="S4.SS5.p1.m9" class="ltx_Math" alttext="\hat{\Phi}\in\Gamma" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow><annotation encoding="application/x-tex">\hat{\Phi}\in\Gamma</annotation></semantics></math> be the argument attaining this maximum and append it to <math id="S4.SS5.p1.m10" class="ltx_Math" alttext="\tilde{\Gamma}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Γ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\Gamma}</annotation></semantics></math> in (<a href="#S4.E25" title="Equation 25 ‣ IV-E 𝛿-Optimal Robust Utility Reconstruction via Finite Reduction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>). Then we iterate, tightening the approximation for the infinite set of constraints in (<a href="#S4.E24" title="Equation 24 ‣ Theorem 3 (Semi-Infinite Reformulation). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) until <math id="S4.SS5.p1.m11" class="ltx_Math" alttext="CV\leq\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>≤</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">CV\leq\delta</annotation></semantics></math>; by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite> this termination yields a <math id="S4.SS5.p1.m12" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-optimal solution of (<a href="#S4.E24" title="Equation 24 ‣ Theorem 3 (Semi-Infinite Reformulation). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>).
<span id="footnote13" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">13</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">13</sup>
              <span class="ltx_tag ltx_tag_note">13</span>
              
              
              
              
              
              
              
            A <math id="footnote13.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-optimal solution solves (<a href="#S4.E24" title="Equation 24 ‣ Theorem 3 (Semi-Infinite Reformulation). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) with the <math id="footnote13.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> r.h.s. replaced by <math id="footnote13.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>; One can show by Lipschitz continuity arguments that this thus approximates the solution <math id="footnote13.m4" class="ltx_Math" alttext="\hat{\psi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\psi}</annotation></semantics></math> of (<a href="#S4.E24" title="Equation 24 ‣ Theorem 3 (Semi-Infinite Reformulation). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) by some constant factor times <math id="footnote13.m5" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> (in e.g., <math id="footnote13.m6" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> norm on <math id="footnote13.m7" class="ltx_Math" alttext="\Psi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ψ</mi><annotation encoding="application/x-tex">\Psi</annotation></semantics></math>); so we approximate arbitrarily well as <math id="footnote13.m8" class="ltx_Math" alttext="\delta\to 0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta\to 0</annotation></semantics></math>.</span></span></span></p>
</div>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Wasserstein Robust Utility Estimation</figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            Input: Noisy dataset <math id="alg3.l1.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}=\{\alpha_{t},\,\hat{\beta}_{t}^{i},t\in[T]\}_{i\in[M]}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo rspace="0.337em">,</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{\mathcal{D}}=\{\alpha_{t},\,\hat{\beta}_{t}^{i},t\in[T]\}_{i\in[M]}</annotation></semantics></math>, Wasserstein radius <math id="alg3.l1.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>, stopping tolerance <math id="alg3.l1.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>.

</div>
<div id="alg3.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            Initialize: <math id="alg3.l2.m1" class="ltx_Math" alttext="\hat{\psi}\in\Psi,\hat{v}\in\mathcal{V},\tilde{\Gamma}\leftarrow\emptyset,CV=\delta+1" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mo>∈</mo><mi mathvariant="normal">Ψ</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi>v</mi><mo>^</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo>,</mo><mrow><mover accent="true"><mi mathvariant="normal">Γ</mi><mo>~</mo></mover><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><mo>,</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>=</mo><mrow><mi>δ</mi><mo>+</mo><mn>1</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\psi}\in\Psi,\hat{v}\in\mathcal{V},\tilde{\Gamma}\leftarrow\emptyset,CV=\delta+1</annotation></semantics></math>.

</div>
<div id="alg3.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg3.l3.3" class="ltx_text ltx_font_bold">while</span> <math id="alg3.l3.m1" class="ltx_Math" alttext="CV\geq\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>≥</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">CV\geq\delta</annotation></semantics></math> <span id="alg3.l3.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              Solve (<a href="#S4.E26" title="Equation 26 ‣ IV-E 𝛿-Optimal Robust Utility Reconstruction via Finite Reduction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) with <math id="alg3.l4.m1" class="ltx_Math" alttext="\hat{\psi},\hat{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mo>,</mo><mover accent="true"><mi>𝒗</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">\hat{\psi},\hat{\bm{v}}</annotation></semantics></math>, returning <math id="alg3.l4.m2" class="ltx_Math" alttext="\hat{\Phi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\Phi}</annotation></semantics></math>, <math id="alg3.l4.m3" class="ltx_Math" alttext="CV" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">CV</annotation></semantics></math>.

</div>
<div id="alg3.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <span id="alg3.l5.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l5.m1" class="ltx_Math" alttext="CV" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">CV</annotation></semantics></math> &gt; 0 <span id="alg3.l5.4" class="ltx_text ltx_font_bold">then</span> <math id="alg3.l5.m2" class="ltx_Math" alttext="\tilde{\Gamma}\leftarrow\tilde{\Gamma}\cup\hat{\Phi}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Γ</mi><mo>~</mo></mover><mo stretchy="false">←</mo><mrow><mover accent="true"><mi mathvariant="normal">Γ</mi><mo>~</mo></mover><mo>∪</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>^</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\tilde{\Gamma}\leftarrow\tilde{\Gamma}\cup\hat{\Phi}</annotation></semantics></math> 
</div>
<div id="alg3.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              <span id="alg3.l6.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l6.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg3.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              Solve (<a href="#S4.E25" title="Equation 25 ‣ IV-E 𝛿-Optimal Robust Utility Reconstruction via Finite Reduction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>) with <math id="alg3.l7.m1" class="ltx_Math" alttext="\tilde{\Gamma}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Γ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\Gamma}</annotation></semantics></math>, returning <math id="alg3.l7.m2" class="ltx_Math" alttext="\hat{\psi},\hat{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mo>,</mo><mover accent="true"><mi>𝒗</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">\hat{\psi},\hat{\bm{v}}</annotation></semantics></math>.

</div>
<div id="alg3.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <span id="alg3.l8.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l8.4" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg3.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            Output: <math id="alg3.l9.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-optimal solution <math id="alg3.l9.m2" class="ltx_Math" alttext="\hat{\psi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\psi}</annotation></semantics></math> of (<a href="#S4.E24" title="Equation 24 ‣ Theorem 3 (Semi-Infinite Reformulation). ‣ IV-D Semi-Infinite Programming Approach to Solve the DRO ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>); thus, of (<a href="#S4.E23" title="Equation 23 ‣ IV-C3 Wasserstein Distributionally Robust Utility Estimation ‣ IV-C Utility Reconstruction: Distributionally Robust (DRO) Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>).

</div>
</div>
</figure>
<div id="S4.SS5.p2" class="ltx_para">
<p id="S4.SS5.p2.1" class="ltx_p">Algorithm <a href="#alg3" title="Algorithm 3 ‣ IV-E 𝛿-Optimal Robust Utility Reconstruction via Finite Reduction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> illustrates this iterative procedure, and by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite> it is guaranteed to converge in
<math id="S4.SS5.p2.m1" class="ltx_Math" alttext="\mathcal{O}\left(\left(\frac{1}{\delta}+1\right)^{2TM+2}\right)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\left(\left(\frac{1}{\delta}+1\right)^{2TM+2}\right)</annotation></semantics></math> iterations. In Section <a href="#S6" title="VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">VI</span></a>, we validate the performance of Algorithm <a href="#alg3" title="Algorithm 3 ‣ IV-E 𝛿-Optimal Robust Utility Reconstruction via Finite Reduction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> in producing utility estimates which substantially decrease the worst case-error, when compared with classical estimators (<a href="#S4.E22" title="Equation 22 ‣ IV-B Utility Reconstruction: Classical Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>).</p>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">V </span><span id="S5.2" class="ltx_text ltx_font_smallcaps">Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs</span></h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">The goal of this section is to detect coordination among a group of UAVs in an adversarial setting. By adversarial, we mean the UAVs are trying to attain their objective while remaining undetected by the radar. This can be mathematically formalized as a constraint on the group’s observability, which translates, when instantiated in the algorithmic filtering level of Sub-section <a href="#S5.SS2" title="V-B Deriving the Covertness Bound from Tracking Dynamics ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">V-B</span></a>, to a bound (<a href="#S5.E35" title="Equation 35 ‣ V-B2 Deriving the Linear Spectral Constraint ‣ V-B Deriving the Covertness Bound from Tracking Dynamics ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>) on the radar’s measurement precision. This is quantified directly as a lower bound on the measurement covariance in any filtering scheme, and thus induces substantial statistical noise in the filtering process which challenges the radar’s utility reconstruction. This directly motivates our statistically optimal coordination detection, and robust utility reconstruction algorithms.</p>
</div>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p">Next, we show how the abstracted mathematical form (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) can be derived from the dynamics of such a <span id="S5.p2.1.1" class="ltx_text ltx_font_italic">covertly coordinating group of UAVs</span>, thus enabling the usage of our statistical detection and robust utility reconstruction algorithms. One of the novelties of our formulation is that we identify this linearly constrained multi-objective optimization as arising from the state-space spectral dynamics of a radar – multi-UAV interaction scenario. Thus, reconstructed utility functions in this setting encode information about target intent through preferences over the spectral modulation of their state dynamics.</p>
</div>
<div id="S5.p3" class="ltx_para">
<p id="S5.p3.1" class="ltx_p">Now let us introduce the state space dynamics constituting a radar – multi-UAV tracking scenario. We consider two time scales for the interaction: the fast time scale <math id="S5.p3.m1" class="ltx_Math" alttext="k=1,2,\dots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">k=1,2,\dots</annotation></semantics></math> represents the scale at which the target state and measurement dynamics occur, and the slow time scale <math id="S5.p3.m2" class="ltx_Math" alttext="t=1,2,\dots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">t=1,2,\dots</annotation></semantics></math> represents the scale at which the radar probes (tracking signals) and UAV maneuvers <math id="S5.p3.m3" class="ltx_Math" alttext="\{\beta_{t}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\beta_{t}^{i}\}_{i=1}^{M}</annotation></semantics></math> occur.</p>
</div>
<div id="Thmdefinition4" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition4.2" class="ltx_text ltx_font_bold">Definition 4</span></span><span id="Thmdefinition4.3" class="ltx_text ltx_font_bold"> </span>(Radar–Multi-UAV Interaction)<span id="Thmdefinition4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition4.p1" class="ltx_para">
<p id="Thmdefinition4.p1.1" class="ltx_p">The radar – UAV network interaction has the following dynamics:</p>
<table id="S5.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.E27.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\textrm{radar emission}:\alpha_{t}&amp;\in\mathbb{R}^{N}_{+}\\
\textrm{UAV (agent) $i$ maneuver}:\beta_{t}^{i}&amp;\in\mathbb{R}^{N}_{+}\\
\textrm{UAV (agent) $i$ state}:x_{k}^{i}&amp;\in\mathbb{R}^{q},\ x_{k+1}^{i}\sim p_{\beta_{t}^{i}}(x|x_{k}^{i})\\
\textrm{radar observation}:y^{i}_{k}&amp;\in\mathbb{R}^{p},\ y^{i}_{k}\sim p_{\alpha_{t}}(y|x_{k}^{i})\\
\textrm{radar tracker}:\pi^{i}_{k}&amp;=\mathcal{T}(\pi^{i}_{k-1},y^{i}_{k})\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mtext>radar emission</mtext><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msubsup><mi>ℝ</mi><mo>+</mo><mi>N</mi></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mtext>UAV (agent) </mtext><mi>i</mi><mtext> maneuver</mtext></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msubsup><mi>ℝ</mi><mo>+</mo><mi>N</mi></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mtext>UAV (agent) </mtext><mi>i</mi><mtext> state</mtext></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>x</mi><mi>k</mi><mi>i</mi></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mi>q</mi></msup></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>x</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo>∼</mo><mrow><msub><mi>p</mi><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>k</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mtext>radar observation</mtext><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>y</mi><mi>k</mi><mi>i</mi></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>y</mi><mi>k</mi><mi>i</mi></msubsup><mo>∼</mo><mrow><msub><mi>p</mi><msub><mi>α</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>x</mi><mi>k</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mtext>radar tracker</mtext><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>π</mi><mi>k</mi><mi>i</mi></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo>,</mo><msubsup><mi>y</mi><mi>k</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\textrm{radar emission}:\alpha_{t}&amp;\in\mathbb{R}^{N}_{+}\\
\textrm{UAV (agent) $i$ maneuver}:\beta_{t}^{i}&amp;\in\mathbb{R}^{N}_{+}\\
\textrm{UAV (agent) $i$ state}:x_{k}^{i}&amp;\in\mathbb{R}^{q},\ x_{k+1}^{i}\sim p_{\beta_{t}^{i}}(x|x_{k}^{i})\\
\textrm{radar observation}:y^{i}_{k}&amp;\in\mathbb{R}^{p},\ y^{i}_{k}\sim p_{\alpha_{t}}(y|x_{k}^{i})\\
\textrm{radar tracker}:\pi^{i}_{k}&amp;=\mathcal{T}(\pi^{i}_{k-1},y^{i}_{k})\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="Thmdefinition4.p1.2" class="ltx_p">where <math id="Thmdefinition4.p1.m1" class="ltx_Math" alttext="\pi_{k}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>k</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\pi_{k}^{i}</annotation></semantics></math> is radar <math id="Thmdefinition4.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s target state posterior and <math id="Thmdefinition4.p1.m3" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> is a general Bayesian tracker.</p>
</div>
</div>
<div id="S5.p4" class="ltx_para">
<p id="S5.p4.1" class="ltx_p">For a fixed <math id="S5.p4.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> in the slow time-scale, <math id="S5.p4.m2" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> abstractly represents the radar’s signal output which parameterizes its measurement kernel, and <math id="S5.p4.m3" class="ltx_Math" alttext="\beta_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\beta_{t}^{i}</annotation></semantics></math> represents UAV <math id="S5.p4.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s maneuver (radial acceleration, etc.) which parametrizes the state update kernel. These interaction dynamics are illustrated in Figure <a href="#S1.F1" title="Figure 1 ‣ I Introduction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.
Taking the point of view of the radar, we aim to detect if the targets are <span id="S5.p4.1.1" class="ltx_text ltx_font_italic">covertly coordinating</span>. That is, here we identify the analyst, who observes the dataset (<a href="#S4.E19" title="Equation 19 ‣ IV-A Identifying Near-Pareto-Efficient Behavior ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>), with the radar itself which emits the probe signal.</p>
</div>
<div id="S5.p5" class="ltx_para">
<p id="S5.p5.1" class="ltx_p">We next present precisely what is meant by covert coordination, and motivate how the mathematical definition can be derived from practical multi-target filtering algorithms.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS1.6" class="ltx_text">V-A</span> </span><span id="S5.SS1.7" class="ltx_text ltx_font_italic">Multi-UAV Covert Coordination Definition</span></h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">In formulating our problem, it is necessary to define rigorously what we mean by UAV coordination. Examples of such coordination definitions have been proposed and studied in works <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">41</a>]</cite>. We consider the following coordination specification. Each UAV has an individual utility function <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="f^{i}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>i</mi></msup><annotation encoding="application/x-tex">f^{i}</annotation></semantics></math>, which maps from its state dynamics <math id="S5.SS1.p1.m2" class="ltx_Math" alttext="\beta_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\beta_{t}^{i}</annotation></semantics></math>, parametrizing the state transition kernel in (<a href="#S5.E27" title="Equation 27 ‣ Definition 4 (Radar–Multi-UAV Interaction). ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>), to a real-valued utility, i.e.,</p>
<table id="S5.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex13.m1" class="ltx_Math" alttext="f^{i}:\mathbb{R}^{N}\to\mathbb{R}" display="block" intent=":literal"><semantics><mrow><msup><mi>f</mi><mi>i</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>N</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f^{i}:\mathbb{R}^{N}\to\mathbb{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p1.2" class="ltx_p">Such utility functions can capture the UAVs’ flight objectives by quantifying a reward profile for flight dynamics. The UAVs then should act to maximize their individual utility functions at each point in time in order to achieve their flight objective. However, such individual maximization would decouple the UAV dynamics such that they act independently of each other’s trajectories. A notion of coordination would need to capture a certain coupling or codependency between these trajectories.</p>
</div>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.1" class="ltx_p">We propose to quantify this coupling through a constraint on the radar’s average measurement precision. This captures the idea that the UAVs aim to obtain some flight objective while jointly acting such that the entire network remains hidden to a certain degree from the radar. This induces a coupling between UAV trajectories; the UAVs must adjust their individual sequential state dynamics such that the entire network satisfies a certain undetectability constraint.</p>
</div>
<div id="S5.SS1.p3" class="ltx_para">
<p id="S5.SS1.p3.1" class="ltx_p">This coordination formulation can be summarized informally as:</p>
<table id="S5.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.E28.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\textrm{maximize }(f^{1},\dots,f^{M})\textrm{, such that}\\
&amp;\textrm{average radar measurement precision}\leq\textrm{bound}\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>maximize </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>f</mi><mi>M</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>, such that</mtext></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>average radar measurement precision</mtext><mo>≤</mo><mtext>bound</mtext></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\textrm{maximize }(f^{1},\dots,f^{M})\textrm{, such that}\\
&amp;\textrm{average radar measurement precision}\leq\textrm{bound}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
<div id="S5.SS1.p4" class="ltx_para">
<p id="S5.SS1.p4.1" class="ltx_p">The ’maximize <math id="S5.SS1.p4.m1" class="ltx_Math" alttext="(f^{1},\dots,f^{M})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>f</mi><mi>M</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f^{1},\dots,f^{M})</annotation></semantics></math>’ can be interpreted in the framework of Pareto optimality, as introduced in the previous section. The radar measurement precision bound can be derived from standard multi-target tracking algorithms, as we show in Section <a href="#S5.SS2" title="V-B Deriving the Covertness Bound from Tracking Dynamics ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">V-B</span></a>. Furthermore, this constraint is well-motivated in practical circumstances <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib42" title="" class="ltx_ref">42</a>]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib43" title="" class="ltx_ref">43</a>]</cite>,<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib44" title="" class="ltx_ref">44</a>]</cite>.</p>
</div>
<div id="S5.SS1.p5" class="ltx_para">
<p id="S5.SS1.p5.1" class="ltx_p">This leads us to our formal definition of coordination in a UAV network, given as follows:</p>
</div>
<div id="Thmdefinition5" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition5.2" class="ltx_text ltx_font_bold">Definition 5</span></span><span id="Thmdefinition5.3" class="ltx_text ltx_font_bold"> </span>(Covert Multi-UAV Coordination)<span id="Thmdefinition5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition5.p1" class="ltx_para">
<p id="Thmdefinition5.p1.1" class="ltx_p">Considering the interaction dynamics (<a href="#S5.E27" title="Equation 27 ‣ Definition 4 (Radar–Multi-UAV Interaction). ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>), we define a coordinating UAV network to be a network of <math id="Thmdefinition5.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> UAVs, each with individual concave, continuous and monotone increasing<span id="footnote14" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">14</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">14</sup>
                <span class="ltx_tag ltx_tag_note">14</span>
                
                
                
                
                
                
                
              This objective function structure is known as ’locally non-satiated’ in the micro-economics literature, and is not necessarily restrictive when considering target objectives, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite>.</span></span></span> objective functions <math id="Thmdefinition5.p1.m2" class="ltx_Math" alttext="f^{i}:\mathbb{R}^{N}\to\mathbb{R},i\in[M]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mi>i</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>N</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{i}:\mathbb{R}^{N}\to\mathbb{R},i\in[M]</annotation></semantics></math>, which produces output signals <math id="Thmdefinition5.p1.m3" class="ltx_Math" alttext="\{\beta_{t}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\beta_{t}^{i}\}_{i=1}^{M}</annotation></semantics></math> on the slow time-scale in accordance with</p>
<table id="S5.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.E29.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\{\beta_{t}^{i}\}_{i=1}^{M}\in&amp;\arg\max_{\{\beta^{i}\}_{i=1}^{M}}\{f^{1}(\beta^{1}),\dots,f^{M}(\beta^{M})\}\\
&amp;s.t.\quad\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo>∈</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>β</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>f</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>β</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>f</mi><mi>M</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>β</mi><mi>M</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi></mrow><mo lspace="0em">.</mo><mspace style="width:2.167em;" width="2.167em"></mspace><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msup><mi>β</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\{\beta_{t}^{i}\}_{i=1}^{M}\in&amp;\arg\max_{\{\beta^{i}\}_{i=1}^{M}}\{f^{1}(\beta^{1}),\dots,f^{M}(\beta^{M})\}\\
&amp;s.t.\quad\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS1.p6" class="ltx_para">
<p id="S5.SS1.p6.1" class="ltx_p">Note that (<a href="#S5.E29" title="Equation 29 ‣ Definition 5 (Covert Multi-UAV Coordination). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) exactly corresponds to (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>). Thus, a covertly coordinating UAV network controls its joint state dynamics (through e.g., controlling a certain formation) such that they are <span id="S5.SS1.p6.1.1" class="ltx_text ltx_font_italic">Pareto-efficient</span> (Def. (<a href="#Thmdefinition1" title="Definition 1 (Pareto-Efficiency). ‣ II-A Multi-Objective Optimization ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>)) with respect to each objective function, the tracking signal from the radar, and a constraint on the UAV network’s detectability.</p>
</div>
<div id="S5.SS1.p7" class="ltx_para">
<p id="S5.SS1.p7.1" class="ltx_p">The following proposition summarizes this mapping</p>
</div>
<div id="Thmproposition1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition1.2" class="ltx_text ltx_font_bold">Proposition 1</span></span><span id="Thmproposition1.3" class="ltx_text ltx_font_bold"> </span>(Radar Tracking <math id="Thmproposition1.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> Linear Constraint)<span id="Thmproposition1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition1.p1" class="ltx_para">
<p id="Thmproposition1.p1.1" class="ltx_p"><span id="Thmproposition1.p1.1.1" class="ltx_text ltx_font_italic">Under standard linear Gaussian tracking models with Kalman or JPDAF filtering,
the radar’s asymptotic measurement precision <math id="Thmproposition1.p1.m1" class="ltx_Math" alttext="\Sigma_{t}^{*-1}(\alpha_{t},\beta^{i}_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>t</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{t}^{*-1}(\alpha_{t},\beta^{i}_{t})</annotation></semantics></math>
is monotone increasing in the probe parameter <math id="Thmproposition1.p1.m2" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> and the UAV maneuver
parameter <math id="Thmproposition1.p1.m3" class="ltx_Math" alttext="\beta^{i}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\beta^{i}_{t}</annotation></semantics></math>. Consequently, enforcing a bound on the radar’s average
measurement precision across all <math id="Thmproposition1.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> UAVs is equivalent to the linear constraint</span></p>
<table id="S5.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E30.m1" class="ltx_Math" alttext="\alpha_{t}^{\top}\Bigg(\sum_{i=1}^{M}\beta^{i}_{t}\Bigg)\leq 1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha_{t}^{\top}\Bigg(\sum_{i=1}^{M}\beta^{i}_{t}\Bigg)\leq 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS1.p8" class="ltx_para ltx_noindent">
<p id="S5.SS1.p8.1" class="ltx_p">Proposition <a href="#Thmproposition1" title="Proposition 1 (Radar Tracking → Linear Constraint). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> provides the analytical bridge between
low-level radar filtering dynamics and the high-level linearly constrained
multi-objective optimization (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>). This equivalence justifies treating
covert multi-UAV coordination as a Pareto-efficient resource allocation problem
subject to the shared constraint (<a href="#S5.E30" title="Equation 30 ‣ Proposition 1 (Radar Tracking → Linear Constraint). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>).</p>
</div>
<div id="S5.SS1.p9" class="ltx_para">
<p id="S5.SS1.p9.1" class="ltx_p">We next specify precisely how Proposition <a href="#Thmproposition1" title="Proposition 1 (Radar Tracking → Linear Constraint). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> is justified from practical filtering dynamics.</p>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS2.6" class="ltx_text">V-B</span> </span><span id="S5.SS2.7" class="ltx_text ltx_font_italic">Deriving the Covertness Bound from Tracking Dynamics</span></h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.1" class="ltx_p">The goal of this section is to show how the high-level coordination framework (<a href="#S2.E8" title="Equation 8 ‣ Definition 3 (Coordinated System). ‣ II-B Coordinated Multi-Agent Systems ‣ II Background. Constrained Multi-Objective Optimization in Coordinated Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) can be recovered from standard multi-target filtering procedures. Specifically, we recover the "covertness" bound <math id="S5.SS2.p1.m1" class="ltx_Math" alttext="\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><msup><mi>β</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta^{i})\leq 1</annotation></semantics></math>. <span id="S5.SS2.p1.1.1" class="ltx_text ltx_font_italic">These serve as illustrative examples of how to map complex multi-target tracking algorithms to the constrained multi-objective optimization (<a href="#S5.E29" title="Equation 29 ‣ Definition 5 (Covert Multi-UAV Coordination). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>)</span>. One should be able to extend these mappings to other target tracking schemes.</p>
</div>
<section id="S5.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S5.SS2.SSS1.6" class="ltx_text">V-B</span>1 </span>Multi-Target Filtering</h4>

<div id="S5.SS2.SSS1.p1" class="ltx_para">
<p id="S5.SS2.SSS1.p1.1" class="ltx_p">Here we specify a concrete example of the abstract dynamics (<a href="#S5.E27" title="Equation 27 ‣ Definition 4 (Radar–Multi-UAV Interaction). ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>). Linear Gaussian dynamics for a target’s kinematics <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib45" title="" class="ltx_ref">45</a>]</cite> and linear Gaussian measurements at each radar are widely assumed as a useful approximation <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib46" title="" class="ltx_ref">46</a>]</cite>. Thus, we will consider the following linear Gaussian state dynamics and measurements over the <span id="S5.SS2.SSS1.p1.1.1" class="ltx_text ltx_font_italic">fast time scale <math id="S5.SS2.SSS1.p1.m1" class="ltx_Math" alttext="k\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{N}</annotation></semantics></math></span>, with a particular <math id="S5.SS2.SSS1.p1.m2" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math> fixed:</p>
</div>
<div id="S5.SS2.SSS1.p2" class="ltx_para">
<table id="S5.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.E31.m1" class="ltx_Math" alttext="\displaystyle\begin{split}x_{k+1}^{i}&amp;=A^{i}x_{k}^{i}+w_{k}^{i},\ x_{0}^{i}\sim\pi^{i}_{0},\\
y^{i}_{k}&amp;=C^{i}x_{k}^{i}+v^{i}_{k},\ i\in[M]\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msubsup><mi>x</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>A</mi><msup><mrow></mrow><mi>i</mi></msup><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mi>i</mi></msup><mo>+</mo><mi>w</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mi>i</mi></msup><mo rspace="1.167em">,</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mi>i</mi></msup><mo>∼</mo><mi>π</mi><msup><mrow></mrow><mi>i</mi></msup><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msubsup><mi>y</mi><mi>k</mi><mi>i</mi></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>C</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>k</mi><mi>i</mi></msubsup></mrow><mo>+</mo><msubsup><mi>v</mi><mi>k</mi><mi>i</mi></msubsup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}x_{k+1}^{i}&amp;=A^{i}x_{k}^{i}+w_{k}^{i},\ x_{0}^{i}\sim\pi^{i}_{0},\\
y^{i}_{k}&amp;=C^{i}x_{k}^{i}+v^{i}_{k},\ i\in[M]\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS1.p2.1" class="ltx_p">where <math id="S5.SS2.SSS1.p2.m1" class="ltx_Math" alttext="x_{k}^{i},w_{k}^{i}\in\mathbb{R}^{q}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mi>k</mi><mi>i</mi></msubsup><mo>,</mo><mrow><msubsup><mi>w</mi><mi>k</mi><mi>i</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>q</mi></msup></mrow></mrow><annotation encoding="application/x-tex">x_{k}^{i},w_{k}^{i}\in\mathbb{R}^{q}</annotation></semantics></math> are the target <math id="S5.SS2.SSS1.p2.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> state and noise vectors, respectively, and <math id="S5.SS2.SSS1.p2.m3" class="ltx_Math" alttext="A^{i}\in\mathbb{R}^{q\times q}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mi>i</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>q</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A^{i}\in\mathbb{R}^{q\times q}</annotation></semantics></math> is the state update matrix for target <math id="S5.SS2.SSS1.p2.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. <math id="S5.SS2.SSS1.p2.m5" class="ltx_Math" alttext="y^{i}_{k}\in\mathbb{R}^{p}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>y</mi><mi>k</mi><mi>i</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">y^{i}_{k}\in\mathbb{R}^{p}</annotation></semantics></math> is the radar’s measurement of target <math id="S5.SS2.SSS1.p2.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, <math id="S5.SS2.SSS1.p2.m7" class="ltx_Math" alttext="C^{i}\in\mathbb{R}^{p\times q}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi>i</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>q</mi></mrow></msup></mrow><annotation encoding="application/x-tex">C^{i}\in\mathbb{R}^{p\times q}</annotation></semantics></math> is the measurement transformation, and <math id="S5.SS2.SSS1.p2.m8" class="ltx_Math" alttext="v^{i}_{k}\in\mathbb{R}^{p}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>v</mi><mi>k</mi><mi>i</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>p</mi></msup></mrow><annotation encoding="application/x-tex">v^{i}_{k}\in\mathbb{R}^{p}</annotation></semantics></math> is the measurement noise. The constraints and subsequent radar responses will be indexed over the <span id="S5.SS2.SSS1.p2.1.1" class="ltx_text ltx_font_italic">slow time scale</span> <math id="S5.SS2.SSS1.p2.m9" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>. These parameterize the state and noise covariance matrices:</p>
<table id="S5.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E32.m1" class="ltx_Math" alttext="w_{k}\sim\mathcal{N}(0,Q_{t}(\beta_{t}^{i})),\ v^{i}_{k}\sim\mathcal{N}(0,R_{t}(\alpha_{t}))" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>k</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msub><mi>Q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msubsup><mi>v</mi><mi>k</mi><mi>i</mi></msubsup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msub><mi>R</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{k}\sim\mathcal{N}(0,Q_{t}(\beta_{t}^{i})),\ v^{i}_{k}\sim\mathcal{N}(0,R_{t}(\alpha_{t}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
</div>
<div id="S5.SS2.SSS1.p3" class="ltx_para">
<p id="S5.SS2.SSS1.p3.1" class="ltx_p">In this spectral interpretation, <math id="S5.SS2.SSS1.p3.m1" class="ltx_Math" alttext="\beta_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\beta_{t}^{i}</annotation></semantics></math> represents the vector of eigenvalues of state-noise covariance matrix <math id="S5.SS2.SSS1.p3.m2" class="ltx_Math" alttext="Q_{t}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">Q_{t}</annotation></semantics></math> and <math id="S5.SS2.SSS1.p3.m3" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> represents the vector of eigenvalues of the inverse measurement noise covariance matrix <math id="S5.SS2.SSS1.p3.m4" class="ltx_Math" alttext="R_{t}^{-1}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">R_{t}^{-1}</annotation></semantics></math>. Thus, given this interpretation we can view modulations of <math id="S5.SS2.SSS1.p3.m5" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> as corresponding to increased/decreased measurement precision on the part of the radar, and modulations of <math id="S5.SS2.SSS1.p3.m6" class="ltx_Math" alttext="\beta_{t}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\beta_{t}^{i}</annotation></semantics></math> as adjusting the target dynamics. See Appendix <a href="#S8.SS4" title="VIII-D Example Radar Waveform Specifications ‣ VIII Appendix ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">VIII-D</span></a> for precise details on such waveform modulation.</p>
</div>
<div id="S5.SS2.SSS1.p4" class="ltx_para">
<p id="S5.SS2.SSS1.p4.1" class="ltx_p">A simple interpretation of the multi-target tracking procedure is a standard de-coupled Kalman filter, whereby after measurements are associated to each target, a standard Kalman filter is applied to track each target state separately. This procedure is idealized, but allows for a nice exposition of the connection between filtering precision and the constraint in (<a href="#S5.E29" title="Equation 29 ‣ Definition 5 (Covert Multi-UAV Coordination). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>).</p>
</div>
</section>
<section id="S5.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S5.SS2.SSS2.6" class="ltx_text">V-B</span>2 </span>Deriving the Linear Spectral Constraint</h4>

<div id="S5.SS2.SSS2.p1" class="ltx_para">
<p id="S5.SS2.SSS2.p1.1" class="ltx_p">Under standard assumptions on the linear Kalman filtering model (see Appendix <a href="#S8.SS1" title="VIII-A Kalman Filter Dynamics ‣ VIII Appendix ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">VIII-A</span></a> for all details) for tracking a single UAV, the asymptotic (in <math id="S5.SS2.SSS2.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, for fixed <math id="S5.SS2.SSS2.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>) predicted covariance is the unique non-negative definite solution of the algebraic Riccati equation:</p>
<table id="S5.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S5.E33.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\mathcal{A}(\alpha_{t},\beta_{t}^{i},\Sigma):=\\
&amp;-\Sigma+A^{i}(\Sigma-\Sigma(C^{i})^{\top}[C^{i}\Sigma(C^{i})^{\top}+R_{t}(\alpha_{t})]^{-1}C^{i}\Sigma)(A^{i})^{\top}\\
&amp;+Q_{t}(\beta_{t}^{i})=0\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>,</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mphantom></mphantom></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mi mathvariant="normal">Σ</mi></mrow><mo>+</mo><mrow><msup><mi>A</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Σ</mi><mo>−</mo><mrow><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>C</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><msub><mi>R</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>+</mo><mrow><msub><mi>Q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\mathcal{A}(\alpha_{t},\beta_{t}^{i},\Sigma):=\\
&amp;-\Sigma+A^{i}(\Sigma-\Sigma(C^{i})^{\top}[C^{i}\Sigma(C^{i})^{\top}+R_{t}(\alpha_{t})]^{-1}C^{i}\Sigma)(A^{i})^{\top}\\
&amp;+Q_{t}(\beta_{t}^{i})=0\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
</div>
<div id="S5.SS2.SSS2.p2" class="ltx_para">
<p id="S5.SS2.SSS2.p2.1" class="ltx_p">Let <math id="S5.SS2.SSS2.p2.m1" class="ltx_Math" alttext="\Sigma_{t}^{*-1}(\alpha_{t},\beta_{t}^{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>t</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{t}^{*-1}(\alpha_{t},\beta_{t}^{i})</annotation></semantics></math> be the inverse of this solution, representing the time <math id="S5.SS2.SSS2.p2.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> measurement <span id="S5.SS2.SSS2.p2.1.1" class="ltx_text ltx_font_italic">precision</span> obtained by the radar. Then we have the following guarantee</p>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite>)<span id="Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para">
<p id="Thmtheorem4.p1.1" class="ltx_p"><span id="Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">We can represent a limit <math id="Thmtheorem4.p1.m1" class="ltx_Math" alttext="\bar{\Sigma}^{-1}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>¯</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\bar{\Sigma}^{-1}</annotation></semantics></math> on the radar’s precision of target <math id="Thmtheorem4.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> measurement, <math id="Thmtheorem4.p1.m3" class="ltx_Math" alttext="\Sigma_{t}^{*-1}(\alpha_{t},\beta_{t}^{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>t</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{t}^{*-1}(\alpha_{t},\beta_{t}^{i})</annotation></semantics></math> at time <math id="Thmtheorem4.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> as the simple linear inequality <math id="Thmtheorem4.p1.m5" class="ltx_Math" alttext="\alpha_{t}^{\top}\beta_{t}^{i}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha_{t}^{\top}\beta_{t}^{i}\leq 1</annotation></semantics></math>. Specifically:</span></p>
<table id="S5.E34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E34.m1" class="ltx_Math" alttext="\alpha_{t}^{\top}\beta_{t}^{i}\leq 1\Longleftrightarrow\Sigma_{t}^{*-1}(\alpha_{t},\beta_{t}^{i})\leq\bar{\Sigma}^{-1}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow><mo>≤</mo><mn>1</mn><mo stretchy="false">⟺</mo><mrow><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>t</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>¯</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}^{\top}\beta_{t}^{i}\leq 1\Longleftrightarrow\Sigma_{t}^{*-1}(\alpha_{t},\beta_{t}^{i})\leq\bar{\Sigma}^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.2" class="ltx_p"><span id="Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">where the constant <math id="Thmtheorem4.p1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> bound is taken without loss of generality.</span></p>
</div>
</div>
<div id="S5.SS2.SSS2.p3" class="ltx_para">
<p id="S5.SS2.SSS2.p3.1" class="ltx_p">The key idea behind this equivalence is to show the asymptotic precision <math id="S5.SS2.SSS2.p3.m1" class="ltx_Math" alttext="\Sigma^{*-1}_{n}(\cdot,\beta_{t}^{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>n</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Sigma^{*-1}_{n}(\cdot,\beta_{t}^{i})</annotation></semantics></math> is monotone increasing in the first argument <math id="S5.SS2.SSS2.p3.m2" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> using the information Kalman filter formulation. Then, we can represent a constraint on the radar’s average precision over measurements of all targets as</p>
<table id="S5.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E35.m1" class="ltx_Math" alttext="\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta_{t}^{i})\leq 1" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha_{t}^{\top}(\sum_{i=1}^{M}\beta_{t}^{i})\leq 1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS2.p3.2" class="ltx_p">Thus, we recover a direct correspondence between the radar’s average measurement precision and the linear inequality constraint in (<a href="#S5.E29" title="Equation 29 ‣ Definition 5 (Covert Multi-UAV Coordination). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>). Thus, we derive the constrained multi-objective optimization (<a href="#S5.E29" title="Equation 29 ‣ Definition 5 (Covert Multi-UAV Coordination). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) as corresponding to covert coordination, from filtering-level dynamics.</p>
</div>
<div id="S5.SS2.SSS2.p4" class="ltx_para">
<p id="S5.SS2.SSS2.p4.1" class="ltx_p"><span id="S5.SS2.SSS2.p4.1.1" class="ltx_text ltx_font_italic">Remark. Joint Probabilistic Data Association Filter</span>:
The recovery of this linear constraint (<a href="#S5.E34" title="Equation 34 ‣ Theorem 4 ([]). ‣ V-B2 Deriving the Linear Spectral Constraint ‣ V-B Deriving the Covertness Bound from Tracking Dynamics ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>) from the de-coupled Kalman filter gives a clear correspondence between the filtering dynamics and the high-level objective constraint (<a href="#S5.E28" title="Equation 28 ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>). However, this de-coupled Kalman filtering scheme is idealized and simplified. In Appendix <a href="#S8.SS5" title="VIII-E Multi-Target Filtering: Joint Probabilistic Data Association Filter ‣ VIII Appendix ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">VIII-E</span></a> we outline a more sophisticated multi-target tracking algorithm, the joint probabilistic data association filter (JPDAF), which is widely used in practice <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">47</a>]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib48" title="" class="ltx_ref">48</a>]</cite>. We show the same recovery of the linear constraint (<a href="#S5.E35" title="Equation 35 ‣ V-B2 Deriving the Linear Spectral Constraint ‣ V-B Deriving the Covertness Bound from Tracking Dynamics ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>), thus illustrating the consistency of our abstract linearly constrained optimization (<a href="#S5.E29" title="Equation 29 ‣ Definition 5 (Covert Multi-UAV Coordination). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) with more sophisticated tracking techniques.</p>
</div>
</section>
</section>
<section id="S5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS3.6" class="ltx_text">V-C</span> </span><span id="S5.SS3.7" class="ltx_text ltx_font_italic">Implications for Coordination Detection and Utility Reconstruction in Multi-UAV Systems</span></h3>

<div id="S5.SS3.p1" class="ltx_para">
<p id="S5.SS3.p1.1" class="ltx_p">The derivation in Sections V-A and V-B established that the filtering-level dynamics of a multi-UAV system can be expressed in the form of a linearly constrained multi-objective optimization problem. Each UAV’s filtering and maneuvering objective contributes a component to a global objective, and the coupling constraints arise naturally from shared observability bounds. In this formulation, the realized system trajectories can be viewed as solutions to a weighted-sum optimization subject to linear constraints, precisely of the form analyzed in Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="S5.SS3.p2" class="ltx_para">
<p id="S5.SS3.p2.1" class="ltx_p">This equivalence has two key implications. First, it enables the use of our <em id="S5.SS3.p2.1.1" class="ltx_emph ltx_font_italic">coordination detection</em> framework of Section <a href="#S3" title="III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">III</span></a>: by applying the statistical detector to noisy observed UAV trajectories in response to varying radar probes, an analyst can test whether the system’s behavior is consistent with Pareto-efficient multi-objective optimization. In operational terms, this allows the analyst to determine whether the UAVs are actively coordinating their sensing and maneuvering strategies, or whether their responses could be explained by independent, uncoordinated policies.</p>
</div>
<div id="S5.SS3.p3" class="ltx_para">
<p id="S5.SS3.p3.1" class="ltx_p">Second, the equivalence permits the <em id="S5.SS3.p3.1.1" class="ltx_emph ltx_font_italic">robust utility reconstruction</em> of Section <a href="#S4" title="IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">IV</span></a>. These reconstructed utilities provide insight into the implicit trade-offs the system is making—for example, between radar observability and formation maintenance, or between sensing fidelity and exposure risk. Moreover, since the reconstructed utilities are predictive, they can be used to forecast the system’s response to future probing signals, thereby enabling anticipatory countermeasures.</p>
</div>
<div id="S5.SS3.p4" class="ltx_para">
<p id="S5.SS3.p4.1" class="ltx_p">In summary, the representation of multi-UAV dynamics as a constrained multi-objective optimization problem is not merely a modeling convenience: it provides the analytical bridge that allows us to apply our general results on coordination detection and robust utility reconstruction directly to the multi-UAV setting.</p>
</div>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">VI </span><span id="S6.2" class="ltx_text ltx_font_smallcaps">Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems</span></h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">The following example illustrates the performance of our statistical detection and robust utility reconstruction procedures, given a simple UAV multi-objective optimization model.</p>
</div>
<div id="S6.p2" class="ltx_para">
<p id="S6.p2.1" class="ltx_p">All of our numerical simulations are fully reproducible, with open-source code found in the following repository: <span id="S6.p2.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">https://github.com/LukeSnow0/Collective-IRL</span>. This code is amenable to analysis with an arbitrary number of agents, and in high dimensions. However, for the sake of exposition and visualization we limit here to three agents with two-dimensional utility functions.</p>
</div>
<section id="S6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S6.SS1.6" class="ltx_text">VI-A</span> </span><span id="S6.SS1.7" class="ltx_text ltx_font_italic">Data Generation Model</span></h3>

<div id="S6.SS1.p1" class="ltx_para">
<p id="S6.SS1.p1.1" class="ltx_p">For our numerical examples we consider the case with <math id="S6.SS1.p1.m1" class="ltx_Math" alttext="M=3" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">M=3</annotation></semantics></math> targets, with evolving dynamics modulated by <math id="S6.SS1.p1.m2" class="ltx_Math" alttext="\beta_{t}^{i}\in\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\beta_{t}^{i}\in\mathbb{R}^{2}</annotation></semantics></math>, and with objective functions given by</p>
<table id="S6.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S6.E36.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;f^{1}(\beta)=\textrm{det}(Q(\beta))=\beta(1)\times\beta(2),\\
&amp;f^{2}(\beta)=\textrm{Tr}(Q(\beta))=\beta(1)+\beta(2),\\
&amp;f^{3}(\beta)=\sqrt{\beta(1)}\beta(2)\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msup><mi>f</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>det</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msup><mi>f</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>Tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mi>f</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msqrt><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;f^{1}(\beta)=\textrm{det}(Q(\beta))=\beta(1)\times\beta(2),\\
&amp;f^{2}(\beta)=\textrm{Tr}(Q(\beta))=\beta(1)+\beta(2),\\
&amp;f^{3}(\beta)=\sqrt{\beta(1)}\beta(2)\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
<p id="S6.SS1.p1.2" class="ltx_p">We generate the deterministic dataset</p>
<table id="S6.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E37.m1" class="ltx_Math" alttext="\mathcal{D}=\{\alpha_{t},\{\beta^{i}_{t}\}_{i=1}^{M},t\in[T]\}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mo>,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}=\{\alpha_{t},\{\beta^{i}_{t}\}_{i=1}^{M},t\in[T]\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="S6.SS1.p1.3" class="ltx_p">as</p>
<table id="S6.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S6.E38.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\alpha_{t}\sim\mathcal{U}(0.1,1.1)^{2}\in\mathbb{R}^{2},\,\beta_{t}^{i}\in\mathbb{R}^{2},\,t\in\{1,\dots,T\},\\
&amp;\{\beta_{t}^{i}\}_{i=1}^{3}\in\arg\max_{\{\beta^{i}\}_{i=1}^{3}}\sum_{i=1}^{3}f^{i}(\beta^{i})\,\,s.t.\,\,\alpha_{t}^{\top}(\sum_{i=1}^{3}\beta^{i})\leq 1\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>α</mi><msub><mrow></mrow><mi>t</mi></msub><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo stretchy="false">(</mo><mn>0.1</mn><mo>,</mo><mn>1.1</mn><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mn>2</mn></msup><mo rspace="0.507em">,</mo><mi>β</mi><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mi>i</mi></msup><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><mn>2</mn></msup><mo rspace="0.507em">,</mo><mi>t</mi><mo>∈</mo><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi><mo stretchy="false">}</mo><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></msubsup><mo>∈</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mstyle displaystyle="true"><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><mprescripts></mprescripts><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>β</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></msubsup><mrow></mrow></mmultiscripts></mstyle><mo>⁡</mo><msup><mi>f</mi><mi>i</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>β</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.510em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi><mo lspace="0em" rspace="0.677em">.</mo><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover></mstyle><msup><mi>β</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\alpha_{t}\sim\mathcal{U}(0.1,1.1)^{2}\in\mathbb{R}^{2},\,\beta_{t}^{i}\in\mathbb{R}^{2},\,t\in\{1,\dots,T\},\\
&amp;\{\beta_{t}^{i}\}_{i=1}^{3}\in\arg\max_{\{\beta^{i}\}_{i=1}^{3}}\sum_{i=1}^{3}f^{i}(\beta^{i})\,\,s.t.\,\,\alpha_{t}^{\top}(\sum_{i=1}^{3}\beta^{i})\leq 1\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="S6.SS1.p1.4" class="ltx_p">The noisy dataset <math id="S6.SS1.p1.m3" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> (<a href="#S4.E19" title="Equation 19 ‣ IV-A Identifying Near-Pareto-Efficient Behavior ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) is then generated as:</p>
<table id="S6.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S6.E39.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\hat{\beta}_{t}^{i}=\max\{\beta_{t}^{i}+\epsilon_{t}^{i}\,,0.01(\bm{1})\},\,\ \epsilon_{t}^{i}\sim\mathcal{N}(0,\sigma^{2})\end{split}" display="inline" intent=":literal"><semantics><mtable><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>+</mo><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup></mrow><mo lspace="0.170em">,</mo><mrow><mn>0.01</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟏</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo rspace="1.337em">,</mo><mrow><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\hat{\beta}_{t}^{i}=\max\{\beta_{t}^{i}+\epsilon_{t}^{i}\,,0.01(\bm{1})\},\,\ \epsilon_{t}^{i}\sim\mathcal{N}(0,\sigma^{2})\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="S6.SS1.p1.5" class="ltx_p">where <math id="S6.SS1.p1.m4" class="ltx_Math" alttext="\bm{1}=[1,1]^{\prime}" display="inline" intent=":literal"><semantics><mrow><mn>𝟏</mn><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\bm{1}=[1,1]^{\prime}</annotation></semantics></math> and <math id="S6.SS1.p1.m5" class="ltx_Math" alttext="\max" display="inline" intent=":literal"><semantics><mi>max</mi><annotation encoding="application/x-tex">\max</annotation></semantics></math> operates elementwise.</p>
</div>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S6.SS2.6" class="ltx_text">VI-B</span> </span><span id="S6.SS2.7" class="ltx_text ltx_font_italic">Deterministic Utility Reconstruction</span></h3>

<div id="S6.SS2.p1" class="ltx_para">
<p id="S6.SS2.p1.1" class="ltx_p">Here we illustrate the efficacy of the deterministic utility reconstruction result in Corollary <a href="#Thmcorollary1" title="Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. Specifically, given the deterministic dataset <math id="S6.SS2.p1.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> (<a href="#S6.E37" title="Equation 37 ‣ VI-A Data Generation Model ‣ VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>) we verify that the linear program (<a href="#S3.E10" title="Equation 10 ‣ Item 2 ‣ Theorem 1. ‣ III-A1 Testing Pareto-Efficiency ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) has a feasible solution, and using feasible variables we reconstruct <math id="S6.SS2.p1.m2" class="ltx_Math" alttext="\{U^{i}(\cdot)\}_{i=1}^{3}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msup><mi>U</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></msubsup><annotation encoding="application/x-tex">\{U^{i}(\cdot)\}_{i=1}^{3}</annotation></semantics></math> from the dataset <math id="S6.SS2.p1.m3" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>. Figure <a href="#S6.F4" title="Figure 4 ‣ VI-B Deterministic Utility Reconstruction ‣ VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> displays the true utility functions (<a href="#S6.E36" title="Equation 36 ‣ VI-A Data Generation Model ‣ VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) giving rise to the dataset <math id="S6.SS2.p1.m4" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> beside the reconstructed utility functions <math id="S6.SS2.p1.m5" class="ltx_Math" alttext="\{U^{i}(\cdot)\}_{i=1}^{3}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msup><mi>U</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></msubsup><annotation encoding="application/x-tex">\{U^{i}(\cdot)\}_{i=1}^{3}</annotation></semantics></math>. It can be seen that the structure of each utility function can be recovered accurately in each case.</p>
</div>
<figure id="S6.F4" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S6.F4.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.08956v1/TU1.png" id="S6.F4.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:96/72;" width="96" height="72" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span><math id="S6.F4.sf1.m2" class="ltx_math_unparsed" alttext="f^{1}(\beta)=\textrm{det}(Q^{(}\beta))" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mn>1</mn></msup><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mtext>det</mtext><mrow><mo stretchy="false">(</mo><msup><mi>Q</mi><mo stretchy="false">(</mo></msup><mi>β</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">f^{1}(\beta)=\textrm{det}(Q^{(}\beta))</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S6.F4.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.08956v1/U1.png" id="S6.F4.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:96/72;" width="96" height="72" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span><math id="S6.F4.sf2.m2" class="ltx_Math" alttext="U^{1}(\beta)" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U^{1}(\beta)</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S6.F4.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.08956v1/TU2.png" id="S6.F4.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:96/72;" width="96" height="72" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(c) </span><math id="S6.F4.sf3.m2" class="ltx_Math" alttext="f^{2}(\beta)=\textrm{Tr}(Q(\beta))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>Tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{2}(\beta)=\textrm{Tr}(Q(\beta))</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S6.F4.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.08956v1/U2.png" id="S6.F4.sf4.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:96/72;" width="96" height="72" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(d) </span><math id="S6.F4.sf4.m2" class="ltx_Math" alttext="U^{2}(\beta)" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U^{2}(\beta)</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F4.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.08956v1/TU3.png" id="S6.F4.sf5.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:96/72;" width="96" height="72" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(e) </span><math id="S6.F4.sf5.m2" class="ltx_Math" alttext="f^{3}(\beta)=\sqrt{\beta(1)}\beta(2)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msqrt><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{3}(\beta)=\sqrt{\beta(1)}\beta(2)</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F4.sf6" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.08956v1/U3.png" id="S6.F4.sf6.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:96/72;" width="96" height="72" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(f) </span><math id="S6.F4.sf6.m2" class="ltx_Math" alttext="U^{3}(\beta)" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U^{3}(\beta)</annotation></semantics></math></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 4: </span><math id="S6.F4.m7" class="ltx_Math" alttext="f^{i}(\beta)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{i}(\beta)</annotation></semantics></math> is the true objective function of the <math id="S6.F4.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’th target, inducing the responses
<math id="S6.F4.m9" class="ltx_Math" alttext="\{\hat{\beta}_{t}^{i}\}_{t=1}^{10}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>β</mi><mo>^</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></msubsup><annotation encoding="application/x-tex">\{\hat{\beta}_{t}^{i}\}_{t=1}^{10}</annotation></semantics></math>. <math id="S6.F4.m10" class="ltx_Math" alttext="U^{i}(\beta)" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U^{i}(\beta)</annotation></semantics></math> is the reconstructed objective function for radar <math id="S6.F4.m11" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>,
computed using the deterministic dataset <math id="S6.F4.m12" class="ltx_Math" alttext="\bm{\beta}" display="inline" intent=":literal"><semantics><mi>𝜷</mi><annotation encoding="application/x-tex">\bm{\beta}</annotation></semantics></math> and (<a href="#S3.E11" title="Equation 11 ‣ Corollary 1. ‣ III-A2 Reconstructing Rationalizing Utility Functions ‣ III-A Main Result 1A. Linear Programming Formulation for Detection of Deterministic Pareto-Efficient Coordination. ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>).</figcaption>
</figure>
</section>
<section id="S6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S6.SS3.6" class="ltx_text">VI-C</span> </span><span id="S6.SS3.7" class="ltx_text ltx_font_italic">Statistical Detector Implementation</span></h3>

<figure id="S6.F5" class="ltx_figure"><img src="2509.08956v1/StatDet_2.png" id="S6.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/301;" width="476" height="301" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 5: </span>Statistic <math id="S6.F5.m4" class="ltx_Math" alttext="1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))</annotation></semantics></math> as a function of variance of the noise distribution <math id="S6.F5.m5" class="ltx_Math" alttext="\Lambda_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Lambda_{t}</annotation></semantics></math>. Error bars represent one standard deviation within the dataset produced by 300 Monte-Carlo simulations. Higher <math id="S6.F5.m6" class="ltx_Math" alttext="1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))</annotation></semantics></math> corresponds to higher likelihood of radar network coordination in the statistical detector (<a href="#S3.E17" title="Equation 17 ‣ III-B Type-I Error Minimizing Statistical Detector ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>).</figcaption>
</figure>
<div id="S6.SS3.p1" class="ltx_para">
<p id="S6.SS3.p1.1" class="ltx_p">Here we investigate the empirical behavior of the statistic <math id="S6.SS3.p1.m1" class="ltx_Math" alttext="1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))</annotation></semantics></math> under both <math id="S6.SS3.p1.m2" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> and <math id="S6.SS3.p1.m3" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>. We generate the statistic from the procedure outlined in Algorithm <a href="#alg2" title="Algorithm 2 ‣ III-B Type-I Error Minimizing Statistical Detector ‣ III Result 1. Statistical Detection of Pareto-Efficient Coordination ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, with <math id="S6.SS3.p1.m4" class="ltx_Math" alttext="L=500" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mn>500</mn></mrow><annotation encoding="application/x-tex">L=500</annotation></semantics></math>, <math id="S6.SS3.p1.m5" class="ltx_Math" alttext="M=3" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">M=3</annotation></semantics></math>, <math id="S6.SS3.p1.m6" class="ltx_Math" alttext="T=10" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">T=10</annotation></semantics></math>. The probe signal <math id="S6.SS3.p1.m7" class="ltx_Math" alttext="\alpha_{t}\in\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\alpha_{t}\in\mathbb{R}^{2}</annotation></semantics></math> is generated randomly as <math id="S6.SS3.p1.m8" class="ltx_Math" alttext="\alpha_{t}\sim U[0.1,1.1]^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>∼</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0.1</mn><mo>,</mo><mn>1.1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}\sim U[0.1,1.1]^{2}</annotation></semantics></math>, i.e., each element of <math id="S6.SS3.p1.m9" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> is generated as an independent uniform random variable on the interval [0.1,1.1]. To simulate a UAV network, the responses <math id="S6.SS3.p1.m10" class="ltx_Math" alttext="\{\beta_{t}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\beta_{t}^{i}\}_{i=1}^{M}</annotation></semantics></math> are taken as solutions to the multi-objective optimization (<a href="#S5.E29" title="Equation 29 ‣ Definition 5 (Covert Multi-UAV Coordination). ‣ V-A Multi-UAV Covert Coordination Definition ‣ V Extended Example. Detecting and Identifying Pareto-efficient Coordination amongst UAVs ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) with objective functions given by (<a href="#S6.E36" title="Equation 36 ‣ VI-A Data Generation Model ‣ VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>), and <math id="S6.SS3.p1.m11" class="ltx_Math" alttext="\mu^{1}=\mu^{2}=\mu^{3}=1/3" display="inline" intent=":literal"><semantics><mrow><msup><mi>μ</mi><mn>1</mn></msup><mo>=</mo><msup><mi>μ</mi><mn>2</mn></msup><mo>=</mo><msup><mi>μ</mi><mn>3</mn></msup><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\mu^{1}=\mu^{2}=\mu^{3}=1/3</annotation></semantics></math>. Then noisy responses <math id="S6.SS3.p1.m12" class="ltx_Math" alttext="\{\bar{\beta}_{t}^{i}\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>β</mi><mo>¯</mo></mover><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\bar{\beta}_{t}^{i}\}_{i=1}^{M}</annotation></semantics></math> are obtained by adding i.i.d. Gaussian noise <math id="S6.SS3.p1.m13" class="ltx_Math" alttext="\epsilon^{i}_{t}\sim\Lambda_{t}=\mathcal{N}(0,\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup><mo>∼</mo><msub><mi mathvariant="normal">Λ</mi><mi>t</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon^{i}_{t}\sim\Lambda_{t}=\mathcal{N}(0,\sigma^{2})</annotation></semantics></math>. The blue line in Figure <a href="#S6.F5" title="Figure 5 ‣ VI-C Statistical Detector Implementation ‣ VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> displays the resultant empirical statistic <math id="S6.SS3.p1.m14" class="ltx_Math" alttext="1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))</annotation></semantics></math> as a function of noise variance.
To simulate a non-coordinating radar network, we generate each response <math id="S6.SS3.p1.m15" class="ltx_Math" alttext="\beta_{t}^{i}\sim U[0,1]^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mi>t</mi><mi>i</mi></msubsup><mo>∼</mo><mrow><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}^{i}\sim U[0,1]^{2}</annotation></semantics></math> independently, and similarly add Gaussian measurement noise <math id="S6.SS3.p1.m16" class="ltx_Math" alttext="\epsilon^{i}_{t}\sim\Lambda_{t}=\mathcal{N}(0,\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mi>t</mi><mi>i</mi></msubsup><mo>∼</mo><msub><mi mathvariant="normal">Λ</mi><mi>t</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon^{i}_{t}\sim\Lambda_{t}=\mathcal{N}(0,\sigma^{2})</annotation></semantics></math>. The red line in Figure <a href="#S6.F5" title="Figure 5 ‣ VI-C Statistical Detector Implementation ‣ VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> is the empirical statistic <math id="S6.SS3.p1.m17" class="ltx_Math" alttext="1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))</annotation></semantics></math> under these circumstances, when no coordination is present.</p>
</div>
<div id="S6.SS3.p2" class="ltx_para">
<p id="S6.SS3.p2.1" class="ltx_p">Let us interpret the simulation results displayed in Figure <a href="#S6.F5" title="Figure 5 ‣ VI-C Statistical Detector Implementation ‣ VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.
Observe that the statistic <math id="S6.SS3.p2.m1" class="ltx_Math" alttext="1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))</annotation></semantics></math> is a constant value of 1 for the noise variance range simulated. This validates our choice that the null hypothesis <math id="S6.SS3.p2.m2" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> (coordination) should be chosen once the statistic surpasses a threshold. Furthermore, it indicates the strength of the statistical detector’s ability to filter noise and correctly determine that coordination is present. However, as the noise variance increases the probability of Type-II error (determining <math id="S6.SS3.p2.m3" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math> under <math id="S6.SS3.p2.m4" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>) grows, since the statistic <math id="S6.SS3.p2.m5" class="ltx_Math" alttext="1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>^</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝜷</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\hat{F}_{\Psi}(\Phi^{*}(\bar{\bm{\beta}}))</annotation></semantics></math> becomes more likely to surpass a given threshold <math id="S6.SS3.p2.m6" class="ltx_Math" alttext="\gamma\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma\in(0,1)</annotation></semantics></math>. This is an unavoidable consequence, within any statistical detection scheme, of the degraded ability to differentiate coordination vs non-coordination as the noise power grows. However, the particular behavior displayed in Figure <a href="#S6.F5" title="Figure 5 ‣ VI-C Statistical Detector Implementation ‣ VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> gives insight into the control of Type-II error, since one may choose the threshold <math id="S6.SS3.p2.m7" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> to be arbitrarily close to one, in this small noise regime, such that the probability of Type-I error remains constant but that of Type-II error is diminished.</p>
</div>
</section>
<section id="S6.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S6.SS4.6" class="ltx_text">VI-D</span> </span><span id="S6.SS4.7" class="ltx_text ltx_font_italic">Robust Utility Estimation</span></h3>

<div id="S6.SS4.p1" class="ltx_para">
<p id="S6.SS4.p1.1" class="ltx_p">We generate the noisy dataset <math id="S6.SS4.p1.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathcal{D}}</annotation></semantics></math> (<a href="#S4.E19" title="Equation 19 ‣ IV-A Identifying Near-Pareto-Efficient Behavior ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) for <math id="S6.SS4.p1.m2" class="ltx_Math" alttext="M=3" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">M=3</annotation></semantics></math> agents as (<a href="#S6.E38" title="Equation 38 ‣ VI-A Data Generation Model ‣ VI Numerical Examples. Detection of Pareto-Efficient Coordination in Multi-UAV Systems ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>), with <math id="S6.SS4.p1.m3" class="ltx_Math" alttext="T=5,\sigma^{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>=</mo><mn>5</mn></mrow><mo>,</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">T=5,\sigma^{2}=1</annotation></semantics></math>.
We initialize the variables in Algorithm <a href="#alg3" title="Algorithm 3 ‣ IV-E 𝛿-Optimal Robust Utility Reconstruction via Finite Reduction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> as <math id="S6.SS4.p1.m4" class="ltx_Math" alttext="\delta=0.1,\,\epsilon=0.2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>=</mo><mn>0.1</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>ϵ</mi><mo>=</mo><mn>0.2</mn></mrow></mrow><annotation encoding="application/x-tex">\delta=0.1,\,\epsilon=0.2</annotation></semantics></math>.</p>
</div>
<div id="S6.SS4.p2" class="ltx_para">
<p id="S6.SS4.p2.1" class="ltx_p">We test the reconstruction accuracy of (<a href="#S4.E22" title="Equation 22 ‣ IV-B Utility Reconstruction: Classical Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), with parameters <math id="S6.SS4.p2.m1" class="ltx_Math" alttext="\hat{\psi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\psi}</annotation></semantics></math> taken from (<a href="#S4.E21" title="Equation 21 ‣ IV-B Utility Reconstruction: Classical Approach to Utility Reconstruction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) (naive approach) and Algorithm <a href="#alg3" title="Algorithm 3 ‣ IV-E 𝛿-Optimal Robust Utility Reconstruction via Finite Reduction ‣ IV Main Result II. Distributionally Robust Utility Reconstruction ‣ Multi-Agent Inverse RL for Identifying Pareto-Efficient Coordination – Distributionally Robust Approach" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> (robust approach). The reconstruction accuracy of <math id="S6.SS4.p2.m2" class="ltx_Math" alttext="\{\hat{f}^{i}(\cdot)\}_{i=1}^{M}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msup><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\{\hat{f}^{i}(\cdot)\}_{i=1}^{M}</annotation></semantics></math> is quantified as the Hausdorff distance between Pareto-efficient surfaces <math id="S6.SS4.p2.m3" class="ltx_Math" alttext="E_{f,\alpha},E_{\hat{f},\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mrow><mi>f</mi><mo>,</mo><mi>α</mi></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>,</mo><mi>α</mi></mrow></msub></mrow><annotation encoding="application/x-tex">E_{f,\alpha},E_{\hat{f},\alpha}</annotation></semantics></math>, where we define</p>
<table id="S6.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex14.m1" class="ltx_math_unparsed" alttext="E_{g,\alpha}=\{x\in\mathbb{R}^{n}:x\in\arg\max_{\gamma}\sum_{i=1}^{M}g^{i}(\gamma)\,s.t.\,\alpha^{\top}\gamma\leq 1\}" display="block" intent=":literal"><semantics><mrow><msub><mi>E</mi><mrow><mi>g</mi><mo>,</mo><mi>α</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>x</mi><mo>∈</mo><mi>arg</mi><munder><mi>max</mi><mi>γ</mi></munder><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><msup><mi>g</mi><mi>i</mi></msup><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi><mo lspace="0em" rspace="0.337em">.</mo><msup><mi>α</mi><mo>⊤</mo></msup><mi>γ</mi><mo>≤</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">E_{g,\alpha}=\{x\in\mathbb{R}^{n}:x\in\arg\max_{\gamma}\sum_{i=1}^{M}g^{i}(\gamma)\,s.t.\,\alpha^{\top}\gamma\leq 1\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS4.p2.2" class="ltx_p">This Hausdorff distance <math id="S6.SS4.p2.m4" class="ltx_Math" alttext="H(E_{f,\alpha},E_{\hat{f},\alpha})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><mi>f</mi><mo>,</mo><mi>α</mi></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>,</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(E_{f,\alpha},E_{\hat{f},\alpha})</annotation></semantics></math> is defined as</p>
<table id="S6.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex15.m1" class="ltx_Math" alttext="\displaystyle H(E_{f,\alpha},E_{\hat{f},\alpha})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><mi>f</mi><mo>,</mo><mi>α</mi></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>,</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(E_{f,\alpha},E_{\hat{f},\alpha})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex16.m1" class="ltx_Math" alttext="\displaystyle\quad:=\max\biggl\{\sup_{x\in E_{f,\alpha}}d(x,E_{\hat{f},\alpha}),\sup_{y\in E_{\hat{f},\alpha}}d(y,E_{f,\alpha})\biggr\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>x</mi><mo>∈</mo><msub><mi>E</mi><mrow><mi>f</mi><mo>,</mo><mi>α</mi></mrow></msub></mrow></munder><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>E</mi><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>,</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>y</mi><mo>∈</mo><msub><mi>E</mi><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>,</mo><mi>α</mi></mrow></msub></mrow></munder><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>E</mi><mrow><mi>f</mi><mo>,</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad:=\max\biggl\{\sup_{x\in E_{f,\alpha}}d(x,E_{\hat{f},\alpha}),\sup_{y\in E_{\hat{f},\alpha}}d(y,E_{f,\alpha})\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS4.p2.3" class="ltx_p">where the distance from point <math id="S6.SS4.p2.m5" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> to set <math id="S6.SS4.p2.m6" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is <math id="S6.SS4.p2.m7" class="ltx_Math" alttext="d(a,B)=\inf_{b\in B}d(a,b)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">inf</mo><mrow><mi>b</mi><mo>∈</mo><mi>B</mi></mrow></msub><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">d(a,B)=\inf_{b\in B}d(a,b)</annotation></semantics></math>. The Hausdorff distance is a natural metric for quantifying reconstruction error in this
setting because the object of interest is not the utilities themselves but the
Pareto-efficient surfaces they induce. Two different sets of utilities may produce
similar efficient frontiers, in which case their predictive implications for system
behavior are essentially indistinguishable. Conversely, small perturbations in the
utilities that result in large shifts of the frontier, resulting in poor predictive
accuracy. The Hausdorff distance captures precisely this geometric notion: it measures
the worst-case discrepancy between the true efficient set <math id="S6.SS4.p2.m8" class="ltx_Math" alttext="E_{f,\alpha}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><mi>f</mi><mo>,</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">E_{f,\alpha}</annotation></semantics></math> and the
reconstructed efficient set <math id="S6.SS4.p2.m9" class="ltx_Math" alttext="E_{\hat{f},\alpha}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>,</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">E_{\hat{f},\alpha}</annotation></semantics></math>. In other words, it quantifies the
largest misspecification an analyst would face when using the reconstructed utilities
to predict coordinated responses under any probe <math id="S6.SS4.p2.m10" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>. This worst-case orientation
is particularly important in adversarial or covert sensing environments, where even a
single large deviation can compromise detection or prediction.</p>
</div>
