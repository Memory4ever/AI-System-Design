{"data":{"id":"10.48550/arxiv.2509.09629","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.09629","prefix":"10.48550","suffix":"arxiv.2509.09629","identifiers":[{"identifier":"2509.09629","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.09629"}],"creators":[{"name":"Zhu, Minghang","nameType":"Personal","givenName":"Minghang","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Shi, Zhengliang","nameType":"Personal","givenName":"Zhengliang","familyName":"Shi","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Zhiwei","nameType":"Personal","givenName":"Zhiwei","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Shiguang","nameType":"Personal","givenName":"Shiguang","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Lingjie","nameType":"Personal","givenName":"Lingjie","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Ren, Pengjie","nameType":"Personal","givenName":"Pengjie","familyName":"Ren","affiliation":[],"nameIdentifiers":[]},{"name":"Ren, Zhaochun","nameType":"Personal","givenName":"Zhaochun","familyName":"Ren","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Zhumin","nameType":"Personal","givenName":"Zhumin","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bridging the Capability Gap: Joint Alignment Tuning for Harmonizing LLM-based Multi-Agent Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-11T17:15:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-12T00:47:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The advancement of large language models (LLMs) has enabled the construction of multi-agent systems to solve complex tasks by dividing responsibilities among specialized agents, such as a planning agent for subgoal generation and a grounding agent for executing tool-use actions. Most existing methods typically fine-tune these agents independently, leading to capability gaps among them with poor coordination. To address this, we propose MOAT, a Multi-Agent Joint Alignment Tuning framework that improves agents collaboration through iterative alignment. MOAT alternates between two key stages: (1) Planning Agent Alignment, which optimizes the planning agent to generate subgoal sequences that better guide the grounding agent; and (2) Grounding Agent Improving, which fine-tunes the grounding agent using diverse subgoal-action pairs generated by the agent itself to enhance its generalization capablity. Theoretical analysis proves that MOAT ensures a non-decreasing and progressively convergent training process. Experiments across six benchmarks demonstrate that MOAT outperforms state-of-the-art baselines, achieving average improvements of 3.1% on held-in tasks and 4.4% on held-out tasks.","descriptionType":"Abstract"},{"description":"EMNLP 2025 Findings","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.09629","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-12T01:38:27.000Z","registered":"2025-09-12T01:38:28.000Z","published":"2025","updated":"2025-09-12T01:38:28.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.09629","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}