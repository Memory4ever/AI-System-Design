<span id="S4.T4.4.1.1.1.1.1.1.3" class="ltx_tr">
<span id="S4.T4.4.1.1.1.1.1.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t ltx_rowspan ltx_rowspan_2"><span id="S4.T4.4.1.1.1.1.1.1.3.1.1" class="ltx_text">Baseline</span></span>
<span id="S4.T4.4.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Visual Matching</span>
<span id="S4.T4.4.1.1.1.1.1.1.3.3" class="ltx_td ltx_align_center ltx_border_t">91.3</span>
<span id="S4.T4.4.1.1.1.1.1.1.3.4" class="ltx_td ltx_align_center ltx_border_t">85.0</span>
<span id="S4.T4.4.1.1.1.1.1.1.3.5" class="ltx_td ltx_align_center ltx_border_t">71.8</span>
