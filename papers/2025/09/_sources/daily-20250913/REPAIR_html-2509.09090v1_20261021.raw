<tr id="S4.T1.4.2" class="ltx_tr">
<th id="S4.T1.4.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S4.T1.4.2.1.1" class="ltx_text ltx_font_bold">Pick Coke</span></th>
