<div id="A2.F10.3.2" class="ltx_block ltx_minipage ltx_align_middle" style="width:49.7pt;"><img src="2509.08897v1/images/qualitatives/rag/infoseek/infoseek_val_00011689.jpg" id="A2.F10.g3" class="ltx_graphics ltx_img_square" style="aspect-ratio:69/61;" width="69" height="61" alt="Refer to caption">
