<td id="S5.T2.1.1.1.14" class="ltx_td ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"></td>
<td id="S5.T2.1.1.1.15" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="2"><span id="S5.T2.1.1.1.15.1" class="ltx_text ltx_font_bold">E-VQA</span></td>
<td id="S5.T2.1.1.1.16" class="ltx_td ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"></td>
<td id="S5.T2.1.1.1.17" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="2"><span id="S5.T2.1.1.1.17.1" class="ltx_text ltx_font_bold">OKVQA</span></td>
<td id="S5.T2.1.1.1.18" class="ltx_td ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"></td>
