<th id="S5.T4.4.1.1.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" colspan="2">Method</th>
<th id="S5.T4.4.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="6">AVMS (both blurred) scale:8</th></tr>
<tr id="S5.T4.4.1.2" class="ltx_tr">
<th id="S5.T4.4.1.2.1" class="ltx_td ltx_th ltx_th_column ltx_th_row"></th>
<th id="S5.T4.4.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S5.T4.4.1.2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">CLSE</span></th>
