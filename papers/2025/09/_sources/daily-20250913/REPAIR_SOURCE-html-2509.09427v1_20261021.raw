<td id="S5.T1.8.1.2.6" class="ltx_td ltx_align_left ltx_border_r">MSE↓</td>
<td id="S5.T1.8.1.2.7" class="ltx_td ltx_align_left">VIF↑</td>
<td id="S5.T1.8.1.2.8" class="ltx_td ltx_align_left">Q<sup id="S5.T1.8.1.2.8.1" class="ltx_sup">AB/F</sup>↑</td>
