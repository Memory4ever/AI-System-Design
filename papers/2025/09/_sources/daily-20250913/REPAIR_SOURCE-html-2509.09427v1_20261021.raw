<tr id="S5.T1.8.1.1" class="ltx_tr">
<td id="S5.T1.8.1.1.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="S5.T1.8.1.1.1.1" class="ltx_text">Methods</span></td>
<td id="S5.T1.8.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="6">Dataset: MSRS fusion dataset (<span id="S5.T1.8.1.1.2.1" class="ltx_text ltx_font_bold">VI and IR blurred scale:8</span>)</td>
<td id="S5.T1.8.1.1.3" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="S5.T1.8.1.1.3.1" class="ltx_text">Methods</span></td>
<td id="S5.T1.8.1.1.4" class="ltx_td ltx_align_center ltx_border_t" colspan="6">Dataset: MSRS fusion dataset (<span id="S5.T1.8.1.1.4.1" class="ltx_text ltx_font_bold">VI blurred scale: 8</span>)</td></tr>
