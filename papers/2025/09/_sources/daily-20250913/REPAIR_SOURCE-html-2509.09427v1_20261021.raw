<tr id="S5.T1.8.1.3" class="ltx_tr">
<td id="S5.T1.8.1.3.1" class="ltx_td ltx_align_left ltx_border_t">CDD<span id="S5.T1.8.1.3.1.1" class="ltx_text" style="--ltx-fg-color:#800080;">+SR3</span></td>
<td id="S5.T1.8.1.3.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T1.8.1.3.2.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">0.465</span></td>
<td id="S5.T1.8.1.3.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T1.8.1.3.3.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">0.417</span></td>
