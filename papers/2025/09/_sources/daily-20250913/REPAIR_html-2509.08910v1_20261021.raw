</span></span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#EDFFFF;" fill="#EDFFFF"><path d="M 66.93 -314.22 L -66.93 -314.22 C -71.28 -314.22 -74.8 -317.75 -74.8 -322.1 L -74.8 -343.75 C -74.8 -348.1 -71.28 -351.62 -66.93 -351.62 L 66.93 -351.62 C 71.28 -351.62 74.8 -348.1 74.8 -343.75 L 74.8 -322.1 C 74.8 -317.75 71.28 -314.22 66.93 -314.22 Z M -74.8 -351.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -61.57 -343.55)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 25.02)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.41)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 16.41)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 7.26)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:9.9em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.19em;font-size:9.06pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="124.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.15" class="ltx_text ltx_font_bold" style="font-size:70%;">S3: (Opt.) Verification</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.42)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 11.55 0)"><foreignObject style="--ltx-fo-width:9.04em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="99.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.16" class="ltx_text" style="font-size:70%;">ReAct external tools</span></span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 23.14)"><g clas