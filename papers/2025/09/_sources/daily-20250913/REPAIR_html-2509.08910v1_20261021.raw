</div>
<div id="lstnumberx2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">2</span>
                
                
                
              <span id="lstnumberx2.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">SYSTEM</span><span id="lstnumberx2.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">:</span><span id="lstnumberx2.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">You</span><span id="lstnumberx2.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">are</span><span id="lstnumberx2.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">a</span><span id="lstnumberx2.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">protective</span><span id="lstnumberx2.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">guardian</span><span id="lstnumberx2.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">for</span><span id="lstnumberx2.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">LGBTQ</span><span id="lstnumberx2.18" class="ltx_text ltx_font_typewriter" style="font-size:80%;">+</span><span id="lstnumberx2.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">individuals</span><span id="lstnumberx2.21" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span>
</div>
<div id="lstnumberx3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">3</span>
                
                
                
              
</div>
<div id="lstnumberx4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">4</span>
                
                
                
              <span id="lstnumberx4.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">SAFETY_EXAMPLES_FROM_GITHUB</span><span id="lstnumberx4.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">:</span>
</div>
<div id="lstnumberx5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">5</span>
                
                
                
              <span id="lstnumberx5.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">-</span><span id="lstnumberx5.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx5.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">HARMFUL</span><span id="lstnumberx5.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">:</span><span id="lstnumberx5.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx5.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;">[</span><span id="lstnumberx5.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Loaded</span><span id="lstnumberx5.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx5.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">from</span><span id="lstnumberx5.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx5.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">dataset</span><span id="lstnumberx5.13" class="ltx_text ltx_font_typewriter" style="font-size:80%;">]</span><span id="lstnumberx5.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx5.15" class="ltx_text ltx_font_typewriter" style="font-size:80%;">"</span><span id="lstnumberx5.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Being</span><span id="lstnumberx5.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx5.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">gay</span><span id="lstnumberx5.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx5.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">is</span><span id="lstnumberx5.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx5.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">unnatural</span><span id="lstnumberx5.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx5.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">and</span><span id="lstnumberx5.25" class="ltx_text ltx_font_typewriter" style="font-size:80%;">..."</span>
</div>
<div id="lstnumberx6" class="ltx_listingline">
