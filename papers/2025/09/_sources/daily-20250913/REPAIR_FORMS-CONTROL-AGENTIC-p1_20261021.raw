{"data":[{"id":"10.48550/arxiv.2509.09505","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.09505","identifiers":[{"identifier":"2509.09505","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoran","familyName":"Wu","name":"Wu, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Can","familyName":"Xiao","name":"Xiao, Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Nie","name":"Nie, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuan","familyName":"Guo","name":"Guo, Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binglei","familyName":"Lou","name":"Lou, Binglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeffrey T. H.","familyName":"Wong","name":"Wong, Jeffrey T. H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwen","familyName":"Mo","name":"Mo, Zhiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Zhang","name":"Zhang, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Przemyslaw","familyName":"Forys","name":"Forys, Przemyslaw","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengyang","familyName":"Ai","name":"Ai, Chengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timi","familyName":"Adeniran","name":"Adeniran, Timi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wayne","familyName":"Luk","name":"Luk, Wayne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongxiang","familyName":"Fan","name":"Fan, Hongxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianyi","familyName":"Cheng","name":"Cheng, Jianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timothy M.","familyName":"Jones","name":"Jones, Timothy M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rika","familyName":"Antonova","name":"Antonova, Rika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Mullins","name":"Mullins, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaron","familyName":"Zhao","name":"Zhao, Aaron","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Combating the Memory Walls: Optimization Pathways for Long-Context Agentic LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-11T14:49:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-12T00:40:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T11:31:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:43:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-12T10:29:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-14T01:00:03Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLMs now form the backbone of AI agents across a diverse range of applications, including tool use, command-line interfaces, and web or computer interaction. These agentic LLM inference tasks are fundamentally different from chatbot-focused inference. They often involve much longer context lengths to capture complex and prolonged inputs, such as an entire webpage DOM or complicated tool-call trajectories. This, in turn, generates significant off-chip memory traffic during inference and causes workloads to be constrained by two memory walls, namely the bandwidth wall and the capacity wall, preventing compute units from achieving high utilization.\n In this paper, we introduce PLENA, a hardware-software co-designed system built around three core optimization pathways. PLENA features a novel flattened systolic-array architecture (Pathway 1) and efficient compute and memory units that support an asymmetric quantization scheme (Pathway 2). It also provides native support for FlashAttention (Pathway 3). In addition, PLENA includes a complete software-hardware stack, consisting of a custom ISA, a compiler, a transaction-level simulator, and an automated design-space exploration flow. Experimental results show that PLENA delivers up to 2.23x and 4.70x higher throughput than the A100 GPU and TPU v6e, respectively, under identical multiplier counts and memory configurations during LLaMA agentic inference. PLENA also achieves up to 4.04x higher energy efficiency than the A100 GPU. The full PLENA system, including its simulator, compiler, ISA, and RTL implementation, will be open-sourced to the research community."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.09505","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-12T01:35:33Z","registered":"2025-09-12T01:35:33Z","published":null,"updated":"2026-04-14T04:17:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=%28titles.title%3A%28%22agentic%22%29+OR+descriptions.description%3A%28%22agentic%22%29%29+AND+doi%3A%2210.48550%2Farxiv.2509.09505%22+AND+registered%3A%5B2025-09-11T16%3A00%3A00Z+TO+2025-09-12T15%3A59%3A59.999Z%5D\u0026page%5Bsize%5D=100\u0026sort=registered"}}