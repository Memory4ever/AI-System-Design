<td id="S5.T5.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T5.m3" class="ltx_Math" alttext="0.6152\pm 0.0577" display="inline" intent=":literal"><semantics><mrow><mn>0.6152</mn><mo>±</mo><mn>0.0577</mn></mrow><annotation encoding="application/x-tex">0.6152\pm 0.0577</annotation></semantics></math></td>
<td id="S5.T5.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T5.m4" class="ltx_Math" alttext="0.2968\pm 0.0175" display="inline" intent=":literal"><semantics><mrow><mn>0.2968</mn><mo>±</mo><mn>0.0175</mn></mrow><annotation encoding="application/x-tex">0.2968\pm 0.0175</annotation></semantics></math></td>
