<td id="S5.T5.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T5.m1" class="ltx_Math" alttext="0.3524\pm 0.0238" display="inline" intent=":literal"><semantics><mrow><mn>0.3524</mn><mo>±</mo><mn>0.0238</mn></mrow><annotation encoding="application/x-tex">0.3524\pm 0.0238</annotation></semantics></math></td>
