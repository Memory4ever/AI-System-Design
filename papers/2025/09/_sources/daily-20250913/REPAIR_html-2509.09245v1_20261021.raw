<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              <span id="alg1.l7.1" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l7.2" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              Sample <math id="alg1.l8.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> candidate thought-action pairs from LLM

</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              <span id="alg1.l9.1" class="ltx_text ltx_font_bold">for</span> each candidate <span id="alg1.l9.2" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
               Execute code in notebook context, obtain output

</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
               Expand notebook content to create a new child node

</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
               <span id="alg1.l12.1" class="ltx_text ltx_font_bold">if</span> Trajectory Collection Phrase <span id="alg1.l12.2" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
                <span id="alg1.l13.1" class="ltx_text ltx_font_bold">if</span> Child node is terminal <span id="alg1.l13.2" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
                 Assign reward (<math id="alg1.l14.m1" class="ltx_Math" alttext="+1" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">+1</annotation></semantics></math> if correct answer, <math id="alg1.l14.m2" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math> if error/invalid)

</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
                <span id="alg1.l15.1" class="ltx_text ltx_font_bold">else</span>


