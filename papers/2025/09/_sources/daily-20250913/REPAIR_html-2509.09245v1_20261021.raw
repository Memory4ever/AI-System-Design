<td id="Sx4.T1.1.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="Sx4.T1.1.2.2.1" class="ltx_text ltx_font_bold ltx_align_left ltx_inline-block" style="width:30.0pt;">+56.81</span> (<span id="Sx4.T1.1.2.2.2" class="ltx_text ltx_phantom"><span style="visibility:hidden">0</span></span>2.33 <math id="Sx4.T1.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> 59.14)</td></tr>
<tr id="Sx4.T1.1.3" class="ltx_tr">
