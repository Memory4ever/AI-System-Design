<td id="Sx4.T3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="Sx4.T3.1.1.2.1" class="ltx_text ltx_font_bold">Strategy</span></td>
<td id="Sx4.T3.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="Sx4.T3.1.1.3.1" class="ltx_text ltx_font_bold">Accuracy (%)</span></td></tr>
<tr id="Sx4.T3.1.2" class="ltx_tr">
<td id="Sx4.T3.1.2.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="3"><span id="Sx4.T3.1.2.1.1" class="ltx_text">Vanilla</span></td>
<td id="Sx4.T3.1.2.2" class="ltx_td ltx_align_center ltx_border_t">PoT</td>
