</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              <span id="alg1.l3.1" class="ltx_text ltx_font_bold">if</span> Trajectory Collection Phrase <span id="alg1.l3.2" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
               Select node to expand using PUCT (<math id="alg1.l4.m1" class="ltx_Math" alttext="c_{puct}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{puct}&gt;0</annotation></semantics></math>)

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              <span id="alg1.l5.1" class="ltx_text ltx_font_bold">else</span>


</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
               Select node to expand using PUCT (<math id="alg1.l6.m1" class="ltx_Math" alttext="c_{puct}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{puct}=0</annotation></semantics></math>)

