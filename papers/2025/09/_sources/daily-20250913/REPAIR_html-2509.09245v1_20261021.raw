<tr id="Sx4.T1.1.4" class="ltx_tr">
<th id="Sx4.T1.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">Qwen2.5-7B-Instruct</th>
<td id="Sx4.T1.1.4.2" class="ltx_td ltx_align_left"><span id="Sx4.T1.1.4.2.1" class="ltx_text ltx_font_bold ltx_align_left ltx_inline-block" style="width:30.0pt;">+24.12</span> (43.97 <math id="Sx4.T1.m3" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> 68.09)</td></tr>
