<td id="Sx4.T1.1.5.2" class="ltx_td ltx_align_left ltx_border_b"><span id="Sx4.T1.1.5.2.1" class="ltx_text ltx_font_bold ltx_align_left ltx_inline-block" style="width:30.0pt;">+7.39</span> (69.65 <math id="Sx4.T1.m4" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> 77.04)</td></tr>
