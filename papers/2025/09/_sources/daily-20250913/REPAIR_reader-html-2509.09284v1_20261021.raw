</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F4.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.09284v1/adv_var_plot.svg" id="S4.F4.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/282;" width="476" height="282"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F4.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S4.F4.sf2.4" class="ltx_text" style="font-size:90%;">Advantage variance</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
