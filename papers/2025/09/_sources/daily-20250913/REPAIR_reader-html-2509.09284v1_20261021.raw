.05 -158.53 -196.88 -147.64 -196.88 C -136.75 -196.88 -127.92 -188.05 -127.92 -177.17 Z M -147.64 -177.17"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -155.82 -184.53)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 20.96)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 1.42 0)"><foreignObject style="--ltx-fo-width:1.06em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="13.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.7" class="ltx_text" style="font-size:90%;">C </span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.85)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="16.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.8" class="ltx_text" style="font-size:90%;">(3)</span></span></span></foreignObject></g></g></g></g><path style="fill:none" d="M -147.64 -138.1 L -147.64 -152.19"></path><g transform="matrix(0.0 -1.0 1.0 0.0 -147.64 -152.19)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g><g style="--ltx-fill-color:#B3FFB3;" fill="#B3FFB3"><path d="M -127.92 -236.22 C -127.92 -225.33 -136.75 -216.51 -147.64 -216.51 C -158.53 -216.51 -167.35 -225.33 -167.35 -236.22 C -167.35 -247.11 -158.53 -255.93 -147.64 -255.93 C -136.75 -255.93 -127.92 -247.11 -127.92 -236.22 Z M -147.64 -236.22"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -155.82 -243.59)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 20.96)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 1.16 0)"><foreignObject style="--ltx-fo-width:1.1em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="14.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.9" class="ltx_text" style="font-size:90%;">D </span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.85)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="16.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.10" class="ltx_text" style="font-size:90%;">(4)</span></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -186.07 -264.48)"><foreignObject style="--ltx-fo-width:0.58em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.04em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="8.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<div id="S3.F1.pic1.11" class="ltx_inline-block ltx_transformed_outer" style="width:5.8pt;height:34.4pt;vertical-align:-34.4pt;"><span class="ltx_transformed_inner" style="width:34.4pt;transform:translate(-14.3pt,-14.3pt) rotate(90deg) ;">
