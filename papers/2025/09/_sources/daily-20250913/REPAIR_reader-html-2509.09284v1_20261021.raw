<span id="A3.T4.3.3.1.1" class="ltx_inline-block ltx_align_middle" style="width:85.4pt;">
<span id="A3.T4.3.3.1.1.1" class="ltx_p ltx_align_center"><span id="A3.T4.3.3.1.1.1.1" class="ltx_text" style="font-size:90%;">Q-A-B</span></span>
</span></td>
<td id="A3.T4.3.3.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A3.T4.3.3.2.1" class="ltx_text" style="font-size:90%;">1</span></td>
<td id="A3.T4.3.3.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A3.T4.3.3.3.1" class="ltx_text" style="font-size:90%;">3</span></td>
<td id="A3.T4.3.3.4" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="A3.T4.m5" class="ltx_Math" alttext="\frac{1}{3}" display="inline" intent=":literal"><semantics><mfrac><mn mathsize="0.900em">1</mn><mn mathsize="0.900em">3</mn></mfrac><annotation encoding="application/x-tex">\frac{1}{3}</annotation></semantics></math></td>
<td id="A3.T4.3.3.5" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A3.T4.3.3.5.1" class="ltx_text" style="font-size:90%;">1</span></td>
<td id="A3.T4.3.3.6" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A3.T4.3.3.6.1" class="ltx_text" style="font-size:90%;">0</span></td></tr>
