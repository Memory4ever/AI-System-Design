<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F4.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S4.F4.sf3.4" class="ltx_text" style="font-size:90%;">Group average reward</span></figcaption>
</figure></div></div>
