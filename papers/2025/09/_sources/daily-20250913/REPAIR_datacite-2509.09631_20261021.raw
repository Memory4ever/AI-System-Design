{"data":{"id":"10.48550/arxiv.2509.09631","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.09631","prefix":"10.48550","suffix":"arxiv.2509.09631","identifiers":[{"identifier":"2509.09631","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.09631"}],"creators":[{"name":"Nguyen, Ngoc-Son","nameType":"Personal","givenName":"Ngoc-Son","familyName":"Nguyen","affiliation":[],"nameIdentifiers":[]},{"name":"Tran, Thanh V. T.","nameType":"Personal","givenName":"Thanh V. T.","familyName":"Tran","affiliation":[],"nameIdentifiers":[]},{"name":"Huynh-Nguyen, Hieu-Nghia","nameType":"Personal","givenName":"Hieu-Nghia","familyName":"Huynh-Nguyen","affiliation":[],"nameIdentifiers":[]},{"name":"Hy, Truong-Son","nameType":"Personal","givenName":"Truong-Son","familyName":"Hy","affiliation":[],"nameIdentifiers":[]},{"name":"Nguyen, Van","nameType":"Personal","givenName":"Van","familyName":"Nguyen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DiFlow-TTS: Compact and Low-Latency Zero-Shot Text-to-Speech with Discrete Flow Matching"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Sound (cs.SD)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-11T17:16:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-12T00:47:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-12T01:59:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-15T00:12:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-07T14:31:16Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-08T01:46:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-16T09:58:12Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-17T00:43:39Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-06-17T16:16:04Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-06-18T01:05:37Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Zero-shot text-to-speech (TTS) has made significant progress in replicating unseen voices, yet balancing generation quality and inference efficiency remains challenging. Autoregressive models suffer from high latency, while diffusion-based approaches are constrained by training-time configurations. Moreover, most flow-based methods operate in continuous space, which introduces optimization challenges because continuous token spaces are inherently more complex than discrete ones. To address these limitations, we propose DiFlow-TTS, a novel zero-shot TTS framework based on discrete flow matching. The model consists of a deterministic Phoneme-Content Mapper for linguistic modeling and a Factorized Discrete Flow Denoiser that simultaneously generates prosody and acoustic token streams. Experimental results demonstrate the effectiveness of our approach across multiple evaluation metrics.","descriptionType":"Abstract"},{"description":"Accepted at Interspeech 2026 (Long Paper Track)","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.09631","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-12T01:38:30.000Z","registered":"2025-09-12T01:38:30.000Z","published":"2025","updated":"2026-06-18T02:18:34.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.09631","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}