<span id="S3.T1.2.1.1.1.4" class="ltx_tr">
<span id="S3.T1.2.1.1.1.4.1" class="ltx_td ltx_align_left ltx_border_r" style="padding:3.5pt 3.0pt;">SD2.1 <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib54" title="" class="ltx_ref">Stability-AI, 2022</a>]</cite></span>
<span id="S3.T1.2.1.1.1.4.2" class="ltx_td ltx_align_center" style="padding:3.5pt 3.0pt;">47.9</span>
