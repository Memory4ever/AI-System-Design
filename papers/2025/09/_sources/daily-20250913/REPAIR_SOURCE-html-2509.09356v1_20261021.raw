<td id="S5.T3.3.5.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T3.3.5.5.1" class="ltx_text" style="font-size:90%;">228</span></td>
<td id="S5.T3.3.5.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T3.3.5.6.1" class="ltx_text"></span><span id="S5.T3.3.5.6.2" class="ltx_text" style="font-size:90%;"> <span id="S5.T3.3.5.6.2.1" class="ltx_text">
<span id="S5.T3.3.5.6.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T3.3.5.6.2.1.1.1" class="ltx_tr">
