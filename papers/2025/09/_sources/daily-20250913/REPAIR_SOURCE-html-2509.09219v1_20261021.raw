<td id="S5.T2.7.6.2" class="ltx_td ltx_align_center">0.73 <math id="S5.T2.m11" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.16</td>
<td id="S5.T2.7.6.3" class="ltx_td ltx_align_center">1.00 <math id="S5.T2.m12" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.00</td></tr>
<tr id="S5.T2.7.7" class="ltx_tr">
<th id="S5.T2.7.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">CrossingTraffic</th>
