<tr id="S5.T4.6.9" class="ltx_tr">
<th id="S5.T4.6.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Elevators</th>
<td id="S5.T4.6.9.2" class="ltx_td ltx_align_center ltx_border_bb">0.00 <math id="S5.T4.m25" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.00</td>
<td id="S5.T4.6.9.3" class="ltx_td ltx_align_center ltx_border_bb">0.21 <math id="S5.T4.m26" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.19</td>
<td id="S5.T4.6.9.4" class="ltx_td ltx_align_center ltx_border_bb">1.00 <math id="S5.T4.m27" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.00</td></tr>
</tbody>
