<th id="S5.T4.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="S5.T4.5.1.1.2.1" class="ltx_text">mixtral</span></th>
<th id="S5.T4.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="S5.T4.5.1.1.3.1" class="ltx_text">deepseek</span></th>
<th id="S5.T4.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T4.5.1.1.4.1" class="ltx_text">qwen</span></th></tr>
</thead>
