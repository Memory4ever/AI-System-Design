<th id="S4.T2.7.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Nonlinear_FN</th>
<td id="S4.T2.7.1.4.2" class="ltx_td ltx_align_center"><span id="S4.T2.7.1.4.2.1" class="ltx_text" style="--ltx-fg-color:#009900;">✓</span></td>
<td id="S4.T2.7.1.4.3" class="ltx_td ltx_align_center"><span id="S4.T2.7.1.4.3.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td>
<td id="S4.T2.7.1.4.4" class="ltx_td ltx_align_center"><span id="S4.T2.7.1.4.4.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td>
<td id="S4.T2.7.1.4.5" class="ltx_td ltx_align_center"><span id="S4.T2.7.1.4.5.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td>
<td id="S4.T2.7.1.4.6" class="ltx_td ltx_align_center"><span id="S4.T2.7.1.4.6.1" class="ltx_text" style="--ltx-fg-color:#009900;">✓</span>*</td>
<td id="S4.T2.7.1.4.7" class="ltx_td ltx_align_center"><span id="S4.T2.7.1.4.7.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td>
