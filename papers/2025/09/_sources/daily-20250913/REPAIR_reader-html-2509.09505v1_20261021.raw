<td id="A1.T15.5.1.4.2" class="ltx_td ltx_align_left">Matrix SRAM depth must accommodate <math id="A1.T15.m4" class="ltx_math_unparsed" alttext="2\times" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">2\times</annotation></semantics></math> MLEN</td></tr>
<tr id="A1.T15.5.1.5" class="ltx_tr">
<th id="A1.T15.5.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">VECTOR_SRAM_DEPTH <math id="A1.T15.m5" class="ltx_math_unparsed" alttext="\geq 2\times" display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mn>2</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">\geq 2\times</annotation></semantics></math> HEAD_DIM <math id="A1.T15.m6" class="ltx_Math" alttext="+\frac{\text{HIDDEN\_DIM}}{\text{VLEN}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mfrac><mtext>HIDDEN_DIM</mtext><mtext>VLEN</mtext></mfrac></mrow><annotation encoding="application/x-tex">+\frac{\text{HIDDEN\_DIM}}{\text{VLEN}}</annotation></semantics></math></th>
