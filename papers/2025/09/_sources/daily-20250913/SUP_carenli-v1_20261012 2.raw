<tr id="S4.T2.2.4" class="ltx_tr">
<th id="S4.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">gpt-4o</th>
<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center">64.0</td>
<td id="S4.T2.2.4.3" class="ltx_td ltx_align_center">74.0</td>
<td id="S4.T2.2.4.4" class="ltx_td ltx_align_center">67.3</td>
<td id="S4.T2.2.4.5" class="ltx_td ltx_align_center">52.0</td></tr>
<tr id="S4.T2.2.5" class="ltx_tr">
