<td id="S4.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.2.3.1" class="ltx_text ltx_font_bold">92.2</span></td>
<td id="S4.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.2.4.1" class="ltx_text ltx_font_bold">72.3</span></td>
<td id="S4.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.2.5.1" class="ltx_text ltx_font_bold">60.2</span></td></tr>
