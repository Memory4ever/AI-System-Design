<tr id="S4.T1.2.15" class="ltx_tr">
<th id="S4.T1.2.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">gpt-4o</th>
<td id="S4.T1.2.15.2" class="ltx_td ltx_align_center">37.0</td>
