<td id="S5.T2.4.3.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T2.4.3.6.1" class="ltx_text" style="font-size:80%;">0.9401</span></td></tr>
<tr id="S5.T2.4.4" class="ltx_tr">
