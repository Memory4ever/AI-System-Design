<td id="S5.T2.4.4.2" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S5.T2.4.4.2.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T2.4.4.2.1.1" class="ltx_p ltx_align_left"><span id="S5.T2.4.4.2.1.1.1" class="ltx_text" style="font-size:80%;">mini/mini/41/5/0</span></span>
</span></td>
<td id="S5.T2.4.4.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T2.4.4.3.1" class="ltx_text" style="font-size:80%;">0.9352</span></td>
