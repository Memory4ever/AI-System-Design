               <math id="alg1.l11.m1" class="ltx_Math" alttext="\mathit{result}\leftarrow" display="inline" intent=":literal"><semantics><mrow><mi>𝑟𝑒𝑠𝑢𝑙𝑡</mi><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathit{result}\leftarrow</annotation></semantics></math> <span id="alg1.l11.3" class="ltx_text ltx_font_smallcaps">VerifyWithLLM<math id="alg1.l11.m2" class="ltx_Math" alttext="(F^{syn},C)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>F</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(F^{syn},C)</annotation></semantics></math></span>

