<td id="S5.T8.5.4.3" class="ltx_td ltx_align_center"><span id="S5.T8.5.4.3.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">0.0611</span></td></tr>
<tr id="S5.T8.5.5" class="ltx_tr">
<td id="S5.T8.5.5.1" class="ltx_td ltx_align_left ltx_border_bb">SCIBERT</td>
