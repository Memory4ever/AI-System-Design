<td id="S5.T8.5.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T8.5.1.2.1" class="ltx_text ltx_font_bold">MSE</span></td>
<td id="S5.T8.5.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T8.5.1.3.1" class="ltx_text ltx_font_bold">MAE</span></td></tr>
