{"data":{"id":"10.48550/arxiv.2509.09977","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.09977","prefix":"10.48550","suffix":"arxiv.2509.09977","identifiers":[{"identifier":"2509.09977","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.09977"}],"creators":[{"name":"Liu, Siying","nameType":"Personal","givenName":"Siying","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zikai","nameType":"Personal","givenName":"Zikai","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Hanle","nameType":"Personal","givenName":"Hanle","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Yifan","nameType":"Personal","givenName":"Yifan","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Xilin","nameType":"Personal","givenName":"Xilin","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Qingkai","nameType":"Personal","givenName":"Qingkai","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Jibin","nameType":"Personal","givenName":"Jibin","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Hao","nameType":"Personal","givenName":"Hao","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Deng, Lei","nameType":"Personal","givenName":"Lei","familyName":"Deng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ISTASTrack: Bridging ANN and SNN via ISTA Adapter for RGB-Event Tracking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T05:37:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-15T00:17:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-26T03:59:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-27T00:28:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"RGB-Event tracking has become a promising trend in visual object tracking to leverage the complementary strengths of both RGB images and dynamic spike events for improved performance. However, existing artificial neural networks (ANNs) struggle to fully exploit the sparse and asynchronous nature of event streams. Recent efforts toward hybrid architectures combining ANNs and spiking neural networks (SNNs) have emerged as a promising solution in RGB-Event perception, yet effectively fusing features across heterogeneous paradigms remains a challenge. In this work, we propose ISTASTrack, the first transformer-based \\textbf{A}NN-\\textbf{S}NN hybrid \\textbf{Track}er equipped with \\textbf{ISTA} adapters for RGB-Event tracking. The two-branch model employs a vision transformer to extract spatial context from RGB inputs and a spiking transformer to capture spatio-temporal dynamics from event streams. To bridge the modality and paradigm gap between ANN and SNN features, we systematically design a model-based ISTA adapter for bidirectional feature interaction between the two branches, derived from sparse representation theory by unfolding the iterative shrinkage thresholding algorithm. Additionally, we incorporate a temporal downsampling attention module within the adapter to align multi-step SNN features with single-step ANN features in the latent space, improving temporal fusion. Experimental results on RGB-Event tracking benchmarks, such as FE240hz, VisEvent, COESOT, and FELT, have demonstrated that ISTASTrack achieves state-of-the-art performance while maintaining high energy efficiency, highlighting the effectiveness and practicality of hybrid ANN-SNN designs for robust visual tracking. The code is publicly available at https://github.com/lsying009/ISTASTrack.git.","descriptionType":"Abstract"},{"description":"Accepted by IEEE Transactions on Image Processing, DOI: 10.1109/TIP.2026.3694138, 15 pages, 8 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.09977","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-15T01:24:06.000Z","registered":"2025-09-15T01:24:07.000Z","published":"2025","updated":"2026-05-27T02:35:57.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.09977","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}