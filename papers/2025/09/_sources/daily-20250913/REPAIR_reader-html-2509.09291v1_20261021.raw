<td id="S5.T3.7.9.1" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T3.m10" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S5.T3.7.9.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T3.m11" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
