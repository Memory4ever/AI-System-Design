<td id="S5.T2.5.5.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.5.5.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFE0E0;">96%</span></td>
<td id="S5.T2.5.5.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.5.5.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFE0E0;">100%</span></td></tr>
