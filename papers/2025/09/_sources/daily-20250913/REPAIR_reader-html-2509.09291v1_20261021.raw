<td id="S5.T4.7.12.7" class="ltx_td ltx_nopad_l ltx_align_center" style="padding-left:1.4pt;padding-right:1.4pt;" colspan="3"><span id="S5.T4.7.12.7.1" class="ltx_text" style="font-size:70%;">1.00%</span></td>
