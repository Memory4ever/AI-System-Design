<td id="S5.T5.7.4.6" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFBFBF;padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T5.7.4.6.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#FFBFBF;">33.33</span></td></tr>
<tr id="S5.T5.7.5" class="ltx_tr">
<td id="S5.T5.7.5.1" class="ltx_td ltx_align_left" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T5.7.5.1.1" class="ltx_text" style="font-size:70%;">Business</span></td>
<td id="S5.T5.7.5.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFBFBF;padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T5.7.5.2.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#FFBFBF;">4.03</span></td>
