{"data":{"id":"10.48550/arxiv.2509.10397","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10397","prefix":"10.48550","suffix":"arxiv.2509.10397","identifiers":[{"identifier":"2509.10397","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.10397"}],"creators":[{"name":"Liu, Fei","nameType":"Personal","givenName":"Fei","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Xinyu","nameType":"Personal","givenName":"Xinyu","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Hanchao","nameType":"Personal","givenName":"Hanchao","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Mingyuan","nameType":"Personal","givenName":"Mingyuan","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Jianyu","nameType":"Personal","givenName":"Jianyu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Qiang","nameType":"Personal","givenName":"Qiang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Zhuokai","nameType":"Personal","givenName":"Zhuokai","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Xia, Yinglong","nameType":"Personal","givenName":"Yinglong","familyName":"Xia","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yao","nameType":"Personal","givenName":"Yao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Weiwei","nameType":"Personal","givenName":"Weiwei","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Mingze","nameType":"Personal","givenName":"Mingze","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Qifan","nameType":"Personal","givenName":"Qifan","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Lizhu","nameType":"Personal","givenName":"Lizhu","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Benyu","nameType":"Personal","givenName":"Benyu","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Xiangjun","nameType":"Personal","givenName":"Xiangjun","familyName":"Fan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RecoWorld: Building Simulated Environments for Agentic Recommender Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Information Retrieval (cs.IR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T16:44:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-15T00:44:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-06T01:43:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-09T01:13:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-25T20:09:07Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-28T00:37:26Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We present RecoWorld, a blueprint for building simulated environments tailored to agentic recommender systems. Such environments give agents a proper training space where they can learn from errors without impacting real users. RecoWorld distinguishes itself with a dual-view architecture: a simulated user and an agentic recommender engage in multi-turn interactions aimed at maximizing user retention. The user simulator reviews recommended items, updates its mindset, and when sensing potential user disengagement, generates reflective instructions. The agentic recommender adapts its recommendations by incorporating these user instructions and reasoning traces, creating a dynamic feedback loop that actively engages users. This process leverages the exceptional reasoning capabilities of modern LLMs. We explore diverse content representations within the simulator, including text-based, multimodal, and semantic ID modeling, and discuss how multi-turn RL enables the recommender to refine its strategies through iterative interactions. RecoWorld also supports multi-agent simulations, allowing creators to simulate the responses of targeted user populations. It marks an important first step toward recommender systems where users and agents collaboratively shape personalized information streams. We envision new interaction paradigms where \"user instructs, recommender responds,\" jointly optimizing user retention and engagement.","descriptionType":"Abstract"},{"description":"HCRS @ WWW 2026, Best Paper Award","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.10397","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-15T01:34:02.000Z","registered":"2025-09-15T01:34:02.000Z","published":"2025","updated":"2026-07-28T03:47:52.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.10397","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}