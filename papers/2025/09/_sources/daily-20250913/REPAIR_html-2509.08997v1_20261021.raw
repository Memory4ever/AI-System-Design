<td id="S4.T2.2.1.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T2.2.1.2.1.1.1.1.1" class="ltx_text ltx_font_bold">OUTPUT FORMAT:</span></td></tr>
<tr id="S4.T2.2.1.2.1.1.2" class="ltx_tr">
