</table></td></tr>
<tr id="S4.T2.2.1.2" class="ltx_tr">
<td id="S4.T2.2.1.2.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_t">
<table id="S4.T2.2.1.2.1.1" class="ltx_tabular ltx_align_middle">
