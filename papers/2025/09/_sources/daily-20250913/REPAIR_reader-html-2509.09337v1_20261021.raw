<td id="Sx4.T1.5.1.16.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="Sx4.T1.5.1.16.3.1" class="ltx_text ltx_font_bold">92.7 <math id="Sx4.T1.m116" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.5</span></td>
