<th id="Sx4.T1.5.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">Methods</th>
<th id="Sx4.T1.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="Sx4.T1.5.1.1.3.1" class="ltx_text ltx_font_bold">MUTAG</span></th>
<th id="Sx4.T1.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="Sx4.T1.5.1.1.4.1" class="ltx_text ltx_font_bold">D&amp;D</span></th>
<th id="Sx4.T1.5.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="Sx4.T1.5.1.1.5.1" class="ltx_text ltx_font_bold">NCI1</span></th>
<th id="Sx4.T1.5.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="Sx4.T1.5.1.1.6.1" class="ltx_text ltx_font_bold">PROTEINS</span></th>
<th id="Sx4.T1.5.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="Sx4.T1.5.1.1.7.1" class="ltx_text ltx_font_bold">ENZYMES</span></th>
<th id="Sx4.T1.5.1.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="Sx4.T1.5.1.1.8.1" class="ltx_text ltx_font_bold">IMDB-BINARY</span></th>
<th id="Sx4.T1.5.1.1.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="Sx4.T1.5.1.1.9.1" class="ltx_text ltx_font_bold">IMDB-MULTI</span></th>
<th id="Sx4.T1.5.1.1.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="Sx4.T1.5.1.1.10.1" class="ltx_text ltx_font_bold">REDDIT-BINARY</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="Sx4.T1.5.1.2" class="ltx_tr">
<th id="Sx4.T1.5.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;" rowspan="3">
<span id="Sx4.T1.5.1.2.1.1" class="ltx_inline-block ltx_parbox ltx_align_top" style="width:4.0pt;">
<span id="Sx4.T1.5.1.2.1.1.1" class="ltx_p">
<span id="Sx4.T1.5.1.2.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.8pt;height:15.6pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:15.6pt;transform:translate(-4.4pt,-4.4pt) rotate(-90deg) ;">
<span id="Sx4.T1.5.1.2.1.1.1.1.1" class="ltx_p">GK</span>
</span></span></span>
</span></th>
<th id="Sx4.T1.5.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">GL</th>
<td id="Sx4.T1.5.1.2.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">80.8 <math id="Sx4.T1.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 6.4</td>
