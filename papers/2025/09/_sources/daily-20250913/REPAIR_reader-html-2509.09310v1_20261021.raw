<td id="S4.T1.3.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Direct Fusion</td>
<td id="S4.T1.3.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">83.2</td>
