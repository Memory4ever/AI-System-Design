              <span id="alg1.l7.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l7.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
              <span id="alg1.l8.3" class="ltx_text ltx_font_bold">for</span> each agent <math id="alg1.l8.m1" class="ltx_Math" alttext="\chi_{i}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\chi_{i}</annotation></semantics></math> except ego <span id="alg1.l8.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
               <math id="alg1.l9.m1" class="ltx_Math" alttext="\mathbf{L_{i}},\mathcal{H}_{i}\leftarrow\mathcal{D}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐋</mi><mi>𝐢</mi></msub><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub><mo stretchy="false">←</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{L_{i}},\mathcal{H}_{i}\leftarrow\mathcal{D}_{i}</annotation></semantics></math>

</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
               <math id="alg1.l10.m1" class="ltx_Math" alttext="\mathbf{P_{i}}=head_{ego}(fuse_{ego}(\mathcal{H}_{i}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐏</mi><mi>𝐢</mi></msub><mo>=</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{P_{i}}=head_{ego}(fuse_{ego}(\mathcal{H}_{i}))</annotation></semantics></math>

</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
               <math id="alg1.l11.m1" class="ltx_Math" alttext="\Phi_{i\to ego}\leftarrow\mathop{\nabla}Loss(\mathbf{L_{i}},\mathbf{P_{i}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mrow><mi>i</mi><mo stretchy="false">→</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow></msub><mo stretchy="false">←</mo><mrow><mo rspace="0.167em">∇</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐋</mi><mi>𝐢</mi></msub><mo>,</mo><msub><mi>𝐏</mi><mi>𝐢</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi_{i\to ego}\leftarrow\mathop{\nabla}Loss(\mathbf{L_{i}},\mathbf{P_{i}})</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <span id="alg1.l12.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              <span id="alg1.l13.3" class="ltx_text ltx_font_bold">Output: </span> <math id="alg1.l13.m1" class="ltx_Math" alttext="\Phi_{i\to ego}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mrow><mi>i</mi><mo stretchy="false">→</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow></msub><annotation encoding="application/x-tex">\Phi_{i\to ego}</annotation></semantics></math> <span id="alg1.l13.4" class="ltx_text" style="float:right;"><math id="alg1.l13.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> feature adapters from agents to ego
</span>
</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
            <span id="alg1.l14.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l14.4" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
<div id="S3.SS4.p3" class="ltx_para">
<p id="S3.SS4.p3.1" class="ltx_p">Our model optimization strategy builds upon a two-stage fine-tuning approach (TFA)<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">28</a>]</cite>due to its simplicity and efficiency. We introduce further enhancements to improve its adaptability within our collaborative perception framework. Considering that the detectors of ego and agent have already been trained separately before the collaboration begins, we only need to focus on the second fine-tuning stage. In the second stage, we fix all the parameters of the fusion network and the detector head and only fine-tune the adapters. This is because the ego needs to use the same fusion network and detector head for different agents. When collaborating with multiple agents simultaneously, fine-tuning the model on multiple datasets may introduce mutual interference, reducing its adaptability to each agent and degrading overall performance. However, the adapter is created independently by the ego for each agent, and by only adjusting the adapter, isolation can be achieved, and interference can be reduced. In the fine-tuning process, we adopt a scheduler with a warm-up mechanism. We select one scenario for hyperparameter tuning, while the remaining scenarios are for testing. We train a total of 20 rounds, and due to the small training data size, the overall computational overhead is very low.</p>
</div>
<div id="S3.SS4.p4" class="ltx_para">
<p id="S3.SS4.p4.1" class="ltx_p"><span id="S3.SS4.p4.1.1" class="ltx_text ltx_font_bold">Stage II.</span> This stage follows immediately after the first stage. We consider the features shared by agents as the query set <math id="S3.SS4.p4.m1" class="ltx_math_unparsed" alttext="\mathcal{Q}_{i}=\{d_{k+1},\dots,d_{N}\mid d\in\mathcal{S}_{i}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>d</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>N</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>d</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Q}_{i}=\{d_{k+1},\dots,d_{N}\mid d\in\mathcal{S}_{i}\}</annotation></semantics></math>. We believe that after the training in the first stage, the adapter can effectively address the domain gap problem. Subsequently, the transformed features <math id="S3.SS4.p4.m2" class="ltx_Math" alttext="\mathcal{Q}_{i}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>i</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\mathcal{Q}_{i}^{\prime}</annotation></semantics></math> and the features from the ego’s encoder can be fused to obtain the final detection results.</p>
</div>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> <span id="alg2.5" class="ltx_text ltx_font_bold">Stage II: Inference</span></figcaption>
<div id="alg2.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg2.l1.3" class="ltx_text ltx_font_bold">for</span> each scenario <span id="alg2.l1.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
              <span id="alg2.l2.3" class="ltx_text ltx_font_bold">Input: </span> <math id="alg2.l2.m1" class="ltx_Math" alttext="\{F_{i}\},\mathbf{F}_{i}={d_{k+1},...d_{N}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>F</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><msub><mi>𝐅</mi><mi>i</mi></msub><mo>=</mo><msub><mi>d</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>N</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\{F_{i}\},\mathbf{F}_{i}={d_{k+1},...d_{N}}</annotation></semantics></math> <span id="alg2.l2.4" class="ltx_text" style="float:right;"><math id="alg2.l2.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> shared feature from each agent
</span>
</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
              <span id="alg2.l3.3" class="ltx_text ltx_font_bold">for</span> each agent <math id="alg2.l3.m1" class="ltx_Math" alttext="\chi_{i}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\chi_{i}</annotation></semantics></math> except ego <span id="alg2.l3.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
               <math id="alg2.l4.m1" class="ltx_Math" alttext="F_{i}^{\prime}=\Phi_{i\to ego}(F_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>F</mi><mi>i</mi><mo>′</mo></msubsup><mo>=</mo><mrow><msub><mi mathvariant="normal">Φ</mi><mrow><mi>i</mi><mo stretchy="false">→</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{i}^{\prime}=\Phi_{i\to ego}(F_{i})</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
               <math id="alg2.l5.m1" class="ltx_Math" alttext="\mathcal{F}_{i}=\mathcal{F}_{i}\cup F_{i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo>∪</mo><msubsup><mi>F</mi><mi>i</mi><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{i}=\mathcal{F}_{i}\cup F_{i}^{\prime}</annotation></semantics></math>

</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              <span id="alg2.l6.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l6.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <math id="alg2.l7.m1" class="ltx_Math" alttext="\mathbf{P_{ego}}=head_{ego}(fuse_{ego}(\mathcal{F}_{i}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐏</mi><mi>𝐞𝐠𝐨</mi></msub><mo>=</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{P_{ego}}=head_{ego}(fuse_{ego}(\mathcal{F}_{i}))</annotation></semantics></math>

</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
              <span id="alg2.l8.3" class="ltx_text ltx_font_bold">Output: </span> <math id="alg2.l8.m1" class="ltx_Math" alttext="\mathbf{P_{ego}}" display="inline" intent=":literal"><semantics><msub><mi>𝐏</mi><mi>𝐞𝐠𝐨</mi></msub><annotation encoding="application/x-tex">\mathbf{P_{ego}}</annotation></semantics></math> <span id="alg2.l8.4" class="ltx_text" style="float:right;"><math id="alg2.l8.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> ego final prediction
</span>
</div>
<div id="alg2.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            <span id="alg2.l9.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l9.4" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
<div id="S3.SS4.p5" class="ltx_para">
<p id="S3.SS4.p5.1" class="ltx_p">We use the average AP value of all scenarios as the final evaluation metric, referred to as mean scenario AP (mSAP). This is because we observe significant differences in the data distribution among different scenarios. In Fig.<a href="#S3.F5.sf1" title="Figure 5(a) ‣ Figure 5 ‣ 3.4 PHCP Process ‣ 3 Method ‣ You Share Beliefs, I Adapt: Progressive Heterogeneous Collaborative Perception" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5(a)</span></a>, most of the objects are concentrated on one side of the ego vehicle, and even without receiving information from other agents, the final detection results are not affected. However, in Fig.<a href="#S3.F5.sf2" title="Figure 5(b) ‣ Figure 5 ‣ 3.4 PHCP Process ‣ 3 Method ‣ You Share Beliefs, I Adapt: Progressive Heterogeneous Collaborative Perception" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5(b)</span></a>, the objects are mainly distributed on the side of agent vehicles. If the ego vehicle cannot effectively utilize the feature information from agents, it may result in many false negatives. Therefore, mSAP, as a comprehensive performance evaluation metric, can more fairly measure the detection capability of the model in different scenarios.</p>
</div>
<figure id="S3.F5" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F5.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.09310v1/large_overlap.png" id="S3.F5.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:685/517;" width="685" height="517" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F5.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S3.F5.sf1.4" class="ltx_text" style="font-size:90%;">broad shared field of view</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F5.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.09310v1/less_overlap.png" id="S3.F5.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:685/508;" width="685" height="508" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F5.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S3.F5.sf2.4" class="ltx_text" style="font-size:90%;">narrow shared field of view</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F5.3" class="ltx_text" style="font-size:90%;">Figure 5</span>: </span><span id="S3.F5.4" class="ltx_text" style="font-size:90%;">Detection performance under different ego vehicle field of view conditions</span></figcaption>
</figure>
</section>
</section>
