<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F4.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S3.F4.sf3.4" class="ltx_text" style="font-size:90%;">PointPillar feature map, c=29</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
