<tr id="S3.T4.6.7" class="ltx_tr">
<td id="S3.T4.6.7.1" class="ltx_td ltx_align_left" style="padding:0.45pt 3.0pt;"><span id="S3.T4.6.7.1.1" class="ltx_text" style="font-size:90%;">Reefknot</span></td>
<td id="S3.T4.6.7.2" class="ltx_td ltx_align_center" style="padding:0.45pt 3.0pt;"><span id="S3.T4.6.7.2.1" class="ltx_text" style="font-size:90%;">ACL’25</span></td>
<td id="S3.T4.6.7.3" class="ltx_td ltx_align_center" style="padding:0.45pt 3.0pt;"><math id="S3.T4.m4" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math><span id="S3.T4.6.7.3.1" class="ltx_text" style="font-size:90%;">17k</span></td>
<td id="S3.T4.6.7.4" class="ltx_td ltx_align_center" style="padding:0.45pt 3.0pt;"><span id="S3.T4.6.7.4.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#CB4154;">✗</span></td>
