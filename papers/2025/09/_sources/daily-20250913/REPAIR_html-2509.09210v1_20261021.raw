<td id="S4.T1.5.7.5" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T1.5.7.5.1" class="ltx_text ltx_font_bold">0.0000</span></td>
<td id="S4.T1.5.7.6" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:10.0pt;padding-right:10.0pt;">0.0136</td>
