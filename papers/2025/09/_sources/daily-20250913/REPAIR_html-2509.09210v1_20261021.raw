<td id="S4.T1.5.14.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T1.5.14.4.1" class="ltx_text ltx_font_bold">0.1538</span></td>
