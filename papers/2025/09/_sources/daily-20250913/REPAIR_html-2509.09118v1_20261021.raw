<td id="S5.T4.2.1.8.9" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;"><span id="S5.T4.2.1.8.9.1" class="ltx_text ltx_underline">52.30</span></td>
<td id="S5.T4.2.1.8.10" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;"><span id="S5.T4.2.1.8.10.1" class="ltx_text ltx_underline">39.61</span></td></tr>
<tr id="S5.T4.2.1.9" class="ltx_tr">
<th id="S5.T4.2.1.9.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb" style="padding:1pt 4.0pt;">
<div id="S5.T4.2.1.9.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.4pt;height:6.8pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-499.3pt,536.6pt) scale(0.00632711751977807,0.00632711751977807) ;"><span class="ltx_inline-block"><svg id="S5.T4.pic14" class="ltx_picture" height="1494.4" overflow="visible" version="1.1" viewBox="0 0 1385.92 1494.4" width="1385.92"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" fill-rule="nonzero" stroke="#000000" stroke-width="1.6pt" transform="translate(0,1494.4) matrix(1 0 0 -1 0 0) translate(-359.77,0) translate(0,1991.45)"><path d="M 1744.58 -1923.9 C 1744.58 -1942.35 1737.56 -1958.22 1723.54 -1971.5 C 1710.26 -1984.05 1694.39 -1990.32 1675.94 -1990.32 C 1657.49 -1990.32 1640.52 -1981.83 1625.02 -1964.86 C 1587.39 -1914.68 1531.3 -1841.25 1456.76 -1744.58 C 1302.53 -1546.06 1149.4 -1369.68 997.37 -1215.45 C 821.74 -1391.82 691.85 -1553.44 607.72 -1700.3 C 586.32 -1746.05 553.48 -1814.68 509.2 -1906.19 C 495.18 -1933.5 475.26 -1947.15 449.43 -1947.15 C 404.41 -1947.15 381.9 -1925.38 381.9 -1881.84 C 381.9 -1872.98 383.38 -1864.5 386.33 -1856.38 C 471.94 -1624.65 643.88 -1379.65 902.18 -1121.35 C 820.26 -1041.65 697.76 -922.47 534.66 -763.81 C 499.24 -731.33 447.95 -680.78 380.8 -612.15 C 367.51 -597.39 360.87 -581.89 360.87 -565.66 C 360.87 -547.95 367.51 -532.45 380.8 -519.17 C 394.82 -505.14 410.68 -498.13 428.4 -498.13 C 444.63 -498.13 460.13 -504.78 474.89 -518.06 C 522.12 -564.55 592.59 -634.29 686.32 -727.28 C 755.69 -793.69 859.37 -894.06 997.37 -1028.37 C 1071.91 -958.26 1182.98 -852.36 1330.57 -710.67 C 1365.26 -672.3 1418.76 -616.21 1491.08 -542.41 C 1505.84 -528.39 1521.71 -521.38 1538.68 -521.38 C 1583.7 -521.38 1606.21 -543.52 1606.21 -587.8 C 1606.21 -602.56 1600.67 -616.95 1589.6 -630.97 C 1569.68 -656.8 1515.43 -713.25 1426.88 -800.34 C 1352.34 -871.18 1240.91 -978.19 1092.57 -1121.35 C 1185.56 -1215.82 1306.96 -1350.87 145