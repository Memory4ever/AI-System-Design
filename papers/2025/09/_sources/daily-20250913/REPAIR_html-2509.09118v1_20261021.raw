<td id="A1.T5.2.1.5.2" class="ltx_td ltx_align_center"><math id="A1.T5.m6" class="ltx_Math" alttext="0.9" display="inline" intent=":literal"><semantics><mn>0.9</mn><annotation encoding="application/x-tex">0.9</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.1.6" class="ltx_tr">
<th id="A1.T5.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Adam <math id="A1.T5.m7" class="ltx_Math" alttext="\beta_{2}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\beta_{2}</annotation></semantics></math></th>
<td id="A1.T5.2.1.6.2" class="ltx_td ltx_align_center"><math id="A1.T5.m8" class="ltx_Math" alttext="0.999" display="inline" intent=":literal"><semantics><mn>0.999</mn><annotation encoding="application/x-tex">0.999</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.1.7" class="ltx_tr">
