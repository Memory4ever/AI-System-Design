<div id="A1.T5.2" class="ltx_inline-block ltx_transformed_outer" style="width:276.0pt;height:212.1pt;vertical-align:-102.9pt;"><span class="ltx_transformed_inner" style="transform:translate(27.9pt,-21.5pt) scale(1.25359868940479,1.25359868940479) ;">
