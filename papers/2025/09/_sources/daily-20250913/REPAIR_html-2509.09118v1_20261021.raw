<td id="A1.T5.2.1.7.2" class="ltx_td ltx_align_center"><math id="A1.T5.m10" class="ltx_Math" alttext="10^{-3}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><annotation encoding="application/x-tex">10^{-3}</annotation></semantics></math></td></tr>
