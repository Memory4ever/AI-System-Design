<td id="A1.T5.2.1.3.2" class="ltx_td ltx_align_center"><math id="A1.T5.m3" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn>0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math></td></tr>
