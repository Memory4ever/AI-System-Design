<th id="A1.T5.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Weight decay</th>
<td id="A1.T5.2.1.9.2" class="ltx_td ltx_align_center"><math id="A1.T5.m11" class="ltx_Math" alttext="4\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">4\times 10^{-5}</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.1.10" class="ltx_tr">
<th id="A1.T5.2.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Batch size</th>
<td id="A1.T5.2.1.10.2" class="ltx_td ltx_align_center"><math id="A1.T5.m12" class="ltx_Math" alttext="512" display="inline" intent=":literal"><semantics><mn>512</mn><annotation encoding="application/x-tex">512</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.1.11" class="ltx_tr">
<th id="A1.T5.2.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Learning rate</th>
<td id="A1.T5.2.1.11.2" class="ltx_td ltx_align_center"><math id="A1.T5.m13" class="ltx_Math" alttext="10^{-4}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><annotation encoding="application/x-tex">10^{-4}</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.1.12" class="ltx_tr">
<th id="A1.T5.2.1.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Learning rate scheduler</th>
<td id="A1.T5.2.1.12.2" class="ltx_td ltx_align_center">CosineAnnealingLR</td></tr>
<tr id="A1.T5.2.1.13" class="ltx_tr">
<th id="A1.T5.2.1.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Training epochs</th>
<td id="A1.T5.2.1.13.2" class="ltx_td ltx_align_center"><math id="A1.T5.m14" class="ltx_Math" alttext="30" display="inline" intent=":literal"><semantics><mn>30</mn><annotation encoding="application/x-tex">30</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.1.14" class="ltx_tr">
<th id="A1.T5.2.1.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r">GPU</th>
