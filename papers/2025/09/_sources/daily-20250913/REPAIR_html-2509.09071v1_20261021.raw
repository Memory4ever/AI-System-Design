            <span id="alg1.l7.3" class="ltx_text ltx_font_bold">for all</span> <math id="alg1.l7.m1" class="ltx_Math" alttext="i\in\mathbf{I}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>𝐈</mi></mrow><annotation encoding="application/x-tex">i\in\mathbf{I}</annotation></semantics></math> <span id="alg1.l7.4" class="ltx_text ltx_font_bold">do</span>

