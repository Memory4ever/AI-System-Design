            <span id="alg1.l9.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l9.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            <math id="alg1.l10.m1" class="ltx_Math" alttext="possible\_trades\leftarrow\texttt{true}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">true</mtext></mrow><annotation encoding="application/x-tex">possible\_trades\leftarrow\texttt{true}</annotation></semantics></math>

</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
            <span id="alg1.l11.3" class="ltx_text ltx_font_bold">while</span> <math id="alg1.l11.m1" class="ltx_Math" alttext="possible\_trades" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">possible\_trades</annotation></semantics></math> <span id="alg1.l11.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <math id="alg1.l12.m1" class="ltx_Math" alttext="trades\_found\leftarrow\texttt{false}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">false</mtext></mrow><annotation encoding="application/x-tex">trades\_found\leftarrow\texttt{false}</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              <math id="alg1.l13.m1" class="ltx_Math" alttext="I_{\text{shuffled}}\leftarrow\text{RandomShuffle}(\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mtext>shuffled</mtext></msub><mo stretchy="false">←</mo><mrow><mtext>RandomShuffle</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{\text{shuffled}}\leftarrow\text{RandomShuffle}(\mathbf{I})</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
              <span id="alg1.l14.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l14.m1" class="ltx_Math" alttext="k=1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k=1</annotation></semantics></math> <span id="alg1.l14.4" class="ltx_text ltx_font_bold">to</span> <math id="alg1.l14.m2" class="ltx_Math" alttext="|\mathbf{I_{\text{shuffled}}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>𝐈</mi><mtext>shuffled</mtext></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathbf{I_{\text{shuffled}}}|</annotation></semantics></math> <span id="alg1.l14.5" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
               <span id="alg1.l15.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l15.m1" class="ltx_Math" alttext="l=k+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l=k+1</annotation></semantics></math> <span id="alg1.l15.4" class="ltx_text ltx_font_bold">to</span> <math id="alg1.l15.m2" class="ltx_Math" alttext="|\mathbf{I_{\text{shuffled}}}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>𝐈</mi><mtext>shuffled</mtext></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathbf{I_{\text{shuffled}}}|</annotation></semantics></math> <span id="alg1.l15.5" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
                 <math id="alg1.l16.m1" class="ltx_Math" alttext="(i,j)\leftarrow(I_{\text{shuffled}}[k],I_{\text{shuffled}}[l])" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mtext>shuffled</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>I</mi><mtext>shuffled</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>l</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(i,j)\leftarrow(I_{\text{shuffled}}[k],I_{\text{shuffled}}[l])</annotation></semantics></math>

</div>
<div id="alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
                 
<span id="alg1.l17.3" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:345.0pt;">
<span id="alg1.l17.3.1" class="ltx_p"><math id="alg1.l17.m1" class="ltx_Math" alttext="(\mathbf{A^{*}_{ij}},\,\textit{outcome},\,r)\leftarrow\textsc{SolveA}^{*}\Bigl(i,\;j,\;\mathbf{G},\;\{a_{ig},a_{jg}\}_{g\in\mathbf{G}},\;B_{i},\;B_{j}\Bigr)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐀</mi><mi>𝐢𝐣</mi><mo>∗</mo></msubsup><mo>,</mo><mtext class="ltx_mathvariant_italic">outcome</mtext><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><msup><mtext class="ltx_font_smallcaps">SolveA</mtext><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>𝐆</mi><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi>g</mi><mo>∈</mo><mi>𝐆</mi></mrow></msub><mo>,</mo><msub><mi>B</mi><mi>i</mi></msub><mo>,</mo><msub><mi>B</mi><mi>j</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{A^{*}_{ij}},\,\textit{outcome},\,r)\leftarrow\textsc{SolveA}^{*}\Bigl(i,\;j,\;\mathbf{G},\;\{a_{ig},a_{jg}\}_{g\in\mathbf{G}},\;B_{i},\;B_{j}\Bigr)</annotation></semantics></math></span>
</span>
<span id="alg1.l17.4" class="ltx_text" style="float:right;"><math id="alg1.l17.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Proposer <math id="alg1.l17.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> finds best trade; <math id="alg1.l17.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> is the responding agent (who accepts/rejects)
</span>
</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
                 <span id="alg1.l18.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l18.m1" class="ltx_Math" alttext="\textit{outcome}=\textsc{accept}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">outcome</mtext><mo>=</mo><mtext class="ltx_font_smallcaps">accept</mtext></mrow><annotation encoding="application/x-tex">\textit{outcome}=\textsc{accept}</annotation></semantics></math> <span id="alg1.l18.4" class="ltx_text ltx_font_bold">then</span>
<span id="alg1.l18.5" class="ltx_text" style="float:right;"><math id="alg1.l18.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Trade executed
</span>
</div>
<div id="alg1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
                  <math id="alg1.l19.m1" class="ltx_Math" alttext="\{a_{ig},\,a_{jg}\}_{g\in\mathbf{G}}\leftarrow\mathbf{A^{*}_{ij}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub><mo rspace="0.337em">,</mo><msub><mi>a</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi>g</mi><mo>∈</mo><mi>𝐆</mi></mrow></msub><mo stretchy="false">←</mo><msubsup><mi>𝐀</mi><mi>𝐢𝐣</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\{a_{ig},\,a_{jg}\}_{g\in\mathbf{G}}\leftarrow\mathbf{A^{*}_{ij}}</annotation></semantics></math>

</div>
<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
                  <math id="alg1.l20.m1" class="ltx_Math" alttext="trades\_found\leftarrow\texttt{true}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">true</mtext></mrow><annotation encoding="application/x-tex">trades\_found\leftarrow\texttt{true}</annotation></semantics></math>

</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
                 <span id="alg1.l21.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l21.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
                 <math id="alg1.l22.m1" class="ltx_Math" alttext="\textsc{BayesianUpdate}\bigl(i,\,j,\,r,\,\textit{outcome},\,B_{i},\,B_{j},\,\{B_{k}\}_{k\neq i,j}\bigr)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">BayesianUpdate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>r</mi><mo>,</mo><mtext class="ltx_mathvariant_italic">outcome</mtext><mo>,</mo><msub><mi>B</mi><mi>i</mi></msub><mo>,</mo><msub><mi>B</mi><mi>j</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>B</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mrow><mi>k</mi><mo>≠</mo><mi>i</mi></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{BayesianUpdate}\bigl(i,\,j,\,r,\,\textit{outcome},\,B_{i},\,B_{j},\,\{B_{k}\}_{k\neq i,j}\bigr)</annotation></semantics></math>
<span id="alg1.l22.3" class="ltx_text" style="float:right;"><math id="alg1.l22.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> All players update beliefs based on accept/reject
</span>
</div>
<div id="alg1.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
              
              
               <span id="alg1.l23.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l23.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              
              <span id="alg1.l24.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l24.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
              
              
              <math id="alg1.l25.m1" class="ltx_Math" alttext="possible\_trades\leftarrow trades\_found" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">←</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">possible\_trades\leftarrow trades\_found</annotation></semantics></math>

</div>
<div id="alg1.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l26.1" class="ltx_text" style="font-size:80%;">26:</span></span>
              
              
            <span id="alg1.l26.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l26.4" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg1.l27" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l27.1" class="ltx_text" style="font-size:80%;">27:</span></span>
              
              
            <span id="alg1.l27.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l27.m1" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math>

</div>
</div>
</figure>
<div id="A1.SS3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.p1.1" class="ltx_p"><span id="A1.SS3.p1.1.1" class="ltx_text ltx_font_bold">Explanation of key subroutines:</span></p>
<ul id="A1.I2" class="ltx_itemize">
<li id="A1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i1.p1" class="ltx_para">
<p id="A1.I2.i1.p1.1" class="ltx_p"><math id="A1.I2.i1.p1.m1" class="ltx_Math" alttext="\textsc{SolveA}^{*}(i,j,\dots)" display="inline" intent=":literal"><semantics><mrow><msup><mtext class="ltx_font_smallcaps">SolveA</mtext><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{SolveA}^{*}(i,j,\dots)</annotation></semantics></math>:</p>
<ul id="A1.I2.i1.I1" class="ltx_itemize">
<li id="A1.I2.i1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A1.I2.i1.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A1.I2.i1.I1.i1.p1" class="ltx_para">
<p id="A1.I2.i1.I1.i1.p1.1" class="ltx_p"><span id="A1.I2.i1.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Proposer’s optimization.</span>
Agent <math id="A1.I2.i1.I1.i1.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> (the proposer) solves</p>
<table id="A1.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\max_{(\mathbf{x},\mathbf{y})}\sum_{\mathbf{v}_{-i}}\mathbf{1}\Bigl\{\exists\,\text{receiver }r\neq i:\textsc{accept}\bigl(v_{r};\mathbf{x},\mathbf{y}\bigr)\Bigr\}\times\Bigl(u_{i}\bigl(h_{i}-\mathbf{x}+\mathbf{y}\bigr)-u_{i}\bigl(h_{i}\bigr)\Bigr)\times B_{i}(\mathbf{v}_{-i})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mmultiscripts><munder><mo movablelimits="false">∑</mo><msub><mi>𝐯</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub></munder><mprescripts></mprescripts><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><mrow></mrow></mmultiscripts><mo>⁡</mo><mn>𝟏</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo rspace="0.337em">∃</mo><mrow><mtext>receiver </mtext><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo>≠</mo><mi>i</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mtext class="ltx_font_smallcaps">accept</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>v</mi><mi>r</mi></msub><mo>,</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">}</mo></mrow></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>−</mo><mi>𝐱</mi></mrow><mo>+</mo><mi>𝐲</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>h</mi><mi>i</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><msub><mi>B</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\max_{(\mathbf{x},\mathbf{y})}\sum_{\mathbf{v}_{-i}}\mathbf{1}\Bigl\{\exists\,\text{receiver }r\neq i:\textsc{accept}\bigl(v_{r};\mathbf{x},\mathbf{y}\bigr)\Bigr\}\times\Bigl(u_{i}\bigl(h_{i}-\mathbf{x}+\mathbf{y}\bigr)-u_{i}\bigl(h_{i}\bigr)\Bigr)\times B_{i}(\mathbf{v}_{-i}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I2.i1.I1.i1.p1.2" class="ltx_p">where <math id="A1.I2.i1.I1.i1.p1.m2" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> are the chips given up by <math id="A1.I2.i1.I1.i1.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="A1.I2.i1.I1.i1.p1.m4" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math> are the chips requested, <math id="A1.I2.i1.I1.i1.p1.m5" class="ltx_Math" alttext="h_{i}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>i</mi></msub><annotation encoding="application/x-tex">h_{i}</annotation></semantics></math> denotes <math id="A1.I2.i1.I1.i1.p1.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s current holdings, and <math id="A1.I2.i1.I1.i1.p1.m7" class="ltx_Math" alttext="B_{i}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>i</mi></msub><annotation encoding="application/x-tex">B_{i}</annotation></semantics></math> is <math id="A1.I2.i1.I1.i1.p1.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s belief over others’ valuations.</p>
</div></li>
<li id="A1.I2.i1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A1.I2.i1.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A1.I2.i1.I1.i2.p1" class="ltx_para">
<p id="A1.I2.i1.I1.i2.p1.1" class="ltx_p"><span id="A1.I2.i1.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Receiver’s acceptance criterion.</span>
A potential responder <math id="A1.I2.i1.I1.i2.p1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> accepts the trade <math id="A1.I2.i1.I1.i2.p1.m2" class="ltx_Math" alttext="(\mathbf{x},\mathbf{y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{x},\mathbf{y})</annotation></semantics></math> <em id="A1.I2.i1.I1.i2.p1.1.2" class="ltx_emph ltx_font_italic">myopically</em> if</p>
<table id="A1.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex8.m1" class="ltx_Math" alttext="u_{r}\bigl(h_{r}-\mathbf{y}+\mathbf{x};\,v_{r}\bigr)\;&gt;\;u_{r}\bigl(h_{r};\,v_{r}\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>u</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>h</mi><mi>r</mi></msub><mo>−</mo><mi>𝐲</mi></mrow><mo>+</mo><mi>𝐱</mi></mrow><mo>,</mo><msub><mi>v</mi><mi>r</mi></msub><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.558em">&gt;</mo><mrow><msub><mi>u</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>h</mi><mi>r</mi></msub><mo>,</mo><msub><mi>v</mi><mi>r</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u_{r}\bigl(h_{r}-\mathbf{y}+\mathbf{x};\,v_{r}\bigr)\;&gt;\;u_{r}\bigl(h_{r};\,v_{r}\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I2.i1.I1.i2.p1.2" class="ltx_p">The subroutine returns <math id="A1.I2.i1.I1.i2.p1.m3" class="ltx_Math" alttext="\mathbf{A^{*}_{ij}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐀</mi><mi>𝐢𝐣</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\mathbf{A^{*}_{ij}}</annotation></semantics></math> (the updated allocation for <math id="A1.I2.i1.I1.i2.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="A1.I2.i1.I1.i2.p1.m5" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>), the <span id="A1.I2.i1.I1.i2.p1.2.1" class="ltx_text ltx_markedasmath ltx_font_italic">outcome</span> (<span id="A1.I2.i1.I1.i2.p1.2.2" class="ltx_text ltx_font_smallcaps">accept</span> or <span id="A1.I2.i1.I1.i2.p1.2.3" class="ltx_text ltx_font_smallcaps">reject</span>), and the identity of the actual <em id="A1.I2.i1.I1.i2.p1.2.4" class="ltx_emph ltx_font_italic">responder</em> <math id="A1.I2.i1.I1.i2.p1.m7" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> (in case multiple receivers are considered, or if <math id="A1.I2.i1.I1.i2.p1.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is always the designated responder, <math id="A1.I2.i1.I1.i2.p1.m9" class="ltx_Math" alttext="r=j" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">r=j</annotation></semantics></math>).</p>
</div></li>
</ul>
</div></li>
<li id="A1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i2.p1" class="ltx_para">
<p id="A1.I2.i2.p1.1" class="ltx_p"><math id="A1.I2.i2.p1.m1" class="ltx_Math" alttext="\textsc{BayesianUpdate}\bigl(i,j,r,\textit{outcome},B_{i},B_{j},\{B_{k}\}_{k\neq i,j}\bigr)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">BayesianUpdate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>r</mi><mo>,</mo><mtext class="ltx_mathvariant_italic">outcome</mtext><mo>,</mo><msub><mi>B</mi><mi>i</mi></msub><mo>,</mo><msub><mi>B</mi><mi>j</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>B</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mrow><mi>k</mi><mo>≠</mo><mi>i</mi></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{BayesianUpdate}\bigl(i,j,r,\textit{outcome},B_{i},B_{j},\{B_{k}\}_{k\neq i,j}\bigr)</annotation></semantics></math>:</p>
<ul id="A1.I2.i2.I1" class="ltx_itemize">
<li id="A1.I2.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A1.I2.i2.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A1.I2.i2.I1.i1.p1" class="ltx_para">
<p id="A1.I2.i2.I1.i1.p1.1" class="ltx_p">On <span id="A1.I2.i2.I1.i1.p1.1.1" class="ltx_text ltx_font_smallcaps">acceptance</span>:
All agents discard any valuation states inconsistent with <math id="A1.I2.i2.I1.i1.p1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> accepting <math id="A1.I2.i2.I1.i1.p1.m2" class="ltx_Math" alttext="(\mathbf{x},\mathbf{y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{x},\mathbf{y})</annotation></semantics></math>.
Specifically,</p>
<table id="A1.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex9.m1" class="ltx_Math" alttext="v_{r}\text{ is retained only if }u_{r}(h_{r}-\mathbf{y}+\mathbf{x};v_{r})&gt;u_{r}(h_{r};v_{r})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>v</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> is retained only if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>h</mi><mi>r</mi></msub><mo>−</mo><mi>𝐲</mi></mrow><mo>+</mo><mi>𝐱</mi></mrow><mo>,</mo><msub><mi>v</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi>u</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>r</mi></msub><mo>,</mo><msub><mi>v</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">v_{r}\text{ is retained only if }u_{r}(h_{r}-\mathbf{y}+\mathbf{x};v_{r})&gt;u_{r}(h_{r};v_{r}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A1.I2.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A1.I2.i2.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A1.I2.i2.I1.i2.p1" class="ltx_para">
<p id="A1.I2.i2.I1.i2.p1.1" class="ltx_p">On <span id="A1.I2.i2.I1.i2.p1.1.1" class="ltx_text ltx_font_smallcaps">rejection</span>:
All agents discard any valuation states for <math id="A1.I2.i2.I1.i2.p1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> that would have <em id="A1.I2.i2.I1.i2.p1.1.2" class="ltx_emph ltx_font_italic">accepted</em> <math id="A1.I2.i2.I1.i2.p1.m2" class="ltx_Math" alttext="(\mathbf{x},\mathbf{y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{x},\mathbf{y})</annotation></semantics></math>, since that contradicts the observed rejection.</p>
</div></li>
<li id="A1.I2.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A1.I2.i2.I1.i3.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="A1.I2.i2.I1.i3.p1" class="ltx_para">
<p id="A1.I2.i2.I1.i3.p1.1" class="ltx_p">Then, each agent renormalizes its belief distributions <math id="A1.I2.i2.I1.i3.p1.m1" class="ltx_Math" alttext="B_{k}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>k</mi></msub><annotation encoding="application/x-tex">B_{k}</annotation></semantics></math> to sum to 1 over the remaining (still-plausible) valuations.</p>
</div></li>
</ul>
</div></li>
</ul>
</div>
<div id="A1.SS3.p2" class="ltx_para ltx_noindent">
<p id="A1.SS3.p2.1" class="ltx_p">This procedure repeats until no further beneficial trades can be found. The Bayesian updates ensure that, over time, agents refine their beliefs about each other’s valuations based on observed accept/reject decisions, thereby <em id="A1.SS3.p2.1.1" class="ltx_emph ltx_font_italic">learning</em> which trades are more likely to succeed.</p>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Human data collection</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Implementation on Deliberate Lab</h3>

<section id="A2.SS1.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Platform.</h5>

<div id="A2.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px1.p1.1" class="ltx_p">The bargaining game was implemented via Deliberate Lab (<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib36" title="" class="ltx_ref">Tsai et al. (2024)</a></cite>), an open-source platform for conducting group human-LLM social science experiments. We will publish the bargaining game implementation within the platform upon acceptance.</p>
</div>
</section>
<section id="A2.SS1.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Participant interface.</h5>

<div id="A2.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px2.p1.1" class="ltx_p">Upon entering Deliberate Lab through a web link, participants proceed through a multi-stage experiment including informed consent, game instructions, comprehension checks, and payout information. Upon completing the final comprehension check, they wait in a “Lobby” stage for other participants. When three participants are in the lobby, they are sent an invitation to join a live bargaining game (Fig <a href="#A2.F6" title="Figure 6 ‣ Participant interface. ‣ B.1 Implementation on Deliberate Lab ‣ Appendix B Human data collection ‣ Strategic Tradeoffs Between Humans and AI in Multi-Agent Bargaining" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>). Following the game, there is a post-game survey. For anonymity, we used a Deliberate Lab feature that assigns participants an anonymous animal avatar (e.g., “Bear”) as they join the experiment.</p>
</div>
<figure id="A2.F6" class="ltx_figure"><img src="2509.09071v1/images/deliberate_lab_negotiation_interface_offer.png" id="A2.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:429/256;" width="429" height="256" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F6.4" class="ltx_text" style="font-size:90%;">Figure 6</span>: </span><span id="A2.F6.5" class="ltx_text" style="font-size:90%;">The game interface shown to participants. This shows a participant’s game state. The top left indicates that they are currently the <span id="A2.F6.5.1" class="ltx_text ltx_font_italic">Proposer</span>, offering an interface to propose an offer. A table below displays all players’ chip volumes. To the right, the public ledger shows a history of game rounds, turns, and trade statuses.</span></figcaption>
</figure>
</section>
<section id="A2.SS1.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Bargaining game user interface.</h5>

<div id="A2.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px3.p1.1" class="ltx_p">To submit trade proposals, participants used text and selection fields to specify number and type of chip, respectively. The interface automatically calculated and displayed projected total chip value if the proposal were to be accepted (Fig <a href="#A2.F6" title="Figure 6 ‣ Participant interface. ‣ B.1 Implementation on Deliberate Lab ‣ Appendix B Human data collection ‣ Strategic Tradeoffs Between Humans and AI in Multi-Agent Bargaining" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>); it also prevented players from submitting invalid offers by disabling the "submit" button.</p>
</div>
<figure id="A2.F7.fig1" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:165.6pt;">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<p id="A2.F7.fig1.3" class="ltx_p ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:165.6pt;">For accepting or rejecting proposals, the interface calculated and displayed the projected total chip value if the player were to accept the proposal. It also disabled acceptance for offers the player could not fulfill (Fig <a href="#A2.F7.fig1" title="Figure 7 ‣ Bargaining game user interface. ‣ B.1 Implementation on Deliberate Lab ‣ Appendix B Human data collection ‣ Strategic Tradeoffs Between Humans and AI in Multi-Agent Bargaining" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, bottom). All participants were shown a table of all players’ chip quantities and a log of actions (i.e., when trades were proposed, accepted, and rejected, and when each round and turn of the game changed). Turn order was determined randomly.</p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.09071v1/images/deliberate_lab_negotiation_responder.png" id="A2.F7.g1" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:229/81;" width="229" height="81" alt="Refer to caption"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.09071v1/images/deliberate_lab_negotiation_responder_no_accept.png" id="A2.F7.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:229/61;" width="229" height="61" alt="Refer to caption"></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F7.fig1.4" class="ltx_text" style="font-size:90%;">Figure 7</span>: </span><span id="A2.F7.fig1.5" class="ltx_text" style="font-size:90%;">Accepting or rejecting a trade. The bottom image shows a disabled “accept” option.</span></figcaption>
</figure>
</section>
<section id="A2.SS1.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Experimenter interface.</h5>

<div id="A2.SS1.SSS0.Px4.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px4.p1.1" class="ltx_p">To conduct experiments, the experimenter used Deliberate Lab’s dashboard (Fig <a href="#A2.F8" title="Figure 8 ‣ Experimenter interface. ‣ B.1 Implementation on Deliberate Lab ‣ Appendix B Human data collection ‣ Strategic Tradeoffs Between Humans and AI in Multi-Agent Bargaining" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) to monitor participants as they progressed through the experiment’s information and comprehension check stages, then manually transferred participants into groups of three to play the bargaining game once the player was ready to be transferred. The experimenter was also able to send attention checks to participants (e.g., if several minutes elapsed without any visible progress) and remove them from the experiment (e.g., if attention checks went unanswered).</p>
</div>
<figure id="A2.F8" class="ltx_figure"><img src="2509.09071v1/images/deliberate_lab_running_experiment.png" id="A2.F8.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/126;" width="476" height="126" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F8.3" class="ltx_text" style="font-size:90%;">Figure 8</span>: </span><span id="A2.F8.4" class="ltx_text" style="font-size:90%;">Experiment dashboard for managing participants. On the left, experimenters can view participants as they enter the experiment, send attention checks, and/or remove participants. On the right, experimenters can monitor the status of a selected participant and assign them to a cohort of three for gameplay.</span></figcaption>
</figure>
</section>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Post-game participant survey</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Survey questions</h3>

<figure id="A3.T1" class="ltx_table">
<figcaption class="ltx_caption" style="font-size:80%;"><span class="ltx_tag ltx_tag_table"><span id="A3.T1.5" class="ltx_text" style="font-size:113%;">Table 1</span>: </span><span id="A3.T1.6" class="ltx_text" style="font-size:113%;">Post-game survey questions.</span></figcaption>
<table id="A3.T1.7" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A3.T1.7.1" class="ltx_tr">
<td id="A3.T1.7.1.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t"></td>
<td id="A3.T1.7.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A3.T1.7.1.2.1" class="ltx_inline-block ltx_align_top" style="width:256.1pt;">
<span id="A3.T1.7.1.2.1.1" class="ltx_p"><span id="A3.T1.7.1.2.1.1.1" class="ltx_text" style="font-size:80%;">Survey question</span></span>
</span></td>
<td id="A3.T1.7.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A3.T1.7.1.3.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="A3.T1.7.1.3.1.1" class="ltx_p"><span id="A3.T1.7.1.3.1.1.1" class="ltx_text" style="font-size:80%;">Response format</span></span>
</span></td></tr>
<tr id="A3.T1.7.2" class="ltx_tr">
<td id="A3.T1.7.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A3.T1.7.2.1.1" class="ltx_inline-block ltx_align_top" style="width:8.5pt;">
<span id="A3.T1.7.2.1.1.1" class="ltx_p"><span id="A3.T1.7.2.1.1.1.1" class="ltx_text" style="font-size:80%;">1</span></span>
</span></td>
<td id="A3.T1.7.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A3.T1.7.2.2.1" class="ltx_inline-block ltx_align_top" style="width:256.1pt;">
<span id="A3.T1.7.2.2.1.1" class="ltx_p"><span id="A3.T1.7.2.2.1.1.1" class="ltx_text" style="font-size:80%;">Please describe your strategy in the game in a few sentences.</span></span>
</span></td>
<td id="A3.T1.7.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A3.T1.7.2.3.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="A3.T1.7.2.3.1.1" class="ltx_p"><span id="A3.T1.7.2.3.1.1.1" class="ltx_text" style="font-size:80%;">Freeform text</span></span>
</span></td></tr>
<tr id="A3.T1.7.3" class="ltx_tr">
<td id="A3.T1.7.3.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A3.T1.7.3.1.1" class="ltx_inline-block ltx_align_top" style="width:8.5pt;">
<span id="A3.T1.7.3.1.1.1" class="ltx_p"><span id="A3.T1.7.3.1.1.1.1" class="ltx_text" style="font-size:80%;">2</span></span>
</span></td>
<td id="A3.T1.7.3.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="A3.T1.7.3.2.1" class="ltx_inline-block ltx_align_top" style="width:256.1pt;">
<span id="A3.T1.7.3.2.1.1" class="ltx_p"><span id="A3.T1.7.3.2.1.1.1" class="ltx_text" style="font-size:80%;">Please describe any experiences or background that may have influenced your performance in the game.</span></span>
</span></td>
<td id="A3.T1.7.3.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="A3.T1.7.3.3.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="A3.T1.7.3.3.1.1" class="ltx_p"><span id="A3.T1.7.3.3.1.1.1" class="ltx_text" style="font-size:80%;">Freeform text</span></span>
</span></td></tr>
<tr id="A3.T1.7.4" class="ltx_tr">
<td id="A3.T1.7.4.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A3.T1.7.4.1.1" class="ltx_inline-block ltx_align_top" style="width:8.5pt;">
<span id="A3.T1.7.4.1.1.1" class="ltx_p"><span id="A3.T1.7.4.1.1.1.1" class="ltx_text" style="font-size:80%;">3</span></span>
</span></td>
<td id="A3.T1.7.4.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="A3.T1.7.4.2.1" class="ltx_inline-block ltx_align_top" style="width:256.1pt;">
<span id="A3.T1.7.4.2.1.1" class="ltx_p"><span id="A3.T1.7.4.2.1.1.1" class="ltx_text" style="font-size:80%;">On a scale from 1 to 10, how would you rate your trading strategy, where 1 is highly </span><span id="A3.T1.7.4.2.1.1.2" class="ltx_text ltx_font_bold" style="font-size:80%;">competitive</span><span id="A3.T1.7.4.2.1.1.3" class="ltx_text" style="font-size:80%;"> (focused mainly on your own gains) and 10 is highly </span><span id="A3.T1.7.4.2.1.1.4" class="ltx_text ltx_font_bold" style="font-size:80%;">collaborative</span><span id="A3.T1.7.4.2.1.1.5" class="ltx_text" style="font-size:80%;"> (focused on other players’s potential gains and mutual benefits?</span></span>
</span></td>
<td id="A3.T1.7.4.3" class="ltx_td ltx_align_left ltx_align_top"><span id="A3.T1.7.4.3.1" class="ltx_inline-logical-block ltx_align_top" style="width:113.8pt;">
<span id="A3.T1.p1" class="ltx_para ltx_noindent">
<span id="A3.T1.p1.1" class="ltx_p"><span id="A3.T1.p1.1.1" class="ltx_text"></span><span id="A3.T1.p1.1.2" class="ltx_text" style="font-size:80%;">
<span id="A3.T1.p1.1.2.1" class="ltx_tabular ltx_align_top">
<span id="A3.T1.p1.1.2.1.1" class="ltx_tr">
<span id="A3.T1.p1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">1 through 10 scale;</span></span>
<span id="A3.T1.p1.1.2.1.2" class="ltx_tr">
<span id="A3.T1.p1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">1: "Not at all aggressive",</span></span>
<span id="A3.T1.p1.1.2.1.3" class="ltx_tr">
<span id="A3.T1.p1.1.2.1.3.1" class="ltx_td ltx_nopad_r ltx_align_left">10: "Very aggressive"</span></span>
</span></span><span id="A3.T1.p1.1.3" class="ltx_text"></span></span>
</span></span></td></tr>
<tr id="A3.T1.7.5" class="ltx_tr">
<td id="A3.T1.7.5.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A3.T1.7.5.1.1" class="ltx_inline-block ltx_align_top" style="width:8.5pt;">
<span id="A3.T1.7.5.1.1.1" class="ltx_p"><span id="A3.T1.7.5.1.1.1.1" class="ltx_text" style="font-size:80%;">4</span></span>
</span></td>
<td id="A3.T1.7.5.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="A3.T1.7.5.2.1" class="ltx_inline-block ltx_align_top" style="width:256.1pt;">
<span id="A3.T1.7.5.2.1.1" class="ltx_p"><span id="A3.T1.7.5.2.1.1.1" class="ltx_text" style="font-size:80%;">On a scale from 1 to 10, how certain are you that you made the best possible trades during the experiment?</span></span>
</span></td>
