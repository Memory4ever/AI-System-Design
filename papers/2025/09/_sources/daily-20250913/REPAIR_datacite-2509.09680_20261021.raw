{"data":{"id":"10.48550/arxiv.2509.09680","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.09680","prefix":"10.48550","suffix":"arxiv.2509.09680","identifiers":[{"identifier":"2509.09680","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.09680"}],"creators":[{"name":"Fang, Rongyao","nameType":"Personal","givenName":"Rongyao","familyName":"Fang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Aldrich","nameType":"Personal","givenName":"Aldrich","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Duan, Chengqi","nameType":"Personal","givenName":"Chengqi","familyName":"Duan","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Linjiang","nameType":"Personal","givenName":"Linjiang","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Bai, Shuai","nameType":"Personal","givenName":"Shuai","familyName":"Bai","affiliation":[],"nameIdentifiers":[]},{"name":"Cai, Yuxuan","nameType":"Personal","givenName":"Yuxuan","familyName":"Cai","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Kun","nameType":"Personal","givenName":"Kun","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Si","nameType":"Personal","givenName":"Si","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Xihui","nameType":"Personal","givenName":"Xihui","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Hongsheng","nameType":"Personal","givenName":"Hongsheng","familyName":"Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FLUX-Reason-6M \u0026amp; PRISM-Bench: A Million-Scale Text-to-Image Reasoning Dataset and Comprehensive Benchmark"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-11T17:59:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-12T00:49:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The advancement of open-source text-to-image (T2I) models has been hindered by the absence of large-scale, reasoning-focused datasets and comprehensive evaluation benchmarks, resulting in a performance gap compared to leading closed-source systems. To address this challenge, We introduce FLUX-Reason-6M and PRISM-Bench (Precise and Robust Image Synthesis Measurement Benchmark). FLUX-Reason-6M is a massive dataset consisting of 6 million high-quality FLUX-generated images and 20 million bilingual (English and Chinese) descriptions specifically designed to teach complex reasoning. The image are organized according to six key characteristics: Imagination, Entity, Text rendering, Style, Affection, and Composition, and design explicit Generation Chain-of-Thought (GCoT) to provide detailed breakdowns of image generation steps. The whole data curation takes 15,000 A100 GPU days, providing the community with a resource previously unattainable outside of large industrial labs. PRISM-Bench offers a novel evaluation standard with seven distinct tracks, including a formidable Long Text challenge using GCoT. Through carefully designed prompts, it utilizes advanced vision-language models for nuanced human-aligned assessment of prompt-image alignment and image aesthetics. Our extensive evaluation of 19 leading models on PRISM-Bench reveals critical performance gaps and highlights specific areas requiring improvement. Our dataset, benchmark, and evaluation code are released to catalyze the next wave of reasoning-oriented T2I generation. Project page: https://flux-reason-6m.github.io/ .","descriptionType":"Abstract"},{"description":"Project page: https://flux-reason-6m.github.io/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.09680","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-12T01:39:39.000Z","registered":"2025-09-12T01:39:39.000Z","published":"2025","updated":"2025-09-12T01:39:39.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.09680","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}