            <span id="alg1.l17.3" class="ltx_text ltx_font_bold" style="font-size:90%;">return</span><span id="alg1.l17.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg1.l17.m1" class="ltx_Math" alttext="d_{\mathcal{P}_{a}}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.900em">d</mi><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mi mathsize="0.900em">a</mi></msub><mo mathsize="0.900em">⋆</mo></msubsup><annotation encoding="application/x-tex">d_{\mathcal{P}_{a}}^{\star}</annotation></semantics></math><span id="alg1.l17.5" class="ltx_text" style="font-size:90%;">
</span>
