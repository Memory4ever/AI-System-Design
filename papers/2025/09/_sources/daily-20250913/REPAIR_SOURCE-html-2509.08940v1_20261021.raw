            <span id="alg1.l9.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.l9.m1" class="ltx_Math" alttext="d_{\mathcal{P}_{a}}[i]\leftarrow\texttt{describeDiverging}(\mathcal{P}_{a}^{div},\mathcal{P}_{a}^{non},\mathcal{H})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">d</mi><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mi mathsize="0.900em">a</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">i</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.900em">describeDiverging</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mi mathsize="0.900em">a</mi><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow></msubsup><mo mathsize="0.900em">,</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mi mathsize="0.900em">a</mi><mrow><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></msubsup><mo mathsize="0.900em">,</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{\mathcal{P}_{a}}[i]\leftarrow\texttt{describeDiverging}(\mathcal{P}_{a}^{div},\mathcal{P}_{a}^{non},\mathcal{H})</annotation></semantics></math><span id="alg1.l9.4" class="ltx_text" style="font-size:90%;">
