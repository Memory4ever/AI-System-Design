<td id="A2.T4.3.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A2.T4.3.1.3.3.1" class="ltx_text" style="font-size:90%;">0.68</span></td>
<td id="A2.T4.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A2.T4.3.1.3.4.1" class="ltx_text" style="font-size:90%;">0.64</span></td>
