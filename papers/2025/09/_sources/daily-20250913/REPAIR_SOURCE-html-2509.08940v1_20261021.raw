</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
            <span id="alg1.l13.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.l13.m1" class="ltx_Math" alttext="\mathcal{H}^{non}=\mathcal{H}^{non}\cup\mathcal{P}_{a}^{non}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mrow><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></msup><mo mathsize="0.900em">=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mrow><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></msup><mo mathsize="0.900em">∪</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mi mathsize="0.900em">a</mi><mrow><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}^{non}=\mathcal{H}^{non}\cup\mathcal{P}_{a}^{non}</annotation></semantics></math><span id="alg1.l13.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
            <span id="alg1.l14.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg1.l14.m1" class="ltx_Math" alttext="\mathcal{H}^{div}=\mathcal{H}^{div}\cup\mathcal{P}_{a}^{div}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow></msup><mo mathsize="0.900em">=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow></msup><mo mathsize="0.900em">∪</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mi mathsize="0.900em">a</mi><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">v</mi></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}^{div}=\mathcal{H}^{div}\cup\mathcal{P}_{a}^{div}</annotation></semantics></math><span id="alg1.l14.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
            <span id="alg1.l15.3" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg1.l15.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l15.5" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
            <math id="alg1.l16.m1" class="ltx_Math" alttext="d_{\mathcal{P}_{a}}^{\star}\leftarrow d_{\mathcal{P}_{a}}[\texttt{argmax}(\sigma)]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">d</mi><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mi mathsize="0.900em">a</mi></msub><mo mathsize="0.900em">⋆</mo></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">d</mi><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒫</mi><mi mathsize="0.900em">a</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.900em">argmax</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">σ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{\mathcal{P}_{a}}^{\star}\leftarrow d_{\mathcal{P}_{a}}[\texttt{argmax}(\sigma)]</annotation></semantics></math><span id="alg1.l16.3" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
