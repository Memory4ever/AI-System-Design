</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 4.74 8.2)"><foreignObject style="--ltx-fo-width:41.59em;--ltx-fo-height:10.35em;--ltx-fo-depth:0.25em;font-size:10pt;" class="ltx_minipage" height="146.67" overflow="visible" transform="matrix(1 0 0 -1 0 143.21)" width="39.61em"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><pre id="S2.SS1.p4.pic1.2" class="ltx_verbatim ltx_font_typewriter" style="--ltx-fg-color:#000000;">{
  "dataset_name": "brain",
  "meta": {
    "total_images": 3264,
