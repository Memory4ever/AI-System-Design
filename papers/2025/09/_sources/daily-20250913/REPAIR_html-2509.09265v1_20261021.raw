<math alttext="k" class="ltx_Math" display="inline" id="A3.T4.m2"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, <math alttext="k^{\prime}" class="ltx_Math" display="inline" id="A3.T4.m3"><semantics><msup><mi>k</mi><mo>′</mo></msup><annotation encoding="application/x-tex">k^{\prime}</annotation></semantics></math>
</th>
<td class="ltx_td ltx_align_left">1.0</td>
