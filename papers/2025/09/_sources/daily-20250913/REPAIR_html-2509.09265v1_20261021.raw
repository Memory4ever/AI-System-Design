<td class="ltx_td ltx_align_left">16</td>
</tr>
<tr class="ltx_tr">
<th class="ltx_td ltx_align_left ltx_th ltx_th_row">Training Step</th>
<td class="ltx_td ltx_align_left">150</td>
</tr>
<tr class="ltx_tr">
<th class="ltx_td ltx_align_left ltx_th ltx_th_row">Rollout Group Size</th>
