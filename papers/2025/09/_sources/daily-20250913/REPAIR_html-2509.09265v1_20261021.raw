</tr>
<tr class="ltx_tr">
<th class="ltx_td ltx_align_left ltx_th ltx_th_row">Clip Low (DAPO)</th>
<td class="ltx_td ltx_align_left">0.2</td>
</tr>
<tr class="ltx_tr">
<th class="ltx_td ltx_align_left ltx_th ltx_th_row">Clip Low/High (GRPO)</th>
