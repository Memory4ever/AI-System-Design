<td id="Sx5.T2.1.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="Sx5.T2.m5" class="ltx_Math" alttext="N_{1}=50" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mn>1</mn></msub><mo>=</mo><mn>50</mn></mrow><annotation encoding="application/x-tex">N_{1}=50</annotation></semantics></math></td>
