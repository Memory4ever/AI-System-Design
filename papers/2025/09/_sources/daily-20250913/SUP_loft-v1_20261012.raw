<td id="Sx5.T2.1.2.4" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><math id="Sx5.T2.m3" class="ltx_Math" alttext="\gamma_{u}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>u</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma_{u}=1</annotation></semantics></math> (uniform)</td>
<td id="Sx5.T2.1.2.5" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><math id="Sx5.T2.m4" class="ltx_Math" alttext="\gamma_{u}=1/10" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>u</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>10</mn></mrow></mrow><annotation encoding="application/x-tex">\gamma_{u}=1/10</annotation></semantics></math> (reversed)</td></tr>
