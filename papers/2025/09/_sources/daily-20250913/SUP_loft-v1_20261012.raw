<td id="Sx5.T2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><math id="Sx5.T2.m1" class="ltx_Math" alttext="\gamma=\gamma_{l}=\gamma_{u}=10" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><msub><mi>γ</mi><mi>l</mi></msub><mo>=</mo><msub><mi>γ</mi><mi>u</mi></msub><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">\gamma=\gamma_{l}=\gamma_{u}=10</annotation></semantics></math></td>
